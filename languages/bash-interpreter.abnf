        for (i = 0; i < segs.length; i++) {
            var sg = segs[i]
            var out = []
            var v
            if (typeof sg == "function" || sg.alts == undefined) {
                for (v = 0; v < variants.length; v++) { out.push(concatSegs(variants[v], [sg])) }
            } else {
                for (v = 0; v < variants.length; v++) {
                    var a
                    for (a = 0; a < sg.alts.length; a++) {
