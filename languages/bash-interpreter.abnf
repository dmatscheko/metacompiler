    function notFound(name) {
        diagErr(name + ": command not found\n")
        setStatus(127)
        return 127
    }

    // `builtin NAME ARGS` and `command NAME ARGS` run NAME passing over shell functions
    // (skipFuncs, read once by the next runCommand). No engine here runs external programs,
    // so `command` of a name that is not a builtin is not found, and `builtin` of one is
    // bash's "not a shell builtin" (status 1). `command -v NAME...` prints each NAME that is
    // a builtin, a keyword or a function, and `command -V` says which one it is as `type`
    // does (describeName) or that it is not found; the status is 1 when none is anything. Of -v and -V the last one given counts. Twin of wrapperWords and
    // emitWrapper in bash-to-llvm-ir.abnf.
    var skipFuncs = false
    var shellBuiltins = {}
    var shellKnownWords = ". : [ alias bg bind break builtin caller cd command compgen complete compopt continue declare dirs disown echo enable eval exec exit export false fc fg getopts hash help history jobs kill let local logout mapfile popd printf pushd pwd read readarray readonly return set shift shopt source suspend test times trap true type typeset ulimit umask unalias unset wait".split(" ")
    var swi
    for (swi = 0; swi < shellKnownWords.length; swi++) { shellBuiltins["$" + shellKnownWords[swi]] = true }
    var shellKeywords = {}
    var shellKwWords = "if then else elif fi case esac for select while until do done in function time { } ! [[ ]] coproc".split(" ")
    for (swi = 0; swi < shellKwWords.length; swi++) { shellKeywords["$" + shellKwWords[swi]] = true }
    // `type [-t] NAME...`: what each NAME is, looked up as bash does - keyword, function,
    // builtin. A function is "NAME is a function" and its definition as bash prints it
    // (bashDeparse); -t prints only the kind. A NAME that is none is "type: NAME: not
    // found" (nothing with -t) and makes the status 1. Twin of emitType in
    // bash-to-llvm-ir.abnf.
    function nameKind(name) {
        var k = "$" + name
        if (hasOwn(shellKeywords, k)) { return "keyword" }
        if (isFunc(name)) { return "function" }
        if (hasOwn(shellBuiltins, k)) { return "builtin" }
        return ""
    }
    function describeName(name, kind) {
        if (kind == "function") { return name + " is a function\n" + funcText(name) + "\n" }
        return name + " is a shell " + kind + "\n"
    }
    function funcText(name) {
        var d = bashDeparse(funcSrc["$" + name])
        if (d.err != undefined) { fail("printing a function body that holds " + d.err + " is not supported") }
        return d.text
    }
    function typeCmd(args) {
        var i = 0
        var terse = false
        while (i < args.length && args[i].length > 1 && args[i].charAt(0) == "-") {
            var opt = args[i]
            i = i + 1
            if (opt == "--") { break }
            if (opt != "-t") { fail("type " + opt + " is not supported") }
            terse = true
        }
