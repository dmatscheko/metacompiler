    function indFail(msg) {
        emitErr("bash: " + msg + "\n")
        arithErr = true
        return null
    }
    // A name an indirection may land on. Twin of rt_isref.
    function isRefName(v) {
        if (v.length == 1 && "@*#?-$!".indexOf(v) >= 0) { return true }
        if (allDigits(v) || isIdentText(v)) { return true }
        var sp = splitSubscript(v)
        return sp.key != null && sp.key != "" && isIdentText(sp.name)
