        // not modelled. None of them may be read as `declare NAME`, which below would make
        // the name a fresh unset local.
        var query = (flags.indexOf("p") >= 0) || (flags.indexOf("f") >= 0) || (flags.indexOf("F") >= 0)
        var isPrint = (flags.indexOf("p") >= 0) && (flags.indexOf("f") < 0) && (flags.indexOf("F") < 0)
        return function() {
            var k
            if (query) {
                // -p with names PRINTS; -p bare and -f/-F stay silent (declLine's comment
                // says why), and a name that is not set is a diagnostic and status 1.
                if (isPrint && names.length > 0) {
                    var pst = 0
                    for (k = 0; k < names.length; k++) {
                        var line = declLine(names[k])
                        if (line == "") { emitErr("bash: declare: " + names[k] + ": not found\n"); pst = 1 }
                        else { emitOut(line + "\n") }
                    }
                    setStatus(pst)
                    return pst
                }
                setStatus(0); return 0
            }
