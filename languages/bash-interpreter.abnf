            var cmd = wordJoin(cmdT())
            var args = expandWords(argTs)
            var k
            if (abortSignal != null) { var ab = abortSignal; abortSignal = null; return ab }
            if (redirs.length == 0) { return runCommand(cmd, args) }
            var rs = openRedirs(redirs)
