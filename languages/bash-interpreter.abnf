                        ai = ai + 1
                        used = true
                        var piece = ""
                        if (conv == "s") { piece = arg; if (prec >= 0 && piece.length > prec) { piece = piece.slice(0, prec) } }
                        else if (conv == "d" || conv == "i") { piece = numToStr(strToInt(arg)) }
                        else if (conv == "c") { piece = (arg.length > 0) ? arg.charAt(0) : "" }
                        else if (conv == "x" || conv == "X") { piece = toHex(strToInt(arg), conv == "X") }
                        else { piece = arg }
                        while (piece.length < width) {
