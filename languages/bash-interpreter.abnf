                        var dasg = declArrAssign(idxName)
                        // Unquoted, [@] is the [*] string too, split like any other value.
                        if ((sub == "*" || uqStar) && !starFields()) { return "declare " + dflag + " " + dasg }
                        if (ifsFirst() == "") { return encFields(["declare", dflag, dasg]) }
                        var dval = dasg.slice(idxName.length + 1)
                        var dtxt = "declare " + dflag + " " + idxName + "="
                        var dfs = splitIFS(dtxt)
                        if (dfs.length == 0 || ifsTrail(dtxt)) { dfs.push(dval) } else { dfs[dfs.length - 1] = dfs[dfs.length - 1] + dval }
                        return encFields(dfs)
