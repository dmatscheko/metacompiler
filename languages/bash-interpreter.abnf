        // applyPatOp the subscripted branch above uses element-wise.
        if (isPatOp(pe)) {
            var sPe = pe
            var sAnch = anchor
            var pT = (args.length > 0) ? args[0] : null
            var rT = (args.length > 1) ? args[1] : null
            return function() {
                var pat = (pT != null) ? wordJoin(pT()) : ""
                var rep = (rT != null) ? wordJoin(rT()) : ""
                var pnm = nameOf()
                if (pnm == null) { return "" }
                var pv = getVarVal(pnm)
