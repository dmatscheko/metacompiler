        for (i = 1; i < items.length; i++) {
            var it = items[i]
            if (typeof it == "function") { if (idxT == null && op == "=" && lit == null && valT == null && hasIdxMark(items)) { idxT = it } else { valT = it } }
            else if (it.aop2 != undefined) { op = it.aop2 }
