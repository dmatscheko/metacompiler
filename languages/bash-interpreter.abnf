            var res = [""]
            var i
            for (i = 0; i < segs.length; i++) {
                var v = segs[i]()
                var f = isFields(v) ? decFields(v) : [v]
                if (f.length > 0) {
                    res[res.length - 1] = res[res.length - 1] + f[0]
                    var j
                    for (j = 1; j < f.length; j++) { res.push(f[j]) }
                }
            }
            if (res.length == 1) { return res[0] }
            return encFields(res)
