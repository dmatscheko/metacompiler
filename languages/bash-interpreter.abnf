        var lT = items[0], rT = items[2]
        return function() {
            var subj = condWord(lT)
            var src = condWord(rT)
            var re = bashRegex(src)
            // A pattern that does not compile is not fatal in bash: it reports on standard
            // error and gives the [[ ]] status 2.
            if (!re.ok) {
                diagErr("[[: invalid regular expression: " + re.err + "\n")
                condErr = 2
                // BASH_REMATCH is deliberately NOT touched: bash only rewrites it once
                // it has a compiled pattern to search with, so after a bad pattern the
                // previous match's contents are still readable.
                return false
            }
            var m = rxSearch(re, subj, 0)
            if (m == null) { arrFromList("BASH_REMATCH", false, []); return false }
            var list = []
            var i
            for (i = 0; i <= re.ngroups; i++) {
                // rxGroup answers null for a group that did not participate; bash reports "".
                var g = rxGroup(re, subj, m, i)
