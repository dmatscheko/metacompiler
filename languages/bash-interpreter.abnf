        // that is no variable removes the function of that name. -n acts as -v (no namerefs).
        // Twin of the unset arm of makeSimpleCommand in bash-to-llvm-ir.abnf.
        if (cmd == "unset") {
            var ui = 0
            var ust = 0
            var uf = false, uv = false, un = false
            while (ui < args.length && args[ui].length > 1 && args[ui].charAt(0) == "-") {
                var uo = args[ui]
                ui = ui + 1
                if (uo == "--") { break }
                var uc
                for (uc = 1; uc < uo.length; uc++) {
                    var ul = uo.charAt(uc)
                    if (ul == "f") { uf = true }
                    else if (ul == "v") { uv = true }
                    else if (ul == "n") { un = true }
                    else {
