            while (i < len && ifsIsWs(seps, l.charAt(i))) { i = i + 1 }
            if (i < len && ifsHas(seps, chunkAt(l, i))) {
                i = i + chunkAt(l, i).length
                while (i < len && ifsIsWs(seps, l.charAt(i))) { i = i + 1 }
            }
            if (out.length == n - 1 && i < len) {
