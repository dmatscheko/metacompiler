                st = 1
            } else { emitOut(terse ? kind + "\n" : describeName(args[i], kind)) }
        }
        setStatus(st)
        return st
    }
    // `declare -f [NAME...]` prints each function's definition, `declare -F [NAME...]` its
    // name; with no NAME every function, sorted, -F as `declare -f NAME`. A NAME that is no
    // function prints nothing and makes the status 1. Twin of emitDeclFuncs in
    // bash-to-llvm-ir.abnf.
    // declare -f / -F: with names and an attribute (-t, +t) and no -p, they set or clear it
    // on each function, a name that is none failing silently. Otherwise they print: -f the
    // definitions, -F the names, and a function's attribute line `declare -ft NAME` when no
    // name is given or with -p; with no name an attribute picks the functions holding it,
    // and with -p a name that is none is "not found". Twin of emitDeclFuncs in
    // bash-to-llvm-ir.abnf.
    function declFuncs(kw, q, names, flags, plus) {
        var p = flags.indexOf("p") >= 0
        var tOn = flags.indexOf("t") >= 0
        var tOff = plus.indexOf("t") >= 0
        var st = 0
        var k
        if (!p && names.length > 0 && (tOn || tOff)) {
            for (k = 0; k < names.length; k++) {
                if (!isFunc(names[k])) { st = 1; continue }
                funcLogNote("$" + names[k])
                funcTr["$" + names[k]] = !tOff
            }
            setStatus(st)
            return st
        }
        var list = names
        if (names.length == 0) {
            list = []
            var j
            for (j = 0; j < funcNames.length; j++) { if (isFunc(funcNames[j]) && (!tOn || funcTraced(funcNames[j]))) { list.push(funcNames[j]) } }
            list = bashSortNames(list)
        }
        var full = p || names.length == 0
        for (k = 0; k < list.length; k++) {
            if (!isFunc(list[k])) {
                if (p) { diagErr(kw + ": " + list[k] + ": not found\n") }
                st = 1
                continue
            }
            var at = funcTraced(list[k]) ? "t" : ""
            if (q == "f") { emitOut(funcText(list[k]) + "\n" + ((full && at != "") ? "declare -f" + at + " " + list[k] + "\n" : "")) }
            else { emitOut((full ? "declare -f" + at + " " : "") + list[k] + "\n") }
        }
        setStatus(st)
        return st
    }
    function runWrapper(cmd, args) {
        var i = 0
        var query = ""
        while (cmd == "command" && i < args.length && args[i].length > 1 && args[i].charAt(0) == "-") {
            var opt = args[i]
            i = i + 1
            if (opt == "--") { break }
            var oc
            for (oc = 1; oc < opt.length; oc++) { if (opt.charAt(oc) == "v" || opt.charAt(oc) == "V") { query = opt.charAt(oc) } }
        }
        if (i >= args.length) { setStatus(0); return 0 }
        if (query != "") {
            var qst = 1
            for (; i < args.length; i++) {
                var kind = nameKind(args[i])
                if (kind == "") { if (query == "V") { diagErr("command: " + args[i] + ": not found\n") }; continue }
                emitOut((query == "v") ? args[i] + "\n" : describeName(args[i], kind))
                qst = 0
            }
            setStatus(qst)
            return qst
        }
        var name = args[i]
        if (!hasOwn(shellBuiltins, "$" + name)) {
            if (cmd == "builtin") {
                diagErr("builtin: " + name + ": not a shell builtin\n")
                setStatus(1)
                return 1
            }
            return notFound(name)
        }
        skipFuncs = true
        return runCommand(name, args.slice(i + 1))
    }

    function isFunc(name) { return hasOwn(funcs, "$" + name) && funcs["$" + name] != null }
    // Call a user function: bind $1.. to args, run the body, restore, return its status.
    function callFunc(name, args) {
        var body = funcs["$" + name]
        var svLn = lnCtx
        lnCtx = funcLn["$" + name]
        var saved = posParams
        var savedLoops = loopDepth
        posParams = args
        loopDepth = 0
        var own = !adoptFrame
        adoptFrame = false
        if (own) { pushLocalFrame() }
        declareLocal("FUNCNAME")
        localFrames[localFrames.length - 1][localFrames[localFrames.length - 1].length - 1].sys = true
        setVarVal("FUNCNAME", name)
        fnDepth = fnDepth + 1
        var r = anytype
        r = body()
        fnDepth = fnDepth - 1
        lnCtx = svLn
        if (own) { popLocalFrame() }
        posParams = saved
        loopDepth = savedLoops
        if (typeof r == "object") {
            if (r.isExit != undefined) { return r }   // an exit unwinds past the caller too
            return r.ret
        }
        return r
    }

    // cmd1 && cmd2 || cmd3 : short circuit on the running status; a {ret} unwinds at once.
    function makeAndOr(items) {
        if (items.length == 1) { return items[0] }
        return function() {
            var st = anytype
            // Every element but the last runs as a condition, so set -e does not fire on it.
            st = runCond(items[0])
            if (typeof st == "object") { return st }
            var i
            for (i = 1; i < items.length; i += 2) {
                var op = items[i].op
                var runIt = (op == "&&") ? (st == 0) : (st != 0)
                if (runIt) {
                    var isLast = (i + 2 >= items.length)
                    // set -e looks only at the LAST command of the list, when it runs
                    eeDone = false
                    st = isLast ? items[i + 1]() : runCond(items[i + 1])
                    if (typeof st == "object") { return st }
                    if (isLast && !eeDone && optErrExit && st != 0 && condDepth == 0) { return {ret: st, isExit: 1} }
                }
            }
            eeDone = true
            return st
        }
    }

    // `cmd &` : the parser leaves an {amp} marker AFTER the statement it applies to, so a
    // statement list is a mix of thunks and markers. linkAsync folds the markers away and
    // hands back a list of plain thunks, which is what makeSeq / runProgram expect.
    function linkAsync(items) {
        var out = []
        var i
        for (i = 0; i < items.length; i++) {
            if (typeof items[i] == "function") { out.push(items[i]) }
            else if (out.length > 0) { out[out.length - 1] = mkAsync(out[out.length - 1]) }
        }
        return out
    }
    // LIMIT, and a deliberate one: there is no second process behind a grammar run, so an
    // asynchronous statement is run to completion HERE, in a subshell copy of the shell
    // state, and reports status 0 immediately - which is what a real `cmd & wait` pair
    // observes. What it cannot model is overlap: `sleep 1 & echo hi` prints "hi" after the
    // sleep, not before it. $! answers a fresh, monotonically increasing fake pid.
    var lastBgPid = 0
    function mkAsync(t) {
        return function() {
            lastBgPid = lastBgPid + 1
            var saved = saveShellState()
            localFrames = framesCopy()
            exitTrap = null
            var r = anytype
            r = t()
            runExitTrap(endStatus(r))
            restoreShellState(saved)
            setStatus(0)
            return 0
        }
    }

    // A statement sequence: the value is the last statement's status; a {ret} unwinds.
    // set -e: leave on the first failing statement, unless it is a CONDITION or answered set -e
    // itself or is exempt (eeDone). Twin of makeSeq in bash-to-llvm-ir.abnf.
    // The lines of an eval or trap string (splitLines): an expansion error abandons the rest
    // of its line with status 1 and the next line runs, as in a script (runProgram). Twin of
    // makeLines in bash-to-llvm-ir.abnf.
    function makeLines(lines) {
        var seqs = []
        var i
        for (i = 0; i < lines.length; i++) { seqs.push(makeSeq(lines[i])) }
        return function() {
            var r = anytype
            r = 0
            var li
            for (li = 0; li < seqs.length; li++) {
                r = seqs[li]()
                // In a subshell the abandoned line ends the subshell instead, status 1.
                if (subLevels > 0 && (typeof r == "object" || abortSignal != null || arithErr)) { return r }
                if (typeof r == "object") {
                    if (r.soft == undefined) { return r }
                    takeAbort()
                    r = 1
                    setStatus(1)
                    continue
