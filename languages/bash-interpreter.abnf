                        // A local made of the call's prefix binding keeps its export (bash's
                        // makunbound).
                        var keepX = attrOn(exVars, sp.name) && tmpOwn(sp.name) != null
                        unsetVar(sp.name); arrs[arrKey(sp.name)] = null; dropAttrs(sp.name)
                        if (localHere(sp.name)) { dclVars["$" + sp.name] = true }
                        exVars["$" + sp.name] = keepX
