    // answers an ENCODED list instead: "\x02" followed by each field and a "\x01" after it.
    // The trailing separator makes the empty list ("\x02") and the one-empty-field list
    // ("\x02\x01") different, which is what makes `a=($empty)` produce no element at all.
    function encFields(list) {
        var out = "\x02"
