    function mkDeclItem(items) { return {a: parseAssign(items)} }

    // A character copied one at a time must carry a SURROGATE PAIR across in one piece: the
    // script string type re-encodes on every concatenation, so appending a lone surrogate
    // turns an astral character into U+FFFD. Every loop below that rebuilds text uses this.
    function chunkAt(s, i) {
        var cc = s.charCodeAt(i)
        if (cc >= 55296 && cc <= 56319 && i + 1 < s.length) { return s.slice(i, i + 2) }
        return s.charAt(i)
