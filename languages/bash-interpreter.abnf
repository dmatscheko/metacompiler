    }
    var testNumOps = {"-eq": "==", "-ne": "!=", "-lt": "<", "-le": "<=", "-gt": ">", "-ge": ">="}
    // An operand of test's -eq ... -ge, which takes bash's legal_number, not arithmetic:
    // white space, one optional sign, decimal digits that fit an intmax_t, white space.
    // Anything else is "integer expected", reported once, and tst.err makes the test
    // command's status 2. Twin of rt_test_int in bash-rt.c.
    var tst = {who: "test", err: false, stop: false, a: [], n: 0, i: 0}
    function isCSpace(c) { return c == 32 || (c >= 9 && c <= 13) }
    function testInt(s) {
        var i = 0, j = s.length
        while (i < j && isCSpace(s.charCodeAt(i))) { i = i + 1 }
        while (j > i && isCSpace(s.charCodeAt(j - 1))) { j = j - 1 }
        var d = (i < j && (s.charAt(i) == "-" || s.charAt(i) == "+")) ? i + 1 : i
        var k = d
        while (k < j && s.charCodeAt(k) >= 48 && s.charCodeAt(k) <= 57) { k = k + 1 }
        var z = d
        while (z < j - 1 && s.charAt(z) == "0") { z = z + 1 }
        var lim = (s.charAt(i) == "-") ? "9223372036854775808" : "9223372036854775807"
        var ds = s.slice(z, j)
        if (k == d || k < j || ds.length > 19 || (ds.length == 19 && ds > lim)) {
            if (!tst.err) { diagErr(tst.who + ": " + s + ": integer expected\n") }
            tst.err = true
            return 0
        }
        return arStr(s.slice(i, j))
    }
    function testBinary(l, op, r) {
        if (hasOwn(testNumOps, op)) { return arIsZero(arOp(testNumOps[op], testInt(l), testInt(r))) ? 1 : 0 }
        if (op == "=" || op == "==") { return (l == r) ? 0 : 1 }
        if (op == "!=") { return (l != r) ? 0 : 1 }
        if (op == "<") { return (l < r) ? 0 : 1 }
        if (op == ">") { return (l > r) ? 0 : 1 }
        if (op == "-nt" || op == "-ot" || op == "-ef") { return testFileCmp(l, op, r) ? 0 : 1 }
        fail("unknown binary test operator: " + op)
        return 2
    }

    // bash's test.c over the ARGUMENT LIST tst.a, at position tst.i. posixtest picks a rule by
    // the number of arguments (0 to 4, and so does a parenthesised group of at most four);
    // beyond that, expr := and [ -o expr ], and := term [ -a and ], term := { "!" } ( "(" ... ")"
    // | WORD BINOP WORD | UNOP WORD | WORD ). A syntax error is reported unless an operand
    // already was, and stops the evaluation (tst.stop); either makes the status 2. Values are
    // booleans. Twin of the tc* functions in bash-to-llvm-ir.abnf and rt_test in bash-rt.c.
    function tstAt(k) { return (k < tst.n) ? tst.a[k] : "\x00end" }
    function tstSyn(msg) {
        if (!tst.stop && !tst.err) { diagErr(tst.who + ": " + msg + "\n") }
        tst.err = true
        tst.stop = true
        return false
    }
    function tstAdvance(chk) {
        tst.i = tst.i + 1
        if (chk && tst.i >= tst.n) { tstSyn("argument expected") }
    }
    function tstAndOr(t) { return t == "-a" || t == "-o" }
    function tstBinary() {
        var k = tst.i
        tst.i = k + 3
        return testBinary(tst.a[k], tst.a[k + 1], tst.a[k + 2]) == 0
    }
    // -t takes its operand only when that is an integer, or is no -a / -o among five or more
    // arguments (where it means -t 1); the model has no terminal.
    function tstUnary() {
        var k = tst.i
        if (tst.a[k] == "-t") {
            if (tst.n >= 4 && tstAndOr(tst.a[k + 1])) { tst.i = k + 1; return false }
            testInt(tst.a[k + 1])
            tst.i = k + 2
            return false
        }
        tst.i = k + 2
        return testUnary(tst.a[k], tst.a[k + 1], false) == 0
    }
    function tstTwo() {
        var k = tst.i
        if (tst.a[k] == "!") { tst.i = k + 2; return tst.a[k + 1] == "" }
        if (isTestUnary(tst.a[k])) { return tstUnary() }
        return tstSyn(tst.a[k] + ": unary operator expected")
    }
    function tstThree() {
        var k = tst.i
        var w = tst.a[k + 1]
        if (isTestBinary(w)) { return tstBinary() }
        if (tstAndOr(w)) {
            tst.i = k + 3
            return (w == "-a") ? (tst.a[k] != "" && tst.a[k + 2] != "") : (tst.a[k] != "" || tst.a[k + 2] != "")
        }
        if (tst.a[k] == "!") { tstAdvance(true); return !tstTwo() }
        if (tst.a[k] == "(" && tst.a[k + 2] == ")") { tst.i = k + 3; return w != "" }
        return tstSyn(w + ": binary operator expected")
    }
    // One argument reads the FIRST argument of the command, also inside parentheses (bash).
    function tstPosix(nargs) {
        var k = tst.i
        if (nargs == 1) { tst.i = k + 1; return tst.a[0] != "" }
        if (nargs == 2) { return tstTwo() }
        if (nargs == 3) { return tstThree() }
        if (nargs == 4 && tst.a[k] == "!") { tstAdvance(true); return !tstThree() }
        if (nargs == 4 && tst.a[k] == "(" && tst.a[k + 3] == ")") {
            tstAdvance(true)
            var v = tstTwo()
            tstAdvance(false)
            return v
        }
        return tstExpr()
    }
    function tstExpr() { return (tst.i >= tst.n) ? tstSyn("argument expected") : tstOr() }
    function tstOr() {
        var v = tstAnd()
        if (tstAt(tst.i) == "-o") { tst.i = tst.i + 1; var v2 = tstOr(); return v || v2 }
        return v
    }
    function tstAnd() {
        var v = tstTerm()
        if (tstAt(tst.i) == "-a") { tst.i = tst.i + 1; var v2 = tstAnd(); return v && v2 }
        return v
    }
    function tstTerm() {
        if (tst.stop) { return false }
        if (tst.i >= tst.n) { return tstSyn("argument expected") }
        var t = tst.a[tst.i]
        if (t == "!") {
            var neg = false
            while (tstAt(tst.i) == "!") { tstAdvance(true); neg = !neg }
            var r = tstTerm()
            return neg ? !r : r
        }
        if (t == "(") {
            tstAdvance(true)
            if (tst.stop) { return false }
            // The group a matching ")" closes, counted from the argument after the first.
            var nargs = 1, depth = 1
            while (tst.i + nargs < tst.n) {
                var u = tst.a[tst.i + nargs]
                if (u == ")") { depth = depth - 1 } else if (u == "(") { depth = depth + 1 }
                if (depth == 0) { break }
                nargs = nargs + 1
            }
            var v = (tst.i + nargs < tst.n && nargs <= 4) ? tstPosix(nargs) : tstExpr()
            if (tst.i >= tst.n) { tstSyn("`)' expected") }
            else if (tst.a[tst.i] != ")") { tstSyn("`)' expected, found " + tst.a[tst.i]) }
            tst.i = tst.i + 1
            return v
        }
        if (tst.i + 3 <= tst.n && isTestBinary(tst.a[tst.i + 1])) { return tstBinary() }
        if (tst.i + 2 <= tst.n && isTestUnary(t)) { return tstUnary() }
        tst.i = tst.i + 1
        return t != ""
    }

    // The test builtin: [ ... ] (drops the closing ]) or `test ...`.
    function testBuiltin(cmd, argsIn) {
        var a = argsIn
        tst.who = cmd
        if (cmd == "[") {
            if (a.length == 0 || a[a.length - 1] != "]") { diagErr("[: missing `]'\n"); return 2 }
            a = a.slice(0, a.length - 1)
        }
        if (a.length == 0) { return 1 }
        tst.a = a
        tst.n = a.length
        tst.i = 0
        tst.err = false
        tst.stop = false
        var v = tstPosix(a.length)
        if (tst.i < tst.n) {
            if (tst.a[tst.i].charAt(0) == "-") { tstSyn("syntax error: `" + tst.a[tst.i] + "' unexpected") }
            else { tstSyn("too many arguments") }
        }
        return tst.err ? 2 : (v ? 0 : 1)
    }

    // Dispatch a command by its (already expanded) name. Returns an int status, or {ret: n}
    // for the return builtin; exit terminates the whole run immediately.
    function runCommand(cmd, args) {
        // A function hides the builtin of its name (`echo() { builtin echo "<$*>"; }`).
        var noFn = skipFuncs
        skipFuncs = false
        if (!noFn && isFunc(cmd)) {
            var st2 = anytype
            st2 = callFunc(cmd, args)
            if (typeof st2 == "object") { return st2 }
            setStatus(st2)
            return st2
        }
        if (cmd == "echo") { echoCmd(args); setStatus(0); return 0 }
        if (cmd == "builtin" || cmd == "command") { return runWrapper(cmd, args) }
        if (cmd == "type") { return typeCmd(args) }
        if (cmd == "[" || cmd == "test") {
            var st = testBuiltin(cmd, args)
            // An arithmetic error in a -v subscript abandons the line.
            var tab = takeAbort()
            if (tab != null) { setStatus(1); return tab }
            setStatus(st)
            return st
