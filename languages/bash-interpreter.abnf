                    if (ut == "") { unRef = true; refTarget(sp.name) } else { sp = splitSubscript(ut) }
                }
                else if (anyRef && !un) { sp = {name: splitSubscript(refTarget(sp.name)).name, key: sp.key} }
                if (!uv && sp.key == null && isFunc(sp.name) && !isSetVar(sp.name) && !isArr(sp.name) && !attrOn(dclVars, sp.name)) {
                    setFunc(sp.name, null, null, null)
