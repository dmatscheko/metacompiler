        if (hasIdx && args.length > 0) {
            idxT = args[0]
            args = args.slice(1)
            if (wordT == args[0]) { wordT = null }
            wordT = (args.length > 0) ? args[args.length - 1] : null
        }
        if (idxT != null) {
            var readIdx = function() {
                var sub = wordJoin(idxT())
