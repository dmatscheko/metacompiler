    // bash's own text when it is empty - on standard error, and the (sub)shell ends with
    // status 1. Twin of rt_pcheck.
    function paramErr(nm, wordT, colon) {
        var msg = (wordT != null) ? wordJoin(wordT()) : ""
        if (msg == "") { msg = colon ? "parameter null or not set" : "parameter not set" }
        emitErr("bash: " + nm + ": " + msg + "\n")
        abortSignal = {ret: 1, isExit: 1}
    }

    // items = [{dkw}, {dflag}*, ({dname} | {aname, val})*]
    function makeDecl(items) {
        var kw = items[0].dkw
        var flags = ""
        var names = []
        var asgs = []
        var i
        for (i = 1; i < items.length; i++) {
            var it = items[i]
            if (it.dflag != undefined) { flags = flags + it.dflag; continue }
            if (it.dname != undefined) { names.push(it.dname); asgs.push(null) }
            else { names.push(it.a.name); asgs.push(it.a) }
        }
        var isArray = (flags.indexOf("a") >= 0) || (flags.indexOf("A") >= 0)
        var assoc = (flags.indexOf("A") >= 0)
        var upper = (flags.indexOf("u") >= 0)
        var lower = (flags.indexOf("l") >= 0)
        var integer = (flags.indexOf("i") >= 0)
        var global = (flags.indexOf("g") >= 0)
