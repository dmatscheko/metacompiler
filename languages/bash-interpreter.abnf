        for (i = 0; i < s.length; i++) { var cc = s.charCodeAt(i); if (cc < 48 || cc > 57) { return false } }
        return true
    }
    function joinParams(sep) {
        var out = ""
        var i
        for (i = 0; i < posParams.length; i++) { if (i > 0) { out = out + sep }; out = out + posParams[i] }
        return out
    }
