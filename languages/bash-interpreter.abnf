        if (cmd == "true" || cmd == ":") { setStatus(0); return 0 }
        // `cmd &` already ran to completion (see mkAsync), so there is never anything left
        // to wait for and no job list to print. LIMIT: `wait PID` answers 0 rather than the
        // job's real status, and `jobs` prints nothing.
        if (cmd == "wait") { setStatus(0); return 0 }
