    // items = [thunk] | [{iop,pre}, {lhs}] | [{lhs}, {iop,pre}]
    function mkIncDec(items) {
        var lhs = "", iop = "++", pre = 0
        var i
        for (i = 0; i < items.length; i++) {
            var it = items[i]
            if (it.lhs != undefined) { lhs = it.lhs } else { iop = it.iop; pre = it.pre }
        }
        return function() {
            var v = strToInt(getVarVal(lhs))
