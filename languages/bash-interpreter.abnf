                if (typeof r == "object") {
                    var sg = loopSignal(r)
                    if (sg == 0 || sg == 3) { return (sg == 3) ? loopOuter(r) : r }
                    last = sigStatus(r)
                    if (sg == 1) { k = vals.length }
                } else { last = r }
            }
            setStatus(last)
            return last
        })
    }

    // items = [{fname}, bodyThunk]. Registration happens when the statement runs.
    function makeFuncDef(items) {
        var fname = items[0].fname
        var bodyT = items[1]
        return function() {
            funcs["$" + fname] = bodyT
            setStatus(0)
            return 0
        }
    }

    // ---- run ----

    // Build all statement thunks, then run them top to bottom. The exit code of the whole
    // metacompiler run is the status of the last command (or an explicit exit N).
    // The {nl} marker a top-level separator run with a newline in it leaves (see Program).
    function pushLineEnd(t) {
        var i
        for (i = 0; i < t.length; i++) { if (t.charAt(i) == "\n") { push({nl: 1}); return } }
    }
    // The top-level items as lines of statements, each list folded by linkAsync.
    function splitLines(items) {
        var lines = [], cur = []
        var i
        for (i = 0; i < items.length; i++) {
            if (typeof items[i] != "function" && items[i].nl != undefined) { lines.push(linkAsync(cur)); cur = [] }
            else { cur.push(items[i]) }
        }
        lines.push(linkAsync(cur))
        return lines
    }
    function runProgram(items) {
        var lines = splitLines(items)
        var li
        var i
        var r = anytype
        for (li = 0; li < lines.length; li++) {
            var stmts = lines[li]
            for (i = 0; i < stmts.length; i++) {
                r = stmts[i]()
                if (typeof r == "object") {
                    // An expansion error abandons the rest of its line, with status 1.
                    if (r.soft != undefined) { setStatus(1); i = stmts.length; continue }
                    if (r.isExit != undefined) { setStatus(r.ret); runExitTrap(); flushErrTail(); exit(r.ret) }
                    setStatus(r.ret)
                }
            }
            r = takeAbort()
            if (r != null) {
                if (r.soft == undefined) { setStatus(r.ret); runExitTrap(); flushErrTail(); exit(r.ret) }
                setStatus(1)
            }
        }
        runExitTrap()
        // A `printf x >&2` with no trailing newline is still sitting in errBuf; hand it over
        // (see writeChan) rather than losing it.
        flushErrTail()
        exit(lastStatus)
    }

    c.compile(c.asg)

~~) ;
