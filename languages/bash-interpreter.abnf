                var ab = takeAbort()
                if (ab != null) {
                    if (ab.soft == undefined) { return ab }
                    r = 1
                    setStatus(1)
                }
            }
            return r
        }
    }
    function makeSeq(thunks) {
        return function() {
            var last = 0
            var r = anytype
            var i
            for (i = 0; i < thunks.length; i++) {
                eeDone = false
                r = thunks[i]()
                var done = eeDone
                eeDone = false
                if (typeof r == "object") { return r }
                last = r
                if (optErrExit && last != 0 && condDepth == 0 && !done) { return {ret: last, isExit: 1} }
            }
