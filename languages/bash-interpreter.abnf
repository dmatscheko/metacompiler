    // A shell NAME: a letter or underscore, then letters, digits and underscores. Twin of
    // isIdentText in bash-to-llvm-ir.abnf.
    function isIdentText(t) {
        if (t.length == 0) { return false }
        var i
        for (i = 0; i < t.length; i++) {
            var cc = t.charCodeAt(i)
            var al = (cc >= 97 && cc <= 122) || (cc >= 65 && cc <= 90) || cc == 95
            if (!al && !(i > 0 && cc >= 48 && cc <= 57)) { return false }
        }
        return true
    }

    // read [-r] [-a NAME] NAME... : one line of standard input, split on IFS, the last name
    // taking the rest. Returns 1 at end of file, exactly like the shell.
    function readBuiltin(args) {
        var names = []
        var arrName = null
        var i = 0
        while (i < args.length) {
            var a = args[i]
            if (a == "-a") { i = i + 1; if (i < args.length) { arrName = args[i] } }
            else if (a == "-d" || a == "-n" || a == "-N" || a == "-p" || a == "-t" || a == "-u") { i = i + 1 }
            else if (a.length > 1 && a.charAt(0) == "-") { }
            else { names.push(a) }
            i = i + 1
        }
        if (stdinPos >= stdinBuf.length) {
            var z
            for (z = 0; z < names.length; z++) { setVarVal(names[z], "") }
            // At end of file bash CLEARS what it would have set, REPLY included:
            // `REPLY=keep; read -r </dev/null; echo "[$REPLY]"` prints [].
            if (arrName == null && names.length == 0) { setVarVal("REPLY", "") }
            if (arrName != null) { arrFromList(arrName, false, []) }
            return 1
        }
        var e = stdinPos
        while (e < stdinBuf.length && stdinBuf.charAt(e) != "\n") { e = e + 1 }
        var line = stdinBuf.slice(stdinPos, e)
        stdinPos = (e < stdinBuf.length) ? (e + 1) : e
        var rec = splitIFSRec(line)
        var fields = rec.f
        if (arrName != null) {
            var svp = arPfx
            arPfx = "read: "
            arrFromList(arrName, false, fields)
            arPfx = svp
            return 0
        }
        if (names.length == 0) { setVarVal("REPLY", line); return 0 }
        var k
        for (k = 0; k < names.length; k++) {
            if (k == names.length - 1) {
                setVarVal(names[k], readRest(line, rec, k))
            } else {
                setVarVal(names[k], (k < fields.length) ? fields[k] : "")
            }
        }
        return 0
    }
    // WHAT THE LAST NAME OF A `read` GETS, which is not "the remaining fields joined":
    // `IFS=: read -r a b <<< "p::q:r:"` gives b=":q:r:" and `read -r a b <<< "  x   y   z  "`
    // gives b="y   z". The rule, checked against bash 5.3.15:
    //
    //   - EXACTLY ONE field left: that field, delimiters and all whitespace gone.
    //     `read -r a <<< "  only  "` is "only"; `IFS=: read -r a b <<< "p:q:"` is "q".
    //   - TWO OR MORE: the RAW text from the start of that field to the end of the line,
    //     less trailing IFS WHITESPACE only. `IFS=: read -r a <<< "p:q:"` keeps its
    //     trailing colon; `IFS=: read -r a b <<< ":a:b:"` is "a:b:"; and an IFS that does
    //     not contain the space leaves a trailing space alone ("a::: " -> ":: ").
    //   - NONE: the empty string.
    //
    // Twin: rt_field in languages/lib/bash-rt.c.
    function readRest(line, rec, k) {
        if (k >= rec.f.length) { return "" }
        if (rec.f.length - k <= 1) { return rec.f[k] }
        var seps = isSetVar("IFS") ? vars["$IFS"] : " \t\n"
        var s = rec.s[k]
        var t = line.length
        while (t > s && ifsIsWs(seps, line.charAt(t - 1))) { t = t - 1 }
        return line.slice(s, t)
    }
    // FIELD SPLITTING, with the POSIX delimiter rule (POSIX 2.6.5): `IFS=:` on "a:b::c" is
    // FOUR fields (the third empty), ":a:" is two, and `IFS=" :"` on "a : b::c" is four.
    //
    // A character of IFS that is space, tab
    // or newline is IFS WHITESPACE and a RUN of it is one delimiter, ignored entirely at the
    // ends of the value; any other character of IFS delimits exactly ONE field on its own,
    // so two of them in a row leave an empty field between them. A delimiter is therefore
    // "optional IFS whitespace, then at most one non-whitespace IFS character, then optional
    // IFS whitespace" - which is also why a TRAILING non-whitespace delimiter adds nothing
    // ("a:" is one field) while a LEADING one adds an empty first field.
    //
    // Twin: rt_splitifs in languages/lib/bash-rt.c.
    function ifsIsWs(seps, ch) {
        if (ch != " " && ch != "\t" && ch != "\n") { return false }
        return ifsHas(seps, ch)
    }
    function ifsHas(seps, ch) {
        var j
        for (j = 0; j < seps.length; j++) { if (seps.charAt(j) == ch) { return true } }
        return false
    }
    function splitIFS(line) { return splitIFSRec(line).f }
    // The same walk, also reporting where each field STARTS in the line. `read`'s last name
    // needs the raw text from one field's start (readRest), and nothing else does, so the
    // offsets ride along rather than being recomputed by a second walk.
    function splitIFSRec(line) {
        var seps = isSetVar("IFS") ? vars["$IFS"] : " \t\n"
        var out = []
        var starts = []
        var i = 0
        while (i < line.length && ifsIsWs(seps, chunkAt(line, i))) { i = i + chunkAt(line, i).length }
        while (i < line.length) {
            var cur = ""
            starts.push(i)
            while (i < line.length && !ifsHas(seps, chunkAt(line, i))) {
                var ch = chunkAt(line, i)
                cur = cur + ch
                i = i + ch.length
            }
            out.push(cur)
            while (i < line.length && ifsIsWs(seps, chunkAt(line, i))) { i = i + chunkAt(line, i).length }
            if (i < line.length && ifsHas(seps, chunkAt(line, i))) {
                i = i + chunkAt(line, i).length
                while (i < line.length && ifsIsWs(seps, chunkAt(line, i))) { i = i + chunkAt(line, i).length }
            }
        }
        return {f: out, s: starts}
    }

    // An echo option word is "-" and one or more of n e E (`-en` = `-e -n`); answers its
    // letters, or "" for an ordinary word. Twin of echo_flags in languages/lib/bash-rt.c
    // and of the constant scan in emitEcho.
    function echoFlags(a) {
        if (a.length < 2 || a.charAt(0) != "-") { return "" }
        var j
        for (j = 1; j < a.length; j++) {
            var f = a.charAt(j)
            if (f != "n" && f != "e" && f != "E") { return "" }
        }
        return a.slice(1)
    }
    function echoCmd(args) {
        var i = 0
        var newline = true
        var escapes = false
        var flagging = true
        while (flagging && i < args.length) {
            var fl = echoFlags(args[i])
            if (fl == "") { flagging = false } else {
                var j
                for (j = 0; j < fl.length; j++) {
                    var f = fl.charAt(j)
                    if (f == "n") { newline = false } else { escapes = (f == "e") }
                }
                i = i + 1
            }
        }
        var out = ""
        var first = true
        pf.stop = false
        while (i < args.length) {
            if (!first) { out = out + " " }
            out = out + (escapes ? pfBstr(args[i], 2) : args[i])
            // \c ends all further output, the newline included. Twin of rt_echo.
            if (pf.stop) { emitOut(normBytes(out)); return }
            first = false
            i = i + 1
        }
        if (newline) { out = out + "\n" }
        emitOut(normBytes(out))
    }

    // ---- the test builtin -------------------------------------------------------------
    // There is no real filesystem behind a grammar run, so the file predicates answer from a
    // small MODEL of the standard paths every shell can rely on. Anything else is "absent".
    //
    // Why not a real stat(): a native binary could call it (bash-rt.c links libc), but the
    // other two engines cannot - the tag-script host running this half has no filesystem
    // API, and llvm.Run's libcExterns (abnf/llvmmap.go) only lists what the IR interpreter
    // implements EXACTLY, which a stat struct is not. A stat() in one engine of three would
    // be a designed-in halves divergence.
    //
    // The model, checked with bash 5.3.15 (`test OP PATH`):
    //     /dev/null /dev/zero /dev/tty        -e -r -w -c      (character devices)
    //     / /dev /usr /bin /usr/bin           -e -d -s -r -x
    //     anything else                       nothing
    // /tmp, /etc and /var are -h -L as well on darwin (symlinks) but not on Linux, so the
    // model does NOT claim it. /dev/stdin, /dev/stdout and /dev/stderr follow the process's
    // fds in reality, and are modelled as the character devices they are on a terminal.
    //
    // Deliberate divergences: -f on a REAL regular file is false here, and -w answers "it
    // exists", so the system directories read as writable where bash (non-root) says no -
    // modelling that would mean modelling a uid.
    // 0 = absent, 1 = regular file, 2 = directory, 3 = character device.
    function fsKind(p) {
        if (p == "/dev/null" || p == "/dev/zero" || p == "/dev/tty") { return 3 }
        if (p == "/dev/stdin" || p == "/dev/stdout" || p == "/dev/stderr") { return 3 }
        if (p == "/" || p == "/dev" || p == "/tmp" || p == "/usr" || p == "/etc") { return 2 }
        if (p == "/var" || p == "/bin" || p == "/usr/bin") { return 2 }
        return 0
    }

    // "name" or "name[key]" - the form `unset a[0]` and `[[ -v a[k] ]]` use.
    function splitSubscript(s0) {
        var i
        for (i = 0; i < s0.length; i++) {
            if (s0.charAt(i) == "[" && s0.charAt(s0.length - 1) == "]") {
                return {name: s0.slice(0, i), key: s0.slice(i + 1, s0.length - 1)}
            }
        }
        return {name: s0, key: null}
    }
    function isTestUnary(t) {
        if (t == "-z" || t == "-n" || t == "-v") { return true }
        if (t == "-e" || t == "-f" || t == "-d" || t == "-s" || t == "-r" || t == "-w") { return true }
        if (t == "-x" || t == "-h" || t == "-L" || t == "-b" || t == "-c" || t == "-p") { return true }
        if (t == "-S" || t == "-t" || t == "-g" || t == "-u" || t == "-k" || t == "-O") { return true }
        return false
    }
    function isTestBinary(t) {
        if (t == "=" || t == "==" || t == "!=" || t == "<" || t == ">") { return true }
        if (t == "-eq" || t == "-ne" || t == "-lt" || t == "-le" || t == "-gt" || t == "-ge") { return true }
        if (t == "-nt" || t == "-ot" || t == "-ef") { return true }
        return false
    }
    function testUnary(op, s) {
        if (op == "-z") { return (s == "") ? 0 : 1 }
        if (op == "-n") { return (s != "") ? 0 : 1 }
        if (op == "-v") {
            var sp = splitSubscript(s)
            if (sp.key != null) { return arrHas(sp.name, subKey(sp.name, sp.key)) ? 0 : 1 }
            return (isSetVar(s) || isArr(s)) ? 0 : 1
        }
        // See fsKind for the model and for why stat() was declined. -s is "exists and has a
        // nonzero size", which a directory has and a character device does not; -x is
        // "searchable/executable", which is true of the model's directories and unknowable
        // for anything else; -b, -p, -S, -h, -L, -g, -u, -k, -O and -t are all false,
        // because the model has no block device, no fifo, no socket and no symlink.
        if (op == "-d") { return (fsKind(s) == 2) ? 0 : 1 }
        if (op == "-e" || op == "-r" || op == "-w") { return (fsKind(s) != 0) ? 0 : 1 }
        if (op == "-f") { return (fsKind(s) == 1) ? 0 : 1 }
        if (op == "-s") { return (fsKind(s) == 1 || fsKind(s) == 2) ? 0 : 1 }
        if (op == "-x") { return (fsKind(s) == 2) ? 0 : 1 }
        if (op == "-c") { return (fsKind(s) == 3) ? 0 : 1 }
        return 1
    }
    var testNumOps = {"-eq": "==", "-ne": "!=", "-lt": "<", "-le": "<=", "-gt": ">", "-ge": ">="}
    function testBinary(l, op, r) {
        if (hasOwn(testNumOps, op)) { return arIsZero(arOp(testNumOps[op], arStr(l), arStr(r))) ? 1 : 0 }
        if (op == "=" || op == "==") { return (l == r) ? 0 : 1 }
        if (op == "!=") { return (l != r) ? 0 : 1 }
        if (op == "<") { return (l < r) ? 0 : 1 }
        if (op == ">") { return (l > r) ? 0 : 1 }
        fail("unknown binary test operator: " + op)
        return 2
    }

    // A recursive descent over the ARGUMENT LIST: or := and { -o and }, and := not { -a not },
    // not := "!" not | prim, prim := "(" or ")" | UNOP word | word [ BINOP word ] | word.
    function tstAt(a, st) { return (st.i < a.length) ? a[st.i] : "\x00end" }
    function tstPrim(a, st) {
        var t = tstAt(a, st)
        if (t == "(") {
            st.i = st.i + 1
            var r = tstOr(a, st)
            if (tstAt(a, st) == ")") { st.i = st.i + 1 }
            return r
        }
        if (t == "!") { st.i = st.i + 1; var r2 = tstPrim(a, st); return (r2 == 0) ? 1 : 0 }
        if (isTestUnary(t) && st.i + 1 < a.length && !isTestBinary(a[st.i + 1])) {
            var opnd = a[st.i + 1]
            st.i = st.i + 2
            return testUnary(t, opnd)
        }
        st.i = st.i + 1
        if (st.i + 1 < a.length + 0 && isTestBinary(tstAt(a, st))) {
            var op = tstAt(a, st)
            var rhs = a[st.i + 1]
            st.i = st.i + 2
            return testBinary(t, op, rhs)
        }
        return (t != "") ? 0 : 1
    }
    function tstAnd(a, st) {
        var v = tstPrim(a, st)
        while (tstAt(a, st) == "-a") { st.i = st.i + 1; var r = tstPrim(a, st); if (r != 0) { v = 1 } }
        return v
    }
    function tstOr(a, st) {
        var v = tstAnd(a, st)
        while (tstAt(a, st) == "-o") { st.i = st.i + 1; var r = tstAnd(a, st); if (r == 0) { v = 0 } }
        return v
    }

    // The test builtin: [ ... ] (drops the closing ]) or `test ...`.
    function testBuiltin(cmd, argsIn) {
        var a = argsIn
        if (cmd == "[") {
            if (a.length == 0 || a[a.length - 1] != "]") { fail("[ used without the closing ]") }
            a = a.slice(0, a.length - 1)
        }
        if (a.length == 0) { return 1 }
        if (a.length == 1) { return (a[0] != "") ? 0 : 1 }
        var st = {i: 0}
        return tstOr(a, st)
    }

    // Dispatch a command by its (already expanded) name. Returns an int status, or {ret: n}
    // for the return builtin; exit terminates the whole run immediately.
    function runCommand(cmd, args) {
        if (cmd == "echo") { echoCmd(args); setStatus(0); return 0 }
        if (cmd == "[" || cmd == "test") { var st = testBuiltin(cmd, args); setStatus(st); return st }
        if (cmd == "true" || cmd == ":") { setStatus(0); return 0 }
        // `cmd &` already ran to completion (see mkAsync), so there is never anything left
        // to wait for and no job list to print. LIMIT: `wait PID` answers 0 rather than the
        // job's real status, and `jobs` prints nothing.
        if (cmd == "wait") { setStatus(0); return 0 }
        // `shopt` knows extglob (-s / -u / -q); every other option is accepted and reported
        // as success, and a -q query of one answers "on". Twin of emitShopt.
        if (cmd == "shopt") {
            var sflag = "", si2, sst = 0
            for (si2 = 0; si2 < args.length; si2++) {
                var sa = args[si2]
                if (sa == "-s" || sa == "-u" || sa == "-q") { sflag = sa }
                else if (sa == "extglob") {
                    if (sflag == "-s") { optExtglob = true }
                    if (sflag == "-u") { optExtglob = false }
                    if (sflag == "-q" && !optExtglob) { sst = 1 }
                }
            }
            setStatus(sst)
            return sst
        }
        if (cmd == "unset") {
            var ui
            var ust = 0
            for (ui = 0; ui < args.length; ui++) {
                var sp = splitSubscript(args[ui])
                if (sp.key == null) {
                    if (localHere(sp.name) || !unsetCallerLocal(sp.name)) {
                        unsetVar(sp.name); arrs[arrKey(sp.name)] = null; dropAttrs(sp.name)
                        if (localHere(sp.name)) { dclVars["$" + sp.name] = true }
                    }
                }
                else if (unsetElem(sp.name, sp.key) != 0) { ust = 1 }
            }
            setStatus(ust)
            return ust
        }
        if (cmd == "false") { setStatus(1); return 1 }
        // `break N` / `continue N` past the loops there are act on the outermost one; outside
        // any loop they only complain; a level below 1 is an error that leaves EVERY loop.
        if (cmd == "break" || cmd == "continue") {
            var lv = (args.length > 0) ? strToInt(args[0]) : 1
            if (loopDepth == 0) {
                emitErr("bash: " + cmd + ": only meaningful in a `for', `while', or `until' loop\n")
                setStatus(0)
                return 0
            }
            if (lv < 1) {
                emitErr("bash: " + cmd + ": " + args[0] + ": loop count out of range\n")
                setStatus(1)
                return {brk: loopDepth, bst: 1}
            }
            if (lv > loopDepth) { lv = loopDepth }
            return (cmd == "break") ? {brk: lv} : {cont: lv}
        }
        if (cmd == "set") { return setBuiltin(args) }
        if (cmd == "trap") {
            // trap 'CODE' EXIT : only the EXIT trap is modelled. The code is re-parsed with
            // this grammar's own parser, exactly like eval.
            if (args.length > 0 && args[0] != "" && args[0] != "-") { exitTrap = compileSnippet(args[0]) }
            else { exitTrap = null }
            setStatus(0)
            return 0
        }
        if (cmd == "eval") {
            var src = ""
            var ei
            for (ei = 0; ei < args.length; ei++) { if (ei > 0) { src = src + " " }; src = src + args[ei] }
            if (src == "") { setStatus(0); return 0 }
            var et = compileSnippet(src)
            var er = anytype
            er = et()
            if (typeof er == "object") { return er }
            setStatus(er)
            return er
        }
        if (cmd == "printf") { var pst = printfBuiltin(args); setStatus(pst); return pst }
        if (cmd == "mapfile" || cmd == "readarray") {
            var mst = anytype
            mst = mapfileBuiltin(cmd, args)
            if (typeof mst == "object") { return mst }
            var mab = takeAbort()
            if (mab != null) { setStatus(1); return mab }
            setStatus(mst)
            return mst
        }
        // An element that is an -i arithmetic error abandons the line, as an expansion
        // error does.
        if (cmd == "read") {
            var rst = readBuiltin(args)
            var rab = takeAbort()
            if (rab != null) { setStatus(1); return rab }
            setStatus(rst)
            return rst
        }
        if (cmd == "shift") {
            var n = (args.length > 0) ? strToInt(args[0]) : 1
            posParams = (n <= posParams.length) ? posParams.slice(n) : []
            setStatus(0)
            return 0
        }
        if (cmd == "exit") {
            var code = (args.length > 0) ? (arPair(arStr(args[0])).l & 255) : lastStatus
            return {ret: code, isExit: 1}
        }
        if (cmd == "return") {
            // `return N` and `exit N` are N modulo 256: 300 is 44, -1 is 255.
            var rc = (args.length > 0) ? (arPair(arStr(args[0])).l & 255) : lastStatus
            return {ret: rc}
        }
        var key = "$" + cmd
        if (hasOwn(funcs, key)) {
            var st2 = anytype
            st2 = callFunc(cmd, args)
            if (typeof st2 == "object") { return st2 }
            setStatus(st2)
            return st2
        }
        // A SHELL DIAGNOSTIC, NOT AN ENGINE DIAGNOSTIC: all three engines print
        // `<script>: command not found: NAME` and exit 127, as bash exits 127. The word order
        // differs from bash's `<script>: line N: NAME: command not found`, which needs a line
        // number no engine here carries to run time; and this STOPS, where bash would carry on.
        println(scriptName + ": command not found: " + cmd)
        exit(127)
        return 127
    }

    // Call a user function: bind $1.. to args, run the body, restore, return its status.
    function callFunc(name, args) {
        var body = funcs["$" + name]
        var saved = posParams
        var savedLoops = loopDepth
        posParams = args
        loopDepth = 0
        pushLocalFrame()
        declareLocal("FUNCNAME")
        setVarVal("FUNCNAME", name)
        var r = anytype
        r = body()
        popLocalFrame()
        posParams = saved
        loopDepth = savedLoops
        if (typeof r == "object") {
            if (r.isExit != undefined) { return r }   // an exit unwinds past the caller too
            return r.ret
        }
        return r
    }

    // cmd1 && cmd2 || cmd3 : short circuit on the running status; a {ret} unwinds at once.
    function makeAndOr(items) {
        if (items.length == 1) { return items[0] }
        return function() {
            var st = anytype
            // Every element but the last runs as a condition, so set -e does not fire on it.
            st = runCond(items[0])
            if (typeof st == "object") { return st }
            var i
            for (i = 1; i < items.length; i += 2) {
                var op = items[i].op
                var runIt = (op == "&&") ? (st == 0) : (st != 0)
                if (runIt) {
                    var isLast = (i + 2 >= items.length)
                    st = isLast ? items[i + 1]() : runCond(items[i + 1])
                    if (typeof st == "object") { return st }
                }
            }
            return st
        }
    }

    // `cmd &` : the parser leaves an {amp} marker AFTER the statement it applies to, so a
    // statement list is a mix of thunks and markers. linkAsync folds the markers away and
    // hands back a list of plain thunks, which is what makeSeq / runProgram expect.
    function linkAsync(items) {
        var out = []
        var i
        for (i = 0; i < items.length; i++) {
            if (typeof items[i] == "function") { out.push(items[i]) }
            else if (out.length > 0) { out[out.length - 1] = mkAsync(out[out.length - 1]) }
        }
        return out
    }
    // LIMIT, and a deliberate one: there is no second process behind a grammar run, so an
    // asynchronous statement is run to completion HERE, in a subshell copy of the shell
    // state, and reports status 0 immediately - which is what a real `cmd & wait` pair
    // observes. What it cannot model is overlap: `sleep 1 & echo hi` prints "hi" after the
    // sleep, not before it. $! answers a fresh, monotonically increasing fake pid.
    var lastBgPid = 0
    function mkAsync(t) {
        return function() {
            lastBgPid = lastBgPid + 1
            var saved = saveShellState()
            localFrames = []
            var r = anytype
            r = t()
            restoreShellState(saved)
            setStatus(0)
            return 0
        }
    }

    // A statement sequence: the value is the last statement's status; a {ret} unwinds.
    function makeSeq(thunks) {
        return function() {
            var last = 0
            var r = anytype
            var i
            for (i = 0; i < thunks.length; i++) {
                r = thunks[i]()
                if (typeof r == "object") { return r }
                last = r
                // set -e: leave on the first failing command, unless it is a CONDITION.
