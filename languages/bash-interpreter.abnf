    // ---- the pattern based ${...} forms, all built on the glob matcher ----

    // Shortest / longest prefix or suffix of v that matches pat, removed.
    function stripPat(v, pat, isPrefix, longest) {
        var n = v.length
        var t = 0
        while (t <= n) {
            var k = (longest == isPrefix) ? (n - t) : t
            var cand = isPrefix ? v.slice(0, k) : v.slice(k)
            if (globMatch(pat, cand)) { return isPrefix ? v.slice(k) : v.slice(0, k) }
            t = t + 1
