    // The same matcher backs case, [[ == ]] and the ${v#pat} family, exactly like the shell.

    // --- extended globs: @(a|b) ?(a|b) *(a|b) +(a|b) !(a|b) ---------------------------
    // Index just past the ")" that closes the "(" at p[pi], honouring nesting and escapes.
    function egEnd(p, pi) {
        var d = 0
        var j = pi
        while (j < p.length) {
            var c = p.charAt(j)
            if (c == "\\") { j = j + 2; continue }
            if (c == "(") { d = d + 1 }
