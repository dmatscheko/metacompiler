            setStatus(ust)
            return ust
        }
        if (cmd == "false") { setStatus(1); return 1 }
        // `break N` / `continue N` past the loops there are act on the outermost one; outside
        // any loop they only complain; a level below 1 is an error that leaves EVERY loop.
        if (cmd == "break" || cmd == "continue") {
            var lv = (args.length > 0) ? strToInt(args[0]) : 1
            if (loopDepth == 0) {
                diagErr(cmd + ": only meaningful in a `for', `while', or `until' loop\n")
                setStatus(0)
                return 0
            }
            if (lv < 1) {
