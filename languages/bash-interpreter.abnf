        for (wi = 0; wi < pat.length; wi++) { if (pat.charCodeAt(wi) >= 128) { pw = wi } }
        for (wi = 0; wi < v.length; wi++) { if (v.charCodeAt(wi) >= 128) { vw = wi } }
        if (pat != "" && !patAnywhere(pat, v, 0, mode, pw >= 0 || vw >= 0)) { return v }
