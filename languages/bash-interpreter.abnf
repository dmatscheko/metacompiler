        if (pe == "len") { return function() { return numToStr(charLen(getVarVal(name))) } }
        if (pe == "ind") { return function() { var it = indName(name, null, null); return (it == null) ? "" : indVal(it) } }
        // ${!prefix*} and ${!prefix@} answer the NAMES of the set variables with that prefix,
        // in sorted order. Measured: `Zq=1; Zw=2; echo "${!Z*}"` -> "Zq Zw".
        if (pfx != "") {
            var pfxName = name
            var pfxAt = (pfx.charAt(pfx.length - 1) == "@")
            return function() {
                var ks = varNamesWithPrefix(pfxName)
