        return function() {
            var tn = nameOf()
            var v = (tn == null) ? "" : getVarVal(tn)
            var colon = (op.charAt(0) == ":")
            var o = colon ? op.slice(1) : op
            var blank = (tn == null) || (colon ? (!isSetVar(tn) || v == "") : !isSetVar(tn))
            if (o == "-") { return blank ? dfltWord(wordT) : v }
            if (o == "+") { return blank ? "" : dfltWord(wordT) }
            if (o == "=") {
                if (blank) { var d = (wordT != null) ? wordJoin(wordT()) : ""; if (tn != null) { setVarVal(tn, d) }; return d }
                return v
            }
            if (o == "?") {
