    // bash's strings are BYTES, these are characters. A byte that is not part of a UTF-8
    // character - $'\xff', printf '\303', the first byte %c takes of "é" - is held as the
    // lone surrogate U+DC80..U+DCFF (Python's surrogateescape): one character, one byte, and
    // writeChan writes it back as that byte. rawSeen keeps the output path from scanning for
    // one until one has been made. The compiled half's strings are bytes already.
    var rawSeen = false
    // A NUL byte exists only on its way out of printf / echo -e (pfChr): written to the
    // output, dropped by a command substitution, the end of a printf -v value.
    var nulSeen = false
    var capNul = {}       // capture depth -> a NUL was dropped there (mkCmdSub warns)
    function dropNul(s) {
        var out = ""
        var i
        for (i = 0; i < s.length; i++) { if (s.charCodeAt(i) != 0) { out = out + s.charAt(i) } }
        return out
    }
