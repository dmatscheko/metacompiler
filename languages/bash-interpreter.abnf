        if (name == "?") { return numToStr(lastStatus) }
        // There is no process behind a grammar run, so $$ and $! are fixed, documented values.
        if (name == "$") { return "1000" }
        if (name == "!") { return "0" }
        if (name == "-") { return "hB" }
        if (name == "#") { return numToStr(posParams.length) }
        if (name == "*") { return joinParams(ifsFirst()) }
        if (name == "@") { return encFields(posParams) }
        if (allDigits(name)) {
            var idx = strToInt(name)
            if (idx == 0) { return "bash" }
            if (idx <= posParams.length) { return posParams[idx - 1] }
            return ""
        }
        if (isArr(name)) { return arrGet(name, "0") }
