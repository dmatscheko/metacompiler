    }

    function sliceStr(v, offT, lenT) {
        var off = offT()
        if (off < 0) { off = v.length + off; if (off < 0) { off = 0 } }
        if (off > v.length) { return "" }
        if (lenT == null) { return v.slice(off) }
        var ln = lenT()
        if (ln < 0) {
            var end = v.length + ln
            if (end < off) { return "" }
            return v.slice(off, end)
