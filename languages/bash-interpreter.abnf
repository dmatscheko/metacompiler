    }

    function mkWord(segThunks) {
        var canSplit = false
        var i
        for (i = 0; i < segThunks.length; i++) { if (typeof segThunks[i] != "function") { canSplit = true } }
        if (!canSplit) {
            return function() {
                var out = ""
                var k
                for (k = 0; k < segThunks.length; k++) { out = out + segThunks[k]() }
                return out
            }
        }
        return function() {
            var res = [""]
            var hadLiteral = false
            var k
            for (k = 0; k < segThunks.length; k++) {
                var sg = segThunks[k]
                var f = anytype
                if (typeof sg == "function") { hadLiteral = true; f = [sg()] }
                else {
                    var v = sg.sp()
                    f = isFields(v) ? decFields(v) : splitIFS(v)
