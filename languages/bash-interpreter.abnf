    var stdinPos = 0

    // Shell options (set -e / -u / -o pipefail) and the EXIT trap. They are part of the
    // subshell state, so ( ) and $( ) save and restore them along with the variables.
    var optErrExit = false
    var optNounset = false
    var optPipefail = false
    var exitTrap = null      // a statement thunk, or null
    var condDepth = 0        // >0 while a command runs as a CONDITION (set -e does not fire)
    var abortSignal = null   // set by a set -u or ${v:?} failure during expansion

    // $0 and the prefix on every diagnostic: the program's own path, exactly as this
    // process was given it, which is what a real shell answers.
    var scriptName = c.file

    // There is no process environment behind a grammar run, so the few variables a script may
    // reasonably expect to exist get a fixed, documented default.
    vars["$HOME"] = "/home/user"; varsHas["$HOME"] = true; varNames.push("HOME")
    vars["$PWD"] = "/home/user"; varsHas["$PWD"] = true; varNames.push("PWD")
