        if (o.badNum != null) { diagErr("read: " + o.badNum + ": invalid number\n"); return 1 }
        if (names.length > 0 && !bashIsRef(names[0])) { diagErr("read: `" + names[0] + "': not a valid identifier\n"); return 1 }
        // A readonly target, once the record is read: the array or the last name fails the
