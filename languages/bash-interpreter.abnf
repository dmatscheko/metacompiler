            var n = 0
            var cp = 0
            if (b0 >= 194 && b0 <= 223) { n = 1; cp = b0 - 192 }
            else if (b0 >= 224 && b0 <= 239) { n = 2; cp = b0 - 224 }
            else if (b0 >= 240 && b0 <= 244) { n = 3; cp = b0 - 240 }
            var k = 1
            while (k <= n && i + k < bs.length && bs[i + k] >= 128 && bs[i + k] <= 191) { cp = cp * 64 + (bs[i + k] - 128); k = k + 1 }
            var ok = n > 0 && k == n + 1 && !(n == 2 && (cp < 2048 || (cp >= 55296 && cp <= 57343))) && !(n == 3 && (cp < 65536 || cp > 1114111))
            if (b0 < 128) { out = out + String.fromCharCode(b0); i = i + 1 }
