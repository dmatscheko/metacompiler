    // ended it}. Nothing left at all is an empty record, and so is -n 0, which reads nothing.
    //
    // Without -r a backslash quotes the character after it and is dropped, and a
    // backslash-newline is dropped whole, the record going on past it, with any delimiter;
    // a backslash that ends the input is dropped. A quoted character delimits no field,
    // which the record keeps by a "\x01" before it, as bash's CTLESC; a "\x01" of the input
    // is quoted the same way, so that readFields can take every one away. The count is of
    // the characters the record keeps: a quoted one counts, its backslash does not, and
    // neither does a backslash-newline. Twin of rt_read_line in languages/lib/bash-rt.c.
    function readRec(raw, dlm, nch) {
        var n = stdinBuf.length
        var p = stdinPos
        var t = ""
        var seg = p
        var eof = true
        var got = 0
        var full = false
        while (p < n) {
            if (got == nch) { full = true; break }
            var ch = stdinBuf.charAt(p)
            if (ch == dlm) { eof = false; break }
            if (raw || (ch != "\\" && ch != "\x01")) { got = got + 1; p = p + 1; continue }
            t = t + stdinBuf.slice(seg, p)
            p = p + 1
            if (ch == "\\") {
