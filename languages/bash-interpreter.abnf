            // this grammar's own parser, exactly like eval; '' sets a trap that runs nothing,
            // - removes it. A bare `trap` lists it the way bash prints it.
            if (args.length == 0) {
                if (exitTrap != null) { emitOut("trap -- " + shellQuote(exitTrapSrc) + " EXIT\n") }
            }
            else if (args[0] != "-") { exitTrap = compileSnippet(args[0], 1, true); exitTrapSrc = args[0] }
            else { exitTrap = null }
            setStatus(0)
            return 0
        }
        if (cmd == "eval") {
            var src = ""
            var ei
            if (args.length > 0 && args[0] == "--") { args = args.slice(1) }
            for (ei = 0; ei < args.length; ei++) { if (ei > 0) { src = src + " " }; src = src + args[ei] }
            if (src == "") { setStatus(0); return 0 }
            var et = compileSnippet(src, 0, true)
            var er = anytype
            er = et()
            if (typeof er == "object") { return er }
            setStatus(er)
            return er
        }
        if (cmd == "printf") {
            var pst = printfBuiltin(args)
            var pab = takeAbort()
            if (pab != null) { setStatus(1); return pab }
            setStatus(pst)
            return pst
        }
        if (cmd == "mapfile" || cmd == "readarray") {
            var mst = anytype
            mst = mapfileBuiltin(cmd, args)
            if (typeof mst == "object") { return mst }
            var mab = takeAbort()
            if (mab != null) { setStatus(1); return mab }
            setStatus(mst)
            return mst
        }
        // An element that is an -i arithmetic error abandons the line, as an expansion
        // error does.
        if (cmd == "read") {
            var rst = readBuiltin(args)
            var rab = takeAbort()
            if (rab != null) { setStatus(1); return rab }
            setStatus(rst)
            return rst
        }
        // `exec` with neither a command nor a redirection does nothing.
        if (cmd == "exec" && args.length == 0) { setStatus(0); return 0 }
        if (cmd == "shift") {
            var n = (args.length > 0) ? strToInt(args[0]) : 1
            posParams = (n <= posParams.length) ? posParams.slice(n) : []
            setStatus(0)
            return 0
        }
        if (cmd == "exit") {
            var code = (args.length > 0) ? (arPair(arStr(args[0])).l & 255) : lastStatus
            return {ret: code, isExit: 1}
