                if (sa == "-s" || sa == "-u" || sa == "-q") { sflag = sa }
                else if (sa == "extglob") {
                    if (sflag == "-s") { optExtglob = true }
                    if (sflag == "-u") { optExtglob = false }
                    if (sflag == "-q" && !optExtglob) { sst = 1 }
