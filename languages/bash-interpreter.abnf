    // Make every glob metacharacter of s literal (a quoted pattern part).
    function globEscape(s) {
        var out = ""
        var i = 0
        while (i < s.length) {
            var ch = chunkAt(s, i)
            i = i + ch.length
            if (ch == "*" || ch == "?" || ch == "[" || ch == "]" || ch == "\\") { out = out + "\\" }
            out = out + ch
        }
        return out
    }
    function mkQuotedPat(t) { return function() { return globEscape(wordJoin(t())) } }
    // Make every ERE metacharacter of s literal (a quoted part of a =~ regex). Twin of
    // rt_rxescape.
    function regexEscape(s) {
        var out = ""
        var i = 0
        while (i < s.length) {
            var ch = chunkAt(s, i)
            i = i + ch.length
            if (ch.length == 1 && "\\.[]()*+?{}|^$".indexOf(ch) >= 0) { out = out + "\\" }
            out = out + ch
        }
        return out
    }
    function mkQuotedRx(t) { return function() { return regexEscape(wordJoin(t())) } }
    // A quoted part of a ${v/p/r} replacement: its "&" and "\" are literal. Twin of
    // rt_repescape.
    function repEscape(s) {
        var out = ""
        var i
        for (i = 0; i < s.length; i++) {
            var ch = s.charAt(i)
            if (ch == "&" || ch == "\\") { out = out + "\\" }
            out = out + ch
        }
        return out
    }
    function mkQuotedRep(t) { return function() { return repEscape(wordJoin(t())) } }
    // The replacement with the matched text m for every unquoted "&": "\&" and "\\" are a
    // literal & and \, a backslash before anything else is itself. Twin of rt_repsub.
    function repSubst(r, m) {
        var out = ""
        var i = 0
        while (i < r.length) {
            var ch = r.charAt(i)
            var nx = (i + 1 < r.length) ? r.charAt(i + 1) : ""
            if (ch == "\\" && (nx == "&" || nx == "\\")) { out = out + nx; i = i + 2 }
            else if (ch == "&") { out = out + m; i = i + 1 }
            else { out = out + ch; i = i + 1 }
        }
        return out
    }

    function mkCondBin(items) {
        var l = items[0], op = items[1].cop, r = items[2]
        return function() {
            var lv = condWord(l)
            var rv = condWord(r)
            // == and != glob-match their right hand side inside [[ ]]; = is a synonym of ==.
            if (op == "==" || op == "=") { return globMatchX(rv, lv) }
            if (op == "!=") { return !globMatchX(rv, lv) }
            // The numeric tests evaluate BOTH sides as arithmetic expressions inside [[ ]]
            // ([[ 2+3 -eq 5 ]], [[ 010 -eq 8 ]], [[ x -eq 4 ]]), where test / [ want integers.
            if (hasOwn(testNumOps, op)) {
                var svp = arPfx
                arPfx = "[[: "
                var al = arEval(lv)
                var ar = arEval(rv)
                arPfx = svp
                return arOp(testNumOps[op], al, ar) == 1
            }
            return testBinary(lv, op, rv) == 0
        }
    }

    // Redirection: without a filesystem, an output redirection DISCARDS the output and an
    // input redirection other than a here-string yields end of file at once.
    function mkRedir(items) {
        var op = "", fd = "", t = null
        var i
        for (i = 0; i < items.length; i++) {
            var it = items[i]
            if (typeof it == "function") { t = it }
            else if (it.redir != undefined) { op = it.redir }
            else if (it.iofd != undefined) { fd = it.iofd }
        }
        return {rd: op, iofd: fd, target: t}
    }

    // <<DELIM / <<-DELIM: the token HdScan read, `<<`, the delimiter word as written, and the
    // body between \x02 and \x03; at is the offset just past it. A delimiter quoted in any
    // way (<<'E' <<"E" <<\E <<E\F) makes the body literal. Twin of mkHereDoc in
    // bash-to-llvm-ir.abnf.
    function mkHereDoc(text, at) {
        var i = 2
        var dashed = false
        if (text.charAt(i) == "-") { dashed = true; i = i + 1 }
        var b0 = text.indexOf("\x02")
        var w = text.slice(i, b0)
