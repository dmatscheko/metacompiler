    // THE TARGET OF AN INDIRECTION ${!REF...}: REF's value, which has to name a variable - a
    // NAME, NAME[SUB], a positional or a special parameter (isRefName). REF is the variable
    // `name`, or with a subscript (sub its key, raw its text) that element, or for @ / * the
    // elements joined. bash 5.3: an unset REF is "REF: invalid indirect expansion" - for
    // NAME[SUB] only when NAME is no variable at all, an unset element or an empty array being
    // an unset target - and a value that is no name, the empty one included, is "VALUE:
    // invalid variable name"; either abandons the line as an expansion error does. The answer
    // is null for an unset target or after an error. Twin of rt_indname / rt_indsub in
    // languages/lib/bash-rt.c.
    function indName(name, sub, raw) {
        var v = ""
        if (sub == null) {
            var special = !isIdentText(name) && !allDigits(name)
            if (!special && !isArr(name) && !isSetVar(name)) { return indFail(name + ": invalid indirect expansion") }
            v = getVarVal(name)
        } else {
            if (!isArr(name) && !isSetVar(name) && !attrOn(dclVars, name)) {
                return indFail(name + "[" + raw + "]: invalid indirect expansion")
            }
            if (sub == "@" || sub == "*") {
                var vals = scValList(name)
                if (vals.length == 0) { return null }
                v = joinList(vals, (sub == "@") ? " " : ifsFirst())
            } else {
                if (!scHas(name, sub)) { return null }
                v = scGet(name, sub)
            }
        }
        if (isRefName(v)) { return v }
        return indFail(v + ": invalid variable name")
