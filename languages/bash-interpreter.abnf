        if (a.length >= 2 && a[0] == "-v") { dest = a[1]; a = a.slice(2) }
        if (a.length == 0) { return 0 }
        var fmt = a[0]
        var rest = a.slice(1)
        var out = ""
        var ai = 0
        var pass = 0
        while (pass == 0 || ai < rest.length) {
            pass = pass + 1
            var used = false
            var i = 0
            while (i < fmt.length) {
                var ch = fmt.charAt(i)
                if (ch == "\\" && i + 1 < fmt.length) {
                    var e = fmt.charAt(i + 1)
                    i = i + 2
                    if (e == "n") { out = out + "\n" }
                    else if (e == "t") { out = out + "\t" }
                    else if (e == "r") { out = out + "\r" }
                    else if (e == "\\") { out = out + "\\" }
                    else { out = out + "\\" + e }
                } else if (ch == "%") {
                    i = i + 1
                    if (fmt.charAt(i) == "%") { out = out + "%"; i = i + 1 }
                    else {
                        var left = false
                        var zero = false
                        var flagging = true
                        while (flagging && i < fmt.length) {
                            var fc = fmt.charAt(i)
                            if (fc == "-") { left = true; i = i + 1 }
                            else if (fc == "0") { zero = true; i = i + 1 }
                            else if (fc == "+" || fc == " " || fc == "#") { i = i + 1 }
                            else { flagging = false }
                        }
                        var width = 0
                        while (i < fmt.length && fmt.charCodeAt(i) >= 48 && fmt.charCodeAt(i) <= 57) {
                            width = width * 10 + (fmt.charCodeAt(i) - 48)
                            i = i + 1
                        }
                        var prec = -1
                        if (fmt.charAt(i) == ".") {
                            i = i + 1
                            prec = 0
                            while (i < fmt.length && fmt.charCodeAt(i) >= 48 && fmt.charCodeAt(i) <= 57) {
