    // items = [{dkw}, {dflag}*, ({dname} | {aname, val})*]
    function makeDecl(items) {
        var kw = items[0].dkw
        var flags = ""
        var names = []
        var asgs = []
        var i
        for (i = 1; i < items.length; i++) {
            var it = items[i]
            if (it.dflag != undefined) { flags = flags + it.dflag; continue }
            if (it.dname != undefined) { names.push(it.dname); asgs.push(null) }
            else { names.push(it.a.name); asgs.push(it.a) }
        }
