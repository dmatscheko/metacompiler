            var r = anytype
            r = t()
            eeDone = true
            return r
        }
    }
    // Run a thunk as a CONDITION: its failure must not trip set -e.
    function runCond(t) {
        condDepth = condDepth + 1
        var r = anytype
        r = t()
        condDepth = condDepth - 1
        return r
    }

    // items = [{pats}, bodyThunk, {cterm}?]
    function mkCaseClause(items) {
        var pats = []
        var body = null
        var term = ";;"
        var i
        for (i = 0; i < items.length; i++) {
            var it = items[i]
            if (typeof it == "function") { body = it }
            else if (it.pats != undefined) { pats = it.pats }
            else if (it.cterm != undefined) { term = it.cterm }
        }
        return {pats: pats, body: body, cterm: term}
    }
    // items = [subjectWordThunk, clause...]
    function makeCase(items, ln) {
        var subjT = items[0]
        var clauses = items.slice(1)
        return function() {
            vars["$LINENO"] = lnCtx == null ? ln : lnIn(ln)
            var s = wordJoin(subjT())
            // An expansion error in the word or a pattern abandons the case (bash 5.3:
            // `( case a${#x-a}b in x) ;; esac ); echo $?` prints 1).
            var ab = takeAbort()
            if (ab != null) { return ab }
            var i = 0
            var fall = false
            var last = 0
            var stop = false
            while (i < clauses.length && !stop) {
                var cl = clauses[i]
                var hit = fall
                var k
                for (k = 0; k < cl.pats.length && !hit; k++) {
                    hit = globMatch(wordJoin(cl.pats[k]()), s)
                    ab = takeAbort()
                    if (ab != null) { return ab }
                }
                fall = false
                if (hit) {
                    var r = anytype
                    r = cl.body()
                    if (typeof r == "object") { return r }
                    last = r
                    setStatus(r)
                    if (cl.cterm == ";&") { fall = true }
                    else if (cl.cterm != ";;&") { stop = true }
                }
                i = i + 1
            }
            if (!stop) { setStatus(last) }
            return last
        }
    }

    // ---- pipelines, subshells, groups, (( )), [[ ]], redirections ----

    // items = [{bang}?, (stageThunk {cpd}?)...] : with two stages or more every stage runs in
    // a subshell (bash without lastpipe), and each but the last has its stdout captured as
    // the next stage's standard input. A lone `! CMD` runs in the current shell.
    function makePipeline(items) {
        var bang = false
        var stages = []
        var cpds = []
        var i
        for (i = 0; i < items.length; i++) {
            var it = items[i]
            if (typeof it == "function") { stages.push(it); cpds.push(false) }
            else if (it.cpd != undefined) { cpds[cpds.length - 1] = true }
            else { bang = true }
        }
        if (!bang && stages.length == 1) { return stages[0] }
        if (stages.length > 1) {
            for (i = 0; i < stages.length; i++) { stages[i] = subshellOf(stages[i], !cpds[i]) }
        }
        return function() {
            var savedIn = stdinBuf, savedPos = stdinPos
            var st = anytype
            st = 0
            var firstFail = 0
            var statuses = []
            var k
            for (k = 0; k < stages.length; k++) {
                var lastStage = (k == stages.length - 1)
                if (!lastStage) { capOpen() }
                st = stages[k]()
                statuses.push((typeof st == "object") ? st.ret : st)
                if (typeof st != "object" && st != 0 && firstFail == 0) { firstFail = st }
                if (!lastStage) {
                    var out = capClose()
                    stdinBuf = out
                    stdinPos = 0
                }
                if (typeof st == "object") { k = stages.length }
            }
            stdinBuf = savedIn
            stdinPos = savedPos
            arrFromList("PIPESTATUS", false, statuses)
            if (typeof st == "object") { return st }
            // set -o pipefail: the pipeline reports the first failing stage.
            if (optPipefail && st == 0 && firstFail != 0) { st = firstFail }
            if (bang) { st = (st == 0) ? 1 : 0 }
            // a ! pipeline is exempt from set -e; any other answers it by its status
            eeDone = bang
            setStatus(st)
            return st
        }
    }

    // Everything a subshell must restore: variables, positional parameters, call frames,
    // the shell options, the EXIT trap and the streams an `exec` may have redirected. The
    // standard input comes back only when the subshell REPLACED it: what a subshell reads of
    // an inherited input is consumed for its parent too, as from a shared file offset.
    function saveShellState() {
        subLevels = subLevels + 1
        return {fl: funcLog.length, vars: snapshotVars(), pos: posParams, frames: localFrames, st: snapshotState(),
                e: optErrExit, u: optNounset, pf: optPipefail, eg: optExtglob, tr: exitTrap, ts: exitTrapSrc,
                so: sinkOut, se: sinkErr, fd: fdTab, inb: stdinBuf, inp: stdinPos}
    }
    function restoreShellState(st) {
        while (funcLog.length > st.fl) {
            var fu = funcLog.pop()
            funcs[fu.k] = fu.b
            funcLn[fu.k] = fu.l
            funcSrc[fu.k] = fu.s
            funcTr[fu.k] = fu.t
        }
        subLevels = subLevels - 1
        sinkOut = st.so
        sinkErr = st.se
        fdTab = st.fd
        if (stdinBuf != st.inb) { stdinBuf = st.inb; stdinPos = st.inp }
        restoreVars(st.vars)
        restoreState(st.st)
        posParams = st.pos
        localFrames = st.frames
        optErrExit = st.e
        optNounset = st.u
        optPipefail = st.pf
        optExtglob = st.eg
        exitTrap = st.tr
        exitTrapSrc = st.ts
    }
    // ( LIST ) : variables and positional parameters are restored afterwards, and both a
    // `return` and an `exit` inside end only the subshell. No EXIT trap is inherited. It starts outside every loop,
    // except a SIMPLE command run as a pipeline stage (keepLoops): there `break` and
    // `continue` see the loops around it and end the subshell with the signal's status.
    // Twin of subshellOf in bash-to-llvm-ir.abnf.
    function makeSubshell(bodyT) { return subshellOf(bodyT, false) }
    function subshellOf(bodyT, keepLoops) {
        return function() {
            var saved = saveShellState()
            localFrames = framesCopy()
            exitTrap = null
            var savedLoops = loopDepth
            if (!keepLoops) { loopDepth = 0 }
            var r = anytype
            r = bodyT()
            loopDepth = savedLoops
            var st = runExitTrap(endStatus(r))
            restoreShellState(saved)
            eeDone = false
            setStatus(st)
            return st
        }
    }
    // The status a subshell body's result ends it with: a number, or an exit / return / loop
    // signal.
    function endStatus(r) {
        if (typeof r != "object") { return r }
        return (r.ret != undefined) ? r.ret : sigStatus(r)
    }
    // { LIST; } runs in the current shell, so it is just its body.
    function makeGroup(bodyT) { return bodyT }

    // ( LIST ) and { LIST; } CARRY THEIR OWN [ RedirList ], so their tags take the whole
    // stack (takeAll, not pop - pop would take the last redirection, not the body) and wrap
    // the body with mkRedirected, as CompoundRedir does.
    function withRedirs(bodyT, items) {
        var wrapped = [bodyT]
        var i
        for (i = 1; i < items.length; i++) { wrapped.push(items[i]) }
        return mkRedirected(wrapped)
    }
    function makeSubshellR(items) { return withRedirs(makeSubshell(items[0]), items) }
    function makeGroupR(items) { return withRedirs(makeGroup(items[0]), items) }

    // (( expr )) : status 0 when the value is non-zero (the opposite of C).
    function makeArithCmd(exprT0, ln) {
        var exprT = arIn("((: ", exprT0)
        return function() {
            vars["$LINENO"] = lnCtx == null ? ln : lnIn(ln)
            var st = !arIsZero(exprT()) ? 0 : 1
            if (takeArithErr()) { st = 1 }
            var sab = subErrAbort()
            if (sab != null) { return sab }
            setStatus(st)
            return st
        }
    }
    // let EXPR ... : same evaluator, status from the LAST expression; the first error stops
    // the command. The arguments are all expanded before any is evaluated (x=1; `let x=5 y=$x`
    // sets y=1); a word argument ({letws}) is expanded like a command word and each field is one
    // expression. No expression at all is an error.
    // Twin of makeLetCmd in bash-to-llvm-ir.abnf (rt_letfields in lib/bash-rt.c).
    function makeLetCmd(items, ln) {
        var args = []
        var redirs = []
        var nstatic = 0
        var i
        for (i = 0; i < items.length; i++) {
            if (typeof items[i] == "function") { args.push(items[i]); nstatic = nstatic + 1 }
            else if (items[i].letws != undefined) { args.push(items[i]) }
            else { redirs.push(items[i]) }
        }
        var core = function() {
            vars["$LINENO"] = lnCtx == null ? ln : lnIn(ln)
            var lists = []
            var total = 0
            var k
            for (k = 0; k < args.length; k++) {
                var fs = []
                if (typeof args[k] != "function") { fs = expandWords(args[k].letws) }
                lists.push(fs)
                total = total + fs.length
            }
            var ab = takeAbort()
            if (ab != null) { return ab }
            if (nstatic == 0 && total == 0) { arFailAt("let", "expression expected", "") }
            var v = anytype
            v = 0
            var svp = arPfx
            arPfx = "let: "
            for (k = 0; k < args.length && !arithErr; k++) {
                if (typeof args[k] == "function") { v = args[k]() }
                else {
                    var j
                    for (j = 0; j < lists[k].length && !arithErr; j++) { v = arEval(lists[k][j]) }
                }
            }
            arPfx = svp
            var st = !arIsZero(v) ? 0 : 1
            if (takeArithErr()) { st = 1 }
            var sab = subErrAbort()
            if (sab != null) { return sab }
            setStatus(st)
            return st
        }
        var wrapped = [core]
        for (i = 0; i < redirs.length; i++) { wrapped.push(redirs[i]) }
        return mkRedirected(wrapped)
    }
    // [[ ... ]] : the condition thunks answer a boolean; the command status is its inverse.
    // 0 true, 1 false, 2 the condition could not be evaluated (a bad =~ pattern).
    var condErr = 0
    function makeCondCmd(t, ln) {
        return function() {
            vars["$LINENO"] = lnCtx == null ? ln : lnIn(ln)
            condErr = 0
            var v = t()
            var st = (condErr != 0) ? condErr : (v ? 0 : 1)
            if (takeArithErr() && condErr == 0) { st = 1 }
            var sab = subErrAbort()
            if (sab != null) { return sab }
            setStatus(st)
            return st
        }
    }
    function foldCondOr(items) {
        if (items.length == 1) { return items[0] }
        return function() {
            var i
            for (i = 0; i < items.length; i++) { if (items[i]()) { return true } }
            return false
        }
    }
    function foldCondAnd(items) {
        if (items.length == 1) { return items[0] }
        return function() {
            var i
            for (i = 0; i < items.length; i++) { if (!items[i]()) { return false } }
            return true
        }
    }
    function mkCondNot(t) { return function() { return !t() } }
    // An operand of [[ ]], expanded. An error of its expansion (an arithmetic one, a bad
    // substitution) abandons the line as a subscript's does (arSubErr), while the
    // command's own arithmetic only fails it: bash 5.3 prints 1 for
    // `( [[ $((1/0)) == x ]]; echo no ); echo $?` and no for `[[ 1/0 -eq 1 ]]; echo no`.
    // Twin of condWord in bash-to-llvm-ir.abnf.
    function condWord(w) {
        var v = wordJoin(w())
        if (arithErr) { arSubErr = true }
        return v
    }
    function mkCondSingle(w) { return function() { return condWord(w) != "" } }
    function mkCondUn(items) {
        var op = items[0].cop
        var w = items[1]
        return function() { return testUnary(op, condWord(w), true) == 0 }
    }
    // [[ STR =~ ERE ]] : a successful match fills BASH_REMATCH with the whole match and the
    // capture groups, and a failed one empties it (bash).
    var reCache = {}
    function bashRegex(src) {
        var key = "$" + src
        if (hasOwn(reCache, key)) { return reCache[key] }
        // "e" is the shared engine's POSIX ERE dialect: no escape sequences or (? forms,
        // [[:alpha:]] classes, a literal ) at the top level, a literal backslash inside a
        // bracket, one quantifier per atom, no empty branch, and POSIX capture semantics
        // for ^(a*)*$. ^ and $ anchor the whole subject (no "m"), and nocasematch is off.
        var prog = rxCompile(src, "e")
        reCache[key] = prog
        return prog
    }
