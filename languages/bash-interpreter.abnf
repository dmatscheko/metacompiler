        // is <c><><d> and "${*/c/C}" replaces in each parameter before the join. So they
        // take the subscripted path below with "@"/"*" as both the name and the
        // subscript (scValList, scGet and scHas answer the parameters for those names),
        // every @-transform included (posDeclA has @A's own form). Twin of the same
        // routing in languages/bash-to-llvm-ir.abnf.
        if (!hasIdx && (name == "@" || name == "*") && !lenp && !indp
            && (pe == "substr" || isPatOp(pe) || op != "" || xf != "")) {
            var posSub = name
            hasIdx = true
