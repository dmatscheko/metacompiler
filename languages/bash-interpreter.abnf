            // function declare a function-local name (value AND attributes restored on
            // return) unless -g is given; `export` and `readonly` always act on the global.
            var localize = !global && (kw == "local" || ((kw == "declare" || kw == "typeset") && localFrames.length > 0))
            for (k = 0; k < names.length; k++) {
                touchState(names[k])
                if (localize) {
                    declareLocal(names[k])
                    // A local declaration starts from a CLEAN SLATE. bash does not inherit
                    // the global's attributes or its array: `declare -i g; f(){ local g;
                    // g=1+1; }` prints 1+1, and `arr=(a b); f(){ local arr=Q; }` sees a
                    // one-element array. declareLocal has just saved all of it for the return.
                    dropAttrs(names[k])
                    arrs[arrKey(names[k])] = null
                }
                if (integer) { intVars["$" + names[k]] = true }
                if (upper) { upVars["$" + names[k]] = true; loVars["$" + names[k]] = false }
                if (lower) { loVars["$" + names[k]] = true; upVars["$" + names[k]] = false }
                // A global `declare -a a` keeps a's elements; only a value or a local starts empty.
                if (isArray && asgs[k] == null) {
                    if (!assoc && !localize) { arrAdopt(names[k]) }
                    arrEnsure(names[k], assoc)
                    arrs[arrKey(names[k])].decl = true
                }
                if (asgs[k] != null) {
                    if (isArray) { arrNew(names[k], assoc) }
                    runAssign(asgs[k], assoc)
                }
                else if (localize) { unsetVar(names[k]) }
                if (asgs[k] == null && !isArray && kw != "export" && kw != "readonly") { dclVars["$" + names[k]] = true }
            }
