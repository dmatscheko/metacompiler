            if (!al && !(i > 0 && cc >= 48 && cc <= 57)) { return false }
        }
        return true
    }

    // read [-r] [-a NAME] [-d DELIM] [-n|-N COUNT] NAME... : one record of standard input (readRec), split
    // on IFS, the last name taking the rest (readFields). The status is 1 when no delimiter
    // ended the record - at the end of the input the names are still stored, and with nothing
    // left at all they are CLEARED, REPLY included (`REPLY=keep; read -r </dev/null` leaves it
    // empty) and an -a array is left set and empty. A name that is no NAME or NAME[SUB]
    // (bashIsRef) is "not a valid identifier", status 1: the first before anything is read,
    // the others when their turn to be stored comes. Twin of emitRead in bash-to-llvm-ir.abnf.
    function readBuiltin(args) {
