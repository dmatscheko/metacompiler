                var lenT = (args.length > 1) ? args[1] : null
                return function() {
                    var sub = readIdx()
                    if (sub != "@" && sub != "*") { return sliceStr(arrGet(name, sub), offT, lenT) }
                    var vals = arrValList(name)
                    var off = offT()
                    if (off < 0) { off = vals.length + off; if (off < 0) { off = 0 } }
                    var n = (lenT != null) ? lenT() : (vals.length - off)
                    if (n < 0) { n = vals.length + n - off }
                    var out = []
                    var i2
                    for (i2 = off; i2 < off + n && i2 < vals.length; i2++) { out.push(vals[i2]) }
