        if (op == "/") { return (l / r) | 0 }
        if (op == "%") { return (l % r) | 0 }
        if (op == "<")  { return (l < r) ? 1 : 0 }
        if (op == ">")  { return (l > r) ? 1 : 0 }
        if (op == "<=") { return (l <= r) ? 1 : 0 }
        if (op == ">=") { return (l >= r) ? 1 : 0 }
        if (op == "==") { return (l == r) ? 1 : 0 }
        if (op == "!=") { return (l != r) ? 1 : 0 }
