    // upper/lower-cases every later write too, including one made by `read` or a `for` head,
    // which is why this sits in setVarVal rather than in makeDecl.
    function attrCase(name, val) {
        if (attrOn(upVars, name)) { return caseMap(val, "^^", "") }
        if (attrOn(loVars, name)) { return caseMap(val, ",,", "") }
        return val
    }
    function snapshotVars() {
        var snap = []
        var i
        for (i = 0; i < varNames.length; i++) {
            var k = "$" + varNames[i]
            snap.push({v: hasOwn(vars, k) ? vars[k] : "", h: hasOwn(varsHas, k) ? varsHas[k] : false})
        }
        return snap
    }
    function restoreVars(snap) {
        var i
        for (i = 0; i < snap.length; i++) {
            var k = "$" + varNames[i]
            vars[k] = snap[i].v
            varsHas[k] = snap[i].h
        }
