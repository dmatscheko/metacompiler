                var lenT = (args.length > 1) ? args[1] : null
                return function() {
                    var sub = readIdx()
                    if (sub != "@" && sub != "*") { return sliceStr(scGet(name, sub), offT, lenT) }
                    // NAME[@] / NAME[*] of a SCALAR is the substring of its value, as ${NAME:off}
                    // (bash 5.3: s=hello; "${s[@]:1:-1}" is ell); an offset outside the value
                    // is no word for [@]. Twin of the scalar arm of rt_arr_slice.
                    if (!isPosName(name) && !isArr(name)) {
                        var sv = isSetVar(name) ? sliceAt(getVarVal(name), arNum(offT()), lenT) : null
                        if (sv == null) { return (sub == "@") ? encFields([]) : "" }
                        return (sub == "@") ? encFields([sv]) : sv
                    }
                    // The positional list counts from $0: "${@:1}" is $1 on and "${@:0}"
                    // starts with the script name.
                    var vals = scValList(name)
                    if (isPosName(name)) { vals = [scriptName]; for (var pv = 0; pv < posParams.length; pv++) { vals.push(posParams[pv]) } }
                    if (!isPosName(name) && isArr(name) && !arrs[arrKey(name)].assoc) {
                        var sl = arrSlice(name, offT(), (lenT != null) ? lenT() : null)
                        return (sub == "@") ? encFields(sl) : starJoin(sl)
                    }
                    var off = arNum(offT())
                    // A negative offset counts from the end, and one reaching past the
                    // start selects nothing (bash 5.3: a=(p q r); "${a[@]: -5}" is no word).
                    if (off < 0) { off = vals.length + off; if (off < 0) { off = vals.length } }
                    var n = (lenT != null) ? arNum(lenT()) : (vals.length - off)
                    if (n < 0) { n = vals.length + n - off }
                    var out = []
                    var i2
                    for (i2 = off; i2 < off + n && i2 < vals.length; i2++) { out.push(vals[i2]) }
