        }
        // ${#v OP arg} is a parse-time-legal, run-time-illegal combination in bash:
        //     $ echo "${#x-default}"   ->  bash: ${#x-default}: bad substitution
        if (lenp) { var badName = name; return function() { fail("${#" + badName + "...}: bad substitution"); return "" } }
        // ${!ref OP arg} and ${!a[k] OP arg}: the operator applies to the variable the
        // indirection LANDED on (cell, see mkParamExp), so every leaf below reads its name
        // through nameOf() - once per expansion - instead of closing over `name`; null is an
        // unset target.
        var baseName = name
        var indirect = indp
        var nameOf = function() {
            if (!indirect) { return baseName }
            return cell.ok ? cell.v : null
        }
        // The transform operators. @P (prompt expansion) is the only one that is not a pure
        // string function; promptExpand implements the escapes bash documents for PS1.
        if (xf != "") {
            var xfOp = xf
            return function() {
                var xn = nameOf()
                if (xn == null) { return "" }
                return xformOne(getVarVal(xn), xfOp, xn, isSetVar(xn) || isArr(xn))
            }
        }
        if (pe == "substr") {
            var offT0 = args[0]
            var lenT0 = (args.length > 1) ? args[1] : null
            return function() { var sn = nameOf(); return sliceStr((sn == null) ? "" : getVarVal(sn), offT0, lenT0) }
        }
