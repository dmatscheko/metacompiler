        return -1
    }
    // The start index of the LONGEST match of pat that reaches the end of v, or -1.
    function matchAtEnd(pat, v) {
        var i = 0
        while (i <= v.length) {
            if (globMatch(pat, v.slice(i))) { return i }
            i = i + 1
        }
        return -1
    }
    function replacePat(v, pat, rep, mode) {
        if (mode == "#") {
            var j = matchLenAt(pat, v, 0)
            if (j < 0) { return v }
            return rep + v.slice(j)
        }
        if (mode == "%") {
            var i0 = matchAtEnd(pat, v)
            if (i0 < 0) { return v }
            return v.slice(0, i0) + rep
        }
        var out = ""
        var i = 0
        var done = false
        while (i <= v.length && !done) {
            var j2 = matchLenAt(pat, v, i)
            if (j2 > i) {
                out = out + rep
                i = j2
                if (mode == "one") { out = out + v.slice(i); done = true }
            } else {
                if (i < v.length) { var cch = chunkAt(v, i); out = out + cch; i = i + cch.length }
                else { i = i + 1 }
            }
        }
        return out
    }
