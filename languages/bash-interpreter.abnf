    function isRawCh(cc) { return cc >= 56448 && cc <= 56575 }
    function hasRaw(s) {
        var i
        for (i = 0; i < s.length; i++) { if (isRawCh(s.charCodeAt(i))) { return true } }
        return false
    }
    // The UTF-8 bytes of s, a raw byte as itself.
    function strBytes(s) {
        var out = []
        var i
        for (i = 0; i < s.length; i++) {
            var cc = s.charCodeAt(i)
            if (isRawCh(cc)) { out.push(cc - 56320) }
            else if (cc < 128) { out.push(cc) }
            else if (cc < 2048) { out.push(192 + (cc >> 6)); out.push(128 + (cc & 63)) }
            else if (cc >= 55296 && cc <= 56319 && i + 1 < s.length) {
