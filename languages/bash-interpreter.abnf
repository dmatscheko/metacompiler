            var it = items[i]
            if (it.rend != undefined) { ends.push(it.rend) } else { step = strToInt(it.rstep.slice(2)) }
        }
        var lo = ends[0], hi = ends[1]
        var alts = []
        var numeric = !(lo.length == 1 && isAlphaCh(lo.charCodeAt(0)))
        var a = numeric ? strToInt(lo) : lo.charCodeAt(0)
        var b = numeric ? strToInt(hi) : hi.charCodeAt(0)
        var st = (step != 0) ? step : 1
        if (st < 0) { st = (0 - st) | 0 }
        var v = a
        var guard = 0
        while (guard < 100000) {
            guard = guard + 1
            alts.push([makeConst(numeric ? numToStr(v) : String.fromCharCode(v))])
