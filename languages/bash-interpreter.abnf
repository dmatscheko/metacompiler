                var j
                for (j = i + 1; j < args.length; j++) { rest.push(args[j]) }
                posParams = rest
                i = args.length
            } else if (a == "-o" || a == "+o") {
                var on = (a == "-o")
                if (i + 1 < args.length) {
                    var nm = args[i + 1]
                    if (nm == "pipefail") { optPipefail = on }
                    if (nm == "errexit") { optErrExit = on }
                    if (nm == "nounset") { optNounset = on }
                    i = i + 1
                }
            } else if (a.length > 1 && (a.charAt(0) == "-" || a.charAt(0) == "+")) {
                var on2 = (a.charAt(0) == "-")
                var k
                for (k = 1; k < a.length; k++) {
                    var f = a.charAt(k)
                    if (f == "e") { optErrExit = on2 }
                    if (f == "u") { optNounset = on2 }
                }
            }
            i = i + 1
        }
        setStatus(0)
        return 0
    }

    // read [-r] [-a NAME] NAME... : one line of standard input, split on IFS, the last name
    // taking the rest. Returns 1 at end of file, exactly like the shell.
    function readBuiltin(args) {
        var names = []
        var arrName = null
        var i = 0
        while (i < args.length) {
            var a = args[i]
            if (a == "-a") { i = i + 1; if (i < args.length) { arrName = args[i] } }
            else if (a == "-d" || a == "-n" || a == "-N" || a == "-p" || a == "-t" || a == "-u") { i = i + 1 }
            else if (a.length > 1 && a.charAt(0) == "-") { }
            else { names.push(a) }
            i = i + 1
        }
        if (stdinPos >= stdinBuf.length) {
            var z
            for (z = 0; z < names.length; z++) { setVarVal(names[z], "") }
            if (arrName != null) { arrFromList(arrName, false, []) }
            return 1
        }
        var e = stdinPos
        while (e < stdinBuf.length && stdinBuf.charAt(e) != "\n") { e = e + 1 }
        var line = stdinBuf.slice(stdinPos, e)
        stdinPos = (e < stdinBuf.length) ? (e + 1) : e
        var fields = splitIFS(line)
        if (arrName != null) { arrFromList(arrName, false, fields); return 0 }
        if (names.length == 0) { setVarVal("REPLY", line); return 0 }
        var k
        for (k = 0; k < names.length; k++) {
            if (k == names.length - 1) {
                var rest = ""
                var j
                for (j = k; j < fields.length; j++) { if (j > k) { rest = rest + " " }; rest = rest + fields[j] }
                setVarVal(names[k], rest)
            } else {
                setVarVal(names[k], (k < fields.length) ? fields[k] : "")
            }
        }
        return 0
    }
    // Split on the characters of IFS (default: space, tab and newline), dropping empty fields.
    function splitIFS(line) {
        var seps = isSetVar("IFS") ? vars["$IFS"] : " \t\n"
        var out = []
        var cur = ""
        var i = 0
        while (i < line.length) {
            var ch = chunkAt(line, i)
            i = i + ch.length
            var isSep = false
            var j
            for (j = 0; j < seps.length; j++) { if (seps.charAt(j) == ch) { isSep = true } }
            if (isSep) { if (cur != "") { out.push(cur) }; cur = "" }
            else { cur = cur + ch }
        }
        if (cur != "") { out.push(cur) }
        return out
    }

    function echoCmd(args) {
        var i = 0
        var newline = true
        var escapes = false
        var flagging = true
        while (flagging && i < args.length) {
            var a = args[i]
            if (a == "-n") { newline = false; i = i + 1 }
            else if (a == "-e") { escapes = true; i = i + 1 }
            else if (a == "-E") { escapes = false; i = i + 1 }
            else { flagging = false }
        }
        var out = ""
        var first = true
        while (i < args.length) {
            if (!first) { out = out + " " }
            out = out + (escapes ? ansiC(args[i]) : args[i])
            first = false
            i = i + 1
        }
        if (newline) { out = out + "\n" }
        emitOut(out)
    }

    // ---- the test builtin -------------------------------------------------------------
    // There is no real filesystem behind a grammar run, so the file predicates answer from a
    // small MODEL of the standard paths every shell can rely on. Anything else is "absent".
    // 0 = absent, 1 = exists and is not a directory, 2 = directory.
    function fsKind(p) {
        if (p == "/dev/null" || p == "/dev/zero" || p == "/dev/tty") { return 1 }
        if (p == "/dev/stdin" || p == "/dev/stdout" || p == "/dev/stderr") { return 1 }
        if (p == "/" || p == "/dev" || p == "/tmp" || p == "/usr" || p == "/etc") { return 2 }
        if (p == "/var" || p == "/bin" || p == "/usr/bin") { return 2 }
        return 0
    }

    // "name" or "name[key]" - the form `unset a[0]` and `[[ -v a[k] ]]` use.
    function splitSubscript(s0) {
        var i
        for (i = 0; i < s0.length; i++) {
            if (s0.charAt(i) == "[" && s0.charAt(s0.length - 1) == "]") {
                return {name: s0.slice(0, i), key: s0.slice(i + 1, s0.length - 1)}
            }
        }
        return {name: s0, key: null}
    }
    function isTestUnary(t) {
        if (t == "-z" || t == "-n" || t == "-v") { return true }
        if (t == "-e" || t == "-f" || t == "-d" || t == "-s" || t == "-r" || t == "-w") { return true }
        if (t == "-x" || t == "-h" || t == "-L" || t == "-b" || t == "-c" || t == "-p") { return true }
        if (t == "-S" || t == "-t" || t == "-g" || t == "-u" || t == "-k" || t == "-O") { return true }
        return false
    }
    function isTestBinary(t) {
        if (t == "=" || t == "==" || t == "!=" || t == "<" || t == ">") { return true }
        if (t == "-eq" || t == "-ne" || t == "-lt" || t == "-le" || t == "-gt" || t == "-ge") { return true }
        if (t == "-nt" || t == "-ot" || t == "-ef") { return true }
        return false
    }
    function testUnary(op, s) {
        if (op == "-z") { return (s == "") ? 0 : 1 }
        if (op == "-n") { return (s != "") ? 0 : 1 }
        if (op == "-v") {
            var sp = splitSubscript(s)
            if (sp.key != null) { return arrHas(sp.name, sp.key) ? 0 : 1 }
            return (isSetVar(s) || isArr(s)) ? 0 : 1
        }
        if (op == "-d") { return (fsKind(s) == 2) ? 0 : 1 }
        if (op == "-e" || op == "-r" || op == "-w") { return (fsKind(s) != 0) ? 0 : 1 }
        if (op == "-f" || op == "-s") { return (fsKind(s) == 1) ? 0 : 1 }
        if (op == "-c" || op == "-b") { return (fsKind(s) == 1) ? 0 : 1 }
        return 1
    }
    function testBinary(l, op, r) {
        if (op == "-eq") { return (strToInt(l) == strToInt(r)) ? 0 : 1 }
        if (op == "-ne") { return (strToInt(l) != strToInt(r)) ? 0 : 1 }
        if (op == "-lt") { return (strToInt(l) < strToInt(r)) ? 0 : 1 }
        if (op == "-le") { return (strToInt(l) <= strToInt(r)) ? 0 : 1 }
        if (op == "-gt") { return (strToInt(l) > strToInt(r)) ? 0 : 1 }
        if (op == "-ge") { return (strToInt(l) >= strToInt(r)) ? 0 : 1 }
        if (op == "=" || op == "==") { return (l == r) ? 0 : 1 }
        if (op == "!=") { return (l != r) ? 0 : 1 }
        if (op == "<") { return (l < r) ? 0 : 1 }
        if (op == ">") { return (l > r) ? 0 : 1 }
        fail("unknown binary test operator: " + op)
        return 2
    }

    // A recursive descent over the ARGUMENT LIST: or := and { -o and }, and := not { -a not },
    // not := "!" not | prim, prim := "(" or ")" | UNOP word | word [ BINOP word ] | word.
    function tstAt(a, st) { return (st.i < a.length) ? a[st.i] : "\x00end" }
    function tstPrim(a, st) {
        var t = tstAt(a, st)
        if (t == "(") {
            st.i = st.i + 1
            var r = tstOr(a, st)
            if (tstAt(a, st) == ")") { st.i = st.i + 1 }
            return r
        }
        if (t == "!") { st.i = st.i + 1; var r2 = tstPrim(a, st); return (r2 == 0) ? 1 : 0 }
        if (isTestUnary(t) && st.i + 1 < a.length && !isTestBinary(a[st.i + 1])) {
            var opnd = a[st.i + 1]
            st.i = st.i + 2
            return testUnary(t, opnd)
        }
        st.i = st.i + 1
        if (st.i + 1 < a.length + 0 && isTestBinary(tstAt(a, st))) {
            var op = tstAt(a, st)
            var rhs = a[st.i + 1]
            st.i = st.i + 2
            return testBinary(t, op, rhs)
        }
        return (t != "") ? 0 : 1
    }
    function tstAnd(a, st) {
        var v = tstPrim(a, st)
        while (tstAt(a, st) == "-a") { st.i = st.i + 1; var r = tstPrim(a, st); if (r != 0) { v = 1 } }
        return v
    }
    function tstOr(a, st) {
        var v = tstAnd(a, st)
        while (tstAt(a, st) == "-o") { st.i = st.i + 1; var r = tstAnd(a, st); if (r == 0) { v = 0 } }
        return v
    }

    // The test builtin: [ ... ] (drops the closing ]) or `test ...`.
    function testBuiltin(cmd, argsIn) {
        var a = argsIn
        if (cmd == "[") {
            if (a.length == 0 || a[a.length - 1] != "]") { fail("[ used without the closing ]") }
            a = a.slice(0, a.length - 1)
        }
        if (a.length == 0) { return 1 }
        if (a.length == 1) { return (a[0] != "") ? 0 : 1 }
        var st = {i: 0}
        return tstOr(a, st)
    }

    // Dispatch a command by its (already expanded) name. Returns an int status, or {ret: n}
    // for the return builtin; exit terminates the whole run immediately.
    function runCommand(cmd, args) {
        if (cmd == "echo") { echoCmd(args); setStatus(0); return 0 }
        if (cmd == "[" || cmd == "test") { var st = testBuiltin(cmd, args); setStatus(st); return st }
        if (cmd == "true" || cmd == ":") { setStatus(0); return 0 }
        if (cmd == "unset") {
            var ui
            for (ui = 0; ui < args.length; ui++) {
                var sp = splitSubscript(args[ui])
                if (sp.key == null) { unsetVar(sp.name); arrs[arrKey(sp.name)] = null }
                else { arrDel(sp.name, sp.key) }
            }
            setStatus(0)
            return 0
        }
        if (cmd == "false") { setStatus(1); return 1 }
        if (cmd == "break") { return {brk: (args.length > 0) ? strToInt(args[0]) : 1} }
        if (cmd == "continue") { return {cont: (args.length > 0) ? strToInt(args[0]) : 1} }
        if (cmd == "set") { return setBuiltin(args) }
        if (cmd == "trap") {
            // trap 'CODE' EXIT : only the EXIT trap is modelled. The code is re-parsed with
            // this grammar's own parser, exactly like eval.
            if (args.length > 0 && args[0] != "" && args[0] != "-") { exitTrap = compileSnippet(args[0]) }
            else { exitTrap = null }
            setStatus(0)
            return 0
        }
        if (cmd == "eval") {
            var src = ""
            var ei
            for (ei = 0; ei < args.length; ei++) { if (ei > 0) { src = src + " " }; src = src + args[ei] }
            if (src == "") { setStatus(0); return 0 }
            var et = compileSnippet(src)
            var er = anytype
            er = et()
            if (typeof er == "object") { return er }
            setStatus(er)
            return er
        }
        if (cmd == "printf") { var pst = printfBuiltin(args); setStatus(pst); return pst }
        if (cmd == "read") { var rst = readBuiltin(args); setStatus(rst); return rst }
        if (cmd == "shift") {
            var n = (args.length > 0) ? strToInt(args[0]) : 1
            posParams = (n <= posParams.length) ? posParams.slice(n) : []
            setStatus(0)
            return 0
        }
        if (cmd == "exit") {
            var code = (args.length > 0) ? strToInt(args[0]) : lastStatus
            return {ret: code, isExit: 1}
        }
        if (cmd == "return") {
            var rc = (args.length > 0) ? strToInt(args[0]) : lastStatus
            return {ret: rc}
        }
        var key = "$" + cmd
        if (hasOwn(funcs, key)) {
            var st2 = anytype
            st2 = callFunc(cmd, args)
            if (typeof st2 == "object") { return st2 }
            setStatus(st2)
            return st2
        }
        fail("command not found: " + cmd)
        return 127
    }

    // Call a user function: bind $1.. to args, run the body, restore, return its status.
    function callFunc(name, args) {
        var body = funcs["$" + name]
        var saved = posParams
        posParams = args
        pushLocalFrame()
        declareLocal("FUNCNAME")
        setVarVal("FUNCNAME", name)
        var r = anytype
        r = body()
        popLocalFrame()
        posParams = saved
        if (typeof r == "object") {
            if (r.isExit != undefined) { return r }   // an exit unwinds past the caller too
            return r.ret
        }
        return r
    }

    // cmd1 && cmd2 || cmd3 : short circuit on the running status; a {ret} unwinds at once.
    function makeAndOr(items) {
        if (items.length == 1) { return items[0] }
        return function() {
            var st = anytype
            // Every element but the last runs as a condition, so set -e does not fire on it.
            st = runCond(items[0])
            if (typeof st == "object") { return st }
            var i
            for (i = 1; i < items.length; i += 2) {
                var op = items[i].op
                var runIt = (op == "&&") ? (st == 0) : (st != 0)
                if (runIt) {
                    var isLast = (i + 2 >= items.length)
                    st = isLast ? items[i + 1]() : runCond(items[i + 1])
                    if (typeof st == "object") { return st }
                }
            }
            return st
        }
    }

    // A statement sequence: the value is the last statement's status; a {ret} unwinds.
    function makeSeq(thunks) {
        return function() {
            var last = 0
            var r = anytype
            var i
            for (i = 0; i < thunks.length; i++) {
                r = thunks[i]()
                if (typeof r == "object") { return r }
                last = r
                // set -e: leave on the first failing command, unless it is a CONDITION.
                if (optErrExit && last != 0 && condDepth == 0) { return {ret: last, isExit: 1} }
            }
            return last
        }
    }
    // Run a thunk as a CONDITION: its failure must not trip set -e.
    function runCond(t) {
        condDepth = condDepth + 1
        var r = anytype
        r = t()
        condDepth = condDepth - 1
        return r
    }

    // items = [{pats}, bodyThunk, {cterm}?]
    function mkCaseClause(items) {
        var pats = []
        var body = null
        var term = ";;"
        var i
        for (i = 0; i < items.length; i++) {
            var it = items[i]
            if (typeof it == "function") { body = it }
            else if (it.pats != undefined) { pats = it.pats }
            else if (it.cterm != undefined) { term = it.cterm }
        }
        return {pats: pats, body: body, cterm: term}
    }
    // items = [subjectWordThunk, clause...]
    function makeCase(items) {
        var subjT = items[0]
        var clauses = items.slice(1)
        return function() {
            var s = wordJoin(subjT())
            var i = 0
            var fall = false
            var last = 0
            var stop = false
            while (i < clauses.length && !stop) {
                var cl = clauses[i]
                var hit = fall
                var k
                for (k = 0; k < cl.pats.length; k++) { if (globMatch(wordJoin(cl.pats[k]()), s)) { hit = true } }
                fall = false
                if (hit) {
                    var r = anytype
                    r = cl.body()
                    if (typeof r == "object") { return r }
                    last = r
                    setStatus(r)
                    if (cl.cterm == ";&") { fall = true }
                    else if (cl.cterm != ";;&") { stop = true }
                }
                i = i + 1
            }
            if (!stop) { setStatus(last) }
            return last
        }
    }

    // ---- pipelines, subshells, groups, (( )), [[ ]], redirections ----

    // items = [{bang}?, stageThunk...] : each stage but the last runs with its stdout
    // captured, and that capture becomes the next stage's standard input.
    function makePipeline(items) {
        var bang = false
        var stages = []
        var i
        for (i = 0; i < items.length; i++) {
            var it = items[i]
            if (typeof it == "function") { stages.push(it) } else { bang = true }
        }
        if (!bang && stages.length == 1) { return stages[0] }
        return function() {
            var savedIn = stdinBuf, savedPos = stdinPos
            var st = anytype
            st = 0
            var firstFail = 0
            var statuses = []
            var k
            for (k = 0; k < stages.length; k++) {
                var lastStage = (k == stages.length - 1)
                if (!lastStage) { capStack.push("") }
                st = lastStage ? stages[k]() : runCond(stages[k])
                statuses.push((typeof st == "object") ? st.ret : st)
                if (typeof st != "object" && st != 0 && firstFail == 0) { firstFail = st }
                if (!lastStage) {
                    var out = capStack.pop()
                    stdinBuf = out
                    stdinPos = 0
                }
                if (typeof st == "object") { k = stages.length }
            }
            stdinBuf = savedIn
            stdinPos = savedPos
            arrFromList("PIPESTATUS", false, statuses)
            if (typeof st == "object") { return st }
            // set -o pipefail: the pipeline reports the first failing stage.
            if (optPipefail && st == 0 && firstFail != 0) { st = firstFail }
            if (bang) { st = (st == 0) ? 1 : 0 }
            setStatus(st)
            return st
        }
    }

    // ( LIST ) : variables and positional parameters are restored afterwards, and both a
    // `return` and an `exit` inside end only the subshell.
    // Everything a subshell must restore: variables, positional parameters, call frames,
    // the shell options and the EXIT trap.
    function saveShellState() {
        return {vars: snapshotVars(), pos: posParams, frames: localFrames,
                e: optErrExit, u: optNounset, pf: optPipefail, tr: exitTrap}
    }
    function restoreShellState(st) {
        restoreVars(st.vars)
        posParams = st.pos
        localFrames = st.frames
        optErrExit = st.e
        optNounset = st.u
        optPipefail = st.pf
        exitTrap = st.tr
    }
    function makeSubshell(bodyT) {
        return function() {
            var saved = saveShellState()
            localFrames = []
            var r = anytype
            r = bodyT()
            runExitTrap()
            restoreShellState(saved)
            var st = 0
            if (typeof r == "object") { st = r.ret } else { st = r }
            setStatus(st)
            return st
        }
    }
    // { LIST; } runs in the current shell, so it is just its body.
    function makeGroup(bodyT) { return bodyT }

    // (( expr )) : status 0 when the value is non-zero (the opposite of C).
    function makeArithCmd(exprT) {
        return function() { var st = (exprT() != 0) ? 0 : 1; setStatus(st); return st }
    }
    // let EXPR ... : same evaluator, status from the LAST expression.
    function makeLetCmd(items) {
        return function() {
            var v = 0
            var i
            for (i = 0; i < items.length; i++) { v = items[i]() }
            var st = (v != 0) ? 0 : 1
            setStatus(st)
            return st
        }
    }
    // [[ ... ]] : the condition thunks answer a boolean; the command status is its inverse.
    // 0 true, 1 false, 2 the condition could not be evaluated (a bad =~ pattern).
    var condErr = 0
    function makeCondCmd(t) {
        return function() {
            condErr = 0
            var v = t()
            var st = (condErr != 0) ? condErr : (v ? 0 : 1)
            setStatus(st)
            return st
        }
    }
    function foldCondOr(items) {
        if (items.length == 1) { return items[0] }
        return function() {
            var i
            for (i = 0; i < items.length; i++) { if (items[i]()) { return true } }
            return false
        }
    }
    function foldCondAnd(items) {
        if (items.length == 1) { return items[0] }
        return function() {
            var i
            for (i = 0; i < items.length; i++) { if (!items[i]()) { return false } }
            return true
        }
    }
    function mkCondNot(t) { return function() { return !t() } }
    function mkCondSingle(w) { return function() { return wordJoin(w()) != "" } }
    function mkCondUn(items) {
        var op = items[0].cop
        var w = items[1]
        return function() { return testUnary(op, wordJoin(w())) == 0 }
    }
    // [[ STR =~ ERE ]] : a successful match fills BASH_REMATCH with the whole match and the
    // capture groups, and a failed one empties it (bash).
    var reCache = {}
    function bashRegex(src) {
        var key = "$" + src
        if (hasOwn(reCache, key)) { return reCache[key] }
        // No flags: bash's =~ is a POSIX ERE where ^ and $ anchor the whole subject and "."
        // does not cross a newline, and nocasematch is off.
        var prog = rxCompile(src, "")
        reCache[key] = prog
        return prog
    }
    function mkCondMatch(items) {
        var lT = items[0], rT = items[2]
        return function() {
            var subj = wordJoin(lT())
            var src = wordJoin(rT())
            var re = bashRegex(src)
            // A pattern that does not compile is not fatal in bash: it reports on standard
            // error and gives the [[ ]] status 2.
            if (!re.ok) {
                emitErr("bash: [[: invalid regular expression: " + re.err + "\n")
                condErr = 2
                arrFromList("BASH_REMATCH", false, [])
                return false
            }
            var m = rxSearch(re, subj, 0)
            if (m == null) { arrFromList("BASH_REMATCH", false, []); return false }
            var list = []
            var i
            for (i = 0; i <= re.ngroups; i++) {
                // rxGroup answers null for a group that did not participate; bash reports "".
                var g = rxGroup(re, subj, m, i)
                list.push((g == null) ? "" : g)
            }
            arrFromList("BASH_REMATCH", false, list)
            return true
        }
    }

    // Make every glob metacharacter of s literal (a quoted pattern part).
    function globEscape(s) {
        var out = ""
        var i = 0
        while (i < s.length) {
            var ch = chunkAt(s, i)
            i = i + ch.length
            if (ch == "*" || ch == "?" || ch == "[" || ch == "]" || ch == "\\") { out = out + "\\" }
            out = out + ch
        }
        return out
    }
    function mkQuotedPat(t) { return function() { return globEscape(wordJoin(t())) } }

    function mkCondBin(items) {
        var l = items[0], op = items[1].cop, r = items[2]
        return function() {
            var lv = wordJoin(l())
            var rv = wordJoin(r())
            // == and != glob-match their right hand side inside [[ ]]; = is a synonym of ==.
            if (op == "==" || op == "=") { return globMatch(rv, lv) }
            if (op == "!=") { return !globMatch(rv, lv) }
            return testBinary(lv, op, rv) == 0
        }
    }

    // Redirection: without a filesystem, an output redirection DISCARDS the output and an
    // input redirection other than a here-string yields end of file at once.
    function mkRedir(items) {
        var op = "", fd = "", t = null
        var i
        for (i = 0; i < items.length; i++) {
            var it = items[i]
            if (typeof it == "function") { t = it }
            else if (it.redir != undefined) { op = it.redir }
            else if (it.iofd != undefined) { fd = it.iofd }
        }
        return {rd: op, iofd: fd, target: t}
    }

    // <<DELIM / <<-DELIM / <<'DELIM' : split the scanned token back into marker and body.
    function mkHereDoc(text) {
        var i = 2
        var dashed = false
        if (text.charAt(i) == "-") { dashed = true; i = i + 1 }
        while (text.charAt(i) == " " || text.charAt(i) == "\t") { i = i + 1 }
        var quote = ""
        var q = text.charAt(i)
        if (q == "'" || q == "\"") { quote = q; i = i + 1 }
        // the body starts after the first newline and ends after the last one
        var firstNL = -1
        var lastNL = -1
        var k
        for (k = 0; k < text.length; k++) {
            var ch = text.charAt(k)
            if (ch == "\n") { if (firstNL < 0) { firstNL = k }; lastNL = k }
        }
        var body = ""
        if (firstNL >= 0 && lastNL > firstNL) { body = text.slice(firstNL + 1, lastNL + 1) }
        if (dashed) { body = stripLeadingTabs(body) }
        var t = (quote != "") ? makeConst(body) : compileHereBody(body)
        return {rd: "<<", iofd: "", target: t}
    }
    function stripLeadingTabs(b) {
        var out = ""
        var atLineStart = true
        var i = 0
        while (i < b.length) {
            var ch = chunkAt(b, i)
            i = i + ch.length
            if (atLineStart && ch == "\t") { continue }
            atLineStart = (ch == "\n")
            out = out + ch
        }
        return out
    }
    // An unquoted here-document body is re-parsed with this grammar so that $ expansions,
    // command substitutions and backslash escapes inside it work exactly as in a word.
    function compileHereBody(body) {
        var frag = c.parseFrom(c.agrammar, "\x01" + body, "HereBodyW")
        return c.compile(frag).stack[0]
    }

    // A compound statement plus its redirections; items = [bodyThunk, redir...]
    function mkRedirected(items) {
        var bodyT = items[0]
        var redirs = []
        var i
        for (i = 1; i < items.length; i++) { redirs.push(items[i]) }
        if (redirs.length == 0) { return bodyT }
        return function() {
            var rs = openRedirs(redirs)
            var st = anytype
            st = bodyT()
            closeRedirs(rs)
            return st
        }
    }

    function mkPrefixAsg(items) {
        return {aname: items[0].aname, val: (items.length > 1) ? items[1] : null}
    }
    // items = [{aname,val}..., cmdWordThunk, argThunk/redir...]
    function makePrefixCmd(items) {
        var asgs = []
        var rest = []
        var i
        for (i = 0; i < items.length; i++) {
            var it = items[i]
            if (typeof it != "function" && it.aname != undefined) { asgs.push(it) } else { rest.push(it) }
        }
        var inner = makeSimpleCommand(rest)
        return function() {
            var saved = []
            var k
            for (k = 0; k < asgs.length; k++) {
                var nm = asgs[k].aname
                saved.push({name: nm, had: isSetVar(nm), val: getVarVal(nm)})
                setVarVal(nm, (asgs[k].val != null) ? wordJoin(asgs[k].val()) : "")
            }
            var st = anytype
            st = inner()
            for (k = saved.length - 1; k >= 0; k--) {
                vars["$" + saved[k].name] = saved[k].val
                varsHas["$" + saved[k].name] = saved[k].had
            }
            return st
        }
    }

    // break / continue travel as {brk: n} / {cont: n}, the same object-signal shape this
    // interpreter already uses for `return` ({ret}) and `exit` ({ret, isExit}); every
    // sequence, conditional and loop already propagates an object result unchanged.
    // loopSignal answers what a loop should do with one: 0 = not mine, 1 = break,
    // 2 = continue, 3 = propagate one level further out.
    function loopSignal(r) {
        if (r.brk != undefined) { return (r.brk <= 1) ? 1 : 3 }
        if (r.cont != undefined) { return (r.cont <= 1) ? 2 : 3 }
        return 0
    }
    function loopOuter(r) {
        if (r.brk != undefined) { return {brk: r.brk - 1} }
        return {cont: r.cont - 1}
    }

    function mkCond(items) { return {cond: items[0], body: items[1]} }
    function makeUntil(items) {
        var condT = items[0], bodyT = items[1]
        return function() {
            var last = 0
            var cst = anytype
            var r = anytype
            var loop = true
            while (loop) {
                cst = runCond(condT)
                if (typeof cst == "object") { return cst }
                if (cst == 0) { loop = false } else {
                    r = bodyT()
                    if (typeof r == "object") {
                        var sg2 = loopSignal(r)
                        if (sg2 == 0 || sg2 == 3) { return (sg2 == 3) ? loopOuter(r) : r }
                        if (sg2 == 1) { loop = false }
                    } else { last = r }
                }
            }
            return last
        }
    }
    // items = [initExpr, condExpr, stepExpr, bodyThunk]
    function makeCFor(items) {
        var initT = items[0], condT = items[1], stepT = items[2], bodyT = items[3]
        return function() {
            var last = 0
            var r = anytype
            initT()
            var go = true
            while (go && condT() != 0) {
                r = bodyT()
                if (typeof r == "object") {
                    var sg = loopSignal(r)
                    if (sg == 0 || sg == 3) { return (sg == 3) ? loopOuter(r) : r }
                    if (sg == 1) { go = false }
                } else { last = r }
                if (go) { stepT() }
            }
            return last
        }
    }
    function mkElse(bodyT) { return {els: bodyT} }
    // clauses = [{cond,body} (if), {cond,body} (elif)*, {els} (else)?].
    function makeIf(clauses) {
        return function() {
            var i
            var cst = anytype
            for (i = 0; i < clauses.length; i++) {
                var cl = clauses[i]
                if (cl.els != undefined) { return cl.els() }
                cst = runCond(cl.cond)
                if (typeof cst == "object") { return cst }
                if (cst == 0) { return cl.body() }
            }
            return 0
        }
    }

    // items = [condThunk, bodyThunk].
    function makeWhile(items) {
        var condT = items[0]
        var bodyT = items[1]
        return function() {
            var last = 0
            var cst = anytype
            var r = anytype
            var loop = true
            while (loop) {
                cst = runCond(condT)
                if (typeof cst == "object") { return cst }
                if (cst != 0) { loop = false } else {
                    r = bodyT()
                    if (typeof r == "object") {
                        var sg = loopSignal(r)
                        if (sg == 0 || sg == 3) { return (sg == 3) ? loopOuter(r) : r }
                        if (sg == 1) { loop = false }
                    } else { last = r }
                }
            }
            return last
        }
    }

    // items = [{fname}, {words:[wordThunks]}, bodyThunk] in source order.
    function makeFor(items) {
        var fname = ""
        var wordThunks = null
        var bodyT = anytype
        var i
        for (i = 0; i < items.length; i++) {
            var it = items[i]
            if (typeof it == "function") { bodyT = it }
            else if (it.words != undefined) { wordThunks = it.words }
            else if (it.fname != undefined) { fname = it.fname }
        }
        return function() {
            // `for NAME; do` with no `in` list iterates the positional parameters.
            var vals = []
            if (wordThunks == null) {
                var w
                for (w = 0; w < posParams.length; w++) { vals.push(posParams[w]) }
            } else { vals = expandWords(wordThunks) }
            var last = 0
            var r = anytype
            var k
            for (k = 0; k < vals.length; k++) {
                setVarVal(fname, vals[k])
                r = bodyT()
                if (typeof r == "object") {
                    var sg = loopSignal(r)
                    if (sg == 0 || sg == 3) { return (sg == 3) ? loopOuter(r) : r }
                    if (sg == 1) { k = vals.length }
                } else { last = r }
            }
            return last
        }
    }

    // items = [{fname}, bodyThunk]. Registration happens when the statement runs.
    function makeFuncDef(items) {
        var fname = items[0].fname
        var bodyT = items[1]
        return function() {
            funcs["$" + fname] = bodyT
            setStatus(0)
            return 0
        }
    }

    // ---- run ----

    // Build all statement thunks, then run them top to bottom. The exit code of the whole
    // metacompiler run is the status of the last command (or an explicit exit N).
    function runProgram(stmts) {
        var i
        var r = anytype
        for (i = 0; i < stmts.length; i++) {
            r = stmts[i]()
            if (typeof r == "object") {
                if (r.isExit != undefined) { setStatus(r.ret); runExitTrap(); exit(r.ret) }
                setStatus(r.ret)
            }
        }
        runExitTrap()
        exit(lastStatus)
    }

    c.compile(c.asg)

~~) ;
