            if (it.op != undefined || it.pe != undefined || it.xf != undefined) { bare = false }
            if (it.pfx != undefined) { pfx = true }
            rest.push(it)
        }
        if (!indp || bare || pfx) { return paramCore(items, null) }
        var idxT = hasIdx ? fns[0] : null
        for (i = hasIdx ? 1 : 0; i < fns.length; i++) { rest.push(fns[i]) }
        var cell = {v: "", ok: false}
        var scalarT = paramCore(items, cell)
        var byTarget = {}
        var refName = name
        return function() {
            var tg = anytype
            if (idxT == null) { tg = indName(refName, null, null) }
            else { var raw = wordJoin(idxT()); tg = indName(refName, subKey(refName, raw), raw) }
            if (tg != null && (tg == "@" || tg == "*" || isElemRef(tg))) {
                var key = "$" + tg
                if (!hasOwn(byTarget, key)) { byTarget[key] = paramCore(targetItems(tg, "!" + refName, rest), null) }
                return byTarget[key]()
