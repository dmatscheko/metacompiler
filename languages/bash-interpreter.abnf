            cmdSubRan = false
            var v = (valT != null) ? valT() : ""
            setVarVal(name, v)
            // v=$(cmd) leaves $? at cmd's status; a plain assignment always succeeds.
            if (!cmdSubRan) { setStatus(0) }
            return lastStatus
        }
    }

    // items[0] is the command word thunk; the rest are argument word thunks and redirections.
    function makeSimpleCommand(items) {
        var cmdT = items[0]
        var argTs = []
        var redirs = []
        var i
        for (i = 1; i < items.length; i++) {
            var it = items[i]
            if (typeof it == "function") { argTs.push(it) } else { redirs.push(it) }
        }
        return function() {
            var cmd = cmdT()
            var args = []
            var k
            for (k = 0; k < argTs.length; k++) { args.push(argTs[k]()) }
            if (redirs.length == 0) { return runCommand(cmd, args) }
            var rs = openRedirs(redirs)
            var st = anytype
            st = runCommand(cmd, args)
            closeRedirs(rs)
            return st
        }
    }

    // Apply a redirection list: an output redirection swallows the command's output (there is
    // no filesystem here), an input redirection other than a here-string gives end of file.
    function openRedirs(redirs) {
        var suppress = false
        var newIn = null
        var i
        for (i = 0; i < redirs.length; i++) {
            var r = redirs[i]
            var tgt = (r.target != null) ? r.target() : ""
            if (r.rd == "<<<") { newIn = tgt + "\n" }
            else if (r.rd == "<") { newIn = "" }
            else if (r.rd == ">&" || r.rd == "<&") { }
            else { if (r.iofd == "" || r.iofd == "1") { suppress = true } }
        }
        var st = {sup: suppress, inb: stdinBuf, inp: stdinPos, hadIn: (newIn != null)}
        if (suppress) { capStack.push("") }
        if (newIn != null) { stdinBuf = newIn; stdinPos = 0 }
        return st
    }
    function closeRedirs(st) {
        if (st.sup) { capStack.pop() }
        if (st.hadIn) { stdinBuf = st.inb; stdinPos = st.inp }
    }

    // read [-r] [-a NAME] NAME... : one line of standard input, split on IFS, the last name
    // taking the rest. Returns 1 at end of file, exactly like the shell.
    function readBuiltin(args) {
        var names = []
        var i = 0
        while (i < args.length) {
            var a = args[i]
            if (a == "-a" || a == "-d" || a == "-n" || a == "-N" || a == "-p" || a == "-t" || a == "-u") { i = i + 1 }
            else if (a.length > 1 && a.charAt(0) == "-") { }
            else { names.push(a) }
            i = i + 1
        }
        if (stdinPos >= stdinBuf.length) {
            var z
            for (z = 0; z < names.length; z++) { setVarVal(names[z], "") }
            return 1
        }
        var e = stdinPos
        while (e < stdinBuf.length && stdinBuf.charAt(e) != "\n") { e = e + 1 }
        var line = stdinBuf.slice(stdinPos, e)
        stdinPos = (e < stdinBuf.length) ? (e + 1) : e
        if (names.length == 0) { setVarVal("REPLY", line); return 0 }
        var fields = splitIFS(line)
        var k
        for (k = 0; k < names.length; k++) {
            if (k == names.length - 1) {
                var rest = ""
                var j
                for (j = k; j < fields.length; j++) { if (j > k) { rest = rest + " " }; rest = rest + fields[j] }
                setVarVal(names[k], rest)
            } else {
                setVarVal(names[k], (k < fields.length) ? fields[k] : "")
            }
        }
        return 0
    }
    // Split on the characters of IFS (default: space, tab and newline), dropping empty fields.
    function splitIFS(line) {
        var seps = isSetVar("IFS") ? vars["$IFS"] : " \t\n"
        var out = []
        var cur = ""
        var i
        for (i = 0; i < line.length; i++) {
            var ch = line.charAt(i)
            var isSep = false
            var j
            for (j = 0; j < seps.length; j++) { if (seps.charAt(j) == ch) { isSep = true } }
            if (isSep) { if (cur != "") { out.push(cur) }; cur = "" }
            else { cur = cur + ch }
        }
        if (cur != "") { out.push(cur) }
        return out
    }

    function echoCmd(args) {
        var i = 0
        var newline = true
        if (args.length > 0 && args[0] == "-n") { newline = false; i = 1 }
        var out = ""
        var first = true
        while (i < args.length) {
            if (!first) { out = out + " " }
            out = out + args[i]
            first = false
            i = i + 1
        }
        if (newline) { out = out + "\n" }
        emitOut(out)
    }

    // ---- the test builtin -------------------------------------------------------------
    // There is no real filesystem behind a grammar run, so the file predicates answer from a
    // small MODEL of the standard paths every shell can rely on. Anything else is "absent".
    // 0 = absent, 1 = exists and is not a directory, 2 = directory.
    function fsKind(p) {
        if (p == "/dev/null" || p == "/dev/zero" || p == "/dev/tty") { return 1 }
        if (p == "/dev/stdin" || p == "/dev/stdout" || p == "/dev/stderr") { return 1 }
        if (p == "/" || p == "/dev" || p == "/tmp" || p == "/usr" || p == "/etc") { return 2 }
        if (p == "/var" || p == "/bin" || p == "/usr/bin") { return 2 }
        return 0
    }

    function isTestUnary(t) {
        if (t == "-z" || t == "-n" || t == "-v") { return true }
        if (t == "-e" || t == "-f" || t == "-d" || t == "-s" || t == "-r" || t == "-w") { return true }
        if (t == "-x" || t == "-h" || t == "-L" || t == "-b" || t == "-c" || t == "-p") { return true }
        if (t == "-S" || t == "-t" || t == "-g" || t == "-u" || t == "-k" || t == "-O") { return true }
        return false
    }
    function isTestBinary(t) {
        if (t == "=" || t == "==" || t == "!=" || t == "<" || t == ">") { return true }
        if (t == "-eq" || t == "-ne" || t == "-lt" || t == "-le" || t == "-gt" || t == "-ge") { return true }
        if (t == "-nt" || t == "-ot" || t == "-ef") { return true }
        return false
    }
    function testUnary(op, s) {
        if (op == "-z") { return (s == "") ? 0 : 1 }
        if (op == "-n") { return (s != "") ? 0 : 1 }
        if (op == "-v") { return isSetVar(s) ? 0 : 1 }
        if (op == "-d") { return (fsKind(s) == 2) ? 0 : 1 }
        if (op == "-e" || op == "-r" || op == "-w") { return (fsKind(s) != 0) ? 0 : 1 }
        if (op == "-f" || op == "-s") { return (fsKind(s) == 1) ? 0 : 1 }
        if (op == "-c" || op == "-b") { return (fsKind(s) == 1) ? 0 : 1 }
        return 1
    }
    function testBinary(l, op, r) {
        if (op == "-eq") { return (strToInt(l) == strToInt(r)) ? 0 : 1 }
        if (op == "-ne") { return (strToInt(l) != strToInt(r)) ? 0 : 1 }
        if (op == "-lt") { return (strToInt(l) < strToInt(r)) ? 0 : 1 }
        if (op == "-le") { return (strToInt(l) <= strToInt(r)) ? 0 : 1 }
        if (op == "-gt") { return (strToInt(l) > strToInt(r)) ? 0 : 1 }
        if (op == "-ge") { return (strToInt(l) >= strToInt(r)) ? 0 : 1 }
        if (op == "=" || op == "==") { return (l == r) ? 0 : 1 }
        if (op == "!=") { return (l != r) ? 0 : 1 }
        if (op == "<") { return (l < r) ? 0 : 1 }
        if (op == ">") { return (l > r) ? 0 : 1 }
        fail("unknown binary test operator: " + op)
        return 2
    }

    // A recursive descent over the ARGUMENT LIST: or := and { -o and }, and := not { -a not },
    // not := "!" not | prim, prim := "(" or ")" | UNOP word | word [ BINOP word ] | word.
    function tstAt(a, st) { return (st.i < a.length) ? a[st.i] : "\x00end" }
    function tstPrim(a, st) {
        var t = tstAt(a, st)
        if (t == "(") {
            st.i = st.i + 1
            var r = tstOr(a, st)
            if (tstAt(a, st) == ")") { st.i = st.i + 1 }
            return r
        }
        if (t == "!") { st.i = st.i + 1; var r2 = tstPrim(a, st); return (r2 == 0) ? 1 : 0 }
        if (isTestUnary(t) && st.i + 1 < a.length && !isTestBinary(a[st.i + 1])) {
            var opnd = a[st.i + 1]
            st.i = st.i + 2
            return testUnary(t, opnd)
        }
        st.i = st.i + 1
        if (st.i + 1 < a.length + 0 && isTestBinary(tstAt(a, st))) {
            var op = tstAt(a, st)
            var rhs = a[st.i + 1]
            st.i = st.i + 2
            return testBinary(t, op, rhs)
        }
        return (t != "") ? 0 : 1
    }
    function tstAnd(a, st) {
        var v = tstPrim(a, st)
        while (tstAt(a, st) == "-a") { st.i = st.i + 1; var r = tstPrim(a, st); if (r != 0) { v = 1 } }
        return v
    }
    function tstOr(a, st) {
        var v = tstAnd(a, st)
        while (tstAt(a, st) == "-o") { st.i = st.i + 1; var r = tstAnd(a, st); if (r == 0) { v = 0 } }
        return v
    }

    // The test builtin: [ ... ] (drops the closing ]) or `test ...`.
    function testBuiltin(cmd, argsIn) {
        var a = argsIn
        if (cmd == "[") {
            if (a.length == 0 || a[a.length - 1] != "]") { fail("[ used without the closing ]") }
            a = a.slice(0, a.length - 1)
        }
        if (a.length == 0) { return 1 }
        if (a.length == 1) { return (a[0] != "") ? 0 : 1 }
        var st = {i: 0}
        return tstOr(a, st)
    }

    // Dispatch a command by its (already expanded) name. Returns an int status, or {ret: n}
    // for the return builtin; exit terminates the whole run immediately.
    function runCommand(cmd, args) {
        if (cmd == "echo") { echoCmd(args); setStatus(0); return 0 }
        if (cmd == "[" || cmd == "test") { var st = testBuiltin(cmd, args); setStatus(st); return st }
        if (cmd == "true" || cmd == ":") { setStatus(0); return 0 }
        if (cmd == "unset") {
            var ui
            for (ui = 0; ui < args.length; ui++) { unsetVar(args[ui]) }
            setStatus(0)
            return 0
        }
        if (cmd == "false") { setStatus(1); return 1 }
        if (cmd == "read") { var rst = readBuiltin(args); setStatus(rst); return rst }
        if (cmd == "shift") {
            var n = (args.length > 0) ? strToInt(args[0]) : 1
            posParams = (n <= posParams.length) ? posParams.slice(n) : []
            setStatus(0)
            return 0
        }
        if (cmd == "exit") {
            var code = (args.length > 0) ? strToInt(args[0]) : lastStatus
            return {ret: code, isExit: 1}
        }
        if (cmd == "return") {
            var rc = (args.length > 0) ? strToInt(args[0]) : lastStatus
            return {ret: rc}
        }
        var key = "$" + cmd
        if (hasOwn(funcs, key)) {
            var st2 = anytype
            st2 = callFunc(cmd, args)
            if (typeof st2 == "object") { return st2 }
            setStatus(st2)
            return st2
        }
        fail("command not found: " + cmd)
        return 127
    }

    // Call a user function: bind $1.. to args, run the body, restore, return its status.
    function callFunc(name, args) {
        var body = funcs["$" + name]
        var saved = posParams
        posParams = args
        pushLocalFrame()
        declareLocal("FUNCNAME")
        setVarVal("FUNCNAME", name)
        var r = anytype
        r = body()
        popLocalFrame()
        posParams = saved
        if (typeof r == "object") {
            if (r.isExit != undefined) { return r }   // an exit unwinds past the caller too
            return r.ret
        }
        return r
    }

    // cmd1 && cmd2 || cmd3 : short circuit on the running status; a {ret} unwinds at once.
    function makeAndOr(items) {
        if (items.length == 1) { return items[0] }
        return function() {
            var st = anytype
            st = items[0]()
            if (typeof st == "object") { return st }
            var i
            for (i = 1; i < items.length; i += 2) {
                var op = items[i].op
                var runIt = (op == "&&") ? (st == 0) : (st != 0)
                if (runIt) {
                    st = items[i + 1]()
                    if (typeof st == "object") { return st }
                }
            }
            return st
        }
    }

    // A statement sequence: the value is the last statement's status; a {ret} unwinds.
    function makeSeq(thunks) {
        return function() {
            var last = 0
            var r = anytype
            var i
            for (i = 0; i < thunks.length; i++) {
                r = thunks[i]()
                if (typeof r == "object") { return r }
                last = r
            }
            return last
        }
    }

    // items = [{pats}, bodyThunk, {cterm}?]
    function mkCaseClause(items) {
        var pats = []
        var body = null
        var term = ";;"
        var i
        for (i = 0; i < items.length; i++) {
            var it = items[i]
            if (typeof it == "function") { body = it }
            else if (it.pats != undefined) { pats = it.pats }
            else if (it.cterm != undefined) { term = it.cterm }
        }
        return {pats: pats, body: body, cterm: term}
    }
    // items = [subjectWordThunk, clause...]
    function makeCase(items) {
        var subjT = items[0]
        var clauses = items.slice(1)
        return function() {
            var s = subjT()
            var i = 0
            var fall = false
            var last = 0
            var stop = false
            while (i < clauses.length && !stop) {
                var cl = clauses[i]
                var hit = fall
                var k
                for (k = 0; k < cl.pats.length; k++) { if (globMatch(cl.pats[k](), s)) { hit = true } }
                fall = false
                if (hit) {
                    var r = anytype
                    r = cl.body()
                    if (typeof r == "object") { return r }
                    last = r
                    setStatus(r)
                    if (cl.cterm == ";&") { fall = true }
                    else if (cl.cterm != ";;&") { stop = true }
                }
                i = i + 1
            }
            if (!stop) { setStatus(last) }
            return last
        }
    }

    // ---- pipelines, subshells, groups, (( )), [[ ]], redirections ----

    // items = [{bang}?, stageThunk...] : each stage but the last runs with its stdout
    // captured, and that capture becomes the next stage's standard input.
    function makePipeline(items) {
        var bang = false
        var stages = []
        var i
        for (i = 0; i < items.length; i++) {
            var it = items[i]
            if (typeof it == "function") { stages.push(it) } else { bang = true }
        }
        if (!bang && stages.length == 1) { return stages[0] }
        return function() {
            var savedIn = stdinBuf, savedPos = stdinPos
            var st = anytype
            st = 0
            var k
            for (k = 0; k < stages.length; k++) {
                var lastStage = (k == stages.length - 1)
                if (!lastStage) { capStack.push("") }
                st = stages[k]()
                if (!lastStage) {
                    var out = capStack.pop()
                    stdinBuf = out
                    stdinPos = 0
                }
                if (typeof st == "object") { k = stages.length }
            }
            stdinBuf = savedIn
            stdinPos = savedPos
            if (typeof st == "object") { return st }
            if (bang) { st = (st == 0) ? 1 : 0 }
            setStatus(st)
            return st
        }
    }

    // ( LIST ) : variables and positional parameters are restored afterwards, and both a
    // `return` and an `exit` inside end only the subshell.
    function makeSubshell(bodyT) {
        return function() {
            var saved = snapshotVars()
            var savedPos = posParams
            var savedFrames = localFrames
            localFrames = []
            var r = anytype
            r = bodyT()
            localFrames = savedFrames
            restoreVars(saved)
            posParams = savedPos
            var st = 0
            if (typeof r == "object") { st = r.ret } else { st = r }
            setStatus(st)
            return st
        }
    }
    // { LIST; } runs in the current shell, so it is just its body.
    function makeGroup(bodyT) { return bodyT }

    // (( expr )) : status 0 when the value is non-zero (the opposite of C).
    function makeArithCmd(exprT) {
        return function() { var st = (exprT() != 0) ? 0 : 1; setStatus(st); return st }
    }
    // let EXPR ... : same evaluator, status from the LAST expression.
    function makeLetCmd(items) {
        return function() {
            var v = 0
            var i
            for (i = 0; i < items.length; i++) { v = items[i]() }
            var st = (v != 0) ? 0 : 1
            setStatus(st)
            return st
        }
    }
    // [[ ... ]] : the condition thunks answer a boolean; the command status is its inverse.
    function makeCondCmd(t) {
        return function() { var st = t() ? 0 : 1; setStatus(st); return st }
    }
    function foldCondOr(items) {
        if (items.length == 1) { return items[0] }
        return function() {
            var i
            for (i = 0; i < items.length; i++) { if (items[i]()) { return true } }
            return false
        }
    }
    function foldCondAnd(items) {
        if (items.length == 1) { return items[0] }
        return function() {
            var i
            for (i = 0; i < items.length; i++) { if (!items[i]()) { return false } }
            return true
        }
    }
    function mkCondNot(t) { return function() { return !t() } }
    function mkCondSingle(w) { return function() { return w() != "" } }
    function mkCondUn(items) {
        var op = items[0].cop
        var w = items[1]
        return function() { return testUnary(op, w()) == 0 }
    }
    function mkCondBin(items) {
        var l = items[0], op = items[1].cop, r = items[2]
        return function() {
            var lv = l()
            var rv = r()
            // == and != glob-match their right hand side inside [[ ]]; = is a synonym of ==.
            if (op == "==" || op == "=") { return globMatch(rv, lv) }
            if (op == "!=") { return !globMatch(rv, lv) }
            if (op == "=~") { fail("[[ =~ ]] (regex matching) is not supported") }
            return testBinary(lv, op, rv) == 0
        }
    }

    // Redirection: without a filesystem, an output redirection DISCARDS the output and an
    // input redirection other than a here-string yields end of file at once.
    function mkRedir(items) {
        var op = "", fd = "", t = null
        var i
        for (i = 0; i < items.length; i++) {
            var it = items[i]
            if (typeof it == "function") { t = it }
            else if (it.redir != undefined) { op = it.redir }
            else if (it.iofd != undefined) { fd = it.iofd }
        }
        return {rd: op, iofd: fd, target: t}
    }

    function mkCond(items) { return {cond: items[0], body: items[1]} }
    function makeUntil(items) {
        var condT = items[0], bodyT = items[1]
        return function() {
            var last = 0
            var cst = anytype
            var r = anytype
            var loop = true
            while (loop) {
                cst = condT()
                if (typeof cst == "object") { return cst }
                if (cst == 0) { loop = false } else {
                    r = bodyT()
                    if (typeof r == "object") { return r }
                    last = r
                }
            }
            return last
        }
    }
    // items = [initExpr, condExpr, stepExpr, bodyThunk]
    function makeCFor(items) {
        var initT = items[0], condT = items[1], stepT = items[2], bodyT = items[3]
        return function() {
            var last = 0
            var r = anytype
            initT()
            while (condT() != 0) {
                r = bodyT()
                if (typeof r == "object") { return r }
                last = r
                stepT()
            }
            return last
        }
    }
    function mkElse(bodyT) { return {els: bodyT} }
    // clauses = [{cond,body} (if), {cond,body} (elif)*, {els} (else)?].
    function makeIf(clauses) {
        return function() {
            var i
            var cst = anytype
            for (i = 0; i < clauses.length; i++) {
                var cl = clauses[i]
                if (cl.els != undefined) { return cl.els() }
                cst = cl.cond()
                if (typeof cst == "object") { return cst }
                if (cst == 0) { return cl.body() }
            }
            return 0
        }
    }

    // items = [condThunk, bodyThunk].
    function makeWhile(items) {
        var condT = items[0]
        var bodyT = items[1]
        return function() {
            var last = 0
            var cst = anytype
            var r = anytype
            var loop = true
            while (loop) {
                cst = condT()
                if (typeof cst == "object") { return cst }
                if (cst != 0) { loop = false } else {
                    r = bodyT()
                    if (typeof r == "object") { return r }
                    last = r
                }
            }
            return last
        }
    }

    // items = [{fname}, {words:[wordThunks]}, bodyThunk] in source order.
    function makeFor(items) {
        var fname = ""
        var wordThunks = anytype
        var bodyT = anytype
        var i
        for (i = 0; i < items.length; i++) {
            var it = items[i]
            if (typeof it == "function") { bodyT = it }
            else if (it.words != undefined) { wordThunks = it.words }
            else if (it.fname != undefined) { fname = it.fname }
        }
        return function() {
            var last = 0
            var r = anytype
            var k
            for (k = 0; k < wordThunks.length; k++) {
                setVarVal(fname, wordThunks[k]())
                r = bodyT()
                if (typeof r == "object") { return r }
                last = r
            }
            return last
        }
    }

    // items = [{fname}, bodyThunk]. Registration happens when the statement runs.
    function makeFuncDef(items) {
        var fname = items[0].fname
        var bodyT = items[1]
        return function() {
            funcs["$" + fname] = bodyT
            setStatus(0)
            return 0
        }
    }

    // ---- run ----

    // Build all statement thunks, then run them top to bottom. The exit code of the whole
    // metacompiler run is the status of the last command (or an explicit exit N).
    function runProgram(stmts) {
        var i
        var r = anytype
        for (i = 0; i < stmts.length; i++) {
            r = stmts[i]()
            if (typeof r == "object") {
                if (r.isExit != undefined) { exit(r.ret) }
                setStatus(r.ret)
            }
        }
        exit(lastStatus)
    }

    c.compile(c.asg)

~~) ;
