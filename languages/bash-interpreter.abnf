            if (xf != "") {
                var idxXf = xf
                var idxName = name
                return function() {
                    var sub = readIdx()
                    if (sub != "@" && sub != "*") {
                        return xformOne(scGet(idxName, sub), idxXf, idxName, scHas(idxName, sub))
                    }
                    // @A, @K and @k describe the WHOLE VARIABLE when the subscript is @ or *,
                    // and none of the three is the per-element walk the others are. bash 5.3.15:
                    //   a=(pa pb)          ${a[@]@A} -> declare -a a=([0]="pa" [1]="pb")
                    //                      ${a[@]@K} -> 0 "pa" 1 "pb"
                    //                      ${a[@]@k} -> the four fields 0 pa 1 pb
                    //   s=hi (not an array) ${s[@]@A} -> s='hi'   i.e. the scalar form
                    // @A's [@] form is a FIELD LIST: bash splits the text `declare -a a=` on
                    // IFS (a null IFS counting as the default) and keeps the parenthesised
                    // value atomic, glued to the last field unless that text ends in a
                    // delimiter. So `printf '<%s>' "${a[@]@A}"` prints three items under the
                    // default IFS, one under IFS=: and two (`declare -a a`, the value) under
                    // IFS==. The [*] form is the one string `declare -a a=(...)` whatever
                    // IFS holds, except unquoted under a null IFS (see starFields). Twin of
                    // rt_declxa in languages/lib/bash-rt.c.
                    if (idxXf == "A" && isPosName(idxName)) { return posDeclA(sub) }
                    if (idxXf == "A" && declIsArr(idxName)) {
