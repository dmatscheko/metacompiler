    // standard error channel, 2 = discarded.
    //
    // Channel 1 goes to `eprintln`, the tag host's standard-error channel, which both script
    // hosts bind identically (goja in abnf/commonscript.go, the frozen engine in abnf/jsrt.go)
    // so the matrix's byte-identical stderr holds. eprintln APPENDS a newline and there is no
    // eprint, so channel 1 is LINE BUFFERED: bytes accumulate in errBuf and each complete line
    // is handed over without its newline. That is exact for everything a shell writes to fd 2
    // in practice; a final PARTIAL line (`printf x >&2`) is flushed at the end of the run and
    // gains a newline - the one byte this half cannot match.
    var sinkOut = 0
    var sinkErr = 1
    var errBuf = ""

    function writeChan(ch, s) {
        if (ch == 1) { errBuf = errBuf + s; flushErrLines(); return }
