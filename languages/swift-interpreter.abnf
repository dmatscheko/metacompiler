    // forced ".0" on a one-digit mantissa. The twins are swFloStr32 in
    // abnf/jsrtswift.go and swF32Str in languages/lib/swift-rt.metajs.

    // The host's own shortest rendering of a > 0, split into the significant
    // digits and the SCIENTIFIC exponent of the first one.
    function swSplitDE(a) {
        var s = "" + a
        var mant = s
        var exp = 0
        var ei = 0 - 1
        for (var i = 0; i < s.length; i++) { if (s.charAt(i) == "e" || s.charAt(i) == "E") { ei = i } }
        if (ei >= 0) {
            mant = s.substring(0, ei)
            var et = s.substring(ei + 1)
            if (et.charAt(0) == "+") { et = et.substring(1) }
            exp = parseInt(et, 10)
        }
        var digits = ""
        var pt = 0 - 1
        for (var j = 0; j < mant.length; j++) {
