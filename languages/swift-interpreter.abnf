                    if (cur === null || cur === undefined) { return null }
                } else if (s.kind == "force") {
                    // Force unwrap: the value is already the unwrapped one here.
                } else if (s.kind == "mcall") {
                    var ea = evalArgs(s.args)
                    cur = mcall(cur, s.name, ea.argv)
                    writeBacks(ea.boxes)
                } else if (s.kind == "call") {
