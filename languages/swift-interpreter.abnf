    // overloaded operator work through it. A type may still DECLARE `static func +=`
    // - it is accepted - but the + overload is the one that runs.
    applyOps["+="] = function(a, b) { return binOp("+", a, b) }
    applyOps["-="] = function(a, b) { return binOp("-", a, b) }
    applyOps["*="] = function(a, b) { return binOp("*", a, b) }
    applyOps["/="] = function(a, b) { return binOp("/", a, b) }
    applyOps["%="] = function(a, b) { return binOp("%", a, b) }
    // -x: a `static prefix func -` on the operand's type wins over the negation.
    makeNeg = function(t) {
        return function() {
            var v = t()
            var f = findOpFn("-", v)
            if (f != null) { return f(undefined, v) }
            // A float negates by MULTIPLYING by -1: `0 - 0.0` is +0.0 in JS, so
            // -0.0 would have lost its sign (and print "0.0" where swift says "-0.0").
            return swWhole(v) ? szNeg(v) : swFlo(swD(v) * swNegOne)
        }
    }
    // Double(x) / Float(x): the conversion that BOXES, and the type's own statics.
    // Double(3) is 3.0 and Double(3) / 2 is 1.5 - that is the whole point of the
    // box. A String source is failable, like Int("x").
    // Double("3.5") is FAILABLE: swift answers nil unless the WHOLE string is a
    // number, where parseFloat would stop at the first bad character and answer 3.5
    // for "3.5x". [+-]? digits [. digits] [(e|E) [+-] digits], at least one digit.
    function swFloText(s) {
        var i = 0
        if (i < s.length && (s.charAt(i) == "+" || s.charAt(i) == "-")) { i++ }
        var d0 = i
        while (i < s.length && s.charAt(i) >= "0" && s.charAt(i) <= "9") { i++ }
        var seen = i > d0
        if (i < s.length && s.charAt(i) == ".") {
            i++
            var d1 = i
            while (i < s.length && s.charAt(i) >= "0" && s.charAt(i) <= "9") { i++ }
            if (i > d1) { seen = true }
        }
        if (!seen) { return false }
        if (i < s.length && (s.charAt(i) == "e" || s.charAt(i) == "E")) {
            i++
            if (i < s.length && (s.charAt(i) == "+" || s.charAt(i) == "-")) { i++ }
            var d2 = i
            while (i < s.length && s.charAt(i) >= "0" && s.charAt(i) <= "9") { i++ }
            if (i == d2) { return false }
        }
        return i == s.length
    }
    function swFloConv(x) {
        if (isFlo(x)) { return x }
        if (typeof x == "string") {
            if (!swFloText(x)) { return null }
            return swFlo(parseFloat(x))
