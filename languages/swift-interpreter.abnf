    // ----- Values: dictionaries, strings, indexing (js_pyget/js_pyset semantics) -----
    // Dictionaries (isDict/dictFind/dictSet) are shared - see lib/interp-core.js.
    // String(describing:) - what print writes and what "\(v)" interpolates.
    //
