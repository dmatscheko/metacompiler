                if (noSig) {
                    for (var sh = 0; sh < 4; sh++) { declVar("$" + sh, sh < args.length ? args[sh] : undefined) }
                }
                var last = anytype // A block's value hops types across items.
                last = undefined
                for (var k = 0; k < body.length; k++) {
                    if (body[k].expr != undefined) {
