        var whereT = null
        if (rest[k] != undefined && rest[k].fwhere != undefined) { whereT = rest[k].fwhere; k++ }
        var bodyT = rest[k]
        return function() {
            var res = undefined
            var from = fromT()
            var last = toT()
            if (rop == "..<") { last = (last - 1) | 0 }
            for (var i = from; i <= last; i++) {
                scopes.push({})
                bindForPat(pat, i)
                var r = undefined
                if (whereT == null || core.test(whereT())) { r = bodyT() }
                scopes.pop()
                var a = loopAct(r, lbl)
