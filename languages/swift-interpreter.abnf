    // ----- Calls: argument labels, default values, variadics and inout -----
    // A call site knows the callee's parameter list whenever the callee was declared
    // earlier in the walk (sigReg, filled by every func/init as it is built), so the
    // arguments a call LEAVES OUT because they are defaulted are filled in here, by
    // matching each argument's label against the parameter labels in order. Swift
    // requires arguments in declaration order, so this is a single forward pass.
    // Without a signature (a call through a function value, or a callee declared
    // further down) the arguments stay positional and the callee fills the trailing
    // defaults itself.
    var sigReg = {}
    function regSig(name, params) { scopePut(sigReg, "$" + name, params) }
    function lookupSig(name) { return hasOwn(sigReg, "$" + name) ? sigReg["$" + name] : null }

    function makeParam(items) {
        var ids = []
        var type = ""
        var isVar = false
        var isInout = false
        var isAuto = false
        var hasDflt = false
        var dflt = null
        for (var i = 0; i < items.length; i++) {
            var it = items[i]
            if (it.pid != undefined) { ids.push(it.pid) }
            else if (it.ptype != undefined) { type = stripWs(it.ptype) }
            else if (it.pvar != undefined) { isVar = true }
            else if (it.pinout != undefined) { isInout = true }
            else if (it.pdflt != undefined) { hasDflt = true; dflt = it.pdflt }
            else if (it.pattr != undefined && it.pattr == "autoclosure") { isAuto = true }
