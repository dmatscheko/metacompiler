    // items = [{lbl}?, condT, bodyT]
    function makeWhileL(items) {
        var lbl = itemLbl(items)
        var rest = itemsAfterLbl(items)
        var condT = rest[0]
        var bodyT = rest[1]
        return function() {
            while (core.test(condT())) {
