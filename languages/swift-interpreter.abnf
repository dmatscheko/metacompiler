    // chain is the captured scope chain of a NESTED function (a closure over its
    // defining scope); a top-level function passes null and starts from the globals.
    function makeFunBody(f, chain, self) {
        var args = []
        var raw = arguments
        for (var i = 3; i < raw.length; i++) { args.push(raw[i]) }
        var bnd = swBindArgs(f.params, args)
        var saved = scopes
        if (chain == null) { scopes = [globalScope, {}] }
        else { scopes = chain.slice(0); scopes.push({}) }
