        var r = f.body()
        for (var k = 0; k < bnd.boxes.length; k++) { bnd.boxes[k].box.v = getVar(bnd.boxes[k].name) }
        scopes = saved
        return relabelRet(f, (r != undefined && r.isRet) ? r.v : undefined)
