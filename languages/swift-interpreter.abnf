    // items = [{lbl}?, pat, listT, {fwhere}?, bodyT]. Iterating a dictionary with a
    // tuple pattern yields (key, value) pairs; with a plain name it yields the keys.
    function makeForList(items) {
        var lbl = itemLbl(items)
        var rest = itemsAfterLbl(items)
        var pat = rest[0]
        var listT = rest[1]
        var k = 2
        var whereT = null
        if (rest[k] != undefined && rest[k].fwhere != undefined) { whereT = rest[k].fwhere; k++ }
        var bodyT = rest[k]
        var wantPair = pat.tnames != undefined
        return function() {
            var arr = listT()
            var res = undefined
            var isD = isDict(arr)
            var n = swlen(arr)
            for (var i = 0; i < n; i++) {
                var el = anytype
                if (isD) { el = wantPair ? newTupleVal([arr.keys[i], arr.vals[i]]) : arr.keys[i] }
                else { el = arr[i] }
                scopes.push({})
                bindForPat(pat, el)
                var r = undefined
                if (whereT == null || core.test(whereT())) { r = bodyT() }
                scopes.pop()
                var a = loopAct(r, lbl)
                if (a == 1) { break }
                if (a == 3) { res = r; break }
            }
            return res
        }
    }
    function makeReturn(items) {
        var t = items.length > 0 ? items[0] : makeConst(undefined)
        return function() { return {isRet: true, v: t()} }
    }

    // guard COND else BLOCK: run the else block only when COND is falsey, and
    // propagate its signal (typically a return); otherwise fall through.
    function makeGuard(items) {
        var condT = items[0]
        var elseT = items[1]
        return function() {
            if (core.test(condT())) { return undefined }
            return elseT()
        }
    }

    // A case label carries its value thunks (empty for default).
    function makeCaseLabel(items) {
        var vals = []
        for (var i = 0; i < items.length; i++) { vals.push(items[i].v) }
        return {isDefault: items.length == 0, vals: vals}
    }
    // items = [{subj}, label or statement thunk...]: the flat item list is regrouped
    // so every statement belongs to the last label; no fallthrough. The subject is
    // evaluated once and compared (==) to each case value in source order; a bare
    // break ends the switch, other signals (return/continue) propagate.
    function makeSwitch(items) {
        var subj = null
        var cases = []
        var cur = null
        var swLbl = itemLbl(items)
        for (var i = 0; i < items.length; i++) {
            var it = items[i]
            if (typeof it == "function") {
                if (cur != null) { cur.body.push(it) }
            } else if (it.lbl != undefined) {
                continue
            } else if (it.subj != undefined) {
                subj = it.subj
            } else {
