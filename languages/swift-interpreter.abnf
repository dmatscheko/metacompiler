    }
    function makeOptBind(items) {
        var names = items[0].bnames
        var initT = null
        var whereT = null
        for (var i = 1; i < items.length; i++) {
            if (items[i].cinit != undefined) { initT = items[i].cinit }
            else if (items[i].cwhere != undefined) { whereT = items[i].cwhere }
        }
        // `if let x` (Swift 5.7) rebinds x from the x already in scope.
        if (initT == null) { initT = makeVarRef(names[0]) }
        return {bindNames: names, init: initT, whereT: whereT}
    }
    function makeCaseCond(items) {
        var initT = null
        var whereT = null
        for (var i = 1; i < items.length; i++) {
            if (items[i].cinit != undefined) { initT = items[i].cinit }
            else if (items[i].cwhere != undefined) { whereT = items[i].cwhere }
        }
        return {pat: items[0], init: initT, whereT: whereT}
    }
    function makeCondIf(items) {
        var conds = items[0].conds
        var thenT = items[1]
        var elseT = items.length > 2 ? items[2] : null
        return function() {
            scopes.push({})
            var ok = runConds(conds)
            var r = undefined
            if (ok) { r = thenT() }
            scopes.pop()
            if (!ok && elseT != null) { r = elseT() }
            return r
