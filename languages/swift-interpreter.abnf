    // f(args): a global function or a class/struct constructor (runs __ctor then init).
    function makeCall(items) {
        var name = items[0]
        var recs = planArgs(name, items.slice(1))
        return function() {
            var ea = evalArgs(recs)
            var argv = ea.argv
            var f = getVar(name)
            if (f != undefined && f !== null && f.__isclass === true) {
                var obj = {__class: f}
                if (typeof f.__ctor == "function") { f.__ctor(obj) }
                var init = f["init"]
                if (typeof init == "function") { init.apply(undefined, concat2impl([obj], argv)) }
                writeBacks(ea.boxes)
                return obj
