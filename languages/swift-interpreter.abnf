            if (typeof swD(a) != "number" || typeof swD(b) != "number") { return false }
            return swD(a) === swD(b)
        }
        if (szIs(a) || szIs(b)) {
            if (!swWhole(a) || !swWhole(b)) { return false }
            return szEq(a, b)
