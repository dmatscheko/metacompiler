            for (i = 0; i < n - rk; i++) { t[i] = t[i + rk] }
            for (i = 0; i < rk; i++) { t.pop() }
            return undefined
        }
        // remove(at:) answers the removed element.
        if (name == "remove") {
            var ai = szNum(args[0]) | 0
            if (ai < 0 || ai >= n) { fail("Fatal error: Index out of range") }
            var rv = t[ai]
            for (i = ai; i < n - 1; i++) { t[i] = t[i + 1] }
            t.pop()
            return rv
        }
        if (name == "removeAll") {
            if (args.length > 0 && typeof args[0] == "function") {
                var keep = []
                for (i = 0; i < n; i++) { if (!args[0](t[i])) { keep.push(t[i]) } }
                while (t.length > 0) { t.pop() }
                for (i = 0; i < keep.length; i++) { t.push(keep[i]) }
                return undefined
            }
            while (t.length > 0) { t.pop() }
            return undefined
        }
        // reversed() answers a ReversedCollection in Swift, whose printed form names
        // the STATIC element type - `ReversedCollection<Array<Int>>(_base: [3, 1, 2])`.
        // That needs a type checker (manual 7.9's Optional argument, exactly), so a
        // plain reversed ARRAY is answered instead: every use except printing the
        // collection itself agrees (`print(a.reversed())` prints `[2, 1, 3]`, not
        // swiftc's ReversedCollection spelling).
        if (name == "reversed") {
            out = []
            for (i = n - 1; i >= 0; i--) { out.push(t[i]) }
            return out
        }
        if (name == "sorted") { return swMergeSort(t, swLessOf(args)) }
        // sort() is the MUTATING form and answers Void.
        if (name == "sort") {
            var so = swMergeSort(t, swLessOf(args))
            for (i = 0; i < n; i++) { t[i] = so[i] }
            return undefined
        }
        // randomElement(): from the same stream as shuffled(); nil when empty.
        if (name == "randomElement") { return n == 0 ? null : t[swRndBelow(n)] }
        if (name == "shuffled") {
            out = t.slice(0)
            for (i = out.length - 1; i > 0; i--) {
                var j = swRndBelow(i + 1)
                var tmp = out[i]
                out[i] = out[j]
                out[j] = tmp
            }
            return out
        }
        if (name == "swapAt") {
            var x = szNum(args[0]) | 0
            var y = szNum(args[1]) | 0
            if (x < 0 || x >= n || y < 0 || y >= n) { fail("Fatal error: Index out of range") }
            var sv = t[x]
            t[x] = t[y]
            t[y] = sv
            return undefined
        }
        // min()/max() answer an Optional in Swift and this value model has none
        // (manual 7.9), so `print(a.min())` reads `1` where swiftc prints
        // `Optional(1)`. The EMPTY case still answers nil, which swiftc prints as
        // `nil` too, so that row is byte-exact.
        if (name == "min" || name == "max") {
            if (n == 0) { return null }
            var less = swLessOf(args)
            var best = t[0]
            for (i = 1; i < n; i++) {
                // Sequence.min/max(by:) replace the running answer only when the
                // next element orders strictly before / after it, so a tie (or a
                // NaN) keeps the EARLIER element (SequenceAlgorithms.swift).
                if (name == "min") { if (less(t[i], best)) { best = t[i] } }
                else { if (less(best, t[i])) { best = t[i] } }
            }
            return best
        }
        // prefix(while:) / drop(while:): the leading run the predicate holds for,
        // and what follows it.
        if ((name == "prefix" || name == "drop") && typeof args[0] == "function") {
            var run = 0
            while (run < n && core.test(args[0](t[run]))) { run = run + 1 }
            return name == "prefix" ? swSubArr(t, 0, run) : swSubArr(t, run, n)
        }
        if (name == "split") { return swSplitSeq(t, args) }
        // starts(with:) / elementsEqual(_:) compare element by element with ==.
        if (name == "starts" || name == "elementsEqual") {
            var other = anytype
            other = swSeqVal(args[0])
            if (other.length > n || (name == "elementsEqual" && other.length != n)) { return false }
            for (i = 0; i < other.length; i++) { if (!swEq(t[i], other[i])) { return false } }
            return true
        }
        if (name == "prefix") {
            out = []
            var pk = swSeqK(args, 1, n)
            for (i = 0; i < pk; i++) { out.push(t[i]) }
            return out
        }
        if (name == "suffix") {
            out = []
            var sk = swSeqK(args, 1, n)
            for (i = n - sk; i < n; i++) { out.push(t[i]) }
            return out
        }
        if (name == "dropFirst") {
            out = []
            var dk = swSeqK(args, 1, n)
            for (i = dk; i < n; i++) { out.push(t[i]) }
            return out
        }
        if (name == "dropLast") {
            out = []
            var lk = swSeqK(args, 1, n)
            for (i = 0; i < n - lk; i++) { out.push(t[i]) }
            return out
        }
        // firstIndex/lastIndex take either `of:` (a value) or `where:` (a closure),
        // and answer an Optional - the same Optional divergence as min/max, and nil
        // for "not found", which IS what swiftc prints.
        if (name == "firstIndex" || name == "lastIndex" || name == "index") {
            var wantLast = name == "lastIndex"
            var found = null
            for (i = 0; i < n; i++) {
                var hit = typeof args[0] == "function" ? args[0](t[i]) : swEq(t[i], args[0])
                if (hit) {
                    if (!wantLast) { return i }
                    found = i
                }
            }
            return found
        }
        if (name == "allSatisfy") {
            for (i = 0; i < n; i++) { if (!args[0](t[i])) { return false } }
            return true
        }
        if (name == "compactMap") {
            out = []
            for (i = 0; i < n; i++) {
                var cv = args[0](t[i])
                if (cv !== null && cv !== undefined) { out.push(cv) }
            }
            return out
        }
        if (name == "flatMap") {
            out = []
            for (i = 0; i < n; i++) {
                var fv = args[0](t[i])
                if (Array.isArray(fv)) { for (var q = 0; q < fv.length; q++) { out.push(fv[q]) } }
                else if (typeof fv == "string") { var gs = swcGraphemes(fv); for (var g = 0; g < gs.length; g++) { out.push(gs[g]) } }
                else { out.push(fv) }
            }
            return out
        }
        // indices answers a Range, and `print(a.indices)` is `0..<3` in swiftc, which
        // this matches exactly.
        if (name == "indices") { return {__range: true, lo: 0, hi: n, closed: false} }
        // enumerated() answers an EnumeratedSequence whose own printed form names the
        // static type, like reversed(); `Array(a.enumerated())` is what programs use
        // and THAT is byte-exact - swiftc prints
        // `[(offset: 0, element: 3), (offset: 1, element: 1), ...]`.
        if (name == "enumerated") {
            out = []
            for (i = 0; i < n; i++) {
                var pt = {__tuple: 2}
                scopePut(pt, "__tlabels", ["offset", "element"])
                scopePut(pt, "0", i)
                scopePut(pt, "offset", i)
                scopePut(pt, "1", t[i])
                scopePut(pt, "element", t[i])
                out.push(pt)
            }
            return out
        }
        // joined(): [String] concatenates to a String, [[T]] flattens to an array.
        // swiftc's `[[1,2],[3]].joined()` prints a FlattenSequence naming the static
        // type; `Array(...)` of it is the array this answers, the same trade as
        // reversed().
        if (name == "joined") {
            var sep = args.length > 0 ? swstr(args[0]) : ""
            var allArr = n > 0
            for (i = 0; i < n; i++) { if (!Array.isArray(t[i])) { allArr = false } }
            if (allArr && args.length == 0) {
                out = []
                for (i = 0; i < n; i++) { for (var z = 0; z < t[i].length; z++) { out.push(t[i][z]) } }
                return out
            }
            var js = ""
            for (i = 0; i < n; i++) {
                if (i > 0) { js += sep }
                js += swstr(t[i])
            }
            return js
        }
        // reduce(initial, combine) and reduce(into: seed, combine). The labels do not
        // reach here, so the two forms are told apart by WHAT THE CLOSURE ANSWERS: an
        // `into` body mutates its inout accumulator and returns Void, which is the
        // only shape in which discarding the result is right. Measured against
        // swiftc: `a.reduce(0, +)` is 6 and `a.reduce(into: [Int]()) { $0.append($1) }`
        // is [3, 1, 2].
        if (name == "reduce") {
            var acc = anytype
            acc = args[0]
            var comb = args[1]
            for (i = 0; i < n; i++) {
                var r2 = comb(acc, t[i])
                if (r2 !== undefined) { acc = swKeepLabels(acc, r2) }
            }
            return acc
        }
        // An IndexingIterator over a copy: the array's later edits do not reach it.
        if (name == "makeIterator") { return {__swit: 3, st: t.slice(0), i: 0, done: false} }
        fail("unknown Array method: " + name)
    }

    // ----- Expression thunks -----

    // e is T answers the dynamic type test, e as? T answers the value or nil, and
    // e as / e as! T pass the value through - this value model has one representation
    // per value, so an upcast and a forced downcast are both identities.
    // `A & B` is a protocol COMPOSITION and every component has to match:
    // `U2() is A2 & B2` is false with `struct U2: A2` (swiftc 6.1.2). The twin is
    // swSplitAmp in swift-to-llvm-ir.abnf's emitIsType.
    function swSplitAmp(t) {
        var out = []
        var cur = ""
        // Only a spelling that HAS an & is taken apart: every other type name must
        // reach the tests below exactly as it was written, whitespace included.
        var amp = false
        for (var k = 0; k < t.length; k++) { if (t.charAt(k) == "&") { amp = true } }
        if (!amp) { out.push(t); return out }
        for (var i = 0; i < t.length; i++) {
            var ch = t.charAt(i)
            if (ch == "&") { out.push(stripWs(cur)); cur = "" } else { cur = cur + ch }
        }
        out.push(stripWs(cur))
        return out
    }
    // `xs is [Int]`, `d is [String: Int]`, `t is (Int, String)`: a collection or
    // tuple type, as {k: "arr" | "dict" | "tup", ts: element types}, else null.
    // Twin in swift-to-llvm-ir.abnf.
    function swStructTy(t) {
        if (t.length < 3) { return null }
        var c0 = t.charAt(0)
        if ((c0 != "[" && c0 != "(") || swCloseAt(t, 0) != t.length - 1) { return null }
        var parts = swTySplit(t.substring(1, t.length - 1), c0 == "[" ? ":" : ",")
        if (c0 == "[") {
            if (parts.length > 2) { return null }
            return {k: parts.length == 1 ? "arr" : "dict", ts: parts}
        }
        if (parts.length < 2) { return null }
        var ts = []
        for (var i = 0; i < parts.length; i++) {
            var lp = swTySplit(parts[i], ":")
            ts.push(lp[lp.length - 1])
        }
        return {k: "tup", ts: ts}
    }
    // A collection or tuple value is that type when every element is its
    // element type: `[1, 2] as Any is [Int]`, and an empty array is an array of
    // anything. Twin of swEmitStructIs in swift-to-llvm-ir.abnf.
    function swStructIs(v, st) {
        if (st.k == "arr") {
            if (!Array.isArray(v)) { return false }
            for (var i = 0; i < v.length; i++) { if (!swIsType(v[i], st.ts[0])) { return false } }
            return true
        }
        if (st.k == "dict") {
            if (v.__dict !== true) { return false }
            for (var j = 0; j < v.keys.length; j++) {
                if (!swIsType(v.keys[j], st.ts[0]) || !swIsType(v.vals[j], st.ts[1])) { return false }
            }
            return true
        }
        if (v.__tuple !== st.ts.length) { return false }
        for (var q = 0; q < st.ts.length; q++) { if (!swIsType(v["" + q], st.ts[q])) { return false } }
        return true
    }
    function swIsType(v, tname) {
        var comps = swSplitAmp(tname)
        if (comps.length > 1) {
            for (var ci = 0; ci < comps.length; ci++) {
                if (!swIsType(v, comps[ci])) { return false }
            }
            return true
        }
        var tb = swTyStripOpt(tname)
        var st = swStructTy(tb)
        if (st != null) {
            if (v === null || v === undefined) { return tb.length != tname.length }
            if (typeof v != "object") { return false }
            return swStructIs(v, st)
        }
        if (isCaseVal(v)) {
            var t = tname
            if (t.charAt(t.length - 1) == "?") { t = t.substring(0, t.length - 1) }
            if (protoNames["$" + t] == 1) { return swConforms(v, t) }
            return t == "Any" || t == "Error" || v.__etype === t
        }
        return swIsNamed(v, tname)
    }
    // The DYNAMIC type test, for the names this value model answers itself.
    //
    // The shared rtIsType does not know the {__flo} box: it says "an integral
    // number" for Int AND for Double (`3 is Double` must be false, `3.0 is Double`
    // true), and its boolean arm spells the Java/Kotlin name `Boolean`, not `Bool`.
    // swIsType also drives `as?` and `as!`.
    //
    // The value model carries the answer already (docs/working-on-this-project.md
    // 7.15): a {__flo} box is a Double, the same box with __f32 is a Float, a plain
    // integral number or a {__sz} box is an integer of the width the box names.
    //
    // Int64 and UInt64 are widths of their own (swIntWidthOf), so `8 as Int64 is
    // Int` is false as in swiftc 6.1.2.
    //
    // Non-numeric names fall through to the shared probe unchanged (a String, an
    // Array, a user class and `Any`). Twins: js_swis in
    // abnf/jsrtswift.go and in languages/lib/swift-rt.metajs.
    function swIsNamed(v, tname) {
        var t = swBaseTy(tname)
        // A user PROTOCOL is answered by the conformance marker adoptProtocol wrote,
        // not by the name walk below - a conforming type's descriptor is named for
        // itself, never for the protocol.
        if (protoNames["$" + t] == 1) { return swConforms(v, t) }
        var opt = tname.length > 0 &&
                  (tname.charAt(tname.length - 1) == "?" || tname.charAt(tname.length - 1) == "!")
        var iw = swIntWidthOf(t)
        var isD = t == "Double"
        var isF = t == "Float"
        var isB = t == "Bool"
        if (iw == null && !isD && !isF && !isB) { return rtIsType(v, tname) }
        // The width as two plain values, so the sized-box arm below is reachable
        // for a Double name too (where it must answer false, not read a null).
        var bits = iw == null ? 0 : iw.w
        var uns = iw == null ? false : iw.u
        if (v === null || v === undefined) { return opt }
        if (isB) { return typeof v == "boolean" }
        // The box tests come first in all three engines: in the COMPILED halves a
        // float box and a sized box are floor tags, and `typeof` answers "number"
        // for both, so an isD arm placed above them would claim a big sized integer.
        if (isFlo(v)) { return isF32(v) ? isF : isD }
        if (szIs(v)) { return szWidth(v, v) == bits && szUns(v, v) === uns }
        if (typeof v != "number") { return false }
        if (isD) { return Math.floor(v) != v }
        if (isF) { return false }
        // A plain number is a signed 64 bit Int, and only an integral one is an Int
        // at all - a fraction that reached here unboxed is a Double.
        return Math.floor(v) == v && bits == 64 && !uns
    }
    function makeCastOne(t, op, tname) {
        if (op == "is") { return function() { return swIsType(swOptOpen(t()), tname) } }
        if (op == "as?") { return function() { var v = swOptOpen(t()); return swIsType(v, tname) ? v : null } }
        if (op == "as!") {
            if (!swAdoptable(tname)) { return function() { return swOptOpen(t()) } }
            return function() { return swAdoptTy(swOptOpen(t()), tname) }
        }
        // `3 as Int8` is a COERCION, not a no-op: the literal takes the WIDTH (and
        // the floatness) of the named type exactly as a declared type would, so
        // `(3 as Double) / 2` is 1.5, `(250 as UInt8) &+ 10` is 4 and
        // `(3 as Int8) is Int8` is true (swiftc 6.1.2).
        // A name that is not Double/Float/a sized integer adopts NOTHING, so `x as
        // Any`, `as String` and every upcast are untouched, and `as Int64` stays the
        // plain number Int already is. A STRUCTURAL type with such a leaf types its
        // literal the same way: `[1, 2] as [Double]` is [1.0, 2.0].
        if (swAdoptable(tname)) { return function() { return swAdoptTy(t(), tname) } }
        if (swAdoptNeeded(tname)) { return function() { return swAdoptAnn(t(), tname) } }
        return t
    }
    function makeCast(items, pos, txt) {
        if (items.length == 1) { return items[0] }
        var t = items[0]
        var op = ""
        var ty = ""
        for (var i = 1; i + 1 < items.length; i = i + 2) {
            op = items[i].cast
            ty = items[i + 1].ctype
            t = makeCastOne(t, op, ty)
        }
        if (op == "as?" && swAdoptable(ty)) { swAsqCasts.push({at: pos, ty: ty}) }
        if (swCastOptAny(items, txt)) {
            var inner = t
            return function() {
                var v = anytype
                v = inner()
                if (v === null || v === undefined) { return v }
                return {__optany: v}
            }
        }
        return t
    }
    // `x as Any` where x is an OPTIONAL by its static type (swExprAnn) keeps the
    // Optional inside the Any: print shows `Optional(7)` and a cast back out
    // (`as? Int`, swOptOpen) unwraps it. nil stays nil, which prints "nil" as
    // swiftc does. An Optional is otherwise its own value in this model; this box
    // exists only behind such a cast. Twin of makeCast in swift-to-llvm-ir.abnf.
    function swCastOptAny(items, txt0) {
        if (items.length != 3 || items[1].cast != "as" || items[2].ctype != "Any") { return false }
        var txt = stripWs(txt0)
        var cut = txt.length - items[1].cast.length - items[2].ctype.length
        if (cut <= 0) { return false }
        return swTyIsOpt(swExprAnn(txt.substring(0, cut)))
    }
    function swOptOpen(v) {
        if (v !== null && typeof v == "object" && v.__optany !== undefined) { return v.__optany }
        return v
    }
    // The `as? T` casts to a numeric T, by END position (a thunk loses its identity
    // on the tag stack under goja): the right side of a `??` after one is typed T,
    // so `x as? Double ?? -1` is -1.0 (swiftc 6.1.2). The latest record wins, which
    // is the current file's. Twin of swAsqTyOf in swift-to-llvm-ir.abnf.
    var swAsqCasts = []
    function swAsqTyOf(at) {
        for (var i = swAsqCasts.length - 1; i >= 0; i--) {
            if (swAsqCasts[i].at == at) { return swAsqCasts[i].ty }
        }
        return ""
    }

    // ----- Value semantics: struct, Array, Dictionary and tuple -----
    // Swift's defining property. EVERY value type is copied whenever it is stored
    // into a location - a var/let binding, an assignment, a non-inout argument, an
    // element of a collection literal, an argument to a mutating collection method.
    // A class instance is a REFERENCE and is never copied, which is what makes
    // `var b = a; b[0].x = 9` visible through a in an array of class instances
    // (swiftc agrees: the array is copied, its elements are not).
    //
    // COPY AT STORE IS COMPLETE, and that is why there is no copy on READ. The only
    // way two locations can alias is that one stored a value the other can still
    // reach; if every store site deposits a graph nobody else holds, no read can
    // produce one. It is also why `a[0].append(5)` still mutates a in place: a
    // subscript READ is not a store.
    //
    // This is NOT copy-on-write. Swift's real rule is COW with value semantics
    // OBSERVABLE; only the observable half is implemented here, eagerly. The cost
    // is a walk per store, and the alternative needs a mutable flag on a host array,
    // which this value model has nowhere to put.
    function isStructVal(v) {
        return v !== null && v !== undefined && typeof v == "object" && v.__struct === true
    }
    function swCopyArr(v) {
        var out = []
        for (var i = 0; i < v.length; i++) { out.push(swCopy(v[i])) }
        return out
    }
    function swCopyDict(v) {
        var out = {__dict: true, keys: [], vals: []}
        var ks = v.keys
        var vs = v.vals
        for (var i = 0; i < ks.length; i++) {
            out.keys.push(ks[i])
            out.vals.push(swCopy(vs[i]))
        }
        return out
    }
    // A LABELLED tuple stores the same value twice - under "0" and under its label -
    // and makeParen is the site that establishes that aliasing. The copy re-
    // establishes it rather than walking the keys, so the two spellings of one
    // element stay the one element.
    function swCopyTup(v) {
        var n = v.__tuple
        var out = {__tuple: n}
        var lbls = hasOwn(v, "__tlabels") ? v.__tlabels : null
        if (lbls != null) { scopePut(out, "__tlabels", lbls) }
        for (var i = 0; i < n; i++) {
            var e = swCopy(hasOwn(v, "" + i) ? v["" + i] : undefined)
            scopePut(out, "" + i, e)
            if (lbls != null && i < lbls.length && lbls[i] != "") { scopePut(out, lbls[i], e) }
        }
        return out
    }
    // An enum CASE value is deliberately NOT copied, and that is a measurement
    // rather than an omission. Its payload is reachable only through a pattern
    // binding (`if case .some(var v)`), and that binding is itself a copy site - so
    // no program can observe two case values sharing one __vals array. swiftc
    // agrees on the probe: A/B/C all answer [1, 2]. Copying it would mean keeping a
    // seven-slot literal in step across three engines for no visible behaviour.
    function swCopy(v) {
        if (v === null || v === undefined) { return v }
        if (Array.isArray(v)) { return swCopyArr(v) }
        if (typeof v != "object") { return v }
        if (v.__dict === true) { return swCopyDict(v) }
        if (v.__tuple != undefined) { return swCopyTup(v) }
        if (v.__set === true) { return {__set: true, elems: swCopyArr(v.elems)} }
        if (v.__struct !== true) { return v }
        var cls = v.__class
        if (cls == undefined || cls === null) { return v }
        var ks = cls.__fields
        if (ks == undefined || ks == null) { return v }
        var out = {__struct: true, __class: cls}
        if (hasOwn(v, "__targs")) { scopePut(out, "__targs", v.__targs) }
        for (var i = 0; i < ks.length; i++) {
            if (hasOwn(v, ks[i])) { scopePut(out, ks[i], swCopy(v[ks[i]])) }
        }
        return out
    }

    // ----- Tuples -----
    // A tuple is a plain object carrying its elements under the property names
    // "0", "1", ... plus, for a labelled element, under its label - so t.0 and
    // t.lo are both ordinary field reads and no new runtime type is needed.
    // __tuple holds the arity (a tuple of one element never occurs: ( e ) is
    // a parenthesized expression in Swift, not a one-tuple).
    function makeTupleElem(items) {
        if (items.length > 1) { return {lbl: items[0].tlabel, t: items[1]} }
        return {lbl: null, t: items[0]}
    }
    function newTupleVal(vals) {
        var t = {__tuple: vals.length}
        for (var i = 0; i < vals.length; i++) { scopePut(t, "" + i, vals[i]) }
        return t
    }
