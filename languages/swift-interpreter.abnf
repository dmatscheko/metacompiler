        var simple = !k.pdot && k.pargs == null && k.ppath.indexOf(".") < 0
        if (binding && simple) { declVar(k.ppath, v); return true }
        return matchEnumCase(k, v, binding)
    }
    // A plain enum's cases are named string constants, so a case pattern is an
    // equality test against that constant; `.name` (leading dot) has no type to
    // resolve against and compares the case NAME directly.
    function matchEnumCase(k, v, binding) {
        var last = k.ppath
        var cut = -1
        for (var i = 0; i < last.length; i++) { if (last.charAt(i) == ".") { cut = i } }
        var caseName = cut < 0 ? last : last.substring(cut + 1)
        if (k.pargs != null && k.pargs.length > 0) { return false }
        return v === caseName
    }

    // A condition list of if/guard/while: {cexpr} tests, {bindNames} optional
    // bindings and {pat} case patterns, each optionally followed by a where guard.
    // Every item must pass; the bindings land in whatever scope the caller pushed.
    function runConds(conds) {
        for (var i = 0; i < conds.length; i++) {
            var cd = conds[i]
            if (cd.cexpr != undefined) {
                if (!core.test(cd.cexpr())) { return false }
                continue
            }
            if (cd.bindNames != undefined) {
                var v = cd.init()
                if (v === null || v === undefined) { return false }
                var ns = cd.bindNames
                if (ns.length == 1) { declVar(ns[0], v) }
                else { for (var j = 0; j < ns.length; j++) { declVar(ns[j], tupleAt(v, j)) } }
            } else {
                if (!matchPat(cd.pat, cd.init(), false)) { return false }
            }
            if (cd.whereT != null && !core.test(cd.whereT())) { return false }
