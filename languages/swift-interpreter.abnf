        if (x === true) { return swFlo(1) }
        if (x === false) { return swFlo(0) }
        if (x === null || x === undefined) { fail("Double conversion of nil") }
        return swFlo(swD(x) * 1)
    }
    function swFloType() {
        return {infinity: swFlo(swInfF), nan: swFlo(swNanF), pi: swFlo(3.141592653589793),
                zero: swFlo(0), __conv: swFloConv}
    }
    hostGlobals["Double"] = swFloType()
    // Float is an ALIAS of Double here - see the note at swFlo above for the
    // precision this deliberately does not model.
    hostGlobals["Float"] = swFloType()
    // String(x) / String(describing: x): the text print would have written.
    hostGlobals["String"] = {__conv: function(x) { return swstr(x) }}
    hostGlobals["Int"] = swIntType(64, false)
    hostGlobals["Int64"] = swIntType(64, false)
    hostGlobals["Int32"] = swIntType(32, false)
    hostGlobals["Int16"] = swIntType(16, false)
    hostGlobals["Int8"] = swIntType(8, false)
    hostGlobals["UInt"] = swIntType(64, true)
    hostGlobals["UInt64"] = swIntType(64, true)
    hostGlobals["UInt32"] = swIntType(32, true)
    hostGlobals["UInt16"] = swIntType(16, true)
    hostGlobals["UInt8"] = swIntType(8, true)

    core.lang = "swift"
    // `_` is the discard name: `_ = expr` evaluates and throws the value away.
    core.blank = "_"
    core.add = swadd
    core.getField = swGetField
    core.getIndex = swIndex
