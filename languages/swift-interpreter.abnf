        return {argv: argv, boxes: boxes}
    }
    function writeBacks(boxes) {
        for (var i = 0; i < boxes.length; i++) { setVar(boxes[i].name, boxes[i].box.v) }
    }
    // The callee side: bind the positional arguments to the parameters, collecting a
    // variadic tail into an array, filling in the defaults of the parameters no
    // argument reached, and unwrapping an inout box (remembered for the write-back).
    function swBindArgs(params, args) {
        var vals = []
        var boxes = []
        var ai = 0
        for (var p = 0; p < params.length; p++) {
            var prm = params[p]
            if (prm.variadic) {
                var rest = []
                while (ai < args.length) { rest.push(args[ai]); ai++ }
                vals.push(rest)
                continue
            }
            var v = anytype
            if (ai < args.length) { v = args[ai]; ai++ }
            else if (prm.hasDefault) { v = prm.dflt() }
            else { v = undefined }
            if (prm.inout && v !== null && v !== undefined && typeof v == "object" && v.__ref != undefined) {
