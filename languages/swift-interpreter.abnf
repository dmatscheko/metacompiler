    // ----- defer -----
    // A defer is not a thunk but a MARKER in its block's item list: everything after
    // it runs inside a host try whose finally is the defer body, so the body runs on
    // the normal path, on a return (the signal keeps propagating through the finally)
    // and on a throw. Nested markers therefore unwind LIFO, and a defer that was never
    // reached - an early return above it - never runs, exactly like Swift's.
    function makeDefer(t) { return {isdefer: t} }
    function swSeqWithDefers(items) {
        var cut = -1
        for (var i = 0; i < items.length && cut < 0; i++) {
            if (typeof items[i] != "function") { cut = i }
        }
        if (cut < 0) { return makeSeq(items) }
        var before = makeSeq(items.slice(0, cut))
        var deferT = items[cut].isdefer
        var restT = swSeqWithDefers(items.slice(cut + 1))
        return function() {
            var r = anytype
            r = before()
            if (r != undefined) { return r }
            try {
                r = restT()
            } finally {
                deferT()
