    // Overridden by ASSIGNMENT (see the include-override trap in the gotchas doc).
    makeBlockStmt = function(items) {
        var seq = swSeqWithDefers(items)
        return function() {
            scopes.push({})
            var r = seq()
            scopes.pop()
            return r
        }
    }

    // items = [cond] or [cond, then, else] -> the ternary conditional.
    function makeTernary(items) {
        if (items.length == 1) { return items[0] }
        var condT = items[0]
        var thenT = items[1]
        var elseT = items[2]
        return function() { return core.test(condT()) ? thenT() : elseT() }
    }

    // items = [thunk, thunk, ...]: a ?? b yields a unless it is nil (short circuit).
    function makeCoalesce(items) {
        if (items.length == 1) { return items[0] }
        return function() {
            var v = items[0]()
            for (var i = 1; i < items.length && (v === null || v === undefined); i++) { v = items[i]() }
            return v
        }
    }

    function makeArray(items) {
        return function() {
            var out = []
            for (var i = 0; i < items.length; i++) { out.push(items[i]()) }
            return out
