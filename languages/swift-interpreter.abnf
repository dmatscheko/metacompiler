    }
    // guard binds into the scope it stands in (the bindings outlive the statement);
    // the else block runs only when the clause fails and normally diverges.
    function makeCondGuard(items) {
        var conds = items[0].conds
        var elseT = items[1]
        return function() {
            if (runConds(conds)) { return undefined }
            return elseT()
        }
    }
    function makeCondWhile(items) {
        var lbl = itemLbl(items)
        var rest = itemsAfterLbl(items)
        var conds = rest[0].conds
        var bodyT = rest[1]
        return function() {
            var res = undefined
            while (true) {
                scopes.push({})
                var ok = runConds(conds)
                var r = undefined
                if (ok) { r = bodyT() }
                scopes.pop()
                if (!ok) { break }
                var a = loopAct(r, lbl)
                if (a == 1) { break }
                if (a == 3) { res = r; break }
            }
            return res
        }
    }
    // items = [{lbl}?, pattern, listT, {fwhere}?, bodyT]
    function makeForCase(items) {
        var lbl = itemLbl(items)
        var rest = itemsAfterLbl(items)
        var pat = rest[0]
        var listT = rest[1]
        var k = 2
        var whereT = null
        if (rest[k] != undefined && rest[k].fwhere != undefined) { whereT = rest[k].fwhere; k++ }
        var bodyT = rest[k]
        return function() {
            var arr = listT()
            var res = undefined
            var n = swlen(arr)
            for (var i = 0; i < n; i++) {
                scopes.push({})
                var r = undefined
                if (matchPat(pat, arr[i], false) && (whereT == null || core.test(whereT()))) { r = bodyT() }
                scopes.pop()
                var a = loopAct(r, lbl)
                if (a == 1) { break }
                if (a == 3) { res = r; break }
