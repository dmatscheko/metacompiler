    function makeRepeat(items) {
        var lbl = itemLbl(items)
        var rest = itemsAfterLbl(items)
        var bodyT = rest[0]
        var condT = rest[1]
        return function() {
            do {
                var r = bodyT()
                var a = loopAct(r, lbl)
                if (a == 1) { break }
                if (a == 3) { return r }
            } while (core.test(condT()))
