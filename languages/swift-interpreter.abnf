    // expression. Captures the scope chain (a real closure). A capture list
    // snapshots its names at creation; a closure with no parameter names binds its
    // arguments under the shorthand names $0..$3.
    function makeClosure(items) {
        var params = []
        var caps = []
        var start = 0
        if (items.length > 0 && items[0] != undefined && items[0].csig != undefined) {
            params = items[0].cparams
            caps = items[0].caps
            start = 1
        }
        var body = items.slice(start)
        var noSig = params.length == 0
        return function() {
            var captured = scopes.slice(0)
            if (caps.length > 0) {
                var snap = {}
                for (var ci = 0; ci < caps.length; ci++) { scopePut(snap, caps[ci], getVar(caps[ci])) }
                captured.push(snap)
            }
            return function() {
                var args = arguments
                var saved = scopes
                scopes = captured.slice(0)
                scopes.push({})
                for (var i = 0; i < params.length; i++) {
                    declVar(params[i], i < args.length ? args[i] : undefined)
