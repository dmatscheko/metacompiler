    // one object (C11 6.2.2p2): 'extern int g; int g = 5;' and a repeated tentative
    // 'int g; int g;' reuse the first declaration's global, and only two
    // initializers (6.9p3) or two different types (6.7p4) are an error.
    function defineGlobals(items) {
        var base = items[0].bty
        for (var i = 1; i < items.length; i++) {
            var d = items[i].dcl
            var ct = declCt(base, d)
            var prev = hasOwn(globalScope, d.name) ? globalScope[d.name] : undefined
            if (prev == undefined) {
                newGlobal(d.name, ct)
            } else {
                var nct = cRedeclCt(d.name, prev.ct, ct)
                if (nct != prev.ct) sizeGlobal(prev, nct)
            }
            var g = globalScope[d.name].val
            if (d.init == undefined) continue
            var entry = globalScope[d.name]
            if (entry.inited == true) fail("redefinition of '" + d.name + "'")
            entry.inited = true
            globalInits.push({g: g, ct: ct, init: d.init})
