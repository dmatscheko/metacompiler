        for (var i = 0; i < argValues.length; i++) { all.push(icallBox(b, argValues[i])) }
        var rct = known ? fct.r : undefined
        if (rct == undefined || rct.k == "void" || rct.k == "struct" || rct.k == "arr") { rct = ctInt }
        return {b: b, v: icallArg(b, b.NewCall(trampolineFor(args.length), all), ctRTy(rct)), ct: rct}
    }

    // ----- Statement thunks: function(block) -> block to continue in -----

    // ----- Declarators -----
    // A declarator collapses into a descriptor; the enclosing declaration owns the base type.
    function makeDeclr(items, kind) {
        var d = {name: "", ptr: 0, rptr: 0, sigs: [], dims: undefined, init: undefined, gv: undefined, kind: kind}
        for (var i = 0; i < items.length; i++) {
            var it = items[i]
            if (it == undefined) continue
            if (typeof it == "string") { d.name = it; continue }
            if (typeof it == "function") { d.init = it; continue }
            if (it.ptr != undefined) { d.ptr = it.ptr; continue }
            if (it.rptr != undefined) { d.rptr = it.rptr; continue }
            if (it.fsig != undefined) { d.sigs.push(it.fsig); continue }
            if (it.dims != undefined) { d.dims = it.dims; continue }
            if (it.gv != undefined) { d.gv = it.gv; continue }
