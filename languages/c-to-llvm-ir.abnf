        // A floating-point place steps by 1.0 in its own precision.
        if (ct != undefined && isFlt(ct)) {
            var dv = emitDBin(b, (op == "++") ? "+" : "-", old, emitDblConst(b, 1))
            return ct.w == 4 ? emitD2F(b, dv) : dv
        }
        return (op == "++") ? b.NewAdd(old, one) : b.NewSub(old, one)
