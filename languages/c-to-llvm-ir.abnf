    // The value of the last expression statement EMITTED. exprToStmt is overridden to
    // record it; a statement expression emits its block and then reads it back. Emission
    // is in source order within a block, so the block's own last expression statement is
    // the last to write, exactly as at run time in the interpreter.
    var lastExprV = undefined
    exprToStmt = function(t) {
        return function(b) {
            var r = t(b)
            lastExprV = r
            return r.b
        }
    }
    function makeStmtExpr(items) {
        var body = makeBlockStmt(items)
        return function(b) {
            var saved = lastExprV
            lastExprV = undefined
            b = body(b)
            var r = lastExprV
            lastExprV = saved
            if (r == undefined) return {b: b, v: zero, ct: ctInt}
            return {b: b, v: r.v, ct: r.ct != undefined ? r.ct : ctInt}
        }
    }
