        if (op == "!=") return a != b ? 1 : 0
        if (op == "<")  return a < b ? 1 : 0
        if (op == ">")  return a > b ? 1 : 0
        if (op == "<=") return a <= b ? 1 : 0
        if (op == ">=") return a >= b ? 1 : 0
