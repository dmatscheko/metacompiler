        return function(b) {
            scopes.push({})
            if (init != null) b = init(b)
            var headB = curF.NewBlock("")
            var bodyB = curF.NewBlock("")
            var postB = curF.NewBlock("")
            var exitB = curF.NewBlock("")
            b.NewBr(headB)
            if (cond != null) {
                var r = cond(headB)
                r.b.NewCondBr(truthy(r.b, r.v), bodyB, exitB)
            } else {
                headB.NewBr(bodyB)
            }
            loopStack.push({cont: postB, brk: exitB})
            bodyT(bodyB).NewBr(postB)
            loopStack.pop()
            var pb = postB
            if (post != null) pb = post(postB)
            pb.NewBr(headB)
            scopes.pop()
            return exitB
        }
    }
    // items = [valueThunk, stmtThunk...] resp. [stmtThunk...] -> one case descriptor.
    function makeCase(items) { return {isDefault: false, v: items[0], body: items.slice(1)} }
    function makeDefault(items) { return {isDefault: true, body: items} }
    // items = [scrutineeThunk, caseDescriptor...]: C switch with fallthrough. The
    // dispatch compares the value against every case in source order; the bodies form
    // one block chain (fallthrough), and break jumps behind the switch (loop stack).
    // ----- switch: case labels are BASIC BLOCKS -----
    // A case label may sit anywhere inside the switch body - in a nested block, or
    // halfway down a loop body, which is what makes Duff's device legal C - so the body
    // is emitted as ORDINARY code and each case label simply starts a new block that the
    // code before it falls into. Fallthrough is then the fallthrough the emitter already
    // does, and the dispatch is a chain of compares that BRANCHES INTO the body.
    //
    // The dispatch has to be appended to the pre-switch block AFTER the body is emitted,
    // because only then is the set of case blocks known. That is exactly what the
    // instruction order allows: the scrutinee is computed in that block, the compares
    // follow it there, and every case block is dominated by it.
    var curSwCases = undefined
    var curSwDefault = undefined
    function makeCase(items) {
        var vT = items[0]
        var t = items[1]
        return function(b) {
            if (curSwCases == undefined) fail("'case' outside a switch")
            var cb = curF.NewBlock("")
            b.NewBr(cb)                     // the code before the label falls into it
            curSwCases.push({v: vT, blk: cb})
            return t(cb)
        }
    }
    function makeDefault(t) {
        return function(b) {
            if (curSwCases == undefined) fail("'default' outside a switch")
            var cb = curF.NewBlock("")
            b.NewBr(cb)
            curSwDefault = cb
            return t(cb)
        }
    }
    function makeSwitch(items) {
        var scrut = items[0]
        var bodyT = items[1]
        return function(b) {
            var r = scrut(b)
            b = r.b
            var exitB = curF.NewBlock("")
            // Statements BEFORE the first case label are unreachable (nothing branches
            // to this block), which is what C says about them.
            var bodyB = curF.NewBlock("")
            var savedCases = curSwCases
            var savedDflt = curSwDefault
            curSwCases = []
            curSwDefault = undefined
            var outerCont = loopStack.length > 0 ? loopStack[loopStack.length - 1].cont : null
            loopStack.push({cont: outerCont, brk: exitB})
            var endB = bodyT(bodyB)
            endB.NewBr(exitB)
            loopStack.pop()
            var cases = curSwCases
            var dflt = curSwDefault
            curSwCases = savedCases
            curSwDefault = savedDflt
            for (var i = 0; i < cases.length; i++) {
                var rc = cases[i].v(b)
                b = rc.b
                var nextB = curF.NewBlock("")
                b.NewCondBr(b.NewICmp(llvm.enum.IPredEQ, r.v, rc.v), cases[i].blk, nextB)
                b = nextB
            }
            b.NewBr(dflt != undefined ? dflt : exitB)
            return exitB
        }
    }
    function makeReturn(items) {
        var t = items.length > 0 ? items[0] : makeInt(0)
        var hasVal = items.length > 0
        return function(b) {
            // In a struct-returning function the value is copied into the caller's
            // destination (the hidden first parameter) and the call itself yields it.
            if (curSret != undefined && hasVal) {
                var rs = t(b)
                var eb = emitCopy(rs.b, curRetCt, curSret, rs.v)
                eb.NewRet(zero)
                return deadBlock()
            }
            var r = t(b)
            // Every function of this model returns an int, unless it was declared to
            // return a 64-bit type (the value keeps its full width) or a POINTER (the
            // result type is the uniform i32*, so the value has to arrive as one -
            // 'return 0' in such a function is the null pointer).
            if (curFnRetPtr) {
                r.b.NewRet(llvm.types.IsPointer(r.v.Type()) ? r.b.NewBitCast(r.v, i32p)
                           : r.b.NewIntToPtr(emitWiden(r.b, r.v, false, false), i32p))
                return deadBlock()
            }
            // The declared narrow type first (6.8.6.4p3), then the register width
            // the signature wants. emitConv answers an i32 either way, so the second
            // step is a no-op for everything but a 64-bit or floating return.
            if (curFnRetNarrow != undefined) {
                r = {b: r.b, v: coerce(r.b, curFnRetNarrow, r), ct: curFnRetNarrow}
            }
            r.b.NewRet(coerce(r.b, curFnRetCt, r))
            return deadBlock()
