KwSizeof    = "sizeof" KwEnd ;
KwAlignof   = "_Alignof" KwEnd ;
KwOffsetof  = "offsetof" KwEnd ;
KwStaticAs  = "_Static_assert" KwEnd ;
KwBool      = "_Bool" KwEnd ;
KwIf        = "if" KwEnd ;
KwElse      = "else" KwEnd ;
KwWhile     = "while" KwEnd ;
KwDo        = "do" KwEnd ;
KwFor       = "for" KwEnd ;
KwReturn    = "return" KwEnd ;
KwBreak     = "break" KwEnd ;
KwContinue  = "continue" KwEnd ;
KwSwitch    = "switch" KwEnd ;
KwCase      = "case" KwEnd ;
KwDefault   = "default" KwEnd ;

