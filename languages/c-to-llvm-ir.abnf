        if (op == "-") return convertNum(ct, a - b)
        if (op == "*") return convertNum(ct, a * b)
        if (op == "/") return convertNum(ct, isFlt(ct) ? (a / b) : trunc0(a / b))
        if (op == "%") return convertNum(ct, a % b)
        if (op == "|") return convertNum(ct, a | b)
        if (op == "^") return convertNum(ct, a ^ b)
        if (op == "&") return convertNum(ct, a & b)
