                var eb = emitCopy(rs.b, curRetCt, curSret, rs.v)
                eb.NewRet(zero)
                return deadBlock()
            }
            var r = t(b)
            // Every function of this model returns an int, unless it was declared to
            // return a 64-bit type (the value keeps its full width) or a POINTER (the
            // result type is the uniform i32*, so the value has to arrive as one -
            // 'return 0' in such a function is the null pointer).
            if (curFnRetPtr) {
                r.b.NewRet(llvm.types.IsPointer(r.v.Type()) ? r.b.NewBitCast(r.v, i32p)
                           : r.b.NewIntToPtr(emitWiden(r.b, r.v, false, false), i32p))
