    // items = [seed, {args}...]. The seed is either {fname} (a bare name, resolved as
    // a function or as a variable holding a function pointer), {fname, t} (see
    // makeCallExpr in c-interpreter.abnf) or an expression thunk
    // yielding a function identifier. Every further argument list calls what the
    // previous one returned, through the per-arity trampoline.
    function makeCallExpr(items) {
        var seed = items[0]
        var lists = items.slice(1)
        return function(b) {
            var v = zero
            var vct = ctInt
            // The declared return type of a DIRECT call, kept aside because vct reports
            // the type the module's i32 return actually carries. A suffix stepping off
            // that value needs the C type instead ('int *getp(void)' -> getp()[1]).
            var declRet = undefined
            var start = 0
            if (typeof seed != "function") {
