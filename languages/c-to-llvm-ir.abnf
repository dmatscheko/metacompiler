    var kQuiet = k64(2251799813685248)               // 2^51, the quiet bit
    var kInfBits = k64(9218868437227405312)          // +Inf
    var kNanBits = k64(9221120237041090560)          // the default quiet NaN
    var kAbsMask = k64(9223372036854775807)          // everything but the sign
    function isNanOf(b, x) {
        return b.NewICmp(llvm.enum.IPredUGT, b.NewAnd(x, kAbsMask), kInfBits)
    }
    function isInfOf(b, x) {
        return b.NewICmp(llvm.enum.IPredEQ, b.NewAnd(x, kAbsMask), kInfBits)
    }
    function isZeroOf(b, x) {
        return b.NewICmp(llvm.enum.IPredEQ, b.NewAnd(x, kAbsMask), zero64)
    }
    function signedInf(b, sg) { return b.NewOr(b.NewShl(sg, k64(63)), kInfBits) }
    // A NaN operand carries THROUGH, payload and all, quieted - which is what the
    // hardware does and therefore what cc answers.
    function nanThrough(b, x, y, res) {
        res = b.NewSelect(isNanOf(b, y), b.NewOr(y, kQuiet), res)
        return b.NewSelect(isNanOf(b, x), b.NewOr(x, kQuiet), res)
    }
    function pack(b, sg, ex, mn) {
        var ez = b.NewAnd(ex, kExpMask)
        return b.NewOr(b.NewOr(b.NewShl(sg, k64(63)), b.NewShl(ez, k64(52))), b.NewAnd(mn, kM52))
    }
    // ----- round to nearest, ties to even -----
    // Every helper below computes in an EXTENDED mantissa field: the 53-bit
    // mantissa shifted left by three, so bits 2..0 hold the guard/round/sticky
    // that the IEEE-754 default rounding mode needs, and a separate flag `st`
    // (an i64 holding 0 or 1) carries whatever fell below even those.
    var kB55 = k64(36028797018963968)     // 2^55, the extended leading bit
    var kB56 = k64(72057594037927936)     // 2^56
    var kThree = k64(3)
    // m >> d, with a flag saying whether any set bit was lost. The flag is kept
    // BESIDE the value rather than jammed into its low bit, because addition and
    // subtraction need to move in opposite directions from it.
    function shrSticky(b, m, d) {
        var huge = b.NewICmp(llvm.enum.IPredSGT, d, k64(63))
        var dc = b.NewSelect(huge, k64(63), d)
        var q = b.NewLShr(m, dc)
        var lost = b.NewSub(m, b.NewShl(q, dc))
        var sLost = b.NewZExt(b.NewICmp(llvm.enum.IPredNE, lost, zero64), i64)
        var sAll = b.NewZExt(b.NewICmp(llvm.enum.IPredNE, m, zero64), i64)
        return {m: b.NewSelect(huge, zero64, q), s: b.NewSelect(huge, sAll, sLost)}
    }
    // Round an extended mantissa (leading bit 55) down to the stored 53, nearest
    // with ties to even, and pack the result. `st` is a residue STRICTLY BELOW the
    // extended field and always positive - every caller arranges that, which is
    // what lets one flag serve both a sum and a difference.
    function roundPack(b, sg, e, ext, st) {
        // GRADUAL UNDERFLOW: an exponent at or below zero is not representable, so the
        // mantissa is shifted down into the subnormal range - the bits that fall off
        // joining the sticky - and rounded there instead. Without this the exponent
        // simply wrapped and a product that should underflow came back enormous.
        var sub = b.NewICmp(llvm.enum.IPredSLT, e, one64)
        var dn = shrSticky(b, ext, b.NewSub(one64, e))
        st = b.NewSelect(sub, b.NewOr(st, dn.s), st)
        ext = b.NewSelect(sub, dn.m, ext)
        e = b.NewSelect(sub, one64, e)
        var mant = b.NewLShr(ext, kThree)
        var g = b.NewAnd(b.NewLShr(ext, k64(2)), one64)         // the guard bit
        var below = b.NewOr(b.NewAnd(ext, kThree), st)          // anything under it
        var up = b.NewOr(b.NewZExt(b.NewICmp(llvm.enum.IPredNE, below, zero64), i64),
                         b.NewAnd(mant, one64))                 // ...or an odd mantissa
        var inc = b.NewAnd(g, up)
        mant = b.NewAdd(mant, inc)
        // Rounding 2^53-1 up carries into a new leading bit.
        var over = b.NewICmp(llvm.enum.IPredUGE, mant, kB53)
        mant = b.NewSelect(over, b.NewLShr(mant, one64), mant)
        e = b.NewSelect(over, b.NewAdd(e, one64), e)
        // A mantissa that never reached the implicit bit IS a subnormal, and a
        // subnormal's exponent FIELD is zero; rounding one up to 2^52 lands exactly on
        // the smallest normal, which the same formula spells with a field of 1.
        var ez = b.NewSelect(b.NewICmp(llvm.enum.IPredULT, mant, kB52), zero64, e)
        // OVERFLOW saturates to infinity rather than wrapping the exponent.
        var inf = b.NewICmp(llvm.enum.IPredSGE, e, kExpMask)
        return b.NewSelect(inf, b.NewOr(b.NewShl(sg, k64(63)), b.NewShl(kExpMask, k64(52))),
                           pack(b, sg, ez, mant))
    }
    var softFns = {}
    function softFn(name, nargs, build) {
        if (hasOwn(softFns, name)) return softFns[name]
        var ps = []
        for (var i = 0; i < nargs; i++) ps.push(llvm.ir.NewParam("", i64))
        var f = m.NewFunc(name, i64, ps)
        softFns[name] = f
        var fb = f.NewBlock("entry")
        fb.NewRet(build(fb, f))
        return f
    }
    // a + b. The operands are ordered by exponent, the smaller mantissa is shifted
    // into place, and the sum (or difference) is renormalized.
    function buildDAdd(b, f) { return addCore(b, f, false) }
    function buildDSub(b, f) { return addCore(b, f, true) }
    function addCore(b, f, negB) {
        var xb = f.Params[0]
        // Subtraction flips the sign HERE rather than at the call site, so that a NaN
        // second operand reaches nanThrough with its own bits intact.
        var yb = negB ? b.NewXor(f.Params[1], b.NewShl(one64, k64(63))) : f.Params[1]
        var A = unpack(b, xb)
        var B = unpack(b, yb)
        // SIGNED: a normalized subnormal's exponent is below zero, and an unsigned
        // compare would rank it as the largest number there is.
        var aGe = b.NewICmp(llvm.enum.IPredSGE, A.e, B.e)
        var e1 = b.NewSelect(aGe, A.e, B.e)
        var m1 = b.NewShl(b.NewSelect(aGe, A.m, B.m), kThree)
        var s1 = b.NewSelect(aGe, A.s, B.s)
        var e2 = b.NewSelect(aGe, B.e, A.e)
        var m2 = b.NewShl(b.NewSelect(aGe, B.m, A.m), kThree)
        var s2 = b.NewSelect(aGe, B.s, A.s)
        var sh = shrSticky(b, m2, b.NewSub(e1, e2))
        var m2s = sh.m
        var st = sh.s
        var same = b.NewICmp(llvm.enum.IPredEQ, s1, s2)
        // Which operand is larger decides the sign of a cancelling subtraction, and
        // the bits lost to the alignment count: an equal aligned mantissa with
        // something still underneath it belongs to the LARGER number.
        var lessN = b.NewOr(b.NewZExt(b.NewICmp(llvm.enum.IPredULT, m1, m2s), i64),
                            b.NewAnd(b.NewZExt(b.NewICmp(llvm.enum.IPredEQ, m1, m2s), i64), st))
        var less = b.NewICmp(llvm.enum.IPredNE, lessN, zero64)
        // Both difference branches are arranged to leave a POSITIVE residue below
        // the computed value, which is what lets the one sticky flag serve both:
        // a - (b + f) is (a - b - 1) + (1 - f), and (b + f) - a is (b - a) + f.
        var dif = b.NewSelect(less, b.NewSub(m2s, m1), b.NewSub(b.NewSub(m1, m2s), st))
        var mres = b.NewSelect(same, b.NewAdd(m1, m2s), dif)
        var sres = b.NewSelect(same, s1, b.NewSelect(less, s2, s1))
        var eres = e1
        // A carry out of the extended field costs one right shift, whose lost bit
        // joins the sticky; a cancelling subtraction can need up to 55 left shifts,
        // and only ever happens when nothing was lost to the alignment at all (a
        // difference of more than three in the exponents cannot cancel).
        var over = b.NewICmp(llvm.enum.IPredUGE, mres, kB56)
        st = b.NewSelect(over, b.NewOr(st, b.NewAnd(mres, one64)), st)
        mres = b.NewSelect(over, b.NewLShr(mres, one64), mres)
        eres = b.NewSelect(over, b.NewAdd(eres, one64), eres)
        var n = normLeft(b, mres, eres, normLim55)
        var res = roundPack(b, sres, n.e, n.m, st)
        // A zero result keeps a sign: -0 + -0 is -0, while a cancellation between
        // opposite signs is +0 under round-to-nearest.
        res = b.NewSelect(b.NewICmp(llvm.enum.IPredEQ, mres, zero64),
                          b.NewShl(b.NewSelect(same, s1, zero64), k64(63)), res)
        // Infinity dominates a finite operand; two infinities of opposite sign are
        // the one sum that has no answer.
        var ai = b.NewZExt(isInfOf(b, xb), i64)
        var bi = b.NewZExt(isInfOf(b, yb), i64)
        res = b.NewSelect(b.NewICmp(llvm.enum.IPredNE, bi, zero64), yb, res)
        res = b.NewSelect(b.NewICmp(llvm.enum.IPredNE, ai, zero64), xb, res)
        res = b.NewSelect(b.NewICmp(llvm.enum.IPredNE,
                  b.NewAnd(b.NewAnd(ai, bi),
                           b.NewZExt(b.NewICmp(llvm.enum.IPredNE, A.s, B.s), i64)), zero64),
                  kNanBits, res)
        // The NaN that comes THROUGH is the operand as written: 'x - NaN' answers that
        // NaN, sign and all, not the sign-flipped one the subtraction works with.
        return nanThrough(b, xb, f.Params[1], res)
    }
    // a * b. The 106-bit product of the two mantissas is formed from 26-bit halves
    // and kept WHOLE - as a high half (bits 105..52) and a 52-bit remainder - so
    // that nothing is discarded before the rounding decision is taken.
    function buildDMul(b, f) {
        var xb = f.Params[0]
        var yb = f.Params[1]
        var A = unpack(b, xb)
        var B = unpack(b, yb)
        var k26 = k64(26)
        var k49 = k64(49)
        var k52 = k64(52)
        var mask26 = k64(67108863)
        var ah = b.NewLShr(A.m, k26)
        var al = b.NewAnd(A.m, mask26)
        var bh = b.NewLShr(B.m, k26)
        var bl = b.NewAnd(B.m, mask26)
        var hh = b.NewMul(ah, bh)
        var mid = b.NewAdd(b.NewMul(ah, bl), b.NewMul(al, bh))
        var t = b.NewAdd(b.NewMul(al, bl), b.NewShl(b.NewAnd(mid, mask26), k26))
        var high = b.NewAdd(b.NewAdd(hh, b.NewLShr(mid, k26)), b.NewLShr(t, k52))
        var lowr = b.NewSub(t, b.NewShl(b.NewLShr(t, k52), k52))
        // The extended mantissa is the product shifted right by 49; the 49 bits
        // that fall off it are the sticky.
        var kept = b.NewLShr(lowr, k49)
        var mres = b.NewOr(b.NewShl(high, kThree), kept)
        var st = b.NewZExt(b.NewICmp(llvm.enum.IPredNE,
                     b.NewSub(lowr, b.NewShl(kept, k49)), zero64), i64)
        var eres = b.NewSub(b.NewAdd(A.e, B.e), kBias)
        var over = b.NewICmp(llvm.enum.IPredUGE, mres, kB56)
        st = b.NewSelect(over, b.NewOr(st, b.NewAnd(mres, one64)), st)
        mres = b.NewSelect(over, b.NewLShr(mres, one64), mres)
        eres = b.NewSelect(over, b.NewAdd(eres, one64), eres)
        // Either mantissa being zero makes the product zero. Testing their PRODUCT
        // would not do: 2^52 * 2^52 is 0 modulo 2^64.
        var az = b.NewICmp(llvm.enum.IPredEQ, A.m, zero64)
        var isZero = b.NewICmp(llvm.enum.IPredEQ, b.NewSelect(az, zero64, B.m), zero64)
        var sgn = b.NewXor(A.s, B.s)
        var res = roundPack(b, sgn, eres, mres, st)
        res = b.NewSelect(isZero, b.NewShl(sgn, k64(63)), res)
        // Infinity times anything but zero is infinity; times zero it has no answer.
        var anyInf = b.NewOr(b.NewZExt(isInfOf(b, xb), i64), b.NewZExt(isInfOf(b, yb), i64))
        var anyZero = b.NewOr(b.NewZExt(isZeroOf(b, xb), i64), b.NewZExt(isZeroOf(b, yb), i64))
        res = b.NewSelect(b.NewICmp(llvm.enum.IPredNE, anyInf, zero64), signedInf(b, sgn), res)
        res = b.NewSelect(b.NewICmp(llvm.enum.IPredNE, b.NewAnd(anyInf, anyZero), zero64),
                          kNanBits, res)
        return nanThrough(b, xb, yb, res)
    }
    // a / b. Five unrolled long-division steps of 11 bits and one of 3 give 58
    // quotient bits: the 55 the extended mantissa needs, and the guard/round/sticky
    // under them. A remainder left at the end is the sticky proper.
    function buildDDiv(b, f) {
        var xb = f.Params[0]
        var yb = f.Params[1]
        var A = unpack(b, xb)
        var B = unpack(b, yb)
        var k11 = k64(11)
        var den = b.NewSelect(b.NewICmp(llvm.enum.IPredEQ, B.m, zero64), one64, B.m)
        var num = A.m
        var acc = zero64
        for (var i = 0; i < 5; i++) {
            var sh = b.NewShl(num, k11)
            acc = b.NewOr(b.NewShl(acc, k11), b.NewUDiv(sh, den))
            num = b.NewURem(sh, den)
        }
        var sh3 = b.NewShl(num, kThree)
        acc = b.NewOr(b.NewShl(acc, kThree), b.NewUDiv(sh3, den))
        num = b.NewURem(sh3, den)
        var st = b.NewZExt(b.NewICmp(llvm.enum.IPredNE, num, zero64), i64)
        // acc is the quotient scaled by 2^58 and lies in (2^57, 2^59).
        var c = b.NewSelect(b.NewICmp(llvm.enum.IPredUGE, acc, k64(288230376151711744)), kThree, k64(2))
        var mres = b.NewLShr(acc, c)
        st = b.NewOr(st, b.NewZExt(b.NewICmp(llvm.enum.IPredNE,
                 b.NewSub(acc, b.NewShl(mres, c)), zero64), i64))
        var eres = b.NewAdd(b.NewSub(b.NewAdd(b.NewSub(A.e, B.e), kBias), kThree), c)
        var isZero = b.NewICmp(llvm.enum.IPredEQ, A.m, zero64)
        var sgn = b.NewXor(A.s, B.s)
        var res = roundPack(b, sgn, eres, mres, st)
        res = b.NewSelect(isZero, b.NewShl(sgn, k64(63)), res)
        // x/0 is infinity, x/Inf is zero, Inf/x is infinity - and Inf/Inf and 0/0 are
        // the two quotients with no answer.
        var ai = b.NewZExt(isInfOf(b, xb), i64)
        var bi = b.NewZExt(isInfOf(b, yb), i64)
        var az2 = b.NewZExt(isZeroOf(b, xb), i64)
        var bz = b.NewZExt(isZeroOf(b, yb), i64)
        var sZero = b.NewShl(sgn, k64(63))
        res = b.NewSelect(b.NewICmp(llvm.enum.IPredNE, bz, zero64), signedInf(b, sgn), res)
        res = b.NewSelect(b.NewICmp(llvm.enum.IPredNE, bi, zero64), sZero, res)
        res = b.NewSelect(b.NewICmp(llvm.enum.IPredNE, ai, zero64), signedInf(b, sgn), res)
        res = b.NewSelect(b.NewICmp(llvm.enum.IPredNE, b.NewAnd(ai, bi), zero64), kNanBits, res)
        res = b.NewSelect(b.NewICmp(llvm.enum.IPredNE, b.NewAnd(az2, bz), zero64), kNanBits, res)
        return nanThrough(b, xb, yb, res)
    }
    // A signed 64-bit integer to a double, rounded to nearest even. The magnitude
    // needs up to 63 bits, so it is first shifted DOWN under 2^53 - keeping what
    // that loses as the sticky - and only then normalized up. Shifting down is what
    // the old version did not do: every integer above 2^53 came out halved.
    function buildI2D(b, f) {
        var x = f.Params[0]
        var neg = b.NewICmp(llvm.enum.IPredSLT, x, zero64)
        var ax0 = b.NewSelect(neg, b.NewSub(zero64, x), x)
        var ax = ax0
        // The magnitude enters the extended field UNSHIFTED, so it stands for a
        // mantissa eight times smaller and the base exponent is three higher.
        var e = k64(1023 + 52 + 3)
        var st = zero64
        // Down to the extended field (below 2^56), not to the mantissa itself: the
        // three bits that would otherwise be thrown away ARE the guard bits, and
        // rounding needs them. Four conditional steps cover the eight shifts a
        // 63-bit magnitude can need.
        var ks = [4, 2, 1, 1]
        var lim = [1152921504606846976, 288230376151711744,
                   144115188075855872, 72057594037927936]   // 2^60 2^58 2^57 2^56
        for (var i = 0; i < 4; i++) {
            var c = b.NewICmp(llvm.enum.IPredUGE, ax, k64(lim[i]))
            var sh = shrSticky(b, ax, k64(ks[i]))
            st = b.NewSelect(c, b.NewOr(st, sh.s), st)
            ax = b.NewSelect(c, sh.m, ax)
            e = b.NewSelect(c, b.NewAdd(e, k64(ks[i])), e)
        }
        var n = normLeft(b, ax, e, normLim55)
        var res = roundPack(b, b.NewSelect(neg, one64, zero64), n.e, n.m, st)
        return b.NewSelect(b.NewICmp(llvm.enum.IPredEQ, ax0, zero64), zero64, res)
    }
    // A double to a signed 64-bit integer, truncating towards zero.
    function buildD2I(b, f) {
        var A = unpack(b, f.Params[0])
        var sh = b.NewSub(k64(52 + 1023), A.e)
        var big = b.NewICmp(llvm.enum.IPredSGT, sh, k64(63))   // |value| < 1
        var shc = b.NewSelect(big, k64(63), sh)
        var neg = b.NewICmp(llvm.enum.IPredSLT, shc, zero64)   // |value| >= 2^52
        var up = b.NewShl(A.m, b.NewSub(zero64, shc))
        var down = b.NewLShr(A.m, shc)
        var mag = b.NewSelect(neg, up, b.NewSelect(big, zero64, down))
        return b.NewSelect(b.NewICmp(llvm.enum.IPredNE, A.s, zero64), b.NewSub(zero64, mag), mag)
    }
    function emitDBin(b, op, x, y) {
        if (op == "+") return b.NewCall(softFn("__mec_dadd", 2, buildDAdd), [x, y])
        if (op == "-") return b.NewCall(softFn("__mec_dsub", 2, buildDSub), [x, y])
        if (op == "*") return b.NewCall(softFn("__mec_dmul", 2, buildDMul), [x, y])
        if (op == "/") return b.NewCall(softFn("__mec_ddiv", 2, buildDDiv), [x, y])
        fail("operator " + op + " is not defined on floating-point operands")
    }
    // The IEEE ordering as an UNSIGNED integer ordering: flip every bit of a negative
    // pattern, set the top bit of a positive one, and the bit patterns sort like the
    // numbers they encode.
    function dblKey(b, x) {
        var top = b.NewShl(one64, k64(63))
        // -0 and +0 are the same NUMBER and must key the same, so the one pattern
        // that is a negative zero is canonicalized before the ordering trick.
        var z = b.NewSelect(b.NewICmp(llvm.enum.IPredEQ, x, top), zero64, x)
        return b.NewSelect(b.NewICmp(llvm.enum.IPredSLT, z, zero64), b.NewXor(z, k64(-1)), b.NewOr(z, top))
    }
    function trueBit(b) { return b.NewICmp(llvm.enum.IPredEQ, zero64, zero64) }
    function falseBit(b) { return b.NewICmp(llvm.enum.IPredNE, zero64, zero64) }
    function emitDCmp(b, op, x, y) {
        var pred = { "==": llvm.enum.IPredEQ, "!=": llvm.enum.IPredNE, "<": llvm.enum.IPredULT,
                     ">": llvm.enum.IPredUGT, "<=": llvm.enum.IPredULE, ">=": llvm.enum.IPredUGE }[op]
        var c = b.NewICmp(pred, dblKey(b, x), dblKey(b, y))
        // A NaN is UNORDERED against everything, itself included: every comparison but
        // '!=' is false, and '!=' is true. The bit-pattern ordering below cannot say
        // that on its own - it made NaN == NaN come out true.
        var un = b.NewOr(b.NewZExt(isNanOf(b, x), i64), b.NewZExt(isNanOf(b, y), i64))
        var unc = b.NewICmp(llvm.enum.IPredNE, un, zero64)
        return toInt(b, b.NewSelect(unc, (op == "!=") ? trueBit(b) : falseBit(b), c))
    }
    // int -> double and double -> int, at the i32 boundary the rest of the model uses.
    function emitI2D(b, ct, v) {
        // A 64-bit operand is ALREADY an i64 register and must not be extended again.
        var w = llIs64(v) ? v : ((ct.k == "int" && ct.u == true) ? b.NewZExt(v, i64) : b.NewSExt(v, i64))
        return b.NewCall(softFn("__mec_i2d", 1, buildI2D), [w])
    }
    // The soft-float helper answers a full i64; the destination type narrows it
    // (emitConv does), so a (long) cast of a double keeps all 64 bits.
    function emitD2I(b, v) {
        return b.NewCall(softFn("__mec_d2i", 1, buildD2I), [v])
    }

    // A condition is "not zero", against a zero of the value's own register width:
    // an i64 long has to be compared against an i64 zero.
    truthy = function(b, v) {
        if (llvm.types.IsPointer(v.Type())) { return b.NewICmp(llvm.enum.IPredNE, v, llvm.constant.NewNull(i32p)) }
        return b.NewICmp(llvm.enum.IPredNE, v, llIs64(v) ? zero64 : zero)
    }
    function toInt(b, v) { return b.NewZExt(v, i32) }

    // ----- goto and labels -----
    // A labelled statement is pushed as {lbl, t} instead of a bare thunk, so the
    // enclosing statement SEQUENCE can give each of its labels a basic block. Every
    // label block of a sequence is created BEFORE any statement of that sequence is
    // emitted, so a forward goto - even from inside a nested block or loop - already
    // finds its target; a goto is then simply an unconditional branch.
    var labelBlocks = {}
    function makeLabel(items) { return {lbl: items[0], t: items[1]} }
    function makeGoto(name) {
        return function(b) {
            var t = hasOwn(labelBlocks, name) ? labelBlocks[name] : undefined
            if (t == undefined) fail("goto to an undefined label: " + name)
            b.NewBr(t)
            return deadBlock()
        }
    }
    makeSeq = function (items) {
        var stmts = []
        var marks = []
        for (var i = 0; i < items.length; i++) {
            var it = items[i]
            if (it != undefined && typeof it != "function" && it.lbl != undefined) {
                marks.push({at: stmts.length, name: it.lbl})
                stmts.push(it.t)
            } else {
                stmts.push(it)
            }
        }
        return function(b) {
            var at = []
            for (var k = 0; k < stmts.length; k++) at.push(undefined)
            for (var j = 0; j < marks.length; j++) {
                var blk = curF.NewBlock("")
                at[marks[j].at] = blk
                labelBlocks[marks[j].name] = blk
            }
            for (var n = 0; n < stmts.length; n++) {
                if (at[n] != undefined) { b.NewBr(at[n]); b = at[n] }
                b = stmts[n](b)
            }
            return b
        }
    }

    // ----- Expression thunks: function(block) -> {b, v} -----

    function kint(n) { return llvm.constant.NewInt(i32, n | 0) }
    // Every expression thunk answers {b, v, ct, cv}: the block to continue in, the
    // LLVM value, the C type, and - when the expression is a compile-time constant -
    // its value. cv is what carries floating point, which the IR interpreter has no
    // instruction for, through constant expressions, casts and comparisons.
    function makeNum(n, ct) {
