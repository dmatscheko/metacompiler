    }
    // ----- Top level -----

    var unnamedSeq = 0
    // One parameter descriptor. An ARRAY parameter is adjusted to a pointer to its
    // element type (C11 6.7.6.3p7), and a struct or union VALUE parameter travels as
    // the address of the caller's object, which the callee copies.
    function paramOf(name, ct) {
        if (ct.k == "arr") { ct = {k: "ptr", p: ct.e} }
        var pname = name
        if (pname == undefined || pname == "") { unnamedSeq = unnamedSeq + 1; pname = "$arg" + unnamedSeq }
        return {name: pname, ptr: ct.k == "ptr" || isAggCt(ct), ct: ct}
    }
    // A function type's parameter list -> the {cts, ptrs} a call through a pointer
    // to it converts its arguments by (emitCallArgs).
    function fnSigOf(params) {
        var cts = []
        var ptrs = []
        for (var i = 0; i < params.length; i++) {
            cts.push(params[i].ct)
            ptrs.push(params[i].ptr == true)
        }
        return {cts: cts, ptrs: ptrs}
    }
    // An abstract function declarator ('int (*)(int)', the parameter 'int (int)'),
    // with the {fsig} of its parameter list when FnSig read one.
    function absFnOf(items) {
        var sig = undefined
        for (var i = 0; i < items.length; i++) {
            if (items[i] != undefined && items[i].fsig != undefined) { sig = items[i].fsig }
        }
        return {fnabs: true, sig: sig}
    }
    // The type of a function's name used as a value: a pointer to that function.
    function funcPtrCt(name) {
        return fnpCt(hasOwn(funcRetAll, name) ? funcRetAll[name] : undefined,
                     {cts: paramCtsOf(name), ptrs: paramPtrsOf(name)})
    }
    // Param / ParamAbs items = [{bty}|{sname}, {ptr}?, name?, {dims}?].
    function makeParam(items) {
        var i = 0
        var base = ctInt
        if (items[i] != undefined && items[i].sname != undefined) { base = ctStruct(items[i].sname); i++ }
        else if (items[i] != undefined && items[i].bty != undefined) { base = items[i].bty; i++ }
        for (var k = i; k < items.length; k++) {
            if (items[k] != undefined && items[k].fnabs == true) return paramOf("", fnpCt(ptrTo(starsOf(items[i]), base), items[k].sig))
