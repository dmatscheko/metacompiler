        typedefs["ssize_t"] = ctI(8, false)
        typedefs["ptrdiff_t"] = ctI(8, false)
        typedefs["intptr_t"] = ctI(8, false)
        typedefs["uintptr_t"] = ctI(8, true)
        typedefs["intmax_t"] = ctI(8, false)
        typedefs["uintmax_t"] = ctI(8, true)
        typedefs["wchar_t"] = ctI(4, false)
        typedefs["wint_t"] = ctI(4, false)
        typedefs["char16_t"] = ctI(2, true)
        typedefs["char32_t"] = ctI(4, true)
        typedefs["int8_t"] = ctI(1, false)
        typedefs["uint8_t"] = ctI(1, true)
        typedefs["int16_t"] = ctI(2, false)
        typedefs["uint16_t"] = ctI(2, true)
        typedefs["int32_t"] = ctI(4, false)
        typedefs["uint32_t"] = ctI(4, true)
        typedefs["int64_t"] = ctI(8, false)
        typedefs["uint64_t"] = ctI(8, true)
        typedefs["int_fast8_t"] = ctI(1, false)
        typedefs["int_least8_t"] = ctI(1, false)
