    // An integer constant carries the type its suffix names and its VALUE selects
    // (C11 6.4.4.1p5), and a 64-bit one is emitted from its exact two-half reading
    // rather than from the double parseCInt answered.
    function makeNumLit(n, text) {
        var p = parseCInt64(text)
        var ct = intCtOf(text, p)
        if (ct.w < 8) return makeNum(n, ct)
        var k = k64exact(p)
        var cv = u64Num(p, ct.u == true)
        return function(b) { return {b: b, v: k, ct: ct, cv: cv, p64: p} }
    }
    // The type of an integer literal's text. Twin of cLitCt in c-interpreter.abnf.
    function cLitCt(text) { return intCtOf(text, parseCInt64(text)) }
    // The suffix names the smallest rank and the signedness; the type is then the
    // first one of that rank's list that holds the value. A decimal constant only ever
    // picks a signed type, a hexadecimal / octal / binary one may pick the unsigned
    // one of the same rank - which is what makes sizeof(0xFFFFFFFF) 4 while
    // sizeof(5000000000) is 8.
    function intCtOf(text, p) {
        var nl = 0
        var u = false
        var isDec = true
        if (text.length > 1 && text.charCodeAt(0) == 48) { isDec = false }
        for (var i = 0; i < text.length; i++) {
            var cc = text.charCodeAt(i)
            if (cc == 108 || cc == 76) nl = nl + 1
            else if (cc == 117 || cc == 85) u = true
            else if (!((cc >= 48 && cc <= 57) || (cc >= 97 && cc <= 102) || (cc >= 65 && cc <= 70) || cc == 120 || cc == 88)) break
        }
        if (nl > 0) return ctI(8, u)
        var fitsU32 = (p.hi == 0)
        var fitsI32 = (p.hi == 0 && (p.lo & 2147483648) == 0)
        var fitsI64 = ((p.hi & 2147483648) == 0)
        if (u) return fitsU32 ? ctI(4, true) : ctI(8, true)
        if (fitsI32) return ctI(4, false)
        if (!isDec && fitsU32) return ctI(4, true)
        if (fitsI64) return ctI(8, false)
        return ctI(8, true)
    }
