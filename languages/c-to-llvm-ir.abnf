    // type it initializes: cInitWalk (lib/c-literals.js) places each item, and a
    // nested brace list recurses. Every position the list does not reach keeps the
    // zero the pre-fill wrote.
    function emitInit(b, ct, init, addr) {
        if (typeof init == "function") {
            var r = init(b)
            b = r.b
            if (isAggCt(ct)) return emitCopy(b, ct, addr, r.v)
            storeTo(b, ct, addr, coerce(b, ct, r))
            return b
        }
        // A string-literal item: the bytes of a char array, or the literal's address
        // for a pointer ('char *a[] = { "x", "yy" }').
        if (init.str != undefined) return strInitInto(b, ct, init, addr)
        var list = init.list
        // 'int x = { 1 };': a scalar may be brace-initialized by one item (C11 6.7.9p11).
        if (!isAggCt(ct)) {
            if (list.length > 1) fail("too many initializers for a scalar")
            if (list.length == 1) { return emitInit(b, ct, list[0].v, addr) }
            return b
        }
        var cur = {b: b}
        cInitWalk(ct, list, cInitWholeOf(init, function(v, mct) { return wholeInit(cur.b, v, mct) }),
