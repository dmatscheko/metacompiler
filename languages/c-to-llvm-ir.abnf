    var curSret = undefined
    var curRetCt = undefined
    // The C type the function currently being emitted returns (int unless it was
    // declared to return a 64-bit type, in which case the LLVM return type is i64).
    var curFnRetCt = ctInt
    // Whether the function currently being emitted returns a POINTER (LLVM i32*).
    var curFnRetPtr = false
    // The DECLARED return type when narrower than int (char, short, _Bool). Not
    // curFnRetCt, which drives the i32 signature; C11 6.8.6.4p3 still converts the
    // returned value to it like an assignment.
    var curFnRetNarrow = undefined
    function emitFunctionBody(name, params, bodyT, sretCt) {
        cNoteFnDef(name)
        if (sretCt != undefined) { structRet[name] = sretCt }
        userFuncs[name] = params.length
        noteParamCts(name, params)
        var f = getFunc(name, params)
        curF = f
        curFnRetCt = hasOwn(funcRetCt, name) ? funcRetCt[name] : ctInt
        curFnRetNarrow = undefined
        if (hasOwn(funcRetAll, name)) {
            var nrc = funcRetAll[name]
            if (nrc != undefined && nrc.k == "int" && nrc.w < 4) { curFnRetNarrow = nrc }
        }
        curFnRetPtr = sretCt == undefined && retIsPtr(name)
        labelBlocks = {}   // Labels are function scoped.
        var b = f.NewBlock("entry")
        scopes.push({})
        var off = 0
        if (sretCt != undefined) { curSret = f.Params[0]; off = 1 } else { curSret = undefined }
        curRetCt = sretCt
        for (var i = 0; i < params.length; i++) {
            var pct = params[i].ct
            if (isAggCt(pct)) {
                // A struct parameter is passed BY VALUE: the argument is the address of
                // the caller's object, and the callee gets its own copy.
                var a = b.NewAlloca(ctLTy(pct))
                b = emitCopy(b, pct, a, f.Params[i + off])
                declVar(params[i].name, {val: a, arr: false, ct: pct})
                continue
            }
            // The signature passes a narrow integer promoted (i32) and a float as a
            // double's i64, but the SLOT is a cell of the declared type (an i8 for a
            // char, a binary32 for a float), like every other store/load of it.
            var pty = params[i].ptr ? i32p
                      : ((pct != undefined && (pct.k == "flt" || (pct.k == "int" && pct.w >= 8)))
                         ? llvm.types.I64 : i32)
            var cty = (!params[i].ptr && pct != undefined && ((pct.k == "int" && pct.w < 4) || pct.k == "flt" || pct.k == "fnp"))
