    // type is a typedef name. The name resolves to the type it abbreviates, which then
    // drives the signature exactly as if spelled out (a struct by value gets sret).
    // Returns [name, params, sret struct type or undefined].
    function noteTdRet(items) {
        var rt = typedefOf(items[0].tname)
        var star = (typeof items[1] == "string" && typeof items[2] == "string") ? items[1] : undefined
        var n = star == undefined ? 1 : 2
        noteRet(items[n], star, rt)
        var sret = (star == undefined && rt.k == "struct") ? rt : undefined
        if (sret != undefined) { structRet[items[n]] = sret }
        return [items[n], items[n + 1], sret]
    }
