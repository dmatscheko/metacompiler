    }
    // Step a place path from a starting {b, v, ct}: '[i]' peels one array or pointer
    // level (getelementptr by whole elements), '.f' selects the field, '->f' loads the
    // pointer first. The C type travels with the address.
    function emitPath(start, path, name) {
        var b = start.b
        var addr = start.v
        var ct = start.ct != undefined ? start.ct : ctInt
        var bf = undefined   // Set when the LAST step selected a bit field.
        for (var i = 0; i < path.length; i++) {
            var s = path[i]
            bf = undefined
            if (s.idx != undefined) {
                var r = s.idx(b)
                b = r.b
                if (ct.k == "arr") {
                    addr = b.NewGetElementPtr(ctLTy(ct), addr, [zero, r.v])
                    ct = ct.e
                } else if (ct.k == "ptr") {
                    var base = b.NewLoad(i32p, addr)
                    ct = ct.p
                    addr = b.NewGetElementPtr(ctLTy(ct), base, [r.v])
                } else if (ct.k == "int") {
                    var sp = emitSubscript(b, {v: loadCt(b, ct, addr), ct: ct}, r)
                    addr = sp.v
                    ct = sp.ct
                } else fail("indexing needs an array or a pointer: " + name)
            } else if (s.fld != undefined) {
                if (ct.k != "struct") fail("'.' needs a struct value: ." + s.fld)
                var f = fieldOf(ct.s, s.fld)
                addr = fieldAddr(b, structOf(ct.s), f, addr)
                ct = f.ct
                bf = f.bf
            } else {
                if (ct.k != "ptr" || ct.p.k != "struct") fail("'->' needs a struct pointer: ->" + s.arw)
                var base2 = b.NewLoad(i32p, addr)
                var f2 = fieldOf(ct.p.s, s.arw)
                addr = fieldAddr(b, structOf(ct.p.s), f2, base2)
                ct = f2.ct
                bf = f2.bf
            }
