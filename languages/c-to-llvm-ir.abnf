        // A pointer-returning function reports its declared pointer type (its LLVM result
        // is already i32*); ctInt would send 'strchr(s, c) - s' down the ptr+int path.
        var rct = hasOwn(funcRetCt, name) ? funcRetCt[name] : ctInt
        if (retIsPtr(name) || (hasOwn(funcRetAll, name) && funcRetAll[name].k == "fnp")) { rct = funcRetAll[name] }
