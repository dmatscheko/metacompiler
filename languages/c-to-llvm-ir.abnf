            }
            // The declared narrow type first (6.8.6.4p3), then the register width
            // the signature wants. emitConv answers an i32 either way, so the second
            // step is a no-op for everything but a 64-bit or floating return.
            if (curFnRetNarrow != undefined) {
                r = {b: r.b, v: coerce(r.b, curFnRetNarrow, r), ct: curFnRetNarrow}
            }
            r.b.NewRet(coerce(r.b, curFnRetCt, r))
            return deadBlock()
