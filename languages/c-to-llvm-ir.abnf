    // Every global starts as a zeroed slot, and its initializer is emitted into the
    // module's global-initializer function (see buildGlobalInit): the module format
    // has no way to spell an aggregate constant - llvm.constant has no NewArray - and
    // the entry point is wrapped so the function runs before anything else does.
    var globalInits = []
    function newGlobal(name, ct) {
        var lty = ctLTy(ct)
        var g = m.NewGlobalDef(name, ct.k == "ptr" ? llvm.constant.NewNull(i32p)
                                                   : llvm.constant.NewZeroInitializer(lty))
        // An array without a size is reached through a cast of its global, so the
        // code emitted against it stays well typed once sizeGlobal retypes the global.
        var val = (ct.k == "arr" && ct.n == 0) ? llvm.constant.NewBitCast(g, g.Type()) : g
        globalScope[name] = {val: val, g: g, arr: ct.k == "arr", ty: lty,
