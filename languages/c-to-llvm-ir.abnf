    // elements (the array in place, a pointer through its loaded base), .f selects
    // the field, ->f loads the pointer first. The extra ct in the result lets
    // makeLoadOf pick the loaded type.
    // Step a place path from a starting {b, v, ct}: '[i]' peels one array or pointer
    // level (and getelementptrs by whole elements), '.f' selects the field, '->f'
    // loads the pointer first. The C type travels with the address, so nothing needs
    // a separate 'is this an array' flag.
    function emitPath(start, path, name) {
        var b = start.b
        var addr = start.v
        var ct = start.ct != undefined ? start.ct : ctInt
        var bf = undefined   // Set when the LAST step selected a bit field.
        for (var i = 0; i < path.length; i++) {
            var s = path[i]
            bf = undefined
            if (s.idx != undefined) {
                var r = s.idx(b)
                b = r.b
                if (ct.k == "arr") {
                    addr = b.NewGetElementPtr(ctLTy(ct), addr, [zero, r.v])
                    ct = ct.e
                } else if (ct.k == "ptr") {
