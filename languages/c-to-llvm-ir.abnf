            var ptr = b.NewAlloca(cty)
            // Narrowing here is also the conversion C11 6.5.2.2p7 requires of an
            // argument to a declared parameter type: f(300) with 'char c' sees 44.
            // A _Bool parameter is not TRUNCATED but tested against zero, so
            // f(3) with '_Bool b' sees 1 (C11 6.3.1.2, applied by 6.5.2.2p7).
            var pv = f.Params[i + off]
            if (pct != undefined && pct.bool == true) { pv = emitConv(b, pct, pv, pct) }
            if (!params[i].ptr && pct != undefined && pct.k == "flt" && pct.w == 4) { pv = emitF32Pack(b, pv) }
            if (!params[i].ptr && pct != undefined && pct.k == "fnp") { pv = b.NewZExt(pv, i64) }
            b.NewStore(llvm.types.Equal(cty, pv.Type()) ? pv : b.NewTrunc(pv, cty), ptr)
