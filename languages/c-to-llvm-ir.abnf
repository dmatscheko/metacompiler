        var t = items.length > 0 ? items[0] : makeInt(0)
        var hasVal = items.length > 0
        return function(b) {
            // In a struct-returning function the value is copied into the caller's
            // destination (the hidden first parameter) and the call itself yields it.
            if (curSret != undefined && hasVal) {
