        var lty = ctLTy(ct)
        var init = items[1]
        return function(b) {
            var a = b.NewAlloca(lty)
            b = zeroAggregate(b, ct, a)
            b = emitInit(b, ct, init, a)
            return {b: b, v: a, ct: ct}
