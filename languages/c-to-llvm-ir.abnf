    function makeAssign(items) {
        var placeT = items[0]
        var op = items[1]
        var valT = items[2]
        return function(b) {
            var p = placeT(b)
            b = p.b
            if (p.ct != undefined && p.ct.k == "arr") fail("an array is not assignable")
            var r = valT(b)
            b = r.b
            var v = r.v
            // Assigning a whole struct or union copies its members (C11 6.5.16.1).
            if (op == "=" && isAggCt(p.ct)) { return {b: emitCopy(b, p.ct, p.v, v), v: p.v, ct: p.ct} }
            if (op != "=") {
                var cur = {b: b, v: loadPlace(b, p), ct: p.ct}
                var ra = applyOp(b, op, cur, r)
