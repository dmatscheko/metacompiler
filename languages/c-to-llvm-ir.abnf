    // it. main() returns int and output goes through putchar, so the binary prints and
    // reports main()'s value as its process exit code.
    if (c.exePath != undefined && c.exePath != "") {
        // A called function that is neither defined here nor one of the libc names
        // the model shares is a link error in C, so no zero stub may stand in for it
        // (the varargs printf family is one: c-interpreter.abnf has none either).
        var undef = llvm.UndefinedSymbols(m)
        if (undef.length > 0) {
            var names = undef[0]
            for (var ui = 1; ui < undef.length; ui++) { names = names + ", " + undef[ui] }
            eprintln("c compiler: function not defined: " + names)
            exit(1)
        }
        var buildErr = llvm.BuildExecutable(m, c.exePath)
        if (buildErr != "") { eprintln(buildErr); exit(1) }
        println("c compiler: wrote executable " + c.exePath)
        exit(0)
    }

    println(m)

    var res = llvm.Run(m, entry)
    llvm.WriteOut(res)
    println("c compiler: " + entry + "() returned " + res.Ret)
    exit(res.Ret)

~~) ;
