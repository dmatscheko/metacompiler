            }
            for (var j = 0; j < st.order.length; j++) {
                var f = fieldOf(ct.s, st.order[j])
                b = emitCopy(b, f.ct, fieldAddr(b, st, f, dst), fieldAddr(b, st, f, src))
            }
            return b
        }
        var lty = ctLTy(ct)
        b.NewStore(b.NewLoad(lty, src), dst)
        return b
    }

    // ----- Software floating point -----
    // The IR interpreter (abnf/llvmmap.go) decodes no floating-point instruction, so
    // a C double is carried as its IEEE-754 binary64 BIT PATTERN in an i64 and the
    // arithmetic is emitted as integer code - the soft-float library a compiler ships
    // for a target without an FPU, written straight into the module. Every helper is
    // branchless (select instead of branches), so it needs no basic blocks of its own
    // and can be emitted while another function is being built.
    // Rounding is to nearest, ties to even (see roundPack); infinities, NaNs, subnormals
    // and signed zeros are carried. A float is a double rounded to binary32 (buildD2F).
    var i64 = llvm.types.I64
    function k64(n) { return llvm.constant.NewInt(i64, n) }

    // ----- exact 64-bit integer constants -----
    // A JS number is an IEEE double, so it stops being an exact integer at 2^53 and a
    // literal like 18446744073709551615 would arrive already rounded. A 64-bit
    // constant is therefore carried as its two 32-bit HALVES all the way to the
    // module, where llir spells it with the unsigned-hexadecimal notation LLVM
    // accepts (u0x...); nothing about it ever passes through a double.
    function u64Make(hi, lo) { return {hi: hi >>> 0, lo: lo >>> 0} }
    // p * m + d, with m and d small (a digit and its base), on the two halves.
