    function emitSubscript(b, x, y) {
        if (y.ct != undefined && y.ct.k == "ptr") { var t = x; x = y; y = t }
        if (x.ct == undefined || x.ct.k != "ptr") fail("indexing needs an array or a pointer")
        var et = x.ct.p
        var base = b.NewBitCast(x.v, llvm.types.NewPointer(ctLTy(et)))
        return {b: b, v: b.NewGetElementPtr(ctLTy(et), base, [y.v]), ct: et, bf: undefined}
    }
    // items = [seedThunk, {idx} or {arw}, step...]: a subscripted value, or a pointer
    // value stepped through with '->', as a place.
    function makeSubscript(items) {
        var seedT = items[0]
        var first = items[1]
        var path = items.slice(2)
        return function(b) {
            var x = seedT(b)
            var p = undefined
            if (first.idx != undefined) {
                var y = first.idx(x.b)
                p = emitSubscript(y.b, x, y)
            } else {
                p = emitValStep(x.b, x.v, x.ct != undefined ? x.ct : ctInt, first)
            }
            return path.length == 0 ? p : emitPath(p, path, "subscript")
