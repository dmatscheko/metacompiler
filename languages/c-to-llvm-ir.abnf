                rv = llvm.types.IsPointer(rv.Type()) ? b.NewBitCast(rv, i32p) : b.NewIntToPtr(rv, i32p)
                var upred = { "==": llvm.enum.IPredEQ, "!=": llvm.enum.IPredNE, "<": llvm.enum.IPredULT,
