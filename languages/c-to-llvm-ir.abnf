    // int -> double and double -> int through the soft-float helpers.
    function emitI2D(b, ct, v) {
        var uns = ct.k == "int" && ct.u == true
        if (!llIs64(v)) { return b.NewCall(softFn("__mec_i2d", 1, buildI2D), [uns ? b.NewZExt(v, i64) : b.NewSExt(v, i64)]) }
        if (!uns) { return b.NewCall(softFn("__mec_i2d", 1, buildI2D), [v]) }
        // An unsigned long at or past 2^63 is negative to __mec_i2d: it converts HALF
        // the value, with the bit shifted out kept as a sticky bit so the one rounding
        // still sees it, and doubles the (exact) result.
        var big = b.NewICmp(llvm.enum.IPredSLT, v, zero64)
        var half = b.NewOr(b.NewLShr(v, one64), b.NewAnd(v, one64))
        var dv = b.NewCall(softFn("__mec_i2d", 1, buildI2D), [b.NewSelect(big, half, v)])
