        var uns = ct.k == "int" && ct.u == true
        var top = uns ? b.NewLShr(v, k64(53)) : b.NewAShr(v, k64(53))
        var exact = b.NewICmp(llvm.enum.IPredEQ, top, zero64)
        if (!uns) { exact = b.NewOr(exact, b.NewICmp(llvm.enum.IPredEQ, top, k64(-1))) }
        var lost = b.NewICmp(llvm.enum.IPredNE, b.NewAnd(v, k64(2047)), zero64)
        var jam = b.NewOr(b.NewAnd(v, k64(-2048)), b.NewSelect(lost, k64(2048), zero64))
        return b.NewSelect(exact, v, jam)
