    // rounded to binary32 (buildD2F), so this is exact: a normal is rebiased and keeps
    // its top 23 mantissa bits, a value below 2^-126 (field 897) becomes a binary32
    // subnormal, shifting one more place per binade, and an infinity or NaN keeps the
    // top of its payload, a NaN staying quiet. The result is in the low 32 bits.
    function buildF32Pack(b, f) {
        var x = f.Params[0]
        var sg = b.NewShl(b.NewLShr(x, k64(63)), k64(31))
        var ex = b.NewAnd(b.NewLShr(x, k64(52)), kExpMask)
        var mn = b.NewAnd(x, kM52)
        var top = b.NewLShr(mn, k64(29))
        var normal = b.NewOr(b.NewShl(b.NewSub(ex, k64(896)), k64(23)), top)
        var sh0 = b.NewSub(k64(926), ex)
        var sh = b.NewSelect(b.NewICmp(llvm.enum.IPredUGT, sh0, k64(63)), k64(63), sh0)
        var sub = b.NewLShr(b.NewOr(mn, kB52), sh)
        var special = b.NewOr(b.NewOr(k64(2139095040), top),
                              b.NewSelect(b.NewICmp(llvm.enum.IPredNE, mn, zero64), k64(4194304), zero64))
        var mag = b.NewSelect(b.NewICmp(llvm.enum.IPredUGE, ex, k64(897)), normal, sub)
        mag = b.NewSelect(b.NewICmp(llvm.enum.IPredEQ, ex, kExpMask), special, mag)
        return b.NewOr(sg, mag)
    }
    function emitF32Pack(b, v) { return b.NewTrunc(b.NewCall(softFn("__mec_f32pack", 1, buildF32Pack), [v]), i32) }
    // The double a binary32 cell (in the low 32 bits) holds. A binary32 subnormal is a
    // normal double: its mantissa is shifted until the leading bit reaches bit 23, in
    // steps of 16, 8, 4, 2 and 1 places, and each place lowers the exponent by one.
    function buildF32Unpack(b, f) {
        var y = f.Params[0]
        var sg = b.NewShl(b.NewAnd(b.NewLShr(y, k64(31)), one64), k64(63))
        var e8 = b.NewAnd(b.NewLShr(y, k64(23)), k64(255))
        var m = b.NewAnd(y, k64(8388607))
        var m29 = b.NewShl(m, k64(29))
        var normal = b.NewOr(b.NewShl(b.NewAdd(e8, k64(896)), k64(52)), m29)
        var special = b.NewOr(kInfBits, m29)
        var t = m
        var n = zero64
        var steps = [16, 8, 4, 2, 1]
        var below = [256, 65536, 1048576, 4194304, 8388608]
        for (var i = 0; i < steps.length; i++) {
            var lt = b.NewICmp(llvm.enum.IPredULT, t, k64(below[i]))
            t = b.NewSelect(lt, b.NewShl(t, k64(steps[i])), t)
            n = b.NewSelect(lt, b.NewAdd(n, k64(steps[i])), n)
        }
        var sub = b.NewOr(b.NewShl(b.NewSub(k64(897), n), k64(52)), b.NewShl(b.NewAnd(t, k64(8388607)), k64(29)))
        sub = b.NewSelect(b.NewICmp(llvm.enum.IPredEQ, m, zero64), zero64, sub)
        var mag = b.NewSelect(b.NewICmp(llvm.enum.IPredEQ, e8, zero64), sub, normal)
        mag = b.NewSelect(b.NewICmp(llvm.enum.IPredEQ, e8, k64(255)), special, mag)
        return b.NewOr(sg, mag)
