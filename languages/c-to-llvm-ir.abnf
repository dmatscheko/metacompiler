    // taking the next slots, aligned as the nested struct would be); an anonymous
    // union member takes a single shared slot. Inside a union, L.at is the run's byte
    // offset in the tag and its members are registered by byte offset (slot -1),
    // since L's slots are not the tag's. Returns cc's layout of the run.
    function layoutStructInto(fields, order, groups, name, L) {
        var ms = []
