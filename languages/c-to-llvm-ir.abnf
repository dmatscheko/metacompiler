    function makeDerefPlace(t) {
        return function(b) {
            var r = t(b)
            var ct = (r.ct != undefined && r.ct.k == "ptr") ? r.ct.p : ctInt
            return {b: r.b, v: r.v, ct: ct}
        }
    }
