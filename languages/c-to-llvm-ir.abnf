        return function(b) {
            var p = placeT(b)
            b = p.b
            var old = loadPlace(b, p)
            var nv = storePlace(b, p, bfNormV(b, p.bf, emitStep(b, p.ct, old, op)))
            return {b: b, v: nv, ct: p.bf != undefined ? p.bf.vct : p.ct}
        }
    }
    function makePostIncDec(op, placeT) {
        return function(b) {
            var p = placeT(b)
            b = p.b
            var old = loadPlace(b, p)
            storePlace(b, p, bfNormV(b, p.bf, emitStep(b, p.ct, old, op)))
            return {b: b, v: old, ct: p.bf != undefined ? p.bf.vct : p.ct}
