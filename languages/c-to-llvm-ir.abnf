        if (ct.k != "ptr" || ct.p.k != "struct") fail("'->' needs a struct pointer: ->" + s.arw)
        var f2 = fieldOf(ct.p.s, s.arw)
        var sty2 = structOf(ct.p.s).lty
        return {b: b, v: b.NewGetElementPtr(sty2, b.NewBitCast(v, llvm.types.NewPointer(sty2)),
