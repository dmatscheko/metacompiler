            if (ect.k == "arr") return {b: b, v: b.NewGetElementPtr(ctLTy(ect), e.val, [zero, zero]), ct: {k: "ptr", p: ect.e}}
            if (ect.k == "struct") return {b: b, v: e.val, ct: ect}
            return {b: b, v: loadCt(b, ect, e.val, e.load), ct: ect}
