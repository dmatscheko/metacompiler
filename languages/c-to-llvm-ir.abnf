    }
    // The entry point becomes a wrapper that runs the global initializers first and
    // then the user's function under its original name, so both llvm.Run and a
    // clang-linked executable (-exe, which enters at main) see the initialized data.
    function wrapEntry(name, ginit) {
        var uf = funcs[name]
        uf.SetName("__mec_body_" + name)
        var w = m.NewFunc(name, i32, [])
        var wb = w.NewBlock("entry")
        wb.NewCall(ginit, [])
        var args = []
        for (var i = 0; i < uf.Params.length; i++) {
            args.push(llvm.types.IsPointer(uf.Params[i].Type()) ? llvm.constant.NewNull(i32p) : zero)
        }
        wb.NewRet(wb.NewCall(uf, args))
        funcs[name] = w
    }

    function buildFunction() {
        var bodyT = pop()
        var params = pop()
        var name = pop()
        var star = pop()
        var rt = (typeof star == "string") ? pop() : star
        noteRet(name, star, rt.ret)
        emitFunctionBody(name, params, bodyT, undefined)
    }
    // Records the declared return type 'ret', or a pointer to it when a star run
    // ("*", "**") stands in front of the name.
    function noteRet(name, star, ret) {
        var isPtr = typeof star == "string"
        noteRetCt(name, isPtr ? undefined : ret)
        noteRetAll(name, isPtr ? ptrTo(starCount(star), ret) : ret)
    }
    // A prototype only records the shape: the name and the parameters are dropped, the
    // return type is remembered so a call that PRECEDES the definition already emits
    // the right return width.
    function registerProto() {
        var params = pop()
        var name = pop()
        var star = pop()
        var rt = (typeof star == "string") ? pop() : star
        noteRet(name, star, rt.ret)
        noteParamCts(name, params)
    }
    // A prototype sitting in a comma-separated declarator list ('int f(int a), g(int), a;').
    // items = [name, [params...]]. The base type belongs to the whole declaration and is
    // already consumed by BaseTy, so only the parameter types are noted here; the return
    // type stays the model's default int, which is all such a list can declare anyway.
    function noteProtoItem(items) {
        noteParamCts(items[0], items[1])
    }
    // The C type a 'struct S' / 'union U' / 'struct S *' return type names.
    function makeRetCt(items) { return ptrTo(starsOf(items[1]), ctStruct(items[0])) }
    // A prototype only fixes the calling convention (the hidden sret parameter).
    function registerSProto(items) {
        if (items[0].ret.k == "struct") { structRet[items[1]] = items[0].ret }
        noteRetAll(items[1], items[0].ret)
    }
    // items = [{ret}, name, [params...], bodyThunk].
    function buildSFunction(items) {
        registerSProto(items)
        var rct = items[0].ret
        emitFunctionBody(items[1], items[2], items[3], rct.k == "struct" ? rct : undefined)
    }
