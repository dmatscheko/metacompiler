            | ( "0x" | "0X" ) :whitespace() "." HexDig { HexDig } BinExp [ FltSfx ] :whitespace(Whitespace)
            | "0"..."9" :whitespace() { "0"..."9" } ( "." { "0"..."9" } [ DecExp ] | DecExp ) [ FltSfx ] :whitespace(Whitespace)
            | "." :whitespace() "0"..."9" { "0"..."9" } [ DecExp ] [ FltSfx ] :whitespace(Whitespace) ;
DecExp      = ( "e" | "E" ) [ "+" | "-" ] "0"..."9" { "0"..."9" } ;
BinExp      = ( "p" | "P" ) [ "+" | "-" ] "0"..."9" { "0"..."9" } ;
