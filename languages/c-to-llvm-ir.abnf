        if (ct != undefined && ct.k == "int" && !llvm.types.IsPointer(v.Type())) {
            // The value is matched to the cell width as well (an i32 into a long element).
            var lt = ctLTy(ct)
            if (!llvm.types.Equal(v.Type(), lt)) {
