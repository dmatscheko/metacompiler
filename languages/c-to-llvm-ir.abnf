    }
    // ----- Top level -----

    var unnamedSeq = 0
    // Param items = [{sname}?, "*"?, name]: int, int*, or a struct pointer.
    // One parameter descriptor. An ARRAY parameter is adjusted to a pointer to its
    // element type (C11 6.7.6.3p7), and a struct or union VALUE parameter travels as
    // the address of the caller's object, which the callee copies.
    function paramOf(name, ct) {
        if (ct.k == "arr") { ct = {k: "ptr", p: ct.e} }
        var pname = name
        if (pname == undefined || pname == "") { unnamedSeq = unnamedSeq + 1; pname = "$arg" + unnamedSeq }
        return {name: pname, ptr: ct.k == "ptr" || isAggCt(ct), ct: ct}
    }
    // Param / ParamAbs items = [{bty}|{sname}, {ptr}?, name?, {dims}?].
    function makeParam(items) {
        var i = 0
        var base = ctInt
        if (items[i] != undefined && items[i].sname != undefined) { base = ctStruct(items[i].sname); i++ }
        else if (items[i] != undefined && items[i].bty != undefined) { base = items[i].bty; i++ }
        for (var k = i; k < items.length; k++) {
            if (items[k] != undefined && items[k].fnabs == true) return paramOf("", ctFn)
        }
        var d = makeDeclr(items.slice(i), "plain")
        return paramOf(d.name, declCt(base, d))
    }
    // Every global starts as a zeroed slot, and its initializer is emitted into the
    // module's global-initializer function (see buildGlobalInit): the module format
    // has no way to spell an aggregate constant - llvm.constant has no NewArray - and
    // the entry point is wrapped so the function runs before anything else does.
    var globalInits = []
    function newGlobal(name, ct) {
        var lty = ctLTy(ct)
        var g = m.NewGlobalDef(name, ct.k == "ptr" ? llvm.constant.NewNull(i32p)
                                                   : llvm.constant.NewZeroInitializer(lty))
        declVar(name, {val: g, arr: ct.k == "arr", ty: lty,
                       load: ct.k == "ptr" ? i32p : lty, ct: ct})
        return g
    }
    // items = [{bty}, {dcl}...].
    function defineGlobals(items) {
        var base = items[0].bty
        for (var i = 1; i < items.length; i++) {
            var d = items[i].dcl
            var ct = declCt(base, d)
            var g = newGlobal(d.name, ct)
            if (d.init != undefined) globalInits.push({g: g, ct: ct, init: d.init})
        }
    }
    // The module's global-initializer function: every global's initializer, in
    // declaration order, exactly as C requires.
    function buildGlobalInit() {
        if (globalInits.length == 0) return undefined
        var f = m.NewFunc("__mec_ginit", i32, [])
        curF = f
        var b = f.NewBlock("entry")
        for (var i = 0; i < globalInits.length; i++) {
            var gi = globalInits[i]
            b = initInto(b, gi.ct, gi.init, gi.g)
        }
        b.NewRet(zero)
        return f
    }
    // The entry point becomes a wrapper that runs the global initializers first and
    // then the user's function under its original name, so both llvm.Run and a
    // clang-linked executable (-exe, which enters at main) see the initialized data.
    function wrapEntry(name, ginit) {
        var uf = funcs[name]
        uf.SetName("__mec_body_" + name)
        var w = m.NewFunc(name, i32, [])
        var wb = w.NewBlock("entry")
        wb.NewCall(ginit, [])
        var args = []
        for (var i = 0; i < uf.Params.length; i++) {
            args.push(llvm.types.IsPointer(uf.Params[i].Type()) ? llvm.constant.NewNull(i32p) : zero)
        }
        wb.NewRet(wb.NewCall(uf, args))
        funcs[name] = w
    }

    function buildFunction() {
        var bodyT = pop()
        var params = pop()
        var name = pop()
        var star = pop()
        var rt = (typeof star == "string") ? pop() : star
        noteRetCt(name, (typeof star == "string") ? undefined : rt.ret)
        noteRetAll(name, (typeof star == "string") ? ptrTo(starCount(star), rt.ret) : rt.ret)
        emitFunctionBody(name, params, bodyT, undefined)
    }
    // A prototype only records the shape: the name and the parameters are dropped, the
    // return type is remembered so a call that PRECEDES the definition already emits
    // the right return width.
    function registerProto() {
        var params = pop()
        var name = pop()
        var star = pop()
        var rt = (typeof star == "string") ? pop() : star
        noteRetCt(name, (typeof star == "string") ? undefined : rt.ret)
        noteRetAll(name, (typeof star == "string") ? ptrTo(starCount(star), rt.ret) : rt.ret)
        noteParamCts(name, params)
    }
    // A prototype sitting in a comma-separated declarator list ('int f(int a), g(int), a;').
    // items = [name, [params...]]. The base type belongs to the whole declaration and is
    // already consumed by BaseTy, so only the parameter types are noted here; the return
    // type stays the model's default int, which is all such a list can declare anyway.
    function noteProtoItem(items) {
        noteParamCts(items[0], items[1])
    }
    // The C type a 'struct S' / 'union U' / 'struct S *' return type names.
    function makeRetCt(items) { return ptrTo(starsOf(items[1]), ctStruct(items[0])) }
    // A prototype only fixes the calling convention (the hidden sret parameter).
    function registerSProto(items) {
        if (items[0].ret.k == "struct") { structRet[items[1]] = items[0].ret }
        noteRetAll(items[1], items[0].ret)
    }
    // items = [{ret}, name, [params...], bodyThunk].
    function buildSFunction(items) {
        registerSProto(items)
        var rct = items[0].ret
        emitFunctionBody(items[1], items[2], items[3], rct.k == "struct" ? rct : undefined)
    }
    // The current function's by-value struct destination, read by makeReturn.
    var curSret = undefined
    var curRetCt = undefined
    // The C type the function currently being emitted returns (int unless it was
    // declared to return a 64-bit type, in which case the LLVM return type is i64).
    var curFnRetCt = ctInt
    // Whether the function currently being emitted returns a POINTER (LLVM i32*).
    var curFnRetPtr = false
    // The DECLARED return type when it is narrower than an int - a char, a short or a
    // _Bool. It cannot be curFnRetCt: that one drives the module SIGNATURE (and the
    // fall-off-the-end constant), which stays i32 for every narrow type because that
    // is what the call sites build. But C11 6.8.6.4p3 converts the returned value to
    // the declared type exactly as an assignment does, so `unsigned char f(int n)
    // { return n; }` called with 300 answers 44 - which cc and c-interpreter.abnf both
    // said and the compiled half did not, since coerce was handed ctInt.
    var curFnRetNarrow = undefined
    function emitFunctionBody(name, params, bodyT, sretCt) {
        if (sretCt != undefined) { structRet[name] = sretCt }
        userFuncs[name] = params.length
        noteParamCts(name, params)
        var f = getFunc(name, params)
        curF = f
        curFnRetCt = hasOwn(funcRetCt, name) ? funcRetCt[name] : ctInt
        curFnRetNarrow = undefined
        if (hasOwn(funcRetAll, name)) {
            var nrc = funcRetAll[name]
            if (nrc != undefined && nrc.k == "int" && nrc.w < 4) { curFnRetNarrow = nrc }
        }
        curFnRetPtr = sretCt == undefined && retIsPtr(name)
        labelBlocks = {}   // Labels are function scoped.
        var b = f.NewBlock("entry")
        scopes.push({})
        var off = 0
        if (sretCt != undefined) { curSret = f.Params[0]; off = 1 } else { curSret = undefined }
        curRetCt = sretCt
        for (var i = 0; i < params.length; i++) {
            var pct = params[i].ct
            if (isAggCt(pct)) {
                // A struct parameter is passed BY VALUE: the argument is the address of
                // the caller's object, and the callee gets its own copy.
                var a = b.NewAlloca(ctLTy(pct))
                b = emitCopy(b, pct, a, f.Params[i + off])
                declVar(params[i].name, {val: a, arr: false, ct: pct})
                continue
            }
            // The SIGNATURE passes a narrow integer promoted (i32), because that is
            // how every call site builds it, but the parameter's own SLOT is a cell of
            // the declared width - an i8 for a char. Anything else is inconsistent:
            // a store through the place path truncates to the cell, so an i32 slot
            // would keep three stale bytes that the next plain read would see.
            // A double parameter is an i64 - its bit pattern - which is what getFunc
            // puts in the SIGNATURE. Saying i32 here instead left the prologue storing
            // an i64 into an i32 slot, and no function with a double parameter would
            // build at all.
            var pty = params[i].ptr ? i32p
                      : ((pct != undefined && (pct.k == "flt" || (pct.k == "int" && pct.w >= 8)))
                         ? llvm.types.I64 : i32)
            var cty = (!params[i].ptr && pct != undefined && pct.k == "int" && pct.w < 4)
                      ? ctLTy(pct) : pty
            var ptr = b.NewAlloca(cty)
            // Narrowing here is also the conversion C11 6.5.2.2p7 requires of an
            // argument to a declared parameter type: f(300) with 'char c' sees 44.
            // A _Bool parameter is not TRUNCATED but tested against zero, so
            // f(3) with '_Bool b' sees 1 (C11 6.3.1.2, applied by 6.5.2.2p7).
            var pv = f.Params[i + off]
            if (pct != undefined && pct.bool == true) { pv = emitConv(b, pct, pv, pct) }
            b.NewStore(llvm.types.Equal(cty, pty) ? pv : b.NewTrunc(pv, cty), ptr)
            declVar(params[i].name, {val: ptr, arr: false, ty: cty, load: cty, ct: pct})
        }
        b = bodyT(b)
        // The implicit fall-off-the-end return. It has to match the RESULT TYPE, so a
        // pointer-returning function falls off into a null pointer, not into 'ret i32 0'.
        b.NewRet(curFnRetPtr ? llvm.constant.NewNull(i32p) : kct(curFnRetCt, 0))
        scopes.pop()
        curSret = undefined
        curRetCt = undefined
        curFnRetCt = ctInt
        curFnRetNarrow = undefined
        curFnRetPtr = false
    }

    // ----- typedef -----
    // name -> the C type it abbreviates. Filled by defineTypedef as the file is
    // walked, read by makeTdDecl when a later declaration uses the name.
    var typedefs = {}
    // The names the standard headers of core.stdlibImports introduce. Those headers
    // are no-ops here (the runtime provides what they declare), so the typedefs they
    // would define are predefined - a file that includes stdint.h and writes uint16_t
    // means the same thing whether or not the header text was read.
    function stdTypedefs() {
        typedefs["size_t"] = ctI(8, true)
        typedefs["ssize_t"] = ctI(8, false)
        typedefs["ptrdiff_t"] = ctI(8, false)
        typedefs["intptr_t"] = ctI(8, false)
        typedefs["uintptr_t"] = ctI(8, true)
        typedefs["intmax_t"] = ctI(8, false)
        typedefs["uintmax_t"] = ctI(8, true)
        typedefs["wchar_t"] = ctI(4, false)
        typedefs["wint_t"] = ctI(4, false)
        typedefs["char16_t"] = ctI(2, true)
        typedefs["char32_t"] = ctI(4, true)
        typedefs["int8_t"] = ctI(1, false)
        typedefs["uint8_t"] = ctI(1, true)
        typedefs["int16_t"] = ctI(2, false)
        typedefs["uint16_t"] = ctI(2, true)
        typedefs["int32_t"] = ctI(4, false)
        typedefs["uint32_t"] = ctI(4, true)
        typedefs["int64_t"] = ctI(8, false)
        typedefs["uint64_t"] = ctI(8, true)
        typedefs["int_fast8_t"] = ctI(1, false)
        typedefs["int_least8_t"] = ctI(1, false)
    }
    stdTypedefs()
    function typedefOf(name) {
        if (!hasOwn(typedefs, name)) fail("type not defined: " + name)
        return typedefs[name]
    }
    // 'typedef struct { ... } Box;': the tag is defined here and its key returned.
    function tdTagDef(items, isUnion) {
        var key = anonTagName()
        var tagItems = []
        for (var i = 0; i < items.length; i++) {
            if (items[i].tag != undefined) { key = isUnion ? uKey(items[i].tag) : items[i].tag }
            else { tagItems.push(items[i]) }
        }
        var all = [key]
        for (var j = 0; j < tagItems.length; j++) all.push(tagItems[j])
        defineTag(all, isUnion)
        return ctStruct(key)
    }
    // items = [{tb}|{tref}, {dcl}...].
    function defineTypedef(items) {
        var b = items[0]
        var base = (b.tref != undefined) ? typedefOf(b.tref) : b.tb
        for (var i = 1; i < items.length; i++) {
            var d = items[i].dcl
            typedefs[d.name] = declCt(base, d)
        }
    }
    // items = [{tname}, {dcl}...] -> the [{bty}, {dcl}...] shape every declaration
    // maker reads, with the typedef name resolved to the type it abbreviates.
    function tdBase(items) {
        var all = [{bty: typedefOf(items[0].tname)}]
        for (var i = 1; i < items.length; i++) all.push(items[i])
        return all
    }
    // A parameter of typedef type: [{tname}, {ptr}?, name, {dims}?].
    function makeTdParam(items) {
        var d = makeDeclr(items.slice(1), "plain")
        return paramOf(d.name, declCt(typedefOf(items[0].tname), d))
    }
    // items = [{tname}, name, [params...], bodyThunk]: a function whose return type
    // is a typedef name. The value returned is one i32 like every other, so only the
    // declarator syntax differs from an ordinary definition.
    function buildTdFunc(items) { emitFunctionBody(items[1], items[2], items[3], undefined) }

    // System headers the runtime already provides; #include of anything else is an
    // external library we cannot resolve (see resolveImport in lib/compile-core.js).
    core.stdlibImports = ["stdio.h", "stdlib.h", "string.h", "math.h", "ctype.h", "stdbool.h", "stdint.h", "stddef.h", "limits.h", "assert.h", "stdarg.h"]

    // Project-file includes: #include "geomlib.h" loads geomlib.h (searched under the
    // program's directory and the -i roots) and compiles it, so its functions emit into
    // this module like the main file's (header-only in this subset). System <...> headers
    // in core.stdlibImports stay no-ops. A file is included once; repeats and cycles no-op.
    var importedFiles = {}
    core.importFile = function(path, pos) {
        var rel = path
        if (rel.slice(0, 2) == "./") { rel = rel.slice(2) }
        var file = c.findImport(rel)
        if (file == "") { return false }
        if (importedFiles["$" + file] == true) { return true }
        importedFiles["$" + file] = true
        var text = c.readFile(file)
        var asg = c.parse(c.agrammar, text, null, file)
        c.pushSource(file, text)
        c.compile(asg)
        c.popSource()
        return true
    }

    c.compile(c.asg)
    // Every address-taken function is known now, so the indirect-call trampolines
    // can be given their dispatch bodies.
    finishTrampolines()
    var ginitF = buildGlobalInit()

    // The entry point defaults to main() but the -main flag (c.mainName) can name any
    // other defined function.
    var entry = c.mainName
    if (entry == undefined || entry == "") { entry = "main" }
    if (mainIsSnippet(entry)) {
        // A snippet (e.g. return greet(3, 4);) is emitted as a synthetic entry function
        // that runs in a fresh frame with the file's functions available (as buildFunction).
        var frag = c.parseFrom(c.agrammar, entry, "Statement")
        var thunk = c.compile(frag).stack[0]
        var sf = m.NewFunc("__mecmain__", i32, [])
        curF = sf
        var sb = sf.NewBlock("entry")
        if (ginitF != undefined) { sb.NewCall(ginitF, []) }
        scopes.push({})
        sb = thunk(sb)
        sb.NewRet(zero)
        scopes.pop()
        println(m)
        var sres = llvm.Run(m, "__mecmain__")
        print(sres.Out)
        println("c compiler: -main snippet returned " + sres.Ret)
        exit(sres.Ret)
    }
    if (funcs[entry] == undefined || funcs[entry].Blocks.length == 0) {
        println("Error: C programs need a " + entry + "() function.")
        exit(1)
    }
    if (ginitF != undefined) { wrapEntry(entry, ginitF) }

    // With -exe PATH, link the module into a native executable (clang) instead of running
    // it. main() returns int and output goes through putchar, so the binary prints and
    // reports main()'s value as its process exit code.
    if (c.exePath != undefined && c.exePath != "") {
        var buildErr = llvm.BuildExecutable(m, c.exePath)
        if (buildErr != "") { println(buildErr); exit(1) }
        println("c compiler: wrote executable " + c.exePath)
        exit(0)
    }

    println(m)

    var res = llvm.Run(m, entry)
    print(res.Out)
    println("c compiler: " + entry + "() returned " + res.Ret)
    exit(res.Ret)

~~) ;
