            // that f(0) and f(NULL) still typecheck once the signature says i32*.
            // ptrOperand sign-extends an integer to the pointer's 64 bits first.
            if (pptrs != undefined && i < pptrs.length && pptrs[i]) { into.push(ptrOperand(b, r.v)); continue }
            var pct = (pcts != undefined && i < pcts.length) ? pcts[i] : undefined
