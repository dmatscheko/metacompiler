    // items = [{ext}?, {tname}, {ext}?, {dcl}...] -> the [{bty, ext}, {dcl}...] shape every
    // declaration maker reads, with the typedef name resolved to the type it abbreviates.
    function tdBase(items) {
        var all = [{bty: ctInt, ext: false}]
        for (var i = 0; i < items.length; i++) {
            if (items[i].tname != undefined) { all[0].bty = typedefOf(items[i].tname) }
            else if (items[i].ext == true) { all[0].ext = true }
            else { all.push(items[i]) }
        }
        return all
    }
