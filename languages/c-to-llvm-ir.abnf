    // ----- switch: case labels are BASIC BLOCKS -----
    // A case label may sit anywhere inside the switch body - in a nested block, or
    // halfway down a loop body, which is what makes Duff's device legal C - so the body
    // is emitted as ORDINARY code and each case label simply starts a new block that the
    // code before it falls into. Fallthrough is then the fallthrough the emitter already
    // does, and the dispatch is a chain of compares that BRANCHES INTO the body.
    //
    // The dispatch has to be appended to the pre-switch block AFTER the body is emitted,
    // because only then is the set of case blocks known. That is exactly what the
    // instruction order allows: the scrutinee is computed in that block, the compares
    // follow it there, and every case block is dominated by it.
    var curSwCases = undefined
    var curSwDefault = undefined
    function makeCase(items) {
        var vT = items[0]
        var t = items[1]
        return function(b) {
            if (curSwCases == undefined) fail("'case' outside a switch")
            var cb = curF.NewBlock("")
            b.NewBr(cb)                     // the code before the label falls into it
            curSwCases.push({v: vT, blk: cb})
            return t(cb)
        }
