    // The module's global-initializer function: every global's initializer, in
    // declaration order, exactly as C requires.
    function buildGlobalInit() {
        if (globalInits.length == 0) return undefined
        var f = m.NewFunc("__mec_ginit", i32, [])
        curF = f
        var b = f.NewBlock("entry")
        for (var i = 0; i < globalInits.length; i++) {
            var gi = globalInits[i]
            b = initInto(b, gi.ct, gi.init, gi.g)
