// assignment - without the lookaheads it matches their first character and the rest
// of the sequence then fails somewhere else entirely.
AssignOp    = "**=" | "<<=" | ">>=" | "??=" | "+=" | "-=" | "*=" | "/=" | "%=" | ".="
