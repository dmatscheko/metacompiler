    function phpLibLoad(key) {
        if (key == "" || phpLib.fns[key] === undefined || phpLibDone[key] === true) { return }
        phpLibDone[key] = true
        var base = phpLib.bases[key]
        if (base !== undefined) { phpLibLoad(base) }
        var text = phpLibText(phpLib, key, phpLibBase)
        phpLibBase = false
        var asg = c.parse(c.agrammar, text, null, "php-stdlib.php")
        c.pushSource("php-stdlib.php", text)
        importDepth = importDepth + 1
        var outerDefs = topDefs
        var outerClasses = topClasses
        var outerHoisted = hoisted
        var outerJumps = jw
        var outerClass = cloClass
        topDefs = []
        topClasses = []
        hoisted = {}
        jw = jumpWalkNew()
        c.compile(asg)
        topDefs = outerDefs
        topClasses = outerClasses
        hoisted = outerHoisted
        jw = outerJumps
        cloClass = outerClass
        importDepth = importDepth - 1
        c.popSource()
