    // it emits anything (to create its block), and a record survives the tag stack
    // where a property hung on a function value would not.
    function makeLabelStmt(name) {
        jumpLabel(name)
        return {lblstmt: name}
    }
    // ----- jumps PHP checks at compile time -----
    // A break/continue with no loop or switch around it, one naming more levels
    // than there are, one that would leave a finally body, and a goto that leaves
    // or enters a finally body are compile errors. The walk keeps, per file: every
    // goto and label with the ids of the finally bodies around it, and a frame per
    // function and per finally body counting the loops open in it. Twin of jw in
    // php-interpreter.abnf.
    function jumpWalkNew() {
        return {gotos: [], labels: [], gfins: [], lfins: [], fins: [], finId: 0,
                frames: [{fin: false, loops: 0, g: 0, l: 0}]}
    }
    var jw = jumpWalkNew()
    function jumpFrame(fin) {
        jw.frames.push({fin: fin, loops: 0, g: jw.gotos.length, l: jw.labels.length})
    }
    function loopEnter() {
        var fr = jw.frames[jw.frames.length - 1]
        fr.loops = fr.loops + 1
    }
    function loopLeave() {
        var fr = jw.frames[jw.frames.length - 1]
        fr.loops = fr.loops - 1
    }
    function fnEnter() { jumpFrame(false) }
    function fnLeave() { jumpResolve(jw.frames.pop()) }
    function finEnter() {
        jw.finId = jw.finId + 1
        jw.fins.push(jw.finId)
        jumpFrame(true)
    }
    // Every goto inside the finally body must find its label inside it too.
    function finLeave(body) {
        var f = jw.frames.pop()
        jw.fins.pop()
        for (var gi = f.g; gi < jw.gotos.length; gi++) {
            if (jumpLabelAt(jw.gotos[gi], f.l) < 0) { fail("jump out of a finally block is disallowed") }
        }
        return body
    }
    function jumpLabelAt(name, from) {
        for (var li = from; li < jw.labels.length; li++) {
            if (jw.labels[li] == name) { return li }
        }
        return 0 - 1
    }
    function jumpGoto(name) {
        jw.gotos.push(name)
        jw.gfins.push(jw.fins.slice(0))
    }
    function jumpLabel(name) {
        jw.labels.push(name)
        jw.lfins.push(jw.fins.slice(0))
    }
    // The end of a function (or of a file's top level): each goto resolves among
    // its labels, and one whose label stands in a finally body the goto is not in
    // is refused. The function's log is dropped after.
    function jumpResolve(f) {
        for (var gi = f.g; gi < jw.gotos.length; gi++) {
            var li = jumpLabelAt(jw.gotos[gi], f.l)
            if (li < 0) { continue }
            var lf = jw.lfins[li]
            for (var k = 0; k < lf.length; k++) {
                if (jw.gfins[gi].indexOf(lf[k]) < 0) { fail("jump into a finally block is disallowed") }
            }
        }
        while (jw.gotos.length > f.g) { jw.gotos.pop(); jw.gfins.pop() }
        while (jw.labels.length > f.l) { jw.labels.pop(); jw.lfins.pop() }
    }
    // break N / continue N, kw naming which: the loops open up to the enclosing
    // function must number at least n, and the n-th must not lie outside a finally
    // body the jump stands in.
    function jumpCheck(kw, n) {
        var total = 0
        var left = n
        var outOfFin = false
        for (var i = jw.frames.length - 1; i >= 0; i--) {
            var fr = jw.frames[i]
            total = total + fr.loops
            if (left > 0 && left > fr.loops && fr.fin) { outOfFin = true }
            left = left - fr.loops
            if (!fr.fin) { break }
        }
        if (total == 0) { fail("'" + kw + "' not in the 'loop' or 'switch' context") }
        if (n > total) { fail("Cannot '" + kw + "' " + n + " level" + (n == 1 ? "" : "s")) }
        if (outOfFin) { fail("jump out of a finally block is disallowed") }
    }
    function jumpLevel(items) {
        for (var i = 0; i < items.length; i++) {
            if (items[i] != undefined && items[i].lvl != undefined) { return items[i].lvl }
        }
        return 1
    }
