        var cases = items[1].cases
        return function(b) {
            var rs = subj(b)
            b = rs.b
            var sv = rs.v
            var exitB = curF.NewBlock("")
            var bodyBs = []
            var dflt = -1
            for (var i = 0; i < cases.length; i++) {
                bodyBs.push(curF.NewBlock(""))
                if (cases[i].isDflt) { dflt = i }
