    // ----- member chains: ->method(args), ->field, [index], (call), ::static -----
    // One chain suffix, with the nullsafe flag its arrow carried.
    function sfxNs(items) {
        for (var i = 0; i < items.length; i++) {
            if (items[i] != undefined && items[i].ns != undefined) { return true }
        }
        return false
    }
    function sfxRest(items) {
        var out = []
        for (var i = 0; i < items.length; i++) {
            var it = items[i]
            if (it != undefined && (it.ns != undefined || it.mname != undefined
                                    || it.fname != undefined || it.dynname != undefined)) { continue }
            out.push(it)
        }
        return out
