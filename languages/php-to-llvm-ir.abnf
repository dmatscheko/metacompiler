    // ----- calls, defs, classes -----
    function hasBuiltin(name) {
        return name == "count" || name == "strlen"
            || name == "array_push" || name == "array_values" || name == "intdiv" || name == "abs"
            || name == "var_dump" || name == "gettype" || name == "get_debug_type" || name == "get_class"
            || name == "method_exists" || name == "property_exists" || name == "class_exists" || name == "interface_exists"
            || name == "function_exists"
            || name == "is_a" || name == "is_subclass_of" || name == "get_parent_class"
            || name == "define" || name == "defined" || name == "constant" || name == "error_reporting"
            || phpIsKind(name) != "" || phpNativeExt(name) != "" || name == "strtolower" || name == "strtoupper"
            || name == "__mec_callable" || name == "__mec_ifaces" || name == "realpath"
