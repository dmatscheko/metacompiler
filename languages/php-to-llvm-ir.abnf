            if (items[i] != undefined && items[i].lblstmt != undefined) { labels.push(items[i].lblstmt) }
        }
        if (labels.length == 0) {
            return function(b) {
                for (var j = 0; j < items.length; j++) { b = items[j](b) }
                return b
            }
        }
        return function(b) {
            for (var k = 0; k < labels.length; k++) {
                labelBlocks["$" + labels[k]] = curF.NewBlock("")
            }
            for (var q = 0; q < items.length; q++) {
                var it = items[q]
                if (it != undefined && it.lblstmt != undefined) {
                    var lb = labelBlocks["$" + it.lblstmt]
                    b.NewBr(lb)
                    b = lb
