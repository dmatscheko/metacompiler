// in globals, so the scope-chain snapshot makeTry restores covers them and an
// exception can never leave them pointing at the wrong class.
StaticExpr  <~~ push(makeStaticExpr(takeAll())) ~~>
            = StaticBaseRef "::" StaticMember [ StaticArgs ] ;
StaticBaseRef <~~ push({sbase: stripWs(up.in)}) ~~>
            = ( "static" KwEnd | QName ) ;
StaticMember <~~ push({smem: up.in}) ~~>
            = MethodName | DollarName ;
StaticArgs  <~~ push({sargs: takeAll()}) ~~>
            = "(" [ ArgList ] ")" ;

// A closure: function($a) use ($b, $c) { ... } (optionally 'static'). The use list is
// captured lexically (this subset captures the whole defining scope).
ClosureExpr <~~ push(makeClosure(takeAll())) ~~>
