                return {b: pa.b, v: callExt(pa.b, "js_phparent", [vs[0], pa.v])}
            }
            // With no argument, the class scope of the caller (deprecated since 8.3).
            var selfV = scopeProbe(b, emitStr(b, frameClsName("self")), hNull)
            var inB = curF.NewBlock("")
            var outB = curF.NewBlock("")
            b.NewCondBr(b.NewICmp(llvm.enum.IPredEQ, selfV, hNull), outB, inB)
            var parV = callExt(inB, "js_phparent", [selfV, hNull])
            inB.NewBr(outB)
