    // ----- traits ---------------------------------------------------------------
    // A trait is a compile-time member list. `use T;` copies those members into the
    // using class unless the class declares the same name itself, which is exactly
    // PHP's precedence (own > trait > inherited).
    var traitBodies = {}
    function makeTraitDecl(items) {
        var name = items[0]
        for (var i = 1; i < items.length; i++) {
            if (items[i] != undefined && items[i].method != undefined) { noteMagic(items[i].method.name) }
        }
        traitBodies["$" + name] = items.slice(1)
        lastClassDecl = {name: name, ext: "", plain: true}
        return function(b) { return b }
    }
    function traitRefParts(t) {
        for (var i = 0; i + 1 < t.length; i++) {
            if (t.charAt(i) == ":" && t.charAt(i + 1) == ":") {
                return {trait: t.substring(0, i), member: t.substring(i + 2)}
            }
        }
        return {trait: "", member: t}
    }
    function makeInsteadof(items) {
        var p = traitRefParts(items[0].tref)
        var losers = []
        for (var i = 1; i < items.length; i++) {
            if (items[i].impl != undefined) { losers.push(lastSeg(stripWs(items[i].impl))) }
        }
        return {excl: losers, member: p.member}
    }
    // 'm as protected' with no new name only changes the visibility of m; 'm as
    // private n' adds n with that visibility.
    function makeTraitAs(items) {
        var p = traitRefParts(items[0].tref)
        var alias = ""
        var tvis = anytype
        tvis = null
        for (var i = 1; i < items.length; i++) {
            if (items[i].alias != undefined) { alias = items[i].alias }
            if (items[i].tvis != undefined) { tvis = phVisWord(items[i].tvis) }
        }
        if (alias == "" && tvis == null) { return {aliasnop: true} }
        if (tvis != null && tvis != "") { noteMVis(alias == "" ? p.member : alias) }
        if (alias == "") { return {visFrom: p, aliasVis: tvis} }
        return {aliasFrom: p, aliasTo: alias, aliasVis: tvis}
    }
    function makeUseTrait(items) {
        var names = []
        var rules = []
        for (var i = 0; i < items.length; i++) {
            if (items[i] == undefined) { continue }
            if (items[i].impl != undefined) { names.push(lastSeg(stripWs(items[i].impl))) }
            else { rules.push(items[i]) }
        }
        return {usetrait: names, traitrules: rules}
    }
    // The members a class gets from its traits, with the conflict rules applied.
    // `have` is the set of names the class declares itself; a trait member never
    // overrides one of those.
    function traitMembers(uses, have) {
        var out = {methods: [], props: [], statics: [], consts: []}
        for (var u = 0; u < uses.length; u++) {
            var names = uses[u].usetrait
            var rules = uses[u].traitrules
            for (var t = 0; t < names.length; t++) {
                var body = traitBodies["$" + names[t]]
                if (body == undefined) { fail("unknown trait " + names[t]) }
                // A trait that uses traits brings their members along, less the
                // methods it declares itself, which win.
                var ownNames = []
                for (var oi = 0; oi < have.length; oi++) { ownNames.push(have[oi]) }
                for (var on = 0; on < body.length; on++) {
                    if (body[on] != undefined && body[on].method != undefined) { ownNames.push(body[on].method.name) }
                }
                for (var ui = 0; ui < body.length; ui++) {
                    if (body[ui] == undefined || body[ui].usetrait == undefined) { continue }
                    var nested = traitMembers([body[ui]], ownNames)
                    for (var nm = 0; nm < nested.methods.length; nm++) {
                        var nmn = nested.methods[nm].name
                        if (traitExcluded(rules, names[t], nmn) || hasMethod(out.methods, nmn)) { continue }
                        out.methods.push(nested.methods[nm])
                    }
                    for (var np = 0; np < nested.props.length; np++) { out.props.push(nested.props[np]) }
                    for (var ns = 0; ns < nested.statics.length; ns++) { out.statics.push(nested.statics[ns]) }
                    for (var nc = 0; nc < nested.consts.length; nc++) { out.consts.push(nested.consts[nc]) }
                }
                for (var i = 0; i < body.length; i++) {
                    var it = body[i]
                    if (it == undefined) { continue }
                    if (it.method != undefined) {
                        var mn = it.method.name
                        if (traitExcluded(rules, names[t], mn)) { continue }
                        if (hasOwnName(have, mn) || hasMethod(out.methods, mn)) { continue }
                        out.methods.push(it.method)
                    } else if (it.propdecl != undefined && it.propdecl != null) {
                        if (it.propdecl.isStatic === true) { out.statics.push(it.propdecl) }
                        else { out.props.push(it.propdecl) }
                    } else if (it.cconsts != undefined) {
                        for (var q = 0; q < it.cconsts.length; q++) { out.consts.push(it.cconsts[q]) }
                    }
                }
            }
            // Aliases are added after the copy, so 'T::m as alias' can name a member
            // that an insteadof rule kept out of the class under its own name.
            for (var r = 0; r < rules.length; r++) {
                if (rules[r].aliasTo == undefined) { continue }
                var src = findTraitMethod(names, rules[r].aliasFrom)
                if (src == null) { fail("unknown trait method " + rules[r].aliasFrom.member) }
                out.methods.push({name: rules[r].aliasTo, params: src.params, byref: src.byref,
                                  rest: src.rest, body: src.body, st: src.st,
                                  vis: rules[r].aliasVis == null ? src.vis : rules[r].aliasVis})
            }
            // A visibility-only rule replaces the copied method with one of that
            // visibility (the trait's own record is shared, so it is not edited).
            for (var r2 = 0; r2 < rules.length; r2++) {
                if (rules[r2].visFrom == undefined) { continue }
                for (var k2 = 0; k2 < out.methods.length; k2++) {
                    var om = out.methods[k2]
                    if (phsCase(om.name, false) != phsCase(rules[r2].visFrom.member, false)) { continue }
                    out.methods[k2] = {name: om.name, params: om.params, byref: om.byref, rest: om.rest,
                                       pvis: om.pvis, body: om.body, vis: rules[r2].aliasVis, st: om.st}
                }
            }
        }
        return out
    }
    function traitExcluded(rules, trait, member) {
        for (var i = 0; i < rules.length; i++) {
            if (rules[i].excl == undefined || rules[i].member != member) { continue }
            for (var k = 0; k < rules[i].excl.length; k++) {
                if (rules[i].excl[k] == trait) { return true }
            }
        }
        return false
    }
    function findTraitMethod(names, from) {
        for (var t = 0; t < names.length; t++) {
            if (from.trait != "" && from.trait != names[t]) { continue }
            var body = traitBodies["$" + names[t]]
            if (body == undefined) { continue }
            for (var i = 0; i < body.length; i++) {
                if (body[i] != undefined && body[i].method != undefined && body[i].method.name == from.member) {
                    return body[i].method
                }
            }
        }
        return null
    }
    // Method names compare case-insensitively: a class's hello() keeps out a
    // trait's Hello().
    function hasMethod(list, nm) {
        var lc = phsCase(nm, false)
        for (var i = 0; i < list.length; i++) { if (phsCase(list[i].name, false) == lc) { return true } }
        return false
    }
    function hasOwnName(names, nm) {
        var lc = phsCase(nm, false)
        for (var i = 0; i < names.length; i++) { if (phsCase(names[i], false) == lc) { return true } }
        return false
    }
    function makeEnumCase(items) {
        var nm = ""
        var init = null
        for (var i = 0; i < items.length; i++) {
            if (items[i] != undefined && items[i].ecase != undefined) { nm = items[i].ecase }
            else { init = items[i] }
        }
        return {ecasename: nm, ecaseinit: init}
    }
    function makeEnumStmt(items) {
        var name = items[0]
        var cases = []
        var classItems = [name]
        for (var i = 1; i < items.length; i++) {
            if (items[i] != undefined && items[i].ecasename != undefined) { cases.push(items[i]) }
            else { classItems.push(items[i]) }
        }
        var clsStmt = makeClassStmt(classItems)
        var hasImpl = false
        for (var hi = 1; hi < classItems.length; hi++) {
            if (classItems[hi] != undefined && classItems[hi].impl != undefined) { hasImpl = true }
        }
        var backed = cases.length > 0 && cases[0].ecaseinit != null
        return function(b) {
            b = clsStmt(b)
            var clsV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, name)])
            // Every enum is a UnitEnum, a backed one a BackedEnum too: bare names, the
            // way the built-in exception classes list Throwable. Twin of
            // makeEnumStmt in php-interpreter.abnf.
            var ifV = hasImpl ? callExt(b, "js_get", [clsV, emitStr(b, "__ifaces")]) : callExt(b, "js_pharr", [])
            callExt(b, "js_phpush", [ifV, emitStr(b, "UnitEnum")])
            if (backed) { callExt(b, "js_phpush", [ifV, emitStr(b, "BackedEnum")]) }
            if (!hasImpl) { callExt(b, "js_set", [clsV, emitStr(b, "__ifaces"), ifV]) }
            var allV = callExt(b, "js_pharr", [])
            // A case's value may read self::.
            var outerSelf = bindDeclSelf(b, clsV)
            for (var k = 0; k < cases.length; k++) {
                var inst = callExt(b, "js_obj_new", [])
                callExt(b, "js_set", [inst, emitStr(b, "__class"), clsV])
                callExt(b, "js_phoid", [inst])
                callExt(b, "js_set", [inst, emitStr(b, "name"), emitStr(b, cases[k].ecasename)])
                if (cases[k].ecaseinit != null) {
                    var rv = cases[k].ecaseinit(b)
                    b = rv.b
                    callExt(b, "js_set", [inst, emitStr(b, "value"), rv.v])
                }
                callExt(b, "js_set", [clsV, emitStr(b, "k:" + cases[k].ecasename), inst])
                callExt(b, "js_phpush", [allV, inst])
            }
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, frameClsName("self")), outerSelf])
            callExt(b, "js_set", [clsV, emitStr(b, "__cases"), allV])
            // E::cases(): the declaration-order list, as a fresh array each call.
            var idx = emitFunc([], function(bb) {
                return retStmt(bb, callExt(bb, "js_phcopy",
                                           [callExt(bb, "js_get", [frameCls(bb, "self"), emitStr(bb, "__cases")])]))
            }, true, false, name)
            callExt(b, "js_set", [clsV, emitStr(b, "cases"),
                                  callExt(b, "js_closure", [handle(idx), curScopeV])])
            return b
        }
    }
    // The name an anonymous class shows: its parent's, else its first interface's,
    // else "class", then "@anonymous". Twin of anonClassName in
    // php-interpreter.abnf.
    function anonClassName(ext, ifaces) {
        var base = ext != null ? ext : (ifaces.length > 0 ? ifaces[0] : "class")
        if (base.charCodeAt(0) == 92) { base = base.substring(1) }
        return base + "@anonymous"
    }
    // The rest of its full name, which get_class and ::class answer and every
    // display stops before: a NUL byte, the file, ":" and the line of the class
    // keyword, then "$" and the site's ordinal in hex (zend_generate_anon_class_name;
    // PHP's ordinal also counts closures, so only its form is reproduced). Twin of
    // anonSuffix in php-interpreter.abnf.
    function anonSuffix(pos, n) {
        var hex = ""
        var v = n
        while (hex == "" || v > 0) {
            hex = "0123456789abcdef".charAt(v % 16) + hex
            v = (v - v % 16) / 16
        }
        return "\x00" + c.file + ":" + c.lineOf(pos) + "$" + hex
    }
    // A class declaring __toString implements Stringable without naming it, after
    // the interfaces it names (add_stringable_interface in zend_compile.c); one
    // using a trait's __toString does too (zend_do_bind_traits). Answers ifaces,
    // or a copy with "Stringable" appended. Twin of addStringable in php-interpreter.abnf.
    function addStringable(ifaces, methods) {
        var has = false
        for (var i = 0; i < methods.length; i++) {
            if (phsCase(methods[i].name, false) == "__tostring") { has = true }
        }
        if (!has) { return ifaces }
        var out = []
        for (var j = 0; j < ifaces.length; j++) {
            if (phsCase(lastSeg(ifaces[j]), false) == "stringable") { return ifaces }
            out.push(ifaces[j])
        }
        out.push("Stringable")
        return out
    }
    function makeClassStmt(items) {
        var name = items[0]
        srcClasses["$" + name] = true
        var anon = false
        var anonSfx = ""
        var extRaw = null
        var ifacesRaw = []
        var methods = []
        var props = []
        var statics = []
        var consts = []
        var ifaces = []
        var uses = []
        var hasCtor = false
        var ext = ""
        for (var i = 1; i < items.length; i++) {
            if (items[i].method != undefined) {
                methods.push(items[i].method)
                noteMethodSig(items[i].method)
                noteMagic(items[i].method.name)
                if (items[i].method.name == "__construct") {
                    hasCtor = true
                    // A promoted parameter declares its property where the
                    // constructor stands in the body: PHP's slot order is body order.
                    var pvs = items[i].method.pvis
                    for (var pq = 0; pq < pvs.length; pq++) {
                        props.push({name: pvs[pq].name, init: null, isStatic: false, hooks: [], vis: pvs[pq].vis})
                    }
                }
            }
            else if (items[i].ext != undefined) {
                ext = lastSeg(items[i].ext)
                extRaw = stripWs(items[i].ext)
            }
            else if (items[i].impl != undefined) {
                ifaces.push(noteIterIface(lastSeg(stripWs(items[i].impl))))
                ifacesRaw.push(stripWs(items[i].impl))
            }
            else if (items[i].anonShown != undefined) {
                anon = true
                anonSfx = items[i].anonShown
            }
            else if (items[i].cconsts != undefined) {
                var cs = items[i].cconsts
                for (var q = 0; q < cs.length; q++) { consts.push(cs[q]) }
            }
            else if (items[i].usetrait != undefined) { uses.push(items[i]) }
            else if (items[i].propdecl != undefined && items[i].propdecl != null) {
                if (items[i].propdecl.isStatic === true) { statics.push(items[i].propdecl) }
                else { props.push(items[i].propdecl) }
            }
        }
        // Trait members are copied in where the class does not declare the name
        // itself. The copy happens at WALK time, so the emitted class carries them
        // exactly as if they had been written out in the body.
        if (uses.length > 0) {
            var own = []
            for (var mn = 0; mn < methods.length; mn++) { own.push(methods[mn].name) }
            var tm = traitMembers(uses, own)
            for (var a = 0; a < tm.methods.length; a++) { methods.push(tm.methods[a]) }
            for (var c = 0; c < tm.props.length; c++) { props.push(tm.props[c]) }
            for (var d = 0; d < tm.statics.length; d++) { statics.push(tm.statics[d]) }
            for (var e = 0; e < tm.consts.length; e++) { consts.push(tm.consts[e]) }
        }
        ifaces = addStringable(ifaces, methods)
        noteNs(methods)
        // A root class with no constructor takes no arguments, so a named one raises.
        if (ext == "") { ctorSigs["$" + name] = noParams }
        for (var mi = 0; mi < methods.length; mi++) {
            if (methods[mi].name == "__construct") { ctorSigs["$" + name] = {params: methods[mi].params, byref: methods[mi].byref, rest: methods[mi].rest} }
        }
        var shown = anon ? anonClassName(extRaw, ifacesRaw) : name
        noteClassProps(name, ext, props)
        lastClassDecl = {name: name, ext: ext, plain: ifaces.length == 0 && uses.length == 0}
        return function(b) {
            var clsV = callExt(b, "js_obj_new", [])
            callExt(b, "js_set", [clsV, emitStr(b, "__isclass"), hTrue])
            callExt(b, "js_set", [clsV, emitStr(b, "__name"), emitStr(b, shown)])
            if (anon) { callExt(b, "js_set", [clsV, emitStr(b, "__anon"), emitStr(b, anonSfx)]) }
            // Single inheritance: the __super chain is what the runtime's method
            // dispatch (js_phmcall / memberCall) walks, so `extends E` is one property.
            if (ext != "") {
                callExt(b, "js_set", [clsV, emitStr(b, "__super"), classRefV(b, ext)])
            }
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, name), clsV])
            declClassAlias(b, name, clsV)
            // The implemented interfaces, by name: instanceof and a typed catch walk
            // them (js_phisa), which is all an interface means without a body model.
            b = emitIfaceList(b, clsV, ifaces)
            // Bind 'self' for the initializers below: a class constant may read
            // self::OTHER, and they are evaluated here, in declaration order.
            var outerSelf = bindDeclSelf(b, clsV)
            for (var c1 = 0; c1 < consts.length; c1++) { emitConstDecl(b, clsV, name, consts[c1]) }
            var svl = phStaticVisList(shown, statics)
            if (svl != ",") { callExt(b, "js_set", [clsV, emitStr(b, "__svis"), emitStr(b, svl)]) }
            // A typed static property records its type under "t:" and starts
            // uninitialised when it has no default (js_phsget / js_phsset).
            for (var s1 = 0; s1 < statics.length; s1++) {
                var styp = statics[s1].typ
                var isTyped = styp != undefined && styp != ""
                if (isTyped) { callExt(b, "js_set", [clsV, emitStr(b, "t:" + statics[s1].name), emitStr(b, styp)]) }
                callExt(b, "js_set", [clsV, emitStr(b, "s:" + statics[s1].name), isTyped && statics[s1].init == null ? hUndef : hNull])
            }
            if (consts.length > 0 || statics.length > 0) {
                var siIdx = emitFunc([], classInitBody(consts, statics), true, false, name)
                callExt(b, "js_set", [clsV, emitStr(b, "__sinit"), callExt(b, "js_closure", [handle(siIdx), curScopeV])])
            }
            b = emitInitProps(b, clsV, name, ext, props)
            for (var hp = 0; hp < props.length; hp++) {
                if (props[hp].hooks != undefined && props[hp].hooks.length > 0) {
                    b = emitHooks(b, clsV, name, props[hp])
                }
            }
            // The declared method names, lower-cased between commas: method_exists.
            var mlc = ","
            for (var ml = 0; ml < methods.length; ml++) { mlc = mlc + phsCase(methods[ml].name, false) + "," }
            callExt(b, "js_set", [clsV, emitStr(b, "__mlc"), emitStr(b, mlc)])
            var mvl = phMethodVisList(methods)
            if (mvl != ",") { callExt(b, "js_set", [clsV, emitStr(b, "__mvis"), emitStr(b, mvl)]) }
            var nsl = nsUsed ? phNonStaticList(methods) : ","
            if (nsl != ",") { callExt(b, "js_set", [clsV, emitStr(b, "__mns"), emitStr(b, nsl)]) }
            var stl = phStaticList(methods)
            if (stl != ",") { callExt(b, "js_set", [clsV, emitStr(b, "__mst"), emitStr(b, stl)]) }
            var pvl = phVisList(shown, props)
            if (pvl != ",") { callExt(b, "js_set", [clsV, emitStr(b, "__pvis"), emitStr(b, pvl)]) }
            for (var k = 0; k < methods.length; k++) {
                var idx = emitFunc(methods[k].params, methods[k].body, true, false, name, methods[k].st === true)
                // Stored under its declared name, its lower-cased name and every other
                // spelling an ancestor declared (setMethod in php-interpreter.abnf).
                callExt(b, "js_phmset", [clsV, emitStr(b, methods[k].name), withSig(b, closureV(b, idx, curScopeV), methods[k])])
            }
            if (!hasCtor && ext == "") {
                var emptyBody = function(bb) { return bb }
                var iidx = emitFunc([], emptyBody, true, false, name)
                callExt(b, "js_set", [clsV, emitStr(b, "__construct"),
                                      callExt(b, "js_closure", [handle(iidx), curScopeV])])
            }
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, frameClsName("self")), outerSelf])
            return b
        }
    }
    // A declaration binds 'self' to the class while its initializers run and
    // hands back the binding it shadowed (null outside every class), which it puts
    // back afterwards: code after the declaration is not in the class's scope.
    // A class constant is evaluated on first use, not where the class is declared:
    // `const A = self::B; const B = 1;` reads B, and a constant inherited from a parent
    // still reads `self::` as the parent. Its initializer becomes a method of the
    // declaring class (so self and parent bind there), stored under "k:" + name in a
    // {__lazyconst: closure} box that phpConstIn (abnf/jsrtphp.go) and phConstIn
    // (lib/php-rt.metajs) call once and replace with the value. Twin of constFind in
    // php-interpreter.abnf.
    function emitConstDecl(b, clsV, clsName, rec) {
        var cv = hNull
        if (rec.cinit != null) {
            var idx = emitFunc([], makeBody([makeReturn([rec.cinit])]), true, false, clsName)
            cv = callExt(b, "js_obj_new", [])
            callExt(b, "js_set", [cv, emitStr(b, "__lazyconst"), callExt(b, "js_closure", [handle(idx), curScopeV])])
        }
        callExt(b, "js_set", [clsV, emitStr(b, "k:" + rec.cname), cv])
    }
    // The body of a class's __sinit: its own constants read in declaration order as
    // outermost reads, then its static property defaults. js_phsinit runs it when
    // the class is first used (a static property access or `new`), parent first,
    // and drops it once it succeeds. Twin of classInit in php-interpreter.abnf.
    function classInitBody(consts, statics) {
        return function(b) {
            for (var c = 0; c < consts.length; c++) {
                callExt(b, "js_phconst", [frameCls(b, "self"), emitStr(b, consts[c].cname), emitStr(b, "self")])
            }
            for (var s = 0; s < statics.length; s++) {
                if (statics[s].init == null) { continue }
                var rs = statics[s].init(b)
                b = rs.b
                callExt(b, "js_set", [frameCls(b, "self"), emitStr(b, "s:" + statics[s].name), rs.v])
            }
            return b
        }
    }
    function bindDeclSelf(b, clsV) {
        var outer = scopeProbe(b, emitStr(b, frameClsName("self")), hNull)
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, frameClsName("self")), clsV])
        return outer
    }

    // ----- program entry & project-file imports -----
    // PHP has no importable builtins (count/strlen/... are always in scope), so every
    // include/require path is a project file. `require 'geomlib.php'` looks for geomlib.php
    // (a leading ./ dropped, a missing .php extension added) under the program's directory
    // and the -i roots (c.findImport). The file is parsed with this grammar and walked with
    // the same tags; its top-level thunks are stashed by buildMain (importDepth > 0) and
    // prepended to phpmain, so the included function / class declarations run before the
    // main file's code. A file is imported once; repeats and cycles are no-ops. The imported
    // names bind flat (global), like PHP require.
    core.stdlibImports = []
    var importedFiles = {}
    var importDepth = 0
    // imported files top-level items: stashImported / emitImported (compile-core)
    core.importFile = function(path, pos) {
        if (path.length >= 2 && path.charAt(0) == "." && path.charAt(1) == "/") { path = path.substring(2) }
        if (!(path.length >= 4 && path.substring(path.length - 4) == ".php")) { path = path + ".php" }
        var file = c.findImport(path)
        if (file == "") { return false }
        if (importedFiles["$" + file] == true) { return true }
        importedFiles["$" + file] = true
        var text = c.readFile(file)
        phpLibClasses(text)
        var asg = c.parse(c.agrammar, text, null, file)
        c.pushSource(file, text)
        importDepth = importDepth + 1
        var outerDefs = topDefs
        var outerClasses = topClasses
        var outerHoisted = hoisted
        var outerJumps = jw
        topDefs = []
        topClasses = []
        hoisted = {}
        jw = jumpWalkNew()
        c.compile(asg)
        topDefs = outerDefs
        topClasses = outerClasses
        hoisted = outerHoisted
        jw = outerJumps
        importDepth = importDepth - 1
        c.popSource()
