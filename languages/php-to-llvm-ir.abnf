    // created where the program starts so the slot survives between calls. What it
    // HOLDS is filled in by the declaration itself, on the first call.
    function emitStaticSlots(b) {
        for (var i = 0; i < staticSlots.length; i++) {
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, staticSlots[i].hidden), newCell(b, hUndef)])
        }
        return b
    }
    // $$name as a VALUE. The name is "$" . the string the inner expression yields.
    function makeVarVarRef(t) {
        return function(b) {
            var r = t(b)
            b = r.b
            var nameV = callExt(b, "js_phcat", [emitStr(b, "$"), callExt(b, "js_phstr", [r.v])])
            return readVarV(b, nameV)
        }
    }

    // ----- literal builders -----
    // A float literal's text, with PHP 7.4 underscore separators (and any whitespace
    // the token carries) stripped before parseFloat. A float is BOXED (js_phflo), the
    // same way the interpreter boxes it, so 1.0 !== 1 and match(3.0) stay observable.
    function makeFloat(n) {
        return function(b) { return {b: b, v: callExt(b, "js_phflo", [emitNum(b, n)])} }
    }
    function stripUnd(t) {
        var out = ""
        for (var i = 0; i < t.length; i++) {
            var ch = t.charAt(i)
            if (ch != "_" && ch != " " && ch != "\t" && ch != "\r" && ch != "\n") { out += ch }
        }
        return out
    }
    function phpFloatLit(t) { return parseFloat(stripUnd(t)) }
    // ----- integer literals -----
    // PHP's int is 64 bit, so a literal can be exact where a JS number is not, and
    // one that does not FIT is a float rather than a wrapped int
    // (0xFFFFFFFFFFFFFFFF is float(1.8446744073709552E+19)). The digits are
    // therefore handed to js_philit whenever they leave the exactly representable
    // range; a small literal stays an ordinary emitNum constant.
    // Corpus: lang/integer_literals/*_64bit.phpt.
    function digitsOnly(s, radix) {
        var out = ""
        for (var i = 0; i < s.length; i++) {
            var c = s.charCodeAt(i)
            var d = 0 - 1
            if (c >= 48 && c <= 57) { d = c - 48 }
            else if (c >= 97 && c <= 122) { d = c - 87 }
            else if (c >= 65 && c <= 90) { d = c - 55 }
            if (d >= 0 && d < radix) { out += s.charAt(i) }
        }
        var j = 0
        while (j < out.length - 1 && out.charAt(j) == "0") { j++ }
        return out.substring(j)
    }
    // Exact in a double? 2^53 is 16 decimal digits, 13 hex, 53 binary, 18 octal;
    // the digit COUNT is the cheap conservative test and anything longer goes
    // through the extern, which is exact either way.
    function litIsSmall(ds, radix) {
        var lim = 15
        if (radix == 16) { lim = 13 }
        else if (radix == 8) { lim = 17 }
        else if (radix == 2) { lim = 52 }
        return ds.length <= lim
    }
    function makeIntLit(ds, radix) {
        if (litIsSmall(ds, radix)) { return makeConst(parseInt(ds, radix)) }
        return function(b) {
            return {b: b, v: callExt(b, "js_philit", [emitStr(b, ds), emitNum(b, radix)])}
        }
    }
    function allOct(s) {
        for (var i = 0; i < s.length; i++) { if (s.charAt(i) < "0" || s.charAt(i) > "7") { return false } }
        return true
    }
    function phpIntLit(t) {
        var raw = stripUnd(t)
        // PHP's legacy octal survives an underscore right after the leading zero
        // ("0_16" is 14), and that form reaches the DECIMAL production because the
        // octal one wants a digit there.
        if (raw.length > 1 && raw.charAt(0) == "0" && allOct(raw)) {
            return makeIntLit(digitsOnly(raw, 8), 8)
