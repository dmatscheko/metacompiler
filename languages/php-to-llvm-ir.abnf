PhpBin      <~~ push(makeConst(phpRadixLit(up.in, 2))) ~~>
            = "0" ( "b" | "B" ) :whitespace() BinDig { BinDig | "_" } :whitespace(Whitespace) ;
BinDig      = "0" | "1" ;
PhpOct      <~~ push(makeConst(phpRadixLit(up.in, 8))) ~~>
            = "0" ( "o" | "O" ) :whitespace() OctDig { OctDig | "_" } :whitespace(Whitespace) ;
OctDig      = "0"..."7" ;
PhpLegOct   <~~ push(makeConst(phpLegOctLit(up.in))) ~~>
            = "0" :whitespace() OctDig { OctDig | "_" } :whitespace(Whitespace) ;
PhpInt      <~~ push(makeConst(phpIntLit(up.in))) ~~>
            = "0"..."9" :whitespace() { "0"..."9" | "_" } :whitespace(Whitespace) ;

VarRef      <~~ push(makeVarRef(pop())) ~~>
            = DollarName ;
Null        <~~ push(makeConst(null)) ~~> = "null" KwEnd ;

// $name: the dollar sigil is part of the stored key (PHP variables and function
// names live in separate namespaces). Attaching the capture to the whole
// production keeps the '$' in up.in.
