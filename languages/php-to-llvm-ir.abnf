            boundDynIdx[ext] = idx
        }
        var holder = callExt(b, "js_scope_new", [env])
        callExt(b, "js_phfccdecl", [holder, emitStr(b, "\x00dcrecv"), recvV, ext == "scallvia" ? emitStr(b, "__call") : nameV])
        callExt(b, "js_scope_decl", [holder, emitStr(b, "\x00dcname"), nameV])
        // In a program that restricts some method, the callable is judged from the
        // class scope that resolves it, and dispatches from there; one __call takes
        // is never the method's to judge.
        if (anyMVis) {
            var rsc = b.NewCall(scopeProbeFn(), [env, emitStr(b, frameClsName("self")), hNull])
            if (ext != "scallvia") { callExt(b, "js_phmvis", [recvV, nameV, rsc, hUndef]) }
