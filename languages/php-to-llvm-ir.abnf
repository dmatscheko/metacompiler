            var fnBare = b.NewSelect(truthy(b, bsV), callExt(b, "js_phsubstr", [fnS, emitNum(b, 1), hNull]), fnS)
            var fnK = callExt(b, "js_phcat", [emitStr(b, "\x00f"), callExt(b, "js_phcase", [fnBare, hFalse])])
            var fnHit = b.NewCall(fnProbeFn(), [curScopeV, fnK, hNull])
