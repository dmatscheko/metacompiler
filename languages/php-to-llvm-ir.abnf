        var okName = "0icok" + hidCount
        var tryT = function(b) {
            var v = callExt(b, "js_scope_get", [curScopeV, emitStr(b, vName)])
            cbCheckV(b, v, emitStr(b, "is_callable()"), true, false)
            callExt(b, "js_pyset_var", [curScopeV, emitStr(b, okName), hTrue])
