    // env runs in (js_phcbvis); cls is the class a named callable denotes, null for
    // [$obj, 'm'].
    function cbVisChk(b, env, v, clsV, where) {
        if (!anyMVis) { return null }
        var sc = b.NewCall(scopeProbeFn(), [env, emitStr(b, frameClsName("self")), hNull])
        return callExt(b, "js_phcbvis", [v, clsV, sc, where])
