        for (var i = 0; i < items.length; i++) {
            if (items[i] == undefined) { continue }
            if (items[i].casecond != undefined) { cond = items[i].casecond }
            else if (items[i].casedflt != undefined) { isDflt = true }
            else { stmts.push(items[i]) }
