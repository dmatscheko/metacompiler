    var genClosure = false
    function makeYieldArg(items) {
        if (items.length == 1) { return {yval: items[0]} }
        return {ykey: items[0], yval: items[1]}
    }
    function makeYield(items) {
        usesYield = true
        var fromT = null
        var keyT = null
        var valT = null
        for (var i = 0; i < items.length; i++) {
            if (items[i] == undefined) { continue }
            if (items[i].yfrom != undefined) { fromT = items[i].yfrom }
            else if (items[i].yval != undefined) { valT = items[i].yval; keyT = items[i].ykey }
        }
        return function(b) {
            sawYield = true
            if (fromT != null) {
                var rf = fromT(b)
                b = rf.b
                return {b: emitYieldFrom(b, rf.v), v: hNull}
            }
            var v = hNull
            if (valT != null) { var rv = valT(b); b = rv.b; v = rv.v }
            if (keyT != null) {
                var rk = keyT(b)
                b = rk.b
                var pair = callExt(b, "js_obj_new", [])
                callExt(b, "js_set", [pair, emitStr(b, "__genkv"), hTrue])
                callExt(b, "js_set", [pair, emitStr(b, "k"), rk.v])
                callExt(b, "js_set", [pair, emitStr(b, "v"), v])
