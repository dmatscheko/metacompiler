            if (items[i].body != undefined) { body = items[i].body }
            else if (items[i].pmod != undefined) { pendingMod = true }
            else if (items[i].param != undefined) {
                params.push(items[i].param)
                if (pendingMod) { promoted.push(items[i].param) }
                pendingMod = false
            }
            else if (items[i].pdef != undefined) { defs.push({name: params[params.length - 1], init: items[i].pdef}) }
        }
