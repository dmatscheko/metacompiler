        for (var i = 1; i < items.length; i++) {
            if (items[i].body != undefined) { body = items[i].body }
            else if (items[i].v1 != undefined) { valName = items[i].v1 }
            else if (items[i].v2 != undefined) { keyName = items[i].v2 }
            else if (items[i].pat != undefined) { pat = items[i].pat }
        }
        return function(b) {
            var ir = iterT(b)
            b = ir.b
            hidCount++
            var itName = "0fe_it" + hidCount
            var lenName = "0fe_len" + hidCount
            var iName = "0fe_i" + hidCount
            callExt(b, "js_pyset_var", [curScopeV, emitStr(b, itName), ir.v])
            callExt(b, "js_pyset_var", [curScopeV, emitStr(b, lenName), callExt(b, "js_range_len", [ir.v])])
            callExt(b, "js_pyset_var", [curScopeV, emitStr(b, iName), emitNum(b, 0)])
            var headB = curF.NewBlock("")
            var bodyB = curF.NewBlock("")
            var postB = curF.NewBlock("")
            var exitB = curF.NewBlock("")
            b.NewBr(headB)
            var iV = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, iName)])
            var lenV = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, lenName)])
            headB.NewCondBr(truthy(headB, callExt(headB, "js_lt", [iV, lenV])), bodyB, exitB)
            var itV = callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, itName)])
            var iB = callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, iName)])
            if (pat != null) {
                bodyB = emitBindPattern(bodyB, pat, callExt(bodyB, "js_range_val", [itV, iB]))
            } else if (keyName != null) {
                callExt(bodyB, "js_pyset_var", [curScopeV, emitStr(bodyB, valName), callExt(bodyB, "js_range_key", [itV, iB])])
                callExt(bodyB, "js_pyset_var", [curScopeV, emitStr(bodyB, keyName), callExt(bodyB, "js_range_val", [itV, iB])])
            } else {
                callExt(bodyB, "js_pyset_var", [curScopeV, emitStr(bodyB, valName), callExt(bodyB, "js_range_val", [itV, iB])])
            }
            loopStack.push({cont: postB, brk: exitB})
            body(bodyB).NewBr(postB)
            loopStack.pop()
            var iP = callExt(postB, "js_scope_get", [curScopeV, emitStr(postB, iName)])
            callExt(postB, "js_pyset_var", [curScopeV, emitStr(postB, iName),
                                            intWrap(postB, callExt(postB, "js_jadd", [iP, emitNum(postB, 1)]))])
            postB.NewBr(headB)
            return exitB
        }
    }

    // ----- ternary / Elvis / null-coalescing (expressions) -----
    // items: [cond] plain, [cond, {elvis}] Elvis, [cond, then, else] full ternary.
    function makeTernary(items) {
        if (items.length == 1) { return items[0] }
        if (items.length == 2) {
            var condE = items[0]
            var rightE = items[1].elvis
            return function(b) {
                var rc = condE(b)
                b = rc.b
                var thenB = curF.NewBlock("")
                var elseB = curF.NewBlock("")
                var mergeB = curF.NewBlock("")
                b.NewCondBr(truthy(b, rc.v), thenB, elseB)
                thenB.NewBr(mergeB)
                var re = rightE(elseB)
                re.b.NewBr(mergeB)
                var phi = mergeB.NewPhi([llvm.ir.NewIncoming(rc.v, thenB), llvm.ir.NewIncoming(re.v, re.b)])
                return {b: mergeB, v: phi}
            }
        }
        var condT = items[0]
        var thenT = items[1]
        var elseT = items[2]
        return function(b) {
            var rc = condT(b)
            b = rc.b
            var thenB = curF.NewBlock("")
            var elseB = curF.NewBlock("")
            var mergeB = curF.NewBlock("")
            b.NewCondBr(truthy(b, rc.v), thenB, elseB)
            var rt = thenT(thenB)
            rt.b.NewBr(mergeB)
            var re = elseT(elseB)
            re.b.NewBr(mergeB)
            var phi = mergeB.NewPhi([llvm.ir.NewIncoming(rt.v, rt.b), llvm.ir.NewIncoming(re.v, re.b)])
            return {b: mergeB, v: phi}
        }
    }
    // a ?? b : the first operand that is not null (left fold; associative for '??').
    function makeCoalesce(items) {
        if (items.length == 1) { return items[0] }
        return function(b) {
            var r = items[0](b)
            b = r.b
            var v = r.v
            for (var i = 1; i < items.length; i++) {
                var rightB = curF.NewBlock("")
                var mergeB = curF.NewBlock("")
                var isNull = b.NewICmp(llvm.enum.IPredEQ, v, hNull)
                b.NewCondBr(isNull, rightB, mergeB)
                var r2 = items[i](rightB)
                r2.b.NewBr(mergeB)
                var phi = mergeB.NewPhi([llvm.ir.NewIncoming(v, b), llvm.ir.NewIncoming(r2.v, r2.b)])
                b = mergeB
                v = phi
            }
            return {b: b, v: v}
        }
    }
    // list($a, $b) = e / [$a, $b] = e : bind targets from the array's positions.
    // A slot is {empty} | {key, val}; val is either a nested {pat} or a target {dt}.
    function makeSlot(items) {
        if (items.length == 0) { return {empty: true, key: null, val: null} }
        var it = items[0]
        return {empty: false, key: it.dkey == undefined ? null : it.dkey, val: it.dval}
    }
    function makePattern(items) {
        var slots = []
        for (var i = 0; i < items.length; i++) { slots.push(items[i]) }
        return {slots: slots}
    }
    // Positional slots consume the next integer index; a KEYED slot reads its own key
    // and does not advance the position, which is PHP's rule and the interpreter's.
    function emitBindPattern(b, pat, arrV) {
        var pos = 0
        for (var i = 0; i < pat.slots.length; i++) {
            var sl = pat.slots[i]
            if (sl.empty === true) { pos = pos + 1; continue }
            var keyV = anytype
            if (sl.key != null) {
                var rk = sl.key(b)
                b = rk.b
                keyV = rk.v
            } else {
                keyV = emitNum(b, pos)
                pos = pos + 1
            }
            var elem = callExt(b, "js_phget", [arrV, keyV])
            if (sl.val.pat != undefined) {
                b = emitBindPattern(b, sl.val.pat, elem)
            } else {
                var ref = sl.val.dt
                if (ref.path.length == 0) {
                    callExt(b, "js_pyset_var", [curScopeV, emitStr(b, ref.name), elem])
                } else {
                    var p = emitRefPath(b, ref)
                    b = p.b
                    writeRefSlot(b, p, elem)
                }
            }
        }
        return b
    }
    function makeDestructure(items) {
        var pat = null
        var valT = null
        for (var i = 0; i < items.length; i++) {
            if (items[i].pat != undefined) { pat = items[i].pat }
            else { valT = items[i] }
        }
        return function(b) {
            var r = valT(b)
            b = emitBindPattern(r.b, pat, r.v)
            return {b: b, v: r.v}
        }
    }

    // ----- && / || : short circuit, PHP-style boolean result -----
    makeOrAnd = function(items, isOr) {
        if (items.length == 1) { return items[0] }
        return function(b) {
            var r = items[0](b)
            b = r.b
            var v = r.v
            for (var i = 1; i < items.length; i++) {
                var rightB = curF.NewBlock("")
                var mergeB = curF.NewBlock("")
                var cnd = truthy(b, v)
                if (isOr) { b.NewCondBr(cnd, mergeB, rightB) }
                else      { b.NewCondBr(cnd, rightB, mergeB) }
                var r2 = items[i](rightB)
                r2.b.NewBr(mergeB)
                var phi = mergeB.NewPhi([llvm.ir.NewIncoming(v, b), llvm.ir.NewIncoming(r2.v, r2.b)])
                b = mergeB
                v = phi
            }
            var boolV = callExt(b, "js_phbool", [v])
            return {b: b, v: boolV}
        }
    }

    // ----- PHP's value model: the whole operator ladder goes through js_ph* -------
    // The handle runtime's default operators are JavaScript's, and PHP's are not:
    // '==' is loose, '"0"' is falsy, a float is a distinct type from an int, and an
    // array is one ordered map whose '===' compares the keys AND their order. Each
    // js_ph* external below is the Go twin of the like-named function in
    // php-interpreter.abnf (phpLoose / phpIdentical / phpCmp / phpArith / phptest /
    // phpStr), so the interpreter stays the reference implementation and the two
    // engines answer the same thing. See abnf/jsrtphp.go.
    core.truthyExt = "js_phtruthy"
    binExt["==="] = "js_phseq"
    binExt["!=="] = "js_phsne"
    binExt["=="] = "js_pheq"
    binExt["!="] = "js_phne"
    binExt["<>"] = "js_phne"
    binExt["<"] = "js_phlt"
    binExt[">"] = "js_phgt"
    binExt["<="] = "js_phle"
    binExt[">="] = "js_phge"
    binExt["+"] = "js_phadd"
    binExt["-"] = "js_phsub"
    binExt["*"] = "js_phmul"
    binExt["/"] = "js_phdiv"
    binExt["%"] = "js_phmod"
    binExt["+="] = "js_phadd"
    binExt["-="] = "js_phsub"
    binExt["*="] = "js_phmul"
    binExt["/="] = "js_phdiv"
    binExt["%="] = "js_phmod"
    // js_ph* already answers in PHP's own type (an int stays an int, any float
    // operand makes the result a float), so the C-family 32-bit truncation the
    // shared emitBin applies must be off for every one of them. PHP integers are
    // 64 bit and '/' is float division (7 / 2 is 3.5), which intWrap destroyed.
    wraps["/"] = 0
    wraps["/="] = 0
    wraps["-"] = 0
    wraps["-="] = 0
    wraps["*"] = 0
    wraps["*="] = 0
    wraps["%"] = 0
    wraps["%="] = 0
    makeNeg = function(t) {
        return function(b) {
            var r = t(b)
            return {b: r.b, v: callExt(r.b, "js_phneg", [r.v])}
        }
    }
    // '!' is PHP truthiness, not JS truthiness ('!"0"' is true).
    makeNot = function(t) {
        return function(b) {
            var r = t(b)
            return {b: r.b, v: callExt(r.b, "js_phnot", [r.v])}
        }
    }
    // The rest of PHP's binary ladder. The bitwise / shift forms truncate to a
    // 32-bit integer, which is what phpBit does in the interpreter.
    binExt["&"] = "js_phband"
    binExt["|"] = "js_phbor"
    binExt["^"] = "js_phbxor"
    binExt["<<"] = "js_phshl"
    binExt[">>"] = "js_phshr"
    binExt["&="] = "js_phband"
    binExt["|="] = "js_phbor"
    binExt["^="] = "js_phbxor"
    binExt["<<="] = "js_phshl"
    binExt[">>="] = "js_phshr"
    emitBin = function(b, op, l, r) {
        if (op == "." || op == ".=") {
            return callExt(b, "js_phcat", [l, r])
        }
        if (op == "**" || op == "**=") {
            return callExt(b, "js_phpow", [l, r])
        }
        // '<=>' answers exactly -1 / 0 / 1 from PHP's own comparison.
        if (op == "<=>") {
            return callExt(b, "js_phcmp", [l, r])
        }
        // '$a ??= $b' keeps $a when it is set and not null. The right-hand side is
        // already evaluated at this point, so - unlike PHP - it is not short-circuited;
        // a side-effecting right operand of '??=' therefore still runs.
        if (op == "??=") {
            return b.NewSelect(truthy(b, callExt(b, "js_seq", [l, hNull])), r,
                               b.NewSelect(truthy(b, callExt(b, "js_seq", [l, hUndef])), r, l))
        }
        var v = callExt(b, binExt[op], [l, r])
        if (wraps[op] == 1) { v = intWrap(b, v) }
        return v
    }
    // 2 ** 3 ** 2 == 512: the parse is already right-associative (the right operand is
    // a full UnaryExpr), so the fold only has to apply the operator when one is there.
    function foldPow(items) {
        if (items.length == 1) { return items[0] }
        var base = items[0]
        var exp = items[1]
        return function(b) {
            var rl = base(b)
            var rr = exp(rl.b)
            return {b: rr.b, v: emitBin(rr.b, "**", rl.v, rr.v)}
        }
    }
    // ~x on PHP's own integer coercion (phpBit in the interpreter).
    function makeBitNot(t) {
        return function(b) {
            var r = t(b)
            return {b: r.b, v: callExt(r.b, "js_phbnot", [r.v])}
        }
    }
    // throw as an EXPRESSION (PHP 8): it never produces a value, so the block it ends
    // is dead exactly like the throw statement's.
    function makeThrowExpr(e) {
        return function(b) {
            var r = e(b)
            callExt(r.b, "js_throw", [r.v])
            r.b.NewRet(hUndef) // Never reached: js_throw unwinds on the host side.
            return {b: deadBlock(), v: hUndef}
        }
    }

    // ----- arrays: ONE type, the ordered key/value map ---------------------------
    // PHP has a single array type: [1, 2, 3] IS the map 0=>1, 1=>2, 2=>3, which is why
    // $a === $b compares the keys and their ORDER while $a == $b ignores it, and why
    // [5 => "x"] followed by $m[] = "y" lands at key 6. The compiler used to build an
    // indexed literal as a runtime LIST and a keyed one as a dict, so the two spellings
    // of the same value were different types. js_pharr / js_phset / js_phpush build the
    // one map (the __dict shape js_range_* already iterates), carrying __next - the
    // next automatic integer key - exactly like the interpreter's newArr/arrPush.
    // A '...$a' spread merges another array in: its INTEGER keys are renumbered and its
    // string keys are kept, PHP's rule for the array-unpacking operator.
    function makeArray(items) {
        return function(b) {
            var d = callExt(b, "js_pharr", [])
            for (var k = 0; k < items.length; k++) {
                if (items[k].hk != undefined) {
                    var rk = items[k].hk(b); b = rk.b
                    var rv = items[k].hv(b); b = rv.b
                    callExt(b, "js_phset", [d, rk.v, rv.v])
                } else if (items[k].spread != undefined) {
                    var rs = items[k].spread(b); b = rs.b
                    callExt(b, "js_phmerge", [d, rs.v])
                } else {
                    var re = items[k].elem(b); b = re.b
                    callExt(b, "js_phpush", [d, re.v])
                }
            }
            return {b: b, v: d}
        }
    }

    function makeTemplate(items) {
        return function(b) {
            var v = emitStr(b, "")
            for (var i = 0; i < items.length; i++) {
                var pv
                if (items[i].s != undefined) { pv = emitStr(b, items[i].s) }
                else { var r = items[i].e(b); b = r.b; pv = r.v }
                v = callExt(b, "js_phcat", [v, pv])
            }
            return {b: b, v: v}
        }
    }

    // "$name", "$a[0]", "$map[key]", "$o->prop": PHP's simple interpolation form. The
    // index text is classified here, exactly as php-interpreter.abnf's makeTplVar does:
    // a leading '$' is another variable, a canonical integer is an int key, anything
    // else is a BARE word taken as a string key (that is what "$map[key]" means).
    function makeTplVar(items) {
        var name = ""
        var idx = null
        var prop = null
        for (var i = 0; i < items.length; i++) {
            if (items[i].tvar != undefined) { name = items[i].tvar }
            else if (items[i].tidx != undefined) { idx = items[i].tidx }
            else if (items[i].tprop != undefined) { prop = items[i].tprop }
        }
        if (idx != null) {
            var itxt = idx
            return function(b) {
                var ov = callExt(b, "js_scope_get", [curScopeV, emitStr(b, name)])
                var kv = anytype
                if (itxt.charAt(0) == "$") { kv = callExt(b, "js_scope_get", [curScopeV, emitStr(b, itxt)]) }
                else if (isCanonInt(itxt)) { kv = emitNum(b, parseInt(itxt, 10)) }
                else { kv = emitStr(b, itxt) }
                return {b: b, v: callExt(b, "js_phget", [ov, kv])}
            }
        }
        if (prop != null) {
            var pn = prop.substring(2)
            return function(b) {
                var ov = callExt(b, "js_scope_get", [curScopeV, emitStr(b, name)])
                return {b: b, v: callExt(b, "js_get", [ov, emitStr(b, pn)])}
            }
        }
        return makeVarRef(name)
    }
    // A canonical decimal integer: no leading zero, an optional '-'. PHP's array keys
    // only fold a string to an int in that exact form ("01" stays a string key).
    function isCanonInt(s) {
        if (s.length == 0) { return false }
        var i = 0
        if (s.charAt(0) == "-") { if (s.length == 1) { return false }; i = 1 }
        if (s.charAt(i) == "0" && s.length > i + 1) { return false }
        for (var j = i; j < s.length; j++) {
            var ch = s.charAt(j)
            if (ch < "0" || ch > "9") { return false }
        }
        return true
    }

    // ----- member chains: ->method(args), ->field, [index], (call), ::static -----
    foldCallMember = function(items) {
        if (items.length == 1) { return items[0] }
        var primary = items[0]
        var suffixes = items.slice(1)
        return function(b) {
            var r = primary(b)
            b = r.b
            var cur = r.v
            for (var i = 0; i < suffixes.length; i++) {
                var s = suffixes[i]
                if (s.kind == "mcall") {
                    var ea = emitArgs(b, s.args)
                    b = ea.b
                    cur = callExt(b, "js_mcall", [cur, emitStr(b, s.name), ea.v])
                } else if (s.kind == "field") {
                    cur = callExt(b, "js_get", [cur, emitStr(b, s.name)])
                } else if (s.kind == "call") {
                    var ea2 = emitArgs(b, s.args)
                    b = ea2.b
                    cur = callExt(b, "js_call", [cur, hUndef, ea2.v])
                } else if (s.kind == "static") {
                    var curV = cur
                    var rs = emitStaticAccess(function(bb) { return {b: bb, v: curV} }, s.sfxMem, s.sfxArgs)(b)
                    b = rs.b
                    cur = rs.v
                } else {
                    var ir = s.idx(b)
                    b = ir.b
                    cur = callExt(b, "js_phget", [cur, ir.v])
                }
            }
            return {b: b, v: cur}
        }
    }
    // items = [{cast}, operandThunk]
    function makeCast(items) {
        var kind = items[0].cast
        var t = items[1]
        return function(b) {
            var r = t(b)
            return {b: r.b, v: callExt(r.b, "js_phcast", [emitStr(r.b, kind), r.v])}
        }
    }
    // ----- '::' : class constants, static properties, static dispatch -----------
    // The base of a '::' is a class descriptor at run time. 'self' and 'static' are
    // read out of the CALL FRAME (emitFunc declares them per method), which is what
    // keeps them correct across a try/catch: makeTry restores the scope chain, and
    // they ride along in it.
    function staticBaseThunk(name) {
        var n = lastSeg(name)
        if (n == "self") { return function(b) { return {b: b, v: frameCls(b, "self")} } }
        if (n == "static") { return function(b) { return {b: b, v: frameCls(b, "static")} } }
        if (n == "parent") {
            return function(b) {
                return {b: b, v: callExt(b, "js_get", [frameCls(b, "self"), emitStr(b, "__super")])}
            }
        }
        return function(b) { return {b: b, v: callExt(b, "js_scope_get", [curScopeV, emitStr(b, n)])} }
    }
    // The hidden call-frame entries. The names start with a NUL so no PHP identifier
    // and no '$variable' can collide with them.
    function frameClsName(which) { return "\x00" + which }
    function frameCls(b, which) {
        return callExt(b, "js_scope_get", [curScopeV, emitStr(b, frameClsName(which))])
    }
    // baseT :: member, with or without an argument list.
    function emitStaticAccess(baseT, mem, args) {
        return function(b) {
            var rb = baseT(b)
            b = rb.b
            if (args != null) {
                var ea = emitArgs(b, args)
                b = ea.b
                var thisV = callExt(b, "js_phthis", [curScopeV])
                return {b: b, v: callExt(b, "js_phscall", [rb.v, emitStr(b, mem), thisV, ea.v])}
            }
            if (mem.charAt(0) == "$") {
                return {b: b, v: callExt(b, "js_phsget", [rb.v, emitStr(b, mem.substring(1))])}
            }
            // C::class is the class NAME, not a constant lookup.
            if (mem == "class") { return {b: b, v: callExt(b, "js_phcname", [rb.v])} }
            return {b: b, v: callExt(b, "js_phconst", [rb.v, emitStr(b, mem)])}
        }
    }
    function staticParts(items) {
        var out = {base: null, mem: "", args: null}
        for (var i = 0; i < items.length; i++) {
            if (items[i].sbase != undefined) { out.base = staticBaseThunk(items[i].sbase) }
            else if (items[i].smem != undefined) { out.mem = items[i].smem }
            else if (items[i].sargs != undefined) { out.args = items[i].sargs }
        }
        return out
    }
    // One match arm: the conditions it answers to (empty for 'default') and its body.
    function makeArm(items) {
        var conds = []
        var body = null
        var isDflt = false
        for (var i = 0; i < items.length; i++) {
            if (items[i].mdflt != undefined) { isDflt = true }
            else if (items[i].mcond != undefined) { conds.push(items[i].mcond) }
            else if (items[i].mbody != undefined) { body = items[i].mbody }
        }
        return {conds: conds, body: body, isDflt: isDflt}
    }
    function makeMatch(items) {
        var subj = items[0]
        var arms = items.slice(1)
        return function(b) {
            var rs = subj(b)
            b = rs.b
            var sv = rs.v
            var mergeB = curF.NewBlock("")
            var incs = []
            var dflt = null
            for (var d = 0; d < arms.length; d++) { if (arms[d].isDflt) { dflt = arms[d] } }
            for (var a = 0; a < arms.length; a++) {
                if (arms[a].isDflt) { continue }
                var bodyB = curF.NewBlock("")
                for (var k = 0; k < arms[a].conds.length; k++) {
                    var rc = arms[a].conds[k](b)
                    b = rc.b
                    var nextB = curF.NewBlock("")
                    b.NewCondBr(truthy(b, callExt(b, "js_phseq", [sv, rc.v])), bodyB, nextB)
                    b = nextB
                }
                var rb = arms[a].body(bodyB)
                rb.b.NewBr(mergeB)
                incs.push(llvm.ir.NewIncoming(rb.v, rb.b))
            }
            if (dflt != null) {
