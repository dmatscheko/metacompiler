    }
    // A static method of Closure named through the class is a valid callback
    // (js_phclost): it branches to okB. Answers the block anything else continues in.
    function cloStaticOk(f, b, cnV, mnV, where, okB) {
        var missB = f.NewBlock("")
        b.NewCondBr(b.NewICmp(llvm.enum.IPredEQ, callExt(b, "js_phclost", [cnV, mnV, where]), hUndef), missB, okB)
        return missB
    }
    // The non-static half of a class-named callback check, when ns asks for it.
    // Answers the block the check continues in.
    function cbNsChk(f, b, env, ns, clsV, cnV, mnV, where) {
        var doB = f.NewBlock("")
        var contB = f.NewBlock("")
        b.NewCondBr(b.NewICmp(llvm.enum.IPredEQ, ns, hTrue), doB, contB)
        var thisV = doB.NewCall(scopeProbeFn(), [env, emitStr(doB, "$this"), hUndef])
        var selfV = doB.NewCall(scopeProbeFn(), [env, emitStr(doB, frameClsName("self")), hNull])
        callExt(doB, "js_phcbns", [where, clsV, cnV, mnV, thisV, selfV])
