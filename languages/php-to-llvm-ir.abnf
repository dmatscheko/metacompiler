// together so a '\"' does not end the string.
TplEsc      = TplUniEsc | "\\" "\x00"..."\U0010ffff" ;
TplPlain    = "\x20"..."\x21" | "\x23" | "\x25"..."\x5b" | "\x5d"..."\x7a" | "\x7c"..."\U0010ffff" | @"\t" | @"\n" | @"\r" ;
TplSpecial  <~~ push({s: up.in}) ~~>
