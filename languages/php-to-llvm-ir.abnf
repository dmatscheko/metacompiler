    function makeTemplate(items) {
        if (items.length == 1 && items[0].s != undefined) { phpLibRef(items[0].s, false) }
        return function(b) {
            var v = emitStr(b, "")
            for (var i = 0; i < items.length; i++) {
                var pv
                if (items[i].s != undefined) { pv = emitStr(b, items[i].s) }
                else if (items[i].sb != undefined) { pv = callExt(b, "js_phfrombytes", [emitStr(b, items[i].sb)]) }
