    // because the runtime keeps its own slots (__class, __dict, __refcell ...)
    // under such names and hides every __ key from a listing. js_phpkey does the
    // same at run time and js_phpname takes it back off (abnf/jsrtphp.go,
    // lib/php-rt.metajs). The interpreter keeps properties apart from its slots.
    function propKey(b, name) {
        return emitStr(b, (name.length > 1 && name.substring(0, 2) == "__") ? "\x01" + name : name)
    }
    // The magic fallbacks run only for a property the instance does not HAVE: a
    // declared `public $p;` holds null, is present, and is read, written and isset()
    // without __get / __set / __isset (zend_std_read_property and friends find the
    // slot first). Absent is the floor's undefined - js_del removes the key on unset() -
    // and so is an uninitialised typed property, which the runtime tells apart.
    // Twin of the dictFind presence test in php-interpreter.abnf's phpGetProp.
    function propPresent(b, raw) { return b.NewICmp(llvm.enum.IPredNE, raw, hUndef) }
    // A name some class makes private or protected is read through js_phprop, which
    // checks the running class. Any other read is a plain js_get, and only a value
    // that is absent (undefined) takes js_phprop for the magic fallback or the
    // uninitialised typed property - and only in a program that has one of those.
    // Twin of phpGetProp in php-interpreter.abnf.
    function emitPropGetPlain(b, objV, keyV, name, thisLex, isMode) {
