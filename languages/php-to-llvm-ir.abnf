    // ----- magic methods --------------------------------------------------------
    // __get / __set / __isset / __unset / __call / __invoke are FALLBACKS: they run only where an
    // ordinary member access finds nothing. Each therefore costs a branch at every
    // property read, property write or method call - so, exactly like the operator
    // overloading in csharp-to-llvm-ir.abnf, the branch is emitted only when some class
    // in the program declares that hook. A program with no magic method emits none.
    var magicGet = false
    var magicSet = false
    var magicIsset = false
    var magicUnset = false
    var magicCall = false
    var magicInvoke = false
