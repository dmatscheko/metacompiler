                callExt(bb, "js_phpush", [inner, nmV])
                callExt(bb, "js_phpush", [inner, phListOf(bb, bf.Params[1])])
                var vThis = callExt(bb, "js_scope_get", [bf.Params[0], emitStr(bb, "\x00dcthis")])
                var vLsb = callExt(bb, "js_scope_get", [bf.Params[0], emitStr(bb, "\x00dclsb")])
