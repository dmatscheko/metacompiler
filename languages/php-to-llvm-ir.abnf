    // The implemented / extended interfaces, as DESCRIPTORS: js_phisa then matches an
    // interface that itself extends others, and js_phconst can inherit a constant
    // through them. A name that is not declared yet resolves to null and simply never
    // matches, so a forward reference degrades instead of aborting.
    function emitIfaceList(b, clsV, names) {
        if (names.length == 0) { return b }
        var ifV = callExt(b, "js_pharr", [])
        for (var q = 0; q < names.length; q++) {
            callExt(b, "js_phpush", [ifV, callExt(b, "js_phclslookup", [curScopeV, emitStr(b, names[q])])])
        }
        callExt(b, "js_set", [clsV, emitStr(b, "__ifaces"), ifV])
        return b
    }
    function makeInstanceof(items) {
        var left = items[0]
        var nm = items[1].iname
        var dyn = items[1].idyn
        return function(b) {
            var r = left(b)
            b = r.b
            if (nm != undefined) { return {b: b, v: callExt(b, "js_phisa", [r.v, emitStr(b, nm)])} }
            var rd = dyn(b)
            b = rd.b
            return {b: b, v: callExt(b, "js_phisa", [r.v, rd.v])}
        }
    }
    // One class-constant item: 'A = 1', or the typed 'int SIZE = 4' (CIds keeps the
    // LAST word, which is the name).
    function makeCItem(items) {
        var nm = ""
        var init = null
        for (var i = 0; i < items.length; i++) {
            if (items[i].cname != undefined) { nm = items[i].cname }
            else { init = items[i] }
        }
        return {cname: nm, cinit: init}
    }


    // include / require: a single-quoted literal path is resolved to a project file
    // (resolveImport -> core.importFile below, whose thunks are stashed for phpmain); a
    // dynamic / double-quoted operand stays notImplemented. The expression yields a
    // harmless true so the enclosing statement still lowers.
    function makeInclude(items, pos) {
        for (var i = 0; i < items.length; i++) {
            if (items[i].incpath != undefined) {
                resolveImport(items[i].incpath, pos)
                return makeConst(true)
            }
        }
        return notImplExpr("include/require", pos)
    }

    // ----- closures (IR function closed over the defining scope via js_closure) -----
    function makeClosure(items) {
        var pl = paramList(items)
        var body = null
        var byVal = []
        var byRef = []
        var pendingUseRef = false
        for (var i = 0; i < items.length; i++) {
            if (items[i].body != undefined) { body = items[i].body }
            else if (items[i].useref != undefined) { pendingUseRef = true; noteRef() }
            else if (items[i].use != undefined) {
                if (pendingUseRef) { byRef.push(items[i].use) }
                else { byVal.push(items[i].use) }
                pendingUseRef = false
            }
        }
        body = paramDefaults(pl.defs, variadicPrologue(pl, body))
        return function(b) {
            var idx = emitFunc(pl.params, body, false)
            var rc = emitCapture(b, byVal, byRef, false)
            return {b: rc.b, v: closureV(rc.b, idx, rc.v)}
        }
    }

    // fn ($x) => $e is the same emitted function as a closure, with a body that
    // consists of one synthesized 'return $e' - so it inherits the closure's whole
    // capture, its parameter binding and its try-aware return in one step.
    function makeArrowFn(items) {
        var pl = paramList(items)
        var bodyT = null
        var mark = 0
        for (var i = 0; i < items.length; i++) {
            if (items[i].arrowbody != undefined) { bodyT = items[i].arrowbody }
            else if (items[i].vmark != undefined) { mark = items[i].vmark }
        }
        // An arrow function captures BY VALUE, automatically: every '$name' the body
        // mentions (varLog since the 'fn' keyword, minus this function's own
        // parameters) is snapshotted where the closure is created, so a later write
        // to one of them outside is not visible inside.
        var captured = varsSince(mark, pl.params)
        var body = paramDefaults(pl.defs, variadicPrologue(pl, makeBody([makeReturn([bodyT])])))
        return function(b) {
            var idx = emitFunc(pl.params, body, false)
            var rc = emitCapture(b, captured, [], true)
            return {b: rc.b, v: callExt(rc.b, "js_closure", [handle(idx), rc.v])}
        }
    }

    // ----- new C(...) -----
    // Declared defaults are replayed by the class's own __initprops hook, which every
    // class declaration emits (emitInitProps): it calls the PARENT's hook first and then
    // assigns its own declared defaults, so a redeclared property in the subclass wins -
    // PHP's rule - and a `new $cn()` whose class is only known at run time gets exactly
    // the same treatment as a named one.
    // The class descriptor a `new` names: a plain name, a RELATIVE keyword
    // (self/static/parent) read out of the call frame, or a run-time value that is
    // either a class name string or a descriptor (js_phcname normalizes both to the
    // name, js_phclslookup turns that back into the descriptor).
    function newClassV(b, target) {
        if (target.cls != undefined) {
            return {b: b, v: callExt(b, "js_scope_get", [curScopeV, emitStr(b, target.cls)])}
        }
        if (target.crel != undefined) {
            if (target.crel == "parent") {
                return {b: b, v: callExt(b, "js_get", [frameCls(b, "self"), emitStr(b, "__super")])}
            }
            return {b: b, v: frameCls(b, target.crel)}
        }
        var rd = target.cdyn(b)
        b = rd.b
        return {b: b, v: callExt(b, "js_phclslookup", [curScopeV, callExt(b, "js_phcname", [rd.v])])}
    }
    // An argument record (from ArgList) as opposed to a class-member record.
    function isArgRec(it) {
        if (it == undefined) { return false }
        return it.pos != undefined || it.aname != undefined || it.aspread != undefined || it.fcc != undefined
    }
    var anonCount = 0
    function makeNewAnon(items) {
        anonCount++
        var name = "class@anonymous" + anonCount
        var classItems = [name]
        var args = []
        for (var i = 0; i < items.length; i++) {
            if (isArgRec(items[i])) { args.push(items[i]) }
            else { classItems.push(items[i]) }
        }
        var clsStmt = makeClassStmt(classItems)
        var newItems = [{cls: name}]
        for (var k = 0; k < args.length; k++) { newItems.push(args[k]) }
        var newT = makeNew(newItems)
        return function(b) {
            b = clsStmt(b)
            return newT(b)
        }
    }
    function makeNew(items) {
        var target = items[0]
        var args = items.slice(1)
        return function(b) {
            var rc = newClassV(b, target)
            b = rc.b
            var clsV = rc.v
            var objV = callExt(b, "js_obj_new", [])
            callExt(b, "js_set", [objV, emitStr(b, "__class"), clsV])
            callExt(b, "js_phscall", [clsV, emitStr(b, "__initprops"), objV, callExt(b, "js_pharr", [])])
            var ean = emitPhArgs(b, args, ctorSig(target.cls))
            b = ean.b
            var argsV = ean.v
            // The constructor is resolved through the __super chain, not read off the
            // class with js_get: `class Boom extends Exception {}` declares no
            // __construct of its own, and the plain lookup answered undefined -
            // which is why every subclass of the built-in exceptions failed to
            // instantiate. js_phscall also makes the NAMED class the late-static-
            // binding class, so `new static()` inside the constructor is right.
            callExt(b, "js_phscall", [clsV, emitStr(b, "__construct"), objV, argsV])
            return {b: b, v: objV}
        }
    }

    // ----- echo / print -----
    // ----- inline HTML (text outside <?php ... ?>) -----
    // The run is echoed verbatim: one print() of a constant string, so a template
    // costs no more IR than the echo it stands for. After a CLOSE tag PHP swallows
    // one immediately following newline (so '?>' at the end of a template line adds
    // no blank line); text before the FIRST open tag keeps its newlines.
    function makeHtmlOut(text, afterClose) {
        var s = text
        if (afterClose === true && s.length > 0) {
            if (s.charCodeAt(0) === 10) { s = s.substring(1) }
            else if (s.charCodeAt(0) === 13 && s.length > 1 && s.charCodeAt(1) === 10) { s = s.substring(2) }
            else if (s.charCodeAt(0) === 13) { s = s.substring(1) }
        }
        return function(b) {
            if (s.length > 0) {
                var printV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, "print")])
