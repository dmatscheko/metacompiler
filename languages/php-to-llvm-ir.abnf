            }
            if (ch == "$" && i + 1 < body.length && isNameStart(body.charAt(i + 1))) {
                var k = i + 1
                while (k < body.length && isNameChar(body.charAt(k))) { k++ }
                var expr = body.substring(i, k)
                // one optional '[key]' or '->prop' step, like the string form
                if (k < body.length && body.charAt(k) == "[") {
                    var e2 = k
                    while (e2 < body.length && body.charAt(e2) != "]") { e2++ }
                    if (e2 < body.length) {
                        var inner = body.substring(k + 1, e2)
                        if (inner.length > 0 && inner.charAt(0) != "$" && !isCanonInt(inner)) { inner = "'" + inner + "'" }
                        expr = expr + "[" + inner + "]"
                        k = e2 + 1
                    }
                } else if (k + 2 < body.length && body.charAt(k) == "-" && body.charAt(k + 1) == ">" && isNameStart(body.charAt(k + 2))) {
                    var p2 = k + 2
                    while (p2 < body.length && isNameChar(body.charAt(p2))) { p2++ }
                    expr = expr + body.substring(k, p2)
                    k = p2
                }
                if (lit != "") { parts.push({s: unescapeDq(lit)}); lit = "" }
                parts.push({e: compileSnippet(expr)})
                i = k
                continue
            }
            lit += ch
            i++
        }
        if (lit != "") { parts.push({s: unescapeDq(lit)}) }
