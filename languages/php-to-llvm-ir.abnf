    // hookedProps holds every property name some class gives a hook, so a read or write
    // of that NAME can be compiled with a dispatch in front of it and every other
    // property keeps a plain js_get / js_set.
    // hookBacking is the property whose hook body is being emitted right now: inside it
    // '$this->x' is the backing STORE, not another hook call, which is what stops a
    // backed hook from recursing into itself.
    var hookedProps = {}
    var usesHooks = false
    var hookBacking = ""
    function noteHooked(name) { hookedProps["$" + name] = true; usesHooks = true }
    function isHooked(name) {
