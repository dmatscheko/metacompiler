        strB.NewCondBr(strB.NewICmp(llvm.enum.IPredEQ, strB.NewCall(fnProbeFn(), [env, v, hNull]), hNull), missB, okB)
        missB = fnRetry(f, missB, env, v, function(hb, fv) { hb.NewBr(okB) })
        var sepV = callExt(missB, "js_phstrpos", [v, emitStr(missB, "::"), hNull])
        var sepB = f.NewBlock("sep")
        var badB = f.NewBlock("bad")
        missB.NewCondBr(truthy(missB, callExt(missB, "js_phis", [emitStr(missB, "int"), sepV])), sepB, badB)
        var whyV = callExt(badB, "js_phcat", [emitStr(badB, "function \""), v])
        callExt(badB, "js_phcbfail", [where, callExt(badB, "js_phcat", [whyV, emitStr(badB, "\" not found or invalid function name")])])
        badB.NewRet(v) // never reached: js_phcbfail throws
