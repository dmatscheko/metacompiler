            }
            // A by-value loop variable that is a reference is assigned through it.
            return setVar(b, ref.name, v)
        }
        // A computed name ($$n, $GLOBALS[e]) has no path to walk.
        if (ref.path.length == 0 && ref.sbase == undefined && ref.headT == undefined) {
