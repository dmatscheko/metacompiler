    // control signal instead of a ret/br (see compile-core inCtlBody / excDispatch).
    // curFTag is saved/restored for EVERY function so a return inside a function defined
    // inside a try body targets that inner function, not the try (this is the only
    // function-body emitter in this grammar).
    function emitFunc(params, bodyStmt, isMethod, isCtl) {
        funcCount++
        var idx = funcCount
        var savedTag = curFTag
        var f = m.NewFunc("jsf_" + idx, i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var savedF = curF
        var savedScope = curScopeV
        var savedLoops = loopStack
        curF = f
        curFTag = idx
        loopStack = []
        if (isCtl) { ctlEnter(idx) }
        var b = f.NewBlock("entry")
        curScopeV = callExt(b, "js_scope_new", [f.Params[0]])
        var off = 0
        if (isMethod) {
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "$this"), callExt(b, "js_arg", [f.Params[1], handle(0)])])
            off = 1
        }
        for (var i = 0; i < params.length; i++) {
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, params[i]),
                                         callExt(b, "js_arg", [f.Params[1], handle(i + off)])])
        }
        var endB = bodyStmt(b)
        endB.NewRet(hNull)
        if (isCtl) { ctlLeave() }
        curF = savedF
        curScopeV = savedScope
        loopStack = savedLoops
        curFTag = savedTag
        return idx
    }
    function makeFun(items) {
        var name = items[0]
        var params = []
        var body = null
        for (var i = 1; i < items.length; i++) {
            if (items[i].body != undefined) { body = items[i].body }
            else if (items[i].param != undefined) { params.push(items[i].param) }
        }
        return {name: name, params: params, body: body != null ? body : makeBody([])}
    }
    function makeDefStmt(fn) {
        return function(b) {
            var idx = emitFunc(fn.params, fn.body, false)
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, fn.name),
                                         callExt(b, "js_closure", [handle(idx), curScopeV])])
            return b
        }
    }
    // A property declaration reduced to {name, init}: the name without its '$' (that is
    // the key "$this->x" reads) and the default-value thunk, or null for a bare 'public
    // $x;' and for every 'static' property (no static model here).
    function makeProp(items) {
        var isStatic = false
        var pname = ""
        var init = null
        for (var i = 0; i < items.length; i++) {
            if (items[i].mod != undefined) {
                if (hasWord(items[i].mod, "static")) { isStatic = true }
            }
            else if (typeof items[i] == "string") { pname = items[i].substring(1) }
            else { init = items[i] }
        }
        if (isStatic || pname == "") { return null }
        return {name: pname, init: init}
    }
    function hasWord(s, w) {
        for (var i = 0; i + w.length <= s.length; i++) {
            if (s.substring(i, i + w.length) == w) { return true }
        }
        return false
    }
    // Declared instance-property defaults, by class, plus the extends edge. Both maps are
    // filled while the tags run and read back at EMIT time (buildMain is the Program tag,
    // so every class in the program is already recorded when the first `new` is emitted),
    // which is what lets makeNew replay a base class's defaults without a runtime walk.
    var classProps = {}
    var classSuper = {}
    function makeClassStmt(items) {
        var name = items[0]
        var methods = []
        var props = []
        var hasCtor = false
        var ext = ""
        for (var i = 1; i < items.length; i++) {
            if (items[i].method != undefined) {
                methods.push(items[i].method)
                if (items[i].method.name == "__construct") { hasCtor = true }
            }
            else if (items[i].ext != undefined) { ext = lastSeg(items[i].ext) }
            else if (items[i].propdecl != undefined && items[i].propdecl != null) {
                props.push(items[i].propdecl)
            }
        }
        classProps["$" + name] = props
        classSuper["$" + name] = ext
        return function(b) {
            var clsV = callExt(b, "js_obj_new", [])
            callExt(b, "js_set", [clsV, emitStr(b, "__isclass"), hTrue])
            callExt(b, "js_set", [clsV, emitStr(b, "__name"), emitStr(b, name)])
            // Single inheritance: the __super chain is what the runtime's method
            // dispatch (js_mcall / memberCall) walks, so `extends E` is one property.
            if (ext != "") {
                callExt(b, "js_set", [clsV, emitStr(b, "__super"),
                                      callExt(b, "js_scope_get", [curScopeV, emitStr(b, ext)])])
            }
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, name), clsV])
            for (var k = 0; k < methods.length; k++) {
                var idx = emitFunc(methods[k].params, methods[k].body, true)
                callExt(b, "js_set", [clsV, emitStr(b, methods[k].name),
                                      callExt(b, "js_closure", [handle(idx), curScopeV])])
            }
            if (!hasCtor && ext == "") {
                var emptyBody = function(bb) { return bb }
                var iidx = emitFunc([], emptyBody, true)
                callExt(b, "js_set", [clsV, emitStr(b, "__construct"),
                                      callExt(b, "js_closure", [handle(iidx), curScopeV])])
            }
            return b
        }
    }

    // ----- program entry & project-file imports -----
    // PHP has no importable builtins (count/strlen/... are always in scope), so every
    // include/require path is a project file. `require 'geomlib.php'` looks for geomlib.php
    // (a leading ./ dropped, a missing .php extension added) under the program's directory
    // and the -i roots (c.findImport). The file is parsed with this grammar and walked with
    // the same tags; its top-level thunks are stashed by buildMain (importDepth > 0) and
    // prepended to phpmain, so the included function / class declarations run before the
    // main file's code. A file is imported once; repeats and cycles are no-ops. The imported
    // names bind flat (global), like PHP require.
    core.stdlibImports = []
    var importedFiles = {}
    var importDepth = 0
    // imported files top-level items: stashImported / emitImported (compile-core)
    core.importFile = function(path, pos) {
        if (path.length >= 2 && path.charAt(0) == "." && path.charAt(1) == "/") { path = path.substring(2) }
        if (!(path.length >= 4 && path.substring(path.length - 4) == ".php")) { path = path + ".php" }
        var file = c.findImport(path)
        if (file == "") { return false }
        if (importedFiles["$" + file] == true) { return true }
        importedFiles["$" + file] = true
        var text = c.readFile(file)
        var asg = c.parse(c.agrammar, text, null, file)
        c.pushSource(file, text)
        importDepth = importDepth + 1
        c.compile(asg)
        importDepth = importDepth - 1
        c.popSource()
        return true
    }
    // ----- the built-in exception hierarchy -----
    // A namespace-qualified name (\RuntimeException, App\Boom) resolves on its last
    // segment, which is how the flat, global name model here can see \Exception at all.
    function lastSeg(s) {
        var out = s
        for (var i = 0; i < s.length; i++) {
            if (s.charCodeAt(i) == 92) { out = s.substring(i + 1) }
        }
        return out
    }
    // php-interpreter.abnf declares this same set with declBuiltinClass, and the two must
    // agree: real PHP 8 refuses to throw an object that does not implement Throwable, so a
    // program that throws anything at all needs `new Exception(...)` to resolve. Only the
    // two roots carry the methods; every derived class reaches them over __super, which is
    // the chain the runtime's own dispatch walks.
    var excRoots = ["Exception", "Error"]
    var excDerived = [["RuntimeException", "Exception"], ["LogicException", "Exception"],
                      ["InvalidArgumentException", "LogicException"], ["TypeError", "Error"],
                      ["ValueError", "Error"], ["DivisionByZeroError", "Error"]]
    // $this->name = args[idx] when that argument was passed, else the default. PHP's
    // Exception::__construct($message = "", $code = 0), written out as a branch because
    // the parameter binding here has no default-value model.
    function emitExcArg(b, idx, name, dflt) {
        var thisV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, "$this")])
        var argV = callExt(b, "js_arg", [curF.Params[1], handle(idx)])
        var gotB = curF.NewBlock("")
        var defB = curF.NewBlock("")
        var endB = curF.NewBlock("")
        b.NewCondBr(truthy(b, callExt(b, "js_ne", [argV, hUndef])), gotB, defB)
        callExt(gotB, "js_set", [thisV, emitStr(gotB, name), argV])
        gotB.NewBr(endB)
        callExt(defB, "js_set", [thisV, emitStr(defB, name), dflt(defB)])
        defB.NewBr(endB)
        return endB
    }
    function emitExcClass(b, name, superName) {
        var clsV = callExt(b, "js_obj_new", [])
        callExt(b, "js_set", [clsV, emitStr(b, "__isclass"), hTrue])
        callExt(b, "js_set", [clsV, emitStr(b, "__name"), emitStr(b, name)])
        if (superName != "") {
            callExt(b, "js_set", [clsV, emitStr(b, "__super"),
                                  callExt(b, "js_scope_get", [curScopeV, emitStr(b, superName)])])
        } else {
            var ctor = emitFunc([], function(bb) {
                bb = emitExcArg(bb, 1, "message", function(x) { return emitStr(x, "") })
                bb = emitExcArg(bb, 2, "code", function(x) { return emitNum(x, 0) })
                return bb
            }, true)
            callExt(b, "js_set", [clsV, emitStr(b, "__construct"),
                                  callExt(b, "js_closure", [handle(ctor), curScopeV])])
            callExt(b, "js_set", [clsV, emitStr(b, "getMessage"),
                                  callExt(b, "js_closure", [handle(emitExcGetter("message")), curScopeV])])
            callExt(b, "js_set", [clsV, emitStr(b, "getCode"),
                                  callExt(b, "js_closure", [handle(emitExcGetter("code")), curScopeV])])
        }
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, name), clsV])
        return b
    }
    function emitExcGetter(prop) {
        return emitFunc([], function(bb) {
            var thisV = callExt(bb, "js_scope_get", [curScopeV, emitStr(bb, "$this")])
            return retStmt(bb, callExt(bb, "js_get", [thisV, emitStr(bb, prop)]))
        }, true)
    }
    function emitExcClasses(b) {
        for (var i = 0; i < excRoots.length; i++) { b = emitExcClass(b, excRoots[i], "") }
        for (var j = 0; j < excDerived.length; j++) {
            b = emitExcClass(b, excDerived[j][0], excDerived[j][1])
        }
        return b
    }
    function buildMain(items) {
        // The walk of an imported file ends here too: stash its top-level thunks for the
        // real phpmain instead of emitting a second one.
        if (importDepth > 0) {
            stashImported(items) // stashed with its file; emitted later (compile-core)
            return
        }
        var f = m.NewFunc("phpmain", i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        curF = f
        var b = f.NewBlock("entry")
        curScopeV = callExt(b, "js_scope_new", [f.Params[0]])
        var mathV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, "Math")])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "abs"), callExt(b, "js_get", [mathV, emitStr(b, "abs")])])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "max"), callExt(b, "js_get", [mathV, emitStr(b, "max")])])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "min"), callExt(b, "js_get", [mathV, emitStr(b, "min")])])
        b = emitExcClasses(b) // Exception / Error and their subclasses
        b = emitImported(b)   // imported files' items, each under its own source
        b = makeSeq(items)(b)
        b.NewRet(handle(0))
    }

    core.scopeGetExt = "js_scope_get"

    c.compile(c.asg)

    println(m)

    var res = llvm.RunJS(m, "phpmain")
    println("php compiler: phpmain() returned " + res.Ret)
    exit(res.Ret)

~~) ;
