    // program's code; the functions it names follow the same way
    // (lib/php-stdlib-index.js). A direct call of a native is lowered inline and
    // does not load it; a native taken as a VALUE (a string callable, f(...)) is
    // the library's wrapper function of the same name. A library class is compiled
    // before the walk of any text that spells its name. Twin of phpLibRef in
    // php-interpreter.abnf.
    var phpLib = null
    var phpLibDone = {}
    var phpLibBase = true
    // A string literal may also name a Closure method a callback reaches
    // ([$c, 'bindTo']), which arms cloRebind as ->bindTo does.
    function phpLibRef(name, viaCall) {
        if (viaCall && hasBuiltin(name)) { return name }
        var lcn = phsCase(name, false)
        if (!viaCall && (lcn == "bindto" || lcn == "bind" || lcn == "call")) { cloRebind = true }
        if (phpLib == null) { phpLib = phpLibIndex(load("lib/php-stdlib.php")) }
        phpLibLoad(phpLibKey(phpLib, name))
