        var rest = -1
        var pendingRef = false
        var pendingRest = false
        for (var i = 0; i < items.length; i++) {
            if (items[i] == undefined) { continue }
            if (items[i].pref != undefined) { pendingRef = true }
            else if (items[i].prest != undefined) { pendingRest = true }
            else if (items[i].param != undefined) {
