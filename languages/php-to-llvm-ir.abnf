        for (var i = 0; i < items.length; i++) {
            if (items[i].sbase != undefined) { out.base = staticBaseThunk(items[i].sbase) }
            else if (items[i].smem != undefined) { out.mem = items[i].smem }
            else if (items[i].sargs != undefined) { out.args = items[i].sargs }
        }
        return out
    }
    // One match arm: the conditions it answers to (empty for 'default') and its body.
    function makeArm(items) {
        var conds = []
        var body = null
        var isDflt = false
        for (var i = 0; i < items.length; i++) {
            if (items[i].mdflt != undefined) { isDflt = true }
            else if (items[i].mcond != undefined) { conds.push(items[i].mcond) }
            else if (items[i].mbody != undefined) { body = items[i].mbody }
        }
        return {conds: conds, body: body, isDflt: isDflt}
    }
    function makeMatch(items) {
        var subj = items[0]
        var arms = items.slice(1)
        return function(b) {
            var rs = subj(b)
            b = rs.b
            var sv = rs.v
            var mergeB = curF.NewBlock("")
            var incs = []
            var dflt = null
            for (var d = 0; d < arms.length; d++) { if (arms[d].isDflt) { dflt = arms[d] } }
            for (var a = 0; a < arms.length; a++) {
                if (arms[a].isDflt) { continue }
                var bodyB = curF.NewBlock("")
                for (var k = 0; k < arms[a].conds.length; k++) {
                    var rc = arms[a].conds[k](b)
                    b = rc.b
                    var nextB = curF.NewBlock("")
                    b.NewCondBr(truthy(b, callExt(b, "js_phseq", [sv, rc.v])), bodyB, nextB)
                    b = nextB
                }
                var rb = arms[a].body(bodyB)
                rb.b.NewBr(mergeB)
                incs.push(llvm.ir.NewIncoming(rb.v, rb.b))
            }
            if (dflt != null) {
                var rd = dflt.body(b)
                rd.b.NewBr(mergeB)
                incs.push(llvm.ir.NewIncoming(rd.v, rd.b))
            } else {
                incs.push(llvm.ir.NewIncoming(hNull, b))
                b.NewBr(mergeB)
            }
            return {b: mergeB, v: mergeB.NewPhi(incs)}
        }
    }
    function makeStaticExpr(items) {
        var p = staticParts(items)
        return emitStaticAccess(p.base, p.mem, p.args)
    }
    // As a chain suffix the base is whatever the chain produced so far.
    function makeStaticSfx(items) {
        var p = staticParts(items)
        var mem = p.mem
        var args = p.args
        return {kind: "static", run: function(b) { return {b: b, v: hNull} }, sfxMem: mem, sfxArgs: args}
    }
    function makeStaticHead(items) {
        var p = staticParts(items)
        return {var: "\x00staticprop", sbase: p.base, sname: p.mem.charAt(0) == "$" ? p.mem.substring(1) : p.mem}
    }
    function makeClone(t) {
        return function(b) {
            var r = t(b)
            return {b: r.b, v: callExt(r.b, "js_phclone", [r.v])}
        }
    }
    // An interface: a descriptor with __isiface, its parent interfaces and its
    // constants. Methods are declarations only and are not emitted - dispatch always
    // walks the instance's own class chain, never an interface.
    function makeIfaceStmt(items) {
        var name = items[0]
        var parents = []
        var consts = []
        for (var i = 1; i < items.length; i++) {
            if (items[i].impl != undefined) { parents.push(lastSeg(stripWs(items[i].impl))) }
            else if (items[i].cconsts != undefined) {
                var cs = items[i].cconsts
                for (var q = 0; q < cs.length; q++) { consts.push(cs[q]) }
            }
        }
        return function(b) {
            var clsV = callExt(b, "js_obj_new", [])
            callExt(b, "js_set", [clsV, emitStr(b, "__isclass"), hTrue])
            callExt(b, "js_set", [clsV, emitStr(b, "__isiface"), hTrue])
            callExt(b, "js_set", [clsV, emitStr(b, "__name"), emitStr(b, name)])
            b = emitIfaceList(b, clsV, parents)
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, name), clsV])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, frameClsName("self")), clsV])
            for (var c1 = 0; c1 < consts.length; c1++) {
                var cv = hNull
                if (consts[c1].cinit != null) { var rc = consts[c1].cinit(b); b = rc.b; cv = rc.v }
                callExt(b, "js_set", [clsV, emitStr(b, "k:" + consts[c1].cname), cv])
