        // A '=>' whose value side is a pattern leaves exactly one slot AND a pattern.
        if (slots.length == 1 && pat == null) { valName = slots[0] }
        else if (slots.length == 1) { keyName = slots[0] }
        else if (slots.length > 1) { keyName = slots[0]; valName = slots[1] }
