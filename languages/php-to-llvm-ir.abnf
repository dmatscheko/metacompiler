    // name is null for a computed one; thisLex says the receiver is '$this' as
    // written; isMode is the read of '??' (BP_VAR_IS).
    function emitPropGet(b, objV, keyV, name, thisLex, isMode) {
        if (isHooked(name)) {
            var hn = emitStr(b, "__hget_" + name)
            var hm = emitHasMethod(b, objV, hn)
            b = hm.b
            var hookB = curF.NewBlock("")
            var plainB = curF.NewBlock("")
            var joinB = curF.NewBlock("")
            b.NewCondBr(truthy(b, hm.v), hookB, plainB)
            var hv = callExt(hookB, "js_phmcall", [objV, hn, callExt(hookB, "js_arr_new", [])])
            hookB.NewBr(joinB)
