            for (var k = 0; k < items.length; k++) {
                if (items[k].hk != undefined) {
                    // The key is evaluated before a by-reference target (zend_compile_array).
                    var rk = items[k].hk(b); b = rk.b
                    var rv = items[k].hr != undefined ? targetCell(b, items[k].hr) : items[k].hv(b); b = rv.b
                    if (items[k].hr != undefined) { callExt(b, "js_phrebind", [hUndef, rv.v]) }
                    callExt(b, "js_phset", [d, rk.v, rv.v])
                } else if (items[k].er != undefined) {
                    var rc = targetCell(b, items[k].er); b = rc.b
                    callExt(b, "js_phrebind", [hUndef, rc.v])
                    callExt(b, "js_phpush", [d, rc.v])
                } else if (items[k].spread != undefined) {
                    var rs = items[k].spread(b); b = rs.b
                    callExt(b, "js_phmerge", [d, rs.v])
                } else {
