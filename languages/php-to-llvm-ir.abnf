    // ----- string helpers -----
    // The double-quoted / heredoc escape set. PHP keeps an UNKNOWN escape as BOTH
    // characters ("\q" is a backslash and a q, two bytes), which is why there is no
    // default branch that drops the backslash.
    function unescapeDq(s) {
        var out = ""
        var i = 0
        while (i < s.length) {
            var c = s.charCodeAt(i)
            if (c != 92 || i + 1 >= s.length) { out += String.fromCharCode(c); i++; continue }
            var e = s.charAt(i + 1)
            if (e == "n") { out += "\n"; i += 2; continue }
            if (e == "t") { out += "\t"; i += 2; continue }
            if (e == "r") { out += "\r"; i += 2; continue }
            if (e == "v") { out += String.fromCharCode(11); i += 2; continue }
            if (e == "e") { out += String.fromCharCode(27); i += 2; continue }
            if (e == "f") { out += String.fromCharCode(12); i += 2; continue }
            if (e == "\\") { out += "\\"; i += 2; continue }
            if (e == "$") { out += "$"; i += 2; continue }
            if (e == "\"") { out += "\""; i += 2; continue }
            if (e >= "0" && e <= "7") {
                var v = 0
                var n = 0
                var j = i + 1
                while (n < 3 && j < s.length && s.charAt(j) >= "0" && s.charAt(j) <= "7") {
                    v = v * 8 + (s.charCodeAt(j) - 48)
                    j++
                    n++
                }
                out += String.fromCharCode(v % 256)
                i = j
                continue
            }
            if (e == "x") {
                var hv = 0
                var hn = 0
                var hj = i + 2
                while (hn < 2 && hj < s.length && isHexCh(s.charAt(hj))) { hv = hv * 16 + hexVal(s.charAt(hj)); hj++; hn++ }
                if (hn > 0) { out += String.fromCharCode(hv); i = hj; continue }
            }
            if (e == "u" && i + 2 < s.length && s.charAt(i + 2) == "{") {
                var uv = 0
                var uj = i + 3
                var un = 0
                while (uj < s.length && isHexCh(s.charAt(uj))) { uv = uv * 16 + hexVal(s.charAt(uj)); uj++; un++ }
                if (un > 0 && uj < s.length && s.charAt(uj) == "}") {
