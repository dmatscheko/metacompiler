    // variable is a single js_scope_decl; anything else is an ordinary assignment
    // target and goes through the path walk.
    // isRef: v is the element's cell ('as &$v').
    function emitFeBind(b, ref, v, isRef) {
        if (ref == null) { return b }
        if (ref.path.length == 0 && ref.sbase == undefined && ref.headT == undefined && ref.nameT == null
            && ref.gkey == undefined) {
            if (isRef === true) {
                bindRefIn(b, curScopeV, emitStr(b, ref.name), v)
