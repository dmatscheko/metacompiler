    // try/catch/finally: each body compiles to its own IR closure handed to js_try. The
    // try and catch bodies are ctl closures, so a return/break/continue leaving them
    // becomes a control signal that excDispatch re-issues here; the finally is a plain
    // closure (its value is discarded by js_try).
    // This makeCatch replaces the shared one (lib/compile-core.js): a PHP catch clause
    // carries its type list, so the clauses can be discriminated.
    makeCatch = function(items) {
        var types = []
        var nm = anytype
        var body = null
        for (var i = 0; i < items.length; i++) {
            if (items[i] != undefined && items[i].ctype != undefined) { types.push(items[i].ctype) }
            else if (typeof items[i] == "string") { nm = items[i] }
            else { body = items[i] }
        }
        return {catchbody: body, catchname: nm, catchtype: types}
    }
    // All catch clauses become ONE closure: it tests each clause's type list in order,
    // binds the clause's variable and runs its body; a value that matches none is
    // re-thrown, which is what makes an outer try see it.
    function makeCatchDispatch(catches) {
        return function(b) {
            var caught = callExt(b, "js_scope_get", [curScopeV, emitStr(b, "0caught")])
            var endB = curF.NewBlock("")
            for (var i = 0; i < catches.length; i++) {
                var tv = callExt(b, "js_pharr", [])
                var ts = catches[i].catchtype
                for (var k = 0; k < ts.length; k++) {
                    callExt(b, "js_phpush", [tv, emitStr(b, ts[k])])
                }
                var thenB = curF.NewBlock("")
                var nextB = curF.NewBlock("")
                b.NewCondBr(truthy(b, callExt(b, "js_phcatch", [caught, tv])), thenB, nextB)
                if (catches[i].catchname != undefined) {
