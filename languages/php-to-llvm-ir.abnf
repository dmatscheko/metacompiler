        funcCount++
        var mnIdx = funcCount
        var mnf = m.NewFunc("jsf_" + mnIdx, i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var mnb = mnf.NewBlock("entry")
        mnb.NewRet(callExt(mnb, "js_phmissname",
                           [callExt(mnb, "js_arg", [mnf.Params[1], handle(0)])]))
