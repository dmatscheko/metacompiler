    // foreach over something that MAY be a generator. One loop drives both: an array
    // is walked by index, a generator by its next() handshake (so its body really is
    // suspended and resumed, and a break leaves it parked rather than draining it).
    // The generator's key is the one a 'yield k => v' put in the marker record, or the
    // running count when the yield had no key - PHP's auto-keys.
    // This shape is emitted only for a program that contains a yield somewhere;
    // everything else keeps the plain index loop.
    // One step of a generator: {value, done}. js_phmcall dispatches a generator's own
    // protocol (memberCall's *jsGenerator case), so this is an ordinary method call.
    // The key of a KEYLESS yield is the generator's own: the next integer after the
    // largest one used so far, explicit keys included (Generator::key()).
    function genAutoKey(b, itN) {
        var genV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, itN)])
        return callExt(b, "js_phmcall", [genV, emitStr(b, "key"), callExt(b, "js_arr_new", [])])
    }
    function genNext(b, genV) {
        return callExt(b, "js_phmcall", [genV, emitStr(b, "next"), callExt(b, "js_arr_new", [])])
    }
    // 'yield from SRC': every element of SRC is yielded in turn, WITH ITS OWN KEY -
    // PHP forwards the inner keys, which is what makes a delegating generator
    // indistinguishable from the one it delegates to. SRC may be an array or another
    // GENERATOR, so the loop is the same dual walk foreach uses: an array by index, a
    // generator through its next() handshake (so a delegated-to generator stays lazy).
    // In a program with iterators an Iterator (or an IteratorAggregate's) is walked
    // the way foreach walks one (feStep).
    // Deviation: the expression's own value (a sub-generator's return) is not
    // propagated, exactly as in php-interpreter.abnf.
    function emitYieldFrom(b, srcV) {
        hidCount++
        var itN = "\x00yi" + hidCount
        var ixN = "\x00yx" + hidCount
        var stN = "\x00ys" + hidCount
        var gnN = "\x00yg" + hidCount
        var lnN = "\x00yl" + hidCount
        if (usesIter) { srcV = callExt(b, "js_phfeobj", [srcV, hNull, hFalse]) }
        var isGen = callExt(b, "js_phisa", [srcV, emitStr(b, "Generator")])
        if (usesIter) {
