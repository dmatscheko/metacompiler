    // name fires before the body's tags, so a __FUNCTION__ inside it sees the right
    // name. A closure keeps the enclosing name (PHP says "{closure}"), the one
    // deviation.
    var walkFnName = ""
    function noteFnName(n) { walkFnName = n; return n }
