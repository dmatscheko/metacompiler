        jumpGoto(name)
        return function(b) {
            var n = labelIds["$" + name]
            if (n == undefined) { fail("goto to an unknown label " + name) }
            var t = curFTag
            while (t != ctlLabels[n].tag) {
                t = ctlOuterTag["$" + t]
                if (t == undefined) { fail("goto " + name + " into a try/catch/finally body is not supported") }
            }
            emitGoto(b, n)
            return deadBlock()
