            if (ext == "mcall" && anyMVis) { res = callExt(bb, "js_phmcallv", [selfV, nmV, bf.Params[1], dsc]) }
            else if (ext == "mcall") { res = callExt(bb, "js_phmcall", [selfV, nmV, bf.Params[1]]) }
            else if (ext == "scallvia") {
