    // ----- generators -----------------------------------------------------------
    // usesYield is program wide (it decides whether foreach has to be able to drive a
    // generator at all); sawYield is per function body and tells the emitter of the
    // function currently being built whether to wrap its closure in js_genfn.
    var usesYield = false
    // A program that implements Iterator or IteratorAggregate drives foreach
    // through that same two-way walk, the iterator's methods standing in for a
    // generator's next() (js_phfestep).
    var usesIter = false
    function noteIterIface(name) {
        if (name == "Iterator" || name == "IteratorAggregate") { usesIter = true }
        return name
    }
