    function cbClsChk(f, b, env, where, clsV, mnV, cnV, formV, okB) {
        var thisV = b.NewCall(scopeProbeFn(), [env, emitStr(b, "$this"), hUndef])
        var selfV = b.NewCall(scopeProbeFn(), [env, emitStr(b, frameClsName("self")), hNull])
        var hid = callExt(b, "js_phcbcls", [where, clsV, mnV, cnV, thisV, selfV, formV])
        var contB = f.NewBlock("")
        b.NewCondBr(b.NewICmp(llvm.enum.IPredEQ, hid, hTrue), okB, contB)
        return contB
    }
    function emitCbCheckFn() {
        var f = m.NewFunc("php_cbcheck", i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("v", i64),
                                               llvm.ir.NewParam("where", i64), llvm.ir.NewParam("ns", i64),
                                               llvm.ir.NewParam("form", i64)])
        var env = f.Params[0]
        var v = f.Params[1]
        var where = f.Params[2]
        var ns = f.Params[3]
        var eb = f.NewBlock("entry")
        var okB = f.NewBlock("ok")
        okB.NewRet(v)
        var strB = f.NewBlock("str")
        var notStrB = f.NewBlock("notstr")
        eb.NewCondBr(truthy(eb, callExt(eb, "js_phis", [emitStr(eb, "string"), v])), strB, notStrB)
        // A string: a function's name, else 'C::m'.
