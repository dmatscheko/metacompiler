            if (refT) { curWrites["*"] = true }
            var r = srcT(b)
            var scope = scopeProbe(r.b, emitStr(r.b, frameClsName("self")), hNull)
            return {b: r.b, v: callExt(r.b, "js_phfeobj", [r.v, scope, refT ? hTrue : hFalse])}
        }
