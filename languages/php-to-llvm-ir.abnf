DElem       = DKeyed | DPlain ;
DKeyed      <~~ var dv = pop(); push({dkey: pop(), dval: dv}) ~~>
            = Expression "=>" DValue ;
DPlain      <~~ push({dval: pop()}) ~~>
            = DValue ;
DValue      = DestructPat | DTarget ;
DTarget     <~~ push({dt: pop()}) ~~>
            = Target ;

// cond ? a : b  /  cond ?: b (Elvis, yields cond when truthy) ; '??' null-coalescing
// binds tighter than the ternary but looser than ||.
