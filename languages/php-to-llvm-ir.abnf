    // segment, which is how the flat, global name model here can see \Exception at all.
    function lastSeg(s) {
        var out = s
        for (var i = 0; i < s.length; i++) {
            if (s.charCodeAt(i) == 92) { out = s.substring(i + 1) }
        }
        return out
    }
    // self, static and parent are case-insensitive like every class name: a name
    // that spells one in any case answers it in lower case. Twin of relName in
    // php-interpreter.abnf.
    function relName(n) {
        if (n.length != 4 && n.length != 6) { return n }
        var lc = phsCase(n, false)
        return (lc == "self" || lc == "static" || lc == "parent") ? lc : n
    }
    // php-interpreter.abnf declares this same set with declBuiltinClass, and the two must
    // agree: real PHP 8 refuses to throw an object that does not implement Throwable, so a
    // program that throws anything at all needs `new Exception(...)` to resolve. Only the
    // two roots carry the methods; every derived class reaches them over __super, which is
    // the chain the runtime's own dispatch walks.
    var excRoots = ["Exception", "Error"]
    var excDerived = [["RuntimeException", "Exception"], ["LogicException", "Exception"],
                      ["InvalidArgumentException", "LogicException"], ["TypeError", "Error"],
                      ["ValueError", "Error"], ["ArithmeticError", "Error"],
                      ["DivisionByZeroError", "ArithmeticError"]]
    for (var exr = 0; exr < excRoots.length; exr++) {
        srcClasses["$" + excRoots[exr]] = true
        engineClasses["$" + phsCase(excRoots[exr], false)] = true
    }
    for (var exd = 0; exd < excDerived.length; exd++) {
        srcClasses["$" + excDerived[exd][0]] = true
        engineClasses["$" + phsCase(excDerived[exd][0], false)] = true
    }
    // $this->name = args[idx] when that argument was passed, else the default. PHP's
    // Exception::__construct($message = "", $code = 0), written out as a branch because
    // the parameter binding here has no default-value model.
    function emitExcArg(b, idx, name, dflt) {
        var thisV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, "$this")])
        var argV = callExt(b, "js_arg", [curF.Params[1], handle(idx)])
        var gotB = curF.NewBlock("")
        var defB = curF.NewBlock("")
        var endB = curF.NewBlock("")
        b.NewCondBr(truthy(b, callExt(b, "js_ne", [argV, hUndef])), gotB, defB)
        callExt(gotB, "js_set", [thisV, emitStr(gotB, name), argV])
        gotB.NewBr(endB)
        callExt(defB, "js_set", [thisV, emitStr(defB, name), dflt(defB)])
        defB.NewBr(endB)
        return endB
    }
    function emitExcClass(b, name, superName) {
        var clsV = callExt(b, "js_obj_new", [])
        callExt(b, "js_set", [clsV, emitStr(b, "__isclass"), hTrue])
        callExt(b, "js_set", [clsV, emitStr(b, "__name"), emitStr(b, name)])
        if (superName != "") {
            callExt(b, "js_set", [clsV, emitStr(b, "__super"),
                                  callExt(b, "js_scope_get", [curScopeV, emitStr(b, superName)])])
        } else {
            var ctor = emitFunc([], function(bb) {
                bb = emitExcArg(bb, 1, "message", function(x) { return emitStr(x, "") })
                bb = emitExcArg(bb, 2, "code", function(x) { return emitNum(x, 0) })
                return bb
            }, true)
            callExt(b, "js_set", [clsV, emitStr(b, "__construct"),
                                  callExt(b, "js_closure", [handle(ctor), curScopeV])])
            callExt(b, "js_set", [clsV, emitStr(b, "getMessage"),
                                  callExt(b, "js_closure", [handle(emitExcGetter("message")), curScopeV])])
            callExt(b, "js_set", [clsV, emitStr(b, "getCode"),
                                  callExt(b, "js_closure", [handle(emitExcGetter("code")), curScopeV])])
            callExt(b, "js_set", [clsV, emitStr(b, "__mlc"), emitStr(b, ",__construct,getmessage,getcode,")])
            // Both roots implement Throwable, listed as the bare name js_phisa matches.
            var ifV = callExt(b, "js_pharr", [])
            callExt(b, "js_phpush", [ifV, emitStr(b, "Throwable")])
            callExt(b, "js_set", [clsV, emitStr(b, "__ifaces"), ifV])
