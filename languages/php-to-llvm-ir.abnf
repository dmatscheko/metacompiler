        if (name == "is_float" || name == "is_double") { return "float" }
        if (name == "is_string") { return "string" }
        if (name == "is_bool") { return "bool" }
        if (name == "is_array") { return "array" }
        if (name == "is_object") { return "object" }
        if (name == "is_null") { return "null" }
        if (name == "is_numeric") { return "numeric" }
        return ""
