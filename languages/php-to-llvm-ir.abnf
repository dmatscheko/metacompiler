    // name from the scope it closes over. fake says it is a closure PHP makes from
    // the callable, one Closure::bind can rebind (bindMethodSig).
    var boundDynIdx = {}
    function boundDyn(b, env, ext, recvV, nameV, thisV, lsbV, fake) {
        if (boundDynIdx[ext] == undefined) {
            funcCount++
            var idx = funcCount
            var bf = m.NewFunc("jsf_" + idx, i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
            var bb = bf.NewBlock("entry")
            var selfV = callExt(bb, "js_scope_get", [bf.Params[0], emitStr(bb, "\x00dcrecv")])
            var nmV = callExt(bb, "js_scope_get", [bf.Params[0], emitStr(bb, "\x00dcname")])
            var dsc = anyMVis ? callExt(bb, "js_scope_get", [bf.Params[0], emitStr(bb, "\x00dcscope")]) : hNull
