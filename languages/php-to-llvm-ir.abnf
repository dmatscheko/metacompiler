    // does NOT abort on an unknown name (js_phclslookup answers null), so a program
    // that reads a constant this subset does not model degrades instead of failing.
    function makeConstRef(name) {
        if (name == "__FUNCTION__" || name == "__METHOD__") { return makeConst(walkFnName) }
        if (name == "__CLASS__") {
            return function(b) {
                return {b: b, v: callExt(b, "js_get", [frameCls(b, "self"), emitStr(b, "__name")])}
            }
        }
        return function(b) {
            return {b: b, v: callExt(b, "js_phclslookup", [curScopeV, emitStr(b, name)])}
