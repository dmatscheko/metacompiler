    // if / elseif / else -- a statement; each branch body is a statement thunk.
    makeIf = function(items) {
        var branches = [{cond: items[0], body: items[1].body}]
        var els = null
        for (var i = 2; i < items.length; i++) {
            if (items[i].els != undefined) { els = items[i].els }
            else { branches.push({cond: items[i].elifCond, body: items[i].elifBody}) }
        }
        return function(b) {
            var endB = curF.NewBlock("")
            for (var a = 0; a < branches.length; a++) {
                var rc = branches[a].cond(b)
                b = rc.b
                var thenBk = curF.NewBlock("")
                var nextBk = curF.NewBlock("")
                b.NewCondBr(truthy(b, rc.v), thenBk, nextBk)
                branches[a].body(thenBk).NewBr(endB)
                b = nextBk
            }
            if (els != null) { els(b).NewBr(endB) }
            else { b.NewBr(endB) }
            return endB
        }
    }
    // for (init; cond; post) { body } -- no new scope: PHP for-vars are function
    // scoped (matches the interpreter).
    function makeFor(items) {
        var body = null
        var init = null
        var cond = null
        var post = null
        for (var i = 0; i < items.length; i++) {
            if (items[i].body != undefined) { body = items[i].body }
            else if (items[i].k == "init") { init = items[i].t }
            else if (items[i].k == "cond") { cond = items[i].t }
            else if (items[i].k == "post") { post = items[i].t }
        }
        return function(b) {
            if (init != null) { b = init(b) }
            var headB = curF.NewBlock("")
            var bodyB = curF.NewBlock("")
            var postB = curF.NewBlock("")
            var exitB = curF.NewBlock("")
            b.NewBr(headB)
            if (cond != null) {
                var r = cond(headB)
                r.b.NewCondBr(truthy(r.b, r.v), bodyB, exitB)
            } else {
                headB.NewBr(bodyB)
            }
            loopStack.push({cont: postB, brk: exitB})
            body(bodyB).NewBr(postB)
            loopStack.pop()
            var pb = postB
            if (post != null) { pb = post(postB) }
            pb.NewBr(headB)
            return exitB
        }
    }
    // foreach over indexed arrays (key = index) and ordered maps (key/value),
    // uniformly via js_range_len / js_range_key / js_range_val.
    function makeForeach(items) {
        var iterT = items[0]
        var keyName = null
        var valName = null
        var pat = null
        var body = null
        var byRef = false
        for (var i = 1; i < items.length; i++) {
            if (items[i].body != undefined) { body = items[i].body }
            else if (items[i].v1 != undefined) { valName = items[i].v1 }
            else if (items[i].v2 != undefined) { keyName = items[i].v2 }
            else if (items[i].pat != undefined) { pat = items[i].pat }
            else if (items[i].feref != undefined) { byRef = true }
        }
        // Which loop shape to emit is decided at EMIT time, not here: usesYield is only
        // final once the whole program has been walked, and a foreach written BEFORE the
        // first generator function in the file would otherwise get the plain index loop.
        var genT = makeForeachGen(iterT, keyName, valName, pat, body, byRef)
        return function(b) {
            if (usesYield) { return genT(b) }
            var ir = iterT(b)
            b = ir.b
            hidCount++
            var itName = "0fe_it" + hidCount
            var lenName = "0fe_len" + hidCount
            var iName = "0fe_i" + hidCount
            callExt(b, "js_pyset_var", [curScopeV, emitStr(b, itName), ir.v])
            callExt(b, "js_pyset_var", [curScopeV, emitStr(b, lenName), callExt(b, "js_range_len", [ir.v])])
            callExt(b, "js_pyset_var", [curScopeV, emitStr(b, iName), emitNum(b, 0)])
            var headB = curF.NewBlock("")
            var bodyB = curF.NewBlock("")
            var postB = curF.NewBlock("")
            var exitB = curF.NewBlock("")
            b.NewBr(headB)
            var iV = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, iName)])
            var lenV = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, lenName)])
            headB.NewCondBr(truthy(headB, callExt(headB, "js_lt", [iV, lenV])), bodyB, exitB)
            var itV = callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, itName)])
            var iB = callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, iName)])
            var elemV = anytype
            if (byRef) {
                // 'as &$v' binds the variable to the element's storage cell, so a
                // write to $v lands in the array.
                elemV = elemCell(bodyB, itV, callExt(bodyB, "js_range_key", [itV, iB]))
            } else {
                var rel = phDeref(bodyB, callExt(bodyB, "js_range_val", [itV, iB]))
                bodyB = rel.b
                elemV = callExt(bodyB, "js_phcopy", [rel.v])
            }
            if (pat != null) {
                bodyB = emitBindPattern(bodyB, pat, elemV)
            } else if (keyName != null) {
                callExt(bodyB, "js_pyset_var", [curScopeV, emitStr(bodyB, valName), callExt(bodyB, "js_range_key", [itV, iB])])
                callExt(bodyB, "js_pyset_var", [curScopeV, emitStr(bodyB, keyName), elemV])
            } else {
                callExt(bodyB, "js_pyset_var", [curScopeV, emitStr(bodyB, valName), elemV])
            }
            loopStack.push({cont: postB, brk: exitB})
            body(bodyB).NewBr(postB)
            loopStack.pop()
            var iP = callExt(postB, "js_scope_get", [curScopeV, emitStr(postB, iName)])
            callExt(postB, "js_pyset_var", [curScopeV, emitStr(postB, iName),
                                            intWrap(postB, callExt(postB, "js_jadd", [iP, emitNum(postB, 1)]))])
            postB.NewBr(headB)
            return exitB
        }
    }

    // ----- generators -----------------------------------------------------------
    // usesYield is program wide (it decides whether foreach has to be able to drive a
    // generator at all); sawYield is per function body and tells the emitter of the
    // function currently being built whether to wrap its closure in js_genfn.
    var usesYield = false
    var sawYield = false
    var genClosure = false
    function makeYieldArg(items) {
        if (items.length == 1) { return {yval: items[0]} }
        return {ykey: items[0], yval: items[1]}
    }
    function makeYield(items) {
        usesYield = true
        var fromT = null
        var keyT = null
        var valT = null
        for (var i = 0; i < items.length; i++) {
            if (items[i] == undefined) { continue }
            if (items[i].yfrom != undefined) { fromT = items[i].yfrom }
            else if (items[i].yval != undefined) { valT = items[i].yval; keyT = items[i].ykey }
        }
        return function(b) {
            sawYield = true
            if (fromT != null) {
                var rf = fromT(b)
                b = rf.b
                return {b: emitYieldFrom(b, rf.v), v: hNull}
            }
            var v = hNull
            if (valT != null) { var rv = valT(b); b = rv.b; v = rv.v }
            if (keyT != null) {
                var rk = keyT(b)
                b = rk.b
                var pair = callExt(b, "js_obj_new", [])
                callExt(b, "js_set", [pair, emitStr(b, "__genkv"), hTrue])
                callExt(b, "js_set", [pair, emitStr(b, "k"), rk.v])
                callExt(b, "js_set", [pair, emitStr(b, "v"), v])
                v = pair
            }
            return {b: b, v: callExt(b, "js_yield", [v])}
        }
    }

    // foreach over something that MAY be a generator. One loop drives both: an array
    // is walked by index, a generator by its next() handshake (so its body really is
    // suspended and resumed, and a break leaves it parked rather than draining it).
    // The generator's key is the one a 'yield k => v' put in the marker record, or the
    // running count when the yield had no key - PHP's auto-keys.
    // This shape is emitted only for a program that contains a yield somewhere;
    // everything else keeps the plain index loop.
    // One step of a generator: {value, done}. js_mcall dispatches a generator's own
    // protocol (memberCall's *jsGenerator case), so this is an ordinary method call.
    function genNext(b, genV) {
        return callExt(b, "js_mcall", [genV, emitStr(b, "next"), callExt(b, "js_arr_new", [])])
    }
    // 'yield from SRC': every element of SRC is yielded in turn, WITH ITS OWN KEY -
    // PHP forwards the inner keys, which is what makes a delegating generator
    // indistinguishable from the one it delegates to. SRC may be an array or another
    // GENERATOR, so the loop is the same dual walk foreach uses: an array by index, a
    // generator through its next() handshake (so a delegated-to generator stays lazy).
    // Deviation: the expression's own value (a sub-generator's return) is not
    // propagated, exactly as in php-interpreter.abnf.
    function emitYieldFrom(b, srcV) {
        hidCount++
        var itN = "\x00yi" + hidCount
        var ixN = "\x00yx" + hidCount
        var stN = "\x00ys" + hidCount
        var gnN = "\x00yg" + hidCount
        var lnN = "\x00yl" + hidCount
        var isGen = callExt(b, "js_phisa", [srcV, emitStr(b, "Generator")])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, itN), srcV])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, ixN), emitNum(b, 0)])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, stN), hUndef])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, lnN), emitNum(b, 0)])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, gnN), isGen])
        var startG = curF.NewBlock("")
        var startA = curF.NewBlock("")
        var headB = curF.NewBlock("")
        b.NewCondBr(truthy(b, isGen), startG, startA)
        callExt(startG, "js_scope_set", [curScopeV, emitStr(startG, stN), genNext(startG, srcV)])
        startG.NewBr(headB)
        callExt(startA, "js_scope_set", [curScopeV, emitStr(startA, lnN),
                                         callExt(startA, "js_range_len", [srcV])])
        startA.NewBr(headB)
        var bodyB = curF.NewBlock("")
        var postB = curF.NewBlock("")
        var exitB = curF.NewBlock("")
        var gHead = curF.NewBlock("")
        var aHead = curF.NewBlock("")
        headB.NewCondBr(truthy(headB, callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, gnN)])), gHead, aHead)
        var stH = callExt(gHead, "js_scope_get", [curScopeV, emitStr(gHead, stN)])
        gHead.NewCondBr(truthy(gHead, callExt(gHead, "js_get", [stH, emitStr(gHead, "done")])), exitB, bodyB)
        var iH = callExt(aHead, "js_scope_get", [curScopeV, emitStr(aHead, ixN)])
        var lH = callExt(aHead, "js_scope_get", [curScopeV, emitStr(aHead, lnN)])
        aHead.NewCondBr(truthy(aHead, callExt(aHead, "js_lt", [iH, lH])), bodyB, exitB)
        var gBody = curF.NewBlock("")
        var aBody = curF.NewBlock("")
        var kvB = curF.NewBlock("")
        var plainB = curF.NewBlock("")
        var joinB = curF.NewBlock("")
        var bindB = curF.NewBlock("")
        bodyB.NewCondBr(truthy(bodyB, callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, gnN)])), gBody, aBody)
        var stB = callExt(gBody, "js_scope_get", [curScopeV, emitStr(gBody, stN)])
        var rawV = callExt(gBody, "js_get", [stB, emitStr(gBody, "value")])
        gBody.NewCondBr(truthy(gBody, callExt(gBody, "js_phisset", [rawV, emitStr(gBody, "__genkv")])), kvB, plainB)
        var kvK = callExt(kvB, "js_get", [rawV, emitStr(kvB, "k")])
        var kvV = callExt(kvB, "js_get", [rawV, emitStr(kvB, "v")])
        kvB.NewBr(joinB)
        var autoK = callExt(plainB, "js_scope_get", [curScopeV, emitStr(plainB, ixN)])
        plainB.NewBr(joinB)
        var gK = joinB.NewPhi([llvm.ir.NewIncoming(kvK, kvB), llvm.ir.NewIncoming(autoK, plainB)])
        var gV = joinB.NewPhi([llvm.ir.NewIncoming(kvV, kvB), llvm.ir.NewIncoming(rawV, plainB)])
        joinB.NewBr(bindB)
        var itA = callExt(aBody, "js_scope_get", [curScopeV, emitStr(aBody, itN)])
        var ixA = callExt(aBody, "js_scope_get", [curScopeV, emitStr(aBody, ixN)])
        var aK = callExt(aBody, "js_range_key", [itA, ixA])
        var aV = callExt(aBody, "js_range_val", [itA, ixA])
        aBody.NewBr(bindB)
        var keyV = bindB.NewPhi([llvm.ir.NewIncoming(gK, joinB), llvm.ir.NewIncoming(aK, aBody)])
        var valV = bindB.NewPhi([llvm.ir.NewIncoming(gV, joinB), llvm.ir.NewIncoming(aV, aBody)])
        var pair = callExt(bindB, "js_obj_new", [])
        callExt(bindB, "js_set", [pair, emitStr(bindB, "__genkv"), hTrue])
        callExt(bindB, "js_set", [pair, emitStr(bindB, "k"), keyV])
        callExt(bindB, "js_set", [pair, emitStr(bindB, "v"), valV])
        callExt(bindB, "js_yield", [pair])
        bindB.NewBr(postB)
        var ixP = callExt(postB, "js_scope_get", [curScopeV, emitStr(postB, ixN)])
        callExt(postB, "js_scope_set", [curScopeV, emitStr(postB, ixN),
                                        intWrap(postB, callExt(postB, "js_jadd", [ixP, emitNum(postB, 1)]))])
        var gPost = curF.NewBlock("")
        postB.NewCondBr(truthy(postB, callExt(postB, "js_scope_get", [curScopeV, emitStr(postB, gnN)])), gPost, headB)
        var itP = callExt(gPost, "js_scope_get", [curScopeV, emitStr(gPost, itN)])
        callExt(gPost, "js_scope_set", [curScopeV, emitStr(gPost, stN), genNext(gPost, itP)])
        gPost.NewBr(headB)
        return exitB
    }
    function makeForeachGen(iterT, keyName, valName, pat, body, byRef) {
        return function(b) {
            var ir = iterT(b)
            b = ir.b
            hidCount++
            var itN = "\x00fi" + hidCount
            var ixN = "\x00fx" + hidCount
            var stN = "\x00fs" + hidCount
            var gnN = "\x00fg" + hidCount
            var lnN = "\x00fl" + hidCount
            var isGen = callExt(b, "js_phisa", [ir.v, emitStr(b, "Generator")])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, itN), ir.v])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, ixN), emitNum(b, 0)])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, stN), hUndef])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, lnN), emitNum(b, 0)])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, gnN), isGen])
            var startG = curF.NewBlock("")
            var startA = curF.NewBlock("")
            var headB = curF.NewBlock("")
            b.NewCondBr(truthy(b, isGen), startG, startA)
            callExt(startG, "js_scope_set", [curScopeV, emitStr(startG, stN), genNext(startG, ir.v)])
            startG.NewBr(headB)
            callExt(startA, "js_scope_set", [curScopeV, emitStr(startA, lnN),
                                             callExt(startA, "js_range_len", [ir.v])])
            startA.NewBr(headB)
            var bodyB = curF.NewBlock("")
            var postB = curF.NewBlock("")
            var exitB = curF.NewBlock("")
            var gHead = curF.NewBlock("")
            var aHead = curF.NewBlock("")
            headB.NewCondBr(truthy(headB, callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, gnN)])), gHead, aHead)
            var stH = callExt(gHead, "js_scope_get", [curScopeV, emitStr(gHead, stN)])
            gHead.NewCondBr(truthy(gHead, callExt(gHead, "js_get", [stH, emitStr(gHead, "done")])), exitB, bodyB)
            var iH = callExt(aHead, "js_scope_get", [curScopeV, emitStr(aHead, ixN)])
            var lH = callExt(aHead, "js_scope_get", [curScopeV, emitStr(aHead, lnN)])
            aHead.NewCondBr(truthy(aHead, callExt(aHead, "js_lt", [iH, lH])), bodyB, exitB)
            // key / value for this step
            var gBody = curF.NewBlock("")
            var aBody = curF.NewBlock("")
            var kvB = curF.NewBlock("")
            var plainB = curF.NewBlock("")
            var joinB = curF.NewBlock("")
            bodyB.NewCondBr(truthy(bodyB, callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, gnN)])), gBody, aBody)
            var stB = callExt(gBody, "js_scope_get", [curScopeV, emitStr(gBody, stN)])
            var rawV = callExt(gBody, "js_get", [stB, emitStr(gBody, "value")])
            gBody.NewCondBr(truthy(gBody, callExt(gBody, "js_phisset", [rawV, emitStr(gBody, "__genkv")])), kvB, plainB)
            var kvK = callExt(kvB, "js_get", [rawV, emitStr(kvB, "k")])
            var kvV = callExt(kvB, "js_get", [rawV, emitStr(kvB, "v")])
            kvB.NewBr(joinB)
            var autoK = callExt(plainB, "js_scope_get", [curScopeV, emitStr(plainB, ixN)])
            plainB.NewBr(joinB)
            var gK = joinB.NewPhi([llvm.ir.NewIncoming(kvK, kvB), llvm.ir.NewIncoming(autoK, plainB)])
            var gV = joinB.NewPhi([llvm.ir.NewIncoming(kvV, kvB), llvm.ir.NewIncoming(rawV, plainB)])
            var bindB = curF.NewBlock("")
            joinB.NewBr(bindB)
            var itA = callExt(aBody, "js_scope_get", [curScopeV, emitStr(aBody, itN)])
            var ixA = callExt(aBody, "js_scope_get", [curScopeV, emitStr(aBody, ixN)])
            var aK = callExt(aBody, "js_range_key", [itA, ixA])
            var aV = anytype
            if (byRef) { aV = elemCell(aBody, itA, aK) }
            else { aV = callExt(aBody, "js_phcopy", [callExt(aBody, "js_range_val", [itA, ixA])]) }
            aBody.NewBr(bindB)
            var keyV = bindB.NewPhi([llvm.ir.NewIncoming(gK, joinB), llvm.ir.NewIncoming(aK, aBody)])
            var valV = bindB.NewPhi([llvm.ir.NewIncoming(gV, joinB), llvm.ir.NewIncoming(aV, aBody)])
            var bb = bindB
            if (pat != null) {
                bb = emitBindPattern(bb, pat, valV)
            } else if (keyName != null) {
                callExt(bb, "js_pyset_var", [curScopeV, emitStr(bb, valName), keyV])
                callExt(bb, "js_pyset_var", [curScopeV, emitStr(bb, keyName), valV])
            } else {
                callExt(bb, "js_pyset_var", [curScopeV, emitStr(bb, valName), valV])
            }
            loopStack.push({cont: postB, brk: exitB})
            body(bb).NewBr(postB)
            loopStack.pop()
            var ixP = callExt(postB, "js_scope_get", [curScopeV, emitStr(postB, ixN)])
            callExt(postB, "js_scope_set", [curScopeV, emitStr(postB, ixN),
                                            intWrap(postB, callExt(postB, "js_jadd", [ixP, emitNum(postB, 1)]))])
            var gPost = curF.NewBlock("")
            postB.NewCondBr(truthy(postB, callExt(postB, "js_scope_get", [curScopeV, emitStr(postB, gnN)])), gPost, headB)
            var itP = callExt(gPost, "js_scope_get", [curScopeV, emitStr(gPost, itN)])
            callExt(gPost, "js_scope_set", [curScopeV, emitStr(gPost, stN), genNext(gPost, itP)])
            gPost.NewBr(headB)
            return exitB
        }
    }

    // ----- ternary / Elvis / null-coalescing (expressions) -----
    // items: [cond] plain, [cond, {elvis}] Elvis, [cond, then, else] full ternary.
    function makeTernary(items) {
        if (items.length == 1) { return items[0] }
        if (items.length == 2) {
            var condE = items[0]
            var rightE = items[1].elvis
            return function(b) {
                var rc = condE(b)
                b = rc.b
                var thenB = curF.NewBlock("")
                var elseB = curF.NewBlock("")
                var mergeB = curF.NewBlock("")
                b.NewCondBr(truthy(b, rc.v), thenB, elseB)
                thenB.NewBr(mergeB)
                var re = rightE(elseB)
                re.b.NewBr(mergeB)
                var phi = mergeB.NewPhi([llvm.ir.NewIncoming(rc.v, thenB), llvm.ir.NewIncoming(re.v, re.b)])
                return {b: mergeB, v: phi}
            }
        }
        var condT = items[0]
        var thenT = items[1]
        var elseT = items[2]
        return function(b) {
            var rc = condT(b)
            b = rc.b
            var thenB = curF.NewBlock("")
            var elseB = curF.NewBlock("")
            var mergeB = curF.NewBlock("")
            b.NewCondBr(truthy(b, rc.v), thenB, elseB)
            var rt = thenT(thenB)
            rt.b.NewBr(mergeB)
            var re = elseT(elseB)
            re.b.NewBr(mergeB)
            var phi = mergeB.NewPhi([llvm.ir.NewIncoming(rt.v, rt.b), llvm.ir.NewIncoming(re.v, re.b)])
            return {b: mergeB, v: phi}
        }
    }
    // a ?? b : the first operand that is not null (left fold; associative for '??').
    function makeCoalesce(items) {
        if (items.length == 1) { return items[0] }
        return function(b) {
            var r = items[0](b)
            b = r.b
            var v = r.v
            for (var i = 1; i < items.length; i++) {
                var rightB = curF.NewBlock("")
                var mergeB = curF.NewBlock("")
                var isNull = b.NewICmp(llvm.enum.IPredEQ, v, hNull)
                b.NewCondBr(isNull, rightB, mergeB)
                var r2 = items[i](rightB)
                r2.b.NewBr(mergeB)
                var phi = mergeB.NewPhi([llvm.ir.NewIncoming(v, b), llvm.ir.NewIncoming(r2.v, r2.b)])
                b = mergeB
                v = phi
            }
            return {b: b, v: v}
        }
    }
    // list($a, $b) = e / [$a, $b] = e : bind targets from the array's positions.
    // A slot is {empty} | {key, val}; val is either a nested {pat} or a target {dt}.
    function makeSlot(items) {
        if (items.length == 0) { return {empty: true, key: null, val: null} }
        var it = items[0]
        return {empty: false, key: it.dkey == undefined ? null : it.dkey, val: it.dval}
    }
    function makePattern(items) {
        var slots = []
        for (var i = 0; i < items.length; i++) { slots.push(items[i]) }
        return {slots: slots}
    }
    // Positional slots consume the next integer index; a KEYED slot reads its own key
    // and does not advance the position, which is PHP's rule and the interpreter's.
    function emitBindPattern(b, pat, arrV) {
        var pos = 0
        for (var i = 0; i < pat.slots.length; i++) {
            var sl = pat.slots[i]
            if (sl.empty === true) { pos = pos + 1; continue }
            var keyV = anytype
            if (sl.key != null) {
                var rk = sl.key(b)
                b = rk.b
                keyV = rk.v
            } else {
                keyV = emitNum(b, pos)
                pos = pos + 1
            }
            var elem = callExt(b, "js_phget", [arrV, keyV])
            if (sl.val.pat != undefined) {
                b = emitBindPattern(b, sl.val.pat, elem)
            } else {
                var ref = sl.val.dt
                if (ref.path.length == 0) {
                    var rn1 = refNameV(b, ref)
                    b = setVarV(rn1.b, rn1.v, callExt(rn1.b, "js_phcopy", [elem]))
                } else {
                    var p = emitRefPath(b, ref)
                    b = writeRefSlot(p.b, p, elem)
                }
            }
        }
        return b
    }
    function makeDestructure(items) {
        var pat = null
        var valT = null
        for (var i = 0; i < items.length; i++) {
            if (items[i].pat != undefined) { pat = items[i].pat }
            else { valT = items[i] }
        }
        return function(b) {
            var r = valT(b)
            b = emitBindPattern(r.b, pat, r.v)
            return {b: b, v: r.v}
        }
    }

    // ----- && / || : short circuit, PHP-style boolean result -----
    makeOrAnd = function(items, isOr) {
        if (items.length == 1) { return items[0] }
        return function(b) {
            var r = items[0](b)
            b = r.b
            var v = r.v
            for (var i = 1; i < items.length; i++) {
                var rightB = curF.NewBlock("")
                var mergeB = curF.NewBlock("")
                var cnd = truthy(b, v)
                if (isOr) { b.NewCondBr(cnd, mergeB, rightB) }
                else      { b.NewCondBr(cnd, rightB, mergeB) }
                var r2 = items[i](rightB)
                r2.b.NewBr(mergeB)
                var phi = mergeB.NewPhi([llvm.ir.NewIncoming(v, b), llvm.ir.NewIncoming(r2.v, r2.b)])
                b = mergeB
                v = phi
            }
            var boolV = callExt(b, "js_phbool", [v])
            return {b: b, v: boolV}
        }
    }

    // ----- PHP's value model: the whole operator ladder goes through js_ph* -------
    // The handle runtime's default operators are JavaScript's, and PHP's are not:
    // '==' is loose, '"0"' is falsy, a float is a distinct type from an int, and an
    // array is one ordered map whose '===' compares the keys AND their order. Each
    // js_ph* external below is the Go twin of the like-named function in
    // php-interpreter.abnf (phpLoose / phpIdentical / phpCmp / phpArith / phptest /
    // phpStr), so the interpreter stays the reference implementation and the two
    // engines answer the same thing. See abnf/jsrtphp.go.
    core.truthyExt = "js_phtruthy"
    binExt["==="] = "js_phseq"
    binExt["!=="] = "js_phsne"
    binExt["=="] = "js_pheq"
    binExt["!="] = "js_phne"
    binExt["<>"] = "js_phne"
    binExt["<"] = "js_phlt"
    binExt[">"] = "js_phgt"
    binExt["<="] = "js_phle"
    binExt[">="] = "js_phge"
    binExt["+"] = "js_phadd"
    binExt["-"] = "js_phsub"
    binExt["*"] = "js_phmul"
    binExt["/"] = "js_phdiv"
    binExt["%"] = "js_phmod"
    binExt["+="] = "js_phadd"
    binExt["-="] = "js_phsub"
    binExt["*="] = "js_phmul"
    binExt["/="] = "js_phdiv"
    binExt["%="] = "js_phmod"
    // js_ph* already answers in PHP's own type (an int stays an int, any float
    // operand makes the result a float), so the C-family 32-bit truncation the
    // shared emitBin applies must be off for every one of them. PHP integers are
    // 64 bit and '/' is float division (7 / 2 is 3.5), which intWrap destroyed.
    wraps["/"] = 0
    wraps["/="] = 0
    wraps["-"] = 0
    wraps["-="] = 0
    wraps["*"] = 0
    wraps["*="] = 0
    wraps["%"] = 0
    wraps["%="] = 0
    makeNeg = function(t) {
        return function(b) {
            var r = t(b)
            return {b: r.b, v: callExt(r.b, "js_phneg", [r.v])}
        }
    }
    // '!' is PHP truthiness, not JS truthiness ('!"0"' is true).
    makeNot = function(t) {
        return function(b) {
            var r = t(b)
            return {b: r.b, v: callExt(r.b, "js_phnot", [r.v])}
        }
    }
    // The rest of PHP's binary ladder. The bitwise / shift forms truncate to a
    // 32-bit integer, which is what phpBit does in the interpreter.
    binExt["&"] = "js_phband"
    binExt["|"] = "js_phbor"
    binExt["^"] = "js_phbxor"
    binExt["<<"] = "js_phshl"
    binExt[">>"] = "js_phshr"
    binExt["&="] = "js_phband"
    binExt["|="] = "js_phbor"
    binExt["^="] = "js_phbxor"
    binExt["<<="] = "js_phshl"
    binExt[">>="] = "js_phshr"
    emitBin = function(b, op, l, r) {
        if (op == "." || op == ".=") {
            return callExt(b, "js_phcat", [l, r])
        }
        if (op == "**" || op == "**=") {
            return callExt(b, "js_phpow", [l, r])
        }
        // '<=>' answers exactly -1 / 0 / 1 from PHP's own comparison.
        if (op == "<=>") {
            return callExt(b, "js_phcmp", [l, r])
        }
        // '$a ??= $b' keeps $a when it is set and not null. The right-hand side is
        // already evaluated at this point, so - unlike PHP - it is not short-circuited;
        // a side-effecting right operand of '??=' therefore still runs.
        if (op == "??=") {
            return b.NewSelect(truthy(b, callExt(b, "js_seq", [l, hNull])), r,
                               b.NewSelect(truthy(b, callExt(b, "js_seq", [l, hUndef])), r, l))
        }
        var v = callExt(b, binExt[op], [l, r])
        if (wraps[op] == 1) { v = intWrap(b, v) }
        return v
    }
    // 2 ** 3 ** 2 == 512: the parse is already right-associative (the right operand is
    // a full UnaryExpr), so the fold only has to apply the operator when one is there.
    function foldPow(items) {
        if (items.length == 1) { return items[0] }
        var base = items[0]
        var exp = items[1]
        return function(b) {
            var rl = base(b)
            var rr = exp(rl.b)
            return {b: rr.b, v: emitBin(rr.b, "**", rl.v, rr.v)}
        }
    }
    // ~x on PHP's own integer coercion (phpBit in the interpreter).
    function makeBitNot(t) {
        return function(b) {
            var r = t(b)
            return {b: r.b, v: callExt(r.b, "js_phbnot", [r.v])}
        }
    }
    // throw as an EXPRESSION (PHP 8): it never produces a value, so the block it ends
    // is dead exactly like the throw statement's.
    function makeThrowExpr(e) {
        return function(b) {
            var r = e(b)
            callExt(r.b, "js_throw", [r.v])
            r.b.NewRet(hUndef) // Never reached: js_throw unwinds on the host side.
            return {b: deadBlock(), v: hUndef}
        }
    }

    // ----- arrays: ONE type, the ordered key/value map ---------------------------
    // PHP has a single array type: [1, 2, 3] IS the map 0=>1, 1=>2, 2=>3, which is why
    // $a === $b compares the keys and their ORDER while $a == $b ignores it, and why
    // [5 => "x"] followed by $m[] = "y" lands at key 6. The compiler used to build an
    // indexed literal as a runtime LIST and a keyed one as a dict, so the two spellings
    // of the same value were different types. js_pharr / js_phset / js_phpush build the
    // one map (the __dict shape js_range_* already iterates), carrying __next - the
    // next automatic integer key - exactly like the interpreter's newArr/arrPush.
    // A '...$a' spread merges another array in: its INTEGER keys are renumbered and its
    // string keys are kept, PHP's rule for the array-unpacking operator.
    function makeArray(items) {
        return function(b) {
            var d = callExt(b, "js_pharr", [])
            for (var k = 0; k < items.length; k++) {
                if (items[k].hk != undefined) {
                    var rk = items[k].hk(b); b = rk.b
                    var rv = items[k].hv(b); b = rv.b
                    callExt(b, "js_phset", [d, rk.v, rv.v])
                } else if (items[k].spread != undefined) {
                    var rs = items[k].spread(b); b = rs.b
                    callExt(b, "js_phmerge", [d, rs.v])
                } else {
                    var re = items[k].elem(b); b = re.b
                    callExt(b, "js_phpush", [d, re.v])
                }
            }
            return {b: b, v: d}
        }
    }

    function makeTemplate(items) {
        return function(b) {
            var v = emitStr(b, "")
            for (var i = 0; i < items.length; i++) {
                var pv
                if (items[i].s != undefined) { pv = emitStr(b, items[i].s) }
                else { var r = items[i].e(b); b = r.b; pv = r.v }
                v = callExt(b, "js_phcat", [v, pv])
            }
            return {b: b, v: v}
        }
    }

    // "$name", "$a[0]", "$map[key]", "$o->prop": PHP's simple interpolation form. The
    // index text is classified here, exactly as php-interpreter.abnf's makeTplVar does:
    // a leading '$' is another variable, a canonical integer is an int key, anything
    // else is a BARE word taken as a string key (that is what "$map[key]" means).
    function makeTplVar(items) {
        var name = ""
        var idx = null
        var prop = null
        for (var i = 0; i < items.length; i++) {
            if (items[i].tvar != undefined) { name = items[i].tvar }
            else if (items[i].tidx != undefined) { idx = items[i].tidx }
            else if (items[i].tprop != undefined) { prop = items[i].tprop }
        }
        if (idx != null) {
            var itxt = idx
            return function(b) {
                var ov = callExt(b, "js_scope_get", [curScopeV, emitStr(b, name)])
                var kv = anytype
                if (itxt.charAt(0) == "$") { kv = callExt(b, "js_scope_get", [curScopeV, emitStr(b, itxt)]) }
                else if (isCanonInt(itxt)) { kv = emitNum(b, parseInt(itxt, 10)) }
                else { kv = emitStr(b, itxt) }
                return {b: b, v: callExt(b, "js_phget", [ov, kv])}
            }
        }
        if (prop != null) {
            var pn = prop.substring(2)
            return function(b) {
                var rov = phDeref(b, callExt(b, "js_scope_get", [curScopeV, emitStr(b, name)]))
                return emitPropGet(rov.b, rov.v, emitStr(rov.b, pn), pn)
            }
        }
        return makeVarRef(name)
    }
    // A canonical decimal integer: no leading zero, an optional '-'. PHP's array keys
    // only fold a string to an int in that exact form ("01" stays a string key).
    function isCanonInt(s) {
        if (s.length == 0) { return false }
        var i = 0
        if (s.charAt(0) == "-") { if (s.length == 1) { return false }; i = 1 }
        if (s.charAt(i) == "0" && s.length > i + 1) { return false }
        for (var j = i; j < s.length; j++) {
            var ch = s.charAt(j)
            if (ch < "0" || ch > "9") { return false }
        }
        return true
    }

    // ----- member chains: ->method(args), ->field, [index], (call), ::static -----
    // One chain suffix, with the nullsafe flag its arrow carried.
    function sfxNs(items) {
        for (var i = 0; i < items.length; i++) {
            if (items[i] != undefined && items[i].ns != undefined) { return true }
        }
        return false
    }
    function sfxRest(items) {
        var out = []
        for (var i = 0; i < items.length; i++) {
            var it = items[i]
            if (it != undefined && (it.ns != undefined || it.mname != undefined
                                    || it.fname != undefined || it.dynname != undefined)) { continue }
            out.push(it)
        }
        return out
    }
    function sfxNamed(items, key) {
        for (var i = 0; i < items.length; i++) {
            if (items[i] != undefined && items[i][key] != undefined) { return items[i][key] }
        }
        return undefined
    }
    function makeMethodSfx(items) {
        return {kind: "mcall", name: sfxNamed(items, "mname"), args: sfxRest(items), nullsafe: sfxNs(items)}
    }
    function makeFieldSfx(items) {
        return {kind: "field", name: sfxNamed(items, "fname"), nullsafe: sfxNs(items)}
    }
    // $o->$meth(...) / $o->{"add"}(...): the member NAME is computed at run time.
    function makeDynMethodSfx(items) {
        return {kind: "dyncall", nameT: sfxNamed(items, "dynname"), args: sfxRest(items), nullsafe: sfxNs(items)}
    }
    function makeDynFieldSfx(items) {
        return {kind: "dynfield", nameT: sfxNamed(items, "dynname"), nullsafe: sfxNs(items)}
    }
    foldCallMember = function(items) {
        if (items.length == 1) { return items[0] }
        var primary = items[0]
        var suffixes = items.slice(1)
        var hasNs = false
        for (var q = 0; q < suffixes.length; q++) {
            if (suffixes[q].nullsafe === true) { hasNs = true }
        }
        return function(b) {
            var r = primary(b)
            b = r.b
            var cur = r.v
            // A '?->' anywhere in the chain gives it an end block that every null
            // receiver jumps straight to, so nothing to its right is evaluated.
            var endB = hasNs ? curF.NewBlock("") : null
            var incs = []
            for (var i = 0; i < suffixes.length; i++) {
                var s = suffixes[i]
                if (s.nullsafe === true) {
                    var contB = curF.NewBlock("")
                    b.NewCondBr(b.NewICmp(llvm.enum.IPredEQ, cur, hNull), endB, contB)
                    incs.push(llvm.ir.NewIncoming(hNull, b))
                    b = contB
                }
                if (s.kind == "dyncall") {
                    var rn = s.nameT(b)
                    b = rn.b
                    var ed = emitPhArgs(b, s.args, null)
                    b = ed.b
                    var rdm = emitMethodCall(b, cur, callExt(b, "js_phstr", [rn.v]), ed.v)
                    b = rdm.b
                    cur = rdm.v
                } else if (s.kind == "dynfield") {
                    var rf = s.nameT(b)
                    b = rf.b
                    var rdf = emitPropGet(b, cur, callExt(b, "js_phstr", [rf.v]), null)
                    b = rdf.b
                    cur = rdf.v
                } else if (s.kind == "mcall") {
                    // $o->m(...): a callable bound to this receiver.
                    if (hasFcc(s.args)) { cur = emitMethodFcc(b, cur, s.name); continue }
                    var ea = emitPhArgs(b, s.args, methSigOf(s.name))
                    b = ea.b
                    var rm = emitMethodCall(b, cur, emitStr(b, s.name), ea.v)
                    b = rm.b
                    cur = rm.v
                } else if (s.kind == "field") {
                    var rg = emitPropGet(b, cur, emitStr(b, s.name), s.name)
                    b = rg.b
                    cur = rg.v
                } else if (s.kind == "call") {
                    var ea2 = emitPhArgs(b, s.args, null)
                    b = ea2.b
                    var rc2 = callableV(ea2.b, cur)
                    b = rc2.b
                    if (magicInvoke) {
                        // An INSTANCE used as a callable runs its __invoke method.
                        var invB = curF.NewBlock("")
                        var fnB = curF.NewBlock("")
                        var endI = curF.NewBlock("")
                        b.NewCondBr(emitIsObj(b, rc2.v), invB, fnB)
                        var iv = callExt(invB, "js_mcall", [rc2.v, emitStr(invB, "__invoke"), ea2.v])
                        invB.NewBr(endI)
                        var fv = callExt(fnB, "js_call", [rc2.v, hUndef, ea2.v])
                        fnB.NewBr(endI)
                        b = endI
                        cur = endI.NewPhi([llvm.ir.NewIncoming(iv, invB), llvm.ir.NewIncoming(fv, fnB)])
                    } else {
                        cur = callExt(b, "js_call", [rc2.v, hUndef, ea2.v])
                    }
                } else if (s.kind == "static") {
                    var curV = cur
                    var rs = emitStaticAccess(function(bb) { return {b: bb, v: curV} }, s.sfxMem, s.sfxArgs)(b)
                    b = rs.b
                    cur = rs.v
                } else {
                    var ir = s.idx(b)
                    b = ir.b
                    cur = callExt(b, "js_phget", [cur, ir.v])
                }
            }
            if (!hasNs) { return {b: b, v: cur} }
            incs.push(llvm.ir.NewIncoming(cur, b))
            b.NewBr(endB)
            return {b: endB, v: endB.NewPhi(incs)}
        }
    }
    // ----- magic methods --------------------------------------------------------
    // __get / __set / __isset / __call / __invoke are FALLBACKS: they run only where an
    // ordinary member access finds nothing. Each therefore costs a branch at every
    // property read, property write or method call - so, exactly like the operator
    // overloading in csharp-to-llvm-ir.abnf, the branch is emitted only when some class
    // in the program declares that hook. A program with no magic method emits the IR it
    // did before they existed.
    var magicGet = false
    var magicSet = false
    var magicIsset = false
    var magicCall = false
    var magicInvoke = false
    function noteMagic(name) {
        if (name == "__get") { magicGet = true }
        else if (name == "__set") { magicSet = true }
        else if (name == "__isset") { magicIsset = true }
        else if (name == "__call") { magicCall = true }
        else if (name == "__invoke") { magicInvoke = true }
    }
    // ----- property hooks (PHP 8.4) ---------------------------------------------
    // hookedProps holds every property name some class gives a hook, so a read or write
    // of that NAME can be compiled with a dispatch in front of it and every other
    // property keeps the plain js_get / js_set it always had.
    // hookBacking is the property whose hook body is being emitted right now: inside it
    // '$this->x' is the backing STORE, not another hook call, which is what stops a
    // backed hook from recursing into itself.
    var hookedProps = {}
    var usesHooks = false
    var hookBacking = ""
    function noteHooked(name) { hookedProps["$" + name] = true; usesHooks = true }
    function isHooked(name) {
        if (!usesHooks || name == undefined || name == "") { return false }
        if (name == hookBacking) { return false }
        return hookedProps["$" + name] == true
    }
    // The hook methods of one declared property. A 'get' becomes __hget_<name> (no
    // parameters), a 'set' becomes __hset_<name> (one, defaulting to PHP's implicit
    // $value); the arrow forms are the one-expression spellings of 'return e' and
    // 'store e'.
    function emitHooks(b, clsV, clsName, prop) {
        for (var i = 0; i < prop.hooks.length; i++) {
            var h = prop.hooks[i]
            if (h.hempty == true) { continue }
            var isGet = h.hkind == "get"
            var pname = h.hparam == null || h.hparam == undefined ? "$value" : h.hparam
            var body = h.hbodyT
            if (body == null) {
                body = isGet ? makeBody([makeReturn([h.harrowT])])
                             : makeBody([makeHookStore(prop.name, h.harrowT)])
            }
            var savedBacking = hookBacking
            hookBacking = prop.name
            var idx = emitFunc(isGet ? [] : [pname], body, true, false, clsName)
            hookBacking = savedBacking
            callExt(b, "js_set", [clsV, emitStr(b, (isGet ? "__hget_" : "__hset_") + prop.name),
                                  closureV(b, idx, curScopeV)])
        }
        return b
    }
    // 'set => e': store e in the backing property, bypassing the hook.
    function makeHookStore(name, valT) {
        return function(b) {
            var r = valT(b)
            b = r.b
            callExt(b, "js_set", [callExt(b, "js_phthis", [curScopeV]), emitStr(b, name), r.v])
            return b
        }
    }
    // "is this an instance": js_phisset never aborts, and only an object built by `new`
    // carries __class.
    function emitIsObj(b, v) {
        return truthy(b, callExt(b, "js_phisset", [v, emitStr(b, "__class")]))
    }
    // Does the value's class - or any of its bases - declare `name`? A runtime walk of
    // the __super chain, since the receiver's class is not known here.
    function emitHasMethod(b, objV, nameV) {
        hidCount++
        var cName = "\x00mc" + hidCount
        var fName = "\x00mf" + hidCount
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, cName),
                                     callExt(b, "js_get", [objV, emitStr(b, "__class")])])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, fName), hFalse])
        var headB = curF.NewBlock("")
        var bodyB = curF.NewBlock("")
        var foundB = curF.NewBlock("")
        var nextB = curF.NewBlock("")
        var exitB = curF.NewBlock("")
        b.NewBr(headB)
        var curH = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, cName)])
        headB.NewCondBr(truthy(headB, callExt(headB, "js_phisset", [curH, emitStr(headB, "__isclass")])), bodyB, exitB)
        var curB = callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, cName)])
        bodyB.NewCondBr(truthy(bodyB, callExt(bodyB, "js_phisset", [curB, nameV])), foundB, nextB)
        callExt(foundB, "js_scope_set", [curScopeV, emitStr(foundB, fName), hTrue])
        foundB.NewBr(exitB)
        callExt(nextB, "js_scope_set", [curScopeV, emitStr(nextB, cName),
                                        callExt(nextB, "js_get", [curB, emitStr(nextB, "__super")])])
        nextB.NewBr(headB)
        return {b: exitB, v: callExt(exitB, "js_scope_get", [curScopeV, emitStr(exitB, fName)])}
    }
    // $o->p, with a property HOOK in front of it (when p is a hooked name anywhere in
    // the program) and __get as the fallback for a property the instance does not have.
    function emitPropGet(b, objV, keyV, name) {
        if (isHooked(name)) {
            var hn = emitStr(b, "__hget_" + name)
            var hm = emitHasMethod(b, objV, hn)
            b = hm.b
            var hookB = curF.NewBlock("")
            var plainB = curF.NewBlock("")
            var joinB = curF.NewBlock("")
            b.NewCondBr(truthy(b, hm.v), hookB, plainB)
            var hv = callExt(hookB, "js_mcall", [objV, hn, callExt(hookB, "js_arr_new", [])])
            hookB.NewBr(joinB)
            var pr = emitPropGetPlain(plainB, objV, keyV)
            pr.b.NewBr(joinB)
            return {b: joinB, v: joinB.NewPhi([llvm.ir.NewIncoming(hv, hookB),
                                               llvm.ir.NewIncoming(pr.v, pr.b)])}
        }
        return emitPropGetPlain(b, objV, keyV)
    }
    function emitPropGetPlain(b, objV, keyV) {
        if (!magicGet) { return {b: b, v: callExt(b, "js_get", [objV, keyV])} }
        var haveB = curF.NewBlock("")
        var missB = curF.NewBlock("")
        var mergeB = curF.NewBlock("")
        b.NewCondBr(truthy(b, callExt(b, "js_phisset", [objV, keyV])), haveB, missB)
        var plainV = callExt(haveB, "js_get", [objV, keyV])
        haveB.NewBr(mergeB)
        var hm = emitHasMethod(missB, objV, emitStr(missB, "__get"))
        var magB = curF.NewBlock("")
        var rawB = curF.NewBlock("")
        hm.b.NewCondBr(truthy(hm.b, hm.v), magB, rawB)
        var magV = callExt(magB, "js_mcall", [objV, emitStr(magB, "__get"), argList(magB, [keyV])])
        magB.NewBr(mergeB)
        var rawV = callExt(rawB, "js_get", [objV, keyV])
        rawB.NewBr(mergeB)
        return {b: mergeB, v: mergeB.NewPhi([llvm.ir.NewIncoming(plainV, haveB),
                                             llvm.ir.NewIncoming(magV, magB),
                                             llvm.ir.NewIncoming(rawV, rawB)])}
    }
    // $o->p = v, with the property's set HOOK in front of it and __set as the fallback.
    function emitPropSet(b, objV, keyV, valV, name) {
        if (isHooked(name)) {
            var hn = emitStr(b, "__hset_" + name)
            var hm = emitHasMethod(b, objV, hn)
            b = hm.b
            var hookB = curF.NewBlock("")
            var plainB = curF.NewBlock("")
            var joinB = curF.NewBlock("")
            b.NewCondBr(truthy(b, hm.v), hookB, plainB)
            callExt(hookB, "js_mcall", [objV, hn, argList(hookB, [valV])])
            hookB.NewBr(joinB)
            emitPropSetPlain(plainB, objV, keyV, valV).NewBr(joinB)
            return joinB
        }
        return emitPropSetPlain(b, objV, keyV, valV)
    }
    function emitPropSetPlain(b, objV, keyV, valV) {
        if (!magicSet) { callExt(b, "js_set", [objV, keyV, valV]); return b }
        var haveB = curF.NewBlock("")
        var missB = curF.NewBlock("")
        var mergeB = curF.NewBlock("")
        b.NewCondBr(truthy(b, callExt(b, "js_phisset", [objV, keyV])), haveB, missB)
        callExt(haveB, "js_set", [objV, keyV, valV])
        haveB.NewBr(mergeB)
        var hm = emitHasMethod(missB, objV, emitStr(missB, "__set"))
        var magB = curF.NewBlock("")
        var rawB = curF.NewBlock("")
        hm.b.NewCondBr(truthy(hm.b, hm.v), magB, rawB)
        callExt(magB, "js_mcall", [objV, emitStr(magB, "__set"), argList(magB, [keyV, valV])])
        magB.NewBr(mergeB)
        callExt(rawB, "js_set", [objV, keyV, valV])
        rawB.NewBr(mergeB)
        return mergeB
    }
    // isset($o->p), with __isset as the fallback.
    function emitPropIsset(b, objV, keyV) {
        var plain = callExt(b, "js_phisset", [objV, keyV])
        if (!magicIsset) { return {b: b, v: plain} }
        var missB = curF.NewBlock("")
        var mergeB = curF.NewBlock("")
        b.NewCondBr(truthy(b, plain), mergeB, missB)
        var hm = emitHasMethod(missB, objV, emitStr(missB, "__isset"))
        var magB = curF.NewBlock("")
        var rawB = curF.NewBlock("")
        hm.b.NewCondBr(truthy(hm.b, hm.v), magB, rawB)
        var magV = callExt(magB, "js_phbool", [callExt(magB, "js_mcall", [objV, emitStr(magB, "__isset"), argList(magB, [keyV])])])
        magB.NewBr(mergeB)
        rawB.NewBr(mergeB)
        return {b: mergeB, v: mergeB.NewPhi([llvm.ir.NewIncoming(plain, b),
                                             llvm.ir.NewIncoming(magV, magB),
                                             llvm.ir.NewIncoming(hFalse, rawB)])}
    }
    // $o->m(args), with __call($name, $args) as the fallback for a method the class
    // chain does not declare.
    function emitMethodCall(b, objV, nameV, argsV) {
        if (!magicCall) { return {b: b, v: callExt(b, "js_mcall", [objV, nameV, argsV])} }
        var hm = emitHasMethod(b, objV, nameV)
        b = hm.b
        var directB = curF.NewBlock("")
        var magB = curF.NewBlock("")
        var mergeB = curF.NewBlock("")
        b.NewCondBr(truthy(b, hm.v), directB, magB)
        var dv = callExt(directB, "js_mcall", [objV, nameV, argsV])
        directB.NewBr(mergeB)
        var mv = callExt(magB, "js_mcall", [objV, emitStr(magB, "__call"),
                                            argList(magB, [nameV, phListOf(magB, argsV)])])
        magB.NewBr(mergeB)
        return {b: mergeB, v: mergeB.NewPhi([llvm.ir.NewIncoming(dv, directB), llvm.ir.NewIncoming(mv, magB)])}
    }

    // ----- isset / empty / unset ------------------------------------------------
    // A handle-level "is this null or undefined": both are interned constants, so the
    // test is two integer comparisons and no runtime call.
    function isSetHandle(b, v) {
        return b.NewSelect(b.NewICmp(llvm.enum.IPredEQ, v, hNull), hFalse,
                           b.NewSelect(b.NewICmp(llvm.enum.IPredEQ, v, hUndef), hFalse, hTrue))
    }
    // isset() of ONE storage location. A plain variable is read with the non-aborting
    // scope probe (an undeclared name answers null, not an error); an element and a
    // property go through js_phisset, which is false for a missing key AND for a null
    // value - PHP's rule.
    function emitIssetOne(b, ref) {
        if (ref.path.length == 0) {
            if (ref.sbase != undefined) {
                var rb = ref.sbase(b)
                b = rb.b
                return {b: b, v: isSetHandle(b, callExt(b, "js_phsget", [rb.v, emitStr(b, ref.sname)]))}
            }
            var rn2 = refNameV(b, ref)
            var rd = phDeref(rn2.b, rawVarV(rn2.b, rn2.v))
            return {b: rd.b, v: isSetHandle(rd.b, rd.v)}
        }
        var p = emitRefPath(b, ref)
        b = p.b
        if (p.kind == "append") { return {b: b, v: hFalse} }
        if (p.kind == "field") { return emitPropIsset(b, p.obj, p.key) }
        return {b: b, v: callExt(b, "js_phisset", [p.obj, p.key])}
    }
    function makeIsset(refs) {
        return function(b) {
            var v = hTrue
            for (var i = 0; i < refs.length; i++) {
                var r = emitIssetOne(b, refs[i])
                b = r.b
                v = i == 0 ? r.v : b.NewSelect(truthy(b, v), r.v, hFalse)
            }
            return {b: b, v: v}
        }
    }
    function makeEmpty(t) {
        return function(b) {
            var r = t(b)
            return {b: r.b, v: callExt(r.b, "js_phnot", [r.v])}
        }
    }
    // unset($x): drop the binding. A variable becomes undefined in its own slot - NOT
    // through a cell, since unset() breaks the reference rather than clearing what it
    // points at - an element is removed from the array and a property is cleared.
    function makeUnset(refs) {
        return function(b) {
            for (var i = 0; i < refs.length; i++) {
                var ref = refs[i]
                if (ref.path.length == 0) {
                    if (ref.sbase == undefined) {
                        var rn3 = refNameV(b, ref)
                        b = rn3.b
                        callExt(b, "js_pyset_var", [curScopeV, rn3.v, hUndef])
                    }
                } else {
                    var p = emitRefPath(b, ref)
                    b = p.b
                    if (p.kind == "index") { callExt(b, "js_phunset", [p.obj, p.key]) }
                    else if (p.kind == "field") { callExt(b, "js_set", [p.obj, p.key, hUndef]) }
                }
            }
            return b
        }
    }
    // items = [{cast}, operandThunk]
    function makeCast(items) {
        var kind = items[0].cast
        var t = items[1]
        return function(b) {
            var r = t(b)
            return {b: r.b, v: callExt(r.b, "js_phcast", [emitStr(r.b, kind), r.v])}
        }
    }
    // ----- '::' : class constants, static properties, static dispatch -----------
    // The base of a '::' is a class descriptor at run time. 'self' and 'static' are
    // read out of the CALL FRAME (emitFunc declares them per method), which is what
    // keeps them correct across a try/catch: makeTry restores the scope chain, and
    // they ride along in it.
    function staticBaseThunk(name) {
        var n = lastSeg(name)
        if (n == "self") { return function(b) { return {b: b, v: frameCls(b, "self")} } }
        if (n == "static") { return function(b) { return {b: b, v: frameCls(b, "static")} } }
        if (n == "parent") {
            return function(b) {
                return {b: b, v: callExt(b, "js_get", [frameCls(b, "self"), emitStr(b, "__super")])}
            }
        }
        return function(b) { return {b: b, v: callExt(b, "js_scope_get", [curScopeV, emitStr(b, n)])} }
    }
    // The hidden call-frame entries. The names start with a NUL so no PHP identifier
    // and no '$variable' can collide with them.
    function frameClsName(which) { return "\x00" + which }
    function frameCls(b, which) {
        return callExt(b, "js_scope_get", [curScopeV, emitStr(b, frameClsName(which))])
    }
    // baseT :: member, with or without an argument list.
    function emitStaticAccess(baseT, mem, args) {
        return function(b) {
            var rb = baseT(b)
            b = rb.b
            if (args != null) {
                // C::m(...): the first-class callable form yields a closure that
                // performs the static dispatch when it is finally called.
                if (hasFcc(args)) { return {b: b, v: emitStaticFcc(b, rb.v, mem)} }
                var ea = emitPhArgs(b, args, null)
                b = ea.b
                var thisV = callExt(b, "js_phthis", [curScopeV])
                return {b: b, v: callExt(b, "js_phscall", [rb.v, emitStr(b, mem), thisV, ea.v])}
            }
            if (mem.charAt(0) == "$") {
                return {b: b, v: callExt(b, "js_phsget", [rb.v, emitStr(b, mem.substring(1))])}
            }
            // C::class is the class NAME, not a constant lookup.
            if (mem == "class") { return {b: b, v: callExt(b, "js_phcname", [rb.v])} }
            return {b: b, v: callExt(b, "js_phconst", [rb.v, emitStr(b, mem)])}
