                }
                catches[i].catchbody(thenB).NewBr(endB)
                b = nextB
            }
            callExt(b, "js_throw", [caught])
            b.NewRet(hUndef) // Never reached: js_throw unwinds on the host side.
            return endB
        }
    }
    function makeTry(items) {
