    // The labels of the statement run currently being emitted, by name, as indexes
    // into compile-core's ctlLabels (the block and the IR function it lies in).
    // makeBody registers its own before it emits anything, which is what lets a goto
    // that sits EARLIER in the run branch to a label further down.
    var labelIds = {}
    // The function each try/catch/finally closure is written in, by its curFTag. A
    // goto may leave such closures outward, as a control signal (emitGoto); a label
    // inside one is out of reach from anywhere else.
    var ctlOuterTag = {}
    function popLabel() {
        var items = takeAll()
        var nm = ""
        for (var i = 0; i < items.length; i++) {
            if (items[i] != undefined && items[i].lbl != undefined) { nm = stripWs(items[i].lbl) }
            else { push(items[i]) }
        }
        return nm
    }
