        var vs = []
        for (var i = 0; i < args.length; i++) { var r = args[i].pos(b); b = r.b; vs.push(r.v) }
        // strlen counts BYTES (PHP strings are byte strings), count() counts elements.
        // strlen() measures PHP's string form of the argument (true is "1", false
        // and null are ""), not the JavaScript form js_bytelen alone would measure.
        if (name == "strlen") { return {b: b, v: callExt(b, "js_phstrlen", [vs[0]])} }
        if (name == "count") { return {b: b, v: callExt(b, "js_phcount", [vs[0]])} }
