            var okB = curF.NewBlock("")
            var badB = curF.NewBlock("")
            b.NewCondBr(truthy(b, callExt(b, "js_phis", [emitStr(b, "array"), vs[0]])), okB, badB)
            var gotV = callExt(badB, "js_phcat", [callExt(badB, "js_phvname", [vs[0]]), emitStr(badB, " given")])
            callExt(badB, "js_phraise", [emitStr(badB, "TypeError"),
