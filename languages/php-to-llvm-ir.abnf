    // ----- global constants, static locals, magic constants ---------------------
    // Constants carry no '$' sigil, so they share the flat name space with classes and
    // functions and never collide with a PHP variable.
    // The directives are dropped by DeclDirective, so anything left is the braced body.
    function makeDeclare(items) {
        for (var i = 0; i < items.length; i++) {
            if (items[i] != undefined && items[i].body != undefined) { return items[i].body }
        }
        return function(b) { return b }
    }
    function makeConstDecl(items) {
        var cs = []
        for (var i = 0; i < items.length; i++) { cs.push(items[i]) }
        return function(b) {
            for (var k = 0; k < cs.length; k++) {
                var cv = hNull
                if (cs[k].cinit != null) { var r = cs[k].cinit(b); b = r.b; cv = r.v }
                callExt(b, "js_scope_decl", [curScopeV, emitStr(b, cs[k].cname), cv])
            }
            return b
        }
    }
