        var valName = null
        var slots = []
        var pat = null
        var body = null
        var byRef = false
        for (var i = 1; i < items.length; i++) {
            if (items[i].body != undefined) { body = items[i].body }
            else if (items[i].v1 != undefined) { slots.push(items[i].v1) }
            else if (items[i].v2 != undefined) { slots.push(items[i].v2) }
            else if (items[i].pat != undefined) { pat = items[i].pat }
            else if (items[i].feref != undefined) { byRef = true }
        }
