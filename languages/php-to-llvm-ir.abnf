    var walkFnName = ""
    function noteFnName(n) { walkFnName = n; return n }
    // A bareword: a magic constant, or a global / already-declared constant.
    //
    // js_phclslookup answers null rather than aborting - an interface list has to
    // survive a forward reference - but null is ambiguous: `const X = null;` looks
    // the same as an UNDEFINED constant. So the null arm PROBES the scope
    // (scopeProbe, which does not abort) and splits the two apart: a declared null is
    // answered, and a name that is nowhere raises PHP 8's catchable
    // `Error: Undefined constant "X"` (js_scope_get would take the floor's
    // uncatchable `variable not defined` abort instead).
    // PHP 8 quotes the constant name in `Undefined constant "X"`. Spelled as a
    // variable so the tag script never carries an escaped quote inside a string
    // literal, which the two script hosts do not agree on.
    var dq = String.fromCharCode(34)
    // __LINE__ / __FILE__ / __DIR__: twin of magicFileConst in php-interpreter.abnf.
    function magicFileConst(name, pos) {
        if (name == "__LINE__") { return c.lineOf(pos) }
        if (name != "__FILE__" && name != "__DIR__") { return undefined }
        var f = c.curFileAbs()
        if (name == "__FILE__") { return f }
        var cut = 0
        for (var i = 0; i < f.length; i++) { if (f.charCodeAt(i) == 47) { cut = i } }
        return cut == 0 ? "/" : f.substring(0, cut)
    }
    function makeConstRef(name, pos) {
        // A bare 'exit' / 'die' is the language construct exit(), not a constant.
        // Twin of makeConstRef in php-interpreter.abnf.
        var lo = name.toLowerCase()
        if (lo == "exit" || lo == "die") { return makeCall(["exit"]) }
        if (name == "__FUNCTION__" || name == "__METHOD__") { return makeConst(cloMagic(name == "__METHOD__")) }
        var fileConst = magicFileConst(name, pos)
        if (fileConst != undefined) { return makeConst(fileConst) }
        if (name == "__CLASS__") {
            return function(b) {
                return {b: b, v: callExt(b, "js_get", [frameCls(b, "self"), emitStr(b, "__name")])}
            }
        }
        return function(b) {
            var nameV = emitStr(b, name)
            var v = phClsLookup(b, nameV)
            var missB = curF.NewBlock("")
            var haveB = curF.NewBlock("")
            var mergeB = curF.NewBlock("")
            b.NewCondBr(truthy(b, callExt(b, "js_seq", [v, hNull])), missB, haveB)
            // A declared-null constant or nothing at all (see above). The probe is
            // affordable because this block is cold. The bareword hook
            // (js_phmissname) must not answer here: its message is the FUNCTION one.
            var probed = scopeProbe(missB, emitStr(missB, name), hUndef)
            var badB = curF.NewBlock("")
            var okB = curF.NewBlock("")
            missB.NewCondBr(missB.NewICmp(llvm.enum.IPredEQ, probed, hUndef), badB, okB)
            callExt(badB, "js_phraise", [emitStr(badB, "Error"),
                                         emitStr(badB, "Undefined constant " + dq + name + dq)])
            badB.NewBr(mergeB) // never reached: js_phraise throws
            okB.NewBr(mergeB)
            haveB.NewBr(mergeB)
            return {b: mergeB, v: mergeB.NewPhi([llvm.ir.NewIncoming(hUndef, badB),
                                                 llvm.ir.NewIncoming(probed, okB),
                                                 llvm.ir.NewIncoming(v, haveB)])}
        }
    }
    // static $n = 0: one reference cell per declaration SITE, created where the program
    // starts and bound to the local name on every call.
    var staticSlots = []
    function makeStaticVarItem(items) {
        var nm = ""
        var init = null
        for (var i = 0; i < items.length; i++) {
            if (typeof items[i] == "string") { nm = items[i] }
            else { init = items[i] }
        }
        return {svname: nm, svinit: init}
    }
    function makeStaticVars(items) {
        noteRef()
        var binds = []
        for (var i = 0; i < items.length; i++) {
            hidCount++
            var hidden = "\x00sv" + hidCount + walkFnName + items[i].svname
            staticSlots.push({hidden: hidden})
            binds.push({hidden: hidden, name: items[i].svname, init: items[i].svinit})
        }
        return function(b) {
            for (var k = 0; k < binds.length; k++) {
                var cellV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, binds[k].hidden)])
                // The initializer runs on the FIRST call, not where the program starts
                // (php-interpreter.abnf's makeStaticVars builds its cells lazily too).
                // The cell starts out holding undefined, which no PHP value is, so the
                // test is exact: a static explicitly set to null stays null.
                if (binds[k].init != null) {
                    var initB = curF.NewBlock("")
                    var doneB = curF.NewBlock("")
                    var cur = callExt(b, "js_get", [cellV, emitStr(b, "v")])
                    b.NewCondBr(b.NewICmp(llvm.enum.IPredEQ, cur, hUndef), initB, doneB)
                    var ri = binds[k].init(initB)
                    callExt(ri.b, "js_set", [cellV, emitStr(ri.b, "v"), callExt(ri.b, "js_phcopy", [ri.v])])
                    ri.b.NewBr(doneB)
                    b = doneB
                }
                callExt(b, "js_scope_decl", [curScopeV, emitStr(b, binds[k].name), cellV])
            }
            return b
        }
