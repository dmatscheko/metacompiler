        var mnS = callExt(sepB, "js_phsubstr", [v, callExt(sepB, "js_phadd", [sepV, emitNum(sepB, 2)]), hNull])
        sepB = cloStaticOk(f, sepB, cnS, mnS, where, okB)
        var clsS = sepB.NewCall(classNamedFn(), [env, cnS, where])
        sepB = cbClsChk(f, sepB, env, where, clsS, mnS, cnS, f.Params[4], okB)
        sepB = cbNsChk(f, sepB, env, ns, clsS, cnS, mnS, where)
