SqBack      = "\\" ;
SqPlain     = "\x20"..."\x26" | "\x28"..."\x5b" | "\x5d"..."\U0010ffff" | @"\t" | @"\n" | @"\r" ;

// A heredoc / nowdoc. The body lives on the lines AFTER the marker, so it cannot be
// written as ordinary productions: HdScan is a :script lexer that returns the marker
// line, the body and the terminator line as ONE token, and makeHeredoc splits that
// text apart again (terminator-indent strip, escapes and interpolation unless the
// marker was single-quoted). Modelled on the Ruby grammar's heredoc lexer.
HeredocLit  <~~ push(makeHeredoc(up.in)) ~~>
            = HdScan :whitespace(Whitespace) ;
HdScan = :script(~~
    (function() {
        var no = abnf.newToken("\x01noheredoc", 0)
        // Whitespace is not skipped before a script, so step over it here.
        var i = 0
        var cc = c.peek(i)
        var steps = 0
        while (steps < 100000) {
            steps = steps + 1
            if (cc === 32 || cc === 9 || cc === 13 || cc === 10) { i = i + 1; cc = c.peek(i); continue }
            break
        }
        var start = i
