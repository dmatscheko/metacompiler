        b = emitStaticSlots(b) // one reference cell per 'static $x' declaration site
        b = emitImported(b)   // imported files' items, each under its own source
        b = makeBody(all)(b) // a statement list like any body: labels work here too
        b.NewRet(handle(0))
    }

    core.scopeGetExt = "js_scope_get"

    phpLibClasses(c.srcSlice(0, 2147483647))
    c.compile(c.asg)

    // ----- the native build -----
    // jsdispatch(idx, env, args) is the function table a LINKED binary needs: js_closure
    // stores a raw function index, and under llvm.Run the Go runtime turns that index
    // back into a callee by looking "jsf_<idx>" up in the module. A binary has no such
    // reflection, so the module carries the mapping itself. The MISS arm calls
    // jsdispatch_ext, the same table emitted by the layer-2 runtime library
    // (lib/php-rt.ll, built by metajs-to-llvm-ir.abnf -rt-lib): its own function indices
    // are offset by a million, so the two chains cannot overlap and one js_call reaches
    // either module. Emitted ONLY for -exe. Twin of lua-to-llvm-ir.abnf's emitDispatch:
    // nothing here is PHP's.
    function emitDispatch() {
        var idxs = []
        var fns = []
        var i = 0
        while (i < m.Funcs.length) {
            var f = m.Funcs[i]
            var nm = f.Name()
            if (nm.length > 4 && nm.substring(0, 4) == "jsf_") {
                idxs.push(parseInt(nm.substring(4, nm.length)))
                fns.push(f)
            }
            i = i + 1
        }
        var ext = m.NewFunc("jsdispatch_ext", i64,
            [llvm.ir.NewParam("idx", i64), llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var d = m.NewFunc("jsdispatch", i64,
            [llvm.ir.NewParam("idx", i64), llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var b = d.NewBlock("entry")
        var extB = d.NewBlock("ext")
        var ownB = d.NewBlock("own")
        b.NewCondBr(b.NewICmp(llvm.enum.IPredSGE, d.Params[0], llvm.constant.NewInt(i64, 1000000)), extB, ownB)
        extB.NewRet(extB.NewCall(ext, [d.Params[0], d.Params[1], d.Params[2]]))
        b = ownB
        i = 0
        while (i < fns.length) {
            var hit = d.NewBlock("hit" + idxs[i])
            var nxt = d.NewBlock("miss" + idxs[i])
            b.NewCondBr(b.NewICmp(llvm.enum.IPredEQ, d.Params[0], llvm.constant.NewInt(i64, idxs[i])), hit, nxt)
            hit.NewRet(hit.NewCall(fns[i], [d.Params[1], d.Params[2]]))
            b = nxt
            i = i + 1
        }
        b.NewRet(b.NewCall(ext, [d.Params[0], d.Params[1], d.Params[2]]))
    }

    // runtime.c's main() calls jsmain(env, args); PHP's top level is phpmain, which has
    // the same signature. One forwarding definition rather than a rename, so the module
    // llvm.Run is handed keeps phpmain as its entry point.
    function emitJsMain() {
        var i = 0
        var pm = undefined
        while (i < m.Funcs.length) {
            if (m.Funcs[i].Name() == "phpmain") { pm = m.Funcs[i] }
            i = i + 1
        }
        if (pm == undefined) { fail("-exe: no phpmain in the module") }
        var f = m.NewFunc("jsmain", i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var b = f.NewBlock("entry")
        b.NewRet(b.NewCall(pm, [f.Params[0], f.Params[1]]))
    }

    // The two runtime inputs live next to THIS grammar, so the build does not depend on
    // the working directory: lib/runtime.ll is the C floor and lib/php-rt.ll is PHP's
    // own layer 2. An explicit -rt REPLACES both.
    function libPath(name) {
        var mn = moduleName()
        var cut = -1
        var i = 0
        while (i < mn.length) {
            var ch = mn.charAt(i)
            if (ch == "/" || ch == "\\") { cut = i }
            i = i + 1
        }
        return mn.substring(0, cut + 1) + "lib/" + name
    }

    // ----- the native build -----------------------------------------------------
    //
    // `-exe PATH` below produces a self-contained native binary out of
    // lib/runtime.ll (the C floor) and lib/php-rt.ll (PHP's layer 2). Reproduce it
    // by hand with:
    //
    //     mec languages/php-to-llvm-ir.abnf tests/php-test-full.php -q \
    //         -exe /tmp/php-native.out && /tmp/php-native.out
    //
    // which prints `full: N checks, 0 failures` - byte-identical with llvm.Run
    // on stdout, on stderr and in its exit code.
    //
    // Do not write tests/clang-check.sh's row-held marker literal anywhere in this
    // grammar: the script greps for it and would hold the row.
    if (c.exePath != undefined && c.exePath != "") {
        emitJsMain()
        emitDispatch()
        var rts = c.runtime
        if (rts == undefined || rts.length == 0) { rts = [libPath("runtime.ll"), libPath("php-rt.ll")] }
        var buildErr = llvm.BuildExecutable(m, c.exePath, rts)
        if (buildErr != "") {
            println(buildErr)
            exit(1)
        }
        println("php compiler: wrote executable " + c.exePath)
        exit(0)
    }

    println(m)

    var res = llvm.RunJS(m, "phpmain")
    println("php compiler: phpmain() returned " + res.Ret)
    exit(res.Ret)

~~) ;
