            restB = f.NewBlock("rest")
            cbVisChk(restB, env, v, hNull, where)
            restB.NewBr(okB)
        }
        notStrB.NewCondBr(truthy(notStrB, callExt(notStrB, "js_phcbarr", [v, where])), arrB, restB)
        var cnA = callExt(arrB, "js_phstr", [callExt(arrB, "js_phget", [v, emitNum(arrB, 0)])])
        var mnA = callExt(arrB, "js_phstr", [callExt(arrB, "js_phget", [v, emitNum(arrB, 1)])])
        arrB = cloStaticOk(f, arrB, cnA, mnA, where, okB)
        var clsA = arrB.NewCall(classNamedFn(), [env, cnA, where])
        arrB = cbClsChk(f, arrB, env, where, clsA, mnA, cnA, emitNum(arrB, 1), okB)
        arrB = cbNsChk(f, arrB, env, ns, clsA, cnA, mnA, where)
        cbVisChk(arrB, env, v, clsA, where)
        arrB.NewBr(okB)
