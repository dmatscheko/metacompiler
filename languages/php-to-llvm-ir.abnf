    // ----- literal builders -----
    // A float literal's text, with PHP 7.4 underscore separators (and any whitespace
    // the token carries) stripped before parseFloat. A float is BOXED (js_phflo), the
    // same way the interpreter boxes it, so 1.0 !== 1 and match(3.0) stay observable.
    function makeFloat(n) {
        return function(b) { return {b: b, v: callExt(b, "js_phflo", [emitNum(b, n)])} }
    }
