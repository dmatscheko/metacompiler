        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "PHP_INT_MAX"),
                                     callExt(b, "js_philit", [emitStr(b, "9223372036854775807"), emitNum(b, 10)])])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "PHP_INT_MIN"),
                                     callExt(b, "js_philit", [emitStr(b, "-9223372036854775808"), emitNum(b, 10)])])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "PHP_FLOAT_DIG"), emitNum(b, 15)])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "PHP_FLOAT_EPSILON"),
                                     callExt(b, "js_phflo", [emitNum(b, Math.pow(2, 0 - 52))])])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "PHP_FLOAT_MAX"),
                                     callExt(b, "js_phflo", [emitNum(b, (2 - Math.pow(2, 0 - 52)) * Math.pow(2, 1023))])])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "PHP_FLOAT_MIN"),
                                     callExt(b, "js_phflo", [emitNum(b, Math.pow(2, 0 - 1022))])])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "INF"), callExt(b, "js_phflo", [emitNum(b, 1 / 0)])])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "NAN"), callExt(b, "js_phflo", [emitNum(b, 0 / 0)])])
        for (var mci = 0; mci < mathConstNames.length; mci++) {
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, mathConstNames[mci]),
                                         callExt(b, "js_phflo", [emitNum(b, mathConstVals[mci])])])
        }
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "E_ALL"), emitNum(b, 32767)])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "E_ERROR"), emitNum(b, 1)])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "E_WARNING"), emitNum(b, 2)])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "E_NOTICE"), emitNum(b, 8)])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "E_DEPRECATED"), emitNum(b, 8192)])
        b = emitExcClasses(b) // Exception / Error and their subclasses
        b = emitStdClass(b)
        // The engine's own arithmetic errors (division by zero, a negative shift
        // count) are THROWN, and the class descriptors live in this scope - so the
        // runtime is handed them to raise with. See phpRaise in abnf/jsrtphp.go and
        // phpRaise in php-interpreter.abnf.
        //
        // What goes over is a PHP ARRAY of name => descriptor, a plain VALUE: layer 2
        // cannot open a scope, so the emitter (which may call js_scope_get) reads it.
        var regV = callExt(b, "js_pharr", [])
        // "Error" is here for the METHOD and NAME misses (js_phmcall / js_phmissname
        // in languages/lib/php-rt.metajs and abnf/jsrtphp.go), which PHP 8 raises as a
        // catchable Error.
        // "stdClass" is the class of an (object) cast (js_phcast).
        var rtCls = ["DivisionByZeroError", "ArithmeticError", "Error", "ValueError", "TypeError", "stdClass"]
        for (var rc = 0; rc < rtCls.length; rc++) {
            callExt(b, "js_phset", [regV, emitStr(b, rtCls[rc]),
