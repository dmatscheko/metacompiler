    function isHexCh(ch) { return (ch >= "0" && ch <= "9") || (ch >= "a" && ch <= "f") || (ch >= "A" && ch <= "F") }
    function hexVal(ch) {
        var cc = ch.charCodeAt(0)
        if (cc >= 48 && cc <= 57) { return cc - 48 }
        if (cc >= 97) { return cc - 87 }
        return cc - 55
    }
    function codePointStr(cp) {
        if (cp < 65536) { return String.fromCharCode(cp) }
        var off = cp - 65536
        return String.fromCharCode(55296 + ((off - (off % 1024)) / 1024)) + String.fromCharCode(56320 + (off % 1024))
