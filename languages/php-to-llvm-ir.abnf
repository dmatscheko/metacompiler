    // 'function &f()': the functions declared to return by reference, by lower-cased
    // name, and for each function being parsed whether it is one (refFnStack).
    // Twins of refFns / refRetVar / callHeadName in php-interpreter.abnf.
    var refFns = {}
    var refFnStack = []
    var defAmp = false
    function refFnEnter(name) {
        refFnStack.push(defAmp)
        if (defAmp) {
            refFns["$" + phsCase(stripWs(name), false)] = true
            noteRef()
        }
        defAmp = false
    }
    function refRetVar(t) {
        if (refFnStack.length == 0 || refFnStack[refFnStack.length - 1] !== true) { return null }
        var e = t.substring(6, t.length - 1)
        if (e.length < 2 || e.charAt(0) != "$" || e == "$this") { return "" }
        for (var i = 1; i < e.length; i++) {
            var ch = e.charAt(i)
            if (!(isNameStart(ch) || (ch >= "0" && ch <= "9"))) { return "" }
        }
        return e
    }
    function callHeadName(t) {
        var i = 0
        while (i < t.length && (isNameStart(t.charAt(i)) || t.charAt(i) == "\\" || (i > 0 && t.charAt(i) >= "0" && t.charAt(i) <= "9"))) { i++ }
        if (i == 0 || i >= t.length || t.charAt(i) != "(") { return "" }
        // The argument list must close the text: 'f()->g()' is a chain, not f's call.
        var depth = 0
        for (var j = i; j < t.length; j++) {
            if (t.charAt(j) == "(") { depth++ }
            else if (t.charAt(j) == ")") {
                depth--
                if (depth == 0 && j != t.length - 1) { return "" }
            }
        }
        return lastSeg(phsCase(t.substring(0, i), false))
    }
    // break / continue go through emitBreak / emitContinue so a jump that leaves a try
    // body (with no loop of its own) becomes a control signal instead of an invalid
    // branch; outside a try body they are a plain b.NewBr.
    // 'break N' / 'continue N' name the N-th enclosing loop or switch, counted from the
    // innermost - which is a direct branch to that level's exit / continue block.
    makeBreak = function(items) {
        var n = jumpLevel(items)
        jumpCheck("break", n)
        return function(b) {
            if (n > 1 && loopStack.length >= n) { b.NewBr(loopStack[loopStack.length - n].brk) }
            else { emitBreak(b) }
            return deadBlock()
        }
    }
    makeContinue = function(items) {
        var n = jumpLevel(items)
        jumpCheck("continue", n)
        return function(b) {
            if (n > 1 && loopStack.length >= n) { b.NewBr(loopStack[loopStack.length - n].cont) }
            else { emitContinue(b) }
            return deadBlock()
        }
    }
    // ----- switch / do-while / goto ---------------------------------------------
    function makeCase(items) {
        var cond = null
        var isDflt = false
        var stmts = []
        for (var i = 0; i < items.length; i++) {
            if (items[i] == undefined) { continue }
            if (items[i].casecond != undefined) { cond = items[i].casecond }
            else if (items[i].casedflt != undefined) { isDflt = true }
