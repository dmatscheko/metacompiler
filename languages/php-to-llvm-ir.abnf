    function makeConstStmt() { return function(b) { return b } }
    function makeReturn(items, rv) {
        var t = items.length > 0 ? items[0] : null
        return function(b) {
            var v = hNull
            if (t != null) { var r = t(b); b = r.b; v = r.v }
            // In a function returning by reference: the variable's cell, or null for a
            // value that is no variable, is left in the globals frame's \x00refret for
            // a caller that writes through the result (memoRefV).
            if (rv != null) {
                var cv = hNull
                if (rv != "") {
                    var rc = varCell(b, rv)
                    b = rc.b
                    cv = rc.v
                }
                callExt(b, "js_scope_decl", [globalsFrameV(b), emitStr(b, "\x00refret"), cv])
            }
            return retStmt(b, v) // plain ret, or a control signal when leaving a try body
        }
