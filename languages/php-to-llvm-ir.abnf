                var dLsb = callExt(bb, "js_scope_get", [bf.Params[0], emitStr(bb, "\x00dclsb")])
                if (anyMVis) { res = callExt(bb, "js_phscallv", [selfV, nmV, dThis, phListOf(bb, bf.Params[1]), dLsb, dsc]) }
                else { res = callExt(bb, "js_phscall", [selfV, nmV, dThis, phListOf(bb, bf.Params[1]), dLsb]) }
            }
