    // arguments in order, an absent optional one as null (abnf/jsrtphpstr.go,
    // lib/php-strings.js and lib/php-rt.metajs).
    function phpNativeExt(name) {
        if (name == "substr") { return "js_phsubstr" }
        if (name == "strpos") { return "js_phstrpos" }
        if (name == "strrpos") { return "js_phstrrpos" }
        if (name == "strcmp") { return "js_phstrcmp" }
        if (name == "ord") { return "js_phord" }
        if (name == "chr") { return "js_phchr" }
        if (name == "__mec_fmtfloat") { return "js_phfmtfloat" }
        if (name == "__mec_math") { return "js_phmath" }
        if (name == "__mec_aptr") { return "js_phaptr" }
        if (name == "__mec_precision") { return "js_phprecision" }
        if (name == "__mec_oid") { return "js_phoidof" }
        if (name == "array_key_exists") { return "js_phkeyexists" }
        if (name == "array_key_last") { return "js_phkeylast" }
        if (name == "array_pop") { return "js_phpop" }
        return ""
