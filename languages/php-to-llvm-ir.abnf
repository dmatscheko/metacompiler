        else if (name == "__set") { magicSet = true }
        else if (name == "__isset") { magicIsset = true }
        else if (name == "__unset") { magicUnset = true }
        else if (name == "__call") { magicCall = true }
        else if (name == "__invoke") { magicInvoke = true }
