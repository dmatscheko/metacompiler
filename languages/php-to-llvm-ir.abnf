        }
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, itN), srcV])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, ixN), emitNum(b, 0)])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, stN), hUndef])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, lnN), emitNum(b, 0)])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, gnN), isGen])
        var startG = curF.NewBlock("")
        var startA = curF.NewBlock("")
        var headB = curF.NewBlock("")
        b.NewCondBr(truthy(b, isGen), startG, startA)
        callExt(startG, "js_scope_set", [curScopeV, emitStr(startG, stN), feStep(startG, srcV, hTrue, hTrue)])
        startG.NewBr(headB)
        callExt(startA, "js_scope_set", [curScopeV, emitStr(startA, lnN),
                                         callExt(startA, "js_range_len", [srcV])])
        startA.NewBr(headB)
        var bodyB = curF.NewBlock("")
        var postB = curF.NewBlock("")
        var exitB = curF.NewBlock("")
        var gHead = curF.NewBlock("")
        var aHead = curF.NewBlock("")
        headB.NewCondBr(truthy(headB, callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, gnN)])), gHead, aHead)
        var stH = callExt(gHead, "js_scope_get", [curScopeV, emitStr(gHead, stN)])
        gHead.NewCondBr(truthy(gHead, callExt(gHead, "js_get", [stH, emitStr(gHead, "done")])), exitB, bodyB)
        var iH = callExt(aHead, "js_scope_get", [curScopeV, emitStr(aHead, ixN)])
        var lH = callExt(aHead, "js_scope_get", [curScopeV, emitStr(aHead, lnN)])
        aHead.NewCondBr(truthy(aHead, callExt(aHead, "js_lt", [iH, lH])), bodyB, exitB)
        var gBody = curF.NewBlock("")
        var aBody = curF.NewBlock("")
        var kvB = curF.NewBlock("")
        var plainB = curF.NewBlock("")
        var joinB = curF.NewBlock("")
        var bindB = curF.NewBlock("")
        bodyB.NewCondBr(truthy(bodyB, callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, gnN)])), gBody, aBody)
        var stB = callExt(gBody, "js_scope_get", [curScopeV, emitStr(gBody, stN)])
        var rawV = callExt(gBody, "js_get", [stB, emitStr(gBody, "value")])
        gBody.NewCondBr(truthy(gBody, callExt(gBody, "js_phisset", [rawV, emitStr(gBody, "__genkv")])), kvB, plainB)
        var kvK = callExt(kvB, "js_get", [rawV, emitStr(kvB, "k")])
        var kvV = callExt(kvB, "js_get", [rawV, emitStr(kvB, "v")])
        kvB.NewBr(joinB)
        var autoK = genAutoKey(plainB, itN)
        plainB.NewBr(joinB)
        var gK = joinB.NewPhi([llvm.ir.NewIncoming(kvK, kvB), llvm.ir.NewIncoming(autoK, plainB)])
        var gV = joinB.NewPhi([llvm.ir.NewIncoming(kvV, kvB), llvm.ir.NewIncoming(rawV, plainB)])
        joinB.NewBr(bindB)
        var itA = callExt(aBody, "js_scope_get", [curScopeV, emitStr(aBody, itN)])
        var ixA = callExt(aBody, "js_scope_get", [curScopeV, emitStr(aBody, ixN)])
        var aK = callExt(aBody, "js_range_key", [itA, ixA])
        var aV = callExt(aBody, "js_range_val", [itA, ixA])
        aBody.NewBr(bindB)
        var keyV = bindB.NewPhi([llvm.ir.NewIncoming(gK, joinB), llvm.ir.NewIncoming(aK, aBody)])
        var valV = bindB.NewPhi([llvm.ir.NewIncoming(gV, joinB), llvm.ir.NewIncoming(aV, aBody)])
        // A delegated value keeps its own key and leaves the generator's running
        // index alone (__genfrom): `yield 1; yield from [7, 8]; yield 5;` keys 5 by 1.
        var pair = callExt(bindB, "js_obj_new", [])
        callExt(bindB, "js_set", [pair, emitStr(bindB, "__genkv"), hTrue])
        callExt(bindB, "js_set", [pair, emitStr(bindB, "__genfrom"), hTrue])
        callExt(bindB, "js_set", [pair, emitStr(bindB, "k"), keyV])
        callExt(bindB, "js_set", [pair, emitStr(bindB, "v"), valV])
        callExt(bindB, "js_yield", [pair])
        bindB.NewBr(postB)
        var ixP = callExt(postB, "js_scope_get", [curScopeV, emitStr(postB, ixN)])
        callExt(postB, "js_scope_set", [curScopeV, emitStr(postB, ixN),
                                        intWrap(postB, callExt(postB, "js_jadd", [ixP, emitNum(postB, 1)]))])
        var gPost = curF.NewBlock("")
        postB.NewCondBr(truthy(postB, callExt(postB, "js_scope_get", [curScopeV, emitStr(postB, gnN)])), gPost, headB)
        var itP = callExt(gPost, "js_scope_get", [curScopeV, emitStr(gPost, itN)])
        callExt(gPost, "js_scope_set", [curScopeV, emitStr(gPost, stN), feStep(gPost, itP, hFalse, hTrue)])
        gPost.NewBr(headB)
        return exitB
    }
    // One step of foreach's generator walk: a generator's next(), or, in a program
    // with iterators, js_phfestep, which also drives an Iterator.
    function feStep(b, itV, first, needKey) {
        if (!usesIter) { return genNext(b, itV) }
        return callExt(b, "js_phfestep", [itV, first, needKey])
    }
    function makeForeachGen(iterT, keyName, valName, pat, body, byRef) {
        return function(b) {
            var ir = iterT(b)
            b = ir.b
            hidCount++
            var itN = "\x00Fi" + hidCount
            var ixN = "\x00Fx" + hidCount
            var stN = "\x00Fs" + hidCount
            var gnN = "\x00Fg" + hidCount
            var lnN = "\x00Fl" + hidCount
            var isGen = callExt(b, "js_phisa", [ir.v, emitStr(b, "Generator")])
            if (usesIter) {
                isGen = b.NewSelect(truthy(b, isGen), hTrue, callExt(b, "js_phisa", [ir.v, emitStr(b, "Iterator")]))
            }
            var needKey = keyName != null ? hTrue : hFalse
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, itN), ir.v])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, ixN), emitNum(b, 0)])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, stN), hUndef])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, lnN), emitNum(b, 0)])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, gnN), isGen])
            var startG = curF.NewBlock("")
            var startA = curF.NewBlock("")
            var headB = curF.NewBlock("")
            b.NewCondBr(truthy(b, isGen), startG, startA)
            callExt(startG, "js_scope_set", [curScopeV, emitStr(startG, stN), feStep(startG, ir.v, hTrue, needKey)])
            startG.NewBr(headB)
            callExt(startA, "js_scope_set", [curScopeV, emitStr(startA, lnN),
                                             callExt(startA, "js_range_len", [ir.v])])
            startA.NewBr(headB)
            var bodyB = curF.NewBlock("")
            var postB = curF.NewBlock("")
            var exitB = curF.NewBlock("")
            var gHead = curF.NewBlock("")
            var aHead = curF.NewBlock("")
            headB.NewCondBr(truthy(headB, callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, gnN)])), gHead, aHead)
            var stH = callExt(gHead, "js_scope_get", [curScopeV, emitStr(gHead, stN)])
            gHead.NewCondBr(truthy(gHead, callExt(gHead, "js_get", [stH, emitStr(gHead, "done")])), exitB, bodyB)
            var iH = callExt(aHead, "js_scope_get", [curScopeV, emitStr(aHead, ixN)])
            var lH = callExt(aHead, "js_scope_get", [curScopeV, emitStr(aHead, lnN)])
            aHead.NewCondBr(truthy(aHead, callExt(aHead, "js_lt", [iH, lH])), bodyB, exitB)
            // key / value for this step
            var gBody = curF.NewBlock("")
            var aBody = curF.NewBlock("")
            var kvB = curF.NewBlock("")
            var plainB = curF.NewBlock("")
            var joinB = curF.NewBlock("")
            bodyB.NewCondBr(truthy(bodyB, callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, gnN)])), gBody, aBody)
            var stB = callExt(gBody, "js_scope_get", [curScopeV, emitStr(gBody, stN)])
            var rawV = callExt(gBody, "js_get", [stB, emitStr(gBody, "value")])
            gBody.NewCondBr(truthy(gBody, callExt(gBody, "js_phisset", [rawV, emitStr(gBody, "__genkv")])), kvB, plainB)
            var kvK = callExt(kvB, "js_get", [rawV, emitStr(kvB, "k")])
            var kvV = callExt(kvB, "js_get", [rawV, emitStr(kvB, "v")])
            kvB.NewBr(joinB)
            var autoK = keyName == null ? hNull : genAutoKey(plainB, itN)
            plainB.NewBr(joinB)
            var gK = joinB.NewPhi([llvm.ir.NewIncoming(kvK, kvB), llvm.ir.NewIncoming(autoK, plainB)])
            var gV = joinB.NewPhi([llvm.ir.NewIncoming(kvV, kvB), llvm.ir.NewIncoming(rawV, plainB)])
            var bindB = curF.NewBlock("")
            joinB.NewBr(bindB)
            var itA = callExt(aBody, "js_scope_get", [curScopeV, emitStr(aBody, itN)])
            var ixA = callExt(aBody, "js_scope_get", [curScopeV, emitStr(aBody, ixN)])
            var aK = callExt(aBody, "js_range_key", [itA, ixA])
            var aV = anytype
            if (byRef) { aV = elemCell(aBody, itA, aK) }
            else {
                var rdA = phDeref(aBody, callExt(aBody, "js_range_val", [itA, ixA]))
                aBody = rdA.b
                aV = callExt(aBody, "js_phcopy", [rdA.v])
            }
            aBody.NewBr(bindB)
            var keyV = bindB.NewPhi([llvm.ir.NewIncoming(gK, joinB), llvm.ir.NewIncoming(aK, aBody)])
            var valV = bindB.NewPhi([llvm.ir.NewIncoming(gV, joinB), llvm.ir.NewIncoming(aV, aBody)])
            var bb = bindB
            if (keyName != null) { bb = emitFeBind(bb, keyName, keyV) }
            if (pat != null) { bb = emitBindPattern(bb, pat, valV) }
            else { bb = emitFeBind(bb, valName, valV, byRef) }
            loopStack.push({cont: postB, brk: exitB})
            body(bb).NewBr(postB)
            loopStack.pop()
            var ixP = callExt(postB, "js_scope_get", [curScopeV, emitStr(postB, ixN)])
            callExt(postB, "js_scope_set", [curScopeV, emitStr(postB, ixN),
                                            intWrap(postB, callExt(postB, "js_jadd", [ixP, emitNum(postB, 1)]))])
            var gPost = curF.NewBlock("")
            postB.NewCondBr(truthy(postB, callExt(postB, "js_scope_get", [curScopeV, emitStr(postB, gnN)])), gPost, headB)
            var itP = callExt(gPost, "js_scope_get", [curScopeV, emitStr(gPost, itN)])
            callExt(gPost, "js_scope_set", [curScopeV, emitStr(gPost, stN), feStep(gPost, itP, hFalse, needKey)])
            gPost.NewBr(headB)
            return exitB
        }
    }

    // ----- ternary / Elvis / null-coalescing (expressions) -----
    // items: [cond] plain, [cond, {elvis}] Elvis, [cond, then, else] full ternary.
    function makeTernary(items) {
        if (items.length == 1) { return items[0] }
        if (items.length == 2) {
            var condE = items[0]
            var rightE = items[1].elvis
            return function(b) {
                var rc = condE(b)
                b = rc.b
                var thenB = curF.NewBlock("")
                var elseB = curF.NewBlock("")
                var mergeB = curF.NewBlock("")
                b.NewCondBr(truthy(b, rc.v), thenB, elseB)
                thenB.NewBr(mergeB)
                var re = rightE(elseB)
                re.b.NewBr(mergeB)
                var phi = mergeB.NewPhi([llvm.ir.NewIncoming(rc.v, thenB), llvm.ir.NewIncoming(re.v, re.b)])
                return {b: mergeB, v: phi}
            }
        }
        var condT = items[0]
        var thenT = items[1]
        var elseT = items[2]
        return function(b) {
            var rc = condT(b)
            b = rc.b
            var thenB = curF.NewBlock("")
            var elseB = curF.NewBlock("")
            var mergeB = curF.NewBlock("")
            b.NewCondBr(truthy(b, rc.v), thenB, elseB)
            var rt = thenT(thenB)
            rt.b.NewBr(mergeB)
            var re = elseT(elseB)
            re.b.NewBr(mergeB)
            var phi = mergeB.NewPhi([llvm.ir.NewIncoming(rt.v, rt.b), llvm.ir.NewIncoming(re.v, re.b)])
            return {b: mergeB, v: phi}
        }
    }
    // a ?? b : the first operand that is not null (left fold; associative for '??').
    // Every operand but the last is fetched for isset: a member chain takes coalIs
    // (foldCallMember), and any other thunk ignores it.
    var coalIs = {coalIs: true}
    function makeCoalesce(items) {
        if (items.length == 1) { return items[0] }
        return function(b) {
            var r = items[0](b, coalIs)
            b = r.b
            var v = r.v
            for (var i = 1; i < items.length; i++) {
                var rightB = curF.NewBlock("")
                var mergeB = curF.NewBlock("")
                var isNull = b.NewICmp(llvm.enum.IPredEQ, v, hNull)
                b.NewCondBr(isNull, rightB, mergeB)
                var r2 = i == items.length - 1 ? items[i](rightB) : items[i](rightB, coalIs)
                r2.b.NewBr(mergeB)
                var phi = mergeB.NewPhi([llvm.ir.NewIncoming(v, b), llvm.ir.NewIncoming(r2.v, r2.b)])
                b = mergeB
                v = phi
            }
            return {b: b, v: v}
        }
    }
    // list($a, $b) = e / [$a, $b] = e : bind targets from the array's positions.
    // A slot is {empty} | {key, val}; val is either a nested {pat} or a target {dt}.
    function makeSlot(items) {
        if (items.length == 0) { return {empty: true, key: null, val: null} }
        var it = items[0]
        return {empty: false, key: it.dkey == undefined ? null : it.dkey, val: it.dval}
    }
    function makePattern(items) {
        var slots = []
        for (var i = 0; i < items.length; i++) { slots.push(items[i]) }
        return {slots: slots}
    }
    // Positional slots consume the next integer index; a KEYED slot reads its own key
    // and does not advance the position, which is PHP's rule and the interpreter's.
    function emitBindPattern(b, pat, arrV) {
        var pos = 0
        for (var i = 0; i < pat.slots.length; i++) {
            var sl = pat.slots[i]
            if (sl.empty === true) { pos = pos + 1; continue }
            var keyV = anytype
            if (sl.key != null) {
                var rk = sl.key(b)
                b = rk.b
                keyV = rk.v
            } else {
                keyV = emitNum(b, pos)
                pos = pos + 1
            }
            var elem = callExt(b, "js_phget", [arrV, keyV])
            if (sl.val.pat != undefined) {
                b = emitBindPattern(b, sl.val.pat, elem)
            } else {
                var ref = sl.val.dt
                if (ref.path.length == 0) {
                    var rn1 = refNameV(b, ref)
                    b = setVarV(rn1.b, rn1.v, callExt(rn1.b, "js_phcopy", [elem]))
                } else {
                    var p = emitRefPathV(b, ref, true)
                    b = writeRefSlot(p.b, p, elem)
                }
            }
        }
        return b
    }
    function makeDestructure(items) {
        var pat = null
        var valT = null
        for (var i = 0; i < items.length; i++) {
            if (items[i].pat != undefined) { pat = items[i].pat }
            else { valT = items[i] }
        }
        return function(b) {
            var r = valT(b)
            b = emitBindPattern(r.b, pat, r.v)
            return {b: b, v: r.v}
        }
    }

    // ----- && / || : short circuit, PHP-style boolean result -----
    makeOrAnd = function(items, isOr) {
        if (items.length == 1) { return items[0] }
        return function(b) {
            var r = items[0](b)
            b = r.b
            var v = r.v
            for (var i = 1; i < items.length; i++) {
                var rightB = curF.NewBlock("")
                var mergeB = curF.NewBlock("")
                var cnd = truthy(b, v)
                if (isOr) { b.NewCondBr(cnd, mergeB, rightB) }
                else      { b.NewCondBr(cnd, rightB, mergeB) }
                var r2 = items[i](rightB)
                r2.b.NewBr(mergeB)
                var phi = mergeB.NewPhi([llvm.ir.NewIncoming(v, b), llvm.ir.NewIncoming(r2.v, r2.b)])
                b = mergeB
                v = phi
            }
            var boolV = callExt(b, "js_phbool", [v])
            return {b: b, v: boolV}
        }
    }

    // ----- '|>' : the pipe, left associative -----
    // makePipe receives [v, f1, f2, ...] and builds f2(f1(v)). pipeStep is a named
    // function rather than an inline closure so each step captures its OWN operands
    // (an inline closure in the loop would share the loop variable, and the frozen
    // engine is stricter about that than goja). The right operand is coerced with the
    // same callableV a '(...)' call suffix uses, so a function NAME in a string, a
    // closure and a first-class callable all work; an instance runs its __invoke, the
    // same branch the call suffix emits.
    function pipeStep(lhsT, rhsT) {
        return function(b) {
            var rl = lhsT(b)
            b = rl.b
            var rr = rhsT(b)
            b = rr.b
            var rc = callableV(b, rr.v, false, false)
            b = rc.b
            var argsV = dynPlaceArgs(b, rc.v, argList(b, [rl.v]), true)
            if (!magicInvoke) { return {b: b, v: callExt(b, "js_call", [rc.v, hUndef, argsV])} }
            var invB = curF.NewBlock("")
            var fnB = curF.NewBlock("")
            var endI = curF.NewBlock("")
            b.NewCondBr(emitIsObj(b, rc.v), invB, fnB)
            var iv = callExt(invB, "js_phmcall", [rc.v, emitStr(invB, "__invoke"), argsV])
            invB.NewBr(endI)
            var fv = callExt(fnB, "js_call", [rc.v, hUndef, argsV])
            fnB.NewBr(endI)
            return {b: endI, v: endI.NewPhi([llvm.ir.NewIncoming(iv, invB), llvm.ir.NewIncoming(fv, fnB)])}
        }
    }
    function makePipe(items) {
        nsUsed = true
        var cur = items[0]
        for (var i = 1; i < items.length; i++) { cur = pipeStep(cur, items[i]) }
        return cur
    }

    // ----- PHP's value model: the whole operator ladder goes through js_ph* -------
    // The handle runtime's default operators are JavaScript's, and PHP's are not:
    // '==' is loose, '"0"' is falsy, a float is a distinct type from an int, and an
    // array is one ordered map whose '===' compares the keys AND their order. Each
    // js_ph* external below is the Go twin of the like-named function in
    // php-interpreter.abnf (phpLoose / phpIdentical / phpCmp / phpArith / phptest /
    // phpStr), so the interpreter stays the reference implementation and the two
    // engines answer the same thing. See abnf/jsrtphp.go.
    core.truthyExt = "js_phtruthy"
    binExt["==="] = "js_phseq"
    binExt["!=="] = "js_phsne"
    binExt["=="] = "js_pheq"
    binExt["!="] = "js_phne"
    binExt["<>"] = "js_phne"
    binExt["<"] = "js_phlt"
    binExt[">"] = "js_phgt"
    binExt["<="] = "js_phle"
    binExt[">="] = "js_phge"
    binExt["+"] = "js_phadd"
    binExt["-"] = "js_phsub"
    binExt["*"] = "js_phmul"
    binExt["/"] = "js_phdiv"
    binExt["%"] = "js_phmod"
    binExt["+="] = "js_phadd"
    binExt["-="] = "js_phsub"
    binExt["*="] = "js_phmul"
    binExt["/="] = "js_phdiv"
    binExt["%="] = "js_phmod"
    // js_ph* already answers in PHP's own type (an int stays an int, any float
    // operand makes the result a float), so the C-family 32-bit truncation the
    // shared emitBin applies must be off for every one of them. PHP integers are
    // 64 bit and '/' is float division (7 / 2 is 3.5), which intWrap would destroy.
    wraps["/"] = 0
    wraps["/="] = 0
    wraps["-"] = 0
    wraps["-="] = 0
    wraps["*"] = 0
    wraps["*="] = 0
    wraps["%"] = 0
    wraps["%="] = 0
    makeNeg = function(t) {
        return function(b) {
            var r = t(b)
            return {b: r.b, v: callExt(r.b, "js_phneg", [r.v])}
        }
    }
    // PHP compiles +$x as $x * 1: "5" becomes int(5) and "abc" is a TypeError.
    function makePos(t) {
        return function(b) {
            var r = t(b)
            return {b: r.b, v: callExt(r.b, "js_phmul", [r.v, emitNum(r.b, 1)])}
        }
    }
    // '!' is PHP truthiness, not JS truthiness ('!"0"' is true).
    makeNot = function(t) {
        return function(b) {
            var r = t(b)
            return {b: r.b, v: callExt(r.b, "js_phnot", [r.v])}
        }
    }
    // The rest of PHP's binary ladder. The bitwise / shift forms are exact 64 bit,
    // like phpBit in the interpreter.
    binExt["&"] = "js_phband"
    binExt["|"] = "js_phbor"
    binExt["^"] = "js_phbxor"
    binExt["<<"] = "js_phshl"
    binExt[">>"] = "js_phshr"
    binExt["&="] = "js_phband"
    binExt["|="] = "js_phbor"
    binExt["^="] = "js_phbxor"
    binExt["<<="] = "js_phshl"
    binExt[">>="] = "js_phshr"
    emitBin = function(b, op, l, r) {
        if (op == "." || op == ".=") {
            return callExt(b, "js_phcat", [l, r])
        }
        if (op == "**" || op == "**=") {
            return callExt(b, "js_phpow", [l, r])
        }
        // '<=>' answers exactly -1 / 0 / 1 from PHP's own comparison.
        if (op == "<=>") {
            return callExt(b, "js_phcmp", [l, r])
        }
        var v = callExt(b, binExt[op], [l, r])
        if (wraps[op] == 1) { v = intWrap(b, v) }
        return v
    }
    // 2 ** 3 ** 2 == 512: the parse is already right-associative (the right operand is
    // a full UnaryExpr), so the fold only has to apply the operator when one is there.
    function foldPow(items) {
        if (items.length == 1) { return items[0] }
        var base = items[0]
        var exp = items[1]
        return function(b) {
            var rl = base(b)
            var rr = exp(rl.b)
            return {b: rr.b, v: emitBin(rr.b, "**", rl.v, rr.v)}
        }
    }
