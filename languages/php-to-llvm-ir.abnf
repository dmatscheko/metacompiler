FloatTail   = "." { "0"..."9" | "_" } [ ExpPart ] | ExpPart ;
ExpPart     = ( "e" | "E" ) [ "+" | "-" ] "0"..."9" { "0"..."9" } ;
PhpHex      <~~ push(makeConst(phpRadixLit(up.in, 16))) ~~>
