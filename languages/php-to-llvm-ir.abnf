        if (name == "count") { return {b: b, v: callExt(b, "js_phlen", [vs[0]])} }
        if (name == "in_array") { return {b: b, v: callExt(b, "js_phin", [vs[0], vs[1]])} }
        if (name == "array_push") { callExt(b, "js_phpush", [vs[0], vs[1]]); return {b: b, v: callExt(b, "js_phlen", [vs[0]])} }
        if (name == "array_keys") { return {b: b, v: callExt(b, "js_phkeys", [vs[0]])} }
        if (name == "array_values") { return {b: b, v: callExt(b, "js_phvals", [vs[0]])} }
