    }
    function emitExcGetter(prop) {
        return emitFunc([], function(bb) {
            var thisV = callExt(bb, "js_scope_get", [curScopeV, emitStr(bb, "$this")])
            return retStmt(bb, callExt(bb, "js_get", [thisV, emitStr(bb, prop)]))
        }, true)
    }
    function emitExcClasses(b) {
        for (var i = 0; i < excRoots.length; i++) { b = emitExcClass(b, excRoots[i], "") }
        for (var j = 0; j < excDerived.length; j++) {
            b = emitExcClass(b, excDerived[j][0], excDerived[j][1])
        }
        return b
    }
    // stdClass: the empty class of `new stdClass`, an (object) cast and
    // json_decode's objects. Twin of the stdClass declaration in
    // php-interpreter.abnf.
    function emitStdClass(b) {
        var clsV = callExt(b, "js_obj_new", [])
        callExt(b, "js_set", [clsV, emitStr(b, "__isclass"), hTrue])
        callExt(b, "js_set", [clsV, emitStr(b, "__name"), emitStr(b, "stdClass")])
        b = emitInitProps(b, clsV, "stdClass", "", [])
        var ctor = emitFunc([], function(bb) { return bb }, true, false, "stdClass")
        callExt(b, "js_set", [clsV, emitStr(b, "__construct"), callExt(b, "js_closure", [handle(ctor), curScopeV])])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "stdClass"), clsV])
        declClassAlias(b, "stdClass", clsV)
        return b
    }
    // A braced namespace body: emit its items where the declaration stands.
    function makeNs(items, pos) {
        for (var i = 0; i < items.length; i++) {
            if (items[i].nsbody != undefined) { return items[i].nsbody }
        }
        return notImplStmt("namespace", pos)
    }
    // ext/standard's math constants: php_math.h's decimal values, each written as
    // the shortest form that reads back as the same double. Twin of phpMathConsts
    // in php-interpreter.abnf.
    var mathConstNames = ["M_PI", "M_E", "M_LOG2E", "M_LOG10E", "M_LN2", "M_LN10", "M_PI_2", "M_PI_4",
        "M_1_PI", "M_2_PI", "M_SQRTPI", "M_2_SQRTPI", "M_LNPI", "M_EULER", "M_SQRT2",
        "M_SQRT1_2", "M_SQRT3"]
    var mathConstVals = [3.141592653589793, 2.718281828459045, 1.4426950408889634, 0.4342944819032518,
        0.6931471805599453, 2.302585092994046, 1.5707963267948966, 0.7853981633974483,
        0.3183098861837907, 0.6366197723675814, 1.772453850905516, 1.1283791670955126,
        1.1447298858494002, 0.5772156649015329, 1.4142135623730951, 0.7071067811865476,
        1.7320508075688772]
    function buildMain(items) {
        jumpResolve(jw.frames[0])
        var all = topDefs.concat(topClasses).concat(items)
        topDefs = []
        topClasses = []
        hoisted = {}
        // The walk of an imported file ends here too: stash its top-level thunks for the
        // real phpmain instead of emitting a second one.
        if (importDepth > 0) {
            stashImported(all) // stashed with its file; emitted later (compile-core)
            return
        }
        var f = m.NewFunc("phpmain", i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        curF = f
        var b = f.NewBlock("entry")
        curScopeV = callExt(b, "js_scope_new", [f.Params[0]])
        // The main frame holds the global variables; `global $x` finds it by this name.
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "\x00globals"), curScopeV])
        // The bareword spellings of the three literals (PHP's true/false/null are
        // case insensitive) plus the handful of constants a program may read.
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "TRUE"), hTrue])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "FALSE"), hFalse])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "NULL"), hNull])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "PHP_EOL"), emitStr(b, "\n")])
        // PHP's int is 64 bit two's complement, so the extremes are values a double
        // cannot carry and have to come from js_philit.
