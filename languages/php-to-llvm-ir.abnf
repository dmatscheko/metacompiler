    // declares __get anywhere - emitHasMethod's js_get(objV, "__class"). It is the
    // intermediate step of `isset($undef->a->b)` / `isset($o->missing->p)`.
    //
    // ONLY the non-creating walk gets it. An ordinary `$null->p` READ aborts, because
    // php-interpreter.abnf aborts there too ("property ->p of null"); answering PHP 8's
    // warn-and-null in this half alone would make the two halves diverge.
    function emitPropGetSafe(b, objV, keyV, name, thisLex) {
        var nullB = curF.NewBlock("")
        var liveB = curF.NewBlock("")
        var joinB = curF.NewBlock("")
        b.NewCondBr(isNullishHandle(b, objV), nullB, liveB)
        nullB.NewBr(joinB)
        var r = emitPropGet(liveB, objV, keyV, name, thisLex, true)
        r.b.NewBr(joinB)
        return {b: joinB, v: joinB.NewPhi([llvm.ir.NewIncoming(hNull, nullB),
