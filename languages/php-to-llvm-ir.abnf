    // The UTF-8 bytes of code point cp, as a byte string.
    function dqUtf8(cp) {
        var tail = ""
        var v = cp
        var lead = 0
        var room = 128
        while (v >= room) {
            tail = String.fromCharCode(128 + v % 64) + tail
            v = Math.floor(v / 64)
            lead = lead == 0 ? 192 : 128 + lead / 2
            room = room == 128 ? 32 : room / 2
        }
        return String.fromCharCode(lead + v) + tail
    }
    // A literal piece of a double-quoted string or heredoc: {s: text}, or {sb:
    // bytes} when the text would hold a byte that is not part of a character,
    // which the tag stack cannot carry (js_phfrombytes turns it into text at run time).
    function dqPiece(raw) {
        var bytes = unescapeDq(raw)
        var text = phsFromBytes(bytes)
        if (phsHasHeld(text)) { return {sb: bytes} }
        return {s: text}
    }
    function isHexCh(ch) { return (ch >= "0" && ch <= "9") || (ch >= "a" && ch <= "f") || (ch >= "A" && ch <= "F") }
    function hexVal(ch) {
        var cc = ch.charCodeAt(0)
        if (cc >= 48 && cc <= 57) { return cc - 48 }
        if (cc >= 97) { return cc - 87 }
        return cc - 55
    }
    function unescapeSq(s) {
        var out = ""
        var i = 0
        while (i < s.length) {
            var c = s.charCodeAt(i)
            if (c == 92 && i + 1 < s.length) {
                var e = s.charCodeAt(i + 1)
                if (e == 39 || e == 92) { out += String.fromCharCode(e); i += 2; continue }
            }
            out += String.fromCharCode(c)
            i++
        }
        return out
    }

    // ----- control flow (statement thunks: function(b) -> block) -----
    function makeBody(items) {
        var labels = []
        for (var i = 0; i < items.length; i++) {
            if (items[i] != undefined && items[i].lblstmt != undefined) { labels.push(items[i].lblstmt) }
        }
        if (labels.length == 0) {
            return function(b) {
                for (var j = 0; j < items.length; j++) { b = items[j](b) }
                return b
            }
        }
        return function(b) {
            for (var k = 0; k < labels.length; k++) {
                labelIds["$" + labels[k]] = ctlLabel(curF.NewBlock(""))
            }
            for (var q = 0; q < items.length; q++) {
                var it = items[q]
                if (it != undefined && it.lblstmt != undefined) {
                    var lb = ctlLabels[labelIds["$" + it.lblstmt]].blk
                    b.NewBr(lb)
                    b = lb
                } else {
                    b = it(b)
                }
            }
            return b
        }
