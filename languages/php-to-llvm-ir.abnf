                    while (p2 < body.length && isNameChar(body.charAt(p2))) { p2++ }
                    expr = expr + body.substring(k, p2)
                    k = p2
                }
                if (lit != "") { parts.push({s: unescapeDq(lit)}); lit = "" }
                parts.push({e: compileSnippet(expr)})
                i = k
                continue
            }
            lit += ch
            i++
        }
        if (lit != "") { parts.push({s: unescapeDq(lit)}) }
        return parts
    }
    function isNameStart(ch) { return (ch >= "a" && ch <= "z") || (ch >= "A" && ch <= "Z") || ch == "_" }
    function isNameChar(ch) { return isNameStart(ch) || (ch >= "0" && ch <= "9") }
    function compileSnippet(src) {
        var frag = c.parseFrom(c.agrammar, src, "Expression")
        return c.compile(frag).stack[0]
    }

    // ----- string helpers -----
    // The double-quoted / heredoc escape set. PHP keeps an UNKNOWN escape as BOTH
    // characters ("\q" is a backslash and a q, two bytes), which is why there is no
    // default branch that drops the backslash.
    function unescapeDq(s) {
        var out = ""
        var i = 0
        while (i < s.length) {
            var c = s.charCodeAt(i)
            if (c != 92 || i + 1 >= s.length) { out += String.fromCharCode(c); i++; continue }
            var e = s.charAt(i + 1)
            if (e == "n") { out += "\n"; i += 2; continue }
            if (e == "t") { out += "\t"; i += 2; continue }
            if (e == "r") { out += "\r"; i += 2; continue }
            if (e == "v") { out += String.fromCharCode(11); i += 2; continue }
            if (e == "e") { out += String.fromCharCode(27); i += 2; continue }
            if (e == "f") { out += String.fromCharCode(12); i += 2; continue }
            if (e == "\\") { out += "\\"; i += 2; continue }
            if (e == "$") { out += "$"; i += 2; continue }
            if (e == "\"") { out += "\""; i += 2; continue }
            if (e >= "0" && e <= "7") {
                var v = 0
                var n = 0
                var j = i + 1
                while (n < 3 && j < s.length && s.charAt(j) >= "0" && s.charAt(j) <= "7") {
                    v = v * 8 + (s.charCodeAt(j) - 48)
                    j++
                    n++
                }
                out += String.fromCharCode(v % 256)
                i = j
                continue
            }
            if (e == "x") {
                var hv = 0
                var hn = 0
                var hj = i + 2
                while (hn < 2 && hj < s.length && isHexCh(s.charAt(hj))) { hv = hv * 16 + hexVal(s.charAt(hj)); hj++; hn++ }
                if (hn > 0) { out += String.fromCharCode(hv); i = hj; continue }
            }
            if (e == "u" && i + 2 < s.length && s.charAt(i + 2) == "{") {
                var uv = 0
                var uj = i + 3
                var un = 0
                while (uj < s.length && isHexCh(s.charAt(uj))) { uv = uv * 16 + hexVal(s.charAt(uj)); uj++; un++ }
                if (un > 0 && uj < s.length && s.charAt(uj) == "}") {
                    out += codePointStr(uv)
                    i = uj + 1
                    continue
                }
            }
            out += "\\" + e
            i += 2
        }
        return out
    }
    function isHexCh(ch) { return (ch >= "0" && ch <= "9") || (ch >= "a" && ch <= "f") || (ch >= "A" && ch <= "F") }
    function hexVal(ch) {
        var cc = ch.charCodeAt(0)
        if (cc >= 48 && cc <= 57) { return cc - 48 }
        if (cc >= 97) { return cc - 87 }
        return cc - 55
    }
    function codePointStr(cp) {
        if (cp < 65536) { return String.fromCharCode(cp) }
        var off = cp - 65536
        return String.fromCharCode(55296 + ((off - (off % 1024)) / 1024)) + String.fromCharCode(56320 + (off % 1024))
    }
    function unescapeSq(s) {
        var out = ""
        var i = 0
        while (i < s.length) {
            var c = s.charCodeAt(i)
            if (c == 92 && i + 1 < s.length) {
                var e = s.charCodeAt(i + 1)
                if (e == 39 || e == 92) { out += String.fromCharCode(e); i += 2; continue }
            }
            out += String.fromCharCode(c)
            i++
        }
        return out
    }

    // ----- control flow (statement thunks: function(b) -> block) -----
    function makeBody(items) {
        return function(b) {
            for (var i = 0; i < items.length; i++) { b = items[i](b) }
            return b
        }
    }
    function makeConstStmt() { return function(b) { return b } }
    function makeReturn(items) {
        var t = items.length > 0 ? items[0] : null
        return function(b) {
            var v = hNull
            if (t != null) { var r = t(b); b = r.b; v = r.v }
            return retStmt(b, v) // plain ret, or a control signal when leaving a try body
        }
    }
    // break / continue go through emitBreak / emitContinue so a jump that leaves a try
    // body (with no loop of its own) becomes a control signal instead of an invalid
    // branch; outside a try body these are the same b.NewBr as before (byte-identical).
    makeBreak = function(items) {
        return function(b) { emitBreak(b); return deadBlock() }
    }
    makeContinue = function(items) {
        return function(b) { emitContinue(b); return deadBlock() }
    }
    // makeCatch is shared - see lib/compile-core.js.
    // try/catch/finally: each body compiles to its own IR closure handed to js_try. The
    // try and catch bodies are ctl closures, so a return/break/continue leaving them
    // becomes a control signal that excDispatch re-issues here; the finally is a plain
    // closure (its value is discarded by js_try). The first catch wins.
    function makeTry(items) {
        var tryT = anytype, catchT = anytype, catchName = anytype, finallyT = anytype
        for (var i = 0; i < items.length; i++) {
            if (items[i].trybody != undefined) { tryT = items[i].trybody }
            else if (items[i].catchbody != undefined) {
                if (catchT == undefined) { catchT = items[i].catchbody; catchName = items[i].catchname }
            }
            else if (items[i].finbody != undefined) { finallyT = items[i].finbody }
        }
        return function(b) {
            var tryClo = callExt(b, "js_closure", [handle(emitFunc([], tryT, false, true)), curScopeV])
            var catchClo = hUndef
            if (catchT != undefined) {
                var cn = (catchName != undefined) ? catchName : "__caught"
                catchClo = callExt(b, "js_closure", [handle(emitFunc([cn], catchT, false, true)), curScopeV])
            }
            var finClo = hUndef
            if (finallyT != undefined) {
                finClo = callExt(b, "js_closure", [handle(emitFunc([], finallyT, false, true)), curScopeV])
            }
            var ctl = callExt(b, "js_try", [tryClo, catchClo, finClo])
            return excDispatch(b, ctl)
        }
    }
    // throw e: evaluate e and raise it with js_throw (a Go panic the runtime unwinds).
    function makeThrow(e) {
        return function(b) {
            var r = e(b)
            callExt(r.b, "js_throw", [r.v])
            r.b.NewRet(hUndef) // Never reached: js_throw unwinds on the host side.
            return deadBlock()
        }
    }
    // if / elseif / else -- a statement; each branch body is a statement thunk.
    makeIf = function(items) {
        var branches = [{cond: items[0], body: items[1].body}]
        var els = null
        for (var i = 2; i < items.length; i++) {
            if (items[i].els != undefined) { els = items[i].els }
            else { branches.push({cond: items[i].elifCond, body: items[i].elifBody}) }
        }
        return function(b) {
            var endB = curF.NewBlock("")
            for (var a = 0; a < branches.length; a++) {
                var rc = branches[a].cond(b)
                b = rc.b
                var thenBk = curF.NewBlock("")
                var nextBk = curF.NewBlock("")
                b.NewCondBr(truthy(b, rc.v), thenBk, nextBk)
                branches[a].body(thenBk).NewBr(endB)
                b = nextBk
            }
            if (els != null) { els(b).NewBr(endB) }
            else { b.NewBr(endB) }
            return endB
        }
    }
    // for (init; cond; post) { body } -- no new scope: PHP for-vars are function
    // scoped (matches the interpreter).
    function makeFor(items) {
        var body = null
        var init = null
        var cond = null
        var post = null
        for (var i = 0; i < items.length; i++) {
            if (items[i].body != undefined) { body = items[i].body }
            else if (items[i].k == "init") { init = items[i].t }
            else if (items[i].k == "cond") { cond = items[i].t }
            else if (items[i].k == "post") { post = items[i].t }
        }
        return function(b) {
            if (init != null) { b = init(b) }
            var headB = curF.NewBlock("")
            var bodyB = curF.NewBlock("")
            var postB = curF.NewBlock("")
            var exitB = curF.NewBlock("")
            b.NewBr(headB)
            if (cond != null) {
                var r = cond(headB)
                r.b.NewCondBr(truthy(r.b, r.v), bodyB, exitB)
            } else {
                headB.NewBr(bodyB)
            }
            loopStack.push({cont: postB, brk: exitB})
            body(bodyB).NewBr(postB)
            loopStack.pop()
            var pb = postB
            if (post != null) { pb = post(postB) }
            pb.NewBr(headB)
            return exitB
        }
    }
    // foreach over indexed arrays (key = index) and ordered maps (key/value),
    // uniformly via js_range_len / js_range_key / js_range_val.
    function makeForeach(items) {
        var iterT = items[0]
        var keyName = null
        var valName = null
        var body = null
        for (var i = 1; i < items.length; i++) {
            if (items[i].body != undefined) { body = items[i].body }
            else if (items[i].v1 != undefined) { valName = items[i].v1 }
            else if (items[i].v2 != undefined) { keyName = items[i].v2 }
        }
        return function(b) {
            var ir = iterT(b)
            b = ir.b
            hidCount++
            var itName = "0fe_it" + hidCount
            var lenName = "0fe_len" + hidCount
            var iName = "0fe_i" + hidCount
            callExt(b, "js_pyset_var", [curScopeV, emitStr(b, itName), ir.v])
            callExt(b, "js_pyset_var", [curScopeV, emitStr(b, lenName), callExt(b, "js_range_len", [ir.v])])
            callExt(b, "js_pyset_var", [curScopeV, emitStr(b, iName), emitNum(b, 0)])
            var headB = curF.NewBlock("")
            var bodyB = curF.NewBlock("")
            var postB = curF.NewBlock("")
            var exitB = curF.NewBlock("")
            b.NewBr(headB)
            var iV = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, iName)])
            var lenV = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, lenName)])
            headB.NewCondBr(truthy(headB, callExt(headB, "js_lt", [iV, lenV])), bodyB, exitB)
            var itV = callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, itName)])
            var iB = callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, iName)])
            if (keyName != null) {
                callExt(bodyB, "js_pyset_var", [curScopeV, emitStr(bodyB, valName), callExt(bodyB, "js_range_key", [itV, iB])])
                callExt(bodyB, "js_pyset_var", [curScopeV, emitStr(bodyB, keyName), callExt(bodyB, "js_range_val", [itV, iB])])
            } else {
                callExt(bodyB, "js_pyset_var", [curScopeV, emitStr(bodyB, valName), callExt(bodyB, "js_range_val", [itV, iB])])
            }
            loopStack.push({cont: postB, brk: exitB})
            body(bodyB).NewBr(postB)
            loopStack.pop()
            var iP = callExt(postB, "js_scope_get", [curScopeV, emitStr(postB, iName)])
            callExt(postB, "js_pyset_var", [curScopeV, emitStr(postB, iName),
                                            intWrap(postB, callExt(postB, "js_jadd", [iP, emitNum(postB, 1)]))])
            postB.NewBr(headB)
            return exitB
        }
    }

    // ----- ternary / Elvis / null-coalescing (expressions) -----
    // items: [cond] plain, [cond, {elvis}] Elvis, [cond, then, else] full ternary.
    function makeTernary(items) {
        if (items.length == 1) { return items[0] }
        if (items.length == 2) {
            var condE = items[0]
            var rightE = items[1].elvis
            return function(b) {
                var rc = condE(b)
                b = rc.b
                var thenB = curF.NewBlock("")
                var elseB = curF.NewBlock("")
                var mergeB = curF.NewBlock("")
                b.NewCondBr(truthy(b, rc.v), thenB, elseB)
                thenB.NewBr(mergeB)
                var re = rightE(elseB)
                re.b.NewBr(mergeB)
                var phi = mergeB.NewPhi([llvm.ir.NewIncoming(rc.v, thenB), llvm.ir.NewIncoming(re.v, re.b)])
                return {b: mergeB, v: phi}
            }
        }
        var condT = items[0]
        var thenT = items[1]
        var elseT = items[2]
        return function(b) {
            var rc = condT(b)
            b = rc.b
            var thenB = curF.NewBlock("")
            var elseB = curF.NewBlock("")
            var mergeB = curF.NewBlock("")
            b.NewCondBr(truthy(b, rc.v), thenB, elseB)
            var rt = thenT(thenB)
            rt.b.NewBr(mergeB)
            var re = elseT(elseB)
            re.b.NewBr(mergeB)
            var phi = mergeB.NewPhi([llvm.ir.NewIncoming(rt.v, rt.b), llvm.ir.NewIncoming(re.v, re.b)])
            return {b: mergeB, v: phi}
        }
    }
    // a ?? b : the first operand that is not null (left fold; associative for '??').
    function makeCoalesce(items) {
        if (items.length == 1) { return items[0] }
        return function(b) {
            var r = items[0](b)
            b = r.b
            var v = r.v
            for (var i = 1; i < items.length; i++) {
                var rightB = curF.NewBlock("")
                var mergeB = curF.NewBlock("")
                var isNull = b.NewICmp(llvm.enum.IPredEQ, v, hNull)
                b.NewCondBr(isNull, rightB, mergeB)
                var r2 = items[i](rightB)
                r2.b.NewBr(mergeB)
                var phi = mergeB.NewPhi([llvm.ir.NewIncoming(v, b), llvm.ir.NewIncoming(r2.v, r2.b)])
                b = mergeB
                v = phi
            }
            return {b: b, v: v}
        }
    }
    // list($a, $b) = e / [$a, $b] = e : bind targets from the array's positions.
    function makeDestructure(items) {
        var targets = []
        var valT = null
        for (var i = 0; i < items.length; i++) {
            if (items[i].dt != undefined) { targets.push(items[i].dt) }
            else { valT = items[i] }
        }
        return function(b) {
            var r = valT(b)
            b = r.b
            var arr = r.v
            for (var i = 0; i < targets.length; i++) {
                var elem = callExt(b, "js_pyget", [arr, emitNum(b, i)])
                var ref = targets[i]
                if (ref.path.length == 0) {
                    callExt(b, "js_pyset_var", [curScopeV, emitStr(b, ref.name), elem])
                } else {
                    var p = emitRefPath(b, ref)
                    b = p.b
                    writeRefSlot(b, p, elem)
                }
            }
            return {b: b, v: arr}
        }
    }

    // ----- && / || : short circuit, PHP-style boolean result -----
    makeOrAnd = function(items, isOr) {
        if (items.length == 1) { return items[0] }
        return function(b) {
            var r = items[0](b)
            b = r.b
            var v = r.v
            for (var i = 1; i < items.length; i++) {
                var rightB = curF.NewBlock("")
                var mergeB = curF.NewBlock("")
                var cnd = truthy(b, v)
                if (isOr) { b.NewCondBr(cnd, mergeB, rightB) }
                else      { b.NewCondBr(cnd, rightB, mergeB) }
                var r2 = items[i](rightB)
                r2.b.NewBr(mergeB)
                var phi = mergeB.NewPhi([llvm.ir.NewIncoming(v, b), llvm.ir.NewIncoming(r2.v, r2.b)])
                b = mergeB
                v = phi
            }
            var boolV = callExt(b, "js_not", [callExt(b, "js_not", [v])])
            return {b: b, v: boolV}
        }
    }

    // ----- concatenation and === / !== on the shared binary fold -----
    binExt["==="] = "js_seq"
    binExt["!=="] = "js_sne"
    // PHP's "/" is FLOAT division: 7 / 2 is 3.5 and -7 / 2 is -3.5; it yields an int
    // only when the division comes out even, which plain IEEE division already does.
    // The C-family default in compile-core.js truncates the quotient to 32 bit
    // (intWrap), which is intdiv() and not "/", so switch both forms off. (Dart made
    // exactly this correction for its own "/" vs "~/" pair.)
    wraps["/"] = 0
    wraps["/="] = 0
    // Unary minus for the same reason: the shared makeNeg truncates its result to
    // 32 bit, which turned the literal -3.5 into -3. PHP integers are 64 bit, so the
    // truncation is wrong for them too.
    makeNeg = function(t) {
        return function(b) {
            var r = t(b)
            return {b: r.b, v: callExt(r.b, "js_neg", [r.v])}
        }
    }
    // The rest of PHP's binary ladder. The bitwise / shift externals already exist in
    // the handle runtime; '<>' is PHP's other spelling of '!='.
    binExt["&"] = "js_band"
    binExt["|"] = "js_bor"
    binExt["^"] = "js_bxor"
    binExt["<<"] = "js_shl"
    binExt[">>"] = "js_shr"
    binExt["<>"] = "js_sne"
    binExt["&="] = "js_band"
    binExt["|="] = "js_bor"
    binExt["^="] = "js_bxor"
    binExt["<<="] = "js_shl"
    binExt[">>="] = "js_shr"
    emitBin = function(b, op, l, r) {
        if (op == "." || op == ".=") {
            return callExt(b, "js_jadd", [callExt(b, "js_jadd", [emitStr(b, ""), l]), r])
        }
        // '**' has no external of its own; it is Math.pow, which the handle runtime
        // already carries (buildMain binds Math into phpmain's scope).
        if (op == "**" || op == "**=") {
            var mathV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, "Math")])
            var powV = callExt(b, "js_get", [mathV, emitStr(b, "pow")])
            return callExt(b, "js_call", [powV, hUndef, argList(b, [l, r])])
        }
        // '<=>' as (l > r) - (l < r): the two comparisons are booleans, and the
        // subtraction coerces them, so the result is exactly -1 / 0 / 1.
        if (op == "<=>") {
            return callExt(b, "js_sub", [callExt(b, "js_gt", [l, r]), callExt(b, "js_lt", [l, r])])
        }
        // '$a ??= $b' keeps $a when it is set and not null. The right-hand side is
        // already evaluated at this point, so - unlike PHP - it is not short-circuited;
        // a side-effecting right operand of '??=' therefore still runs.
        if (op == "??=") {
            return b.NewSelect(truthy(b, callExt(b, "js_seq", [l, hNull])), r,
                               b.NewSelect(truthy(b, callExt(b, "js_seq", [l, hUndef])), r, l))
        }
        var v = callExt(b, binExt[op], [l, r])
        if (wraps[op] == 1) { v = intWrap(b, v) }
        return v
    }
    // 2 ** 3 ** 2 == 512: the parse is already right-associative (the right operand is
    // a full UnaryExpr), so the fold only has to apply the operator when one is there.
    function foldPow(items) {
        if (items.length == 1) { return items[0] }
        var base = items[0]
        var exp = items[1]
        return function(b) {
            var rl = base(b)
            var rr = exp(rl.b)
            return {b: rr.b, v: emitBin(rr.b, "**", rl.v, rr.v)}
        }
    }
    // ~x is x XOR -1 (two's complement), which needs no external of its own.
    function makeBitNot(t) {
        return function(b) {
            var r = t(b)
            return {b: r.b, v: callExt(r.b, "js_bxor", [r.v, emitNum(r.b, -1)])}
        }
    }
    // throw as an EXPRESSION (PHP 8): it never produces a value, so the block it ends
    // is dead exactly like the throw statement's.
    function makeThrowExpr(e) {
        return function(b) {
            var r = e(b)
            callExt(r.b, "js_throw", [r.v])
            r.b.NewRet(hUndef) // Never reached: js_throw unwinds on the host side.
            return {b: deadBlock(), v: hUndef}
        }
    }

    // ----- arrays and associative arrays -----
    function makeArray(items) {
        var hasKeys = false
        for (var i = 0; i < items.length; i++) { if (items[i].hk != undefined) { hasKeys = true } }
        return function(b) {
            if (!hasKeys) {
                var arrV = callExt(b, "js_arr_new", [])
                for (var j = 0; j < items.length; j++) {
                    var r = items[j].elem(b)
                    b = r.b
                    callExt(b, "js_arr_push", [arrV, r.v])
                }
                return {b: b, v: arrV}
            }
            var d = callExt(b, "js_dict_new", [])
            var idx = 0
            for (var k = 0; k < items.length; k++) {
                if (items[k].hk != undefined) {
                    var rk = items[k].hk(b); b = rk.b
                    var rv = items[k].hv(b); b = rv.b
                    callExt(b, "js_pyset", [d, rk.v, rv.v])
                } else {
                    var re = items[k].elem(b); b = re.b
                    callExt(b, "js_pyset", [d, emitNum(b, idx), re.v])
                    idx = (idx + 1) | 0
                }
            }
            return {b: b, v: d}
        }
    }

    function makeTemplate(items) {
        return function(b) {
            var v = emitStr(b, "")
            for (var i = 0; i < items.length; i++) {
                var pv
                if (items[i].s != undefined) { pv = emitStr(b, items[i].s) }
                else { var r = items[i].e(b); b = r.b; pv = r.v }
                v = callExt(b, "js_jadd", [v, pv])
            }
            return {b: b, v: v}
        }
    }

    // "$name", "$a[0]", "$map[key]", "$o->prop": PHP's simple interpolation form. The
    // index text is classified here, exactly as php-interpreter.abnf's makeTplVar does:
    // a leading '$' is another variable, a canonical integer is an int key, anything
    // else is a BARE word taken as a string key (that is what "$map[key]" means).
    function makeTplVar(items) {
        var name = ""
        var idx = null
        var prop = null
        for (var i = 0; i < items.length; i++) {
            if (items[i].tvar != undefined) { name = items[i].tvar }
            else if (items[i].tidx != undefined) { idx = items[i].tidx }
            else if (items[i].tprop != undefined) { prop = items[i].tprop }
        }
        if (idx != null) {
            var itxt = idx
            return function(b) {
                var ov = callExt(b, "js_scope_get", [curScopeV, emitStr(b, name)])
                var kv = anytype
                if (itxt.charAt(0) == "$") { kv = callExt(b, "js_scope_get", [curScopeV, emitStr(b, itxt)]) }
                else if (isCanonInt(itxt)) { kv = emitNum(b, parseInt(itxt, 10)) }
                else { kv = emitStr(b, itxt) }
                return {b: b, v: callExt(b, "js_pyget", [ov, kv])}
            }
        }
        if (prop != null) {
            var pn = prop.substring(2)
            return function(b) {
                var ov = callExt(b, "js_scope_get", [curScopeV, emitStr(b, name)])
                return {b: b, v: callExt(b, "js_get", [ov, emitStr(b, pn)])}
            }
        }
        return makeVarRef(name)
    }
    // A canonical decimal integer: no leading zero, an optional '-'. PHP's array keys
    // only fold a string to an int in that exact form ("01" stays a string key).
    function isCanonInt(s) {
        if (s.length == 0) { return false }
        var i = 0
        if (s.charAt(0) == "-") { if (s.length == 1) { return false }; i = 1 }
        if (s.charAt(i) == "0" && s.length > i + 1) { return false }
        for (var j = i; j < s.length; j++) {
            var ch = s.charAt(j)
            if (ch < "0" || ch > "9") { return false }
        }
        return true
    }

    // ----- member chains: ->method(args), ->field, [index], (call), ::static -----
    foldCallMember = function(items) {
        if (items.length == 1) { return items[0] }
        var primary = items[0]
        var suffixes = items.slice(1)
        return function(b) {
            var r = primary(b)
            b = r.b
            var cur = r.v
            for (var i = 0; i < suffixes.length; i++) {
                var s = suffixes[i]
                if (s.kind == "mcall") {
                    var ea = emitArgs(b, s.args)
                    b = ea.b
                    cur = callExt(b, "js_mcall", [cur, emitStr(b, s.name), ea.v])
                } else if (s.kind == "field") {
                    cur = callExt(b, "js_get", [cur, emitStr(b, s.name)])
                } else if (s.kind == "call") {
                    var ea2 = emitArgs(b, s.args)
                    b = ea2.b
                    cur = callExt(b, "js_call", [cur, hUndef, ea2.v])
                } else if (s.kind == "static") {
                    var rs = s.run(b)
                    b = rs.b
                    cur = rs.v
                } else {
                    var ir = s.idx(b)
                    b = ir.b
                    cur = callExt(b, "js_pyget", [cur, ir.v])
                }
            }
            return {b: b, v: cur}
        }
    }
    function makeStatic(items, pos) {
        notImpl("static / :: access", pos)
        return {kind: "static", run: function(b) { return {b: b, v: hNull} }}
    }

    // include / require: a single-quoted literal path is resolved to a project file
    // (resolveImport -> core.importFile below, whose thunks are stashed for phpmain); a
    // dynamic / double-quoted operand stays notImplemented. The expression yields a
    // harmless true so the enclosing statement still lowers.
    function makeInclude(items, pos) {
        for (var i = 0; i < items.length; i++) {
            if (items[i].incpath != undefined) {
                resolveImport(items[i].incpath, pos)
                return makeConst(true)
            }
        }
        return notImplExpr("include/require", pos)
    }

    // ----- closures (IR function closed over the defining scope via js_closure) -----
    function makeClosure(items) {
        var params = []
        var body = null
        for (var i = 0; i < items.length; i++) {
            if (items[i].body != undefined) { body = items[i].body }
            else if (items[i].param != undefined) { params.push(items[i].param) }
        }
        return function(b) {
            var idx = emitFunc(params, body, false)
            return {b: b, v: callExt(b, "js_closure", [handle(idx), curScopeV])}
        }
    }

    // ----- new C(...) -----
    // Declared defaults are replayed base class FIRST, so a redeclared property in the
    // subclass wins - PHP's rule. The chain is walked at compile time (classSuper), and a
    // cycle or an unknown base simply stops the walk.
    function emitPropDefaults(b, objV, name) {
        var chain = []
        var cur = name
        var guard = 0
        while (cur != "" && cur != undefined && guard < 64) {
            if (classProps["$" + cur] == undefined) { break }
            chain.push(cur)
            cur = classSuper["$" + cur]
            guard++
        }
        for (var i = chain.length - 1; i >= 0; i--) {
            var ps = classProps["$" + chain[i]]
            for (var k = 0; k < ps.length; k++) {
                var pv = hNull
                if (ps[k].init != null) { var r = ps[k].init(b); b = r.b; pv = r.v }
                callExt(b, "js_set", [objV, emitStr(b, ps[k].name), pv])
            }
        }
        return b
    }
    function makeNew(items) {
        var name = items[0].cls
        var args = items.slice(1)
        return function(b) {
            var clsV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, name)])
            var objV = callExt(b, "js_obj_new", [])
            callExt(b, "js_set", [objV, emitStr(b, "__class"), clsV])
            b = emitPropDefaults(b, objV, name)
            var argsV = callExt(b, "js_arr_new", [])
            callExt(b, "js_arr_push", [argsV, objV])
            for (var k = 0; k < args.length; k++) {
                var ra = args[k](b)
                b = ra.b
                callExt(b, "js_arr_push", [argsV, ra.v])
            }
            var ctorV = callExt(b, "js_get", [clsV, emitStr(b, "__construct")])
            callExt(b, "js_call", [ctorV, hUndef, argsV])
            return {b: b, v: objV}
        }
    }

    // ----- echo / print -----
    function makeEcho(items) {
        var args = items.slice(1)
        return function(b) {
            var printV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, "print")])
            for (var i = 0; i < args.length; i++) {
                var r = args[i](b)
                b = r.b
                var sv = callExt(b, "js_jadd", [emitStr(b, ""), r.v])
                callExt(b, "js_call", [printV, hUndef, argList(b, [sv])])
            }
            return b
        }
    }
    function argList(b, vals) {
        var argsV = callExt(b, "js_arr_new", [])
        for (var i = 0; i < vals.length; i++) { callExt(b, "js_arr_push", [argsV, vals[i]]) }
        return argsV
    }

    // ----- assignment targets (locals via create-on-assign, ->field, [i], [] append) -----
    makeTargetRef = function(items) {
        var head = items[0]
        return {name: head.var, path: items.slice(1)}
    }
    function emitRefPath(b, ref) {
        var o = callExt(b, "js_scope_get", [curScopeV, emitStr(b, ref.name)])
        for (var i = 0; i < ref.path.length - 1; i++) {
            var s = ref.path[i]
            if (s.key != undefined) { o = callExt(b, "js_get", [o, emitStr(b, s.key)]) }
            else { var ri = s.idx(b); b = ri.b; o = callExt(b, "js_pyget", [o, ri.v]) }
        }
        var last = ref.path[ref.path.length - 1]
        if (last.append === true) { return {b: b, obj: o, kind: "append"} }
        if (last.key != undefined) { return {b: b, obj: o, key: emitStr(b, last.key), kind: "field"} }
        var kr = last.idx(b)
        return {b: kr.b, obj: o, key: kr.v, kind: "index"}
    }
    function readRefSlot(b, p) {
        if (p.kind == "field") { return callExt(b, "js_get", [p.obj, p.key]) }
        if (p.kind == "index") { return callExt(b, "js_pyget", [p.obj, p.key]) }
        return hNull
    }
    function writeRefSlot(b, p, v) {
        if (p.kind == "field") { callExt(b, "js_set", [p.obj, p.key, v]); return }
        if (p.kind == "index") { callExt(b, "js_pyset", [p.obj, p.key, v]); return }
        callExt(b, "js_arr_push", [p.obj, v])
    }
    function makeAssign(items) {
        var ref = items[0]
        var op = items[1]
        var valT = items[2]
        return function(b) {
            var r = valT(b)
            b = r.b
            var v = r.v
            if (ref.path.length == 0) {
                var nameV = emitStr(b, ref.name)
                if (op != "=") {
                    var oldl = callExt(b, "js_scope_get", [curScopeV, nameV])
                    v = emitBin(b, op, oldl, v)
                }
                callExt(b, "js_pyset_var", [curScopeV, nameV, v])
            } else {
                var p = emitRefPath(b, ref)
                b = p.b
                if (op != "=") {
                    var old = readRefSlot(b, p)
                    v = emitBin(b, op, old, v)
                }
                writeRefSlot(b, p, v)
            }
            return {b: b, v: v}
        }
    }

    // ++ / -- (postfix yields the old value, prefix the new one).
    function incDec(b, ref, isPre, isInc) {
        var ext = isInc ? "js_jadd" : "js_sub"
        if (ref.path.length == 0) {
            var nameV = emitStr(b, ref.name)
            var oldV = callExt(b, "js_tonum", [callExt(b, "js_scope_get", [curScopeV, nameV])])
            var newV = intWrap(b, callExt(b, ext, [oldV, emitNum(b, 1)]))
            callExt(b, "js_pyset_var", [curScopeV, nameV, newV])
            return {b: b, v: isPre ? newV : oldV}
        }
        var p = emitRefPath(b, ref)
        b = p.b
        var oldM = callExt(b, "js_tonum", [readRefSlot(b, p)])
        var newM = intWrap(b, callExt(b, ext, [oldM, emitNum(b, 1)]))
        writeRefSlot(b, p, newM)
        return {b: b, v: isPre ? newM : oldM}
    }
    function makeIncDec(items) {
        var ref = items[0]
        var isInc = (items[1] == "++")
        return function(b) { return incDec(b, ref, false, isInc) }
    }
    function makePreIncDec(ref, op) {
        var isInc = (op == "++")
        return function(b) { return incDec(b, ref, true, isInc) }
    }

    // ----- calls, defs, classes -----
    function hasBuiltin(name) {
        return name == "count" || name == "strlen" || name == "in_array"
            || name == "array_push" || name == "array_keys" || name == "array_values" || name == "intdiv"
    }
    function emitBuiltin(b, name, args) {
        var vs = []
        for (var i = 0; i < args.length; i++) { var r = args[i](b); b = r.b; vs.push(r.v) }
        // strlen counts BYTES (PHP strings are byte strings), count() counts elements.
        if (name == "strlen") { return {b: b, v: callExt(b, "js_bytelen", [vs[0]])} }
        if (name == "count") { return {b: b, v: callExt(b, "js_pylen", [vs[0]])} }
        if (name == "in_array") { return {b: b, v: callExt(b, "js_mcall", [vs[1], emitStr(b, "contains"), argList(b, [vs[0]])])} }
        if (name == "array_push") { callExt(b, "js_arr_push", [vs[0], vs[1]]); return {b: b, v: callExt(b, "js_pylen", [vs[0]])} }
        if (name == "array_keys") { return {b: b, v: callExt(b, "js_mcall", [vs[0], emitStr(b, "keys"), callExt(b, "js_arr_new", [])])} }
        if (name == "array_values") { return {b: b, v: callExt(b, "js_mcall", [vs[0], emitStr(b, "values"), callExt(b, "js_arr_new", [])])} }
        return {b: b, v: intWrap(b, callExt(b, "js_div", [vs[0], vs[1]]))}
    }
    function makeCall(items) {
        var name = items[0]
        var args = items.slice(1)
        return function(b) {
            if (hasBuiltin(name)) { return emitBuiltin(b, name, args) }
            var fV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, name)])
            var ea = emitArgs(b, args)
            b = ea.b
            return {b: b, v: callExt(b, "js_call", [fV, hUndef, ea.v])}
        }
    }
