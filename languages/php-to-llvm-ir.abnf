    // collects positions (c.tracing), so without -trace/-cfgraph/-callgraph/-why
    // the emitted module is byte for byte the module of a grammar with no markers.
    function phStmtPos(items) {
        var t = items[1]
        if (!c.tracing) { return t }
        if (typeof t != "function") { return t }
        var pos = items[0]
        if (pos == undefined) { return t }
        return function(b) {
            callExt(b, "js_srcpos", [handle(pos)])
            return t(b)
        }
    }

    // ----- references: one storage CELL shared by two names ---------------------
    // php-interpreter.abnf models a PHP reference as a CELL that a scope slot or an
    // array element holds in PLACE of the value; every read dereferences and every
    // write writes through it, so $b = &$a, use (&$v), a by-reference parameter and
    // foreach (... as &$v) are all the same mechanism. The compiler uses the same
    // model: a cell is an ordinary object carrying __refcell and the value under "v",
