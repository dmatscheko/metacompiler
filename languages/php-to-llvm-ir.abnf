ArgLabel    = Id ":" !":" ;
SpreadArg   <~~ takeAll(); push(notImplExpr("spread argument", up.pos)) ~~>
            = "..." Expression ;
FccArg      <~~ push(notImplExpr("first-class callable", up.pos)) ~~>
            = "..." ;
PosArg      = Expression ;
