        // end (#s) when string.sub was called with two arguments; lua_sub assembles them
        // and answers "" when the range is empty, as Lua does instead of erroring.
        if (name == "lua_clamplo") {
            var cloB = curF.NewBlock("")
            var choB = curF.NewBlock("")
