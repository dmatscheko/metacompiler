                if (cc >= 55296 && cc < 56320 && i + 1 < s.length) {
                    var lo2 = s.charCodeAt(i + 1)
                    if (lo2 >= 56320 && lo2 < 57344) {
                        out = out + utf8Enc(65536 + (cc - 55296) * 1024 + (lo2 - 56320))
                        i = i + 2
                        continue
                    }
