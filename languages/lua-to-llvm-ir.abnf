                var nextB = curF.NewBlock("")
                cur.NewCondBr(cur.NewICmp(llvm.enum.IPredEQ, fileNo, handle(fi)), hitB, nextB)
                hitB.NewRet(callExt(hitB, "js_add", [callExt(hitB, "js_add", [emitStr(hitB, luaFiles[fi] + ":"), lineV]), emitStr(hitB, ": ")]))
