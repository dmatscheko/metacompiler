            var edig = 0
            while (i < n && s.charCodeAt(i) >= 48 && s.charCodeAt(i) <= 57) { e = e * 10 + (s.charCodeAt(i) - 48); i = i + 1; edig = edig + 1 }
            if (edig === 0) { return undefined }
