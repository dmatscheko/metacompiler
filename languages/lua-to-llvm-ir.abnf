            objB.NewRet(callExt(objB, "js_sne", [callExt(objB, "js_get", [ps[0], emitStr(objB, "__mv")]), hUndef]))
            noB.NewRet(hFalse)
            return
        }
        if (name == "lua_first") {
            var mvB = curF.NewBlock("")
            var oneB = curF.NewBlock("")
            b.NewCondBr(truthy(b, callLua(b, "lua_ismv", [ps[0]])), mvB, oneB)
