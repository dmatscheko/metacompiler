    // its subtype apart from 1 all the way to the concatenation that renders it, and an
    // integer literal is read from its digits by js_lulit so that it is exact to 64 bits.
    // A SMALL decimal integer skips the call and goes in as a plain number - which is
    // every literal an ordinary program writes.
    var coreMakeConst = makeConst
    makeConst = function(v) {
