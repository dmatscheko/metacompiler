    }
    function luaHexNum(s, i, n) {
        var v = 0
        var digits = 0
        var isFloat = false
        while (i < n && hexDigit(s.charCodeAt(i)) >= 0) { v = v * 16 + hexDigit(s.charCodeAt(i)); i = i + 1; digits = digits + 1 }
        if (i < n && s.charCodeAt(i) === 46) {
            isFloat = true
            i = i + 1
            var scale = 1
            while (i < n && hexDigit(s.charCodeAt(i)) >= 0) {
                scale = scale / 16
                v = v + hexDigit(s.charCodeAt(i)) * scale
                i = i + 1
                digits = digits + 1
            }
        }
        if (digits === 0) { return undefined }
        if (i < n && (s.charCodeAt(i) === 112 || s.charCodeAt(i) === 80)) {
            isFloat = true
            i = i + 1
            var esign = 1
            if (i < n && (s.charCodeAt(i) === 43 || s.charCodeAt(i) === 45)) {
                if (s.charCodeAt(i) === 45) { esign = 0 - 1 }
                i = i + 1
            }
