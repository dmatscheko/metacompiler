        if (name == "lua_all") {
            var mvB2 = curF.NewBlock("")
            var oneB2 = curF.NewBlock("")
            b.NewCondBr(truthy(b, callLua(b, "lua_ismv", [ps[0]])), mvB2, oneB2)
            mvB2.NewRet(callExt(mvB2, "js_get", [ps[0], emitStr(mvB2, "__mv")]))
            var a1 = callExt(oneB2, "js_arr_new", [])
