        if (name == "lua_cmpv") {
            // A comparison operand: a number unboxes, a string stays a string. This is
            // also what a table key goes through, so t[2.0] addresses t[2].
            var cvB = curF.NewBlock("")
            var cpB = curF.NewBlock("")
            b.NewCondBr(rawTruthy(b, callLua(b, "lua_isnum", [ps[0]])), cvB, cpB)
            cvB.NewRet(callLua(cvB, "lua_num", [ps[0]]))
            cpB.NewRet(ps[0])
            return
        }
        if (name == "lua_cmp") {
            // p0 is the operator: 0 <, 1 >, 2 <=, 3 >=.
            var cx = callLua(b, "lua_cmpv", [ps[1]])
            var cy = callLua(b, "lua_cmpv", [ps[2]])
            var cops = ["js_lt", "js_gt", "js_le", "js_ge"]
            var ccur = b
            for (var ci = 0; ci < cops.length; ci++) {
                var chB = curF.NewBlock("")
                var cnB = curF.NewBlock("")
                ccur.NewCondBr(ccur.NewICmp(llvm.enum.IPredEQ, ps[0], handle(ci)), chB, cnB)
                chB.NewRet(callExt(chB, cops[ci], [cx, cy]))
                ccur = cnB
            }
            ccur.NewRet(hFalse)
            return
        }
        if (name == "lua_str") {
            // How a value renders in a concatenation or in print: nil and the booleans
            // by name, an integer without a fraction, a float always with one.
            var snB = curF.NewBlock("")
            var s1B = curF.NewBlock("")
            var sbB = curF.NewBlock("")
            var s2B = curF.NewBlock("")
            var smB = curF.NewBlock("")
            var s3B = curF.NewBlock("")
            var siB = curF.NewBlock("")
            var sfB = curF.NewBlock("")
            var sdB = curF.NewBlock("")
            var srB = curF.NewBlock("")
            var stv = callExt(b, "js_typeof", [ps[0]])
            b.NewCondBr(rawTruthy(b, callExt(b, "js_seq", [stv, emitStr(b, "undefined")])), snB, s1B)
            snB.NewRet(emitStr(snB, "nil"))
            s1B.NewCondBr(rawTruthy(s1B, callExt(s1B, "js_seq", [stv, emitStr(s1B, "boolean")])), sbB, s2B)
            sbB.NewRet(sbB.NewSelect(rawTruthy(sbB, ps[0]), emitStr(sbB, "true"), emitStr(sbB, "false")))
            s2B.NewCondBr(rawTruthy(s2B, callLua(s2B, "lua_isnum", [ps[0]])), smB, s3B)
            s3B.NewRet(callExt(s3B, "js_pystr", [ps[0]]))
            smB.NewCondBr(rawTruthy(smB, callLua(smB, "lua_isint", [ps[0]])), siB, sfB)
            siB.NewRet(callExt(siB, "js_pystr", [ps[0]]))
            // js_luaflt is Lua's float rendering: inf / -inf / nan for the
            // non-finite values (js_pystr spelled them Infinity / NaN, which is
            // JavaScript) and always a fraction otherwise.
            var sn2 = callLua(sfB, "lua_num", [ps[0]])
            sfB.NewCondBr(rawTruthy(sfB, callLua(sfB, "lua_isint", [sn2])), sdB, srB)
            sdB.NewRet(callExt(sdB, "js_luaflt", [sn2]))
            srB.NewRet(callExt(srB, "js_luaflt", [sn2]))
            return
        }
        if (name == "lua_shift") {
            // Lua shifts a 64-BIT integer, logically, and a count of 64 or more clears
            // the value; a negative count shifts the other way. js_shl / js_ushr are
            // JavaScript's 32-bit shifts with a 5-bit count mask, so the compiler
            // answered 1 for `1 << 32' and -16777216 for `255 << 24' while
            // lua-interpreter.abnf (and real Lua) answered 4294967296 and 4278190080.
            // js_luashift does the whole thing in Go. p0 is 1 for '<<', 0 for '>>'.
            b.NewRet(callExt(b, "js_luashift", [ps[1], ps[2], ps[0]]))
            return
        }
        if (name == "lua_tail") {
            // The extra arguments of a variadic call: a fresh array of args[n...].
            var out = callExt(b, "js_arr_new", [])
            var total = callExt(b, "js_get", [ps[0], emitStr(b, "length")])
            var tcell = callExt(b, "js_obj_new", [])
            callExt(b, "js_set", [tcell, emitStr(b, "i"), ps[1]])
            var thB = curF.NewBlock("")
            var tbB = curF.NewBlock("")
            var teB = curF.NewBlock("")
            b.NewBr(thB)
            var tiV = callExt(thB, "js_get", [tcell, emitStr(thB, "i")])
            thB.NewCondBr(truthy(thB, callExt(thB, "js_lt", [tiV, total])), tbB, teB)
            var tiV2 = callExt(tbB, "js_get", [tcell, emitStr(tbB, "i")])
            callExt(tbB, "js_arr_push", [out, callExt(tbB, "js_get", [ps[0], tiV2])])
            callExt(tbB, "js_set", [tcell, emitStr(tbB, "i"), callExt(tbB, "js_add", [tiV2, emitNum(tbB, 1)])])
            tbB.NewBr(thB)
            teB.NewRet(out)
            return
        }
        // The three list walkers. They share one shape: run over a source array with a
        // counter kept in a small object cell (a helper has no scope chain of its own).
        //   lua_appendall(dst, v)     push every value of v onto the array dst
        //   lua_extend(dst, src)      push every element of the array src onto dst
        //   lua_spread(tbl, n, v)     store the values of v at tbl[n], tbl[n+1], ...
        var src = anytype // The array being walked.
        if (name == "lua_strall") { src = ps[0] }
        else if (name == "lua_extend") { src = ps[1] }
        else if (name == "lua_spread") { src = callLua(b, "lua_all", [ps[2]]) }
        else { src = callLua(b, "lua_all", [ps[1]]) }
        var outArr = callExt(b, "js_arr_new", []) // Only lua_strall builds a result array.
        var cnt = callExt(b, "js_get", [src, emitStr(b, "length")])
        var cell = callExt(b, "js_obj_new", [])
        callExt(b, "js_set", [cell, emitStr(b, "i"), emitNum(b, 0)])
        var headB = curF.NewBlock("")
        var bodyB = curF.NewBlock("")
        var exitB = curF.NewBlock("")
        b.NewBr(headB)
        var iV = callExt(headB, "js_get", [cell, emitStr(headB, "i")])
        headB.NewCondBr(truthy(headB, callExt(headB, "js_lt", [iV, cnt])), bodyB, exitB)
        var iV2 = callExt(bodyB, "js_get", [cell, emitStr(bodyB, "i")])
        var elemV = callExt(bodyB, "js_get", [src, iV2])
        if (name == "lua_strall") {
            callExt(bodyB, "js_arr_push", [outArr, callLua(bodyB, "lua_str", [elemV])])
        } else if (name == "lua_spread") {
            callExt(bodyB, "js_set", [ps[0], callExt(bodyB, "js_add", [ps[1], iV2]), elemV])
        } else {
            callExt(bodyB, "js_arr_push", [ps[0], elemV])
        }
        callExt(bodyB, "js_set", [cell, emitStr(bodyB, "i"), callExt(bodyB, "js_add", [iV2, emitNum(bodyB, 1)])])
        bodyB.NewBr(headB)
        exitB.NewRet(name == "lua_strall" ? outArr : hUndef)
    }
    function emitArrExtend(b, dst, srcArr) { callLua(b, "lua_extend", [dst, srcArr]); return b }
    function emitSpreadInto(b, tbl, startV, v) { callLua(b, "lua_spread", [tbl, startV, v]); return b }

    // ----- goto and labels -----
    // A ::name:: label becomes a real basic block, so a goto is simply a branch - which
    // is what IR wants anyway. makeSeq creates a block for every label of a block BEFORE
    // it emits the statements (so a forward goto finds its target) and keeps them on
    // labelScopes while the block is being emitted, so a goto in a nested block or loop
    // reaches an enclosing label and leaves the loops on the way out.
    var labelScopes = []
    function makeLabel(name) { return {__label: name} }
    function makeGoto(name) {
        return function(b) {
            for (var i = labelScopes.length - 1; i >= 0; i--) {
                var tgt = labelScopes[i]["$" + name]
                if (tgt != undefined) {
                    b.NewBr(tgt)
                    return deadBlock()
                }
            }
            fail("no visible label '" + name + "' for goto")
        }
    }
    // A label marker is not a thunk, so it must not be wrapped with a source position.
    var coreStmtPos = stmtPos
    stmtPos = function(t) {
        if (typeof t != "function") { return t }
        return coreStmtPos(t)
    }
    makeSeq = function(items) {
        return function(b) {
            var scope = {}
            var any = false
            for (var i = 0; i < items.length; i++) {
                if (typeof items[i] != "function" && items[i].__label != undefined) {
                    scope["$" + items[i].__label] = curF.NewBlock("")
                    any = true
                }
            }
            if (any) { labelScopes.push(scope) }
            for (var j = 0; j < items.length; j++) {
                var it = items[j]
                if (typeof it != "function") {
                    if (it.__label != undefined) {
                        var lb = scope["$" + it.__label]
                        b.NewBr(lb)
                        b = lb
                    }
                    continue
                }
                b = it(b)
            }
            if (any) { labelScopes.pop() }
            return b
        }
    }

    // Emit an expression list the Lua way into a fresh array: every thunk but the last is
    // truncated to one value, the last one expands. This is what an argument list, an
    // expression list, a return and a table constructor all use.
    function emitListArr(b, ts) {
        var arr = callExt(b, "js_arr_new", [])
        var last = ts.length - 1
        for (var i = 0; i < ts.length; i++) {
            var r = ts[i](b)
            b = r.b
            if (i === last) { callLua(b, "lua_appendall", [arr, r.v]) }
            else { callExt(b, "js_arr_push", [arr, callLua(b, "lua_first", [r.v])]) }
        }
        return {b: b, v: arr}
    }
    // ( e ) truncates a multi-value to its first value.
    function luaParen(t) {
        return function(b) {
            var r = t(b)
            return {b: r.b, v: callLua(r.b, "lua_first", [r.v])}
        }
    }
    // '...' in expression position: the extra arguments of the enclosing variadic call,
    // which emitFunction stored in the frame under that very name.
    function makeVararg() {
        return function(b) {
            var arr = callExt(b, "js_scope_get", [curScopeV, emitStr(b, "...")])
            return {b: b, v: callLua(b, "lua_mk", [arr])}
        }
    }

    // a ^ b: always a float in Lua. There is no js_pow external and none is needed - the
    // host's Math lives in the same runtime, so the power is a method call on it.
    function emitPow(b, l, r) {
        var mathV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, "Math")])
        var argsV = callExt(b, "js_arr_new", [])
        callExt(b, "js_arr_push", [argsV, l])
        callExt(b, "js_arr_push", [argsV, r])
        return callExt(b, "js_mcall", [mathV, emitStr(b, "pow"), argsV])
    }
    function makePow(items) {
        if (items.length == 1) { return items[0] }
        var l = items[0]
        var r = items[1]
        return function(b) {
            var rl = l(b)
            b = rl.b
            var rr = r(b)
            b = rr.b
            return {b: b, v: callLua(b, "lua_mkflt", [emitPow(b, callLua(b, "lua_num", [rl.v]), callLua(b, "lua_num", [rr.v]))])}
        }
    }
    // Unary bitwise not: the complement is an exclusive or with all ones.
    function makeBNot(t) {
        return function(b) {
            var r = t(b)
            return {b: r.b, v: callExt(r.b, "js_bxor", [r.v, emitNum(r.b, 0 - 1)])}
        }
    }

    // The standard-library tables (math/string/table) and the global next() are emitted
    // into jsmain's scope only when the program actually references them, so a program
    // that uses none of them compiles to exactly the IR it did before. makeVarRef is the
    // single read path for a bare name, so it is where a reference is noticed.
    var libNeed = {math: false, string: false, table: false, next: false, ipairs: false, pairs: false}
    makeVarRef = function(name) {
        if (name == "math" || name == "string" || name == "table" || name == "next"
            || name == "ipairs" || name == "pairs") {
            libNeed[name] = true
        }
        return function(b) {
            return {b: b, v: callLua(b, "lua_getvar", [curScopeV, emitStr(b, name)])}
        }
    }

    // Lua truthiness for branches: an i1 that is 1 unless v is nil (hUndef) or false.
    truthy = function(b, v) {
        var isNil = b.NewICmp(llvm.enum.IPredNE, callExt(b, "js_truthy", [callExt(b, "js_seq", [v, hUndef])]), handle(0))
        var isFalse = b.NewICmp(llvm.enum.IPredNE, callExt(b, "js_truthy", [callExt(b, "js_seq", [v, hFalse])]), handle(0))
        var truthH = b.NewSelect(isNil, hFalse, b.NewSelect(isFalse, hFalse, hTrue))
        return b.NewICmp(llvm.enum.IPredNE, callExt(b, "js_truthy", [truthH]), handle(0))
    }

    // ----- Expression thunks: function(block) -> {b, v} -----

    // Unary minus is 0 - x, so it keeps the operand's number subtype and coerces a
    // string exactly like the binary operator does.
    makeNeg = function(t) {
        return function(b) {
            var r = t(b)
            return {b: r.b, v: callLua(r.b, "lua_arith", [handle(1), emitNum(r.b, 0), r.v])}
        }
    }
    // not v: true exactly when v is falsy.
    makeNot = function(t) {
        return function(b) {
            var r = t(b)
            b = r.b
            return {b: b, v: b.NewSelect(truthy(b, r.v), hFalse, hTrue)}
        }
    }
    // #v: a string yields its length (like the interpreter's luaLen); a table is
    // probed at t[1], t[2], ... for the first nil - the border is that index minus one.
    function makeLen(t) {
        return function(b) {
            var r = t(b)
            b = r.b
            var tv = r.v
            var saved = curScopeV
            curScopeV = callExt(b, "js_scope_new", [curScopeV])
            hidCount++
            var iName = "$li" + hidCount
            var tName = "$lt" + hidCount
            var rName = "$lr" + hidCount
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, tName), tv])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, iName), emitNum(b, 1)])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, rName), emitNum(b, 0)])
            var strB = curF.NewBlock("")
            var headB = curF.NewBlock("")
            var bodyB = curF.NewBlock("")
            var exitB = curF.NewBlock("")
            var joinB = curF.NewBlock("")
            var isStr = callExt(b, "js_seq", [callExt(b, "js_typeof", [tv]), emitStr(b, "string")])
            b.NewCondBr(truthy(b, isStr), strB, headB)
            callExt(strB, "js_scope_set", [curScopeV, emitStr(strB, rName), callExt(strB, "js_get", [tv, emitStr(strB, "length")])])
            strB.NewBr(joinB)
            var iV = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, iName)])
            var tV = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, tName)])
            var elem = callExt(headB, "js_get", [tV, iV])
            headB.NewCondBr(truthy(headB, callExt(headB, "js_sne", [elem, hUndef])), bodyB, exitB)
            var iV2 = callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, iName)])
            callExt(bodyB, "js_scope_set", [curScopeV, emitStr(bodyB, iName), callExt(bodyB, "js_add", [iV2, emitNum(bodyB, 1)])])
            bodyB.NewBr(headB)
            var iFin = callExt(exitB, "js_scope_get", [curScopeV, emitStr(exitB, iName)])
            callExt(exitB, "js_scope_set", [curScopeV, emitStr(exitB, rName), callExt(exitB, "js_sub", [iFin, emitNum(exitB, 1)])])
            exitB.NewBr(joinB)
            var lenV = callExt(joinB, "js_scope_get", [curScopeV, emitStr(joinB, rName)])
            curScopeV = saved
            return {b: joinB, v: lenV}
        }
    }
    // Concatenation: right associative, so at most two operands per node. Both sides are
    // rendered to strings (js_pystr) and joined (js_add on two strings concatenates).
    function makeConcat(items) {
        if (items.length == 1) { return items[0] }
        var l = items[0]
        var r = items[1]
        return function(b) {
            var rl = l(b)
            b = rl.b
            var rr = r(b)
            b = rr.b
            var ls = callLua(b, "lua_str", [callLua(b, "lua_first", [rl.v])])
            var rs = callLua(b, "lua_str", [callLua(b, "lua_first", [rr.v])])
            return {b: b, v: callExt(b, "js_add", [ls, rs])}
        }
    }

    // Lua operators: no 32 bit wrapping, floor division //, floor modulo %, ~= not equal.
    // Every binary operator goes through the value model rather than straight to an
    // external: the arithmetic has to know the two number subtypes and to coerce a
    // string operand, and the comparisons have to see through a float box. The bitwise
    // and/or/xor still map to the runtime's 32-bit externals - Lua's are 64-bit, so a
    // value beyond 32 bits does not match Lua yet (the shift COUNT does, see lua_shift).
    binExt = {"&": "js_band", "|": "js_bor", "~": "js_bxor"}
    wraps = {}
    var arithCode = {"+": 0, "-": 1, "*": 2, "/": 3, "//": 4, "%": 5}
    var cmpCode = {"<": 0, ">": 1, "<=": 2, ">=": 3}
    emitBin = function(b, op, l, r) {
        if (op == "<<" || op == ">>") {
            return callLua(b, "lua_shift", [handle(op == "<<" ? 1 : 0),
                callLua(b, "lua_num", [l]), callLua(b, "lua_num", [r])])
        }
        if (op == "&" || op == "|" || op == "~") {
            return callExt(b, binExt[op], [callLua(b, "lua_num", [l]), callLua(b, "lua_num", [r])])
        }
        if (op == "==") { return callLua(b, "lua_eq", [l, r]) }
        if (op == "~=") { return callExt(b, "js_not", [callLua(b, "lua_eq", [l, r])]) }
        if (cmpCode[op] != undefined) { return callLua(b, "lua_cmp", [handle(cmpCode[op]), l, r]) }
        return callLua(b, "lua_arith", [handle(arithCode[op]), l, r])
    }

    // ONE suffix step of a prefixexp, emitted. `pre` says whether the value coming in is a
    // possible multi-value (it is exactly after a call), in which case it is truncated
    // first. Shared by the expression folder below and by emitTargetWrite, which is what
    // makes `getmetatable(t).__index = f` emit exactly the chain `getmetatable(t).__index`
    // reads. Answers {b, v, call} - `call` is the next step's `pre`.
    function emitLuaStep(b, cur, s, pre) {
        var v = cur
        if (pre) { v = callLua(b, "lua_first", [v]) } // Only one value feeds a step.
        if (s.kind == "call") {
            var ea = emitListArr(b, s.args)
            b = ea.b
            return {b: b, v: callExt(b, "js_call", [v, hUndef, ea.v]), call: true}
        }
        if (s.kind == "method") {
            // obj:m(args): look up m on the receiver, then call it with the
            // receiver prepended as the first argument (self).
            var fn = callExt(b, "js_get", [v, emitStr(b, s.name)])
            var margs = callExt(b, "js_arr_new", [])
            callExt(b, "js_arr_push", [margs, v])
            var ma = emitListArr(b, s.args)
            b = ma.b
            b = emitArrExtend(b, margs, ma.v)
            return {b: b, v: callExt(b, "js_call", [fn, hUndef, margs]), call: true}
        }
        if (s.kind == "field") {
            return {b: b, v: callExt(b, "js_get", [v, emitStr(b, s.name)]), call: false}
        }
        var ir = s.idx(b)
        b = ir.b
        return {b: b, v: callExt(b, "js_get", [v, callLua(b, "lua_cmpv", [callLua(b, "lua_first", [ir.v])])]), call: false}
    }
    // items = [primaryThunk, {kind:"call"|"field"|"index", ...}...].
    foldCallMember = function(items) {
        if (items.length == 1) { return items[0] }
        var primary = items[0]
        var suffixes = items.slice(1)
        return function(b) {
            var r = primary(b)
            b = r.b
            var cur = r.v
            var afterCall = false
            for (var i = 0; i < suffixes.length; i++) {
                var st = emitLuaStep(b, cur, suffixes[i], afterCall)
                b = st.b
                cur = st.v
                afterCall = st.call
            }
            return {b: b, v: cur}
        }
    }

    // { ... } fields, in source order: positional fields fill numeric keys 1, 2, 3, ...
    function makeTable(items) {
        var lastPos = 0 - 1
        for (var k = 0; k < items.length; k++) { if (items[k].fkind == "pos") { lastPos = k } }
        return function(b) {
            var t = callExt(b, "js_obj_new", [])
            var pos = 1
            for (var i = 0; i < items.length; i++) {
                var f = items[i]
                if (f.fkind == "pos") {
                    var rv = f.v(b)
                    b = rv.b
                    if (i === lastPos) {
                        // The last positional field expands a multi-value into as many
                        // entries as it has values, so {f()} collects everything f gave.
                        b = emitSpreadInto(b, t, emitNum(b, pos), rv.v)
                    } else {
                        callExt(b, "js_set", [t, emitNum(b, pos), callLua(b, "lua_first", [rv.v])])
                        pos++
                    }
                } else if (f.fkind == "name") {
                    var rv2 = f.v(b)
                    b = rv2.b
                    callExt(b, "js_set", [t, emitStr(b, f.name), callLua(b, "lua_first", [rv2.v])])
                } else {
                    var rk = f.k(b)
                    b = rk.b
                    var rv3 = f.v(b)
                    b = rv3.b
                    callExt(b, "js_set", [t, callLua(b, "lua_cmpv", [callLua(b, "lua_first", [rk.v])]), callLua(b, "lua_first", [rv3.v])])
                }
            }
            return {b: b, v: t}
        }
    }

    // ----- Assignment -----
    function pathKeyV(b, p) {
        if (p.kind == "field") { return {b: b, v: emitStr(b, p.name)} }
        var r = p.idx(b)
        return {b: r.b, v: callLua(r.b, "lua_cmpv", [callLua(r.b, "lua_first", [r.v])])}
    }
    function emitTargetWrite(b, ref, v) {
        if (ref.path.length == 0) {
            callExt(b, "js_pyset_var", [curScopeV, emitStr(b, ref.name), v])
            return b
        }
        var o = callExt(b, "js_scope_get", [curScopeV, emitStr(b, ref.name)])
        // emitLuaStep, not a bare js_get: the leading steps of a target may be calls
        // (getmetatable(t).__index = f), which is ordinary Lua - see the Target production.
        var afterCall = false
        for (var i = 0; i < ref.path.length - 1; i++) {
            var st = emitLuaStep(b, o, ref.path[i], afterCall)
            b = st.b
            o = st.v
            afterCall = st.call
        }
        if (afterCall) { o = callLua(b, "lua_first", [o]) }
        var lk = pathKeyV(b, ref.path[ref.path.length - 1])
        b = lk.b
        callExt(b, "js_set", [o, lk.v, v])
        return b
    }
    // items interleave targets (objects) and value thunks (functions); all right hand
    // sides are evaluated first, then assigned positionally (missing values are nil).
    function makeAssign(items) {
        var targets = []
        var vals = []
        for (var i = 0; i < items.length; i++) {
            if (typeof items[i] == "function") { vals.push(items[i]) }
            else { targets.push(items[i]) }
        }
        return function(b) {
            var ra = emitListArr(b, vals)
            b = ra.b
            for (var t = 0; t < targets.length; t++) {
                b = emitTargetWrite(b, targets[t], callExt(b, "js_get", [ra.v, emitNum(b, t)]))
            }
            return b
        }
    }
    function makeLocal(items) {
        var names = []
        var vals = []
        for (var i = 0; i < items.length; i++) {
            if (typeof items[i] == "function") { vals.push(items[i]) }
            else { names.push(items[i].lname) }
        }
        return function(b) {
            var before = funcCount
            var ra = emitListArr(b, vals)
            b = ra.b
            // The new locals must stay invisible to a closure one of the initializers
            // just built - 'local f = function() return f end' reads the GLOBAL f in Lua -
            // and that closure captured the current frame, so the declarations go into a
            // fresh one. Only the case that really built a function pays for the frame,
            // and the enclosing block restores curScopeV on its way out.
            if (funcCount != before) { curScopeV = callExt(b, "js_scope_new", [curScopeV]) }
            for (var n = 0; n < names.length; n++) {
                callExt(b, "js_scope_decl", [curScopeV, emitStr(b, names[n]), callExt(b, "js_get", [ra.v, emitNum(b, n)])])
            }
            return b
        }
    }

    // ----- Functions -----
    function emitFunction(params, bodyT) {
        funcCount++
        var idx = funcCount
        var f = m.NewFunc("jsf_" + idx, i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var savedF = curF
        var savedScope = curScopeV
        var savedLoops = loopStack
        curF = f
        loopStack = []
        var b = f.NewBlock("entry")
        curScopeV = callExt(b, "js_scope_new", [f.Params[0]])
        for (var i = 0; i < params.length; i++) {
            // A trailing '...' marks the function variadic: the arguments beyond the
            // named ones go into the frame under that very name, where makeVararg
            // reads them.
            if (params[i] == "...") {
                callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "..."),
                    callLua(b, "lua_tail", [f.Params[1], emitNum(b, i)])])
                continue
            }
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, params[i]), callExt(b, "js_arg", [f.Params[1], handle(i)])])
        }
        var endB = bodyT(b)
        endB.NewRet(hUndef)
        curF = savedF
        curScopeV = savedScope
        loopStack = savedLoops
        return idx
    }
    function makeFuncExpr(bodyT, plist) {
        return function(b) {
            var idx = emitFunction(plist.params, bodyT)
            return {b: b, v: callExt(b, "js_closure", [handle(idx), curScopeV])}
        }
    }
    // A function-definition name: a base variable, a chain of .field steps, and a flag
    // marking a trailing :method step (which binds an implicit leading 'self' parameter).
    function makeFuncName(items) {
        var base = items[0].fnbase
        var steps = []
        var isMethod = false
        for (var i = 1; i < items.length; i++) {
            steps.push(items[i].fnstep)
            if (items[i].fnself === true) { isMethod = true }
        }
        return {fbase: base, fsteps: steps, fmethod: isMethod}
    }
    // function name(...) / function tbl.field(...) / function tbl:method(...). A method
    // definition prepends 'self'; a plain name assigns the variable, a dotted/method name
    // writes the closure into the last field of the resolved table path.
    function makeFunc(bodyT, plist, nameDesc) {
        var params = plist.params
        if (nameDesc.fmethod) {
            var mp = []
            mp.push("self")
            for (var i = 0; i < plist.params.length; i++) { mp.push(plist.params[i]) }
            params = mp
        }
        return function(b) {
            var idx = emitFunction(params, bodyT)
            var cl = callExt(b, "js_closure", [handle(idx), curScopeV])
            if (nameDesc.fsteps.length == 0) {
                callExt(b, "js_pyset_var", [curScopeV, emitStr(b, nameDesc.fbase), cl])
                return b
            }
            var o = callExt(b, "js_scope_get", [curScopeV, emitStr(b, nameDesc.fbase)])
            for (var i = 0; i < nameDesc.fsteps.length - 1; i++) {
                o = callExt(b, "js_get", [o, emitStr(b, nameDesc.fsteps[i])])
            }
            callExt(b, "js_set", [o, emitStr(b, nameDesc.fsteps[nameDesc.fsteps.length - 1]), cl])
            return b
        }
    }
    function makeLocalFunc(bodyT, plist, name) {
        return function(b) {
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, name), hUndef])
            var idx = emitFunction(plist.params, bodyT)
            var cl = callExt(b, "js_closure", [handle(idx), curScopeV])
            callExt(b, "js_scope_set", [curScopeV, emitStr(b, name), cl])
            return b
        }
    }

    // ----- Statement thunks: function(block) -> block -----
    function makeElseIf(suite, cond) { return {elifCond: cond, suite: suite} }
    function makeElse(suite) { return {elseSuite: suite} }
    makeIf = function(items) {
        var cond = items[0]
        var thenT = items[1]
        var elifs = []
        var elseT = null
        for (var i = 2; i < items.length; i++) {
            if (items[i].elifCond != undefined) { elifs.push(items[i]) }
            if (items[i].elseSuite != undefined) { elseT = items[i].elseSuite }
        }
        return function(b) {
            var mergeB = curF.NewBlock("")
            var r = cond(b)
            b = r.b
            var thenB = curF.NewBlock("")
            var nextB = curF.NewBlock("")
            b.NewCondBr(truthy(b, r.v), thenB, nextB)
            thenT(thenB).NewBr(mergeB)
            b = nextB
            for (var k = 0; k < elifs.length; k++) {
                var r2 = elifs[k].elifCond(b)
                b = r2.b
                var armB = curF.NewBlock("")
                var next2 = curF.NewBlock("")
                b.NewCondBr(truthy(b, r2.v), armB, next2)
                elifs[k].suite(armB).NewBr(mergeB)
                b = next2
            }
            if (elseT != null) { elseT(b).NewBr(mergeB) }
            else { b.NewBr(mergeB) }
            return mergeB
        }
    }
    function makeNumFor(items) {
        var name = items[0].fname
        var startT = items[1]
        var limitT = items[2]
        var block = items[items.length - 1]
        var stepT = (items.length == 5) ? items[3] : null
        return function(b) {
            var saved = curScopeV
            curScopeV = callExt(b, "js_scope_new", [curScopeV])
            hidCount++
            var iName = "$fi" + hidCount
            var limName = "$fl" + hidCount
            var stepName = "$fs" + hidCount
            var rs = startT(b)
            b = rs.b
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, iName), rs.v])
            var rl = limitT(b)
            b = rl.b
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, limName), rl.v])
            var stepV = emitNum(b, 1)
            if (stepT != null) {
                var rst = stepT(b)
                b = rst.b
                stepV = rst.v
            }
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, stepName), stepV])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, name), hUndef])
            var headB = curF.NewBlock("")
            var bodyB = curF.NewBlock("")
            var postB = curF.NewBlock("")
            var exitB = curF.NewBlock("")
            b.NewBr(headB)
            var iV = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, iName)])
            var limV = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, limName)])
            var stpV = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, stepName)])
            // The three control values keep their number subtype (a float start or step
            // makes the loop variable a float), so the tests run on the raw numbers.
            var iN = callLua(headB, "lua_num", [iV])
            var limN = callLua(headB, "lua_num", [limV])
            var stepPos = truthy(headB, callExt(headB, "js_gt", [callLua(headB, "lua_num", [stpV]), emitNum(headB, 0)]))
            var leCond = callExt(headB, "js_le", [iN, limN])
            var geCond = callExt(headB, "js_ge", [iN, limN])
            var condH = headB.NewSelect(stepPos, leCond, geCond)
            headB.NewCondBr(truthy(headB, condH), bodyB, exitB)
            callExt(bodyB, "js_scope_set", [curScopeV, emitStr(bodyB, name), callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, iName)])])
            loopStack.push({cont: postB, brk: exitB})
            block(bodyB).NewBr(postB)
            loopStack.pop()
            var iV2 = callExt(postB, "js_scope_get", [curScopeV, emitStr(postB, iName)])
            var stpV2 = callExt(postB, "js_scope_get", [curScopeV, emitStr(postB, stepName)])
            callExt(postB, "js_scope_set", [curScopeV, emitStr(postB, iName), callLua(postB, "lua_arith", [handle(0), iV2, stpV2])])
            postB.NewBr(headB)
            curScopeV = saved
            return exitB
        }
    }
    // repeat body until cond. The body block gets a fresh scope each iteration (so the
    // until condition, evaluated in that scope, sees the body's locals); it loops back
    // while cond is falsy. break -> exit, continue -> the until test.
    function makeRepeat(block, condT) {
        return function(b) {
            var saved = curScopeV
            var bodyB = curF.NewBlock("")
            var contB = curF.NewBlock("")
            var exitB = curF.NewBlock("")
            b.NewBr(bodyB)
            curScopeV = callExt(bodyB, "js_scope_new", [saved])
            loopStack.push({cont: contB, brk: exitB})
            block(bodyB).NewBr(contB)
            loopStack.pop()
            var r = condT(contB)
            r.b.NewCondBr(truthy(r.b, r.v), exitB, bodyB)
            curScopeV = saved
            return exitB
        }
    }
    // Generic for, in its full Lua form: the expression list yields the iterator TRIPLE
    // (function, state, initial control value) and every pass calls f(state, control).
    // The loop ends when the first returned value is nil; otherwise that value becomes
    // the next control value and the returned values are bound to the loop names. ipairs
    // and pairs are ordinary library functions returning such a triple, so a hand-written
    // iterator - stateless or a closure - drives the loop exactly the same way.
    // items = [{gname}..., iterExprThunk..., blockThunk]; the block is always last.
    function makeGenFor(items) {
        var names = []
        var exprs = []
        var block = items[items.length - 1]
        for (var i = 0; i < items.length - 1; i++) {
            if (typeof items[i] == "function") { exprs.push(items[i]) }
            else { names.push(items[i].gname) }
        }
        return function(b) {
            var saved = curScopeV
            curScopeV = callExt(b, "js_scope_new", [curScopeV])
            hidCount++
            var fName = "$gf" + hidCount
            var sName = "$gs" + hidCount
            var cName = "$gc" + hidCount
            var ra = emitListArr(b, exprs)
            b = ra.b
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, fName), callExt(b, "js_get", [ra.v, emitNum(b, 0)])])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, sName), callExt(b, "js_get", [ra.v, emitNum(b, 1)])])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, cName), callExt(b, "js_get", [ra.v, emitNum(b, 2)])])
            for (var n = 0; n < names.length; n++) {
                callExt(b, "js_scope_decl", [curScopeV, emitStr(b, names[n]), hUndef])
            }
            var headB = curF.NewBlock("")
            var bodyB = curF.NewBlock("")
            var postB = curF.NewBlock("")
            var exitB = curF.NewBlock("")
            b.NewBr(headB)
            var fV = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, fName)])
            var argsV = callExt(headB, "js_arr_new", [])
            callExt(headB, "js_arr_push", [argsV, callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, sName)])])
            callExt(headB, "js_arr_push", [argsV, callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, cName)])])
            var allV = callLua(headB, "lua_all", [callExt(headB, "js_call", [fV, hUndef, argsV])])
            var firstV = callExt(headB, "js_get", [allV, emitNum(headB, 0)])
            headB.NewCondBr(truthy(headB, callExt(headB, "js_sne", [firstV, hUndef])), bodyB, exitB)
            callExt(bodyB, "js_scope_set", [curScopeV, emitStr(bodyB, cName), firstV])
            for (var n2 = 0; n2 < names.length; n2++) {
                callExt(bodyB, "js_scope_set", [curScopeV, emitStr(bodyB, names[n2]), callExt(bodyB, "js_get", [allV, emitNum(bodyB, n2)])])
            }
            loopStack.push({cont: postB, brk: exitB})
            block(bodyB).NewBr(postB)
            loopStack.pop()
            postB.NewBr(headB)
            curScopeV = saved
            return exitB
        }
    }
    function makeDoBlock(block) {
        return function(b) {
            var saved = curScopeV
            curScopeV = callExt(b, "js_scope_new", [curScopeV])
            b = block(b)
            curScopeV = saved
            return b
        }
    }
    // return e1, e2, ...: all the values travel back as one Lua value (a single one
    // unwrapped, any other count as a multi-value box), the last expression expanding -
    // so 'return f()' propagates everything f returned.
    function makeReturn(items) {
        return function(b) {
            var ra = emitListArr(b, items)
            b = ra.b
            b.NewRet(callLua(b, "lua_mk", [ra.v]))
            return deadBlock()
        }
    }

    // ----- Standard library emission -----
    // Each library function is emitted as its own IR function jsf_N (like a Lua-level
    // function): a fresh scope/function/loop-stack, a body built by bodyEmit(entryBlock,
    // argsHandle) -> {b, v}, and a return. Its handle is wrapped by js_closure at the
    // declaration site so the running program can call it.
    function emitLibFunc(bodyEmit) {
        funcCount++
        var idx = funcCount
        var f = m.NewFunc("jsf_" + idx, i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var savedF = curF
        var savedScope = curScopeV
        var savedLoops = loopStack
        curF = f
        loopStack = []
        var b = f.NewBlock("entry")
        curScopeV = callExt(b, "js_scope_new", [f.Params[0]])
        var r = bodyEmit(b, f.Params[1])
        r.b.NewRet(r.v)
        curF = savedF
        curScopeV = savedScope
        loopStack = savedLoops
        return idx
    }
    function libArg(b, argsH, n) { return callExt(b, "js_arg", [argsH, handle(n)]) }
    // The sequence border (#t) of a live table handle, reusing the length probe loop.
    function emitBorder(b, tv) {
        return makeLen(function(bb) { return {b: bb, v: tv} })(b)
    }

    // math.*: floor via floor-division by 1; ceil derived from floor; abs/max/min via a
    // comparison and a select. All straight-line (Lua numbers are floats, no wrapping).
    function libFloor(bb, argsH) {
        var x = callLua(bb, "lua_num", [libArg(bb, argsH, 0)])
        return {b: bb, v: callExt(bb, "js_fdiv", [x, emitNum(bb, 1)])}
    }
    function libCeil(bb, argsH) {
        var x = callLua(bb, "lua_num", [libArg(bb, argsH, 0)])
        var fl = callExt(bb, "js_fdiv", [callExt(bb, "js_neg", [x]), emitNum(bb, 1)])
        return {b: bb, v: callExt(bb, "js_neg", [fl])}
    }
    function libAbs(bb, argsH) {
        var x = callLua(bb, "lua_num", [libArg(bb, argsH, 0)])
        var isNeg = truthy(bb, callExt(bb, "js_lt", [x, emitNum(bb, 0)]))
        return {b: bb, v: bb.NewSelect(isNeg, callExt(bb, "js_neg", [x]), x)}
    }
    function libMax(bb, argsH) {
        var a = callLua(bb, "lua_num", [libArg(bb, argsH, 0)])
        var c = callLua(bb, "lua_num", [libArg(bb, argsH, 1)])
        return {b: bb, v: bb.NewSelect(truthy(bb, callExt(bb, "js_gt", [a, c])), a, c)}
    }
    function libMin(bb, argsH) {
        var a = callLua(bb, "lua_num", [libArg(bb, argsH, 0)])
        var c = callLua(bb, "lua_num", [libArg(bb, argsH, 1)])
        return {b: bb, v: bb.NewSelect(truthy(bb, callExt(bb, "js_lt", [a, c])), a, c)}
    }

    // string.*: len via the host string's .length; upper/lower via the string methods;
    // sub is 1-based inclusive lowered to JS slice(i-1, j) (a nil j reaches the end);
    // rep concatenates n copies in a scoped while loop.
    function libStrLen(bb, argsH) {
        var s = libArg(bb, argsH, 0)
        return {b: bb, v: callExt(bb, "js_get", [s, emitStr(bb, "length")])}
    }
    // The compiled runtime exposes toUpperCase/toLowerCase/slice on strings through the
    // bound-method path (js_get yields the method, js_call runs it), not js_mcall.
    function libStrMethod(bb, s, method, argsArr) {
        return callExt(bb, "js_call", [callExt(bb, "js_get", [s, emitStr(bb, method)]), hUndef, argsArr])
    }
    function libUpper(bb, argsH) {
        var s = libArg(bb, argsH, 0)
        return {b: bb, v: libStrMethod(bb, s, "toUpperCase", callExt(bb, "js_arr_new", []))}
    }
    function libLower(bb, argsH) {
        var s = libArg(bb, argsH, 0)
        return {b: bb, v: libStrMethod(bb, s, "toLowerCase", callExt(bb, "js_arr_new", []))}
    }
    function libSub(bb, argsH) {
        var s = libArg(bb, argsH, 0)
        var i = callLua(bb, "lua_num", [libArg(bb, argsH, 1)])
        var j = libArg(bb, argsH, 2)
        var arr = callExt(bb, "js_arr_new", [])
        callExt(bb, "js_arr_push", [arr, callExt(bb, "js_sub", [i, emitNum(bb, 1)])])
        callExt(bb, "js_arr_push", [arr, j])
        return {b: bb, v: libStrMethod(bb, s, "slice", arr)}
    }
    function libRep(bb, argsH) {
        var s = libArg(bb, argsH, 0)
        var n = callLua(bb, "lua_num", [libArg(bb, argsH, 1)])
        var saved = curScopeV
        curScopeV = callExt(bb, "js_scope_new", [curScopeV])
        hidCount++
        var iName = "$ri" + hidCount
        var aName = "$ra" + hidCount
        callExt(bb, "js_scope_decl", [curScopeV, emitStr(bb, iName), emitNum(bb, 0)])
        callExt(bb, "js_scope_decl", [curScopeV, emitStr(bb, aName), emitStr(bb, "")])
        var headB = curF.NewBlock("")
        var bodyB = curF.NewBlock("")
        var exitB = curF.NewBlock("")
        bb.NewBr(headB)
        var iV = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, iName)])
        headB.NewCondBr(truthy(headB, callExt(headB, "js_lt", [iV, n])), bodyB, exitB)
        var aV = callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, aName)])
        callExt(bodyB, "js_scope_set", [curScopeV, emitStr(bodyB, aName), callExt(bodyB, "js_add", [aV, s])])
        var iV2 = callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, iName)])
        callExt(bodyB, "js_scope_set", [curScopeV, emitStr(bodyB, iName), callExt(bodyB, "js_add", [iV2, emitNum(bodyB, 1)])])
        bodyB.NewBr(headB)
        var aFin = callExt(exitB, "js_scope_get", [curScopeV, emitStr(exitB, aName)])
        curScopeV = saved
        return {b: exitB, v: aFin}
    }

    // table.insert(t, v): append at the border+1. table.remove(t): read the last element,
    // clear its slot (so #t shrinks), and return it.
    function libInsert(bb, argsH) {
        var t = libArg(bb, argsH, 0)
        var v = libArg(bb, argsH, 1)
        var rb = emitBorder(bb, t)
        var b2 = rb.b
        callExt(b2, "js_set", [t, callExt(b2, "js_add", [rb.v, emitNum(b2, 1)]), v])
        return {b: b2, v: hUndef}
    }
    function libRemove(bb, argsH) {
        var t = libArg(bb, argsH, 0)
        var rb = emitBorder(bb, t)
        var b2 = rb.b
        var val = callExt(b2, "js_get", [t, rb.v])
        callExt(b2, "js_set", [t, rb.v, hUndef])
        return {b: b2, v: val}
    }

    // next(t [, k]): the array-part iterator, straight-line. k nil -> probe index 1, else
    // k+1; the result is that index while t[index] is non-nil, else nil (the key only,
    // since the subset yields one value per call).
    function libNext(bb, argsH) {
        var t = libArg(bb, argsH, 0)
        var k = libArg(bb, argsH, 1)
        var i = bb.NewSelect(truthy(bb, callExt(bb, "js_seq", [k, hUndef])), emitNum(bb, 0), k)
        var nk = callExt(bb, "js_add", [i, emitNum(bb, 1)])
        var elem = callExt(bb, "js_get", [t, nk])
        return {b: bb, v: bb.NewSelect(truthy(bb, callExt(bb, "js_seq", [elem, hUndef])), hUndef, nk)}
    }

    // ipairs(t) / pairs(t): both answer the iterator triple the generic for consumes.
    // ipairs walks 1, 2, 3, ... and stops at the first nil element; pairs walks the
    // table's own keys in insertion order (js_keys, deterministic across engines) and
    // skips the ones whose value is nil, binding the key in its stored (string) form.
    // ipairs' iterator is stateless (its control value is the index), pairs' is a closure
    // over a cursor cell - the loop feeds the control value back either way.
    function libINext(bb, argsH) {
        var t = libArg(bb, argsH, 0)
        var nk = callExt(bb, "js_add", [libArg(bb, argsH, 1), emitNum(bb, 1)])
        var v = callExt(bb, "js_get", [t, nk])
        var nilB = curF.NewBlock("")
        var okB = curF.NewBlock("")
        bb.NewCondBr(truthy(bb, callExt(bb, "js_seq", [v, hUndef])), nilB, okB)
        nilB.NewRet(hUndef)
        var arr = callExt(okB, "js_arr_new", [])
        callExt(okB, "js_arr_push", [arr, nk])
        callExt(okB, "js_arr_push", [arr, v])
        okB.NewRet(callLua(okB, "lua_mk", [arr]))
        return {b: deadBlock(), v: hUndef}
    }
    function libIpairs(bb, argsH) {
        var t = libArg(bb, argsH, 0)
        var arr = callExt(bb, "js_arr_new", [])
        callExt(bb, "js_arr_push", [arr, callExt(bb, "js_closure", [handle(emitLibFunc(libINext)), curScopeV])])
        callExt(bb, "js_arr_push", [arr, t])
        callExt(bb, "js_arr_push", [arr, emitNum(bb, 0)])
        return {b: bb, v: callLua(bb, "lua_mk", [arr])}
    }
    // The cursor of a pairs walk: {t, k (the key array), i}. Its iterator ignores the
    // control value the loop hands back and advances the cursor itself.
    function libPNext(bb, argsH) {
        var st = libArg(bb, argsH, 0)
        var tV = callExt(bb, "js_get", [st, emitStr(bb, "t")])
        var kV = callExt(bb, "js_get", [st, emitStr(bb, "k")])
        var nV = callExt(bb, "js_get", [kV, emitStr(bb, "length")])
        var headB = curF.NewBlock("")
        var bodyB = curF.NewBlock("")
        var hitB = curF.NewBlock("")
        var skipB = curF.NewBlock("")
        var endB = curF.NewBlock("")
        bb.NewBr(headB)
        var iV = callExt(headB, "js_get", [st, emitStr(headB, "i")])
        headB.NewCondBr(truthy(headB, callExt(headB, "js_lt", [iV, nV])), bodyB, endB)
        var iV2 = callExt(bodyB, "js_get", [st, emitStr(bodyB, "i")])
        var keyV = callExt(bodyB, "js_get", [kV, iV2])
        var valV = callExt(bodyB, "js_get", [tV, keyV])
        callExt(bodyB, "js_set", [st, emitStr(bodyB, "i"), callExt(bodyB, "js_add", [iV2, emitNum(bodyB, 1)])])
        bodyB.NewCondBr(truthy(bodyB, callExt(bodyB, "js_sne", [valV, hUndef])), hitB, skipB)
        skipB.NewBr(headB)
        var parr = callExt(hitB, "js_arr_new", [])
        callExt(hitB, "js_arr_push", [parr, keyV])
        callExt(hitB, "js_arr_push", [parr, valV])
        hitB.NewRet(callLua(hitB, "lua_mk", [parr]))
        endB.NewRet(hUndef)
        return {b: deadBlock(), v: hUndef}
    }
    function libPairs(bb, argsH) {
        var t = libArg(bb, argsH, 0)
        var st = callExt(bb, "js_obj_new", [])
        callExt(bb, "js_set", [st, emitStr(bb, "t"), t])
        callExt(bb, "js_set", [st, emitStr(bb, "k"), callExt(bb, "js_keys", [t])])
        callExt(bb, "js_set", [st, emitStr(bb, "i"), emitNum(bb, 0)])
        var arr = callExt(bb, "js_arr_new", [])
        callExt(bb, "js_arr_push", [arr, callExt(bb, "js_closure", [handle(emitLibFunc(libPNext)), curScopeV])])
        callExt(bb, "js_arr_push", [arr, st])
        callExt(bb, "js_arr_push", [arr, hUndef])
        return {b: bb, v: callLua(bb, "lua_mk", [arr])}
    }

    // libSet wires one closure into a library table field; libDecl binds a table (or a
    // bare function) into jsmain's scope under its global name.
    function libSet(b, obj, name, idx) {
        callExt(b, "js_set", [obj, emitStr(b, name), callExt(b, "js_closure", [handle(idx), curScopeV])])
        return b
    }
    // Emit only the referenced libraries; a program that uses none emits nothing here and
    // its IR is unchanged from before this feature existed.
    function emitLibs(b) {
        if (libNeed.ipairs) {
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "ipairs"), callExt(b, "js_closure", [handle(emitLibFunc(libIpairs)), curScopeV])])
        }
        if (libNeed.pairs) {
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "pairs"), callExt(b, "js_closure", [handle(emitLibFunc(libPairs)), curScopeV])])
        }
        if (libNeed.next) {
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "next"), callExt(b, "js_closure", [handle(emitLibFunc(libNext)), curScopeV])])
        }
        if (libNeed.math) {
            var mt = callExt(b, "js_obj_new", [])
            b = libSet(b, mt, "floor", emitLibFunc(libFloor))
            b = libSet(b, mt, "ceil", emitLibFunc(libCeil))
            b = libSet(b, mt, "abs", emitLibFunc(libAbs))
            b = libSet(b, mt, "max", emitLibFunc(libMax))
            b = libSet(b, mt, "min", emitLibFunc(libMin))
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "math"), mt])
        }
        if (libNeed.string) {
            var st = callExt(b, "js_obj_new", [])
            b = libSet(b, st, "len", emitLibFunc(libStrLen))
            b = libSet(b, st, "upper", emitLibFunc(libUpper))
            b = libSet(b, st, "lower", emitLibFunc(libLower))
            b = libSet(b, st, "sub", emitLibFunc(libSub))
            b = libSet(b, st, "rep", emitLibFunc(libRep))
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "string"), st])
        }
        if (libNeed.table) {
            var tt = callExt(b, "js_obj_new", [])
            b = libSet(b, tt, "insert", emitLibFunc(libInsert))
            b = libSet(b, tt, "remove", emitLibFunc(libRemove))
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "table"), tt])
        }
        return b
    }

    // jsmain: declare print, then run the file top to bottom.
    function buildMain(items) {
        // The walk of a required file ends here too (importDepth > 0): stash its top-level
        // statement thunks for the real jsmain instead of emitting a second one.
        if (importDepth > 0) {
            stashImported(items) // stashed with its file; emitted later (compile-core)
            return
        }
        var f = m.NewFunc("jsmain", i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        curF = f
        var b = f.NewBlock("entry")
        curScopeV = callExt(b, "js_scope_new", [f.Params[0]])
        funcCount++
        var prIdx = funcCount
        var pf = m.NewFunc("jsf_" + prIdx, i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var pb = pf.NewBlock("entry")
        // js_luaprint joins with a TAB, which is what Lua's print does (js_pyprint
        // joined with a space - Python's rule - so every multi-argument print
        // differed from lua-interpreter.abnf and from real Lua).
        pb.NewCall(getExtern("js_luaprint", 1), [callLua(pb, "lua_strall", [pf.Params[1]])])
        pb.NewRet(hUndef)
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "print"), callExt(b, "js_closure", [handle(prIdx), curScopeV])])
        b = emitLibs(b)
        b = emitImported(b)
        b = makeSeq(items)(b)
        b.NewRet(hUndef)
    }
    function buildChunk(items) { buildMain(items) }

    // ----- Core library config (see lib/compile-core.js) -----
    // Lua stdlib libraries the runtime already provides; require of one is a no-op.
    core.stdlibImports = ["string", "table", "math", "io", "os", "coroutine"]

    // ----- Project-file imports (see the Require rule) -----
    function luaImport(items, pos) {
        resolveImport(items[items.length - 1], pos)
        return function(b) { return b }
    }
    // A required file is parsed with this grammar and walked with importDepth > 0, so its
    // buildMain stashes its top-level thunks into importedItems; the real buildMain prepends
    // them to jsmain. Required once; a leading './' is dropped and a missing '.lua' extension
    // appended before the -i-root search.
    var importedFiles = {}
    var importDepth = 0
    // imported files top-level items: stashImported / emitImported (compile-core)
    core.importFile = function(path, pos) {
        var rel = path
        if (rel.length >= 2 && rel.charAt(0) == "." && rel.charAt(1) == "/") { rel = rel.substring(2) }
        if (!(rel.length >= 4 && rel.substring(rel.length - 4) == ".lua")) { rel = rel + ".lua" }
        var file = c.findImport(rel)
        if (file == "") { return false }
        if (importedFiles["$" + file] == true) { return true }
        importedFiles["$" + file] = true
        var text = c.readFile(file)
        var asg = c.parse(c.agrammar, text, null, file)
        c.pushSource(file, text)
        importDepth = importDepth + 1
        c.compile(asg)
        importDepth = importDepth - 1
        c.popSource()
        return true
    }

    c.compile(c.asg)

    println(m)

    var res = llvm.RunJS(m, "jsmain")
    println("lua compiler: program ran to completion")
    exit(res.Ret)

~~) ;
