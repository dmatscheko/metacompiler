            var misB = curF.NewBlock("")
            var hitB = curF.NewBlock("")
            b.NewCondBr(rawTruthy(b, callExt(b, "js_seq", [callExt(b, "js_scope_typeof", [ps[0], ps[1]]), emitStr(b, "undefined")])), misB, hitB)
