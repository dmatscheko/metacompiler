                    b = rv2.b
                    callExt(b, "js_set", [t, emitStr(b, luaNameKey(f.name)), callLua(b, "lua_first", [rv2.v])])
                } else {
                    var rk = f.k(b)
                    b = rk.b
                    var rv3 = f.v(b)
                    b = rv3.b
                    var kv = callLua(b, "lua_first", [rk.v])
                    callExt(b, "js_set", [t, callExt(b, "js_luwkey", [kv]), callLua(b, "lua_first", [rv3.v])])
