            var fileNo = posB.NewLShr(ps[0], handle(24))
            var lineV = callExt(posB, "js_num_i", [posB.NewAnd(ps[0], handle(16777215))])
            var cur = posB
            for (var fi = 0; fi < luaFiles.length; fi++) {
