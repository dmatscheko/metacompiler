    // parts of the value model live in one place instead of at every operator site. A
    // helper has no env parameter and therefore no scope: everything it needs arrives in
    // its arguments (which is why the '^' lowering, the one that reaches for the host's
    // Math, stays at the call site).
    var luaFns = {}
    function luaFn(name) {
        var have = luaFns["$" + name]
        if (have != undefined) { return have }
        var np = luaFnArity[name]
        var params = []
        for (var i = 0; i < np; i++) { params.push(llvm.ir.NewParam("p" + i, i64)) }
        var f = m.NewFunc(name, i64, params)
        luaFns["$" + name] = f // Registered before the body, so a helper may call itself.
        var savedF = curF
        var savedScope = curScopeV
        var savedLoops = loopStack
        curF = f
        loopStack = []
        luaFnBody(name, f.NewBlock("entry"), f.Params)
        curF = savedF
        curScopeV = savedScope
        loopStack = savedLoops
        return f
    }
    function callLua(b, name, args) { return b.NewCall(luaFn(name), args) }
    var luaFnArity = {lua_getvar: 2, lua_ismv: 1, lua_first: 1, lua_all: 1, lua_mk: 1, lua_appendall: 2, lua_extend: 2, lua_spread: 3,
                      lua_tail: 2, lua_shift: 3, lua_strall: 1,
                      lua_num: 1, lua_isnum: 1, lua_isint: 1, lua_mkflt: 1, lua_res: 3,
                      lua_arith: 3, lua_eq: 2, lua_cmp: 3, lua_cmpv: 1, lua_str: 1,
                      lua_sub: 3, lua_subi: 2, lua_subj: 2, lua_subjv: 2, lua_clamplo: 1, lua_clamphi: 2}
    // Inside a helper the tested value is already a real boolean, so the plain host test
    // is enough - Lua's own truthiness (the `truthy` override below) would recurse.
    function rawTruthy(b, v) { return b.NewICmp(llvm.enum.IPredNE, callExt(b, "js_truthy", [v]), handle(0)) }
    function luaFnBody(name, b, ps) {
        if (name == "lua_ismv") {
            // A multi-value is an object carrying its value array under __mv; anything
            // else (a number, a string, nil, a table) is a single value.
            var objB = curF.NewBlock("")
            var noB = curF.NewBlock("")
