                var dn = 0
                i = i + 1
                while (dn < 3 && i < s.length && s.charCodeAt(i) >= 48 && s.charCodeAt(i) <= 57) {
                    dv = dv * 10 + (s.charCodeAt(i) - 48)
                    i = i + 1
                    dn = dn + 1
                }
                out = out + String.fromCharCode(dv)
                continue
