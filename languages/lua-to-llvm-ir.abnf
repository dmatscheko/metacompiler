        var n = s.length
        while (i < n && isSpaceCode(s.charCodeAt(i))) { i = i + 1 }
        while (n > i && isSpaceCode(s.charCodeAt(n - 1))) { n = n - 1 }
        var neg = false
        if (i < n && (s.charCodeAt(i) === 43 || s.charCodeAt(i) === 45)) {
            neg = s.charCodeAt(i) === 45
            i = i + 1
        }
        if (i >= n) { return undefined }
