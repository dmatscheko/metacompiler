            // other count becomes a multi-value box.
            var oneB3 = curF.NewBlock("")
            var boxB = curF.NewBlock("")
            var n = callExt(b, "js_get", [ps[0], emitStr(b, "length")])
            b.NewCondBr(truthy(b, callExt(b, "js_seq", [n, emitNum(b, 1)])), oneB3, boxB)
            oneB3.NewRet(callExt(oneB3, "js_get", [ps[0], emitNum(oneB3, 0)]))
            var box = callExt(boxB, "js_obj_new", [])
            callExt(boxB, "js_set", [box, emitStr(boxB, "__mv"), ps[0]])
