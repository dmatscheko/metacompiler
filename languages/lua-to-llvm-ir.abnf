        if (s.charCodeAt(i) === 48 && i + 1 < n && (s.charCodeAt(i + 1) === 120 || s.charCodeAt(i + 1) === 88)) {
            r = luaHexNum(s, i + 2, n)
        } else {
            r = luaDecNum(s, i, n)
        }
        if (r === undefined) { return undefined }
        if (!neg) { return r }
        if (isFlt(r)) { return mkFlt(0 - r.v) }
        if (isILit(r)) { return mkILit("-" + r.d, r.r) }
        return 0 - r
    }
    function luaHexNum(s, i, n) {
