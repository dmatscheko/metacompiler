    function luaDecNum(s, i, n) {
        var start = i
        var isFloat = false
        var digits = 0
        while (i < n && s.charCodeAt(i) >= 48 && s.charCodeAt(i) <= 57) { i = i + 1; digits = digits + 1 }
        if (i < n && s.charCodeAt(i) === 46) {
            isFloat = true
            i = i + 1
            while (i < n && s.charCodeAt(i) >= 48 && s.charCodeAt(i) <= 57) { i = i + 1; digits = digits + 1 }
        }
        if (digits === 0) { return undefined }
        if (i < n && (s.charCodeAt(i) === 101 || s.charCodeAt(i) === 69)) {
            isFloat = true
            i = i + 1
            if (i < n && (s.charCodeAt(i) === 43 || s.charCodeAt(i) === 45)) { i = i + 1 }
            var edig = 0
            while (i < n && s.charCodeAt(i) >= 48 && s.charCodeAt(i) <= 57) { i = i + 1; edig = edig + 1 }
            if (edig === 0) { return undefined }
        }
