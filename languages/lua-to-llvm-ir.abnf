            var d = v.d
            var radix = v.r
            if (radix == 10 && d.length <= 15) { return coreMakeConst(parseFloat(d)) }
            return function(b) {
                return {b: b, v: callExt(b, "js_lulit", [emitStr(b, d), emitNum(b, radix)])}
            }
        }
        if (!isFlt(v)) { return coreMakeConst(v) }
        var n = v.v
        return function(b) {
            var o = callExt(b, "js_obj_new", [])
            callExt(b, "js_set", [o, emitStr(b, "__f"), emitNum(b, n)])
