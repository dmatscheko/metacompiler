    function callLua(b, name, args) { return b.NewCall(luaFn(name), args) }
    var luaFnArity = {lua_catstr: 4, lua_metabin: 3, lua_where: 1, lua_whereat: 1, lua_errlevel: 1, lua_errval: 1, lua_errtext: 1, lua_raise: 1,
                      lua_getvar: 2, lua_ismv: 1, lua_first: 1, lua_all: 1, lua_mk: 1, lua_appendall: 2, lua_extend: 2, lua_spread: 3,
                      lua_tail: 2, lua_shift: 3, lua_strall: 1, lua_tramp: 1,
                      lua_num: 1, lua_isnum: 1, lua_isint: 1, lua_mkflt: 1, lua_res: 3,
                      lua_arith: 3, lua_eq: 2, lua_cmp: 3, lua_cmpv: 1, lua_str: 1,
                      lua_argerr: 3, lua_argmsg: 2, lua_needany: 3, lua_opmsg: 2}
    // Inside a helper the tested value is already a real boolean, so the plain host test
