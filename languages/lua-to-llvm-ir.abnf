    // ----- Assignment -----
    // A target's key: a field's name, or the index's first value, which is made a
    // table key only when it is written (js_luwkey rejects nil and NaN there).
    function pathKeyV(b, p) {
        if (p.kind == "field") { return {b: b, v: emitStr(b, luaNameKey(p.name)), raw: false, name: p.name} }
        var r = p.idx(b)
        return {b: r.b, v: callLua(r.b, "lua_first", [r.v]), raw: true, name: ""}
    }
    // An indexed target's table and key, evaluated before any right-hand side, as
    // lua does (manual 3.3.3: in `i, a[i] = i+1, 20` the a[i] is a[old i]); whether
    // the table takes a field is only asked when it is written (emitSlotWrite). A
    // plain name has no slot. Twin of targetSlot in lua-interpreter.abnf.
    function emitTargetSlot(b, ref) {
        if (ref.path.length == 0) { return {b: b, o: null} }
        var o = callLua(b, "lua_getvar", [curScopeV, emitStr(b, ref.name)])
        // emitLuaStep, not a bare js_get: the leading steps of a target may be calls
        // (getmetatable(t).__index = f), which is ordinary Lua - see the Target production.
        var afterCall = false
        var cnames = luaCalleeNames(ref.name, ref.path)
        var pdescs = luaPrefixDescs(luaVarDesc(ref.name), ref.path)
        for (var i = 0; i < ref.path.length - 1; i++) {
            var st = emitLuaStep(b, o, ref.path[i], afterCall, false, cnames[i], pdescs[i])
            b = st.b
            o = st.v
            afterCall = st.call
        }
        if (afterCall) { o = callLua(b, "lua_first", [o]) }
        var lk = pathKeyV(b, ref.path[ref.path.length - 1])
        return {b: lk.b, o: o, k: lk.v, raw: lk.raw, name: lk.name, d: pdescs[ref.path.length - 1]}
    }
    function emitSlotWrite(b, ref, slot, v) {
        if (slot.o == null) {
            callExt(b, "js_scope_set_or_create", [curScopeV, emitStr(b, ref.name), v])
            return b
        }
        var o = slot.o
        // Only a table takes a field - not the {__f} box of an integral float -
        // and anything else is a Lua error, as in luaSetIndex. A table whose __f
        // slot holds its metatable takes the store to js_lusetindex (__newindex),
        // with the key as the program wrote it.
        var objB = curF.NewBlock("")
        var setB = curF.NewBlock("")
        var slotB = curF.NewBlock("")
        var metaB = curF.NewBlock("")
        var badB = curF.NewBlock("")
        var doneB = curF.NewBlock("")
        b.NewCondBr(rawTruthy(b, callExt(b, "js_seq", [callExt(b, "js_typeof", [o]), emitStr(b, "object")])), objB, badB)
        var fV = callExt(objB, "js_get", [o, emitStr(objB, "__f")])
        objB.NewCondBr(rawTruthy(objB, callExt(objB, "js_seq", [fV, hUndef])), setB, slotB)
        callExt(setB, "js_set", [o, slot.raw ? callExt(setB, "js_luwkey", [slot.k]) : slot.k, v])
        setB.NewBr(doneB)
        // A file has a metatable too, and is no table to store into.
        var metaTabB = curF.NewBlock("")
        slotB.NewCondBr(rawTruthy(slotB, callExt(slotB, "js_seq", [callExt(slotB, "js_typeof", [fV]), emitStr(slotB, "object")])), metaTabB, badB)
        metaTabB.NewCondBr(rawTruthy(metaTabB, callExt(metaTabB, "js_seq", [callExt(metaTabB, "js_lutypeof", [o]), emitStr(metaTabB, "table")])), metaB, badB)
        callExt(metaB, "js_lusetindex", [o, slot.raw ? slot.k : emitStr(metaB, slot.name), v])
        metaB.NewBr(doneB)
        luaIndexError(badB, o, luaDescText(slot.d))
        badB.NewBr(doneB)
        return doneB
    }
    // items interleave targets (objects) and value thunks (functions). The targets'
    // tables and keys are evaluated first, left to right, then all right hand sides,
    // then the stores run right to left as lua's do (`a, a = 1, 2` leaves 1); missing
    // values are nil. Twin of makeAssign in lua-interpreter.abnf.
    function makeAssign(items) {
        var targets = []
        var vals = []
        for (var i = 0; i < items.length; i++) {
            if (typeof items[i] == "function") { vals.push(items[i]) }
            else { targets.push(items[i]) }
        }
        return function(b) {
            // ONE target, ONE value is the assignment nearly every program writes, and
            // it does not need the positional array at all: lua_first(v) IS
            // js_get(appendall([], v), 0) for every v, the empty multi-value included
            // (both answer nil), and the array would be an allocation per execution.
            var slots = []
            for (var s = 0; s < targets.length; s++) {
                var sl = emitTargetSlot(b, targets[s])
                b = sl.b
                slots.push(sl)
            }
            if (targets.length == 1 && vals.length == 1) {
                var r1 = vals[0](b)
                return emitSlotWrite(r1.b, targets[0], slots[0], callLua(r1.b, "lua_first", [r1.v]))
            }
            var ra = emitListArr(b, vals)
            b = ra.b
            for (var t = targets.length - 1; t >= 0; t--) {
                b = emitSlotWrite(b, targets[t], slots[t], callExt(b, "js_get", [ra.v, emitNum(b, t)]))
            }
            return b
        }
    }
    // A <const> local whose initializer is a constant - a literal nil, boolean,
    // number or string - is folded away by lua, so an error names no variable for
    // it. `items` are makeLocal's; the answer is one flag per name.
    function luaFolded(items) {
        var flags = []
        var texts = []
        for (var i = 0; i < items.length; i++) {
            var it = items[i]
            if (typeof it == "function") { continue }
            if (it.lname != undefined) { flags.push(false) }
            else if (it.lattr != undefined) { flags[flags.length - 1] = it.lattr.indexOf("const") >= 0 }
            else if (it.ltext != undefined) { texts.push(it.ltext) }
        }
        for (var k = 0; k < flags.length; k++) { flags[k] = flags[k] && k < texts.length && luaConstText(texts[k]) }
        return flags
    }
    function luaConstText(t) {
        if (t == "nil" || t == "true" || t == "false") { return true }
        var c = t.length > 0 ? t.charCodeAt(0) : 0
        if (c === 34 || c === 39) { return true }
        var s = c === 45 ? t.substring(1) : t
        if (s.length == 0) { return false }
        var c0 = s.charCodeAt(0)
        if (!(c0 >= 48 && c0 <= 57) && c0 !== 46) { return false }
        for (var i = 0; i < s.length; i++) { if (!luaIsIdChar(s.charCodeAt(i)) && s.charCodeAt(i) !== 46) { return false } }
        return true
    }
    function makeLocal(items) {
        var names = []
        var vals = []
        for (var i = 0; i < items.length; i++) {
            if (typeof items[i] == "function") { vals.push(items[i]) }
            else if (items[i].lname != undefined) { names.push(items[i].lname) }
        }
        var folded = luaFolded(items)
        return function(b) {
            // `local x = e` - one name, one value - skips the positional array for the
            // same reason makeAssign does; see the note there.
            if (names.length == 1 && vals.length == 1) {
                var r1 = vals[0](b)
                b = r1.b
                var v1 = callLua(b, "lua_first", [r1.v])
                luaLocalScope(b)
                callExt(b, "js_scope_decl", [curScopeV, emitStr(b, names[0]), v1])
                luaDeclare(folded[0] ? "\x00k" + names[0] : names[0])
                return b
            }
            var ra = emitListArr(b, vals)
            b = ra.b
            luaLocalScope(b)
            for (var n = 0; n < names.length; n++) {
                callExt(b, "js_scope_decl", [curScopeV, emitStr(b, names[n]), callExt(b, "js_get", [ra.v, emitNum(b, n)])])
                luaDeclare(folded[n] ? "\x00k" + names[n] : names[n])
            }
            return b
        }
    }

    // ----- Functions -----
    function emitFunction(params, bodyT) {
        funcCount++
        var idx = funcCount
        var f = m.NewFunc("jsf_" + idx, i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var savedF = curF
        var savedScope = curScopeV
        var savedLoops = loopStack
        curF = f
        loopStack = []
        var b = f.NewBlock("entry")
        var savedFrame = luaFrame
        luaFrame = luaEnter(b, true)
        curScopeV = callExt(b, "js_scope_new", [f.Params[0]])
        luaDeclPush(true)
        for (var i = 0; i < params.length; i++) {
            // A trailing '...' marks the function variadic: the arguments beyond the
            // named ones go into the frame under that very name, where makeVararg
            // reads them.
            if (params[i] == "...") {
                callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "..."),
                    callLua(b, "lua_tail", [f.Params[1], emitNum(b, i)])])
                continue
            }
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, params[i]), callExt(b, "js_arg", [f.Params[1], handle(i)])])
            luaDeclare(params[i])
        }
        luaOwnTop = true
        var savedStamp = luaScopeStamp
        luaScopeStamp = funcCount
        var endB = bodyT(b)
        luaScopeStamp = savedStamp
        luaDeclPop()
        luaLeave(endB, luaFrame)
        // Running off the end returns NO value (select('#', f()) is 0, print(f())
        // an empty line) - the one empty multi-value jsmain made.
        endB.NewRet(endB.NewLoad(i64, gLuaNone))
        luaFrame = savedFrame
        curF = savedF
        curScopeV = savedScope
        loopStack = savedLoops
        return idx
    }
    function makeFuncExpr(bodyT, plist) {
        return function(b) {
            var idx = emitFunction(plist.params, bodyT)
            return {b: b, v: callExt(b, "js_closure", [handle(idx), curScopeV])}
        }
    }
    // A function-definition name: a base variable, a chain of .field steps, and a flag
    // marking a trailing :method step (which binds an implicit leading 'self' parameter).
    function makeFuncName(items) {
        var base = items[0].fnbase
        var steps = []
        var isMethod = false
        for (var i = 1; i < items.length; i++) {
            steps.push(items[i].fnstep)
            if (items[i].fnself === true) { isMethod = true }
        }
        return {fbase: base, fsteps: steps, fmethod: isMethod}
    }
    // function name(...) / function tbl.field(...) / function tbl:method(...). A method
    // definition prepends 'self'; a plain name assigns the variable, a dotted/method name
    // writes the closure into the last field of the resolved table path.
    function makeFunc(bodyT, plist, nameDesc) {
        var params = plist.params
        if (nameDesc.fsteps.length > 1) { libNeed.string = true } // emitMemberGet's string arm
        if (nameDesc.fmethod) {
            var mp = []
            mp.push("self")
            for (var i = 0; i < plist.params.length; i++) { mp.push(plist.params[i]) }
            params = mp
        }
        return function(b) {
            var idx = emitFunction(params, bodyT)
            var cl = callExt(b, "js_closure", [handle(idx), curScopeV])
            if (nameDesc.fsteps.length == 0) {
                callExt(b, "js_scope_set_or_create", [curScopeV, emitStr(b, nameDesc.fbase), cl])
                return b
            }
            var o = callExt(b, "js_scope_get", [curScopeV, emitStr(b, nameDesc.fbase)])
            for (var i = 0; i < nameDesc.fsteps.length - 1; i++) {
                var st = emitMemberGet(b, o, emitStr(b, luaNameKey(nameDesc.fsteps[i])), "", nameDesc.fsteps[i], hUndef)
                b = st.b
                o = st.v
            }
            // `function t.f` is the store t.f = function, so a metatable sees it.
            var fname = nameDesc.fsteps[nameDesc.fsteps.length - 1]
            var rawB = curF.NewBlock("")
            var metaB = curF.NewBlock("")
            var doneB = curF.NewBlock("")
            b.NewCondBr(rawTruthy(b, callExt(b, "js_seq", [callExt(b, "js_typeof", [callExt(b, "js_get", [o, emitStr(b, "__f")])]), emitStr(b, "object")])), metaB, rawB)
            callExt(rawB, "js_set", [o, emitStr(rawB, luaNameKey(fname)), cl])
            rawB.NewBr(doneB)
            callExt(metaB, "js_lusetindex", [o, emitStr(metaB, fname), cl])
            metaB.NewBr(doneB)
            return doneB
        }
    }
    function makeLocalFunc(bodyT, plist, name) {
        return function(b) {
            luaLocalScope(b)
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, name), hUndef])
            luaDeclare(name)
            var idx = emitFunction(plist.params, bodyT)
            var cl = callExt(b, "js_closure", [handle(idx), curScopeV])
            callExt(b, "js_scope_set", [curScopeV, emitStr(b, name), cl])
            return b
        }
    }

    // ----- Statement thunks: function(block) -> block -----
    function makeElseIf(suite, cond) { return {elifCond: cond, suite: suite} }
    function makeElse(suite) { return {elseSuite: suite} }
    makeIf = function(items) {
        var cond = items[0]
        var thenT = items[1]
        var elifs = []
        var elseT = null
        for (var i = 2; i < items.length; i++) {
            if (items[i].elifCond != undefined) { elifs.push(items[i]) }
            if (items[i].elseSuite != undefined) { elseT = items[i].elseSuite }
        }
        return function(b) {
            var mergeB = curF.NewBlock("")
            var r = cond(b)
            b = r.b
            var thenB = curF.NewBlock("")
            var nextB = curF.NewBlock("")
            b.NewCondBr(truthy(b, r.v), thenB, nextB)
            thenT(thenB).NewBr(mergeB)
            b = nextB
            for (var k = 0; k < elifs.length; k++) {
                var r2 = elifs[k].elifCond(b)
                b = r2.b
                var armB = curF.NewBlock("")
                var next2 = curF.NewBlock("")
                b.NewCondBr(truthy(b, r2.v), armB, next2)
                elifs[k].suite(armB).NewBr(mergeB)
                b = next2
            }
            if (elseT != null) { elseT(b).NewBr(mergeB) }
            else { b.NewBr(mergeB) }
            return mergeB
        }
    }
    function makeNumFor(items) {
        var name = items[0].fname
        var startT = items[1]
        var limitT = items[2]
        var block = items[items.length - 1]
        var stepT = (items.length == 5) ? items[3] : null
        return function(b) {
            var saved = curScopeV
            curScopeV = callExt(b, "js_scope_new", [curScopeV])
            hidCount++
            var iName = "$fi" + hidCount
            var limName = "$fl" + hidCount
            var stepName = "$fs" + hidCount
            var rs = startT(b)
            b = rs.b
            var startV = callLua(b, "lua_first", [rs.v])
            var rl = limitT(b)
            b = rl.b
            var limV0 = callLua(b, "lua_first", [rl.v])
            var stepV = emitNum(b, 1)
            if (stepT != null) {
                var rst = stepT(b)
                b = rst.b
                stepV = callLua(b, "lua_first", [rst.v])
            }
            // forprep's checks, and a start made a float when the loop runs on floats.
            startV = callExt(b, "js_luforprep", [startV, limV0, stepV])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, iName), startV])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, limName), limV0])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, stepName), stepV])
            // The step is written once, at the head of the loop, and nothing can
            // reassign $fs (the name is unspellable in Lua), so its SIGN is loop
            // invariant: lua_num(step) (a layer-2 call) is computed once here, in the
            // preheader, and used by both tests below.
            var stepPos = truthy(b, callExt(b, "js_gt", [callLua(b, "lua_num", [stepV]), emitNum(b, 0)]))
            var headB = curF.NewBlock("")
            var bodyB = curF.NewBlock("")
            var postB = curF.NewBlock("")
            var exitB = curF.NewBlock("")
            b.NewBr(headB)
            var iV = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, iName)])
            var limV = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, limName)])
            // The three control values keep their number subtype (a float start or step
            // makes the loop variable a float). The two bound tests go through lua_cmp
            // rather than through the raw doubles: a loop that runs near math.maxinteger
            // has to stop on the exact value, not on the rounded one.
            //
            // A branch, not a SELECT: a select evaluates both of its operands, which
            // would call lua_cmp twice per iteration; a branch runs the one test asked for.
            var upB = curF.NewBlock("")
            var downB = curF.NewBlock("")
            var testB = curF.NewBlock("")
            headB.NewCondBr(stepPos, upB, downB)
            var leCond = callLua(upB, "lua_cmp", [handle(2), iV, limV])
            upB.NewBr(testB)
            var geCond = callLua(downB, "lua_cmp", [handle(3), iV, limV])
            downB.NewBr(testB)
            var condH = testB.NewPhi([llvm.ir.NewIncoming(leCond, upB), llvm.ir.NewIncoming(geCond, downB)])
            testB.NewCondBr(truthy(testB, condH), bodyB, exitB)
            // The loop variable is a fresh binding per pass, in a scope of its own that
            // the body's locals share; its parent is the scope outside the loop, so the
            // body reads its upvalues no deeper than it would without one.
            var forScope = curScopeV
            curScopeV = callExt(bodyB, "js_scope_new", [saved])
            callExt(bodyB, "js_scope_decl", [curScopeV, emitStr(bodyB, name), callExt(bodyB, "js_scope_get", [forScope, emitStr(bodyB, iName)])])
            loopStack.push({cont: postB, brk: exitB})
            luaDeclPush(false)
            luaDeclare(name)
            luaOwnTop = true
            luaScopeStamp = funcCount
            block(bodyB).NewBr(postB)
            luaDeclPop()
            loopStack.pop()
            curScopeV = forScope
            var iV2 = callExt(postB, "js_scope_get", [curScopeV, emitStr(postB, iName)])
            var stpV2 = callExt(postB, "js_scope_get", [curScopeV, emitStr(postB, stepName)])
            var nextV = callLua(postB, "lua_arith", [handle(0), iV2, stpV2])
            // The step WRAPS at 64 bits, so a loop
            // whose limit is math.maxinteger would step from it to math.mininteger and
            // run forever. Real Lua cannot: it precomputes the iteration count. The same
            // stop, expressed on the values themselves - a step that does not move the
            // control variable in the step's own direction has overflowed, and the loop
            // is over.
            var upB2 = curF.NewBlock("")
            var downB2 = curF.NewBlock("")
            var testB2 = curF.NewBlock("")
            postB.NewCondBr(stepPos, upB2, downB2)
            var upWrap = callLua(upB2, "lua_cmp", [handle(2), nextV, iV2])
            upB2.NewBr(testB2)
            var downWrap = callLua(downB2, "lua_cmp", [handle(3), nextV, iV2])
            downB2.NewBr(testB2)
            var wrapH = testB2.NewPhi([llvm.ir.NewIncoming(upWrap, upB2), llvm.ir.NewIncoming(downWrap, downB2)])
            var stepB = curF.NewBlock("")
            testB2.NewCondBr(truthy(testB2, wrapH), exitB, stepB)
            callExt(stepB, "js_scope_set", [curScopeV, emitStr(stepB, iName), nextV])
            stepB.NewBr(headB)
            curScopeV = saved
            return exitB
        }
    }
    // repeat body until cond. The body block gets a fresh scope each iteration (so the
    // until condition, evaluated in that scope, sees the body's locals); it loops back
    // while cond is falsy. break -> exit, continue -> the until test.
    function makeRepeat(block, condT) {
        return function(b) {
            var saved = curScopeV
            var bodyB = curF.NewBlock("")
            var contB = curF.NewBlock("")
            var exitB = curF.NewBlock("")
            b.NewBr(bodyB)
            curScopeV = callExt(bodyB, "js_scope_new", [saved])
            loopStack.push({cont: contB, brk: exitB})
            luaDeclPush(false)
            luaDeclShared = true
            luaOwnTop = true
            luaScopeStamp = funcCount
            block(bodyB).NewBr(contB)
            loopStack.pop()
            var r = condT(contB)
            luaDeclPop()
            r.b.NewCondBr(truthy(r.b, r.v), exitB, bodyB)
            curScopeV = saved
            return exitB
        }
    }
    // Generic for, in its full Lua form: the expression list yields the iterator TRIPLE
    // (function, state, initial control value) and every pass calls f(state, control).
    // The loop ends when the first returned value is nil; otherwise that value becomes
    // the next control value and the returned values are bound to the loop names. ipairs
    // and pairs are ordinary library functions returning such a triple, so a hand-written
    // iterator - stateless or a closure - drives the loop exactly the same way.
    // items = [{gname}..., iterExprThunk..., blockThunk]; the block is always last.
    function makeGenFor(items) {
        var names = []
        var exprs = []
        var block = items[items.length - 1]
        for (var i = 0; i < items.length - 1; i++) {
            if (typeof items[i] == "function") { exprs.push(items[i]) }
            else { names.push(items[i].gname) }
        }
        return function(b) {
            var saved = curScopeV
            curScopeV = callExt(b, "js_scope_new", [curScopeV])
            hidCount++
            var fName = "$gf" + hidCount
            var sName = "$gs" + hidCount
            var cName = "$gc" + hidCount
            var ra = emitListArr(b, exprs)
            b = ra.b
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, fName), callExt(b, "js_get", [ra.v, emitNum(b, 0)])])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, sName), callExt(b, "js_get", [ra.v, emitNum(b, 1)])])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, cName), callExt(b, "js_get", [ra.v, emitNum(b, 2)])])
            var headB = curF.NewBlock("")
            var bodyB = curF.NewBlock("")
            var postB = curF.NewBlock("")
            var exitB = curF.NewBlock("")
            b.NewBr(headB)
            var fV = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, fName)])
            var argsV = callExt(headB, "js_arr_new", [])
            callExt(headB, "js_arr_push", [argsV, callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, sName)])])
            callExt(headB, "js_arr_push", [argsV, callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, cName)])])
            headB.NewStore(handle(luaCalleeCode({n: "for iterator", m: false})), gLuaCallee)
            var allV = callLua(headB, "lua_all", [callExt(headB, "js_call", [fV, hUndef, argsV])])
            var firstV = callExt(headB, "js_get", [allV, emitNum(headB, 0)])
            headB.NewCondBr(truthy(headB, callExt(headB, "js_sne", [firstV, hUndef])), bodyB, exitB)
            callExt(bodyB, "js_scope_set", [curScopeV, emitStr(bodyB, cName), firstV])
            // A fresh scope per pass for the loop names, as in makeNumFor.
            var forScope = curScopeV
            curScopeV = callExt(bodyB, "js_scope_new", [saved])
            for (var n2 = 0; n2 < names.length; n2++) {
                callExt(bodyB, "js_scope_decl", [curScopeV, emitStr(bodyB, names[n2]), callExt(bodyB, "js_get", [allV, emitNum(bodyB, n2)])])
            }
            loopStack.push({cont: postB, brk: exitB})
            luaDeclPush(false)
            for (var n3 = 0; n3 < names.length; n3++) { luaDeclare(names[n3]) }
            luaOwnTop = true
            luaScopeStamp = funcCount
            block(bodyB).NewBr(postB)
            luaDeclPop()
            loopStack.pop()
            curScopeV = forScope
            postB.NewBr(headB)
            curScopeV = saved
            return exitB
        }
    }
    // A block scopes its own locals (makeSeq), so do ... end is just its block.
    function makeDoBlock(block) { return block }
    // return e1, e2, ...: all the values travel back as one Lua value (a single one
    // unwrapped, any other count as a multi-value box), the last expression expanding -
    // so 'return f()' propagates everything f returned.
    // `return f(...)` inside a Lua function is a TAIL CALL; in the main chunk there
    // is no frame to take over. The function's frame entry stays in place for the
    // callee, and a function lua_tramp called hands the call back to it, so a chain
    // of tail calls runs at one depth.
    function makeReturn(items, text) {
        var tailT = null
        if (items.length == 1 && lastCallFold !== null && text == "return" + lastCallFold.text) { tailT = lastCallFold.tail }
        return function(b) {
            if (tailT != null && luaFrame != null) {
                var rt = tailT(b)
                var trB = curF.NewBlock("")
                var ownB = curF.NewBlock("")
                rt.b.NewCondBr(luaFrame.tramp, trB, ownB)
                trB.NewStore(handle(1), gLuaTcPend)
                trB.NewRet(rt.v)
                var res = callLua(ownB, "lua_tramp", [rt.v])
                luaLeave(ownB, luaFrame)
                ownB.NewRet(res)
                return deadBlock()
            }
            var ts = items
            var ra = emitListArr(b, ts)
            b = ra.b
            var rv = callLua(b, "lua_mk", [ra.v])
            if (luaFrame != null) { luaLeave(b, luaFrame) }
            b.NewRet(rv)
            return deadBlock()
        }
    }

    // ----- Standard library emission -----
    // Each library function is emitted as its own IR function jsf_N (like a Lua-level
    // function): a fresh scope/function/loop-stack, a body built by bodyEmit(entryBlock,
    // argsHandle) -> {b, v}, and a return. Its handle is wrapped by js_closure at the
    // declaration site so the running program can call it.
    function emitLibFunc(bodyEmit) {
        funcCount++
        var idx = funcCount
        var f = m.NewFunc("jsf_" + idx, i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var savedF = curF
        var savedScope = curScopeV
        var savedLoops = loopStack
        curF = f
        loopStack = []
        var b = f.NewBlock("entry")
        var savedFrame = luaFrame
        luaFrame = null
        // lua.tail is meant for a Lua function's luaEnter; one a library function
        // calls must not mistake itself for the callee of a tail call.
        b.NewStore(handle(0), gLuaTail)
        curScopeV = callExt(b, "js_scope_new", [f.Params[0]])
        var r = bodyEmit(b, f.Params[1])
        r.b.NewRet(r.v)
        luaFrame = savedFrame
        curF = savedF
        curScopeV = savedScope
        loopStack = savedLoops
        return idx
    }
    function libArg(b, argsH, n) { return callExt(b, "js_arg", [argsH, handle(n)]) }

    // math.* and the string library: one extern each over the call's whole ARGUMENT
    // ARRAY (abnf/jsrtlua.go and abnf/jsrtluastr.go; layer 2 over lib/lua-strlib.js),
    // which checks the arguments the way lauxlib does - "got no value" needs the
    // count - and answers the results as one Lua value. The math members have to
    // know the integer subtype: floor/ceil ANSWER an integer, abs/max/min KEEP their
    // argument's, and none may reduce a 64 bit integer to a double on the way
    // through (math.floor(math.maxinteger) would round). The float-only members share
    // js_lumathf, whose second argument is the member's index (a raw handle).
    function libArgsExt(ext) {
        return function(bb, argsH) { return {b: bb, v: callExt(bb, ext, [argsH])} }
    }
    function libMathF(op) {
        return function(bb, argsH) { return {b: bb, v: callExt(bb, "js_lumathf", [argsH, handle(op)])} }
    }

    // string.find and string.match share one extern.
    function libFind(find) {
        return function(bb, argsH) { return {b: bb, v: callExt(bb, "js_lufind", [argsH, find ? hTrue : hFalse])} }
    }
    // gmatch answers an iterator closing over the iteration state.
    function libGmatch(bb, argsH) {
        var sc = callExt(bb, "js_scope_new", [curScopeV])
        callExt(bb, "js_scope_decl", [sc, emitStr(bb, "0gm"), callExt(bb, "js_lugmatch", [argsH])])
        return {b: bb, v: callExt(bb, "js_closure", [handle(emitLibFunc(libGmatchNext)), sc])}
    }
    function libGmatchNext(bb, argsH) {
        return {b: bb, v: callExt(bb, "js_lugmatchnext", [callExt(bb, "js_scope_get", [curScopeV, emitStr(bb, "0gm")])])}
    }

    // tostring(v) and type(v): luaL_checkany, then the value's rendering or its type
    // name. A table or a function renders by type name (lua_str).
    function libToString(bb, argsH) {
        callLua(bb, "lua_needany", [argsH, emitNum(bb, 1), emitStr(bb, "tostring")])
        return {b: bb, v: callLua(bb, "lua_str", [libArg(bb, argsH, 0)])}
    }
    function libType(bb, argsH) {
        callLua(bb, "lua_needany", [argsH, emitNum(bb, 1), emitStr(bb, "type")])
        return {b: bb, v: callExt(bb, "js_lutypeof", [libArg(bb, argsH, 0)])}
    }

    // ipairs(t) / pairs(t): both answer the iterator triple the generic for consumes.
    // ipairs walks 1, 2, 3, ... and stops at the first nil element; pairs walks the
    // table's own keys in insertion order (js_keys, deterministic across engines) and
    // skips the ones whose value is nil, binding a numeric key as the number it
    // was stored as (js_lukeyback).
    // ipairs' iterator is stateless (its control value is the index), pairs' is a closure
    // over a cursor cell - the loop feeds the control value back either way.
    function libINext(bb, argsH) {
        var t = libArg(bb, argsH, 0)
        var nk = callExt(bb, "js_add", [libArg(bb, argsH, 1), emitNum(bb, 1)])
        var rawV = callExt(bb, "js_get", [t, nk])
        var nilB = curF.NewBlock("")
        var okB = curF.NewBlock("")
        bb.NewCondBr(truthy(bb, callExt(bb, "js_seq", [rawV, hUndef])), nilB, okB)
        // A raw miss on a table with a metatable asks its __index, as lua_geti does.
        var objB = curF.NewBlock("")
        var mtB = curF.NewBlock("")
        var endB = curF.NewBlock("")
        nilB.NewCondBr(rawTruthy(nilB, callExt(nilB, "js_seq", [callExt(nilB, "js_typeof", [t]), emitStr(nilB, "object")])), objB, endB)
        objB.NewCondBr(rawTruthy(objB, callExt(objB, "js_seq", [callExt(objB, "js_typeof", [callExt(objB, "js_get", [t, emitStr(objB, "__f")])]), emitStr(objB, "object")])), mtB, endB)
        var mv = callExt(mtB, "js_luindex", [t, nk])
        mtB.NewCondBr(truthy(mtB, callExt(mtB, "js_seq", [mv, hUndef])), endB, okB)
        endB.NewRet(hUndef)
        var v = okB.NewPhi([llvm.ir.NewIncoming(rawV, bb), llvm.ir.NewIncoming(mv, mtB)])
        var arr = callExt(okB, "js_arr_new", [])
        callExt(okB, "js_arr_push", [arr, nk])
        callExt(okB, "js_arr_push", [arr, v])
        okB.NewRet(callLua(okB, "lua_mk", [arr]))
        return {b: deadBlock(), v: hUndef}
    }
    function libIpairs(bb, argsH) {
        callLua(bb, "lua_needany", [argsH, emitNum(bb, 1), emitStr(bb, "ipairs")])
        var t = libArg(bb, argsH, 0)
        var arr = callExt(bb, "js_arr_new", [])
        callExt(bb, "js_arr_push", [arr, callExt(bb, "js_closure", [handle(emitLibFunc(libINext)), curScopeV])])
        callExt(bb, "js_arr_push", [arr, t])
        callExt(bb, "js_arr_push", [arr, emitNum(bb, 0)])
        return {b: bb, v: callLua(bb, "lua_mk", [arr])}
    }
    // The cursor of a pairs walk: {t, k (the key array), i}. Its iterator ignores the
    // control value the loop hands back and advances the cursor itself.
    function libPNext(bb, argsH) {
        var st = libArg(bb, argsH, 0)
        var tV = callExt(bb, "js_get", [st, emitStr(bb, "t")])
        var kV = callExt(bb, "js_get", [st, emitStr(bb, "k")])
        var nV = callExt(bb, "js_get", [kV, emitStr(bb, "length")])
        var headB = curF.NewBlock("")
        var bodyB = curF.NewBlock("")
        var hitB = curF.NewBlock("")
        var skipB = curF.NewBlock("")
        var endB = curF.NewBlock("")
        bb.NewBr(headB)
        var iV = callExt(headB, "js_get", [st, emitStr(headB, "i")])
        headB.NewCondBr(truthy(headB, callExt(headB, "js_lt", [iV, nV])), bodyB, endB)
        var iV2 = callExt(bodyB, "js_get", [st, emitStr(bodyB, "i")])
        var keyV = callExt(bodyB, "js_get", [kV, iV2])
        var valV = callExt(bodyB, "js_get", [tV, keyV])
        var progKeyV = callExt(bodyB, "js_lukeyback", [keyV])
        callExt(bodyB, "js_set", [st, emitStr(bodyB, "i"), callExt(bodyB, "js_add", [iV2, emitNum(bodyB, 1)])])
        bodyB.NewCondBr(truthy(bodyB, callExt(bodyB, "js_sne", [valV, hUndef])), hitB, skipB)
        skipB.NewBr(headB)
        var parr = callExt(hitB, "js_arr_new", [])
        callExt(hitB, "js_arr_push", [parr, progKeyV])
        callExt(hitB, "js_arr_push", [parr, valV])
        hitB.NewRet(callLua(hitB, "lua_mk", [parr]))
        endB.NewRet(hUndef)
        return {b: deadBlock(), v: hUndef}
    }
    // lua 5.5's pairs answers four values, the last one nil (a closing value).
    // pairs of a value that is not a table answers next and the value, as lua does,
    // so the error surfaces where the loop calls the iterator.
    function libPairs(bb, argsH) {
        callLua(bb, "lua_needany", [argsH, emitNum(bb, 1), emitStr(bb, "pairs")])
        var t = libArg(bb, argsH, 0)
        var tabB = curF.NewBlock("")
        var otherB = curF.NewBlock("")
        bb.NewCondBr(rawTruthy(bb, callExt(bb, "js_seq", [callExt(bb, "js_lutypeof", [t]), emitStr(bb, "table")])), tabB, otherB)
        var oarr = callExt(otherB, "js_arr_new", [])
        callExt(otherB, "js_arr_push", [oarr, callExt(otherB, "js_closure", [handle(emitLibFunc(libArgsExt("js_lunext"))), curScopeV])])
        callExt(otherB, "js_arr_push", [oarr, t])
        callExt(otherB, "js_arr_push", [oarr, hUndef])
        callExt(otherB, "js_arr_push", [oarr, hUndef])
        otherB.NewRet(callLua(otherB, "lua_mk", [oarr]))
        // A __pairs metamethod answers the iterator triple itself: its first three
        // results.
        var pmB = curF.NewBlock("")
        var plainB = curF.NewBlock("")
        var pm = callExt(tabB, "js_lutm", [handle(20), t, t])
        tabB.NewCondBr(tabB.NewICmp(llvm.enum.IPredEQ, pm, hUndef), plainB, pmB)
        var pargs = callExt(pmB, "js_arr_new", [])
        callExt(pmB, "js_arr_push", [pargs, t])
        var pall = callLua(pmB, "lua_all", [callExt(pmB, "js_call", [pm, hUndef, pargs])])
        var three = callExt(pmB, "js_arr_new", [])
        for (var pi = 0; pi < 3; pi++) { callExt(pmB, "js_arr_push", [three, libArg(pmB, pall, pi)]) }
        pmB.NewRet(callLua(pmB, "lua_mk", [three]))
        tabB = plainB
        var st = callExt(tabB, "js_obj_new", [])
        callExt(tabB, "js_set", [st, emitStr(tabB, "t"), t])
        callExt(tabB, "js_set", [st, emitStr(tabB, "k"), callExt(tabB, "js_keys", [t])])
        callExt(tabB, "js_set", [st, emitStr(tabB, "i"), emitNum(tabB, 0)])
        var arr = callExt(tabB, "js_arr_new", [])
        callExt(tabB, "js_arr_push", [arr, callExt(tabB, "js_closure", [handle(emitLibFunc(libPNext)), curScopeV])])
        callExt(tabB, "js_arr_push", [arr, st])
        callExt(tabB, "js_arr_push", [arr, hUndef])
        callExt(tabB, "js_arr_push", [arr, hUndef])
        return {b: tabB, v: callLua(tabB, "lua_mk", [arr])}
    }

    // error(v [, level]): throw v, a string first prefixed with the position of
    // `level` (lua_whereat). Any other value travels unchanged. Twin of
    // globalScope["error"] in lua-interpreter.abnf.
    function libError(bb, argsH) {
        var v = libArg(bb, argsH, 0)
        var lvH = callLua(bb, "lua_errlevel", [libArg(bb, argsH, 1)])
        var strB = curF.NewBlock("")
        var plainB = curF.NewBlock("")
        bb.NewCondBr(rawTruthy(bb, callExt(bb, "js_seq", [callExt(bb, "js_typeof", [v]), emitStr(bb, "string")])), strB, plainB)
        callExt(strB, "js_throw", [callExt(strB, "js_add", [callLua(strB, "lua_whereat", [lvH]), v])])
        strB.NewRet(hUndef)
        callExt(plainB, "js_throw", [v])
        return {b: plainB, v: hUndef}
    }
    // pcall(f, ...) / xpcall(f, msgh, ...): call f in protected mode - true and its
    // results, or false and the error object (through msgh first, for xpcall). The
    // call runs in a js_try whose two clauses are closures over a scope holding f,
    // its arguments and the handler. pcall is a frame with no position: it pushes
    // its caller's and runs f with lua.pos -1, and it restores both after the
    // js_try, because a throw skips every frame's own restore. Twin of luaProtect
    // in lua-interpreter.abnf.
    function libProtect(withHandler) {
        return function(bb, argsH) {
            var nargs = callExt(bb, "js_get", [argsH, emitStr(bb, "length")])
            var fewB = curF.NewBlock("")
            var okB = curF.NewBlock("")
            var need = withHandler ? 2 : 1
            if (withHandler) {
                // xpcall checks only the handler, which has to be a function
                // (luaB_xpcall).
                var hv = libArg(bb, argsH, 1)
                bb.NewCondBr(rawTruthy(bb, callExt(bb, "js_seq", [callExt(bb, "js_typeof", [hv]), emitStr(bb, "function")])), okB, fewB)
                var got = fewB.NewSelect(rawTruthy(fewB, callExt(fewB, "js_lt", [nargs, emitNum(fewB, 2)])),
                                         emitStr(fewB, "no value"), callExt(fewB, "js_lutname", [hv]))
                callLua(fewB, "lua_argerr", [emitNum(fewB, 2), emitStr(fewB, "xpcall"),
                                             callExt(fewB, "js_add", [emitStr(fewB, "function expected, got "), got])])
            } else {
                bb.NewCondBr(rawTruthy(bb, callExt(bb, "js_lt", [nargs, emitNum(bb, 1)])), fewB, okB)
                callLua(fewB, "lua_argerr", [emitNum(fewB, 1), emitStr(fewB, "pcall"), emitStr(fewB, "value expected")])
            }
            fewB.NewRet(hUndef)
            var b = okB
            var fr = luaEnter(b, false)
            b.NewStore(handle(0 - 1), gLuaPos)
            var sc = callExt(b, "js_scope_new", [curScopeV])
            callExt(b, "js_scope_decl", [sc, emitStr(b, "f"), libArg(b, argsH, 0)])
            callExt(b, "js_scope_decl", [sc, emitStr(b, "a"), callLua(b, "lua_tail", [argsH, emitNum(b, need)])])
            if (withHandler) { callExt(b, "js_scope_decl", [sc, emitStr(b, "h"), libArg(b, argsH, 1)]) }
            var tryClo = callExt(b, "js_closure", [handle(emitLibFunc(libProtectTry)), sc])
            var catchClo = callExt(b, "js_closure", [handle(emitLibFunc(libProtectCatch(withHandler))), sc])
            var res = callExt(b, "js_try", [tryClo, catchClo, hUndef])
            luaLeave(b, fr)
            // A throw between a tail call and its callee's luaEnter leaves lua.tail set.
            b.NewStore(handle(0), gLuaTail)
            return {b: b, v: res}
        }
    }
    function libProtectTry(bb, argsH) {
        var envV = curScopeV
        bb.NewStore(handle(0), gLuaCallee)
        var r = callExt(bb, "js_call", [callExt(bb, "js_scope_get", [envV, emitStr(bb, "f")]), hUndef,
                                        callExt(bb, "js_scope_get", [envV, emitStr(bb, "a")])])
        var arr = callExt(bb, "js_arr_new", [])
        callExt(bb, "js_arr_push", [arr, hTrue])
        callLua(bb, "lua_appendall", [arr, r])
        return {b: bb, v: callLua(bb, "lua_mk", [arr])}
    }
    function libHandlerCall(bb, argsH) {
        var hargs = callExt(bb, "js_arr_new", [])
        callExt(bb, "js_arr_push", [hargs, callExt(bb, "js_scope_get", [curScopeV, emitStr(bb, "e")])])
        bb.NewStore(handle(0), gLuaCallee)
        return {b: bb, v: callLua(bb, "lua_first", [callExt(bb, "js_call", [callExt(bb, "js_scope_get", [curScopeV, emitStr(bb, "h")]), hUndef, hargs])])}
    }
    function libHandlerFail(bb, argsH) { return {b: bb, v: emitStr(bb, "error in error handling")} }
    function libProtectCatch(withHandler) {
        return function(bb, argsH) {
            var ev = callLua(bb, "lua_errval", [libArg(bb, argsH, 0)])
            if (withHandler) {
                // The handler runs in a js_try of its own: an error inside it is
                // lua's LUA_ERRERR, whose error object is a fixed text. Twin of
                // luaHandle in lua-interpreter.abnf.
                var hs = callExt(bb, "js_scope_new", [curScopeV])
                callExt(bb, "js_scope_decl", [hs, emitStr(bb, "e"), ev])
                ev = callExt(bb, "js_try", [callExt(bb, "js_closure", [handle(emitLibFunc(libHandlerCall)), hs]),
                                            callExt(bb, "js_closure", [handle(emitLibFunc(libHandlerFail)), hs]), hUndef])
            }
            // lua 5.5 reports a nil error object as this string.
            ev = bb.NewSelect(rawTruthy(bb, callExt(bb, "js_seq", [ev, hUndef])), emitStr(bb, "<no error object>"), ev)
            var arr = callExt(bb, "js_arr_new", [])
            callExt(bb, "js_arr_push", [arr, hFalse])
            callExt(bb, "js_arr_push", [arr, ev])
            return {b: bb, v: callLua(bb, "lua_mk", [arr])}
        }
    }

    // libSet wires one closure into a library table field; libDecl binds a table (or a
    // bare function) into jsmain's scope under its global name.
    function libSet(b, obj, name, idx) {
        callExt(b, "js_set", [obj, emitStr(b, name), callExt(b, "js_closure", [handle(idx), curScopeV])])
        return b
    }
    // Emit only the referenced libraries; a program that uses none emits nothing here.
    function emitLibs(b) {
        if (libNeed.getmetatable) { libNeed.string = true } // getmetatable("") is the strings' metatable
        if (libNeed.error) {
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "error"), callExt(b, "js_closure", [handle(emitLibFunc(libError)), curScopeV])])
        }
        if (libNeed.pcall) {
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "pcall"), callExt(b, "js_closure", [handle(emitLibFunc(libProtect(false))), curScopeV])])
        }
        if (libNeed.xpcall) {
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "xpcall"), callExt(b, "js_closure", [handle(emitLibFunc(libProtect(true))), curScopeV])])
        }
        if (libNeed.ipairs) {
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "ipairs"), callExt(b, "js_closure", [handle(emitLibFunc(libIpairs)), curScopeV])])
        }
        if (libNeed.pairs) {
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "pairs"), callExt(b, "js_closure", [handle(emitLibFunc(libPairs)), curScopeV])])
        }
        if (libNeed.select) {
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "select"), callExt(b, "js_closure", [handle(emitLibFunc(libArgsExt("js_luselect"))), curScopeV])])
        }
        // The base library members that are one extern each (abnf/jsrtlutab.go, layer 2
        // in lib/lua-rt.metajs).
        var baseExt = [["next", "js_lunext"], ["tonumber", "js_lutonumber"], ["assert", "js_luassert"],
                       ["rawequal", "js_lurawequal"], ["rawget", "js_lurawget"], ["rawset", "js_lurawset"],
                       ["rawlen", "js_lurawlen"], ["setmetatable", "js_lusetmt"], ["getmetatable", "js_lugetmt"]]
        for (var bi = 0; bi < baseExt.length; bi++) {
            if (libNeed[baseExt[bi][0]]) {
                callExt(b, "js_scope_decl", [curScopeV, emitStr(b, baseExt[bi][0]), callExt(b, "js_closure", [handle(emitLibFunc(libArgsExt(baseExt[bi][1]))), curScopeV])])
            }
        }
        if (libNeed.tostring) {
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "tostring"), callExt(b, "js_closure", [handle(emitLibFunc(libToString)), curScopeV])])
        }
        if (libNeed.type) {
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "type"), callExt(b, "js_closure", [handle(emitLibFunc(libType)), curScopeV])])
        }
        if (libNeed.utf8) {
            // utf8: one extern each over the argument array (abnf/jsrtluastr.go,
            // layer 2 over lib/lua-strlib.js); charpattern is a string value.
            var ut = callExt(b, "js_obj_new", [])
            b = libSet(b, ut, "char", emitLibFunc(libArgsExt("js_luutf8char")))
            b = libSet(b, ut, "len", emitLibFunc(libArgsExt("js_luutf8len")))
            b = libSet(b, ut, "codepoint", emitLibFunc(libArgsExt("js_luutf8cp")))
            b = libSet(b, ut, "offset", emitLibFunc(libArgsExt("js_luutf8off")))
            b = libSet(b, ut, "codes", emitLibFunc(libUtf8Codes))
            var cps = "[" + String.fromCharCode(0) + "-" + String.fromCharCode(127) + String.fromCharCode(194) + "-" +
                      String.fromCharCode(253) + "][" + String.fromCharCode(128) + "-" + String.fromCharCode(191) + "]*"
            callExt(b, "js_set", [ut, emitStr(b, "charpattern"), emitStr(b, cps)])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "utf8"), ut])
        }
        if (libNeed.coroutine) {
            var cot = callExt(b, "js_obj_new", [])
            var resumeClo = callExt(b, "js_closure", [handle(emitLibFunc(libCoResume)), curScopeV])
            callExt(b, "js_set", [cot, emitStr(b, "resume"), resumeClo])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "0coresume"), resumeClo])
            b = libSet(b, cot, "create", emitLibFunc(libCoCreate))
            b = libSet(b, cot, "yield", emitLibFunc(libCoYield))
            b = libSet(b, cot, "status", emitLibFunc(libCoStatus))
            b = libSet(b, cot, "running", emitLibFunc(libCoRunning))
            b = libSet(b, cot, "isyieldable", emitLibFunc(libCoYieldable))
            b = libSet(b, cot, "wrap", emitLibFunc(libCoWrap))
            b = libSet(b, cot, "close", emitLibFunc(libCoClose))
            // The main thread, which running() answers outside every coroutine.
            var mainTh = callExt(b, "js_obj_new", [])
            callExt(b, "js_set", [mainTh, emitStr(b, "__luco"), hTrue])
