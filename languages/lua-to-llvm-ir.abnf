            // lua.c's msghandler: a string or a number is the message, anything
            // else is named by its type. Twin of luaErrText in lua-interpreter.abnf.
            var strB = curF.NewBlock("")
            var notStrB = curF.NewBlock("")
            var numB = curF.NewBlock("")
            var otherB = curF.NewBlock("")
            b.NewCondBr(rawTruthy(b, callExt(b, "js_seq", [callExt(b, "js_typeof", [ps[0]]), emitStr(b, "string")])), strB, notStrB)
            strB.NewRet(ps[0])
            notStrB.NewCondBr(rawTruthy(notStrB, callLua(notStrB, "lua_isnum", [ps[0]])), numB, otherB)
            numB.NewRet(callLua(numB, "lua_str", [ps[0]]))
            otherB.NewRet(callExt(otherB, "js_add", [callExt(otherB, "js_add", [emitStr(otherB, "(error object is a "), callExt(otherB, "js_lutname", [ps[0]])]), emitStr(otherB, " value)")]))
