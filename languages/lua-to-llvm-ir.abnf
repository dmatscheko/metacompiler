    // its subtype apart from 1 all the way to the concatenation that renders it, and an
    // integer literal is read from its digits by js_lulit so that it is exact to 64 bits.
    // A SMALL decimal integer skips the call and goes in as a plain number - which is
    // every literal an ordinary program writes, so the emitted IR is unchanged there.
    var coreMakeConst = makeConst
    makeConst = function(v) {
        if (isILit(v)) {
            var d = v.d
            var radix = v.r
            if (radix == 10 && d.length <= 15) { return coreMakeConst(parseFloat(d)) }
            return function(b) {
                return {b: b, v: callExt(b, "js_lulit", [emitStr(b, d), emitNum(b, radix)])}
            }
        }
        if (!isFlt(v)) { return coreMakeConst(v) }
        var n = v.v
        return function(b) {
            var o = callExt(b, "js_obj_new", [])
            callExt(b, "js_set", [o, emitStr(b, "__f"), emitNum(b, n)])
            return {b: b, v: o}
        }
    }

    // ----- Lua strings are BYTE strings -----
    // A Lua string is a counted sequence of BYTES, not of characters: real Lua answers 6
    // for #"hello" spelled with an e-acute. The runtime string type is UTF-16, so a Lua
    // string is held with ONE CHARACTER PER BYTE (every code unit is 0..255) and #,
    // string.len, string.sub, string.rep and the relational operators all measure and cut
    // in bytes for free. utf8Enc/luaUtf8 encode source text and \u{...} on the way IN;
    // the js_luaout extern decodes on the way OUT, at print. lua-interpreter.abnf carries
    // exactly the same pair.
    function utf8Enc(cp) {
        if (cp < 128) { return String.fromCharCode(cp) }
        if (cp < 2048) {
            return String.fromCharCode(192 + Math.floor(cp / 64)) + String.fromCharCode(128 + cp % 64)
        }
        if (cp < 65536) {
            return String.fromCharCode(224 + Math.floor(cp / 4096))
                 + String.fromCharCode(128 + Math.floor(cp / 64) % 64)
                 + String.fromCharCode(128 + cp % 64)
        }
        return String.fromCharCode(240 + Math.floor(cp / 262144))
             + String.fromCharCode(128 + Math.floor(cp / 4096) % 64)
             + String.fromCharCode(128 + Math.floor(cp / 64) % 64)
             + String.fromCharCode(128 + cp % 64)
    }
    function luaUtf8(s) {
        var out = ""
        var i = 0
        while (i < s.length) {
            var c = s.charCodeAt(i)
            if (c >= 55296 && c < 56320 && i + 1 < s.length) {
                var lo = s.charCodeAt(i + 1)
                if (lo >= 56320 && lo < 57344) {
                    out = out + utf8Enc(65536 + (c - 55296) * 1024 + (lo - 56320))
                    i = i + 2
                    continue
                }
            }
            out = out + utf8Enc(c)
            i = i + 1
        }
        return out
    }

    // ----- String escapes -----
    // Lua's own set: the single letters a b f n r t v, a decimal byte of up to three
    // digits, xNN, u{...} (a code point), a real line break (which stands for a newline)
    // and z (which swallows the whitespace run behind it).
    function luaUnesc(s) {
        var out = ""
        var i = 0
        while (i < s.length) {
            var cc = s.charCodeAt(i)
            // Literal text is UTF-8 encoded into the byte string; the escapes below that
            // name a BYTE (\xNN, \ddd) are already one host character each.
            if (cc !== 92) {
                if (cc < 128) { out = out + String.fromCharCode(cc); i = i + 1; continue }
                if (cc >= 55296 && cc < 56320 && i + 1 < s.length) {
                    var lo2 = s.charCodeAt(i + 1)
                    if (lo2 >= 56320 && lo2 < 57344) {
                        out = out + utf8Enc(65536 + (cc - 55296) * 1024 + (lo2 - 56320))
                        i = i + 2
                        continue
                    }
                }
                out = out + utf8Enc(cc)
                i = i + 1
                continue
            }
            var e = s.charCodeAt(i + 1)
            if (e === 110) { out = out + String.fromCharCode(10); i = i + 2; continue }
            if (e === 116) { out = out + String.fromCharCode(9);  i = i + 2; continue }
            if (e === 114) { out = out + String.fromCharCode(13); i = i + 2; continue }
            if (e === 97)  { out = out + String.fromCharCode(7);  i = i + 2; continue }
            if (e === 98)  { out = out + String.fromCharCode(8);  i = i + 2; continue }
            if (e === 102) { out = out + String.fromCharCode(12); i = i + 2; continue }
            if (e === 118) { out = out + String.fromCharCode(11); i = i + 2; continue }
            if (e === 10)  { out = out + String.fromCharCode(10); i = i + 2; continue }
            if (e === 13) {
                out = out + String.fromCharCode(10)
                i = i + 2
                if (i < s.length && s.charCodeAt(i) === 10) { i = i + 1 }
                continue
            }
            if (e === 122) {
                i = i + 2
                while (i < s.length && isSpaceCode(s.charCodeAt(i))) { i = i + 1 }
                continue
            }
            if (e === 120 || e === 88) {
                var hv = 0
                var hn = 0
                i = i + 2
                while (hn < 2 && i < s.length && hexDigit(s.charCodeAt(i)) >= 0) {
                    hv = hv * 16 + hexDigit(s.charCodeAt(i))
                    i = i + 1
                    hn = hn + 1
                }
                out = out + String.fromCharCode(hv)
                continue
            }
            if (e === 117) {
                var uv = 0
                i = i + 2
                if (i < s.length && s.charCodeAt(i) === 123) { i = i + 1 }
                while (i < s.length && hexDigit(s.charCodeAt(i)) >= 0) { uv = uv * 16 + hexDigit(s.charCodeAt(i)); i = i + 1 }
                if (i < s.length && s.charCodeAt(i) === 125) { i = i + 1 }
                // \u{...} names a CODE POINT and Lua writes its UTF-8 encoding.
                out = out + utf8Enc(uv)
                continue
            }
            if (e >= 48 && e <= 57) {
