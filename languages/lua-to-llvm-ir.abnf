    // the name an argument error reports: a method's own name, the field a call
    // reads its function from, or the variable the chain starts with (`first`);
    // null where there is none. Twin of luaCalleeNames in lua-interpreter.abnf.
    function luaCalleeNames(first, suffixes) {
        var out = []
        for (var i = 0; i < suffixes.length; i++) {
            var st = suffixes[i]
            var nm = anytype
            nm = null
            if (st.kind == "method") { nm = {n: st.name, m: true} }
            else if (st.kind == "call") {
                if (i == 0 && first !== null) { nm = {n: first, m: false} }
                else if (i > 0 && suffixes[i - 1].kind == "field") { nm = {n: suffixes[i - 1].name, m: false} }
            }
            out.push(nm)
        }
        return out
    }
    // The variable a chain's source text starts with, or null when it starts with
    // anything else (a parenthesis, a literal).
    function luaLeadName(text) {
        var c0 = text.length > 0 ? text.charCodeAt(0) : 0
        if (!((c0 >= 65 && c0 <= 90) || (c0 >= 97 && c0 <= 122) || c0 === 95)) { return null }
        var i = 1
        while (i < text.length) {
            var c = text.charCodeAt(i)
            if (!((c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c === 95)) { break }
            i = i + 1
        }
        return text.substring(0, i)
    }
    // items = [primaryThunk, {kind:"call"|"field"|"index", ...}...]. A chain that ends
    // in a call is built twice, the second time as the tail call makeReturn
    // substitutes. Twin of foldCallMember in lua-interpreter.abnf; see there.
    var lastCallFold = null
    foldCallMember = function(items, text) {
        if (items.length == 1) { return items[0] }
        var primary = items[0]
        var suffixes = items.slice(1)
        var last = suffixes.length - 1
        // Any member access can land on a string, and then it resolves through the string
        // metatable (emitMemberGet), so the library table has to exist.
        for (var q = 0; q < suffixes.length; q++) {
            if (suffixes[q].kind != "call") { libNeed.string = true }
        }
        var cnames = luaCalleeNames(luaLeadName(text), suffixes)
        var pdescs = luaPrefixDescs(luaChainFirst(text), suffixes)
        var mk = function(tail) {
            return function(b) {
                var r = primary(b)
                b = r.b
                var cur = r.v
                var afterCall = false
                for (var i = 0; i < suffixes.length; i++) {
                    var st = emitLuaStep(b, cur, suffixes[i], afterCall, tail && i === last, cnames[i], pdescs[i])
                    b = st.b
                    cur = st.v
                    afterCall = st.call
                }
                return {b: b, v: cur}
            }
        }
        var t = mk(false)
        if (suffixes[last].kind == "call" || suffixes[last].kind == "method") { lastCallFold = {text: text, tail: mk(true)} }
        return t
    }

    // { ... } fields, in source order: positional fields fill numeric keys 1, 2, 3, ...
    function makeTable(items) {
        var lastPos = 0 - 1
        for (var k = 0; k < items.length; k++) { if (items[k].fkind == "pos") { lastPos = k } }
        return function(b) {
            var t = callExt(b, "js_obj_new", [])
            var pos = 1
            for (var i = 0; i < items.length; i++) {
                var f = items[i]
                if (f.fkind == "pos") {
                    var rv = f.v(b)
                    b = rv.b
                    if (i === lastPos) {
                        // The last positional field expands a multi-value into as many
                        // entries as it has values, so {f()} collects everything f gave.
                        b = emitSpreadInto(b, t, emitNum(b, pos), rv.v)
                    } else {
                        callExt(b, "js_set", [t, emitNum(b, pos), callLua(b, "lua_first", [rv.v])])
