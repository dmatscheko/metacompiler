    function mkFlt(n) { if (n - n === 0 && Math.floor(n) === n) { return {__f: true, v: n} } return n }
    function isSpaceCode(cc) { return cc === 32 || cc === 9 || cc === 10 || cc === 13 }
    function hexDigit(cc) {
        if (cc >= 48 && cc <= 57) { return cc - 48 }
        if (cc >= 97 && cc <= 102) { return cc - 87 }
        if (cc >= 65 && cc <= 70) { return cc - 55 }
        return -1
    }
    function luaNumVal(s) {
        var i = 0
        var n = s.length
        while (i < n && isSpaceCode(s.charCodeAt(i))) { i = i + 1 }
        while (n > i && isSpaceCode(s.charCodeAt(n - 1))) { n = n - 1 }
        var neg = false
        if (i < n && (s.charCodeAt(i) === 43 || s.charCodeAt(i) === 45)) {
            neg = s.charCodeAt(i) === 45
            i = i + 1
        }
        if (i >= n) { return undefined }
        var r = anytype // An integer (a plain number) or a float (possibly boxed).
        if (s.charCodeAt(i) === 48 && i + 1 < n && (s.charCodeAt(i + 1) === 120 || s.charCodeAt(i + 1) === 88)) {
            r = luaHexNum(s, i + 2, n)
        } else {
            r = luaDecNum(s, i, n)
        }
        if (r === undefined) { return undefined }
        if (!neg) { return r }
        if (isFlt(r)) { return mkFlt(0 - r.v) }
