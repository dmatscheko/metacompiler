    // Concatenation: right associative, so at most two operands per node. Each side
    // becomes a string through lua_catstr and js_add joins the two.
    function makeConcat(items) {
        if (items.length == 1) { return items[0] }
        var l = items[0]
        var r = items[1]
        return function(b) {
            var rl = l(b)
            b = rl.b
            var rr = r(b)
            b = rr.b
            var lv = callLua(b, "lua_first", [rl.v])
            var rv = callLua(b, "lua_first", [rr.v])
            var ls = callLua(b, "lua_catstr", [lv, emitNum(b, 1), lv, rv])
            var rs = callLua(b, "lua_catstr", [rv, emitNum(b, 2), lv, rv])
            // A nil side means the pair has a __concat (lua_catstr).
            var catB = curF.NewBlock("")
            var tmB = curF.NewBlock("")
            var joinB = curF.NewBlock("")
            b.NewCondBr(b.NewOr(b.NewICmp(llvm.enum.IPredEQ, ls, hUndef), b.NewICmp(llvm.enum.IPredEQ, rs, hUndef)), tmB, catB)
            var sv = callExt(catB, "js_add", [ls, rs])
            catB.NewBr(joinB)
            var tv = callLua(tmB, "lua_metabin", [handle(14), lv, rv])
            tmB.NewBr(joinB)
            return {b: joinB, v: joinB.NewPhi([llvm.ir.NewIncoming(sv, catB), llvm.ir.NewIncoming(tv, tmB)])}
        }
    }

    // Lua operators: no 32 bit wrapping, floor division //, floor modulo %, ~= not equal.
    // Every binary operator goes through the value model rather than straight to an
    // external: the arithmetic has to know the two number subtypes and to coerce a
    // string operand, and the comparisons have to see through a float box.
    //
    // The bitwise operators are 64 bit in Lua and integer-only, so all five go to
    // js_lubit (abnf/jsrtlua.go), which is exact and raises Lua's own two errors -
    // not to the runtime's 32-bit externals, and NOT through lua_num, whose double
    // reading is exactly the precision the operator is supposed to keep.
    binExt = {}
    wraps = {}
    var arithCode = {"+": 0, "-": 1, "*": 2, "/": 3, "//": 4, "%": 5}
    var bitCode = {"&": 0, "|": 1, "~": 2, "<<": 3, ">>": 4}
    var cmpCode = {"<": 0, ">": 1, "<=": 2, ">=": 3}
    emitBin = function(b, op, l, r) {
        if (bitCode[op] != undefined) { return callExt(b, "js_lubit", [handle(bitCode[op]), l, r]) }
        if (op == "==") { return callLua(b, "lua_eq", [l, r]) }
        if (op == "~=") { return callExt(b, "js_not", [callLua(b, "lua_eq", [l, r])]) }
        if (cmpCode[op] != undefined) { return callLua(b, "lua_cmp", [handle(cmpCode[op]), l, r]) }
        return callLua(b, "lua_arith", [handle(arithCode[op]), l, r])
    }

    // ONE suffix step of a prefixexp, emitted. `pre` says whether the value coming in is a
    // possible multi-value (it is exactly after a call), in which case it is truncated
    // first. Shared by the expression folder below and by emitTargetSlot, which is what
    // makes `getmetatable(t).__index = f` emit exactly the chain `getmetatable(t).__index`
    // reads. Answers {b, v, call} - `call` is the next step's `pre`.
    // A call step with `tail` set is the call of `return f(...)`: lua.tail tells the
    // callee's luaEnter to take over this frame.
    // `pd` is the descriptor of the value the step works on (luaPrefixDescs).
    function emitLuaStep(b, cur, s, pre, tail, cname, pd) {
        var v = cur
        if (pre) { v = callLua(b, "lua_first", [v]) } // Only one value feeds a step.
        var sfx = luaDescText(pd)
        if (s.kind == "call") {
            var ea = emitListArr(b, s.args)
            b = ea.b
            b.NewStore(handle(s.at.code), gLuaPos)
            b.NewStore(handle(luaCalleeCode(cname, sfx)), gLuaCallee)
            return {b: b, v: luaCallTail(b, tail, v, ea.v), call: true}
        }
        if (s.kind == "method") {
            // obj:m(args): look up m on the receiver, then call it with the
            // receiver prepended as the first argument (self).
            b.NewStore(handle(s.at.code), gLuaPos)
            var mr = emitMemberGet(b, v, emitStr(b, luaNameKey(s.name)), sfx, s.name, hUndef)
            b = mr.b
            var fn = mr.v
            var margs = callExt(b, "js_arr_new", [])
            callExt(b, "js_arr_push", [margs, v])
            var ma = emitListArr(b, s.args)
            b = ma.b
            b = emitArrExtend(b, margs, ma.v)
            b.NewStore(handle(s.at.code), gLuaPos)
            b.NewStore(handle(luaCalleeCode(cname, luaDescText({k: "method", n: s.name}))), gLuaCallee)
            return {b: b, v: luaCallTail(b, tail, fn, margs), call: true}
        }
        if (s.kind == "field") {
            var fr = emitMemberGet(b, v, emitStr(b, luaNameKey(s.name)), sfx, s.name, hUndef)
            return {b: fr.b, v: fr.v, call: false}
        }
        var ir = s.idx(b)
        b = ir.b
        var kFirst = callLua(b, "lua_first", [ir.v])
        var xr = emitMemberGet(b, v, callLua(b, "lua_cmpv", [kFirst]), sfx, "", kFirst)
        return {b: xr.b, v: xr.v, call: false}
    }
    // A tail call is not made here: it becomes the pair [f, args] that makeReturn
    // hands to lua_tramp.
    function luaCallTail(b, tail, fn, args) {
        if (!tail) { return callExt(b, "js_call", [fn, hUndef, args]) }
        var rec = callExt(b, "js_arr_new", [])
        callExt(b, "js_arr_push", [rec, fn])
        callExt(b, "js_arr_push", [rec, args])
        return rec
    }
    // Every Lua string shares one metatable whose __index is the string library, so
    // s:sub(2) / s:len() resolve there instead of aborting on "attempt to index a string
    // value". The library table is parked in jsmain's scope under the reserved name
    // 0strlib (an ordinary Lua name cannot begin with a digit, so nothing can shadow it)
    // and only the string arm of the branch reads it - a table access pays one js_typeof
    // and one compare.
    //
    // Any other value that is not a table is a Lua error ("attempt to index a
    // number value"), as in luaIndex; the table test comes first, so a table
    // access still pays one compare.
    // A field NAME as the table key js_lukey would make of it, decided at compile
    // time: a name cannot start with a digit or '-', so only the "__" prefix and
    // Infinity / NaN take the U+0100 escape. Twin of luaStrKey in
    // lua-interpreter.abnf.
    function luaNameKey(name) {
        if ((name.charCodeAt(0) === 95 && name.charCodeAt(1) === 95) || name == "Infinity" || name == "NaN") { return String.fromCharCode(256) + name }
        return name
    }
    // `sfx` names the indexed expression in an error (luaDescText). The key as the
    // program wrote it, which an __index function is handed, is the field name
    // keyName (emitted only where it is used), or keyV when keyName is "".
    function emitMemberGet(b, v, kV, sfx, keyName, keyV) {
        var tyV = callExt(b, "js_typeof", [v])
        var objB = curF.NewBlock("")
        var notObjB = curF.NewBlock("")
        var strB = curF.NewBlock("")
        var badB = curF.NewBlock("")
        var joinB = curF.NewBlock("")
        b.NewCondBr(rawTruthy(b, callExt(b, "js_seq", [tyV, emitStr(b, "object")])), objB, notObjB)
        var ov = callExt(objB, "js_get", [v, kV])
        // Only a MISS can be the {__f} box of an integral float (2.0), which is a
        // number and not a table: the check costs nothing on a hit. The same slot
        // holds a table's metatable (lib/lua-rt.metajs, luMetaOf), and then the
        // miss goes to its __index (js_luindex) - one read for both.
        var missB = curF.NewBlock("")
        var hitB = curF.NewBlock("")
        objB.NewCondBr(rawTruthy(objB, callExt(objB, "js_seq", [ov, hUndef])), missB, hitB)
        hitB.NewBr(joinB)
        var slotB = curF.NewBlock("")
        var boxB = curF.NewBlock("")
        var metaB = curF.NewBlock("")
        var fV = callExt(missB, "js_get", [v, emitStr(missB, "__f")])
        missB.NewCondBr(rawTruthy(missB, callExt(missB, "js_sne", [fV, hUndef])), slotB, joinB)
        slotB.NewCondBr(rawTruthy(slotB, callExt(slotB, "js_seq", [callExt(slotB, "js_typeof", [fV]), emitStr(slotB, "object")])), metaB, boxB)
        luaIndexError(boxB, v, sfx)
        boxB.NewBr(joinB)
        var mv = callExt(metaB, "js_luindex", [v, keyName != "" ? emitStr(metaB, keyName) : keyV])
        metaB.NewBr(joinB)
        notObjB.NewCondBr(rawTruthy(notObjB, callExt(notObjB, "js_seq", [tyV, emitStr(notObjB, "string")])), strB, badB)
        var libV = callLua(strB, "lua_getvar", [curScopeV, emitStr(strB, "0strlib")])
        var sv = callExt(strB, "js_get", [libV, kV])
        strB.NewBr(joinB)
        luaIndexError(badB, v, sfx)
        badB.NewBr(joinB)
        return {b: joinB, v: joinB.NewPhi([llvm.ir.NewIncoming(ov, hitB), llvm.ir.NewIncoming(hUndef, missB),
                                           llvm.ir.NewIncoming(mv, metaB),
                                           llvm.ir.NewIncoming(hUndef, boxB), llvm.ir.NewIncoming(sv, strB),
                                           llvm.ir.NewIncoming(hUndef, badB)])}
