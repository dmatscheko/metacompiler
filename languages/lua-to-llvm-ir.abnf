    // The same reader as the interpreter's: it decides from the spelling whether a
    // literal is an integer or a float and marks a float by boxing it.
    //
    // An INTEGER literal is exact to 64 bits, which a host double is not, so the reader
    // does not compute its value at all - it hands makeConst the DIGIT TEXT in an
    // {__ilit} descriptor and js_lulit (abnf/jsrtlua.go) reads it in the emitted
    // program. Going through emitNum would round 9223372036854775807 to
    // 9223372036854776000 on the way into the module, and would lose the two rules
    // that differ between the bases: a decimal literal too large for a 64 bit integer
    // is a FLOAT, a hexadecimal one WRAPS.
    function isFlt(v) { return v !== null && v !== undefined && typeof v == "object" && v.__f === true }
    function isILit(v) { return v !== null && v !== undefined && typeof v == "object" && v.__ilit === true }
    function mkILit(d, r) { return {__ilit: true, d: d, r: r} }
    function mkFlt(n) { if (n - n === 0 && Math.floor(n) === n) { return {__f: true, v: n} } return n }
