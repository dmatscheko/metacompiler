    function libUpper(bb, argsH) { return libCase(bb, argsH, luaLower, luaUpper) }
    function libLower(bb, argsH) { return libCase(bb, argsH, luaUpper, luaLower) }
    // string.sub is NOT JS slice(i-1, j): Lua's negative index is INCLUSIVE and 1-based
    // (-1 is the last character, so it normalises to len+i+1) and both ends clamp into
    // 1..len instead of being reinterpreted. The whole normalisation lives in the emitted lua_sub helper
    // so the branching is written once; the interpreter half's luaSubStart / luaSubEnd
    // are the same three steps.
    function libSub(bb, argsH) {
        return {b: bb, v: callLua(bb, "lua_sub", [libArg(bb, argsH, 0), libArg(bb, argsH, 1), libArg(bb, argsH, 2)])}
    }
    function libRep(bb, argsH) {
        var s = callLua(bb, "lua_strarg", [libArg(bb, argsH, 0)])
        var n = callLua(bb, "lua_num", [libArg(bb, argsH, 1)])
        var saved = curScopeV
        curScopeV = callExt(bb, "js_scope_new", [curScopeV])
        hidCount++
        var iName = "$ri" + hidCount
        var aName = "$ra" + hidCount
        callExt(bb, "js_scope_decl", [curScopeV, emitStr(bb, iName), emitNum(bb, 0)])
        callExt(bb, "js_scope_decl", [curScopeV, emitStr(bb, aName), emitStr(bb, "")])
        var headB = curF.NewBlock("")
        var bodyB = curF.NewBlock("")
        var exitB = curF.NewBlock("")
        bb.NewBr(headB)
        var iV = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, iName)])
        headB.NewCondBr(truthy(headB, callExt(headB, "js_lt", [iV, n])), bodyB, exitB)
        var aV = callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, aName)])
        callExt(bodyB, "js_scope_set", [curScopeV, emitStr(bodyB, aName), callExt(bodyB, "js_add", [aV, s])])
        var iV2 = callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, iName)])
        callExt(bodyB, "js_scope_set", [curScopeV, emitStr(bodyB, iName), callExt(bodyB, "js_add", [iV2, emitNum(bodyB, 1)])])
        bodyB.NewBr(headB)
        var aFin = callExt(exitB, "js_scope_get", [curScopeV, emitStr(exitB, aName)])
        curScopeV = saved
        return {b: exitB, v: aFin}
    }

    // table.insert(t, v): append at the border+1. table.remove(t): read the last element,
    // clear its slot (so #t shrinks), and return it.
    function libInsert(bb, argsH) {
        var t = libArg(bb, argsH, 0)
        var v = libArg(bb, argsH, 1)
        var rb = emitBorder(bb, t)
        var b2 = rb.b
        callExt(b2, "js_set", [t, callExt(b2, "js_add", [rb.v, emitNum(b2, 1)]), v])
        return {b: b2, v: hUndef}
    }
    function libRemove(bb, argsH) {
        var t = libArg(bb, argsH, 0)
        var rb = emitBorder(bb, t)
        var b2 = rb.b
        var val = callExt(b2, "js_get", [t, rb.v])
        callExt(b2, "js_set", [t, rb.v, hUndef])
        return {b: b2, v: val}
    }

    // next(t [, k]): the array-part iterator, straight-line. k nil -> probe index 1, else
    // k+1; the result is that index while t[index] is non-nil, else nil (the key only,
    // since the subset yields one value per call).
    function libNext(bb, argsH) {
        var t = libArg(bb, argsH, 0)
        var k = libArg(bb, argsH, 1)
        var i = bb.NewSelect(truthy(bb, callExt(bb, "js_seq", [k, hUndef])), emitNum(bb, 0), k)
        var nk = callExt(bb, "js_add", [i, emitNum(bb, 1)])
        var elem = callExt(bb, "js_get", [t, nk])
        return {b: bb, v: bb.NewSelect(truthy(bb, callExt(bb, "js_seq", [elem, hUndef])), hUndef, nk)}
    }

    // ipairs(t) / pairs(t): both answer the iterator triple the generic for consumes.
    // ipairs walks 1, 2, 3, ... and stops at the first nil element; pairs walks the
    // table's own keys in insertion order (js_keys, deterministic across engines) and
    // skips the ones whose value is nil, binding a numeric key as the number it
    // was stored as (js_lukeyback).
    // ipairs' iterator is stateless (its control value is the index), pairs' is a closure
    // over a cursor cell - the loop feeds the control value back either way.
    function libINext(bb, argsH) {
        var t = libArg(bb, argsH, 0)
        var nk = callExt(bb, "js_add", [libArg(bb, argsH, 1), emitNum(bb, 1)])
        var v = callExt(bb, "js_get", [t, nk])
        var nilB = curF.NewBlock("")
        var okB = curF.NewBlock("")
        bb.NewCondBr(truthy(bb, callExt(bb, "js_seq", [v, hUndef])), nilB, okB)
        nilB.NewRet(hUndef)
        var arr = callExt(okB, "js_arr_new", [])
        callExt(okB, "js_arr_push", [arr, nk])
        callExt(okB, "js_arr_push", [arr, v])
        okB.NewRet(callLua(okB, "lua_mk", [arr]))
        return {b: deadBlock(), v: hUndef}
    }
    function libIpairs(bb, argsH) {
        var t = libArg(bb, argsH, 0)
        var arr = callExt(bb, "js_arr_new", [])
        callExt(bb, "js_arr_push", [arr, callExt(bb, "js_closure", [handle(emitLibFunc(libINext)), curScopeV])])
        callExt(bb, "js_arr_push", [arr, t])
        callExt(bb, "js_arr_push", [arr, emitNum(bb, 0)])
        return {b: bb, v: callLua(bb, "lua_mk", [arr])}
    }
    // The cursor of a pairs walk: {t, k (the key array), i}. Its iterator ignores the
    // control value the loop hands back and advances the cursor itself.
    function libPNext(bb, argsH) {
        var st = libArg(bb, argsH, 0)
        var tV = callExt(bb, "js_get", [st, emitStr(bb, "t")])
        var kV = callExt(bb, "js_get", [st, emitStr(bb, "k")])
        var nV = callExt(bb, "js_get", [kV, emitStr(bb, "length")])
        var headB = curF.NewBlock("")
        var bodyB = curF.NewBlock("")
        var hitB = curF.NewBlock("")
        var skipB = curF.NewBlock("")
        var endB = curF.NewBlock("")
        bb.NewBr(headB)
        var iV = callExt(headB, "js_get", [st, emitStr(headB, "i")])
        headB.NewCondBr(truthy(headB, callExt(headB, "js_lt", [iV, nV])), bodyB, endB)
        var iV2 = callExt(bodyB, "js_get", [st, emitStr(bodyB, "i")])
        var keyV = callExt(bodyB, "js_get", [kV, iV2])
        var valV = callExt(bodyB, "js_get", [tV, keyV])
        var progKeyV = callExt(bodyB, "js_lukeyback", [keyV])
        callExt(bodyB, "js_set", [st, emitStr(bodyB, "i"), callExt(bodyB, "js_add", [iV2, emitNum(bodyB, 1)])])
        bodyB.NewCondBr(truthy(bodyB, callExt(bodyB, "js_sne", [valV, hUndef])), hitB, skipB)
        skipB.NewBr(headB)
        var parr = callExt(hitB, "js_arr_new", [])
        callExt(hitB, "js_arr_push", [parr, progKeyV])
        callExt(hitB, "js_arr_push", [parr, valV])
        hitB.NewRet(callLua(hitB, "lua_mk", [parr]))
        endB.NewRet(hUndef)
        return {b: deadBlock(), v: hUndef}
    }
    function libPairs(bb, argsH) {
        var t = libArg(bb, argsH, 0)
        var st = callExt(bb, "js_obj_new", [])
        callExt(bb, "js_set", [st, emitStr(bb, "t"), t])
        callExt(bb, "js_set", [st, emitStr(bb, "k"), callExt(bb, "js_keys", [t])])
        callExt(bb, "js_set", [st, emitStr(bb, "i"), emitNum(bb, 0)])
        var arr = callExt(bb, "js_arr_new", [])
        callExt(bb, "js_arr_push", [arr, callExt(bb, "js_closure", [handle(emitLibFunc(libPNext)), curScopeV])])
        callExt(bb, "js_arr_push", [arr, st])
        callExt(bb, "js_arr_push", [arr, hUndef])
        return {b: bb, v: callLua(bb, "lua_mk", [arr])}
    }

    // error(v [, level]): throw v, a string first prefixed with the position of
    // `level` (lua_whereat). Any other value travels unchanged. Twin of
    // globalScope["error"] in lua-interpreter.abnf.
    function libError(bb, argsH) {
        var v = libArg(bb, argsH, 0)
        var lvH = callLua(bb, "lua_errlevel", [libArg(bb, argsH, 1)])
        var strB = curF.NewBlock("")
        var plainB = curF.NewBlock("")
        bb.NewCondBr(rawTruthy(bb, callExt(bb, "js_seq", [callExt(bb, "js_typeof", [v]), emitStr(bb, "string")])), strB, plainB)
        callExt(strB, "js_throw", [callExt(strB, "js_add", [callLua(strB, "lua_whereat", [lvH]), v])])
        strB.NewRet(hUndef)
        callExt(plainB, "js_throw", [v])
        return {b: plainB, v: hUndef}
    }
    // pcall(f, ...) / xpcall(f, msgh, ...): call f in protected mode - true and its
    // results, or false and the error object (through msgh first, for xpcall). The
    // call runs in a js_try whose two clauses are closures over a scope holding f,
    // its arguments and the handler. pcall is a frame with no position: it pushes
    // its caller's and runs f with lua.pos -1, and it restores both after the
    // js_try, because a throw skips every frame's own restore. Twin of luaProtect
    // in lua-interpreter.abnf.
    function libProtect(withHandler) {
        return function(bb, argsH) {
            var nargs = callExt(bb, "js_get", [argsH, emitStr(bb, "length")])
            var fewB = curF.NewBlock("")
            var okB = curF.NewBlock("")
            var need = withHandler ? 2 : 1
            bb.NewCondBr(rawTruthy(bb, callExt(bb, "js_lt", [nargs, emitNum(bb, need)])), fewB, okB)
            callLua(fewB, "lua_raise", [emitStr(fewB, withHandler ? "bad argument #2 to 'xpcall' (value expected)"
                                                                  : "bad argument #1 to 'pcall' (value expected)")])
            fewB.NewRet(hUndef)
            var b = okB
            var fr = luaEnter(b, false)
            b.NewStore(handle(0 - 1), gLuaPos)
            var sc = callExt(b, "js_scope_new", [curScopeV])
            callExt(b, "js_scope_decl", [sc, emitStr(b, "f"), libArg(b, argsH, 0)])
            callExt(b, "js_scope_decl", [sc, emitStr(b, "a"), callLua(b, "lua_tail", [argsH, emitNum(b, need)])])
            if (withHandler) { callExt(b, "js_scope_decl", [sc, emitStr(b, "h"), libArg(b, argsH, 1)]) }
            var tryClo = callExt(b, "js_closure", [handle(emitLibFunc(libProtectTry)), sc])
            var catchClo = callExt(b, "js_closure", [handle(emitLibFunc(libProtectCatch(withHandler))), sc])
            var res = callExt(b, "js_try", [tryClo, catchClo, hUndef])
            luaLeave(b, fr)
            // A throw between a tail call and its callee's luaEnter leaves lua.tail set.
            b.NewStore(handle(0), gLuaTail)
            return {b: b, v: res}
        }
    }
    function libProtectTry(bb, argsH) {
        var envV = curScopeV
        var r = callExt(bb, "js_call", [callExt(bb, "js_scope_get", [envV, emitStr(bb, "f")]), hUndef,
                                        callExt(bb, "js_scope_get", [envV, emitStr(bb, "a")])])
        var arr = callExt(bb, "js_arr_new", [])
        callExt(bb, "js_arr_push", [arr, hTrue])
        callLua(bb, "lua_appendall", [arr, r])
        return {b: bb, v: callLua(bb, "lua_mk", [arr])}
    }
    function libProtectCatch(withHandler) {
        return function(bb, argsH) {
            var ev = callLua(bb, "lua_errval", [libArg(bb, argsH, 0)])
            if (withHandler) {
                var hargs = callExt(bb, "js_arr_new", [])
                callExt(bb, "js_arr_push", [hargs, ev])
                ev = callLua(bb, "lua_first", [callExt(bb, "js_call", [callExt(bb, "js_scope_get", [curScopeV, emitStr(bb, "h")]), hUndef, hargs])])
            }
            // lua 5.5 reports a nil error object as this string.
            ev = bb.NewSelect(rawTruthy(bb, callExt(bb, "js_seq", [ev, hUndef])), emitStr(bb, "<no error object>"), ev)
            var arr = callExt(bb, "js_arr_new", [])
            callExt(bb, "js_arr_push", [arr, hFalse])
            callExt(bb, "js_arr_push", [arr, ev])
            return {b: bb, v: callLua(bb, "lua_mk", [arr])}
        }
    }

    // libSet wires one closure into a library table field; libDecl binds a table (or a
    // bare function) into jsmain's scope under its global name.
    function libSet(b, obj, name, idx) {
        callExt(b, "js_set", [obj, emitStr(b, name), callExt(b, "js_closure", [handle(idx), curScopeV])])
        return b
    }
    // Emit only the referenced libraries; a program that uses none emits nothing here.
    function emitLibs(b) {
        if (libNeed.error) {
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "error"), callExt(b, "js_closure", [handle(emitLibFunc(libError)), curScopeV])])
        }
        if (libNeed.pcall) {
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "pcall"), callExt(b, "js_closure", [handle(emitLibFunc(libProtect(false))), curScopeV])])
        }
        if (libNeed.xpcall) {
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "xpcall"), callExt(b, "js_closure", [handle(emitLibFunc(libProtect(true))), curScopeV])])
        }
        if (libNeed.ipairs) {
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "ipairs"), callExt(b, "js_closure", [handle(emitLibFunc(libIpairs)), curScopeV])])
        }
        if (libNeed.pairs) {
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "pairs"), callExt(b, "js_closure", [handle(emitLibFunc(libPairs)), curScopeV])])
        }
        if (libNeed.next) {
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "next"), callExt(b, "js_closure", [handle(emitLibFunc(libNext)), curScopeV])])
        }
        if (libNeed.math) {
            var mt = callExt(b, "js_obj_new", [])
            b = libSet(b, mt, "floor", emitLibFunc(libFloor))
            b = libSet(b, mt, "ceil", emitLibFunc(libCeil))
            b = libSet(b, mt, "abs", emitLibFunc(libAbs))
            b = libSet(b, mt, "max", emitLibFunc(libMax))
            b = libSet(b, mt, "min", emitLibFunc(libMin))
            b = libSet(b, mt, "fmod", emitLibFunc(libFmod))
            b = libSet(b, mt, "type", emitLibFunc(libType))
            b = libSet(b, mt, "tointeger", emitLibFunc(libToInt))
            b = libSet(b, mt, "sqrt", emitLibFunc(libMath1("sqrt")))
            b = libSet(b, mt, "sin", emitLibFunc(libMath1("sin")))
            b = libSet(b, mt, "cos", emitLibFunc(libMath1("cos")))
            b = libSet(b, mt, "tan", emitLibFunc(libMath1("tan")))
            b = libSet(b, mt, "asin", emitLibFunc(libMath1("asin")))
            b = libSet(b, mt, "acos", emitLibFunc(libMath1("acos")))
            b = libSet(b, mt, "exp", emitLibFunc(libMath1("exp")))
            b = libSet(b, mt, "deg", emitLibFunc(libScale(180 / Math.PI)))
            b = libSet(b, mt, "rad", emitLibFunc(libScale(Math.PI / 180)))
            b = libSet(b, mt, "atan", emitLibFunc(libAtan))
            b = libSet(b, mt, "log", emitLibFunc(libLog))
            b = libSet(b, mt, "modf", emitLibFunc(libModf))
            b = libSet(b, mt, "ult", emitLibFunc(libUlt))
            // math.pi and math.huge are FLOAT VALUES, not functions. The dialect has
            // no exponent literal, so the infinity is built by division (manual
            // chapter 4); js_luflo boxes a raw double as a Lua float.
            callExt(b, "js_set", [mt, emitStr(b, "pi"), callLua(b, "lua_mkflt", [emitNum(b, Math.PI)])])
            callExt(b, "js_set", [mt, emitStr(b, "huge"), callLua(b, "lua_mkflt", [emitNum(b, 1 / 0)])])
            // The two ends of the integer range are VALUES, not functions, and neither
            // survives a double - they are built from their bit pattern in Go.
            callExt(b, "js_set", [mt, emitStr(b, "maxinteger"), callExt(b, "js_lumaxint", [])])
            callExt(b, "js_set", [mt, emitStr(b, "mininteger"), callExt(b, "js_luminint", [])])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "math"), mt])
        }
        if (libNeed.string) {
            var st = callExt(b, "js_obj_new", [])
            b = libSet(b, st, "len", emitLibFunc(libStrLen))
            b = libSet(b, st, "upper", emitLibFunc(libUpper))
            b = libSet(b, st, "lower", emitLibFunc(libLower))
            b = libSet(b, st, "sub", emitLibFunc(libSub))
            b = libSet(b, st, "rep", emitLibFunc(libRep))
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "string"), st])
            // The same table under a name no Lua program can spell, so the string
            // metatable lookup cannot be broken by `local string = 1`.
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "0strlib"), st])
        }
        if (libNeed.table) {
            var tt = callExt(b, "js_obj_new", [])
            b = libSet(b, tt, "insert", emitLibFunc(libInsert))
            b = libSet(b, tt, "remove", emitLibFunc(libRemove))
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "table"), tt])
        }
        return b
    }

    // jsmain: declare print, then run the file top to bottom.
    function buildMain(items) {
        // The walk of a required file ends here too (importDepth > 0): stash its top-level
        // statement thunks for the real jsmain instead of emitting a second one.
        if (importDepth > 0) {
            stashImported(items) // stashed with its file; emitted later (compile-core)
            return
        }
        var f = m.NewFunc("jsmain", i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        curF = f
        var b = f.NewBlock("entry")
        curScopeV = callExt(b, "js_scope_new", [f.Params[0]])
        funcCount++
        var prIdx = funcCount
        var pf = m.NewFunc("jsf_" + prIdx, i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var pb = pf.NewBlock("entry")
        // js_luaprint joins with a TAB, which is what Lua's print does (js_pyprint
        // would join with a space - Python's rule).
        pb.NewCall(getExtern("js_luaprint", 1), [callLua(pb, "lua_strall", [pf.Params[1]])])
        pb.NewRet(hUndef)
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "print"), callExt(b, "js_closure", [handle(prIdx), curScopeV])])
        b = emitLibs(b)
        // A member read or write on nil and a call of a non-function are Lua errors,
        // catchable like any other: the floor's three hooks answer the marker to
        // throw where they would otherwise abort.
        callExt(b, "js_rt_missmem", [callExt(b, "js_closure", [handle(emitLibFunc(libIndexNil)), curScopeV])])
        callExt(b, "js_rt_missset", [callExt(b, "js_closure", [handle(emitLibFunc(libIndexNil)), curScopeV])])
        callExt(b, "js_rt_missfn", [callExt(b, "js_closure", [handle(emitLibFunc(libCallBad)), curScopeV])])
        // An error nobody caught ends the run with lua's own text for its error
        // object: the chunk runs as the try body of one js_try whose catch renders
        // it. The body is a function of its own that reads jsmain's scope straight
        // from its env, so the chunk gains no scope level.
        var ucClo = callExt(b, "js_closure", [handle(emitLibFunc(libUncaught)), curScopeV])
        funcCount++
        var topIdx = funcCount
        var topClo = callExt(b, "js_closure", [handle(topIdx), curScopeV])
        b.NewRet(callExt(b, "js_try", [topClo, ucClo, hUndef]))
        curF = m.NewFunc("jsf_" + topIdx, i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        b = curF.NewBlock("entry")
        curScopeV = curF.Params[0]
        b = emitImported(b)
        b = makeSeq(items)(b)
        b.NewRet(hUndef)
    }
    function libIndexNil(bb, argsH) {
        return {b: bb, v: luaMarker(bb, emitStr(bb, "attempt to index a nil value"))}
    }
    function libCallBad(bb, argsH) {
        var msg = callExt(bb, "js_add", [callExt(bb, "js_add", [emitStr(bb, "attempt to call a "), callExt(bb, "js_lutname", [libArg(bb, argsH, 0)])]), emitStr(bb, " value")])
        return {b: bb, v: luaMarker(bb, msg)}
    }
    function libUncaught(bb, argsH) {
        var text = callLua(bb, "lua_errtext", [callLua(bb, "lua_errval", [libArg(bb, argsH, 0)])])
        callExt(bb, "js_luuncaught", [callExt(bb, "js_luaout", [text])])
        return {b: bb, v: hUndef}
    }
    function buildChunk(items) { buildMain(items) }

    // ----- Core library config (see lib/compile-core.js) -----
    // Lua stdlib libraries the runtime already provides; require of one is a no-op.
    core.stdlibImports = ["string", "table", "math", "io", "os", "coroutine"]

    // ----- Project-file imports (see the Require rule) -----
    function luaImport(items, pos) {
        resolveImport(items[items.length - 1], pos)
        return function(b) { return b }
    }
    // A required file is parsed with this grammar and walked with importDepth > 0, so its
    // buildMain stashes its top-level thunks into importedItems; the real buildMain prepends
    // them to jsmain. Required once; a leading './' is dropped and a missing '.lua' extension
    // appended before the -i-root search.
    var importedFiles = {}
    var importDepth = 0
    // imported files top-level items: stashImported / emitImported (compile-core)
    core.importFile = function(path, pos) {
        var rel = path
        if (rel.length >= 2 && rel.charAt(0) == "." && rel.charAt(1) == "/") { rel = rel.substring(2) }
        if (!(rel.length >= 4 && rel.substring(rel.length - 4) == ".lua")) { rel = rel + ".lua" }
        var file = c.findImport(rel)
        if (file == "") { return false }
        if (importedFiles["$" + file] == true) { return true }
        importedFiles["$" + file] = true
        var text = c.readFile(file)
        var asg = c.parse(c.agrammar, text, null, file)
        c.pushSource(file, text)
        importDepth = importDepth + 1
        c.compile(asg)
        importDepth = importDepth - 1
        c.popSource()
        return true
    }

    c.compile(c.asg)

    // ----- the native build -----
    // jsdispatch(idx, env, args) is the function table a LINKED binary needs: js_closure
    // stores a raw function index, and under llvm.Run the Go runtime turns that index
    // back into a callee by looking "jsf_<idx>" up in the module. A binary has no such
    // reflection, so the module carries the mapping itself. The MISS arm calls
    // jsdispatch_ext, the same table emitted by the layer-2 runtime library
    // (lib/lua-rt.ll, built by metajs-to-llvm-ir.abnf -rt-lib): its own function indices
    // are offset by a million, so the two chains cannot overlap and one js_call reaches
    // either module. Emitted ONLY for -exe.
    function emitDispatch() {
        var idxs = []
        var fns = []
        var i = 0
        while (i < m.Funcs.length) {
            var f = m.Funcs[i]
            var nm = f.Name()
            if (nm.length > 4 && nm.substring(0, 4) == "jsf_") {
                idxs.push(parseInt(nm.substring(4, nm.length)))
                fns.push(f)
            }
            i = i + 1
        }
        var ext = m.NewFunc("jsdispatch_ext", i64,
            [llvm.ir.NewParam("idx", i64), llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var d = m.NewFunc("jsdispatch", i64,
            [llvm.ir.NewParam("idx", i64), llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var b = d.NewBlock("entry")
        // The library's indices start at a million (metajs -rt-lib offsets them), so
        // ONE compare sends a layer-2 call straight to the layer-2 table instead of
        // walking this module's whole chain first. Layer 2 calls itself far more often
        // than the program calls it, so this is the compare that matters.
        var extB = d.NewBlock("ext")
        var ownB = d.NewBlock("own")
        b.NewCondBr(b.NewICmp(llvm.enum.IPredSGE, d.Params[0], llvm.constant.NewInt(i64, 1000000)), extB, ownB)
        extB.NewRet(extB.NewCall(ext, [d.Params[0], d.Params[1], d.Params[2]]))
        b = ownB
        i = 0
        while (i < fns.length) {
            var hit = d.NewBlock("hit" + idxs[i])
            var nxt = d.NewBlock("miss" + idxs[i])
            b.NewCondBr(b.NewICmp(llvm.enum.IPredEQ, d.Params[0], llvm.constant.NewInt(i64, idxs[i])), hit, nxt)
            hit.NewRet(hit.NewCall(fns[i], [d.Params[1], d.Params[2]]))
            b = nxt
            i = i + 1
        }
        b.NewRet(b.NewCall(ext, [d.Params[0], d.Params[1], d.Params[2]]))
    }

    // The two runtime inputs live next to THIS grammar, so the build does not depend on
    // the working directory: lib/runtime.ll is the C floor and lib/lua-rt.ll
    // is Lua's own layer 2. An explicit -rt REPLACES both.
    function libPath(name) {
        var mn = moduleName()
        var cut = -1
        var i = 0
        while (i < mn.length) {
            var ch = mn.charAt(i)
            if (ch == "/" || ch == "\\") { cut = i }
            i = i + 1
        }
        return mn.substring(0, cut + 1) + "lib/" + name
    }

    if (c.exePath != undefined && c.exePath != "") {
        emitDispatch()
        var rts = c.runtime
        if (rts == undefined || rts.length == 0) { rts = [libPath("runtime.ll"), libPath("lua-rt.ll")] }
        var buildErr = llvm.BuildExecutable(m, c.exePath, rts)
        if (buildErr != "") {
            println(buildErr)
            exit(1)
        }
        println("lua compiler: wrote executable " + c.exePath)
        exit(0)
    }

    println(m)

    var res = llvm.RunJS(m, "jsmain")
    println("lua compiler: program ran to completion")
    exit(res.Ret)

~~) ;
