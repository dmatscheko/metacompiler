            var okhB = curF.NewBlock("")
            b.NewCondBr(rawTruthy(b, callExt(b, "js_gt", [ps[1], ps[0]])), hiB, okhB)
            hiB.NewRet(ps[0])
            okhB.NewRet(ps[1])
            return
