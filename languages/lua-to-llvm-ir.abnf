    // A Lua string is a counted sequence of BYTES, not of characters: real Lua answers 6
    // for #"hello" spelled with an e-acute. The runtime string type is UTF-16, so a Lua
    // string is held with ONE CHARACTER PER BYTE (every code unit is 0..255) and #,
    // string.len, string.sub, string.rep and the relational operators all measure and cut
    // in bytes for free. utf8Enc/luaUtf8 encode source text and \u{...} on the way IN;
    // print writes the bytes raw (the writeBytes host global), and only the text of an
    // uncaught error is decoded back (js_luaout). lua-interpreter.abnf does the same.
    // lua's luaO_utf8esc: continuation bytes from the low end while the rest does not
    // fit the lead byte, whose free bits halve with each one - the original
    // UTF-8 of up to six bytes, so \u{7FFFFFFF} is FD BF BF BF BF BF. Twin of lu8Esc in
    // lib/lua-strlib.js (the interpreter and layer 2).
    function utf8Enc(cp) {
        if (cp < 128) { return String.fromCharCode(cp) }
        var out = ""
        var x = cp
        var mfb = 63 // The largest value the lead byte can still hold.
        var more = true
        while (more) {
            out = String.fromCharCode(128 + x % 64) + out
            x = Math.floor(x / 64)
            mfb = Math.floor(mfb / 2)
            more = x > mfb
        }
        return String.fromCharCode((255 - mfb) * 2 % 256 + x) + out
    }
    function luaUtf8(s) {
        var out = ""
        var i = 0
        while (i < s.length) {
            var c = s.charCodeAt(i)
            if (c >= 55296 && c < 56320 && i + 1 < s.length) {
                var lo = s.charCodeAt(i + 1)
                if (lo >= 56320 && lo < 57344) {
                    out = out + utf8Enc(65536 + (c - 55296) * 1024 + (lo - 56320))
                    i = i + 2
                    continue
                }
            }
            out = out + utf8Enc(c)
            i = i + 1
        }
