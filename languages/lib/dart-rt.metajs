        if (name === "equals") { return recv === dtArgAt(args, 0) }
        if (name === "substring") {
            var n = dtStrLen(recv)
            var bg = 0
            var en = n
            if (args.length > 0) { bg = Math.trunc(dtNum(args[0])) }
            if (args.length > 1) { en = Math.trunc(dtNum(args[1])) }
            if (bg < 0) { bg = 0 }
            if (en > n) { en = n }
            if (bg > en) { return "" }
            return dtStrRange(recv, bg, en)
