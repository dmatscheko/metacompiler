    if (n === "IntegerDivisionByZeroException") { return "IntegerDivisionByZeroException" }
    if (n === "AssertionError") {                                                  // :135-140
        if (dtExcNull(msg)) { return "Assertion failed" }
        return "Assertion failed: " + dtExcSafe(msg)
    }
    if (n === "ArgumentError" || n === "RangeError" || n === "IndexError") {
        return dtExcArgStr(n, o)
    }
    if (n === "UnsupportedError") { return "Unsupported operation: " + dtStr(msg) } // :584
    if (n === "UnimplementedError") {                                              // :598-603
        if (dtExcNull(msg)) { return "UnimplementedError" }
        return "UnimplementedError: " + dtStr(msg)
    }
    if (n === "StateError") { return "Bad state: " + dtStr(msg) }                  // :623
    if (n === "ConcurrentModificationError") {                                     // :637-643
