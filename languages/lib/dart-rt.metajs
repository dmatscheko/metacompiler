        if (name === "keys") { return rtCopyArr(recv["keys"]) }
        if (name === "values") { return rtCopyArr(recv["vals"]) }
        if (name === "get") {
            var gi = dtDictFind(recv["keys"], dtArgAt(args, 0))
            if (gi >= 0) { return recv["vals"][gi] }
            if (args.length > 1) { return args[1] }
            return undefined
        }
        fail("unknown dict method '" + name + "'")
    }
    if (rtIsArr(recv)) { return dtListMethod(recv, name, args) }
    if (dtIsObj(recv)) {
        var cls = recv["__class"]
        if (cls !== undefined) {
            var c = cls
            var guard = 0
            while (guard < 64) {
                guard = guard + 1
                if (!dtIsObj(c)) { guard = 99 } else {
                    var mm = c[name]
