    if (ctor === "withLength") {                                                   // :483
        e["invalidValue"] = dtExcArg(argv, 0)
        e["__dlen"] = dtExcArg(argv, 1)
        e["indexable"] = dtExcOpt(argv, 2, "indexable")
        e["name"] = dtExcOpt(argv, 2, "name")
        e["message"] = dtExcOr(dtExcOpt(argv, 2, "message"), "Index out of range")
    } else {                                                                       // :465
        e["invalidValue"] = dtExcArg(argv, 0)
        e["indexable"] = dtExcArg(argv, 1)
