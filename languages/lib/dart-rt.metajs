// The Kotlin/Python list methods of rt.memberCall, in its order.
function dtListMethod(o, name, args) {
    if (name === "add") {
        o.push(dtArgAt(args, 0))
        return true
    }
    if (name === "append") {
        o.push(dtArgAt(args, 0))
        return undefined
    }
    if (name === "pop" || name === "removeLast") {
        if (o.length == 0) { fail("pop from empty list") }
        return o.pop()
    }
    if (name === "get") {
        var gi = Math.trunc(dtNum(dtArgAt(args, 0)))
        if (gi < 0 || gi >= o.length) { fail("list index out of range") }
        return o[gi]
    }
    if (name === "contains") {
        var ci = 0
        while (ci < o.length) {
            if (o[ci] === dtArgAt(args, 0)) { return true }
            ci = ci + 1
        }
        return false
    }
    if (name === "map") {
        var mo = []
        var mi = 0
        while (mi < o.length) {
            mo.push(args[0].apply(undefined, [o[mi]]))
            mi = mi + 1
        }
        return mo
    }
    if (name === "forEach") {
        var ei = 0
        while (ei < o.length) {
            args[0].apply(undefined, [o[ei]])
            ei = ei + 1
        }
        return undefined
    }
    if (name === "count") {
        if (args.length == 0) { return o.length }
        var n = 0
        var ni = 0
        while (ni < o.length) {
            if (args[0].apply(undefined, [o[ni]])) { n = n + 1 }
            ni = ni + 1
        }
        return n
    }
