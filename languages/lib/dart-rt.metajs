        if (idx < 0 || idx >= c.length) { dtIndexErr(k, c) }
        return c[idx]
    }
    if (typeof c == "string") {
        var si = Math.trunc(dtNum(k))
        if (si < 0 || si >= dtStrLen(c)) { dtIndexErr(k, c) }
        return dtStrAt(c, si)
    }
