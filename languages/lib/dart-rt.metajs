    if (n === "IndexError") {                                                      // :536-546
        if (dtNumOf(o["invalidValue"]) < 0) { return ": index must not be negative" }
        if (dtNumOf(o["__dlen"]) == 0) { return ": no indices are valid" }
        return ": index should be less than " + dtStr(o["__dlen"])
    }
