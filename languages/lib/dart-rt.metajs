    if (lt === "Double" || lt === "Float" || lt === "Number") { return plain }
    if (lt === "String" || lt === "CharSequence") { return typeof v == "string" }
    if (lt === "Boolean") { return typeof v == "boolean" }
    if (lt === "List" || lt === "MutableList" || lt === "Collection" || lt === "Array") { return rtIsArr(v) }
    if (!dtIsObj(v)) { return false }
    var cls = v["__class"]
    var guard = 0
    while (guard < 64) {
