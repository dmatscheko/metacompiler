        if (dtExcNull(mo)) { return "Concurrent modification during iteration." }
        return "Concurrent modification during iteration: " + dtExcSafe(mo) + "."
    }
    if (n === "OutOfMemoryError") { return "Out of Memory" }                       // :650
    if (n === "StackOverflowError") { return "Stack Overflow" }                    // :659
