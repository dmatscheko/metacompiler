        var i = 0
        var n = dtStrLen(v)
        while (i < n) {
            out.push(dtStrAt(v, i))
            i = i + 1
        }
        return out
    }
    if (rtIsDictObj(v)) { return rtCopyArr(v["keys"]) }
    fail("iteration over a " + typeof v)
    return []
}

// s[lo:hi] on lists and strings; open ends arrive as undefined.
function js_pyslice(c, lo, hi) {
    if (rtIsArr(c)) {
        var r = dtSliceRange(lo, hi, c.length)
        var out = []
        var i = r.from
        while (i < r.to) {
            out.push(c[i])
            i = i + 1
        }
        return out
    }
    if (typeof c == "string") {
        var n = dtStrLen(c)
        var sr = dtSliceRange(lo, hi, n)
        return dtStrRange(c, sr.from, sr.to)
    }
    fail("slicing a " + typeof c)
    return undefined
}

function dtSliceClamp(v, dflt, n) {
    if (v === undefined) { return dflt }
    var i = Math.trunc(dtNum(v))
    if (i < 0) { i = i + n }
    if (i < 0) { i = 0 }
    if (i > n) { i = n }
    return i
}

function dtSliceRange(lo, hi, n) {
    var from = dtSliceClamp(lo, 0, n)
    var to = dtSliceClamp(hi, n, n)
    if (to < from) { to = from }
    return {from: from, to: to}
}

// 'x in y' for lists, strings and Map keys.
function js_pyin(x, y) {
    if (rtIsArr(y)) {
        var i = 0
        while (i < y.length) {
            if (y[i] === x) { return true }
            i = i + 1
        }
        return false
    }
    if (typeof y == "string") { return y.indexOf(dtToStr(x)) >= 0 }
    if (rtIsDictObj(y)) { return dtDictFind(y["keys"], x) >= 0 }
    fail("'in' needs a list, a string or a dict on the right side")
    return false
}

// Containers compare BY VALUE; everything else by strict equality.
function js_pyeq(l, r) { return dtPyEqual(l, r) }

// (positional array, iterable): append every element of the iterable.
function js_pyspread(arr, it) {
    if (!rtIsArr(arr)) { fail("js_pyspread needs an array") }
    if (rtIsArr(it)) {
        var i = 0
        while (i < it.length) {
            arr.push(it[i])
            i = i + 1
        }
        return undefined
    }
    if (typeof it == "string") {
        var si = 0
        var n = dtStrLen(it)
        while (si < n) {
            arr.push(dtStrAt(it, si))
            si = si + 1
        }
        return undefined
    }
    if (rtIsDictObj(it)) {
        var ks = it["keys"]
        var ki = 0
        while (ki < ks.length) {
            arr.push(ks[ki])
            ki = ki + 1
        }
        return undefined
    }
    fail("cannot unpack a " + typeof it + " with *")
    return undefined
}

// A Set from a candidate list, de-duplicated with the VALUE equality above.
function js_pyset_new(src) {
    var out = []
    if (rtIsArr(src)) {
        var i = 0
        while (i < src.length) {
            if (!dtSetHas(out, src[i])) { out.push(src[i]) }
            i = i + 1
        }
    }
    return {__set: true, elems: out}
}

// e is T, the language-neutral spelling. The dart emitter reaches this one for
// "String", for a catch clause's type and for a class-name probe; DART's own
// type names go through js_dartis below.
function js_is_type(v, t) { return dtTypeName(v, t) }

// js_jadd is SHARED - lib/runtime.metajs, via the rtkStr/rtkNum hooks above.
// The dart emitter emits it for its own string builders and index arithmetic.

// rtJavaStr is SHARED with swift - lib/runtime-dartswift.metajs. The two copies
// were byte-identical.

// (target, method name, args array): the neutral dispatcher.
function js_mcall(recv, name, args) { return dtMember(recv, name, args) }

// ----- Dart's own seventeen --------------------------------------------------

// print(x): Dart's print writes x.toString() followed by a newline.
function js_dartprint(v) {
    print(dtStr(v) + "\n")
    return undefined
}

// The same rendering as a value: string interpolation and an explicit
// .toString() both go through it.
function js_dartstr(v) { return dtStr(v) }

// const e: the canonical value for e.
function js_dartcanon(v) { return dtCanon(v, 0) }

// `v is T` for Dart's OWN type names. The shared js_is_type knows only the JVM
// spelling and answers false for int / num / Map / Set, so this is the Dart one.
// A user class name still falls through to the shared __class walk.
function js_dartis(v, t) { return dtIsType(v, t) }

// One of dart:core's sixteen errors / exceptions: (class name, named constructor or
// "", args array). See dtExcAnc.
function js_dartexc(name, ctor, argv) { return dtExcNew(name, ctor, argv) }

// The same sixteen used as a NAME rather than called: the receiver of a named
// constructor, or a Type value. A marker object, not a class descriptor.
function js_dartexctype(name) { return {__dexcType: name} }

// A double literal, and the value of a `.toDouble()`-shaped conversion.
function js_dartflo(v) { return flo(dtNum(v), 0) }

// An int literal a double cannot hold exactly: the emitter passes its DIGITS,
// because emitNum would already have rounded 9223372036854775807 to
// 9223372036854776000 on the way into the module. (text, radix); a literal past
// the 64-bit range wraps, which is how the VM reads 0x8000000000000000.
function js_dartlit(text, radix) {
    var s = dtToStr(text)
    var rx = Math.trunc(dtNum(radix))
    var acc = 0
    var i = 0
    while (i < s.length) {
        var c = s.charAt(i)
        var d = 0 - 1
        if (c >= "0" && c <= "9") { d = c.charCodeAt(0) - 48 }
        else if (c >= "a" && c <= "f") { d = c.charCodeAt(0) - 97 + 10 }
        else if (c >= "A" && c <= "F") { d = c.charCodeAt(0) - 65 + 10 }
        if (d >= 0 && d < rx) { acc = dtIntOp("+", dtIntOp("*", acc, rx), d) }
        i = i + 1
    }
    return acc
}

// One binary operator: (op name, left, right). The operator is a compile time
// constant string, so this is one call per operator in the emitted IR. '+' also
// concatenates strings, and '+' on two Lists concatenates them, so any other
// non-numeric pair keeps the runtime's own rule.
function js_dartarith(op, l, r) {
    if (op == "+") {
        if (typeof l == "string" || typeof r == "string") { return dtStr(l) + dtStr(r) }
        if (Array.isArray(l) && Array.isArray(r)) { return dtListPlus(l, r) }
        if (!dtIsNum(l) || !dtIsNum(r)) { return dtJsAdd(l, r) }
    }
    return dtArith(op, l, r)
}

// dart:core, List.operator +: "Returns the concatenation of this list and
// other" - a NEW list holding this list's elements followed by other's, with
// neither operand touched. dtJsAdd below is JavaScript's + and renders both
// sides instead, so `[1, 2] + [3]` used to be the STRING "1,23" with length 4
// rather than the list [1, 2, 3] with length 3. No dart toolchain is installed
// here, so the dart:core signature is the oracle. The twin is js_dartarith in
// abnf/jsrtdart.go, the third half core.add in dart-interpreter.abnf.
function dtListPlus(l, r) {
    var out = []
    for (var i = 0; i < l.length; i++) { out.push(l[i]) }
    for (var j = 0; j < r.length; j++) { out.push(r[j]) }
    return out
}

// rt.jsAdd for every other non-numeric pair, and it is JavaScript's + and not
// Dart's: an object on EITHER side renders both sides with rt.toString and
// concatenates the text. Dart has no `operator +` for those shapes at all, so
// there is nothing to be faithful to and the two halves simply agree.
function dtJsAdd(l, r) {
    if (typeof l == "string" || typeof r == "string") { return dtToStr(l) + dtToStr(r) }
    if (dtIsObj(l) || dtIsObj(r)) { return dtToStr(l) + dtToStr(r) }
    return dtNum(l) + dtNum(r)
}

function js_dartlt(l, r) {
    if (dtIsNum(l) && dtIsNum(r)) {
        var c = dtCmp(l, r)
        return c !== 2 && c < 0
    }
    return dtJsCompare(l, r) < 0
}

function js_dartle(l, r) {
    if (dtIsNum(l) && dtIsNum(r)) {
        var c = dtCmp(l, r)
        return c !== 2 && c <= 0
    }
    return dtJsCompare(l, r) <= 0
}

function js_dartgt(l, r) {
    if (dtIsNum(l) && dtIsNum(r)) {
        var c = dtCmp(l, r)
        return c !== 2 && c > 0
    }
    return dtJsCompare(l, r) > 0
}

function js_dartge(l, r) {
    if (dtIsNum(l) && dtIsNum(r)) {
        var c = dtCmp(l, r)
        return c !== 2 && c >= 0
    }
    return dtJsCompare(l, r) >= 0
}

// == : value equality across int and double, then the runtime's own ===.
function js_darteq(l, r) {
    if (dtIsNum(l) && dtIsNum(r)) { return dtNumEq(l, r) }
    return l === r
}

function js_dartne(l, r) {
    if (dtIsNum(l) && dtIsNum(r)) { return !dtNumEq(l, r) }
    return l !== r
}

// identical(a, b).
function js_dartident(l, r) { return dtIdentical(l, r) }

// -x keeps the operand's TYPE: a double negates as a double (so -0.0 and
// -1.0/0.0 stay real), an int at 64 bits (so -int64min wraps back to itself).
// UNARY minus, never 0 - x: 0.0 - 0.0 is +0.0 where the floor's d_neg flips the
// sign BIT. That trap has now bitten five languages.
function js_dartneg(v) {
    if (floIs(v)) { return flo(-floNum(v), 0) }
    if (!dtIsNum(v)) { return 0 - dtNum(v) }
    return sintOp(1, 0, v)
}

// ~x flips all 64 bits (Dart's int is 64-bit two's complement).
function js_dartnot(v) { return dtIntOp("^", dtToInt(v), 0 - 1) }

// A METHOD CALL, in the shape js_mcall has: (receiver, name, args array). It
// answers num's own members (toInt, round, isEven, ...) when the receiver is a
// number and the name is one of them, and otherwise hands the call straight to
// the runtime's ordinary member dispatch.
function js_dartnm(recv, name, args) {
    if (!rtIsArr(args)) { fail("js_dartnm args must be an array") }
    if (dtIsNum(recv)) {
        var hit = dtNumMember(recv, name, args)
        if (hit.hit) { return hit.v }
    }
    // A NAMED constructor of one of dart:core's errors, reached through the postfix
    // chain: ArgumentError.value(7). js_dartexctype put the marker here.
    if (dtIsObj(recv)) {
        var tn = recv["__dexcType"]
        if (typeof tn == "string") { return dtExcNew(tn, name, args) }
    }
    return dtMember(recv, name, args)
}
