        var ai = 0
        while (ai < o.length) {
            if (args[0].apply(undefined, [o[ai]])) { return true }
            ai = ai + 1
        }
        return false
    }
    fail("unknown list method '" + name + "'")
    return undefined
}



// ===================================================== the exports ==========
//
// Everything below is a TOP-LEVEL `function js_*`, which is what -rt-lib exports
// under its own C symbol. The language-NEUTRAL externs of abnf/jsrt.go come
// first, then Dart's own seventeen in the order of abnf/jsrtdart.go.

// ----- the language-NEUTRAL thirteen ----------------------------------------
// None of these is Dart's. They live in abnf/jsrt.go, several languages emit
// them, and they are here only because the C floor does not have them yet.

// An empty Map / Python dict / Go map handle.
// js_dict_new is SHARED - lib/runtime.metajs (six identical copies, no knobs).

// Sequence indexing (negative wraps) and Map lookup: core.indexExt.
// The __getitem__ arm of the Go twin is PYTHON's and is unreachable from Dart -
// a Dart class cannot declare a member of that name.
function js_pyget(c, k) {
