// ArgumentError.toString (:227-238) with the _errorName / _errorExplanation hooks
// RangeError (:415-437) and IndexError (:535-546) override.
function dtExcArgStr(n, o) {
    var hasVal = o["__hasv"] === true
    var errName = "RangeError"
    if (n === "ArgumentError") {
        if (hasVal) { errName = "Invalid argument" } else { errName = "Invalid argument(s)" }
    }
    var nameStr = ""
    if (!dtExcNull(o["name"])) { nameStr = " (" + dtStr(o["name"]) + ")" }
    var msgStr = ""
    if (!dtExcNull(o["message"])) { msgStr = ": " + dtStr(o["message"]) }
    var prefix = errName + nameStr + msgStr
    if (!hasVal) { return prefix }
    return prefix + dtExcExpl(n, o) + ": " + dtExcSafe(o["invalidValue"])
