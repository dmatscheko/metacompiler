    var e = {__dexc: name, message: null}
    if (name === "Exception") { e["message"] = dtExcArg(argv, 0); return e }        // :24
    if (name === "FormatException") {                                              // :73
        if (argv.length > 0) { e["message"] = argv[0] } else { e["message"] = "" }
