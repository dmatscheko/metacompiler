}

// ===================================================== equality =============
//
// dtPyEqual is rt.pyEqual: containers compare BY VALUE, recursively; everything
// else falls back to strict equality. The dart emitter reaches it from exactly
// one place, a record's field-dict comparison.
function dtPyEqual(x, y) {
    var xs = dtSetElems(x)
    var ys = dtSetElems(y)
    if (xs !== undefined) {
        if (ys === undefined) { return false }
        if (xs.length != ys.length) { return false }
        var si = 0
        while (si < xs.length) {
            if (!dtSetHas(ys, xs[si])) { return false }
            si = si + 1
        }
        return true
    }
    if (ys !== undefined) { return false }
    if (rtIsArr(x)) {
        if (!rtIsArr(y)) { return false }
        if (x.length != y.length) { return false }
        var ai = 0
        while (ai < x.length) {
            if (!dtPyEqual(x[ai], y[ai])) { return false }
            ai = ai + 1
        }
        return true
    }
    if (rtIsDictObj(x)) {
        if (!rtIsDictObj(y)) { return false }
        var xk = x["keys"]
        var xv = x["vals"]
        var yk = y["keys"]
        var yv = y["vals"]
        if (xk.length != yk.length) { return false }
        var di = 0
        while (di < xk.length) {
            var j = dtDictFind(yk, xk[di])
            if (j < 0) { return false }
            if (!dtPyEqual(xv[di], yv[j])) { return false }
            di = di + 1
        }
        return true
    }
    return x === y
