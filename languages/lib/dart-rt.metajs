// ArgumentError and its two subclasses share one field set (:163-547): _hasValue
// (here __hasv, private in Dart and therefore hidden), invalidValue, name, message,
// and RangeError's start / end.
function dtExcArgNew(name, ctor, argv) {
    var e = {__dexc: name, __hasv: false, invalidValue: null, name: null, message: null,
             start: null, end: null}
    if (name === "ArgumentError") {
        if (ctor === "value") {                                                    // :204
            e["__hasv"] = true
            e["invalidValue"] = dtExcArg(argv, 0)
            e["name"] = dtExcArg(argv, 1)
            e["message"] = dtExcArg(argv, 2)
        } else if (ctor === "notNull") {                                           // :209
            e["name"] = dtExcArg(argv, 0)
            e["message"] = "Must not be null"
        } else {                                                                   // :188
            e["message"] = dtExcArg(argv, 0)
            e["name"] = dtExcArg(argv, 1)
        }
        return e
    }
    if (name === "RangeError") {
        if (ctor === "value") {                                                    // :262
            e["__hasv"] = true
            e["invalidValue"] = dtExcArg(argv, 0)
            e["name"] = dtExcArg(argv, 1)
            e["message"] = dtExcOr(dtExcArg(argv, 2), "Value not in range")
        } else if (ctor === "range") {                                             // :280
            e["__hasv"] = true
            e["invalidValue"] = dtExcArg(argv, 0)
            e["start"] = dtExcArg(argv, 1)
            e["end"] = dtExcArg(argv, 2)
            e["name"] = dtExcArg(argv, 3)
            e["message"] = dtExcOr(dtExcArg(argv, 4), "Invalid value")
