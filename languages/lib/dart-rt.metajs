// Construction. `ctor` is the named constructor's name, "" for the unnamed one.
function dtExcNew(name, ctor, argv) {
    if (name === "ArgumentError" || name === "RangeError" || name === "IndexError") {
        return dtExcArgNew(name, ctor, argv)
