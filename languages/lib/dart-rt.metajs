// which is what pyStrLen does in the Go twin.
function js_pylen(v) {
    var els = dtSetElems(v)
    if (els !== undefined) { return els.length }
    if (typeof v == "string") { return dtStrLen(v) }
    if (rtIsArr(v)) { return v.length }
    if (rtIsDictObj(v)) { return v["keys"].length }
