    var en = dtNumOf(end)
    if (en > sn) { return ": Not in inclusive range " + dtStr(start) + ".." + dtStr(end) }
    if (en < sn) { return ": Valid value range is empty" }
    return ": Only valid value is " + dtStr(start)
}

// FormatException.toString, exceptions.dart:88-169, in full - including the branch
// that quotes the offending LINE of a string source and marks the column. The floor's
// strings are UTF-16 and Dart indexes a String in UTF-16 code units, so charCodeAt /
// substring / length are exactly what the algorithm asks for.
function dtExcFormatStr(o) {
    var report = "FormatException"
    var msg = o["message"]
    if (!dtExcNull(msg) && msg !== "") { report = report + ": " + dtStr(msg) }
    var rawOff = o["offset"]
    var src = o["source"]
    if (typeof src != "string") {
        if (!dtExcNull(rawOff)) { report = report + " (at offset " + dtStr(rawOff) + ")" }
        return report
    }
    // An absent offset and an out-of-range one take the same branch (:97-99).
    var off = 0 - 1
    if (!dtExcNull(rawOff)) { off = Math.trunc(dtNumOf(rawOff)) }
    if (off > src.length) { off = 0 - 1 }
    if (off < 0) {
        var s0 = src
        if (s0.length > 78) { s0 = s0.substring(0, 75) + "..." }
        return report + "\n" + s0
    }
    var lineNum = 1
    var lineStart = 0
    var prevCR = false
    var i = 0
    while (i < off) {
        var ch = src.charCodeAt(i)
        if (ch == 10) {
            if (lineStart != i || !prevCR) { lineNum = lineNum + 1 }
            lineStart = i + 1
            prevCR = false
        } else if (ch == 13) {
            lineNum = lineNum + 1
            lineStart = i + 1
            prevCR = true
        }
        i = i + 1
    }
    if (lineNum > 1) {
        report = report + " (at line " + lineNum + ", character " + (off - lineStart + 1) + ")\n"
    } else {
