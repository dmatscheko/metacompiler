        var i = dtDictFind(c["keys"], k)
        if (i < 0) { fail("KeyError: " + dtStr(k)) }
        return c["vals"][i]
    }
    var idx = Math.trunc(dtNum(k))
    if (rtIsArr(c)) {
        if (idx < 0) { idx = idx + c.length }
        if (idx < 0 || idx >= c.length) { fail("list index out of range: " + Math.trunc(dtNum(k))) }
        return c[idx]
    }
    if (typeof c == "string") {
        var n = dtStrLen(c)
        if (idx < 0) { idx = idx + n }
        if (idx < 0 || idx >= n) { fail("string index out of range: " + Math.trunc(dtNum(k))) }
        return dtStrAt(c, idx)
