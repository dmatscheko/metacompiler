// dtIdentical is identical(): numbers have no identity apart from their value
// and their type.
function dtIdentical(a, b) {
    if (dtIsNum(a) || dtIsNum(b)) {
        if (!dtIsNum(a)) { return false }
        if (!dtIsNum(b)) { return false }
        if (dtIsFlo(a) !== dtIsFlo(b)) { return false }
        if (dtIsFlo(a)) {
            var x = floNum(a)
            var y = floNum(b)
            if (x !== x && y !== y) { return true }
            if (x === 0 && y === 0) { return dtSignBit(x) === dtSignBit(y) }
            return x === y
        }
        return sintCmp(a, b) === 0
    }
    return a === b
}

// ===================================================== member dispatch ======
//
// dtMember is rt.memberCall of abnf/jsrt.go: the LANGUAGE-NEUTRAL dispatcher
// over strings, dicts, lists and instances. The GENERATOR arm is the one that is
// not here, and it cannot be - a generator needs a coroutine primitive the floor
// does not have. Dart emits no js_genfn / js_yield at all, so nothing in this
// language can reach it.
function dtMember(recv, name, args) {
