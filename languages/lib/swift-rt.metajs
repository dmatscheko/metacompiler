// swift-rt.metajs -- SWIFT'S OWN SEMANTICS, in MetaJS: the layer-2 runtime that
// swift-to-llvm-ir.abnf links next to the C floor (languages/lib/runtime.c,
// layer 1). Externs the floor already provides generically are not repeated here.
//
// Compile with:
//     mec languages/metajs-to-llvm-ir.abnf languages/lib/swift-rt.metajs -q -rt-lib
// which is what tests/gen-swift-rt-ll.sh does; the result is the checked-in
// languages/lib/swift-rt.ll that swift-to-llvm-ir.abnf links next to runtime.ll.
// -rt-lib exports every TOP-LEVEL `function js_*` below under its own C symbol,
// so nothing else in this file is visible to the linker - the helpers are
// deliberately named sw*.
//
// THE AUTHORITATIVE SPECIFICATION IS abnf/jsrtswift.go plus the shared externs it
// layers over in abnf/jsrt.go (memberCall, js_pyget/js_pyset/js_pylen,
// js_is_type, js_jadd, js_char/js_char_code/js_kindex, js_dict_new), and this
// file matches them function for function. Where it CANNOT, the site says so in
// full.
//
// ----- the value model -------------------------------------------------------
//
//     null / undefined     ==  Swift nil. There is no Optional BOX in this
//                              model, deliberately and in both halves: Int? is
//                              just the value or nil.
//     a boolean            ==  Bool
//     a PLAIN NUMBER       ==  an Int whose value is exact in a double
//     a SIZED INTEGER      ==  an Int outside [-2^53, 2^53], or any value of a
//                              declared width (Int8 ... UInt64). The Go twin uses
//                              jsGInt (abnf/jsrtint.go); the C floor has the same
//                              thing as a REAL PRIMITIVE TYPE (tag 13) reached
//                              through the sint/sintOp/sintCmp/... host builtins.
//     a BOXED DOUBLE       ==  Double (style 0) and Float (style 3, the 32 bit
//                              width - see "the float WIDTH" below).
//                              The Go twin uses jsJFlo (abnf/jsrtjvm.go); the C
//                              floor has it as tag 14, reached through
//                              flo/floIs/floNum/... Swift never renders through
//                              floStr: every Swift print path goes through
//                              swRender, whose float arm is Swift's own SwiftDtoa
//                              rules.
//     a string             ==  String
//     an array             ==  Array
//     a {__dict} object    ==  Dictionary: keys/vals parallel arrays, INSERTION
//                              ordered (Swift's own order is the hash order and
//                              is unspecified, so any fixed order is as correct).
//     a {__tuple: n} obj   ==  a tuple; the slots are "0".."n-1" and the labels,
//                              when it has any, ride along as __tlabels.
//     a {__ecase} object   ==  an enum case: __ename, __vals, __labels.
//     a {__set} object     ==  a Set: its members in elems, insertion ordered.
//     a {__isclass} /
//       {__isenum} object  ==  a TYPE DESCRIPTOR: __name, __super, __struct,
//                              __fields.
//     any other object     ==  an instance; its descriptor is __class.
//
// ----- floor facts this file relies on ---------------------------------------
//
// Swift's two numeric types ARE the floor's tag 13 (sint*: Int8 ... UInt64) and
// tag 14 (flo*: Double/Float), so there is no i64 pair layer and no object box
// for a float in this file.
//
//  1. core.truthyExt stays at its default "js_truthy", the C FLOOR'S OWN function,
//     which answers the RAW 1/0 that compile-core's truthy() (`icmp ne <call>, 0`)
//     needs. A shim answering a boolean HANDLE would give 2 for false and make
//     every condition true, silently.
//  2. No `_raw` parameters: every operator selector the swift emitter passes -
//     js_swarith's and js_swshift's op, js_swintconv's width and signedness - is
//     emitted with emitStr/emitNum or as a real boolean handle, never with a bare
//     handle(k).
//  3. No jsChar. js_char / js_char_code / js_kindex are Kotlin's Char externs and
//     the floor has no jsChar. Swift reaches all three ONLY inside the emitter's
//     grapheme-cluster walk (sw_gcount / sw_nfd), where js_char's value is handed
//     straight to js_jadd for CONCATENATION and js_kindex's straight to
//     js_char_code. A one-character STRING makes exactly the same two round trips
//     a jsChar does in Go (rt.toString / rt.toNumber). A language that reaches
//     js_char where this equivalence does not hold has a real floor gap.
//
// ----- the scope chain is lowered in the EMITTER, not here -------------------
//
// A scope is the floor's private storage, so layer 2 cannot walk one. Name
// lookup with a `this` fallback is emitted by swift-to-llvm-ir.abnf as the IR
// helpers sw_kget / sw_kset over the floor's js_scope_typeof / get / set probes.
//
// ----- MetaJS rules that shape the code below --------------------------------
//
// docs/abnf-dialect-gotchas.md: a local (or a reassigned parameter) keeps the
// TYPE CLASS it is first assigned, so a variable that holds a number in one
// branch and an object in another is declared `var x = anytype`; there is no ASI,
// so every `return` carries its value on the same line and a value-less early
// return is BRACED; no for..in, no splice, no split/join/lastIndexOf, indexOf
// ignores its from-index, array.length is not assignable, and there are no
// exponent literals.

// The shared layer-2 runtime (lib/runtime.metajs). It supplies the externs every
// language implements identically, parameterised by the rtk* hooks below.
import "./runtime.metajs"

// Double("0x1p4")'s numeral (swFloParse).
import "./hex-float.js"

// Character's properties (swcProp) over java's Unicode classification table.
import "./java-chars.js"
import "./swift-chars.js"

// ----- the rtk* hooks the shared runtime calls -------------------------------
function rtkStr(v) { return rtJavaStr(v) }
function rtkNum(v) { return swNum(v) }
function rtkIsChar(v) { return false }
function rtkIsArr(v) { return rtIsArr(v) }
// js_supercall's one knob. This language's emitter never emits js_supercall, so
// the shared body is unreachable here; the hook is defined anyway so that the day
// it IS emitted the answer is the plain one and not a missing name.
function rtkCall(f, self, argv) { return f.apply(undefined, argv) }
// js_pyset's two knobs.
function rtkIsDict(v) { return rtIsDictObj(v) }
// A key that is an object or an array (a Set, Array, Dictionary, struct or enum
// case) is Hashable BY VALUE, so after the strict-equality miss it is looked up
// with Swift's ==. Twins: core.keyEq in swift-interpreter.abnf and the swLang arm
// of dictKeyEq in abnf/jsrt.go.
function rtkDictFind(keys, k) {
    var i = rtDictFind(keys, k)
    if (i >= 0 || !rtIsObj(k)) { return i }
    i = 0
    while (i < keys.length) {
        if (swEqual(keys[i], k, 0)) { return i }
        i = i + 1
    }
    return 0 - 1
}

// ===================================================== the two number tags ==
//
// swWhole is jsrtswift.go's swIsWhole: a sized-integer box, or a Double whose
// value is a whole number. `typeof v == "number"` is TRUE for BOTH tags, so
// every site that meant "an ordinary double" has to say so - which is what the
// floIs test below is for.
function swWhole(v) {
    if (sintIs(v)) { return true }
    if (floIs(v)) { return false }
    if (typeof v != "number") { return false }
    if (v !== v) { return false }
    if (v === Infinity) { return false }
    if (0 - v === Infinity) { return false }
    return v === Math.trunc(v)
}

// swIsNumeric: does this value take part in numeric equality at all, so that
// 1.0 == "x" is false rather than 1.0 == 0.
function swIsNumeric(v) {
    return typeof v == "number"
}

// giIsIntegral: the narrower test the ordered comparisons need - a float operand
// must NOT be truncated into an integer comparison.
function swIntegral(v) {
    if (sintIs(v)) { return true }
    if (floIs(v)) { return false }
    return typeof v == "number"
}

// swNum is giFloat, the plain-number reading of any operand: sintNum is the
// UNSIGNED-aware one an UInt box needs (int64(-1) read as a uint64 is 1.8e19),
// and it falls through to to_number for everything else.
function swNum(v) { return sintNum(v) }

// Double(x) / Float(x) of a number. A UInt64 box is width 65 (swAdoptWidth),
// which the floor reads signed, so it is read at width 64. Twin of swIntToD in
// abnf/jsrtswift.go.
function swIntToD(v) {
    if (sintIs(v) && sintUns(v)) { return sintNum(sintConv(v, 64, true)) }
    return sintNum(v)
}

// swMkFlo is jsJFlo{f: x}: style 0, which is never consulted - see the header.
function swMkFlo(x) { return flo(x, 0) }

// Double.rounded(), i.e. .toNearestOrAwayFromZero, which is Go's math.Round and
// NOT JS's Math.round: (-2.5).rounded() is -3 and Math.round(-2.5) is -2.
// Three guards:
//   - a ZERO returns itself, so (-0.0).rounded() keeps its sign. `x < 0` is FALSE
//     for -0.0, so without this the value would come back through
//     Math.floor(0.5) as +0.0 and print "0.0" where swift prints "-0.0".
//   - |x| >= 2^52: every double that large is already an integer, and x + 0.5
//     would round UP to the next one.
//   - NaN and the infinities return themselves.
function swRound(x) {
    if (x !== x) { return x }
    if (x === 0) { return x }
    if (x === Infinity) { return x }
    if (-x === Infinity) { return x }
    var a = x
    if (a < 0) { a = -a }
    if (a >= 4503599627370496) { return x }
    if (x < 0) { return -Math.floor(a + 0.5) }
    return Math.floor(a + 0.5)
}

// Double.rounded(_ rule:), the rule an unqualified case value (`.down`) read by
// name. Every rule but the default works off Math.floor, exact below 2^52 (every
// double at or above it is already integral); a zero result from a negative
// operand keeps its sign. Twin of swRoundRule in languages/swift-interpreter.abnf
// and abnf/jsrtswift.go.
function swRoundRule(x, rv) {
    var rule = "toNearestOrAwayFromZero"
    if (swIsObj(rv)) { if (rv["__ecase"] === true) { rule = rv["__ename"] } }
    if (rule === "toNearestOrAwayFromZero") { return swRound(x) }
    if (x !== x) { return x }
    if (x === 0) { return x }
    var a = x
    if (a < 0) { a = -a }
    if (a >= 4503599627370496) { return x }
    var fl = Math.floor(x)
    var up = fl
    if (fl !== x) { up = fl + 1 }
    var r = fl
    if (rule === "up") { r = up }
    else if (rule === "towardZero") { if (x < 0) { r = up } }
    else if (rule === "awayFromZero") { if (x >= 0) { r = up } }
    else if (rule === "toNearestOrEven") {
        var d = x - fl
        if (d > 0.5) { r = up }
        else if (d === 0.5) { if (fl % 2 !== 0) { r = up } }
    }
    else if (rule !== "down") { fail("unknown rounding rule: " + rule) }
    if (r === 0) { if (x < 0) { return 0 / (0 - 1) } }
    return r
}

// ===================================================== float rendering ======
//
// swFloStr is Swift's Double.description (SwiftDtoa): the shortest decimal that
// round-trips, written as a plain decimal when the scientific exponent is in
// -4 ... 15 and in computerized scientific notation - two digit minimum exponent,
// always signed - outside it, with the integral case always carrying a ".0". So
// 1e15 prints 1000000000000000.0 and 1e16 prints 1e+16. The infinities are
// "inf"/"-inf" and the NaN is "nan". This is the twin of swFloStr in
// abnf/jsrtswift.go and of the same name in swift-interpreter.abnf.
// rtFloStr (languages/lib/runtime.metajs) is the shared body; the three strings
// are the knob, and Swift's are Python's.
function swFloStr(d) { return rtFloStr(d, "nan", "inf", "-inf") }

// rtkFloDigits renders a > 0, and is the hook rtFloStr calls. The Go twin
// formats from strconv's 'e' form, which hands it the shortest round-tripping
// digit run and the scientific exponent directly. MetaJS has no such formatter,
// so the same pair is recovered from the engine's own shortest-round-trip
// rendering ("" + a) - which is jsNumString in the Go half and d_num_str in the
// floor, and both are the SAME shortest form strconv produces. That recovery is
// rtSplit10 in languages/lib/runtime.metajs; rtSciText and rtFixText are the two
// renderings.
//
// SWIFT'S OWN PART is the boundary, and it is the one of the three that is on the
// VALUE rather than the exponent: SwiftDtoa goes scientific above 2^53, and the
// two rules part between 2^53 and 1e16. 9007199254740992.0 is the last plain
// value and 9007199254740994.0 the first scientific one, read off swift 6.1.2.
// See abnf/jsrtswift.go. Swift forces no ".0" onto a one-digit mantissa
// (1e+20, not ruby's 1.0e+20), which is rtSciText's `dot` argument.
function rtkFloDigits(a) {
    var p = rtSplit10(a)
    if (p.e < 0 - 4 || a > 9007199254740992) { return rtSciText(p.d, p.e, false) }
    return rtFixText(p.d, p.e + 1)
}

// ===================================================== the float WIDTH ======
//
// A Swift `Float` is an IEEE-754 binary32, not a print style and not a Double
// spelled differently: `Float(1) / Float(3)` is 0.33333334 where the Double is
// 0.3333333333333333, and every arithmetic result has to be rounded back to 24
// significant bits. The VALUE still travels as a double (every float is exactly
// one), so the only thing that goes ON the box is the WIDTH - and the tag 14 box
// already has a byte for a per-language print tag. STYLE 3 IS THE FLOAT, the
// same style byte java and kotlin use (floJavaF in abnf/jsrtjvm.go), because it
// means the same thing there: a 24 bit significand. Only the RENDERING differs,
// and swift's never reaches the floor's jf_text - every swift print path is
// swRender, whose float arm is swFloDesc below.
//
// THE SIMPLIFICATION SWIFT GETS AND THE JVM LANGUAGES DO NOT. Swift FORBIDS
// mixed arithmetic outright: `x + y` with `let x: Float` and `let y: Double` is
// *error: binary operator '+' cannot be applied to operands of type 'Float' and
// 'Double'*, and so is `x + i` for `let i: Int` - both read off swiftc 6.1.2.
// Only an untyped LITERAL may take the other side's type. So "if either operand
// is a Float, both are" is correct for every program swiftc accepts, and none of
// kotlin's JLS-5.6.2 wider-type machinery (k1FloStyle2 / k1FloFix) is needed
// here: there is no Float-op-Double pair to get backwards.
//
// The binary32 rounding is runtime.metajs's "binary32 float" section.
//
// Three engines implement this one specification for swift: the {__flo, __f32}
// box of languages/swift-interpreter.abnf, jsJFlo{sty: floJavaF} in
// abnf/jsrtswift.go, and this file.

// swIsF32: a Float rather than a Double.
function swIsF32(v) {
    if (!floIs(v)) { return false }
    return floStyle(v) == 3
}

// swMkF32 is the Float box: jsJFlo{f: jvmFround(x), sty: floJavaF}.
function swMkF32(x) { return flo(rtF32Round(x), 3) }

// One result, rebuilt at the width its operands had.
function swReFlo(x, f32) {
    if (f32) { return swMkF32(x) }
    return swMkFlo(x)
}

// ----- Float.description ----------------------------------------------------
//
// SwiftDtoa's rule read at 24 significant bits: the SHORTEST decimal that reads
// back as the same FLOAT, plain when the scientific exponent is >= -4 and the
// value is <= 2^24, and d.ddde+nn outside it. Read off swift 6.1.2: 16777216.0
// is the last plain value and 16777218.0 prints 1.6777218e+07, exactly as
// 9007199254740992.0 / 9.007199254740994e+15 do for a Double. There is no
// two-significant-digit minimum (Float.leastNonzeroMagnitude prints "1e-45",
// where java's Float.MIN_VALUE prints "1.4E-45") and no forced ".0" on a
// one-digit mantissa, which is rtSciText's `dot` argument again.
//
// The digits come from rtSplit10, i.e. from `"" + a`, which is exact in layer 2
// (see rtDecDigits in runtime.metajs).

// The shortest decimal that round-trips as a binary32, as rtSplit10's {d, e}.
// Nine digits always do.
function swF32Sig(a) {
    var full = rtSplit10(a)
    var n = 1
    while (n < 9) {
        var c = swRoundSig(full, n)
        if (rtF32Round(swSigVal(c)) === a) { return c }
        n = n + 1
    }
    return swRoundSig(full, 9)
}

// A {d, e} pair rounded to n significant digits, half to even. The source is
// already the shortest form of the value, so a genuine tie can only be a decimal
// the double holds exactly. runtime.metajs's rtRoundDig is the same body over a
// "digits e exp" string.
function swRoundSig(p, n) {
    var ds = p.d
    var ex = p.e
    if (ds.length <= n) { return p }
    var keep = ds.substring(0, n)
    var nxt = ds.charCodeAt(n) - 48
    var up = false
    if (nxt > 5) { up = true }
    if (nxt == 5) {
        var rest = false
        var i = n + 1
        while (i < ds.length) {
            if (ds.charCodeAt(i) != 48) { rest = true }
            i = i + 1
        }
        if (rest) { up = true }
        else {
            var last = ds.charCodeAt(n - 1) - 48
            if (last - Math.floor(last / 2) * 2 == 1) { up = true }
        }
    }
    if (up) {
        var out = ""
        var carry = 1
        var k = n - 1
        while (k >= 0) {
            var dg = ds.charCodeAt(k) - 48 + carry
            carry = 0
            if (dg == 10) { dg = 0; carry = 1 }
            out = "" + dg + out
            k = k - 1
        }
        if (carry == 1) {
            out = ("1" + out).substring(0, n)
            ex = ex + 1
        }
        keep = out
    }
    var ez = keep.length
    while (ez > 1 && keep.charAt(ez - 1) == "0") { ez = ez - 1 }
    return {d: keep.substring(0, ez), e: ex}
}

// The value of a {d, e} pair. At most nine digits, so the integer part is exact;
// the power of ten is applied in chunks of 10^15, the largest one a double holds
// exactly. The relative error stays under ~1e-15, five million times finer than a
// float's half-ulp - and the only consumer is the round-trip TEST above, so an
// error that small cannot pick a wrong length.
function swSigVal(p) {
    var ds = p.d
    var k = p.e - ds.length + 1
    var m = 0
    var i = 0
    while (i < ds.length) {
        m = m * 10 + (ds.charCodeAt(i) - 48)
        i = i + 1
    }
    while (k >= 15) { m = m * 1000000000000000; k = k - 15 }
    while (k <= 0 - 15) { m = m / 1000000000000000; k = k + 15 }
    while (k > 0) { m = m * 10; k = k - 1 }
    while (k < 0) { m = m / 10; k = k + 1 }
    return m
}

// rtkFloDigits at the 32 bit width: the shortest float digits, and the boundary
// moved from 2^53 down to 2^24.
function swF32Digits(a) {
    var p = swF32Sig(a)
    if (p.e < 0 - 4 || a > 16777216) { return rtSciText(p.d, p.e, false) }
    return rtFixText(p.d, p.e + 1)
}

// rtFloStr's body with swF32Digits underneath it. rtFloStr itself cannot be
// reused: it is hard-wired to the rtkFloDigits hook, and this file already
// spends that hook on the Double.
function swF32Str(d) {
    if (d !== d) { return "nan" }
    if (d === Infinity) { return "inf" }
    if (0 - d === Infinity) { return "-inf" }
    if (d == 0) {
        if (1 / d < 0) { return "-0.0" }
        return "0.0"
    }
    if (d < 0) { return "-" + swF32Digits(0 - d) }
    return swF32Digits(d)
}

// Every rendering of a tag 14 box goes through here, because the floor cannot
// render style 3 (see the section header).
function swFloDesc(v) {
    if (floStyle(v) == 3) { return swF32Str(floNum(v)) }
    return swFloStr(floNum(v))
}

// The failable Double("3.5"), read as swift reads it with strtod: the WHOLE
// string is a sign, then a decimal numeral, a hexadecimal one (0x, an optional p
// exponent), inf, infinity or nan in any case; out of range is inf or zero. null
// for anything else - "3.5x" too, where a lenient parse would answer 3.5. Twin of
// swFloParse in swift-interpreter.abnf and abnf/jsrtswift.go.
function swFloParse(s) {
    var b = s
    var neg = false
    if (b.length > 0 && (b.charAt(0) == "+" || b.charAt(0) == "-")) {
        neg = b.charAt(0) == "-"
        b = b.substring(1, b.length)
    }
    var w = b.toLowerCase()
    if (w == "inf" || w == "infinity") { return neg ? -1 / 0 : 1 / 0 }
    if (swIsNanText(w)) { return 0 / 0 }
    if (w.length > 1 && w.charAt(0) == "0" && w.charAt(1) == "x") {
        var r = anytype
        r = hexFloatScan(b, 2)
        if (r === null || r["end"] != b.length) { return null }
        if (r["v"] == 0) { return neg ? 0 / (0 - 1) : 0 }
        return neg ? -r["v"] : r["v"]
    }
    if (!swFloText(s)) { return null }
    return parseFloat(s)
}

// strtod's NaN spellings, lower-cased and unsigned: "nan", "snan", and "nan(...)"
// with anything but a parenthesis inside. The value model has ONE NaN, so the
// sign and payload they spell are not kept. Twin of swIsNanText in
// swift-interpreter.abnf and abnf/jsrtswift.go.
function swIsNanText(w) {
    if (w == "nan" || w == "snan") { return true }
    if (w.length < 5 || w.substring(0, 4) != "nan(" || w.charAt(w.length - 1) != ")") { return false }
    var inner = w.substring(4, w.length - 1)
    return inner.indexOf("(") < 0 && inner.indexOf(")") < 0
}

// [+-]? digits [. digits] [(e|E) [+-] digits], at least one digit.
function swFloText(s) {
    var i = 0
    if (i < s.length && (s.charAt(i) == "+" || s.charAt(i) == "-")) { i = i + 1 }
    var d0 = i
    while (i < s.length && swIsDigit(s.charAt(i))) { i = i + 1 }
    var seen = i > d0
    if (i < s.length && s.charAt(i) == ".") {
        i = i + 1
        var d1 = i
        while (i < s.length && swIsDigit(s.charAt(i))) { i = i + 1 }
        if (i > d1) { seen = true }
    }
    if (!seen) { return false }
    if (i < s.length && (s.charAt(i) == "e" || s.charAt(i) == "E")) {
        i = i + 1
        if (i < s.length && (s.charAt(i) == "+" || s.charAt(i) == "-")) { i = i + 1 }
        var d2 = i
        while (i < s.length && swIsDigit(s.charAt(i))) { i = i + 1 }
        if (i == d2) { return false }
    }
    return i == s.length
}

function swIsDigit(c) { return c >= "0" && c <= "9" }

// ===================================================== integer conversion ===
//
// swIntFromStr is Int("17") / UInt8("300") / Int("ff", radix: 16): the failable
// string initializer. It answers undefined for anything that is not a complete,
// in-range integer in the radix - an optional sign, then digits and letters of
// either case. MetaJS has only the double, so the accumulation runs through
// sintOp (the floor's exact 64 bit multiply-add, which WRAPS) and the range check
// - the value read back in the radix must equal the canonical input - catches
// every wrap, exactly as it catches an out-of-width truncation. Twin of
// swIntFromStr in languages/swift-interpreter.abnf and abnf/jsrtswift.go.
function swIntFromStr(s, w, u, radix) {
    var i = 0
    var neg = false
    if (i < s.length && (s.charAt(i) == "+" || s.charAt(i) == "-")) {
        neg = s.charAt(i) == "-"
        i = i + 1
    }
    if (i >= s.length) { return undefined }
    var acc = 0
    var canon = ""
    var k = i
    while (k < s.length) {
        var d = swDigitVal(s.charCodeAt(k))
        if (d < 0 || d >= radix) { return undefined }
        acc = sintOp(0, sintOp(2, acc, radix), d)
        if (canon.length > 0 || d > 0) { canon = canon + RT_DIGITS.charAt(d) }
        // 64 significant digits is the most a 64 bit value has in any radix; past
        // that the wrap has certainly happened, and the check below would still
