    return undefined
}

// A closure's Bool result, as a MetaJS boolean: the dialect is typed, so a local
// that starts as `false` cannot later hold whatever a user closure answered.
function swTruth(v) { if (v) { return true } return false }

// {__range, lo, hi, closed} - the shape both grammars build for a...b / a..<b.
function swMkRange(lo, hi, closed) {
    var r = {__range: true}
    r["lo"] = lo
    r["hi"] = hi
    r["closed"] = closed
    return r
}

// ----- Swift's own twenty-one ------------------------------------------------

// String(describing:) / "\(v)" / the thing print writes.
function js_swdesc(v) { return swDesc(v) }

// String(x) / String(describing: x): the same text.
function js_swstr(v) { return swDesc(v) }

// String(x) and String(describing: x) are NOT one conversion, and the argument
// that tells them apart is a SEQUENCE:
//   String(s.sorted())             "ehllo"                  init(_: some Sequence<Character>)
//   String(describing: s.sorted())  ["e", "h", "l", "l", "o"]
// Every other argument shape agrees, because an unlabelled String(x) is only
// valid for a LosslessStringConvertible or a Character sequence and both of those
// render the same either way. The emitter knows the LABEL statically, so it picks
// the extern rather than passing one: js_swstrinit is the unlabelled form.
// String(reflecting:): the debug form, as inside a collection.
function js_swreflect(v) { return swRender(v, true, 0) }

function js_swstrinit(v) {
    if (rtIsArr(v)) {
        var out = ""
        var i = 0
        while (i < v.length) { out = out + swDesc(v[i]); i = i + 1 }
        return out
    }
    return swDesc(v)
}

// Swift's print(_:separator:terminator:). args is the argument ARRAY, sep the
// separator and term the terminator; nil means the default (" " and "\n").
function js_swprint(args, sep, term) {
    print(js_swprintstr(args, sep, term, false))
    return undefined
}

// The text print (debug false) or debugPrint (true) writes, for a call with
// `to:` or a debugPrint. debugPrint renders each item as it prints inside a
// collection - a String quoted and escaped. Twin of swPrintText in
// abnf/jsrtswift.go and swift-interpreter.abnf.
function js_swprintstr(args, sep, term, debug) {
    var s = " "
    if (sep !== undefined && sep !== null) { s = swDesc(sep) }
    var t = "\n"
    if (term !== undefined && term !== null) { t = swDesc(term) }
    var out = ""
    var i = 0
    while (i < args.length) {
        if (i > 0) { out = out + s }
        out = out + swRender(args[i], debug, 0)
        i = i + 1
    }
    return out + t
}

// Swift's ==. js_seq compares an Array, a Dictionary and a tuple by IDENTITY; in
// Swift all three are value types and compare element by element.
function js_sweq(l, r) { return swEqual(l, r, 0) }

// ----- parameter packs (SE-0393) -----
// A `repeat E` expansion produces a TUPLE of the per-element results, and
// `for x in repeat each p` is the one place a tuple is walked as a sequence.
function js_swtuple(arr) {
    var o = {__tuple: arr.length}
    var i = 0
    while (i < arr.length) {
        o["" + i] = arr[i]
        i = i + 1
    }
    return o
}

function js_swtuparr(o) {
    if (!swIsObj(o)) { return o }
    var n = swNumProp(o, "__tuple")
    if (n < 0) { return o }
    var out = []
    var i = 0
    while (i < n) {
        out.push(o["" + i])
        i = i + 1
    }
    return out
}

// ----- Swift's arithmetic -----
// One binary arithmetic or bitwise operator: (op, left, right). Two INTEGRAL
// operands go to the sized-integer tag, which evaluates at the result type's
// width and wraps to it; an operand that is a FLOAT BOX pulls the whole operation
// into floating point and the result is a box again.
function swOpCode(op) {
    if (op === "+") { return 0 }
    if (op === "-") { return 1 }
    if (op === "*") { return 2 }
    if (op === "/") { return 3 }
    if (op === "%") { return 4 }
    if (op === "&") { return 5 }
    if (op === "|") { return 6 }
    if (op === "^") { return 7 }
    if (op === "&^") { return 8 }
    if (op === "<<") { return 9 }
    if (op === ">>") { return 10 }
    return 0 - 1
}

// giArith, through the floor's tag: an operator the table does not have answers
// sintOp's own zero, which is what the Go twin's `rt.fail` guard would not reach
// from an emitter that only ever passes the eleven.
function swGiArith(op, l, r) {
    var c = swOpCode(op)
    if (c < 0) { fail("js_swarith: unknown operator " + op) }
    // AN INTEGER DIVISION BY ZERO IS SWIFT'S, NOT GO'S.
    // `integer divide by zero` is the text of GO'S OWN runtime panic - it is the
    // shared sized-integer layer's (languages/lib/runtime.c's si_arith and
    // abnf/jsrtint.go), correct for go and for nobody else. swiftc 6.1.2 says
    //     Swift/IntegerTypes.swift:9012: Fatal error: Division by zero
    // (`... in remainder operation` for %), so the guard stays in FRONT of the shared primitive, in swift's own file, and
    // the floor's Go-correct wording is left exactly as it is. Twins: swDivGuard in
    // languages/swift-interpreter.abnf and js_swarith in abnf/jsrtswift.go.
    if (c == 3 && swNum(r) === 0) { swAbort("Fatal error: Division by zero") }
    if (c == 4 && swNum(r) === 0) { swAbort("Fatal error: Division by zero in remainder operation") }
    return sintOp(c, l, r)
}

function js_swarith(op, l, r) {
    if (swWhole(l) && swWhole(r)) { return swGiArith(op, l, r) }
    if (op === "+") {
        if (typeof l == "string" || typeof r == "string") { return swDesc(l) + swDesc(r) }
        // Array + Array is CONCATENATION in Swift, where the shared jsAdd coerces
        // both to text ("1,23").
        if (rtIsArr(l) && rtIsArr(r)) {
            var out = rtCopyArr(l)
            var i = 0
            while (i < r.length) {
                out.push(r[i])
                i = i + 1
            }
            return out
        }
    }
    var x = swNum(l)
    var y = swNum(r)
    // A Float operand makes BOTH operands Floats and rounds the result: swift
    // forbids every mixed pair, so the only other side an untyped literal can be
    // is a Float too. Computing in double and rounding once is exactly binary32
    // + - * / % - a double carries more than 2*24+2 significand bits, so the
    // second rounding cannot move the result.
    var f32 = swIsF32(l) || swIsF32(r)
    if (f32) { x = rtF32Round(x); y = rtF32Round(y) }
    if (op === "+") { return swReFlo(x + y, f32) }
    if (op === "-") { return swReFlo(x - y, f32) }
    if (op === "*") { return swReFlo(x * y, f32) }
    if (op === "/") { return swReFlo(x / y, f32) }
    if (op === "%") { return swReFlo(x % y, f32) }
    return swGiArith(op, l, r)
}

// Swift's Double: a float literal, Double(x) and Float(x) all arrive here. A
// String source is FAILABLE, like Int("x").
function js_swflo(v) {
    if (typeof v == "string") {
        var f = anytype
        f = swFloParse(v)
        if (f === null) { return null }
        return swMkFlo(f)
    }
    if (v === undefined || v === null) { fail("Double conversion of nil") }
    if (v === true) { return swMkFlo(1) }
    if (v === false) { return swMkFlo(0) }
    return swMkFlo(swIntToD(v))
}

// Float(x): the same conversion at the 32 bit width. Every Float in a program
// comes from here or from js_swadoptf32 (a
// `let x: Float` annotation); a Float that is already one keeps its width
// through every operator above. The Go twin is js_swflo32 in abnf/jsrtswift.go.
//
// (A string is read at 64 bits and rounded to 32, where swiftc rounds once. A
// decimal that lands exactly on a float midpoint AFTER a double rounding would
// differ; no value in the corpus or the probe does.)
function js_swflo32(v) {
    if (typeof v == "string") {
        var f = anytype
        f = swFloParse(v)
        if (f === null) { return null }
        return swMkF32(f)
    }
    if (v === undefined || v === null) { fail("Float conversion of nil") }
    if (v === true) { return swMkF32(1) }
    if (v === false) { return swMkF32(0) }
    return swMkF32(swIntToD(v))
}

// `let x: Float = 1` and every other declared-Float binding site - the float half
// of the rule that makes `let d: Double = 3` hold 3.0. It passes nil through,
// which js_swflo32 aborts on.
function js_swadoptf32(v) {
    if (v === undefined || v === null) { return v }
    return js_swflo32(v)
}

// ----- Declared-type adoption -----
//
// An untyped literal takes the FLOATNESS and the WIDTH of the type it is written
