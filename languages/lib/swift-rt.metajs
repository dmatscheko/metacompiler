// below are swiftc 6.1.2's OWN, read off the
// toolchain, and abnf/jsrtswift.go's js_swidx and swIndexFail in
// swift-interpreter.abnf print exactly these.
//
//     xs[7]  Swift/ContiguousArrayBuffer.swift:692: Fatal error: Index out of range
//     s[i]   Swift/StringCharacterView.swift:158: Fatal error: String index is out of bounds
//     d[9]!  m.swift:3: Fatal error: Unexpectedly found nil while unwrapping an Optional value
//
// A missing dictionary key answers nil (`d[k]` is an Optional); the THIRD message
// is js_swforce's, and a nil base gets it too.
function swIsRange(v) {
    if (!swIsObj(v)) { return false }
    return v["__range"] === true
}
function swRangeLen(r) {
    var lo = swNum(r["lo"])
    var hi = swNum(r["hi"])
    var n = hi - lo
    if (r["closed"] === true) { n = n + 1 }
    if (n < 0) { return 0 }
    return n | 0
}
// a[1...] / a[0..<2] / s[1...3]: a RANGE subscript answers the slice. Swift's
// ArraySlice/Substring keep the ORIGINAL indices (`a[1...][1]` is a[1]), which a
// plain array cannot; the printed form, the count and every walk agree, and the
// re-indexing is the one known divergence - recorded rather than modelled,
// because a slice type is a second collection representation in three engines.
// A ONE-SIDED range carries a null bound, filled in from the receiver's length.
function swSliceBounds(r, n) {
    var lo = 0
    if (r["lo"] !== null && r["lo"] !== undefined) { lo = swNum(r["lo"]) | 0 }
    var hi = n
    if (r["hi"] !== null && r["hi"] !== undefined) {
        hi = swNum(r["hi"]) | 0
        if (r["closed"] === true) { hi = hi + 1 }
    }
    if (lo < 0 || hi > n || lo > hi) { swAbort("Fatal error: Range requires lowerBound <= upperBound") }
    var b = {lo: 0}
    b["lo"] = lo
    b["hi"] = hi
    return b
}
function swSlice(c, r) {
    if (typeof c == "string") {
        var sb = swSliceBounds(r, c.length)
        return c.substring(sb["lo"], sb["hi"])
    }
    var ab = swSliceBounds(r, c.length)
    var out = []
    var j = ab["lo"]
    while (j < ab["hi"]) { out.push(c[j]); j = j + 1 }
    return out
}

function js_swidx(c, k) {
    if (swIsRange(k) && (rtIsArr(c) || typeof c == "string")) { return swSlice(c, k) }
    if (rtIsDictObj(c)) {
        var i = swDictFind(c["keys"], k)
        if (i < 0) { return null }
        return c["vals"][i]
    }
    if (c === null || c === undefined) {
        swAbort("Fatal error: Unexpectedly found nil while unwrapping an Optional value")
    }
    var idx = swNum(k)
    if (rtIsArr(c)) {
        if (idx < 0) { idx = idx + c.length }
        if (idx < 0 || idx >= c.length) { swAbort("Fatal error: Index out of range") }
        return c[idx]
    }
    if (typeof c == "string") {
        if (idx < 0) { idx = idx + c.length }
        if (idx < 0 || idx >= c.length) { swAbort("Fatal error: String index is out of bounds") }
        return c.charAt(idx)
    }
    swAbort("Fatal error: cannot subscript a value of this type")
    return undefined
}

// `x!`: an Optional IS its value in this model, so only nil traps. Twin of
// js_swforce in abnf/jsrtswift.go and ForceSfx in swift-interpreter.abnf.
// `x as Any` of an Optional x: the Optional kept inside the Any, and the cast
// back out that unwraps it. Twins in abnf/jsrtswift.go; swCastOptAny / swOptOpen
// in languages/swift-interpreter.abnf.
function js_swoptany(v) {
    if (v === null || v === undefined) { return v }
    var o = {}
    o["__optany"] = v
    return o
}
function js_swoptopen(v) {
    if (swIsObj(v)) {
        var inner = v["__optany"]
        if (inner !== undefined) { return inner }
    }
    return v
}

// `c[k] = v`: js_pyset, except that `d[k] = nil` REMOVES the key (Dictionary's
// subscript setter takes a V?). Twins: js_swdset in abnf/jsrtswift.go and setElem
// in swift-interpreter.abnf.
function js_swdset(c, k, v) {
    if (rtIsDictObj(c) && (v === null || v === undefined)) {
        var keys = c["keys"]
        var vals = c["vals"]
        var i = rtkDictFind(keys, k)
        if (i < 0) { return undefined }
        while (i + 1 < keys.length) {
            keys[i] = keys[i + 1]
            vals[i] = vals[i + 1]
            i = i + 1
        }
        keys.pop()
        vals.pop()
        return undefined
    }
    return js_pyset(c, k, v)
}

function js_swforce(v) {
    if (v === null || v === undefined) {
        swAbort("Fatal error: Unexpectedly found nil while unwrapping an Optional value")
    }
    return v
}

// THE TOP OF THE PROGRAM: an error nobody caught. swift-to-llvm-ir.abnf wraps the
// whole program in one js_try whose catch calls this, so the value never reaches
// the floor's uncaught-throw handler in languages/lib/runtime.c, whose generic
// rendering is shared by every language. The
// wording is swiftc 6.1.2's, minus the standard-library frame it names and with the
// value rendered by swDesc, so swiftc's `m.E.boom' reads `boom' - the module
// qualification this runtime has no concept of (manual chapter 7.9).
//
// HOW A SWIFT PROGRAM DIES. A message ALREADY in swiftc's own
// wording is printed bare on stderr and exits 1 - the pattern is java's js_jvtop,
// and the twins are the fail
// override in languages/swift-interpreter.abnf and rt.swAbort in abnf/jsrtswift.go.
// An engine-level complaint that no toolchain would say ("unknown Array method: x")
// still goes through fail() and keeps its prefix, because it is the engine talking.
//
// THE EXIT CODE STAYS 1, not swiftc's 133 - see "How a Swift program DIES" in
// languages/swift-interpreter.abnf.
function swAbort(msg) {
    eprintln(msg)
    exit(1)
    return undefined
}

function js_swtop(exc) {
    swAbort("Fatal error: Error raised at top level: " + swDesc(exc))
    return undefined
}

// List element (negative wraps) or dict entry assignment.
// js_pyset is SHARED - lib/runtime.metajs (five languages, knobs rtkIsDict and
// rtkDictFind; the index coercion truncates, which is the oracle).

// len() for strings, lists, sets and dicts. Python counts CODE POINTS in a
// string, not UTF-16 code units - but Swift's own .count goes through the
// emitter's sw_gcount (grapheme clusters), so the only strings that reach this
// arm are the ones the emitter measures in code UNITS on purpose.
function js_pylen(v) {
    if (typeof v == "string") { return v.length }
    if (rtIsDictObj(v)) { return v["keys"].length }
    if (swIsObj(v) && v["__set"] !== undefined) {
        var el = v["elems"]
        if (rtIsArr(el)) { return el.length }
    }
    if (rtIsArr(v)) { return v.length }
    // A Range's .count, LAST so the array path pays nothing for it. The emitter
    // reaches the range through sw_lenr before it ever gets here, so this arm is the
    // belt to that brace: any other js_pylen site that meets a Range answers too.
    if (swIsRange(v)) { return swRangeLen(v) }
    fail("len() of a " + typeof v)
    return 0
}

// e is T. The Go twin is rt.isTypeName, and the SET OF NAMES it knows is what is
// reproduced here - including the two facts a reader would not guess: an
// Int8...UInt64 box is NOT an "Int" (the arm tests a plain float64) and a boxed
// Double is NOT a "Double". Swift's emitter handles its own enum and class names
// through the descriptor walk at the bottom, which is where `x is MyType` lands.
// js_is_type is SHARED - lib/runtime.metajs, via the rtkIsChar/rtkIsArr hooks.
//
// js_swis is what the emitter actually calls for `is` / `as?` / `as!`: the two
// facts above are not a Swift specification (swiftc 6.1.2 says `3.0 is Double` and
// `3 is Int`), and the shared probe's boolean arm spells the Java/Kotlin name
// `Boolean`, not `Bool`. The value model carries the answer already - a float box is a Double,
// the same box at style 3 is a Float, a plain integral number or a sized box is an
// integer of the width the box names - so it is answered here and every other name
// falls through to js_is_type unchanged.
//
// ONE RESIDUE, and it is the value model rather than this test: `Int` and `Int64`
// are the same width and signedness here and normalise to the same
// representation, so `8 as Int64 is Int` answers true where swiftc says false.
// Twins: swIsNamed in languages/swift-interpreter.abnf, js_swis in
// abnf/jsrtswift.go.
function swIsTyOpt(t) {
    if (t.length == 0) { return false }
    var c = t.charAt(t.length - 1)
    return c == "?" || c == "!"
}
function swStripTyOpt(t) {
    var s = t
    while (swIsTyOpt(s)) { s = s.substring(0, s.length - 1) }
    return s
}
function swStripAngleTy(s) {
    var i = 0
    while (i < s.length) {
        if (s.charAt(i) == "<") { return s.substring(0, i) }
        i = i + 1
    }
    return s
}
function js_swis(v, tname) {
    var t0 = swStripAngleTy(tname)
    var opt = swIsTyOpt(t0)
    var t = swStripTyOpt(t0)
    var bits = swAdoptWidth(t)
    var isD = t == "Double"
    var isF = t == "Float"
    var isB = t == "Bool"
    if (bits == 0 && !isD && !isF && !isB) { return js_is_type(v, tname) }
    if (v === undefined || v === null) { return opt }
    if (isB) { return typeof v == "boolean" }
    // BOTH BOXES ANSWER `typeof v == "number"` in this half - they are floor tags
    // 13 and 14, not objects the way the interpreter's are - so the box tests have
    // to come FIRST (otherwise a sized box past 2^53 would answer `is Double`).
    if (floIs(v)) { return swIsF32(v) ? isF : isD }
    if (sintIs(v)) { return sintWidth(v) == bits && sintUns(v) === swAdoptUns(t) }
