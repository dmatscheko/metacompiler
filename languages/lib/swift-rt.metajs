            }
            i = i + 1
        }
        return found
    }
    // first(where:) / last(where:); the property forms never reach here.
    if (name === "first" || name === "last") {
        i = 0
        while (i < n) {
            var fe = anytype
            fe = o[i]
            if (name === "last") { fe = o[n - 1 - i] }
            if (swTruth(args[0].apply(undefined, [fe]))) { return fe }
            i = i + 1
        }
        return null
    }
    if (name === "allSatisfy") {
        i = 0
        while (i < n) {
            if (!args[0].apply(undefined, [o[i]])) { return false }
            i = i + 1
        }
        return true
    }
    if (name === "compactMap") {
        i = 0
        while (i < n) {
            var cv = args[0].apply(undefined, [o[i]])
            if (cv !== null && cv !== undefined) { out.push(cv) }
            i = i + 1
        }
        return out
    }
    if (name === "flatMap") {
        i = 0
        while (i < n) {
            var fv = args[0].apply(undefined, [o[i]])
            if (rtIsArr(fv)) {
                var q = 0
                while (q < fv.length) { out.push(fv[q]); q = q + 1 }
            } else { out.push(fv) }
            i = i + 1
        }
        return out
    }
    // indices answers a Range; swiftc prints `0..<3` for [3, 1, 2].indices, which
    // swObjDesc's __range arm matches exactly.
    if (name === "indices") { return swMkRange(0, n, false) }
    // enumerated() answers an EnumeratedSequence whose printed form names the static
    // type, like reversed(); `Array(a.enumerated())` is what programs use, and THAT
    // is byte-exact - `[(offset: 0, element: 3), (offset: 1, element: 1), ...]`.
    if (name === "enumerated") {
        i = 0
        while (i < n) {
            var pt = {__tuple: 2}
            var lbl = []
            lbl.push("offset")
            lbl.push("element")
            pt["__tlabels"] = lbl
            pt["0"] = i
            pt["offset"] = i
            pt["1"] = o[i]
            pt["element"] = o[i]
            out.push(pt)
            i = i + 1
        }
        return out
    }
    // joined(): [String] concatenates, [[T]] flattens. swiftc's
    // `[[1,2],[3]].joined()` prints a FlattenSequence naming the static type;
