    return swSeqMethod(o, name, args)
}

// ----- The Sequence/Collection members ----------------------------------------
// Every one of these is checked against swiftc 6.1.2; the members that cannot be
// matched exactly are recorded at their arms. The twins are arraySeqMethod in
// languages/swift-interpreter.abnf and swSeqMethod in abnf/jsrtswift.go.
//
// THE REFUSAL WORDING IS "unknown Array method: X" IN ALL THREE ENGINES. The Go
// twin reaches its own copy before abnf/jsrt.go's shared list table (whose wording
// is "unknown list method 'X'"), so no swift value can land on the shared wording.

// A total order over the values a Swift Array can hold. js_swlt is Swift's own <
// (a UInt64 above 2^63 is NOT negative there, and a Double is a box, so a plain <
// would be wrong twice); a String pair compares as text.
// A user type's own `static func <` WINS (`[P(n: 3), P(n: 1)].sorted()` is
// [1, 3]): Comparable is how
// Swift sorts anything that is not a built-in, and the built-in comparison sees
// two opaque objects. The operand's type is asked first, then the other's -
// exactly what sw_opfn does for a written `a < b`.
function swSortLess(a, b) {
    var f = swFindMember(a, "<")
    if (f === undefined) { f = swFindMember(b, "<") }
    if (typeof f == "function") { return swTruth(f.apply(undefined, [a, b])) }
    if (typeof a == "string" && typeof b == "string") { return a < b }
    return js_swlt(a, b)
}

// A STABLE merge sort. Swift's own sort is introsort and is not stable, so
// stability is not a convergence claim - it is what makes the three engines agree
// with each other on equal keys, which byte-identity requires.
function swMergeSort(xs, less) {
    if (xs.length < 2) { return rtCopyArr(xs) }
    var mid = (xs.length / 2) | 0
    var la = []
    var ra = []
    var i = 0
    while (i < xs.length) {
        if (i < mid) { la.push(xs[i]) } else { ra.push(xs[i]) }
        i = i + 1
    }
    var l = swMergeSort(la, less)
    var r = swMergeSort(ra, less)
    var out = []
    var p = 0
    var q = 0
    while (p < l.length && q < r.length) {
        if (less(r[q], l[p])) { out.push(r[q]); q = q + 1 } else { out.push(l[p]); p = p + 1 }
    }
    while (p < l.length) { out.push(l[p]); p = p + 1 }
    while (q < r.length) { out.push(r[q]); q = q + 1 }
    return out
}

function swLessOf(args) {
    if (args.length > 0 && typeof args[0] == "function") { return swClosureLess(args[0]) }
    return swSortLess
}
function swClosureLess(f) {
    return function(a, b) { return f.apply(undefined, [a, b]) }
}

// THERE IS NO RANDOM SOURCE IN THIS PROJECT and there cannot be one the three
// engines agree on byte-for-byte (kotlin's k4RndBox is settled by the same
// argument, and Math.random is deleted from the goja host for it). shuffled()
// therefore draws from a DETERMINISTIC xorshift32 with a fixed seed: a program sees
// a permuted sequence, every run of every engine sees the SAME permutation, and the
// matrix's byte-identity holds by construction. A test asserts on the SORTED result
// or the count, never on the order.
var SW_RND = {s: 20260810}
function swRndNext() {
    var x = SW_RND["s"] | 0
    x = (x ^ ((x << 13) | 0)) | 0
    x = (x ^ (x >>> 17)) | 0
    x = (x ^ ((x << 5) | 0)) | 0
    if (x == 0) { x = 1 }
    SW_RND["s"] = x
    return x
}
function swRndBelow(n) {
    if (n <= 1) { return 0 }
    return (swRndNext() & 1073741823) % n
}

// The count Swift takes from prefix(k) / dropFirst(k): the argument, or the default
// 1, clamped into 0...length. swiftc traps on a negative argument; clamping to 0 is
// this project's answer, recorded rather than trapped.
function swSeqK(args, dflt, n) {
    var k = dflt
    if (args.length > 0) { k = swNum(args[0]) | 0 }
