// The canonical decimal text of a digit run - the sign and the leading zeros
// removed - for the range check above.
function swIntCanon(s, neg) {
    var i = 0
    while (i < s.length && (s.charAt(i) == "+" || s.charAt(i) == "-")) { i = i + 1 }
    while (i < s.length - 1 && s.charAt(i) == "0") { i = i + 1 }
