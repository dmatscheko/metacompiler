    if (op === "-") { return 1 }
    if (op === "*") { return 2 }
    if (op === "/") { return 3 }
    if (op === "%") { return 4 }
    if (op === "&") { return 5 }
    if (op === "|") { return 6 }
    if (op === "^") { return 7 }
