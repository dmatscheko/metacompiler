        return l
    }
    if (swIntegral(l) && swIntegral(r)) {
        var ic = sintCmp(l, r)
        if (wantGt) {
            if (ic > 0) { return l }
            return r
        }
        if (ic < 0) { return l }
        return r
    }
    // rtCompare's NaN sentinel cannot arise here: the two arms above have taken
    // every float box and every sized integer, so this arm sees strings, and a
    // string pair never coerces. Folded to 0 so the merge changes no answer.
    var jc = rtCompare(l, r)
    if (jc == 2) { jc = 0 }
    if (wantGt) {
        if (jc > 0) { return l }
        return r
    }
    if (jc < 0) { return l }
    return r
}

function js_swmax(l, r) { return swPick(l, r, true) }
function js_swmin(l, r) { return swPick(l, r, false) }

// The Double methods this subset carries, in front of the runtime's own js_mcall
// (a float box is not a shape memberCall knows). Verified against swift 6.1.2:
// 2.0.rounded() is 2.0, 2.5.squareRoot() is 1.5811388300841898 and
// 7.0.truncatingRemainder(dividingBy: 2.0) is 1.0.
function js_swmcall(recv, name, args) {
    if (!floIs(recv)) {
        // insert(_:at:) existed in no engine and aborted with *unknown Array
        // method*, found while closing docs/todo.md 1.2's append bullet. There is
        // no splice in this dialect, so the tail is shifted up by one. It sits
        // INSIDE the non-float arm so a Double method call pays nothing for it.
        // Twins: arrayMethod in languages/swift-interpreter.abnf and js_swmcall in
        // abnf/jsrtswift.go.
        if (name === "insert" && rtIsArr(recv) && args.length > 1) {
            var at = swNum(args[1]) | 0
            if (at < 0) { at = 0 }
            if (at > recv.length) { at = recv.length }
            recv.push(args[0])
            var jj = recv.length - 1
            while (jj > at) { recv[jj] = recv[jj - 1]; jj = jj - 1 }
            recv[at] = args[0]
            return undefined
        }
        return js_mcall(recv, name, args)
    }
    var f = floNum(recv)
    var a0 = 0
    if (args.length > 0) { a0 = swNum(args[0]) }
    // Every one of these keeps the RECEIVER'S width: a Float method answers a
    // Float. squareRoot is correctly rounded at 32 bits by the same
    // double-then-round argument as the operators.
    var f32 = swIsF32(recv)
    if (name === "rounded") { return swReFlo(swRound(f), f32) }
    if (name === "squareRoot") { return swReFlo(Math.sqrt(f), f32) }
    if (name === "truncatingRemainder") { return swReFlo(f % a0, f32) }
    if (name === "isMultiple") { return (f % a0) === 0 }
    if (name === "description") { return swFloDesc(recv) }
    fail("unknown Double method: " + name)
    return undefined
}

// Swift's SMART SHIFT: an over-shift answers 0 (or the sign, for a signed >>) and
// a NEGATIVE count shifts the other way - `256 >> -2` is 1024, verified against
// swift 6. sintOp already gets the over-shift right; only the negative count is
// Swift specific.
function js_swshift(op, l, r) {
    var o = op
    var n = swNum(r)
    if (sintIs(r)) { n = swNum(sintConv(r, 64, false)) }
    if (n < 0) {
        if (o === "<<") { o = ">>" } else { o = "<<" }
        n = 0 - n
    }
    return swGiArith(o, l, sintConv(n, 64, false))
}

// -x and ~x, both at the operand's own width. A fractional Double keeps the
// floating point negation, so -0.0 keeps its sign and -1.0/0.0 is -inf.
function js_swneg(v) {
    // UNARY minus: `0 - x` would answer +0.0 for -0.0 and lose the sign Swift
    // prints. The floor's d_neg flips the sign bit; see swFloStr.
    // Negation is exact, so the width is only carried, never re-rounded.
    if (!swWhole(v)) { return swReFlo(-swNum(v), swIsF32(v)) }
    return sintConv(sintOp(1, 0, v), sintWidth(v), sintUns(v))
}

function js_swnot(v) {
    return sintConv(sintOp(7, v, sintConv(0 - 1, 64, false)), sintWidth(v), sintUns(v))
}

// Int(x) / Int8(x) / UInt64(x): (value, bits, unsigned). A String source is
// FAILABLE - Swift answers nil for anything that is not a complete, in-range
// integer - and is the one conversion that does not wrap.
function js_swintconv(v, bits, uns) {
    if (typeof v == "string") {
        var r = swIntFromStr(v, bits, uns)
        if (r === undefined) { return null }
        return r
    }
    if (v === undefined || v === null) { fail("integer conversion of nil") }
    return sintConv(v, bits, uns)
}

// The four ordered comparisons. A box has to go through sintCmp rather than the
// shared jsCompare, because a UInt64 above 2^63 reads as a NEGATIVE int64 there,
// so UInt64.max < 0 would hold.
function swRel(l, r) {
    // A float box is an object to the shared comparison, so it has to be unboxed
    // first: `1.5 < 2.0` between two boxes is not a numeric comparison at all.
    // -2 is the NaN answer, on which every ordering is false.
    if (floIs(l) || floIs(r)) {
        var x = swNum(l)
        var y = swNum(r)
        // A Float operand makes the other side a Float too, so `16777217 < f`
        // compares two binary32 values - swift will only ever have put an
        // untyped literal on the other side.
        if (swIsF32(l) || swIsF32(r)) { x = swF32Round(x); y = swF32Round(y) }
        if (x < y) { return 0 - 1 }
        if (x > y) { return 1 }
        if (x !== y) { return 0 - 2 }
        return 0
    }
    if (sintIs(l) || sintIs(r)) {
        if (swIntegral(l) && swIntegral(r)) { return sintCmp(l, r) }
    }
    // rtCompare answers the SENTINEL 2 for a NaN operand; swRel's own marker for
    // "every ordering is false" is -2, which js_swlt/le/gt/ge already test. The
    // old swLoose - the fourth copy of rtCompare's body - dropped the sentinel
    // and answered 0, i.e. EQUAL, so a RAW (unboxed) NaN pair reaching this arm
    // made `<=` and `>=` TRUE. Swift makes all four false, like C# and Java.
    var c = rtCompare(l, r)
    if (c == 2) { return 0 - 2 }
    return c
}

function js_swlt(l, r) {
    var c = swRel(l, r)
    if (c === 0 - 2) { return false }
    return c < 0
}

function js_swle(l, r) {
    var c = swRel(l, r)
    if (c === 0 - 2) { return false }
    return c <= 0
}

function js_swgt(l, r) {
    var c = swRel(l, r)
    if (c === 0 - 2) { return false }
    return c > 0
}

function js_swge(l, r) {
    var c = swRel(l, r)
    if (c === 0 - 2) { return false }
    return c >= 0
}

// The members a sized integer or a Double answers for itself. Everything else
// falls straight through to the plain member read the grammar already emitted, so
// this is only ever a type switch in front of it.
function js_swget(v, k) {
    if (floIs(v)) {
        var f = floNum(v)
        if (k === "isNaN") { return f !== f }
        if (k === "isInfinite") { return f === Infinity || 0 - f === Infinity }
        if (k === "isFinite") { return f === f && f !== Infinity && 0 - f !== Infinity }
        if (k === "isZero") { return f === 0 }
        if (k === "description") { return swFloDesc(v) }
        if (k === "magnitude") { return swReFlo(Math.abs(f), swIsF32(v)) }
    }
    if (sintIs(v)) {
        if (k === "description") { return sintStr(v) }
        if (k === "bitWidth") { return sintWidth(v) }
        if (k === "magnitude") {
            if (!sintUns(v) && sintCmp(v, 0) < 0) { return sintConv(sintOp(1, 0, v), sintWidth(v), sintUns(v)) }
            return v
        }
    }
    // The same three on a value that stayed a plain number, which is where every
    // integer inside +/- 2^53 lives.
    if (typeof v == "number") {
        if (k === "description") { return swDesc(v) }
        if (k === "bitWidth") { return 64 }
        if (k === "magnitude") { return Math.abs(v) }
    }
    return v[k]
}
