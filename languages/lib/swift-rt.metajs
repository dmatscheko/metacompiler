// languages/swift-interpreter.abnf and js_swrandom* in abnf/jsrtswift.go.
function js_swrandom(r) {
    var n = swRangeLen(r)
    if (n <= 0) { swAbort("Fatal error: Can't get random value with an empty range") }
    return swRangeAt(r["lo"], swRndBelow(n))
}
function swRandomFlo(r, f32) {
    var uf = (swRndNext() & 1073741823) / 1073741824
    var flo = swNum(r["lo"])
    return swReFlo(flo + uf * (swNum(r["hi"]) - flo), f32)
}
function js_swrandomd(r) { return swRandomFlo(r, false) }
function js_swrandomf(r) { return swRandomFlo(r, true) }
function swRndBelow(n) {
    if (n <= 1) { return 0 }
    return (swRndNext() & 1073741823) % n
}

// The count Swift takes from prefix(k) / dropFirst(k): the argument, or the default
// 1, clamped into 0...length. swiftc traps on a negative argument; clamping to 0 is
// this project's answer, recorded rather than trapped.
function swSeqK(args, dflt, n) {
    var k = dflt
    if (args.length > 0) { k = swNum(args[0]) | 0 }
    if (k < 0) { k = 0 }
    if (k > n) { k = n }
    return k
}

function swSubArr(t, a, b) {
    var out = []
    var i = a
    while (i < b) { out.push(t[i]); i = i + 1 }
    return out
}
// Collection.split, step for step; the arguments are told apart by type because
// the labels do not reach here. Twins: swSplitSeq in
// languages/swift-interpreter.abnf and abnf/jsrtswift.go.
function swSplitSeq(t, args) {
    var pred = anytype
    pred = undefined
    var sep = anytype
    sep = undefined
    var maxS = 0 - 1
    var omit = true
    var i = 0
    while (i < args.length) {
        if (typeof args[i] == "function") { pred = args[i] }
        i = i + 1
    }
    var j = 0
    while (j < args.length) {
        var a = args[j]
        if (typeof a == "boolean") { omit = a }
        else if (typeof a != "function") {
            if (j == 0 && pred === undefined) { sep = a } else { maxS = swNum(a) | 0 }
        }
        j = j + 1
    }
    var n = t.length
    var res = []
    if (maxS == 0 || n == 0) {
        if (n > 0 || !omit) { res.push(swSubArr(t, 0, n)) }
        return res
    }
    var start = 0
    var end = 0
    while (end < n) {
        var isSep = false
        if (pred !== undefined) { isSep = swTruth(pred.apply(undefined, [t[end]])) }
        else { isSep = swEqual(t[end], sep, 0) }
        if (isSep) {
            var did = false
            if (!(start == end && omit)) { res.push(swSubArr(t, start, end)); did = true }
            end = end + 1
            start = end
            if (did && res.length == maxS) { break }
        } else {
            end = end + 1
        }
    }
    if (start != n || !omit) { res.push(swSubArr(t, start, n)) }
    return res
}

function swSeqMethod(o, name, args) {
    var i = 0
    var out = []
    var n = o.length
    if (name === "isEmpty") { return n == 0 }
    // append(contentsOf:): the emitter hands over the elements as an array
    // (rtLabelMeth in languages/swift-to-llvm-ir.abnf).
    if (name === "$appendSeq") {
        var xs = args[0]
        if (Array.isArray(xs)) {
            i = 0
            while (i < xs.length) { o.push(xs[i]); i = i + 1 }
        }
        return undefined
    }
    // In place; a replacement that is not an array is one element (a String
    // receiver's text, joined back by rtStrMut). Twins: arrayMethod in
    // languages/swift-interpreter.abnf, swSeqMethod in abnf/jsrtswift.go.
    if (name === "removeSubrange" || name === "replaceSubrange") {
        var rb = swSliceBounds(args[0], n)
        var ins = []
        if (name === "replaceSubrange") {
            if (Array.isArray(args[1])) { ins = args[1] } else { ins.push(args[1]) }
        }
        i = 0
        while (i < rb["lo"]) { out.push(o[i]); i = i + 1 }
        i = 0
        while (i < ins.length) { out.push(ins[i]); i = i + 1 }
        i = rb["hi"]
        while (i < n) { out.push(o[i]); i = i + 1 }
        swSetRepl(o, out)
        return undefined
    }
    // removeFirst() answers the element; removeFirst(k) answers Void. Both trap on
    // an empty array, with swiftc 6.1.2's own two messages.
    if (name === "removeFirst") {
        if (args.length == 0) {
            if (n == 0) { swAbort("Fatal error: Can't remove first element from an empty collection") }
            var f0 = o[0]
            i = 0
            while (i < n - 1) { o[i] = o[i + 1]; i = i + 1 }
            o.pop()
            return f0
        }
        var rk = swNum(args[0]) | 0
        if (rk < 0 || rk > n) { swAbort("Fatal error: Can't remove more items from a collection than it contains") }
        i = 0
        while (i < n - rk) { o[i] = o[i + rk]; i = i + 1 }
        i = 0
        while (i < rk) { o.pop(); i = i + 1 }
        return undefined
    }
    if (name === "remove") {
        var ai = swNum(args[0]) | 0
        if (ai < 0 || ai >= n) { swAbort("Fatal error: Index out of range") }
        var rv = o[ai]
        i = ai
        while (i < n - 1) { o[i] = o[i + 1]; i = i + 1 }
        o.pop()
        return rv
    }
    if (name === "removeAll") {
        if (args.length > 0 && typeof args[0] == "function") {
            var keep = []
            i = 0
            while (i < n) {
                if (!args[0].apply(undefined, [o[i]])) { keep.push(o[i]) }
                i = i + 1
            }
            while (o.length > 0) { o.pop() }
            i = 0
            while (i < keep.length) { o.push(keep[i]); i = i + 1 }
            return undefined
        }
        while (o.length > 0) { o.pop() }
        return undefined
    }
    // reversed() answers a ReversedCollection in Swift, whose printed form names the
    // STATIC element type - `ReversedCollection<Array<Int>>(_base: [3, 1, 2])`. That
    // needs a type checker (manual 7.9's Optional argument exactly), so a plain
    // reversed ARRAY is answered: every use except printing the collection itself
    // agrees, and `print(a.reversed())` is the one known divergence.
    if (name === "reversed") {
        i = n - 1
        while (i >= 0) { out.push(o[i]); i = i - 1 }
        return out
    }
    if (name === "sorted") { return swMergeSort(o, swLessOf(args)) }
    if (name === "sort") {
        var so = swMergeSort(o, swLessOf(args))
        i = 0
        while (i < n) { o[i] = so[i]; i = i + 1 }
        return undefined
    }
    if (name === "randomElement") {
        if (n == 0) { return null }
        return o[swRndBelow(n)]
    }
    if (name === "shuffled") {
        out = rtCopyArr(o)
        i = out.length - 1
        while (i > 0) {
            var j = swRndBelow(i + 1)
            var tmp = out[i]
            out[i] = out[j]
            out[j] = tmp
            i = i - 1
        }
        return out
    }
    if (name === "swapAt") {
        var sx = swNum(args[0]) | 0
        var sy = swNum(args[1]) | 0
        if (sx < 0 || sx >= n || sy < 0 || sy >= n) { swAbort("Fatal error: Index out of range") }
        var sv = o[sx]
        o[sx] = o[sy]
        o[sy] = sv
        return undefined
    }
    // min()/max() answer an Optional in Swift and this value model has none (manual
    // 7.9), so `print(a.min())` reads `1` where swiftc prints `Optional(1)`. The
    // EMPTY case answers nil, which swiftc prints as `nil` too, so that row is exact.
    if (name === "min" || name === "max") {
        if (n == 0) { return null }
        var less = swLessOf(args)
        var best = anytype
        best = o[0]
        i = 1
        while (i < n) {
            // Sequence.min/max(by:) replace the running answer only when the
            // next element orders strictly before / after it, so a tie (or a
            // NaN) keeps the EARLIER element.
            if (name === "min") {
                if (less(o[i], best)) { best = o[i] }
            } else {
                if (less(best, o[i])) { best = o[i] }
            }
            i = i + 1
        }
        return best
    }
    // prefix(while:) / drop(while:): the leading run the predicate holds for, and
    // what follows it.
    if ((name === "prefix" || name === "drop") && args.length > 0 && typeof args[0] == "function") {
        var run = 0
        while (run < n && swTruth(args[0].apply(undefined, [o[run]]))) { run = run + 1 }
        if (name === "prefix") { return swSubArr(o, 0, run) }
        return swSubArr(o, run, n)
    }
    if (name === "split") { return swSplitSeq(o, args) }
    // starts(with:) / elementsEqual(_:) compare element by element with ==.
    if (name === "starts" || name === "elementsEqual") {
        var other = args[0]
        if (swIsObj(other) && other["__set"] === true) { other = other["elems"] }
        if (other.length > n) { return false }
        if (name === "elementsEqual" && other.length !== n) { return false }
        i = 0
        while (i < other.length) {
            if (!swEqual(o[i], other[i], 0)) { return false }
            i = i + 1
        }
        return true
    }
    if (name === "prefix") {
        var pk = swSeqK(args, 1, n)
        i = 0
        while (i < pk) { out.push(o[i]); i = i + 1 }
        return out
    }
    if (name === "suffix") {
        var sk = swSeqK(args, 1, n)
        i = n - sk
        while (i < n) { out.push(o[i]); i = i + 1 }
        return out
    }
    if (name === "dropFirst") {
        var dk = swSeqK(args, 1, n)
        i = dk
        while (i < n) { out.push(o[i]); i = i + 1 }
        return out
    }
    if (name === "dropLast") {
        var lk = swSeqK(args, 1, n)
        i = 0
        while (i < n - lk) { out.push(o[i]); i = i + 1 }
        return out
    }
    // firstIndex/lastIndex take either `of:` (a value) or `where:` (a closure) and
    // answer an Optional - the same divergence as min/max, and nil for "not found",
    // which IS what swiftc prints.
    if (name === "firstIndex" || name === "lastIndex" || name === "index") {
        var wantLast = name === "lastIndex"
        var found = anytype
        found = null
        i = 0
        while (i < n) {
            var hit = false
            if (typeof args[0] == "function") { hit = swTruth(args[0].apply(undefined, [o[i]])) }
            else { hit = swEqual(o[i], args[0], 0) }
            if (hit) {
                if (!wantLast) { return i }
