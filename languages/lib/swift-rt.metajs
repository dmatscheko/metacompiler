        if (k === "isFinite") { return f === f && f !== Infinity && 0 - f !== Infinity }
        if (k === "isZero") { return f === 0 }
        if (k === "description") { return swFloDesc(v) }
        if (k === "magnitude") { return swReFlo(Math.abs(f), swIsF32(v)) }
    }
    if (sintIs(v)) {
        if (k === "description") { return sintStr(v) }
        if (k === "bitWidth") { return sintWidth(v) > 64 ? 64 : sintWidth(v) }
        // magnitude is the UNSIGNED type of the same width (swiftc 6.1.2).
        if (k === "magnitude") {
            if (!sintUns(v) && sintCmp(v, 0) < 0) { return sintConv(sintOp(1, 0, v), sintWidth(v), true) }
            return sintConv(v, sintWidth(v), true)
        }
    }
    // indices is a PROPERTY on every Collection. Only an Array is answered: a String's indices are String.Index values
    // with no printable form here. swiftc 6.1.2 prints `0..<3` for [3, 1, 2].indices.
    if (k === "indices" && rtIsArr(v)) { return swMkRange(0, v.length, false) }
    // A String's views, as arrays: `.utf8` the UTF-8 bytes and `.unicodeScalars`
    // one String per code point. Twins: swGetField in
    // languages/swift-interpreter.abnf and js_swget in abnf/jsrtswift.go.
    if (typeof v == "string") {
        if (k === "utf8") { return swUtf8Of(v) }
        if (k === "unicodeScalars") { return swScalarsOf(v) }
    }
    // `.description` of a built-in value is its String(describing:).
    if (k === "description") {
        if (typeof v == "string" || typeof v == "boolean" || rtIsArr(v) || rtIsDictObj(v) || swIsRange(v)) { return swDesc(v) }
        if (swIsObj(v) && v["__set"] === true) { return swDesc(v) }
    }
    // A Dictionary's values, as a copy. The Go twin answers it in abnf/jsrt.go's js_get.
    if (k === "values" && rtIsDictObj(v)) { return rtCopyArr(v["vals"]) }
    // The same three on a value that stayed a plain number, which is where every
    // integer inside +/- 2^53 lives.
    if (typeof v == "number") {
        if (k === "description") { return swDesc(v) }
        if (k === "bitWidth") { return 64 }
        if (k === "magnitude") { return sintConv(Math.abs(v), 64, true) }
    }
    return v[k]
}
