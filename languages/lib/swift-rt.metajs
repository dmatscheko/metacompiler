    if (name === "joined") {
        var allArr = n > 0
        i = 0
        while (i < n) {
            if (!rtIsArr(o[i])) { allArr = false }
            i = i + 1
        }
        if (allArr && args.length == 0) {
            i = 0
            while (i < n) {
                var z = 0
                while (z < o[i].length) { out.push(o[i][z]); z = z + 1 }
                i = i + 1
            }
            return out
        }
        var sep = ""
        if (args.length > 0) { sep = swDesc(args[0]) }
        var js = ""
        i = 0
        while (i < n) {
            if (i > 0) { js = js + sep }
            js = js + swDesc(o[i])
            i = i + 1
        }
        return js
    }
    // reduce(initial, combine) and reduce(into: seed, combine). The labels do not
    // reach here, so the two forms are told apart by WHAT THE CLOSURE ANSWERS: an
    // `into` body mutates its accumulator and returns Void. Measured against swiftc:
