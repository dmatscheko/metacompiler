        if (crty !== undefined) {
            var crc = "pastEnd"
            if (v["v"] !== undefined) { crc = "inRange(" + swRender(v["v"], false, depth + 1) + ")" }
            if (nested) { return "(extension in Swift):Swift.ClosedRange<Swift." + crty + ">.Index." + crc }
            return crc
        }
