// swCopyArr is SHARED as rtCopyArr - lib/runtime.metajs.

// The Kotlin/Python list methods of rt.memberCall, in its order.
function swListMethod(o, name, args) {
    if (name === "add") {
        o.push(args[0])
        return true
    }
    if (name === "append") {
        o.push(args[0])
        return undefined
    }
    if (name === "pop" || name === "removeLast") {
        if (o.length == 0) { fail("pop from empty list") }
        return o.pop()
    }
    if (name === "size") { return o.length }
    if (name === "get") {
        var gi = swNum(args[0])
        if (gi < 0 || gi >= o.length) { fail("list index out of range") }
        return o[gi]
    }
    // contains(_:) is a value test by Swift's == and contains(where:) a PREDICATE;
    // the label does not reach here, so the closure argument is what tells them
    // apart (`[1, 3].contains(where: { $0 > 2 })` is true).
    if (name === "contains") {
        var ci = 0
        if (args.length > 0 && typeof args[0] == "function") {
            while (ci < o.length) {
                if (args[0].apply(undefined, [o[ci]])) { return true }
                ci = ci + 1
            }
            return false
        }
        while (ci < o.length) {
            if (swEqual(o[ci], args[0], 0)) { return true }
            ci = ci + 1
        }
        return false
    }
    if (name === "map") {
        var mo = []
        var mi = 0
        while (mi < o.length) {
            mo.push(args[0].apply(undefined, [o[mi]]))
            mi = mi + 1
        }
        return mo
    }
    if (name === "filter") {
        var fo = []
        var fi = 0
        while (fi < o.length) {
            if (args[0].apply(undefined, [o[fi]])) { fo.push(o[fi]) }
            fi = fi + 1
        }
        return fo
    }
    if (name === "forEach") {
        var ei = 0
        while (ei < o.length) {
            args[0].apply(undefined, [o[ei]])
            ei = ei + 1
        }
        return undefined
    }
    if (name === "count") {
        if (args.length == 0) { return o.length }
        var n = 0
        var ni = 0
        while (ni < o.length) {
            if (args[0].apply(undefined, [o[ni]])) { n = n + 1 }
            ni = ni + 1
        }
        return n
    }
    if (name === "any") {
        var ai = 0
        while (ai < o.length) {
            if (args[0].apply(undefined, [o[ai]])) { return true }
            ai = ai + 1
        }
        return false
