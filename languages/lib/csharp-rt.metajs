        if (typeof r == "string") {
            if (r.length != 1) { return false }
            return r.charCodeAt(0) == l["__char"]
        }
        if (csIsChar(r)) { return l["__char"] === r["__char"] }
        if (rtIsPlainNum(r)) { return l["__char"] === r }
        if (sintIs(r)) { return csCmp("==", l, r) }
        if (floIs(r)) { return floEq(flo(l["__char"], 2), r) }
        return false
    }
    if (csIsChar(r)) { return js_jchareq(r, l) }
    return rtjStrictEq(l, r)
}

// The floor's === with the two number boxes taught to it is rtjStrictEq - SHARED
// with java, lib/runtime-jvm.metajs, its ONE knob being rtjkCmp. Its sized-integer
// arm is a FIX the merge found: floEq (jf_num_eq / jvmNumEq) has no tag 13 case,
// so `long == double` answered false in BOTH compiler engines while both
// interpreter halves answered true. See the note at the shared body.
//
// csValueEq above deliberately does NOT take that arm: it is rt.dictFind's
// equality, i.e. object identity for a dictionary KEY, and neither language calls
// a boxed long and a boxed double the same key.

// (target, method name, args array). The Go twin (rt.memberCall in abnf/jsrt.go) is
// a LANGUAGE-NEUTRAL dispatcher; only the arms csharp-to-llvm-ir.abnf can reach are
// here, and the ones it cannot are named at the fallthrough rather than guessed at.
// C#'s method-call entry point. It exists for the same reason js_ktsmcall and
// js_swmcall do: the Go extern table is filled ONCE for every language, so a
// wrapper on js_mcall itself would give the other fifteen C#'s answers - observed,
// with a C# Substring raising java's "Range [10, 6) out of bounds for length 6".
//
// It adds the three members of the System.Object contract that no receiver could
// answer (docs/todo.md 1.6). ECMA-334 8.2.3: EVERY type inherits Equals,
// GetHashCode, GetType and ToString from object. Only ToString was routed, so
// `v[0].Equals((object) v[1])` aborted this half with "method call 'equals' on a
// number" and the interpreter with "unknown method 'Equals'". A user override still
// wins - csUserMethod is the __class/__super walk js_mcall does anyway. The twin is
// mcall0 in languages/csharp-interpreter.abnf.
function js_csmcall(recv, name, args) {
