}

// js_csdfld(recv, name): the DELEGATE stored in a member of that name, or undefined.
// `k.E(5)` on a delegate field parses as a method call and C# resolves it as the
// invocation of the field's value (ECMA-334 12.8.10.2). Safe for any receiver - a
// string, a List, a dictionary all answer undefined and the call site then reaches
// js_mcall exactly as it did before. The twins are the delegate fallback in
// mcall0 (languages/csharp-interpreter.abnf) and js_csdfld in abnf/jsrtcsharp.go.
function csIsDelegVal(v) {
