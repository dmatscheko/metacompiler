        // here; the walk is what reaches one inherited from a base.
        var sc = recv
        var g1 = 0
        while (g1 < 64) {
            g1 = g1 + 1
            if (sc === undefined || sc === null) { return undefined }
            if (typeof sc != "object") { return undefined }
            var sv = sc[name]
            if (csIsFn(sv)) { return sv }
            sc = sc["__super"]
        }
        return undefined
    }
    var cls = recv["__class"]
    if (cls === undefined || cls === null) { return undefined }
    var m = rtFindMethod(cls, name)
    if (!csIsFn(m)) { return undefined }
    var key = "__mg_" + name
    var had = recv[key]
    if (had !== undefined) { return had }
    recv[key] = bound
    return bound
}

// ----- `ref` / `out` arguments: the REFERENCE BOX (docs/todo.md 1.1) -----
//
// ECMA-334 12.6.2.3.3 makes a `ref` argument's parameter an ALIAS for the argument's
// variable. Nothing in this value model can alias a scope slot, so the emitter builds
// `{__csref, rd, wb}` - two emitted closures over the place - at the call site and
// emits these two probes around every read and write of a `ref` PARAMETER's name.
// Both are total: anything that is not a box passes straight through, which is what
// lets the emitter gate on the NAME alone and emit no basic blocks. The twins are
// js_csrefrd / js_csrefwr in abnf/jsrtcsharp.go and csGetVar / csSetVar in
// languages/csharp-interpreter.abnf.
function csIsRefBox(v) {
    if (v === undefined || v === null) { return false }
    if (typeof v != "object") { return false }
    if (Array.isArray(v)) { return false }
    return v["__csref"] === true
}
function js_csrefrd(v) {
    if (!csIsRefBox(v)) { return v }
    var f = v["rd"]
    return f()
}
// Writes v THROUGH the box and answers the box, so the scope store the emitter puts
// after it re-stores the same handle; a plain slot answers v and that store is the
// ordinary one.
function js_csrefwr(cur, v) {
    if (!csIsRefBox(cur)) { return v }
    var f = cur["wb"]
    f(v)
