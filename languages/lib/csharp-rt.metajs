// String.Substring with the Go twin's substringRange clamping.
// js_supercall is SHARED - lib/runtime.metajs (four languages, one knob: rtkCall).

// `a[lo..hi]`, C#'s range indexer, on a string or an array: the elements are
// COPIED and an absent bound arrives as undefined, reading as 0 / the length.
//
// It used to be named js_goslice, the SHARED extern, and that is Go's slice and
// not C#'s: a Go string is a byte sequence, so js_goslice takes a BYTE window
// while System.Range on a System.String is Substring - UTF-16 code units
// (ECMA-334 12.8.12 / String.Substring). `"日本語"[0..1]` therefore answered a
// lone replacement character under llvm.Run, where the Go twin's byte arm ran,
// and "日" here and in the interpreter. One name was carrying two
// specifications; C# has its own now and js_goslice stays Go's. The twin is
// js_csslice in abnf/jsrtcsharp.go.
function js_csslice(v, lo0, hi0) {
    if (typeof v == "string") {
        var slo = lo0 === undefined ? 0 : rtjNum(lo0)
        var shi = hi0 === undefined ? v.length : rtjNum(hi0)
        if (slo < 0 || shi > v.length || slo > shi) { fail("slice bounds [" + slo + ":" + shi + "] out of range") }
        return v.substring(slo, shi)
    }
    if (!Array.isArray(v)) {
        fail("slicing a " + typeof v)
        return undefined
    }
    var lo = lo0 === undefined ? 0 : rtjNum(lo0)
    var hi = hi0 === undefined ? v.length : rtjNum(hi0)
    if (lo < 0 || hi > v.length || lo > hi) { fail("slice bounds [" + lo + ":" + hi + "] out of range") }
    var out = []
    var i = lo
    while (i < hi) {
        out.push(v[i])
        i = i + 1
    }
    return out
}

// js_gospread is the C FLOOR's now (lib/runtime.c, next to js_bytelen). It was
// HERE and in go-rt.metajs; the two copies were one specification, unlike js_has
// and js_csslice, which mean genuinely different things in Go and in C# (BYTE
// offsets vs UTF-16 code units) and therefore stay split. Two definitions of the
// name is a duplicate-symbol link error, so the floor body and this deletion are
// ONE change.

// ----- C#'s own eighteen ----------------------------------------------------

// One binary integral operator: (op, left, right). A double operand keeps the FLOAT
// path of abnf/jsrtjvm.go, which is where the two number tags meet; two bools take
// C#'s non-short-circuit & | ^.
function js_csarith(op, l, r) {
    // The one host call the DOUBLE path pays for the float width: floStyle of a
    // result that is not style 5 is the whole test, because style 5 can only have
    // come off a C# float operand.
    if (floIs(l) || floIs(r)) { var rf = rtjArith(op, l, r); if (floStyle(rf) == 5) { return csFloFix(op, rf, l, r) } return rf }
    if (typeof l == "boolean") {
        if (typeof r == "boolean") {
            if (op == "&") { return l && r }
            if (op == "|") { return l || r }
            if (op == "^") { return l !== r }
        }
    }
    if (!rtjIsIntegral(l) || !rtjIsIntegral(r)) { var rg = rtjArith(op, l, r); if (floStyle(rg) == 5) { return csFloFix(op, rg, l, r) } return rg }
    return csArith(op, l, r)
}

function js_csshift(op, l, r) { return csShift(op, l, r) }

// The body is rtjRel - SHARED with java's js_jvcmp, lib/runtime-jvm.metajs. The
// NaN sentinel it carries (ECMA-334 12.12.1: every floating point relation with a
// NaN operand is false) was fixed HERE in Part A and was still wrong in java's
// copy months later, in both engines, in two different directions. That is why
// the two are one body now. abnf/jsrtcsharp.go:477 is the same three lines; the
// two halves have to move together or --cross reports it.
function js_cscmp(op, l, r) {
    // THE INTEGRAL FAST PATH IS SPELLED OUT rather than reached through rtjRel,
    // and that is a MEASUREMENT: 8f43e84 put the float question in FRONT of the
    // same body in java and paid +5.32% against a 4.96% spread, because a loop
    // condition `i < n` is the hot case. rtjRel's own first line is this arm
    // (rtjIsIntegral already excludes a float box), so it is the same answer by
    // construction.
    if (rtjIsIntegral(l) && rtjIsIntegral(r)) { return rtjkCmp(op, l, r) }
    if (csFloPromotes(l, r)) { return rtjRel(op, flo(csF32Round(rtjNum(l)), 5), flo(csF32Round(rtjNum(r)), 5)) }
    return rtjRel(op, l, r)
}

// A cast or a declared integral type: (value, bits, unsigned).
function js_csconv(v, bits, uns) { return csConvTo(v, rtjNum(bits), uns === true) }

// A declared type applied to an initializer: only an INTEGRAL value converts, so
// `object o = "s"` and a lambda pass through untouched.
function js_csadopt(v, bits, uns) {
    if (!rtjIsIntegral(v)) { return v }
    var w = rtjNum(bits)
    var u = (uns === true)
    // Adopting a value that ALREADY carries the width and signedness is the
    // identity, and saying so keeps a declared-type write allocation-free (see
    // js_csadoptty for the measurement). Sized integers are compared BY VALUE by
    // the floor's strict_eq, so handing back the same cell is not observable.
    if (sintIs(v)) { if (sintWidth(v) == w && sintUns(v) === u) { return v } }
    else if (w == 32 && !u && typeof v == "number") { return v }
    return csConvTo(v, w, u)
}

// csIsNumericV: can this value be CONVERTED to a double / float by an implicit
// numeric conversion? A plain number (an `int` here), a sized integer or a float
// box - all three are `typeof "number"` here, because they are tagged handles,
// and a char box is not, which is exactly the set. A char is deliberately NOT one:
// the interpreter's csImplicitConv declines it too, and the halves have to agree.
function csIsNumericV(v) { return typeof v == "number" }

// js_csadoptty(v, ty) is ECMA-334 10.2.3's implicit numeric conversion at a
// DECLARED TYPE NAME - a parameter, a method's return type, a field or an
// auto-property - and it is the twin of csImplicitConv's numeric arms in
// languages/csharp-interpreter.abnf and of js_csadoptty in abnf/jsrtcsharp.go. It
// is what makes
//
//     static double G(double x) { return x / 2; }   G(3)
//
// answer 1.5 rather than the 1 an int division gave: THE WIDTH IS ON THE VALUE,
// NOT THE ANNOTATION, so nothing but a conversion at the binding site can put it
// there (docs/todo.md 1.1). Anything that is not numeric is handed back unchanged.
function js_csadoptty(v, ty) {
    // ADOPTING A VALUE THAT ALREADY CARRIES THE TYPE IS THE IDENTITY, and saying so
    // here is not a micro-optimisation: without it every write to a declared-type
    // slot re-boxed, and `long i; while (...) { i = i + 1; }` allocated a fresh
    // 64-bit cell per iteration - measured at +15.8% on tests/bench/mod.cs against
    // a 1.94% spread when the local-write site started adopting (docs/todo.md 1.3).
    // A sized-integer box and a float box are compared BY VALUE by the floor's
    // strict_eq (manual 7.9), so returning the same object rather than a copy is
    // not observable. The twin is js_csadoptty in abnf/jsrtcsharp.go.
    if (ty == "float") {
        if (floIs(v) && floStyle(v) == 5) { return v }
        if (!csIsNumericV(v)) { return v }
        return flo(csF32Round(rtjNum(v)), 5)
    }
    if (ty == "double" || ty == "decimal") {
        if (floIs(v) && floStyle(v) == 2) { return v }
        if (!csIsNumericV(v)) { return v }
        return flo(rtjNum(v), 2)
    }
    var bits = csTypeW(ty)
    if (bits == 0) { return v }
    if (!rtjIsIntegral(v)) { return v }
    var uns = csTypeU(ty)
    if (sintIs(v)) { if (sintWidth(v) == bits && sintUns(v) === uns) { return v } }
    else if (bits == 32 && !uns && typeof v == "number") { return v }
    return csConvTo(v, bits, uns)
}

// js_csadoptarr(v, ty): `double[] a = {3, 4}` types the ELEMENTS, so a[0] / 2 is
// 1.5. IN PLACE, not into a copy - `int[] x = {1}; int[] y = x;` must still alias.
// One level only; `double[][]` adopts nothing.
function js_csadoptarr(v, ty) {
    if (!Array.isArray(v)) { return v }
    var i = 0
    while (i < v.length) {
        v[i] = js_csadoptty(v[i], ty)
        i = i + 1
    }
    return v
}

// js_csadoptmem(obj, name, v): the declared type a WRITE to a member adopts (ECMA-334
// 10.2.3 at 12.21.2's simple assignment), read off the '__mty' table the class
// descriptor carries. A qualified write - `c.D = 3` on a `public double D;` - has no
// static receiver type here, so the type has to come off the object at run time; the
// emitter calls this only for member NAMES some class declares with an adopting type,
// so every other write emits the IR it emitted before (docs/todo.md 1.3). The twins
// are js_csadoptmem in abnf/jsrtcsharp.go and csAdoptMemW in
// languages/csharp-interpreter.abnf.
function js_csadoptmem(o, name, v) {
    if (o === undefined || o === null) { return v }
    if (typeof o != "object") { return v }
    // A qualified STATIC write ('C.S = 3') has the class DESCRIPTOR as its receiver,
    // and the descriptor is where __mty lives - so the walk starts at the object
    // itself there, and at its class for an instance.
    var cls = (o["__isclass"] === true) ? o : o["__class"]
    var guard = 0
    while (guard < 64) {
        guard = guard + 1
        if (cls === undefined || cls === null) { return v }
        if (typeof cls != "object") { return v }
        var mty = cls["__mty"]
        if (mty !== undefined && mty !== null && typeof mty == "object") {
            var ty = mty[name]
            if (ty !== undefined && ty !== null) {
                var el = csElemAdoptName(ty)
                if (el != "") { return js_csadoptarr(v, el) }
                return js_csadoptty(v, ty)
            }
        }
        cls = cls["__super"]
    }
    return v
}

// "double[]" -> "double" when the elements adopt, "" otherwise. One level only, the
// same rule csElemAdoptTy applies in both grammars.
function csElemAdoptName(ty) {
    if (ty.length < 3) { return "" }
    if (ty.substring(ty.length - 2, ty.length) != "[]") { return "" }
    var e = ty.substring(0, ty.length - 2)
    if (e == "double" || e == "float" || e == "decimal") { return e }
    if (csTypeW(e) != 0) { return e }
    return ""
}

// An integer literal, passed as DIGITS because emitNum would already have rounded
// 9223372036854775807 to 9223372036854776000 on the way into the module. Its TYPE
// follows its suffix and its value (ECMA-334 6.4.5.3): with no suffix it is the
// first of int, uint, long, ulong that holds it; U makes it uint or ulong; L long or
// ulong; UL ulong.
function js_cslit(text, radix, hasU, hasL) {
    var rx = rtjNum(radix)
    var acc = sintRaw(0, 0, 64, true)
    var rb = sintRaw(0, rx, 64, true)
    var i = 0
    while (i < text.length) {
        var c = text.charCodeAt(i)
        var d = 0 - 1
        if (c >= 48 && c <= 57) { d = c - 48 } else if (c >= 97 && c <= 102) { d = c - 97 + 10 } else if (c >= 65 && c <= 70) { d = c - 65 + 10 }
        if (d >= 0 && d < rx) { acc = sintOp(0, sintOp(2, acc, rb), sintRaw(0, d, 64, true)) }
        i = i + 1
    }
    var hi = sintHi(acc)
    var lo = sintLo(acc)
    var fitsUInt = hi == 0
    var fitsInt = hi == 0 && lo <= 2147483647
    var fitsLong = hi <= 2147483647
    var u = hasU === true
    var el = hasL === true
    if (u && el) { return sintRaw(hi, lo, 64, true) }
    if (u) {
        if (fitsUInt) { return sintRaw(hi, lo, 32, true) }
        return sintRaw(hi, lo, 64, true)
    }
    if (el) {
        if (fitsLong) { return sintRaw(hi, lo, 64, false) }
        return sintRaw(hi, lo, 64, true)
    }
    if (fitsInt) { return lo }
    if (fitsUInt) { return sintRaw(hi, lo, 32, true) }
    if (fitsLong) { return sintRaw(hi, lo, 64, false) }
    return sintRaw(hi, lo, 64, true)
}

// -x, at the UNARY promoted type (ECMA-334 12.4.7.2): a long keeps its type, a uint
// becomes a LONG (because -uint.MaxValue does not fit in a uint) and everything
// narrower becomes an int.
function js_csneg(v) {
    // NOT `flo(0 - floNum(v), 2)`. Unary minus on a double is emitted as `0.0 - x`
    // by languages/c-to-llvm-ir.abnf, and 0.0 - 0.0 is +0.0 - so the sign of a
    // NEGATIVE ZERO would be lost. Multiplying by -1.0 computes the sign instead of
    // writing it, and is exact for every operand including the infinities and NaN.
    if (floIs(v)) { return floOp(2, v, flo(0 - 1, 2)) }
    if (csSzW(v) == 64) { return csNorm(csNegate(v, 64, csSzU(v)), 64, csSzU(v)) }
    if (csSzW(v) == 32 && csSzU(v)) { return csNorm(csNegate(v, 64, false), 64, false) }
    return rtWrap32(0 - csNorm(v, 32, false))
}

// Two's complement negation at a given width, which maps MinValue to itself exactly
// as C#'s unchecked unary minus does.
function csNegate(v, w, u) {
    return sintOp(1, csBox(0, w, u), csBox(v, w, u))
}

// ~x, at the same unary promoted type.
function js_csnot(v) {
    if (csSzW(v) == 64) { return csNorm(csComplement(v, 64, csSzU(v)), 64, csSzU(v)) }
    if (csSzW(v) == 32 && csSzU(v)) { return csNorm(csComplement(v, 32, true), 32, true) }
    return rtWrap32(0 - csNorm(v, 32, false) - 1)
}

function csComplement(v, w, u) {
    return sintOp(7, csBox(v, w, u), csBox(csAllOnes(), w, u))
}

// ++ / -- step at the operand's OWN type and wrap there (ECMA-334 12.8.15: `x++` is
// `x = (T)(x + 1)`), so `byte b = 255; b++` is 0.
function js_csstep(v, d) {
    var n = rtjNum(d)
    if (csIsChar(v)) { return csChar((v["__char"] + n) & 65535) }
    // ++/-- keeps the operand's own type, WIDTH included (ECMA-334 12.8.15).
    if (floIs(v)) { var st = floStyle(v); if (st == 5) { return flo(csF32Round(floNum(v) + n), 5) } return flo(floNum(v) + n, st) }
    if (sintIs(v)) { return csConvTo(csArith("+", v, n), sintWidth(v), sintUns(v)) }
    return rtWrap32(csNorm(v, 32, false) + n)
}

// The result of a COMPOUND assignment: the operation, then the implicit cast back to
// the LEFT operand's type (ECMA-334 12.21.4: `x op= y` is `x = (T)(x op y)`), so
// `byte b = 250; b += 10` is (byte)260 == 4.
function js_csnarrowlike(l, v) {
    if (floIs(l)) {
        // The implicit cast back to the LEFT operand's type keeps the WIDTH too, so
        // `float f = 1.1f; f += 0.1` is (float)(f + 0.1) and NOT a double.
        if (floStyle(l) == 5) { return flo(csF32Round(rtjNum(v)), 5) }
        if (floIs(v)) { return v }
        return flo(rtjNum(v), floStyle(l))
    }
    if (csIsChar(l)) { return csChar(csNorm(v, 16, true)) }
    if (sintIs(l)) { return csConvTo(v, sintWidth(l), sintUns(l)) }
    if (rtIsPlainNum(l)) {
        if (rtjIsIntegral(v) || floIs(v)) { return csConvTo(v, 32, false) }
    }
    return v
}

// A (char) cast: narrow to 16 UNSIGNED bits and re-box.
function js_cschar(v) {
    if (floIs(v)) { return csChar(csNorm(csConvTo(v, 16, true), 16, true)) }
    return csChar(csNorm(v, 16, true))
}

// C#'s '+'. Identical to the shared js_csadd - string concat with C#'s null rule,
// float add when a double is involved - except that two INTEGRAL operands add at
// their promoted type and wrap to it, instead of through a double that rounds above
// 2^53.
function js_csadd2(l, r) {
    if (typeof l == "string" || typeof r == "string") { return cpAddStr(l) + cpAddStr(r) }
    // csFloStyle2, not csFloStyle: the two differ only when a 32-bit box is in
    // play, and there the WIDER type wins (ECMA-334 12.4.7.3). BOTH operands
    // convert first when the promoted type is float - rounding only the sum is a
    // different answer for `0.1f + 16777217`.
    if (floIs(l) || floIs(r)) {
        var st = csFloStyle2(l, r)
        if (st == 5) { return flo(csF32Round(csF32Round(rtjNum(l)) + csF32Round(rtjNum(r))), 5) }
        return flo(rtjNum(l) + rtjNum(r), st)
    }
    if (rtjIsIntegral(l) && rtjIsIntegral(r)) { return csArith("+", l, r) }
    return rtjNum(l) + rtjNum(r)
}

// jvmStyleOf: the style of whichever operand is a box, C# (2) when neither is.
function csFloStyle(l, r) {
    if (floIs(l)) { return floStyle(l) }
    if (floIs(r)) { return floStyle(r) }
    return 2
}

// The shared js_csadd (abnf/jsrt.go): the emitter uses it for `"" + x`, which is
// what .ToString() lowers to.
function js_csadd(l, r) {
    if (typeof l == "string" || typeof r == "string") { return cpAddStr(l) + cpAddStr(r) }
    if (floIs(l) || floIs(r)) { return flo(rtjNum(l) + rtjNum(r), csFloStyle(l, r)) }
    var ln = rtjNum(l)
    var rn = rtjNum(r)
    if (rtIsInt32(ln) && rtIsInt32(rn)) { return rtWrap32(ln + rn) }
    return ln + rn
}

// == / != with a sized integer on either side: two integers compare BY VALUE at
// their promoted type, so a uint and a long holding the same number are equal and
// two boxes holding 5 are not two distinct objects. The third argument is the
// js_jchareq / $valeq answer the caller already computed.
function js_cseq(l, r, pre) {
    // THE FLOAT WIDTH RIDES HERE rather than on a new extern the way java's does,
    // because C#'s emitter already wraps every == / != in js_cseq and hands it
    // the js_jchareq answer to override. ECMA-334 12.4.7.3 converts the INT
    // operand to a float first, so `16777216f == 16777217` is true where a bare
    // value comparison says false. A float against a DOUBLE is not this case: the
    // pair promotes to double and csFloPromotes answers false.
    // The INTEGRAL fast path stays FIRST and pays nothing for the width, which is
    // the lesson 8f43e84 bought at +5.32% in java.
    if (rtjIsIntegral(l) && rtjIsIntegral(r)) {
        if (sintIs(l)) { return csCmp("==", l, r) }
        if (sintIs(r)) { return csCmp("==", l, r) }
        return pre
    }
    if (csFloPromotes(l, r)) { return csF32Round(rtjNum(l)) == csF32Round(rtjNum(r)) }
    return pre
}

// ===================================================== the index bounds ======
//
// docs/todo.md 1.2's C# half. These used to be python's js_pyget / js_pyset, which
// WRAP a negative index - so `a[-1]` answered the LAST element in this half while
// the interpreter aborted with "index out of range: -1", a live halves divergence
// --cross had never reached - and which raise python's IndexError / a raw "list
// assignment index out of range" rather than the BCL exception the spec names.
//
// The CLASS is spec-grounded: ECMA-335 III.4.4 (ldelem / stelem throw
// IndexOutOfRangeException), ECMA-334 12.8.11.3 for the string indexer, and
// System.Collections.Generic.Dictionary's indexer for the key miss. The MESSAGES
// are .NET BCL text with no dotnet on this machine to settle them (manual 7.9).
//
// KNOWN SIMPLIFICATION, shared by all three engines: a `List<T>` and an array are
// the same value here, so a List index out of range also raises
// IndexOutOfRangeException where real .NET raises ArgumentOutOfRangeException.
function csIdxOob() { csThrow("IndexOutOfRangeException", "Index was outside the bounds of the array.") }
function csNullRef() { csThrow("NullReferenceException", "Object reference not set to an instance of an object.") }

function js_csidx(o, i) {
    if (Array.isArray(o)) {
        var n = rtjNum(i)
        if (n < 0 || n >= o.length) { csIdxOob() }
        return o[n]
    }
    if (typeof o == "string") {
        var si = rtjNum(i)
        if (si < 0 || si >= o.length) { csIdxOob() }
        return o.charAt(si)
    }
    if (o === undefined || o === null) { csNullRef() }
    if (csIsDict(o)) {
        var d = csDictFind(o["keys"], i)
        if (d < 0) {
            csThrow("KeyNotFoundException",
                    "The given key '" + cpStr(i) + "' was not present in the dictionary.")
        }
        return o["vals"][d]
    }
    return js_pyget(o, i)
}

function js_csidxset(o, i, v) {
    if (Array.isArray(o)) {
        var n = rtjNum(i)
        // A WRITE past the end THROWS; it does not grow the array, which is what
        // js_pyset's list arm reported as "list assignment index out of range" and
        // what the interpreter half silently did.
        if (n < 0 || n >= o.length) { csIdxOob() }
        o[n] = v
        return undefined
    }
    if (o === undefined || o === null) { csNullRef() }
    // A dictionary write INSERTS (ECMA-334's Dictionary indexer setter), so it is
    // deliberately NOT bounds-checked.
    return js_pyset(o, i, v)
}

// ECMA-335 III.4.16: newarr throws OverflowException when the element count is
// negative. Without this `new int[-1]` killed the compiled half outright with a Go
// panic (`runtime error: makeslice: len out of range`).
function js_csnewlen(n) {
    var v = rtjNum(n)
    if (v < 0) { csThrow("OverflowException", "Arithmetic operation resulted in an overflow.") }
    return v
}

// One of the integral type NAMES as an expression primary.
function js_cstype(name) { return csTypeObject(name) }

// C#'s .Length / .Count. A string's Length counts UTF-16 CODE UNITS (System.String
// is a UTF-16 sequence, so "😀".Length is 2) - which is what a MetaJS
// string's .length already counts. Everything else is js_pylen.
function js_cslen(v) {
    if (typeof v == "string") { return v.length }
    if (Array.isArray(v)) { return v.length }
    if (csIsDict(v)) { return v["keys"].length }
    fail("Length/Count of a " + typeof v)
    return 0
}

// The whole Console object, built here rather than in the grammar so that WriteLine
// / Write render through cpStr instead of through the shared println host function.
function js_csconsole() {
    var o = {}
    o["WriteLine"] = function(v) { println(cpStr(v)) }
    o["Write"] = function(v) { print(cpStr(v)) }
    return o
}

// The rendering step of a string CONVERSION, used by '+', by an interpolation hole
// and by .ToString(). It converts only the values whose C# string form differs from
// the shared runtime's - a bool, an array and a class instance - and passes
// everything else through UNCHANGED, so that `1 + 2` stays an integer addition and a
// boxed double stays a double. The caller wraps the result in js_csadd, which
// supplies C#'s null rule and the numeric cases.
function js_csstr(v) {
    if (typeof v == "boolean") { return cpBoolStr(v) }
    if (Array.isArray(v)) { return cpArrayName(v) }
    if (v === undefined) { return v }
    if (v === null) { return v }
    if (typeof v == "object") {
        if (csIsChar(v)) { return v }
        var s = cpObjStr(v, 0)
        if (s !== undefined) { return s }
    }
    return v
}
