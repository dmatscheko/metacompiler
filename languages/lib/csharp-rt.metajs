function js_csdfld(recv, name) {
    if (recv === undefined || recv === null) { return undefined }
    if (typeof recv != "object") { return undefined }
    if (Array.isArray(recv)) { return undefined }
    if (recv["__class"] === undefined) { return undefined }
    var v = recv[name]
    if (v === undefined) {
        var g = rtFindMethod(recv["__class"], "__get_" + name)
        if (csIsFn(g)) { v = g.apply(undefined, rtPrepend(recv, [])) }
    }
    if (csIsDelegVal(v)) { return v }
    return undefined
