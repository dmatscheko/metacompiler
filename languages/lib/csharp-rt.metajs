        if (name == "length") { return recv.length }
        if (name == "charAt") { return recv.charAt(rtjNum(args[0])) }
        if (name == "equals") { return rtjStrictEq(recv, args[0]) }
        // System.String.Substring(int startIndex, int length) takes a LENGTH, not
        // an end index; this lowered to rtSubstring(start, END), so
        // `"abcdef".Substring(1, 3)` answered "bc" where C# answers "bcd" - one
        // wrong answer BOTH halves agreed on, which --cross cannot see. And an
        // out-of-range argument CLAMPED where C# raises ArgumentOutOfRangeException.
        // The twin is csSubstr in languages/csharp-interpreter.abnf.
        if (name == "substring") {
            var b = args.length > 0 ? rtjNum(args[0]) : 0
            if (b < 0) { csThrow("ArgumentOutOfRangeException", "StartIndex cannot be less than zero. (Parameter 'startIndex')") }
            if (b > recv.length) { csThrow("ArgumentOutOfRangeException", "startIndex cannot be larger than length of string. (Parameter 'startIndex')") }
            if (args.length < 2) { return rtSubstring(recv, b, recv.length) }
            var n = rtjNum(args[1])
            if (n < 0) { csThrow("ArgumentOutOfRangeException", "Length cannot be less than zero. (Parameter 'length')") }
            if (b + n > recv.length) { csThrow("ArgumentOutOfRangeException", "Index and length must refer to a location within the string. (Parameter 'length')") }
            return rtSubstring(recv, b, b + n)
        }
