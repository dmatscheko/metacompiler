    var f = anytype
    f = v
    if (typeof v == "string") { f = phNumStrVal(v) }
    if (f === undefined) { return undefined }
    if (f === true) { return 1 }
    if (f === false) { return 0 }
    if (phIsInt(f)) { return f }
    if (!phIsFlo(f)) { return undefined }
    var d = phNumOf(f)
    var lim = Math.pow(2, 63)
    if (d != d || d >= lim || d < 0 - lim) { return undefined }
    return phCast("int", f)
}
// A declared type as PHP prints it (zend_type_to_string). Twin of phpTypeText in
// languages/php-interpreter.abnf.
function phTypeText(typ) {
    var alts = phTypeAlts(typ)
    var order = ["object", "array", "string", "int", "float", "bool", "false", "true"]
    var builtin = ",object,array,string,int,float,bool,false,true,"
    var s = ""
    var n = 0
    var hasNull = false
    var i = 0
    while (i < alts.length) {
        var lc = phsCase(alts[i], false)
        if (lc == "null") { hasNull = true }
        else if (builtin.indexOf("," + lc + ",") < 0) {
            if (n > 0) { s = s + "|" }
            if (alts[i].indexOf("&") >= 0 && alts.length > 1) { s = s + "(" + alts[i] + ")" } else { s = s + alts[i] }
            n = n + 1
        }
        i = i + 1
    }
    var o = 0
    while (o < order.length) {
        var j = 0
        while (j < alts.length) {
            if (phsCase(alts[j], false) == order[o]) {
                if (n > 0) { s = s + "|" }
                s = s + order[o]
                n = n + 1
            }
            j = j + 1
        }
        o = o + 1
    }
    if (!hasNull) { return s }
    if (n == 1 && s.indexOf("&") < 0 && phsCase(s, false) != "mixed") { return "?" + s }
    if (n == 0) { return "null" }
    return s + "|null"
}
// v as the declared type of property name on an instance of cls takes it, or
// PHP's TypeError. Twin of phpPropFit in languages/php-interpreter.abnf.
function phPropFit(cls, name, v) {
    var d = phPropDecl(cls, name)
    if (d === undefined) { return v }
    var typ = phStr(d["typ"])
    if (typ == "") { return v }
    return phSlotFit(d["k"], name, typ, v)
}
// v checked against the type of property name declared by k, instance or static.
function phSlotFit(k, name, typ, v) {
    var r = phTypeFit(typ, v, k)
    if (r === phTypeBad) {
        phRaise("TypeError", "Cannot assign " + phValueName(v) + " to property " + phStr(k["__name"]) + "::$" + name + " of type " + phTypeText(typ))
    }
    return r
}

function js_phpropisset(o, key, scope) {
    if (!phInstance(o)) { return phArrHas(o, key) }
    var name = phPropName(phStr(key))
    var c = phPropAccess(o, name, scope)
    if (c == 0 || c == 2) {
        var ikey = anytype
        ikey = key
        if (c == 2) { ikey = phShadowKey(name) }
        var v = phDeref(o[ikey])
        if (v !== undefined) { return v !== null }
        if (!phInUn(o, name) && phHasKey(o, ikey)) { return false }
    }
    var r = phMagicCall(o, "i", name, [name])
    return r !== undefined && phTest(r["r"])
}

function js_phpropunset(o, key, scope) {
    if (!phInstance(o)) {
        if (typeof o == "object" && !rtIsNil(o)) { delKey(o, phStr(key)) }
        return undefined
    }
    var name = phPropName(phStr(key))
    var c = phPropAccess(o, name, scope)
    if (c == 0 && phHasKey(o, key)) {
        var d = phPropDecl(o["__class"], name)
        var typed = d !== undefined && d["typ"] != ""
        if (o[key] !== undefined || (typed && !phInUn(o, name))) {
            if (!typed) {
                delKey(o, phStr(key))
                return undefined
            }
            // A typed property keeps its slot, uninitialised again.
            o[key] = undefined
            if (!phInUn(o, name)) {
                var l = ","
                if (typeof o["__un"] == "string") { l = o["__un"] }
                o["__un"] = l + name + ","
            }
            return undefined
        }
    }
    if (c == 2 && phHasKey(o, phShadowKey(name))) {
        delKey(o, phShadowKey(name))
        return undefined
    }
    if (phMagicCall(o, "u", name, [name]) === undefined && c == 1) { phBadAccess(o, name) }
    return undefined
}

// An object's properties as an array - keysOf's own non-hidden keys in
// insertion order: a non-public name mangled the way (array) does, or, for
// foreach (iter), only those visible from class scope (null outside every
// class). Twin of phpObjArr in languages/php-interpreter.abnf.
function phObjArr(v, iter, scope) {
    var out = phNewArr()
    var cls = v["__class"]
    var ks = keysOf(v)
    var i = 0
    while (i < ks.length) {
        // An uninitialised typed property is not listed.
        if (v[ks[i]] !== undefined) {
            var kv = phKeyVis(cls, ks[i])
            var name = phStr(kv.n)
            var vis = phStr(kv.vis)
            if (vis == "") { phArrSet(out, name, v[ks[i]]) }
            else if (iter) {
                if (phVisible(v, vis, scope)) { phArrSet(out, name, v[ks[i]]) }
            } else { phArrSet(out, "\x00" + vis + "\x00" + name, v[ks[i]]) }
        }
        i = i + 1
    }
    return out
}

// Can code in class scope read a property of o whose visibility is vis?
function phVisible(o, vis, scope) {
    if (scope === undefined || scope === null) { return false }
    if (vis == "*") { return phIsA(o, phStr(scope["__name"])) || phIsA(scope, phClassName(o)) }
    return phStr(scope["__name"]) == vis
}

// One step of foreach's generator walk: a generator's next(), or an Iterator's
// rewind (first) / next, valid, current and, when the loop binds one, key, as
// the same {done, value} record with the key in a {__genkv, k, v}. Twin of
// m["js_phfestep"] in abnf/jsrtphp.go.
function js_phfestep(it, first, needKey) {
    if (phIsGen(it)) { return js_phmcall(it, "next", []) }
    if (first === true) { js_phmcall(it, "rewind", []) } else { js_phmcall(it, "next", []) }
    var st = {}
    if (!phTest(js_phmcall(it, "valid", []))) {
        st["value"] = undefined
        st["done"] = true
        return st
    }
    var kv = {}
    kv["__genkv"] = true
    kv["v"] = js_phmcall(it, "current", [])
    kv["k"] = null
    if (needKey === true) { kv["k"] = js_phmcall(it, "key", []) }
    st["value"] = kv
    st["done"] = false
    return st
}

// foreach's iterable: an object's properties visible from the class scope (for
// `as &$v` each one its property's storage cell), by value an array as it is
// now, anything else as is.
// Twin of m["js_phfeobj"] in abnf/jsrtphp.go.
function js_phfeobj(v, scope, byref) {
    var o = anytype
    o = v
    while (phIsObj(o) && phIsA(o, "IteratorAggregate")) { o = js_phmcall(o, "getIterator", []) }
    // By value, an array is walked as it was when the loop started: the body's
    // writes to it go to the variable, not to what is iterated.
    if (byref !== true) {
        var ap = phArrParts(o)
        if (ap !== undefined) {
            var snap = phNewArr()
            var sk = snap["keys"]
            var sv = snap["vals"]
            var j = 0
            while (j < ap.k.length) {
                sk.push(ap.k[j])
                sv.push(ap.v[j])
                j = j + 1
            }
            return snap
        }
    }
    if (!phIsObj(o) || phIsGen(o) || phIsA(o, "Iterator")) { return o }
    var out = phObjArr(o, true, scope)
    if (byref !== true) { return out }
    var p = phArrParts(out)
    var i = 0
    while (i < p.k.length) {
        var c = phCellOf(p.v[i])
        if (c === undefined) {
            c = {}
            c["__refcell"] = true
            c["v"] = p.v[i]
            o[phPropKey(phStr(p.k[i]))] = c
        }
        p.v[i] = c
        i = i + 1
    }
    return out
}

// phObjPropsEq compares two instances property by property with ==: every own
// non-hidden key of a has to be present in b and loosely equal there, and the two
// counts have to match. keysOf drops the hidden keys for us, so the count test is
// the two lengths.
function phObjPropsEq(a, b) {
    var ka = keysOf(a)
    var kb = keysOf(b)
    if (ka.length != kb.length) { return false }
    var i = 0
    while (i < ka.length) {
        var k = ka[i]
        // b.props[k] has to be PRESENT, not merely undefined: the Go twin's
        // `bv, has := b.props[k]` answers false on a missing key even when a's
        // value is null. The key lists are the only membership test layer 2 has.
        if (!rtHas(kb, k)) { return false }
        if (!phLoose(a[k], b[k])) { return false }
        i = i + 1
    }
    return true
}
// rtHas (lib/runtime.metajs) is the `===` membership scan used above.

// ===================================================== casts ================

// (object): an array's elements become the properties of a stdClass, any other
// non-object the one property "scalar". Twin of phpCast in abnf/jsrtphp.go.
function phObjCast(v) {
    if (phIsObj(v) || typeof v == "function" || phIsGen(v)) { return v }
    var o = {}
    if (phRtClasses !== undefined) { o["__class"] = phRtClasses["stdClass"] }
    phStamp(o)
    var p = phArrParts(v)
    if (p !== undefined) {
        var i = 0
        while (i < p.k.length) {
            o[phPropKey(phStr(p.k[i]))] = phArrCopy(phDeref(p.v[i]))
            i = i + 1
        }
        return o
    }
    if (!rtIsNil(v)) { o["scalar"] = v }
    return o
}

function phCast(kind, v) {
    if (kind == "int" || kind == "integer") { return phToLong(v) }
    if (kind == "float" || kind == "double" || kind == "real") { return phMkFlo(phNumOf(phToNum(v))) }
    if (kind == "string" || kind == "binary") { return phStr(v) }
    if (kind == "bool" || kind == "boolean") { return phTest(v) }
    if (kind == "array") {
        if (phIsArr(v)) { return v }
        var out = phNewArr()
        if (rtIsNil(v)) { return out }
        if (phIsObj(v)) { return phObjArr(v, false, null) }
        // A Closure or a Generator is an object with no properties.
        if (typeof v == "function" || phIsGen(v)) { return out }
        phArrPush(out, v)
        return out
    }
    if (kind == "object") { return phObjCast(v) }
    if (kind == "unset") { return null }
    return v
}

// ===================================================== generators ===========
//
// The C floor has real stackful coroutines (tags 15 and 16 of
// languages/lib/runtime.c: js_genfn wraps a closure into a generator FUNCTION,
// calling that makes a generator, js_yield suspends the body and gen_next
// resumes it), so js_genfn and js_yield are NOT defined here - defining them
// again is a hard `ld: duplicate symbol '_js_genfn'`, not a shadow.
//
// What the floor owns is the SUSPENSION and exactly one member on a generator:
//
//     g.next(v)  ->  {value, done}
//
// Everything PHP's Generator class adds on top of that - current / key / valid /
// rewind / send / getReturn, and the auto-keys a keyless `yield` gets - is the
// INSPECTION half of the iterator protocol, which answers from the LAST
// handshake instead of performing one. That half is language-specific and it
// lives here, function for function with the *jsGenerator case of getMember in
// abnf/jsrt.go.

// A generator is a floor CELL, not an object: nothing can be stored on it,
// `typeof` answers "object" (type_of in runtime.c), and `next` is the only
// member get_member answers on it - every other key reads back undefined. That
// is the probe, and it is exact because every other shape layer 2 can see is
// excluded first: an array box (__dict), a reference cell, a class descriptor,
// a raw MetaJS list and an instance (whose methods live on its __class and never
// as own properties, so an instance never has a callable own `next`).
function phIsGen(v) {
    if (v === undefined) { return false }
    if (v === null) { return false }
    if (typeof v != "object") { return false }
    if (v["__dict"] === true) { return false }
    if (v["__refcell"] !== undefined) { return false }
    if (v["__isclass"] !== undefined) { return false }
    if (v["__class"] !== undefined) { return false }
    if (typeof v["length"] == "number") { return false }
    return typeof v["next"] == "function"
}

// The per-generator cursor cannot be stored ON the generator, so it is kept in
// one side table keyed by IDENTITY - the same shape phDumpSeen uses, because the
// frozen subset has no Map. A step is O(n) in the generators a program has ever
// created; the Go twin leaks one parked goroutine per generator in exactly the
// same way, and nothing in tests/ makes more than a handful.
var phGenCell = []
var phGenSt = []

function phGenState(g) {
    var i = 0
    while (i < phGenCell.length) {
        if (phGenCell[i] === g) { return phGenSt[i] }
        i = i + 1
    }
    var st = {}
    st["started"] = false
    st["done"] = false
    st["last"] = null      // the value of the last handshake (current())
    st["key"] = null       // its key (key()): the yielded one, or the auto index
    st["ret"] = null       // the body's return value, once done (getReturn())
    st["auto"] = 0
    phGenCell.push(g)
    phGenSt.push(st)
    return st
}

// One handshake. The record the floor answers is returned UNCHANGED, because the
// emitter reads .value and .done off it (and unpacks the __genkv record itself);
// what happens here is only the bookkeeping the inspection half reads.
function phGenStep(g, sent) {
    var st = phGenState(g)
    if (st["done"]) {
        var end = {}
        end["value"] = undefined
        end["done"] = true
        return end
    }
    st["started"] = true
    var r = g.next(sent)
    if (phTest(r["done"])) {
        st["done"] = true
        st["ret"] = r["value"]
        st["last"] = null
        st["key"] = null
        return r
    }
    // 'yield k => v' hands its key over inside the {__genkv, k, v} record the
    // emitter builds (genSplitKV in abnf/jsrt.go); anything else is the value
    // itself, keyed by the running index - which is what a keyless yield means.
    var raw = anytype
    raw = r["value"]
    var kv = false
    var from = false
    if (raw !== undefined && raw !== null && typeof raw == "object") {
        kv = raw["__genkv"] === true
        from = raw["__genfrom"] === true
    }
    if (kv) {
        st["key"] = raw["k"]
        st["last"] = raw["v"]
    } else {
        st["key"] = st["auto"]
        st["last"] = raw
    }
    // The next automatic key follows the largest integer key used so far, a
    // keyless yield's or an explicit one's (PHP's largest_used_integer_key); a
    // string key, and a key a 'yield from' delegated, leave it alone. Twin of
    // jsGenerator.step in abnf/jsrt.go.
    var ky = anytype
    ky = st["key"]
    if (!from && typeof ky == "number" && ky >= st["auto"]) { st["auto"] = ky + 1 }
    return r
}

// current() and key() on a generator nobody has stepped yet run the body up to
// its first yield first - PHP's Generator does exactly this.
function phGenPrime(g) {
    var st = phGenState(g)
    if (!st["started"]) {
        if (!st["done"]) { phGenStep(g, undefined) }
    }
}

// The whole of PHP's Generator surface, over that one primitive.
function phGenCall(g, name, args) {
    var a0 = anytype
    a0 = undefined
    if (args !== undefined && args !== null) {
        if (args.length > 0) { a0 = args[0] }
    }
    if (name == "next") { return phGenStep(g, a0) }
    if (name == "send") {
        // send(v) resumes with v and answers the value yielded NEXT, which is the
        // shape PHP and Python share; the {value, done} record is next()'s. A send
        // to a fresh generator primes it first.
        var sst = phGenState(g)
        if (!sst["started"]) { phGenStep(g, undefined) }
        phGenStep(g, a0)
        if (sst["done"]) { return null }
        return sst["last"]
    }
    if (name == "return") {
        // generator.return(v): abandon the body without resuming it.
        var fst = phGenState(g)
        fst["done"] = true
        fst["ret"] = a0
        fst["last"] = null
        fst["key"] = null
        var fin = {}
        fin["value"] = a0
        fin["done"] = true
        return fin
    }
    phGenPrime(g)
    var st = phGenState(g)
    if (name == "current") {
        if (st["done"]) { return null }
        return st["last"]
    }
    if (name == "key") {
        if (st["done"]) { return null }
        return st["key"]
    }
    if (name == "valid") { return !st["done"] }
    if (name == "rewind") { return null }
    if (name == "getReturn") { return st["ret"] }
    // PHP 8 makes this the same catchable Error as any other missing method:
    // `Call to undefined method Generator::nope()`.
    phRaise("Error", "Call to undefined method Generator::" + name + "()")
    return null
}

// ===================================================== the exports ==========
//
// Everything below is a TOP-LEVEL `function js_*`, which is what -rt-lib exports
// under its own C symbol. The order follows abnf/jsrtphp.go and the js_ph* block
// of abnf/jsrt.go.

// ----- the language-NEUTRAL externs -----------------------------------------
// None of these is PHP's. They live in abnf/jsrt.go, every language can emit
// them, and they are here only because the C floor does not have them.
// (js_bytelen is the floor's; defining it here too is a duplicate-symbol error.)

// Java/C# +: string concat, 32 bit add for two int values, float add otherwise.
// php-to-llvm-ir.abnf emits it ONLY for its own loop counters, so the float arm -
// which would need jsJFlo, the boxed double layer 2 cannot make - is unreachable
// from PHP and is spelled as the plain double add here. Any language that emits
// js_jadd on real user values needs that box first.
// js_jadd is SHARED - lib/runtime.metajs, via the rtkStr/rtkNum hooks above.

function phJavaStr(v) {
    if (typeof v == "string") { return v }
    if (v === null) { return "null" }
    if (v === undefined) { return "null" }
    if (typeof v == "boolean") { return v ? "true" : "false" }
    return "" + v
}

// (target, method name, args array). The Go twin (rt.memberCall in abnf/jsrt.go)
// is a LANGUAGE-NEUTRAL dispatcher over strings, dicts, lists, generators and
// instances; only the arms php-to-llvm-ir.abnf can actually reach are here, and
// the arms it cannot are named at the fallthrough rather than guessed at. The
// instance arm is the one that matters and it is the Go twin's exactly: walk the
// __class/__super chain, and call the method with the TARGET as its first
// argument and `this` undefined, which is how the emitter compiles a method.
// It is js_phmcall and not js_mcall because the two engines have to give the same
// ANSWER on a method nothing claims, and llvm.Run's js_mcall is the shared,
// language-neutral rt.memberCall in abnf/jsrt.go - which cannot raise a PHP Error
// and which chapter 4 of the manual forbids overriding by name, since
// rxExtraExterns fills ONE extern map for every language and a wrapped js_mcall
// leaks into C# and java. So php-to-llvm-ir.abnf emits its own name and the twin
// is the js_phmcall arm of abnf/jsrtphp.go.
function js_phmcall(recv, name, args) {
    if (phIsGen(recv)) { return phGenCall(recv, name, args) }
    if (recv !== undefined && recv !== null && typeof recv == "object") {
        var cls = recv["__class"]
        if (cls !== undefined) {
            // The __class/__super walk and the receiver prepend are SHARED -
            // rtFindMethod / rtPrepend, lib/runtime.metajs.
            var mm = rtFindMethod(cls, name)
            // Method names are case-insensitive: a class also holds each method under
            // its lower-cased name (js_phmset), which a miss retries.
            if (typeof mm != "function") { mm = rtFindMethod(cls, phsCase(phStr(name), false)) }
            if (typeof mm == "function") { return mm.apply(undefined, rtPrepend(recv, args)) }
            // A method the class does not declare is its __call's.
            if (phOwner(cls, "__call") !== undefined) {
                var inner = phNewArr()
                var i = 0
                while (i < args.length) {
                    phArrPush(inner, args[i])
                    i = i + 1
                }
                return rtFindMethod(cls, "__call").apply(undefined, [recv, name, inner])
            }
            // PHP 8: `Error: Call to undefined method Foo::nope()`, and it is an
            // Error rather than a fatal - `catch (Error $e)` recovers.
            phRaise("Error", "Call to undefined method " + phClassName(recv) + "::" + name + "()")
        }
        var f = recv[name]
        if (typeof f == "function") { return f.apply(recv, args) }
    }
    if (typeof recv == "function") { return phCloCall(recv, phStr(name), args) }
    // Everything that is not an object: a string, an int, null, an array. PHP 8
    // spells it `Call to a member function nope() on string`, with phDebugType's
    // names (null / bool / int / float / string / array), and it is catchable.
    phRaise("Error", "Call to a member function " + name + "() on " + phDebugType(recv))
    return undefined
}

// $o->m() for a method name some class restricts, judged from class scope: the
// scope's own private method when the instance redeclares it, __call or an Error
// for one it may not call, js_phmcall otherwise. Twin of m["js_phmcallv"] in
// abnf/jsrtphp.go.
function js_phmcallv(recv, name, args, scope) {
    if (phIsObj(recv)) {
        var cls = recv["__class"]
        if (cls !== undefined) {
            var nm = phStr(name)
            var lc = phsCase(nm, false)
            var acc = phMethodAccess(cls, lc, scope, true)
            if (acc == 3) { return scope[lc].apply(undefined, rtPrepend(recv, args)) }
            if (acc == 1 || acc == 2) {
                if (phOwner(cls, "__call") === undefined) { phBadMethod(cls, nm, scope, false) }
                var inner = phNewArr()
                var i = 0
                while (i < args.length) {
                    phArrPush(inner, args[i])
                    i = i + 1
                }
                return js_phmcall(recv, "__call", [nm, inner])
            }
        }
    }
    return js_phmcall(recv, name, args)
}
// C::m() for a method name some class restricts: __callStatic or an Error for
// one the scope may not call, js_phscall otherwise. Twin of m["js_phscallv"] in
// abnf/jsrtphp.go.
function js_phscallv(target, name, self, args, lsb, scope) {
    var cls = phClassOf(target)
    var nm = phStr(name)
    var acc = phMethodAccess(cls, phsCase(nm, false), scope, false)
    if (acc == 1 || acc == 2) {
        // An inaccessible method falls back as a missing one does.
        if (phCallFallback(cls, self)) { return phCallVia(self, nm, args) }
        if (phOwner(cls, "__callstatic") === undefined) { phBadMethod(cls, nm, scope, false) }
        var fwd = phNewArr()
        phArrPush(fwd, nm)
        phArrPush(fwd, args)
        return js_phscall(target, "__callstatic", self, fwd, lsb)
    }
    return js_phscall(target, name, self, args, lsb)
}
function js_phmvis(target, name, scope, where) { return phMethodVis(target, phStr(name), scope, where) }
// "Class::name" - the declaring class and the method as declared, off its __mns -
// when the nearest declaration of method lc is not static, else "". Twin of
// phpNonStatic in abnf/jsrtphp.go.
function phNonStatic(cls, lc) {
    var d = phMethodDecl(cls, lc)
    if (d === undefined) { return "" }
    var k = d["k"]
    var l = k["__mns"]
    if (typeof l != "string") { return "" }
    var key = "," + lc + ":"
    var at = l.indexOf(key)
    if (at < 0) { return "" }
    var from = at + key.length
