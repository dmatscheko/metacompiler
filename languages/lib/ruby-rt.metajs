// The Array/Enumerable names that REQUIRE a block; called without one MRI hands
// back an Enumerator over the receiver rather than raising. Names that are legal
// blockless (sort, min, max, count, sum, all?, any?, none?, one?, find_index,
// include?) are not here, and each / each_with_index answer their own Enumerator.
function rbArrWantsBlock(n) {
    return n == "map" || n == "collect" || n == "map!" || n == "collect!"
        || n == "select" || n == "filter" || n == "select!" || n == "filter!"
        || n == "reject" || n == "reject!" || n == "keep_if" || n == "delete_if"
        || n == "sort_by" || n == "sort_by!" || n == "group_by" || n == "partition"
        || n == "flat_map" || n == "collect_concat" || n == "find" || n == "detect"
        || n == "min_by" || n == "max_by" || n == "take_while" || n == "drop_while"
}
function rbArrayMethod(t, name, args) {
    var blk = rbBlockOf(args)
    if (blk === null && rbArrWantsBlock(name)) { return rbMkEnumOp(rtCopyArr(t), name) }
    // The POSITIONAL COUNT, not a positional ARRAY: rbPosArgs would allocate on
    // every array-method call and push/each/map are hot, so the arms index args
    // directly and stop at nPos.
    var nPos = rbNPos(args)
    if (name == "size" || name == "length") { return t.length }
    if (name == "push" || name == "append" || name == "add") {
        var i = 0
        while (i < args.length) {
            t.push(args[i])
            i = i + 1
        }
        return t
    }
    // first / last / pop / shift all take an optional COUNT, and then answer an
    // ARRAY. Without it they answered the single element whatever was passed, so
    // `[1,2,3].first(2)` was a silent 1 in every engine.
    if (name == "pop") {
        if (nPos > 0) {
            var pn = Math.trunc(rbToF(args[0]))
            if (pn > t.length) { pn = t.length }
            var ptail = rbArrSub(t, t.length - pn, pn)
            rbArrReplace(t, rbArrSub(t, 0, t.length - pn))
            return ptail
        }
        if (t.length == 0) { return null }
        return t.pop()
    }
    if (name == "first") {
        if (nPos > 0) { return rbArrSub(t, 0, Math.trunc(rbToF(args[0]))) }
        if (t.length == 0) { return null }
        return t[0]
    }
    if (name == "last") {
        if (nPos > 0) {
            var ln = Math.trunc(rbToF(args[0]))
            if (ln > t.length) { ln = t.length }
            return rbArrSub(t, t.length - ln, ln)
        }
        if (t.length == 0) { return null }
        return t[t.length - 1]
    }
    // shift removes from the FRONT; unshift/prepend adds there, variadically.
    if (name == "shift") {
        if (nPos > 0) {
            var sn = Math.trunc(rbToF(args[0]))
            if (sn > t.length) { sn = t.length }
            var shead = rbArrSub(t, 0, sn)
            rbArrReplace(t, rbArrSub(t, sn, t.length - sn))
            return shead
        }
        if (t.length == 0) { return null }
        var s1 = anytype
        s1 = t[0]
        rbArrReplace(t, rbArrSub(t, 1, t.length - 1))
        return s1
    }
    if (name == "unshift" || name == "prepend") {
        var pre = []
        var pv = 0
        while (pv < nPos) {
            pre.push(args[pv])
            pv = pv + 1
        }
        var pu = 0
        while (pu < t.length) {
            pre.push(t[pu])
            pu = pu + 1
        }
        return rbArrReplace(t, pre)
    }
    // Array#include? / #index / #find_index are ==, not === and not eql?:
    // `[[1]].include?([1])` and `[1].include?(1.0)` are both true in MRI. This was
    // a `===` find, which answered false to both. A plain scan and not the dict
    // index: an ordinary data array must not grow a key index to be searched.
    if (name == "include?" || name == "contains") { return rbArrIndex(t, rbPosAt(args, nPos, 0)) >= 0 }
    // inspect / index / find_index / rindex / uniq, all missing from every engine
    // (docs/todo.md 2.9 recorded them as an interpreter gap; they were not). index
    // and uniq compare BY VALUE - `[[1]].index([1])` is 0 in MRI - which is what
    // rbDictFind says.
    if (name == "inspect") { return rbInspect(t) }
    if (name == "index" || name == "find_index") {
        if (blk !== null && nPos == 0) {
            var bi = 0
            while (bi < t.length) {
