// rubyMethod is the direct method dispatch (js_rmcall in the Go twin; here it is
// reached only through js_rxmcall, which is the one the ruby emitter emits).
function rbMethod(target, name, args) {
    // Ruby's universal reflective methods, answered for every kind of value.
    if (name == "class") {
        var kind = rbClassName(target)
        if (kind != "") { return rbBuiltinClass(kind) }
    }
    if (name == "is_a?" || name == "kind_of?" || name == "instance_of?") {
        if (rbClassName(target) != "" && !rbUserObj(target)) { return rbIsA(target, rbArgAt(args, 0)) }
    }
    if (name == "nil?") { return rbIsNil(target) }
    // TrueClass / FalseClass. Without this arm both compiled halves fell through
    // to the shared member call and aborted with "method call 'inspect' on a
    // boolean", where ruby-interpreter.abnf answered.
    if (name == "to_s" || name == "inspect") {
        if (target === true) { return "true" }
        if (target === false) { return "false" }
    }
    if (name == "message" || name == "full_message") {
