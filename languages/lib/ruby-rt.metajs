// BasicObject#equal? - OBJECT IDENTITY.
//
// The rule is NOT a bare `===' and the reasoning is at identicalP in
// languages/ruby-interpreter.abnf, which carries the row table: a Float
// compares by its DOUBLE (MRI's flonum makes 1.0.equal?(1.0) true, and NaN false
// falls out), a String / Rational / Complex is always false (MRI allocates a fresh
// object per value and this model has no identity for any of them), and everything
// else is a reference or an interned value, where identity is exactly right.
// rubyIdenticalP in abnf/jsrt.go is the other twin.
function rbIdenticalP(a, b) {
    if (rtIsNil(a) || rtIsNil(b)) { return rtIsNil(a) && rtIsNil(b) }
    if (rbIsFlo(a) || rbIsFlo(b)) { return rbIsFlo(a) && rbIsFlo(b) && a["f"] === b["f"] }
