    if (name == "sqrt") { return rbMkFlo(Math.sqrt(x)) }
    if (name == "cbrt") { return rbMkFlo(Math.cbrt(x)) }
    if (name == "sin") { return rbMkFlo(Math.sin(x)) }
    if (name == "cos") { return rbMkFlo(Math.cos(x)) }
    if (name == "tan") { return rbMkFlo(Math.tan(x)) }
    if (name == "asin") { return rbMkFlo(Math.asin(x)) }
    if (name == "acos") { return rbMkFlo(Math.acos(x)) }
    if (name == "atan") { return rbMkFlo(Math.atan(x)) }
    if (name == "sinh") { return rbMkFlo(Math.sinh(x)) }
    if (name == "cosh") { return rbMkFlo(Math.cosh(x)) }
    if (name == "tanh") { return rbMkFlo(Math.tanh(x)) }
    if (name == "asinh") { return rbMkFlo(Math.asinh(x)) }
    if (name == "acosh") { return rbMkFlo(Math.acosh(x)) }
    if (name == "atanh") { return rbMkFlo(Math.atanh(x)) }
    if (name == "exp") { return rbMkFlo(Math.exp(x)) }
    if (name == "log2") { return rbMkFlo(Math.log2(x)) }
    if (name == "log10") { return rbMkFlo(Math.log10(x)) }
    if (name == "atan2") { return rbMkFlo(Math.atan2(x, rbToF(rbArgAt(args, 1)))) }
    if (name == "hypot") { return rbMkFlo(Math.hypot(x, rbToF(rbArgAt(args, 1)))) }
    if (name == "log") {
        if (args.length > 1) { return rbMkFlo(Math.log(x) / Math.log(rbMathArg("log", rbToF(rbArgAt(args, 1))))) }
        return rbMkFlo(Math.log(x))
    }
    return undefined
}

// rubyExcParent: the ancestry of the builtin exception classes - the part of
// Ruby's class tree a rescue clause has to know about. Exception is the root.
var rbExcParent = {
    $StandardError: "Exception",
    $RuntimeError: "StandardError",
    $ArgumentError: "StandardError",
    $TypeError: "StandardError",
    $NameError: "StandardError",
    $NoMethodError: "NameError",
    $IndexError: "StandardError",
    $KeyError: "IndexError",
    $RangeError: "StandardError",
    $ZeroDivisionError: "StandardError",
    // FloatDomainError < RangeError: what Float::INFINITY.to_i and "%d" %
    // Float::INFINITY raise.
    $FloatDomainError: "RangeError",
    $StopIteration: "IndexError",
    $FrozenError: "RuntimeError",
    $IOError: "StandardError",
    $EOFError: "IOError",
    $LocalJumpError: "StandardError",
    // ScriptError sits beside StandardError, so a bare `rescue` does not catch
    // NotImplementedError.
    $ScriptError: "Exception",
    $NotImplementedError: "ScriptError",
    // A call nested past the stack; not a StandardError either.
    $SystemStackError: "Exception"
}

// Math::DomainError < StandardError: a scoped name, so not an identifier key above.
rbExcParent["$Math::DomainError"] = "StandardError"

function rbExcParentOf(name) {
    var p = rbExcParent["$" + name]
    if (typeof p == "string") { return p }
    return ""
}

// rubyExcIsA: "v is an exception of the builtin class named bn". It walks the
// value's own __class/__super chain (so a user subclass counts) and, once that
// reaches a BUILTIN class, continues up rbExcParent by name.
function rbExcIsA(v, bn) {
    if (bn != "Exception" && rbExcParentOf(bn) == "") { return false }
    if (!rbIsObj(v)) { return false }
    var c = v["__class"]
    while (c !== undefined && c !== null) {
        if (!rbIsObj(c)) { return false }
        var name = c["__name"]
        if (typeof name != "string") { name = "" }
        if (typeof c["__rbuiltin"] == "string") {
            var n = name
            while (n != "") {
                if (n == bn) { return true }
                n = rbExcParentOf(n)
            }
            return false
        }
        if (name == bn) { return true }
        c = c["__super"]
    }
    return false
}

// rbMixIsA: the mixin half of is_a?. The COMPILER FLATTENS `include M' at build
// time - M's method bodies are re-emitted into the including class and the module
// itself is never named again - so the emitter records the ancestry instead:
// `$mix$<Name>' -> the module object on every class in the chain (include and
// prepend), `$xmix$<Name>' on the class OBJECT for `extend M'. Identity, not the
// name, decides. Twin: rubyMixIsA in abnf/jsrt.go; emitMixRecord in
// languages/ruby-to-llvm-ir.abnf.
function rbMixIsA(v, cls) {
    if (!rbIsObj(v)) { return false }
    var nm = cls["__name"]
    if (typeof nm != "string") { return false }
    // An INSTANCE that was `extend'ed is a member of that module too, and of every
    // module THAT one includes - `o.extend(B)' where `module B; include A' makes o
    // an A as well ($mix$<Name> is the module object's own ancestry record). The
    // per-object twin of the class case below.
    var xs = v["__sext"]
    if (xs !== undefined && xs !== null) {
        var xi = 0
        while (xi < xs.length) {
            if (xs[xi] === cls) { return true }
            if (xs[xi]["$mix$" + nm] === cls) { return true }
            xi = xi + 1
        }
    }
    if (v["__isclass"] === true) { return v["$xmix$" + nm] === cls }
    var key = "$mix$" + nm
    var c = v["__class"]
    var guard = 0
    while (rbIsObj(c) && guard < 64) {
        if (c[key] === cls) { return true }
        c = c["__super"]
        guard = guard + 1
    }
    return false
}

// rubyIsA: `v.is_a?(cls)` / `cls === v`. A builtin class matches by the value's
// runtime kind (Integer/Float also count as Numeric and Comparable), a compiled
// class by walking the instance's __class / __super chain.
function rbIsA(v, cls) {
    if (!rbIsObj(cls)) { return false }
    // The `typeof' guard keeps the mixin walk off `1.is_a?(Integer)' entirely: only
    // an object can carry a $mix$ record, and in MetaJS a call is a scope frame.
    if (typeof v == "object" && rbMixIsA(v, cls)) { return true }
    var bn = cls["__rbuiltin"]
    if (typeof bn == "string") {
        var kind = rbClassName(v)
        if (kind == bn) { return true }
        if (rbExcIsA(v, bn)) { return true }
        if (bn == "Numeric") { return rbIsNum(v) }
        if (bn == "Comparable") {
            if (rbIsNum(v)) { return true }
            return kind == "String"
        }
        // `A.instance_of?(Class)' / `M.is_a?(Module)'. A Class IS a Module in MRI,
        // a Module is not a Class, and neither name means anything for a value that
        // is not a class object at all. rbClassName answers "" for one, so the
        // kind == bn test above never fires here.
        if (bn == "Class" || bn == "Module") {
            if (!rbIsObj(v) || v["__isclass"] !== true) { return false }
            if (bn == "Module") { return true }
            return v["__ismodule"] !== true
        }
        if (bn == "Object") { return true }
        if (bn == "BasicObject") { return true }
        if (bn == "Kernel") { return true }
        if (bn == "Enumerable") {
            if (kind == "Array") { return true }
            if (kind == "Range") { return true }
            return kind == "Hash"
        }
        return false
    }
    if (!rbIsObj(v)) { return false }
    var c = v["__class"]
    while (c !== undefined && c !== null) {
        if (c === cls) { return true }
        if (!rbIsObj(c)) { return false }
        c = c["__super"]
    }
    return false
}

// ----- Module#ancestors and the module relational operators -----
// They all read the same emitted record rbMixIsA reads. Twins: rubyAncestors /
// rubyModRel in abnf/jsrt.go, ancestorsOf / modRel in
// languages/ruby-interpreter.abnf.
function rbIsClassObj(v) { return rbIsObj(v) && v["__isclass"] === true }

function rbRootAncestor(n) { return n == "Object" || n == "Kernel" || n == "BasicObject" }

function rbPushAll(out, arr) {
    if (!rbIsArr(arr)) { return out }
    for (var i = 0; i < arr.length; i++) { out.push(arr[i]) }
    return out
}

// The ancestor list, in MRI's order: at each level the PREPENDED modules, then the
// class itself, then the INCLUDED modules, then the superclass. A synthetic level
// (the `X$core' a prepend introduces, the `X$builtin' shim an exception subclass
// gets) is skipped - it is an artifact of the lowering and MRI has no name for it.
// A builtin class ends the __super chain, so the walk continues by NAME through
// rbExcParent, which is where the builtin hierarchy lives.
function rbAncestors(cls) {
    var out = []
    if (!rbIsClassObj(cls)) { return out }
    var c = cls
    var guard = 0
    while (rbIsObj(c) && guard < 64) {
        guard = guard + 1
        if (c["__synth"] === true) { c = c["__super"]; continue }
        if (typeof c["__rbuiltin"] == "string") {
            // Object / Kernel / BasicObject close EVERY class's list below, so the
            // name chase stops before them rather than duplicating them.
            var bn = c["__name"]
            while (typeof bn == "string" && bn != "" && !rbRootAncestor(bn)) {
                out.push(rbBuiltinClass(bn))
                bn = rbExcParentOf(bn)
            }
            c = null
            continue
        }
        rbPushAll(out, c["__preorder"])
        out.push(c)
        rbPushAll(out, c["__mixorder"])
        c = c["__super"]
    }
    if (cls["__ismodule"] !== true) {
        out.push(rbBuiltinClass("Object"))
        out.push(rbBuiltinClass("Kernel"))
        out.push(rbBuiltinClass("BasicObject"))
    }
    return out
}

function rbAncestorHas(cls, m) {
    var anc = rbAncestors(cls)
    for (var i = 0; i < anc.length; i++) {
        if (anc[i] === m && m !== cls) { return true }
    }
    return false
}

// Module#< / #<= / #> / #>=: the ancestry relation, and NIL for two unrelated
// modules - which is why these do not go through rbCmp, whose contract is to raise.
function rbModRel(l, r, op) {
    var same = l === r
    var lIsR = rbAncestorHas(l, r)
    var rIsL = rbAncestorHas(r, l)
    if (!same && !lIsR && !rIsL) { return null }
    if (op == "<") { return lIsR }
    if (op == "<=") { return same || lIsR }
    if (op == ">") { return rIsL }
    return same || rIsL
}

// rubyExc: {__class: <class>, __args: [message]}, the shape the message reader
// and the rescue type test both understand. The slot is hidden, so no @ivar
// reflection sees it. Twin of rubyExc in abnf/jsrt.go.
function rbExc(cls, args) {
    return {__class: cls, __args: rtCopyArr(args)}
}

// Exception#message / #to_s: the first constructor argument, or the class name.
// rbExcInst is "v is an EXCEPTION instance", which "has __args" alone is not: the
// emitter gives every body-less class a default initialize that stores its
// arguments under `__args`, so an ordinary instance has the same shape (and MRI
// writes "#<Name>" for it). Mirrors rubyExcInst of abnf/jsrt.go.
function rbExcInst(v) {
    if (!rbIsObj(v) || v["__isclass"] === true) { return false }
    if (v["__args"] === undefined || v["__class"] === undefined) { return false }
    return rbIsA(v, rbBuiltinClass("Exception"))
}

function rbExcMessage(o) {
    var arr = o["__args"]
    if (rbIsArr(arr) && arr.length > 0) { return rbStr(arr[0]) }
    var cls = o["__class"]
    if (rbIsObj(cls)) {
        var n = cls["__name"]
        if (typeof n == "string") { return n }
    }
    return undefined
}

// rubyMakeExc turns the operand of Ruby's `raise` into the object to throw:
//   a class object   -> a fresh instance, the message as its single argument
//                       (its own initialize still runs when it defines one)
//   a string         -> a RuntimeError carrying that message, as in MRI
//   nil / undefined  -> a BARE raise: re-raise what the running rescue caught
//   anything else    -> raised unchanged (raise ArgumentError.new("arg"))
function rbMakeExc(v0, msg0) {
    var v = rbSV(v0)
    var msg = rbSV(msg0)
    if (rtIsNil(v)) {
        if (rbCurExc !== null) { return rbCurExc }
        return rbExc(rbBuiltinClass("RuntimeError"), [])
    }
    if (typeof v == "string") { return rbExc(rbBuiltinClass("RuntimeError"), [v]) }
    if (rbIsObj(v) && v["__isclass"] === true) {
        var argv = []
        if (!rtIsNil(msg)) { argv = [msg] }
        var inst = rbExc(v, argv)
        if (rbFindMethod(inst, "initialize") !== undefined) { rbMethod(inst, "initialize", argv) }
        return inst
    }
    return v
}

// The class a @@class variable belongs to: the class of an instance, or `self`
// itself when the code runs in a class method or a class body.
function rbClassOfSelf(self) {
    if (!rbIsObj(self)) { return null }
    if (self["__isclass"] === true) { return self }
    var c = self["__class"]
    if (c === undefined) { return null }
    return c
}

// ===================================================== ranges ===============

// String#succ for the alphanumeric case: the last character is incremented,
// carrying into the one before it when it wraps ("az" -> "ba").
function rbStrSucc(s) {
    if (s == "") { return "" }
    var codes = []
    var i = 0
    while (i < s.length) {
        codes.push(s.charCodeAt(i))
        i = i + 1
    }
    var j = codes.length - 1
    while (j >= 0) {
        var c = codes[j]
        var done = false
        if (c >= 97 && c < 122) {
            codes[j] = c + 1
            done = true
        } else if (c >= 65 && c < 90) {
            codes[j] = c + 1
            done = true
        } else if (c >= 48 && c < 57) {
            codes[j] = c + 1
            done = true
        } else if (c == 122) {
            codes[j] = 97
        } else if (c == 90) {
            codes[j] = 65
        } else if (c == 57) {
            codes[j] = 48
        } else {
            codes[j] = c + 1
            done = true
        }
        if (done) { return rbFromCodes(codes) }
        j = j - 1
    }
    // Every position wrapped: Go prepends the FIRST byte of the wrapped string.
    var out = rbFromCodes(codes)
    return out.charAt(0) + out
}

function rbFromCodes(codes) {
    var out = ""
    var i = 0
    while (i < codes.length) {
        out = out + String.fromCharCode(codes[i])
        i = i + 1
    }
    return out
}

// TWO DELIBERATE DIVERGENCES FROM MRI LIVE HERE (ruby 2.6.10); they are what
// materializing means:
//   * a FLOAT range iterates: `(1.5..3.5).to_a' is [1.5, 2.5, 3.5] where MRI raises
//     TypeError ("can't iterate from Float"). rbRangeAt / rbRangeLen use the
//     SAME arithmetic, so for-in and to_a at least agree with each other.
//   * `("a".."e").size' is 5 where MRI answers nil - see the Range method table.
// rubyRangeArr materializes lo..hi (excl: the three-dot form) as an array. The
// step caps keep a nonsensical range from hanging the program - the same two
// constants the Go twin uses.
function rbRangeArr(lo, hi, excl) {
    var out = []
    if (typeof lo == "string") {
        var hs = rbStr(hi)
        var s = lo
        var n = 0
        while (n < 1000000) {
            if (excl && s == hs) { break }
            if (s.length > hs.length) { break }
            out.push(s)
            if (s == hs) { break }
            s = rbStrSucc(s)
            n = n + 1
        }
        return out
    }
    var l = rbToF(lo)
    var h = rbToF(hi)
    if (excl) { h = h - 1 }
    var k = 0
    var i = l
    while (i <= h && k < 10000000) {
        out.push(i)
        i = i + 1
        k = k + 1
    }
    return out
}

// ----- A Range as a VALUE ---------------------------------------------------
// Every range is a {__rrange, begin, end, excl} object, so these four are the
// whole of what a range CAN do that an Array cannot; everything else materializes
// and delegates. Twins: rubyRangeText / rubyRangeToArr / rubyRangeLen /
// rubyRangeAt in abnf/jsrt.go, and rangeToA / rangeMethod in
// languages/ruby-interpreter.abnf.
function rbRangeText(r, insp) {
    var dots = r["excl"] === true ? "..." : ".."
    var lo = r["begin"]
    var hi = r["end"]
    var ls = ""
    var hs = ""
    if (!rtIsNil(lo)) { ls = insp ? rbInspect(lo) : rbStr(lo) }
    if (!rtIsNil(hi)) { hs = insp ? rbInspect(hi) : rbStr(hi) }
    return ls + dots + hs
}

// The element sequence. An ENDLESS range has none, and asking for one is an error
// in MRI too - the message is ruby-interpreter.abnf's, so all three engines agree.
function rbRangeToArr(r) {
    if (rtIsNil(r["end"]) || rtIsNil(r["begin"])) {
        fail("cannot convert an endless range to an array")
    }
    return rbRangeArr(r["begin"], r["end"], r["excl"] === true)
}

// rbRangeLen / rbRangeAt are what js_pylen / js_pyget answer for a range, and they
// are ARITHMETIC for the numeric case on purpose: for-in, splat and destructuring
// all ask for the length once and then index element by element, so materializing
// inside rbRangeAt would make every one of them quadratic.
function rbRangeNumeric(r) {
    return typeof r["begin"] != "string"
}
// THE ARITHMETIC HERE MUST BE rbRangeArr'S, EXACTLY. rbRangeArr walks `i = lo;
// while (i <= hi) { push(i); i = i + 1 }', so element i is lo + i and the count is
// floor(hi - lo) + 1 - NOT trunc(hi) - trunc(lo) + 1, which is the same for
// integers and differs for a FLOAT range: `(1.5..3.5).to_a' is [1.5, 2.5, 3.5],
// so `for x in 1.5..3.5' has to yield the same. (MRI raises TypeError for both -
// rbRangeArr's divergence - but the two paths of ONE value model have to agree
// with each other.)
function rbRangeSpan(r) {
    var hi = rbToF(r["end"])
    if (r["excl"] === true) { hi = hi - 1 }
    return hi - rbToF(r["begin"])
}
function rbRangeLen(r) {
    if (rtIsNil(r["end"]) || rtIsNil(r["begin"])) {
        fail("cannot take the length of an endless range")
    }
    if (!rbRangeNumeric(r)) { return rbRangeToArr(r).length }
    var n = Math.floor(rbRangeSpan(r)) + 1
    if (n < 0) { return 0 }
    return n
}
function rbRangeAt(r, i) {
    if (!rbRangeNumeric(r)) {
        var a = rbRangeToArr(r)
        if (i < 0 || i >= a.length) { fail("range index out of range: " + i) }
        return a[i]
    }
    if (i < 0 || i >= rbRangeLen(r)) { fail("range index out of range: " + i) }
    return rbToF(r["begin"]) + i
}

// Two ranges are == when their endpoints and their exclusivity are; MRI compares
// `1..3' and `1...3' as different, and a Range is never == to its own to_a.
function rbRangeEq(l, r) {
    if (l["excl"] === true) {
        if (r["excl"] !== true) { return false }
    } else if (r["excl"] === true) { return false }
    if (!rbEq(l["begin"], r["begin"])) { return false }
    return rbEq(l["end"], r["end"])
}

// The Range method table. Everything a Range can answer that an Array cannot is
// here; EVERYTHING ELSE MATERIALIZES AND DELEGATES to rbArrayMethod, which is what
// keeps the whole Enumerable surface (each / map / select / sum / reduce / zip /
// group_by / each_slice / find / reverse_each / …) working without a second copy of
// it. ruby-interpreter.abnf's rangeMethod is the same shape; rubyRangeMethod in
// abnf/jsrt.go is the twin.
function rbRangeMethod(t, name, args) {
    var blk = rbBlockOf(args)
    var npos = rbNPos(args)
    var endless = rtIsNil(t["end"]) || rtIsNil(t["begin"])
    // Membership stays LAZY - it is the one part that an endless range can answer,
    // and materializing (1..1_000_000) to ask `include?(3)` would be absurd.
    if (name == "cover?" || name == "include?" || name == "member?" || name == "===") {
        return rbOpenRangeCover(t, rbArgAt(args, 0))
    }
    if (name == "exclude_end?") { return t["excl"] === true }
    if (name == "begin") { return t["begin"] }
    // #end and #last with NO argument are the range's END, not its last element:
    // `(1...3).last' is 3 where `(1...3).to_a.last' is 2. With an argument they are
    // the Array's, so those fall through to the delegation below.
    if (name == "end") { return t["end"] }
    if (name == "first" && npos == 0) { return t["begin"] }
    if (name == "last" && npos == 0) { return t["end"] }
    if (name == "to_s") { return rbRangeText(t, false) }
    if (name == "inspect") { return rbRangeText(t, true) }
    if (name == "class") { return rbBuiltinClass("Range") }
    if (name == "is_a?" || name == "kind_of?") { return rbIsA(t, rbArgAt(args, 0)) }
    if (name == "instance_of?") {
        var iof = rbArgAt(args, 0)
        return rbIsObj(iof) && iof["__rbuiltin"] === "Range"
    }
    if (name == "nil?") { return false }
    if (name == "frozen?") { return false }
    if (name == "hash") { return rbHashOf(t) }
    if (name == "object_id") { return rbObjectId(t) }
    if (name == "dup" || name == "clone" || name == "freeze" || name == "itself") { return t }
    if (name == "==" || name == "eql?" || name == "equal?") {
        var o = rbArgAt(args, 0)
        if (!rbIsRange(o)) { return false }
        return rbRangeEq(t, o)
    }
    if (name == "to_a" || name == "entries" || name == "to_ary") { return rbRangeToArr(t) }
    // An endless range has no sequence, so only the two questions that do not need
    // one can be answered; MRI agrees that (1..).min is 1 and (1..).max raises.
    if (endless) {
        if (name == "min") { return t["begin"] }
        if (name == "size" || name == "length" || name == "count") {
            fail("cannot take the length of an endless range")
        }
    }
    if (npos == 0 && blk === null) {
        // #size, #length and #count all answer the ELEMENT COUNT, and that is a
        // DELIBERATE divergence. MRI's Range#size is nil for a non-numeric range
        // (`("a".."e").size' is nil) while #count is 5 - but ruby-to-llvm-ir.abnf
        // lowers every bare `.size' / `.length' straight to js_pylen (the smcall /
        // field arms), so it never reaches this table, and js_pylen is ALSO what
        // for-in asks for its trip count. Splitting them would mean taking `.size'
        // off that lowering in every ruby program, which is a far larger change
        // than the answer is worth. All three engines agree.
        if (name == "size" || name == "length" || name == "count") { return rbRangeLen(t) }
    }
    // Range#step(n): every n-th element. Without a block MRI answers an
    // ArithmeticSequence; the nearest thing in this value model is an
    // Enumerator, which answers #to_a and #each the same way.
    if (name == "step") {
        var by = Math.trunc(rbToF(rbArgAt(args, 0)))
        if (by <= 0) { rbRaiseErr(name, "ArgumentError", "step can't be 0 or negative") }
        var src = rbRangeToArr(t)
        var picked = []
        var si = 0
        while (si < src.length) {
            picked.push(src[si])
            si = si + by
        }
        if (blk !== null) {
            var pi = 0
            while (pi < picked.length) {
                rbCall1(blk, picked[pi])
                pi = pi + 1
            }
            return t
        }
        return rbMkEnum(picked)
    }
    var av = rbDelegArr(rbRangeToArr(t), t, name, args)
    // #each answers the RECEIVER in MRI, and the receiver is the range.
    if (name == "each" && blk !== null) { return t }
    return av
}

// rubyOpenRangeCover: `r.cover?(v)` / `r === v` for ANY range, bounded or open,
// exclusive end included.
function rbOpenRangeCover(o, v) {
    var lo = o["begin"]
    if (!rtIsNil(lo)) {
        var c = rbSpaceship(v, lo)
        if (c === null) { return false }
        if (c < 0) { return false }
    }
    var hi = o["end"]
    if (!rtIsNil(hi)) {
        var d = rbSpaceship(v, hi)
        if (d === null) { return false }
        if (o["excl"] === true) { return d < 0 }
