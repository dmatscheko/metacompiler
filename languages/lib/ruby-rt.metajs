// or nil when it was called without one.
function js_rblock(args) {
    if (rbIsArr(args) && args.length > 0 && rbIsFn(args[args.length - 1])) { return args[args.length - 1] }
    return null
}

// A BLOCK parameter read: Ruby auto-splats a single Array argument over a block
// that declares more than one parameter. Both counts are RAW parameters.
function js_rblockarg(args, i_raw, n_raw) {
    if (!rbIsArr(args)) { return undefined }
    var i = i_raw
    var n = n_raw
    if (n > 1 && args.length == 1 && rbIsArr(args[0])) {
        var inner = args[0]
        if (i < inner.length) { return inner[i] }
        return undefined
    }
    if (i < args.length) { return args[i] }
    return undefined
}

// A lambda literal (->) / Kernel#lambda: an ordinary closure, remembered here so
// `lambda?` can tell it from a proc.
function js_rlambda(f) {
    rbLambdas.push(f)
    return f
