// A @@class variable belongs to the CLASS, shared by every instance and by the
// subclasses: the lookup starts at the class of `self` (or at self when it
// already IS a class) and walks __super.
function js_rcvget(self, name) {
    var key = "@@" + rbStr(name)
    var cls = rbClassOfSelf(self)
    while (cls !== undefined && cls !== null) {
        if (!rbIsObj(cls)) { break }
        var v = cls[key]
        if (v !== undefined) { return v }
        cls = cls["__super"]
    }
    return null
