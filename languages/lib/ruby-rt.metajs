        var flat = rbArrFlat(t, fdepth, [])
        if (name == "flatten") { return flat }
        return rbArrReplace(t, flat)
    }
    if (name == "compact" || name == "compact!") {
        var cmp2 = []
        var pi = 0
        while (pi < t.length) {
