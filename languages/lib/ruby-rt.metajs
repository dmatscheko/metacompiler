// ruby-rt.metajs -- RUBY'S OWN SEMANTICS, in MetaJS: ruby's layer-2 runtime.
//
// languages/ruby-to-llvm-ir.abnf emits handle IR that calls js_* externs. The
// generic primitives come from languages/lib/runtime.c (the C floor, layer 1);
// the Ruby-specific ones are here.
//
// Compile with:
//     mec languages/metajs-to-llvm-ir.abnf languages/lib/ruby-rt.metajs -q -rt-lib
// which is what tests/gen-ruby-rt-ll.sh does; the result is the checked-in
// languages/lib/ruby-rt.ll that ruby-to-llvm-ir.abnf links next to runtime.ll.
// -rt-lib exports every TOP-LEVEL `function js_*` below under its own C symbol,
// so nothing else in this file is visible to the linker - the helpers are
// deliberately named rb*.
//
// THE AUTHORITATIVE SPECIFICATION IS abnf/jsrt.go (Ruby has NO dedicated Go twin:
// its semantics live in the shared file, in rubyNumBin / rubyBin / rubyStr /
// rubyInspect / rubyEq / rubySpaceship / rubyFormat / rubyMethod /
// rubyArrayMethod / rubyIsA / rubyExc / memberCall and the js_r* extern table)
// plus abnf/jsrtregex.go for the Regexp and MatchData halves. This file matches
// them function for function; where it CANNOT, the site says so.
//
// ----- the value model -------------------------------------------------------
//
//     null / undefined     ==  nil
//     a boolean            ==  true / false
//     a PLAIN NUMBER       ==  Integer. Exact and NEVER truncated to 32 bit; past
//                              2^53 it is the {__bint} box (see the arbitrary
//                              precision section).
//     {__flo: true, f}     ==  Float          (Go: jsFlo)
//     {__rat: true, n, d}  ==  Rational       (Go: jsRat, sign in n, reduced)
//     {__cpx: true, re, im} == Complex        (Go: jsCpx)
//     {__sym: true, s}     ==  Symbol         (Go: jsSym)
//     a string             ==  String
//     an array             ==  Array
//     a {__dict} object    ==  Hash: keys/vals parallel arrays, INSERTION ordered
//     {__rrange, begin, end, excl}  == a Range. EVERY range, bounded or open.
//                              rbRangeToArr materializes on demand, and the Range
//                              method table delegates the whole Enumerable
//                              surface to the Array's.
//     {__isclass, __name, __super, ...}   == a class / module descriptor. A BUILTIN
//                              class additionally carries __rbuiltin.
//     {__rxsrc, __rxflags}            == a Regexp
//     {__rxmd, __rxsrc, __rxflags, __rxtext, __rxcaps}  == a MatchData
//     any other object     ==  an instance; its descriptor is __class. An exception
//                              instance additionally carries `args`.
//
// THE ONE PLACE THIS DIVERGES FROM THE GO TWIN, stated rather than buried:
// jsFlo / jsRat / jsCpx / jsSym are Go value STRUCTS, so two of them with the same
// contents are `===` equal and hash to the same dict key. Here they are OBJECTS,
// which are compared by IDENTITY. SYMBOLS are therefore INTERNED (rbSym below
// hands out one object per name), which restores === and dict keying exactly for
// the one of the four that a Ruby program actually uses as a hash key and compares
// with ==. Float/Rational/Complex are not interned: a Float used as a HASH KEY, or
// compared with the floor's js_seq rather than through rbEq, would compare by
// identity here and by value in Go. The emitter never emits js_seq on a number
// (checked: its js_seq sites are `x === nil`, typeof results and class
// descriptors), and rbEq/rbDictFind below compare the tower BY VALUE, so no
// reachable path sees the difference.
//
// ----- what Ruby needs from the floor ----------------------------------------
//
//  1. NO sized-integer tag in the value model and NO boxed double. Ruby's Integer
//     is the plain, un-truncated double and its Float is the {__flo} box above -
//     the same representation abnf/jsrt.go uses. (rbBits64 borrows tag 13's
//     arithmetic for one operation and reads the result straight back.)
//  2. NO `__raw` truthy shim. compile-core's truthy() emits `icmp ne <call>, 0` on
//     core.truthyExt, so that extern must answer a RAW INTEGER - and a shim handing
//     back a boolean HANDLE gives 2 for false, which is != 0, so every condition in
//     the program would be taken, silently. ruby-to-llvm-ir.abnf sets no
//     truthyExt: it overrides truthy() itself with a single unsigned handle
//     compare `v >= 3` (only 0/1/2 - undefined/null/false - are falsy, which IS
//     Ruby truthiness). There is no extern in the path at all. The compare is
//     sound natively because runtime.c seeds H_UNDEF/H_NULL/H_FALSE/H_TRUE as
//     0/1/2/3, the same four handles abnf/jsrt.go uses.
//  3. NO `_raw` PARAMETERS beyond the counts. Every selector the ruby emitter
//     passes goes through emitStr / emitNum; the bare handle(k) arguments go to
//     js_closure, js_arg, js_rargrest, js_rblockarg and js_rrangearr - the first
//     two are floor externs and the last three take a plain COUNT, so they are
//     declared `_raw` below.
//  4. NO coroutine primitive. Ruby's `yield` is a call of the block the caller
//     passed, not a generator.
//  5. NO jsChar. Ruby has no character type; `?a` is a one-character String and the
//     emitter never emits js_char / js_char_code / js_kindex.
//
// ----- the scope chain --------------------------------------------------------
//
// A scope is the C floor's private storage, so scope-taking externs are
// normally lowered in the emitter over js_scope_typeof and friends. js_rdefined
// is the exception and is implemented here: js_scope_typeof cannot tell "holds
// undefined" from "absent", an unsupplied block parameter holds exactly
// undefined, and scopeHas can. It is the only scope-taking extern this file
// implements besides js_rmethodval.
//
// ----- the regular-expression engine is IMPORTED, not copied ------------------
//
// languages/lib/regex.js is the shared backtracking engine that every INTERPRETER
// grammar includes into its tag script, and abnf/jsrtregex.go is its line-by-line
// Go port. It is written in the same MetaJS this file is, so layer 2 does not need
// a third copy: `import "./regex.js"` below compiles it into ruby-rt.ll with
// everything else.
//
// ----- MetaJS rules that shape the code below --------------------------------
//
// docs/abnf-dialect-gotchas.md: a local (or a reassigned parameter) keeps the TYPE
// CLASS it is first assigned, so a variable that holds a number in one branch and
// an object in another is declared `var x = anytype`; there is no ASI, so every
// `return` carries its value on the same line and a value-less early return is
// BRACED; no for..in, no splice, no split/join/lastIndexOf, indexOf ignores its
// from-index, array.length is not assignable, and there are no exponent literals.

import "./regex.js"

// Object#respond_to? for a builtin value (rbResponds).
import "./ruby-respond.js"

// String#to_f and Float(String), MRI's rb_cstr_to_dbl (rbnStrToDbl).
import "./hex-float.js"
import "./ruby-num.js"

// The shared layer-2 runtime: the externs every language implements identically,
// parameterised by the rtk* hooks below.
import "./runtime.metajs"

// ----- the rtk* hooks the shared runtime calls -------------------------------
function rtkStr(v) { return rbJStr(v) }
function rtkNum(v) { return rbToF(v) }
function rtkIsChar(v) { return false }
function rtkIsArr(v) { return rbIsArr(v) }
// js_supercall's one knob. Only the four languages whose emitter actually emits
// js_supercall define it; see the note there.
function rtkCall(f, self, argv) { return f.apply(undefined, argv) }
// js_pyset's two knobs.
function rtkIsDict(v) { return rbIsDict(v) }
// RUBY'S find, not the bare `===` scan: a big Integer and an Array are both VALUE
// keys here, so the shared js_pyset stores into the entry a Ruby program means.
function rtkDictFind(keys, k) { return rbDictFind(keys, k) }

// ===================================================== module state =========
//
// Four tables the Go twin keeps on the jsrt struct (rubyClasses, rubyGlobals,
// rubyLambdas, rubyCurExc). Every key is "$"-prefixed, which is the intern-key
// rule of docs/abnf-dialect-gotchas.md: a bare user name could collide with an
// Object.prototype member and the goja and frozen halves disagree about which
// ones exist.

var rbSymTable = {}      // "$name" -> the ONE symbol object of that name
var rbClassTable = {}    // "$Name" -> the ONE builtin class object of that name
var rbGlobals = {}       // "$name" -> the value of Ruby's $name
var rbGlobalNames = {}   // "$name" -> true once assigned (defined? needs presence)
var rbLambdas = []       // the closures a lambda literal produced (identity scan)
var rbArityFns = []      // the closures js_rarity has recorded a shape for
var rbArityRec = []      // [required, optional, hasSplat] for rbArityFns[i]
// The function values `method(:x)' handed out. MRI's Method is a class of its own
// - #class is Method, #to_s is `#<Method: Object#x>' and #arity counts optionals
// like a lambda's. A side table and not a property on the value, exactly as
// rbLambdas is, and ungated because reaching it means calling Kernel#method.
var rbMethodFns = []     // the closures `method(:x)' produced (identity scan)
var rbMethodRec = []     // [ownerClassName, methodName] for rbMethodFns[i]
var rbCurExc = null      // what the innermost rescue caught, for a bare `raise`

// ===================================================== the value model ======

// DELIBERATELY NOT SHARED: a hot predicate, and a shared body would cost a
// MetaJS call per ask - see pyIsObj in lib/python-rt.metajs.
//
// It is NOT rtIsObj either: that one deliberately leaves the array rejection out.
function rbIsObj(v) {
    if (v === null) { return false }
    if (v === undefined) { return false }
    if (typeof v != "object") { return false }
    return !Array.isArray(v)
}

// rbTag is SHARED as rtTag - lib/runtime.metajs - which INLINES the tests
// rbIsObj makes rather than calling it, to keep a frame off these predicates.
function rbIsSym(v) { return rtTag(v, "__sym") }
function rbIsBig(v) { return rtTag(v, "__bint") }
function rbIsFlo(v) { return rtTag(v, "__flo") }
function rbIsRat(v) { return rtTag(v, "__rat") }
function rbIsCpx(v) { return rtTag(v, "__cpx") }
function rbIsDict(v) { return rtTag(v, "__dict") }
function rbIsRange(v) { return rtTag(v, "__rrange") }
function rbIsArr(v) { return Array.isArray(v) }
// rbIsNil is SHARED as rtIsNil - lib/runtime.metajs.
function rbIsFn(v) { return typeof v == "function" }

// The operator METHOD names Object#send may be handed - see rbMethod. The Go
// twin's rubyIsBinOpName is the same set.
function rbIsBinOpName(n) {
    if (n == "+" || n == "-" || n == "*" || n == "/" || n == "%" || n == "**") { return true }
    if (n == "<<" || n == ">>" || n == "&" || n == "|" || n == "^") { return true }
    return n == "<" || n == ">" || n == "<=" || n == ">=" || n == "<=>"
}

// A user object: an instance carrying a __class descriptor (never a class itself).
function rbUserObj(v) {
    if (!rbIsObj(v)) { return false }
    if (v["__isclass"] === true) { return false }
    return v["__class"] !== undefined
}

// A symbol is INTERNED, so two :names are the same handle and === / dict keying
// answer what the Go twin's comparable jsSym struct answers.
function rbSym(name) {
    var k = "$" + name
    var got = rbSymTable[k]
    if (got !== undefined) { return got }
    var s = {__sym: true, s: name}
    rbSymTable[k] = s
    return s
}

// ================================================ the mutable String ========
//
// A string literal, a method call (rbBoxOut), a String operator and to_s evaluate
// to the box {__rstr: true, __s: text, __fz: frozen}, which every alias shares and
// the mutators change in place; inside the runtime a String is a plain string. The
// rule, and what it leaves out, are at isRStr in languages/ruby-interpreter.abnf;
// jsRStr in abnf/jsrtruby.go is the Go twin.

function rbMkRStr(s, fz) { return {__rstr: true, __s: s, __fz: fz} }
function rbSV(v) {
    if (typeof v == "object" && rtTag(v, "__rstr")) { return v["__s"] }
    return v
}
// rbSV over an argument list, copying only when a box is in it.
function rbSVArgs(args) {
    var i = 0
    while (i < args.length) {
        if (typeof args[i] == "object" && rtTag(args[i], "__rstr")) {
            var out = []
            var j = 0
            while (j < args.length) { out.push(rbSV(args[j])); j = j + 1 }
            return out
        }
        i = i + 1
    }
    return args
}
// The names that change a String in place. Twin of strMutator in
// ruby-interpreter.abnf.
function rbStrMutator(n) {
    if (n.length > 1 && n.charAt(n.length - 1) == "!") { return true }
    return n == "<<" || n == "concat" || n == "replace" || n == "insert" || n == "prepend"
        || n == "clear" || n == "[]=" || n == "setbyte"
}
// What `s << x' / s.concat(x) appends: an Integer is a codepoint.
function rbStrAppendText(r) {
    if (typeof r == "number") { return rbCharCode(r) }
    return rbStr(r)
}
// A mutator on a box. Twin of strMutate in ruby-interpreter.abnf.
function rbStrMutate(b, name, args) {
    if (b["__fz"]) { rbRaiseErr(name, "FrozenError", "can't modify frozen String") }
    if (name == "<<" || name == "concat") {
        var acc = b["__s"]
        var i = 0
        while (i < args.length) { acc = acc + rbStrAppendText(args[i]); i = i + 1 }
        b["__s"] = acc
        return b
    }
    if (name == "replace") { b["__s"] = rbStr(rbArgAt(args, 0)); return b }
    if (name == "clear") { b["__s"] = ""; return b }
    if (name == "[]=") {
        var k2 = anytype
        k2 = undefined
        if (args.length > 2) { k2 = args[1] }
        b["__s"] = rbStr(js_rsetsl(b["__s"], args[0], k2, args[args.length - 1]))
        return args[args.length - 1]
    }
    if (name == "slice!") {
        var cut = js_rxmcall(b["__s"], "slice", args)
        if (rtIsNil(cut)) { return null }
        var k3 = anytype
        k3 = undefined
        if (args.length > 1) { k3 = args[1] }
        b["__s"] = rbStr(js_rsetsl(b["__s"], args[0], k3, ""))
        return cut
    }
    var r = js_rxmcall(b["__s"], name, args)
    if (rtIsNil(r)) { return null }
    b["__s"] = rbStr(r)
    return b
}
// The methods a box answers itself - the mutators and the ones that depend on
// WHICH object it is - or undefined, and rbMethod then answers the name on the
// text. Twin of rubyRStrMethod in abnf/jsrtruby.go.
function rbRStrMethod(b, name, args) {
    if (rbStrMutator(name)) { return rbStrMutate(b, name, args) }
    if (name == "freeze") { b["__fz"] = true; return b }
    if (name == "frozen?") { return b["__fz"] }
    if (name == "dup") { return rbMkRStr(b["__s"], false) }
    if (name == "+@") {
        if (!b["__fz"]) { return b }
        return rbMkRStr(b["__s"], false)
    }
    if (name == "clone") { return rbMkRStr(b["__s"], b["__fz"]) }
    if (name == "-@") {
        if (b["__fz"]) { return b }
        return rbMkRStr(b["__s"], true)
    }
    if (name == "to_s" || name == "to_str" || name == "itself") { return b }
    if (name == "tap") { rbCall1(rbBlockOf(args), b); return b }
    if (name == "equal?") { return rbIdenticalP(b, rbArgAt(args, 0)) }
    if (name == "object_id") { return rbObjectId(b) }
    return undefined
}
// A mutator is about to reach v: a plain string becomes a box, which replaces it
// in the Array or Hash (o, k) it was read from. Twin of rubyStrPromote in
// abnf/jsrtruby.go.
function js_rsprom(o, k, v) {
    if (typeof v != "string") { return v }
    var nb = rbMkRStr(v, false)
    if (rbIsArr(o)) {
        var i = Math.trunc(rbToF(k))
        if (i < 0) { i = i + o.length }
        if (i >= 0 && i < o.length && o[i] === v) { o[i] = nb }
    } else if (rbIsDict(o)) {
        var di = rbDictFind(o["keys"], k)
        if (di >= 0 && o["vals"][di] === v) { o["vals"][di] = nb }
    }
    return nb
}
function js_rsnew(s) { return rbMkRStr(rbStr(s), false) }
// A literal under `# frozen_string_literal: true'. Twin of rubyFzLit in
// abnf/jsrtruby.go, which states the rule.
var rbFzLits = {}
function js_rsfz(v, shared) {
    if (rbIsArr(v)) {
        var out = []
        var i = 0
        while (i < v.length) {
            out.push(js_rsfz(v[i], shared))
            i = i + 1
        }
        return out
    }
    if (typeof v != "string") { return v }
    if (shared !== true) { return rbMkRStr(v, true) }
    var k = "$" + v
    var got = rbFzLits[k]
    if (got === undefined) {
        got = rbMkRStr(v, true)
        rbFzLits[k] = got
    }
    return got
}

// A %-literal: a String is a fresh box, a %w Array a fresh Array of fresh boxes.
function js_rspct(v) {
    if (typeof v == "string") { return rbMkRStr(v, false) }
    if (!rbIsArr(v)) { return v }
    var out = []
    var i = 0
    while (i < v.length) {
        if (typeof v[i] == "string") { out.push(rbMkRStr(v[i], false)) } else { out.push(v[i]) }
        i = i + 1
    }
    return out
}
// A bare `.to_s': a new String of js_rstr's text, except that a String box
// answers itself.
function js_rtos(v) {
    if (typeof v == "object" && rtTag(v, "__rstr")) { return v }
    return rbMkRStr(rbStr(v), false)
}
// Unary plus: the identity on a number, String#+@ on a String.
function js_rpos(v) {
    if (typeof v == "string" || (typeof v == "object" && rtTag(v, "__rstr"))) { return rbMethod(v, "+@", []) }
    return v
}

// ======================================== Integer at ARBITRARY PRECISION ====
//
// Ruby's Integer has no width at all: 2**100 is an exact 31-digit value and
// 0xffffffffffffffff is 18446744073709551615, not the double next to it. An
// Integer stays a plain number while a double counts it exactly and becomes the
// {__bint} box the moment it cannot - so nothing under 2^53 changes shape, the
// hot path pays two comparisons, and only the values that genuinely need
// arbitrary precision carry the object.
//
// THE PROMOTION TRIGGER, spelled out once here because it is written inline at
// its four sites in rbNumBin and nowhere else: `result >= 2^53 || result <=
// -2^53` is sound BOTH WAYS. Every plain operand is exact and of magnitude
// <= 2^53 (anything larger is already a big and was taken by rbABigArith before
// it), so if the TRUE result is >= 2^53 the rounded double is too - rounding to
// nearest of a value at or above 2^53 cannot land below it - and if the true
// result is < 2^53 the double is exact and the guard does not fire. It is
// INLINED rather than a predicate because a MetaJS call is a scope frame and
// this is the hottest line in the language.
//
// The three twins that MUST agree with this digit for digit are the big* family
// in languages/ruby-interpreter.abnf, rubyBig* in abnf/jsrt.go (math/big) and
// the js_bigint literal ruby-to-llvm-ir.abnf emits.
//
// Sign and magnitude, the magnitude a little endian array of base 10000 limbs -
// the same representation runtime.metajs's decimal bignum uses, so rtBigStr
// renders one unchanged. A limb product stays below 1e8, well inside a double's
// exact range. The limb arithmetic is runtime.metajs's rtABig* layer, shared with
// python; this file supplies the {__bint} constructor rtkABigNew.
//
// What is deliberately NOT here, and is stated rather than hidden: a big meeting
// a Rational, a Float or a Complex PROMOTES THROUGH THE DOUBLE (rbToF), so
// `(2**70) + Rational(1,2)` is approximate where MRI keeps it exact. Modelling
// that needs a Rational whose parts are bigs, which is a second value model.

// The rtkABigNew hook of runtime.metajs's rtABig* layer: a normalised {__bint}.
function rtkABigNew(neg, limbs) {
    var ls = rtABigNorm(limbs)
    var n = neg
    if (ls.length == 1 && ls[0] == 0) { n = false }
    return {__bint: true, neg: n, limbs: ls}
}

function rbABigAbs(x) {
    var ls = []
    var i = 0
    while (i < x["limbs"].length) {
        ls.push(x["limbs"][i])
        i = i + 1
    }
    return rtkABigNew(false, ls)
}

// Ruby FLOORS: -7 / 2 is -4 and -7 % 3 is 2. The magnitudes give the TRUNCATED
// pair, which is corrected by one whenever the remainder is non-zero and does
// not already carry the DIVISOR's sign - the same correction rbIDiv/rbIMod make
// on doubles, and the same one bigDivMod makes in ruby-interpreter.abnf.
function rbABigDivMod(x, y) {
    var dm = rtABigDivMag(x["limbs"], y["limbs"])
    var q = rtkABigNew(x["neg"] != y["neg"], dm["q"])
    var r = rtkABigNew(x["neg"], dm["r"])
    if (!rtABigIsZero(r) && r["neg"] != y["neg"]) {
        return {q: rtABigSub(q, rtABigFromNum(1)), r: rtABigAdd(r, y)}
    }
    return {q: q, r: r}
}

// Go: big.Int.SetString(text, 0). The one caller is the js_bigint literal the
// emitter builds, which has already converted every radix to exact DECIMAL and
// stripped the '_' separators, so decimal digits with an optional sign is the
// whole accepted language - exactly where Go's `!ok` fails.
function rbABigFromStr(text) {
    var s = text
    var neg = false
    var i = 0
    if (s.charAt(0) == "-") {
        neg = true
        i = 1
    } else {
        if (s.charAt(0) == "+") { i = 1 }
    }
    var digits = ""
    while (i < s.length) {
        var c = s.charAt(i)
        if (c != "_") {
            if (c < "0" || c > "9") { fail("invalid Integer literal " + text) }
            digits = digits + c
        }
        i = i + 1
    }
    if (digits.length == 0) { fail("invalid Integer literal " + text) }
    var limbs = []
    var end = digits.length
    while (end > 0) {
        var from = end - 4
        if (from < 0) { from = 0 }
        limbs.push(parseInt(digits.substring(from, end), 10))
        end = from
    }
    return rtkABigNew(neg, limbs)
}

// An EXACT big for an Integer operand: a big as itself, an integral double
// inside the exactly representable range as itself, a bool as 0/1. A Float box,
// a Rational, a non-integral double and anything past 2^53 that is not already a
// big answer null, so the caller falls back to the double path rather than
// inventing precision the operand never had.
function rbABigOperand(v) {
    if (rbIsBig(v)) { return v }
    if (typeof v == "boolean") {
        if (v) { return rtABigFromNum(1) }
        return rtABigFromNum(0)
    }
    if (typeof v == "number") {
        // A plain double past 2^53 lifts EXACTLY, which is where this differs
        // from python's pyABigOperand. A Python int that large is already boxed
        // and a bare double IS a float; in Ruby a plain number is always an
        // Integer and a large one can only have come from Float#to_i or float
        // arithmetic, where MRI's answer is the exact integer value OF THAT
        // DOUBLE. So `(1e30).to_i + 1` is 1000000000000000019884624838657, as in
        // MRI. The finiteness test is not optional: rtABigFromNum halves until it
        // reaches the mantissa and an infinity never gets there.
        if (v == Math.trunc(v) && v - v == 0) { return rtABigFromNum(v) }
    }
    return null
}

// rbABigOperand for a COMPARISON, which may also take a Float: `2**64 ==
// 1.8446744073709552e19` is true in MRI and `(2**53+1) == (2**53+1).to_f` is
// false, and neither can be settled by rounding the Integer to a double. An
// arithmetic operator must NOT use this - there the Float wins the rank and the
// Integer converts, which is the tower's rule.
function rbABigCmpOf(v) {
    if (rbIsFlo(v)) {
        var f = v["f"]
        if (f - f != 0) { return null }
        if (Math.trunc(f) != f) { return null }
        return rtABigFromNum(f)
    }
    return rbABigOperand(v)
}

// An Integer built from a double: exact past 2^53, so that the ONE shape
// invariant holds - an Integer of magnitude above 2^53 is always a big and never
// a plain double. Float#to_i and the rest of the truncating family go through
// this, which is also what keeps a big and a plain number from ever being two
// spellings of one Hash key.
function rbIntFromF(x) {
    if (x - x != 0) { return x }
    if (x <= 9007199254740992 && x >= 0 - 9007199254740992) { return x }
    return rtABigNarrow(rtABigFromNum(x))
}

// Both Integer operands exactly when AT LEAST ONE of them is a big. Ruby has ONE
// Integer type and it is arbitrary precision, so a plain int operand meeting a
// big PROMOTES - which is the opposite of ECMAScript's BigInt rule.
function rbABigPair(l, r) {
    if (!rbIsBig(l) && !rbIsBig(r)) { return null }
    var x = rbABigOperand(l)
    if (x == null) { return null }
    var y = rbABigOperand(r)
    if (y == null) { return null }
    return {x: x, y: y}
}

// ----- the BITWISE operators, at arbitrary precision -------------------------
//
// Go: rubyBigBits, which is math/big's And/Or/Xor/Lsh/Rsh - those are defined on
// the SIGNED value, i.e. they are already Ruby's infinite two's complement.
// There is no such primitive here, so a negative operand is written out as
// ~(|x| - 1), which gives four identities per operator over AND / OR / XOR /
// ANDNOT of NON-NEGATIVE bit strings:
//
//   -a & b  == b &~ (a-1)             -a | b  == -(((a-1) &~ b) + 1)
//   -a & -b == -(((a-1) | (b-1)) + 1) -a | -b == -(((a-1) & (b-1)) + 1)
//   -a ^ b  == -(((a-1) ^ b) + 1)     -a ^ -b == (a-1) ^ (b-1)
//
// The magnitude is carried as a LITTLE-ENDIAN array of single bits: the stored
// big is base-10000 limbs, so a bit view has to be built by repeated halving
// either way, and once it is built the increments and decrements the identities
// need are two-line loops on it rather than big additions. bigBitBin in
// ruby-interpreter.abnf is this same body.

// -2^53, as a constant: the promotion trigger tests against it once per
// arithmetic step and `0 - 9007199254740992` is a subtraction at every one.
var RB_MIN53 = 0 - 9007199254740992

var RB_SHIFT_MAX = 1048576

function rbABitsTrim(bits) {
    var n = bits.length
    while (n > 0 && bits[n - 1] == 0) { n = n - 1 }
    var out = []
    var i = 0
    while (i < n) {
        out.push(bits[i])
        i = i + 1
    }
    return out
}

// The magnitude as little-endian BITS, by repeated halving of a copy.
function rbABitsOfMag(limbs) {
    var ls = []
    var i = 0
    while (i < limbs.length) {
        ls.push(limbs[i])
        i = i + 1
    }
    var bits = []
    while (ls.length > 0) {
        var rem = 0
        var j = ls.length - 1
        while (j >= 0) {
            var cur = rem * 10000 + ls[j]
            var q = Math.floor(cur / 2)
            ls[j] = q
            rem = cur - q * 2
            j = j - 1
        }
        while (ls.length > 0 && ls[ls.length - 1] == 0) { ls.pop() }
        bits.push(rem)
    }
    return rbABitsTrim(bits)
}

// bits - 1; the caller only hands this a magnitude of at least 1.
function rbABitsDec(bits) {
    var out = []
    var i = 0
    while (i < bits.length) {
        out.push(bits[i])
        i = i + 1
    }
    var k = 0
    while (k < out.length && out[k] == 0) {
        out[k] = 1
        k = k + 1
    }
    if (k < out.length) { out[k] = 0 }
    return rbABitsTrim(out)
}

function rbABitsInc(bits) {
    var out = []
    var i = 0
    while (i < bits.length) {
        out.push(bits[i])
        i = i + 1
    }
    var k = 0
    while (k < out.length && out[k] == 1) {
        out[k] = 0
        k = k + 1
    }
    if (k == out.length) { out.push(1) } else { out[k] = 1 }
    return out
}

// A bit array back to a big, by the schoolbook doubling rtABigMulSmall already is.
function rbABigFromBits(neg, bits) {
    var limbs = [0]
    var j = bits.length - 1
    while (j >= 0) {
        limbs = rtABigMulSmall(limbs, 2)
        if (bits[j] == 1) { limbs = rtABigAddMag(limbs, [1]) }
        j = j - 1
    }
    return rtkABigNew(neg, limbs)
}

// A shift count as a plain number; anything absurd answers past the cap.
function rbABitsToNum(bits) {
    if (bits.length > 40) { return RB_SHIFT_MAX + 1 }
    var acc = 0
    var p = 1
    var i = 0
    while (i < bits.length) {
        if (bits[i] == 1) { acc = acc + p }
        p = p * 2
        i = i + 1
    }
    return acc
}

// Ruby's |, &, ^, << and >> over two bigs. A NEGATIVE shift count is the
// opposite shift in Ruby (`1 << -2` is 0, `4 >> -2` is 16); null is "no exact
// form here", which only an absurd shift count reaches.
function rbABigBits(op, x, y) {
    var an = x["neg"] && !rtABigIsZero(x)
    var bn = y["neg"] && !rtABigIsZero(y)
    var a = rbABitsOfMag(x["limbs"])
    var b = rbABitsOfMag(y["limbs"])
    if (op == "<<" || op == ">>") {
        var left = op == "<<"
        if (bn) { left = !left }
        var k = rbABitsToNum(b)
        if (k > RB_SHIFT_MAX) { return null }
        if (left) { return rbABigFromBits(an, rtABitsShl(a, k)) }
        if (!an) { return rbABigFromBits(false, rtABitsShr(a, k)) }
        // floor(-a / 2^k) is -(((a-1) >> k) + 1): -5 >> 1 is -3.
        return rbABigFromBits(true, rbABitsInc(rtABitsShr(rbABitsDec(a), k)))
    }
    if (op == "&") {
        if (!an && !bn) { return rbABigFromBits(false, rtABitsOp(RT_BIT_AND, a, b)) }
        if (an && !bn) { return rbABigFromBits(false, rtABitsOp(RT_BIT_ANDNOT, b, rbABitsDec(a))) }
        if (!an && bn) { return rbABigFromBits(false, rtABitsOp(RT_BIT_ANDNOT, a, rbABitsDec(b))) }
        return rbABigFromBits(true, rbABitsInc(rtABitsOp(RT_BIT_OR, rbABitsDec(a), rbABitsDec(b))))
    }
    if (op == "|") {
        if (!an && !bn) { return rbABigFromBits(false, rtABitsOp(RT_BIT_OR, a, b)) }
        if (an && !bn) { return rbABigFromBits(true, rbABitsInc(rtABitsOp(RT_BIT_ANDNOT, rbABitsDec(a), b))) }
        if (!an && bn) { return rbABigFromBits(true, rbABitsInc(rtABitsOp(RT_BIT_ANDNOT, rbABitsDec(b), a))) }
        return rbABigFromBits(true, rbABitsInc(rtABitsOp(RT_BIT_AND, rbABitsDec(a), rbABitsDec(b))))
    }
    if (op == "^") {
        if (!an && !bn) { return rbABigFromBits(false, rtABitsOp(RT_BIT_XOR, a, b)) }
        if (an && bn) { return rbABigFromBits(false, rtABitsOp(RT_BIT_XOR, rbABitsDec(a), rbABitsDec(b))) }
        if (an) { return rbABigFromBits(true, rbABitsInc(rtABitsOp(RT_BIT_XOR, rbABitsDec(a), b))) }
        return rbABigFromBits(true, rbABitsInc(rtABitsOp(RT_BIT_XOR, a, rbABitsDec(b))))
    }
    return null
}

// One arithmetic step at arbitrary precision, over two ALREADY LIFTED bigs.
// null is "no exact form", and the caller then keeps the double path it had.
function rbABigStep(op, x, y) {
    if (op == "+") { return rtABigNarrow(rtABigAdd(x, y)) }
    if (op == "-") { return rtABigNarrow(rtABigSub(x, y)) }
    if (op == "*") { return rtABigNarrow(rtABigMul(x, y)) }
    if (op == "/" || op == "%") {
        if (rtABigIsZero(y)) { rbRaiseErr(op, "ZeroDivisionError", "divided by 0") }
        var dm = rbABigDivMod(x, y)
        if (op == "/") { return rtABigNarrow(dm["q"]) }
        return rtABigNarrow(dm["r"])
    }
    if (op == "**") {
        if (y["neg"]) {
            var ny = rtABigNarrow(y)
            if (typeof ny == "number" && ny >= -4096) { return rbRatPow(rbMkRat(rtABigNarrow(x), 1), ny) }
            return rbMkFlo(Math.pow(rbABigToF(x), rbABigToF(y)))
        }
        var e = rtABigNarrow(y)
        if (typeof e != "number") { return Math.pow(rbABigToF(x), rbABigToF(y)) }
        if (e > 4096) { return Math.pow(rbABigToF(x), e) }
        return rtABigNarrow(rtABigPow(x, e))
    }
    if (op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>") {
        var bb = rbABigBits(op, x, y)
        if (bb == null) { return null }
        return rtABigNarrow(bb)
    }
    return null
}

// One arithmetic step with AT LEAST ONE operand already a big. null when the
// pair is not two exact Integers at all.
function rbABigArith(op, l, r) {
    var p = rbABigPair(l, r)
    if (p == null) { return null }
    return rbABigStep(op, p["x"], p["y"])
}

// The PROMOTION redo: two plain Integers whose double answer has left the exact
// range. Both operands are plain numbers, so rbABigPair cannot fire on them and
// they are lifted explicitly.
function rbABigPromote(op, x, y) {
    var a = rbABigOperand(x)
    if (a == null) { return null }
    var b = rbABigOperand(y)
    if (b == null) { return null }
    return rbABigStep(op, a, b)
}

// A big as a double, which is where this value model stops being exact. Written
// through the decimal text on purpose: there is no other exact-to-nearest route
// from an arbitrary precision integer to a double in this dialect.
function rbABigToF(v) { return parseFloat(rtABigStr(v)) }

// An Integer that is still a plain double, as text. Ruby NEVER writes one in
// exponent form, which is what `"" + x` does from 1e21 up - `(2.0 ** 70).to_i`
// printed 1.1805916207174113e+21 where MRI prints all 22 digits.
function rbIntStr(x) {
    if (x <= 9007199254740992 && x >= 0 - 9007199254740992) { return "" + x }
    if (x - x != 0) { return "" + x }
    if (Math.trunc(x) != x) { return "" + x }
    return rtABigStr(rtABigFromNum(x))
}

// Integer#to_s(base) for a big: one magnitude division per digit, which
// rtABigDivMag already is. Go asks big.Int.Text(base) for the same answer.
function rbABigBaseStr(v, base) {
    if (rtABigIsZero(v)) { return "0" }
    var mag = v["limbs"]
    var out = ""
    while (!(mag.length == 1 && mag[0] == 0)) {
        var dm = rtABigDivMag(mag, [base])
        out = RT_DIGITS.charAt(dm["r"][0]) + out
        mag = dm["q"]
    }
    if (v["neg"]) { return "-" + out }
    return out
}

// The Integer method set for a value past 2^53, and the twin of bigMethod in
// ruby-interpreter.abnf and rubyBigMethod in abnf/jsrt.go. Every step is routed
// through the exact arithmetic instead of the double (rbToF would answer
// `(2**64).abs` as 1.8446744073709552e+19). `undefined` hands the name back to
// rbNumMethod's own list, which answers it in double precision or reports it
// unknown.
function rbABigMethod(t, name, args) {
    if (name == "to_s" || name == "inspect") {
        if (args.length > 0) { return rbABigBaseStr(t, Math.trunc(rbToF(args[0]))) }
        return rtABigStr(t)
    }
    // An Integer is already floored, ceilinged, truncated and rounded, at any
    // digit argument a Ruby program can write here.
    if (name == "to_i" || name == "to_int") { return t }
    // ...at every ndigits >= 0; a NEGATIVE one rounds to a multiple of
    // 10**-ndigits, which past 2**53 has to be exact. #truncate is one of the
    // four.
    if (name == "floor" || name == "ceil" || name == "round" || name == "truncate") {
        var bnd = 0
        if (args.length > 0) { bnd = Math.trunc(rbToF(args[0])) }
        var bmd = "r"
        if (name == "floor") { bmd = "f" } else if (name == "ceil") { bmd = "c" } else if (name == "truncate") { bmd = "t" }
        return rbNumDigitOp(0, t, true, bmd, bnd)
    }
    if (name == "to_f") { return rbMkFlo(rbABigToF(t)) }
    if (name == "abs" || name == "magnitude") { return rtABigNarrow(rbABigAbs(t)) }
    if (name == "zero?") { return rtABigIsZero(t) }
    if (name == "positive?") {
        if (rtABigIsZero(t)) { return false }
        return !t["neg"]
    }
    if (name == "negative?") { return t["neg"] }
    if (name == "even?") { return rbABigDivMod(t, rtABigFromNum(2))["r"]["limbs"][0] == 0 }
    if (name == "odd?") { return rbABigDivMod(t, rtABigFromNum(2))["r"]["limbs"][0] != 0 }
    if (name == "succ" || name == "next") { return rtABigNarrow(rtABigAdd(t, rtABigFromNum(1))) }
    if (name == "pred") { return rtABigNarrow(rtABigSub(t, rtABigFromNum(1))) }
    if (name == "integer?") { return true }
    if (name == "divmod") {
        var d = rbABigOperand(rbArgAt(args, 0))
        if (d != null) {
            if (rtABigIsZero(d)) { rbRaiseErr(name, "ZeroDivisionError", "divided by 0") }
            var dm = rbABigDivMod(t, d)
            return [rtABigNarrow(dm["q"]), rtABigNarrow(dm["r"])]
        }
    }
    return undefined
}

// The js_bigint extern the emitter calls for an Integer literal past 2^53.
// Go: the "js_bigint" entry of abnf/jsrt.go, which is big.Int.SetString.
function js_bigint(text) { return rbABigFromStr(rbStr(text)) }

// ===================================================== the numeric tower ====
//
// abnf/jsrt.go's rubyNumRank / rubyToF / rubyGcd / rubyMkRat / rubyReOf /
// rubyImOf / rubyAsRat, in that order. Integer < Rational < Float < Complex;
// every arithmetic step promotes both operands to the higher rank.

// A big is rank 0: it IS an Integer, not a fifth kind of number. Meeting a
// Rational, a Float or a Complex it promotes to that rank through rbToF, i.e.
// through the double it no longer fits - the boundary stated at the head of the
// arbitrary precision section above.
function rbNumRank(v) {
    if (typeof v == "number") { return 0 }
    if (rbIsRat(v)) { return 1 }
    if (rbIsFlo(v)) { return 2 }
    if (rbIsCpx(v)) { return 3 }
    if (rbIsBig(v)) { return 0 }
    return 0 - 1
}

function rbIsNum(v) { return rbNumRank(v) >= 0 }

function rbToF(v) {
    if (typeof v == "number") { return v }
    if (rbIsFlo(v)) { return v["f"] }
    if (rbIsRat(v)) {
        if (rbIsBig(v["n"]) || rbIsBig(v["d"])) { return rbIntFdiv(v["n"], v["d"]) }
        return v["n"] / v["d"]
    }
    if (rbIsCpx(v)) { return rbToF(v["re"]) }
    if (rbIsBig(v)) { return rbABigToF(v) }
    return 0
}

function rbMkFlo(x) { return {__flo: true, f: x} }
// A Complex's parts are TYPED reals (Integer, Float box, Rational): see rbCpxBin.
function rbMkCpx(re, im) { return {__cpx: true, re: re, im: im} }

// ----- EXACT integer arithmetic on doubles, and why every one of these exists ---
//
// The Go twin computes Ruby's Integer `/` and `%` and rubyGcd's math.Mod in
// float64 - and on arm64 the Go compiler FUSES `x - q*y` into an FMSUB, so the
// product and the subtraction are done at INFINITE precision and only the final
// result is rounded. The C floor's clang does not fuse, so the same source gives a
// different answer the moment |q*y| leaves the exactly-representable range:
// `9007199254740991 % -3` is -2 under llvm.Run and -1 without the fusion. Real
// ruby says -2, so the FUSED answer is also the CORRECT one.
//
// rbFmaSub reproduces the fused `x - q*y` exactly, with the standard Dekker
// two-product / two-sum emulation of an FMA. It is used by BOTH the Integer and
// the Float remainder, which is where the Go source has the fusable expression.
var RB_SPLIT = 134217729              // 2^27 + 1, Dekker's splitting constant
var RB_SAFE = Math.pow(2, 500)        // an operand above this would overflow the
                                      // split, so it is SCALED first (below).
                                      // Written as a pow because the MetaJS dialect
                                      // has no exponent literals.
var RB_DOWN = Math.pow(2, 0 - 256)    // the scaling step, and its inverse
var RB_UP = Math.pow(2, 256)

// The high half of a, exactly representable in 26 bits.
function rbSplitHi(a) {
    var c = RB_SPLIT * a
    return c - (c - a)
}

// A zero carrying x's sign. `x * 0` is the obvious spelling AND IT IS WRONG IN
// THIS DIALECT: the tag engine keeps an integral value as an integer, so
// `-4 * 0` is the integer 0 and the sign is gone (`1 / (x * 0)` is +Infinity for
// x = -4, where `1 / (z / (0 - 1))` is -Infinity). Dividing a zero by -1 is a
// float division in every engine and keeps the sign. zeroSigned in
// languages/ruby-interpreter.abnf is the same body; abnf/jsrt.go spells it
// math.Copysign(0, x), which Go has and this dialect does not.
function rbZeroSign(x) {
    var z = 0
    if (x < 0) { return z / (0 - 1) }
    if (x == 0 && 1 / x < 0) { return z / (0 - 1) }
    return z
}

// ----- Float#round / #floor / #ceil AND Integer#round / #floor / #ceil with a
// DIGIT COUNT -----------------------------------------------------------------
//
// MRI's algorithm (numeric.c): ties are corrected toward the DECIMAL the double
// prints as, a negative ndigits answers an INTEGER, and an Infinity/NaN or an
// ndigits past the mantissa answers the receiver. Against ruby 2.6.10 (Float#round
// is unchanged in 3.x):
//
//     2.345.round(2)   2.35     (2.345 is really 2.3449999999999997513)
//     2.675.round(2)   2.68     (2.675 is really 2.6749999999999998224)
//     3.7.floor(1)     3.7      2.345.floor(2)  2.34    2.345.ceil(5)  2.34501
//     1234.567.round(-2) -> the Integer 1200, and (…).class is Integer
//     1.7976931348623157e308.round(1) -> itself, where x*10 is Infinity
//     5e-324.round(374) -> NaN, because MRI's own pow(10, 374) is Infinity
//
// The twins are floBinExp/floDigitRound/intDigitOp in
// languages/ruby-interpreter.abnf and rubyFloDigitRound/rubyIntDigitOp in
// abnf/jsrt.go (which asks math.Frexp for the binary exponent the other two
// compute by scaling), and the three agree by construction because every step
// is the same double arithmetic.

// frexp's exponent: the e with x == m * 2**e and 0.5 <= |m| < 1. x must be finite
// and non-zero. The 2**32 steps keep a subnormal off a 1074-iteration loop.
function rbFloBinExp(x) {
    var v = Math.abs(x)
    var e = 0
    while (v >= 4294967296) { v = v / 4294967296 ; e = e + 32 }
    while (v >= 1) { v = v / 2 ; e = e + 1 }
    while (v * 4294967296 < 1) { v = v * 4294967296 ; e = e - 32 }
    while (v < 0.5) { v = v * 2 ; e = e - 1 }
    return e
}

// C's integer division, which TRUNCATES toward zero - Math.floor answers -358
// where C answers -357 for -1073/3, and MRI's two guards are written in C.
function rbCTruncDiv(n, d) {
    var q = n / d
    if (q < 0) { return Math.ceil(q) }
    return Math.floor(q)
}

// 10**ndigits * 2**binexp is past the mantissa: every digit asked for is already
// there, so the receiver IS the answer. And the other end: the value is entirely
// below the last digit asked for.
function rbFloRoundOver(nd, be) {
    if (be > 0) { return nd >= 17 - rbCTruncDiv(be, 4) }
    return nd >= 17 - (rbCTruncDiv(be, 3) - 1)
}
function rbFloRoundUnder(nd, be) {
    if (be > 0) { return nd < 0 - (rbCTruncDiv(be, 3) + 1) }
    return nd < 0 - rbCTruncDiv(be, 4)
}

// 10**nd as a DOUBLE, by PARSING the decimal rather than by Math.pow. The tag
// engine of ruby-interpreter.abnf keeps an integral value as a sized integer and
// its integer power WRAPS (Math.pow(10, 20) is 10**20 mod 2**64 there), and here
// Math.pow is the C floor's d_pow - a third implementation to agree with. Parsing
// is exact in all three engines and answers Infinity past 1e308, which is what
// MRI's own pow() does.
function rbPow10(nd) { return parseFloat("1e" + nd) }

// C's round(): half away from zero, and EXACT - `Math.floor(v + 0.5)` answers 1
// for the largest double below 0.5, because the addition itself rounds up.
function rbCRound(v) {
    var t = Math.trunc(v)
    var d = v - t
    if (d >= 0.5) { return t + 1 }
    if (d <= 0 - 0.5) { return t - 1 }
    return t
}

// The three ndigits > 0 bodies. round_half_up is C's round() plus the correction
// that makes 2.675.round(2) == 2.68: if the double `(f + 0.5) / s` is <= x then x
// is at or past the midpoint whatever the scaled product said. That correction is
// why rtExactDec is NOT used here - the true decimal expansion would answer 2.67.
// A zero result carries the receiver's sign (-0.05.ceil(1) is -0.0 in MRI).
function rbFloDigitRound(x, nd) {
    var be = rbFloBinExp(x)
    if (rbFloRoundOver(nd, be)) { return x }
    if (rbFloRoundUnder(nd, be)) { return 0 }
    var s = rbPow10(nd)
    var f = rbCRound(x * s)
    if (x > 0) {
        if ((f + 0.5) / s <= x) { f = f + 1 }
    } else {
        if ((f - 0.5) / s >= x) { f = f - 1 }
    }
    var r = f / s
    if (r == 0) { return rbZeroSign(x) }
    return r
}
function rbFloDigitFloor(x, nd) {
    var be = rbFloBinExp(x)
    if (rbFloRoundOver(nd, be)) { return x }
    if (x > 0 && rbFloRoundUnder(nd, be)) { return 0 }
    var s = rbPow10(nd)
    var r = Math.floor(x * s) / s
    if (r == 0) { return rbZeroSign(x) }
    return r
}
function rbFloDigitCeil(x, nd) {
    var be = rbFloBinExp(x)
    if (rbFloRoundOver(nd, be)) { return x }
    if (x < 0 && rbFloRoundUnder(nd, be)) { return 0 }
    var s = rbPow10(nd)
    var r = Math.ceil(x * s) / s
    if (r == 0) { return rbZeroSign(x) }
    return r
}

// MRI's int_round_zero_p, and it is NOT an optimisation that happens to agree
// with the arithmetic - it OVERRIDES it. numeric.c: "If 10**N / 2 > num, then
// return 0", decided on the receiver's BYTE SIZE with log_256(10) > 0.415241 and
// log_256(1/2) == -0.125, where a Fixnum's size is sizeof(long) == 8 whatever the
// value is. So `(-1234).floor(-20)` is 0 in MRI where the arithmetic says
// -10**20. First-zero-at in MRI: -20 for every Fixnum and for 2**63, -22 for
// 2**64 (9 bytes), -32 for 2**100 (13), -63 for 2**200 (26), -304 for 2**1000
// (126), -309 for Float::MAX floored (128).
function rbIntByteSize(v) {
    var bits = 0
    if (rbIsBig(v)) {
        bits = rbABigBinDigits(v).length
    } else {
        var m = Math.abs(v)
        while (m >= 1) {
            m = Math.floor(m / 2)
            bits = bits + 1
        }
    }
    var bytes = Math.floor((bits + 7) / 8)
    if (bytes < 8) { bytes = 8 }
    return bytes
}
function rbIntRoundZero(v, k) { return 0.415241 * k - 0.125 > rbIntByteSize(v) }

// "199" -> "200". A decimal string incremented by one, carry and all.
function rbDecIncr(s) {
    var i = s.length - 1
    var out = ""
    var carry = 1
    while (i >= 0) {
