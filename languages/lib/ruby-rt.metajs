// The keyword arguments a call passed: the trailing Hash of the argument list (a
// block closure may sit behind it), or an empty Hash.
function js_rkwargs(args) {
    if (rbIsArr(args)) {
        var i = args.length - 1
        while (i >= 0 && i >= args.length - 2) {
