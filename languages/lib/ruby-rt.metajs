// ----- the regex-aware wrappers ---------------------------------------------
// The ruby emitter emits these EVERYWHERE it would otherwise emit the plain
// js_rmcall / js_rcase / js_rwhen / js_rget, so the plain ones are never
// declared and rbMethod / js_rcase / rbWhen / js_rget above carry the base
// behaviour.

// A regexp literal: /src/flags, validated here so a bad pattern is a clean
// runtime error rather than a wrong match.
function js_rxnew(src, flags) {
    var s = rbStr(src)
    var f = rbStr(flags)
    var re = rxGet(s, f)
    if (!re["ok"]) { fail("invalid regexp /" + s + "/: " + re["err"]) }
    return rbRxNewRegex(s, f)
}

function js_rxmcall(target, name, args) {
    if (rbRxIsRegex(target) || rbRxIsMatch(target) || (rbIsArr(args) && args.length > 0 && rbRxIsRegex(args[0]))) {
        var v = rbRxMethod(target, rbStr(name), args)
        if (v !== undefined) { return v }
    }
    return rbMethod(target, rbStr(name), args)
