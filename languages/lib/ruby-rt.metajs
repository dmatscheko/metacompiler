        var groups = []
        var gi = 0
        if (name == "each_slice") {
            while (gi < t.length) {
                groups.push(rbArrSub(t, gi, gn))
                gi = gi + gn
            }
        } else {
            while (gi + gn <= t.length) {
                groups.push(rbArrSub(t, gi, gn))
                gi = gi + 1
            }
        }
        if (blk === null) { return rbEnumAt(rbMkEnum(groups), rbEnumSrc(t), name, args) }
        var gk = 0
        while (gk < groups.length) {
            rbCall1(blk, groups[gk])
            gk = gk + 1
        }
        return t
    }
    // sample / shuffle. There is no random source in this project and there cannot be
    // one the engines agree on byte-for-byte (see rbRand, which is deterministically
    // zero), so these are the DETERMINISTIC draw: sample takes from the front and
    // shuffle is the identity permutation. Every invariant a program can test - the
    // length, membership, and that a shuffle is a permutation of its receiver - holds;
    // the particular ordering does not, and MRI's would not be reproducible either.
    if (name == "sample") {
        if (nPos == 0) {
            if (t.length == 0) { return null }
            return t[0]
        }
        var sn = Math.trunc(rbToF(rbPosAt(args, nPos, 0)))
        if (sn > t.length) { sn = t.length }
        return rbArrSub(t, 0, sn)
    }
    if (name == "shuffle") { return rtCopyArr(t) }
    if (name == "shuffle!") { return t }
    // cycle(n) { } runs the block over the whole array n times; cycle { } with no
    // count repeats FOREVER, and the way out is the block's own `break'.
    if (name == "cycle") {
        var cn = 0
        if (nPos > 0) { cn = Math.trunc(rbToF(rbPosAt(args, nPos, 0))) }
        if (blk === null) {
            if (nPos == 0) { fail("cycle without a count needs a block") }
            var cyc = []
            var ci = 0
            while (ci < cn) {
                var cj = 0
                while (cj < t.length) { cyc.push(t[cj]); cj = cj + 1 }
                ci = ci + 1
            }
            return rbEnumAt(rbMkEnum(cyc), rbEnumSrc(t), name, args)
        }
        if (nPos == 0) {
            if (t.length == 0) { return null }
            while (true) {
                var cq = 0
                while (cq < t.length) { rbCall1(blk, t[cq]); cq = cq + 1 }
            }
        }
        var cy = 0
        while (cy < cn) {
            var ck = 0
            while (ck < t.length) { rbCall1(blk, t[ck]); ck = ck + 1 }
            cy = cy + 1
        }
        return null
    }
    // combination(n) / permutation(n): the subsets and the ordered arrangements, in
    // MRI's own order. With a block they yield each one and answer SELF.
    if (name == "combination" || name == "permutation") {
        var pk = t.length
        if (nPos > 0) { pk = Math.trunc(rbToF(rbPosAt(args, nPos, 0))) }
        var picks = name == "combination" ? rbCombIdx(t.length, pk) : rbPermIdx(t.length, pk)
        var res = []
        var pi = 0
        while (pi < picks.length) {
            var row2 = []
            var pj = 0
            while (pj < picks[pi].length) { row2.push(t[picks[pi][pj]]); pj = pj + 1 }
            res.push(row2)
            pi = pi + 1
        }
        if (blk === null) { return rbEnumAt(rbMkEnum(res), rbEnumSrc(t), name, args) }
        var pm = 0
        while (pm < res.length) { rbCall1(blk, res[pm]); pm = pm + 1 }
        return t
    }
    if (name == "take") { return rbArrSub(t, 0, rbArrCountArg(name, rbPosAt(args, nPos, 0))) }
    if (name == "drop") {
        var dn = Math.trunc(rbToF(rbPosAt(args, nPos, 0)))
        return rbArrSub(t, dn, t.length - dn)
    }
    if (name == "take_while" || name == "drop_while") {
        var cut = t.length
        var wi = 0
        while (wi < t.length) {
            if (!rbTruthy(rbCall1(blk, t[wi]))) {
                cut = wi
                break
            }
            wi = wi + 1
        }
        if (name == "take_while") { return rbArrSub(t, 0, cut) }
        return rbArrSub(t, cut, t.length - cut)
    }
    if (name == "find" || name == "detect") {
        var fi = 0
        while (fi < t.length) {
            if (rbTruthy(rbCall1(blk, t[fi]))) { return t[fi] }
            fi = fi + 1
        }
        return null
    }
    // inject / reduce: four forms - a block, a block with an initial value, a
    // Symbol naming a binary operator, and an initial value with that Symbol.
    if (name == "inject" || name == "reduce") {
        var sym = ""
        var iacc = anytype
        iacc = null
        var haveInit = false
        var ii = 0
        while (ii < nPos) {
            if (rbIsSym(args[ii])) { sym = args[ii]["s"] }
            else {
                iacc = args[ii]
                haveInit = true
            }
            ii = ii + 1
        }
        var from = 0
        if (!haveInit) {
            if (t.length == 0) { return null }
            iacc = t[0]
            from = 1
        }
        var ij = from
        while (ij < t.length) {
            if (sym != "") { iacc = rbBin(sym, iacc, t[ij]) }
            else { iacc = rbCall2(blk, iacc, t[ij]) }
            ij = ij + 1
        }
        return iacc
    }
    if (name == "each_with_object") {
        var memo = anytype
        memo = rbPosAt(args, nPos, 0)
        var oi = 0
        while (oi < t.length) {
            rbCall2(blk, t[oi], memo)
            oi = oi + 1
        }
        return memo
    }
    if (name == "all?" || name == "any?" || name == "none?" || name == "one?") {
        var hits = 0
        var qi = 0
        while (qi < t.length) {
            var hit = false
            // With no block the element's own truthiness is the test; with an
            // argument the test is `arg === element`, which for a class object is
            // is_a? and == for everything else.
            if (blk !== null) { hit = rbTruthy(rbCall1(blk, t[qi])) }
            else if (nPos > 0) { hit = rbTruthy(rbPatternHit(args[0], t[qi])) }
            else { hit = rbTruthy(t[qi]) }
            if (hit) { hits = hits + 1 }
            qi = qi + 1
        }
        if (name == "all?") { return hits == t.length }
        if (name == "any?") { return hits > 0 }
        if (name == "none?") { return hits == 0 }
        return hits == 1
    }
    if (name == "flat_map" || name == "collect_concat") {
        var fm = []
        var mi = 0
        while (mi < t.length) {
            var fv = anytype
            fv = rbCall1(blk, t[mi])
            if (rbIsArr(fv)) {
                var fj = 0
                while (fj < fv.length) {
                    fm.push(fv[fj])
                    fj = fj + 1
                }
            } else { fm.push(fv) }
            mi = mi + 1
        }
        return fm
    }
    if (name == "group_by") {
        var gd = rbNewDict()
        var yi = 0
        while (yi < t.length) {
            var gkey = anytype
            gkey = rbCall1(blk, t[yi])
