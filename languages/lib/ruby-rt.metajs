            // Hash#default is the value Hash.new(v) recorded; a hash built with a
            // BLOCK answers nil here, exactly as MRI does (the block is #default_proc).
            if (name == "default") {
                var hdv = target["__hdef"]
                if (hdv === undefined) { return null }
                return hdv
            }
            // Hash#fetch DELIBERATELY ignores the default: MRI raises KeyError for a
            // missing key unless a second argument or a block supplies the answer.
            if (name == "fetch") {
                var fi = rbDictFind(keys, rbArgAt(args, 0))
                if (fi >= 0) { return vals[fi] }
