// js_supercall is SHARED - lib/runtime.metajs (four languages, one knob: rtkCall).
// Ruby's copy was the only one of the four with no 64-step cap on the walk; it
// takes the cap now, for the reason recorded at the merged body.

// ----- Ruby's own -----------------------------------------------------------

// :name from its name - INTERNED, see the note at rbSym.
function js_sym(name) { return rbSym(rbStr(name)) }

// The three boxes of the numeric tower.
function js_rflo(v) { return rbMkFlo(rbToF(v)) }
function js_rrat(n, d) { return rbMkRat(rbToF(n), rbToF(d)) }
function js_rcpx(re, im) { return rbMkCpx(rbToF(re), rbToF(im)) }

// The binary operators.
function js_radd(l, r) { return rbBin("+", l, r) }
function js_rsub(l, r) { return rbBin("-", l, r) }
function js_rmul(l, r) { return rbBin("*", l, r) }
function js_rdiv(l, r) { return rbBin("/", l, r) }
function js_rmod(l, r) { return rbBin("%", l, r) }
function js_rpow(l, r) { return rbBin("**", l, r) }

// & | ^ are the NON-short-circuit boolean operators when the left side is a
// boolean, and the numeric ones otherwise - one operator, two meanings, like Ruby.
function js_rband(l, r) {
    if (typeof l == "boolean") {
        if (!l) { return false }
        return rbTruthy(r)
