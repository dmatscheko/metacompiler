            if (tix < 0) { rbDictSet(td, t[ti], 1) }
            else { td["vals"][tix] = td["vals"][tix] + 1 }
            ti = ti + 1
        }
        return td
    }
    if (name == "flatten" || name == "flatten!") {
        var fdepth = nPos == 0 ? 0 - 1 : Math.trunc(rbToF(args[0]))
        var flat = rbArrFlat(t, fdepth, [])
        if (name == "flatten") { return flat }
        return rbArrReplace(t, flat)
    }
    if (name == "compact" || name == "compact!") {
        var cmp2 = []
        var pi = 0
        while (pi < t.length) {
            if (!rbIsNil(t[pi])) { cmp2.push(t[pi]) }
            pi = pi + 1
