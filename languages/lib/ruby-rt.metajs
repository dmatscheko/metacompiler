// The Array a Range, Hash or Enumerator is delegating to right now, and that
// delegator, so a NoMethodError names it. Twin of rubyDelegArr in abnf/jsrt.go.
var rbNmDeleg = [null, null]
function rbDelegArr(arr, recv, name, args) {
    var sa = rbNmDeleg[0]
    var sr = rbNmDeleg[1]
    rbNmDeleg[0] = arr
    rbNmDeleg[1] = recv
    var v = rbArrayMethod(arr, name, args)
    rbNmDeleg[0] = sa
    rbNmDeleg[1] = sr
    return v
}

// The receiver as a NoMethodError / NameError message names it. Twin of
// rubyNoMethodDesc in abnf/jsrt.go.
function rbNoMethodDesc(t) {
    var cn = rbClassName(t)
    if (cn == "") {
        cn = "Object"
        if (rbIsObj(t)) {
            if (t["__isclass"] === true) {
                cn = "Class"
                if (t["__ismodule"] === true) { cn = "Module" }
            } else if (rbIsObj(t["__class"])) {
                cn = t["__class"]["__name"]
