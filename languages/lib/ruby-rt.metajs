// A plain `when V` value: a class matches by is_a?, everything else by == (an
// Array compares STRUCTURALLY here - only a RANGE means membership, which is what
// js_rcase above is for). Not exported: only the regex-aware js_rxwhen is emitted.
function rbWhen(l, r) {
    if (rbIsObj(l) && l["__isclass"] === true) { return rbIsA(r, l) }
    return rbEq(l, r)
