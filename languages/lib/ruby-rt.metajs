    while (o.length < ab["s"]) { o.push(null) }
    var al = ab["l"]
    if (ab["s"] + al > o.length) { al = o.length - ab["s"] }
    var ins = []
    if (rbIsArr(v)) { ins = v } else { ins = [v] }
    var out = []
    var i = 0
    while (i < ab["s"]) { out.push(o[i]); i = i + 1 }
    var j = 0
    while (j < ins.length) { out.push(ins[j]); j = j + 1 }
    var k = ab["s"] + al
    while (k < o.length) { out.push(o[k]); k = k + 1 }
    o.length = 0
    var q = 0
    while (q < out.length) { o.push(out[q]); q = q + 1 }
