    if (name == "values_at") {
        var va = []
        while (i < nPos) {
            var vf = rbDictFind(keys, args[i])
            if (vf < 0) { va.push(rbHashDefault(o, args[i])) } else { va.push(vals[vf]) }
            i = i + 1
        }
        return va
    }
    if (name == "invert") {
        var iv = js_dict_new()
        while (i < keys.length) {
            rbDictSet(iv, vals[i], keys[i])
            i = i + 1
        }
        return iv
    }
    if (name == "key") {
        while (i < vals.length) {
            if (rbEq(vals[i], rbArgAt(args, 0))) { return keys[i] }
            i = i + 1
        }
        return null
    }
    if (name == "transform_values") {
        var tv = rbHashCopy(o)
        while (i < tv["vals"].length) {
            tv["vals"][i] = rbCall1(blk, tv["vals"][i])
            i = i + 1
        }
        return tv
    }
    if (name == "transform_keys") {
        var tk = js_dict_new()
        while (i < keys.length) {
            rbDictSet(tk, rbCall1(blk, keys[i]), vals[i])
            i = i + 1
        }
        return tk
    }
    if (!rbHashEnumName(name)) { return rbHashUnknown }
    // Everything else Enumerable is answered over the [key, value] PAIRS, which is
    // what MRI's Hash does (Hash includes Enumerable and yields a pair). select /
    // filter / reject answer a HASH again, everything else the Array Enumerable
    // builds.
    var hp = rbHashPairs(keys, vals)
    if (name == "select" || name == "filter" || name == "reject" || name == "select!"
        || name == "filter!" || name == "reject!" || name == "keep_if" || name == "delete_if") {
        if (blk === null) { return rbMkEnumOp(hp, name) }
        var inner = "select"
        if (name == "reject" || name == "reject!" || name == "delete_if") { inner = "reject" }
        var kept = rbArrayMethod(hp, inner, args)
        var hs = rbPairsToHash(kept, o)
