// ruby-rt.metajs -- RUBY'S OWN SEMANTICS, in MetaJS. Layer 2 of
// docs/runtime-next-plan.md part 3, for the sixth language after the Lua pilot,
// PHP, Swift, Java, C# and Dart.
//
// languages/ruby-to-llvm-ir.abnf emits handle IR that calls 93 js_* externs over
// the full-syntax ratchet. 30 of them are generic primitives languages/lib/runtime.c
// already provides (the C floor, layer 1). The other 63 are here.
//
// Compile with:
//     mec languages/metajs-to-llvm-ir.abnf languages/lib/ruby-rt.metajs -q -rt-lib
// which is what tests/gen-ruby-rt-ll.sh does; the result is the checked-in
// languages/lib/ruby-rt.ll that ruby-to-llvm-ir.abnf links next to runtime.ll.
// -rt-lib exports every TOP-LEVEL `function js_*` below under its own C symbol,
// so nothing else in this file is visible to the linker - the helpers are
// deliberately named rb*.
//
// THE AUTHORITATIVE SPECIFICATION IS abnf/jsrt.go (Ruby has NO dedicated Go twin:
// its semantics live in the shared file, in rubyNumBin / rubyBin / rubyStr /
// rubyInspect / rubyEq / rubySpaceship / rubyFormat / rubyMethod /
// rubyArrayMethod / rubyIsA / rubyExc / memberCall and the js_r* extern table)
// plus abnf/jsrtregex.go for the Regexp and MatchData halves. This file matches
// them function for function; where it CANNOT, the site says so in full.
//
// ----- the value model -------------------------------------------------------
//
//     null / undefined     ==  nil
//     a boolean            ==  true / false
//     a PLAIN NUMBER       ==  Integer. Exact and NEVER truncated to 32 bit.
//     {__flo: true, f}     ==  Float          (Go: jsFlo)
//     {__rat: true, n, d}  ==  Rational       (Go: jsRat, sign in n, reduced)
//     {__cpx: true, re, im} == Complex        (Go: jsCpx)
//     {__sym: true, s}     ==  Symbol         (Go: jsSym)
//     a string             ==  String
//     an array             ==  Array
//     a {__dict} object    ==  Hash: keys/vals parallel arrays, INSERTION ordered
//     {__rrange, begin, end, excl}  == a Range with an OPEN end. A range with BOTH
//                              bounds is MATERIALIZED as an array by js_rrangearr,
//                              which is what the whole lowering expects.
//     {__isclass, __name, __super, ...}   == a class / module descriptor. A BUILTIN
//                              class additionally carries __rbuiltin.
//     {__rxsrc, __rxflags}            == a Regexp
//     {__rxmd, __rxsrc, __rxflags, __rxtext, __rxcaps}  == a MatchData
//     any other object     ==  an instance; its descriptor is __class. An exception
//                              instance additionally carries `args`.
//
// THE ONE PLACE THIS DIVERGES FROM THE GO TWIN, stated rather than buried:
// jsFlo / jsRat / jsCpx / jsSym are Go value STRUCTS, so two of them with the same
// contents are `===` equal and hash to the same dict key. Here they are OBJECTS,
// which are compared by IDENTITY. SYMBOLS are therefore INTERNED (rbSym below
// hands out one object per name), which restores === and dict keying exactly for
// the one of the four that a Ruby program actually uses as a hash key and compares
// with ==. Float/Rational/Complex are not interned: a Float used as a HASH KEY, or
// compared with the floor's js_seq rather than through rbEq, would compare by
// identity here and by value in Go. The emitter never emits js_seq on a number
// (checked: its js_seq sites are `x === nil`, typeof results and class
// descriptors), and rbEq/rbDictFind below compare the tower BY VALUE, so no
// reachable path sees the difference.
//
// ----- what Ruby needed from the floor, and what it did NOT ------------------
//
//  1. NO sized-integer tag and NO boxed double. Ruby's Integer is the plain,
//     un-truncated double and its Float is the {__flo} box above - the same
//     representation abnf/jsrt.go uses - so neither tag 13 nor tag 14 is reached
//     from this file at all. The si_norm question the plan asks ("is the
//     language's unboxed representation the one si_norm produces") does not arise:
//     Ruby never builds a tag-13 cell.
//  2. NO `__raw` truthy shim. compile-core's truthy() emits `icmp ne <call>, 0` on
//     core.truthyExt, so that extern must answer a RAW INTEGER - and a shim handing
//     back a boolean HANDLE gives 2 for false, which is != 0, so every condition in
//     the program would be taken, silently. `grep -n truthyExt
//     languages/ruby-to-llvm-ir.abnf` is EMPTY, and Ruby goes further than the four
//     languages that merely keep the default: it overrides truthy() itself with a
//     single unsigned handle compare `v >= 3` (only 0/1/2 - undefined/null/false -
//     are falsy, which IS Ruby truthiness). There is no extern in the path at all.
//     The compare is sound natively because runtime.c seeds H_UNDEF/H_NULL/
//     H_FALSE/H_TRUE as 0/1/2/3, the same four handles abnf/jsrt.go uses.
//  3. NO `_raw` PARAMETERS. Every selector the ruby emitter passes goes through
//     emitStr / emitNum; the bare handle(k) arguments go to js_closure, js_arg,
//     js_rargrest, js_rblockarg and js_rrangearr - the first two are floor externs
//     and the last three take a plain COUNT, so they are declared `_raw` below.
//  4. NO coroutine primitive. `grep -c 'js_genfn\|js_yield'
//     languages/ruby-to-llvm-ir.abnf` is 0: Ruby's `yield` is a call of the block
//     the caller passed, not a generator, and no test file uses Fiber or
//     Enumerator. WALL 1 does not touch this language.
//  5. NO jsChar. Ruby has no character type; `?a` is a one-character String and the
//     emitter never emits js_char / js_char_code / js_kindex.
//
// ----- WALL 3, the scope chain: lowered in the EMITTER, not here --------------
//
// js_rdefined took a SCOPE HANDLE and walked the chain. A scope is the floor's
// private storage, so layer 2 cannot open one and this could never have been
// written here. It is a pure PROBE, and an EMITTER may call js_scope_typeof, so
// ruby-to-llvm-ir.abnf now emits it as the IR helper rb_defined. PHP recorded the
// generalisation, Swift/Java/Dart confirmed it, Ruby is the fifth lowering.
//
// ----- the regular-expression engine is IMPORTED, not copied ------------------
//
// languages/lib/regex.js is the shared backtracking engine that every INTERPRETER
// grammar includes into its tag script, and abnf/jsrtregex.go is its line-by-line
// Go port. It is written in the same MetaJS this file is, so layer 2 does not need
// a third copy: `import "./regex.js"` below compiles it into ruby-rt.ll with
// everything else. That is the first time a layer-2 library has imported a shared
// source rather than restating it, and it is worth copying - the whole Regexp /
// MatchData surface cost 1,559 lines of nothing.
//
// ----- MetaJS rules that shape the code below --------------------------------
//
// docs/abnf-dialect-gotchas.md: a local (or a reassigned parameter) keeps the TYPE
// CLASS it is first assigned, so a variable that holds a number in one branch and
// an object in another is declared `var x = anytype`; there is no ASI, so every
// `return` carries its value on the same line and a value-less early return is
// BRACED; no for..in, no splice, no split/join/lastIndexOf, indexOf ignores its
// from-index, array.length is not assignable, and there are no exponent literals.

import "./regex.js"

// The shared layer-2 runtime (docs/runtime-merge-plan.md part A). It supplies
// the externs every language implements identically, parameterised by the rtk*
// hooks below.
import "./runtime.metajs"
import "./runtime-decimal.metajs"
import "./runtime-bignum.metajs"

// ----- the rtk* hooks the shared runtime calls -------------------------------
function rtkStr(v) { return rbJStr(v) }
function rtkNum(v) { return rbToF(v) }
function rtkIsChar(v) { return false }
function rtkIsArr(v) { return rbIsArr(v) }
// js_supercall's one knob. Only the four languages whose emitter actually emits
// js_supercall define it; see the note there.
function rtkCall(f, self, argv) { return f.apply(undefined, argv) }
// js_pyset's two knobs.
function rtkIsDict(v) { return rbIsDict(v) }
function rtkDictFind(keys, k) { return rtDictFind(keys, k) }

// ===================================================== module state =========
//
// Four tables the Go twin keeps on the jsrt struct (rubyClasses, rubyGlobals,
// rubyLambdas, rubyCurExc). Every key is "$"-prefixed, which is the intern-key
// rule of docs/abnf-dialect-gotchas.md: a bare user name could collide with an
// Object.prototype member and the goja and frozen halves disagree about which
// ones exist.

var rbSymTable = {}      // "$name" -> the ONE symbol object of that name
var rbClassTable = {}    // "$Name" -> the ONE builtin class object of that name
var rbGlobals = {}       // "$name" -> the value of Ruby's $name
var rbGlobalNames = {}   // "$name" -> true once assigned (defined? needs presence)
var rbLambdas = []       // the closures a lambda literal produced (identity scan)
var rbCurExc = null      // what the innermost rescue caught, for a bare `raise`

// ===================================================== the value model ======

function rbIsObj(v) {
    if (v === null) { return false }
    if (v === undefined) { return false }
    if (typeof v != "object") { return false }
    return !Array.isArray(v)
}

function rbTag(v, name) {
    if (!rbIsObj(v)) { return false }
    return v[name] === true
}

function rbIsSym(v) { return rbTag(v, "__sym") }
function rbIsFlo(v) { return rbTag(v, "__flo") }
function rbIsRat(v) { return rbTag(v, "__rat") }
function rbIsCpx(v) { return rbTag(v, "__cpx") }
function rbIsDict(v) { return rbTag(v, "__dict") }
function rbIsRange(v) { return rbTag(v, "__rrange") }
function rbIsArr(v) { return Array.isArray(v) }
function rbIsNil(v) {
    if (v === null) { return true }
    return v === undefined
}
function rbIsFn(v) { return typeof v == "function" }

// A user object: an instance carrying a __class descriptor (never a class itself).
function rbUserObj(v) {
    if (!rbIsObj(v)) { return false }
    if (v["__isclass"] === true) { return false }
    return v["__class"] !== undefined
}

// A symbol is INTERNED, so two :names are the same handle and === / dict keying
// answer what the Go twin's comparable jsSym struct answers.
function rbSym(name) {
    var k = "$" + name
    var got = rbSymTable[k]
    if (got !== undefined) { return got }
    var s = {__sym: true, s: name}
    rbSymTable[k] = s
    return s
}

// ===================================================== the numeric tower ====
//
// abnf/jsrt.go's rubyNumRank / rubyToF / rubyGcd / rubyMkRat / rubyReOf /
// rubyImOf / rubyAsRat, in that order. Integer < Rational < Float < Complex;
// every arithmetic step promotes both operands to the higher rank.

function rbNumRank(v) {
    if (typeof v == "number") { return 0 }
    if (rbIsRat(v)) { return 1 }
    if (rbIsFlo(v)) { return 2 }
    if (rbIsCpx(v)) { return 3 }
    return 0 - 1
}

function rbIsNum(v) { return rbNumRank(v) >= 0 }

function rbToF(v) {
    if (typeof v == "number") { return v }
    if (rbIsFlo(v)) { return v["f"] }
    if (rbIsRat(v)) { return v["n"] / v["d"] }
    if (rbIsCpx(v)) { return v["re"] }
    return 0
}

function rbMkFlo(x) { return {__flo: true, f: x} }
function rbMkCpx(re, im) { return {__cpx: true, re: re, im: im} }

// ----- EXACT integer arithmetic on doubles, and why every one of these exists ---
//
// The Go twin computes Ruby's Integer `/` and `%` and rubyGcd's math.Mod in
// float64 - and on arm64 the Go compiler FUSES `x - q*y` into an FMSUB, so the
// product and the subtraction are done at INFINITE precision and only the final
// result is rounded. The C floor's clang does not fuse, so the same source gives a
// different answer the moment |q*y| leaves the exactly-representable range:
// `9007199254740991 % -3` is -2 under llvm.Run and -1 without the fusion. Measured
// on the 36,000-line probe; real ruby 2.6.10 says -2, so the FUSED answer is also
// the CORRECT one and this is layer 2's defect, not the Go twin's.
//
// rbFmaSub reproduces the fused `x - q*y` exactly, with the standard Dekker
// two-product / two-sum emulation of an FMA. It is used by BOTH the Integer and
// the Float remainder, which is where the Go source has the fusable expression.
var RB_SPLIT = 134217729              // 2^27 + 1, Dekker's splitting constant
var RB_SAFE = Math.pow(2, 500)        // an operand above this would overflow the
                                      // split, so it is SCALED first (below).
                                      // Written as a pow because the MetaJS dialect
                                      // has no exponent literals.
var RB_DOWN = Math.pow(2, 0 - 256)    // the scaling step, and its inverse
var RB_UP = Math.pow(2, 256)

// The high half of a, exactly representable in 26 bits.
function rbSplitHi(a) {
    var c = RB_SPLIT * a
    return c - (c - a)
}

// x - q*y, correctly rounded as if ONE fused multiply-add had computed it.
//
// The two-product needs both operands under 2^500 or the 2^27 split overflows, and
// a Float remainder legitimately has |q| near DBL_MAX (1e308 % 2.5). Scaling by a
// POWER OF TWO is exact, so each operand is brought down first and the exact
// product (p1 + e1) is scaled back by the same amount - |p1 * scale| is about |x|,
// so the scale-back cannot overflow.
// A zero carrying x's sign. `x * 0` is the obvious spelling AND IT IS WRONG IN
// THIS DIALECT: the tag engine keeps an integral value as an integer, so
// `-4 * 0` is the integer 0 and the sign is gone - measured, `1 / (x * 0)` is
// +Infinity for x = -4, where `1 / (z / (0 - 1))` is -Infinity. Dividing a zero
// by -1 is a float division in every engine and keeps the sign. zeroSigned in
// languages/ruby-interpreter.abnf is the same body; abnf/jsrt.go spells it
// math.Copysign(0, x), which Go has and this dialect does not.
function rbZeroSign(x) {
    var z = 0
    if (x < 0) { return z / (0 - 1) }
    if (x == 0 && 1 / x < 0) { return z / (0 - 1) }
    return z
}

function rbFmaSub(x, q, y) {
    var p = q * y
    if (p !== p) { return x - p }
    if (p - p !== 0) { return x - p }
    var qq = q
    var yy = y
    var scale = 1
    while (Math.abs(qq) > RB_SAFE) {
        qq = qq * RB_DOWN
        scale = scale * RB_UP
    }
    while (Math.abs(yy) > RB_SAFE) {
        yy = yy * RB_DOWN
        scale = scale * RB_UP
    }
    var p1 = qq * yy
    var qh = rbSplitHi(qq)
    var ql = qq - qh
    var yh = rbSplitHi(yy)
    var yl = yy - yh
    var e1 = ((qh * yh - p1) + qh * yl + ql * yh) + ql * yl
    var P = p1 * scale
    var E = e1 * scale
    // TwoSum of x and -P, then the correction by the product's own error term.
    var sm = x - P
    var bb = sm - x
    var d = (x - (sm - bb)) + (-P - bb)
    return sm + (d - E)
}

function rbGcd(a, b) {
    var x = Math.abs(a)
    var y = Math.abs(b)
    while (y != 0) {
        // math.Mod is EXACT in the Go twin (it is not the fusable expression, it is
        // a scaled subtraction loop), so the naive x - floor(x/y)*y was wrong for a
        // numerator past 2^53 and reduced 90071992547409900/3 to 30023997515803300/1.
        var t = rbFmaSub(x, Math.trunc(x / y), y)
        x = y
        y = t
    }
    return x
}

// The sign lives in the numerator and the pair is reduced, so two equal Rationals
// have equal fields - which is what makes the Go twin's value equality reachable
// through rbEq here.
function rbMkRat(n, d) {
    var nn = n
    var dd = d
    if (dd < 0) {
        nn = 0 - nn
        dd = 0 - dd
    }
    var g = rbGcd(nn, dd)
    if (g > 1) {
        nn = nn / g
        dd = dd / g
    }
    return {__rat: true, n: nn, d: dd}
}

function rbReOf(v) {
    if (rbIsCpx(v)) { return v["re"] }
    return rbToF(v)
}

function rbImOf(v) {
    if (rbIsCpx(v)) { return v["im"] }
    return 0
}

function rbAsRat(v) {
    if (rbIsRat(v)) { return v }
    return rbMkRat(rbToF(v), 1)
}

// Integer division and modulo FLOOR in Ruby (-7 / 2 is -4, -7 % 3 is 2).
function rbIDiv(a, b) {
    if (b == 0) { fail("divided by 0") }
    return Math.floor(a / b)
}

function rbIMod(a, b) {
    if (b == 0) { fail("divided by 0") }
    return rbFmaSub(a, Math.floor(a / b), b)
}

// rubyNumBin: one arithmetic step over the tower.
function rbNumBin(op, l, r) {
    var rk = rbNumRank(l)
    var rr = rbNumRank(r)
    if (rk < 0 || rr < 0) { fail("not a number in '" + op + "'") }
    if (rr > rk) { rk = rr }
    if (rk == 3) {
        var ar = rbReOf(l)
        var ai = rbImOf(l)
        var br = rbReOf(r)
        var bi = rbImOf(r)
        if (op == "+") { return rbMkCpx(ar + br, ai + bi) }
        if (op == "-") { return rbMkCpx(ar - br, ai - bi) }
        if (op == "*") { return rbMkCpx(ar * br - ai * bi, ar * bi + ai * br) }
        if (op == "/") {
            var den = br * br + bi * bi
            return rbMkCpx((ar * br + ai * bi) / den, (ai * br - ar * bi) / den)
        }
        fail("Complex does not support '" + op + "'")
    }
    if (rk == 1) {
        var p = rbAsRat(l)
        var q = rbAsRat(r)
        if (op == "+") { return rbMkRat(p["n"] * q["d"] + q["n"] * p["d"], p["d"] * q["d"]) }
        if (op == "-") { return rbMkRat(p["n"] * q["d"] - q["n"] * p["d"], p["d"] * q["d"]) }
        if (op == "*") { return rbMkRat(p["n"] * q["n"], p["d"] * q["d"]) }
        if (op == "/") { return rbMkRat(p["n"] * q["d"], p["d"] * q["n"]) }
    }
    if (rk >= 1) {
        var x = rbToF(l)
        var y = rbToF(r)
        if (op == "+") { return rbMkFlo(x + y) }
        if (op == "-") { return rbMkFlo(x - y) }
        if (op == "*") { return rbMkFlo(x * y) }
        if (op == "/") { return rbMkFlo(x / y) }
        // Float#% - see rubyFloMod in abnf/jsrt.go. Ruby's flodivmod IS
        // `mod = fmod(x, y); if (y*mod < 0) mod += y`, so this is that body
        // verbatim; `x - floor(x/y)*y` was an approximation of it that lost
        // every digit once floor(x/y)*y stopped being exact. rbZeroSign puts
        // back the DIVIDEND's sign that fmod's zero carries and the tag engine
        // drops.
        if (op == "%") {
            var fm = x % y
            if (fm == 0) { return rbMkFlo(rbZeroSign(x)) }
            if (y * fm < 0) { return rbMkFlo(fm + y) }
            return rbMkFlo(fm)
        }
        if (op == "**") { return rbMkFlo(Math.pow(x, y)) }
        fail("Float does not support '" + op + "'")
    }
    var a = rbToF(l)
    var b = rbToF(r)
    if (op == "+") { return a + b }
    if (op == "-") { return a - b }
    if (op == "*") { return a * b }
    if (op == "/") { return rbIDiv(a, b) }
    if (op == "%") { return rbIMod(a, b) }
    if (op == "**") {
        if (b < 0) { return rbMkFlo(Math.pow(a, b)) }
        return Math.pow(a, b)
    }
    // & | ^ are int64 in Go (`float64(int64(x) & int64(y))`). MetaJS's own & | ^
    // are ToInt32, so they would wrap at 32 bits where the Go twin does not; the
    // 64 bit halves are computed with the floor's sized-integer arithmetic below.
    if (op == "&") { return rbBits64(op, a, b) }
    if (op == "|") { return rbBits64(op, a, b) }
    if (op == "^") { return rbBits64(op, a, b) }
    if (op == "<<") { return a * Math.pow(2, b) }
    if (op == ">>") { return Math.floor(a / Math.pow(2, b)) }
    fail("Integer does not support '" + op + "'")
    return 0
}

// & | ^ over the full int64 range, which is what `float64(int64(x) op int64(y))`
// is in the Go twin. The floor's sized-integer tag (tag 13, docs part 2) does
// exactly that arithmetic, and sintNum reads the signed 64 bit result back as a
// double - so the whole of it is four calls and no 32 bit wrap. sint() applies
// si_norm, which is precisely right here: an Integer IS "a value exact in a
// double" until it leaves the tower, so a result inside +-2^53 comes back unboxed
// and one outside it stays a cell that sintNum reads.
function rbBits64(op, a, b) {
    var x = sintRaw(sintHi(Math.trunc(a)), sintLo(Math.trunc(a)), 64, false)
    var y = sintRaw(sintHi(Math.trunc(b)), sintLo(Math.trunc(b)), 64, false)
    var code = 5
    if (op == "|") { code = 6 }
    if (op == "^") { code = 7 }
    return sintNum(sintOp(code, x, y))
}

function rbNumCmp(l, r) {
    var a = rbToF(l)
    var b = rbToF(r)
    if (a < b) { return 0 - 1 }
    if (a > b) { return 1 }
    return 0
}

// rubyNeg: unary minus over the tower. Written `0 - x` NOWHERE - the signed-zero
// trap the plan records has bitten five languages, and `0 - 0.0` is `+0.0` where
// the sign has to survive. MetaJS's own unary minus compiles to js_neg, which is
// the floor's sign flip.
function rbNeg(v) {
    if (typeof v == "number") { return -v }
    if (rbIsFlo(v)) { return rbMkFlo(-v["f"]) }
    if (rbIsRat(v)) { return {__rat: true, n: -v["n"], d: v["d"]} }
    if (rbIsCpx(v)) { return rbMkCpx(-v["re"], -v["im"]) }
    if (rbUserObj(v)) { return rbMethod(v, "-@", []) }
    fail("cannot negate a " + typeof v)
    return 0
}

// ===================================================== rendering ============

// rubyFloStr: a Float keeps its decimal point even when it is whole (1000.0), which
// is what tells it apart from the Integer 1000, and goes to exponent form outside
// RUBY'S window rather than JavaScript's. numeric.c flo_to_s: exponential when
// `decpt < -3 || decpt > DBL_DIG` (15), the mantissa always carrying a fraction
// digit and the exponent always signed and at least two digits. The full before /
// after table and the ground truth (ruby 2.6.10p210 - Float#to_s is unchanged in
// 3.x and needs no Ruby-3 syntax to probe) are at rubyFloStr in abnf/jsrt.go.

// rtSplit10 (languages/lib/runtime.metajs) turns a > 0 into {d: significant
// digits, e: the scientific exponent}; python, ruby and swift had three copies of
// it, byte-identical bar swift's comments. rtSciText and rtFixText are the two
// halves of the rendering, also shared. What is RUBY'S is the boundary between
// them and the forced ".0" on a one-digit mantissa - `dot` - which is why
// 1e+20.to_s is "1.0e+20" where Python and Swift print "1e+20".
//
// The low bound is the SAME predicate in all three, spelled two ways: ruby's
// `decpt < -3` and python's `decpt <= -4` both mean e10 <= -5.
function rtkFloDigits(a) {
    var p = rtSplit10(a)
    var decpt = p.e + 1
    if (decpt < 0 - 3 || decpt > 15) { return rtSciText(p.d, p.e, true) }
    return rtFixText(p.d, decpt)
}

// rtFloStr is the shared body; the three strings are the knob. Float::NAN.to_s
// is "NaN" and Float::INFINITY.to_s is "Infinity", where Python's are lowercase.
function rbFloStr(x) { return rtFloStr(x, "NaN", "Infinity", "-Infinity") }

function rbStr(v) {
    if (rbIsNil(v)) { return "" }
    if (typeof v == "string") { return v }
    if (typeof v == "number") { return "" + v }
    if (rbIsFlo(v)) { return rbFloStr(v["f"]) }
    if (rbIsRat(v)) { return ("" + v["n"]) + "/" + ("" + v["d"]) }
    if (rbIsCpx(v)) { return ("" + v["re"]) + "+" + ("" + v["im"]) + "i" }
    if (rbIsSym(v)) { return v["s"] }
    if (rbIsArr(v)) { return rbInspect(v) }
    if (rbIsDict(v)) { return rbInspect(v) }
    if (rbIsObj(v)) {
        // A CLASS object stringifies as its name (`Foo.to_s` / "#{Foo}" == "Foo").
        if (v["__isclass"] === true) {
            var nm = v["__name"]
            if (typeof nm == "string") { return nm }
        }
        var m = rbFindMethod(v, "to_s")
        if (m !== undefined) { return rbStr(m.apply(undefined, [v])) }
        // An exception instance renders as its message, like Exception#to_s.
        if (v["args"] !== undefined) {
            var msg = rbExcMessage(v)
            if (msg !== undefined) { return "" + msg }
        }
    }
    return "" + v
}

// Ruby's #inspect: nil, quoted strings, :symbols, and the bracketed collections.
function rbInspect(v) {
    if (rbIsNil(v)) { return "nil" }
    if (typeof v == "string") { return "\"" + v + "\"" }
    if (rbIsSym(v)) { return ":" + v["s"] }
    if (rbIsArr(v)) {
        var out = "["
        var i = 0
        while (i < v.length) {
            if (i > 0) { out = out + ", " }
            out = out + rbInspect(v[i])
            i = i + 1
        }
        return out + "]"
    }
    if (rbIsDict(v)) {
        var keys = v["keys"]
        var vals = v["vals"]
        var s = "{"
        var j = 0
        while (j < keys.length) {
            if (j > 0) { s = s + ", " }
            s = s + rbInspect(keys[j]) + " => " + rbInspect(vals[j])
            j = j + 1
        }
        return s + "}"
    }
    return rbStr(v)
}

// ===================================================== format ===============
//
// rubyFormat: the printf directives Ruby shares with C,
// %[-][0][+][ ][width][.prec](d|i|f|s|x|X|o|b|e|%).

// ----- EXACT decimal expansion of a double ---------------------------------
//
// strconv.FormatFloat prints the EXACT value of the double and rounds HALF TO
// EVEN, which the naive `Math.floor(a * 10^prec + 0.5)` gets wrong twice over:
// it rounds half AWAY from zero (Go's %.0f of 2.5 is "2", not "3") and it loses
// every digit past 2^53 ("%f" of 1e100 has to print all 101 of them). Both were
// measured on the differential probe.
//
// A finite double is m * 2^e with m an integer below 2^53, so its exact decimal
// is a bignum: for e >= 0 it is m doubled e times, and for e < 0 it is m
// multiplied by 5 exactly -e times with the point placed -e digits from the
// right (because 2^-e == 5^-e / 10^-e). The bignum is a little-endian array of
// base-10000 limbs; multiplying by 2 or by 5 keeps every intermediate under
// 50000 + 10000, which a double holds exactly.

// The exact decimal of |x| as {i: <integer digits>, f: <fraction digits>}.
// Round the digit string `digits` (an integer written out) to `keep` digits,
// half to EVEN, and answer the kept digits - one longer when the rounding
// carried all the way (999 -> 1000), which the caller detects by the length.
// strconv.FormatFloat(v, 'f', prec, 64), exactly: the true decimal of the double,
// cut to prec fraction digits with half-to-even rounding.
// strconv.FormatFloat(v, 'e', prec, 64): d.dddde+XX, at least two exponent digits.
function rbSci(x, prec) {
    if (x !== x) { return "NaN" }
    if (x - x !== 0) {
        if (x > 0) { return "+Inf" }
        return "-Inf"
    }
    var neg = x < 0
    if (x == 0 && 1 / x < 0) { neg = true }
    var a = neg ? -x : x
    if (a == 0) {
        var z = "0"
        if (prec > 0) {
            z = z + "."
            var zi = 0
            while (zi < prec) {
                z = z + "0"
                zi = zi + 1
            }
        }
        return (neg ? "-" : "") + z + "e+00"
    }
    var dec = rtExactDec(a)
    var ip = dec["i"]
    var fp = dec["f"]
    var all = ip + fp
    // The exponent of the first significant digit, relative to the point.
    var lead = 0
    while (lead < all.length && all.charAt(lead) == "0") { lead = lead + 1 }
    var e = ip.length - 1 - lead
    var sig = all.substring(lead, all.length)
    var kept = rtRoundHalfEven(sig, prec + 1)
    if (kept.length > prec + 1) {
        // 9.99 -> 10.0: one digit fell out of the mantissa.
        e = e + 1
        kept = kept.substring(0, prec + 1)
    }
    var m = kept.substring(0, 1)
    if (prec > 0) { m = m + "." + kept.substring(1, kept.length) }
    var es = "" + (e < 0 ? 0 - e : e)
    if (es.length < 2) { es = "0" + es }
    return (neg ? "-" : "") + m + "e" + (e < 0 ? "-" : "+") + es
}

// ----- %g / %G -------------------------------------------------------------
//
// UNIMPLEMENTED in every half until now: "g" reached rbFormat's default arm, which
// emitted the letter itself and did not even consume its argument, so
// ("%g" % 1.5) was "g". The twin (rt.rubyFormat in abnf/jsrt.go) has
// strconv.FormatFloat(v, 'g', P, 64); this is that function spelled out, and the
// two were diffed digit for digit against ruby 2.6.10 over 14 values x 4
// precisions (Float#% is unchanged in 3.x, so the row is settleable there).
//
// The rule: P is the precision, defaulting to 6, and P == 0 means 1. Round to P
// SIGNIFICANT digits; if the resulting decimal exponent X is below -4 or at least
// P, write the %e shape with P-1 fraction digits, otherwise the %f shape with
// P-1-X of them. Then strip the fraction's trailing zeros, and a bare trailing
// point with them. 999999.5 at P=6 is the row that proves the exponent has to be
// read AFTER the rounding: it becomes 1000000, so X is 6 and the answer is
// "1e+06", not "999999" or "1000000".

// The trailing zeros of a fraction, and a trailing point, removed. `t` may carry
// an exponent suffix; only the mantissa is touched.
function rbGenStrip(t) {
    var at = 0 - 1
    var k = 0
    while (k < t.length) {
        if (t.charAt(k) == "e" || t.charAt(k) == "E") {
            at = k
            break
        }
        k = k + 1
    }
    var mant = at < 0 ? t : t.substring(0, at)
    var tail = at < 0 ? "" : t.substring(at, t.length)
    var dot = false
    var j = 0
    while (j < mant.length) {
        if (mant.charAt(j) == ".") { dot = true }
        j = j + 1
    }
    if (!dot) { return t }
    while (mant.charAt(mant.length - 1) == "0") { mant = mant.substring(0, mant.length - 1) }
    if (mant.charAt(mant.length - 1) == ".") { mant = mant.substring(0, mant.length - 1) }
    return mant + tail
}

// The decimal exponent of `t`, which rbSci wrote as [-]d[.ddd]e[+-]XX.
function rbSciExp(t) {
    var at = 0 - 1
    var k = 0
    while (k < t.length) {
        if (t.charAt(k) == "e") {
            at = k
            break
        }
        k = k + 1
    }
    if (at < 0) { return 0 }
    var sign = 1
    var i = at + 1
    if (t.charAt(i) == "-") {
        sign = 0 - 1
        i = i + 1
    } else if (t.charAt(i) == "+") {
        i = i + 1
    }
    var v = 0
    while (i < t.length) {
        var d = rtDigitAt(t, i)
        if (d < 0) { break }
        v = v * 10 + d
        i = i + 1
    }
    return sign * v
}

// strconv.FormatFloat(x, 'g', prec, 64), for prec >= 1.
function rbGen(x, prec) {
    var e = rbSci(x, prec - 1)
    var ex = rbSciExp(e)
    if (ex < 0 - 4 || ex >= prec) { return rbGenStrip(e) }
    return rbGenStrip(rtFixed(x, prec - 1 - ex))
}

// Ruby prints "Inf", "-Inf" and "NaN" for a non-finite float under EVERY float
// directive, in that case whatever the directive's own case is, and pads them with
// spaces even under the 0 flag. Go's strconv says "+Inf", which is what reached the
// output before. rubyFloatWord in abnf/jsrt.go is the twin.
function rbFloatWord(x) {
    if (x !== x) { return "NaN" }
    if (x - x !== 0) {
        if (x > 0) { return "Inf" }
        return "-Inf"
    }
    return ""
}

// strconv.FormatInt(int64(x), base) is rtBaseStr, in
// languages/lib/runtime.metajs. Ruby's Integer#to_s(base) is what reaches its
// int64-saturating branches: 1e100.to_i.to_s(16) is "7fffffffffffffff".

// strings.ToUpper / strings.ToLower - the full Unicode SIMPLE mapping. The C
// floor's own toUpperCase / toLowerCase are exactly that (runtime.c generated its
// 328 ranges from the Go runtime's own answers), so an ASCII loop here would be a
// third, worse, copy: it printed "CAFé" for "café".
function rbUpper(s) { return s.toUpperCase() }
function rbLower(s) { return s.toLowerCase() }

// The first `n` BYTES of a string, as Go's body[:n] takes them. Every string the
// %s directive can be handed is valid UTF-8 here, and a cut that would land inside
// a multi-byte character stops before it - which is what a Go slice of a valid
// string does to the RUNES, and the corpus has no case that reaches it.
function rbByteCut(s, n) {
    var out = ""
    var i = 0
    while (i < s.length) {
        var next = out + s.charAt(i)
        if (byteLen(next) > n) { return out }
        out = next
        i = i + 1
    }
    return out
}

// The directives that take a SIGN and honour the 0 flag.
function rbFmtNumeric(conv) {
    if (conv == "d" || conv == "i" || conv == "f") { return true }
    if (conv == "e" || conv == "E" || conv == "g" || conv == "G") { return true }
    return conv == "x" || conv == "X" || conv == "o" || conv == "b"
}

function rbIsSignChar(c) { return c == "-" || c == "+" || c == " " }

function rbFormat(spec, arg) {
    var args = [arg]
    if (rbIsArr(arg)) { args = arg }
    var ai = 0
    var out = ""
    var i = 0
    while (i < spec.length) {
        if (spec.charAt(i) != "%") {
            out = out + spec.charAt(i)
            i = i + 1
            continue
        }
        i = i + 1
        if (i >= spec.length) {
            out = out + "%"
            i = i + 1
            continue
        }
        if (spec.charAt(i) == "%") {
            out = out + "%"
            i = i + 1
            continue
        }
        var left = false
        var zero = false
        var plus = false
        var space = false
        while (i < spec.length) {
            var fc = spec.charAt(i)
            if (fc != "-" && fc != "0" && fc != "+" && fc != " ") { break }
            if (fc == "-") { left = true }
            if (fc == "0") { zero = true }
            if (fc == "+") { plus = true }
            if (fc == " ") { space = true }
            i = i + 1
        }
        var width = 0
        while (i < spec.length) {
            var wd = rtDigitAt(spec, i)
            if (wd < 0) { break }
            width = width * 10 + wd
            i = i + 1
        }
        var prec = 0 - 1
        if (i < spec.length && spec.charAt(i) == ".") {
            i = i + 1
            prec = 0
            while (i < spec.length) {
                var pd = rtDigitAt(spec, i)
                if (pd < 0) { break }
                prec = prec * 10 + pd
                i = i + 1
            }
        }
        if (i >= spec.length) { break }
        var conv = spec.charAt(i)
        i = i + 1
        var nx = null
        if (ai < args.length) { nx = args[ai] }
        var body = ""
        var nonFinite = false
        if (conv == "d" || conv == "i") {
            ai = ai + 1
            body = "" + Math.trunc(rbToF(nx))
        } else if (conv == "f") {
            ai = ai + 1
            var ff = rbToF(nx)
            var fw = rbFloatWord(ff)
            if (fw != "") {
                body = fw
                nonFinite = true
            } else {
                body = rtFixed(ff, prec < 0 ? 6 : prec)
            }
        } else if (conv == "e" || conv == "E") {
            ai = ai + 1
            var ef = rbToF(nx)
            var ew = rbFloatWord(ef)
            if (ew != "") {
                body = ew
                nonFinite = true
            } else {
                body = rbSci(ef, prec < 0 ? 6 : prec)
                if (conv == "E") { body = rbUpper(body) }
            }
        } else if (conv == "g" || conv == "G") {
            ai = ai + 1
            var gf = rbToF(nx)
            var gw = rbFloatWord(gf)
            if (gw != "") {
                body = gw
                nonFinite = true
            } else {
                var gp = prec < 0 ? 6 : prec
                if (gp == 0) { gp = 1 }
                body = rbGen(gf, gp)
                if (conv == "G") { body = rbUpper(body) }
            }
        } else if (conv == "s") {
            ai = ai + 1
            body = rbStr(nx)
            // body[:prec] in Go is a BYTE slice; the cut has to count bytes too.
            if (prec >= 0 && prec < byteLen(body)) { body = rbByteCut(body, prec) }
        } else if (conv == "x") {
            ai = ai + 1
            body = rtBaseStr(rbToF(nx), 16)
        } else if (conv == "X") {
            ai = ai + 1
            body = rbUpper(rtBaseStr(rbToF(nx), 16))
        } else if (conv == "o") {
            ai = ai + 1
            body = rtBaseStr(rbToF(nx), 8)
        } else if (conv == "b") {
            ai = ai + 1
            body = rtBaseStr(rbToF(nx), 2)
        } else {
            body = conv
        }
        // The + and SPACE flags were parsed and thrown away, in every half, so
        // "%+d" % 7 was "7" against MRI's "+7" - both halves agreeing and both
        // wrong, the one class byte-identity cannot see. They apply to the NUMERIC
        // directives only, Inf and NaN included ("%+f" % Float::INFINITY is "+Inf").
        var numeric = rbFmtNumeric(conv)
        if (numeric && body.charAt(0) != "-") {
            if (plus) { body = "+" + body } else if (space) { body = " " + body }
        }
        // The 0 flag is for NUMBERS: MRI's "%05s" % "ab" is "   ab", where this used
        // to pad with zeros. A non-finite float is never zero-padded either.
        var pad = " "
        if (zero && !left && !nonFinite && numeric) { pad = "0" }
        // Go pads to `len(body)`, which is the BYTE length of the UTF-8 string, not
        // the number of characters: "%10s" of "café" gets FIVE spaces, not six.
        // byteLen is the floor's own answer to that and it is what the emitters
        // already use (lib/compile-core.js emitStr).
        while (byteLen(body) < width) {
            if (left) {
                body = body + " "
            } else if (pad == "0" && body.length > 0 && rbIsSignChar(body.charAt(0))) {
                body = body.substring(0, 1) + pad + body.substring(1, body.length)
            } else {
                body = pad + body
            }
        }
        out = out + body
    }
    return out
}

// ===================================================== truthiness ===========
//
// rubyTruthy: only nil and false are falsy (0, "" and the empty collections are
// all truthy). It backs the select/reject predicates so js_rxmcall agrees with
// the emitter's own `handle >= 3` compare, and NOT with JS truthiness.
function rbTruthy(v) {
    if (rbIsNil(v)) { return false }
    if (v === false) { return false }
    return true
}

// ===================================================== dicts ================
//
// dictFind / dictScan / dictAppend of abnf/jsrt.go. The Go side keeps an index
// alongside the keys array as a pure ACCELERATOR (a hit is confirmed against the
// array before it is used), so a linear scan answers exactly what it answers.
// SHARED as rtDictFind - lib/runtime.metajs. This body was byte-identical in
// dart, ruby and swift, and equal to go's goDictFind; see the argument there.
function rbDictFind(keys, k) { return rtDictFind(keys, k) }

function rbDictSet(d, k, v) {
    var keys = d["keys"]
    var i = rbDictFind(keys, k)
    if (i >= 0) {
        d["vals"][i] = v
        return undefined
    }
    keys.push(k)
    d["vals"].push(v)
    return undefined
}

function rbNewDict() { return js_dict_new() }

function rbCopyArr(a) {
    var out = []
    var i = 0
    while (i < a.length) {
        out.push(a[i])
        i = i + 1
    }
    return out
}

// ===================================================== equality =============

// pyEqual: structural for Array and Hash, === for everything else.
function rbPyEqual(x, y) {
    if (rbIsArr(x)) {
        if (!rbIsArr(y)) { return false }
        if (x.length != y.length) { return false }
        var i = 0
        while (i < x.length) {
            if (!rbPyEqual(x[i], y[i])) { return false }
            i = i + 1
        }
        return true
    }
    if (rbIsDict(x)) {
        if (!rbIsDict(y)) { return false }
        var xk = x["keys"]
        var xv = x["vals"]
        var yk = y["keys"]
        var yv = y["vals"]
        if (xk.length != yk.length) { return false }
        var j = 0
        while (j < xk.length) {
            var at = rbDictFind(yk, xk[j])
            if (at < 0) { return false }
            if (!rbPyEqual(xv[j], yv[at])) { return false }
            j = j + 1
        }
        return true
    }
    return x === y
}

// An exception instance: a user object carrying the `args` slot every raise path
// fills in. A class descriptor is not one.
function rbExcObj(v) {
    if (!rbIsObj(v)) { return false }
    if (v["__isclass"] === true) { return false }
    if (v["args"] === undefined) { return false }
    return v["__class"] !== undefined
}

// rubyEq: numeric across the whole tower (2.0 == 2, 1r/2r == 0.5), a user class's
// own == when it defines one, and the structural comparison otherwise.
function rbEq(l, r) {
    if (rbIsNum(l) && rbIsNum(r)) {
        if (rbIsCpx(l) || rbIsCpx(r)) {
            if (rbReOf(l) != rbReOf(r)) { return false }
            return rbImOf(l) == rbImOf(r)
        }
        return rbToF(l) == rbToF(r)
    }
    if (rbUserObj(l)) {
        var m = rbFindMethod(l, "==")
        if (m !== undefined) { return rbTruthy(m.apply(undefined, [l, r])) }
    }
    // An exception compares equal to its own message - the same deliberate
    // divergence rubyEq of ruby-interpreter.abnf makes, so a program that raises a
    // plain string still reads its rescue value as that string.
    if (typeof r == "string" && rbExcObj(l)) { return rbStr(l) === r }
    if (typeof l == "string" && rbExcObj(r)) { return rbStr(r) === l }
    return rbPyEqual(l, r)
}

// rubySpaceship: null when the two cannot be compared, which is Ruby's answer.
function rbSpaceship(l, r) {
    if (rbUserObj(l)) {
        var m = rbFindMethod(l, "<=>")
        if (m !== undefined) { return Math.trunc(rbToF(m.apply(undefined, [l, r]))) }
        return null
    }
    if (rbIsNum(l) && rbIsNum(r)) { return rbNumCmp(l, r) }
    if (typeof l == "string" && typeof r == "string") {
        if (l < r) { return 0 - 1 }
        if (r < l) { return 1 }
        return 0
    }
    if (rbIsArr(l) && rbIsArr(r)) {
        var i = 0
        while (i < l.length && i < r.length) {
            var c = rbSpaceship(l[i], r[i])
            if (c !== null && c != 0) { return c }
            i = i + 1
        }
        return l.length - r.length
    }
    return null
}

// < > <= >= raise in Ruby when the values cannot be compared.
function rbCmp(l, r) {
    var c = rbSpaceship(l, r)
    if (c === null) { fail("comparison of incompatible values") }
    return c
}

// ===================================================== classes ==============

// rubyFindMethod: walk the __class / __super chain of an INSTANCE for a method.
function rbFindMethod(v, name) {
    if (!rbIsObj(v)) { return undefined }
    var cls = v["__class"]
    while (cls !== undefined && cls !== null) {
        if (!rbIsObj(cls)) { return undefined }
        var m = cls[name]
        if (m !== undefined && rbIsFn(m)) { return m }
        cls = cls["__super"]
    }
    return undefined
}

// rubyClassName: the builtin class a runtime value belongs to ("" when none).
function rbClassName(v) {
    if (v === true) { return "TrueClass" }
    if (v === false) { return "FalseClass" }
    if (rbIsNil(v)) { return "NilClass" }
    if (typeof v == "number") { return "Integer" }
    if (typeof v == "string") { return "String" }
    if (rbIsFlo(v)) { return "Float" }
    if (rbIsRat(v)) { return "Rational" }
    if (rbIsCpx(v)) { return "Complex" }
    if (rbIsSym(v)) { return "Symbol" }
    if (rbIsArr(v)) { return "Array" }
    if (rbIsDict(v)) { return "Hash" }
    return ""
}

// rubyBuiltinClass: ONE object per name, so `1.class == Integer` and
// `case v when Integer` compare identities.
function rbBuiltinClass(name) {
    var k = "$" + name
    var got = rbClassTable[k]
    if (got !== undefined) { return got }
    var c = {__isclass: true, __rbuiltin: name, __name: name}
    rbClassTable[k] = c
    return c
}

// rubyExcParent: the ancestry of the builtin exception classes - the part of
// Ruby's class tree a rescue clause has to know about. Exception is the root.
var rbExcParent = {
    $StandardError: "Exception",
    $RuntimeError: "StandardError",
    $ArgumentError: "StandardError",
    $TypeError: "StandardError",
    $NameError: "StandardError",
    $NoMethodError: "NameError",
    $IndexError: "StandardError",
    $KeyError: "IndexError",
    $RangeError: "StandardError",
    $ZeroDivisionError: "StandardError",
    $StopIteration: "IndexError",
    $FrozenError: "RuntimeError",
    $NotImplementedError: "StandardError"
}

function rbExcParentOf(name) {
    var p = rbExcParent["$" + name]
    if (typeof p == "string") { return p }
    return ""
}

// rubyExcIsA: "v is an exception of the builtin class named bn". It walks the
// value's own __class/__super chain (so a user subclass counts) and, once that
// reaches a BUILTIN class, continues up rbExcParent by name.
function rbExcIsA(v, bn) {
    if (bn != "Exception" && rbExcParentOf(bn) == "") { return false }
    if (!rbIsObj(v)) { return false }
    var c = v["__class"]
    while (c !== undefined && c !== null) {
        if (!rbIsObj(c)) { return false }
        var name = c["__name"]
        if (typeof name != "string") { name = "" }
        if (typeof c["__rbuiltin"] == "string") {
            var n = name
            while (n != "") {
                if (n == bn) { return true }
                n = rbExcParentOf(n)
            }
            return false
        }
        if (name == bn) { return true }
        c = c["__super"]
    }
    return false
}

// rubyIsA: `v.is_a?(cls)` / `cls === v`. A builtin class matches by the value's
// runtime kind (Integer/Float also count as Numeric and Comparable), a compiled
// class by walking the instance's __class / __super chain.
function rbIsA(v, cls) {
    if (!rbIsObj(cls)) { return false }
    var bn = cls["__rbuiltin"]
    if (typeof bn == "string") {
        var kind = rbClassName(v)
        if (kind == bn) { return true }
        if (rbExcIsA(v, bn)) { return true }
        if (bn == "Numeric") { return rbIsNum(v) }
        if (bn == "Comparable") {
            if (rbIsNum(v)) { return true }
            return kind == "String"
        }
        if (bn == "Object") { return true }
        if (bn == "BasicObject") { return true }
        if (bn == "Kernel") { return true }
        if (bn == "Enumerable") {
            if (kind == "Array") { return true }
            return kind == "Hash"
        }
        return false
    }
    if (!rbIsObj(v)) { return false }
    var c = v["__class"]
    while (c !== undefined && c !== null) {
        if (c === cls) { return true }
        if (!rbIsObj(c)) { return false }
        c = c["__super"]
    }
    return false
}

// rubyExc: {__class: <class>, args: [message]}, the shape the message reader and
// the rescue type test both understand.
function rbExc(cls, args) {
    return {__class: cls, args: rbCopyArr(args)}
}

// Exception#message / #to_s: the first constructor argument, or the class name.
function rbExcMessage(o) {
    var arr = o["args"]
    if (rbIsArr(arr) && arr.length > 0) { return rbStr(arr[0]) }
    var cls = o["__class"]
    if (rbIsObj(cls)) {
        var n = cls["__name"]
        if (typeof n == "string") { return n }
    }
    return undefined
}

// rubyMakeExc turns the operand of Ruby's `raise` into the object to throw:
//   a class object   -> a fresh instance, the message as its single argument
//                       (its own initialize still runs when it defines one)
//   a string         -> a RuntimeError carrying that message, as in MRI
//   nil / undefined  -> a BARE raise: re-raise what the running rescue caught
//   anything else    -> raised unchanged (raise ArgumentError.new("arg"))
function rbMakeExc(v, msg) {
    if (rbIsNil(v)) {
        if (rbCurExc !== null) { return rbCurExc }
        return rbExc(rbBuiltinClass("RuntimeError"), [])
    }
    if (typeof v == "string") { return rbExc(rbBuiltinClass("RuntimeError"), [v]) }
    if (rbIsObj(v) && v["__isclass"] === true) {
        var argv = []
        if (!rbIsNil(msg)) { argv = [msg] }
        var inst = rbExc(v, argv)
        if (rbFindMethod(inst, "initialize") !== undefined) { rbMethod(inst, "initialize", argv) }
        return inst
    }
    return v
}

// The class a @@class variable belongs to: the class of an instance, or `self`
// itself when the code runs in a class method or a class body.
function rbClassOfSelf(self) {
    if (!rbIsObj(self)) { return null }
    if (self["__isclass"] === true) { return self }
    var c = self["__class"]
    if (c === undefined) { return null }
    return c
}

// ===================================================== ranges ===============

// String#succ for the alphanumeric case: the last character is incremented,
// carrying into the one before it when it wraps ("az" -> "ba").
function rbStrSucc(s) {
    if (s == "") { return "" }
    var codes = []
    var i = 0
    while (i < s.length) {
        codes.push(s.charCodeAt(i))
        i = i + 1
    }
    var j = codes.length - 1
    while (j >= 0) {
        var c = codes[j]
        var done = false
        if (c >= 97 && c < 122) {
            codes[j] = c + 1
            done = true
        } else if (c >= 65 && c < 90) {
            codes[j] = c + 1
            done = true
        } else if (c >= 48 && c < 57) {
            codes[j] = c + 1
            done = true
        } else if (c == 122) {
            codes[j] = 97
        } else if (c == 90) {
            codes[j] = 65
        } else if (c == 57) {
            codes[j] = 48
        } else {
            codes[j] = c + 1
            done = true
        }
        if (done) { return rbFromCodes(codes) }
        j = j - 1
    }
    // Every position wrapped: Go prepends the FIRST byte of the wrapped string.
    var out = rbFromCodes(codes)
    return out.charAt(0) + out
}

function rbFromCodes(codes) {
    var out = ""
    var i = 0
    while (i < codes.length) {
        out = out + String.fromCharCode(codes[i])
        i = i + 1
    }
    return out
}

// rubyRangeArr materializes lo..hi (excl: the three-dot form) as an array. The
// step caps keep a nonsensical range from hanging the program - the same two
// constants the Go twin uses.
function rbRangeArr(lo, hi, excl) {
    var out = []
    if (typeof lo == "string") {
        var hs = rbStr(hi)
        var s = lo
        var n = 0
        while (n < 1000000) {
            if (excl && s == hs) { break }
            if (s.length > hs.length) { break }
            out.push(s)
            if (s == hs) { break }
            s = rbStrSucc(s)
            n = n + 1
        }
        return out
    }
    var l = rbToF(lo)
    var h = rbToF(hi)
    if (excl) { h = h - 1 }
    var k = 0
    var i = l
    while (i <= h && k < 10000000) {
        out.push(i)
        i = i + 1
        k = k + 1
    }
    return out
}

// rubyOpenRangeCover: `r.cover?(v)` / `r === v` for a range with a missing bound,
// where the missing side never constrains.
function rbOpenRangeCover(o, v) {
    var lo = o["begin"]
    if (!rbIsNil(lo)) {
        var c = rbSpaceship(v, lo)
        if (c === null) { return false }
        if (c < 0) { return false }
    }
    var hi = o["end"]
    if (!rbIsNil(hi)) {
        var d = rbSpaceship(v, hi)
        if (d === null) { return false }
        if (o["excl"] === true) { return d < 0 }
        return d <= 0
    }
    return true
}

// ===================================================== binary operators =====

function rbRepeat(s, n) {
    var out = ""
    var i = 0
    while (i < n) {
        out = out + s
        i = i + 1
    }
    return out
}

// rubyBin: the one binary operator step. A user object dispatches to its own
// operator method, strings and arrays get their Ruby operators, everything else
// is the numeric tower.
function rbBin(op, l, r) {
    if (rbUserObj(l)) {
        // An exception instance that defines no + of its own concatenates as its
        // message, so `raise e + "er"` inside a rescue keeps working.
        if (op == "+" && l["args"] !== undefined && rbFindMethod(l, "+") === undefined) {
            return rbStr(l) + rbStr(r)
        }
        return rbMethod(l, op, [r])
    }
    if (op == "+") {
        if (typeof l == "string") { return rbStr(l) + rbStr(r) }
        if (typeof r == "string") { return rbStr(l) + rbStr(r) }
        if (rbIsArr(l) && rbIsArr(r)) {
            var out = rbCopyArr(l)
            var i = 0
            while (i < r.length) {
                out.push(r[i])
                i = i + 1
            }
            return out
        }
    }
    if (op == "*") {
        if (typeof l == "string") {
            var n = Math.trunc(rbToF(r))
            if (n < 0) { n = 0 }
            return rbRepeat(l, n)
        }
        if (rbIsArr(l)) {
            var rep = []
            var t = 0
            var times = Math.trunc(rbToF(r))
            while (t < times) {
                var j = 0
                while (j < l.length) {
                    rep.push(l[j])
                    j = j + 1
                }
                t = t + 1
            }
            return rep
        }
    }
    if (op == "-") {
        if (rbIsArr(l) && rbIsArr(r)) {
            var diff = []
            var a = 0
            while (a < l.length) {
                var drop = false
                var b = 0
                while (b < r.length) {
                    if (rbPyEqual(l[a], r[b])) {
                        drop = true
                        break
                    }
                    b = b + 1
                }
                if (!drop) { diff.push(l[a]) }
                a = a + 1
            }
            return diff
        }
    }
    if (op == "%") {
        if (typeof l == "string") { return rbFormat(l, r) }
    }
    if (op == "<<") {
        if (rbIsArr(l)) {
            l.push(r)
            return l
        }
        if (typeof l == "string") { return l + rbStr(r) }
    }
    return rbNumBin(op, l, r)
}

// ===================================================== Regexp / MatchData ===
//
// abnf/jsrtregex.go's Ruby half. The ENGINE is languages/lib/regex.js, imported
// at the top of this file, so only the value model and the method tables are
// here. Both values are ordinary objects carrying __rx-prefixed slots, exactly
// as the Go twin has them, so nothing else in this file has to learn a new type.

var rbRxCache = {}   // "$<flags> <pattern>" -> a compiled program

function rbRxGet(pattern, flags) {
    var key = "$" + flags + " " + pattern
    var got = rbRxCache[key]
    if (got !== undefined) { return got }
    var re = rxCompile(pattern, flags)
    rbRxCache[key] = re
    return re
}

function rbRxIsRegex(v) {
    if (!rbIsObj(v)) { return false }
    if (v["__rxsrc"] === undefined) { return false }
    return rbIsNil(v["__rxmd"])
}

function rbRxIsMatch(v) {
    if (!rbIsObj(v)) { return false }
    return !rbIsNil(v["__rxmd"])
}

function rbRxObjRe(v) {
    var src = v["__rxsrc"]
    var flags = v["__rxflags"]
    if (typeof src != "string") { src = "" }
    if (typeof flags != "string") { flags = "" }
    return rbRxGet(src, flags)
}

function rbRxNewRegex(src, flags) { return {__rxsrc: src, __rxflags: flags} }

function rbRxNewMatch(src, flags, text, m) {
    var caps = []
    var i = 0
    var mc = m["caps"]
    while (i < mc.length) {
        caps.push(mc[i])
        i = i + 1
    }
    return {__rxmd: true, __rxsrc: src, __rxflags: flags, __rxtext: text, __rxcaps: caps}
}

// The Go twin's rxMatchOf answers three values; MetaJS has one return, so the
// three travel in a record. text stays a STRING: regex.js indexes UTF-16 code
// units where the Go engine indexes runes, which agree for everything in the
// Basic Multilingual Plane and therefore for every pattern in the corpus.
function rbRxMatchOf(v) {
    var re = rbRxObjRe(v)
    var text = v["__rxtext"]
    if (typeof text != "string") { text = "" }
    var arr = v["__rxcaps"]
    var caps = []
    var i = 0
    while (i < arr.length) {
        caps.push(Math.trunc(rbToF(arr[i])))
        i = i + 1
    }
    var begin = 0
    var end = 0
    if (caps.length >= 2) {
        begin = caps[0]
        end = caps[1]
    }
    return {re: re, text: text, m: {begin: begin, end: end, caps: caps}}
}

// rxSetGlobals publishes $~, $& and $1..$9 after a match attempt. A FAILED match
// clears them.
function rbRxSetGlobals(md) {
    var i = 1
    if (md === null) {
        rbGset("~", null)
        rbGset("&", null)
        while (i <= 9) {
            rbGset("" + i, null)
            i = i + 1
        }
        return undefined
    }
    var mo = rbRxMatchOf(md)
    rbGset("~", md)
    var whole = rxGroup(mo["re"], mo["text"], mo["m"], 0)
    rbGset("&", whole === null ? null : whole)
    while (i <= 9) {
        var g = rxGroup(mo["re"], mo["text"], mo["m"], i)
        rbGset("" + i, g === null ? null : g)
        i = i + 1
    }
    return undefined
}

// rxRunMatch searches and publishes the globals; null for no match.
function rbRxRunMatch(reObj, s, from) {
    var re = rbRxObjRe(reObj)
    if (!re["ok"]) { fail("invalid regexp /" + re["src"] + "/: " + re["err"]) }
    var m = rxSearch(re, s, from)
    if (m === null) {
        rbRxSetGlobals(null)
        return null
    }
    var o = rbRxNewMatch(re["src"], re["flags"], s, m)
    rbRxSetGlobals(o)
    return o
}

// MatchData#[]: an Integer reads a group by number, a Symbol or a String by name.
function rbRxMdIndex(md, key) {
    var mo = rbRxMatchOf(md)
    if (typeof key == "number") {
        var g = rxGroup(mo["re"], mo["text"], mo["m"], Math.trunc(key))
        if (g === null) { return null }
        return g
    }
    var name = ""
    if (rbIsSym(key)) { name = key["s"] } else if (typeof key == "string") { name = key } else { return null }
    var gi = rxIndexOfName(mo["re"], name)
    if (gi >= 0) {
        var gv = rxGroup(mo["re"], mo["text"], mo["m"], gi)
        if (gv !== null) { return gv }
    }
    return null
}

function rbRxCaptureArray(re, text, m, withWhole) {
    var out = []
    var i = withWhole ? 0 : 1
    while (i <= re["ngroups"]) {
        var g = rxGroup(re, text, m, i)
        out.push(g === null ? null : g)
        i = i + 1
    }
    return out
}

// String#scan: with no group it collects the whole matches, with groups the
// capture list of each match.
function rbRxScan(reObj, s) {
    var re = rbRxObjRe(reObj)
    var out = []
    var at = 0
    while (at <= s.length) {
        var m = rxSearch(re, s, at)
        if (m === null) { break }
        if (re["ngroups"] == 0) {
            var g = rxGroup(re, s, m, 0)
            out.push(g === null ? "" : g)
        } else {
            out.push(rbRxCaptureArray(re, s, m, false))
        }
        if (m["end"] == m["begin"]) { at = m["end"] + 1 } else { at = m["end"] }
    }
    return out
}

// The =~ operator: either operand may be the pattern, and the answer is the
// INDEX of the match (not a boolean) or nil.
function rbRxMatchOp(l, r) {
    var reObj = null
    var subj = null
    if (rbRxIsRegex(l)) {
        reObj = l
        subj = r
    } else if (rbRxIsRegex(r)) {
        reObj = r
        subj = l
    } else {
        fail("=~ needs a Regexp on one side")
    }
    if (rbIsNil(subj)) {
        rbRxSetGlobals(null)
        return null
    }
    var md = rbRxRunMatch(reObj, rbStr(subj), 0)
    if (md === null) { return null }
    var mo = rbRxMatchOf(md)
    return mo["m"]["begin"]
}

// rxRegexMethod answers a method call whose RECEIVER is a Regexp or a MatchData
// (or a String with a pattern argument), and `undefined` when the name is none of
// theirs - `undefined` is a safe miss sentinel because a Ruby method answers nil,
// which is null here and never undefined.
function rbRxMethod(target, name, args) {
    if (rbRxIsRegex(target)) {
        var re = rbRxObjRe(target)
        if (name == "match?") { return rxSearch(re, rbStr(rbArgAt(args, 0)), 0) !== null }
        if (name == "match") {
            var from = 0
            if (args.length > 1 && typeof args[1] == "number") { from = Math.trunc(args[1]) }
            var md = rbRxRunMatch(target, rbStr(rbArgAt(args, 0)), from)
            if (md === null) { return null }
            return md
        }
        if (name == "=~") { return rbRxMatchOp(target, rbArgAt(args, 0)) }
        if (name == "===") { return rbRxMatchOp(target, rbArgAt(args, 0)) !== null }
        if (name == "source") { return re["src"] }
        if (name == "options") { return 0 }
        if (name == "names") { return rbCopyArr(re["names"]) }
        if (name == "to_s") { return "(?-mix:" + re["src"] + ")" }
        if (name == "inspect") { return "/" + re["src"] + "/" + re["flags"] }
        if (name == "class") { return "Regexp" }
        fail("unknown Regexp method: " + name)
    }
    if (rbRxIsMatch(target)) {
        var mo = rbRxMatchOf(target)
        var mre = mo["re"]
        var text = mo["text"]
        var m = mo["m"]
        if (name == "[]") { return rbRxMdIndex(target, rbArgAt(args, 0)) }
        if (name == "to_a") { return rbRxCaptureArray(mre, text, m, true) }
        if (name == "captures") { return rbRxCaptureArray(mre, text, m, false) }
        if (name == "named_captures") {
            var d = rbNewDict()
            var ni = 0
            var nms = mre["names"]
            while (ni < nms.length) {
                var gv = rxGroup(mre, text, m, rxIndexOfName(mre, nms[ni]))
                d["keys"].push(nms[ni])
                d["vals"].push(gv === null ? null : gv)
                ni = ni + 1
            }
            return d
        }
        if (name == "names") { return rbCopyArr(mre["names"]) }
        if (name == "pre_match") { return text.substring(0, m["begin"]) }
        if (name == "post_match") { return text.substring(m["end"], text.length) }
        if (name == "begin" || name == "end") {
            var g = 0
            if (args.length > 0 && typeof args[0] == "number") { g = Math.trunc(args[0]) }
            var slot = 2 * g
            if (name == "end") { slot = slot + 1 }
            var caps = m["caps"]
            if (slot < caps.length) { return caps[slot] }
            return null
        }
        if (name == "size" || name == "length") { return mre["ngroups"] + 1 }
        if (name == "to_s") {
            var w = rxGroup(mre, text, m, 0)
            return w === null ? "" : w
        }
        if (name == "inspect") {
            var w2 = rxGroup(mre, text, m, 0)
            return "#<MatchData \"" + (w2 === null ? "" : w2) + "\">"
        }
        if (name == "class") { return "MatchData" }
        fail("unknown MatchData method: " + name)
    }
    // A String receiver whose argument is a pattern: the pattern-taking half of
    // Ruby's String methods, which the base dispatch knows nothing about.
    if (typeof target == "string" && args.length > 0) {
        var wants = false
        if (name == "match" || name == "match?" || name == "=~" || name == "scan") { wants = true }
        if (name == "sub" || name == "gsub" || name == "sub!" || name == "gsub!") { wants = true }
        if (name == "split" || name == "index") { wants = true }
        if (!wants) { return undefined }
        var pat = args[0]
        if (!rbRxIsRegex(pat)) {
            if (name == "split" || name == "index") { return undefined }
            pat = rbRxNewRegex(rbStr(args[0]), "m")
        }
        if (name == "match") {
            var smd = rbRxRunMatch(pat, target, 0)
            if (smd === null) { return null }
            return smd
        }
        if (name == "match?") { return rxSearch(rbRxObjRe(pat), target, 0) !== null }
        if (name == "=~") { return rbRxMatchOp(pat, target) }
        if (name == "scan") { return rbRxScan(pat, target) }
        if (name == "sub" || name == "sub!") { return rxReplace(rbRxObjRe(pat), target, rbStr(rbArgAt(args, 1)), false) }
        if (name == "gsub" || name == "gsub!") { return rxReplace(rbRxObjRe(pat), target, rbStr(rbArgAt(args, 1)), true) }
        if (name == "split") { return rxSplit(rbRxObjRe(pat), target) }
        if (name == "index") { return rbRxMatchOp(pat, target) }
    }
    return undefined
}

// ===================================================== method dispatch ======

function rbArgAt(args, i) {
    if (i < args.length) { return args[i] }
    return undefined
}

function rbCall1(f, a) { return f.apply(undefined, [a]) }
function rbCall2(f, a, b) { return f.apply(undefined, [a, b]) }

// rubyNumMethod: the Integer / Float / Rational / Complex method set. It answers
// `undefined` for a name it does not know, so the caller carries on with the
// generic dispatch (and its error message).
function rbNumMethod(t, name, args) {
    var x = rbToF(t)
    var isInt = typeof t == "number"
    if (name == "to_s" || name == "inspect") {
        if (isInt && args.length > 0) { return rtBaseStr(x, Math.trunc(rbToF(args[0]))) }
        return rbStr(t)
    }
    if (name == "to_i" || name == "to_int" || name == "truncate") { return Math.trunc(x) }
    if (name == "to_f") {
        if (rbIsFlo(t)) { return t }
        return rbMkFlo(x)
    }
    if (name == "to_r") { return rbAsRat(t) }
    if (name == "abs") {
        if (rbIsFlo(t)) { return rbMkFlo(Math.abs(x)) }
        return Math.abs(x)
    }
    if (name == "floor") { return Math.floor(x) }
    if (name == "ceil") { return Math.ceil(x) }
    if (name == "round") {
        if (args.length > 0) {
            var p = Math.pow(10, rbToF(args[0]))
            return rbMkFlo(Math.floor(x * p + 0.5) / p)
        }
        if (x < 0) { return -Math.floor(-x + 0.5) }
        return Math.floor(x + 0.5)
    }
    if (name == "zero?") { return x == 0 }
    if (name == "positive?") { return x > 0 }
    if (name == "negative?") { return x < 0 }
    if (name == "even?") { return x - Math.floor(x / 2) * 2 == 0 }
    if (name == "odd?") { return x - Math.floor(x / 2) * 2 != 0 }
    if (name == "succ" || name == "next") { return x + 1 }
    if (name == "pred") { return x - 1 }
    if (name == "chr") { return String.fromCharCode(Math.trunc(x)) }
    if (name == "integer?") { return isInt }
    if (name == "numerator") { return rbAsRat(t)["n"] }
    if (name == "denominator") { return rbAsRat(t)["d"] }
    if (name == "times") {
        var i = 0
        while (i < x) {
            rbCall1(rbArgAt(args, 0), i)
            i = i + 1
        }
        return t
    }
    if (name == "upto") {
        var u = x
        var hi = rbToF(rbArgAt(args, 0))
        while (u <= hi) {
            rbCall1(rbArgAt(args, 1), u)
            u = u + 1
        }
        return t
    }
    if (name == "downto") {
        var d = x
        var lo = rbToF(rbArgAt(args, 0))
        while (d >= lo) {
            rbCall1(rbArgAt(args, 1), d)
            d = d - 1
        }
        return t
    }
    if (name == "divmod") {
        var y = rbToF(rbArgAt(args, 0))
        return [Math.floor(x / y), rbFmaSub(x, Math.floor(x / y), y)]
    }
    if (name == "fdiv") { return rbMkFlo(x / rbToF(rbArgAt(args, 0))) }
    if (name == "pow" || name == "**") { return rbBin("**", t, rbArgAt(args, 0)) }
    if (name == "gcd") { return rbGcd(x, rbToF(rbArgAt(args, 0))) }
    if (name == "between?") {
        if (x < rbToF(rbArgAt(args, 0))) { return false }
        return x <= rbToF(rbArgAt(args, 1))
    }
    if (name == "clamp") {
        var clo = rbToF(rbArgAt(args, 0))
        var chi = rbToF(rbArgAt(args, 1))
        if (x < clo) { return args[0] }
        if (x > chi) { return args[1] }
        return t
    }
    if (name == "real") { return rbReOf(t) }
    if (name == "imaginary" || name == "imag") { return rbImOf(t) }
    if (name == "+" || name == "-" || name == "*" || name == "/" || name == "%") { return rbBin(name, t, rbArgAt(args, 0)) }
    if (name == "&" || name == "|" || name == "^" || name == "<<" || name == ">>") { return rbBin(name, t, rbArgAt(args, 0)) }
    if (name == "==") { return rbEq(t, rbArgAt(args, 0)) }
    if (name == "<=>") {
        var c = rbSpaceship(t, rbArgAt(args, 0))
        if (c === null) { return null }
        return c
    }
    return undefined
}

// rubyArrayMethod. select and reject use RUBY truthiness, and pop/first/last
// answer nil (not an error) on an empty array.
function rbArrayMethod(t, name, args) {
    if (name == "size" || name == "length") { return t.length }
    if (name == "push" || name == "append" || name == "add") {
        var i = 0
        while (i < args.length) {
            t.push(args[i])
            i = i + 1
        }
        return t
    }
    if (name == "pop") {
        if (t.length == 0) { return null }
        return t.pop()
    }
    if (name == "first") {
        if (t.length == 0) { return null }
        return t[0]
    }
    if (name == "last") {
        if (t.length == 0) { return null }
        return t[t.length - 1]
    }
    if (name == "include?" || name == "contains") { return rbDictFind(t, rbArgAt(args, 0)) >= 0 }
    if (name == "to_a") { return rbCopyArr(t) }
    if (name == "each") {
        var e = 0
        while (e < t.length) {
            rbCall1(rbArgAt(args, 0), t[e])
            e = e + 1
        }
        return t
    }
    if (name == "each_with_index") {
        var w = 0
        while (w < t.length) {
