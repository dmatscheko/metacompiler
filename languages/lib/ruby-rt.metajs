// abnf/jsrtregex.go, which states the rule.
function rbReOpts(flags, embed) {
    var f = flags
    if (f.substring(0, 3) == "mpn") { f = f.substring(3, f.length) }
    var m = f.indexOf("s") >= 0
    var i = f.indexOf("i") >= 0
    var x = f.indexOf("x") >= 0
