// === (case equality): a Range matches by membership, an Array by membership,
// a class object by is_a?, everything else by ==.
function js_rcase(l, r) {
    if (rbIsRange(l)) { return rbOpenRangeCover(l, r) }
    if (rbIsArr(l)) {
        var i = 0
        while (i < l.length) {
            if (rbEq(l[i], r)) { return true }
            i = i + 1
        }
        return false
    }
    if (rbIsObj(l) && l["__isclass"] === true) { return rbIsA(r, l) }
    return rbEq(l, r)
