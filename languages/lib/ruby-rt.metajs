// The builtin class objects: one object per name, so `1.class == Integer` and
// `when Integer` compare identities.
function js_rclass(name) { return rbBuiltinClass(rbStr(name)) }

// Ruby's to_s, for string interpolation and puts.
function js_rstr(v) { return rbStr(v) }

// Kernel#puts with RUBY rendering: an array is walked recursively (one element
// per line), an EMPTY array prints nothing, everything else prints its to_s.
function js_rputs(v) {
    if (rbIsArr(v)) {
        var i = 0
        while (i < v.length) {
            js_rputs(v[i])
            i = i + 1
        }
        return undefined
    }
    println(rbStr(v))
    return undefined
}

function js_rprint(v) {
    print(rbStr(v))
    return undefined
}

// Kernel#p: INSPECT, one argument per line, answering the argument (the whole
// list when there is more than one, nil when there is none). One extern rather
// than an emitted loop, so the return value is the same in both engines.
function js_rp(args) {
    if (!rbIsArr(args)) { return null }
    if (args.length == 0) { return null }
    var i = 0
    while (i < args.length) {
        println(rbInspect(args[i]))
        i = i + 1
    }
    if (args.length == 1) { return args[0] }
    return rtCopyArr(args)
}

// Kernel#format / sprintf: the argument array is [format, args...].
function js_rformat(args) {
    if (!rbIsArr(args) || args.length == 0) { return "" }
    var rest = []
    var i = 1
    while (i < args.length) {
        rest.push(args[i])
        i = i + 1
    }
    return rbFormat(rbStr(args[0]), rest)
}

// Kernel#rand, as a call the emitter makes for the bare name. See rbRand.
function js_rrand(args) {
    if (!rbIsArr(args) || args.length == 0) { return rbRand(null) }
    return rbRand(args[0])
}

// %W[..] / %I[..]: split an interpolated body on whitespace into an array of
// strings (or of symbols when the flag is set). strings.Fields drops empties.
function js_rsplitw(v, asSym) {
    var s = rbStr(v)
    var sym = rbTruthy(asSym)
    var out = []
    var cur = ""
    var i = 0
    while (i < s.length) {
        var c = s.charCodeAt(i)
        var isSp = false
        if (c == 32 || c == 9 || c == 10 || c == 13 || c == 11 || c == 12) { isSp = true }
        if (isSp) {
            if (cur != "") {
                out.push(sym ? rbSym(cur) : cur)
                cur = ""
            }
        } else {
            cur = cur + s.charAt(i)
        }
        i = i + 1
    }
    if (cur != "") { out.push(sym ? rbSym(cur) : cur) }
    return out
}

// Ruby indexing: a Proc calls itself, a user class dispatches `def [](i)`, a Hash
// answers nil for a missing key and an Array answers nil out of range.
function js_rget(o, k) {
    if (rbIsFn(o)) { return o.apply(undefined, [k]) }
    if (rbUserObj(o)) { return rbMethod(o, "[]", [k]) }
    if (rbIsDict(o)) {
        var i = rbDictFind(o["keys"], k)
        if (i < 0) { return rbHashDefault(o, k) }
        return o["vals"][i]
    }
    var idx = Math.trunc(rbToF(k))
    if (rbIsArr(o)) {
        if (idx < 0) { idx = idx + o.length }
        if (idx < 0 || idx >= o.length) { return null }
        return o[idx]
    }
    if (typeof o == "string") {
        if (idx < 0) { idx = idx + o.length }
        if (idx < 0 || idx >= o.length) { return null }
        return o.charAt(idx)
    }
    if (rbIsNil(o)) { fail("indexing nil") }
    return o[k]
}

// Ruby index assignment: a user class dispatches `def []=`, a missing Hash key is
// APPENDED and an Array GROWS, filling the gap with nil.
function js_rset(o, k, v) {
    if (rbUserObj(o)) {
        rbMethod(o, "[]=", [k, v])
        return undefined
    }
    if (rbIsDict(o)) { return rbDictSet(o, k, v) }
    if (!rbIsArr(o)) { fail("item assignment on a " + typeof o) }
    var idx = Math.trunc(rbToF(k))
    if (idx < 0) { idx = idx + o.length }
    if (idx < 0) { fail("index " + idx + " too small for array") }
    while (o.length <= idx) { o.push(null) }
    o[idx] = v
    return undefined
}

// C.new(args): build an instance of a compiled class and run its initialize. Two
// builtin classes are constructed directly: Proc.new { } is its block, and an
// exception class makes the {__class, args} shape the rescue clauses read.
function js_rnew(cls, args) {
    var argv = []
    if (rbIsArr(args)) { argv = args }
    if (rbIsObj(cls)) {
        var bn = cls["__rbuiltin"]
        if (typeof bn == "string") {
            if (bn == "Proc") {
                if (argv.length > 0 && rbIsFn(argv[argv.length - 1])) { return argv[argv.length - 1] }
                return null
            }
            // Array.new(n) / Array.new(n, v) / Array.new(n) { |i| }. Without this
            // arm it fell into the exception construction below and answered the
            // first argument - a silent wrong answer, and a different one in each
            // engine.
            if (bn == "Array") { return rbArrNew(argv) }
            // Hash.new / Hash.new(v) / Hash.new { |h, k| }. The default lives in the
            // hidden __hdef / __hdefp slot and rbHashDefault honours it at every read;
            // before that the two argument forms fell through to rbExc below and
            // answered an exception object.
            if (bn == "Hash") { return rbNewHash(argv) }
            return rbExc(cls, argv)
        }
    }
    var inst = {__class: cls}
    rbMethod(inst, "initialize", argv)
    return inst
}

// Ruby's `raise` in one step. rbMakeExc turns a class / a string / a bare
// re-raise into the exception object, which is then thrown exactly as js_throw
// does - MetaJS's own `throw` compiles to the floor's js_throw.
function js_rraise(v, msg) {
    throw rbMakeExc(v, msg)
}

// Whether an argument was ABSENT (js_arg answers undefined for one that was not
// passed). Ruby's nil is a VALUE and must not trigger a default.
function js_rundef(v) { return v === undefined }

// *rest: the arguments from index i on, as an array (a trailing block closure is
// not one of them). i is a RAW parameter: the emitter writes it with handle(pos).
function js_rargrest(args, i_raw) {
    var out = []
    if (!rbIsArr(args)) { return out }
    var i = i_raw
    while (i < args.length) {
        if (i == args.length - 1 && rbIsFn(args[i])) { break }
        out.push(args[i])
        i = i + 1
    }
    return out
}

// One POSITIONAL argument for a parameter that has a default: the trailing block
// slot of the argument list is not a positional value, so `def d(x = 5); yield x;
// end; d { }' leaves x at its default instead of binding it to the block. A
// REQUIRED parameter reads js_arg instead and still sees a trailing callable, so
// `def m(f); end; m(some_proc)' keeps binding f to the proc. i is a RAW parameter:
// the emitter writes it with handle(pos).
function js_rposarg(args, i_raw) {
    if (!rbIsArr(args)) { return undefined }
    var i = i_raw
    if (i < rbNPos(args)) { return args[i] }
    return undefined
