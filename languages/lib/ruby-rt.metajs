// **rest: the keyword hash minus the keys the named keyword parameters took.
function js_rkwrest(kwh, taken) {
    var out = rbNewDict()
    if (!rbIsDict(kwh)) { return out }
    var keys = kwh["keys"]
    var vals = kwh["vals"]
    var i = 0
    while (i < keys.length) {
        var drop = false
        if (rbIsArr(taken)) {
            var t = 0
            while (t < taken.length) {
                if (rbEq(taken[t], keys[i])) {
                    drop = true
                    break
                }
                t = t + 1
            }
        }
        if (!drop) {
            out["keys"].push(keys[i])
            out["vals"].push(vals[i])
        }
        i = i + 1
    }
    return out
