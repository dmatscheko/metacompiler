// A NameError / NoMethodError carrying MRI's #name and #receiver in the hidden
// __nmname / __nmrecv slots. Twin of rubyNameErr in abnf/jsrt.go.
function rbNameErr(cls, msg, name, recv) {
    var e = rbExc(rbBuiltinClass(cls), [msg])
