}

// ===================================================== binary operators =====

// rbRepeat is SHARED as rtRepeat - lib/runtime.metajs, next to rtZeros.

// rubyBin: the one binary operator step. A user object dispatches to its own
// operator method, strings and arrays get their Ruby operators, everything else
// is the numeric tower.
function rbBin(op, l, r) {
    if (rbUserObj(l)) {
        // An exception instance that defines no + of its own concatenates as its
        // message, so `raise e + "er"` inside a rescue keeps working.
        if (op == "+" && l["__args"] !== undefined && rbFindMethod(l, "+") === undefined) {
            return rbStr(l) + rbStr(r)
        }
        return rbMethod(l, op, [r])
    }
    // String#+, #* and #% answer a new String: a box.
    if (op == "+") {
        if (typeof l == "string") { return rbMkRStr(l + rbStrOperand(r), false) }
        if (rbIsArr(l) && rbIsArr(r)) {
            var out = rtCopyArr(l)
            var i = 0
            while (i < r.length) {
                out.push(r[i])
                i = i + 1
            }
            return out
        }
    }
    if (op == "*") {
        if (typeof l == "string") {
            var n = Math.trunc(rbToF(r))
            if (n < 0) { n = 0 }
            return rbMkRStr(rtRepeat(l, n), false)
        }
        // Array#* is repetition with an Integer and JOIN with a String.
        if (rbIsArr(l) && typeof r == "string") { return rbArrJoin(l, r) }
        if (rbIsArr(l) && typeof r == "object" && rtTag(r, "__rstr")) { return rbArrJoin(l, r["__s"]) }
        if (rbIsArr(l)) {
            var rep = []
            var t = 0
            var times = Math.trunc(rbToF(r))
            while (t < times) {
                var j = 0
                while (j < l.length) {
                    rep.push(l[j])
                    j = j + 1
                }
                t = t + 1
            }
            return rep
        }
    }
    if (op == "-") {
        // Array#- is eql?/hash, like uniq and unlike include?: MRI answers
        // `[1, 2.0] - [2]` with [1, 2.0] (rbPyEqual would convert across the
        // numeric classes and drop the 2.0).
        if (rbIsArr(l) && rbIsArr(r)) {
            var diff = []
            var a = 0
            while (a < l.length) {
                var drop = false
                var b = 0
                while (b < r.length) {
                    if (rbEql(l[a], r[b])) {
