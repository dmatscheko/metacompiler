// a[i, len] = v / a[range] = v / s[i] = c: SLICE assignment. It answers the
// container, or the box a plain string became, which the emitter writes back.
// Mirrors rubySetSlice of abnf/jsrt.go and rsetSlice of ruby-interpreter.abnf.
function js_rsetsl(o, k1, k2, v) {
    if (rbUserObj(o)) {
        if (rtIsNil(k2)) { rbMethod(o, "[]=", [k1, v]) } else { rbMethod(o, "[]=", [k1, k2, v]) }
        return o
