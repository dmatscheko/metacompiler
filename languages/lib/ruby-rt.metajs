    var ad = anytype
    var bn = anytype
    var bd = anytype
    var p0 = anytype
    var p1 = anytype
    var q0 = anytype
    var q1 = anytype
    var c = anytype
    an = an0
    ad = ad0
    bn = bn0
    bd = bd0
    p0 = 0
    p1 = 1
    q0 = 1
    q1 = 0
    c = 0
    var walking = true
    while (walking) {
        c = rbNumBin("-", 0, rbNumBin("/", rbNumBin("-", 0, an), ad))
        if (rbNumCmp(rbNumBin("*", c, bd), bn) < 0) {
            walking = false
        } else {
