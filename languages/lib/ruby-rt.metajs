// rbSliceBounds resolves a Ruby subscript pair to {s, l} against a receiver of
// size n. An absent second subscript means a ONE-element write, unless the key is
// a Range (read from its own endpoints) or an Array, whose first element is the
// low bound and whose length is the count. Mirrors rubySliceBounds of
// abnf/jsrt.go.
function rbSliceBounds(n, k1, k2) {
    var st = 0
    var ln = 1
    if (!rtIsNil(k2)) {
        st = Math.trunc(rbToF(k1))
        ln = Math.trunc(rbToF(k2))
        if (ln < 0) { ln = 0 }
    } else if (rbIsRange(k1)) {
        // A RANGE key, read from its own endpoints, so `a[1..-1] = v' works.
        var rb0 = rtIsNil(k1["begin"]) ? 0 : Math.trunc(rbToF(k1["begin"]))
        if (rb0 < 0) { rb0 = rb0 + n }
        var re0 = n - 1
        if (!rtIsNil(k1["end"])) {
            re0 = Math.trunc(rbToF(k1["end"]))
            if (re0 < 0) { re0 = re0 + n }
            if (k1["excl"] === true) { re0 = re0 - 1 }
        }
        st = rb0
        ln = re0 - rb0 + 1
        if (ln < 0) { ln = 0 }
        return {s: st, l: ln}
    } else if (rbIsArr(k1)) {
        if (k1.length == 0) { return {s: n, l: 0} }
        st = Math.trunc(rbToF(k1[0]))
        ln = k1.length
    } else {
        st = Math.trunc(rbToF(k1))
    }
    if (st < 0) { st = st + n }
    return {s: st, l: ln}
