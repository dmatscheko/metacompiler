// ===================================================== Regexp / MatchData ===
//
// abnf/jsrtregex.go's Ruby half. The ENGINE is languages/lib/regex.js, imported
// at the top of this file, so only the value model and the method tables are
// here. Both values are ordinary objects carrying __rx-prefixed slots, exactly
// as the Go twin has them, so nothing else in this file has to learn a new type.

// The compile cache and the two value tests are SHARED - rxCache / rxGet,
// rxIsRegexObj / rxIsMatchObj and rxObjRe, all lib/regex.js, all under the Go
// twin's own names.
function rbRxIsRegex(v) { return rxIsRegexObj(v) }

function rbRxIsMatch(v) { return rxIsMatchObj(v) }

function rbRxObjRe(v) { return rxObjRe(v) }

function rbRxNewRegex(src, flags) { return {__rxsrc: src, __rxflags: flags} }

function rbRxNewMatch(src, flags, text, m) {
    var caps = []
    var i = 0
    var mc = m["caps"]
