// ToInt32, which MetaJS's own `| 0` already is (js_bor runs it on both sides).
function rbToInt32(n) { return n | 0 }

// memberCall, reduced to the arms a Ruby program can reach: an INSTANCE walks its
// __class chain, a plain object calls its own callable property. The string, list
// and dict arms of the Go twin's memberCall are Kotlin's and Python's and are
// shadowed by rbMethod below, which answers every Ruby name first.
function rbMemberCall(target, name, args) {
    if (rbIsObj(target)) {
        var cls = target["__class"]
        if (cls !== undefined) {
            while (cls !== undefined && cls !== null) {
                if (!rbIsObj(cls)) { break }
                var m = cls[name]
                if (m !== undefined && rbIsFn(m)) {
                    var argv = [target]
                    var i = 0
                    while (i < args.length) {
                        argv.push(args[i])
                        i = i + 1
                    }
                    return m.apply(undefined, argv)
                }
                cls = cls["__super"]
            }
            fail("unknown method '" + name + "' on an instance")
        }
        var own = target[name]
        if (own !== undefined && rbIsFn(own)) { return own.apply(undefined, args) }
        fail("unknown method '" + name + "'")
    }
    fail("method call '" + name + "' on a " + typeof target)
