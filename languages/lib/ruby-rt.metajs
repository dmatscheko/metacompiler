// Kernel#format / sprintf / printf: the argument array is [format, args...], and
// frame is the method's name. The answer is a new String, so a box. Twin of
// js_rformat in abnf/jsrtruby.go.
function js_rformat(args, frame) {
    if (!rbIsArr(args) || args.length == 0) { return rbMkRStr("", false) }
    var rest = []
    var i = 1
    while (i < args.length) {
        rest.push(args[i])
        i = i + 1
