        i = i + 1
    }
    return out
}

// Twin of ivarNameOk in ruby-interpreter.abnf.
function rbIvarNameOk(n) {
    if (n.length < 2 || n.charCodeAt(0) != 64) { return false }
    var i = 1
    while (i < n.length) {
        var c = n.charCodeAt(i)
        var ok = c == 95 || c >= 128 || (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
        if (i > 1 && c >= 48 && c <= 57) { ok = true }
        if (!ok) { return false }
        i = i + 1
    }
    return true
}

// Integer#[]. Twin of intBitAt in ruby-interpreter.abnf.
function rbIntBit(n, i) {
    if (rbToF(i) < 0) { return 0 }
    return rbBin("&", rbBin(">>", n, i), 1)
