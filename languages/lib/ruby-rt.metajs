        sc = sc["__super"]
    }
    if (m !== undefined) { return rbStr(m.apply(undefined, [o])) }
    return o["__name"]
}

// The __name of an instance's class, "" when it has none.
function rbInstClassName(o) {
    var cls = o["__class"]
    if (rbIsObj(cls)) {
        var n = cls["__name"]
        if (typeof n == "string") { return n }
    }
    return ""
}

// MRI's Exception#inspect: "#<Class: to_s>", or the bare class name when to_s is
// empty. Mirrors rubyExcInspect of abnf/jsrt.go.
function rbExcInspect(name, msg) {
    if (name == "") { return msg }
    if (msg == "") { return name }
    return "#<" + name + ": " + msg + ">"
}

// ===================================================== format ===============
//
// rubyFormat: the printf directives Ruby shares with C,
// %[-][0][+][ ][width][.prec](d|i|f|s|x|X|o|b|e|%).

// The exact decimal expansion of a double (rtExactDec / rtRoundHalfEven /
// rtFixed) is shared, in languages/lib/runtime.metajs.

// strconv.FormatFloat(v, 'e', prec, 64): d.dddde+XX, at least two exponent digits.
function rbSci(x, prec) {
    if (x !== x) { return "NaN" }
    if (x - x !== 0) {
        if (x > 0) { return "+Inf" }
        return "-Inf"
    }
    var neg = x < 0
    if (x == 0 && 1 / x < 0) { neg = true }
    var a = neg ? -x : x
    if (a == 0) {
        var z = "0"
        if (prec > 0) {
            z = z + "."
            var zi = 0
            while (zi < prec) {
                z = z + "0"
                zi = zi + 1
            }
        }
        return (neg ? "-" : "") + z + "e+00"
    }
    var dec = rtExactDec(a)
    var ip = dec["i"]
    var fp = dec["f"]
    var all = ip + fp
    // The exponent of the first significant digit, relative to the point.
    var lead = 0
    while (lead < all.length && all.charAt(lead) == "0") { lead = lead + 1 }
    var e = ip.length - 1 - lead
    var sig = all.substring(lead, all.length)
    var kept = rtRoundHalfEven(sig, prec + 1)
    if (kept.length > prec + 1) {
        // 9.99 -> 10.0: one digit fell out of the mantissa.
        e = e + 1
        kept = kept.substring(0, prec + 1)
    }
    var m = kept.substring(0, 1)
    if (prec > 0) { m = m + "." + kept.substring(1, kept.length) }
    var es = "" + (e < 0 ? 0 - e : e)
    if (es.length < 2) { es = "0" + es }
    return (neg ? "-" : "") + m + "e" + (e < 0 ? "-" : "+") + es
}

// ----- %g / %G -------------------------------------------------------------
//
// The twin (rt.rubyFormat in abnf/jsrt.go) has strconv.FormatFloat(v, 'g', P,
// 64); this is that function spelled out, checked digit for digit against ruby
// 2.6.10 (Float#% is unchanged in 3.x).
//
// The rule: P is the precision, defaulting to 6, and P == 0 means 1. Round to P
// SIGNIFICANT digits; if the resulting decimal exponent X is below -4 or at least
// P, write the %e shape with P-1 fraction digits, otherwise the %f shape with
// P-1-X of them. Then strip the fraction's trailing zeros, and a bare trailing
// point with them. 999999.5 at P=6 is the row that proves the exponent has to be
// read AFTER the rounding: it becomes 1000000, so X is 6 and the answer is
// "1e+06", not "999999" or "1000000".

// The trailing zeros of a fraction, and a trailing point, removed. `t` may carry
// an exponent suffix; only the mantissa is touched.
function rbGenStrip(t) {
    var at = 0 - 1
    var k = 0
    while (k < t.length) {
        if (t.charAt(k) == "e" || t.charAt(k) == "E") {
            at = k
            break
        }
        k = k + 1
    }
    var mant = at < 0 ? t : t.substring(0, at)
    var tail = at < 0 ? "" : t.substring(at, t.length)
    var dot = false
    var j = 0
    while (j < mant.length) {
        if (mant.charAt(j) == ".") { dot = true }
        j = j + 1
    }
    if (!dot) { return t }
    while (mant.charAt(mant.length - 1) == "0") { mant = mant.substring(0, mant.length - 1) }
    if (mant.charAt(mant.length - 1) == ".") { mant = mant.substring(0, mant.length - 1) }
    return mant + tail
}

// The decimal exponent of `t`, which rbSci wrote as [-]d[.ddd]e[+-]XX.
function rbSciExp(t) {
    var at = 0 - 1
    var k = 0
    while (k < t.length) {
        if (t.charAt(k) == "e") {
            at = k
            break
        }
        k = k + 1
    }
    if (at < 0) { return 0 }
    var sign = 1
    var i = at + 1
    if (t.charAt(i) == "-") {
        sign = 0 - 1
        i = i + 1
    } else if (t.charAt(i) == "+") {
        i = i + 1
    }
    var v = 0
    while (i < t.length) {
        var d = rtDigitAt(t, i)
        if (d < 0) { break }
        v = v * 10 + d
        i = i + 1
    }
    return sign * v
}

// strconv.FormatFloat(x, 'g', prec, 64), for prec >= 1.
function rbGen(x, prec) {
    var e = rbSci(x, prec - 1)
    var ex = rbSciExp(e)
    if (ex < 0 - 4 || ex >= prec) { return rbGenStrip(e) }
    return rbGenStrip(rtFixed(x, prec - 1 - ex))
}

// ----- the # (alternate) flag ----------------------------------------------
//
// MRI: it keeps %g's trailing zeros ("%#g" % 100.0 is "100.000"), it forces a
// decimal point wherever there would be none ("%#.0f" % 1.0 is "1.", "%#.1g" %
// 1234.0 is "1.e+03"), and it puts a base prefix on %x/%X/%o/%b - but not on a
// zero.

// A decimal point at the END of the mantissa when there is none, in front of any
// exponent suffix.
function rbAltPoint(t) {
    var at = 0 - 1
    var k = 0
    while (k < t.length) {
        if (t.charAt(k) == "e" || t.charAt(k) == "E") {
            at = k
            break
        }
        k = k + 1
    }
    var mant = at < 0 ? t : t.substring(0, at)
    var tail = at < 0 ? "" : t.substring(at, t.length)
    var j = 0
    while (j < mant.length) {
        if (mant.charAt(j) == ".") { return t }
        j = j + 1
    }
    return mant + "." + tail
}

// %g's shape with the trailing zeros KEPT - rbGen without rbGenStrip.
function rbGenAlt(x, prec) {
    var e = rbSci(x, prec - 1)
    var ex = rbSciExp(e)
    if (ex < 0 - 4 || ex >= prec) { return rbAltPoint(e) }
    return rbAltPoint(rtFixed(x, prec - 1 - ex))
}

// "0x", "0X" or "0b" for a NON-ZERO value; "" otherwise ("%#x" % 0 is "0").
// The caller keeps the length so the 0 flag can pad behind it: "%#010x" % 255 is
// "0x000000ff".
//
// The test is on the VALUE and not on the digit string: a precision pads the
// digits, and "%#.5x" % 0 is "00000" in MRI with no prefix at all. Octal is a
// different rule again and lives in rbIntBody - "#" on %o means "make sure there
// is a leading zero", so "%#.5o" % 255 is "00377" and MRI leaves it off the ".."
// two's-complement form entirely.
function rbBasePrefix(conv, v) {
    if (rbIsBig(v)) {
        if (rtABigIsZero(v)) { return "" }
    } else if (v == 0) { return "" }
    if (conv == "x") { return "0x" }
    if (conv == "X") { return "0X" }
    if (conv == "b") { return "0b" }
    if (conv == "B") { return "0B" }
    return ""
}

// %c on an Integer is the CODE POINT and not the byte, so an astral value has to
// be written as the surrogate PAIR the floor's UTF-16 strings are made of -
// "%c" % 128512 is one emoji in MRI and here.
//
// Out of range is the one place this does not follow MRI: 0x110000 raises
// ArgumentError there and a negative renders a raw invalid byte, neither of which
// any engine here can express, so all three answer the empty string. rubyCharCode
// in abnf/jsrt.go and charFromCode in languages/ruby-interpreter.abnf are twins.
function rbCharCode(cp) {
    if (cp < 0 || cp > 1114111) { return "" }
    if (cp < 65536) { return String.fromCharCode(cp) }
    var off = cp - 65536
    return String.fromCharCode(55296 + ((off - (off % 1024)) / 1024)) + String.fromCharCode(56320 + (off % 1024))
}

// ----- the three integer directives -----------------------------------------
//
// Past 2^53 neither rtBaseStr (int64, SATURATES: 1e30 would be
// "7fffffffffffffff") nor `"" + v` (the double's SHORTEST form, "1e+30") is
// right. MRI converts the Float with to_i - truncation toward zero - and prints
// the resulting Integer EXACTLY, all 31 digits of 1e30.to_i ==
// 1000000000000000019884624838656. Integer formatting is unchanged in 3.x.
//
// abnf/jsrt.go's twin has math/big and asks it for Int.Text(base). There is no
// bignum multiply here, so the exact digits come out of the double's own BINARY
// expansion - a double IS m * 2^e with m an integer - regrouped in threes for
// octal and fours for hex. Base ten is the bignum that already exists,
// rtExactDec's.
function rbDigitVal(c) {
    var v = c.charCodeAt(0)
    if (v >= 48 && v <= 57) { return v - 48 }
    if (v >= 97 && v <= 122) { return v - 97 + 10 }
    return 0
}

// The exact binary digits of a non-negative INTEGRAL double. Halving a double
// above 2^53 is exact (it has no odd values left), so the mantissa comes down
// whole and the discarded factors of two come back as trailing "0"s.
function rbBinDigits(a) {
    var m = a
    var e = 0
    while (m > 9007199254740992) {
        m = m / 2
        e = e + 1
    }
    var s = ""
    var x = m
    while (x > 0) {
        var q = Math.floor(x / 2)
        if (x - q * 2 == 1) { s = "1" + s } else { s = "0" + s }
        x = q
    }
    if (s == "") { s = "0" }
    var k = 0
    while (k < e) {
        s = s + "0"
        k = k + 1
    }
    return s
}

// Binary digits regrouped `per` at a time, which is base 8 for per == 3 and base
// 16 for per == 4.
function rbGroupBits(bits, per) {
    var s = bits
    while (s.length - Math.floor(s.length / per) * per != 0) { s = "0" + s }
    var out = ""
    var i = 0
    while (i < s.length) {
        var v = 0
        var j = 0
        while (j < per) {
            v = v * 2
            if (s.charAt(i + j) == "1") { v = v + 1 }
            j = j + 1
        }
        out = out + RT_DIGITS.charAt(v)
        i = i + per
    }
    var k = 0
    while (k < out.length - 1 && out.charAt(k) == "0") { k = k + 1 }
    return out.substring(k, out.length)
}

// The bits of a big magnitude, most significant first, as a digit string.
function rbABigBinDigits(a) {
    var bb = rbABitsOfMag(a["limbs"])
    var s = ""
    var i = bb.length - 1
    while (i >= 0) {
        if (bb[i] == 1) { s = s + "1" } else { s = s + "0" }
        i = i - 1
    }
    if (s == "") { s = "0" }
    return s
}

// The exact base-`base` digits of a non-negative integral double, or of a big.
function rbMagDigits(a, base) {
    if (rbIsBig(a)) {
        if (base == 10) { return rtABigStr(rbABigAbs(a)) }
        var bgb = rbABigBinDigits(a)
        if (base == 8) { return rbGroupBits(bgb, 3) }
        if (base == 16) { return rbGroupBits(bgb, 4) }
        return bgb
    }
    if (base == 10) { return rtExactDec(a)["i"] }
    var bits = rbBinDigits(a)
    if (base == 8) { return rbGroupBits(bits, 3) }
    if (base == 16) { return rbGroupBits(bits, 4) }
    return bits
}

// `s` minus one, in base `base`. The operand is a magnitude of at least 1, so the
// borrow always finds a digit to take from.
function rbDecOne(s, base) {
    var arr = []
    var i = 0
    while (i < s.length) {
        arr.push(rbDigitVal(s.charAt(i)))
        i = i + 1
    }
    var at = arr.length - 1
    while (at >= 0) {
        if (arr[at] > 0) {
            arr[at] = arr[at] - 1
            break
        }
        arr[at] = base - 1
        at = at - 1
    }
    var out = ""
    var k = 0
    while (k < arr.length) {
        out = out + RT_DIGITS.charAt(arr[k])
        k = k + 1
    }
    var z = 0
    while (z < out.length - 1 && out.charAt(z) == "0") { z = z + 1 }
    return out.substring(z, out.length)
}

// MRI's INFINITE two's-complement digits for a negative value, without the ".."
// that announces them: "%x" % -5 is "..fb", "%o" is "..73", "%b" is "..1011".
//
// ~n is the magnitude minus one with every digit complemented, which is exact on
// the digit string and needs no bignum subtract. The infinite run of (base-1)
// digits in front is collapsed by MRI to exactly ONE, so -1 is "..f" and not
// "..ff".
function rbTwosDigits(a, base) {
    var src = rbDecOne(rbMagDigits(a, base), base)
    var out = ""
    var i = 0
    while (i < src.length) {
        out = out + RT_DIGITS.charAt(base - 1 - rbDigitVal(src.charAt(i)))
        i = i + 1
    }
    var mx = RT_DIGITS.charAt(base - 1)
    if (out.length == 0 || out.charAt(0) != mx) { out = mx + out }
    return out
}

// rbIntBody assembles ONE integer directive: the sign or the ".." marker, the #
// base prefix, and the digits with any precision applied. It answers the fill
// CHARACTER for the 0 flag too, because the ".." form pads with the base's
// largest digit and not with zeros ("%010x" % -5 is "..fffffb"), and `k`, the
// number of leading characters those fill characters must go behind.
//
// `sign` is the + or SPACE flag, which switches MRI back to sign-and-magnitude:
// "%+x" % -5 is "-5", not "..fb".
function rbIntBody(f, base, upper, alt, sign, prec) {
    var neg = rbIsBig(f) ? (f["neg"] && !rtABigIsZero(f)) : f < 0
    var mag = anytype
    mag = rbIsBig(f) ? rbABigAbs(f) : (neg ? -f : f)
    var fill = "0"
    var twos = false
    var digits = ""
    if (base == 10 || !neg || sign) {
        digits = rbMagDigits(mag, base)
        if (prec >= 0) {
            if (digits == "0" && prec == 0) { digits = "" }
            while (digits.length < prec) { digits = "0" + digits }
        }
    } else {
        twos = true
        var mx = RT_DIGITS.charAt(base - 1)
        digits = rbTwosDigits(mag, base)
        // A precision counts the ".." as two of its characters: "%.5x" % -1 is
        // "..fff" and "%.3x" % -1 is "..f".
        while (digits.length < prec - 2) { digits = mx + digits }
        fill = mx
    }
    var prefix = ""
    if (alt) {
        if (base == 8) {
            if (!twos && (digits.length == 0 || digits.charAt(0) != "0")) { prefix = "0" }
        } else if (base == 16) {
            prefix = rbBasePrefix(upper ? "X" : "x", f)
        } else if (base == 2) {
            // %B is %b with an UPPERCASE prefix: "%#B" % 5 is "0B101". Base 2's
            // digits are 0 and 1, so `upper` changes nothing else here and the
            // caller sets it for "B" exactly as it does for "X".
            prefix = rbBasePrefix(upper ? "B" : "b", f)
        }
    }
    var keep = 0
    if (twos) {
        digits = ".." + digits
        keep = 2
    }
    if (upper) {
        digits = rbUpper(digits)
        fill = rbUpper(fill)
    }
    var body = prefix + digits
    keep = keep + prefix.length
    if (neg && !twos) {
        body = "-" + body
        keep = keep + 1
    }
    return {b: body, f: fill, k: keep}
}

// ----- what a numeric directive may be GIVEN --------------------------------
//
// MRI's numeric directives do not read a number out of the operand, they CONVERT it with
// Kernel#Integer / Kernel#Float rules - so they raise on a value that has no number in
// it, and they PARSE one that has a number in its text (rbToF would answer 0 for
// all of these):
//
//   "%d" % [nil]    MRI: TypeError    can't convert nil into Integer
//   "%d" % [true]   MRI: TypeError    can't convert true into Integer
//   "%d" % [:s]     MRI: TypeError    can't convert Symbol into Integer
//   "%d" % ["x"]    MRI: ArgumentError invalid value for Integer(): "x"
//   "%d" % ["12"]   MRI: "12"
//   "%f" % [nil]    MRI: TypeError can't convert nil into Float
//   "%c" % [nil]    MRI: TypeError    no implicit conversion from nil to integer
//
// nil / true / false name THEMSELVES in the message and everything else names its CLASS,
// which is MRI's wording and not a simplification. %c has a message of its own. The twins
// are fmtIntOperand / fmtFloOperand / fmtCharOperand in ruby-interpreter.abnf and
// rubyFmtIntOperand / rubyFmtFloOperand / rubyFmtCharOperand in abnf/jsrt.go.
// rbOwnerName and NOT rbClassName: rbClassName answers "" for a USER OBJECT, and
// MRI (like ruby-interpreter.abnf's classOf) names the user class.
// rbOwnerName walks __class.__name first.
function rbFmtConvName(v) {
    if (rtIsNil(v)) { return "nil" }
    if (v === true) { return "true" }
    if (v === false) { return "false" }
    return rbOwnerName(v)
}
// A user object is CONVERTED first, with the same two names Kernel#Integer tries
// (#to_int, then #to_i) and #to_f for a float directive - MRI's `"%d" % obj` is 7 when
// obj answers to_int. Same find-then-call shape rbStr already uses for #to_s.
function rbFmtUserConv(v, n1, n2) {
    if (!rbUserObj(v)) { return null }
    var m = rbFindMethod(v, n1)
    if (m !== undefined) { return rbSV(m.apply(undefined, [v])) }
    if (n2 != "") {
        var m2 = rbFindMethod(v, n2)
        if (m2 !== undefined) { return rbSV(m2.apply(undefined, [v])) }
    }
    return null
}
function rbFmtIsNumV(v) {
    if (typeof v == "number") { return true }
    if (rbIsBig(v)) { return true }
    if (rbIsFlo(v)) { return true }
    if (rbIsRat(v)) { return true }
    return rbIsCpx(v)
}
function rbFmtIntOperand(v) {
    if (rbFmtIsNumV(v)) { return v }
    if (typeof v == "string") {
        var ri = rbStrToInum(v, 0, true)
        if (ri["ok"]) { return ri["v"] }
        rbRaiseErr(rbFmtFrame, "ArgumentError", "invalid value for Integer(): " + rbStrInspect(v))
    }
    var uc = rbFmtUserConv(v, "to_int", "to_i")
    if (uc !== null && rbFmtIsNumV(uc)) { return uc }
    rbRaiseErr(rbFmtFrame, "TypeError", "can't convert " + rbFmtConvName(v) + " into Integer")
    return 0
}
function rbFmtFloOperand(v) {
    if (rbFmtIsNumV(v)) { return rbToF(v) }
    if (typeof v == "string") {
        var rf = anytype
        rf = rbnStrToDbl(v, true)
        if (rf !== null) { return rf }
        rbRaiseErr(rbFmtFrame, "ArgumentError", "invalid value for Float(): " + rbStrInspect(v))
    }
    var uf = rbFmtUserConv(v, "to_f", "")
    if (uf !== null && rbFmtIsNumV(uf)) { return rbToF(uf) }
    rbRaiseErr(rbFmtFrame, "TypeError", "can't convert " + rbFmtConvName(v) + " into Float")
    return 0
}
// %c's message is NOT the Integer one, and MRI writes it TWO ways: nil is
// "no implicit conversion from nil to integer" and everything else is
// "no implicit conversion of Symbol into Integer" - a different preposition and a
// different case on "integer". Both are /usr/bin/ruby 2.6.10's own text.
function rbFmtCharOperand(v) {
    if (rbFmtIsNumV(v)) { return rbToF(v) }
    var uc = rbFmtUserConv(v, "to_int", "to_i")
    if (uc !== null && rbFmtIsNumV(uc)) { return rbToF(uc) }
    if (rtIsNil(v)) { rbRaiseErr(rbFmtFrame, "TypeError", "no implicit conversion from nil to integer") }
    rbRaiseErr(rbFmtFrame, "TypeError", "no implicit conversion of " + rbFmtConvName(v) + " into Integer")
    return 0
}

// The base of a conversion character, and 0 for the ones that are not integers.
function rbIntBase(conv) {
    // %u is MRI's %d: the 1.8 "unsigned" meaning is long gone and "%u" % -5 is
    // "-5".
    if (conv == "d" || conv == "i" || conv == "u") { return 10 }
    if (conv == "x" || conv == "X") { return 16 }
    if (conv == "o") { return 8 }
    if (conv == "b" || conv == "B") { return 2 }
    return 0
}

// Ruby prints "Inf", "-Inf" and "NaN" for a non-finite float under EVERY float
// directive, in that case whatever the directive's own case is, and pads them with
// spaces even under the 0 flag (Go's strconv would say "+Inf"). rubyFloatWord
// in abnf/jsrt.go is the twin.
function rbFloatWord(x) {
    if (x !== x) { return "NaN" }
    if (x - x !== 0) {
        if (x > 0) { return "Inf" }
        return "-Inf"
    }
    return ""
}

// strconv.FormatInt(int64(x), base) is rtBaseStr, in
// languages/lib/runtime.metajs. Ruby's Integer#to_s(base) is what reaches its
// int64-saturating branches: 1e100.to_i.to_s(16) is "7fffffffffffffff".

// String#upcase / #downcase: the full Unicode mapping, without Final_Sigma
// (unicodeCase, abnf/casemap.go). Twin of the "upcase" / "downcase" arms in
// abnf/jsrt.go.
function rbUpper(s) { return s.toUpperCase() }
function rbLower(s) { return unicodeCase(s, 2) }

// MRI's sprintf counts CHARACTERS in a width and in a precision, not bytes:
// "%10s" % "café" is six spaces and four characters, and its result has
// String#length 10 and #bytesize 11 (abnf/jsrt.go's `len(body)` byte rule is
// wrong for Ruby).
//
// A surrogate PAIR is one character to MRI ("%5c" % 128512 is four spaces), so
// this counts code points and not the UTF-16 units String#length answers.
// rubyCharCount in abnf/jsrt.go and charCount in languages/ruby-interpreter.abnf
// are the twins.
function rbCharCount(s) {
    var n = 0
    var i = 0
    while (i < s.length) {
        var c = s.charCodeAt(i)
        if (c < 56320 || c > 57343) { n = n + 1 }
        i = i + 1
    }
    return n
}

// The first `n` CHARACTERS of a string, which is what a %s or %p precision cuts
// to: "%.1s" % "日本語" is "日" in MRI.
function rbCharCut(s, n) {
    var out = ""
    var seen = 0
    var i = 0
    while (i < s.length) {
        var c = s.charCodeAt(i)
        if (c < 56320 || c > 57343) {
            if (seen == n) { return out }
            seen = seen + 1
        }
        out = out + s.charAt(i)
        i = i + 1
    }
    return out
}

// The directives that take a SIGN and honour the 0 flag.
function rbFmtNumeric(conv) {
    if (conv == "d" || conv == "i" || conv == "u" || conv == "f") { return true }
    if (conv == "e" || conv == "E" || conv == "g" || conv == "G") { return true }
    if (conv == "b" || conv == "B") { return true }
    // %a/%A takes a sign and honours the 0 flag exactly as %f does:
    // "%+a" % 1.5 is "+0x1.8p+0" and "%020a" % 100.0 is "0x0000000000001.9p+6".
    if (conv == "a" || conv == "A") { return true }
    return conv == "x" || conv == "X" || conv == "o"
}

function rbIsSignChar(c) { return c == "-" || c == "+" || c == " " }

// ----- %a / %A: the hex-float form -----------------------------------------
//
// MRI writes a finite double as [-]0x1.<hex fraction>p<+|-><decimal binary
// exponent>, normalised so the leading digit is 1 for every non-zero value - a
// SUBNORMAL is normalised too ("%a" % 5.0e-324 is "0x1p-1074") - and zero is
// "0x0p+0". Without a precision the fraction's trailing zeros go; with one it is
// rounded half to even, or zero-padded, to exactly that many digits.
//
// No d_frexp is needed. Scaling a double by a POWER OF TWO is exact as long as the
// result neither overflows nor falls into the subnormals, and both directions can
// be driven so that it never does: divide only while the value is >= the power
// (the quotient stays >= 1), multiply only while the product stays < 2. So this
// is pure arithmetic - no bit access, no floor primitive, no new upcall - and it
// is exact for every finite double including 5.0e-324. hexNorm in
// languages/ruby-interpreter.abnf and rubyHexNorm in abnf/jsrtruby.go are the
// twins.
//
// The powers are built by REPEATED SQUARING (2, 4, 16, ... 2^512): the ladder of
// exponents 1, 2, 4, ... 512 that the two loops walk downward. MetaJS has no
// exponent literal, so they cannot be written out.
var rbHexP2v = []
var rbHexP2k = []

function rbHexP2() {
    if (rbHexP2v.length > 0) { return }
    var pv = 2
    var pk = 1
    while (pk <= 512) {
        rbHexP2v.push(pv)
        rbHexP2k.push(pk)
        pv = pv * pv
        pk = pk * 2
    }
}

// x > 0 and finite -> {m, e} with m in [1, 2) and x == m * 2^e, exactly.
function rbHexNorm(x) {
    rbHexP2()
    var e = 0
    var i = rbHexP2v.length - 1
    while (i >= 0) {
        while (x >= rbHexP2v[i]) {
            x = x / rbHexP2v[i]
            e = e + rbHexP2k[i]
        }
        i = i - 1
    }
    i = rbHexP2v.length - 1
    while (i >= 0) {
        while (x * rbHexP2v[i] < 2) {
            x = x * rbHexP2v[i]
            e = e - rbHexP2k[i]
        }
        i = i - 1
    }
    return {m: x, e: e}
}

function rbHexDigitChar(d) {
    if (d < 10) { return "" + d }
    if (d == 10) { return "a" }
    if (d == 11) { return "b" }
    if (d == 12) { return "c" }
    if (d == 13) { return "d" }
    if (d == 14) { return "e" }
    return "f"
}

// The 13 hex digits of m - 1 for m in [1, 2). 13 x 4 is exactly the 52 fraction
// bits of a double, so this is the WHOLE value: m - 1 is exact (Sterbenz) and
// every f * 16 step is a scale by a power of two.
function rbHexFrac(m) {
    var f = m - 1
    var d = []
    var i = 0
    while (i < 13) {
        f = f * 16
        var q = Math.floor(f)
        d.push(q)
        f = f - q
        i = i + 1
    }
    return d
}

// The finite-value body of %a WITHOUT the sign - "0x1.8p+0". prec < 0 means "as
// many digits as the value needs".
//
// ONE DELIBERATE DIVERGENCE FROM THE ORACLE, and MRI 2.6.10 is the one that is
// wrong: at a precision of EXACTLY 13 - the full digit count, where no rounding
// can be needed - it rounds the last digit to even anyway. "%.13a" % (1.0/3) is
// 0x1.5555555555554p-2 there against the value's own 0x1.5555555555555p-2. C's
// printf on this machine, python3's float.hex and MRI's own %a with no precision
// all print the exact digits, and MRI is right again at 12 and at 14 - a tie test
// firing on an exact value in sprintf.c, not a rule. All three engines here print
// the exact digits.
function rbHexBody(fv, prec, alt, upper) {
    var lead = "1"
    var frac = ""
    var ex = 0
    if (fv == 0) {
        lead = "0"
    } else {
        var nm = rbHexNorm(fv < 0 ? 0 - fv : fv)
        ex = nm["e"]
        var d = rbHexFrac(nm["m"])
        var n = 13
        if (prec >= 0 && prec < 13) {
            var up = false
            if (d[prec] > 8) { up = true }
            else if (d[prec] == 8) {
                var rest = false
                var q = prec + 1
                while (q < 13) {
                    if (d[q] != 0) { rest = true }
                    q = q + 1
                }
                if (rest) { up = true }
                else { up = (prec == 0 ? 1 : d[prec - 1]) % 2 == 1 }
            }
            n = prec
            if (up) {
                var c = n - 1
                while (c >= 0 && d[c] == 15) {
                    d[c] = 0
                    c = c - 1
                }
                if (c < 0) { ex = ex + 1 } else { d[c] = d[c] + 1 }
            }
        }
        var k = 0
        while (k < n) {
            frac = frac + rbHexDigitChar(d[k])
            k = k + 1
        }
        if (prec < 0) {
            while (frac.length > 0 && frac.charAt(frac.length - 1) == "0") {
                frac = frac.substring(0, frac.length - 1)
            }
        } else {
            while (frac.length < prec) { frac = frac + "0" }
        }
    }
    if (prec > 0 && frac.length == 0) {
        var z = 0
        while (z < prec) {
            frac = frac + "0"
            z = z + 1
        }
    }
    var out = "0x" + lead
    if (frac.length > 0) { out = out + "." + frac } else if (alt) { out = out + "." }
    var es = "" + (ex < 0 ? 0 - ex : ex)
    out = out + "p" + (ex < 0 ? "-" : "+") + es
    if (upper) { return rbUpper(out) }
    return out
}

// Every route from a Float to an Integer - #to_i, #to_int, #truncate, #round,
// #floor, #ceil, and the %d / %x / %o / %b directives, whose operand MRI converts
// with to_i - raises FloatDomainError on an infinity or a NaN, with the float's
// own #to_s as the message. floDomainGuard in languages/ruby-interpreter.abnf and
// rubyFloDomain in abnf/jsrtruby.go are the twins.
function rbFloDomain(x) {
    if (x !== x) { rbRaiseErr("", "FloatDomainError", "NaN") }
    if (x - x !== 0) { rbRaiseErr("", "FloatDomainError", x > 0 ? "Infinity" : "-Infinity") }
}

// ----- the ARGUMENT SELECTORS ----------------------------------------------
//
// A directive does not have to take the next argument, and MRI offers four ways
// of saying which one it takes:
//
//   %N$s          the Nth argument, 1-based, in any order and reusable
//   %<name>s      the Hash entry :name, formatted by the directive
//   %{name}       the Hash entry :name, to_s, with NO conversion letter
//   %*d / %.*f    the width / precision comes from an argument; a NEGATIVE *
//                 width left-justifies, a negative * precision means none
//
// The `*` argument is read BEFORE the value and width before precision, and `*`
// takes an explicit selector too ("%1$*2$d" % [7, 6] is "     7").
//
// "TOO FEW ARGUMENTS" IS RAISED ("%s %s" % ["a"] is an ArgumentError in MRI
// 2.6.10, unchanged in 3.x); the full row table, and the shapes that do NOT
// raise, are at fmtTooFew in languages/ruby-interpreter.abnf. rubyFmtTooFew in
// abnf/jsrtruby.go is the other twin. NOT implemented: MRI's four
// ArgumentErrors for MIXING the numbered, unnumbered and named styles.
function rbFmtTooFew() {
    rbRaiseErr(rbFmtFrame, "ArgumentError", "too few arguments")
}

function rbFmtHashArg(args) {
    if (args.length == 1 && rbIsDict(args[0])) { return args[0] }
    return null
}

function rbFmtNamed(args, name, open, close) {
    var h = rbFmtHashArg(args)
    if (h === null) { rbRaiseErr(rbFmtFrame, "ArgumentError", "one hash required") }
    // A SCAN and not rbDictFind: the key is the Symbol :name and a String key does
    // NOT match - MRI's "%{x}" % {"x" => 1} is a KeyError.
    var keys = h["keys"]
    var vals = h["vals"]
    var i = 0
    while (i < keys.length) {
        if (rbIsSym(keys[i]) && keys[i]["s"] == name) { return vals[i] }
        i = i + 1
    }
    rbRaiseErr(rbFmtFrame, "KeyError", "key" + open + name + close + " not found")
    return null
}

// The value a `*` reads: the next positional argument, or the explicit one of a
// "*2$" form. Answers the integer and the position just past what it ate.
function rbFmtStar(spec, j, args, st) {
    var dn = 0
    var ds = j
    while (j < spec.length) {
        var dg = rtDigitAt(spec, j)
        if (dg < 0) { break }
        dn = dn * 10 + dg
        j = j + 1
    }
    var v = anytype
    v = null
    if (j > ds && j < spec.length && spec.charAt(j) == "$") {
        j = j + 1
        if (dn == 0 || dn - 1 >= args.length) { rbFmtTooFew() }
        v = args[dn - 1]
    } else {
        j = ds
        if (st["ai"] >= args.length) { rbFmtTooFew() }
        v = args[st["ai"]]
        st["ai"] = st["ai"] + 1
    }
    return {n: Math.trunc(rbToF(v)), j: j}
}

// MRI raises ArgumentError on a malformed format string (sprintf is unchanged in
// 3.x):
//
//     "%z" % 5      malformed format string - %z
//     "%5" % 5      malformed format string - %*[0-9]
//     "100%" % []   incomplete format specifier…
//
// The messages are MRI's own, chosen by what the head consumed last - see the
// table in ruby-interpreter.abnf.
//
// The one row a selector still saves in MRI and not here is "%1$%" % 5, which is
// "%" there and *invalid format character - %* here; it never reaches the
// argument list, so it is a malformed-head row.
function rbIsFmtConv(c) {
    return c == "d" || c == "i" || c == "u" || c == "f" || c == "s" || c == "p"
        || c == "c" || c == "x" || c == "X" || c == "o" || c == "b" || c == "B"
        || c == "e" || c == "E" || c == "g" || c == "G" || c == "a" || c == "A"
}
function rbFmtCheckConv(c) {
    if (rbIsFmtConv(c)) { return }
    var cc = c.charCodeAt(0)
    // % as the conversion of a non-empty head ("%5%"), and a newline or a NUL that
    // is NOT directly after the % ("%5\n"), are MRI's one message.
    if (c == "%" || cc == 10 || cc == 0) { rbRaiseErr(rbFmtFrame, "ArgumentError", "invalid format character - %") }
    if (cc >= 32 && cc < 127) { rbRaiseErr(rbFmtFrame, "ArgumentError", "malformed format string - %" + c) }
    rbRaiseErr(rbFmtFrame, "ArgumentError", "malformed format string")
}

// The Ruby method running rbFormat - see rubyFmtFrame in abnf/jsrt.go.
var rbFmtFrame = ""
function rbFormat(spec, arg, frame) {
    var outerFrame = rbFmtFrame
    rbFmtFrame = frame
    // A format argument is read, never kept, so a box is read as its text.
    var args = [rbSV(arg)]
    if (rbIsArr(arg)) { args = rbSVArgs(arg) }
    var st = {ai: 0}
    var out = ""
    var i = 0
    while (i < spec.length) {
        if (spec.charAt(i) != "%") {
            out = out + spec.charAt(i)
            i = i + 1
            continue
        }
        i = i + 1
        // A MALFORMED directive is an ArgumentError in MRI; rbFmtCheckConv
        // carries the table.
        if (i >= spec.length) { rbRaiseErr(rbFmtFrame, "ArgumentError", "incomplete format specifier; use %% (double %) instead") }
        if (spec.charAt(i) == "%") {
            out = out + "%"
            i = i + 1
            continue
        }
        // A newline or a NUL DIRECTLY after the % is the one shape MRI writes out
        // instead of raising - "%\n" is "%\n" - and only there: "%5\n" raises.
        if (spec.charCodeAt(i) == 10 || spec.charCodeAt(i) == 0) {
            out = out + "%"
            continue
        }
        var left = false
        var zero = false
        var plus = false
        var space = false
        var alt = false
        var width = 0
        var prec = 0 - 1
        var sel = 0 - 1
        var nmk = ""
        var haveName = false
        var brace = false
        var bad = false
        // What the directive head consumed last, which is what MRI's message at
        // the end of the string is chosen by: 1 flags, 2 a number (a width, a
        // precision or a *), 3 an argument SELECTOR or a <name>.
        var tail = 0
        // ONE loop over the whole directive head, because the pieces may come in
        // any order: "% 1$d" and "%1$ d" are both " 5" in MRI.
        while (i < spec.length) {
            var fc = spec.charAt(i)
            if (fc == "-" || fc == "0" || fc == "+" || fc == " " || fc == "#") {
                if (fc == "-") { left = true }
                if (fc == "0") { zero = true }
                if (fc == "+") { plus = true }
                if (fc == " ") { space = true }
                if (fc == "#") { alt = true }
                i = i + 1
                tail = 1
                continue
            }
            if (fc == "<" || fc == "{") {
                var close = fc == "<" ? ">" : "}"
                var e2 = i + 1
                var got = ""
                while (e2 < spec.length && spec.charAt(e2) != close) {
                    got = got + spec.charAt(e2)
                    e2 = e2 + 1
                }
                if (e2 >= spec.length) {
                    bad = true
                    break
                }
                nmk = got
                haveName = true
                i = e2 + 1
                tail = 3
                if (fc == "{") {
                    brace = true
                    break
                }
                continue
            }
            if (fc == "*") {
                var sw = rbFmtStar(spec, i + 1, args, st)
                i = sw["j"]
                tail = 2
                if (sw["n"] < 0) {
                    left = true
                    width = 0 - sw["n"]
                } else { width = sw["n"] }
                continue
            }
            if (fc == ".") {
                if (prec >= 0) { rbRaiseErr(rbFmtFrame, "ArgumentError", "precision given twice") }
                i = i + 1
                tail = 2
                if (i < spec.length && spec.charAt(i) == "*") {
                    var sp = rbFmtStar(spec, i + 1, args, st)
                    i = sp["j"]
                    prec = sp["n"] < 0 ? 0 - 1 : sp["n"]
                } else {
                    prec = 0
                    while (i < spec.length) {
                        var pd = rtDigitAt(spec, i)
                        if (pd < 0) { break }
                        prec = prec * 10 + pd
                        i = i + 1
                    }
                }
                continue
            }
            var wd = rtDigitAt(spec, i)
            if (wd > 0) {
                // A leading 0 was taken as the zero FLAG above, so a run of digits
                // here is a width - unless a "$" makes it an argument selector.
                var dn2 = 0
                while (i < spec.length) {
                    var w2 = rtDigitAt(spec, i)
                    if (w2 < 0) { break }
                    dn2 = dn2 * 10 + w2
                    i = i + 1
                }
                if (i < spec.length && spec.charAt(i) == "$") {
                    sel = dn2 - 1
                    i = i + 1
                    tail = 3
                    continue
                }
                width = dn2
                tail = 2
                continue
            }
            break
        }
        var conv = "s"
        if (!brace) {
            if (bad) { rbRaiseErr(rbFmtFrame, "ArgumentError", "malformed name - unmatched parenthesis") }
            if (i >= spec.length) {
                if (tail == 2) { rbRaiseErr(rbFmtFrame, "ArgumentError", "malformed format string - %*[0-9]") }
                if (tail != 3) { rbRaiseErr(rbFmtFrame, "ArgumentError", "invalid format character - %") }
                // A selector or a <name> that ran off the end writes a bare "%" in
                // MRI ("%1$" % 5 is "%"), but the name is still LOOKED UP -
                // "%<x>" % 5 is *one hash required*.
                if (haveName) { rbFmtNamed(args, nmk, "<", ">") }
                out = out + "%"
                break
            }
            conv = spec.charAt(i)
            i = i + 1
        }
        var nx = anytype
        nx = null
        if (haveName) { nx = rbFmtNamed(args, nmk, brace ? "{" : "<", brace ? "}" : ">") }
        else if (sel >= 0) {
            if (sel >= args.length) { rbFmtTooFew() }
            nx = args[sel]
        } else {
            if (st["ai"] >= args.length) { rbFmtTooFew() }
            nx = args[st["ai"]]
        }
        // The positional cursor moves ONCE, here, rather than in each conversion
        // arm: the arms no longer decide which argument they get.
        if (!haveName && sel < 0) { st["ai"] = st["ai"] + 1 }
        // AFTER the argument, because MRI resolves the name first: "%<x>z" % 5 is
        // *one hash required* and not *malformed format string - %z*.
        if (!brace) { rbFmtCheckConv(conv) }
        var body = ""
        var nonFinite = false
        // The 0 flag's fill character and the number of leading characters it has
        // to go behind. Only the integer directives move them off their defaults;
        // keep < 0 means "work the sign out below, as before".
        var fill = "0"
        var keep = 0 - 1
        var intPrec = false
        var base = rbIntBase(conv)
        if (base != 0) {
            var iv = anytype
            var ivx = rbFmtIntOperand(nx)
            iv = rbIsBig(ivx) ? ivx : Math.trunc(rbToF(ivx))
            if (!rbIsBig(iv) && (iv !== iv || iv - iv !== 0)) {
                // MRI's integer directives convert the operand with to_i, so an
                // infinity or a NaN raises FloatDomainError here exactly as
                // Float#to_i does.
                rbFloDomain(iv)
            } else {
                var ib = rbIntBody(iv, base, conv == "X" || conv == "B", alt, plus || space, prec)
                body = ib["b"]
                fill = ib["f"]
                keep = ib["k"]
                // A precision turns the 0 flag OFF for an integer directive, as it
                // does in C: "%08.3x" % 1 is "     001".
                intPrec = prec >= 0
            }
        } else if (conv == "f") {
            var ff = rbFmtFloOperand(nx)
            var fw = rbFloatWord(ff)
            if (fw != "") {
                body = fw
                nonFinite = true
            } else {
                body = rtFixed(ff, prec < 0 ? 6 : prec)
                if (alt) { body = rbAltPoint(body) }
            }
        } else if (conv == "e" || conv == "E") {
            var ef = rbFmtFloOperand(nx)
            var ew = rbFloatWord(ef)
            if (ew != "") {
                body = ew
                nonFinite = true
            } else {
                body = rbSci(ef, prec < 0 ? 6 : prec)
                if (alt) { body = rbAltPoint(body) }
                if (conv == "E") { body = rbUpper(body) }
            }
        } else if (conv == "g" || conv == "G") {
            var gf = rbFmtFloOperand(nx)
            var gw = rbFloatWord(gf)
            if (gw != "") {
                body = gw
                nonFinite = true
            } else {
                var gp = prec < 0 ? 6 : prec
                if (gp == 0) { gp = 1 }
                body = alt ? rbGenAlt(gf, gp) : rbGen(gf, gp)
                if (conv == "G") { body = rbUpper(body) }
            }
        } else if (conv == "s") {
            body = rbStr(nx)
            // A precision cuts CHARACTERS (rbCharCut), as MRI does.
            if (prec >= 0 && prec < rbCharCount(body)) { body = rbCharCut(body, prec) }
        } else if (conv == "c") {
            // %c is ONE character: a code point from an Integer (a Float is
            // truncated, as it is under %d) or a String of EXACTLY one character
            // (MRI raises ArgumentError otherwise, with its own message). It is not
            // a numeric directive - "%05c" % 65 is "    A" - and MRI ignores a
            // precision on it outright ("%.0c" % 65 is "A").
            if (typeof nx == "string") {
                if (rbCharCount(nx) != 1) { rbRaiseErr(rbFmtFrame, "ArgumentError", "%c requires a character") }
                body = nx
            }
            else { body = rbCharCode(Math.trunc(rbFmtCharOperand(nx))) }
        } else if (conv == "p") {
            // %p is #inspect where %s is #to_s, and its precision cuts the same
            // way: "%.2p" % "abcdef" is `"a'.
            body = rbInspect(nx)
            if (prec >= 0 && prec < rbCharCount(body)) { body = rbCharCut(body, prec) }
        } else if (conv == "a" || conv == "A") {
            // %a / %A - the hex-float form. The sign goes on HERE rather than
            // inside rbHexBody, because the 0 flag has to fill behind BOTH the sign
            // and the "0x": "%020a" % -0.0 is "-0x00000000000000p+0". keep counts
            // them.
            var af = rbFmtFloOperand(nx)
            var aw = rbFloatWord(af)
            if (aw != "") {
                body = aw
                nonFinite = true
            } else {
                body = rbHexBody(af, prec, alt, conv == "A")
                if (af < 0 || (af == 0 && 1 / af < 0)) {
                    body = "-" + body
                    keep = 3
                } else { keep = 2 }
            }
        } else {
            body = conv
        }
        // The + and SPACE flags: "%+d" % 7 is "+7". They apply to the NUMERIC
        // directives only, Inf and NaN included ("%+f" % Float::INFINITY is "+Inf").
        var numeric = rbFmtNumeric(conv)
        if (numeric && body.charAt(0) != "-") {
            if (plus) { body = "+" + body } else if (space) { body = " " + body }
            if ((plus || space) && keep >= 0) { keep = keep + 1 }
        }
        // The 0 flag is for NUMBERS: MRI's "%05s" % "ab" is "   ab". A non-finite
        // float is never zero-padded either, and neither is an integer directive
        // that carried a precision.
        var pad = " "
        if (zero && !left && !nonFinite && !intPrec && numeric) { pad = fill }
        // The width counts CHARACTERS: "%10s" of "café" gets SIX spaces in MRI
        // (rbCharCount).
        // The zeros of the 0 flag go BEHIND the sign and behind a # base prefix:
        // "%05d" % -42 is "-0042" and "%#010x" % 255 is "0x000000ff". For the ".."
        // two's-complement form they go behind that too, and they are f/7/1 rather
        // than 0: "%#010x" % -5 is "0x..fffffb". rbIntBody counted that as `k`.
        var skip = keep
        if (skip < 0) {
            skip = 0
            if (body.length > 0 && rbIsSignChar(body.charAt(0))) { skip = 1 }
        }
        while (rbCharCount(body) < width) {
            if (left) {
                body = body + " "
            } else if (pad != " ") {
                body = body.substring(0, skip) + pad + body.substring(skip, body.length)
            } else {
                body = pad + body
            }
        }
        out = out + body
    }
    rbFmtFrame = outerFrame
    return out
}

// ===================================================== truthiness ===========
//
// rubyTruthy: only nil and false are falsy (0, "" and the empty collections are
// all truthy). It backs the select/reject predicates so js_rxmcall agrees with
// the emitter's own `handle >= 3` compare, and NOT with JS truthiness.
function rbTruthy(v) {
    if (rtIsNil(v)) { return false }
    if (v === false) { return false }
    return true
}

// ===================================================== dicts ================
//
// dictFind / dictScan / dictAppend of abnf/jsrt.go. The Go side keeps an index
// alongside the keys array as a pure ACCELERATOR (a hit is confirmed against the
// array before it is used), so a linear scan answers exactly what it answers.
// The `===` scan is SHARED as rtDictFind - lib/runtime.metajs.
// Two bigs of the same value are different objects, so the value comparison is
// the FALLBACK SCAN and nothing else: a hit costs exactly what rtDictFind costs,
// and a miss costs one type test. A big is only ever the key equal of another
// big, which is what the Go twin's strictEq (its *jsBigInt arm demands two of
// them) and the interpreter's core.keyId namespace both say.
// An ARRAY (and a Hash) is a VALUE key in Ruby - Array#hash and Array#eql? are
// structural - so `{[1] => 5}[[1]]` is 5. That arm rides on the SAME fallback
// scan and for the same reason, and it stays in RUBY's find rather than in
// rtDictFind, which nine languages share and in which two arrays are two
// objects.
function rbDictFind(keys, k) {
