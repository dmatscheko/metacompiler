    if (name == "empty?") { return t.length == 0 }
    if (name == "clear") { return rbArrReplace(t, []) }
    if (name == "sort") { return rbMSort(t, blk, false) }
    if (name == "sort!") { return rbArrReplace(t, rbMSort(t, blk, false)) }
    if (name == "sort_by") { return rbUndecorate(rbArrKeyed(t, blk)) }
    if (name == "sort_by!") { return rbArrReplace(t, rbUndecorate(rbArrKeyed(t, blk))) }
    // #reverse_each yields (or enumerates) from the back. Range#reverse_each
    // delegates here.
    if (name == "reverse_each") {
        var rvz = []
        var zi = t.length - 1
        while (zi >= 0) {
            rvz.push(t[zi])
            zi = zi - 1
        }
        if (blk === null) { return rbEnumAt(rbMkEnum(rvz), rbEnumSrc(t), name, args) }
        var qz = 0
        while (qz < rvz.length) {
            rbCall1(blk, rvz[qz])
            qz = qz + 1
        }
        return t
    }
    if (name == "reverse" || name == "reverse!") {
        var rev = []
        var vi = t.length - 1
        while (vi >= 0) {
            rev.push(t[vi])
            vi = vi - 1
        }
        if (name == "reverse") { return rev }
        return rbArrReplace(t, rev)
    }
    if (name == "join") { return rbArrJoin(t, nPos == 0 ? "" : rbStr(args[0])) }
    // min / max take an optional COUNT and an optional block, and with the count
    // they answer an array - ascending for min, DESCENDING for max.
    if (name == "min" || name == "max") {
        var wantMax = name == "max"
        if (nPos > 0) {
            var mn = Math.trunc(rbToF(args[0]))
            var masc = rbMSort(t, blk, false)
            if (!wantMax) { return rbArrSub(masc, 0, mn) }
            var mdesc = []
            var mi = masc.length - 1
            while (mi >= 0) {
