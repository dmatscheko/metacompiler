    if (rbIsNil(v) || v === true || v === false) { return rbInspect(v) }
    if (typeof v == "number" || rbIsFlo(v) || rbIsSym(v)) { return rbInspect(v) }
    var n = rbClassName(v)
    return n == "" ? "Object" : n
}

// < > <= >= raise in Ruby when the values cannot be compared.
function rbCmp(l, r) {
    var c = rbSpaceship(l, r)
    if (c === null) {
        // A CATCHABLE ArgumentError, not a host abort: MRI's sort raises one and a
        // program may rescue it.
        var ln = rbClassName(l)
        js_rraise(rbBuiltinClass("ArgumentError"),
                  "comparison of " + (ln == "" ? "Object" : ln) + " with " + rbCmpName(r) + " failed")
    }
    return c
}

// ===================================================== classes ==============

// rubyFindMethod: walk the __class / __super chain of an INSTANCE for a method.
function rbFindMethod(v, name) {
    if (!rbIsObj(v)) { return undefined }
    var cls = v["__class"]
    while (cls !== undefined && cls !== null) {
        if (!rbIsObj(cls)) { return undefined }
        var m = cls[name]
        if (m !== undefined && rbIsFn(m)) { return m }
        cls = cls["__super"]
    }
    return undefined
}

// rubyClassName: the builtin class a runtime value belongs to ("" when none).
function rbClassName(v) {
    if (v === true) { return "TrueClass" }
    if (v === false) { return "FalseClass" }
    if (rbIsNil(v)) { return "NilClass" }
    if (typeof v == "number") { return "Integer" }
    if (rbIsBig(v)) { return "Integer" }
    if (typeof v == "string") { return "String" }
    if (rbIsFlo(v)) { return "Float" }
    if (rbIsRat(v)) { return "Rational" }
    if (rbIsCpx(v)) { return "Complex" }
    if (rbIsSym(v)) { return "Symbol" }
    if (rbIsArr(v)) { return "Array" }
    if (rbIsDict(v)) { return "Hash" }
    if (rbIsEnum(v)) { return "Enumerator" }
    return ""
}

// rubyBuiltinClass: ONE object per name, so `1.class == Integer` and
// `case v when Integer` compare identities.
function rbBuiltinClass(name) {
    var k = "$" + name
    var got = rbClassTable[k]
    if (got !== undefined) { return got }
    var c = {__isclass: true, __rbuiltin: name, __name: name}
    rbClassTable[k] = c
    return c
}

// rubyExcParent: the ancestry of the builtin exception classes - the part of
// Ruby's class tree a rescue clause has to know about. Exception is the root.
var rbExcParent = {
    $StandardError: "Exception",
    $RuntimeError: "StandardError",
    $ArgumentError: "StandardError",
    $TypeError: "StandardError",
    $NameError: "StandardError",
    $NoMethodError: "NameError",
    $IndexError: "StandardError",
    $KeyError: "IndexError",
    $RangeError: "StandardError",
    $ZeroDivisionError: "StandardError",
    $StopIteration: "IndexError",
    $FrozenError: "RuntimeError",
    $NotImplementedError: "StandardError"
}

function rbExcParentOf(name) {
    var p = rbExcParent["$" + name]
    if (typeof p == "string") { return p }
    return ""
}

// rubyExcIsA: "v is an exception of the builtin class named bn". It walks the
// value's own __class/__super chain (so a user subclass counts) and, once that
// reaches a BUILTIN class, continues up rbExcParent by name.
function rbExcIsA(v, bn) {
    if (bn != "Exception" && rbExcParentOf(bn) == "") { return false }
    if (!rbIsObj(v)) { return false }
    var c = v["__class"]
    while (c !== undefined && c !== null) {
        if (!rbIsObj(c)) { return false }
        var name = c["__name"]
        if (typeof name != "string") { name = "" }
        if (typeof c["__rbuiltin"] == "string") {
            var n = name
            while (n != "") {
                if (n == bn) { return true }
                n = rbExcParentOf(n)
            }
            return false
        }
        if (name == bn) { return true }
        c = c["__super"]
    }
    return false
}

// rubyIsA: `v.is_a?(cls)` / `cls === v`. A builtin class matches by the value's
// runtime kind (Integer/Float also count as Numeric and Comparable), a compiled
// class by walking the instance's __class / __super chain.
function rbIsA(v, cls) {
    if (!rbIsObj(cls)) { return false }
    var bn = cls["__rbuiltin"]
    if (typeof bn == "string") {
        var kind = rbClassName(v)
        if (kind == bn) { return true }
        if (rbExcIsA(v, bn)) { return true }
        if (bn == "Numeric") { return rbIsNum(v) }
        if (bn == "Comparable") {
            if (rbIsNum(v)) { return true }
            return kind == "String"
        }
        if (bn == "Object") { return true }
        if (bn == "BasicObject") { return true }
        if (bn == "Kernel") { return true }
        if (bn == "Enumerable") {
            if (kind == "Array") { return true }
            return kind == "Hash"
        }
        return false
    }
    if (!rbIsObj(v)) { return false }
    var c = v["__class"]
    while (c !== undefined && c !== null) {
        if (c === cls) { return true }
        if (!rbIsObj(c)) { return false }
        c = c["__super"]
    }
    return false
}

// rubyExc: {__class: <class>, args: [message]}, the shape the message reader and
// the rescue type test both understand.
function rbExc(cls, args) {
    return {__class: cls, args: rtCopyArr(args)}
}

// Exception#message / #to_s: the first constructor argument, or the class name.
function rbExcMessage(o) {
    var arr = o["args"]
    if (rbIsArr(arr) && arr.length > 0) { return rbStr(arr[0]) }
    var cls = o["__class"]
    if (rbIsObj(cls)) {
        var n = cls["__name"]
        if (typeof n == "string") { return n }
    }
    return undefined
}

// rubyMakeExc turns the operand of Ruby's `raise` into the object to throw:
//   a class object   -> a fresh instance, the message as its single argument
//                       (its own initialize still runs when it defines one)
//   a string         -> a RuntimeError carrying that message, as in MRI
//   nil / undefined  -> a BARE raise: re-raise what the running rescue caught
//   anything else    -> raised unchanged (raise ArgumentError.new("arg"))
function rbMakeExc(v, msg) {
    if (rbIsNil(v)) {
        if (rbCurExc !== null) { return rbCurExc }
        return rbExc(rbBuiltinClass("RuntimeError"), [])
    }
    if (typeof v == "string") { return rbExc(rbBuiltinClass("RuntimeError"), [v]) }
    if (rbIsObj(v) && v["__isclass"] === true) {
        var argv = []
        if (!rbIsNil(msg)) { argv = [msg] }
        var inst = rbExc(v, argv)
        if (rbFindMethod(inst, "initialize") !== undefined) { rbMethod(inst, "initialize", argv) }
        return inst
    }
    return v
}

// The class a @@class variable belongs to: the class of an instance, or `self`
// itself when the code runs in a class method or a class body.
function rbClassOfSelf(self) {
    if (!rbIsObj(self)) { return null }
    if (self["__isclass"] === true) { return self }
    var c = self["__class"]
    if (c === undefined) { return null }
    return c
}

// ===================================================== ranges ===============

// String#succ for the alphanumeric case: the last character is incremented,
// carrying into the one before it when it wraps ("az" -> "ba").
function rbStrSucc(s) {
    if (s == "") { return "" }
    var codes = []
    var i = 0
    while (i < s.length) {
        codes.push(s.charCodeAt(i))
        i = i + 1
    }
    var j = codes.length - 1
    while (j >= 0) {
        var c = codes[j]
        var done = false
        if (c >= 97 && c < 122) {
            codes[j] = c + 1
            done = true
        } else if (c >= 65 && c < 90) {
            codes[j] = c + 1
            done = true
        } else if (c >= 48 && c < 57) {
            codes[j] = c + 1
            done = true
        } else if (c == 122) {
            codes[j] = 97
        } else if (c == 90) {
            codes[j] = 65
        } else if (c == 57) {
            codes[j] = 48
        } else {
            codes[j] = c + 1
            done = true
        }
        if (done) { return rbFromCodes(codes) }
        j = j - 1
    }
    // Every position wrapped: Go prepends the FIRST byte of the wrapped string.
    var out = rbFromCodes(codes)
    return out.charAt(0) + out
}

function rbFromCodes(codes) {
    var out = ""
    var i = 0
    while (i < codes.length) {
        out = out + String.fromCharCode(codes[i])
        i = i + 1
    }
    return out
}

// rubyRangeArr materializes lo..hi (excl: the three-dot form) as an array. The
// step caps keep a nonsensical range from hanging the program - the same two
// constants the Go twin uses.
function rbRangeArr(lo, hi, excl) {
    var out = []
    if (typeof lo == "string") {
        var hs = rbStr(hi)
        var s = lo
        var n = 0
        while (n < 1000000) {
            if (excl && s == hs) { break }
            if (s.length > hs.length) { break }
            out.push(s)
            if (s == hs) { break }
            s = rbStrSucc(s)
            n = n + 1
        }
        return out
    }
    var l = rbToF(lo)
    var h = rbToF(hi)
    if (excl) { h = h - 1 }
    var k = 0
    var i = l
    while (i <= h && k < 10000000) {
        out.push(i)
        i = i + 1
        k = k + 1
    }
    return out
}

// rubyOpenRangeCover: `r.cover?(v)` / `r === v` for a range with a missing bound,
// where the missing side never constrains.
function rbOpenRangeCover(o, v) {
    var lo = o["begin"]
    if (!rbIsNil(lo)) {
        var c = rbSpaceship(v, lo)
        if (c === null) { return false }
        if (c < 0) { return false }
    }
    var hi = o["end"]
    if (!rbIsNil(hi)) {
        var d = rbSpaceship(v, hi)
        if (d === null) { return false }
        if (o["excl"] === true) { return d < 0 }
        return d <= 0
    }
    return true
}

// ===================================================== binary operators =====

function rbRepeat(s, n) {
    var out = ""
    var i = 0
    while (i < n) {
        out = out + s
        i = i + 1
    }
    return out
}

// rubyBin: the one binary operator step. A user object dispatches to its own
// operator method, strings and arrays get their Ruby operators, everything else
// is the numeric tower.
function rbBin(op, l, r) {
    if (rbUserObj(l)) {
        // An exception instance that defines no + of its own concatenates as its
        // message, so `raise e + "er"` inside a rescue keeps working.
        if (op == "+" && l["args"] !== undefined && rbFindMethod(l, "+") === undefined) {
            return rbStr(l) + rbStr(r)
        }
        return rbMethod(l, op, [r])
    }
    if (op == "+") {
        if (typeof l == "string") { return rbStr(l) + rbStr(r) }
        if (typeof r == "string") { return rbStr(l) + rbStr(r) }
        if (rbIsArr(l) && rbIsArr(r)) {
            var out = rtCopyArr(l)
            var i = 0
            while (i < r.length) {
                out.push(r[i])
                i = i + 1
            }
            return out
        }
    }
    if (op == "*") {
        if (typeof l == "string") {
            var n = Math.trunc(rbToF(r))
            if (n < 0) { n = 0 }
            return rbRepeat(l, n)
        }
        // Array#* is repetition with an Integer and JOIN with a String.
        if (rbIsArr(l) && typeof r == "string") { return rbArrJoin(l, r) }
        if (rbIsArr(l)) {
            var rep = []
            var t = 0
            var times = Math.trunc(rbToF(r))
            while (t < times) {
                var j = 0
                while (j < l.length) {
                    rep.push(l[j])
                    j = j + 1
                }
                t = t + 1
            }
            return rep
        }
    }
    if (op == "-") {
        // Array#- is eql?/hash, like uniq and unlike include?: MRI answers
        // `[1, 2.0] - [2]` with [1, 2.0]. This was rbPyEqual, which converts
        // across the numeric classes and dropped the 2.0.
        if (rbIsArr(l) && rbIsArr(r)) {
            var diff = []
            var a = 0
            while (a < l.length) {
                var drop = false
                var b = 0
                while (b < r.length) {
                    if (rbEql(l[a], r[b])) {
                        drop = true
                        break
                    }
                    b = b + 1
                }
                if (!drop) { diff.push(l[a]) }
                a = a + 1
            }
            return diff
        }
    }
    // Array#& (intersection) and Array#| (union). Both keep the LEFT-hand order,
    // both dedupe, and both compare with eql? like Array#- above. Without these
    // arms they reached rbNumBin and ABORTED with "not a number in '&'".
    if (op == "&") {
        if (rbIsArr(l) && rbIsArr(r)) { return rbArrAnd(l, r) }
    }
    if (op == "|") {
        if (rbIsArr(l) && rbIsArr(r)) { return rbArrOr(l, r) }
    }
    if (op == "%") {
        if (typeof l == "string") { return rbFormat(l, r) }
    }
    if (op == "<<") {
        if (rbIsArr(l)) {
            l.push(r)
            return l
        }
        if (typeof l == "string") { return l + rbStr(r) }
    }
    return rbNumBin(op, l, r)
}

// ===================================================== Regexp / MatchData ===
//
// abnf/jsrtregex.go's Ruby half. The ENGINE is languages/lib/regex.js, imported
// at the top of this file, so only the value model and the method tables are
// here. Both values are ordinary objects carrying __rx-prefixed slots, exactly
// as the Go twin has them, so nothing else in this file has to learn a new type.

// The compile cache and the two value tests are SHARED - rxCache / rxGet,
// rxIsRegexObj / rxIsMatchObj and rxObjRe, all lib/regex.js, all under the Go
// twin's own names. jsrtregex.go has had exactly one of each since it was
// written; this side had four copies of the cache and two of everything else.
function rbRxIsRegex(v) { return rxIsRegexObj(v) }

function rbRxIsMatch(v) { return rxIsMatchObj(v) }

function rbRxObjRe(v) { return rxObjRe(v) }

function rbRxNewRegex(src, flags) { return {__rxsrc: src, __rxflags: flags} }

function rbRxNewMatch(src, flags, text, m) {
    var caps = []
    var i = 0
    var mc = m["caps"]
    while (i < mc.length) {
        caps.push(mc[i])
        i = i + 1
    }
    return {__rxmd: true, __rxsrc: src, __rxflags: flags, __rxtext: text, __rxcaps: caps}
}

// The Go twin's rxMatchOf answers three values; MetaJS has one return, so the
// three travel in a record. text stays a STRING: regex.js indexes UTF-16 code
// units where the Go engine indexes runes, which agree for everything in the
// Basic Multilingual Plane and therefore for every pattern in the corpus.
// SHARED as rxMatchOf - lib/regex.js, with kotlin's k5MatchOf and python's
// pyERxMatchOf. The rbToF coercion was the only difference and it is the
// identity on every value __rxcaps can hold.
function rbRxMatchOf(v) { return rxMatchOf(v) }

// rxSetGlobals publishes $~, $& and $1..$9 after a match attempt. A FAILED match
// clears them.
function rbRxSetGlobals(md) {
    var i = 1
    if (md === null) {
        rbGset("~", null)
        rbGset("&", null)
        while (i <= 9) {
            rbGset("" + i, null)
            i = i + 1
        }
        return undefined
    }
    var mo = rbRxMatchOf(md)
    rbGset("~", md)
    var whole = rxGroup(mo["re"], mo["text"], mo["m"], 0)
    rbGset("&", whole === null ? null : whole)
    while (i <= 9) {
        var g = rxGroup(mo["re"], mo["text"], mo["m"], i)
        rbGset("" + i, g === null ? null : g)
        i = i + 1
    }
    return undefined
}

// rxRunMatch searches and publishes the globals; null for no match.
function rbRxRunMatch(reObj, s, from) {
    var re = rbRxObjRe(reObj)
    if (!re["ok"]) { fail("invalid regexp /" + re["src"] + "/: " + re["err"]) }
    var m = rxSearch(re, s, from)
    if (m === null) {
        rbRxSetGlobals(null)
        return null
    }
    var o = rbRxNewMatch(re["src"], re["flags"], s, m)
    rbRxSetGlobals(o)
    return o
}

// MatchData#[]: an Integer reads a group by number, a Symbol or a String by name.
function rbRxMdIndex(md, key) {
    var mo = rbRxMatchOf(md)
    if (typeof key == "number") {
        var g = rxGroup(mo["re"], mo["text"], mo["m"], Math.trunc(key))
        if (g === null) { return null }
        return g
    }
    var name = ""
    if (rbIsSym(key)) { name = key["s"] } else if (typeof key == "string") { name = key } else { return null }
    var gi = rxIndexOfName(mo["re"], name)
    if (gi >= 0) {
        var gv = rxGroup(mo["re"], mo["text"], mo["m"], gi)
        if (gv !== null) { return gv }
    }
    return null
}

function rbRxCaptureArray(re, text, m, withWhole) {
    var out = []
    var i = withWhole ? 0 : 1
    while (i <= re["ngroups"]) {
        var g = rxGroup(re, text, m, i)
        out.push(g === null ? null : g)
        i = i + 1
    }
    return out
}

// String#scan: with no group it collects the whole matches, with groups the
// capture list of each match.
function rbRxScan(reObj, s) {
    var re = rbRxObjRe(reObj)
    var out = []
    var at = 0
    while (at <= s.length) {
        var m = rxSearch(re, s, at)
        if (m === null) { break }
        if (re["ngroups"] == 0) {
            var g = rxGroup(re, s, m, 0)
            out.push(g === null ? "" : g)
        } else {
            out.push(rbRxCaptureArray(re, s, m, false))
        }
        if (m["end"] == m["begin"]) { at = m["end"] + 1 } else { at = m["end"] }
    }
    return out
}

// The =~ operator: either operand may be the pattern, and the answer is the
// INDEX of the match (not a boolean) or nil.
function rbRxMatchOp(l, r) {
    var reObj = null
    var subj = null
    if (rbRxIsRegex(l)) {
        reObj = l
        subj = r
    } else if (rbRxIsRegex(r)) {
        reObj = r
        subj = l
    } else {
        fail("=~ needs a Regexp on one side")
    }
    if (rbIsNil(subj)) {
        rbRxSetGlobals(null)
        return null
    }
    var md = rbRxRunMatch(reObj, rbStr(subj), 0)
    if (md === null) { return null }
    var mo = rbRxMatchOf(md)
    return mo["m"]["begin"]
}

// rxRegexMethod answers a method call whose RECEIVER is a Regexp or a MatchData
// (or a String with a pattern argument), and `undefined` when the name is none of
// theirs - `undefined` is a safe miss sentinel because a Ruby method answers nil,
// which is null here and never undefined.
function rbRxMethod(target, name, args) {
    if (rbRxIsRegex(target)) {
        var re = rbRxObjRe(target)
        if (name == "match?") { return rxSearch(re, rbStr(rbArgAt(args, 0)), 0) !== null }
        if (name == "match") {
            var from = 0
            if (args.length > 1 && typeof args[1] == "number") { from = Math.trunc(args[1]) }
            var md = rbRxRunMatch(target, rbStr(rbArgAt(args, 0)), from)
            if (md === null) { return null }
            return md
        }
        if (name == "=~") { return rbRxMatchOp(target, rbArgAt(args, 0)) }
        if (name == "===") { return rbRxMatchOp(target, rbArgAt(args, 0)) !== null }
        if (name == "source") { return re["src"] }
        if (name == "options") { return 0 }
        if (name == "names") { return rtCopyArr(re["names"]) }
        if (name == "to_s") { return "(?-mix:" + re["src"] + ")" }
        if (name == "inspect") { return "/" + re["src"] + "/" + re["flags"] }
        if (name == "class") { return "Regexp" }
        fail("unknown Regexp method: " + name)
    }
    if (rbRxIsMatch(target)) {
        var mo = rbRxMatchOf(target)
        var mre = mo["re"]
        var text = mo["text"]
        var m = mo["m"]
        if (name == "[]") { return rbRxMdIndex(target, rbArgAt(args, 0)) }
        if (name == "to_a") { return rbRxCaptureArray(mre, text, m, true) }
        if (name == "captures") { return rbRxCaptureArray(mre, text, m, false) }
        if (name == "named_captures") {
            var d = rbNewDict()
            var ni = 0
            var nms = mre["names"]
            while (ni < nms.length) {
                var gv = rxGroup(mre, text, m, rxIndexOfName(mre, nms[ni]))
                d["keys"].push(nms[ni])
                d["vals"].push(gv === null ? null : gv)
                ni = ni + 1
            }
            return d
        }
        if (name == "names") { return rtCopyArr(mre["names"]) }
        if (name == "pre_match") { return text.substring(0, m["begin"]) }
        if (name == "post_match") { return text.substring(m["end"], text.length) }
        if (name == "begin" || name == "end") {
            var g = 0
            if (args.length > 0 && typeof args[0] == "number") { g = Math.trunc(args[0]) }
            var slot = 2 * g
            if (name == "end") { slot = slot + 1 }
            var caps = m["caps"]
            if (slot < caps.length) { return caps[slot] }
            return null
        }
        if (name == "size" || name == "length") { return mre["ngroups"] + 1 }
        if (name == "to_s") {
            var w = rxGroup(mre, text, m, 0)
            return w === null ? "" : w
        }
        if (name == "inspect") {
            var w2 = rxGroup(mre, text, m, 0)
            return "#<MatchData \"" + (w2 === null ? "" : w2) + "\">"
        }
        if (name == "class") { return "MatchData" }
        fail("unknown MatchData method: " + name)
    }
    // A String receiver whose argument is a pattern: the pattern-taking half of
    // Ruby's String methods, which the base dispatch knows nothing about.
    if (typeof target == "string" && args.length > 0) {
        var wants = false
        if (name == "match" || name == "match?" || name == "=~" || name == "scan") { wants = true }
        if (name == "sub" || name == "gsub" || name == "sub!" || name == "gsub!") { wants = true }
        if (name == "split" || name == "index") { wants = true }
        if (!wants) { return undefined }
        var pat = args[0]
        if (!rbRxIsRegex(pat)) {
            if (name == "split" || name == "index") { return undefined }
            pat = rbRxNewRegex(rbStr(args[0]), "m")
        }
        if (name == "match") {
            var smd = rbRxRunMatch(pat, target, 0)
            if (smd === null) { return null }
            return smd
        }
        if (name == "match?") { return rxSearch(rbRxObjRe(pat), target, 0) !== null }
        if (name == "=~") { return rbRxMatchOp(pat, target) }
        if (name == "scan") { return rbRxScan(pat, target) }
        if (name == "sub" || name == "sub!") { return rxReplace(rbRxObjRe(pat), target, rbStr(rbArgAt(args, 1)), false) }
        if (name == "gsub" || name == "gsub!") { return rxReplace(rbRxObjRe(pat), target, rbStr(rbArgAt(args, 1)), true) }
        if (name == "split") { return rxSplit(rbRxObjRe(pat), target) }
        if (name == "index") { return rbRxMatchOp(pat, target) }
    }
    return undefined
}

// ===================================================== method dispatch ======

function rbArgAt(args, i) {
    if (i < args.length) { return args[i] }
    return undefined
}

function rbCall1(f, a) { return f.apply(undefined, [a]) }
function rbCall2(f, a, b) { return f.apply(undefined, [a, b]) }
function rbCall3(f, a, b, c) { return f.apply(undefined, [a, b, c]) }

// rubyNumMethod: the Integer / Float / Rational / Complex method set. It answers
// `undefined` for a name it does not know, so the caller carries on with the
