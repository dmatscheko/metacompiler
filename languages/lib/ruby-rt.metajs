    if (name == "minmax") {
        if (t.length == 0) { return [null, null] }
        var mms = rbMSort(t, blk, false)
        return [mms[0], mms[mms.length - 1]]
    }
    // count: no argument is the length, an argument counts == matches, a block
    // counts the elements it accepts.
    if (name == "count") {
        if (blk !== null && nPos == 0) {
            var cb = 0
            var ci = 0
            while (ci < t.length) {
                if (rbTruthy(rbCall1(blk, t[ci]))) { cb = cb + 1 }
                ci = ci + 1
            }
            return cb
        }
        if (nPos == 0) { return t.length }
        var cn = 0
        var cj = 0
        while (cj < t.length) {
            if (rbEq(t[cj], args[0])) { cn = cn + 1 }
            cj = cj + 1
        }
