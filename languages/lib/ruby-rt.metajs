// MRI's flodivmod. rbZeroSign gives a zero modulo the dividend's sign, which
// fmod carries and the tag engine drops.
function rbFloDivmod(x, y) {
    if (y !== y) { rbFloDomain(y) }
    if (y == 0) { rbRaiseErr("divmod", "ZeroDivisionError", "divided by 0") }
    var xInf = x === x && x - x !== 0
    var yInf = y - y !== 0
    var mod = x
    if (!(x == 0 || (yInf && !xInf))) {
        mod = x % y
        if (mod == 0) { mod = rbZeroSign(x) }
    }
    var div = x
    if (!(xInf && !yInf)) {
        var dq = (x - mod) / y
        if (dq < 0) {
            div = 0 - Math.floor(0.5 - dq)
        } else {
            div = Math.floor(dq + 0.5)
