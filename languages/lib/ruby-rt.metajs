function js_req(l, r) { return rbEq(l, r) }
function js_rne(l, r) { return !rbEq(l, r) }
function js_rlt(l, r) { return rbCmp(l, r) < 0 }
function js_rgt(l, r) { return rbCmp(l, r) > 0 }
function js_rle(l, r) { return rbCmp(l, r) <= 0 }
function js_rge(l, r) { return rbCmp(l, r) >= 0 }

