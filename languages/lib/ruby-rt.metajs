// abnf/jsrtregex.go.
function rbReOptBits(flags) {
    var f = flags
    if (f.substring(0, 3) == "mpn") { f = f.substring(3, f.length) }
    var n = 0
    if (f.indexOf("i") >= 0) { n = n + 1 }
    if (f.indexOf("x") >= 0) { n = n + 2 }
    if (f.indexOf("s") >= 0) { n = n + 4 }
