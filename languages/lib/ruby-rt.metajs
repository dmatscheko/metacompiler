// An arithmetic operator whose operands are not both numbers. Twin of
// rubyNumOperandErr in abnf/jsrt.go, which states the rule.
function rbNumOperandErr(op, l, r) {
    if (op == "+" || op == "-" || op == "*" || op == "/" || op == "%" || op == "**") {
        if (rbNumRank(l) >= 0) {
            var desc = rbFmtConvName(r)
            if (rbIsSym(r)) { desc = rbInspect(r) }
