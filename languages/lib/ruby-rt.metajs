function js_rxcase(l, r) {
    if (rbRxIsRegex(l)) { return rbRxMatchOp(l, r) !== null }
    return js_rcase(l, r)
}

function js_rxwhen(l, r) {
    if (rbRxIsRegex(l)) { return rbRxMatchOp(l, r) !== null }
    return rbWhen(l, r)
}

function js_rxget(o, k) {
    if (rbRxIsMatch(o)) { return rbRxMdIndex(o, k) }
    return js_rget(o, k)
}

// The =~ operator.
function js_rxmatch(l, r) { return rbRxMatchOp(l, r) }
