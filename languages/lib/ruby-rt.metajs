            fail("unknown Hash method: " + name)
        }
        // Ruby's type predicates on an INSTANCE.
        if (name == "class") {
            var c0 = target["__class"]
            if (c0 !== undefined) { return c0 }
        }
        if (name == "instance_of?") { return target["__class"] === rbArgAt(args, 0) }
        if (name == "is_a?" || name == "kind_of?") {
