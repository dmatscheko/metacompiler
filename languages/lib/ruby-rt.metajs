    // null here - so a trailing undefined can only mean "not passed".
    return function(recv, a1, a2) {
        var rest = []
        if (a1 !== undefined) { rest.push(a1) }
        if (a2 !== undefined) { rest.push(a2) }
        return rbMethod(recv, name, rest)
    }
}

// A $global lives outside every scope and reads as nil until first assigned.
function js_rgget(name) {
    var v = rbGlobals["$" + rbStr(name)]
    if (v === undefined) { return null }
    return v
}

function js_rgset(name, v) { return rbGset(rbStr(name), v) }

// defined?($x): the KIND of the name, or nil. The shape of the name decided the
// kind at compile time; this only tests presence.
function js_rgdefined(name, kind) {
    if (rbGlobalNames["$" + rbStr(name)] === true) { return kind }
    return null
}

// A @@class variable belongs to the CLASS, shared by every instance and by the
// subclasses: the lookup starts at the class of `self` (or at self when it
// already IS a class) and walks __super.
function js_rcvget(self, name) {
    var key = "@@" + rbStr(name)
    var cls = rbClassOfSelf(self)
    while (cls !== undefined && cls !== null) {
        if (!rbIsObj(cls)) { break }
        var v = cls[key]
        if (v !== undefined) { return v }
        cls = cls["__super"]
    }
    return null
}

function js_rcvset(self, name, v) {
    var key = "@@" + rbStr(name)
    var start = rbClassOfSelf(self)
    var cls = start
    while (cls !== undefined && cls !== null) {
        if (!rbIsObj(cls)) { break }
        if (cls[key] !== undefined) {
            cls[key] = v
            return undefined
        }
        cls = cls["__super"]
    }
    if (rbIsObj(start)) { start[key] = v }
    return undefined
}

// ----- the regex-aware wrappers ---------------------------------------------
// The ruby emitter emits these EVERYWHERE it would otherwise emit the plain
// js_rmcall / js_rcase / js_rwhen / js_rget, so the plain ones are never
// declared and rbMethod / js_rcase / rbWhen / js_rget above carry the base
// behaviour.

// A regexp literal: /src/flags, validated here so a bad pattern is a clean
// runtime error rather than a wrong match.
function js_rxnew(src, flags) {
    var s = rbStr(src)
    var f = rbStr(flags)
    var re = rbRxGet(s, f)
    if (!re["ok"]) { fail("invalid regexp /" + s + "/: " + re["err"]) }
    return rbRxNewRegex(s, f)
}

function js_rxmcall(target, name, args) {
    if (rbRxIsRegex(target) || rbRxIsMatch(target) || (rbIsArr(args) && args.length > 0 && rbRxIsRegex(args[0]))) {
        var v = rbRxMethod(target, rbStr(name), args)
        if (v !== undefined) { return v }
    }
    return rbMethod(target, rbStr(name), args)
}

function js_rxcase(l, r) {
    if (rbRxIsRegex(l)) { return rbRxMatchOp(l, r) !== null }
    return js_rcase(l, r)
}

function js_rxwhen(l, r) {
    if (rbRxIsRegex(l)) { return rbRxMatchOp(l, r) !== null }
    return rbWhen(l, r)
}

function js_rxget(o, k) {
    if (rbRxIsMatch(o)) { return rbRxMdIndex(o, k) }
    return js_rget(o, k)
}

// The =~ operator.
function js_rxmatch(l, r) { return rbRxMatchOp(l, r) }
