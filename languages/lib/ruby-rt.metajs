    if (!rbIsArr(o)) { fail("item assignment on a " + typeof o) }
    var idx = Math.trunc(rbToF(k))
    if (idx < 0) { idx = idx + o.length }
    if (idx < 0) { fail("index " + idx + " too small for array") }
    while (o.length <= idx) { o.push(null) }
    o[idx] = v
    return undefined
}

// `def obj.m' and a def inside `class << obj': install ONE closure in the
// receiver's own singleton table. The class machinery of ruby-to-llvm-ir.abnf is
// build time and the receiver of these two forms is only known at run time.
function js_rsingdef(obj, name, fn) {
    rbSingPut(obj, rbStr(name), fn)
    return undefined
}

// C.new(args): build an instance of a compiled class and run its initialize. Two
// builtin classes are constructed directly: Proc.new { } is its block, and an
// exception class makes the {__class, args} shape the rescue clauses read.
function js_rnew(cls, args) {
    var argv = []
    if (rbIsArr(args)) { argv = args }
    if (rbIsObj(cls)) {
