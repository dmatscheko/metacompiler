        var ha = 7
        var i = 0
        while (i < v.length) {
            ha = (ha * 31 + rbHashOf(v[i])) % 2147483647
            i = i + 1
        }
        return ha
    }
    if (rbIsDict(v)) {
        var keys = v["keys"]
        var vals = v["vals"]
        var hd = 11
        var j = 0
        while (j < keys.length) {
            hd = (hd + (rbHashOf(keys[j]) * 31 + rbHashOf(vals[j])) % 2147483647) % 2147483647
            j = j + 1
        }
        return hd
    }
    if (rbUserObj(v) && rbFindMethod(v, "hash") !== undefined) { return rbToF(rbNumBin("%", rbMethod(v, "hash", []), 2147483647)) }
    if (rtIsNil(v) || v === true || v === false) { return rbStrHash("n" + rbInspect(v)) }
    if (typeof v == "number" || rbIsBig(v)) { return rbStrHash("i" + rbInspect(v)) }
    if (typeof v == "string") { return rbStrHash("s" + v) }
    if (rbIsSym(v)) { return rbStrHash("y" + v["s"]) }
    if (rbIsFlo(v)) { return rbStrHash("f" + rbInspect(v)) }
    if (rbIsRat(v)) { return rbStrHash("r" + rbInspect(v)) }
    if (rbIsCpx(v)) { return rbStrHash("c" + rbInspect(v)) }
    if (rbIsRange(v)) { return rbStrHash("g" + rbInspect(v)) }
    if (rbRxIsRegex(v)) { return rbStrHash("x" + rbInspect(v)) }
