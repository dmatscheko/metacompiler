    }
    if (i < args.length) { return args[i] }
    return undefined
}

// A lambda literal (->) / Kernel#lambda: an ordinary closure, remembered here so
// `lambda?` can tell it from a proc.
function js_rlambda(f) {
    rbLambdas.push(f)
    return f
}

// KERNEL#LAMBDA'S ARITY CHECK. A block binds loosely (a missing parameter is nil,
// an extra argument is dropped) and a lambda does not, so `lambda { |x| }' has to
// WRAP its block in a frame that raises MRI's ArgumentError; `->(x) { }' gets the
// same check from emitParams instead, because its body IS the checked function.
// `kinds' is js_rposbind's encoding, recorded at the block LITERAL by the emitter -
// the arity registry could not supply it, being armed only when the program names
// `arity'. The registry entry, if there is one, is re-registered onto the wrapper so
// Proc#arity still answers.
function js_rlamchk(f, kinds) {
    if (!rbIsFn(f)) { return f }
    var w = function() {
        var av = []
        var i = 0
        while (i < arguments.length) { av.push(arguments[i]); i = i + 1 }
        rbLamArity(av, kinds)
        return f.apply(undefined, av)
    }
    var rec = rtPairGet(rbArityFns, rbArityRec, f)
    if (rec !== undefined) {
        rbArityFns.push(w)
        rbArityRec.push(rec)
    }
    return w
}
// The count check itself: a trailing block marker is not a positional argument, a
// *splat lifts the ceiling, and the message is MRI's. Mirrors lamArity of
// ruby-interpreter.abnf and rubyLamArity of abnf/jsrt.go.
function rbLamArity(av, kinds) {
    var npos = av.length
    if (npos > 0 && rbIsBlk(av[npos - 1])) { npos = npos - 1 }
    var req = 0
    var star = false
    var i = 0
    while (i < kinds.length) {
        var c = kinds.charAt(i)
        if (c == "2") { star = true }
        else if (c != "1") { req = req + 1 }
        i = i + 1
    }
    if (npos < req) { rbArgCountErr(npos, kinds, false) }
    if (!star && npos > kinds.length) { rbArgCountErr(npos, kinds, false) }
    return undefined
}

// The parameter shape of the closure just built, for Proc#arity - the closure
// itself is handed straight back, exactly as js_rlambda does. See rbProcArity for
// why the three counts are stored rather than the answer.
function js_rarity(f, req, opt, star) {
    rbArityFns.push(f)
    rbArityRec.push([rbToF(req), rbToF(opt), rbTruthy(star)])
    return f
}

// Proc#arity. The SHAPE is stored rather than the answer because Kernel#lambda
// turns an already-built proc into a lambda, and the two count optional parameters
// differently: a proc ignores them (`proc { |x = 0| }.arity' is 0), a lambda does
// not (`lambda { |x = 0| }.arity' is -1). A *splat makes it -(required + 1) either
// way, and keyword and block parameters are not counted at all. Mirrors procArity
// of ruby-interpreter.abnf and rubyArityOf of abnf/jsrt.go.
function rbProcArity(f) {
    var rec = rtPairGet(rbArityFns, rbArityRec, f)
    if (rec === undefined) { return 0 }
    if (rec[2] === true) { return 0 - (rec[0] + 1) }
    // A METHOD counts optionals the way a lambda does: MRI's `method(:m).arity' for
    // `def m(a, b = 1)' is -2, not the proc's 1.
    if ((rtHas(rbLambdas, f) || rbIsMethodVal(f)) && rec[1] > 0) { return 0 - (rec[0] + 1) }
    return rec[0]
}

// &:sym as a block argument: the "call this method on each element" proc. A Proc
// is passed straight through.
function js_rsymproc(v) {
    if (!rbIsSym(v)) { return v }
    var name = v["s"]
    // The Go twin builds a variadic hostFunc; MetaJS has no `arguments`, so the
    // proc is written with the three parameters a Ruby block is ever called with
    // (map/each pass one, Hash#each two) and the ABSENT ones are trimmed. That is
    // exact rather than approximate: a Ruby value is never `undefined` - nil is
    // null here - so a trailing undefined can only mean "not passed".
    return function(recv, a1, a2) {
        var rest = []
        if (a1 !== undefined) { rest.push(a1) }
        if (a2 !== undefined) { rest.push(a2) }
        return rbBoxOut(recv, rbMethod(recv, name, rest))

    }
}

// A $global lives outside every scope and reads as nil until first assigned.
function js_rgget(name) {
    var v = rbGlobals["$" + rbStr(name)]
    if (v === undefined) { return null }
    return v
}

function js_rgset(name, v) { return rbGset(rbStr(name), v) }

// defined?($x): the KIND of the name, or nil. The shape of the name decided the
// kind at compile time; this only tests presence.
function js_rgdefined(name, kind) {
    if (rbGlobalNames["$" + rbStr(name)] === true) { return kind }
    return null
}

// defined?(x): the KIND of a plain name, or nil - abnf/jsrt.go's js_rdefined,
// walk for walk (`for s := rt.scopeOf(a[0]); s != nil; s = s.parent { if
// s.has(name) }`). The kind was decided at compile time from the shape of the
// source text; this only answers whether the name is BOUND anywhere up the
// chain.
//
// WHY IT IS HERE AND NOT IN THE EMITTER: an emitter may call js_scope_typeof but
// may not open a scope, and js_scope_typeof CANNOT DISTINGUISH "holds undefined"
// from "absent" (docs/working-on-this-project.md 7.3). A Ruby BLOCK PARAMETER the
// caller did not supply holds exactly undefined - js_arg answers undefined for a
// missing index and js_scope_decl stores it, which is what emitParamDefault's
// js_rundef test then reads. So:
//
//     [1].each { |a, b| puts defined?(b).inspect }
//
// must answer "local-variable", as MRI does. scopeHas is the own-scope test that
// CAN tell the two apart, and it is a HOST BUILTIN (ids 65..68), reachable only
// from here - the same wall and the same answer as js_rmethodval above. The call
// site is `defined?` itself, which no hot path in any test program contains.
//
// A Ruby local is visible up to the nearest scope declaring "$blk" - the
// method's own frame, or the program's main scope - and never beyond it, which
// also keeps out the host's root scope (MetaJS's own print/printf/sprintf). A
// name bound nowhere is "method" when self has one. Twin of js_rdefined in
// abnf/jsrt.go.
function js_rdefined(scope, name, kind) {
    var n = rbStr(name)
    var s = anytype
    var self = anytype
    s = scope
    self = null
    while (s !== undefined && s !== null) {
        if (scopeHas(s, n)) { return kind }
        if (self === null && scopeHas(s, "self")) { self = scopeGet(s, "self") }
        if (scopeHas(s, "$blk")) {
            s = null
        } else {
            s = scopeParent(s)
        }
    }
    if (self !== null && self !== undefined && rbFindMethod(self, n) !== undefined) { return "method" }
    return null
}

// defined?(@x) / defined?(@@x): defined only once ASSIGNED, on self or up its
// class chain. Twin of js_rvardefined in abnf/jsrt.go.
function js_rvardefined(scope, name) {
    var n = rbStr(name)
    var s = anytype
    var self = anytype
    s = scope
    self = null
    while (s !== undefined && s !== null && self === null) {
        if (scopeHas(s, "self")) { self = scopeGet(s, "self") }
        s = scopeParent(s)
    }
    if (n.charAt(1) == "@") {
        var cls = rbClassOfSelf(self)
        while (cls !== undefined && cls !== null) {
            if (!rbIsObj(cls)) { return null }
            if (cls[n] !== undefined) { return "class variable" }
            cls = cls["__super"]
        }
        return null
    }
    if (rbIsObj(self) && self[n.substring(1)] !== undefined) { return "instance-variable" }
    return null
}

// A @@class variable belongs to the CLASS, shared by every instance and by the
// subclasses: the lookup starts at the class of `self` (or at self when it
// already IS a class) and walks __super.
function js_rcvget(self, name) {
    var key = "@@" + rbStr(name)
    var cls = rbClassOfSelf(self)
    while (cls !== undefined && cls !== null) {
        if (!rbIsObj(cls)) { break }
        var v = cls[key]
        if (v !== undefined) { return v }
        cls = cls["__super"]
    }
    return null
}

function js_rcvset(self, name, v) {
    var key = "@@" + rbStr(name)
    var start = rbClassOfSelf(self)
    var cls = start
    while (cls !== undefined && cls !== null) {
        if (!rbIsObj(cls)) { break }
        if (cls[key] !== undefined) {
            cls[key] = v
            return undefined
        }
        cls = cls["__super"]
    }
    if (rbIsObj(start)) { start[key] = v }
    return undefined
}

// ----- the regex-aware wrappers ---------------------------------------------
// The ruby emitter emits these EVERYWHERE it would otherwise emit the plain
// js_rmcall / js_rcase / js_rwhen / js_rget, so the plain ones are never
// declared and rbMethod / js_rcase / rbWhen / js_rget above carry the base
// behaviour.

// A regexp literal: /src/flags, validated here so a bad pattern is a clean
// runtime error rather than a wrong match.
function js_rxnew(src, flags) {
    var s = rbStr(src)
    var f = rbStr(flags)
    var re = rxGet(s, f)
    if (!re["ok"]) { fail("invalid regexp /" + s + "/: " + re["err"]) }
    return rbRxNewRegex(s, f)
}

function js_rxmcall(target, name, args) {
    var mn = rbStr(name)
    var r = anytype
    r = undefined
    // A STRING PATTERN reaches the regexp half too: Ruby compiles a String
    // pattern to a Regexp, so `s.sub("a", "z")` (and gsub, sub!, gsub!, match,
    // match?, =~, scan) must reach rbRxMethod, which normalizes a String
    // argument.
    if (rbRxIsRegex(target) || rbRxIsMatch(target)
        || (rbIsArr(args) && args.length > 0 && rbRxIsRegex(args[0]))
        || (typeof target == "string" && rbRxWantsPattern(mn))) {
        r = rbRxMethod(target, mn, args)
    }
    if (r === undefined) { r = rbMethod(target, mn, args) }
    if (typeof r == "string" || typeof target == "string") { return rbBoxOut(target, r) }
    return r
}
// A method call's answer as the program sees it: a String the call built is a new
// box, and so is every String in an Array a String method built (a box receiver
// answers through a call on its text, so it is covered). Twin of rubyBoxOut in
// abnf/jsrtruby.go.
function rbBoxOut(recv, r) {
    if (typeof r == "string") { return rbMkRStr(r, false) }
    if (typeof recv == "string" && rbIsArr(r)) {
        var i = 0
        while (i < r.length) {
            if (typeof r[i] == "string") { r[i] = rbMkRStr(r[i], false) }
            i = i + 1
        }
    }
    return r
}
// The String methods whose argument is a PATTERN. split and index are left out on
// purpose: with a plain-string argument they are ordinary string operations and
// rbMethod answers them.
function rbRxWantsPattern(name) {
    if (name == "match" || name == "match?" || name == "=~" || name == "scan") { return true }
    return name == "sub" || name == "gsub" || name == "sub!" || name == "gsub!"
}

function js_rxcase(l, r) {
    if (rbRxIsRegex(l)) { return rbRxMatchOp(l, r) !== null }
    return js_rcase(l, r)
}

function js_rxwhen(l, r) {
    if (rbRxIsRegex(l)) { return rbRxMatchOp(l, r) !== null }
    return rbWhen(l, r)
}

function js_rxget(o, k) {
    if (rbRxIsMatch(o)) { return rbRxMdIndex(o, k) }
    return js_rget(o, k)
}

// The =~ operator.
function js_rxmatch(l, r) { return rbRxMatchOp(l, r) }
