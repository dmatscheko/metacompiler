            var vals = target["vals"]
            if (name == "inspect") { return rbInspect(target) }
            if (name == "size" || name == "length") { return keys.length }
            if (name == "keys") { return rtCopyArr(keys) }
            if (name == "values") { return rtCopyArr(vals) }
            if (name == "to_a" || name == "entries") {
                var pairs = []
                var p = 0
                while (p < keys.length) {
                    pairs.push([keys[p], vals[p]])
                    p = p + 1
