    // compares field by field, and true in MRI. A run-vs-native divergence that
    // predates this round's Array work and that only a native probe could see:
    // the matrix, --full and --cross all run llvm.Run. rbEq settles two numbers
    // without reaching this function again.
    if (rbIsNum(x) && rbIsNum(y)) { return rbEq(x, y) }
