    if (v === true) { return 20 }
    if (v === false) { return 0 }
    if (typeof v == "number" || rbIsBig(v)) { return rbNumBin("+", rbNumBin("*", v, 2), 1) }
    var valued = typeof v == "string" || rbIsRat(v) || rbIsCpx(v)
