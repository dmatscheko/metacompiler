}


// ----- Kernel#Integer / #Float / #String / #Array: the CONVERSION functions.
// Integer and Float are STRICT (MRI raises ArgumentError on anything the whole
// string is not), which is what makes `Integer(s) rescue default` the idiom it
// is. Mirrors rubyKernelConv of abnf/jsrt.go and kernelConv of
// ruby-interpreter.abnf.
function rbConvDigit(ch) {
    if (ch >= "0" && ch <= "9") { return ch.charCodeAt(0) - 48 }
    if (ch >= "a" && ch <= "z") { return ch.charCodeAt(0) - 87 }
    if (ch >= "A" && ch <= "Z") { return ch.charCodeAt(0) - 55 }
    return 0 - 1
}

// BY CHARACTER CODE, not by comparing against "\f" / "\v". MetaJS's string
// literal has no \f and no \v escape: it drops the backslash, so `ch == "\f"'
// is `ch == "f"' - correct under goja and in the Go twin, wrong only in the
// native binary.
function rbIsConvSpace(ch) {
    var cc = ch.charCodeAt(0)
    return cc == 32 || cc == 9 || cc == 10 || cc == 13 || cc == 12 || cc == 11
}

// Answers {ok, v}: MRI's rb_int_parse_cstr, the one parser behind String#to_i,
// #hex, #oct and Kernel#Integer, with v the EXACT value. Twin of rubyStrToInum
// in abnf/jsrt.go, which states the rules.
function rbStrToInum(s, base0, badcheck) {
    var n = s.length
    var i = 0
    var base = base0
    while (i < n && rbIsConvSpace(s.charAt(i))) { i = i + 1 }
    var neg = false
    if (i < n && (s.charAt(i) == "+" || s.charAt(i) == "-")) {
        neg = s.charAt(i) == "-"
        i = i + 1
    }
    var p = ""
    if (i + 1 < n) { p = s.charAt(i + 1).toLowerCase() }
    var zero = i < n && s.charAt(i) == "0"
    if (base <= 0) {
        if (zero && i + 1 < n) {
            base = 8
            if (p == "x") { base = 16 }
            else if (p == "b") { base = 2 }
            else if (p == "o") { base = 8 }
            else if (p == "d") { base = 10 }
            if (p == "x" || p == "b" || p == "o" || p == "d") { i = i + 2 }
        } else if (base < -1) {
            base = 0 - base
        } else {
            base = 10
        }
    } else if (zero && ((base == 2 && p == "b") || (base == 8 && p == "o") || (base == 10 && p == "d") || (base == 16 && p == "x"))) {
        i = i + 2
    }
    if (i >= n) { return {ok: false, v: 0} }
    if (s.charAt(i) == "0" && i + 1 < n) {
        var us = 0
        var squeezing = true
        while (squeezing) {
            i = i + 1
            var c = ""
            if (i < n) { c = s.charAt(i) }
            if (c == "_") {
                us = us + 1
                if (us >= 2) { squeezing = false }
            } else if (c == "0") {
                us = 0
            } else {
                if (c == "" || rbIsConvSpace(c)) { i = i - 1 }
                squeezing = false
            }
        }
    }
    var d0 = 0 - 1
    if (i < n) { d0 = rbConvDigit(s.charAt(i)) }
    if (d0 < 0 || d0 >= base) { return {ok: false, v: 0} }
    // A double while every step stays exact, base-10000 limbs after that.
    var acc = 0
    var isBigAcc = false
    var limbs = []
    var nondigit = false
    while (i < n) {
        var ch = s.charAt(i)
        if (ch == "_") {
            if (nondigit) {
                if (badcheck) { return {ok: false, v: 0} }
                break
            }
            nondigit = true
            i = i + 1
            continue
        }
        var d = rbConvDigit(ch)
        if (d < 0 || d >= base) { break }
        if (!isBigAcc && acc < 250000000000000) {
            acc = acc * base + d
        } else {
            if (!isBigAcc) {
                limbs = rtBigFromNum(acc)
                isBigAcc = true
            }
            rtBigMulSmall(limbs, base)
            var k = 0
            var carry = d
            while (carry > 0) {
                if (k == limbs.length) { limbs.push(0) }
                var t = limbs[k] + carry
                carry = Math.floor(t / 10000)
                limbs[k] = t - carry * 10000
                k = k + 1
            }
        }
        nondigit = false
        i = i + 1
    }
    if (badcheck) {
        while (i < n && rbIsConvSpace(s.charAt(i))) { i = i + 1 }
        if (nondigit || i < n) { return {ok: false, v: 0} }
    }
    if (isBigAcc) { return {ok: true, v: rtABigNarrow(rtkABigNew(neg, limbs))} }
    if (neg && acc != 0) { return {ok: true, v: 0 - acc} }
    return {ok: true, v: acc}
}

// The base argument of String#to_i and Kernel#Integer. Twin of rubyRadixArg in
// abnf/jsrt.go.
function rbRadixArg(v, negOK) {
    var b = Math.trunc(rbToF(v))
    if (b == 1 || b > 36 || b < -36 || (b < 0 && !negOK)) { rbRaiseErr("", "ArgumentError", "invalid radix " + b) }
    return b
}

function js_rkconv(name, args) {
    var v = anytype
    v = null
    if (rbIsArr(args) && args.length > 0) { v = rbSV(args[0]) }
    if (name == "String") { return rbStr(v) }
    // Kernel#Rational and Kernel#Complex, the ONLY spelling that builds either from
    // two parts. Rational(a) IS a.to_r and Rational(a, b) is a.to_r / b.to_r, so
    // both go through rbAsRat and inherit exactly what #to_r already answers.
    if (name == "Rational") {
        var rp = rbAsRat(v)
        if (!rbIsArr(args) || args.length < 2) { return rbMkRat(rp["n"], rp["d"]) }
        var rq = rbAsRat(args[1])
        if (rbEq(rq["n"], 0)) { rbRaiseErr(name, "ZeroDivisionError", "divided by 0") }
        return rbMkRat(rbNumBin("*", rp["n"], rq["d"]), rbNumBin("*", rp["d"], rq["n"]))
    }
    if (name == "Complex") {
        var nargs = rbIsArr(args) ? args.length : 0
        if (nargs < 2 && rbIsCpx(v)) { return v }
        if (nargs > 1) { return rbMkCpx(v, args[1]) }
        return rbMkCpx(v, 0)
    }
    if (name == "Array") {
        if (rtIsNil(v)) { return [] }
        if (rbIsArr(v)) { return v }
        if (rbIsDict(v)) {
            var out = []
            var keys = v["keys"]
            var vals = v["vals"]
            var q = 0
            while (q < keys.length) { out.push([keys[q], vals[q]]); q = q + 1 }
            return out
        }
        return [v]
    }
    if (name == "Integer") {
        var base = 0
        if (rbIsArr(args) && args.length > 1) {
            if (typeof v != "string") { rbRaiseErr(name, "ArgumentError", "base specified for non string value") }
            base = rbRadixArg(args[1], true)
        }
        if (rtIsNil(v)) { rbRaiseErr(name, "TypeError", "can't convert nil into Integer") }
        if (typeof v == "string") {
            var ri = rbStrToInum(v, base, true)
            if (ri["ok"]) { return ri["v"] }
            rbRaiseErr(name, "ArgumentError", "invalid value for Integer(): " + rbStrInspect(v))
        }
        // A Float converts as Float#to_i does.
        if (rbIsFlo(v)) {
            rbFloDomain(v["f"])
            return rbIntFromF(Math.trunc(v["f"]))
        }
        return v
    }
    if (name == "Float") {
        if (rtIsNil(v)) { rbRaiseErr(name, "TypeError", "can't convert nil into Float") }
        if (typeof v == "string") {
            var rf = anytype
            rf = rbnStrToDbl(v, true)
            if (rf !== null) { return rbMkFlo(rf) }
            rbRaiseErr(name, "ArgumentError", "invalid value for Float(): " + rbStrInspect(v))
        }
        return rbMkFlo(rbToF(v))
    }
    return v
}

// ===== String methods shared by all three engines ==========================
//
// bytes, tr, center, ljust/rjust, count, delete, their families and the cheap
// remainder of MRI's String surface. Everything here is a pure function of
// strings and numbers, so the three copies (abnf/jsrt.go, lib/ruby-rt.metajs and
// ruby-interpreter.abnf) are line-for-line the same.

// The UTF-8 bytes of a string whose units are UTF-16, surrogate pairs included.
// String#bytes / #bytesize / #getbyte / #each_byte / #sum all read this.
function smUtf8Bytes(s) {
    var out = []
    var i = 0
    while (i < s.length) {
        var c = s.charCodeAt(i)
        i = i + 1
        if (c >= 55296 && c <= 56319 && i < s.length) {
            var lo = s.charCodeAt(i)
            if (lo >= 56320 && lo <= 57343) {
                c = 65536 + (c - 55296) * 1024 + (lo - 56320)
                i = i + 1
            }
        }
        if (c < 128) { out.push(c) }
        else if (c < 2048) {
            out.push(192 + Math.floor(c / 64))
            out.push(128 + (c % 64))
        } else if (c < 65536) {
            out.push(224 + Math.floor(c / 4096))
            out.push(128 + (Math.floor(c / 64) % 64))
            out.push(128 + (c % 64))
        } else {
            out.push(240 + Math.floor(c / 262144))
            out.push(128 + (Math.floor(c / 4096) % 64))
            out.push(128 + (Math.floor(c / 64) % 64))
            out.push(128 + (c % 64))
        }
    }
    return out
}

// The Unicode code points of a string: String#codepoints / #each_codepoint.
function smCodePoints(s) {
    var out = []
    var i = 0
    while (i < s.length) {
        var c = s.charCodeAt(i)
        i = i + 1
        if (c >= 55296 && c <= 56319 && i < s.length) {
            var lo = s.charCodeAt(i)
            if (lo >= 56320 && lo <= 57343) {
                c = 65536 + (c - 55296) * 1024 + (lo - 56320)
                i = i + 1
            }
        }
        out.push(c)
    }
    return out
}

// MRI's character-set notation, shared by tr / tr_s / count / delete / squeeze:
// a leading ^ negates, `a-z` is a range, and a backslash escapes the next
// character. Answers {neg, chars} with every range expanded.
function smSetExpand(spec) {
    var neg = false
    var i = 0
    if (spec.length > 1 && spec.charAt(0) == "^") { neg = true; i = 1 }
    var chars = ""
    while (i < spec.length) {
        var ch = spec.charAt(i)
        if (ch == "\\" && i + 1 < spec.length) {
            chars = chars + spec.charAt(i + 1)
            i = i + 2
            continue
        }
        if (i + 2 < spec.length && spec.charAt(i + 1) == "-") {
            var a = spec.charCodeAt(i)
            var b = spec.charCodeAt(i + 2)
            var k = a
            while (k <= b) { chars = chars + String.fromCharCode(k); k = k + 1 }
            i = i + 3
            continue
        }
        chars = chars + ch
        i = i + 1
    }
    return {neg: neg, chars: chars}
}

// Is ch in EVERY one of the given set specs? MRI intersects the sets of
// count / delete / squeeze when more than one is given.
function smInSets(specs, ch) {
    var i = 0
    while (i < specs.length) {
        var st = smSetExpand(specs[i])
        var found = st["chars"].indexOf(ch) >= 0
        if (st["neg"]) { found = !found }
        if (!found) { return false }
        i = i + 1
    }
    return specs.length > 0
}

// String#tr / #tr_s. An empty `to` DELETES; a shorter one repeats its last
// character; a negated `from` maps everything outside the set to that last
// character. tr_s additionally squeezes the runs it produced.
function smTr(s, from, to, sq) {
    var f = smSetExpand(from)
    var t = smSetExpand(to)
    var last = t["chars"].length > 0 ? t["chars"].charAt(t["chars"].length - 1) : ""
    var out = ""
    var prev = ""
    var i = 0
    while (i < s.length) {
        var ch = s.charAt(i)
        i = i + 1
        var hit = f["chars"].indexOf(ch) >= 0
        var rep = ch
        var did = false
        if (f["neg"]) {
            if (!hit) { rep = last; did = true }
        } else if (hit) {
            var k = f["chars"].indexOf(ch)
            if (t["chars"].length == 0) { rep = "" } else if (k >= t["chars"].length) { rep = last }
            else { rep = t["chars"].charAt(k) }
            did = true
        }
        if (rep == "") { prev = ""; continue }
        if (sq && did && rep == prev) { continue }
        out = out + rep
        prev = did ? rep : ""
    }
    return out
}

// String#squeeze: collapse a run of the same character, restricted to the sets
// when any are given.
function smSqueeze(s, specs) {
    var out = ""
    var prev = ""
    var i = 0
    while (i < s.length) {
        var ch = s.charAt(i)
        i = i + 1
        if (ch == prev && (specs.length == 0 || smInSets(specs, ch))) { continue }
        out = out + ch
        prev = ch
    }
    return out
}

function smCount(s, specs) {
    var n = 0
    var i = 0
    while (i < s.length) {
        if (smInSets(specs, s.charAt(i))) { n = n + 1 }
        i = i + 1
    }
    return n
}

function smDelete(s, specs) {
    var out = ""
    var i = 0
    while (i < s.length) {
        var ch = s.charAt(i)
        if (!smInSets(specs, ch)) { out = out + ch }
        i = i + 1
    }
    return out
}

// String#center / #ljust / #rjust. mode 0 centres, 1 pads on the right, 2 on the
// left. MRI counts CHARACTERS here, and a width at or below the receiver's length
// answers the receiver.
function smPad(s, width, pad, mode) {
    if (pad.length == 0 || width <= s.length) { return s }
    var total = width - s.length
    var left = 0
    if (mode == 0) { left = Math.floor(total / 2) } else if (mode == 2) { left = total }
    var right = total - left
    return smRepeatTo(pad, left) + s + smRepeatTo(pad, right)
}

function smRepeatTo(pad, n) {
    var out = ""
    var i = 0
    while (out.length < n) {
        out = out + pad.charAt(i % pad.length)
        i = i + 1
    }
    return out
}

function smSwapcase(s) {
    var out = ""
    var i = 0
    while (i < s.length) {
        var ch = s.charAt(i)
        var up = ch.toUpperCase()
        if (ch == up) { out = out + ch.toLowerCase() } else { out = out + up }
        i = i + 1
    }
    return out
}

// String#lines: split after each newline, keeping it.
function smLines(s) {
    var out = []
    var cur = ""
    var i = 0
    while (i < s.length) {
        cur = cur + s.charAt(i)
        if (s.charAt(i) == "\n") { out.push(cur); cur = "" }
        i = i + 1
    }
    if (cur.length > 0) { out.push(cur) }
    return out
}

// String#chomp: the trailing record separator, "\r\n" counting as one.
function smChomp(s) {
    if (s.length >= 2 && s.substring(s.length - 2, s.length) == "\r\n") { return s.substring(0, s.length - 2) }
    if (s.length >= 1) {
        var c = s.charAt(s.length - 1)
        if (c == "\n" || c == "\r") { return s.substring(0, s.length - 1) }
    }
    return s
}

// String#chop: the last character, "\r\n" counting as one.
function smChop(s) {
    if (s.length >= 2 && s.substring(s.length - 2, s.length) == "\r\n") { return s.substring(0, s.length - 2) }
    if (s.length == 0) { return s }
    return s.substring(0, s.length - 1)
}

function smIsStrip(cc) {
    return cc == 32 || cc == 9 || cc == 10 || cc == 13 || cc == 12 || cc == 11 || cc == 0
}

function smLstrip(s) {
    var i = 0
    while (i < s.length && smIsStrip(s.charCodeAt(i))) { i = i + 1 }
    return s.substring(i, s.length)
}

function smRstrip(s) {
    var j = s.length
    while (j > 0 && smIsStrip(s.charCodeAt(j - 1))) { j = j - 1 }
    return s.substring(0, j)
}

// String#rindex: the LAST index of sub, or -1. indexOf ignores its second
// argument in this dialect, so the scan is written out.
function smRindex(s, sub) {
    if (sub.length == 0) { return s.length }
    var i = s.length - sub.length
    while (i >= 0) {
        if (s.substring(i, i + sub.length) == sub) { return i }
        i = i - 1
    }
    return 0 - 1
}

// casecmp folds ASCII only - to UPPER case, so "[".casecmp("a") is 1 - and then
// compares like MRI's bytes, i.e. by code point: a surrogate unit (an astral
// character) sorts above every BMP unit from U+E000. Twins: rubyCasecmp in
// abnf/jsrtruby.go and rbCasecmp in ruby-interpreter.abnf.
function rbCasecmp(a, b) {
    var n = a.length < b.length ? a.length : b.length
    var i = 0
    while (i < n) {
        var x = a.charCodeAt(i)
        var y = b.charCodeAt(i)
        if (x >= 97 && x <= 122) { x = x - 32 }
        if (y >= 97 && y <= 122) { y = y - 32 }
        if (x != y) {
            if (x >= 55296 && x < 57344 && y >= 57344) { return 1 }
            if (y >= 55296 && y < 57344 && x >= 57344) { return 0 - 1 }
            return x < y ? 0 - 1 : 1
        }
        i = i + 1
    }
    if (a.length == b.length) { return 0 }
    return a.length < b.length ? 0 - 1 : 1
}

// The String methods above, as one dispatcher. `sargs` is the argument list with
// every element already rendered as a Ruby String and `nargs` the same list as
// numbers, so this function stays free of any one engine's conversions. Answers
// {ok: false} for a name it does not know, so each engine's own table keeps
// priority and its `unknown String method' abort still happens.
function smMethod(s, name, sargs, nargs) {
    if (name == "bytesize") { return {ok: true, v: smUtf8Bytes(s).length} }
    if (name == "bytes") { return {ok: true, v: smUtf8Bytes(s)} }
    if (name == "getbyte") {
        var bs = smUtf8Bytes(s)
        var gi = Math.trunc(nargs[0])
        if (gi < 0) { gi = gi + bs.length }
        if (gi < 0 || gi >= bs.length) { return {ok: true, v: null} }
        return {ok: true, v: bs[gi]}
    }
    if (name == "sum") {
        var sb = smUtf8Bytes(s)
        var acc = 0
        var si = 0
        while (si < sb.length) { acc = acc + sb[si]; si = si + 1 }
        return {ok: true, v: acc}
    }
    if (name == "codepoints") { return {ok: true, v: smCodePoints(s)} }
    if (name == "tr" || name == "tr!") { return {ok: true, v: smTr(s, sargs[0], sargs[1], false)} }
    if (name == "tr_s" || name == "tr_s!") { return {ok: true, v: smTr(s, sargs[0], sargs[1], true)} }
    if (name == "squeeze" || name == "squeeze!") { return {ok: true, v: smSqueeze(s, sargs)} }
    if (name == "count") { return {ok: true, v: smCount(s, sargs)} }
    if (name == "delete" || name == "delete!") { return {ok: true, v: smDelete(s, sargs)} }
    if (name == "center") { return {ok: true, v: smPad(s, Math.trunc(nargs[0]), sargs.length > 1 ? sargs[1] : " ", 0)} }
    if (name == "ljust") { return {ok: true, v: smPad(s, Math.trunc(nargs[0]), sargs.length > 1 ? sargs[1] : " ", 1)} }
    if (name == "rjust") { return {ok: true, v: smPad(s, Math.trunc(nargs[0]), sargs.length > 1 ? sargs[1] : " ", 2)} }
    if (name == "chop" || name == "chop!") { return {ok: true, v: smChop(s)} }
    if (name == "chomp" || name == "chomp!") {
        if (sargs.length > 0) {
            var suf = sargs[0]
            if (suf.length > 0 && s.length >= suf.length
                && s.substring(s.length - suf.length, s.length) == suf) {
                return {ok: true, v: s.substring(0, s.length - suf.length)}
            }
            return {ok: true, v: s}
        }
        return {ok: true, v: smChomp(s)}
    }
    if (name == "chr") { return {ok: true, v: s.length > 0 ? s.charAt(0) : ""} }
    if (name == "lstrip" || name == "lstrip!") { return {ok: true, v: smLstrip(s)} }
    if (name == "rstrip" || name == "rstrip!") { return {ok: true, v: smRstrip(s)} }
    if (name == "strip!") { return {ok: true, v: smLstrip(smRstrip(s))} }
    if (name == "swapcase" || name == "swapcase!") { return {ok: true, v: smSwapcase(s)} }
    if (name == "lines") { return {ok: true, v: smLines(s)} }
    if (name == "partition" || name == "rpartition") {
        var sep = sargs[0]
        var at = name == "partition" ? s.indexOf(sep) : smRindex(s, sep)
        if (at < 0) {
            if (name == "partition") { return {ok: true, v: [s, "", ""]} }
            return {ok: true, v: ["", "", s]}
        }
        return {ok: true, v: [s.substring(0, at), sep, s.substring(at + sep.length, s.length)]}
    }
    if (name == "delete_prefix" || name == "delete_prefix!") {
        var pf = sargs[0]
        if (pf.length > 0 && s.substring(0, pf.length) == pf) { return {ok: true, v: s.substring(pf.length, s.length)} }
        return {ok: true, v: s}
    }
    if (name == "delete_suffix" || name == "delete_suffix!") {
        var sf = sargs[0]
        if (sf.length > 0 && s.length >= sf.length && s.substring(s.length - sf.length, s.length) == sf) {
            return {ok: true, v: s.substring(0, s.length - sf.length)}
        }
        return {ok: true, v: s}
    }
    if (name == "casecmp") { return {ok: true, v: rbCasecmp(s, sargs[0])} }
    if (name == "casecmp?") { return {ok: true, v: unicodeCase(s, 18) == unicodeCase(sargs[0], 18)} }
    if (name == "rindex") {
        var ri = smRindex(s, sargs[0])
        if (ri < 0) { return {ok: true, v: null} }
        return {ok: true, v: ri}
    }
    if (name == "insert") {
        var at2 = Math.trunc(nargs[0])
        if (at2 < 0) { at2 = at2 + s.length + 1 }
        if (at2 < 0 || at2 > s.length) { return {ok: false, v: null} }
        return {ok: true, v: s.substring(0, at2) + sargs[1] + s.substring(at2, s.length)}
    }
    if (name == "prepend") { return {ok: true, v: sargs[0] + s} }
    if (name == "concat" || name == "<<") {
        var acc2 = s
        var ci = 0
        while (ci < sargs.length) { acc2 = acc2 + sargs[ci]; ci = ci + 1 }
        return {ok: true, v: acc2}
    }
    // #hex and #oct never raise: #to_i(16), and a prefix-detecting #to_i whose
    // default radix is 8.
    if (name == "hex") { return {ok: true, v: rbStrToInum(s, 16, false)["v"]} }
    if (name == "oct") { return {ok: true, v: rbStrToInum(s, 0 - 8, false)["v"]} }
    if (name == "clear") { return {ok: true, v: ""} }
    if (name == "b" || name == "scrub" || name == "unicode_normalize" || name == "force_encoding"
        || name == "encode") {
        return {ok: true, v: s}
    }
    if (name == "unicode_normalized?" || name == "valid_encoding?") { return {ok: true, v: true} }
    if (name == "ascii_only?") {
        var ai = 0
        while (ai < s.length) {
            if (s.charCodeAt(ai) > 127) { return {ok: true, v: false} }
            ai = ai + 1
        }
        return {ok: true, v: true}
    }
    return {ok: false, v: null}
}

// The engine glue for smMethod: render every argument as a Ruby String and as a
// number once, then dispatch. The block-taking members are handled beside it.
function rbStrExtra(target, name, args) {
    var sargs = []
    var nargs = []
    var i = 0
    var pos = rbPosArgs(args)
    while (i < pos.length) {
        sargs.push(rbStr(pos[i]))
        nargs.push(rbToF(pos[i]))
        i = i + 1
    }
    if (nargs.length == 0) { nargs.push(0) }
    // Without a block, each_byte / each_codepoint / each_line / upto answer an
    // Enumerator over what they would yield.
    if (name == "each_byte" || name == "each_codepoint" || name == "each_line" || name == "upto") {
        var blk = rbBlockOf(args)
        var list = []
        if (name == "each_byte") { list = smUtf8Bytes(target) }
        if (name == "each_codepoint") { list = smCodePoints(target) }
        if (name == "each_line") { list = smLines(target) }
        if (name == "upto") { list = smUptoList(target, sargs.length > 0 ? sargs[0] : target, pos.length > 1 && rbTruthy(pos[1])) }
        if (blk === null) { return {ok: true, v: rbEnumAt(rbMkEnum(list), target, name, args)} }
        var k = 0
        while (k < list.length) { rbCall1(blk, rbBoxOut(target, list[k])); k = k + 1 }
        return {ok: true, v: target}
    }
    if (name == "dump") { return {ok: true, v: rbStrInspect(target)} }
    // String#slice! on a plain string answers the REMOVED part; nothing holds the
    // string to see the removal (a held one is a box, see rbStrMutate).
    if (name == "slice!") { return {ok: true, v: rbMethod(target, "slice", args)} }
    var bb = smBangBase(name)
    if (bb != "") {
        var bv = rbMethod(target, bb, args)
        if (typeof bv == "string" && bv == target) { return {ok: true, v: null} }
