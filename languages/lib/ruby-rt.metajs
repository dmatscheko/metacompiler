    if (got === undefined) { return null }
    return got
}

// Object#instance_variables on an instance: its @ivar slots in assignment order
// (keysOf leaves the hidden __ slots out). Twin of rubyIvarNames in
// abnf/jsrtruby.go.
function rbIvarNames(o) {
    var ks = keysOf(o)
