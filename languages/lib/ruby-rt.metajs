// A $global lives outside every scope and reads as nil until first assigned.
function js_rgget(name) {
    var v = rbGlobals["$" + rbStr(name)]
    if (v === undefined) { return null }
    return v
}

function js_rgset(name, v) { return rbGset(rbStr(name), v) }

// defined?($x): the KIND of the name, or nil. The shape of the name decided the
// kind at compile time; this only tests presence.
