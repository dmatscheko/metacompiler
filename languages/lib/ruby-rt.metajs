function rbClassObj(v) { return rbIsObj(v) && v["__isclass"] === true }

// An @ivar write where self is a class object: its instance methods are plain
// keys of the same object, so the @ivar names are recorded in __civn, in
// assignment order. Twin of rubyCivSet in abnf/jsrtruby.go.
function js_rcivset(o, k, v) {
