function rbCall2(f, a, b) { return f.apply(undefined, [a, b]) }
function rbCall3(f, a, b, c) { return f.apply(undefined, [a, b, c]) }

// rubyNumMethod: the Integer / Float / Rational / Complex method set. It answers
// `undefined` for a name it does not know, so the caller carries on with the
// generic dispatch (and its error message).
// ----- Numeric#div / #divmod / #modulo / #rationalize ----------------------
//
// Twin of numDivOp in ruby-interpreter.abnf, which states the rules, and
// rubyNumDivOp in abnf/jsrtruby.go.
function rbNumDivOp(t, name, args) {
    var y = rbArgAt(args, 0)
