// List element (negative wraps) or dict entry assignment.
// js_pyset is SHARED - lib/runtime.metajs (five languages, knobs rtkIsDict and
// rtkDictFind; the index coercion now truncates, which is the oracle).

// len() for strings, lists and dicts. Ruby never reaches the Python set arm.
function js_pylen(v) {
