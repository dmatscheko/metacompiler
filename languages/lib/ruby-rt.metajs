        return ix
    }
    if (name == "rindex") {
        var ri = t.length - 1
        while (ri >= 0) {
            if (rbEq(t[ri], rbPosAt(args, nPos, 0))) { return ri }
            ri = ri - 1
        }
        return null
    }
    // uniq is eql?/hash, NOT ==: `[1, 1.0].uniq` keeps BOTH in MRI, because
    // 1.eql?(1.0) is false across classes. index and include? are ==, which is
    // why they do not share this test.
    if (name == "uniq") {
        var uq = []
        var ui = 0
        while (ui < t.length) {
            var dup = false
            var uj = 0
            while (uj < uq.length) {
                if (rbEql(uq[uj], t[ui])) { dup = true; break }
                uj = uj + 1
            }
            if (!dup) { uq.push(t[ui]) }
            ui = ui + 1
        }
        return uq
    }
    if (name == "to_a") { return rtCopyArr(t) }
    // A blockless each / each_with_index is an Enumerator in MRI, not the array.
    if (name == "each") {
        if (blk === null) { return rbEnumAt(rbMkEnum(rtCopyArr(t)), rbEnumSrc(t), name, args) }
        var e = 0
        while (e < t.length) {
            rbCall1(blk, t[e])
            e = e + 1
        }
        return t
    }
    if (name == "each_with_index") {
        if (blk === null) {
            var wpairs = []
            var wp = 0
            while (wp < t.length) { wpairs.push([t[wp], wp]); wp = wp + 1 }
            return rbEnumAt(rbMkEnum(wpairs), rbEnumSrc(t), name, args)
        }
        var w = 0
        while (w < t.length) {
            rbCall2(blk, t[w], w)
            w = w + 1
        }
        return t
    }
    if (name == "each_index") {
        var ei = 0
        while (ei < t.length) {
            rbCall1(blk, ei)
            ei = ei + 1
        }
        return t
    }
    if (name == "map" || name == "collect") {
        var out = []
        var m = 0
        while (m < t.length) {
            out.push(rbCall1(blk, t[m]))
            m = m + 1
        }
        return out
    }
    if (name == "select" || name == "filter") {
        var sel = []
        var s = 0
        while (s < t.length) {
            if (rbTruthy(rbCall1(blk, t[s]))) { sel.push(t[s]) }
            s = s + 1
        }
        return sel
    }
    if (name == "reject") {
        var rej = []
        var r = 0
        while (r < t.length) {
            if (!rbTruthy(rbCall1(blk, t[r]))) { rej.push(t[r]) }
            r = r + 1
        }
        return rej
    }
    // Ruby's sum is ordinary + from an Integer 0 (or from the given initial value),
    // with the block applied to each element first - not a ToInt32 accumulation:
    // `[1.5, 2.5].sum` is 4.0.
    // MRI's sum starts from an Integer 0 and REFUSES a non-numeric element:
    // `["b","a"].sum` is a TypeError, not "0ba". The refusal is only against a
    // NUMERIC accumulator - `["a","b"].sum("")` is "ab" and `[[1],[2]].sum([])` is
    // [1,2]. A catchable TypeError, since MRI's is rescuable.
    if (name == "sum") {
        var acc = anytype
        acc = nPos > 0 ? args[0] : 0
        var k = 0
        while (k < t.length) {
