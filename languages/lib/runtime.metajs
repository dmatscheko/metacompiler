// runtime.metajs -- the SHARED layer-2 runtime, imported by every *-rt.metajs.
//
// Layer 2 is the per-language runtime written in MetaJS and compiled by
// languages/metajs-to-llvm-ir.abnf with -rt-lib into <lang>-rt.ll, which the
// language's own -exe links next to lib/runtime.ll (the C floor). A body that more
// than one language's layer 2 needs lives here, once.
//
// The former split files runtime-decimal.metajs, runtime-bignum.metajs,
// runtime-jvm.metajs and runtime-dartswift.metajs are sections of this file now
// (the last one at its FOOT); a comment elsewhere naming one of them means the
// section here. Grep this file for the body.
//
// A layer-2 file imports this one (`import "./runtime.metajs"`);
// metajs-to-llvm-ir.abnf resolves the relative path, and -rt-lib's lazy boot runs
// both into the SAME pinned scope. So a definition here is indistinguishable from
// one written in the importing file.
//
// ----- how a language parameterises a shared body ----------------------------
//
// An extern's signature is fixed by the emitter (js_jadd(l, r)), so a shared body
// cannot take a knob object the way lib/interp-core.js's `core` does. Instead it
// calls HOOK functions that the importing file defines, all named rtk*:
//
//     rtkStr(v)   the language's rt.javaString - how `+` renders an operand once
//                 the other side is a string. Every language differs here and
//                 always will; this is the one irreducible knob of js_jadd.
//     rtkNum(v)   the language's rt.toNumber - how an operand becomes a double.
//                 Also irreducible: PHP's raises on an array, Dart's answers NaN
//                 for a non-number, Kotlin's answers 0 for null and NaN for
//                 undefined because kotlin.Unit arrives as undefined.
//
// Top-level function declarations hoist and both files land in one scope, so the
// hook may be defined after the import and in the other file. Every name here is
// prefixed rt / rtk so nothing collides with a language's own helpers.
//
// ----- MetaJS rules that shape the code below --------------------------------
//
// docs/abnf-dialect-gotchas.md: a local keeps the TYPE CLASS it is first assigned;
// there is no ASI, so every `return` carries its value on the same line and a
// value-less early return is BRACED; no for..in, no splice, no split/join,
// array.length is not assignable, and there are no exponent literals.

// ===================================================== int32 ================
//
// Go: isInt32Value (abnf/jsrt.go).
function rtIsInt32(n) {
    if (n !== n) { return false }
    if (Math.trunc(n) !== n) { return false }
    if (n > 2147483647) { return false }
    return n >= 0 - 2147483648
}

// Go: float64(int32(x)), i.e. ToInt32. NaN and the infinities answer 0 (unreachable
// from js_jadd, whose float arm has already taken every non-finite operand).
function rtWrap32(x) {
    if (x !== x) { return 0 }
    if (x == Infinity) { return 0 }
    if (x == 0 - Infinity) { return 0 }
    var m = x - Math.floor(x / 4294967296) * 4294967296
    if (m >= 2147483648) { m = m - 4294967296 }
    return m
}

// ===================================================== js_jadd ==============
//
// EXPORTED DIRECTLY. -rt-lib reads its exported surface off the SOURCE TEXT -
// every line starting in column 0 with `function js_` - because a MetaJS function
// is a value in a scope and its name is not in the IR. The scan covers the imported
// files too (metajs-to-llvm-ir.abnf, the -rt-lib block), so a shared extern is
// written here under its real name and needs no forwarder. Only
// tests/clang-check.sh sees an export that fails to link; the matrix and --cross
// run under llvm.Run and are blind to it.
//
// Go: js_jadd (abnf/jsrt.go). Java/C# `+`: string concat when either side is
// a string, a 32 bit wrapping add when both sides are int32-valued, a boxed
// double when either side is one, a plain double add otherwise.
//
// Knobs: rtkStr (how `+` renders an operand: java renders an array as `[I@1b6d3586`,
// kotlin a Char as its character, ruby nil as "null") and rtkNum (dart answers NaN
// for a non-number where csharp answers 0; kotlin answers 0 for null and NaN for
// undefined, since kotlin.Unit arrives as undefined; php raises on an array).
//
// The float arm is the floor's rt.jvmArith spelled out: abnf/jsrtjvm.go answers
// `jsJFlo{f: rt.toNumber(l)+rt.toNumber(r), sty: jvmStyleOf(l, r)}` whenever either
// side is a box. php, python and ruby never reach it (their emitters use js_jadd only
// on internal counters or with a string seed); it is right for them anyway.
//
// Known gap: csNum's fallback answers 0 where the Go twin's rt.toNumber answers NaN
// for an object, an array or undefined. No C# program this tree compiles can put a
// bare object on the double path, and the fix belongs in csharp-rt.metajs.
function js_jadd(l, r) {
    if (typeof l == "string" || typeof r == "string") { return rtkStr(l) + rtkStr(r) }
    if (floIs(l) || floIs(r)) { return flo(rtkNum(l) + rtkNum(r), floStyle(floIs(l) ? l : r)) }
    var ln = rtkNum(l)
    var rn = rtkNum(r)
    if (rtIsInt32(ln) && rtIsInt32(rn)) { return rtWrap32(ln + rn) }
    return ln + rn
}

// ===================================================== js_is_type ===========
//
// Exported directly, for the reason recorded at js_jadd.
//
// Go: js_is_type -> rt.isTypeName (abnf/jsrt.go). `x is T` / `x as? T`:
// strip a generic argument list and a trailing `?`, answer the nullable flag for
// a null, then a fixed table of well-known type names, then walk __class/__super.
//
// Shared by csharp, java, kotlin, python, ruby and swift. Knobs: rtkIsChar (only
// csharp, java and kotlin have a boxed Char) and rtkIsArr (swift's arrays are
// OBJECTS carrying a length). The numeric test is the strict rtIsPlainNum, matching
// the oracle's `v.(float64)`.
//
// DIVERGENCE FROM THE ORACLE, kept deliberately: the __class/__super walk is capped
// at 64 steps where jsrt.go loops until the chain ends. The oracle HANGS on a cyclic
// __super and the cap answers false; none of the six languages can express a
// 65-deep hierarchy in a program this tree compiles.
//
// go and dart keep their own js_is_type: go's does not strip `<` or `?`, answers
// false for a null and has no numeric/Char arms; dart's is dtTypeName(v, t).
function js_is_type(v, t) {
    var nm = t
    var lt = nm.indexOf("<")
    if (lt >= 0) { nm = nm.substring(0, lt) }
    var opt = false
    if (nm.length > 0 && nm.charAt(nm.length - 1) == "?") {
        nm = nm.substring(0, nm.length - 1)
        opt = true
    }
    if (v === undefined) { return opt }
    if (v === null) { return opt }
    // Kotlin's Char is its own type: `c is Char` holds, `c is Int` does not.
    // Tested before the name switch, exactly as jsrt.go does.
    if (rtkIsChar(v)) {
        if (nm == "Char") { return true }
        if (nm == "Character") { return true }
        if (nm == "Any") { return true }
        return nm == "Comparable"
    }
    if (nm == "Any" || nm == "Object") { return true }
    var plain = rtIsPlainNum(v)
    if (nm == "Int" || nm == "Integer" || nm == "Long" || nm == "Short" || nm == "Byte" || nm == "Char" || nm == "Character") {
        if (!plain) { return false }
        return Math.trunc(v) == v
    }
    if (nm == "Double" || nm == "Float" || nm == "Number") { return plain }
    if (nm == "String" || nm == "CharSequence") { return typeof v == "string" }
    if (nm == "Boolean") { return typeof v == "boolean" }
    if (nm == "List" || nm == "MutableList" || nm == "Collection" || nm == "Array") {
        if (rtkIsArr(v)) { return true }
    }
    if (typeof v != "object") { return false }
    return rtClassIs(v["__class"], nm, 0)
}

// Go: classIsNamed. The __super walk, plus every descriptor in each step's
// __ifaces list; `guard` carries the 64-step cap through the recursion.
function rtClassIs(cls0, nm, guard0) {
    var cls = cls0
    var guard = guard0
    while (guard < 64) {
        guard = guard + 1
        if (cls === undefined) { return false }
        if (cls === null) { return false }
        if (typeof cls != "object") { return false }
        if (cls["__name"] === nm) { return true }
        var ifs = cls["__ifaces"]
        if (ifs !== undefined && ifs !== null && typeof ifs == "object") {
            for (var i = 0; i < ifs.length; i++) {
                if (rtClassIs(ifs[i], nm, guard)) { return true }
            }
        }
        cls = cls["__super"]
    }
    return false
}

// The oracle's `v.(float64)`: an ordinary double, which a SIZED INTEGER (tag 13)
// and a BOXED DOUBLE (tag 14) are not, even though `typeof` calls both "number".
function rtIsPlainNum(v) {
    if (typeof v != "number") { return false }
    if (sintIs(v)) { return false }
    return !floIs(v)
}

// ===================================================== js_dict_new ==========
//
// Go: js_dict_new (abnf/jsrt.go). The empty dict / map / Map / Dictionary
// every language builds: a marked object with two PARALLEL, INSERTION-ORDERED
// arrays. The order is the observable part - Python 3.7+, Ruby, Dart's Map, C#'s
// Dictionary and Swift's ordered rendering all depend on it - which is why this
// is not a JS object with real properties.
function js_dict_new() { return {__dict: true, keys: [], vals: []} }

// ===================================================== the object test ======
//
// "not null, not undefined, and typeof object". rbIsObj and pyIsObj also reject
// arrays; that test is not needed here, because every caller walks __class /
// __super and an array carries neither. rt (shared) rather than rtk (knob): there
// is no language for which this is a different question.
function rtIsObj(v) {
    if (v === undefined) { return false }
    if (v === null) { return false }
    return typeof v == "object"
}

// The receiver-prepend every dispatcher does before `apply`. A null/undefined
// `args` answers just [v].
function rtPrepend(v, args) {
    var out = []
    out.push(v)
    if (args === undefined) { return out }
    if (args === null) { return out }
    var i = 0
    while (i < args.length) {
        out.push(args[i])
        i = i + 1
    }
    return out
}

// ===================================================== the Char box =========
//
// Go: jsChar (abnf/jsrt.go). C#'s char, Java's char and Kotlin's Char are a
// type of their own - `c is Char` holds where `c is Int` does not, and `'a' + 1`
// is an Int while `"" + 'a'` is "a" - so those three languages box one. Nothing but
// rtCharBox ever writes __char, and it writes a number.
//
// Dart, Go, PHP, Python, Ruby and Swift have no Char in their value model at all;
// their rtkIsChar answers a constant false and they never call rtCharBox.
function rtCharBox(code) {
    var o = {}
    o["__char"] = code
    return o
}

function rtIsCharBox(v) {
    if (!rtIsObj(v)) { return false }
    return typeof v["__char"] == "number"
}

// ===================================================== js_char ==============
//
// Go: `js_char` (abnf/jsrt.go) is `jsChar{code: int32(a[0])}`.
//
// The parameter keeps its `_raw` suffix, which is not cosmetic: -rt-lib reads the
// signature off this source line and a name ending in _raw marks the argument as
// an UNBOXED integer, so renaming it would hand the boxer a value handle.
//
// swift keeps its own js_char (it has no Char box: a Character is a String, so it
// converts a code POINT to UTF-16, with a surrogate pair above 0xFFFF); a layer-2
// file's own definition wins because its top level runs after its imports.
//
// The oracle truncates the code to int32 and this does not. Unreachable: every
// emitter feeds js_char a character literal's code or a range-checked `Char(i)`.
function js_char(code_raw) { return rtCharBox(code_raw) }

// ===================================================== js_char_code =========
//
// Go: `js_char_code` (abnf/jsrt.go) is `rt.wrapNum(rt.toNumber(v))`, so this is
// rtkNum, each language's rt.toNumber (which unboxes a Char first). swift keeps its
// own: it has no Char box and reads a string's first code unit.
function js_char_code(v) { return rtkNum(v) }

// ===================================================== js_supercall =========
//
// Go: js_supercall (abnf/jsrt.go). `super.m(...)`: walk __super from the
// class the caller already resolved, and call the first callable found with the
// receiver PREPENDED to the argument list.
//
// Shared by csharp, java, kotlin and ruby. Knob: rtkCall, the call itself. Most
// languages spell it `m.apply(undefined, argv)` - `this` deliberately undefined
// because the receiver travels as argv[0]; kotlin's k4bCallAcc sets the k4bThis
// global around the call, which is how an accessor declared in a superclass sees
// its receiver.
//
// The walk is capped at 64 (rtFindMethod), the same deliberate divergence from the
// oracle as js_is_type. js keeps its own js_supercall: a JavaScript `class A
// extends B` chain of 65 IS constructible, and its emitter can hand js_supercall a
// computed name.
function js_supercall(sup, self, name, args) {
    var m = rtFindMethod(sup, name)
    if (typeof m == "function") { return rtkCall(m, self, rtPrepend(self, args)) }
    fail("unknown super method '" + name + "'")
    return undefined
}

// ===================================================== the method walk ======
//
// The __class / __super walk that resolves a method name to a callable, or to
// undefined. It is what js_supercall above IS, and it is also the tail of
// js_mcall in csharp, java, php and swift.
//
// js_mcall itself is per language: the String and container arms differ in method
// set and container model, dart delegates to dtMember, and lua binds the receiver
// as `self` rather than prepending it.
//
// The 64-step cap is the one argued at js_is_type.
function rtFindMethod(cls, name) {
    var c = cls
    var guard = 0
    while (guard < 64) {
        guard = guard + 1
        if (!rtIsObj(c)) { return undefined }
        var m = c[name]
        if (typeof m == "function") { return m }
        c = c["__super"]
    }
    return undefined
}

// ===================================================== the dict shape ======
//
// A dict / Map / Dictionary / Hash / Go map is js_dict_new's object: __dict, and
// two parallel insertion-ordered arrays. No language here puts a __dict on
// something that is NOT a dict.
function rtIsDictObj(v) {
    if (!rtIsObj(v)) { return false }
    if (v["__dict"] !== true) { return false }
    if (!rtkIsArr(v["keys"])) { return false }
    return rtkIsArr(v["vals"])
}

// Key lookup by `===`. In layer 2 `===` is NOT JavaScript identity: it lowers to
// the floor's strict_eq (lib/runtime.c), which compares a BOXED DOUBLE (tag 14) and
// a SIZED INTEGER (tag 13) BY VALUE, in the Go twin's own arm order. rt.strictEq
// (abnf/jsrt.go) is that same function, and rt.dictFind is what the oracle's
// js_pyset finds keys with. So this bare scan IS the oracle.
//
// rtkDictFind is the knob: csharp's adds a first arm unboxing a {__char} through
// js_jchareq, because a Char box is an ordinary object to strict_eq and a C#
// `Dictionary<char, V>` would otherwise miss every key (the oracle unboxes it too).
// The languages without a Char use this scan as it is.
function rtDictFind(keys, k) {
    var i = 0
    while (i < keys.length) {
        if (keys[i] === k) { return i }
        i = i + 1
    }
    return 0 - 1
}

// ===================================================== js_pyset =============
//
// Go: js_pyset (abnf/jsrt.go). `c[k] = v` for a list (a negative index wraps)
// or a dict (find, else append to the parallel arrays). Shared by csharp, dart, go,
// ruby and swift; knobs rtkIsDict and rtkDictFind (see rtDictFind).
//
// The index truncates toward zero, as the oracle's `int(rt.toNumber(...))` does.
//
// python keeps its own js_pyset for its __setitem__ dunder arm (the oracle has it
// too). Python's bool/number key aliasing (`d[True]` and `d[1]` are one entry) is
// also python's alone: pyKeyAlias in languages/lib/python-rt.metajs, in abnf/jsrt.go
// and in python-interpreter.abnf's core.keyEq - not here and not in strict_eq.
function js_pyset(c, k, v) {
    if (rtkIsDict(c)) {
        var keys = c["keys"]
        var i = rtkDictFind(keys, k)
        if (i >= 0) { c["vals"][i] = v } else {
            keys.push(k)
            c["vals"].push(v)
        }
        return undefined
    }
    if (!rtkIsArr(c)) { fail("item assignment on a " + typeof c) }
    var idx = Math.trunc(rtkNum(k))
    if (idx < 0) { idx = idx + c.length }
    if (idx < 0 || idx >= c.length) { fail("list assignment index out of range") }
    c[idx] = v
    return undefined
}

// ============================================ the relational comparison ====
//
// Go: rt.jsCompare (abnf/jsrt.go), the body behind `<`, `<=`, `>`, `>=`
// for every operand pair the language's own number tags do not cover. Used by
// java, csharp, dart and swift; js-rt.metajs has its own (jvCmpPrim) because it
// does not import this file.
//
// A NaN on either side answers the SENTINEL 2, meaning "every relation is false"
// (JLS 15.20.1, ECMA-334 12.12.1). It is NOT 0: a caller spelling `c <= 0` would
// then make `<=` and `>=` true for a NaN. The CALLER translates the sentinel -
// java, csharp and dart's js_dart{lt,le,gt,ge} turn it into false, swift's swRel
// into its own NaN marker - so swMinMax can still use this body for an ordering.
// Twin: abnf/jsrtjava.go takes the same three lines.
//
// The oracle's `rt.hasBigInt` arm is not carried: none of these languages turns
// hasBigInt on in this path.
function rtCompare(l, r) {
    if (typeof l == "string" && typeof r == "string") {
        if (l < r) { return 0 - 1 }
        if (l > r) { return 1 }
        return 0
    }
    var a = rtkNum(l)
    var b = rtkNum(r)
    if (a !== a) { return 2 }
    if (b !== b) { return 2 }
    if (a < b) { return 0 - 1 }
    if (a > b) { return 1 }
    return 0
}

// ============================================ the clamped substring ========
//
// Go: rt.jpSubstring / rt.csSubstring. java's String.substring and C#'s
// String.Substring both THROW on an out-of-range index; both grammars clamp
// instead, so the shared body is the clamp.
function rtSubstring(s, b, e) {
    var begin = b
    var end = e
    if (begin < 0) { begin = 0 }
    if (end > s.length) { end = s.length }
    if (end < begin) { end = begin }
    return s.substring(begin, end)
}

// ============================================ small shared helpers ==========

// A fresh copy of an array - Go's `append([]interface{}{}, xs...)`. There is no
// Array.prototype.slice in this dialect, so everyone wrote the loop.
//
function rtCopyArr(a) {
    var out = []
    var i = 0
    while (i < a.length) {
        out.push(a[i])
        i = i + 1
    }
    return out
}

// Membership in an array, by the floor's strict equality.
//
// rtDictFind is the same scan returning the index: `===` in layer 2 is the floor's
// strict_eq, so identity membership and dict-key lookup ARE one question.
function rtHas(a, v) { return rtDictFind(a, v) >= 0 }

// The identity-keyed SIDE TABLE lookup: two parallel arrays scanned with `===`,
// answering vals[i] or undefined. MetaJS has no map keyed by a function value,
// so every language that has to remember something ABOUT a closure builds this.
//
// Twin: js-rt.metajs's jvCtorDescOf, which keeps its own copy because js-rt.metajs
// does not import this file.
function rtPairGet(keys, vals, k) {
    var i = rtDictFind(keys, k)
    if (i < 0) { return undefined }
    return vals[i]
}

// An operand of INTEGER arithmetic: a Char box is one - it is an integral type
// in C#, Java and Kotlin - and a boxed double is not. Both a sized integer
// (tag 13) and a boxed double (tag 14) answer `typeof v == "number"` in the C
// floor, which is why the tag 14 test is explicit.
//
function rtIsIntegral(v) {
    if (rtIsCharBox(v)) { return true }
    if (typeof v != "number") { return false }
    return !floIs(v)
}

// The number of CODE POINTS in a string - Go's len([]rune(s)) - so a surrogate
// pair counts once. The value model is UTF-16 code units throughout layer 2 (see
// docs/abnf-dialect-gotchas.md), so this walk is the only way to ask.
function rtRuneLen(s) {
    var n = 0
    var i = 0
    while (i < s.length) {
        var c = s.charCodeAt(i)
        if (c >= 55296 && c <= 56319 && i + 1 < s.length) {
            var d = s.charCodeAt(i + 1)
            if (d >= 56320 && d <= 57343) { i = i + 1 }
        }
        n = n + 1
        i = i + 1
    }
    return n
}

// A run of n "0"s.
function rtZeros(n) {
    var out = ""
    var i = 0
    while (i < n) {
        out = out + "0"
        i = i + 1
    }
    return out
}

// A run of n copies of s.
//
// rtZeros above is deliberately NOT re-expressed as rtRepeat("0", n): it is called
// directly by php's float formatter, and a delegation would add a call frame.
function rtRepeat(s, n) {
    var out = ""
    var i = 0
    while (i < n) {
        out = out + s
        i = i + 1
    }
    return out
}

// null OR undefined. Hot: pyDTruthy's first test sits on the loop condition of
// every `while` python emits.
function rtIsNil(v) {
    if (v === null) { return true }
    return v === undefined
}

// "is this an object carrying tag `name` set to true" - the __dict / __set /
// __cplx / __sym / __flo / __rat / __rrange / __bint / __pybig / __pysup test
// every value model here is built out of.
//
// The object test is INLINED on purpose: this is the hottest predicate in python's
// and ruby's layer 2 (js_pybin reaches it several times per operator), and
// delegating to rtIsObj adds a scope frame per call, which is measurably slower.
// Ordered null, undefined, typeof, array, as pyIsObj and rbIsObj are.
function rtTag(v, name) {
    if (v === null) { return false }
    if (v === undefined) { return false }
    if (typeof v != "object") { return false }
    if (Array.isArray(v)) { return false }
    return v[name] === true
}

// ====================================== the former split modules =========
//
// The sections below were once separate files (runtime-bignum.metajs,
// runtime-decimal.metajs, runtime-jvm.metajs, runtime-dartswift.metajs). A
// top-level declaration that an importer never calls costs it nothing at run time
// (scope_find's hash index in languages/lib/runtime.c), so they live here.
//
// THE HOOK CONTRACT: rtkFloDigits (rtFloStr's knob) and rtjkCmp / rtjkFloOperand
// (rtjStrictEq / rtjRel / rtjArith's) are defined only by the languages that call
// those bodies. A layer-2 call is a SCOPE LOOKUP BY NAME - the emitted module
// carries the string "rtkFloDigits", not a relocation - so a module that never calls
// rtFloStr never resolves it and nothing breaks at link time or at boot. An importer
// that CALLS one of these bodies without defining its hooks gets a runtime
// "variable not defined", not a link error.

// ---------------------------------------------------------------------------
// the exact decimal bignum -- the EXACT decimal expansion of a double, and
// strconv.FormatInt, used by python and ruby alone.
// ---------------------------------------------------------------------------

function rtDigitAt(s, i) {
    var c = s.charCodeAt(i)
    if (c < 48 || c > 57) { return 0 - 1 }
    return c - 48
}

// ----- EXACT decimal expansion of a double ---------------------------------
//
// strconv.FormatFloat prints the EXACT value of the double and rounds HALF TO
// EVEN, which the naive `Math.floor(a * 10^prec + 0.5)` gets wrong twice over:
// it rounds half AWAY from zero (Go's %.0f of 2.5 is "2", not "3") and it loses
// every digit past 2^53 ("%f" of 1e100 has to print all 101 of them).
//
// A finite double is m * 2^e with m an integer below 2^53, so its exact decimal
// is a bignum: for e >= 0 it is m doubled e times, and for e < 0 it is m
// multiplied by 5 exactly -e times with the point placed -e digits from the
// right (because 2^-e == 5^-e / 10^-e). The bignum is a little-endian array of
// base-10000 limbs; multiplying by 2 or by 5 keeps every intermediate under
// 50000 + 10000, which a double holds exactly.

function rtBigFromNum(n) {
    var limbs = []
    var x = n
    while (x > 0) {
        var q = Math.floor(x / 10000)
        limbs.push(x - q * 10000)
        x = q
    }
    if (limbs.length == 0) { limbs.push(0) }
    return limbs
}

function rtBigMulSmall(limbs, k) {
    var carry = 0
    var i = 0
    while (i < limbs.length) {
        var v = limbs[i] * k + carry
        carry = Math.floor(v / 10000)
        limbs[i] = v - carry * 10000
        i = i + 1
    }
    while (carry > 0) {
        var c2 = Math.floor(carry / 10000)
        limbs.push(carry - c2 * 10000)
        carry = c2
    }
    return limbs
}

function rtBigStr(limbs) {
    var out = "" + limbs[limbs.length - 1]
    var i = limbs.length - 2
    while (i >= 0) {
        var s = "" + limbs[i]
        while (s.length < 4) { s = "0" + s }
        out = out + s
        i = i - 1
    }
    return out
}

// ================================ Integer at ARBITRARY PRECISION (python, ruby) ===
//
// A big is {neg: <bool>, limbs: [...]}: the magnitude a LITTLE-ENDIAN array of
// base-10000 limbs (the representation of rtBigFromNum above) plus the sign.
// Zero is canonical, limbs == [0] and neg == false. Every limb product stays
// below 1e8, which a double holds exactly. A language tags its own box, so the
// one hook is the constructor:
//
//     rtkABigNew(neg, limbs)   normalise limbs and build the language's box
//
// Schoolbook multiplication, and division by a per-limb binary search for the
// quotient digit; the operands are integer literals and their results, so this
// is small and exact rather than fast.

var RT_BIT_AND = 0
var RT_BIT_OR = 1
var RT_BIT_XOR = 2
var RT_BIT_ANDNOT = 3

function rtABigNorm(limbs) {
    var out = limbs
    while (out.length > 1 && out[out.length - 1] == 0) { out.pop() }
    if (out.length == 0) { out.push(0) }
    return out
}

function rtABigIsZero(v) {
    var ls = v["limbs"]
    return ls.length == 1 && ls[0] == 0
}

// |a| <=> |b| over two NORMALIZED limb arrays.
function rtABigCmpMag(a, b) {
    if (a.length != b.length) { return a.length < b.length ? -1 : 1 }
    var i = a.length - 1
    while (i >= 0) {
        if (a[i] != b[i]) { return a[i] < b[i] ? -1 : 1 }
        i = i - 1
    }
    return 0
}

// The signed comparison - Go's big.Int.Cmp.
function rtABigCmp(x, y) {
    if (x["neg"] != y["neg"]) { return x["neg"] ? -1 : 1 }
    var c = rtABigCmpMag(x["limbs"], y["limbs"])
    if (x["neg"]) { return -c }
    return c
}

function rtABigAddMag(a, b) {
    var out = []
    var carry = 0
    var n = a.length
    if (b.length > n) { n = b.length }
    var i = 0
    while (i < n) {
        var av = i < a.length ? a[i] : 0
        var bv = i < b.length ? b[i] : 0
        var s = av + bv + carry
        if (s >= 10000) {
            carry = 1
            s = s - 10000
        } else {
            carry = 0
        }
        out.push(s)
        i = i + 1
    }
    if (carry > 0) { out.push(carry) }
    return out
}

// |a| - |b|, and the caller guarantees |a| >= |b|.
function rtABigSubMag(a, b) {
    var out = []
    var borrow = 0
    var i = 0
    while (i < a.length) {
        var bv = i < b.length ? b[i] : 0
        var s = a[i] - bv - borrow
        if (s < 0) {
            s = s + 10000
            borrow = 1
        } else {
            borrow = 0
        }
        out.push(s)
        i = i + 1
    }
    return rtABigNorm(out)
}

// A magnitude times a single limb (0..9999), as a FRESH array: the division
// below needs the multiplicand left alone, unlike the in-place rtBigMulSmall.
function rtABigMulSmall(limbs, k) {
    var out = []
    var carry = 0
    var i = 0
    while (i < limbs.length) {
        var v = limbs[i] * k + carry
        carry = Math.floor(v / 10000)
        out.push(v - carry * 10000)
        i = i + 1
    }
    while (carry > 0) {
        var c2 = Math.floor(carry / 10000)
        out.push(carry - c2 * 10000)
        carry = c2
    }
    return rtABigNorm(out)
}

function rtABigNeg(x) {
    var ls = []
    var i = 0
    while (i < x["limbs"].length) {
        ls.push(x["limbs"][i])
        i = i + 1
    }
    return rtkABigNew(!x["neg"], ls)
}

function rtABigAdd(x, y) {
    if (x["neg"] == y["neg"]) { return rtkABigNew(x["neg"], rtABigAddMag(x["limbs"], y["limbs"])) }
    var c = rtABigCmpMag(x["limbs"], y["limbs"])
    if (c == 0) { return rtkABigNew(false, [0]) }
    if (c > 0) { return rtkABigNew(x["neg"], rtABigSubMag(x["limbs"], y["limbs"])) }
    return rtkABigNew(y["neg"], rtABigSubMag(y["limbs"], x["limbs"]))
}

function rtABigSub(x, y) { return rtABigAdd(x, rtABigNeg(y)) }

function rtABigMul(x, y) {
    var a = x["limbs"]
    var b = y["limbs"]
    var out = []
    var z = 0
    while (z < a.length + b.length) {
        out.push(0)
        z = z + 1
    }
    var i = 0
    while (i < a.length) {
        var carry = 0
        var j = 0
        while (j < b.length) {
            var cur = out[i + j] + a[i] * b[j] + carry
            carry = Math.floor(cur / 10000)
            out[i + j] = cur - carry * 10000
            j = j + 1
        }
        var k = i + b.length
        while (carry > 0) {
            var cur2 = out[k] + carry
            carry = Math.floor(cur2 / 10000)
            out[k] = cur2 - carry * 10000
            k = k + 1
        }
        i = i + 1
    }
    return rtkABigNew(x["neg"] != y["neg"], rtABigNorm(out))
}

// |a| divided by |b| -> {q, r}, both NORMALIZED limb arrays. Schoolbook long
// division a limb at a time; the quotient limb is found by binary search over
// 0..9999 because there is no wide-multiply primitive to estimate it with.
// The caller has already rejected a zero divisor.
function rtABigDivMag(a, b) {
    var qms = []
    var rem = [0]
    var i = a.length - 1
    while (i >= 0) {
        // rem = rem * 10000 + a[i], which in little-endian is a PREPENDED limb.
        var shifted = [a[i]]
        if (!(rem.length == 1 && rem[0] == 0)) {
            var t = 0
            while (t < rem.length) {
                shifted.push(rem[t])
                t = t + 1
            }
        }
        rem = rtABigNorm(shifted)
        var lo = 0
        var hi = 9999
        var d = 0
        while (lo <= hi) {
            var mid = Math.floor((lo + hi) / 2)
            if (rtABigCmpMag(rtABigMulSmall(b, mid), rem) <= 0) {
                d = mid
                lo = mid + 1
            } else {
                hi = mid - 1
            }
        }
        qms.push(d)
        rem = rtABigSubMag(rem, rtABigMulSmall(b, d))
        i = i - 1
    }
    // qms came out most-significant first; the representation is little-endian.
    var q = []
    var m = qms.length - 1
    while (m >= 0) {
        q.push(qms[m])
        m = m - 1
    }
    return {q: rtABigNorm(q), r: rtABigNorm(rem)}
}

// An INTEGRAL, FINITE double as an exact bignum - Go's big.NewFloat(f).Int(nil).
// An integral double above 2^53 is a multiple of 2, so halving it down to a 53
// bit mantissa and doubling the bignum back up loses nothing (the same argument
// rtExactDec makes).
function rtABigFromNum(n) {
    var neg = n < 0
    var m = Math.abs(n)
    var e = 0
    while (m > 9007199254740992) {
        m = m / 2
        e = e + 1
    }
    var limbs = []
    var x = m
    while (x > 0) {
        var q = Math.floor(x / 10000)
        limbs.push(x - q * 10000)
        x = q
    }
    if (limbs.length == 0) { limbs.push(0) }
    var ls = limbs
    var k = 0
    while (k < e) {
        ls = rtABigMulSmall(ls, 2)
        k = k + 1
    }
    return rtkABigNew(neg, ls)
}

// Go: rt.pyBigNarrow / rt.rubyBigNarrow, and the interpreter grammars' bigOut. A
// big that still fits in the exactly representable range comes back as a plain
// number, so only the values that GENUINELY need arbitrary precision stay boxed.
// The reconstruction can ROUND when the true value is past 2^53, so the answer is
// checked by rebuilding the limbs from it - rtABigFromNum is exact, so a mismatch
// means the double is not the value.
function rtABigNarrow(x) {
    var limbs = x["limbs"]
    if (limbs.length > 4) { return x }
    var v = 0
    var i = limbs.length - 1
    while (i >= 0) {
        v = v * 10000 + limbs[i]
        i = i - 1
    }
    if (v > 9007199254740992) { return x }
    if (rtABigCmpMag(rtABigFromNum(v)["limbs"], limbs) != 0) { return x }
    if (x["neg"]) { return 0 - v }
    return v
}

// Go: big.Int.Exp with a nil modulus, and the interpreter grammars' bigPow. The
// exponent is capped by the caller, so the linear loop is what the other engines
// use too.
function rtABigPow(x, n) {
    var acc = rtABigFromNum(1)
    var i = 0
    while (i < n) {
        acc = rtABigMul(acc, x)
        i = i + 1
    }
    return acc
}

// Go: big.Int.String().
function rtABigStr(v) {
    var out = rtBigStr(v["limbs"])
    if (v["neg"]) { return "-" + out }
    return out
}

// ----- the bit view the bitwise operators work on --------------------------
//
// A non-negative magnitude as a LITTLE-ENDIAN array of single bits; each
// language maps a negative operand onto these through its own infinite
// two's complement identities. rtABitsTrim drops high zero bits IN PLACE.
function rtABitsTrim(bits) {
    while (bits.length > 0 && bits[bits.length - 1] == 0) { bits.pop() }
    return bits
}

function rtABitsOp(kind, a, b) {
    var n = a.length
    if (b.length > n) { n = b.length }
    var out = []
    var i = 0
    while (i < n) {
        var x = i < a.length ? a[i] : 0
        var y = i < b.length ? b[i] : 0
        var r = 0
        if (kind == RT_BIT_AND) {
            if (x == 1 && y == 1) { r = 1 }
        } else if (kind == RT_BIT_OR) {
            if (x == 1 || y == 1) { r = 1 }
        } else if (kind == RT_BIT_XOR) {
            if (x != y) { r = 1 }
        } else {
            if (x == 1 && y == 0) { r = 1 }
        }
        out.push(r)
        i = i + 1
    }
    return rtABitsTrim(out)
}

function rtABitsShl(bits, k) {
    if (bits.length == 0) { return [] }
    var out = []
    var i = 0
    while (i < k) {
        out.push(0)
        i = i + 1
    }
    var j = 0
    while (j < bits.length) {
        out.push(bits[j])
        j = j + 1
    }
    return out
}

function rtABitsShr(bits, k) {
    var out = []
    var i = k
    while (i < bits.length) {
        out.push(bits[i])
        i = i + 1
    }
    return rtABitsTrim(out)
}

// The exact decimal of |x| as {i: <integer digits>, f: <fraction digits>}.
function rtExactDec(a) {
    if (a == 0) { return {i: "0", f: ""} }
    var m = a
    var e = 0
    // Down to an integer mantissa. Every step is exact, and a subnormal needs at
    // most 1074 of them.
    while (m != Math.floor(m)) {
        m = m * 2
        e = e - 1
    }
    // And back under 2^53, which only an already-integral value can be above.
    while (m > 9007199254740992) {
        m = m / 2
        e = e + 1
    }
    var limbs = rtBigFromNum(m)
    if (e >= 0) {
        var k = 0
        while (k < e) {
            rtBigMulSmall(limbs, 2)
            k = k + 1
        }
        return {i: rtBigStr(limbs), f: ""}
    }
    var n = 0 - e
    var j = 0
    while (j < n) {
        rtBigMulSmall(limbs, 5)
        j = j + 1
    }
    var all = rtBigStr(limbs)
    while (all.length <= n) { all = "0" + all }
    return {i: all.substring(0, all.length - n), f: all.substring(all.length - n, all.length)}
}

// Round the digit string `digits` (an integer written out) to `keep` digits,
// half to EVEN, and answer the kept digits - one longer when the rounding
// carried all the way (999 -> 1000), which the caller detects by the length.
function rtRoundHalfEven(digits, keep) {
    if (keep >= digits.length) {
        var out = digits
        while (out.length < keep) { out = out + "0" }
        return out
    }
    var head = digits.substring(0, keep)
    var d = digits.charCodeAt(keep) - 48
    var up = false
    if (d > 5) { up = true }
    if (d == 5) {
        var rest = false
        var i = keep + 1
        while (i < digits.length) {
            if (digits.charAt(i) != "0") {
                rest = true
                break
            }
            i = i + 1
        }
        if (rest) { up = true } else if (keep > 0) {
            var last = head.charCodeAt(keep - 1) - 48
            up = last - Math.floor(last / 2) * 2 == 1
        }
    }
    if (!up) {
        if (head == "") { return "0" }
        return head
    }
    // Propagate the carry through the kept digits.
    var codes = []
    var k = 0
    while (k < head.length) {
        codes.push(head.charCodeAt(k) - 48)
        k = k + 1
    }
    var at = codes.length - 1
    var carry = 1
    while (at >= 0 && carry == 1) {
        var v = codes[at] + 1
        if (v == 10) {
            codes[at] = 0
        } else {
            codes[at] = v
            carry = 0
        }
        at = at - 1
    }
    var res = ""
    var q = 0
    while (q < codes.length) {
        res = res + ("" + codes[q])
        q = q + 1
    }
    if (carry == 1) { res = "1" + res }
    return res
}

// strconv.FormatFloat(v, 'f', prec, 64), exactly: the true decimal of the double,
// cut to prec fraction digits with half-to-even rounding.
function rtFixed(x, prec) {
    if (x !== x) { return "NaN" }
    if (x - x !== 0) {
        if (x > 0) { return "+Inf" }
        return "-Inf"
    }
    // The sign of a zero has to be READ rather than compared: -0.0 < 0 is false
    // and Go prints "-0.000000". 1 / -0.0 is the only test that sees it.
    var neg = x < 0
    if (x == 0 && 1 / x < 0) { neg = true }
    var a = neg ? -x : x
    var dec = rtExactDec(a)
    var ip = dec["i"]
    var fp = dec["f"]
    var joined = ip + fp
    var kept = rtRoundHalfEven(joined, ip.length + prec)
    // A carry out of the leading digit lengthens the integer part by one.
    var ilen = ip.length
    if (kept.length > ip.length + prec) { ilen = ilen + 1 }
    var ints = kept.substring(0, ilen)
    var fracs = kept.substring(ilen, kept.length)
    if (ints == "") { ints = "0" }
    var body = ints
    if (prec > 0) { body = ints + "." + fracs }
    return (neg ? "-" : "") + body
}

// ----- strconv.FormatInt(int64(x), base) ------------------------------------
//
// Two things a naive loop gets wrong: the digit alphabet is 36
// long and not 16 (to_s(36) of 100 is "2s"), and Go converts through int64,
// which SATURATES on arm64 - `int64(1e100)` is 0x7fffffffffffffff and its hex is
// "7fffffffffffffff", not the 84 digits a float loop produces. The digits are
// taken with the floor's sized-integer tag (tag 13), which is exact int64
// arithmetic, on the UNSIGNED reading of the magnitude - the one shape whose
// negation is exact for int64's minimum too, which is the trick java-rt.metajs
// records.
//
// Python's own callers always hand this an int32 (pyFormatBody converts with
// rt.toInt32 first), so the saturating branches are unreachable from
// js_pyformat; they are kept because Ruby's Integer#to_s(base) does reach them.
var RT_DIGITS = "0123456789abcdefghijklmnopqrstuvwxyz"

function rtBaseStr(n, base) {
    var v = Math.trunc(n)
    if (v !== v) { v = 0 }
    if (v == 0) { return "0" }
    var neg = false
    var mag = sintRaw(0, 0, 64, true)
    if (v >= 9223372036854775808) {
        mag = sintRaw(2147483647, 4294967295, 64, true)   // int64 max
    } else if (v <= 0 - 9223372036854775808) {
        neg = true
        mag = sintRaw(2147483648, 0, 64, true)            // |int64 min|
    } else {
        neg = v < 0
        var a = neg ? -v : v
        mag = sintRaw(sintHi(a), sintLo(a), 64, true)
    }
    var b = sintRaw(0, base, 64, true)
    var zero = sintRaw(0, 0, 64, true)
    var out = ""
    while (sintCmp(mag, zero) != 0) {
        var d = sintNum(sintOp(4, mag, b))
        out = RT_DIGITS.charAt(d) + out
        mag = sintOp(3, mag, b)
    }
    return (neg ? "-" : "") + out
}

// ---------------------------------------------------------------------------
// the shared float rendering -- the SHARED float-to-string rendering, used by
// python, ruby and swift.
// ---------------------------------------------------------------------------
//
// One hook of its own, rtkFloDigits, renders a strictly positive finite double the
// language's own way and is the only part of float-to-string that is not shared.

// ============================================ the decimal bignum ===========
//
// python's and ruby's exact-decimal float formatters (rbDigitAt / rbBigFromNum /
// rbBigMulSmall / rbBigStr / rbExactDec / rbRoundHalfEven / rbFixed / rbSci /
// rbBaseStr / rbByteCut and the pyB copies) and swift's splitter are these bodies.
// The float rendering ABOVE this bignum (FloDigits / FloStr) is split at rtSciText
// below.

// strconv.FormatFloat(a, 'e', -1, 64), recovered from the engine's own shortest
// rendering: turn a > 0 into {d: the significant digits with no point and no
// leading or trailing zero, e: the SCIENTIFIC exponent}, so that the value is
// 0.d1d2... * 10^(e+1). The input "" + a is either a plain decimal ("1234.5",
// "0.00012") or an exponent form ("1e+21", "1.5e-7"), and both are jsNumString
// in the Go half and d_num_str in the floor, which are the same shortest form
// strconv produces.
function rtSplit10(a) {
    var s = "" + a
    var mant = s
    var e10 = 0
    var ei = s.indexOf("e")
    if (ei >= 0) {
        mant = s.substring(0, ei)
        var es = s.substring(ei + 1, s.length)
        var eneg = false
        if (es.charAt(0) == "+") { es = es.substring(1, es.length) }
        else if (es.charAt(0) == "-") {
            eneg = true
            es = es.substring(1, es.length)
        }
        e10 = parseInt(es)
        if (eneg) { e10 = 0 - e10 }
    }
    // Split the mantissa at its point; `pt` is how many digits precede it.
    var pt = mant.length
    var di = mant.indexOf(".")
    var digits = mant
    if (di >= 0) {
        pt = di
        digits = mant.substring(0, di) + mant.substring(di + 1, mant.length)
    }
    // A leading zero run does not count as significant, and each one shifts the
    // point right by one place.
    var lead = 0
    while (lead < digits.length && digits.charAt(lead) == "0") { lead = lead + 1 }
    digits = digits.substring(lead, digits.length)
    pt = pt - lead
    // A trailing zero run is not significant either, and does not move the point.
    var end = digits.length
    while (end > 1 && digits.charAt(end - 1) == "0") { end = end - 1 }
    digits = digits.substring(0, end)
    if (digits.length == 0) { return {d: "0", e: 0} }
    return {d: digits, e: e10 + pt - 1}
}


// The exponential half of a float rendering, shared by python, ruby and swift:
// one digit, the rest as a fraction, then a SIGNED exponent zero-padded to two
// digits. `dot` forces a fraction digit onto a one-digit mantissa, which is
// Ruby's rule (1.0e+20) and not Python's or Swift's (1e+20).
//
// This, and not the whole of FloDigits, is what the three languages share. The
// BOUNDARY between exponential and plain form is three genuinely different rules
// and stays in the three files: Python's is `decpt <= -4 || decpt > 16`, Ruby's
// is numeric.c flo_to_s's `decpt < -3 || decpt > DBL_DIG(15)`, and Swift's is on
// the VALUE rather than the exponent - SwiftDtoa goes scientific above 2^53, so
// 9007199254740992.0 is the last plain one. The two low bounds are the SAME
// predicate spelled twice (decpt <= -4 and decpt < -3 both mean e10 <= -5); only
// the high bound really differs, and it differs three ways.
function rtSciText(digits, e10, dot) {
    var out = digits.substring(0, 1)
    if (digits.length > 1) { out = out + "." + digits.substring(1, digits.length) }
    else if (dot) { out = out + ".0" }
    var sign = "+"
    var ex = e10
    if (ex < 0) {
        sign = "-"
        ex = 0 - ex
    }
    if (ex < 10) { return out + "e" + sign + "0" + ex }
    return out + "e" + sign + ex
}

// The plain half, with `decpt` digits before the point and a forced ".0" when
// there is no fraction left. Byte-identical in all three, down to the spelling.
function rtFixText(digits, decpt) {
    if (decpt <= 0) { return "0." + rtZeros(0 - decpt) + digits }
    if (decpt >= digits.length) { return digits + rtZeros(decpt - digits.length) + ".0" }
    return digits.substring(0, decpt) + "." + digits.substring(decpt, digits.length)
}

// The whole of a language's float-to-string, above rtkFloDigits (which renders a
// strictly positive finite double and is the one part that differs). The three
// spellings of NaN and the infinities are parameters, because they are what the
// language prints:
//
//   nan / inf / -inf        python (repr(float('nan')) is "nan"), swift
//   NaN / Infinity / -Inf…  ruby (Float::NAN.to_s is "NaN", INFINITY "Infinity")
//
// -0.0 keeps its sign, which needs 1 / x: `-0.0 < 0` is false, Math.abs of it is
// +0.0, and `"" + -0.0` is "0" in every engine here.
function rtFloStr(x, nanS, infS, ninfS) {
    if (x !== x) { return nanS }
    // The infinities without naming the Infinity global, which the interpreter
    // half spells 1 / 0 too (languages/metajs-interpreter.abnf): Inf - Inf is NaN.
    if (x - x !== 0) {
        if (x > 0) { return infS }
        return ninfS
    }
    if (x == 0) {
        if (1 / x < 0) { return "-0.0" }
        return "0.0"
    }
    if (x < 0) { return "-" + rtkFloDigits(0 - x) }
    return rtkFloDigits(x)
}

// ---------------------------------------------------------------------------
// the JVM-family bodies -- the bodies csharp-rt.metajs and java-rt.metajs share,
// and NOBODY ELSE DOES.
// ---------------------------------------------------------------------------
//
// `js_cscmp` and `js_jvcmp` are one body (rtjRel), and so are the strict equality
// and the float arithmetic, over two knobs that are genuinely different:
//
//   rtjkCmp - csCmp promotes with csPromote and compares two csBox cells with
//     sintCmp; jvCmp switches on jvW (JLS 5.6.2: long when either side is long,
//     int otherwise) and compares two plain int32s below 64 bits. Two integer
//     models, not one spelled twice.
//   rtjkFloOperand - csFloOperand converts only the {__char} box and lets a tag
//     13 cell through, because a C# long is an honest SIGNED cell; jvmOperand
//     sends everything non-float through jvNum, because Java's long box is marked
//     UNSIGNED and the floor's to_number would read it as a magnitude.

// ----- the two knobs, defined by the importer -------------------------------
//
//   rtjkCmp(op, l, r)       the ordered/equality comparison of two INTEGRAL
//                           operands at the promoted type. csharp: csCmp.
//                           java: jvCmp.
//   rtjkFloOperand(v)       a value made safe for the floor's floOp.
//                           csharp: csFloOperand. java: jvmOperand.

// An operand of INTEGER arithmetic. A char is one - it is an integral type in
// both languages - and a double is not.
//
// Same body as rtIsIntegral above, and DELIBERATELY NOT A DELEGATION TO IT: csharp
// and java ask this at fifteen sites inside their arithmetic dispatch, and one
// extra MetaJS call there is measurably slower (a few percent on java). The same
// rule is written up at pyIsObj in lib/python-rt.metajs: size the CALL SITE, not
// the body.
function rtjIsIntegral(v) {
    if (rtIsCharBox(v)) { return true }
    if (typeof v != "number") { return false }
    return !floIs(v)
}

// long.MaxValue / long.MinValue as 64 bit cells - the SIGNED extremes both
// languages saturate a double to. Shared so the hand-written bit patterns exist
// once; no call site is on an arithmetic path.
function rtjMaxL() { return sintRaw(2147483647, 4294967295, 64, false) }
function rtjMinL() { return sintRaw(2147483648, 0, 64, false) }

// The double reading of anything numeric.
//
// The last two arms are rt.toNumber's (abnf/jsrt.go): undefined answers NaN, as
// in the Go twin, so all three engines agree. Neither language's real answer is a
// number - C# raises RuntimeBinderException for a missing `dynamic` member and Java
// ArrayIndexOutOfBoundsException - and no engine here can raise either. No
// well-formed Java program produces an `undefined` (an uninitialized field reads 0,
// 0.0 or null), so only malformed programs see the arm. kotlin's ktNum carries the
// same two arms.
function rtjNum(v) {
    if (floIs(v)) { return floNum(v) }
    if (rtIsCharBox(v)) { return v["__char"] }
    if (sintIs(v)) { return sintNum(v) }
    if (typeof v == "number") { return v }
    if (v === true) { return 1 }
    if (v === false) { return 0 }
    if (typeof v == "string") { return parseFloat(v) }
    if (v === null) { return 0 }
    return NaN
}

// new T[n] / new T[n] with a default element.
function js_arr_new_n(n, fill) {
    var out = []
    var i = 0
    var c = rtjNum(n)
    while (i < c) {
        out.push(fill)
        i = i + 1
    }
    return out
}

// == / != . A double on either side is compared as a double; two integrals are
// compared at the promoted type; anything else is identity.
//
// The SIZED INTEGER arm matters: floEq is the floor's jf_num_eq / the twin's
// jvmNumEq, and NEITHER has a tag 13 arm, but `long x = 0; double y = 0.0; x == y`
// is true - JLS 15.21.1 and ECMA-334 12.12.9 both promote the integral operand to
// double first. rtjNum is that promotion, the same reading rtjArith gives the same
// pair of operands.
function rtjStrictEq(l, r) {
    if (floIs(l) || floIs(r)) {
        if (sintIs(l) || sintIs(r)) { return rtjNum(l) == rtjNum(r) }
        return floEq(l, r)
    }
    if (sintIs(l) || sintIs(r)) {
        if (!rtjIsIntegral(l)) { return false }
        if (!rtjIsIntegral(r)) { return false }
        return rtjkCmp("==", l, r)
    }
    return l === r
}

// < > <= >= . Two integral operands compare at the promoted type; everything
// else goes through rtCompare (lib/runtime.metajs), which answers the SENTINEL 2
// when either operand coerces to NaN.
//
// THE SENTINEL MEANS "EVERY RELATION IS FALSE", and that is the rule in both
// languages: ECMA-334 12.12.1 for C#, JLS 15.20.1 for Java. Read as an ORDERING
// it makes `>` and `>=` true, and read as 0 it makes `<=` and `>=` true.
// Twins: abnf/jsrtcsharp.go and abnf/jsrtjava.go carry the same three lines and
// have to move with this one, or --cross reports it.
function rtjRel(op, l, r) {
    if (rtjIsIntegral(l) && rtjIsIntegral(r) && !floIs(l) && !floIs(r)) { return rtjkCmp(op, l, r) }
    var c = rtCompare(l, r)
    if (c == 2) { return false }
    if (op == "<") { return c < 0 }
    if (op == ">") { return c > 0 }
    if (op == "<=") { return c <= 0 }
    return c >= 0
}

// Arithmetic with a double on either side: the whole operation is floating point
// and its result is a double. floOp is the floor's own tag 14 arm of exactly
// this, by operator INDEX: 0 + 1 - 2 * 3 / 4 %.
function rtjArith(op, l, r) {
    var code = 0
    if (op == "-") { code = 1 } else if (op == "*") { code = 2 } else if (op == "/") { code = 3 } else if (op == "%") { code = 4 }
    return floOp(code, rtjkFloOperand(l), rtjkFloOperand(r))
}

// ===================================================== the dart/swift pair ==
//
// Shared by dart and swift alone. Neither body adds a hook: rtIsArr calls rtIsObj,
// and rtJavaStr calls sintIs / sintStr / floIs / floStr, which are MetaJS HOST
// GLOBALS the floor seeds. php's phIsList is a different predicate (it also rejects
// a {__refcell} box); go's goJavaStr delegates to gopStr.

// A MetaJS list. A Map / Dictionary / tuple / instance box is an object without
// a numeric `length`.
function rtIsArr(v) {
    if (!rtIsObj(v)) { return false }
    if (v["__dict"] === true) { return false }
    return typeof v["length"] == "number"
}

// The Java-style rendering of a scalar, which both emitters use for their string
// builders and their index arithmetic. Null and undefined are "null"; the two
// number boxes render in their own style; anything else is MetaJS's own `+ ""`.
function rtJavaStr(v) {
    if (typeof v == "string") { return v }
    if (v === null) { return "null" }
    if (v === undefined) { return "null" }
    if (typeof v == "boolean") { return v ? "true" : "false" }
    if (sintIs(v)) { return sintStr(v) }
    if (floIs(v)) { return floStr(v) }
    return "" + v
}

// ===================================================== the binary32 float ===
//
// java/kotlin `float`, C# `float`, Go `float32` and Swift `Float` are binary32.
// The value travels as a double (every binary32 is exactly one) and every
// arithmetic result is rounded back to 24 significant bits by rtF32Round; only
// the box's style byte records the width. The rounding lives in layer 2, not the
// floor, because c-to-llvm-ir.abnf computes every C `float` at double precision
// and so cannot spell `(float)x`. MetaJS has no access to a double's bits either
// (manual 7.7), so the rounding is done with exact power-of-two scalings around
// a single round-half-to-even. The Go twin spells it `float64(float32(x))`.

// x * 2^k, exactly: every factor is a power of two. The chunking by 2^30 keeps
// the loop short for the ~280 halvings a subnormal float needs.
function rtScale2(x, k) {
    var v = x
    var n = k
    while (n >= 30) { v = v * 1073741824; n = n - 30 }
    while (n <= 0 - 30) { v = v / 1073741824; n = n + 30 }
    while (n > 0) { v = v * 2; n = n - 1 }
    while (n < 0) { v = v / 2; n = n + 1 }
    return v
}

// Math.fround: the double nearest x that a binary32 holds, half to even, with
// the subnormals and both overflows. The significand is scaled until its unit in
// the last place is 1, rounded there, and scaled back. `0 / (0 - 1)` is -0.0
// (manual 7.10).
function rtF32Round(x) {
    if (x !== x) { return x }
    if (x === 0) { return x }
    var zero = 0
    var inf = 1 / zero
    var neg = x < 0
    var a = neg ? 0 - x : x
    if (a === inf) { return x }
    var maxf = rtScale2(16777215, 104)
    // 2^128 is above every rounding boundary and 2^-150 is the half-way point
    // below the smallest subnormal (which ties to even, i.e. to zero); both
    // early exits also bound the exponent loop below to ~280 turns.
    if (a >= rtScale2(1, 128)) { return neg ? 0 - inf : inf }
    if (a <= rtScale2(1, 0 - 150)) { return neg ? 0 / (0 - 1) : 0 }
    var e = 0
    var t = a
    while (t >= 2) { t = t / 2; e = e + 1 }
    while (t < 1) { t = t * 2; e = e - 1 }
    var q = e - 23
    if (q < 0 - 149) { q = 0 - 149 }
    var s = rtScale2(a, 0 - q)
    var f = Math.floor(s)
    var d = s - f
    if (d > 0.5) { f = f + 1 }
    if (d === 0.5) { if (f - Math.floor(f / 2) * 2 !== 0) { f = f + 1 } }
    var r = rtScale2(f, q)
    if (r > maxf) { return neg ? 0 - inf : inf }
    if (r === 0) { return neg ? 0 / (0 - 1) : 0 }
    return neg ? 0 - r : r
}

// The shortest round-tripping decimal of the double a > 0, as DIGITS "e" EXP
// with EXP the decimal exponent of the FIRST digit - floPrec's shape. It reads
// the digits off `"" + a`, which is exact in layer 2 in both places it runs (the
// floor's shortest_digits natively, strconv.FormatFloat(-1) under llvm.Run). The
// tag-script halves cannot do this - goja's printer is not always shortest - and
// go through floPrec instead.
function rtDecDigits(a) {
    var s = "" + a
    var mant = s
    var exp = 0
    var ei = 0 - 1
    var i = 0
    while (i < s.length) {
        var c = s.charAt(i)
        if (c == "e") { ei = i }
        if (c == "E") { ei = i }
        i = i + 1
    }
    if (ei >= 0) {
        mant = s.substring(0, ei)
        var et = s.substring(ei + 1)
        if (et.charAt(0) == "+") { et = et.substring(1) }
        exp = parseInt(et, 10)
    }
    var digits = ""
    var pt = 0 - 1
    var j = 0
    while (j < mant.length) {
        var ch = mant.charAt(j)
        if (ch == ".") { pt = digits.length } else { if (ch != "-") { digits = digits + ch } }
        j = j + 1
    }
    if (pt < 0) { pt = digits.length }
    var lead = 0
    while (lead < digits.length - 1 && digits.charAt(lead) == "0") { lead = lead + 1 }
    digits = digits.substring(lead)
    pt = pt - lead
    var endz = digits.length
    while (endz > 1 && digits.charAt(endz - 1) == "0") { endz = endz - 1 }
    digits = digits.substring(0, endz)
    return digits + "e" + (pt + exp - 1)
}

// A DIGITS "e" EXP form rounded to n significant digits, half to even. The
// source is already the shortest form of the value, so a genuine tie can only
// be a decimal the double holds exactly.
function rtRoundDig(s, n) {
    var ei = s.indexOf("e")
    var ds = s.substring(0, ei)
    var ex = parseInt(s.substring(ei + 1), 10)
    if (ds.length <= n) { return s }
    var keep = ds.substring(0, n)
    var nxt = ds.charCodeAt(n) - 48
    var up = false
    if (nxt > 5) { up = true }
    if (nxt == 5) {
        var rest = false
        var i = n + 1
        while (i < ds.length) { if (ds.charCodeAt(i) != 48) { rest = true } i = i + 1 }
        if (rest) { up = true } else {
            var last = ds.charCodeAt(n - 1) - 48
            if (last - Math.floor(last / 2) * 2 == 1) { up = true }
        }
    }
    if (up) {
        var out = ""
        var carry = 1
        var k = n - 1
        while (k >= 0) {
            var d = ds.charCodeAt(k) - 48 + carry
            carry = 0
            if (d == 10) { d = 0; carry = 1 }
            out = "" + d + out
            k = k - 1
        }
        if (carry == 1) { out = ("1" + out).substring(0, n); ex = ex + 1 }
        keep = out
    }
    var endz = keep.length
    while (endz > 1 && keep.charAt(endz - 1) == "0") { endz = endz - 1 }
    return keep.substring(0, endz) + "e" + ex
}

// The value of a DIGITS "e" EXP form of at most nine digits, so the integer
// part is exact; the power of ten goes on in chunks of 10^15, the largest a
// double holds exactly. The error stays far below a float's half-ulp, and the
// only consumer is rtF32Sig's round-trip test.
function rtDecVal(s) {
    var ei = s.indexOf("e")
    var ds = s.substring(0, ei)
    var k = parseInt(s.substring(ei + 1), 10) - ds.length + 1
    var m = 0
    var i = 0
    while (i < ds.length) { m = m * 10 + (ds.charCodeAt(i) - 48); i = i + 1 }
    while (k >= 15) { m = m * 1000000000000000; k = k - 15 }
    while (k <= 0 - 15) { m = m / 1000000000000000; k = k + 15 }
    while (k > 0) { m = m * 10; k = k - 1 }
    while (k < 0) { m = m / 10; k = k + 1 }
    return m
}

// The n-digit neighbour of a DIGITS "e" EXP form: one unit in the n-th digit
// up (up true) or down. Below a power of ten the grid is a decade finer, so
// 1.00e5 steps down to 9.99e4. Twin of coreDigStep in lib/interp-core.js.
function rtDigStep(s, n, up) {
    var ei = s.indexOf("e")
    var ds = s.substring(0, ei)
    var ex = parseInt(s.substring(ei + 1), 10)
    while (ds.length < n) { ds = ds + "0" }
    var out = ""
    var carry = up ? 1 : 0 - 1
    var k = n - 1
    while (k >= 0) {
        var d = ds.charCodeAt(k) - 48 + carry
        carry = 0
        if (d == 10) { d = 0; carry = 1 }
        if (d < 0) { d = 9; carry = 0 - 1 }
        out = "" + d + out
        k = k - 1
    }
    if (carry == 1) { out = "1" + out; ex = ex + 1 }
    if (out.charAt(0) == "0") { out = out.substring(1) + "9"; ex = ex - 1 }
    var endz = out.length
    while (endz > 1 && out.charAt(endz - 1) == "0") { endz = endz - 1 }
    return out.substring(0, endz) + "e" + ex
}

// The shortest decimal that round-trips as a binary32. Nine digits always do.
// At a power of two the rounding interval is lopsided, so when the NEAREST
// n-digit decimal misses it the neighbour on the far side of a can still hit
// it: 2^-96 is 1.2621775E-29, not the nine digit 1.26217745E-29.
function rtF32Sig(a) {
    var full = rtDecDigits(a)
    var n = 1
    while (n < 9) {
        var c = rtRoundDig(full, n)
        var v = rtF32Round(rtDecVal(c))
        if (v === a) { return c }
        var o = rtDigStep(c, n, v < a)
        if (rtF32Round(rtDecVal(o)) === a) { return o }
        n = n + 1
    }
    return rtRoundDig(full, 9)
}

// java.lang.Float.toString, which Kotlin's Float.toString delegates to:
// Double.toString's rule at 24 bits - plain for 1e-3 <= |v| < 1e7 and d.dddEnn
// outside it, always with a decimal point, never fewer than two significant
// digits in the scientific form.
function rtJvmF32Str(d) {
    if (d !== d) { return "NaN" }
    var zero = 0
    var inf = 1 / zero
    if (d === inf) { return "Infinity" }
    if (d === 0 - inf) { return "-Infinity" }
    if (d === 0) { if (1 / d < 0) { return "-0.0" } return "0.0" }
    var neg = d < 0
    var a = neg ? 0 - d : d
    var sig = rtF32Sig(a)
    var ei = sig.indexOf("e")
    var ds = sig.substring(0, ei)
    var e10 = parseInt(sig.substring(ei + 1), 10)
    var body = ""
    if (a >= 0.001 && a < 10000000) {
        body = rtJvmF32Plain(ds, e10)
    } else {
        // Where the shortest form has one digit the second is the closest two
        // digit decimal to the ACTUAL value rather than a zero: Float.MIN_VALUE
        // prints "1.4E-45", as Double.MIN_VALUE prints "4.9E-324".
        if (ds.length == 1) {
            var s2 = rtRoundDig(rtDecDigits(a), 2)
            var e2 = s2.indexOf("e")
            ds = s2.substring(0, e2)
            e10 = parseInt(s2.substring(e2 + 1), 10)
        }
        var frac = ds.substring(1)
        if (frac == "") { frac = "0" }
        body = ds.charAt(0) + "." + frac + "E" + e10
    }
    if (neg) { return "-" + body }
    return body
}

// The plain form, from the digits and the exponent of the first one, with the
// forced ".0" (100.0f is "100.0").
function rtJvmF32Plain(ds, e10) {
    if (e10 >= 0) {
        var ip = ""
        var i = 0
        while (i <= e10) {
            if (i < ds.length) { ip = ip + ds.charAt(i) } else { ip = ip + "0" }
            i = i + 1
        }
        var fp = "0"
        if (ds.length > e10 + 1) { fp = ds.substring(e10 + 1) }
        return ip + "." + fp
    }
    var lead = "0."
    var k = 0 - e10 - 1
    while (k > 0) { lead = lead + "0"; k = k - 1 }
    return lead + ds
}
