        var j = 1
        while (ok && j <= need) {
            var cb = s.charCodeAt(i + j) & 255
            if (cb < 128 || cb > 191) { ok = false }
            else { cp = cp * 64 + (cb - 128) }
            j = j + 1
        }
        if (ok && cp < lo) { ok = false }
        if (ok && cp > 1114111) { ok = false }
        if (ok && cp >= 55296 && cp <= 57343) { ok = false }
        if (!ok) {
            out = out + luChar(b0)
            i = i + 1
            continue
