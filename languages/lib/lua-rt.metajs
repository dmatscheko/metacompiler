            if (cb < 128 || cb > 191) { ok = false }
            else { cp = cp * 64 + (cb - 128) }
            j = j + 1
        }
        if (ok && cp < lo) { ok = false }
        if (ok && cp > 1114111) { ok = false }
        if (ok && cp >= 55296 && cp <= 57343) { ok = false }
        if (!ok) {
            out = out + luChar(b0)
            i = i + 1
            continue
        }
        out = out + luChar(cp)
        i = i + need + 1
    }
    return out
}

// Lua's print separates its arguments with a TAB. Every element has already been
// rendered by the emitter's lua_strall (lua_str + js_luaout), so this only joins
// and writes.
function js_luaprint(args) {
    var out = ""
    for (var i = 0; i < args.length; i++) {
        if (i > 0) { out = out + "\t" }
        out = out + args[i]
    }
    println(out)
    return undefined
}

// str(v) with Python-style rendering. REACHABILITY: the only caller is the
// emitter's lua_str, in the arm reached after nil, boolean, number, function and
// table have all been ruled out - so the argument is always a STRING, for which
// the Go twin's pyString is the identity. The other cases are spelled out anyway
// so the function is not a lie, but nothing in the Lua compiler reaches them.
function js_pystr(v) {
    if (typeof v == "string") { return v }
    if (v === undefined) { return "None" }
    if (v === null) { return "None" }
    if (v === true) { return "True" }
    if (v === false) { return "False" }
    return "" + v
}

// A method call: (receiver, method name, argument array). The Lua compiler emits
// exactly one, Math.pow, so the receiver is always a host object here; apply is
// the general form and costs nothing extra.
function js_mcall(recv, name, args) {
    var f = recv[name]
    return f.apply(recv, args)
}
