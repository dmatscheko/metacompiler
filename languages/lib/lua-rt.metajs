    var i = 0
    var n = s.length
    while (i < n) {
        var b0 = s.charCodeAt(i) & 255
        if (b0 < 128) {
            out = out + String.fromCharCode(b0)
            i = i + 1
            continue
        }
        // How many continuation bytes the lead announces, and the smallest code
        // point the sequence may legally carry (the overlong test). A lead byte
        // outside these ranges (0x80..0xC1, 0xF5..0xFF) starts nothing.
        var need = 0
        var cp = 0
        var lo = 0
        if (b0 >= 194 && b0 <= 223) {
            need = 1
            cp = b0 - 192
            lo = 128
        } else if (b0 >= 224 && b0 <= 239) {
            need = 2
            cp = b0 - 224
            lo = 2048
        } else if (b0 >= 240 && b0 <= 244) {
            need = 3
            cp = b0 - 240
            lo = 65536
