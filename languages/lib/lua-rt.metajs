// lua-rt.metajs -- LUA'S OWN SEMANTICS, in MetaJS: layer 2 over the C floor
// (languages/lib/runtime.c, layer 1). The generic MetaJS primitives and the
// language-neutral scope/object walks (js_scope_decl, js_scope_set,
// js_scope_typeof, js_pyset_var, js_keys) are the floor's; the js_lu* externs
// languages/lua-to-llvm-ir.abnf emits for LUA'S semantics are here.
//
// Compile with:
//     mec languages/metajs-to-llvm-ir.abnf languages/lib/lua-rt.metajs -q -rt-lib
// which is what tests/gen-lua-rt-ll.sh does; the result is the checked-in
// languages/lib/lua-rt.ll that lua-to-llvm-ir.abnf links next to runtime.ll.
// -rt-lib exports every TOP-LEVEL `function js_*` below under its own C symbol,
// so nothing else in this file is visible to the linker - the helpers are
// deliberately named lu*/i64* instead.
//
// THE AUTHORITATIVE SPECIFICATION IS abnf/jsrtlua.go, the Go twin, and this file
// matches it function for function. Where it cannot, the site says so.
//
// ----- the value model, identical in both halves -----
//
//     a plain number       ==  a Lua INTEGER whose value is exact in a double
//                              (|v| <= 2^53, integral), OR a Lua FLOAT whose
//                              value is not integral (1.5, inf, nan)
//     a SIZED INTEGER      ==  a Lua integer outside that range. The Go twin uses
//                              jsGInt (abnf/jsrtint.go); the C floor has the same
//                              thing as a REAL PRIMITIVE TYPE: tag 13 of
//                              languages/lib/runtime.c, reached through the
//                              sint/sintIs/sintHi/sintLo host builtins, and
//                              js_typeof answers "number" for it in both halves.
//
//                              THE PRICE: with the box a real number,
//                              `typeof v == "number"` is
//                              TRUE for it, so every site that means "an ordinary
//                              double" has to say so. Each one below is marked.
//     an {__f} box         ==  a float whose value IS integral (1.0, 1e100), the
//                              only case the plain reading could not tell from an
//                              integer. lua-to-llvm-ir.abnf BUILDS this box in IR
//                              itself (js_obj_new + js_set "__f"), so its shape is
//                              fixed and must not change.
//
// MetaJS rules that shape the code below (docs/abnf-dialect-gotchas.md): a local
// keeps the TYPE CLASS it is first assigned, so a variable that holds a number in
// one branch and a box in another is declared `var x = anytype`; there is no ASI,
// so every `return` carries its value on the same line; no for..in, no splice.

// ============================================================ exact 64 bit ===
// Copied from languages/lib/interp-core.js (the interpreter half's shared
// sized-integer layer), which is validated against `go run` over 156,490
// vectors. Only the operators Lua needs are here.

function i64Make(h, l) { return {h: h >>> 0, l: l >>> 0} }

function i64FromNum(n) {
    if (n !== n) { return i64Make(0, 0) }
    var neg = n < 0
    var a = neg ? 0 - n : n
    a = Math.floor(a)
    if (a >= 18446744073709551616) { a = a - Math.floor(a / 18446744073709551616) * 18446744073709551616 }
    var h = Math.floor(a / 4294967296)
    var l = a - h * 4294967296
    var v = i64Make(h, l)
    if (neg) { v = i64Neg(v) }
    return v
}

function i64Add(a, b) {
    var l = a.l + b.l
    var carry = l >= 4294967296 ? 1 : 0
    var h = a.h + b.h + carry
    return i64Make(h >>> 0, (l >>> 0))
}
function i64Not(a) { return i64Make(~a.h, ~a.l) }
function i64Neg(a) { return i64Add(i64Not(a), i64Make(0, 1)) }
function i64Sub(a, b) { return i64Add(a, i64Neg(b)) }

function i64Mul(a, b) {
    var a0 = a.l & 0xffff
    var a1 = a.l >>> 16
    var a2 = a.h & 0xffff
    var a3 = a.h >>> 16
    var b0 = b.l & 0xffff
    var b1 = b.l >>> 16
    var b2 = b.h & 0xffff
    var b3 = b.h >>> 16
    var c0 = a0 * b0
    var c1 = (c0 >>> 16) + a1 * b0
    var c2 = c1 >>> 16
    c1 = (c1 & 0xffff) + a0 * b1
    c2 = c2 + (c1 >>> 16) + a2 * b0
    var c3 = c2 >>> 16
    c2 = (c2 & 0xffff) + a1 * b1
    c3 = c3 + (c2 >>> 16)
    c2 = (c2 & 0xffff) + a0 * b2
    c3 = c3 + (c2 >>> 16)
    c3 = c3 + a3 * b0 + a2 * b1 + a1 * b2 + a0 * b3
    return i64Make(((c2 & 0xffff) | ((c3 & 0xffff) << 16)) >>> 0,
                   ((c0 & 0xffff) | ((c1 & 0xffff) << 16)) >>> 0)
}

function i64Shl(a, n) {
    var k = n & 63
    if (k === 0) { return i64Make(a.h, a.l) }
    if (k < 32) { return i64Make((a.h << k) | (a.l >>> (32 - k)), a.l << k) }
    return i64Make(a.l << (k - 32), 0)
}
function i64ShrU(a, n) {
    var k = n & 63
    if (k === 0) { return i64Make(a.h, a.l) }
    if (k < 32) { return i64Make(a.h >>> k, (a.l >>> k) | (a.h << (32 - k))) }
    return i64Make(0, a.h >>> (k - 32))
}

function i64And(a, b) { return i64Make(a.h & b.h, a.l & b.l) }
function i64Or(a, b)  { return i64Make(a.h | b.h, a.l | b.l) }
function i64Xor(a, b) { return i64Make(a.h ^ b.h, a.l ^ b.l) }

function i64IsZero(a) { return a.h === 0 && a.l === 0 }
function i64Eq(a, b) { return a.h === b.h && a.l === b.l }
function i64CmpU(a, b) {
    if (a.h !== b.h) { return (a.h >>> 0) < (b.h >>> 0) ? 0 - 1 : 1 }
    if (a.l !== b.l) { return (a.l >>> 0) < (b.l >>> 0) ? 0 - 1 : 1 }
    return 0
}
function i64CmpS(a, b) {
    var an = (a.h & 0x80000000) !== 0
    var bn = (b.h & 0x80000000) !== 0
    if (an !== bn) { return an ? 0 - 1 : 1 }
    return i64CmpU(a, b)
}
function i64IsNeg(a) { return (a.h & 0x80000000) !== 0 }

function i64DivModSmall(a, d) {
    var parts = [a.h >>> 16, a.h & 0xffff, a.l >>> 16, a.l & 0xffff]
    var out = [0, 0, 0, 0]
    var rem = 0
    for (var i = 0; i < 4; i++) {
        var cur = rem * 65536 + parts[i]
        var q = Math.floor(cur / d)
        rem = cur - q * d
        out[i] = q
    }
    return {q: i64Make(((out[0] * 65536) + out[1]) >>> 0, ((out[2] * 65536) + out[3]) >>> 0), r: rem}
}

function i64DivModU(a, b) {
    if (i64IsZero(b)) { return {q: i64Make(0, 0), r: i64Make(0, 0)} }
    if (b.h === 0 && (b.l >>> 0) < 2147483648 && b.l !== 0) {
        var s = i64DivModSmall(a, b.l >>> 0)
        return {q: s.q, r: i64Make(0, s.r)}
    }
    var q = i64Make(0, 0)
    var r = i64Make(0, 0)
    for (var i = 63; i >= 0; i = i - 1) {
        r = i64Shl(r, 1)
        var bit = (i >= 32) ? ((a.h >>> (i - 32)) & 1) : ((a.l >>> i) & 1)
        r = i64Or(r, i64Make(0, bit))
        if (i64CmpU(r, b) >= 0) {
            r = i64Sub(r, b)
            q = i64Or(q, i64Shl(i64Make(0, 1), i))
        }
    }
    return {q: q, r: r}
}

// Go's / and %: truncation toward zero, so the remainder takes the DIVIDEND's
// sign. The most negative value divided by -1 wraps back to itself.
function i64DivModS(a, b) {
    var an = i64IsNeg(a)
    var bn = i64IsNeg(b)
    var ua = an ? i64Neg(a) : a
    var ub = bn ? i64Neg(b) : b
    var d = i64DivModU(ua, ub)
    var q = d.q
    var r = d.r
    if (an !== bn) { q = i64Neg(q) }
    if (an) { r = i64Neg(r) }
    return {q: q, r: r}
}

function i64StrU(a) {
    if (i64IsZero(a)) { return "0" }
    var s = ""
    var v = a
    while (!i64IsZero(v)) {
        var d = i64DivModSmall(v, 1000000000)
        v = d.q
        if (i64IsZero(v)) { s = "" + d.r + s }
        else {
            var chunk = "" + d.r
            while (chunk.length < 9) { chunk = "0" + chunk }
            s = chunk + s
        }
    }
    return s
}
function i64StrS(a) {
    if (i64IsNeg(a)) { return "-" + i64StrU(i64Neg(a)) }
    return i64StrU(a)
}

// ================================================================= the model ==

// LU_MININT / LU_MAXINT as pairs, and the two constants a double needs.
function luMaxPair() { return i64Make(0x7fffffff, 0xffffffff) }
function luMinPair() { return i64Make(0x80000000, 0) }
function luInf() { return Infinity }

// luNorm is giNorm(v, 64, false): sint() is the C floor's si_norm, which answers a
// PLAIN NUMBER when the value is exact in a double and a sized integer otherwise.
// The pair goes over as two unsigned 32 bit halves because a MetaJS number is a
// double and cannot carry 64 bits exactly.
function luNorm(p) { return sint(p.h, p.l, 64, 0) }
// luIsBox is js_giis: the value is a sized integer rather than a plain double.
// It answers false for undefined, null, a string and a table without a guard,
// because the floor asks the TAG.
function luIsBox(v) { return sintIs(v) }
// luPlain is the predicate the sized-integer tag makes necessary: an ORDINARY
// double, which `typeof v == "number"` does not say on its own.
function luPlain(v) {
    if (typeof v != "number") { return false }
    return !sintIs(v)
}
// luFloOf reads the {__f} float box: the boxed value, or undefined.
function luFloOf(v) {
    if (v === undefined) { return undefined }
    if (v === null) { return undefined }
    // A sized integer answers "number" here, so it leaves through this line -
    // which is right: it is an integer, never the {__f} float box. The float box
    // is still an OBJECT in BOTH halves (lua-to-llvm-ir.abnf builds it in IR and
    // abnf/jsrtlua.go reads the same shape), so it needs no tag of its own.
    if (typeof v != "object") { return undefined }
    return v["__f"]
}
// luMkFlo boxes a float that would otherwise read back as an integer. The
// infinities and NaN are floats already and never need the box.
function luMkFlo(f) {
    if (f !== f) { return f }
    if (f === luInf()) { return f }
    if (f === 0 - luInf()) { return f }
    if (Math.floor(f) === f) { return {__f: f} }
    return f
}
// luIsInt is Lua's `math.type(v) == "integer"`.
function luIsInt(v) {
    if (luIsBox(v)) { return true }
    if (typeof v != "number") { return false }
    if (v !== v) { return false }
    if (v === luInf()) { return false }
    if (v === 0 - luInf()) { return false }
    return Math.floor(v) === v
}
// luIsNum is Lua's `type(v) == "number"` - either subtype, either box.
function luIsNum(v) {
    if (luIsBox(v)) { return true }
    if (typeof v == "number") { return true }
    return luFloOf(v) !== undefined
}
// luNumOf is the double reading. It loses precision above 2^53 by construction,
// so only the consumers that genuinely want a double may use it.
function luNumOf(v) {
    // sintNum is the floor's si_float, i.e. float64(int64) with exact
    // round-to-nearest-even bit arithmetic - which is what abnf/jsrtint.go's
    // giFloat does. Going through i64ToNumS would have gone through the soft
    // float's d_mul / d_add instead, which truncate.
    if (luIsBox(v)) { return sintNum(v) }
    if (typeof v == "number") { return v }
    var f = luFloOf(v)
    if (f !== undefined) { return f }
    return NaN
}
// luPair is the exact 64 bit payload of a value already known to be an integer.
function luPair(v) {
    if (luIsBox(v)) { return i64Make(sintHi(v), sintLo(v)) }
    return i64FromNum(luNumOf(v))
}
// luI64 turns an integral double into an integer value, or undefined when it does
// not fit the signed 64 bit range. 2^63 is the first magnitude that is not one.
function luI64(n) {
    if (n >= 9223372036854775808) { return undefined }
    if (n < 0 - 9223372036854775808) { return undefined }
    return luNorm(i64FromNum(n))
}

// A Lua runtime error is CATCHABLE (pcall), so it is thrown as a {__luerr}
// marker; the emitted lua_errval that catches it prefixes the position of the
// statement that was running, which only the module knows. Twin of rt.luFail in
// abnf/jsrtlua.go.
function luFail(msg) {
    var o = {}
    o["__luerr"] = msg
    throw o
}
// luFailOp raises an operation's error about operand opnd (1 or 2): the marker
// carries it as __luop, and the emitted lua_opmsg appends that operand's name when
// the running site has one ("(local 'x')"). Twin of rt.luFailOp in abnf/jsrtlua.go.
function luFailOp(opnd, msg) {
    var o = {}
    o["__luerr"] = msg
    o["__luop"] = opnd
    throw o
}
// The end of a program whose error nobody caught: the text arrives rendered by
// the emitter's lua_errtext. fail() is a host builtin of the C floor
// (languages/lib/runtime.c): the text behind "js runtime error: ", and exit 1.
function js_luuncaught(s) {
    fail(s)
    return undefined
}

// ------------------------------------------------ reading a Lua numeral -----

function luDigit(c) {
    if (c >= 48 && c <= 57)  { return c - 48 }
    if (c >= 97 && c <= 102) { return c - 87 }
    if (c >= 65 && c <= 70)  { return c - 55 }
    return 0 - 1
}

// luParseInt reads a run of digits in `radix` as an exact 64 bit pair, and
// reports whether the value FIT: a hexadecimal literal wraps in Lua rather than
// overflowing to a float, so the caller decides what the overflow means.
function luParseInt(s, radix) {
    var acc = i64Make(0, 0)
    var rp = i64Make(0, radix)
    var fits = true
    for (var i = 0; i < s.length; i++) {
        var d = luDigit(s.charCodeAt(i))
        if (d < 0 || d >= radix) { continue }
        var next = i64Add(i64Mul(acc, rp), i64Make(0, d))
        // Overflow test on the same shape as the Go twin's: dividing the result
        // back by the radix has to give the accumulator again.
        var back = i64DivModU(next, rp)
        if (!i64Eq(back.q, acc)) { fits = false }
        if (i64CmpU(next, acc) < 0) { fits = false }
        acc = next
    }
    if (i64CmpU(acc, luMaxPair()) > 0) { fits = false }
    return {v: acc, fits: fits}
}

function luIsDigit(c) { return c >= 48 && c <= 57 }

// luParseHex reads the body of a 0x numeral: an integer, unless the spelling
// carries a '.' or a binary 'p' exponent.
function luParseHex(s) {
    var i = 0
    var n = s.length
    var f = 0
    var digits = 0
    var isFloat = false
    while (i < n && luDigit(s.charCodeAt(i)) >= 0) {
        f = f * 16 + luDigit(s.charCodeAt(i))
        i = i + 1
        digits = digits + 1
    }
    var intEnd = i
    if (i < n && s.charAt(i) == ".") {
        isFloat = true
        i = i + 1
        var scale = 1
        while (i < n && luDigit(s.charCodeAt(i)) >= 0) {
            scale = scale / 16
            f = f + luDigit(s.charCodeAt(i)) * scale
            i = i + 1
            digits = digits + 1
        }
    }
    if (digits === 0) { return undefined }
    if (i < n && (s.charAt(i) == "p" || s.charAt(i) == "P")) {
        isFloat = true
        i = i + 1
        var esign = 1
        if (i < n && (s.charAt(i) == "+" || s.charAt(i) == "-")) {
            if (s.charAt(i) == "-") { esign = 0 - 1 }
            i = i + 1
        }
        var e = 0
        var edig = 0
        while (i < n && luIsDigit(s.charCodeAt(i))) {
            e = e * 10 + (s.charCodeAt(i) - 48)
            i = i + 1
            edig = edig + 1
        }
        if (edig === 0) { return undefined }
        f = f * Math.pow(2, esign * e)
    }
    if (i < n) { return undefined }
    if (isFloat) { return luMkFlo(f) }
    // A hexadecimal INTEGER wraps to 64 bits: 0x10000000000000000 is 0.
    return luNorm(luParseInt(s.substring(0, intEnd), 16).v)
}

// luParseDec reads a decimal numeral: a float exactly when it has a fraction dot
// or an exponent.
function luParseDec(s) {
    var i = 0
    var n = s.length
    var isFloat = false
    var digits = 0
    while (i < n && luIsDigit(s.charCodeAt(i))) {
        i = i + 1
        digits = digits + 1
    }
    if (i < n && s.charAt(i) == ".") {
        isFloat = true
        i = i + 1
        while (i < n && luIsDigit(s.charCodeAt(i))) {
            i = i + 1
            digits = digits + 1
        }
    }
    if (digits === 0) { return undefined }
    if (i < n && (s.charAt(i) == "e" || s.charAt(i) == "E")) {
        isFloat = true
        i = i + 1
        if (i < n && (s.charAt(i) == "+" || s.charAt(i) == "-")) { i = i + 1 }
        var edig = 0
        while (i < n && luIsDigit(s.charCodeAt(i))) {
            i = i + 1
            edig = edig + 1
        }
        if (edig === 0) { return undefined }
    }
    if (i < n) { return undefined }
    var f = parseFloat(s)
    if (f !== f) { return undefined }
    if (isFloat) { return luMkFlo(f) }
    // A decimal integer literal is EXACT, and one that does not fit a signed 64
    // bit integer is a FLOAT rather than a wrapped integer.
    var p = luParseInt(s, 10)
    if (!p.fits) { return luMkFlo(f) }
    return luNorm(p.v)
}

// lua reads a decimal integer's sign WITH its digits (l_str2int), so the one
// magnitude that fits only when negative, 2^63, is math.mininteger and not a
// float when the text says "-9223372036854775808". luIs2p63 asks whether the
// digits after the sign spell exactly that magnitude. Twin of luIs2p63 in
// abnf/jsrtlua.go and luaIs2p63 in lua-interpreter.abnf.
function luIs2p63(s) {
    var z = 0
    while (z + 1 < s.length && s.charAt(z) == "0") { z = z + 1 }
    return s.substring(z) == "9223372036854775808"
}
// luParseNum reads the text of a Lua numeral - the lexer's spelling and the one a
// string goes through when it coerces in arithmetic. Surrounding blanks and a
// leading sign are tolerated; anything that is not a complete numeral answers
// undefined.
function luParseNum(s) {
    var i = 0
    var n = s.length
    while (i < n && (s.charAt(i) == " " || s.charAt(i) == "\t" || s.charAt(i) == "\n" || s.charAt(i) == "\r")) { i = i + 1 }
    while (n > i && (s.charAt(n - 1) == " " || s.charAt(n - 1) == "\t" || s.charAt(n - 1) == "\n" || s.charAt(n - 1) == "\r")) { n = n - 1 }
    var neg = false
    if (i < n && (s.charAt(i) == "+" || s.charAt(i) == "-")) {
        neg = s.charAt(i) == "-"
        i = i + 1
    }
    if (i >= n) { return undefined }
    var v = anytype
    if (s.charAt(i) == "0" && i + 1 < n && (s.charAt(i + 1) == "x" || s.charAt(i + 1) == "X")) {
        v = luParseHex(s.substring(i + 2, n))
    } else {
        v = luParseDec(s.substring(i, n))
    }
    if (v === undefined) { return undefined }
    if (!neg) { return v }
    var fb = luFloOf(v)
    if (fb === 9223372036854775808 && luIs2p63(s.substring(i, n))) { return luNorm(luMinPair()) }
    if (fb !== undefined) { return luMkFlo(0 - fb) }
    if (luIsInt(v)) { return luNorm(i64Neg(luPair(v))) }
    return 0 - luNumOf(v)
}

// luToNum is Lua's automatic coercion in an arithmetic or bitwise context: a
// number passes, a string that spells a numeral converts, anything else answers
// undefined.
function luToNum(v) {
    if (luIsNum(v)) { return v }
    if (typeof v == "string") { return luParseNum(v) }
    return undefined
}
function js_lutonum(v) { return luToNum(v) }

// luTypeName is Lua's type() for an error message.
function js_lutname(v) { return luTypeName(v) }
function luTypeName(v) {
    if (v === undefined) { return "nil" }
    if (v === null) { return "nil" }
    if (v === true) { return "boolean" }
    if (v === false) { return "boolean" }
    if (luIsNum(v)) { return "number" }
    if (typeof v == "string") { return "string" }
    if (typeof v == "function") { return "function" }
    return "table"
}

// ------------------------------------------------------- the operators -----

// luIDiv / luIMod are FLOOR division and FLOOR modulo on 64 bit pairs. Go's / and
// % truncate toward zero; Lua rounds toward minus infinity, so a non-zero
// remainder whose sign differs from the divisor's moves the quotient one step
// down and the remainder one divisor up. Both wrap at 64 bits, which is what
// makes math.mininteger // -1 answer math.mininteger.
function luIDiv(a, b) {
    if (i64Eq(a, luMinPair()) && i64Eq(b, i64Make(0xffffffff, 0xffffffff))) { return a }
    var d = i64DivModS(a, b)
    var q = d.q
    if (!i64IsZero(d.r) && (i64IsNeg(d.r) !== i64IsNeg(b))) { q = i64Sub(q, i64Make(0, 1)) }
    return q
}
function luIMod(a, b) {
    if (i64Eq(a, luMinPair()) && i64Eq(b, i64Make(0xffffffff, 0xffffffff))) { return i64Make(0, 0) }
    var d = i64DivModS(a, b)
    var r = d.r
    if (!i64IsZero(r) && (i64IsNeg(r) !== i64IsNeg(b))) { r = i64Add(r, b) }
    return r
}

// luToIntOp is a bitwise operand: an integer, or a float whose value is an exact
// integer inside the 64 bit range. A string does not coerce here (lua 5.5).
// Anything else is an error, and Lua distinguishes the two reasons.
function luToIntOp(v, opnd) {
    var a = v
    if (!luIsNum(v)) { luFailOp(opnd, "attempt to perform bitwise operation on a " + luTypeName(v) + " value") }
    if (luIsInt(a)) { return luPair(a) }
    var n = luNumOf(a)
    if (n !== n) { luFailOp(opnd, "number has no integer representation") }
    if (n === luInf() || n === 0 - luInf()) { luFailOp(opnd, "number has no integer representation") }
    if (Math.floor(n) !== n) { luFailOp(opnd, "number has no integer representation") }
    var iv = luI64(n)
    if (iv === undefined) { luFailOp(opnd, "number has no integer representation") }
    return luPair(iv)
}

// luCmpV is the -1/0/1 of Lua's ordered comparison, or 2 for "unordered" (a NaN
// operand), which makes every relation false.
// luCmpIntFlo compares an integer with a float EXACTLY (lvm.c's LTintfloat and
// luaV_equalobj), not on the integer's double reading: 2^53 + 1 is not 2^53. The
// answer is the sign of i - f, or 2 for a NaN f. Inside 2^53 the double reading
// is exact; past it the float is compared with floor(f) as an integer. Twin of
// luCmpIntFlo in abnf/jsrtlua.go.
