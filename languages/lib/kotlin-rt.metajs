// ----- the grouped name tests ktSeqMethod's Go twin spells as case lists -----

function k3IsTakeDrop(name) {
    if (name == "take") { return true }
    if (name == "drop") { return true }
    if (name == "takeLast") { return true }
    return name == "dropLast"
}

function k3IsCopyName(name) {
    if (name == "toList") { return true }
    if (name == "toMutableList") { return true }
    if (name == "asSequence") { return true }
    if (name == "asIterable") { return true }
    if (name == "toIntArray") { return true }
    if (name == "toLongArray") { return true }
    if (name == "toShortArray") { return true }
    if (name == "toByteArray") { return true }
    if (name == "toDoubleArray") { return true }
    if (name == "toFloatArray") { return true }
    if (name == "toBooleanArray") { return true }
    if (name == "toCharArray") { return true }
    return name == "toTypedArray"
}

function k3IsElementAt(name) {
    // `get` joins this group so the LIST read a[i] and its method spelling a.get(i)
    // answer alike (bounds-checked).
    if (name == "get") { return true }
    if (name == "elementAt") { return true }
    if (name == "elementAtOrNull") { return true }
    if (name == "elementAtOrElse") { return true }
    if (name == "getOrNull") { return true }
    return name == "getOrElse"
}

function k3IsMaxOf(name) {
    if (name == "maxOf") { return true }
    if (name == "minOf") { return true }
    if (name == "maxOfOrNull") { return true }
    return name == "minOfOrNull"
}

function k3IsSetOp(name) {
    if (name == "intersect") { return true }
    if (name == "subtract") { return true }
    return name == "union"
}

function k3IsRunning(name) {
    if (name == "runningFold") { return true }
    if (name == "scan") { return true }
    return name == "runningReduce"
}

function k3IsSortOp(name) {
    if (name == "sort") { return true }
    if (name == "sortDescending") { return true }
    if (name == "sortBy") { return true }
    if (name == "sortByDescending") { return true }
    if (name == "sortWith") { return true }
    return name == "reverse"
}

function k3IsRemoveAll(name) {
    if (name == "removeAll") { return true }
    if (name == "removeIf") { return true }
    return name == "retainAll"
}

// ----- arms of ktSeqMethod that need their own scope -------------------------

// contentEquals over two arrays' elements: element-wise equals, so a nested array
// compares by identity, unless deep (contentDeepEquals), which compares two nested
// arrays by their contents in turn. Twin of ktContentEq in abnf/jsrtkotlin.go.
function k3ContentEq(es, other, deep) {
    var i = 0
    if (!ktIsArr(other)) { return false }
    if (other.length != es.length) { return false }
    for (i = 0; i < es.length; i = i + 1) {
        if (deep && k3BothJvmArr(es[i], other[i])) {
            if (!k3ContentEq(es[i], other[i], true)) { return false }
        } else if (!ktEqVals(es[i], other[i])) { return false }
    }
    return true
}
function k3BothJvmArr(a, b) {
    if (!ktIsArr(a)) { return false }
    if (!ktIsArr(b)) { return false }
    return ktIsJvmArr(a) && ktIsJvmArr(b)
}

function k3FilterNotNull(es, req) {
    var out = []
    var i = 0
    var e = anytype
    for (i = 0; i < es.length; i = i + 1) {
        e = es[i]
        if (e === null) {
            if (req) { fail("null element in requireNoNulls()") }
        } else { out.push(e) }
    }
    return out
}

function k3FilterIndexed(es, f, invert, ck) {
    var out = []
    var i = 0
    var e = anytype
    for (i = 0; k4IterMore(ck, es, i); i = i + 1) {
        e = es[i]
        if (k3Truthy(ktCall2(f, i, e)) !== invert) { out.push(e) }
    }
    return out
}

function k3WhileCut(es, f, ck) {
    var i = 0
    for (i = 0; k4IterMore(ck, es, i); i = i + 1) {
        if (!k3Truthy(ktCall1(f, es[i]))) { return i }
    }
    return es.length
}

// k3BinSearch is the binarySearch arm of ktSeqMethodK (jsrtkotlin.go).
function k3BinSearch(es, args) {
    var f = ktArg(args, 0)
    var byFn = args.length == 1 && ktIsFn(f)
    var byCmp = args.length > 1 && ktIsFn(args[1])
    var lo = 0
    var hi = es.length - 1
    while (lo <= hi) {
        var mid = Math.floor((lo + hi) / 2)
        var c = 0
        if (byFn) { c = k2Int(ktCall1(f, es[mid])) } else if (byCmp) { c = k2Int(ktCall2(args[1], es[mid], f)) } else { c = k4CmpValues(es[mid], f) }
        if (c < 0) { lo = mid + 1 } else if (c > 0) { hi = mid - 1 } else { return mid }
    }
    return -(lo + 1)
}

// takeLastWhile / dropLastWhile cut after the last element the predicate rejects.
function k3LastWhileCut(es, f, ck) {
    var i = es.length - 1
    while (k4IterPrev(ck, i)) {
        if (!k3Truthy(ktCall1(f, es[i]))) { return i + 1 }
        i = i - 1
    }
    return 0
}

function k3SortedWith(es, f) {
    return ktTimSort(es, function (a, b) { return ktNum(ktCall2(f, a, b)) })
}

// ============================================================================
// ktSetMethod -- jsrtkotlin.go:4328
//
// Only the members whose ANSWER is a Set, or that mutate the set, live here;
// everything else falls through to ktSeqMethod over the elements, which is right
// because kotlin.collections declares map / filter / sorted / joinToString / ...
// on Iterable and they all answer a LIST even for a Set receiver.
// ============================================================================

function ktSetMethod(s, name, args) {
    var keys = anytype
    var f = anytype
    var out = anytype
    var oth = []
    var kept = []
    var i = 0
    var j = 0
    var b = false
    var d = false
    var changed = false
    if (!ktIsSet(s)) { return KT_MISS }
    keys = ktSetElems(s)
    if (s["__jc"] === KT_PQ_CLASS) {
        var pr = ktPqMethod(s, keys, name, args)
        if (!ktMiss(pr)) { return pr }
    }
    f = ktKeyArg(s, keys, name, args)
    if (name == "size") { return keys.length }
    if (name == "isEmpty") { return keys.length == 0 }
    if (name == "isNotEmpty") { return keys.length > 0 }
    if (name == "contains") { return ktMapFind(keys, f) >= 0 }
    if (name == "containsAll") {
        oth = ktElems(f)
        for (i = 0; i < oth.length; i = i + 1) {
            if (ktMapFind(keys, oth[i]) < 0) { return false }
        }
        return true
