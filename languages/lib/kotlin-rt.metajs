function k3IsSetPlus(name) {
    if (name == "plus") { return true }
    return name == "union"
}

function k3IsSetMinus(name) {
    if (name == "minus") { return true }
    if (name == "subtract") { return true }
    return name == "intersect"
}

// ============================================================================
// ktMapMethod -- jsrtkotlin.go:4596
