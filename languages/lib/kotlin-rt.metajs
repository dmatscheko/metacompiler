function k2StartsWith(s, p) {
    if (p.length > s.length) { return false }
    return s.substring(0, p.length) === p
}

function k2EndsWith(s, p) {
    if (p.length > s.length) { return false }
    return s.substring(s.length - p.length, s.length) === p
}

// Go's unicode.IsSpace, which is what strings.TrimSpace trims. The host's own
// trim() IS strings.TrimSpace on the Go side (abnf/jsrt.go:4303) but is ASCII
// only in the C floor (runtime.c:3714), so the set is spelled out here and the
// two engines cannot drift.
function k2IsSpace(c) {
    if (c == 32 || c == 9 || c == 10 || c == 11 || c == 12 || c == 13) { return true }
    if (c == 133 || c == 160) { return true }
    if (c == 5760) { return true }
    if (c >= 8192 && c <= 8202) { return true }
    if (c == 8232 || c == 8233 || c == 8239 || c == 8287 || c == 12288) { return true }
    return false
}

function k2TrimSpace(s) {
    var a = 0
    var b = s.length
    var go = true
    while (go && a < b) {
        if (k2IsSpace(s.charCodeAt(a))) { a = a + 1 } else { go = false }
    }
    go = true
    while (go && b > a) {
        if (k2IsSpace(s.charCodeAt(b - 1))) { b = b - 1 } else { go = false }
    }
    return s.substring(a, b)
