    // spellings are deprecated but still resolve, so both halves accept all four.
    if (name == "uppercase" || name == "toUpperCase") { return s.toUpperCase() }
    if (name == "lowercase" || name == "toLowerCase") { return s.toLowerCase() }
    if (name == "contains") { return s.indexOf(k2Str2(ktArg(args, 0))) >= 0 }
