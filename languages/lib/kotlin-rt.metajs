// The exact 64 bit edges, built with the tag's own shift so that no
// constructor - and no assumption about section 0's ktNorm - is needed:
// 1 << 63 is Long.MIN_VALUE and MIN_VALUE - 1 wraps to Long.MAX_VALUE.
function k1MinI64() { return sintOp(9, 1, 63) }
function k1MaxI64() { return sintOp(1, k1MinI64(), 1) }

// ----- the operators --------------------------------------------------------

// jsrtkotlin.go ktArith (246). Both operands are truncated to the RESULT type's
// width and signedness first, the operation runs at that width, and the result
// is re-normalised - Kotlin's overflow is silent. sintConv is giTrunc + giNorm,
// and at width 64 signed it answers a plain number whose si_val is unchanged, so
// sintOp's own default result type (64, signed) is the same width the boxes
// would have named.
function k1Arith(op, l, r) {
    var wu = ktWU(l, r)
    var a = sintConv(k1Val(l), wu.w, wu.u)
    var b = sintConv(k1Val(r), wu.w, wu.u)
    if (op == "/" || op == "%") {
        if (sintCmp(b, 0) == 0) { ktThrowArith("/ by zero") }
    }
    return ktNorm(sintOp(k1OpCode(op), a, b), wu.w, wu.u)
