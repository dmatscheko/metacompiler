}
// jsrtkotlin.go's ktRecvDeclaring: the receiver on v's __outer chain that declares
// `name` - an instance, else the companion object of its class or of a superclass -
// or undefined.
function k6RecvDeclaring(v, name, iscall) {
    if (iscall && k4IsBuiltinRecv(v) && !k4BuiltinLacks(v, name)) { return v }
    var o = anytype
    o = v
    var guard = 0
    while (guard < 64) {
        guard = guard + 1
        if (!ktIsObj(o)) { return undefined }
        var cls = o["__class"]
        if (ktIsObj(cls)) {
            if (cls["__isclass"] === true) {
                if (k4Own(o, name)) { return o }
                if (k4bFindAcc(o, name) !== undefined) { return o }
