// isTypeName (abnf/jsrt.go:8432), for a NON-numeric receiver. `t` arrives with its
// type arguments and its `?` already stripped; `opt` carries whether there was one.
function k4IsTypeName(v, t, opt) {
    if (rtIsNil(v)) { return opt }
    // Kotlin's Char is its own type: `c is Char` holds, `c is Int` does not.
    if (ktIsChar(v)) {
        if (t == "Char") { return true }
        if (t == "Character") { return true }
        if (t == "Any") { return true }
        return t == "Comparable"
    }
    // A PROGRESSION before the collection names, so it is not a List.
    if (ktIsRange(v)) { return k4RangeIsType(v, t) }
    if (t == "Any") { return true }
    if (t == "Object") { return true }
    if (t == "String") { return typeof v == "string" }
    if (t == "CharSequence") { return typeof v == "string" }
    if (t == "Boolean") { return typeof v == "boolean" }
    if (t == "List") { return ktIsArr(v) }
    if (t == "MutableList") { return ktIsArr(v) }
    if (t == "Collection") { return ktIsArr(v) }
    if (t == "Array") { return ktIsArr(v) }
    if (ktIsObj(v)) {
        var cls = v["__class"]
        var guard = 0
        while (guard < 64) {
            guard = guard + 1
