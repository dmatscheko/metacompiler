// max / min / maxOf / minOf: the running best over every argument.
function k4MinMax(wantMax) {
    var want = wantMax
    return function () {
        var best = anytype
        best = k4At(arguments, 0)
        var i = 1
        while (i < arguments.length) {
            if (k4KeyLess(best, arguments[i]) === want) { best = arguments[i] }
            i = i + 1
        }
        return best
    }
}

// ============================================================================
// THE `::` NAME TABLE
// ============================================================================
//
// ktFuncNames (jsrtkotlin.go:5764) is a side table keyed by the closure value. The
// Go twin keys a map by the hostFunc pointer; layer 2 has no map keyed by a
// handle, so the two parallel arrays below are scanned with `===`, which is the
// same identity question.
var k4NameFns = []
var k4NameStrs = []

// The two-parallel-array lookup is SHARED as rtPairGet - lib/runtime.metajs.
// python's pyBFuncName was the same eight lines over pyBFnObjs/pyBFnNames.

// ============================================================================
// THE NEUTRAL TAIL: rt.memberCall (abnf/jsrt.go:2761)
// ============================================================================
//
// The last resort of js_ktsmcall is the shared js_mcall, which layer 2 cannot
// call. Only the arms a Kotlin receiver can still reach after the whole Kotlin
// surface above has declined are here - which in practice is the USER-CLASS
// dispatch, since ktStrMethod / ktSeqMethod / ktMapMethod already own the string,
// list and map surfaces. The *jsGenerator arm is NOT reproducible (its member
// table is the floor's) and is named at the fallthrough instead of guessed at.
function k4BaseMcall(recv, name, args) {
    if (typeof recv == "string") {
        if (name == "length") { return recv.length }
        if (name == "charAt") {
            var ci = k4Int(k4At(args, 0))
            if (ci < 0 || ci >= recv.length) { fail("charAt out of range") }
            return recv.charAt(ci)
        }
        if (name == "equals") { return ktIdent(recv, k4At(args, 0)) }
        if (name == "substring") {
            var b = 0
            var e = recv.length
            if (args.length > 0) { b = k4Int(args[0]) }
            if (args.length > 1) { e = k4Int(args[1]) }
            return recv.substring(b, e)
        }
        if (name == "indexOf") { return recv.indexOf(ktRender(k4At(args, 0))) }
        if (name == "isEmpty") { return recv.length == 0 }
        fail("unknown String method: " + name)
        return undefined
    }
    if (rtIsDictObj(recv)) {
        // The Python dict methods.
        if (name == "keys") { return rtCopyArr(ktMapKeys(recv)) }
        if (name == "values") { return rtCopyArr(ktMapVals(recv)) }
        if (name == "get") {
            var gi = ktMapFind(ktMapKeys(recv), k4At(args, 0))
            if (gi >= 0) { return ktMapVals(recv)[gi] }
            if (args.length > 1) { return args[1] }
            return undefined
        }
        fail("unknown dict method '" + name + "'")
        return undefined
    }
    if (ktIsArr(recv)) {
        // abnf/jsrt.go's arrayMethod answers the PROPERTY names as members
        // (`size` at jsrt.go:2853), and ktRecvProp lists exactly this set, so an
        // implicit receiver reached through with / run / apply asks for them here
        // after ktSeqMethod has declined. Without them `with(list) { size }`
        // aborted natively with "unknown list method 'size'" while llvm.Run
        // answered - the first divergence the native run of the ratchet found.
        if (name == "size") { return recv.length }
        if (name == "length") { return recv.length }
        if (name == "get") {
            var gi = k4Int(k4At(args, 0))
            if (gi < 0 || gi >= recv.length) { fail("list index " + gi + " out of range") }
            return recv[gi]
        }
        fail("unknown list method '" + name + "'")
        return undefined
    }
    if (ktIsObj(recv)) {
        var cls = recv["__class"]
        if (cls !== undefined) {
            // The lookup follows the __super chain (single inheritance).
            var c = cls
            var guard = 0
            while (guard < 64) {
                guard = guard + 1
                if (!ktIsObj(c)) { guard = 99 } else {
                    var mm = c[name]
                    if (k4Fn(mm)) { return mm.apply(undefined, rtPrepend(recv, args)) }
                    c = c["__super"]
                }
            }
            fail("unknown method '" + name + "' on an instance")
            return undefined
        }
        var f = recv[name]
        if (k4Fn(f)) { return f.apply(undefined, args) }
        fail("unknown method '" + name + "'")
        return undefined
    }
    fail("method call '" + name + "' on a " + typeof recv)
    return undefined
}

// ============================================================================
// THE HUB
// ============================================================================

// ktSmcall is js_ktsmcall (jsrtkotlin.go:1119): Kotlin's method-call entry point.
// The dispatchers are tried in EXACTLY the Go twin's order; every arm below is one
// of its branches, in place.
function ktSmcall(recv, name, args) {
    var rv = anytype
    rv = recv
    var as = args
    if (as === undefined) { as = [] }

    // A callable reference receiver: get / set / invoke, with the receiver as the
    // FIRST argument when the reference is unbound (Kotlin's KProperty1.get).
    var info = ktRefOf(rv)
    if (k4IsRef(info)) {
        if (name == "invoke") { return ktRefApply(info, as) }
        if (name == "get") { return js_ktfget(k4RefRecv(info, as), info["name"]) }
        if (name == "set") {
            var rest = k4RefRest(info, as)
            var wrecv = k4RefRecv(info, as)
            wrecv[info["name"]] = k4At(rest, 0)
            return undefined
        }
        if (name == "equals") { return k4RefEq(rv, k4At(as, 0)) }
        if (name == "toString") { return ktRender(rv) }
        if (info["bound"] !== true) {
            fail("method ." + name + "() of an unbound callable reference ::" + info["name"])
        }
        rv = js_ktfget(info["recv"], info["name"])
    }

    // A KClass receiver.
    if (ktIsClassLit(rv)) {
        if (name == "isInstance") { return k4IsType(k4At(as, 0), ktRender(rv["kname"])) }
        if (name == "toString") { return ktRender(rv) }
        if (name == "equals") { return k4RefEq(rv, k4At(as, 0)) }
        fail("method ." + name + "() of a class literal")
        return undefined
    }

    // A QUALIFIED stdlib call - kotlin.math.abs(-3). The receiver is a package
    // handle and the member is the same global function the bare spelling reaches;
    // a call is a METHOD call in the tree, so it never passes through js_ktfget.
    if (ktIsPkg(rv)) {
        var pf = ktPkgMember(rv["__pkg"], name)
        if (!k4Fn(pf)) { fail("not a function: " + rv["__pkg"] + "." + name) }
        return pf.apply(undefined, as)
    }

    // The SCOPE FUNCTIONS first: let/run/apply/also/takeIf/takeUnless are
    // extensions on Any, so no receiver branch below owns them. A class member of
    // the same name still wins (ktScopeMethod declines then).
    var sv = ktScopeMethod(rv, name, as)
    if (!ktMiss(sv)) { return sv }

    // kotlin.hashCode() and kotlin.toString() are extensions on Any?, so a NULL
    // receiver answers them rather than throwing.
    if (k4Nullish(rv)) {
        if (name == "hashCode") { return 0 }
        if (name == "toString") { return "null" }
    }

    // An ENUM descriptor: values() / valueOf(name) / entries.
    var ev = ktEnumMethod(rv, name, as)
    if (!ktMiss(ev)) { return ev }

    // A BOOLEAN receiver owns hashCode/toString/not/equals/compareTo - none of
    // which any branch below claims.
    if (typeof rv == "boolean") {
        if (name == "hashCode") {
            if (rv) { return 1231 }
            return 1237
        }
        if (name == "toString") {
            if (rv) { return "true" }
            return "false"
        }
        if (name == "not") { return !rv }
        if (name == "equals") {
            var ob = k4At(as, 0)
            if (typeof ob != "boolean") { return false }
            return ob === rv
        }
        if (name == "compareTo") {
            var oc = k4At(as, 0)
            if (oc !== true) { oc = false }
            if (rv === oc) { return 0 }
            if (rv) { return 1 }
            return -1
        }
    }

    var nv = ktNumMethod(rv, name, as)
    if (!ktMiss(nv)) { return nv }

    if (ktIsChar(rv)) {
        var cv = ktCharMethod(rv, name, as)
        if (!ktMiss(cv)) { return cv }
    }

    if (ktIsArr(rv)) {
        var lv = ktSeqMethod(rv, name, as)
        if (!ktMiss(lv)) { return lv }
    }

    if (ktIsObj(rv)) {
        if (ktIsSb(rv)) {
            var bv = ktSbMethod(rv, name, as)
            if (!ktMiss(bv)) { return bv }
        }
        if (ktIsSet(rv)) {
            var stv = ktSetMethod(rv, name, as)
            if (!ktMiss(stv)) { return stv }
        }
        if (rtIsDictObj(rv)) {
            var mv = ktMapMethod(rv, name, as)
            if (!ktMiss(mv)) { return mv }
        } else {
            if (ktIsResult(rv)) {
                var rrv = ktResultMethod(rv, name, as)
                if (!ktMiss(rrv)) { return rrv }
            } else {
                if (rv["__lazy"] === true) {
                    if (name == "getValue") { return ktLazyValue(rv) }
                    if (name == "value") { return ktLazyValue(rv) }
                    if (name == "isInitialized") { return rv["done"] }
                } else {
                    if (k4IsJob(rv)) {
                        // The Job / Deferred an `async` or `launch` answers.
                        var jv = ktJobMethod(rv, name)
                        if (!ktMiss(jv)) { return jv }
                    } else {
                        if (ktIsPair(rv)) {
                            var pv = k4PairMethod2(rv, name, as)
                            if (!ktMiss(pv)) { return pv }
                        }
                    }
                }
            }
        }
    }

    if (typeof recv == "string") {
        // A pattern argument belongs to the Regex dispatcher: `s.contains(re)` is a
        // regex search, `s.contains("B")` is a substring test.
        var pat = false
        if (as.length > 0) { pat = ktRxIsRegex(as[0]) }
        var svv = ktStrMethod(recv, name, as)
        if (!ktMiss(svv)) {
            if (!pat) { return svv }
        }
    }

    // SAM CONVERSION: `Op43 { it + 100 }` on a `fun interface` builds an instance
    // whose single abstract member is carried as a FIELD holding the lambda. The
    // field is answered here, and only when the chain does NOT declare the name: a
    // real method always wins. It is applied WITHOUT the receiver.
    if (ktIsObj(rv)) {
        if (rv["__class"] !== undefined) {
            if (k4Own(rv, name)) {
                var fv = rv[name]
                if (k4Fn(fv)) {
                    if (!ktClassChainHas(rv, name)) { return fv.apply(undefined, as) }
                }
            }
            // Every Kotlin class inherits equals() from Any. A class that overrides
            // it has it on the chain and is dispatched below; one that does not used
            // to ABORT with "unknown method 'equals' on an instance".
            if (name == "equals") {
                if (!ktClassChainHas(rv, "equals")) { return ktIdent(rv, k4At(as, 0)) }
            }
        }
    }

    // js_rxktmcall: the Regex / MatchResult surface, plus the String members that
    // take a Regex. ktRxMethod carries its own applicability guard.
    var xv = ktRxMethod(rv, name, as)
    if (!ktMiss(xv)) { return xv }

    return k4BaseMcall(rv, name, as)
}

// ktRefRecv (jsrtkotlin.go:5790).
function k4RefRecv(info, args) {
    if (info["bound"] === true) { return info["recv"] }
    if (args.length > 0) { return args[0] }
    return null
}

// ktRefRest (jsrtkotlin.go:5800).
function k4RefRest(info, args) {
    if (info["bound"] === true) { return args }
    if (args.length == 0) { return args }
    return k4Rest(args, 1)
}

// ktRefEq (jsrtkotlin.go:5902): two BOUND references are equal when they name the
// same member of the same receiver, and two class literals when they name the same
// class.
function k4RefEq(l, r) {
    var li = ktRefOf(l)
    var ri = ktRefOf(r)
    var lIsRef = k4IsRef(li)
    var rIsRef = k4IsRef(ri)
    if (lIsRef || rIsRef) {
        if (!lIsRef) { return false }
        if (!rIsRef) { return false }
        if (li["name"] !== ri["name"]) { return false }
        if (li["bound"] !== ri["bound"]) { return false }
        if (li["ctor"] !== ri["ctor"]) { return false }
        if (li["tname"] !== ri["tname"]) { return false }
        return li["recv"] === ri["recv"]
    }
    var lIsCls = ktIsClassLit(l)
    var rIsCls = ktIsClassLit(r)
    if (lIsCls || rIsCls) {
        if (!lIsCls) { return false }
        if (!rIsCls) { return false }
        return l["kname"] === r["kname"]
    }
    return false
}

// ============================================================================
// THE EXPORTS
// ============================================================================

// js_ktsmcall (jsrtkotlin.go:1119).
function js_ktsmcall(recv, name, args) { return ktSmcall(recv, name, args) }

// ktLateinitCheck (jsrtkotlin.go:202): a `lateinit var` that is still null has NOT
// been assigned, and Kotlin throws rather than answering null.
function k4LateinitCheck(o, name, v) {
    if (!k4Nullish(v)) { return v }
    if (!ktIsObj(o)) { return v }
    var cls = o["__class"]
    var guard = 0
    while (guard < 64) {
        guard = guard + 1
        if (!ktIsObj(cls)) { guard = 99 } else {
            var li = cls["__lateinit"]
            if (ktIsObj(li)) {
                if (li[name] === true) {
                    ktRaise("UninitializedPropertyAccessException",
                        "lateinit property " + name + " has not been initialized")
