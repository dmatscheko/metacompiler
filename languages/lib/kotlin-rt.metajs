        if (v) { return 1231 }
        return 1237
    }
    if (ktIsNullish(v)) { return 0 }
    if (floIs(v)) {
        // java.lang.Double.hashCode, not the truncated value - see ktDblHash.
        return ktDblHash(floNum(v))
    }
    if (sintIs(v)) {
        if (sintWidth(v) == 64) { return sintLo(v) ^ sintHi(v) }
        return sintLo(v) | 0
    }
    if (typeof v == "number") { return k0Wrap32(Math.trunc(v)) }
    // A NESTED collection hashes element-wise, exactly as kHash does in the other
    // half.
    if (ktIsArr(v)) {
