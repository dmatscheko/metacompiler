function k6ExtBinds(r, name, tys) {
    if (rtIsNil(r)) { return false }
    if (ktIsObj(r) && r["__class"] !== undefined && r["__class"] !== null) {
        if (k4Own(r, name) || ktClassChainHas(r, name)) { return true }
    } else {
        if (k4IsBuiltinRecv(r) && !k4BuiltinLacks(r, name)) { return true }
    }
    var i = 0
    while (i < tys.length) {
        var ty = tys[i]
        if (ty.length > 0 && ty.charAt(0) == "*") {
            if (ty.length == 1) { return true }
            if (k4IsBuiltinRecv(r) && ty.substring(1).indexOf(k4BuiltinKind(r)) >= 0) { return true }
        } else {
