// A list of Char boxes back to the text it came from.
function k4CharsStr(a) {
    var out = ""
    var i = 0
    while (i < a.length) {
        out = out + k2ChStr(ktCharCode(a[i]))
        i = i + 1
    }
    return out
}

// k2TrimIndent is ktTrimIndent (jsrtkotlin.go:2423) - kotlin.text.trimIndent:
// drop a leading and a trailing BLANK line, then remove the common indent of
// every non-blank line. The twin is kTrimIndent in kotlin-interpreter.abnf.
// The Go twin measures the indent and the slice in BYTES; this measures UTF-16
// code units. The prefix scanned is only spaces and tabs, so the two agree
// wherever the indent itself is what is being cut, which is every call.
function k2TrimIndent(s) {
    var lines = k2Split(s, "\n")
    var lo = 0
    var hi = lines.length
    var go = true
    while (go && lo < hi) {
        if (k2TrimSpace(lines[lo]).length == 0) { lo = lo + 1 } else { go = false }
    }
    go = true
    while (go && hi > lo) {
        if (k2TrimSpace(lines[hi - 1]).length == 0) { hi = hi - 1 } else { go = false }
    }
    var ind = -1
    var i = lo
    while (i < hi) {
        var l = lines[i]
        if (k2TrimSpace(l).length != 0) {
            var k = 0
            var scan = true
            while (scan && k < l.length) {
                var c = l.charCodeAt(k)
                if (c == 32 || c == 9) { k = k + 1 } else { scan = false }
            }
            if (ind < 0 || k < ind) { ind = k }
        }
        i = i + 1
    }
    if (ind < 0) { ind = 0 }
    var out = ""
    var j = lo
    while (j < hi) {
        if (j > lo) { out = out + "\n" }
        var t = lines[j]
        if (t.length >= ind) { out = out + t.substring(ind, t.length) } else { out = out + k2TrimLeftCut(t) }
        j = j + 1
    }
    return out
}

// ------------------------------------------------------ String -> number, %s
//
// ktParseNum and ktFormat belong to the numeric section by subject, but are
// reached only from k2StrMethod2's toInt / toDouble / format arms, so they are
// carried here under the k2 prefix.

// k2ParseNum is ktParseNum: toInt() / toLong() / toDouble() / toFloat() on a
// String and their OrNull forms. Kotlin throws a NumberFormatException for text
// that is not a number, with java.lang's message; the OrNull forms answer null.
// The integer forms are Integer.parseInt / Long.parseLong (no trimming, out of
// range is an error), the floating ones Double.parseDouble (k2JavaFloat). Twin of
// kParseNum in languages/kotlin-interpreter.abnf.
function k2ParseNum(s, name) {
    var orNull = name == "toIntOrNull" || name == "toLongOrNull" || name == "toDoubleOrNull" || name == "toFloatOrNull"
    if (name == "toDouble" || name == "toFloat" || name == "toDoubleOrNull" || name == "toFloatOrNull") {
        var jf = k2JavaFloat(s, name == "toFloat" || name == "toFloatOrNull")
        if (!jf.ok) {
            if (orNull) { return null }
            if (jf.empty) { ktRaise("NumberFormatException", "empty String") }
            ktRaise("NumberFormatException", "For input string: \"" + s + "\"")
        }
        if (name == "toFloat" || name == "toFloatOrNull") { return flo(rtF32Round(jf.v), 3) }
        return flo(jf.v, 0)
    }
    var long = name == "toLong" || name == "toLongOrNull"
    var neg = false
    var body = s
    if (k2StartsWith(body, "-")) {
        neg = true
        body = body.substring(1, body.length)
    } else if (k2StartsWith(body, "+")) {
        body = body.substring(1, body.length)
    }
    var bad = body.length == 0
    var ascii = ""
    var i = 0
    while (!bad && i < body.length) {
        var dv = k2DecDigit(body.charCodeAt(i))
        if (dv < 0) { bad = true } else { ascii = ascii + String.fromCharCode(48 + dv) }
        i = i + 1
    }
