    if (name == "size") { return keys.length }
    if (name == "isEmpty") { return keys.length == 0 }
    if (name == "isNotEmpty") { return keys.length > 0 }
    if (k3IsMapView(name)) {
        // Map.keys is a SET in Kotlin (java.util.Map.keySet), Map.values a
        // Collection, Map.entries a SET of entries - and Map.toList is a LIST of
        // PAIRS, which is why they do not share one branch.
        if (name == "keys") { return k3SetOfDistinct(keys) }
        if (name == "values") { return k3Copy(vals) }
        if (name == "entries") { return k3SetOfDistinct(ktElems(m)) }
