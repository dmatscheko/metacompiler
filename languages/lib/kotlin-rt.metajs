    if (name == "isDigit") { return jcIsDigit(r) }
    if (name == "isLetterOrDigit") { return jcIsLetter(r) || jcIsDigit(r) }
    if (name == "isWhitespace") { return k2IsSpace(r) }
    if (name == "isUpperCase") { return jcIsUpper(r) }
    if (name == "isLowerCase") { return jcIsLower(r) }
