        if (di < 0 || delim.length == 0) { return miss }
        if (name == "substringBefore" || name == "substringBeforeLast") { return s.substring(0, di) }
        return s.substring(di + delim.length, s.length)
    }
    if (name == "ifEmpty") {
        if (s.length == 0) { return ktCall(k2Arg(args, 0), []) }
        return s
    }
    if (name == "ifBlank") {
        if (k2TrimSpace(s).length == 0) { return ktCall(k2Arg(args, 0), []) }
        return s
    }
    if (name == "capitalize" || name == "replaceFirstChar") {
        if (s.length == 0) { return s }
        var c0 = k2CodePointAt(s, 0)
        var rest = s.substring(k2ChStr(c0).length, s.length)
