    // Everything runs IMMEDIATELY and to completion on the calling thread: the
    // RESULTS are right and the ORDERING is not.
    var coro = false
    if (name == "runBlocking") { coro = true }
    if (name == "coroutineScope") { coro = true }
    if (name == "supervisorScope") { coro = true }
    if (name == "withContext") { coro = true }
    if (coro) {
