// ------------------------------------------------------ the StringBuilder box

// ktMakeSb is jsrtkotlin.go:4888 - the StringBuilder box {__sb: true, s: "..."},
// the same shape kotlin-interpreter.abnf builds.
function ktMakeSb(s) { return {__sb: true, s: s} }

// ktIsSb is jsrtkotlin.go:4895.
function ktIsSb(v) {
    if (v === undefined || v === null) { return false }
    if (typeof v != "object") { return false }
    if (Array.isArray(v)) { return false }
    return v["__sb"] === true
}

// ktSbText is jsrtkotlin.go:4904.
function ktSbText(o) {
    var s = o["s"]
    if (typeof s != "string") { return "" }
    return s
}

// ktSbMethod is jsrtkotlin.go:4912 - the StringBuilder member surface, the Go
// twin of the `target.__sb` branch of `mcall` in kotlin-interpreter.abnf. A name
// it does not know falls through to the String methods on the accumulated text,
// exactly as there.
function ktSbMethod(o, name, args) {
    if (name == "append" || name == "appendLine") {
        var s = ktSbText(o)
        var i = 0
        while (i < args.length) {
            s = s + k2Str2(args[i])
            i = i + 1
        }
        if (name == "appendLine") { s = s + "\n" }
        o["s"] = s
        return o
    }
    if (name == "toString") { return ktSbText(o) }
    // CharSequence.length counts UTF-16 units, as String's does.
    if (name == "length") { return ktSbText(o).length }
    if (name == "isEmpty") { return ktSbText(o).length == 0 }
    if (name == "isNotEmpty") { return ktSbText(o).length > 0 }
    if (name == "clear") {
        o["s"] = ""
        return o
    }
    if (name == "reverse") {
        o["s"] = ktRevText(ktSbText(o))
        return o
    }
    // insert / deleteCharAt / setLength with java.lang.StringBuilder's bounds
    // checks (jsrtkotlin.go ktSbMethod).
    if (name == "insert" || name == "deleteCharAt" || name == "setLength") {
        var t = ktSbText(o)
        var n = t.length
        var x = k2Int(ktArg(args, 0))
        if (name == "insert" && (x < 0 || x > n)) {
            ktRaise("StringIndexOutOfBoundsException", "Range [" + x + ", " + n + ") out of bounds for length " + n)
        }
        if (name == "deleteCharAt" && (x < 0 || x >= n)) {
            ktRaise("StringIndexOutOfBoundsException", "Index " + x + " out of bounds for length " + n)
        }
        if (name == "setLength" && x < 0) { ktRaise("StringIndexOutOfBoundsException", "String index out of range: " + x) }
        if (name == "insert") {
            o["s"] = t.substring(0, x) + k2Str2(ktArg(args, 1)) + t.substring(x, n)
