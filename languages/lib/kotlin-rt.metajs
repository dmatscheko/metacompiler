        if (floStyle(v) == 3) { return t == "Float" }
        return t == "Double"
    }
    if (sintIs(v)) {
        if (t == "Any") { return true }
        if (t == "Comparable") { return true }
        if (t == "Number") { return !k4Unsigned(v) }
        return t == ktBoxTypeName(v)
    }
