// js_ktextrecv (jsrtkotlin.go's js_ktextrecv, which has the rules): the implicit
// receiver an unqualified call of the extension name `name` binds, or undefined.
function js_ktextrecv(env, name, tys) {
    var s = anytype
    s = env
    while (s !== undefined && s !== null) {
        if (scopeHas(s, name)) { return undefined }
        s = scopeParent(s)
    }
    s = env
    while (s !== undefined && s !== null) {
        if (scopeHas(s, "this")) {
            if (k6ExtBinds(scopeGet(s, "this"), name, tys)) { return scopeGet(s, "this") }
        }
        s = scopeParent(s)
    }
    s = env
    while (s !== undefined && s !== null) {
        if (scopeHas(s, "__dispatch")) {
            if (k6ExtBinds(scopeGet(s, "__dispatch"), name, tys)) { return scopeGet(s, "__dispatch") }
            s = undefined
        } else {
            s = scopeParent(s)
        }
    }
    var i = ktRecvStack.length - 1
    while (i >= 0) {
