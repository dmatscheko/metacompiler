// The floor's own tag 14 arithmetic (jf_arith in languages/lib/runtime.c), which
// knows nothing about a float width: the style is jf_style_of's left-preferring
// one and there is no rounding step. k1FloFix applies the Kotlin width rule on
// top of it. Code 5 is the "unknown operator answers +0.0" arm no branch takes.
function k1JvmArithRaw(op, l, r) {
    var code = 5
    if (op == "+") { code = 0 }
    else if (op == "-") { code = 1 }
    else if (op == "*") { code = 2 }
    else if (op == "/") { code = 3 }
    else if (op == "%") { code = 4 }
    return floOp(code, k1FloOperand(l), k1FloOperand(r))
