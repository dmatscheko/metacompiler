// and never reach isTypeName; a QUALIFIED type name (`is Shape.Circle`) retries
// with the simple name, which is the convention this subset applies to packages
// and imports.
function k4IsType(v, tname) {
    var t = tname
    var lt = t.indexOf("<")
    if (lt >= 0) { t = t.substring(0, lt) }
    var qt = t
    var opt = false
    if (t.length > 0) {
        if (t.charAt(t.length - 1) == "?") {
            t = t.substring(0, t.length - 1)
            opt = true
        }
    }
    if (floIs(v)) {
        if (t == "Any") { return true }
        if (t == "Comparable") { return true }
        if (t == "Number") { return true }
