        return function (v) { return k4Abs(v) }
    }
    if (name == "max") { return k4MinMax(true) }
    if (name == "maxOf") { return k4MinMax(true) }
    if (name == "min") { return k4MinMax(false) }
    if (name == "minOf") { return k4MinMax(false) }
    if (k4IsContractName(name)) {
