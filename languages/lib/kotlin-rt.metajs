// jsrtkotlin.go ktCmp (293). At the PROMOTED width, because sintCmp on its own
// compares at the widest operand's width and `val b: Byte = 5; b < 1000` would
// truncate 1000 into a byte.
function k1Cmp(op, l, r) {
    var wu = ktWU(l, r)
    var c = sintCmp(sintConv(k1Val(l), wu.w, wu.u), sintConv(k1Val(r), wu.w, wu.u))
    if (op == "<") { return c < 0 }
    if (op == ">") { return c > 0 }
    if (op == "<=") { return c <= 0 }
    if (op == ">=") { return c >= 0 }
    if (op == "==") { return c == 0 }
    return c != 0
}

// jsrtkotlin.go ktFloNarrow (330). Double.toInt() is the JVM's d2i and
// Double.toLong() its d2l: both SATURATE at the target's range and answer 0 for
// NaN, and a target narrower than 32 bits goes through the 32 bit one first.
// Answers a VALUE whose 64 bit reading is the Go twin's int64 - the caller hands
// it straight to ktNorm.
function k1FloNarrow(f, w, u) {
    if (f !== f) { return 0 }
    if (u) {
        if (f <= 0) { return 0 }
        if (w == 64) {
            // The bit pattern of ULong.MAX_VALUE, which is -1 read unsigned.
            if (f >= 18446744073709551616) { return 0 - 1 }
            // Below 2^64 the truncation is exact and si_val reduces it mod 2^64
            // the way uint64(math.Trunc(f)) does.
            return Math.trunc(f)
        }
        if (f >= 4294967295) { return 4294967295 }
        return Math.trunc(f)
    }
    if (w == 64) {
        if (f >= 9223372036854775808) { return k1MaxI64() }
        if (f < 0 - 9223372036854775808) { return k1MinI64() }
        return Math.trunc(f)
    }
    if (f >= 2147483648) { return 2147483647 }
    if (f < 0 - 2147483648) { return 0 - 2147483648 }
    return Math.trunc(f)
}

// jsrtkotlin.go ktConv (373): toByte() / toShort() / toInt() / toLong() /
// toUByte() / ... An INTEGRAL source is a pure bit reinterpretation, so
// (-1).toUInt() is 4294967295u; a floating point one saturates first.
function k1Conv(v, w, u) {
    if (floIs(v)) { return ktNorm(k1FloNarrow(floNum(v), w, u), w, u) }
    return ktNorm(k1Val(v), w, u)
}

// jsrtkotlin.go ktDigits (459). The literal's DIGITS travel rather than a
// number, because a double rounds 9223372036854775807 on the way in - and rounds
// it differently under goja and the frozen engine. The accumulator is an
// UNSIGNED 64 bit box, which is the Go twin's uint64: its arithmetic wraps
// identically and ktLitValue's range tests are then unsigned ones.
function k1Digits(s, radix) {
    var acc = sintConv(0, 64, 1)
    var i = 0
    while (i < s.length) {
        var c = s.charCodeAt(i)
        var d = 0 - 1
        if (c >= 48 && c <= 57) { d = c - 48 }
        else if (c >= 97 && c <= 102) { d = c - 97 + 10 }
        else if (c >= 65 && c <= 70) { d = c - 65 + 10 }
