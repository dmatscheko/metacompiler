    if (name == "put" || name == "set") {
        v = null
        i = ktMapFind(keys, f)
        if (i >= 0) { v = vals[i] }
        ktMapPut(m, f, k3Arg(args, 1))
        return v
    }
    if (name == "remove") {
        i = ktMapFind(keys, f)
        if (i < 0) { return null }
        v = vals[i]
