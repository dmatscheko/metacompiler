        return Math.trunc(f)
    }
    if (w == 64) {
        if (f >= 9223372036854775808) { return k1MaxI64() }
        if (f < 0 - 9223372036854775808) { return k1MinI64() }
        return Math.trunc(f)
    }
    if (f >= 2147483648) { return 2147483647 }
    if (f < 0 - 2147483648) { return 0 - 2147483648 }
    return Math.trunc(f)
}

// jsrtkotlin.go ktConv (373): toByte() / toShort() / toInt() / toLong() /
// toUByte() / ... An INTEGRAL source is a pure bit reinterpretation, so
// (-1).toUInt() is 4294967295u; a floating point one saturates first.
function k1Conv(v, w, u) {
    if (floIs(v)) { return ktNorm(k1FloNarrow(floNum(v), w, u), w, u) }
    return ktNorm(k1Val(v), w, u)
}

// jsrtkotlin.go ktDigits (459). The literal's DIGITS travel rather than a
// number, because a double rounds 9223372036854775807 on the way in - and rounds
// it differently under goja and the frozen engine. The accumulator is an
// UNSIGNED 64 bit box, which is the Go twin's uint64: its arithmetic wraps
// identically and ktLitValue's range tests are then unsigned ones.
function k1Digits(s, radix) {
    var acc = sintConv(0, 64, 1)
    var i = 0
    while (i < s.length) {
        var c = s.charCodeAt(i)
        var d = 0 - 1
        if (c >= 48 && c <= 57) { d = c - 48 }
        else if (c >= 97 && c <= 102) { d = c - 97 + 10 }
        else if (c >= 65 && c <= 70) { d = c - 65 + 10 }
        // anything else is a '_' digit separator and is skipped, as is a digit
        // that the radix does not have.
        if (d >= 0 && d < radix) { acc = sintOp(0, sintOp(2, acc, radix), d) }
        i = i + 1
    }
    return acc
}

// jsrtkotlin.go ktLitValue (437). The suffix code is 0 none, 1 L, 2 u/U, 3 uL.
// An unsuffixed literal is an Int when it fits in one and a Long otherwise (so
// 0xFFFFFFFF is a Long 4294967295 here, where Java makes it int -1); a `u`
// literal is a UInt when it fits and a ULong otherwise.
function k1LitValue(acc, sfx) {
    if (sfx == 1) { return ktNorm(acc, 64, 0) }
    if (sfx == 2) {
        if (sintCmp(acc, 4294967295) <= 0) { return ktNorm(acc, 32, 1) }
        return ktNorm(acc, 64, 1)
    }
    if (sfx == 3) { return ktNorm(acc, 64, 1) }
    if (sintCmp(acc, 2147483647) <= 0) { return ktNorm(acc, 32, 0) }
    return ktNorm(acc, 64, 0)
}

// jsrtjvm.go jvmArith (176), the FLOAT half of Kotlin's arithmetic: a double on
// either side makes the whole operation floating point and its result a Double,
// two integral operands keep the 32 bit wrap. floOp IS that function in the
// floor (jf_arith), including the "unknown operator answers +0.0" arm - code 5
// is the one no branch takes.
function k1JvmArith(op, l, r) {
    // The one host call the DOUBLE path pays for the float width: floStyle of a
    // result that is not style 3 is the whole test, because style 3 can only have
    // come off a Float operand.
    var rr = k1JvmArithRaw(op, l, r)
    if (floStyle(rr) == 3) { return k1FloFix(op, rr, l, r) }
    return rr
}

// The floor's own tag 14 arithmetic (jf_arith in languages/lib/runtime.c), which
// knows nothing about a float width: the style is jf_style_of's left-preferring
// one and there is no rounding step. k1FloFix applies the Kotlin width rule on
// top of it. Code 5 is the "unknown operator answers +0.0" arm no branch takes.
function k1JvmArithRaw(op, l, r) {
    var code = 5
    if (op == "+") { code = 0 }
    else if (op == "-") { code = 1 }
    else if (op == "*") { code = 2 }
    else if (op == "/") { code = 3 }
    else if (op == "%") { code = 4 }
    return floOp(code, k1FloOperand(l), k1FloOperand(r))
}

// floOp reads its operands with the floor's to_number, which knows tag 13 (an
// unsigned 64 bit box reads as a MAGNITUDE, which is what a Kotlin ULong is) and
// tag 14, but not the {__char} box.
function k1FloOperand(v) {
    if (ktIsChar(v)) { return ktCharCode(v) }
    return v
}

// ===================================================== the float WIDTH ======
//
// A Kotlin `Float` is a binary32, not a print style: 1.0f/3.0f is 0.33333334
// where the Double is 0.3333333333333333, and every arithmetic result has to be
// rounded back to 24 significant bits. The VALUE still travels as a double
// (every float is exactly one), so the only thing that has to go on the box is
// the WIDTH - and the tag 14 box already has a byte for a per-language print
// tag. STYLE 3 IS THE FLOAT, the same style byte java uses (abnf/jsrtjvm.go's
// floJavaF), because Kotlin/JVM's Float IS java's: the Kotlin specification
// declares Float an IEEE-754 binary32 (kotlin.Float, "single-precision 32-bit"),
// its arithmetic is the JVM's fadd/fmul/fdiv, and Float.toString() delegates to
// java.lang.Float.toString. There is no kotlinc on this machine, so java 24.0.2
// is the oracle for every one of those rows.
//
// WHY THE WIDTH DOES NOT MOVE INTO THE FLOOR, measured rather than preferred.
// languages/lib/runtime.c is compiled by our own c-to-llvm-ir.abnf, and THAT
// DIALECT COMPUTES EVERY `float` AT DOUBLE PRECISION - "a float is computed at
// double precision" in its header, ctF(4) carried in an i64 double, and floating
// arithmetic emitted as soft-float integer code. So the floor cannot spell
// `(float)x` at all: a floor-side rounder would be the SAME `*`/`/`-by-powers-of-
// two loop written a second time in C, plus a shortest-round-trip-at-24-bits
// renderer in C, in a file every one of the sixteen languages links and every
// bench row measures. Layer 2 is therefore where the width stays, and the cost of
// that is stated at both sites: runtime.c's jf_text has NO ARM for style 3 and
// would render a Float with the DOUBLE renderer, so every rendering and every
// arithmetic result of a style 3 box is intercepted HERE before the floor sees it.
//
// Three engines implement this one specification for kotlin: the {__flo,__f32}
// box of languages/kotlin-interpreter.abnf, jsJFlo{sty: floJavaF} in
// abnf/jsrtkotlin.go + abnf/jsrtjvm.go, and this file.

// x * 2^k, EXACTLY - every factor is a power of two, so not one bit is lost. The
// chunking by 2^30 keeps the loop short for the ~280 halvings a subnormal float
// needs.
function k1Scale2(x, k) {
    var v = x
    var n = k
    while (n >= 30) { v = v * 1073741824; n = n - 30 }
    while (n <= 0 - 30) { v = v / 1073741824; n = n + 30 }
    while (n > 0) { v = v * 2; n = n - 1 }
    while (n < 0) { v = v / 2; n = n + 1 }
    return v
}

// k1F32Round is Math.fround: the double nearest x that a binary32 can hold,
// round-half-to-EVEN, with the subnormals and both overflows. It is what the Go
// twin spells `float64(float32(x))` (jvmFround).
//
// It is written on `*` and `/` by powers of two and a floor, because MetaJS has
// no access to a double's BITS - chapter 7.7 of
// docs/working-on-this-project.md, the same argument that keeps d_pow and
// d_frexp in the C floor. The significand is scaled until its unit in the last
// place is 1, rounded there, and scaled back; both scalings are exact, so the
// single rounding is the only one that happens.
function k1F32Round(x) {
    if (x !== x) { return x }
    if (x === 0) { return x }
    var zero = 0
    var inf = 1 / zero
    var neg = x < 0
    var a = neg ? 0 - x : x
    if (a === inf) { return x }
    var maxf = k1Scale2(16777215, 104)
    // 2^128 is above every rounding boundary and 2^-150 is the half-way point
    // below the smallest subnormal (which ties to even, i.e. to zero); both early
    // exits also bound the exponent loop below to ~280 turns.
    if (a >= k1Scale2(1, 128)) { return neg ? 0 - inf : inf }
    if (a <= k1Scale2(1, 0 - 150)) { return neg ? k1NegZero() : 0 }
    var e = 0
    var t = a
    while (t >= 2) { t = t / 2; e = e + 1 }
    while (t < 1) { t = t * 2; e = e - 1 }
    var q = e - 23
    if (q < 0 - 149) { q = 0 - 149 }
    var sc = k1Scale2(a, 0 - q)
    var f = Math.floor(sc)
    var d = sc - f
    if (d > 0.5) { f = f + 1 }
    if (d === 0.5) { if (f - Math.floor(f / 2) * 2 !== 0) { f = f + 1 } }
    var r = k1Scale2(f, q)
    if (r > maxf) { return neg ? 0 - inf : inf }
    if (r === 0) { return neg ? k1NegZero() : 0 }
    return neg ? 0 - r : r
}

// -0.0. `0 - 0.0` is +0.0 and `x * 0` keeps an integral zero, so the working
// spelling is a division - docs/working-on-this-project.md chapter 7.10.
function k1NegZero() { return 0 / (0 - 1) }

// The result style of a binary operation on two float-ish operands. Kotlin
// promotes to the WIDER type exactly as JLS 5.6.2 does - Float.plus(Double)
// answers a Double, Float.plus(Int) a Float - while the floor's jf_style_of
// takes the LEFT operand's style, which gets `Float + Double` backwards.
function k1FloStyle2(l, r) {
    if (floIs(l)) {
        if (floStyle(l) == 3) {
            if (floIs(r)) { return floStyle(r) }
            return 3
        }
        return floStyle(l)
    }
    if (floIs(r)) { return floStyle(r) }
    return 0
}

// The fix-up applied to the floor's own floOp answer. It runs ONLY when that
// answer already claims style 3 - the one host call the Double path pays - and
// style 3 can only come from a Float, because jf_style_of took it off an
// operand. Two things are wrong with the floor's answer then:
//
//   Float op DOUBLE is a Double. jf_style_of takes the LEFT operand's style and
//   gets that pair backwards; the VALUE is already right, since a float widens to
//   a double exactly, so only the box is rebuilt.
//
//   Float op INT converts the Int to a FLOAT FIRST. Rounding only the result is a
//   different answer: `0.1f + 16777217` is 1.6777216E7 and 1.6777218E7 if the Int
//   keeps its exact value into the addition. So the operation is redone on two
//   converted operands.
function k1FloFix(op, rr, l, r) {
    if (floIs(r)) { if (floStyle(r) != 3) { return flo(floNum(rr), floStyle(r)) } }
    var a = flo(k1F32Round(ktNum(l)), 3)
    var b = flo(k1F32Round(ktNum(r)), 3)
    return flo(k1F32Round(floNum(k1JvmArithRaw(op, a, b))), 3)
}

// The same promotion for the RELATIONS: a Float operand converts the other side
// to a Float, so `16777217 < 16777216f` is false. It answers false unless the
// promoted type really is Float, so every Double and every integral pair keeps
// the path it had.
function k1FloPromotes(l, r) {
    if (!floIs(l) && !floIs(r)) { return false }
    if (k1FloStyle2(l, r) != 3) { return false }
    if (!floIs(l) && !k1Integral(l) && !ktIsChar(l)) { return false }
    if (!floIs(r) && !k1Integral(r) && !ktIsChar(r)) { return false }
    return true
}

// ----- Float.toString -------------------------------------------------------
//
// Double.toString's rule read at 24 significant bits: the SHORTEST decimal that
// reads back as the same float, plain for 1e-3 <= |v| < 1e7 and d.dddEnn outside
// it, always a decimal point, never fewer than two significant digits in the
// scientific form.
//
// THE DIGITS COME FROM `"" + a`, NOT FROM floPrec, and that is not a style
// choice. floPrec's two implementations DISAGREE: abnf/commonscript.go answers
// exactly n digits and languages/lib/runtime.c's answers max(n, shortest), so
// floPrec(1/3, 1) is "3e-1" under llvm.Run and "3333333333333333e-1" natively.
// Using it here would be a halves divergence in every float that needs fewer
// digits than its double. `"" + a` is the shortest round-tripping DOUBLE in every
// engine, and rounding that digit string down to n is exact for every n a float
// can want.

// The shortest round-tripping decimal of the double a > 0, as DIGITS "e" EXP,
// EXP being the decimal exponent of the FIRST digit.
function k1DecDigits(a) {
    var s = "" + a
    var mant = s
    var exp = 0
    var ei = 0 - 1
    var i = 0
    while (i < s.length) {
        var c = s.charAt(i)
        if (c == "e") { ei = i }
        if (c == "E") { ei = i }
        i = i + 1
    }
    if (ei >= 0) {
        mant = s.substring(0, ei)
        var et = s.substring(ei + 1)
        if (et.charAt(0) == "+") { et = et.substring(1) }
        exp = parseInt(et, 10)
    }
    var digits = ""
    var pt = 0 - 1
    var j = 0
    while (j < mant.length) {
        var ch = mant.charAt(j)
        if (ch == ".") { pt = digits.length } else { if (ch != "-") { digits = digits + ch } }
        j = j + 1
    }
    if (pt < 0) { pt = digits.length }
    var lead = 0
    while (lead < digits.length - 1 && digits.charAt(lead) == "0") { lead = lead + 1 }
    digits = digits.substring(lead)
    pt = pt - lead
    var endz = digits.length
    while (endz > 1 && digits.charAt(endz - 1) == "0") { endz = endz - 1 }
    digits = digits.substring(0, endz)
    return digits + "e" + (pt + exp - 1)
}

// A DIGITS "e" EXP form rounded to n significant digits, half to even. The source
// is already the shortest form of the value, so a genuine tie can only be a
// decimal the double holds exactly.
function k1RoundDig(s, n) {
    var ei = s.indexOf("e")
    var ds = s.substring(0, ei)
    var ex = parseInt(s.substring(ei + 1), 10)
    if (ds.length <= n) { return s }
    var keep = ds.substring(0, n)
    var nxt = ds.charCodeAt(n) - 48
    var up = false
    if (nxt > 5) { up = true }
    if (nxt == 5) {
        var rest = false
        var i = n + 1
        while (i < ds.length) { if (ds.charCodeAt(i) != 48) { rest = true } i = i + 1 }
        if (rest) { up = true } else {
            var last = ds.charCodeAt(n - 1) - 48
            if (last - Math.floor(last / 2) * 2 == 1) { up = true }
        }
    }
    if (up) {
        var out = ""
        var carry = 1
        var k = n - 1
        while (k >= 0) {
            var dg = ds.charCodeAt(k) - 48 + carry
            carry = 0
            if (dg == 10) { dg = 0; carry = 1 }
            out = "" + dg + out
            k = k - 1
        }
        if (carry == 1) { out = ("1" + out).substring(0, n); ex = ex + 1 }
        keep = out
    }
    var ez = keep.length
    while (ez > 1 && keep.charAt(ez - 1) == "0") { ez = ez - 1 }
    return keep.substring(0, ez) + "e" + ex
}

// The value of a DIGITS "e" EXP form. At most nine digits, so the integer part is
// exact; the power of ten is applied in chunks of 10^15, the largest one a double
// holds exactly. The relative error stays under ~1e-15, five million times finer
// than a float's half-ulp - and the only consumer is the round-trip TEST below,
// so an error that small cannot pick a wrong length.
function k1DecVal(s) {
    var ei = s.indexOf("e")
    var ds = s.substring(0, ei)
    var k = parseInt(s.substring(ei + 1), 10) - ds.length + 1
    var m = 0
    var i = 0
    while (i < ds.length) { m = m * 10 + (ds.charCodeAt(i) - 48); i = i + 1 }
    while (k >= 15) { m = m * 1000000000000000; k = k - 15 }
    while (k <= 0 - 15) { m = m / 1000000000000000; k = k + 15 }
    while (k > 0) { m = m * 10; k = k - 1 }
    while (k < 0) { m = m / 10; k = k + 1 }
    return m
}

// The shortest decimal that round-trips as a binary32. Nine digits always do.
function k1F32Sig(a) {
    var full = k1DecDigits(a)
    var n = 1
    while (n < 9) {
        var c = k1RoundDig(full, n)
        if (k1F32Round(k1DecVal(c)) === a) { return c }
        n = n + 1
    }
    return k1RoundDig(full, 9)
}

function k1F32Str(d) {
    if (d !== d) { return "NaN" }
    var zero = 0
    var inf = 1 / zero
    if (d === inf) { return "Infinity" }
    if (d === 0 - inf) { return "-Infinity" }
    if (d === 0) { if (1 / d < 0) { return "-0.0" } return "0.0" }
    var neg = d < 0
    var a = neg ? 0 - d : d
    var sig = k1F32Sig(a)
    var ei = sig.indexOf("e")
    var ds = sig.substring(0, ei)
    var e10 = parseInt(sig.substring(ei + 1), 10)
    var body = ""
    if (a >= 0.001 && a < 10000000) {
        body = k1F32Plain(ds, e10)
    } else {
        // Never fewer than TWO significant digits, and where the shortest form has
        // one the second is the closest two digit decimal to the ACTUAL value
        // rather than a zero: Float.MIN_VALUE is 1.401298464324817E-45, which
        // prints "1.4E-45" and not "1.0E-45". The same rule, at the same site, as
        // Double.toString's "4.9E-324".
        if (ds.length == 1) {
            var s2 = k1RoundDig(k1DecDigits(a), 2)
            var e2 = s2.indexOf("e")
            ds = s2.substring(0, e2)
            e10 = parseInt(s2.substring(e2 + 1), 10)
        }
        var frac = ds.substring(1)
        if (frac == "") { frac = "0" }
        body = ds.charAt(0) + "." + frac + "E" + e10
    }
    if (neg) { return "-" + body }
    return body
}

// The plain form, from the digits and the exponent of the first one. The forced
// ".0" is here (100.0f is "100.0"); the two-digit minimum is NOT, because it is
// about the significand and only the scientific form shows one.
function k1F32Plain(ds, e10) {
    if (e10 >= 0) {
        var ip = ""
        var i = 0
        while (i <= e10) {
            if (i < ds.length) { ip = ip + ds.charAt(i) } else { ip = ip + "0" }
            i = i + 1
        }
        var fp = "0"
        if (ds.length > e10 + 1) { fp = ds.substring(e10 + 1) }
        return ip + "." + fp
    }
    var lead = "0."
    var k = 0 - e10 - 1
    while (k > 0) { lead = lead + "0"; k = k - 1 }
    return lead + ds
}

// Every rendering of a tag 14 box goes through here, because the floor cannot
// render style 3 (see the section header).
function k1FloText(v) {
    if (floStyle(v) == 3) { return k1F32Str(floNum(v)) }
    return floStr(v)
}

// js_ktflo32 is the one new extern the width needs: a `1.0f` literal and a
// `.toFloat()` both lower to it. Its Go twin is registered in abnf/jsrtkotlin.go.
function js_ktflo32(v) { return flo(k1F32Round(ktNum(v)), 3) }

// jsrtkotlin.go js_ktadoptf32. The FLOAT half of js_ktadoptf: `val f: Float = 1`
// and every other declared-Float binding site.
function js_ktadoptf32(v) {
    if (!k1Integral(v)) { return v }
    return flo(k1F32Round(ktNum(v)), 3)
}


// jsrtint.go giEq (269): two numbers compare by VALUE across the box, and a box
// never equals a non-numeric value.
function k1GiEq(l, r) {
    if (k1Numeric(l) && k1Numeric(r)) {
        if (floIs(l)) { return floNum(l) === ktNum(r) }
        if (floIs(r)) { return floNum(r) === ktNum(l) }
        return sintCmp(sintConv(k1Val(l), 64, 0), sintConv(k1Val(r), 64, 0)) == 0
    }
    return ktIdent(l, r)
}

// jsrtkotlin.go ktNumLess (617): the "<" the coerce family needs - integral
// operands at the promoted width, anything with a Double in it as floating
// point.
function k1NumLess(l, r) {
    if (k1Integral(l) && k1Integral(r)) { return k1Cmp("<", l, r) }
    return ktNum(l) < ktNum(r)
}

// jsrtkotlin.go ktDblHash (584): java.lang.Double.hashCode, which is what
// Kotlin/JVM's Double.hashCode() IS - doubleToLongBits(d) xor (bits ushr 32),
// read as an Int. The Go twin has math.Float64bits; neither MetaJS engine does,
// so the bits are derived arithmetically exactly as kDblHash does it in
// languages/kotlin-interpreter.abnf (6247), which is the twin the cross-check
// diffs against.
function k1DblHash(d) {
    // doubleToLongBits COLLAPSES every NaN to 0x7ff8000000000000.
    if (d !== d) { return 2146959360 }
    if (d === Infinity) { return 2146435072 }
    if (d === 0 - Infinity) { return 0 - 1048576 }
    if (d === 0) {
        if (1 / d < 0) { return 0 - 2147483648 }
        return 0
    }
    var neg = d < 0
    var a = d
    if (neg) { a = -d }
    var e = 0
    while (a >= 2) { a = a / 2; e = e + 1 }
    while (a < 1) { a = a * 2; e = e - 1 }
    var m = 0
    var biased = 0
    if (e < 0 - 1022) {
        // Subnormal: the biased exponent is 0 and there is no implicit leading
        // 1, so the significand scales back down to the fixed exponent -1022.
        var k = (0 - 1022) - e
        var sub = a
        while (k > 0) { sub = sub / 2; k = k - 1 }
        m = sub * 4503599627370496
    } else {
        m = (a - 1) * 4503599627370496
        biased = e + 1023
    }
    var hi20 = Math.floor(m / 4294967296)
    var hi = (biased * 1048576) + hi20
    if (neg) { hi = hi - 2147483648 }
    return ((hi | 0) ^ ((m - (hi20 * 4294967296)) | 0)) | 0
}

// ----- ktNumMethod, OWNED by this section ----------------------------------

// jsrtkotlin.go ktNumMethod (485): the member-function surface of Kotlin's
// number types - the conversions, inv(), and the handful of names a program
// calls on an Int or a Double. KT_MISS when this dispatcher does not handle the
// receiver or the name.
function ktNumMethod(recv, name, args) {
    if (!k1Numeric(recv)) { return KT_MISS }
    if (name == "toByte") { return k1Conv(recv, 8, 0) }
    if (name == "toShort") { return k1Conv(recv, 16, 0) }
    if (name == "toInt") { return k1Conv(recv, 32, 0) }
    if (name == "toLong") { return k1Conv(recv, 64, 0) }
    if (name == "toUByte") { return k1Conv(recv, 8, 1) }
    if (name == "toUShort") { return k1Conv(recv, 16, 1) }
    if (name == "toUInt") { return k1Conv(recv, 32, 1) }
    if (name == "toULong") { return k1Conv(recv, 64, 1) }
    if (name == "toDouble") { return flo(ktNum(recv), 0) }
    // toFloat() NARROWS to a binary32: 0.1.toFloat() prints "0.1" and is a
    // different value from the Double 0.1.
    if (name == "toFloat") { return flo(k1F32Round(ktNum(recv)), 3) }
    // A Char from the low 16 bits, which is Kotlin's Int.toChar().
    if (name == "toChar") { return ktChar(sintNum(sintConv(k1Val(recv), 16, 1))) }
    if (name == "inv") {
        if (sintIs(recv)) {
            var w = sintWidth(recv)
            var u = 0
            if (sintUns(recv)) { u = 1 }
            // ~x is x XOR the all-ones value of the operand's own type.
            return ktNorm(sintOp(7, sintConv(0 - 1, w, u), recv), w, u)
        }
        return ktNorm(0 - k1I32(recv) - 1, 32, 0)
    }
    if (name == "compareTo") {
        var o = k1Arg(args, 0)
        if (k1Integral(recv) && k1Integral(o)) {
            if (k1Cmp("<", recv, o)) { return 0 - 1 }
            if (k1Cmp(">", recv, o)) { return 1 }
            return 0
        }
        var af = ktNum(recv)
        var bf = ktNum(o)
        if (af < bf) { return 0 - 1 }
        if (af > bf) { return 1 }
        return 0
    }
    if (name == "equals") { return k1GiEq(recv, k1Arg(args, 0)) }
    if (name == "coerceAtLeast") {
        var la = k1Arg(args, 0)
        if (k1NumLess(recv, la)) { return la }
        return recv
    }
    if (name == "coerceAtMost") {
        var ma = k1Arg(args, 0)
        if (k1NumLess(ma, recv)) { return ma }
        return recv
    }
    if (name == "coerceIn") {
        var clo = k1Arg(args, 0)
        var chi = k1Arg(args, 1)
        if (!ktIsNullish(clo)) { if (k1NumLess(recv, clo)) { return clo } }
        if (!ktIsNullish(chi)) { if (k1NumLess(chi, recv)) { return chi } }
        return recv
    }
    // isNaN is declared on Double/Float only, so an integral receiver answers
    // false rather than missing.
    if (name == "isNaN") {
        if (!floIs(recv)) { return false }
        return floNum(recv) !== floNum(recv)
    }
    if (name == "hashCode") {
        if (floIs(recv)) { return k1DblHash(floNum(recv)) }
        if (sintIs(recv)) {
            // Long.hashCode is (value xor (value ushr 32)) read as an Int; for
            // every narrower width that is the value itself.
            var h64 = sintConv(recv, 64, 0)
            return k1I32(sintOp(7, h64, sintOp(10, h64, 32)))
        }
        return k1I32(recv)
    }
    return KT_MISS
}

// ----- the declared-type adoption pair, OWNED by this section ---------------

// ----- String.toInt() / toLong() / toDouble(), OWNED by this section --------

// ----- String.format, OWNED by this section --------------------------------

// ----- the externs ----------------------------------------------------------

// jsrtkotlin.go js_ktarith (646). One binary integral operator: (op, left,
// right). A Double operand keeps the FLOAT path, which is where the two boxes
// meet - so mixed Int/Double arithmetic still answers a Double.
function js_ktarith(op, l, r) {
    // `-` on a COLLECTION is kotlin.collections.minus, the twin of the `+`
    // branch in js_ktadd: a list, set or map loses the given element or every
    // element of the given collection.
    if (op == "-") {
        if (ktIsArr(l)) {
            var av = ktSeqMethod(l, "minus", [r])
            if (!ktMiss(av)) { return av }
        } else if (ktIsObj(l)) {
            if (ktIsSet(l)) {
                var sv = ktSetMethod(l, "minus", [r])
                if (!ktMiss(sv)) { return sv }
            } else if (rtIsDictObj(l)) {
                var mv = ktMapMethod(l, "minus", [r])
                if (!ktMiss(mv)) { return mv }
            }
        }
    }
    if (floIs(l) || floIs(r)) { return k1JvmArith(op, l, r) }
    if (!k1Integral(l) || !k1Integral(r)) {
        // `and`/`or`/`xor` on two Booleans are Kotlin's non-short-circuit boolean
        // operators; anything else is not a program kotlinc accepts.
        if (typeof l == "boolean" && typeof r == "boolean") {
            if (op == "&") { return l && r }
            if (op == "|") { return l || r }
            if (op == "^") { return l != r }
        }
        return k1JvmArith(op, l, r)
    }
    return k1Arith(op, l, r)
}

// jsrtkotlin.go js_ktshift (692).
function js_ktshift(op, l, r) { return k1Shift(op, l, r) }

// jsrtkotlin.go js_ktcmp (698). Two integers compare at the promoted width, so a
// Long above 2^53 compares exactly rather than through a rounded double;
// everything else keeps the shared comparison, except that a class declaring
// `operator fun compareTo` answers for itself (Kotlin's comparison convention).
function js_ktcmp(op, l, r) {
    if (k1Integral(l) && k1Integral(r) && !floIs(l) && !floIs(r)) { return k1Cmp(op, l, r) }
    // A Float operand promotes the other side to Float too, so
    // `16777217 < 16777216f` is false - Int.compareTo(Float) compiles to a JVM
    // float comparison. THE INTEGRAL FAST PATH ABOVE STAYS FIRST: `i < 40000` is
    // the whole of tests/bench/mod.kt's loop condition, and asking the float
    // question ahead of it cost java +5.32% when 8f43e84 tried that shape.
    if (k1FloPromotes(l, r)) { return k1F32Rel(op, k1F32Round(ktNum(l)), k1F32Round(ktNum(r))) }
    if (ktIsObj(l)) {
        if (ktClassChainHas(l, "compareTo")) {
            var m = k1FindMember(l, "compareTo")
            if (m !== undefined) {
                var c = Math.trunc(ktNum(ktCall2(m, l, r)))
                if (op == "<") { return c < 0 }
                if (op == ">") { return c > 0 }
                if (op == "<=") { return c <= 0 }
                return c >= 0
            }
        }
    }
    var d = ktCmpVals(l, r)
    if (op == "<") { return d < 0 }
    if (op == ">") { return d > 0 }
    if (op == "<=") { return d <= 0 }
    return d >= 0
}

// The four ordered relations on two values already narrowed to binary32. Written
// out rather than routed back through js_ktcmp, which would re-enter the
// promotion arm forever.
function k1F32Rel(op, a, b) {
    if (op == "<") { return a < b }
    if (op == ">") { return a > b }
    if (op == "<=") { return a <= b }
    return a >= b
}

// jsrtkotlin.go ktpFindMember (2757): a CALLABLE member of this name anywhere on
// the receiver's descriptor chain.
function k1FindMember(o, name) {
    var cls = ktClassOf(o)
    if (cls === undefined) { return undefined }
    if (cls === null) { return undefined }
    var m = ktClsFind(cls, name)
    if (ktIsFn(m)) { return m }
    return undefined
}

// jsrtkotlin.go js_ktadd (735). Kotlin's `+`: string concatenation is decided at
// the emit site, so this is the numeric case plus the COLLECTION case plus the
// fallback the runtime had.
function js_ktadd(l, r) {
    // k1JvmArith, not a hand-rolled add: the float WIDTH needs both operands
    // converted first and the sum rounded after, and the floor's left-operand
    // style rule gets `Float + Double` (which is a Double) backwards.
    if (floIs(l) || floIs(r)) { return k1JvmArith("+", l, r) }
    if (k1Integral(l) && k1Integral(r)) { return k1Arith("+", l, r) }
    // `+` on a COLLECTION is kotlin.collections.plus: a list gains the elements
    // of another collection, or the single element. A SET gains them as a Set,
    // because kotlin.collections.plus is declared on Set separately from Iterable
    // and keeps the receiver's shape.
    if (ktIsArr(l)) {
        var av = ktSeqMethod(l, "plus", [r])
        if (!ktMiss(av)) { return av }
    } else if (ktIsObj(l)) {
        if (ktIsSet(l)) {
            var sv = ktSetMethod(l, "plus", [r])
            if (!ktMiss(sv)) { return sv }
        }
        if (rtIsDictObj(l)) {
            var mv = ktMapMethod(l, "plus", [r])
            if (!ktMiss(mv)) { return mv }
        }
    }
    return k1JsAdd(l, r)
}

// abnf/jsrt.go jsAdd (1124), for the tail of js_ktadd and the fallback of
// js_jadd: the runtime's own `+`, which renders a STRING operand with the
// javaString rule (2523) and is NOT Kotlin's toString - the Go twin reaches this
// only for a pair the emitter did not type as a concatenation.
function k1JsAdd(l, r) {
    if (typeof l == "string" || typeof r == "string") { return k1JStr(l) + k1JStr(r) }
    return ktNum(l) + ktNum(r)
}

// abnf/jsrt.go javaString (2523): toString, with null/undefined as "null".
function k1JStr(v) {
    if (typeof v == "string") { return v }
    if (v === null) { return "null" }
    if (v === undefined) { return "null" }
    if (typeof v == "boolean") { if (v) { return "true" } else { return "false" } }
    if (ktIsChar(v)) { return String.fromCharCode(ktCharCode(v)) }
    if (sintIs(v)) { return sintStr(v) }
    if (floIs(v)) { return k1FloText(v) }
    return "" + v
}

// jsrtkotlin.go js_kteq (774). == where a box may be involved: two callable
// references / class literals compare through ktRefEq, two numbers by VALUE
// across the box, a list/map/Pair STRUCTURALLY, an instance whose class declares
// equals answers for itself, and everything else keeps the runtime's identity.
function js_kteq(l, r) {
    if (sintIs(l) || sintIs(r)) { return k1GiEq(l, r) }
    // Two callable references / class literals, ahead of ktStructEq exactly as in
    // the Go twin; without this arm the comparison falls through to identity and
    // `b::v == b::v` is false. KT_MISS is its handled=false.
    var re = ktRefEq(l, r)
    if (!ktMiss(re)) { return re }
    var se = ktStructEq(l, r)
    if (!ktMiss(se)) { return se }
    if (ktIsObj(l)) {
        var m = k1FindMember(l, "equals")
        if (m !== undefined) {
            if (ktCall2(m, l, r)) { return true }
            return false
        }
    }
    return ktIdent(l, r)
}

// jsrtkotlin.go js_ktne (802).
function js_ktne(l, r) {
    if (sintIs(l) || sintIs(r)) { return !k1GiEq(l, r) }
    var re = ktRefEq(l, r)
    if (!ktMiss(re)) { return !re }
    var se = ktStructEq(l, r)
    if (!ktMiss(se)) { return !se }
    if (ktIsObj(l)) {
        var m = k1FindMember(l, "equals")
        if (m !== undefined) {
            if (ktCall2(m, l, r)) { return false }
            return true
        }
    }
    return !ktIdent(l, r)
}

// jsrtkotlin.go js_ktadopt (830). A DECLARED integral type applied to its
// initializer. Kotlin has no implicit conversions, so this only ever sees the one
// case the language does allow - an integer LITERAL typed by its expectation,
// `val x: Long = 1` - and a non-integral value passes through untouched.
function js_ktadopt(v, bits, uns) {
    if (!k1Integral(v)) { return v }
    var u = 0
    if (uns) { u = 1 }
    return k1Conv(v, Math.trunc(ktNum(bits)), u)
}

// jsrtkotlin.go js_ktadoptf (841). The float half of the same rule: `val d:
// Double = 1` takes the expected type, and without this the value stayed an Int
// and printed "1" where Kotlin prints "1.0".
function js_ktadoptf(v) {
    if (!k1Integral(v)) { return v }
    return flo(ktNum(v), 0)
}

// jsrtkotlin.go js_ktlit (849). An integer literal, passed as DIGITS:
// (text, radix, suffix code).
function js_ktlit(text, radix, sfx) {
    var s = "" + text
    return k1LitValue(k1Digits(s, Math.trunc(ktNum(radix))), Math.trunc(ktNum(sfx)))
}

// jsrtkotlin.go js_ktneg (856). -x. A Double negates as a Double; a Long stays a
// Long; a Byte, a Short and a Char promote to Int, because that is what Kotlin's
// unaryMinus returns.
function js_ktneg(v) {
