        return k2ChStr(k2Upper(c0)) + rest
    }
    if (name == "decapitalize") {
        if (s.length == 0) { return s }
        var d0 = k2CodePointAt(s, 0)
        return k2ChStr(k2Lower(d0)) + s.substring(k2ChStr(d0).length, s.length)
    }
    if (name == "subSequence") {
        return s.substring(k2Int(k2Arg(args, 0)), k2Int(k2Arg(args, 1)))
    }
    if (name == "trimIndent") { return k2TrimIndent(s) }

    // Everything a String shares with a List of Char - map/filter/forEach/any/
    // all/count/fold/joinToString/... - goes through the collection surface.
    var sv = ktSeqMethod(ktChars(s), name, args)
    if (!ktMiss(sv)) { return sv }
    return KT_MISS
}

// k2TrimIndent is ktTrimIndent (jsrtkotlin.go:2423) - kotlin.text.trimIndent:
// drop a leading and a trailing BLANK line, then remove the common indent of
// every non-blank line. The twin is kTrimIndent in kotlin-interpreter.abnf.
// The Go twin measures the indent and the slice in BYTES; this measures UTF-16
// code units. The prefix scanned is only spaces and tabs, so the two agree
// wherever the indent itself is what is being cut, which is every call.
function k2TrimIndent(s) {
    var lines = k2Split(s, "\n")
    var lo = 0
    var hi = lines.length
    var go = true
    while (go && lo < hi) {
        if (k2TrimSpace(lines[lo]).length == 0) { lo = lo + 1 } else { go = false }
    }
    go = true
    while (go && hi > lo) {
        if (k2TrimSpace(lines[hi - 1]).length == 0) { hi = hi - 1 } else { go = false }
    }
    var ind = -1
    var i = lo
    while (i < hi) {
        var l = lines[i]
        if (k2TrimSpace(l).length != 0) {
            var k = 0
            var scan = true
            while (scan && k < l.length) {
                var c = l.charCodeAt(k)
                if (c == 32 || c == 9) { k = k + 1 } else { scan = false }
            }
            if (ind < 0 || k < ind) { ind = k }
        }
        i = i + 1
    }
    if (ind < 0) { ind = 0 }
    var out = ""
    var j = lo
    while (j < hi) {
        if (j > lo) { out = out + "\n" }
        var t = lines[j]
        if (t.length >= ind) { out = out + t.substring(ind, t.length) } else { out = out + k2TrimLeftCut(t) }
        j = j + 1
    }
    return out
}

// ------------------------------------------------------ String -> number, %s
//
// ktParseNum (jsrtkotlin.go:2459) and ktFormat (2502) sit BETWEEN the two
// functions this section was given (ktTrimIndent at 2423 and ktStr2 at 2579)
// and belong to the numeric section by subject. They are reached only from
// k2StrMethod2's toInt / toDouble / format arms, so they are carried here under
// the k2 prefix rather than left as a hole: a name collision is impossible and
// a duplicated body is the safe failure.

// k2ParseNum is ktParseNum: toInt() / toLong() / toDouble() / toIntOrNull() on
// a String. Kotlin throws a NumberFormatException for text that is not a
// number, and java.lang's message is the one both halves report.
function k2ParseNum(s, name) {
    var t = k2TrimSpace(s)
    if (name == "toDouble") {
        // The Go twin is fmt.Sscanf(t, "%g", &f), which accepts a numeric PREFIX
        // ("1.5abc" is 1.5) and the words NaN / Inf, and errors on empty input.
        // parseFloat has the same prefix rule, so only the word forms and the
        // empty case are spelled out.
        if (t.length == 0) { ktRaise("NumberFormatException", "For input string: \"" + s + "\"") }
        if (t == "NaN" || t == "+NaN" || t == "-NaN") { return flo(0 / 0, 0) }
        var f = parseFloat(t)
        if (f !== f) { ktRaise("NumberFormatException", "For input string: \"" + s + "\"") }
        return flo(f, 0)
    }
    var neg = false
    var body = t
    if (k2StartsWith(body, "-")) {
        neg = true
        body = body.substring(1, body.length)
    } else if (k2StartsWith(body, "+")) {
        body = body.substring(1, body.length)
    }
    if (body.length == 0) {
        if (name == "toIntOrNull") { return null }
        ktRaise("NumberFormatException", "For input string: \"" + s + "\"")
    }
    var acc = 0
    var i = 0
    while (i < body.length) {
        var c = body.charCodeAt(i)
        if (c < 48 || c > 57) {
            if (name == "toIntOrNull") { return null }
            ktRaise("NumberFormatException", "For input string: \"" + s + "\"")
        }
        acc = acc * 10 + (c - 48)
        i = i + 1
    }
    if (neg) { acc = -acc }
    if (name == "toLong") { return ktNorm(acc, 64, false) }
    return ktNorm(acc, 32, false)
}

// k2Format is ktFormat (jsrtkotlin.go:2502): the subset of java.util.Formatter
// a test program actually writes - %s, %d, %f with an optional precision, %x,
// %% and a width.
//
// The Go twin hands the assembled spec to fmt.Sprintf; the floor's own sprintf
// (runtime.c:3080) supports NO width and NO precision, so the padding is done
// by hand here. The two verbs that are not reproduced are %e and %g: Go's
// scientific formatting has no counterpart the floor can reach, so they fall
// back on the double's own rendering. Nothing in tests/kotlin-test*.kt writes
// either, and the site says so rather than pretending.
function k2Format(f, args) {
    var out = ""
    var ai = 0
    var i = 0
    while (i < f.length) {
        if (f.charAt(i) != "%") {
            out = out + f.charAt(i)
            i = i + 1
            continue
        }
        if (i + 1 < f.length) {
            if (f.charAt(i + 1) == "%") {
                out = out + "%"
                i = i + 2
                continue
            }
        }
        i = i + 1
        var minus = false
        var plus = false
        var zero = false
        var width = 0
        var prec = -1
        var inPrec = false
        var more = true
        while (more && i < f.length) {
            var fc = f.charAt(i)
            if (fc == "-") { minus = true } else if (fc == "+") { plus = true } else if (fc == " ") {
                more = true
            } else if (fc == ",") {
                // The grouping flag is dropped, exactly as the Go twin drops it.
                more = true
            } else if (fc == ".") {
                inPrec = true
                prec = 0
            } else if (fc == "0" && !inPrec && width == 0) { zero = true } else if (fc >= "0" && fc <= "9") {
                var d = f.charCodeAt(i) - 48
                if (inPrec) { prec = prec * 10 + d } else { width = width * 10 + d }
            } else { more = false }
            if (more) { i = i + 1 }
        }
        if (i >= f.length) { break }
        var verb = f.charAt(i)
        var a = anytype
        a = undefined
        if (ai < args.length) { a = args[ai] }
        ai = ai + 1
        var txt = anytype
        txt = ""
        if (verb == "s") {
            txt = k2Render(a, 0)
            if (prec >= 0 && txt.length > prec) { txt = txt.substring(0, prec) }
            out = out + k2Pad(txt, width, minus, false)
        } else if (verb == "d") {
            txt = k2IntText(a)
            if (plus && !k2StartsWith(txt, "-")) { txt = "+" + txt }
            out = out + k2PadNum(txt, width, minus, zero)
        } else if (verb == "f") {
            var p = prec
            if (p < 0) { p = 6 }
            txt = k2Fixed(ktNum(a), p)
            if (plus && !k2StartsWith(txt, "-")) { txt = "+" + txt }
            out = out + k2PadNum(txt, width, minus, zero)
        } else if (verb == "e" || verb == "g") {
            // NOT Go's %e / %g. See the header note.
            txt = k2Render(flo(ktNum(a), 0), 0)
            out = out + k2Pad(txt, width, minus, false)
        } else if (verb == "x" || verb == "X" || verb == "o") {
            var base = 16
            if (verb == "o") { base = 8 }
            txt = k2BaseText(a, base, verb == "X")
            out = out + k2PadNum(txt, width, minus, zero)
        } else if (verb == "c") {
            if (ktIsChar(a)) { txt = k2ChStr(ktCharCode(a)) } else { txt = k2Render(a, 0) }
            out = out + k2Pad(txt, width, minus, false)
        } else if (verb == "b") {
            // Go's %t of rt.truthy(a).
            if (k2Truthy(a)) { txt = "true" } else { txt = "false" }
            out = out + k2Pad(txt, width, minus, false)
        } else {
            out = out + verb
            ai = ai - 1
        }
        i = i + 1
    }
    return out
}

function k2Pad(s, width, minus, zero) {
    var out = s
    while (out.length < width) {
        if (minus) { out = out + " " } else if (zero) { out = "0" + out } else { out = " " + out }
    }
    return out
}

// A numeric field pads with zeros AFTER the sign, which is what Go's %0Nd does.
function k2PadNum(s, width, minus, zero) {
    if (!zero || minus) { return k2Pad(s, width, minus, false) }
    var sign = ""
    var body = s
    if (k2StartsWith(s, "-") || k2StartsWith(s, "+")) {
        sign = s.substring(0, 1)
        body = s.substring(1, s.length)
    }
    while (sign.length + body.length < width) { body = "0" + body }
    return sign + body
}

// giVal's digits: a sized integer keeps its exact (possibly unsigned) spelling,
// everything else is truncated toward zero.
function k2IntText(v) {
    if (sintIs(v)) { return sintStr(v) }
    if (ktIsChar(v)) { return "" + ktCharCode(v) }
    return "" + k2Int(v)
}

function k2BaseText(v, base, upper) {
    var x = k2Int(v)
    var neg = false
    if (x < 0) {
        neg = true
        x = -x
    }
    if (x == 0) { return "0" }
    var digits = "0123456789abcdef"
    if (upper) { digits = "0123456789ABCDEF" }
    var out = ""
    while (x > 0) {
        var d = x % base
        out = digits.charAt(d) + out
        x = Math.floor(x / base)
    }
    if (neg) { out = "-" + out }
    return out
}

// rt.truthy: everything but null / undefined / false / 0 / "" / NaN.
function k2Truthy(v) {
    if (v === undefined || v === null || v === false) { return false }
    if (v === true) { return true }
    if (typeof v == "string") { return v.length > 0 }
    if (sintIs(v) || floIs(v)) { return ktNum(v) != 0 }
    if (typeof v == "number") { return v != 0 && v === v }
    return true
}

// k2Fixed is ktFixed (jsrtkotlin.go:5688). Java's %f rounds HALF UP, Go's
// Sprintf rounds half to even, so String.format("%5.1f", 1.25) is "  1.3" on
// java (JDK 24) and "  1.2" through Sprintf. This is the twin of kFixed in
// kotlin-interpreter.abnf and gives both halves Java's answer.
function k2Fixed(f, prec) {
    var neg = f < 0
    var x = f
    if (neg) { x = -x }
    var scale = 1
    var i = 0
    while (i < prec) {
        scale = scale * 10
        i = i + 1
    }
    var scaled = Math.floor(x * scale + 0.5)
    var whole = Math.floor(scaled / scale)
    var frac = Math.round(scaled - whole * scale)
    var fs = "" + frac
    while (fs.length < prec) { fs = "0" + fs }
    var out = "" + whole
    if (prec > 0) { out = out + "." + fs }
    if (neg) { out = "-" + out }
    return out
}

// ------------------------------------------------------------ the Char surface

// ktCharMethod is jsrtkotlin.go:3257 - the kotlin.Char member surface. Char is a
// real type here (the {__char} box), not a one-character String, so every one of
// these answers from the CODE rather than from a string.
function ktCharMethod(c, name, args) {
    var r = ktCharCode(c)
    if (name == "code") { return r }
    if (name == "toString") { return k2ChStr(r) }
    if (name == "isLetter") { return k2IsLetter(r) }
    if (name == "isDigit") { return r >= 48 && r <= 57 }
    if (name == "isLetterOrDigit") { return k2IsLetter(r) || (r >= 48 && r <= 57) }
    if (name == "isWhitespace") {
        return r == 32 || r == 9 || r == 10 || r == 13 || r == 12 || r == 11
    }
    if (name == "isUpperCase") { return r >= 65 && r <= 90 }
    if (name == "isLowerCase") { return r >= 97 && r <= 122 }
    if (name == "uppercaseChar") { return ktChar(k2Upper(r)) }
    if (name == "lowercaseChar") { return ktChar(k2Lower(r)) }
    if (name == "uppercase") { return k2ChStr(k2Upper(r)) }
    if (name == "lowercase") { return k2ChStr(k2Lower(r)) }
    if (name == "digitToInt") {
        if (r >= 48 && r <= 57) { return r - 48 }
        fail("Char \"" + k2ChStr(r) + "\" is not a digit")
    }
    if (name == "compareTo") {
        var o = 0
        var a0 = k2Arg(args, 0)
        if (ktIsChar(a0)) { o = ktCharCode(a0) } else { o = k2Int(a0) }
        if (r < o) { return -1 }
        if (r > o) { return 1 }
        return 0
    }
    if (name == "equals") {
        var e0 = k2Arg(args, 0)
        if (ktIsChar(e0)) { return r === ktCharCode(e0) }
        return false
    }
    if (name == "hashCode") { return r }
    // The numeric surface (toInt/toLong/toDouble) reads the code.
    var nv = ktNumMethod(r, name, args)
    if (!ktMiss(nv)) { return nv }
    return KT_MISS
}

// ------------------------------------------------------ the StringBuilder box

// ktMakeSb is jsrtkotlin.go:4888 - the StringBuilder box {__sb: true, s: "..."},
// the same shape kotlin-interpreter.abnf builds.
function ktMakeSb(s) { return {__sb: true, s: s} }

// ktIsSb is jsrtkotlin.go:4895.
function ktIsSb(v) {
    if (v === undefined || v === null) { return false }
    if (typeof v != "object") { return false }
    if (Array.isArray(v)) { return false }
    return v["__sb"] === true
}

// ktSbText is jsrtkotlin.go:4904.
function ktSbText(o) {
    var s = o["s"]
    if (typeof s != "string") { return "" }
    return s
}

// ktSbMethod is jsrtkotlin.go:4912 - the StringBuilder member surface, the Go
// twin of the `target.__sb` branch of `mcall` in kotlin-interpreter.abnf. A name
// it does not know falls through to the String methods on the accumulated text,
// exactly as there.
function ktSbMethod(o, name, args) {
    if (name == "append" || name == "appendLine") {
        var s = ktSbText(o)
        var i = 0
        while (i < args.length) {
            s = s + k2Str2(args[i])
            i = i + 1
        }
        if (name == "appendLine") { s = s + "\n" }
        o["s"] = s
        return o
    }
    if (name == "toString") { return ktSbText(o) }
    // java.lang.StringBuilder#length counts CODE POINTS in the Go twin
    // (len([]rune(...))), not UTF-16 units.
    if (name == "length") { return k2RuneLen(ktSbText(o)) }
    if (name == "isEmpty") { return ktSbText(o).length == 0 }
    if (name == "isNotEmpty") { return ktSbText(o).length > 0 }
    if (name == "clear") {
        o["s"] = ""
        return o
    }
    if (name == "reverse") {
        // Over CODE POINTS, as the Go twin's []rune reversal is - a surrogate
        // pair is not split.
        var t = ktSbText(o)
        var out = ""
        var j = 0
        while (j < t.length) {
            var cp = k2CodePointAt(t, j)
            var w = k2ChStr(cp)
            out = w + out
            j = j + w.length
        }
        o["s"] = out
        return o
    }
    return ktStrMethod(ktSbText(o), name, args)
}

// ============================================================ THE EXTERNS ===

// js_char: Kotlin's Char from its CODE (abnf/jsrt.go:6077). The code arrives as
// a RAW parameter - kotlin-to-llvm-ir.abnf writes it with handle(k), so without
// the _raw suffix the callee would see the handle 0..3, i.e.
// undefined/null/false/true. The Lua pilot's finding.
//
// Unlike Swift, Kotlin HAS a Char type, so this answers the {__char: code} box
// and never a one-character string: languages/kotlin-to-llvm-ir.abnf:3443 feeds
// the result straight into the value model, and js_char_code / js_char_like /
// js_kindex all read that box back.
// js_char itself is SHARED - lib/runtime.metajs; the three copies were the same
// one-line delegation, and the _raw suffix travels with it.

// js_char_code (abnf/jsrt.go:6080): the code of a Char, and rt.toNumber for
// everything else - so a caller can drive a counter with it without knowing
// whether it holds a Char. kotlin-to-llvm-ir.abnf:3553 and :5058 use it exactly
// that way, as a range's numeric bound.
// js_char_code is SHARED - lib/runtime.metajs, as rtkNum, which is exactly this
// body: kotlin's copy was the oracle spelled directly.

// js_char_like (abnf/jsrt.go:6085): box `v` back into a Char when `model` is
// one, else hand `v` back unchanged. This is how a range keeps its element
// type: 'a'..'c' counts numerically and re-boxes each element, so
// `for (ch in 'a'..'c')` yields Chars while `for (i in 1..3)` yields Ints, from
// one emitted loop (kotlin-to-llvm-ir.abnf:3576, :5084).
function js_char_like(model, v) {
    if (ktIsChar(model)) { return ktChar(k2Int(v)) }
    return v
}

// js_kindex (abnf/jsrt.go:6095): Kotlin's indexed read s[i]. A String yields the
// Char at that CODE UNIT index (Kotlin's CharSequence.get), everything else
// reads the member like js_get - a separate extern because plain js_get must
// keep yielding a one-character STRING for JS, Python and the other languages
// that index strings.
//
// The Go twin builds the Char from []rune(strAt(s, i))[0], so a LONE SURROGATE
// - half of an astral pair - becomes U+FFFD. That mapping is reproduced here
// rather than left to the engine, which would hand back the surrogate itself.
// It is the same rule js_kindex carries in languages/lib/swift-rt.metajs.
function js_kindex(s, i) {
    if (typeof s != "string") { return s[i] }
    var idx = k2Int(i)
    if (idx < 0 || idx >= s.length) {
        fail("string index " + idx + " out of range for \"" + s + "\"")
    }
    var c = s.charCodeAt(idx)
    if (c >= 55296 && c <= 57343) { return ktChar(65533) }
    return ktChar(c)
}

// js_ktprint / js_ktwrite (jsrtkotlin.go:1087 / :1093): Kotlin's println / print
// as a VALUE. The extern takes no arguments and returns the host function, which
// buildMain declares into the program scope under the names `println` and
// `print` (kotlin-to-llvm-ir.abnf:7276). Binding a value rather than
// intercepting the call site keeps `::println` and `list.forEach(::println)`
// working, and keeps the shared println host function untouched for the twelve
// other languages that use it.
//
// The Go twin wraps the text in wtf8Clean. That pass only rewrites a WTF-8 lone
// surrogate, and k2ChStr already refuses to put one into a string, so it is a
// no-op here and is not repeated.
function js_ktprint() {
    return function(a) { println(k2Line(a)) }
}

function js_ktwrite() {
    return function(a) { print(k2Line(a)) }
}

// js_ktstr (jsrtkotlin.go:1102): the text of a value - what println writes, what
// "$v" interpolates and what v.toString() answers.
function js_ktstr(v) { return ktRender(v) }
// ============================================================================
// SECTION 3 of languages/lib/kotlin-rt.metajs -- THE COLLECTION LIBRARY
//
// Ported from abnf/jsrtkotlin.go, the authoritative spec (there is no kotlinc on
// this machine, so the Go twin is the only oracle). The Go originals are named
// at each function. Ported CODE, not comments and not what Kotlin "should" do.
//
// Owned and defined here:
//     ktSeqMethod(arr, name, args)    ktSetMethod(s, name, args)
//     ktMapMethod(m, name, args)      ktEnumMethod(recv, name, args)
//     ktSortBy(es, sel, desc)         ktSumOf(es, f)
//     js_ktiter(v)                    the only exported extern in this section
// Private helpers all carry the k3 prefix.
//
// CALLED but NOT defined here: everything in the SHARED CONTRACT (section 0),
// ktRender (section 2), ktSmcall (section 4a) and js_ktis (the `x is T` extern,
// section 4b) -- see the note at k3 filterIsInstance.
//
// MetaJS rules that shape the code (docs/abnf-dialect-gotchas.md): no ASI, so
// every `return` carries its value on the same line and a value-less early
// return is braced; a local keeps the TYPE CLASS it is first assigned, so a slot
// that holds a number in one branch and an object in another is `anytype`; no
// for..in, no splice, `array.length` is not assignable, no split/join, indexOf
// ignores its from-index; `typeof v == "number"` is true for a sized integer AND
// for a boxed double; unary minus is `-x`, never `0 - x`.
// ============================================================================

// ----- small readers -------------------------------------------------------

// k3Arg is Go's argAt: the i-th argument or undefined.
function k3Arg(args, i) {
    if (i < args.length) { return args[i] }
    return undefined
}

// k3Truthy is rt.truthy (abnf/jsrt.go:909) for the value model Kotlin uses: a
// sized integer is falsy at 0, a boxed double at 0.0 and at NaN.
function k3Truthy(v) {
    if (v === undefined) { return false }
    if (v === null) { return false }
    if (v === true) { return true }
    if (v === false) { return false }
    if (floIs(v)) {
        var d = floNum(v)
        if (d !== d) { return false }
        return d != 0
    }
    if (sintIs(v)) { return sintCmp(v, 0) != 0 }
    if (typeof v == "number") {
        if (v !== v) { return false }
        return v != 0
    }
    if (typeof v == "string") { return v.length > 0 }
    return true
}

// k3Str2 is rt.ktStr2 (jsrtkotlin.go:2579): a string is itself, everything else
// renders through ktRender.
function k3Str2(v) {
    if (typeof v == "string") { return v }
    return ktRender(v)
}

// k3StrArg is rt.ktStrArg (jsrtkotlin.go:3355): a Char argument is its glyph.
function k3StrArg(v) {
    if (ktIsChar(v)) { return String.fromCharCode(ktCharCode(v)) }
    return k3Str2(v)
}

// k3Trunc truncates toward zero; NaN reads as 0, which is what giFromFloat does.
function k3Trunc(x) {
    if (x !== x) { return 0 }
    if (x < 0) { return -Math.floor(-x) }
    return Math.floor(x)
}

// k3Int is jsToInt(rt.toNumber(v)) -- the index / size / count reading.
function k3Int(v) { return k3Trunc(ktNum(v)) }

// k3IVal is giVal (abnf/jsrtint.go:105) as a 64 bit box: a box's payload read at
// 64 bits signed, a Char's code, a plain number truncated toward zero.
function k3IVal(v) {
    if (ktIsChar(v)) { return sintConv(ktCharCode(v), 64, 0) }
    if (sintIs(v)) { return sintConv(v, 64, 0) }
    return sintConv(k3Trunc(ktNum(v)), 64, 0)
}

// k3Norm is jsrtkotlin.go's ktNorm spelled with the floor's own primitives: a
// signed 32 bit result is a PLAIN NUMBER, every other width or signedness a box.
function k3Norm(x, w, u) {
    var t = sintConv(x, w, u)
    if (w == 32) {
        if (u == 0) { return sintNum(t) }
    }
    return t
}

// k3I32 is Go's int32(x) wrap, which the hashCode folds need at every step.
function k3I32(x) { return sintNum(sintConv(x, 32, 0)) }

// k3Integral is ktIsIntegral (jsrtkotlin.go:135): an operand of INTEGER
// arithmetic -- a Char is one, a Double is not.
function k3Integral(v) {
    if (ktIsChar(v)) { return true }
    return ktIsInt(v)
}

// k3CmpLt is rt.ktCmp("<", l, r) (jsrtkotlin.go:293): the comparison at the
// PROMOTED width, so a Byte receiver does not truncate a wide argument.
function k3CmpLt(l, r) {
    var wu = ktWU(l, r)
    var a = sintConv(k3IVal(l), wu.w, wu.u)
    var b = sintConv(k3IVal(r), wu.w, wu.u)
    return sintCmp(a, b) < 0
}

// ----- array plumbing ------------------------------------------------------
//
// There is no splice and `array.length` is not assignable, so removal is index
// shifting plus pop() and truncation is a pop loop.

function k3Copy(a) {
    var out = []
    var i = 0
    for (i = 0; i < a.length; i = i + 1) { out.push(a[i]) }
    return out
}

// k3Sub is the Go slice expression es[lo:hi].
function k3Sub(a, lo, hi) {
    var out = []
    var i = 0
    for (i = lo; i < hi; i = i + 1) { out.push(a[i]) }
    return out
}

function k3Clear(a) {
    while (a.length > 0) { a.pop() }
}

// k3Replace is `o.elems = ne` in place, so every alias of the list sees it.
function k3Replace(a, ne) {
    var i = 0
    var tmp = k3Copy(ne)
    k3Clear(a)
    for (i = 0; i < tmp.length; i = i + 1) { a.push(tmp[i]) }
}

function k3RemoveAt(a, ix) {
    var i = 0
    for (i = ix; i + 1 < a.length; i = i + 1) { a[i] = a[i + 1] }
    a.pop()
}

// ----- set / collection helpers --------------------------------------------

// k3SetFrom is rt.ktSetFrom (jsrtkotlin.go:3026): a set built from a slice,
// deduplicating in first-seen order.
function k3SetFrom(es) {
    var s = ktMakeSet()
    var i = 0
    for (i = 0; i < es.length; i = i + 1) { ktSetAdd(s, es[i]) }
    return s
}

// k3SetOfDistinct is ktSetOfDistinct (jsrtkotlin.go:4536): elements that are
// ALREADY distinct, skipping the quadratic uniqueness scan.
function k3SetOfDistinct(es) {
    var s = ktMakeSet()
    var keys = ktSetElems(s)
    var i = 0
    for (i = 0; i < es.length; i = i + 1) { keys.push(es[i]) }
    return s
}

// k3IsCollection is ktIsCollection (jsrtkotlin.go:4434): the shapes
// kotlin.collections.plus/minus treat as a SEQUENCE rather than as one element.
function k3IsCollection(v) {
    if (ktIsArr(v)) { return true }
    if (ktIsSet(v)) { return true }
    return rtIsDictObj(v)
}

// ----- the sort order ------------------------------------------------------

// k3KeyLess is ktKeyLess (jsrtkotlin.go:4567).
function k3KeyLess(a, b) {
