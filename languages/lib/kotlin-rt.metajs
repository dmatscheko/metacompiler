// ----- ktNumMethod, OWNED by this section ----------------------------------

// jsrtkotlin.go ktNumMethod (485): the member-function surface of Kotlin's
// number types - the conversions, inv(), and the handful of names a program
// calls on an Int or a Double. KT_MISS when this dispatcher does not handle the
// receiver or the name.
function ktNumMethod(recv, name, args) {
    if (!k1Numeric(recv)) { return KT_MISS }
    if (name == "rangeTo" || name == "until" || name == "downTo") {
        if (args.length == 1) { return k4RangeMake(recv, args[0], name) }
    }
    if (name == "toByte") { return k1Conv(recv, 8, 0) }
    if (name == "toShort") { return k1Conv(recv, 16, 0) }
    if (name == "toInt") { return k1Conv(recv, 32, 0) }
    if (name == "toLong") { return k1Conv(recv, 64, 0) }
    if (name == "toUByte") { return k1Conv(recv, 8, 1) }
    if (name == "toUShort") { return k1Conv(recv, 16, 1) }
    if (name == "toUInt") { return k1Conv(recv, 32, 1) }
    if (name == "toULong") { return k1Conv(recv, 64, 1) }
    if (name == "toDouble") { return flo(ktNum(recv), 0) }
    // toFloat() NARROWS to a binary32: 0.1.toFloat() prints "0.1" and is a
    // different value from the Double 0.1.
    if (name == "toFloat") { return flo(rtF32Round(ktNum(recv)), 3) }
    // A Char from the low 16 bits, which is Kotlin's Int.toChar().
    if (name == "toChar") { return ktChar(sintNum(sintConv(k1Val(recv), 16, 1))) }
    if (name == "inv") {
