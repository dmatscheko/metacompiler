        var bf = ktNum(o)
        if (af < bf) { return 0 - 1 }
        if (af > bf) { return 1 }
        return 0
    }
    if (name == "equals") { return k1GiEq(recv, ktArg(args, 0)) }
    if (name == "coerceAtLeast") {
        var la = ktArg(args, 0)
        if (k1NumLess(recv, la)) { return la }
        return recv
    }
    if (name == "coerceAtMost") {
        var ma = ktArg(args, 0)
        if (k1NumLess(ma, recv)) { return ma }
        return recv
    }
    if (name == "coerceIn") {
        var clo = ktArg(args, 0)
        var chi = ktArg(args, 1)
        if (!rtIsNil(clo)) { if (k1NumLess(recv, clo)) { return clo } }
        if (!rtIsNil(chi)) { if (k1NumLess(chi, recv)) { return chi } }
