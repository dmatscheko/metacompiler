    if (name == "toMap" || name == "toMutableMap") {
        out = ktMakeMap()
        for (i = 0; i < keys.length; i = i + 1) { ktMapPut(out, keys[i], vals[i]) }
        return out
    }
    if (name == "clear") {
        k3Clear(keys)
        k3Clear(vals)
        return undefined
    }
    if (name == "hashCode") { return k3I32(ktElemHash(m)) }
    if (name == "equals") { return ktEqVals(m, f) }
    if (k3IsMapFilter(name)) {
