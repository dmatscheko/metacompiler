// call it is undefined, like a sloppy-mode script's.
function js_this() { return k4bThis }

// rt.call(f, this, args): the ONE call shape in this runtime that carries a
// receiver as the dynamic `this` rather than as argument zero.
function k4bCallAcc(f, self, args) {
    var saved = anytype
    saved = k4bThis
    k4bThis = self
    var r = anytype
    r = ktCall(f, args)
    k4bThis = saved
    return r
}

// findClassAccessor (abnf/jsrt.go:2534): accessors live on the __class
// descriptor chain, not on the instance, so an instance read/write follows the
// same single-inheritance chain memberCall walks for methods. undefined when the
// name is not an accessor anywhere on the chain.
function k4bFindAcc(o, name) {
    if (!ktIsObj(o)) { return undefined }
    var cls = o["__class"]
    var guard = 0
    while (guard < 64) {
        guard = guard + 1
        if (!ktIsObj(cls)) { return undefined }
        var v = cls[name]
        if (v !== undefined) {
            if (k4bIsAcc(v)) { return v }
            return undefined
        }
        cls = cls["__super"]
    }
    return undefined
}

// getMember's accessor arm (abnf/jsrt.go:1801). The C floor's member read hands
// back the {__acc, get, set} record itself, so every read that has to see through
// an accessor pair - a `get() = field + 100` property, a `@get:` annotated one, an
// override that replaces a plain field with accessors - goes through here instead.
// An instance does not carry its class's accessors; they live on the __class
// descriptor and its __super chain, which is what k4bFindAcc walks.
function k4bGetMember(o, name) {
    if (!ktIsObj(o)) { return undefined }
    if (k4bAccCount == 0) { return o[name] }
    var v = anytype
    v = o[name]
    if (v !== undefined) {
        if (k4bIsAcc(v)) {
            if (v["get"] === undefined) { return undefined }
            return k4bCallAcc(v["get"], o, [])
        }
        return v
    }
    var acc = k4bFindAcc(o, name)
    if (acc !== undefined) {
        if (acc["get"] === undefined) { return undefined }
        return k4bCallAcc(acc["get"], o, [])
    }
    return undefined
}

// ------------------------------------------------------------ setMember ----

// setMember (abnf/jsrt.go:2011). Layer 2 cannot call the floor's js_set, so the
// fallback the Go twin spells as m["js_set"] is written out here: an accessor on
// the chain wins, `arr.length = n` truncates or pads, a numeric index extends.
function k4bSetMember(o, key, val) {
    if (o === undefined || o === null) { fail("member assignment '" + key + "' on " + o) }
    if (Array.isArray(o)) {
        if (key === "length") {
            var n = ktNum(val)
            if (n != Math.trunc(n) || n < 0) { fail("invalid array length " + n) }
            while (o.length > n) { o.pop() }
            while (o.length < n) { o.push(undefined) }
            return undefined
        }
        var idx = ktNum(key)
        if (idx != Math.trunc(idx) || idx < 0) { fail("invalid array index " + key) }
        while (o.length <= idx) { o.push(undefined) }
        o[idx] = val
        return undefined
    }
    if (!ktIsObj(o)) { return undefined }
    if (k4bAccCount > 0) {
        var own = o[key]
        if (own !== undefined) {
            if (k4bIsAcc(own)) {
                if (own["set"] !== undefined) { k4bCallAcc(own["set"], o, [val]) }
                return undefined
            }
        } else {
            var acc = k4bFindAcc(o, key)
            if (acc !== undefined) {
                if (acc["set"] !== undefined) { k4bCallAcc(acc["set"], o, [val]) }
                return undefined
            }
        }
    }
    o[key] = val
    return undefined
}

// ------------------------------------------------------------ supercall ----

// js_supercall is shared in lib/runtime.metajs; its rtkCall knob exists for Kotlin.

// ------------------------------------------------------------- js_pyrest ---

// *args: the call arguments from index N on, as a list (abnf/jsrt.go:7105). The
// kotlin emitter writes the index with a bare handle(n), so it arrives as a RAW
// integer and not as a value handle - hence the _raw suffix, exactly as
// languages/lib/go-rt.metajs spells js_gorest.
function js_pyrest(args, from_raw) {
    if (!Array.isArray(args)) { fail("js_pyrest needs the argument array") }
    var out = []
    var i = from_raw
    while (i < args.length) {
        out.push(args[i])
        i = i + 1
    }
    return out
}

// ============================================================== `x is T` =====

// ktIsType (jsrtkotlin.go, the ktIsType installer at 951 and js_ktis at 954).
// The shared js_is_type answers by the value model's own rules, where every
// integral number is an Int AND a Long; a box carries its real type, so it is
// answered here and everything else falls through unchanged.
function ktIsType(v, tname) {
    if (typeof v != "number") {
        // A PROGRESSION is an IntRange / CharRange / IntProgression and NOT a
        // List - the shared js_is_type has no arm for it.
        if (ktIsRange(v)) { return k4RangeIsType(v, tname) }
        if (js_is_type(v, tname) === true) { return true }
        // A QUALIFIED type name - `is Shape.Circle`, which is how a NESTED class
        // is spelled from outside its owner. A descriptor is registered under
        // its SIMPLE name, so drop the qualifier.
        var qt = k4bStripAngle(tname)
        var bare = k4bStripQ(qt)
        var d = k4bLastDot(bare)
        if (d >= 0) {
            var short = bare.substring(d + 1, bare.length)
            if (k4bEndsQ(qt)) { short = short + "?" }
            return js_is_type(v, short)
        }
        return false
    }
    var t = k4bStripQ(k4bStripAngle(tname))
    if (t == "Any" || t == "Comparable") { return true }
    if (sintIs(v)) {
        // The four unsigned types are not kotlin.Number.
        if (t == "Number") {
            if (sintUns(v)) { return false }
            return true
        }
        return t == ktBoxTypeName(v)
    }
    if (floIs(v)) {
        // A Double and a plain number carry a type just as definitely: the value
        // model makes a plain number an Int, so `10 is Long` is FALSE and
        // `1.5 is Double` is TRUE - neither of which the shared probe can answer.
        // The style byte says WHICH of the two the box holds, so Double and Float
        // are EXCLUSIVE: `1.5 is Float` and `1.5f is Double` are both false. `is
        // Number` - and the `is Any` / `is Comparable` above - stay true for either
        // width.
        if (t == "Number") { return true }
        if (floStyle(v) == 3) { return t == "Float" }
        return t == "Double"
    }
    return t == "Number" || t == "Int"
}

// `x is T`, as the extern.
function js_ktis(v, tname) { return ktIsType(v, tname) }

// ============================================================= exceptions ====

// js_ktnewexc(name, message) constructs one of the builtin throwables. The
// Kotlin grammar emits it for a call of a throwable name the program does not
// itself declare; `message` is the field both halves read.
function js_ktnewexc(name, message) {
    if (!ktIsBuiltinExc(name)) { fail("unknown builtin exception " + name) }
    var h = ktExcHierarchy()
    var o = {}
    o["__class"] = h[name]
    o["message"] = message
    return o
}

// js_ktexccls(name) hands the emitter the DESCRIPTOR of a builtin throwable, so
// that emitSuperLinks can put it on the __super chain of a class the program
// declares: this half emits no descriptor for Exception, and without the link
// `class Top(m: String) : Exception(m)` would answer `Top("x") is Exception`
// false (java says true). Twin: js_ktexccls in abnf/jsrtkotlin.go.
function js_ktexccls(name) {
    if (!ktIsBuiltinExc(name)) { fail("unknown builtin exception " + name) }
    return ktExcHierarchy()[name]
}

// Does this value's descriptor chain reach a class named "Throwable"?
function k4bIsThrowable(v) {
    if (!ktIsObj(v)) { return false }
    var cls = v["__class"]
    var guard = 0
    while (guard < 64) {
        guard = guard + 1
        if (!ktIsObj(cls)) { return false }
        if (cls["__name"] === "Throwable") { return true }
        cls = cls["__super"]
    }
    return false
}

// js_ktexcmatch(thrown, "TypeName") is Kotlin's CATCH-CLAUSE selection.
// Throwable/Any accept everything (this model lets any value be thrown), the
// three intermediate roots accept a NON-throwable too, and everything else is
// the ordinary dynamic type test.
//
// The non-throwable arm accepts a value that is genuinely not a throwable at all.
// A user throwable is linked to the builtin chain (js_ktexccls), so it takes the
// ordinary type test and `catch (e: RuntimeException)` declines a `: Exception`
// class.
function js_ktexcmatch(thrown, tname) {
    var t = k4bStripQ(k4bStripAngle(tname))
    if (t == "Throwable" || t == "Any") { return true }
    if (t == "Exception" || t == "RuntimeException" || t == "Error") {
        if (!k4bIsThrowable(thrown)) { return true }
    }
    return ktIsType(thrown, t)
}

// js_ktthisat(this, "Outer") is Kotlin's labelled `this@Outer`: walk the __outer
// chain for an instance whose class is named `Outer`, and fall back to the
// receiver itself when there is none. `__outer` is not set when an inner class
// is constructed from inside its outer's own method, so it is not read blindly.
function js_ktthisat(self, want) {
    var cur = anytype
    cur = self
    var i = 0
    while (i < 64) {
        i = i + 1
        if (!ktIsObj(cur)) { i = 99 } else {
            var cls = cur["__class"]
            if (ktIsObj(cls)) {
                if (cls["__name"] === want) { return cur }
            }
            var nxt = cur["__outer"]
            if (rtIsNil(nxt)) { i = 99 } else { cur = nxt }
        }
    }
    return self
}

// ==================================== callable references and class literals ==
//
// Kotlin's `b::v`, `Box::v`, `b::twice`, `::topFun`, `::Box`, `b::class` and
// `Box::class`. The twins are kRefMake / kRefApply / kClassOf / kSimpleName in
// languages/kotlin-interpreter.abnf and the two MUST stay in step.
//
// A reference is a CLOSURE, not a record, and that is the whole design: it makes
// the value callable by every path the runtime already has, with no change to
// the collection code at all.

// The ktRefInfo struct (jsrtkotlin.go:5734), as a plain object:
//   recv   the bound receiver; null when unbound
//   name   the member name
//   bound  is the receiver bound?
//   ctor   ::Box - a constructor reference
//   tname  the TYPE the base named, for an unbound reference
//   ext    the EXTENSION function of that name, resolved at compile time
function k4bRefInfo(recv, name, bound, ctor, tname, ext) {
    var o = {}
    o["recv"] = recv
    o["name"] = name
    o["bound"] = bound
    o["ctor"] = ctor
    o["tname"] = tname
    o["ext"] = ext
    return o
}

// ktRefs (jsrtkotlin.go:5763), as two parallel arrays: MetaJS has no map keyed
// by a function, and the frozen engine rejects a non-index property on an array.
var k4bRefFns = []
var k4bRefInfos = []

// ktFuncNames (jsrtkotlin.go:5764): the name a `::` spelled, against the closure
// it resolved to, so KFunction.name can answer it. SECTION 4a's js_ktfget reads
// it through k4bFuncName.
var k4bNamedFns = []
var k4bNamedNames = []

// ktRefOf (jsrtkotlin.go:5766). undefined means "not a callable reference".
function ktRefOf(v) {
    if (!ktIsFn(v)) { return undefined }
    var i = 0
    while (i < k4bRefFns.length) {
        if (k4bRefFns[i] === v) { return k4bRefInfos[i] }
        i = i + 1
    }
    return undefined
}

// ktMakeRef (jsrtkotlin.go:5778) builds the callable. Calling it IS
// KFunction.invoke / KProperty.invoke: a name the receiver's class chain
// declares as a METHOD is called, anything else is read as a property - which is
// what lets one shape serve both kinds.
function ktMakeRef(info) {
    var hf = function () {
        return ktRefApply(info, rtCopyArr(arguments))
    }
    k4bRefFns.push(hf)
    k4bRefInfos.push(info)
    return hf
}

// ktRefRecv (jsrtkotlin.go:5790)
function k4bRefRecv(info, args) {
    if (info["bound"]) { return info["recv"] }
    if (args.length > 0) { return args[0] }
    return null
}

// ktRefRest (jsrtkotlin.go:5800)
function k4bRefRest(info, args) {
    if (info["bound"] || args.length == 0) { return args }
    var out = []
    var i = 1
    while (i < args.length) {
        out.push(args[i])
        i = i + 1
    }
    return out
}

// ktRefApply (jsrtkotlin.go:5807)
function ktRefApply(info, args) {
    if (info["ctor"]) { return ktConstruct(info["recv"], args) }
    var recv = anytype
    recv = k4bRefRecv(info, args)
    if (ktIsObj(recv)) {
        if (ktClassChainHas(recv, info["name"])) {
            return ktSmcall(recv, info["name"], k4bRefRest(info, args))
        }
        // A member the receiver really HAS wins over a same-named extension,
        // which is Kotlin's rule for the call too.
        if (recv[info["name"]] !== undefined) { return ktRefRead(recv, info["name"]) }
    }
    var ext = info["ext"]
    if (ext !== undefined && ext !== null) {
        return ktCall(ext, rtPrepend(recv, k4bRefRest(info, args)))
    }
    return ktRefRead(recv, info["name"])
}

// ktRefRead (jsrtkotlin.go:1337) is KProperty.get: the property READ, never the
// method. The Go twin routes it through js_ktfget so the reference code reaches
// exactly the field paths the emitted code uses; SECTION 4a's ktRecvMember is
// that function.
function ktRefRead(recv, name) {
    var v = anytype
    v = ktRecvMember(recv, name, false)
    if (ktMiss(v)) { return undefined }
    return v
}

// ktConstruct (jsrtkotlin.go:5836) runs a class descriptor's constructor - what
// `::Box.invoke(7)` and `list.map(::Box)` do. The runtime twin of the emitted
// `new` sequence.
function ktConstruct(cls, args) {
    if (!ktIsObj(cls)) { fail("constructor reference on a non-class") }
    var obj = {}
    obj["__class"] = cls
    var ctor = cls["__ctor"]
    if (ktIsFn(ctor)) { ktCall(ctor, rtPrepend(obj, args)) }
    return obj
}

// ktSimpleName (jsrtkotlin.go:5860) is KClass.simpleName.
function k4bSimpleName(v) {
    if (rtIsNil(v)) { return null }
    if (ktIsChar(v)) { return "Char" }
    if (typeof v == "number") {
        // The style byte says which of the two a tag-14 box holds, so `1.5f::class`
        // is Float.
        if (floIs(v)) {
            if (floStyle(v) == 3) { return "Float" }
            return "Double"
        }
        if (sintIs(v)) { return ktBoxTypeName(v) }
        return "Int"
    }
    if (typeof v == "string") { return "String" }
    if (typeof v == "boolean") { return "Boolean" }
    if (Array.isArray(v)) { return "ArrayList" }
    if (ktIsObj(v)) {
        if (v["__isclass"] === true) { return v["__name"] }
        var cls = v["__class"]
        if (ktIsObj(cls)) { return cls["__name"] }
    }
    return null
}

// ktClassLit (jsrtkotlin.go:5882) is `x::class` / `Type::class`. A KClass renders
// "class Box", and so does java.lang.Class - which is why .java answers the same
// handle here.
function ktClassLit(name) {
    var o = {}
    o["__kclass"] = true
    o["kname"] = name
    return o
}

// ktIsClassLit (jsrtkotlin.go:5889)
function ktIsClassLit(v) {
    if (!ktIsObj(v)) { return false }
    return v["__kclass"] === true
}

// ktRefEq (jsrtkotlin.go:5902) is Kotlin's equality on the two reflection
// shapes: two BOUND references are equal when they name the same member of the
// same receiver (`b::v == b::v` is true), and two class literals when they name
// the same class. KT_MISS is the Go twin's handled=false - anything that is not
// one of the two.
function ktRefEq(l, r) {
    var li = anytype
    var ri = anytype
    li = ktRefOf(l)
    ri = ktRefOf(r)
    if (li !== undefined || ri !== undefined) {
        if (li === undefined || ri === undefined) { return false }
        if (li["name"] !== ri["name"]) { return false }
        if (li["bound"] !== ri["bound"]) { return false }
        if (li["ctor"] !== ri["ctor"]) { return false }
        if (li["tname"] !== ri["tname"]) { return false }
        return ktIdent(li["recv"], ri["recv"])
    }
    var lc = ktIsClassLit(l)
    var rc = ktIsClassLit(r)
    if (lc || rc) {
        if (!lc || !rc) { return false }
        return l["kname"] === r["kname"]
    }
    return KT_MISS
}

// --------------------------------------------------------- the ref externs --

// js_ktref(base, "v") is `base::v`. The base decides which of Kotlin's two
// reference kinds it is: a class descriptor gives an UNBOUND reference
// (KProperty1 / KFunction1, whose get/set/invoke take the receiver first),
// anything else a BOUND one.
//
// The Go twin also recognizes a ktTypeName marker, which only js_ktrebase - a
// SCOPE-taking extern lowered in the emitter - can produce; the emitter passes
// the type NAME as a string in its place, which is the arm below.
function js_ktref(base, name, ext) {
    if (typeof base == "string") {
        return ktMakeRef(k4bRefInfo(null, name, false, false, base, ext))
    }
    if (ktIsObj(base)) {
        if (base["__isclass"] === true) {
            return ktMakeRef(k4bRefInfo(null, name, false, false, base["__name"], ext))
        }
    }
    return ktMakeRef(k4bRefInfo(base, name, true, false, "", ext))
}

// js_ktctorref(v) turns `::Box` into a CONSTRUCTOR reference (Kotlin names it
// "<init>"): callable, and passable where a lambda is expected. A bare `::fn` is
// handed back untouched - a function is already a first-class value.
function js_ktctorref(v) {
    if (ktIsObj(v)) {
        if (v["__isclass"] === true) {
            return ktMakeRef(k4bRefInfo(v, "<init>", true, true, "", undefined))
        }
    }
    return v
}

// js_ktclasslit(base) is `base::class`.
function js_ktclasslit(base) {
    if (typeof base == "string") { return ktClassLit(base) }
    if (ktIsObj(base)) {
        if (base["__isclass"] === true) { return ktClassLit(base["__name"]) }
    }
    return ktClassLit(k4bSimpleName(base))
}

// js_ktnameval(v, "topFun") remembers the name a `::` spelled against the
// closure it resolved to, so KFunction.name can answer it, and hands the value
// straight back.
function js_ktnameval(v, name) {
    k4NameVal(v, name)
    if (ktIsFn(v)) {
        var i = 0
        while (i < k4bNamedFns.length) {
            if (k4bNamedFns[i] === v) {
                k4bNamedNames[i] = name
                return v
            }
            i = i + 1
        }
        k4bNamedFns.push(v)
        k4bNamedNames.push(name)
    }
    return v
}

// ========================================= property writes and super access ==

// js_ktpropset(this, "x", v) stores ONE property initializer. It is not js_set,
// because a property a SUBCLASS overrides with accessors has a js_defprop pair
// on the descriptor chain, and the shared setMember then routes the base class's
// own initializer into the subclass's setter - or, for a getter-only override,
// DROPS it. Kotlin initializes the declaring class's backing field directly, so
// the value lands in the backing slot the accessor model already uses (`x$f`),
// which is where js_ktsupget then finds it for `super.x`.
function js_ktpropset(o, name, v) {
    if (!ktIsObj(o)) { return k4bSetMember(o, name, v) }
    if (o[name] === undefined && k4bAccCount > 0) {
        var acc = k4bFindAcc(o, name)
        if (acc !== undefined) {
            o[name + "$f"] = v
            return undefined
        }
    }
    o[name] = v
    return undefined
}

// js_ktsupget(super class, this, "x") is `super.x` as a VALUE. The walk starts
// AT the given descriptor, so an override never shadows what super.x means. An
// accessor found on the way runs with the receiver. Kotlin differs from the
// shared js_supget in the FALLBACK: a supertype that declares `open val x = 1`
// keeps no accessor at all - the value lives in the instance's own slot - so a
// chain miss reads the receiver rather than answering undefined.
function js_ktsupget(sup, self, name) {
    var cls = sup
    var guard = 0
    while (guard < 64) {
        guard = guard + 1
        if (!ktIsObj(cls)) { guard = 99 } else {
            var v = cls[name]
            if (v !== undefined) {
                if (k4bIsAcc(v)) {
                    if (v["get"] === undefined) { return undefined }
                    return k4bCallAcc(v["get"], self, [])
                }
                return v
            }
            cls = cls["__super"]
        }
    }
    if (ktIsObj(self)) {
        if (self[name] !== undefined) { return self[name] }
        // A property the supertype declared with accessors keeps its value in
        // the emitted backing slot.
        if (self[name + "$f"] !== undefined) { return self[name + "$f"] }
    }
    return null
}

// js_ktsupset(super class, this, "x", v) is `super.x = v`. A setter found on the
// chain runs with the receiver; otherwise the value lands in the slot
// js_ktpropset chose for the declaring class's backing field, so a `super.x`
// read sees it again.
function js_ktsupset(sup, self, name, val) {
    var cls = sup
    var guard = 0
    while (guard < 64) {
        guard = guard + 1
        if (!ktIsObj(cls)) { guard = 99 } else {
            var v = cls[name]
            if (v !== undefined) {
                if (k4bIsAcc(v)) {
                    if (v["set"] !== undefined) { k4bCallAcc(v["set"], self, [val]) }
                    return undefined
                }
                guard = 99
            } else { cls = cls["__super"] }
        }
    }
    if (ktIsObj(self)) {
        if (self[name] !== undefined) {
            self[name] = val
            return undefined
        }
        self[name + "$f"] = val
    }
    return undefined
}

// ktMemberExtFind (jsrtkotlin.go:2860), the half that does NOT take a scope: the
// walk of one receiver and its __outer chain for a mangled member-extension
// name. It answers {fn, disp} or undefined. The scope half - collecting the
// frame's `this` and `__dispatch` as the walk's start values - is lowered in the
// EMITTER, together with js_ktmextget / js_ktmextset / js_ktmextcall.
//
// The receiver's OWN properties come first: a COMPANION object's members hang on
// the class descriptor itself, so a member extension declared in a companion is
// installed on the descriptor where the __class walk below would not see it. No
// Kotlin identifier can contain `$`, so a mangled name is never an ordinary field.
function k4bMextWalk(start, mangled) {
    var cur = anytype
    cur = start
    var i = 0
    while (i < 64) {
        i = i + 1
        if (!ktIsObj(cur)) { i = 99 } else {
            var own = cur[mangled]
            if (ktIsFn(own)) {
                var r0 = {}
                r0["fn"] = own
                r0["disp"] = cur
                return r0
            }
            var fn = ktClsFind(cur["__class"], mangled)
            if (fn !== undefined && fn !== null) {
                var r1 = {}
                r1["fn"] = fn
                r1["disp"] = cur
                return r1
            }
            var nxt = cur["__outer"]
            if (rtIsNil(nxt)) { i = 99 } else { cur = nxt }
        }
    }
    return undefined
}

// ================================================ receiver-function lambdas ==

// js_ktrecvlam(f) wraps the value bound to a parameter whose declared type is a
// receiver function type (`body: Node.() -> Unit`). The wrapper takes the
// receiver in its FIRST slot and runs f with that receiver as `this`, which is
// exactly what ktWithRecv does for with / run / apply - so `t.body()` and
// `body(t)` are the same call, as in Kotlin.
function js_ktrecvlam(f) {
    if (!ktIsFn(f)) { return f }
    return function () {
        var a = rtCopyArr(arguments)
        if (a.length == 0) { return ktWithRecv(null, f, []) }
        // The receiver is passed on as the first ARGUMENT as well as bound as
        // `this`: `fun scoped(block: FeatScope.() -> Int) = block(Scope(9))` with
        // `scoped { s -> s.v }` reads it through the value parameter.
        return ktWithRecv(a[0], f, a)
    }
}

// ================================== the delegated-property protocol (by d) ===

// ktDelegKind (jsrtkotlin.go:2905) names which delegate protocol a `by`
// expression implements, or "" when it implements none. "obj" is a user object
// with getValue (and optionally setValue), "map" a Map delegated by the
// property's NAME, "box" one of the kotlin.properties.Delegates boxes and "lazy"
// a lazy handle.
function ktDelegKind(v) {
    if (!ktIsObj(v)) { return "" }
    var k = v["__ktdeleg"]
    if (typeof k == "string") {
        if (k != "") { return "box" }
    }
    if (v["__lazy"] === true) { return "lazy" }
    if (rtIsDictObj(v)) { return "map" }
    if (ktHasMethod(v, "getValue")) { return "obj" }
    return ""
}

// ktLazyValue (jsrtkotlin.go:5678): the lazy {} delegate's cached value.
function k4bLazyValue(o) {
    if (o["done"] !== true) {
        o["v"] = ktCall(o["f"], [])
        o["done"] = true
    }
    return o["v"]
}

// The property reference handed to getValue/setValue. Only `.name` is meaningful
// for a delegate, which is what Kotlin's own Map delegate uses.
function k4bDRef(owner, name) {
    if (ktIsObj(owner)) { return ktMakeRef(k4bRefInfo(owner, name, true, false, "", undefined)) }
    return ktMakeRef(k4bRefInfo(null, name, true, false, "", undefined))
}

// js_ktdcheck(d, "file:line", warn, thisRef, "name") answers the delegate to
// store - d itself, or what its provideDelegate hands back - and null after
// reporting when d is no delegate at all.
function js_ktdcheck(d0, where, warn, thisRef0, name0) {
    var d = anytype
    d = d0
    var name = ""
    var thisRef = anytype
    thisRef = null
    if (name0 !== undefined) {
        thisRef = thisRef0
        name = name0
    }
    if (ktHasMethod(d, "provideDelegate")) {
        d = ktSmcall(d, "provideDelegate", [thisRef, k4bDRef(thisRef, name)])
    }
    if (ktDelegKind(d) != "") { return d }
    if (warn === 1 || warn === true) {
        // A warning belongs on eprintln, never on println.
        eprintln("warning: " + where + ": delegated property not implemented (ignored)")
        return null
    }
    fail("delegated property not implemented (" + where + "); use -warn-unsupported to ignore")
    return undefined
}

// js_ktdget(d, thisRef, "name") - one read of a delegated property.
function js_ktdget(d, thisRef, name) {
    var kind = ktDelegKind(d)
    if (kind == "") { return null }
    if (kind == "map") {
        // Kotlin's Map delegate reads the entry under the property's NAME, and
        // getValue on a missing key is an error (Map.get would answer null; the
        // delegate uses getValue).
        return ktSmcall(d, "getValue", [name])
    }
    if (kind == "lazy") { return k4bLazyValue(d) }
    if (kind == "box") {
        if (d["__ktdeleg"] === "notNull") {
            if (d["set"] !== true) { fail("Property " + name + " should be initialized before get.") }
        }
        return d["v"]
    }
    return ktSmcall(d, "getValue", [thisRef, k4bDRef(thisRef, name)])
}

// js_ktdset(d, thisRef, "name", v) - one write.
function js_ktdset(d, thisRef, name, val) {
    var kind = ktDelegKind(d)
    if (kind == "" || kind == "lazy") { return undefined }
    if (kind == "map") {
        ktMapPut(d, name, val)
        return undefined
    }
    if (kind == "box") {
        // kotlin.properties.Delegates: observable notifies AFTER the change,
        // vetoable asks BEFORE it and keeps the old value on a false answer,
        // notNull simply refuses to be read before it is written.
        var old = d["v"]
        var bkind = d["__ktdeleg"]
        var cb = d["cb"]
        var live = !rtIsNil(cb)
        if (bkind == "vetoable" && live) {
            if (!ktCall(cb, [k4bDRef(thisRef, name), old, val])) { return undefined }
        }
        d["v"] = val
        d["set"] = true
        if (bkind == "observable" && live) { ktCall(cb, [k4bDRef(thisRef, name), old, val]) }
        return undefined
    }
    ktSmcall(d, "setValue", [thisRef, k4bDRef(thisRef, name), val])
    return undefined
}

// A LOCAL or top-level delegated property binds a BOX; js_ktget unwraps it on
// every read and js_ktvarset routes every write through setValue (both are
// emitter-lowered, being scope-taking). thisRef is null, as it is in Kotlin for
// a property with no owner.
function js_ktdbox(d, name) {
    if (rtIsNil(d)) { return null }
    var box = {}
    box["__pdeleg"] = true
    box["d"] = d
    box["owner"] = null
    box["pname"] = name
    return box
}

// js_ktdmemo(box) answers the delegate of a MEMBER-level extension delegated
// property (`val Ctx.mem: Int by D()` inside a class), resolving it on FIRST
// ACCESS and remembering it in the box. The delegate still belongs to the
// declaration site - one object shared by every receiver - but it cannot be
// evaluated when the descriptor is built: the compiler half emits class items in
// topological order, so a `by` expression naming a top-level val is not bound yet
// at that point. The box is {init: closure, d, done}.
function js_ktdmemo(box) {
    if (!ktIsObj(box)) { return null }
    if (box["done"] === true) { return box["d"] }
    box["done"] = true
    var d = anytype
    d = ktCall(box["init"], [])
    box["d"] = d
    return d
}

// ============================================== numeric conversion externs ===

// A conversion method - toInt(), toLong(), toUInt(): (value, bits, unsigned).
function js_ktconv(v, bits, uns) { return k4bConv(v, ktNum(bits), !!uns) }

// The plain-number reading a raw consumer needs (an index, a length, a range
// bound): a box is not a plain number and every such consumer wants one.
function js_ktnum(v) {
    if (typeof v == "number") {
        if (sintIs(v)) { return sintNum(v) }
    }
    return v
}

// ============================================================ field writes ===

// ktFieldTy (jsrtkotlin.go:4954) answers the declared type of a property,
// walking the __class / __super chain for the __ptypes table the class emitter
// installs. "" when nothing declares one, which makes the adoption a no-op.
function k4bFieldTy(o, name) {
    var cls = o["__class"]
    var i = 0
    while (i < 64) {
        i = i + 1
        if (!ktIsObj(cls)) { i = 99 } else {
            var pt = cls["__ptypes"]
            if (ktIsObj(pt)) {
                var ty = pt[name]
                if (typeof ty == "string") {
                    if (ty != "") { return ty }
                }
            }
            cls = cls["__super"]
        }
    }
    return ""
}

// ktAdoptTy (jsrtkotlin.go:4969) retypes a value by a declared type name, or
// answers undefined when the type carries no width.
function k4bAdoptTy(v, ty) {
    var t = k4bStripQ(ty)
    if (!rtIsIntegral(v)) { return undefined }
    if (t == "Double") { return flo(ktNum(v), 0) }
    if (t == "Float") { return flo(rtF32Round(ktNum(v)), 3) }
    if (t == "Int") { return k4bConv(v, 32, false) }
    if (t == "Long") { return k4bConv(v, 64, false) }
    if (t == "Byte") { return k4bConv(v, 8, false) }
    if (t == "Short") { return k4bConv(v, 16, false) }
    if (t == "UInt") { return k4bConv(v, 32, true) }
    if (t == "ULong") { return k4bConv(v, 64, true) }
    if (t == "UByte") { return k4bConv(v, 8, true) }
    if (t == "UShort") { return k4bConv(v, 16, true) }
    return undefined
}

// js_ktset is js_set plus the map handle: `mm[2] = "b"` is Map.put, which the
// shared setMember cannot answer (it would store a plain PROPERTY named "2").
function js_ktset(o, key, val) {
    // THE INDEXED WRITE IS BOUNDS-CHECKED, exactly like the indexed read. `l[9] = 5`
    // IS MutableList.set(9, 5) in Kotlin and throws IndexOutOfBoundsException;
    // k4bSetMember instead EXTENDS the array for a non-negative index and aborts for
    // a negative one. Twin: the same arm of m["js_ktset"] in abnf/jsrtkotlin.go.
    if (Array.isArray(o)) {
        if (typeof key == "number") {
            var wix = k4Int(key)
            if (wix < 0 || wix >= o.length) { ktIndexOob("IndexOutOfBoundsException", wix, o.length) }
        }
    }
    if (ktIsObj(o)) {
        if (rtIsDictObj(o)) {
            ktMapPut(o, key, val)
            return undefined
        }
        // A field WRITE adopts the property's DECLARED type: `var y: Long = 1`
        // followed by `w.y = 1` stores a Long. __ptypes is the width table the
        // class emitter installs.
        var ty = k4bFieldTy(o, key)
        if (ty != "") {
            var nv = anytype
            nv = k4bAdoptTy(val, ty)
            if (nv !== undefined) { return k4bSetMember(o, key, nv) }
        }
    }
    return k4bSetMember(o, key, val)
}
// ============================================================================
// kotlin-rt.metajs -- SECTION 4a: THE METHOD DISPATCH HUB and the stdlib globals
//
// Ported from abnf/jsrtkotlin.go (the authoritative spec) plus the Kotlin-reached
// tails of abnf/jsrt.go and abnf/jsrtregexkt.go. Every function below names its Go
// original in the comment above it.
//
// WHAT THIS SECTION OWNS
//     ktSmcall / ktRecvMember / ktGlobalFn / ktScopeMethod / ktPairMethod /
//     ktResultMethod / ktJobMethod / ktRunCatching / ktIsResult / ktLazyValue /
//     ktMapOf / ktPkg / ktIsPkg / ktPkgMember / ktSimpleName
//     and the externs js_ktsmcall, js_ktfget, js_ktindex, js_ktglobal,
//     js_kttype, js_ktnameval.
// Every other helper here carries the section's private prefix `k4`.
//
// SKIPPED, AND WHY
//   * Every SCOPE-taking extern in the Go registrar (js_ktget, js_kset,
//     js_ktvarset, js_ktmextget/set/call, js_ktouter, js_ktrefbase, js_ktdthis,
//     js_ktbareref) is lowered in the EMITTER: a scope is the C floor's private
//     storage and layer 2 cannot open one. js_ktrefbase is the only producer of
//     the `ktTypeName` marker, so nothing here builds one.
//   * `js_mcall` stays the floor's for everyone else; the hub cannot CALL an
//     extern, so k4BaseMcall below reimplements the arms of rt.memberCall
//     (abnf/jsrt.go:2761) that a Kotlin receiver can still reach after the whole
//     Kotlin surface above has declined.
//   * `js_ktis` is not this section's extern, and layer 2 cannot call it, so the
//     ONE arm that needs it - KClass.isInstance - drives the private k4IsType,
//     which is js_ktis (jsrtkotlin.go:954) over isTypeName (jsrt.go:8432).
//
// ASSUMPTION ON SECTION 4b's REFERENCE SHAPE
//   ktRefOf(v) is 4b's; the hub reads the info record's fields with the Go twin's
//   own names - `name`, `recv`, `bound`, `ctor`, `tname` - and reaches a
//   reference's property through js_ktfget / a plain member write, which is
//   exactly what the Go registrar installs ktRefRead / ktRefWrite as
//   (jsrtkotlin.go:1337).
// ============================================================================

// ----- small local utilities -------------------------------------------------

// argAt(args, i) of the Go twin: out of range is undefined, never an abort.
function k4At(args, i) {
    if (args === undefined) { return undefined }
    if (i < args.length) { return args[i] }
    return undefined
}

// isCallable. `typeof v == "function"` is the whole test: the floor's type_of
// answers "function" for a generator (tag 16) too, so no apply probe is needed.
function k4Fn(v) { return typeof v == "function" }

// rt.truthy: JavaScript truthiness, which is what every Go `rt.truthy(...)`
// below means.
function k4Truthy(v) {
    if (v === undefined) { return false }
    if (v === null) { return false }
    if (v === false) { return false }
    if (v === true) { return true }
    if (typeof v == "string") { return v.length > 0 }
    if (floIs(v)) { return floNum(v) != 0 }
    if (sintIs(v)) { return sintCmp(v, 0) !== 0 }
    if (typeof v == "number") { return v != 0 }
    return true
}

// The own properties of an object, as the Go twin's `o.props[name]` lookup: a
// class ACCESSOR lives on the descriptor, never on the instance, so a keysOf scan
// is exactly the `v, ok := o.props[name]` test.
function k4Own(o, name) {
    if (!ktIsObj(o)) { return false }
    var ks = keysOf(o)
    var i = 0
    while (i < ks.length) {
        if (ks[i] === name) { return true }
        i = i + 1
    }
    return false
}

// ktRefOf is SECTION 4b's, and the Go twin answers a (info, ok) pair. Here a miss
// is either KT_MISS or nothing at all, so both readings are accepted and the rest
// of this file asks k4IsRef.
function k4IsRef(info) {
    if (info === undefined) { return false }
    if (info === null) { return false }
    return !ktMiss(info)
}

// k4Copy and k4Prepend are shared as rtCopyArr and rtPrepend (lib/runtime.metajs).

// args[1:]
function k4Rest(args, from) {
    var out = []
    var i = from
    while (i < args.length) {
        out.push(args[i])
        i = i + 1
    }
    return out
}

// int32(x), for the hashCode arms.
function k4I32(x) {
    var n = Math.trunc(x)
    var m = n % 4294967296
    if (m < 0) { m = m + 4294967296 }
    if (m >= 2147483648) { m = m - 4294967296 }
    return m
}

// jsToInt(rt.toNumber(v)).
function k4Int(v) { return Math.trunc(ktNum(v)) }

// strings.LastIndexByte - the frozen engine has no lastIndexOf.
function k4LastDot(s) {
    var i = s.length - 1
    while (i >= 0) {
        if (s.charAt(i) == ".") { return i }
        i = i - 1
    }
    return -1
}

// An UNSIGNED sized integer. ktBoxTypeName already answers the four unsigned
// names, so the test reads them back rather than guessing at sintUns's encoding.
function k4Unsigned(v) {
    var n = ktBoxTypeName(v)
    if (n == "UByte") { return true }
    if (n == "UShort") { return true }
    if (n == "UInt") { return true }
    return n == "ULong"
}

// ----- ktKeyLess / ktCmpKeys (jsrtkotlin.go 4567, 5553) ----------------------
//
// Section 0's ktCmpVals is the total order these two are the Go twin's private
// spelling of - strings, Chars, integrals and a user Comparable, in that order -
// so max/min/compareBy/compareValues drive it rather than a second copy.
function k4KeyLess(a, b) { return ktCmpVals(a, b) < 0 }

function k4CmpKeys(a, b, desc) {
    var c = ktCmpVals(a, b)
    if (desc) { return -c }
    return c
}

// ============================================================================
// THE SCOPE FUNCTIONS
// ============================================================================

// ktScopeMethod (jsrtkotlin.go:3210) is kotlin.let / run / apply / also / takeIf /
// takeUnless: the scope functions, which are extensions on ANY receiver. A class
// MEMBER of the same name wins, exactly as it does in Kotlin, which is what the
// ktHasMethod probe is for (the Go twin calls it ktpFindMember).
function ktScopeMethod(target, name, args) {
    var known = false
    if (name == "let") { known = true }
    if (name == "run") { known = true }
    if (name == "apply") { known = true }
    if (name == "also") { known = true }
    if (name == "takeIf") { known = true }
    if (name == "takeUnless") { known = true }
    if (!known) { return KT_MISS }
    if (args === undefined) { return KT_MISS }
    if (args.length != 1) { return KT_MISS }
    if (!k4Fn(args[0])) { return KT_MISS }
    if (ktIsObj(target)) {
        if (ktHasMethod(target, name)) { return KT_MISS }
    }
    var f = args[0]
    if (name == "let") { return ktCall1(f, target) }
    // `x.run { ... }` binds the receiver as `this`. A bare closure handle has no
    // receiver slot, so the receiver goes onto ktRecvStack for the duration of the
    // call and is ALSO passed as `it`.
    if (name == "run") { return ktWithRecv(target, f, [target]) }
    if (name == "apply") {
        ktWithRecv(target, f, [target])
        return target
    }
    if (name == "also") {
        ktCall1(f, target)
        return target
    }
    if (name == "takeIf") {
        if (k4Truthy(ktCall1(f, target))) { return target }
        return null
    }
    if (name == "takeUnless") {
        if (k4Truthy(ktCall1(f, target))) { return null }
        return target
    }
    return KT_MISS
}

// ============================================================================
// THE IMPLICIT RECEIVER
// ============================================================================

// ktRecvProp (jsrtkotlin.go:4815): the names Kotlin declares as PROPERTIES on a
// builtin receiver; everything else resolves to a bound method, so a lookup never
// turns a property into a callable.
// The last four are the properties of the receivers that are neither collections
// nor class instances - kotlin.Lazy's value / isInitialized and kotlin.Result's
// isSuccess / isFailure, plus MatchResult.value, and Char.code. All five are `val`s in the
// stdlib, and no builtin receiver here has a zero-argument METHOD of any of those
// names, which is what makes adding them safe: this table's whole job is to say
// which unqualified names are a FIELD READ rather than a bound call. Keep it in
// step with ktRecvProp (abnf/jsrtkotlin.go), kRecvProps
// (languages/kotlin-interpreter.abnf) and kt_recvprop (kotlin-to-llvm-ir.abnf).
function k4RecvProp(name) {
    if (name == "size") { return true }
    if (name == "length") { return true }
    if (name == "keys") { return true }
    if (name == "values") { return true }
    if (name == "entries") { return true }
    if (name == "indices") { return true }
    if (name == "lastIndex") { return true }
    if (name == "value") { return true }
    if (name == "isInitialized") { return true }
    if (name == "isSuccess") { return true }
    if (name == "isFailure") { return true }
    return name == "code"
}

// ktIsBuiltinRecv (jsrtkotlin.go:4825): a receiver whose members come from the
// runtime rather than from a class descriptor - a list, a map, a StringBuilder box
// or a String.
function k4IsBuiltinRecv(v) {
    if (typeof v == "string") { return true }
    if (ktIsArr(v)) { return true }
    // A PROGRESSION: first / last / step / start / endInclusive are its members.
    if (ktIsRange(v)) { return true }
    // A REGEX, a MATCHRESULT, a RESULT and a CHAR each have a real method surface
    // in ktSmcall and a real property surface in js_ktfget, which is what this
    // predicate asks about; the plain-object arm of ktRecvMember reads own
    // properties only and binds no method. A Char is a box object, so it is
    // tested before the ktIsObj gate says nothing about it.
    if (ktIsChar(v)) { return true }
    if (!ktIsObj(v)) { return false }
    if (v["__class"] !== undefined) { return false }
    if (v["__isclass"] !== undefined) { return false }
    if (rtIsDictObj(v)) { return true }
    // A SET: `with(setOf(1, 2)) { size }`.
    if (ktIsSet(v)) { return true }
    if (ktRxIsRegex(v)) { return true }
    if (ktRxIsMatch(v)) { return true }
    if (ktIsResult(v)) { return true }
    return ktIsSb(v)
}

// k4Bound is jsHostFunc(name, ...) of the Go twin: the bound builtin that reaches
// the whole method surface through the hub.
function k4Bound(recv, name) {
    var self = recv
    var nm = name
    return function () {
        var as = []
        var i = 0
        while (i < arguments.length) {
            as.push(arguments[i])
            i = i + 1
        }
        return ktSmcall(self, nm, as)
    }
}

// ktRecvMember (jsrtkotlin.go:4845) answers an unqualified name against an
// implicit receiver, and KT_MISS when it owns none.
// `iscall` is the SYNTACTIC POSITION of the name: true for `first()`, false for a
// bare `first`. `first` is a PROPERTY of IntProgression and a member FUNCTION of
// List, and a range materializes here as a plain list, so the SITE decides it:
// Kotlin has no unqualified name in value position that means a bound method
// (that spelling is `::name`), and a floor array holds no properties to carry the
// origin. Keep in step with jsrtkotlin.go's ktRecvMember and recvLookup in
// languages/kotlin-interpreter.abnf.
function ktRecvMember(recv, name, iscall) {
    // A USER-CLASS instance reached through with / run / apply. Its FIELDS are its
    // own properties; its METHODS live on the descriptor chain and come back as a
    // bound callable, so an unqualified `method()` inside the lambda dispatches on
    // the receiver.
    if (ktIsObj(recv)) {
        if (recv["__class"] !== undefined) {
            if (k4Own(recv, name)) { return recv[name] }
            // A property with a GETTER: the accessor pair lives on the descriptor
            // chain (js_defprop), not on the instance, so rt.findClassAccessor is
            // what sees it - reading it through the method branch below would hand
            // back a callable instead of the value. The floor's member read is NOT
            // that probe: it hands back the {__acc, get, set} record itself, so the
            // chain walk (k4bFindAcc) and the receiver-bound call (k4bCallAcc) are
            // written out here.
            var acc = k4bFindAcc(recv, name)
            if (acc !== undefined) {
                if (acc["get"] === undefined) { return undefined }
                return k4bCallAcc(acc["get"], recv, [])
            }
            if (ktClassChainHas(recv, name)) { return k4Bound(recv, name) }
            return KT_MISS
        }
    }
    if (!k4IsBuiltinRecv(recv)) {
        // A PLAIN OBJECT receiver that is neither a class instance nor one of the
        // collection kinds: a Pair, a Triple, a Map.Entry, a lazy, a Result, a
        // MatchResult. Kotlin's `with` binds any receiver at all, and every one of
        // those carries real PROPERTIES - first / second / third, key / value,
        // value / isInitialized, isSuccess / isFailure. Reaching none of them is
        // what `with(Pair(1, "x")) { first }` needs. (Under llvm.Run the receiver is
        // also bound as a scope `this`, so the emitter's own probe answers it and
        // this walk is reached natively only.) Own properties answer the first
        // group and js_ktfget the second, which is exactly kt_ktget's order in
        // kotlin-to-llvm-ir.abnf. Nothing is bound as a METHOD here: a plain object
        // has no runtime method table to dispatch into, and binding one would
        // swallow every global name.
        if (ktIsObj(recv) && recv["__isclass"] === undefined) {
            if (k4Own(recv, name)) { return recv[name] }
            // The two receiver shapes js_ktfget ABORTS on rather than missing
            // (kt_fprobe in kotlin-to-llvm-ir.abnf carries the same guard).
            if ((k4RecvProp(name) || !iscall) && !ktIsClassLit(recv) && !ktIsPkg(recv)) {
                var pv = js_ktfget(recv, name)
                if (!rtIsNil(pv)) { return pv }
            }
        }
        // toString(), hashCode() and equals() are members of kotlin.Any, so an
        // unqualified CALL of one resolves against the implicit receiver whatever
        // its shape - a Pair, a Map.Entry, a number (`with(p) { toString() }`);
        // ktSmcall's own Any arm answers it.
        if (iscall) {
            if (name == "toString" || name == "hashCode" || name == "equals") {
                return k4Bound(recv, name)
            }
        }
        return KT_MISS
    }
    // A PROPERTY of the receiver is a FIELD READ, not a zero-argument method call:
    // the list method table has a `size` method but no `lastIndex` one, and
    // `with(list) { lastIndex }` must work. kRecvProps in kotlin-interpreter.abnf
    // reads kGetField the same way.
    if (k4RecvProp(name)) { return js_ktfget(recv, name) }
    // VALUE POSITION on a builtin receiver: the field read is TRIED, and only a miss
    // falls through to the bound method - so nothing that resolved stops resolving.
    // This is the arm that answers `with(1..7 step 2) { first }`.
    if (!iscall) {
        var fv = anytype
        fv = js_ktfget(recv, name)
        if (!rtIsNil(fv)) { return fv }
    }
    return k4Bound(recv, name)
}

// ============================================================================
// THE MAP BUILDER
// ============================================================================

// ktMapOf (jsrtkotlin.go:4999) builds a map from mapOf's arguments: each is a
// Pair, or (after a spread) an array of Pairs.
function ktMapOf(args) {
    var mp = ktMakeMap()
    var i = 0
    while (i < args.length) {
        var p = args[i]
        if (ktIsPair(p)) {
            ktMapPut(mp, p["first"], p["second"])
