    // ++/-- keeps the operand's own type, WIDTH included: a Float steps as a
    // Float, so `var f = 16777216f; f++` stays 1.6777216E7.
    if (floIs(v)) { var st = floStyle(v); if (st == 3) { return flo(k1F32Round(floNum(v) + d), 3) } return flo(floNum(v) + d, st) }
    if (sintIs(v)) {
        var w = sintWidth(v)
        var u = 0
        if (sintUns(v)) { u = 1 }
        return ktNorm(sintOp(0, v, d), w, u)
