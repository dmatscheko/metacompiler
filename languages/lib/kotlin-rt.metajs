}

// jsrtkotlin.go js_ktinv (871). inv(), at the operand's OWN width - Kotlin
// declares it on Int, Long and the four unsigned types, each answering its own
// type.
function js_ktinv(v) {
    if (sintIs(v)) {
        var w = sintWidth(v)
        var u = 0
        if (sintUns(v)) { u = 1 }
        return ktNorm(sintOp(7, sintConv(0 - 1, w, u), v), w, u)
    }
    return ktNorm(0 - k1I32(v) - 1, 32, 0)
