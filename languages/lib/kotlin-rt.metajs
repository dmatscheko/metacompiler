        return lh
    }
    // java.util.AbstractSet.hashCode is the plain SUM of the element hashes, which
    // is what makes it order-independent (java: Set.of(1, 2).hashCode() is 3,
    // where the LIST fold answers 994).
    var se = ktSetElems(v)
    if (se !== undefined) {
        var sh = 0
        var si = 0
        while (si < se.length) {
            sh = (sh + ktElemHash(se[si])) | 0
            si = si + 1
        }
        return sh
    }
    // java.util.AbstractMap.hashCode is the SUM of key XOR value over the entries.
    if (rtIsDictObj(v)) {
        var ks = ktMapKeys(v)
        var vs = ktMapVals(v)
        var mh = 0
        var mi = 0
        while (mi < ks.length) {
            mh = (mh + (ktElemHash(ks[mi]) ^ ktElemHash(vs[mi]))) | 0
            mi = mi + 1
