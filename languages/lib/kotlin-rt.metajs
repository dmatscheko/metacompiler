function k2TrimLeftCut(s) {
    var i = 0
    while (i < s.length) {
        if (!k2IsCut(s.charCodeAt(i))) { return s.substring(i, s.length) }
        i = i + 1
    }
    return ""
}

function k2TrimRightCut(s) {
    var j = s.length
    while (j > 0) {
        if (!k2IsCut(s.charCodeAt(j - 1))) { return s.substring(0, j) }
        j = j - 1
    }
    return ""
}

// ------------------------------------------------------ the String surface

// ktStrMethod is jsrtkotlin.go:2162 - the Go twin of the String branch of
// `mcall` in kotlin-interpreter.abnf. It answers for the names the shared
// js_mcall does NOT carry and KT_MISS for everything else, so a name js_mcall
// already implements keeps exactly the behaviour it had.
function ktStrMethod(s, name, args) {
    if (name == "isNotEmpty") { return s.length > 0 }
    if (name == "get") {
        // Bounds-checked, like the indexed read s[i] it is the method spelling of.
        var gi = k2Int(ktArg(args, 0))
        if (gi < 0 || gi >= s.length) { ktIndexOob("StringIndexOutOfBoundsException", gi, s.length) }
        return ktChar(s.charCodeAt(gi))
    }
    if (name == "plus") { return s + k2Str2(ktArg(args, 0)) }
    if (name == "compareTo") {
        var o = k2Str2(ktArg(args, 0))
        if (s < o) { return -1 }
        if (s > o) { return 1 }
        return 0
    }
