// ----- the two neutral ones Kotlin's emitter reaches ------------------------

// abnf/jsrt.go js_jadd (5151). Java/C# +: string concat, 32 bit add for two int
// values, float add otherwise. The STRING rendering is jsrt.go's javaString, not
// Kotlin's own printer - the completed shape java-rt.metajs, swift-rt.metajs and
// dart-rt.metajs all carry.
// js_jadd is SHARED - lib/runtime.metajs, via the rtkStr/rtkNum hooks above.

// abnf/jsrt.go js_jband (5170). Java & | ^: the non-short-circuit boolean
// operator when both sides are booleans, the int32 bit operation otherwise.
//
// DUPLICATED, DELIBERATELY, with java-rt.metajs's js_jband, and the difference
// list is ONE item that NOTHING CAN REACH. The bodies differ only in the int32
// coercion (jvI here, k1I32 there - two integer models, one per value model),
// and NEITHER EMITTER EVER PRODUCES A CALL THAT REACHES IT: `&` lowers to
// js_jvarith / js_ktarith (java-to-llvm-ir.abnf:2606, kotlin-to-llvm-ir.abnf:4098)
// and the ONLY js_jband either grammar emits is the boolean fold of a structural
// equality (java:3934, kotlin:6682), which returns from the arm above.
//
// So the four lines are shared in every sense but the text, and merging them
// still costs more than they are worth: kotlin does not import
// lib/runtime-jvm.metajs (it has neither rtjkCmp nor rtjkFloOperand and wants
// none of that file's six bodies), and a home in lib/runtime.metajs would need an
// ELEVENTH rtk* hook declared in all ten importers to carry a coercion that is
// dead in both callers. Re-judged in the fifth pass, after the declaration tax
// was measured at zero, and declined on the plumbing rather than on the tax.
//
// NOTE FOR WHEN THE ARM WAKES UP: the Go twin (abnf/jsrt.go:5781) has ONE
// js_jband for both languages and coerces with rt.toInt32 for both. If an
// emitter ever routes a non-boolean here, THAT is where java and kotlin will
// disagree with their own twin - and they will disagree in two directions.
function js_jband(l, r) {
    if (typeof l == "boolean") {
        if (typeof r == "boolean") { return l && r }
    }
    return k1I32(l) & k1I32(r)
}
// ============================================================================
// kotlin-rt.metajs  --  SECTION 2: strings, chars, StringBuilder, the RENDERER
// ============================================================================
//
// The authoritative specification is abnf/jsrtkotlin.go (plus the neutral Char
// externs of abnf/jsrt.go). Every function below names its Go original. Where
// this file cannot reproduce the Go twin exactly, the site says so in full.
//
// WHAT THIS SECTION OWNS (the names the other sections call):
//
//     ktRender(v)                  ktpRender at depth 0        (jsrtkotlin 2611)
//     ktStrMethod(s, name, args)   KT_MISS on a miss           (2162)
//     ktCharMethod(c, name, args)  KT_MISS on a miss           (3257)
//     ktSbMethod(o, name, args)    KT_MISS on a miss           (4912)
//     ktIsSb(v) ktMakeSb(s) ktSbText(o)                        (4895/4888/4904)
//     ktChars(s)  ktStrArg(v)                                  (3344/3355)
//
// and these externs:
//
//     js_char  js_char_code  js_char_like  js_kindex            (abnf/jsrt.go)
//     js_ktprint  js_ktwrite  js_ktstr              (jsrtkotlin 1087/1093/1102)
//
// NOT PORTED HERE, deliberately:
//
//   * js_str_mem. It is a POINTER-and-length read of the module's own constant
//     memory, which layer 2 has no access to; languages/lib/runtime.c already
//     carries it (str_intern, runtime.c:4482) and the Go half registers it in
//     abnf/jsrt.go:4863. Nothing to do.
//
//   * The String members that take a REGEX. jsrtkotlin.go:1290 shows the rule:
//     js_ktsmcall calls ktStrMethod even when args[0] is a Regex and then
//     DISCARDS the answer (`if v, handled := ...; handled && !pat`), so the
//     Regex dispatcher gets the call. The arms are therefore ported faithfully
//     below (replace / replaceFirst / split / contains / matches all answer for
//     a STRING argument), and the HUB in section 4a must carry the `!pat` guard
//     - `ktRxIsRegex(args[0])` - in front of the ktStrMethod result exactly as
//     the Go twin does. Section 5 owns ktRxMethod.
//
// Private helpers are prefixed k2 and are invisible to the linker: only a
// top-level `function js_*` is exported by -rt-lib.
//
// ============================================================================

// ---------------------------------------------------------------- rendering

// ktRender is ktpRender at depth 0 (jsrtkotlin.go:2611) - Kotlin's toString for
// any runtime value. Every other section calls it.
function ktRender(v) { return k2Render(v, 0) }

// k2Render is ktpRender (jsrtkotlin.go:2611). `depth` only guards a cyclic
// object graph - an enum entry's class descriptor holds the entry, which holds
// the descriptor - so the renderer cannot recurse forever.
function k2Render(v, depth) {
    if (depth > 32) { return "..." }
    // Unit is a VALUE in Kotlin, and it prints as its name.
    if (v === undefined) { return "kotlin.Unit" }
    if (v === null) { return "null" }
    // Neither the top level nor a collection element quotes a String:
    // java.util.AbstractCollection.toString calls String.valueOf, so
    // println(listOf("x", "y")) is [x, y].
    if (typeof v == "string") { return v }
    if (v === true) { return "true" }
    if (v === false) { return "false" }
    // A Char renders as its glyph. The Go twin writes string(rune(code)), and Go
    // writes U+FFFD for a rune that is not a scalar value - which is why an
    // ASTRAL character, held as its two surrogate halves by ktChars, renders as
    // TWO U+FFFD. k2ChStr reproduces that; it is not a bug to fix here.
    if (ktIsChar(v)) { return k2ChStr(ktCharCode(v)) }
    // A sized integer prints its exact digits, and an UNSIGNED one prints its
    // unsigned reading: ULong.MAX_VALUE is 18446744073709551615, not -1 (giStr).
    if (sintIs(v)) { return sintStr(v) }
    // A boxed double is jvmFloText: 1.5 / 1.0E20 / Infinity. The floor's floStr
    // carries the JVM style (style 0), including the forced-two-significant-
    // digits subnormal rule, so it is called rather than re-derived.
    if (floIs(v)) { return k1FloText(v) }
    if (typeof v == "number") { return "" + v }
    if (Array.isArray(v)) {
        var out = "["
        var i = 0
        while (i < v.length) {
            if (i > 0) { out = out + ", " }
            out = out + k2Render(v[i], depth + 1)
            i = i + 1
        }
        return out + "]"
    }
    // A callable reference. Real kotlin-reflect renders "val Box.v: kotlin.Int";
    // without the reflection library on the class path it prints "property v
    // (Kotlin reflection is not available)". Neither is reproducible here, so
    // both halves agree on the short form - a deliberate, recorded divergence
    // (ktRefOf / the *hostFunc arm of ktpRender). The Go twin keeps the
    // reference table beside the hostFunc; layer 2 has no such table, so the
    // shape whoever ports js_ktref builds is probed for its marker instead.
    if (typeof v == "object") {
        if (v["__ktref"] === true) {
            var rn = v["name"]
            if (typeof rn == "string") { return "reference " + rn }
        }
        var so = k2Obj(v, depth)
        if (so !== undefined) { return so }
        // ktpRender's fallthrough is rt.toString, which is JavaScript's
        // "[object Object]" for an object shape it does not know.
        return "[object Object]"
    }
    return "" + v
}

// k2Obj is ktpObj (jsrtkotlin.go:2657): the object shapes the Kotlin compiler
// grammar builds. It answers `undefined` for a shape it does not know, which is
// this file's spelling of the Go twin's (·, false).
function k2Obj(o, depth) {
    // A KClass. java.lang.Class.toString() is "class Box" too, which is why
    // .java answers the same handle. The twin is the __kclass arm of kstr.
    if (o["__kclass"] === true) { return "class " + k2Render(o["kname"], depth + 1) }
    // A Regex renders as its pattern and a MatchResult as the matched text,
    // which is what their toString answers (abnf/jsrtregexkt.go); neither
    // carries a __class, so without this they fell through to "[object Object]".
    if (ktRxIsRegex(o) || ktRxIsMatch(o)) {
        var rv = ktRxMethod(o, "toString", [])
        if (!ktMiss(rv)) { return k2Render(rv, depth + 1) }
    }
    // A StringBuilder renders as its accumulated text (java.lang.StringBuilder's
    // toString), the same answer kstr gives it in kotlin-interpreter.abnf.
    if (ktIsSb(o)) { return ktSbText(o) }
    // A MAP renders as java.util.AbstractMap.toString does: {a=1, b=2}.
    if (rtIsDictObj(o)) {
        var mk = ktMapKeys(o)
        var mv = ktMapVals(o)
        var mo = "{"
        var mi = 0
        while (mi < mk.length) {
            if (mi > 0) { mo = mo + ", " }
            mo = mo + k2Render(mk[mi], depth + 1) + "=" + k2Render(mv[mi], depth + 1)
            mi = mi + 1
        }
        return mo + "}"
    }
    // A SET renders like a List - java.util.AbstractCollection.toString again -
    // in its iteration order: [1, 2]. The Go twin recurses at the SAME depth.
    if (ktIsSet(o)) { return k2Render(ktSetElems(o), depth) }
    // A Map.Entry renders as a=1 (java.util.AbstractMap's entry toString), NOT
    // as the Pair it also destructures as - so println(m.entries) is [a=1, b=2].
    if (ktIsEntry(o)) {
        return k2Render(o["key"], depth + 1) + "=" + k2Render(o["value"], depth + 1)
    }
    // A Pair / Triple renders as (a, b) / (a, b, c) - kotlin.Pair.toString.
    if (ktIsPair(o)) {
        var po = "(" + k2Render(o["first"], depth + 1) + ", " + k2Render(o["second"], depth + 1)
        var third = o["third"]
        if (third !== undefined) { po = po + ", " + k2Render(third, depth + 1) }
        return po + ")"
    }
    var cls = o["__class"]
    if (cls === undefined || cls === null || typeof cls != "object") {
        // A class descriptor printed on its own (println(E)), which Go's %v
        // dumped as a map of pointers.
        var cn = k2Name(o)
        if (cn !== undefined) { return cn }
        return undefined
    }
    // A user-written or synthesized toString() wins over every built-in
    // rendering, exactly as it does in Kotlin: a data class renders through the
    // toString the compiler generated for it (D(a=1, b=q)), an `override fun
    // toString()` through its own body. The walk is the __super chain
    // memberCall follows.
    var mth = k2FindMember(o, "toString")
    if (mth !== undefined) { return k2Render(mth.apply(undefined, [o]), depth + 1) }
    // An enum entry prints its NAME (java.lang.Enum.toString); both halves store
    // it on the entry as `name`.
    if (k2IsEnum(cls)) {
        var en = o["name"]
        if (typeof en == "string") { return en }
    }
    var name = cls["__name"]
    if (typeof name != "string") { return undefined }
    if (name.length == 0) { return undefined }
    return name + "@1"
}

// k2Name is ktpName (jsrtkotlin.go:2735): the __name of a class descriptor.
// `undefined` where the Go twin answers ("", false).
function k2Name(o) {
    if (o["__isclass"] === undefined) { return undefined }
    var n = o["__name"]
    if (typeof n != "string") { return undefined }
    if (n.length == 0) { return undefined }
    return n
}

// k2IsEnum is ktpIsEnum (jsrtkotlin.go:2745): whether a descriptor - or one of
// its supers, since an enum entry with a body is an anonymous subclass -
// belongs to an enum class.
function k2IsEnum(cls) {
    var c = cls
    var i = 0
    while (i < 32) {
        if (c === undefined || c === null) { return false }
        if (typeof c != "object") { return false }
        if (c["__isenum"] === true) { return true }
        c = c["__super"]
        i = i + 1
    }
    return false
}

// k2FindMember is ktpFindMember (jsrtkotlin.go:2757): the __class / __super walk
// for a callable member, the same walk memberCall does for a js_mcall and
// clsFind does in kotlin-interpreter.abnf. `undefined` on a miss.
function k2FindMember(o, name) {
    var cls = o["__class"]
    var guard = 0
    while (guard < 64) {
        guard = guard + 1
        if (cls === undefined || cls === null) { return undefined }
        if (typeof cls != "object") { return undefined }
        var mth = cls[name]
        if (typeof mth == "function") { return mth }
        cls = cls["__super"]
    }
    return undefined
}

// k2Line is ktpLine (jsrtkotlin.go:2600): the text one println/print call
// writes. Kotlin's println has only single-argument overloads plus the
// no-argument one (which writes just the line terminator), so this is either ""
// or the one rendered argument.
//
// MetaJS HAS NO `arguments` object (the finding recorded at js_rsymproc in
// languages/lib/ruby-rt.metajs), so the returned host function is written with
// the ONE parameter Kotlin's println ever takes and an absent argument is
// `undefined`. That makes `println()` and `println(Unit)` indistinguishable
// here, where the Go twin prints "" and "kotlin.Unit" respectively; the blank
// line is the reading chosen, because Kotlin has no `println(Unit)` overload -
// Unit only arrives as `println(f())` for a Unit-returning f, which no test in
// tests/kotlin-test*.kt writes.
function k2Line(a) {
    if (a === undefined) { return "" }
    return k2Render(a, 0)
}

// ---------------------------------------------------------------- Char glyphs

// The one-character string a Char code renders as. The Go twin is
// string(rune(code)), so:
//   * a LONE SURROGATE is not a scalar value and Go writes U+FFFD for it. An
//     astral character held as a surrogate PAIR therefore renders as two U+FFFD
//     - the wtf8Clean difference Swift and Go both measured (js_kindex in
//     languages/lib/swift-rt.metajs carries the same rule). Reproduced, not
//     fixed.
//   * an astral CODE POINT in one Char box (a `js_char` literal above 0xFFFF)
//     is a scalar value and renders as itself, which in a UTF-16 string is the
//     surrogate pair.
// Because no lone surrogate can ever enter a string built here, the wtf8Clean
// pass js_ktprint applies on the way out (jsrtkotlin.go:1088) is a no-op and is
// not repeated at the print site.
function k2ChStr(code) {
    // A NEGATIVE code reaches here from `s.get(i)` out of range, which the Go
    // twin does not guard either: strCodeAt answers -1 and string(rune(-1)) is
    // U+FFFD.
    if (code < 0) { return String.fromCharCode(65533) }
    if (code >= 55296 && code <= 57343) { return String.fromCharCode(65533) }
    if (code > 1114111) { return String.fromCharCode(65533) }
    if (code > 65535) {
        var v = code - 65536
        return String.fromCharCode(55296 + Math.floor(v / 1024)) + String.fromCharCode(56320 + (v % 1024))
    }
    return String.fromCharCode(code)
}

// k2Upper / k2Lower are ktUpper (3327) / ktLower (3335): the Unicode SIMPLE
// case mapping of one code point, and the code point itself when the mapping is
// one-to-many (Go's strings.ToUpper("ß") is "SS", two runes, so ktUpper leaves
// it alone). The floor's toUpperCase/toLowerCase is the same table Go's is -
// generated from the Go runtime's own answers, see runtime.c:1352 - so the
// mapping is not re-derived here.
function k2Upper(code) {
    var s = k2ChStr(code).toUpperCase()
    if (k2RuneLen(s) == 1) { return k2CodePointAt(s, 0) }
    return code
}

function k2Lower(code) {
    var s = k2ChStr(code).toLowerCase()
    if (k2RuneLen(s) == 1) { return k2CodePointAt(s, 0) }
    return code
}

// k2IsLetter is ktIsLetter (jsrtkotlin.go:3320): Character.isLetter restricted
// to what this subset can promise - the ASCII letters plus every rune above
// 0x7f that Go classifies as a letter, tested exactly as the Go twin tests it.
function k2IsLetter(code) {
    if (code >= 97 && code <= 122) { return true }
    if (code >= 65 && code <= 90) { return true }
    if (code <= 127) { return false }
    var s = k2ChStr(code)
    return s.toUpperCase() !== s.toLowerCase()
}

// The number of CODE POINTS in s (Go's len([]rune(s))), and the code point at a
// code-point index. Both walk the UTF-16 units and rejoin a surrogate pair.
// SHARED as rtRuneLen - lib/runtime.metajs: dart's dtStrLen was the same
// fourteen lines with one local renamed.
function k2RuneLen(s) { return rtRuneLen(s) }

function k2CodePointAt(s, i) {
    var c = s.charCodeAt(i)
    if (c >= 55296 && c <= 56319 && i + 1 < s.length) {
        var t = s.charCodeAt(i + 1)
        if (t >= 56320 && t <= 57343) { return 65536 + (c - 55296) * 1024 + (t - 56320) }
    }
    return c
}

// ---------------------------------------------------------- small primitives

// jsToInt(rt.toNumber(v)) (abnf/jsrt.go:8486): truncation toward zero, with NaN
// answering 0.
function k2Int(v) {
    var f = ktNum(v)
    if (f !== f) { return 0 }
    return Math.trunc(f)
}

// k2Str2 is ktStr2 (jsrtkotlin.go:2579): a string is itself, everything else
// renders through ktpRender.
function k2Str2(v) {
    if (typeof v == "string") { return v }
    return k2Render(v, 0)
}

// ktStrArg is jsrtkotlin.go:3355: an argument rendered the way a String member
// expects it. A Char argument is its glyph, so s.indexOf('B') and s.indexOf("B")
// agree.
function ktStrArg(v) {
    if (ktIsChar(v)) { return k2ChStr(ktCharCode(v)) }
    return k2Str2(v)
}

// ktChars is jsrtkotlin.go:3344: a string exploded into its Char elements, one
// per UTF-16 CODE UNIT (the Go twin walks strCodeAt, so a surrogate half stays
// a surrogate half here and only becomes U+FFFD when it is rendered).
function ktChars(s) {
    var out = []
    var i = 0
    while (i < s.length) {
        out.push(ktChar(s.charCodeAt(i)))
        i = i + 1
    }
    return out
}

// k2StrHash is ktStrHash (jsrtkotlin.go:2588): java.lang.String.hashCode over
// UTF-16 CODE UNITS, wrapping in int32 exactly as the Go twin's int32 does.
function k2StrHash(s) {
    var h = 0
    var i = 0
    while (i < s.length) {
        h = k2I32(k2I32(31 * h) + s.charCodeAt(i))
        i = i + 1
    }
    return h
}

// Wrap to a signed 32-bit value. 31*h stays exact in a double for every h in
// int32 range (31 * 2^31 is under 2^53), so one reduction per step is enough.
function k2I32(x) {
    var m = x % 4294967296
    if (m >= 2147483648) { m = m - 4294967296 }
    if (m < -2147483648) { m = m + 4294967296 }
    return m
}

// strings.Split without the host's `split`, which the frozen engine does not
// carry. The separator is never empty at any call site below.
function k2Split(s, sep) {
    var out = []
    var start = 0
    var i = 0
    while (i + sep.length <= s.length) {
        if (s.substring(i, i + sep.length) === sep) {
            out.push(s.substring(start, i))
            i = i + sep.length
            start = i
        } else { i = i + 1 }
    }
    out.push(s.substring(start, s.length))
    return out
}

// strings.LastIndex, which the frozen engine has neither as lastIndexOf nor as
// an indexOf with a from-index. The Go twin answers a BYTE offset here and this
// answers a CODE UNIT offset; the two agree for every ASCII haystack, which is
// what "abab".lastIndexOf("ab") and the substringAfterLast family are written
// over. -1 on a miss, and 0 for an empty needle (Go's LastIndex of "" is len(s);
// the sites below all guard delim == "" first, so only the miss path matters).
function k2LastIndexOf(s, sub) {
    if (sub.length == 0) { return s.length }
    var i = s.length - sub.length
    while (i >= 0) {
        if (s.substring(i, i + sub.length) === sub) { return i }
        i = i - 1
    }
    return -1
}

function k2StartsWith(s, p) {
    if (p.length > s.length) { return false }
    return s.substring(0, p.length) === p
}

function k2EndsWith(s, p) {
    if (p.length > s.length) { return false }
    return s.substring(s.length - p.length, s.length) === p
}

// Go's unicode.IsSpace, which is what strings.TrimSpace trims. The host's own
// trim() IS strings.TrimSpace on the Go side (abnf/jsrt.go:4303) but is ASCII
// only in the C floor (runtime.c:3714), so the set is spelled out here and the
// two engines cannot drift.
function k2IsSpace(c) {
    if (c == 32 || c == 9 || c == 10 || c == 11 || c == 12 || c == 13) { return true }
    if (c == 133 || c == 160) { return true }
    if (c == 5760) { return true }
    if (c >= 8192 && c <= 8202) { return true }
    if (c == 8232 || c == 8233 || c == 8239 || c == 8287 || c == 12288) { return true }
    return false
}

function k2TrimSpace(s) {
    var a = 0
    var b = s.length
    var go = true
    while (go && a < b) {
        if (k2IsSpace(s.charCodeAt(a))) { a = a + 1 } else { go = false }
    }
    go = true
    while (go && b > a) {
        if (k2IsSpace(s.charCodeAt(b - 1))) { b = b - 1 } else { go = false }
    }
    return s.substring(a, b)
}

// strings.TrimLeft / TrimRight over the explicit cutset " \t\r\n\f" the Go twin
// spells for trimStart / trimEnd. NOT the same set as TrimSpace above: that is
// the Go twin's own asymmetry, reproduced.
function k2IsCut(c) {
    return c == 32 || c == 9 || c == 13 || c == 10 || c == 12
}

function k2TrimLeftCut(s) {
    var i = 0
    while (i < s.length) {
        if (!k2IsCut(s.charCodeAt(i))) { return s.substring(i, s.length) }
        i = i + 1
    }
    return ""
}

function k2TrimRightCut(s) {
    var j = s.length
    while (j > 0) {
        if (!k2IsCut(s.charCodeAt(j - 1))) { return s.substring(0, j) }
        j = j - 1
    }
    return ""
}

// ------------------------------------------------------ the String surface

// ktStrMethod is jsrtkotlin.go:2162 - the Go twin of the String branch of
// `mcall` in kotlin-interpreter.abnf. It answers for the names the shared
// js_mcall does NOT carry and KT_MISS for everything else, so a name js_mcall
// already implements keeps exactly the behaviour it had.
function ktStrMethod(s, name, args) {
    if (name == "isNotEmpty") { return s.length > 0 }
    if (name == "get") {
        // No range check, exactly as the Go twin has none: strCodeAt answers -1
        // outside and the Char is built from that.
        var gi = k2Int(k2Arg(args, 0))
        if (gi < 0 || gi >= s.length) { return ktChar(-1) }
        return ktChar(s.charCodeAt(gi))
    }
    if (name == "plus") { return s + k2Str2(k2Arg(args, 0)) }
    if (name == "compareTo") {
        var o = k2Str2(k2Arg(args, 0))
        if (s < o) { return -1 }
        if (s > o) { return 1 }
        return 0
    }
    if (name == "repeat") {
        var rn = k2Int(k2Arg(args, 0))
        var ro = ""
        var ri = 0
        while (ri < rn) {
            ro = ro + s
            ri = ri + 1
        }
        return ro
    }
    // Kotlin 1.5 renamed toUpperCase/toLowerCase to uppercase/lowercase; the old
    // spellings are deprecated but still resolve, so both halves accept all four.
    if (name == "uppercase" || name == "toUpperCase") { return s.toUpperCase() }
    if (name == "lowercase" || name == "toLowerCase") { return s.toLowerCase() }
    if (name == "contains") { return s.indexOf(k2Str2(k2Arg(args, 0))) >= 0 }
    if (name == "hashCode") { return k2StrHash(s) }
    return k2StrMethod2(s, name, args)
}

// argAt(args, i).
function k2Arg(args, i) {
    if (i < args.length) { return args[i] }
    return undefined
}

// k2StrMethod2 is ktStrMethod2 (jsrtkotlin.go:2209): the rest of the
// kotlin.text String surface - the CHAR-valued members (Kotlin's String is a
// sequence of Char, so first/last/get/single answer a Char and never a
// one-character String), the trimming and padding family, and the char-sequence
// operations that make a String behave like a collection.
//
// charAt is Java's spelling and does not exist in Kotlin at all - it is get /
// the indexing operator - but both halves have carried it as a builtin for a
// long time, so it stays, now answering a Char like its two Kotlin spellings.
function k2StrMethod2(s, name, args) {
    var n = s.length

    if (name == "charAt") {
        var ci = k2Int(k2Arg(args, 0))
        if (ci < 0 || ci >= n) { fail("charAt(" + ci + ") out of range for " + s) }
        return ktChar(s.charCodeAt(ci))
    }
    if (name == "first") {
        if (n == 0) { fail("first() on an empty string") }
        return ktChar(s.charCodeAt(0))
    }
    if (name == "last") {
        if (n == 0) { fail("last() on an empty string") }
        return ktChar(s.charCodeAt(n - 1))
    }
    if (name == "single") {
        // single(predicate) filters first - the predicate used to be IGNORED, so
        // "hello".single { it == 'h' } aborted with "single() on a string of
        // length 5" in both halves instead of answering 'h'.
        if (args.length > 0) {
            if (ktIsFn(args[0])) { return ktSeqMethod(ktChars(s), name, args) }
        }
        if (n != 1) { fail("single() on a string of length " + n) }
        return ktChar(s.charCodeAt(0))
    }
    if (name == "firstOrNull") {
        if (n == 0) { return null }
        return ktChar(s.charCodeAt(0))
    }
    if (name == "lastOrNull") {
        if (n == 0) { return null }
        return ktChar(s.charCodeAt(n - 1))
    }
    if (name == "toCharArray" || name == "toList") { return ktChars(s) }
    if (name == "trim") { return k2TrimSpace(s) }
    if (name == "trimStart") { return k2TrimLeftCut(s) }
    if (name == "trimEnd") { return k2TrimRightCut(s) }
    if (name == "startsWith") { return k2StartsWith(s, ktStrArg(k2Arg(args, 0))) }
    if (name == "endsWith") { return k2EndsWith(s, ktStrArg(k2Arg(args, 0))) }
    if (name == "padStart" || name == "padEnd") {
        var want = k2Int(k2Arg(args, 0))
        var pad = " "
        if (args.length > 1) { pad = ktStrArg(args[1]) }
        var po = s
        // A zero-length pad would spin; the Go twin spins too, so the guard is
        // only against a hang that no Kotlin program can ask for.
        if (pad.length == 0) { return po }
        while (po.length < want) {
            if (name == "padStart") { po = pad + po } else { po = po + pad }
        }
        return po
    }
    if (name == "reversed") {
        var cs = ktChars(s)
        var vo = ""
        var vi = cs.length - 1
        while (vi >= 0) {
            vo = vo + k2ChStr(ktCharCode(cs[vi]))
            vi = vi - 1
        }
        return vo
    }
    if (name == "lines") {
        var lp = k2Split(s, "\n")
        var lo = []
        var li = 0
        while (li < lp.length) {
            var lv = lp[li]
            if (k2EndsWith(lv, "\r")) { lv = lv.substring(0, lv.length - 1) }
            lo.push(lv)
            li = li + 1
        }
        return lo
    }
    if (name == "split") {
        // No argument, or an empty separator, is not this dispatcher's call: the
        // Regex overload takes it (see the header note on the hub's !pat guard).
        if (args.length == 0) { return KT_MISS }
        var sep = ktStrArg(args[0])
        if (sep.length == 0) { return KT_MISS }
        return k2Split(s, sep)
    }
    if (name == "drop" || name == "take" || name == "dropLast" || name == "takeLast") {
        var k = k2Int(k2Arg(args, 0))
        if (k < 0) { k = 0 }
        if (k > n) { k = n }
        if (name == "drop") { return s.substring(k, n) }
        if (name == "take") { return s.substring(0, k) }
        if (name == "dropLast") { return s.substring(0, n - k) }
        return s.substring(n - k, n)
    }
    if (name == "indexOf") { return s.indexOf(ktStrArg(k2Arg(args, 0))) }
    if (name == "lastIndexOf") { return k2LastIndexOf(s, ktStrArg(k2Arg(args, 0))) }
    if (name == "contains") { return s.indexOf(ktStrArg(k2Arg(args, 0))) >= 0 }
    if (name == "toInt" || name == "toLong" || name == "toDouble" || name == "toIntOrNull") {
        return k2ParseNum(s, name)
    }
    if (name == "format") {
        // "%.2f".format(x): the receiver is the format string, as
        // kotlin.text.format declares it (String.Companion.format has the
        // arguments the other way round).
        return k2Format(s, args)
    }

    // ----- More of kotlin.text: every one of these aborted the run in BOTH
    // halves with "unknown String method". The twin is the `typeof target ==
    // "string"` branch of mcall in kotlin-interpreter.abnf. `replace` with a
    // Regex receiver never reaches here - the hub routes a pattern argument to
    // the Regex dispatcher first (jsrtkotlin.go:1290).
    if (name == "replace" || name == "replaceFirst") {
        var old = ktStrArg(k2Arg(args, 0))
        var nw = ktStrArg(k2Arg(args, 1))
        if (old.length == 0) { return s }
        var parts = k2Split(s, old)
        if (name == "replaceFirst") {
            if (parts.length < 2) { return s }
            var head = parts[0] + nw
            var pi = 1
            while (pi < parts.length) {
                if (pi > 1) { head = head + old }
                head = head + parts[pi]
                pi = pi + 1
            }
            return head
        }
        var ro2 = parts[0]
        var qi = 1
        while (qi < parts.length) {
            ro2 = ro2 + nw + parts[qi]
            qi = qi + 1
        }
        return ro2
    }
    if (name == "isBlank" || name == "isNotBlank") {
        return (k2TrimSpace(s).length == 0) === (name == "isBlank")
    }
    if (name == "removePrefix") {
        var pre1 = ktStrArg(k2Arg(args, 0))
        if (pre1.length > 0 && k2StartsWith(s, pre1)) { return s.substring(pre1.length, s.length) }
        return s
    }
    if (name == "removeSuffix") {
        var suf1 = ktStrArg(k2Arg(args, 0))
        if (suf1.length > 0 && k2EndsWith(s, suf1)) { return s.substring(0, s.length - suf1.length) }
        return s
    }
    if (name == "removeSurrounding") {
        var pre = ktStrArg(k2Arg(args, 0))
        var post = pre
        if (args.length > 1) { post = ktStrArg(args[1]) }
        if (s.length >= pre.length + post.length) {
            if (k2StartsWith(s, pre) && k2EndsWith(s, post)) {
                return s.substring(pre.length, s.length - post.length)
