        return ktSeqMethod(arr, "removeAt", [0])
    }
    if (name == "removeLast") {
        if (arr.length == 0) { fail("removeLast() on an empty list") }
        return ktSeqMethod(arr, "removeAt", [arr.length - 1])
    }
    if (name == "remove") {
        for (i = 0; i < arr.length; i = i + 1) {
            if (ktEqVals(arr[i], f)) {
                k3RemoveAt(arr, i)
                return true
            }
        }
        return false
    }
    if (name == "addAll") {
        oth = ktElems(f)
        n = oth.length
        for (i = 0; i < n; i = i + 1) { arr.push(oth[i]) }
        return n > 0
    }
    return KT_MISS
}

// ----- the grouped name tests ktSeqMethod's Go twin spells as case lists -----

function k3IsTakeDrop(name) {
    if (name == "take") { return true }
    if (name == "drop") { return true }
    if (name == "takeLast") { return true }
    return name == "dropLast"
}

function k3IsCopyName(name) {
    if (name == "toList") { return true }
    if (name == "toMutableList") { return true }
    if (name == "asSequence") { return true }
    if (name == "asIterable") { return true }
    if (name == "asList") { return true }
    if (name == "toIntArray") { return true }
    if (name == "toLongArray") { return true }
    if (name == "toShortArray") { return true }
    if (name == "toByteArray") { return true }
    if (name == "toDoubleArray") { return true }
    if (name == "toFloatArray") { return true }
    if (name == "toBooleanArray") { return true }
    if (name == "toCharArray") { return true }
    return name == "toTypedArray"
}

function k3IsElementAt(name) {
    if (name == "elementAt") { return true }
    if (name == "elementAtOrNull") { return true }
    if (name == "elementAtOrElse") { return true }
    if (name == "getOrNull") { return true }
    return name == "getOrElse"
}

function k3IsMaxOf(name) {
    if (name == "maxOf") { return true }
    if (name == "minOf") { return true }
    if (name == "maxOfOrNull") { return true }
    return name == "minOfOrNull"
}

function k3IsSetOp(name) {
    if (name == "intersect") { return true }
    if (name == "subtract") { return true }
    return name == "union"
}

function k3IsRunning(name) {
    if (name == "runningFold") { return true }
    if (name == "scan") { return true }
    return name == "runningReduce"
}

function k3IsSortOp(name) {
    if (name == "sort") { return true }
    if (name == "sortDescending") { return true }
    if (name == "sortBy") { return true }
    if (name == "sortByDescending") { return true }
    if (name == "sortWith") { return true }
    return name == "reverse"
}

function k3IsRemoveAll(name) {
    if (name == "removeAll") { return true }
    return name == "retainAll"
}

// ----- arms of ktSeqMethod that need their own scope -------------------------

function k3ContentEq(es, other) {
    var i = 0
    if (!ktIsArr(other)) { return false }
    if (other.length != es.length) { return false }
    for (i = 0; i < es.length; i = i + 1) {
        if (!ktEqVals(es[i], other[i])) { return false }
    }
    return true
}

function k3FilterNotNull(es, req) {
    var out = []
    var i = 0
    var e = anytype
    for (i = 0; i < es.length; i = i + 1) {
        e = es[i]
        if (e === undefined || e === null) {
            if (req) { fail("null element in requireNoNulls()") }
        } else { out.push(e) }
    }
    return out
}

function k3FilterIndexed(es, f, invert) {
    var out = []
    var i = 0
    for (i = 0; i < es.length; i = i + 1) {
        if (k3Truthy(ktCall2(f, i, es[i])) !== invert) { out.push(es[i]) }
    }
    return out
}

function k3WhileCut(es, f) {
    var i = 0
    for (i = 0; i < es.length; i = i + 1) {
        if (!k3Truthy(ktCall1(f, es[i]))) { return i }
    }
    return es.length
}

function k3SortedWith(es, f) {
    var out = k3Copy(es)
    var i = 0
    var j = 0
    var v = anytype
    var more = false
    for (i = 1; i < out.length; i = i + 1) {
        v = out[i]
        j = i - 1
        more = true
        while (more) {
            more = false
            if (j >= 0) {
                if (ktNum(ktCall2(f, out[j], v)) > 0) {
                    out[j + 1] = out[j]
                    j = j - 1
                    more = true
                }
