}

// jsrtkotlin.go js_kteq (774). == where a box may be involved: two callable
// references / class literals compare through ktRefEq, two numbers by VALUE
// across the box, a list/map/Pair STRUCTURALLY, an instance whose class declares
// equals answers for itself, and everything else keeps the runtime's identity.
function js_kteq(l, r) {
    if (sintIs(l) || sintIs(r)) { return k1GiEq(l, r) }
    // Two tag 14 boxes: a Float is not equal to a Double even at the same value
    // (java.lang.Float#equals demands a Float). See ktFloEq in section 0.
    var fe = anytype
    fe = ktFloEq(l, r)
    if (!ktMiss(fe)) { return fe }
    // Two callable references / class literals, ahead of ktStructEq exactly as in
    // the Go twin; without this arm the comparison falls through to identity and
    // `b::v == b::v` is false. KT_MISS is its handled=false.
    var re = ktRefEq(l, r)
    if (!ktMiss(re)) { return re }
    var se = ktStructEq(l, r)
    if (!ktMiss(se)) { return se }
    if (ktIsObj(l)) {
        var m = k1FindMember(l, "equals")
        if (m !== undefined) {
            if (ktCall2(m, l, r)) { return true }
            return false
        }
    }
    return ktIdent(l, r)
}

// jsrtkotlin.go js_ktne (802).
function js_ktne(l, r) {
    if (sintIs(l) || sintIs(r)) { return !k1GiEq(l, r) }
    var fe = anytype
    fe = ktFloEq(l, r)
    if (!ktMiss(fe)) { return !fe }
    var re = ktRefEq(l, r)
    if (!ktMiss(re)) { return !re }
    var se = ktStructEq(l, r)
    if (!ktMiss(se)) { return !se }
    if (ktIsObj(l)) {
        var m = k1FindMember(l, "equals")
        if (m !== undefined) {
            if (ktCall2(m, l, r)) { return false }
            return true
        }
    }
    return !ktIdent(l, r)
}

// jsrtkotlin.go js_ktadopt (830). A DECLARED integral type applied to its
// initializer. Kotlin has no implicit conversions, so this only ever sees the one
// case the language does allow - an integer LITERAL typed by its expectation,
// `val x: Long = 1` - and a non-integral value passes through untouched.
function js_ktadopt(v, bits, uns) {
    if (!ktIntegral(v)) { return v }
    var u = 0
    if (uns) { u = 1 }
    return k1Conv(v, Math.trunc(ktNum(bits)), u)
}

// jsrtkotlin.go js_ktadoptf (841). The float half of the same rule: `val d:
// Double = 1` takes the expected type and prints "1.0".
function js_ktadoptf(v) {
    if (!ktIntegral(v)) { return v }
    return flo(ktNum(v), 0)
}

// jsrtkotlin.go js_ktlit (849). An integer literal, passed as DIGITS:
// (text, radix, suffix code).
function js_ktlit(text, radix, sfx) {
    var s = "" + text
    return k1LitValue(k1Digits(s, Math.trunc(ktNum(radix))), Math.trunc(ktNum(sfx)))
}

// jsrtkotlin.go js_ktneg (856). -x. A Double negates as a Double; a Long stays a
// Long; a Byte, a Short and a Char promote to Int, because that is what Kotlin's
// unaryMinus returns.
function js_ktneg(v) {
    // UNARY minus, never `0 - x`: `0.0 - 0.0` is +0.0 and -0.0 must survive.
    // (The integral arms below negate through the tag or through ktNorm, which
    // has no signed zero to lose.)
    if (floIs(v)) { return flo(-floNum(v), floStyle(v)) }
    if (sintIs(v)) {
        var w = sintWidth(v)
        var u = 0
        if (sintUns(v)) { u = 1 }
        if (w == 64 || u) { return ktNorm(sintOp(1, 0, v), w, u) }
        return ktNorm(0 - k1I32(v), 32, 0)
    }
    return ktNorm(0 - k1I32(v), 32, 0)
}

// jsrtkotlin.go js_ktinv (871). inv(), at the operand's OWN width - Kotlin
// declares it on Int, Long and the four unsigned types, each answering its own
// type.
function js_ktinv(v) {
    if (sintIs(v)) {
        var w = sintWidth(v)
        var u = 0
        if (sintUns(v)) { u = 1 }
        return ktNorm(sintOp(7, sintConv(0 - 1, w, u), v), w, u)
    }
    return ktNorm(0 - k1I32(v) - 1, 32, 0)
}

// jsrtkotlin.go js_ktstep (880). ++ / -- keep the type of what they step, which
// is what makes `var b: Byte = 127; b++` answer -128.
function js_ktstep(v, delta) {
    var d = k1I32(delta)
    if (ktIsChar(v)) { return ktChar((ktCharCode(v) + d) & 65535) }
    // ++/-- keeps the operand's own type, WIDTH included: a Float steps as a
    // Float, so `var f = 16777216f; f++` stays 1.6777216E7.
    if (floIs(v)) { var st = floStyle(v); if (st == 3) { return flo(rtF32Round(floNum(v) + d), 3) } return flo(floNum(v) + d, st) }
    if (sintIs(v)) {
        var w = sintWidth(v)
        var u = 0
        if (sintUns(v)) { u = 1 }
        return ktNorm(sintOp(0, v, d), w, u)
    }
    return ktNorm(k1I32(v) + d, 32, 0)
}

// ----- the two neutral ones Kotlin's emitter reaches ------------------------

// abnf/jsrt.go js_jadd: shared in lib/runtime.metajs, via the rtkStr/rtkNum hooks above.

// abnf/jsrt.go js_jband (5170). Java & | ^: the non-short-circuit boolean
// operator when both sides are booleans, the int32 bit operation otherwise.
//
// DUPLICATED, DELIBERATELY, with java-rt.metajs's js_jband. The bodies differ only
// in the int32 coercion (k1I32 here, jvI there), and no emitter produces a call
// that reaches that arm: `&` lowers to js_jvarith / js_ktarith, and the only
// js_jband either grammar emits is the boolean fold of a structural equality,
// which returns from the boolean arm. A shared home would need another rtk* hook
// in every importer for a coercion that is dead in both callers.
//
// If an emitter ever routes a non-boolean here: the Go twin (abnf/jsrt.go) has
// ONE js_jband for both languages and coerces with rt.toInt32, so that is where
// java and kotlin would disagree with their own twin.
function js_jband(l, r) {
    if (typeof l == "boolean") {
        if (typeof r == "boolean") { return l && r }
    }
    return k1I32(l) & k1I32(r)
}
// ============================================================================
// kotlin-rt.metajs  --  SECTION 2: strings, chars, StringBuilder, the RENDERER
// ============================================================================
//
// The authoritative specification is abnf/jsrtkotlin.go (plus the neutral Char
// externs of abnf/jsrt.go). Every function below names its Go original. Where
// this file cannot reproduce the Go twin exactly, the site says so in full.
//
// WHAT THIS SECTION OWNS (the names the other sections call):
//
//     ktRender(v)                  ktpRender at depth 0        (jsrtkotlin 2611)
//     ktStrMethod(s, name, args)   KT_MISS on a miss           (2162)
//     ktCharMethod(c, name, args)  KT_MISS on a miss           (3257)
//     ktSbMethod(o, name, args)    KT_MISS on a miss           (4912)
//     ktIsSb(v) ktMakeSb(s) ktSbText(o)                        (4895/4888/4904)
//     ktChars(s)  ktStrArg(v)                                  (3344/3355)
//
// and these externs:
//
//     js_char  js_char_code  js_char_like  js_kindex            (abnf/jsrt.go)
//     js_ktprint  js_ktwrite  js_ktstr              (jsrtkotlin 1087/1093/1102)
//
// NOT PORTED HERE, deliberately:
//
//   * js_str_mem. It is a POINTER-and-length read of the module's own constant
//     memory, which layer 2 has no access to; languages/lib/runtime.c carries it
//     (str_intern) and the Go half registers it in abnf/jsrt.go.
//
//   * The String members that take a REGEX. js_ktsmcall (jsrtkotlin.go) calls
//     ktStrMethod even when args[0] is a Regex and then DISCARDS the answer
//     (`if v, handled := ...; handled && !pat`), so the Regex dispatcher gets the
//     call. The arms below answer for a STRING argument, and the HUB in section
//     4a carries the `!pat` guard - `ktRxIsRegex(args[0])` - exactly as the Go
//     twin does. Section 5 owns ktRxMethod.
//
// Private helpers are prefixed k2 and are invisible to the linker: only a
// top-level `function js_*` is exported by -rt-lib.
//
// ============================================================================

// ---------------------------------------------------------------- rendering

// ktRender is ktpRender at depth 0 (jsrtkotlin.go:2611) - Kotlin's toString for
// any runtime value. Every other section calls it.
function ktRender(v) { return k2Render(v, 0) }

// k2Render is ktpRender (jsrtkotlin.go:2611). `depth` only guards a cyclic
// object graph - an enum entry's class descriptor holds the entry, which holds
// the descriptor - so the renderer cannot recurse forever.
function k2Render(v, depth) {
    if (depth > 32) { return "..." }
    // Unit is a VALUE in Kotlin, and it prints as its name.
    if (v === undefined) { return "kotlin.Unit" }
    if (v === null) { return "null" }
    // Neither the top level nor a collection element quotes a String:
    // java.util.AbstractCollection.toString calls String.valueOf, so
    // println(listOf("x", "y")) is [x, y].
    if (typeof v == "string") { return v }
    if (v === true) { return "true" }
    if (v === false) { return "false" }
    // A Char renders as its glyph. The Go twin writes string(rune(code)), and Go
    // writes U+FFFD for a rune that is not a scalar value - which is why an
    // ASTRAL character, held as its two surrogate halves by ktChars, renders as
    // TWO U+FFFD. k2ChStr reproduces that; it is not a bug to fix here.
    if (ktIsChar(v)) { return k2ChStr(ktCharCode(v)) }
    // A sized integer prints its exact digits, and an UNSIGNED one prints its
    // unsigned reading: ULong.MAX_VALUE is 18446744073709551615, not -1 (giStr).
    if (sintIs(v)) { return sintStr(v) }
    // A boxed double is jvmFloText: 1.5 / 1.0E20 / Infinity. The floor's floStr
    // carries the JVM style (style 0), including the forced-two-significant-
    // digits subnormal rule, so it is called rather than re-derived.
    if (floIs(v)) { return k1FloText(v) }
    if (typeof v == "number") { return "" + v }
    if (Array.isArray(v)) {
        var out = "["
        var i = 0
        while (i < v.length) {
            if (i > 0) { out = out + ", " }
            out = out + k2Render(v[i], depth + 1)
            i = i + 1
        }
        return out + "]"
    }
    // A callable reference. Real kotlin-reflect renders "val Box.v: kotlin.Int";
    // without the reflection library on the class path it prints "property v
    // (Kotlin reflection is not available)". Neither is reproducible here, so
    // both halves agree on the short form - a deliberate, recorded divergence
    // (ktRefOf / the *hostFunc arm of ktpRender). The Go twin keeps the
    // reference table beside the hostFunc; layer 2 has no such table, so the
    // shape whoever ports js_ktref builds is probed for its marker instead.
    if (typeof v == "object") {
        if (v["__ktref"] === true) {
            var rn = v["name"]
            if (typeof rn == "string") { return "reference " + rn }
        }
        var so = k2Obj(v, depth)
        if (so !== undefined) { return so }
        // ktpRender's fallthrough is rt.toString, which is JavaScript's
        // "[object Object]" for an object shape it does not know.
        return "[object Object]"
    }
    return "" + v
}

// k2Obj is ktpObj (jsrtkotlin.go:2657): the object shapes the Kotlin compiler
// grammar builds. It answers `undefined` for a shape it does not know, which is
// this file's spelling of the Go twin's (·, false).
function k2Obj(o, depth) {
    // A PROGRESSION prints its BOUNDS - "1..5", "10 downTo 1 step 1",
    // "1..9 step 4" - which is IntRange.toString / IntProgression.toString.
    if (o["__range"] === true) { return ktRangeStr(o) }
    // A KClass. java.lang.Class.toString() is "class Box" too, which is why
    // .java answers the same handle. The twin is the __kclass arm of kstr.
    if (o["__kclass"] === true) { return "class " + k2Render(o["kname"], depth + 1) }
    // A Regex renders as its pattern and a MatchResult as the matched text,
    // which is what their toString answers (abnf/jsrtregexkt.go); neither
    // carries a __class.
    if (ktRxIsRegex(o) || ktRxIsMatch(o)) {
        var rv = ktRxMethod(o, "toString", [])
        if (!ktMiss(rv)) { return k2Render(rv, depth + 1) }
    }
    // A StringBuilder renders as its accumulated text (java.lang.StringBuilder's
    // toString), the same answer kstr gives it in kotlin-interpreter.abnf.
    if (ktIsSb(o)) { return ktSbText(o) }
    // A MAP renders as java.util.AbstractMap.toString does: {a=1, b=2}.
    if (rtIsDictObj(o)) {
        var mk = ktMapKeys(o)
        var mv = ktMapVals(o)
        var mo = "{"
        var mi = 0
        while (mi < mk.length) {
            if (mi > 0) { mo = mo + ", " }
            mo = mo + k2Render(mk[mi], depth + 1) + "=" + k2Render(mv[mi], depth + 1)
            mi = mi + 1
        }
        return mo + "}"
    }
    // A SET renders like a List - java.util.AbstractCollection.toString again -
    // in its iteration order: [1, 2]. The Go twin recurses at the SAME depth.
    if (ktIsSet(o)) { return k2Render(ktSetElems(o), depth) }
    // A Map.Entry renders as a=1 (java.util.AbstractMap's entry toString), NOT
    // as the Pair it also destructures as - so println(m.entries) is [a=1, b=2].
    if (ktIsEntry(o)) {
        return k2Render(o["key"], depth + 1) + "=" + k2Render(o["value"], depth + 1)
    }
    // An IndexedValue is a DATA class, so its toString is the generated one:
    // "IndexedValue(index=0, value=10)", not the Pair "(0, 10)". The first/second
    // slots stay on the value so destructuring works.
    if (o["__ktiv"] === true) {
        return "IndexedValue(index=" + k2Render(o["index"], depth + 1) +
               ", value=" + k2Render(o["value"], depth + 1) + ")"
    }
    // A Pair / Triple renders as (a, b) / (a, b, c) - kotlin.Pair.toString.
    if (ktIsPair(o)) {
        var po = "(" + k2Render(o["first"], depth + 1) + ", " + k2Render(o["second"], depth + 1)
        var third = o["third"]
        if (third !== undefined) { po = po + ", " + k2Render(third, depth + 1) }
        return po + ")"
    }
    var cls = o["__class"]
    if (cls === undefined || cls === null || typeof cls != "object") {
        // A class descriptor printed on its own (println(E)), which Go's %v
        // dumped as a map of pointers.
        var cn = k2Name(o)
        if (cn !== undefined) { return cn }
        return undefined
    }
    // A user-written or synthesized toString() wins over every built-in
    // rendering, exactly as it does in Kotlin: a data class renders through the
    // toString the compiler generated for it (D(a=1, b=q)), an `override fun
    // toString()` through its own body. The walk is the __super chain
    // memberCall follows.
    var mth = k2FindMember(o, "toString")
    if (mth !== undefined) { return k2Render(mth.apply(undefined, [o]), depth + 1) }
    // An enum entry prints its NAME (java.lang.Enum.toString); both halves store
    // it on the entry as `name`.
    if (k2IsEnum(cls)) {
        var en = o["name"]
        if (typeof en == "string") { return en }
    }
    // java.lang.Throwable#toString, which Kotlin inherits: the BINARY class name
    // and, only when `message` is non-null, ": " and the message -
    // println(RuntimeException("x")) is "java.lang.RuntimeException: x". This is
    // also what an explicit `e.toString()` reaches (the no-argument toString arm
    // of js_ktsmcall routes to ktRender). It sits AFTER the descriptor walk, so an
    // `override fun toString()` and a data class' generated one still win, exactly
    // as in Kotlin.
    if (k4bIsThrowLike(o)) { return ktThrowableStr(o) }
    var name = cls["__name"]
    if (typeof name != "string") { return undefined }
    if (name.length == 0) { return undefined }
    return name + "@1"
}

// ktClassBin (jsrtkotlin.go's ktClassBin) is a descriptor's binary name: the
// __bname the builtin hierarchy writes, falling back to the simple __name a class
// the PROGRAM declares carries. A top-level Kotlin class in the default package
// has the simple name as its binary name; a NESTED one is spelled Outer$Inner by
// the JVM and this subset keeps no nesting path on the descriptor.
function ktClassBin(cls) {
    var b = cls["__bname"]
    if (typeof b == "string") { if (b.length > 0) { return b } }
    var n = cls["__name"]
    if (typeof n == "string") { return n }
    return "java.lang.Throwable"
}

// ktThrowableStr (jsrtkotlin.go's ktThrowableStr) is java.lang.Throwable#toString:
// the binary class name and, only when `message` is non-null, ": " and the
// message. An EMPTY message still prints the colon and the space; a null one
// prints neither (java). Twin: kThrowableStr in kotlin-interpreter.abnf.
function ktThrowableStr(o) {
    var cls = o["__class"]
    var name = "java.lang.Throwable"
    if (cls !== undefined && cls !== null && typeof cls == "object") { name = ktClassBin(cls) }
    var msg = o["message"]
    if (msg === undefined) { return name }
    if (msg === null) { return name }
    return name + ": " + ktRender(msg)
}

// k4bIsThrowLike (jsrtkotlin.go's ktIsThrowLike) is "does Throwable#toString apply
// to this value" - the RENDERING question, a walk of the descriptor chain.
// emitSuperLinks links a class like `class Top : Exception("t")` to the builtin
// descriptor through js_ktexccls, and every emitCtor call site is preceded by an
// emitSuperLinks over the same supertype list.
function k4bIsThrowLike(v) {
    if (!ktIsObj(v)) { return false }
    return k4bIsThrowable(v)
}

// THE JVM LAUNCHER'S UNCAUGHT-EXCEPTION LINE, and the top of the program.
//
// Kotlin compiles to the JVM and its throwables ARE java.lang's, so java settles
// the format (stderr, exit status 1):
//
//     Exception in thread "main" java.lang.RuntimeException: abort probe
//     Exception in thread "main" java.lang.Exception            <- message == null
//     Exception in thread "main" Top: t                         <- a declared class
//
// The "\tat MainKt.main(Main.kt:4)" frames are NOT reproduced: there is no
// call-site line table here, and inventing frames would be a worse divergence than
// omitting them. A value that is not a Throwable cannot be thrown by real Kotlin at
// all, so the fallback only has to AGREE across the engines: it is each engine's
// own toString.
//
// Twins: kExcTopLine / kReportUncaught in languages/kotlin-interpreter.abnf and
// js_kttop in abnf/jsrtkotlin.go. The shape - the whole entry call inside one
// js_try whose catch clause calls this - is java's js_jvtop and ruby's js_rtop.
function ktExcTopLine(v) {
    var head = "Exception in thread \"main\" "
    if (k4bIsThrowLike(v)) { return head + ktThrowableStr(v) }
    return head + ktRender(v)
}
function js_kttop(exc) {
    eprintln(ktExcTopLine(exc))
    exit(1)
    return undefined
}

// k2Name is ktpName (jsrtkotlin.go:2735): the __name of a class descriptor.
// `undefined` where the Go twin answers ("", false).
function k2Name(o) {
    if (o["__isclass"] === undefined) { return undefined }
    var n = o["__name"]
    if (typeof n != "string") { return undefined }
    if (n.length == 0) { return undefined }
    return n
}

// k2IsEnum is ktpIsEnum (jsrtkotlin.go:2745): whether a descriptor - or one of
// its supers, since an enum entry with a body is an anonymous subclass -
// belongs to an enum class.
function k2IsEnum(cls) {
    var c = cls
    var i = 0
    while (i < 32) {
        if (c === undefined || c === null) { return false }
        if (typeof c != "object") { return false }
        if (c["__isenum"] === true) { return true }
        c = c["__super"]
        i = i + 1
    }
    return false
}

// k2FindMember is ktpFindMember (jsrtkotlin.go:2757): the __class / __super walk
// for a callable member, the same walk memberCall does for a js_mcall and
// clsFind does in kotlin-interpreter.abnf. `undefined` on a miss.
function k2FindMember(o, name) {
    var cls = o["__class"]
    var guard = 0
    while (guard < 64) {
        guard = guard + 1
        if (cls === undefined || cls === null) { return undefined }
        if (typeof cls != "object") { return undefined }
        var mth = cls[name]
        if (typeof mth == "function") { return mth }
        cls = cls["__super"]
    }
    return undefined
