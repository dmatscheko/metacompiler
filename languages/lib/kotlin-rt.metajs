    if (ktIsChar(model)) { return ktChar(k2Int(v)) }
    return v
}

// js_kindex (abnf/jsrt.go): Kotlin's indexed read s[i]. A String yields the
// Char at that CODE UNIT index (Kotlin's CharSequence.get), everything else
// reads the member like js_get. Half of a surrogate pair is answered as itself;
// the Go twin reaches the same answer through js_ktiter, which hands a `for`
// over a String its Chars, because the shared Go js_kindex answers U+FFFD there.
function js_kindex(s, i) {
    if (typeof s != "string") { return s[i] }
    var idx = k2Int(i)
    if (idx < 0 || idx >= s.length) {
        fail("string index " + idx + " out of range for \"" + s + "\"")
    }
    return ktChar(s.charCodeAt(idx))
}

// js_ktprint / js_ktwrite (jsrtkotlin.go): Kotlin's println / print as a VALUE.
// The extern takes no arguments and returns the host function, which buildMain
// declares into the program scope under the names `println` and `print`. Binding
// a value rather than intercepting the call site keeps `::println` and
// `list.forEach(::println)` working, and keeps the shared println host function
// untouched for the other languages that use it.
//
// The Go twin wraps the text in wtf8Clean. That pass only rewrites a WTF-8 lone
// surrogate, and k2ChStr already refuses to put one into a string, so it is a
// no-op here and is not repeated.
function js_ktprint() {
    return function(a) { println(k2Line(a)) }
}

function js_ktwrite() {
    return function(a) { print(k2Line(a)) }
}

// js_kteprint / js_ktewrite (jsrtkotlin.go): System.err's println / print.
function js_kteprint() {
    return function(a) { eprintln(k2Line(a)) }
}

function js_ktewrite() {
    return function(a) { eprint(k2Line(a)) }
}

// js_ktstr (jsrtkotlin.go:1102): the text of a value - what println writes, what
// "$v" interpolates and what v.toString() answers.
function js_ktstr(v) { return ktRender(v) }
// ============================================================================
// SECTION 3 of languages/lib/kotlin-rt.metajs -- THE COLLECTION LIBRARY
//
// Ported from abnf/jsrtkotlin.go, the authoritative spec. The Go originals are
// named at each function.
//
// Owned and defined here:
//     ktSeqMethod(arr, name, args)    ktSetMethod(s, name, args)
//     ktMapMethod(m, name, args)      ktEnumMethod(recv, name, args)
//     ktSortBy(es, sel, desc)         ktSumOf(es, f, ck)
//     js_ktiter(v)                    the only exported extern in this section
// Private helpers all carry the k3 prefix.
//
// CALLED but NOT defined here: everything in the SHARED CONTRACT (section 0),
// ktRender (section 2), ktSmcall (section 4a) and js_ktis (the `x is T` extern,
// section 4b) -- see the note at k3 filterIsInstance.
//
// MetaJS rules that shape the code (docs/abnf-dialect-gotchas.md): no ASI, so
// every `return` carries its value on the same line and a value-less early
// return is braced; a local keeps the TYPE CLASS it is first assigned, so a slot
// that holds a number in one branch and an object in another is `anytype`; no
// for..in, no splice, `array.length` is not assignable, no split/join, indexOf
// ignores its from-index; `typeof v == "number"` is true for a sized integer AND
// for a boxed double; unary minus is `-x`, never `0 - x`.
// ============================================================================

// ----- small readers -------------------------------------------------------

// k3Truthy is rt.truthy (abnf/jsrt.go:909) for the value model Kotlin uses: a
// sized integer is falsy at 0, a boxed double at 0.0 and at NaN.
function k3Truthy(v) {
    if (v === undefined) { return false }
    if (v === null) { return false }
    if (v === true) { return true }
    if (v === false) { return false }
    if (floIs(v)) {
        var d = floNum(v)
        if (d !== d) { return false }
        return d != 0
    }
    if (sintIs(v)) { return sintCmp(v, 0) != 0 }
    if (typeof v == "number") {
        if (v !== v) { return false }
        return v != 0
    }
    if (typeof v == "string") { return v.length > 0 }
    return true
