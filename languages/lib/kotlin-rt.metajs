    if (p == "kotlin.collections") { return true }
    if (p == "kotlin.text") { return true }
    if (p == "kotlin.sequences") { return true }
    if (p == "kotlin.comparisons") { return true }
    if (p == "kotlin.ranges") { return true }
    if (p == "kotlin.system") { return true }
