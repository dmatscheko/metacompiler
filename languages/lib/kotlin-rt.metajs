    // A structural change moves the count a `for` over the set checks.
    if (name == "add" || name == "addAll") {
        oth = [f]
        if (name == "addAll") { oth = ktElems(f) }
        for (i = 0; i < oth.length; i = i + 1) {
            if (ktSetAdd(s, oth[i])) { b = true }
