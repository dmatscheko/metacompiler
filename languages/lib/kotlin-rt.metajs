        }
        return s
    }
    if (name == "substringBefore" || name == "substringAfter" ||
        name == "substringBeforeLast" || name == "substringAfterLast") {
        var delim = ktStrArg(k2Arg(args, 0))
        var miss = s
        if (args.length > 1) { miss = ktStrArg(args[1]) }
        var di = s.indexOf(delim)
        if (name == "substringBeforeLast" || name == "substringAfterLast") {
            di = k2LastIndexOf(s, delim)
