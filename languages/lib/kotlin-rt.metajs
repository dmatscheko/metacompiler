// twin of the `target.__sb` branch of `mcall` in kotlin-interpreter.abnf. A name
// it does not know falls through to the String methods on the accumulated text,
// exactly as there.
function ktSbMethod(o, name, args) {
    if (name == "append" || name == "appendLine") {
        var s = ktSbText(o)
        var i = 0
        while (i < args.length) {
            s = s + k2Str2(args[i])
            i = i + 1
        }
        if (name == "appendLine") { s = s + "\n" }
        o["s"] = s
        return o
    }
    if (name == "toString") { return ktSbText(o) }
    // CharSequence.length counts UTF-16 units, as String's does.
    if (name == "length") { return ktSbText(o).length }
    if (name == "isEmpty") { return ktSbText(o).length == 0 }
    if (name == "isNotEmpty") { return ktSbText(o).length > 0 }
    if (name == "clear") {
        o["s"] = ""
        return o
    }
    if (name == "reverse") {
        // Over CODE POINTS, as the Go twin's []rune reversal is - a surrogate
        // pair is not split.
        var t = ktSbText(o)
        var out = ""
        var j = 0
        while (j < t.length) {
            var cp = k2CodePointAt(t, j)
            var w = k2ChStr(cp)
            out = w + out
            j = j + w.length
        }
        o["s"] = out
        return o
    }
    return ktStrMethod(ktSbText(o), name, args)
}

// ============================================================ THE EXTERNS ===

// js_char: Kotlin's Char from its CODE (abnf/jsrt.go). The code arrives as a RAW
// parameter - kotlin-to-llvm-ir.abnf writes it with handle(k), so without the
// _raw suffix the callee would see the handle 0..3, i.e. undefined/null/false/true.
// Kotlin HAS a Char type, so this answers the {__char: code} box and never a
// one-character string. js_char itself is shared in lib/runtime.metajs.

// js_char_code (abnf/jsrt.go): the code of a Char, and rt.toNumber for
// everything else - so a caller can drive a counter with it without knowing
// whether it holds a Char (kotlin-to-llvm-ir.abnf uses it as a range's numeric
// bound). Shared in lib/runtime.metajs, as rtkNum.

// js_char_like (abnf/jsrt.go): box `v` back into a Char when `model` is
// one, else hand `v` back unchanged. This is how a range keeps its element
// type: 'a'..'c' counts numerically and re-boxes each element, so
// `for (ch in 'a'..'c')` yields Chars while `for (i in 1..3)` yields Ints, from
// one emitted loop.
function js_char_like(model, v) {
    if (ktIsChar(model)) { return ktChar(k2Int(v)) }
    return v
}

// js_kindex (abnf/jsrt.go): Kotlin's indexed read s[i]. A String yields the
// Char at that CODE UNIT index (Kotlin's CharSequence.get), everything else
// reads the member like js_get. Half of a surrogate pair is answered as itself;
// the Go twin reaches the same answer through js_ktiter, which hands a `for`
// over a String its Chars, because the shared Go js_kindex answers U+FFFD there.
function js_kindex(s, i) {
    if (typeof s != "string") { return s[i] }
    var idx = k2Int(i)
    if (idx < 0 || idx >= s.length) {
        fail("string index " + idx + " out of range for \"" + s + "\"")
    }
    return ktChar(s.charCodeAt(idx))
}

// js_ktprint / js_ktwrite (jsrtkotlin.go): Kotlin's println / print as a VALUE.
// The extern takes no arguments and returns the host function, which buildMain
// declares into the program scope under the names `println` and `print`. Binding
// a value rather than intercepting the call site keeps `::println` and
// `list.forEach(::println)` working, and keeps the shared println host function
// untouched for the other languages that use it.
//
// The Go twin wraps the text in wtf8Clean. That pass only rewrites a WTF-8 lone
// surrogate, and k2ChStr already refuses to put one into a string, so it is a
// no-op here and is not repeated.
function js_ktprint() {
    return function(a) { println(k2Line(a)) }
}

function js_ktwrite() {
    return function(a) { print(k2Line(a)) }
}

// js_ktstr (jsrtkotlin.go:1102): the text of a value - what println writes, what
// "$v" interpolates and what v.toString() answers.
function js_ktstr(v) { return ktRender(v) }
// ============================================================================
// SECTION 3 of languages/lib/kotlin-rt.metajs -- THE COLLECTION LIBRARY
//
// Ported from abnf/jsrtkotlin.go, the authoritative spec. The Go originals are
// named at each function.
//
// Owned and defined here:
//     ktSeqMethod(arr, name, args)    ktSetMethod(s, name, args)
//     ktMapMethod(m, name, args)      ktEnumMethod(recv, name, args)
//     ktSortBy(es, sel, desc)         ktSumOf(es, f)
//     js_ktiter(v)                    the only exported extern in this section
// Private helpers all carry the k3 prefix.
//
// CALLED but NOT defined here: everything in the SHARED CONTRACT (section 0),
// ktRender (section 2), ktSmcall (section 4a) and js_ktis (the `x is T` extern,
// section 4b) -- see the note at k3 filterIsInstance.
//
// MetaJS rules that shape the code (docs/abnf-dialect-gotchas.md): no ASI, so
// every `return` carries its value on the same line and a value-less early
// return is braced; a local keeps the TYPE CLASS it is first assigned, so a slot
// that holds a number in one branch and an object in another is `anytype`; no
// for..in, no splice, `array.length` is not assignable, no split/join, indexOf
// ignores its from-index; `typeof v == "number"` is true for a sized integer AND
// for a boxed double; unary minus is `-x`, never `0 - x`.
// ============================================================================

// ----- small readers -------------------------------------------------------

// k3Truthy is rt.truthy (abnf/jsrt.go:909) for the value model Kotlin uses: a
// sized integer is falsy at 0, a boxed double at 0.0 and at NaN.
function k3Truthy(v) {
    if (v === undefined) { return false }
    if (v === null) { return false }
    if (v === true) { return true }
    if (v === false) { return false }
    if (floIs(v)) {
        var d = floNum(v)
        if (d !== d) { return false }
        return d != 0
    }
    if (sintIs(v)) { return sintCmp(v, 0) != 0 }
    if (typeof v == "number") {
        if (v !== v) { return false }
        return v != 0
    }
    if (typeof v == "string") { return v.length > 0 }
    return true
}

// k3Str2 is rt.ktStr2 (jsrtkotlin.go:2579): a string is itself, everything else
// renders through ktRender.
function k3Str2(v) {
    if (typeof v == "string") { return v }
    return ktRender(v)
}

// k3StrArg is rt.ktStrArg (jsrtkotlin.go:3355): a Char argument is its glyph.
function k3StrArg(v) {
    if (ktIsChar(v)) { return String.fromCharCode(ktCharCode(v)) }
    return k3Str2(v)
}

// k3Trunc truncates toward zero; NaN reads as 0, which is what giFromFloat does.
function k3Trunc(x) {
    if (x !== x) { return 0 }
    if (x < 0) { return -Math.floor(-x) }
    return Math.floor(x)
}

// k3Int is jsToInt(rt.toNumber(v)) -- the index / size / count reading.
function k3Int(v) { return k3Trunc(ktNum(v)) }

// k3IVal is giVal (abnf/jsrtint.go:105) as a 64 bit box: a box's payload read at
// 64 bits signed, a Char's code, a plain number truncated toward zero.
function k3IVal(v) {
    if (ktIsChar(v)) { return sintConv(ktCharCode(v), 64, 0) }
    if (sintIs(v)) { return sintConv(v, 64, 0) }
    return sintConv(k3Trunc(ktNum(v)), 64, 0)
}

// k3Norm is jsrtkotlin.go's ktNorm spelled with the floor's own primitives: a
// signed 32 bit result is a PLAIN NUMBER, every other width or signedness a box.
function k3Norm(x, w, u) {
    var t = sintConv(x, w, u)
    if (w == 32) {
        if (u == 0) { return sintNum(t) }
    }
    return t
}

// k3I32 is Go's int32(x) wrap, which the hashCode folds need at every step.
function k3I32(x) { return sintNum(sintConv(x, 32, 0)) }

// k3CmpLt is rt.ktCmp("<", l, r) (jsrtkotlin.go:293): the comparison at the
// PROMOTED width, so a Byte receiver does not truncate a wide argument.
function k3CmpLt(l, r) {
    var wu = ktWU(l, r)
    var a = sintConv(k3IVal(l), wu.w, wu.u)
    var b = sintConv(k3IVal(r), wu.w, wu.u)
    return sintCmp(a, b) < 0
}

// ----- array plumbing ------------------------------------------------------
//
// There is no splice and `array.length` is not assignable, so removal is index
// shifting plus pop() and truncation is a pop loop.

function k3Copy(a) {
    var out = []
    var i = 0
    for (i = 0; i < a.length; i = i + 1) { out.push(a[i]) }
    return out
}

// k3Sub is the Go slice expression es[lo:hi].
function k3Sub(a, lo, hi) {
    var out = []
    var i = 0
    for (i = lo; i < hi; i = i + 1) { out.push(a[i]) }
    return out
}

function k3Clear(a) {
    while (a.length > 0) { a.pop() }
}

// k3Replace is `o.elems = ne` in place, so every alias of the list sees it.
function k3Replace(a, ne) {
    var i = 0
    var tmp = k3Copy(ne)
    k3Clear(a)
    for (i = 0; i < tmp.length; i = i + 1) { a.push(tmp[i]) }
}

function k3RemoveAt(a, ix) {
    var i = 0
    for (i = ix; i + 1 < a.length; i = i + 1) { a[i] = a[i + 1] }
    a.pop()
}

// ----- set / collection helpers --------------------------------------------

// k3SetFrom is rt.ktSetFrom (jsrtkotlin.go:3026): a set built from a slice,
// deduplicating in first-seen order.
function k3SetFrom(es) {
    var s = ktMakeSet()
    var i = 0
    for (i = 0; i < es.length; i = i + 1) { ktSetAdd(s, es[i]) }
    return s
}

// k3SetOfDistinct is ktSetOfDistinct (jsrtkotlin.go:4536): elements that are
// ALREADY distinct, skipping the quadratic uniqueness scan.
function k3SetOfDistinct(es) {
    var s = ktMakeSet()
    var keys = ktSetElems(s)
    var i = 0
    for (i = 0; i < es.length; i = i + 1) { keys.push(es[i]) }
    return s
}

// k3IsCollection is ktIsCollection (jsrtkotlin.go:4434): the shapes
// kotlin.collections.plus/minus treat as a SEQUENCE rather than as one element.
function k3IsCollection(v) {
    if (ktIsArr(v)) { return true }
    if (ktIsRange(v)) { return true }
    if (ktIsSet(v)) { return true }
    return rtIsDictObj(v)
}

// ----- the sort order ------------------------------------------------------

// k3KeyLess is ktKeyLess (jsrtkotlin.go:4567).
function k3KeyLess(a, b) {
    if (ktIsStr(a)) {
        if (ktIsStr(b)) { return a < b }
    }
    if (ktIsChar(a)) {
        if (ktIsChar(b)) { return ktCharCode(a) < ktCharCode(b) }
    }
    if (ktIntegral(a)) {
        if (ktIntegral(b)) { return k3CmpLt(a, b) }
    }
    // A user `Comparable`: listOf(V(3), V(1)).sorted() sorts by the class's own
    // compareTo. Without this every element would compare as NaN.
    if (ktIsObj(a)) {
        if (ktClassChainHas(a, "compareTo")) {
            return ktNum(ktSmcall(a, "compareTo", [b])) < 0
        }
    }
    return ktNum(a) < ktNum(b)
}

// k3KeyEqual is ktKeyEqual (jsrtkotlin.go:4591).
function k3KeyEqual(a, b) {
    if (k3KeyLess(a, b)) { return false }
    return !k3KeyLess(b, a)
}

// ktSortBy is jsrtkotlin.go:4545 -- an insertion sort (stable, and small enough
// to keep the two halves byte identical) by an optional selector.
function ktSortBy(es, sel, desc) {
    var out = k3Copy(es)
    var keys = []
    var i = 0
    var j = 0
    var v = anytype
    var k = anytype
    var d = desc === true
    var more = false
    var hasSel = true
    if (sel === null) { hasSel = false }
    if (sel === undefined) { hasSel = false }
    for (i = 0; i < out.length; i = i + 1) {
        if (hasSel) { keys.push(ktCall1(sel, out[i])) } else { keys.push(out[i]) }
    }
    for (i = 1; i < out.length; i = i + 1) {
        v = out[i]
        k = keys[i]
        j = i - 1
        more = true
        while (more) {
            more = false
            if (j >= 0) {
                if ((k3KeyLess(k, keys[j]) === true) !== d) {
                    if (!k3KeyEqual(k, keys[j])) {
                        out[j + 1] = out[j]
                        keys[j + 1] = keys[j]
                        j = j - 1
                        more = true
                    }
                }
            }
        }
        out[j + 1] = v
        keys[j + 1] = k
    }
    return out
}

// ktSumOf is jsrtkotlin.go:4448 -- Kotlin's sumOf/sum at the WIDTH of what it is
// summing: a Long selector sums to a Long and a Double selector to a Double.
function ktSumOf(es, f) {
    var isFlo = false
    var isLong = false
    var vals = []
    var i = 0
    var v = anytype
    var t = 0
    var acc = anytype
    var hasF = true
    if (f === null) { hasF = false }
    if (f === undefined) { hasF = false }
    for (i = 0; i < es.length; i = i + 1) {
        v = es[i]
        if (hasF) { v = ktCall1(f, es[i]) }
        vals.push(v)
        if (floIs(v)) { isFlo = true }
        if (sintIs(v)) {
            if (sintWidth(v) == 64) { isLong = true }
        }
    }
    if (isFlo) {
        for (i = 0; i < vals.length; i = i + 1) { t = t + ktNum(vals[i]) }
        return flo(t, 0)
    }
    acc = sintConv(0, 64, 0)
    for (i = 0; i < vals.length; i = i + 1) { acc = sintOp(0, acc, k3IVal(vals[i])) }
    if (isLong) { return k3Norm(acc, 64, 0) }
    return k3Norm(acc, 32, 0)
}

// ============================================================================
// ktEnumMethod -- jsrtkotlin.go:2973
//
// values() / valueOf(name) / entries on an enum class descriptor. `entries` is
// Kotlin 1.9's EnumEntries, a List; `values()` is an Array. Both are the
// declaration-ordered entry list in this value model.
// ============================================================================

function ktEnumMethod(recv, name, args) {
    var es = anytype
    var want = ""
    var i = 0
    var e = anytype
    var cn = ""
    if (!ktIsObj(recv)) { return KT_MISS }
    if (recv["__isenum"] !== true) { return KT_MISS }
    es = recv["__entries"]
    if (!ktIsArr(es)) { return KT_MISS }
    if (name == "values") { return k3Copy(es) }
    if (name == "entries") { return k3Copy(es) }
    if (name == "valueOf") {
        want = k3Str2(ktArg(args, 0))
        for (i = 0; i < es.length; i = i + 1) {
            e = es[i]
            if (ktIsObj(e)) {
                if (e["name"] === want) { return e }
            }
        }
        cn = recv["__name"]
        if (typeof cn != "string") { cn = "" }
        // Kotlin THROWS IllegalArgumentException here, which is why
        // runCatching { Level.valueOf(s) }.getOrNull() is the ordinary way to
        // parse an enum from text.
        ktRaise("IllegalArgumentException", "No enum constant " + cn + "." + want)
    }
    return KT_MISS
}

// ============================================================================
// ktSeqMethod -- jsrtkotlin.go:3370
//
// The kotlin.collections surface over a list. The ORDER of the name tests is the
// Go twin's, because a method two arms could answer must be answered by the same
// arm as in Go. A STRING reaches this function too (a String is a sequence of
// Char in Kotlin), which is why the names the shared js_mcall already knows are
// repeated here.
// ============================================================================

// A LIST receiver, which is also every receiver whose kind this value model cannot
// recover: an Array, a Sequence and a Map's `values` view are the same host array.
// Every caller that DOES still know its receiver's kind - a Set, a Map, a range, a
// String - calls ktSeqMethodK with the word kotlin-stdlib's overload for that kind
// uses. See ktNoElemKind.
function ktSeqMethod(arr, name, args) { return ktSeqMethodK(arr, name, args, "List") }

function ktSeqMethodK(arr, name, args, kind) {
    var es = arr
    var f = ktArg(args, 0)
    var out = []
    var oth = []
    var keys = []
    var i = 0
    var j = 0
    var k = 0
    var n = 0
    var e = anytype
    var v = anytype
    var acc = anytype
    var best = anytype
    var mp = anytype
    var t = 0
    var s = ""
    var b = false
    var b2 = false
    var d = false
    var pre = ""
    var post = ""
    var body = ""

    if (name == "isEmpty") { return es.length == 0 }
    if (name == "isNotEmpty") { return es.length > 0 }
    if (name == "map") {
        for (i = 0; i < es.length; i = i + 1) { out.push(ktCall1(f, es[i])) }
        return out
    }
    if (name == "filter") {
        for (i = 0; i < es.length; i = i + 1) {
            if (k3Truthy(ktCall1(f, es[i]))) { out.push(es[i]) }
        }
        return out
    }
    if (name == "forEach") {
        for (i = 0; i < es.length; i = i + 1) { ktCall1(f, es[i]) }
        return undefined
    }
    if (name == "count") {
        if (args.length == 0) { return es.length }
        n = 0
        for (i = 0; i < es.length; i = i + 1) {
            if (k3Truthy(ktCall1(f, es[i]))) { n = n + 1 }
        }
        return n
    }
    if (name == "any") {
        for (i = 0; i < es.length; i = i + 1) {
            if (k3Truthy(ktCall1(f, es[i]))) { return true }
        }
        return false
    }
    if (name == "contains") {
        for (i = 0; i < es.length; i = i + 1) {
            if (ktEqVals(es[i], f)) { return true }
        }
        return false
    }
    if (name == "indexOf") {
        for (i = 0; i < es.length; i = i + 1) {
            if (ktEqVals(es[i], f)) { return i }
        }
        return -1
    }
    if (name == "first") {
        if (args.length == 1) {
            if (ktIsFn(f)) {
                for (i = 0; i < es.length; i = i + 1) {
                    if (k3Truthy(ktCall1(f, es[i]))) { return es[i] }
                }
                ktNoMatch(ktPredWord(kind))
            }
        }
        if (es.length == 0) { ktNoElemKind(kind) }
        return es[0]
    }
    if (name == "last") {
        // last(predicate) is the last MATCHING element:
        // `listOf(1,2,3,4).last { it < 3 }` is 2.
        if (args.length == 1) {
            if (ktIsFn(f)) {
                for (i = es.length - 1; i >= 0; i = i - 1) {
                    if (k3Truthy(ktCall1(f, es[i]))) { return es[i] }
                }
                ktNoMatch(kind)
            }
        }
        if (es.length == 0) { ktNoElemKind(kind) }
        return es[es.length - 1]
    }
    if (name == "single") {
        if (args.length == 1) {
            if (ktIsFn(f)) {
                best = undefined
                n = 0
                for (i = 0; i < es.length; i = i + 1) {
                    if (k3Truthy(ktCall1(f, es[i]))) {
                        best = es[i]
                        n = n + 1
                    }
                }
                if (n == 0) { ktNoMatch(ktPredWord(kind)) }
                if (n > 1) { ktRaise("IllegalArgumentException", ktPredWord(kind) + " contains more than one matching element.") }
                return best
            }
        }
        if (es.length == 0) { ktNoElemKind(kind) }
        if (es.length > 1) { ktRaise("IllegalArgumentException", kind + " has more than one element.") }
        return es[0]
    }
    if (name == "firstOrNull") {
        if (args.length == 1) {
            if (ktIsFn(f)) {
                for (i = 0; i < es.length; i = i + 1) {
                    if (k3Truthy(ktCall1(f, es[i]))) { return es[i] }
                }
                return null
            }
        }
        if (es.length == 0) { return null }
        return es[0]
    }
    // lastOrNull(predicate) is the last MATCHING element -
    // `listOf(1,2,3).lastOrNull { it < 2 }` is 1. This arm must stay ahead of the
    // findLast arm further down, which also names lastOrNull.
    if (name == "lastOrNull") {
        if (args.length == 1) {
            if (ktIsFn(f)) {
                for (i = es.length - 1; i >= 0; i = i - 1) {
                    if (k3Truthy(ktCall1(f, es[i]))) { return es[i] }
                }
                return null
            }
        }
        if (es.length == 0) { return null }
        return es[es.length - 1]
    }
    if (name == "find") {
        for (i = 0; i < es.length; i = i + 1) {
            if (k3Truthy(ktCall1(f, es[i]))) { return es[i] }
        }
        return null
    }
    if (name == "all") {
        for (i = 0; i < es.length; i = i + 1) {
            if (!k3Truthy(ktCall1(f, es[i]))) { return false }
        }
        return true
    }
    if (name == "none") {
        if (args.length == 0) { return es.length == 0 }
        for (i = 0; i < es.length; i = i + 1) {
            if (k3Truthy(ktCall1(f, es[i]))) { return false }
        }
        return true
    }
    if (name == "indexOfFirst") {
        for (i = 0; i < es.length; i = i + 1) {
            if (k3Truthy(ktCall1(f, es[i]))) { return i }
        }
        return -1
    }
    if (name == "fold") {
        acc = ktArg(args, 0)
        for (i = 0; i < es.length; i = i + 1) { acc = ktCall2(ktArg(args, 1), acc, es[i]) }
        return acc
    }
    if (name == "foldRight") {
        acc = ktArg(args, 0)
        for (i = es.length - 1; i >= 0; i = i - 1) { acc = ktCall2(ktArg(args, 1), es[i], acc) }
        return acc
    }
    // The OrNull forms answer null for an empty receiver where the others throw.
    if (name == "reduce" || name == "reduceIndexed" || name == "reduceOrNull" || name == "reduceIndexedOrNull") {
        if (es.length == 0) {
            if (name == "reduceOrNull" || name == "reduceIndexedOrNull") { return null }
            ktRaise("UnsupportedOperationException", "Empty " + ktRedWord(kind, false) + " can't be reduced.")
        }
        acc = es[0]
        for (i = 1; i < es.length; i = i + 1) {
            if (name == "reduce" || name == "reduceOrNull") { acc = ktCall2(f, acc, es[i]) }
            else { acc = ktCall(f, [i, acc, es[i]]) }
        }
        return acc
    }
    // reduceRight folds from the END with the accumulator as the SECOND parameter,
    // and it is declared on List (and CharSequence), which is the only place the
    // "Empty list can't be reduced." wording comes from.
    if (name == "reduceRight" || name == "reduceRightIndexed" || name == "reduceRightOrNull" || name == "reduceRightIndexedOrNull") {
        if (es.length == 0) {
            if (name == "reduceRightOrNull" || name == "reduceRightIndexedOrNull") { return null }
            ktRaise("UnsupportedOperationException", "Empty " + ktRedWord(kind, true) + " can't be reduced.")
        }
        acc = es[es.length - 1]
        for (i = es.length - 2; i >= 0; i = i - 1) {
            if (name == "reduceRight" || name == "reduceRightOrNull") { acc = ktCall2(f, es[i], acc) }
            else { acc = ktCall(f, [i, es[i], acc]) }
        }
