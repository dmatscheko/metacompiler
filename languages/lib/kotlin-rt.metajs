        // entries. Read as PROPERTIES they used to fall through to js_get, which
        // handed back the raw `keys` array behind the handle.
        if (rtIsDictObj(o)) {
            var mname = anytype
            mname = ""
            if (name == "keys") { mname = "keys" }
            if (name == "values") { mname = "values" }
            if (name == "entries") { mname = "entries" }
            if (name == "length") { mname = "size" }
            if (name == "size") { mname = "size" }
