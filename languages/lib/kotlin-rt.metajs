// k2Line is ktpLine (jsrtkotlin.go:2600): the text one println/print call
// writes. Kotlin's println has only single-argument overloads plus the
// no-argument one (which writes just the line terminator), so this is either ""
// or the one rendered argument.
//
// MetaJS HAS NO `arguments` object, so the returned host function is written with
// the ONE parameter Kotlin's println ever takes and an absent argument is
// `undefined`. The argument COUNT is knowable only at the CALL SITE: under -exe the
// emitter passes the EMPTY STRING for a no-argument `println()` / `print()`
// (makeCall in kotlin-to-llvm-ir.abnf), which Kotlin renders identically to no
// argument at all. So `undefined` reaching here is unambiguously kotlin.Unit, and
// k2Render renders it as its name.
//
// Known divergence: `::println` bound to a value and called with no arguments is a
// reference rather than a call of the name, so no emitter can count ITS arguments;
// it prints "kotlin.Unit" natively where llvm.Run prints "".
function k2Line(a) {
    return k2Render(a, 0)
}

// ---------------------------------------------------------------- Char glyphs

// The one-character string a Char code renders as. Twin of jsChar.text in
// abnf/jsrt.go:
//   * a LONE SURROGATE stays itself, so a later concatenation with its other half
//     spells the astral character again ("" + s[0] + s[1] == s).
//   * an astral CODE POINT in one Char box (a `js_char` literal above 0xFFFF)
//     renders as itself, which in a UTF-16 string is the surrogate pair.
function k2ChStr(code) {
    // A NEGATIVE code reaches here from `s.get(i)` out of range, which the Go
    // twin does not guard either: strCodeAt answers -1 and string(rune(-1)) is
    // U+FFFD.
    if (code < 0) { return String.fromCharCode(65533) }
    if (code > 1114111) { return String.fromCharCode(65533) }
    if (code > 65535) {
        var v = code - 65536
        return String.fromCharCode(55296 + Math.floor(v / 1024)) + String.fromCharCode(56320 + (v % 1024))
    }
    return String.fromCharCode(code)
}

// k2Upper / k2Lower are ktUpper / ktLower (jsrtkotlin.go): the Unicode SIMPLE
// case mapping of one code point (unicodeCase modes 1 and 0).
function k2Upper(code) {
    var s = unicodeCase(k2ChStr(code), 1)
    if (k2RuneLen(s) == 1) { return k2CodePointAt(s, 0) }
    return code
}

function k2Lower(code) {
    var s = unicodeCase(k2ChStr(code), 0)
    if (k2RuneLen(s) == 1) { return k2CodePointAt(s, 0) }
    return code
}

// k2IsLetter is ktIsLetter (jsrtkotlin.go:3320): Character.isLetter restricted
// to what this subset can promise - the ASCII letters plus every rune above
// 0x7f that Go classifies as a letter, tested exactly as the Go twin tests it.
function k2IsLetter(code) {
    if (code >= 97 && code <= 122) { return true }
    if (code >= 65 && code <= 90) { return true }
    if (code <= 127) { return false }
    var s = k2ChStr(code)
    return unicodeCase(s, 1) !== unicodeCase(s, 0)
}

// The number of CODE POINTS in s (Go's len([]rune(s))), and the code point at a
// code-point index. Both walk the UTF-16 units and rejoin a surrogate pair.
// Shared as rtRuneLen (lib/runtime.metajs).
function k2RuneLen(s) { return rtRuneLen(s) }

function k2CodePointAt(s, i) {
    var c = s.charCodeAt(i)
    if (c >= 55296 && c <= 56319 && i + 1 < s.length) {
        var t = s.charCodeAt(i + 1)
        if (t >= 56320 && t <= 57343) { return 65536 + (c - 55296) * 1024 + (t - 56320) }
    }
    return c
}

// ---------------------------------------------------------- small primitives

// jsToInt(rt.toNumber(v)) (abnf/jsrt.go:8486): truncation toward zero, with NaN
// answering 0.
function k2Int(v) {
    var f = ktNum(v)
    if (f !== f) { return 0 }
    return Math.trunc(f)
}

// k2Str2 is ktStr2 (jsrtkotlin.go:2579): a string is itself, everything else
// renders through ktpRender.
function k2Str2(v) {
    if (typeof v == "string") { return v }
    return k2Render(v, 0)
}

// ktStrArg is jsrtkotlin.go:3355: an argument rendered the way a String member
// expects it. A Char argument is its glyph, so s.indexOf('B') and s.indexOf("B")
// agree.
function ktStrArg(v) {
    if (ktIsChar(v)) { return k2ChStr(ktCharCode(v)) }
    return k2Str2(v)
