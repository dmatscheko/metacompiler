// ktPairMethod (jsrtkotlin.go:5533) is componentN / toList on the
// {first, second[, third]} shape.
function ktPairMethod(o, name) {
    if (name == "component1") { return o["first"] }
    if (name == "component2") { return o["second"] }
    if (name == "component3") {
        if (k4Own(o, "third")) { return o["third"] }
        return KT_MISS
