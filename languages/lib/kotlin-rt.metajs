                if (!ktMiss(mv)) { return mv }
            }
            // A dotted name on a MAP that is neither one of Kotlin's map properties
            // nor a present key. Kotlin refuses `m.bogus` outright, so no correct
            // program reaches this; what matters is that the two halves answer the
            // SAME thing, and kotlin-interpreter.abnf's kGetField misses to
            // undefined (which renders as kotlin.Unit).
            if (!k4RecvProp(name)) {
                var ki = ktMapFind(ktMapKeys(o), name)
                if (ki < 0) { return undefined }
                // A key the map DOES hold: the Go twin's getMember answers the
                // value (its dictMemberHit arm), so the handle read must too.
                return ktMapVals(o)[ki]
            }
        }
    }
    // js_rxktget is js_get plus Regex.pattern and the MatchResult properties, so it
    // is the tail whenever the regex layer is registered.
    var r = anytype
    r = ktRxFget(o, name)
    if (ktMiss(r)) {
        if (ktIsObj(o)) { r = k4bGetMember(o, name) } else { r = o[name] }
    }
    // `.size` is Kotlin's collection length, and the emitter used to rewrite it to
    // `.length` for EVERY receiver - so a user class declaring its own `size`
    // property read undefined. The rewrite happens HERE, only when the receiver has
    // no `size` of its own.
    if (name == "size") {
        if (k4Nullish(r)) {
            var lr = o["length"]
            if (!k4Nullish(lr)) { return lr }
        }
    }
    // A `lateinit var` that is still null has NOT been assigned.
    if (ktIsObj(o)) { return k4LateinitCheck(o, name, r) }
    return r
}

// js_ktindex (jsrtkotlin.go:2117) is the same rule for the INDEXED read: `m[9]` on
// a map that has no key 9 is null in Kotlin (Map.get answers null), where the
// shared js_kindex answers undefined - which printed "kotlin.Unit" and made
// `m[9] == null` false in the compiler while the interpreter said true.
function js_ktindex(o, k) {
    if (rtIsDictObj(o)) {
        // The Go twin falls through to js_kindex, whose getMember carries a
        // dictMemberHit arm that answers vals[i] for a key the handle holds. The C
        // floor's member read knows nothing of the {__dict, keys, vals} handle, so
        // the hit has to be answered here.
        var mi = ktMapFind(ktMapKeys(o), k)
        if (mi < 0) { return null }
        return ktMapVals(o)[mi]
    }
    var rx = ktRxIndex(o, k)
    if (!ktMiss(rx)) { return rx }
    // js_kindex (abnf/jsrt.go:6095): a STRING index answers a Char, everything else
    // is the ordinary member read.
    if (typeof o == "string") {
        var i = k4Int(k)
        if (i < 0 || i >= o.length) { fail("string index " + i + " out of range") }
        return ktChar(o.charCodeAt(i))
    }
    if (ktIsArr(o)) { return o[k4Int(k)] }
    return o[k]
}

// js_ktglobal(name) (jsrtkotlin.go:1472) is the VALUE of one global builder.
// js_ktglobal(name) carries ONE THING ITS GO TWIN DOES NOT, and the emitter is
// the reason. jsrtkotlin.go's js_ktget resolves an unqualified name against
// Kotlin's IMPLICIT-RECEIVER STACK - what with / run / apply / buildString /
// buildList / buildMap and every T.() -> R lambda push - after its scope walk.
// That stack lives HERE (ktRecvStack), and the emitted kt_ktget helper in
// languages/kotlin-to-llvm-ir.abnf cannot reach it: an emitter may read a scope
// but not a runtime-library variable. So kt_ktget's last-resort arm asks
// js_ktglobal, which is the only extern of the right shape - one NAME, no scope.
//
// In the Go twin ktGlobalFn answers jsUndef for a name it does not know, so
// under llvm.Run this arm changes nothing and jsrtkotlin.go's own js_ktget still
// decides; natively it is what makes `with(list) { size }` and
// `mutableListOf(1, 2).apply { add(3) }` work at all. The receiver stack is
// consulted FIRST because that is js_ktget's order: an unqualified name the
// innermost receiver answers is that receiver's, not the stdlib's.
function js_ktglobal(name) {
    // `this` inside with / run / apply. The Go twin's ktWithRecv binds it in a
    // fresh SCOPE, which layer 2 cannot make, so the receiver stack is where it
    // lives here and an unqualified `this` has to read it off the top.
    if (name == "this") {
        if (ktRecvStack.length > 0) { return ktRecvStack[ktRecvStack.length - 1] }
        return undefined
    }
    var i = ktRecvStack.length - 1
    while (i >= 0) {
        var v = ktRecvMember(ktRecvStack[i], name)
        if (!ktMiss(v)) { return v }
        i = i - 1
    }
    // `kotlin` is the head of a QUALIFIED stdlib path - kotlin.math.abs(-3) - and
    // jsrtkotlin.go answers it at the very END of js_ktget, after the receiver
    // stack. Same place here, for the same reason: only a name nothing else
    // resolves can be the package.
    if (name == "kotlin") { return ktPkg("kotlin") }
    return ktGlobalFn(name)
}

// js_kttype (jsrtkotlin.go:901) is ktTypeObj (jsrtkotlin.go:383): the companion of
// one builtin type. MIN_VALUE / MAX_VALUE are the whole reason a sized integer had
// to exist - Long.MAX_VALUE cannot be written as a plain number at all.
function js_kttype(name) {
    var o = {}
    if (name == "Int") {
        o["MAX_VALUE"] = 2147483647
        o["MIN_VALUE"] = -2147483648
        o["SIZE_BITS"] = 32
        o["SIZE_BYTES"] = 4
        return o
    }
    if (name == "Long") {
        o["MAX_VALUE"] = sint(2147483647, 4294967295, 64, 0)
        o["MIN_VALUE"] = sint(2147483648, 0, 64, 0)
        o["SIZE_BITS"] = 64
        o["SIZE_BYTES"] = 8
        return o
    }
    if (name == "Byte") {
        o["MAX_VALUE"] = sint(0, 127, 8, 0)
        o["MIN_VALUE"] = sint(0, 128, 8, 0)
        o["SIZE_BITS"] = 8
        o["SIZE_BYTES"] = 1
        return o
    }
    if (name == "Short") {
        o["MAX_VALUE"] = sint(0, 32767, 16, 0)
        o["MIN_VALUE"] = sint(0, 32768, 16, 0)
        o["SIZE_BITS"] = 16
        o["SIZE_BYTES"] = 2
        return o
    }
    if (name == "UInt") {
        o["MAX_VALUE"] = sint(0, 4294967295, 32, 1)
        o["MIN_VALUE"] = sint(0, 0, 32, 1)
        o["SIZE_BITS"] = 32
        o["SIZE_BYTES"] = 4
        return o
    }
    if (name == "ULong") {
        o["MAX_VALUE"] = sint(4294967295, 4294967295, 64, 1)
        o["MIN_VALUE"] = sint(0, 0, 64, 1)
        o["SIZE_BITS"] = 64
        o["SIZE_BYTES"] = 8
        return o
    }
    if (name == "UByte") {
        o["MAX_VALUE"] = sint(0, 255, 8, 1)
        o["MIN_VALUE"] = sint(0, 0, 8, 1)
        o["SIZE_BITS"] = 8
        o["SIZE_BYTES"] = 1
        return o
    }
    if (name == "UShort") {
        o["MAX_VALUE"] = sint(0, 65535, 16, 1)
        o["MIN_VALUE"] = sint(0, 0, 16, 1)
        o["SIZE_BITS"] = 16
        o["SIZE_BYTES"] = 2
        return o
    }
    if (name == "Char") {
        o["MAX_VALUE"] = ktChar(65535)
        o["MIN_VALUE"] = ktChar(0)
        o["SIZE_BITS"] = 16
        o["SIZE_BYTES"] = 2
        return o
    }
    // The float companions, boxed so that Double.NaN is a Double rather than an
    // Int: kotlin.Double declares MIN_VALUE as the smallest POSITIVE value, the way
    // java.lang.Double does. The magnitudes are spelled through parseFloat because
    // the MetaJS number rule has no exponent form.
    if (name == "Double" || name == "Float") {
        // Float's five constants are FLOAT boxes (style 3), so Float.MAX_VALUE
        // prints "3.4028235E38" and not the double's 17 digits.
        var fsty = 0
        if (name == "Float") {
            fsty = 3
            o["MAX_VALUE"] = flo(parseFloat("3.4028234663852886e38"), 3)
            o["MIN_VALUE"] = flo(parseFloat("1.401298464324817e-45"), 3)
            o["SIZE_BITS"] = 32
            o["SIZE_BYTES"] = 4
        } else {
            o["MAX_VALUE"] = flo(parseFloat("1.7976931348623157e308"), 0)
            o["MIN_VALUE"] = flo(parseFloat("4.9e-324"), 0)
            o["SIZE_BITS"] = 64
            o["SIZE_BYTES"] = 8
        }
        o["NaN"] = flo(NaN, fsty)
        o["POSITIVE_INFINITY"] = flo(Infinity, fsty)
        o["NEGATIVE_INFINITY"] = flo(-Infinity, fsty)
        return o
    }
    return o
}

// js_ktnameval(v, "topFun") (jsrtkotlin.go:1463) remembers the name a `::` spelled
// against the closure it resolved to, so KFunction.name can answer it, and hands
// the value straight back.
// The hub's half of js_ktnameval: section 4b owns the extern and calls this so
// BOTH name tables (the hub's and the reference layer's) see the same binding.
function k4NameVal(v, name) {
    if (k4Fn(v)) {
        k4NameFns.push(v)
        k4NameStrs.push(name)
    }
    return v
}
// ===================================================== SECTION 5 ============
// Regular expressions: Regex / MatchResult.
//
// The Go twin is abnf/jsrtregexkt.go (the Kotlin half) over abnf/jsrtregex.go
// (the shared engine). This section is the layer-2 port of both:
//
//   (a) the shared engine, `import "./regex.js"` immediately below - the SAME
//       text js, python and ruby import. It needs no adaptation: regex.js is
//       already written in this MetaJS subset. Only the rxFail knob is
//       re-pointed, right after the import, so a step-limit blowup reports the
//       Go twin's text rather than the engine's default.
//
//       THIS USED TO BE 1,489 LINES OF regex.js PASTED IN VERBATIM, kept in step
//       BY HAND, and the import was measured and REVERTED TWICE (+18-23% on wall
//       clock, then +10.7% on instructions retired). BOTH VERDICTS DIED WITH THE
//       DECLARATION TAX. `import` PREPENDS an imported file's top-level
//       declarations to jsrun (metajs-to-llvm-ir.abnf ~590/~1011), so importing
//       regex.js relocates 86 declarations to index 0; while runtime.c's
//       scope_find was a LINEAR SCAN of the module scope's name array that cost
//       +9.5%, and the six bodies kotlin does not call cost a further +1.1%.
//       scope_find has had a HASH INDEX since 2026-08-04 (e1307f3), lookups are
//       O(1), and the only work the import adds is SIX extra js_tdecl calls at
//       module init. Re-measured at e1307f3, native -exe, /usr/bin/time -l
//       INSTRUCTIONS RETIRED, as a MEAN OVER MANY BUILDS (see the warning below):
//
//                                  old (verbatim)   new (import)    delta
//           40,000 x s = s + i%7   mean 17.989 G    mean 17.976 G   -0.07%  n=20
//                                    95% CI on the delta [-0.60%, +0.38%]
//           1,000 x regexp ops     mean 15.052 G    mean 15.093 G   +0.28%  n=14
//                                    95% CI on the delta [-0.60%, +1.17%]
//           println("hi")          med  27.076 M    med  27.048 M   -0.10%  n=10
//
//       BOTH INTERVALS STRADDLE ZERO. The change is not measurable on this
//       machine in either direction, and it shipped on the CORRECTNESS argument:
//       1,489 lines that had to be kept in step BY HAND against a regex.js that
//       three other languages already import and abnf/jsrtregex.go line-by-line
//       ports. The third row is where a module-init cost would show, and it does
//       not; MEC_GC_STATS is byte-identical (pinned=13) either way.
//
//       *** DO NOT A/B THIS FILE WITH A SINGLE BUILD PER VARIANT. *** Take ONE
//       byte-identical kotlin-rt.ll, one source, one tree, and vary nothing but
//       the LENGTH OF THE -exe OUTPUT FILENAME: 17.756 .. 18.600 G, a 4.8%
//       bimodal spread. It is not the run and not codegen - six rebuilds to one
//       path give md5-identical binaries and 0.05% spread. The path string lands
//       in the binary and moves the code layout, and so does this file's own
//       content, identically - so holding the -exe path fixed across variants
//       CANCELS NOTHING. Two careful people measured these same two sources at
//       +0.04% and +0.65% before working this out; both were single draws.
//       Average over >=15 draws and quote an interval, or it is not a
//       measurement.
//
//       WHAT THIS COSTS: kotlin now carries the six bodies its grammar never
//       reaches - rxMatchAt, rxTest, rxGroupCount, rxNameAt, rxReplace, rxSplit.
//       A runtime-regex.metajs split would drop exactly those six; since six
//       declarations are worth nothing measurable it would buy nothing while
//       re-introducing a second regex text to hand-synchronise, so it was NOT
//       created. What the import BUYS is that a change to lib/regex.js can no
//       longer fail to arrive here.
//
//       See docs/runtime-merge-plan.md, "THE THIRD ASKING".
//   (b) the Kotlin layer, under the private prefix k5.
//   (c) the two externs js_rxktnew and js_rxktglobal.
//
// SKIPPED, and why: the Go file also registers js_rxktmcall, js_rxktget and
// js_rxktindex. Those three are WRAPPERS - each one tests the receiver, hands a
// Regex / MatchResult / groups-holder to ktRxMethod / ktRxField / ktRxGroupAt and
// otherwise delegates to js_mcall / js_get / js_kindex. Layer 2 does not own
// those hubs (SECTION 4a does), so the wrappers are not reproduced here; the
// hub calls ktRxMethod / ktRxFget / ktRxIndex, which answer KT_MISS on a miss.
//
// The engine's names are rx* / RX_*; everything invented for Kotlin here is k5*.

import "./regex.js"

// ===================================================== the Kotlin layer =====
//
// From here down is the port of abnf/jsrtregexkt.go. The value model is the
// engine's own: a Regex is {__rxsrc, __rxflags}, a MatchResult is that plus
// {__rxmd, __rxtext, __rxcaps} and __ktsrc - the source of the regexp the match
// CAME FROM, which is what next() re-searches with.

// rxFail is the engine's error knob (see its head comment). Point it at the
// Go twin's wording: rt.fail("regexp: step limit exceeded"). The "invalid
// regexp" path of the knob is unreachable from here - k5Check runs first and
// reports the pattern the way ktRxCheck does.
rxFail = function (msg) { fail("regexp: " + msg) }

// The compile cache is SHARED as rxCache / rxGet - lib/regex.js, where
// abnf/jsrtregex.go has always had it: ONE cache for js, kotlin, python and
// ruby. Four byte-identical private copies retired.

function k5Check(re) {
    if (!re["ok"]) { fail("invalid regex '" + re["src"] + "': " + re["err"]) }
    return re
}

function k5Search(re, text, at) {
    k5Check(re)
    return rxSearch(re, text, at)
}

// k5Whole is Kotlin's matches() / matchEntire(): the pattern must cover the
// WHOLE input. That is the engine's own rxMatchWhole - one program, no anchoring
// wrapper, and therefore no quarrel with the x flag's trailing comments.
function k5Whole(re, text) {
    k5Check(re)
    return rxMatchWhole(re, text, 0)
}

// The two value tests are SHARED as rxIsRegexObj / rxIsMatchObj - lib/regex.js,
// the Go twin's own names for them. ruby's rbRxIsRegex / rbRxIsMatch were the
// same bodies; the difference list is at the shared site.
function ktRxIsRegex(v) { return rxIsRegexObj(v) }

function ktRxIsMatch(v) { return rxIsMatchObj(v) }

function k5IsGroups(v) {
    if (!ktIsObj(v)) { return false }
    return !ktIsNullish(v["__ktgroups"])
}

// k5IsCompanion answers the `Regex` name used as a value (Regex.escape(...)).
function k5IsCompanion(v) {
    if (!ktIsObj(v)) { return false }
    return !ktIsNullish(v["__ktrxco"])
}

// SHARED as rxObjRe - lib/regex.js. ruby's rbRxObjRe was the same seven lines.
function k5ObjRe(v) { return rxObjRe(v) }

// k5NewMatch builds a MatchResult over `prog` (the program the match ran on)
// while remembering `origSrc`, the pattern of the Regex the match came from.
function k5NewMatch(prog, origSrc, text, m) {
    var caps = []
    var mc = m["caps"]
    var i = 0
    while (i < mc.length) {
        caps.push(mc[i])
        i = i + 1
    }
    return {__rxmd: true, __rxsrc: prog["src"], __rxflags: prog["flags"],
            __rxtext: text, __rxcaps: caps, __ktsrc: origSrc}
}

// k5Orig is the plain (unanchored) program of the regexp a MatchResult came from.
function k5Orig(md) {
    var src = md["__ktsrc"]
    var flags = md["__rxflags"]
    if (typeof src != "string") { src = "" }
    if (typeof flags != "string") { flags = "" }
    return rxGet(src, flags)
}

// The Go twin's rxMatchOf answers three values; MetaJS has one return, so the
// three travel in a record. text stays a STRING: regex.js indexes UTF-16 code
// units where the Go engine indexes runes, which agree throughout the BMP.
// SHARED as rxMatchOf - lib/regex.js, with ruby's rbRxMatchOf and python's
// pyERxMatchOf. The one difference was the capture coercion (ktNum here) and it
// is the identity on every value __rxcaps can hold; see the shared site.
function k5MatchOf(v) { return rxMatchOf(v) }

// ----- Flags -----
//
// The engine's neutral letters are i (fold case), s (dot matches newline), m
// (^/$ are LINE anchors) and x (extended). Kotlin's RegexOption maps onto them
// one for one; Kotlin, like Java and unlike Ruby, anchors ^/$ to the whole input
// UNLESS MULTILINE is given, so "m" is NOT forced on. LITERAL is not a match
// mode - it quotes the pattern. CANON_EQ and UNIX_LINES are reported rather than
// silently ignored. "q" is unconditional: the JVM dialect always understands
// \Q...\E quote regions, which is what Pattern.quote emits.
function k5Flags(opts) {
    var names = []
    if (!ktIsNullish(opts)) {
        if (ktIsArr(opts)) {
            var ai = 0
            while (ai < opts.length) {
                names.push(ktRender(opts[ai]))
                ai = ai + 1
            }
        } else if (ktIsSet(opts)) {
            // setOf(...) is the idiomatic spelling and answers a SET, not a list.
            var es = ktSetElems(opts)
            var si = 0
            while (si < es.length) {
                names.push(ktRender(es[si]))
                si = si + 1
            }
        } else {
            names.push(ktRender(opts))
        }
    }
    var flags = "q"
    var literal = false
    var k = 0
    while (k < names.length) {
        var o = names[k]
        if (o == "IGNORE_CASE") { flags = flags + "i" }
        else if (o == "DOT_MATCHES_ALL") { flags = flags + "s" }
        else if (o == "MULTILINE") { flags = flags + "m" }
        else if (o == "COMMENTS") { flags = flags + "x" }
        else if (o == "LITERAL") { literal = true }
        else if (o == "CANON_EQ" || o == "UNIX_LINES") {
            fail("RegexOption." + o + " is not supported")
        } else {
            fail("unknown RegexOption: " + o)
        }
        k = k + 1
    }
    return {flags: flags, literal: literal}
}

// k5Quote is Regex.escape / RegexOption.LITERAL: Pattern.quote, i.e. a \Q...\E
// quote region, which the shared engine understands - so this answers the SAME
// TEXT the JVM does and not merely an equivalent one. An embedded \E has to close
// and reopen the region, exactly as java.util.regex.Pattern.quote spells it.
function k5Quote(s) {
    var out = ""
    var i = 0
    while (i < s.length) {
        if (s.charAt(i) == "\\" && i + 1 < s.length && s.charAt(i + 1) == "E") {
            out = out + "\\E\\\\E\\Q"
            i = i + 2
            continue
        }
        out = out + s.charAt(i)
        i = i + 1
    }
    return "\\Q" + out + "\\E"
}

// ----- Replacement templates -----
//
// Kotlin's template is $1 / ${name}, with a backslash escaping the next
// character; the shared engine expands \1 / \k<name>. The rewrite happens here.
function k5Template(t) {
    var out = ""
    var i = 0
    var n = t.length
    while (i < n) {
        var c = t.charAt(i)
        if (c == "\\") {
            if (i + 1 >= n) {
                out = out + "\\\\"
                i = i + 1
                continue
            }
            if (t.charAt(i + 1) == "\\") { out = out + "\\\\" } else { out = out + t.charAt(i + 1) }
            i = i + 2
            continue
        }
        if (c == "$" && i + 1 < n) {
            var d = t.charCodeAt(i + 1)
            if (d >= 48 && d <= 57) {
                out = out + "\\" + t.charAt(i + 1)
                i = i + 2
                continue
            }
            if (d == 123) { // {
                var j = i + 2
                while (j < n && t.charCodeAt(j) != 125) { j = j + 1 }
                var nm = t.substring(i + 2, j)
                var c0 = -1
                if (nm.length > 0) { c0 = nm.charCodeAt(0) }
                if (c0 >= 48 && c0 <= 57) {
                    out = out + "\\" + nm.substring(0, 1)
                } else {
                    out = out + "\\k<" + nm + ">"
                }
                i = j + 1
                continue
            }
        }
        out = out + c
        i = i + 1
    }
    return out
}

function k5EscapeRepl(s) {
    var out = ""
    var i = 0
    while (i < s.length) {
        var c = s.charAt(i)
        if (c == "\\" || c == "$") { out = out + "\\" }
        out = out + c
        i = i + 1
    }
    return out
}

// ----- The operations -----

function k5Replace(re, s, repl, all) {
    k5Check(re)
    var out = ""
    var at = 0
    var last = 0
    while (at <= s.length) {
        var m = k5Search(re, s, at)
        if (m === null) { break }
        out = out + s.substring(last, m["begin"]) + rxExpand(re, s, m, repl)
        if (m["end"] == m["begin"]) {
            if (m["end"] < s.length) { out = out + s.charAt(m["end"]) }
            last = m["end"] + 1
            at = m["end"] + 1
        } else {
            last = m["end"]
            at = m["end"]
        }
        if (!all) { break }
    }
    if (last <= s.length) { out = out + s.substring(last, s.length) }
    return out
}

// Regex#replace(input) { m -> ... }: the lambda produces each replacement.
function k5ReplaceFn(re, s, fn) {
    var out = ""
    var at = 0
    var last = 0
    while (at <= s.length) {
        var m = k5Search(re, s, at)
        if (m === null) { break }
        var md = k5NewMatch(re, re["src"], s, m)
        out = out + s.substring(last, m["begin"]) + ktRender(ktCall1(fn, md))
        if (m["end"] == m["begin"]) {
            if (m["end"] < s.length) { out = out + s.charAt(m["end"]) }
            last = m["end"] + 1
            at = m["end"] + 1
        } else {
            last = m["end"]
            at = m["end"]
        }
    }
    if (last <= s.length) { out = out + s.substring(last, s.length) }
    return out
}

// Regex#split. limit 0 (Kotlin's default) means no limit; a positive limit stops
// after limit-1 cuts and keeps the rest of the input as the last part.
function k5Split(re, s, limit) {
    k5Check(re)
    var parts = []
    var at = 0
    var last = 0
    while (at <= s.length) {
        if (limit > 0 && parts.length >= limit - 1) { break }
        var m = k5Search(re, s, at)
        if (m === null) { break }
        if (m["end"] == m["begin"]) {
            if (m["begin"] >= s.length) { break }
            parts.push(s.substring(last, m["begin"] + 1))
            last = m["begin"] + 1
            at = m["begin"] + 1
        } else {
            parts.push(s.substring(last, m["begin"]))
            last = m["end"]
            at = m["end"]
        }
    }
    parts.push(s.substring(last, s.length))
    return parts
}

function k5FindAll(re, s) {
    k5Check(re)
    var out = []
    var at = 0
    while (at <= s.length) {
        var m = k5Search(re, s, at)
        if (m === null) { break }
        out.push(k5NewMatch(re, re["src"], s, m))
        if (m["end"] == m["begin"]) { at = m["end"] + 1 } else { at = m["end"] }
    }
    return out
}

// groupValues: index 0 is the whole match and a group that did not take part
// reads as "" (Kotlin), unlike groups[i], which is null there.
function k5GroupValues(re, text, m) {
    var out = []
    var i = 0
    while (i <= re["ngroups"]) {
        var g = rxGroup(re, text, m, i)
        if (g === null) { out.push("") } else { out.push(g) }
        i = i + 1
    }
    return out
}

function k5Range(first, last) { return {first: first, last: last} }

// m.groups[i] / m.groups["name"]: a MatchGroup (value + range) or null.
// A group that took no part reads as null; an index or a name that does not
// exist at all is an error, as it is on the JVM.
function k5GroupAt(md, key) {
    var mo = k5MatchOf(md)
    var re = mo["re"]
    var i = -1
    if (ktIsStr(key)) {
        i = rxIndexOfName(re, key)
        if (i < 0) { fail("no group with name '" + key + "'") }
    } else {
        i = Math.trunc(ktNum(key))
        if (i < 0 || i > re["ngroups"]) { fail("group index " + i + " out of range") }
    }
    var g = rxGroup(re, mo["text"], mo["m"], i)
    if (g === null) { return null }
    var caps = mo["m"]["caps"]
    return {value: g, range: k5Range(caps[2 * i], caps[2 * i + 1] - 1)}
}

function k5Arg(args, i) {
    if (i >= args.length) { return undefined }
    return args[i]
}

function k5ArgInt(args, i, dflt) {
    if (i >= args.length) { return dflt }
    if (ktIsNullish(args[i])) { return dflt }
    return Math.trunc(ktNum(args[i]))
}

// ----- Construction -----

function ktRxNew(src, flags) {
    var fl = k5Flags(flags)
    var pat = ktRender(src)
    if (fl["literal"]) { pat = k5Quote(pat) }
    k5Check(rxGet(pat, fl["flags"]))
    return {__rxsrc: pat, __rxflags: fl["flags"]}
}

// The `RegexOption` and `Regex` names used as VALUES. A RegexOption is modelled
// as its own name, so it prints the way Kotlin prints an enum entry.
function ktRxGlobal(name) {
    if (ktRender(name) == "Regex") { return {__ktrxco: true} }
    return {IGNORE_CASE: "IGNORE_CASE", MULTILINE: "MULTILINE",
            DOT_MATCHES_ALL: "DOT_MATCHES_ALL", COMMENTS: "COMMENTS",
            LITERAL: "LITERAL", CANON_EQ: "CANON_EQ", UNIX_LINES: "UNIX_LINES"}
}

// ----- The dispatchers -----

// ktRxMethod answers a call whose receiver is the Regex companion, a Regex, a
// MatchResult, or a String with a Regex argument, and KT_MISS otherwise.
function ktRxMethod(recv, name, args) {
    if (k5IsCompanion(recv)) {
        if (name == "escape") { return k5Quote(ktRender(k5Arg(args, 0))) }
        if (name == "escapeReplacement") { return k5EscapeRepl(ktRender(k5Arg(args, 0))) }
        if (name == "fromLiteral") { return ktRxNew(k5Arg(args, 0), "LITERAL") }
        return KT_MISS
    }
    if (ktIsStr(recv)) {
        if (name == "toRegex") { return ktRxNew(recv, k5Arg(args, 0)) }
        // The String members that take a pattern. A non-Regex argument is left to
        // the ordinary String behaviour, so plain replace/split/contains are
        // untouched.
        if (args.length > 0 && ktRxIsRegex(args[0])) {
            var sre = k5ObjRe(args[0])
            if (name == "matches") { return k5Whole(sre, recv) !== null }
            if (name == "contains") { return k5Search(sre, recv, 0) !== null }
            if (name == "split") { return k5Split(sre, recv, k5ArgInt(args, 1, 0)) }
            if (name == "replace") {
                if (ktIsFn(k5Arg(args, 1))) { return k5ReplaceFn(sre, recv, args[1]) }
                return k5Replace(sre, recv, k5Template(ktRender(k5Arg(args, 1))), true)
            }
            if (name == "replaceFirst") {
                return k5Replace(sre, recv, k5Template(ktRender(k5Arg(args, 1))), false)
            }
        }
        return KT_MISS
    }
    if (ktRxIsRegex(recv)) {
        var rre = k5ObjRe(recv)
        if (name == "matches") { return k5Whole(rre, ktRender(k5Arg(args, 0))) !== null }
        if (name == "containsMatchIn") { return k5Search(rre, ktRender(k5Arg(args, 0)), 0) !== null }
        if (name == "find") {
            var fs = ktRender(k5Arg(args, 0))
            var fm = k5Search(rre, fs, k5ArgInt(args, 1, 0))
            if (fm === null) { return null }
            return k5NewMatch(rre, rre["src"], fs, fm)
        }
        if (name == "findAll") { return k5FindAll(rre, ktRender(k5Arg(args, 0))) }
        if (name == "matchEntire") {
            var es = ktRender(k5Arg(args, 0))
            var em = k5Whole(rre, es)
            if (em === null) { return null }
            return k5NewMatch(rre, rre["src"], es, em)
        }
        if (name == "replace") {
            if (ktIsFn(k5Arg(args, 1))) { return k5ReplaceFn(rre, ktRender(k5Arg(args, 0)), args[1]) }
            return k5Replace(rre, ktRender(k5Arg(args, 0)),
                             k5Template(ktRender(k5Arg(args, 1))), true)
        }
        if (name == "replaceFirst") {
            return k5Replace(rre, ktRender(k5Arg(args, 0)),
                             k5Template(ktRender(k5Arg(args, 1))), false)
        }
        if (name == "split") { return k5Split(rre, ktRender(k5Arg(args, 0)), k5ArgInt(args, 1, 0)) }
        if (name == "toString") { return rre["src"] }
        fail("unknown Regex method: " + name)
    }
    if (ktRxIsMatch(recv)) {
        var mo = k5MatchOf(recv)
        if (name == "next") {
            var mm = mo["m"]
            var at = mm["end"]
            if (mm["end"] == mm["begin"]) { at = mm["end"] + 1 }
            var orig = k5Orig(recv)
            if (at > mo["text"].length) { return null }
            var nm = k5Search(orig, mo["text"], at)
            if (nm === null) { return null }
            return k5NewMatch(orig, orig["src"], mo["text"], nm)
        }
        if (name == "toString") {
            var wg = rxGroup(mo["re"], mo["text"], mo["m"], 0)
            if (wg === null) { return "" }
            return wg
        }
        fail("unknown MatchResult method: " + name)
    }
    return KT_MISS
}

// ktRxFget is Regex.pattern and the MatchResult properties.
function ktRxFget(o, name) {
    if (ktRxIsRegex(o)) {
        if (name == "pattern") { return k5ObjRe(o)["src"] }
        if (name == "options") { return [] }
        return KT_MISS
    }
    if (ktRxIsMatch(o)) {
        var mo = k5MatchOf(o)
        if (name == "value") {
            var g = rxGroup(mo["re"], mo["text"], mo["m"], 0)
            if (g === null) { return "" }
            return g
        }
        if (name == "range") { return k5Range(mo["m"]["begin"], mo["m"]["end"] - 1) }
        if (name == "groupValues") { return k5GroupValues(mo["re"], mo["text"], mo["m"]) }
        if (name == "groups") { return {__ktgroups: o} }
        if (name == "destructured") {
            // `val (a, b) = m.destructured` reads componentN, and this subset takes
            // componentN of a LIST positionally - so the holder IS the group list
            // without the whole match, which both halves of the pair agree on.
            var all = k5GroupValues(mo["re"], mo["text"], mo["m"])
            var rest = []
            var di = 1
            while (di < all.length) {
                rest.push(all[di])
                di = di + 1
            }
            return rest
        }
        return KT_MISS
    }
    if (k5IsGroups(o)) {
        // The compiler grammar rewrites a `.size` read to `.length` (its lists are
        // arrays), so both spellings arrive here.
        if (name == "size" || name == "length") {
            var gm = k5MatchOf(o["__ktgroups"])
            return gm["re"]["ngroups"] + 1
        }
        return KT_MISS
    }
    return KT_MISS
}

function ktRxIndex(o, key) {
    if (!k5IsGroups(o)) { return KT_MISS }
    return k5GroupAt(o["__ktgroups"], key)
}

// ----- The externs -----
//
// Regex(pattern) / Regex(pattern, options) / "pat".toRegex(): the pattern is
// validated in ktRxNew, so a bad one is a clean runtime error rather than a
// wrong match.
function js_rxktnew(pat, opts) { return ktRxNew(pat, opts) }

function js_rxktglobal(name) { return ktRxGlobal(name) }
// ============================================================================
// SECTION 6 - THE SCOPE-TAKING EXTERNS, WHICH LAYER 2 CANNOT WRITE
// ============================================================================
//
// Ten of Kotlin's externs take a SCOPE HANDLE. A scope is the C floor's PRIVATE
// storage: languages/lib/runtime.c seeds no accessor for one (the seed_root list
// is println/print/eprintln/parseInt/parseFloat/exit/byteLen/sprintf/printf/
// sprint/fail/sint*/flo*/keysOf/sintRaw/Infinity/NaN/anytype/Math/String/Array
// and nothing else), and layer 2 cannot call a js_* extern either. So none of
// these can be implemented here at all - which is the same position php's
// js_phthis, swift's and dart's js_kget/js_kset and go's js_gounctl were in.
//
// Kotlin's answer is the same as theirs and it is in the EMITTER
// (languages/kotlin-to-llvm-ir.abnf, the rtKtGet / rtKSet / rtVarSet helpers):
// an emitter MAY call js_scope_typeof / js_scope_get / js_scope_set, so the
// INNERMOST binding, the INNERMOST `this` and the INNERMOST `__dispatch` are all
// reachable and are lowered into IR. What is NOT reachable is
//
//   * any frame FURTHER OUT than the innermost one carrying `this` - the floor
//     seeds no scope-PARENT accessor, so the chain cannot be walked; and
//   * Kotlin's implicit-receiver STACK, which ktWithRecv pushes inside the
//     runtime for with / run / apply / buildString / buildList / buildMap and
//     for every `T.() -> R` lambda, and which js_ktget consults after the two
//     probes above.
//
// Those two residues are what the functions below stand for. Each aborts with
// the same message, naming the primitive that would remove it, so a native run
// that reaches one says exactly what is missing instead of dying obscurely.
// See the KOTLIN section of docs/runtime-next-plan.md for the measurement.

function k6NoScope(name) {
    fail("kotlin layer 2: " + name + " needs to WALK a scope chain, which the C floor keeps private. " +
         "A scopeParent(scope) / scopeGet(scope, name) host builtin would let this move back into layer 2 " +
         "- see the KOTLIN section of docs/runtime-next-plan.md part 3.")
}

function js_ktget(env, name) { k6NoScope("js_ktget(" + name + ")") }
// The WRITE twin of the js_ktglobal arm above. By the time the emitted kt_kset /
// kt_varset helpers give up, the name is neither a local nor a property of the
// innermost `this` nor of the innermost `__dispatch`, and the Go twin's remaining
// arms all walk the chain. One of them IS reachable from here, and it is the one
// that matters in practice: a write to a property of an IMPLICIT RECEIVER, which
// is `with(node) { tag = "x" }`. ktRecvStack is layer 2's own, so the walk is an
// ordinary loop. Anything else is the residue the message names.
function k6RecvWrite(name, v, who) {
    var i = ktRecvStack.length - 1
    while (i >= 0) {
        var r = ktRecvStack[i]
        if (ktIsObj(r)) {
            if (r[name] !== undefined) {
                r[name] = v
                return 0
            }
        }
        i = i - 1
    }
    k6NoScope(who + "(" + name + ")")
    return 0
}

function js_kset(env, name, v) { return k6RecvWrite(name, v, "js_kset") }
function js_ktvarset(env, name, v) { return k6RecvWrite(name, v, "js_ktvarset") }
function js_ktouter(env, name) { k6NoScope("js_ktouter(" + name + ")") }
// js_ktrefbase is the ONE scope extern that still has a native answer, because
// the emitter reaches it only where the scope does not matter. kt_refbase in
// languages/kotlin-to-llvm-ir.abnf lowers the scope walk and the `this` probe;
// what is left is jsrtkotlin.go's FIRST arm - a builtin TYPE name, which the
// emitter decides statically - and its LAST arm, "nothing carries this name, so
// it names a type". Both answer a ktTypeName marker in the Go twin. Layer 2
// cannot make a Go type, so the marker is the NAME ITSELF as a string, which is
// exactly the shape js_ktref reads as "the base named a type".
function js_ktrefbase(env, name) { return name }
function js_ktbareref(env, name) { k6NoScope("js_ktbareref(" + name + ")") }
function js_ktdthis(env) { k6NoScope("js_ktdthis") }
// The three MEMBER-EXTENSION externs. The emitter (kt_mextfind) already tried the
// innermost `this` and the innermost `__dispatch` and missed, so what is left is
// the IMPLICIT-RECEIVER STACK: in `with(i) { 7.scaled() }` the Go twin's
// ktWithRecv binds the receiver in a fresh SCOPE, which layer 2 cannot make, so
// the same receiver is on ktRecvStack instead and the walk is an ordinary loop
// over it. The fallback below each is the Go twin's own.
function k6MextFind(mangled) {
    var i = ktRecvStack.length - 1
    while (i >= 0) {
        var r = k4bMextWalk(ktRecvStack[i], mangled)
        if (r !== undefined) { return r }
        i = i - 1
    }
    return undefined
}

function js_ktmextget(env, recv, name) {
    var r = k6MextFind("extget$" + name)
    if (r !== undefined) { return ktCall(r["fn"], [r["disp"], recv]) }
    return js_ktfget(recv, name)
}

function js_ktmextset(env, recv, name, v) {
    var r = k6MextFind("extset$" + name)
    if (r !== undefined) {
        ktCall(r["fn"], [r["disp"], recv, v])
        return v
    }
    recv[name] = v
    return v
}

function js_ktmextcall(env, recv, name, args) {
    var r = k6MextFind("ext$" + name)
    if (r !== undefined) {
        var a = [r["disp"], recv]
        var i = 0
        while (i < args.length) {
            a.push(args[i])
            i = i + 1
        }
        return ktCall(r["fn"], a)
    }
    return js_ktsmcall(recv, name, args)
}
