    }
    // ----- kotlinx.coroutines, as a SYNCHRONOUS subset -----
    // Everything runs IMMEDIATELY and to completion on the calling thread: the
    // RESULTS are right and the ORDERING is not.
    var coro = false
    if (name == "runBlocking") { coro = true }
    if (name == "coroutineScope") { coro = true }
    if (name == "supervisorScope") { coro = true }
    if (name == "withContext") { coro = true }
    if (coro) {
        return function () {
            var as = []
            var i = 0
            while (i < arguments.length) {
                as.push(arguments[i])
                i = i + 1
            }
            return k4CoroRun(as)
        }
    }
    if (name == "async" || name == "launch") {
        return function () {
            var as = []
            var i = 0
            while (i < arguments.length) {
                as.push(arguments[i])
                i = i + 1
            }
            return k4MakeJob(k4CoroRun(as))
        }
    }
    if (name == "delay" || name == "yield") {
        return function () { return undefined }
    }
    if (name == "Job") {
        return function () { return k4MakeJob(undefined) }
    }
    if (name == "CoroutineScope") {
        return function () {
            var o = {}
            o["__coroscope"] = true
            return o
        }
    }
    if (name == "awaitAll") {
        return function () {
            var out = []
            var i = 0
            while (i < arguments.length) {
                var a = arguments[i]
                if (k4IsJob(a)) { out.push(a["v"]) } else { out.push(a) }
                i = i + 1
            }
            return out
        }
    }
    // Dispatchers.IO / Main / Default / Unconfined are NAMES here: nothing
    // dispatches, so they carry no behaviour, but a program that mentions one still
    // runs.
    if (name == "Dispatchers") {
        var ds = {}
        ds["IO"] = "Dispatchers.IO"
        ds["Main"] = "Dispatchers.Main"
        ds["Default"] = "Dispatchers.Default"
        ds["Unconfined"] = "Dispatchers.Unconfined"
        return ds
    }
    if (name == "lazy") {
        return function (f) {
            var o = {}
            o["__lazy"] = true
            o["f"] = f
            o["done"] = false
            o["v"] = null
            return o
        }
    }
    // A Sequence is EAGER here, so an infinite generator is capped rather than lazy.
    if (name == "generateSequence") {
        return function (seed, next) {
            var v = anytype
            if (k4Fn(seed)) { v = ktCall(seed, []) } else { v = seed }
            var out = []
            var guard = 0
            var cap = k4SeqCap()
            while (guard < cap) {
                if (rtIsNil(v)) { guard = cap } else {
                    out.push(v)
                    if (!k4Fn(next)) { guard = cap } else {
                        v = ktCall1(next, v)
                        guard = guard + 1
                    }
                }
            }
            // The cap is a REAL limit, not a formality: an eager Sequence cannot
            // represent an infinite generator, so say so instead of handing back a
            // silently truncated list.
            if (out.length >= cap) {
                eprintln("warning: generateSequence is EAGER here and stopped at " +
                    cap + " elements; a Sequence is not lazy in this subset")
            }
            return out
        }
    }
    return undefined
}

// max / min / maxOf / minOf: the running best over every argument.
function k4MinMax(wantMax) {
    var want = wantMax
    return function () {
        var best = anytype
        best = k4At(arguments, 0)
        var i = 1
        while (i < arguments.length) {
            if (k4KeyLess(best, arguments[i]) === want) { best = arguments[i] }
            i = i + 1
        }
        return best
    }
}

// ============================================================================
// THE `::` NAME TABLE
// ============================================================================
//
// ktFuncNames (jsrtkotlin.go:5764) is a side table keyed by the closure value. The
// Go twin keys a map by the hostFunc pointer; layer 2 has no map keyed by a
// handle, so the two parallel arrays below are scanned with `===`, which is the
// same identity question.
var k4NameFns = []
var k4NameStrs = []

// The two-parallel-array lookup is shared as rtPairGet (lib/runtime.metajs).

// ============================================================================
// THE NEUTRAL TAIL: rt.memberCall (abnf/jsrt.go:2761)
// ============================================================================
//
// The last resort of js_ktsmcall is the shared js_mcall, which layer 2 cannot
// call. Only the arms a Kotlin receiver can still reach after the whole Kotlin
// surface above has declined are here - which in practice is the USER-CLASS
// dispatch, since ktStrMethod / ktSeqMethod / ktMapMethod already own the string,
// list and map surfaces. The *jsGenerator arm is NOT reproducible (its member
// table is the floor's) and is named at the fallthrough instead of guessed at.
function k4BaseMcall(recv, name, args) {
    if (typeof recv == "string") {
        if (name == "length") { return recv.length }
        if (name == "charAt") {
            var ci = k4Int(k4At(args, 0))
            if (ci < 0 || ci >= recv.length) { fail("charAt out of range") }
            return recv.charAt(ci)
        }
        if (name == "equals") { return ktIdent(recv, k4At(args, 0)) }
        if (name == "substring") {
            var b = 0
            var e = recv.length
            if (args.length > 0) { b = k4Int(args[0]) }
            if (args.length > 1) { e = k4Int(args[1]) }
            return recv.substring(b, e)
        }
        if (name == "indexOf") { return recv.indexOf(ktRender(k4At(args, 0))) }
        if (name == "isEmpty") { return recv.length == 0 }
        fail("unknown String method: " + name)
        return undefined
    }
    if (rtIsDictObj(recv)) {
        // The Python dict methods.
        if (name == "keys") { return rtCopyArr(ktMapKeys(recv)) }
        if (name == "values") { return rtCopyArr(ktMapVals(recv)) }
        if (name == "get") {
            var gi = ktMapFind(ktMapKeys(recv), k4At(args, 0))
            if (gi >= 0) { return ktMapVals(recv)[gi] }
            if (args.length > 1) { return args[1] }
            return undefined
        }
        fail("unknown dict method '" + name + "'")
        return undefined
    }
    if (ktIsArr(recv)) {
        // abnf/jsrt.go's arrayMethod answers the PROPERTY names as members
        // (`size`), and ktRecvProp lists exactly this set, so an implicit receiver
        // reached through with / run / apply asks for them here after ktSeqMethod
        // has declined (`with(list) { size }`).
        if (name == "size") { return recv.length }
        if (name == "length") { return recv.length }
        if (name == "get") {
            var gi = k4Int(k4At(args, 0))
            if (gi < 0 || gi >= recv.length) { fail("list index " + gi + " out of range") }
            return recv[gi]
        }
        fail("unknown list method '" + name + "'")
        return undefined
    }
    if (ktIsObj(recv)) {
        var cls = recv["__class"]
        if (cls !== undefined) {
            // The lookup follows the __super chain (single inheritance).
            var c = cls
            var guard = 0
            while (guard < 64) {
                guard = guard + 1
                if (!ktIsObj(c)) { guard = 99 } else {
                    var mm = c[name]
                    if (k4Fn(mm)) { return mm.apply(undefined, rtPrepend(recv, args)) }
                    c = c["__super"]
                }
            }
            fail("unknown method '" + name + "' on an instance")
            return undefined
        }
        var f = recv[name]
        if (k4Fn(f)) { return f.apply(undefined, args) }
        fail("unknown method '" + name + "'")
        return undefined
    }
    fail("method call '" + name + "' on a " + typeof recv)
    return undefined
}

// ============================================================================
// THE HUB
// ============================================================================

// ktSmcall is js_ktsmcall (jsrtkotlin.go:1119): Kotlin's method-call entry point.
// The dispatchers are tried in EXACTLY the Go twin's order; every arm below is one
// of its branches, in place.
// Whether a class descriptor chain declares `name` - the guard the Any-member
// fallbacks owe a user class that overrides toString() or hashCode().
function k4ChainDeclares(v, name) {
    if (!ktIsObj(v)) { return false }
    if (v["__class"] === undefined) { return false }
    return ktClassChainHas(v, name)
}

function ktSmcall(recv, name, args) {
    var rv = anytype
    rv = recv
    var as = args
    if (as === undefined) { as = [] }
    // A range materialized into its elements is still not a List: IntRange is an
    // Iterable, so its empty-receiver messages are the Collection ones. The kind is
    // remembered here because ktRangeList below is what loses it.
    var rvKind = "List"

    // A callable reference receiver: get / set / invoke, with the receiver as the
    // FIRST argument when the reference is unbound (Kotlin's KProperty1.get).
    var info = ktRefOf(rv)
    if (k4IsRef(info)) {
        if (name == "invoke") { return ktRefApply(info, as) }
        if (name == "get") { return js_ktfget(k4RefRecv(info, as), info["name"]) }
        if (name == "set") {
            var rest = k4RefRest(info, as)
            var wrecv = k4RefRecv(info, as)
            wrecv[info["name"]] = k4At(rest, 0)
            return undefined
        }
        if (name == "equals") { return k4RefEq(rv, k4At(as, 0)) }
        if (name == "toString") { return ktRender(rv) }
        if (info["bound"] !== true) {
            fail("method ." + name + "() of an unbound callable reference ::" + info["name"])
        }
        rv = js_ktfget(info["recv"], info["name"])
    }

    // A KClass receiver.
    if (ktIsClassLit(rv)) {
        if (name == "isInstance") { return k4IsType(k4At(as, 0), ktRender(rv["kname"])) }
        if (name == "toString") { return ktRender(rv) }
        if (name == "equals") { return k4RefEq(rv, k4At(as, 0)) }
        fail("method ." + name + "() of a class literal")
        return undefined
    }

    // A QUALIFIED stdlib call - kotlin.math.abs(-3). The receiver is a package
    // handle and the member is the same global function the bare spelling reaches;
    // a call is a METHOD call in the tree, so it never passes through js_ktfget.
    if (ktIsPkg(rv)) {
        var pf = ktPkgMember(rv["__pkg"], name)
        if (!k4Fn(pf)) { fail("not a function: " + rv["__pkg"] + "." + name) }
        return pf.apply(undefined, as)
    }

    // The SCOPE FUNCTIONS first: let/run/apply/also/takeIf/takeUnless are
    // extensions on Any, so no receiver branch below owns them. A class member of
    // the same name still wins (ktScopeMethod declines then).
    var sv = ktScopeMethod(rv, name, as)
    if (!ktMiss(sv)) { return sv }

    // A PROGRESSION. The members whose answer IS the range are answered from
    // the bounds; everything else is a Collection/Iterable extension and runs on
    // the materialized elements. `contains` is answered arithmetically so that
    // `x in 1..1000000` does not materialize a million cells.
    if (ktIsRange(rv)) {
        if (name == "toString") { return ktRangeStr(rv) }
        if (name == "contains") { return ktRangeHas(rv, k4At(as, 0)) }
        if (name == "isEmpty") { return ktRangeEmpty(rv) }
        if (name == "hashCode") { return ktRangeHash(rv) }
        if (name == "equals") {
            var ro = k4At(as, 0)
            if (!ktIsRange(ro)) { return false }
            return ktRangeEq(rv, ro)
        }
        if (rv["fl"] !== true) {
            // IntProgression.reversed() is an IntProgression, not a List.
            if (name == "reversed") { return ktRangeRev(rv) }
            // IntProgression.step(k) in its function spelling; the infix `step` is
            // lowered by the emitter and never arrives here.
            if (name == "step") {
                if (as.length == 1) { return js_ktrestep(rv, as[0]) }
            }
            // kotlin.random: random() throws NoSuchElementException on an empty
            // progression, randomOrNull() answers null.
            if (name == "random" || name == "randomOrNull") {
                var rcnt = ktRangeCount(rv)
                if (rcnt == 0) {
                    if (name == "randomOrNull") { return null }
                    ktRaise("NoSuchElementException",
                            "Cannot get random in empty range: " + ktRangeStr(rv))
                }
                return ktRangeAt(rv, k4RndBelow(k4RndOf(as), rcnt))
            }
            // first()/last() resolve to kotlin.ranges' IntProgression /
            // CharProgression / LongProgression overloads, whose empty message names
            // the progression.
            if (name == "first" || name == "last") {
                if (as.length == 0 && ktRangeEmpty(rv)) {
                    ktNoElem("Progression " + ktRangeStr(rv) + " is empty.")
                }
            }
        }
        rv = ktRangeList(rv)
        rvKind = "Collection"
    }
    // A kotlin.random.Random receiver, and Random's COMPANION OBJECT -
    // `Random.nextInt(10)` arrives as a member call on the constructor function.
    if (k4IsRnd(rv)) {
        var rnm = k4RndMethod(rv, name, as)
        if (!ktMiss(rnm)) { return rnm }
    }
    if (rv === K4_RANDOM_FN) {
        var rcm = k4RndMethod(k4RndDefault(), name, as)
        if (!ktMiss(rcm)) { return rcm }
    }

    // kotlin.hashCode() and kotlin.toString() are extensions on Any?, so a NULL
    // receiver answers them rather than throwing.
    if (rtIsNil(rv)) {
        if (name == "hashCode") { return 0 }
        if (name == "toString") { return "null" }
    }

    // An ENUM descriptor: values() / valueOf(name) / entries.
    var ev = ktEnumMethod(rv, name, as)
    if (!ktMiss(ev)) { return ev }

    // A BOOLEAN receiver owns hashCode/toString/not/equals/compareTo - none of
    // which any branch below claims.
    if (typeof rv == "boolean") {
        if (name == "hashCode") {
            if (rv) { return 1231 }
            return 1237
        }
        if (name == "toString") {
            if (rv) { return "true" }
            return "false"
        }
        if (name == "not") { return !rv }
        if (name == "equals") {
            var ob = k4At(as, 0)
            if (typeof ob != "boolean") { return false }
            return ob === rv
        }
        if (name == "compareTo") {
            var oc = k4At(as, 0)
            if (oc !== true) { oc = false }
            if (rv === oc) { return 0 }
            if (rv) { return 1 }
            return -1
        }
    }

    var nv = ktNumMethod(rv, name, as)
    if (!ktMiss(nv)) { return nv }

    if (ktIsChar(rv)) {
        var cv = ktCharMethod(rv, name, as)
        if (!ktMiss(cv)) { return cv }
    }

    if (ktIsArr(rv)) {
        var lv = ktSeqMethodK(rv, name, as, rvKind)
        if (!ktMiss(lv)) { return lv }
    }

    if (ktIsObj(rv)) {
        if (ktIsSb(rv)) {
            var bv = ktSbMethod(rv, name, as)
            if (!ktMiss(bv)) { return bv }
        }
        if (ktIsSet(rv)) {
            var stv = ktSetMethod(rv, name, as)
            if (!ktMiss(stv)) { return stv }
        }
        if (rtIsDictObj(rv)) {
            var mv = ktMapMethod(rv, name, as)
            if (!ktMiss(mv)) { return mv }
        } else {
            if (ktIsResult(rv)) {
                var rrv = ktResultMethod(rv, name, as)
                if (!ktMiss(rrv)) { return rrv }
            } else {
                if (rv["__lazy"] === true) {
                    if (name == "getValue") { return ktLazyValue(rv) }
                    if (name == "value") { return ktLazyValue(rv) }
                    if (name == "isInitialized") { return rv["done"] }
                } else {
                    if (k4IsJob(rv)) {
                        // The Job / Deferred an `async` or `launch` answers.
                        var jv = ktJobMethod(rv, name)
                        if (!ktMiss(jv)) { return jv }
                    } else {
                        if (ktIsPair(rv)) {
                            var pv = k4PairMethod2(rv, name, as)
                            if (!ktMiss(pv)) { return pv }
                        }
                    }
                }
            }
        }
    }

    if (typeof recv == "string") {
        // A pattern argument belongs to the Regex dispatcher: `s.contains(re)` is a
        // regex search, `s.contains("B")` is a substring test.
        var pat = false
        if (as.length > 0) { pat = ktRxIsRegex(as[0]) }
        var svv = ktStrMethod(recv, name, as)
        if (!ktMiss(svv)) {
            if (!pat) { return svv }
        }
    }

    // SAM CONVERSION: `Op43 { it + 100 }` on a `fun interface` builds an instance
    // whose single abstract member is carried as a FIELD holding the lambda. The
    // field is answered here, and only when the chain does NOT declare the name: a
    // real method always wins. It is applied WITHOUT the receiver.
    if (ktIsObj(rv)) {
        if (rv["__class"] !== undefined) {
            if (k4Own(rv, name)) {
                var fv = rv[name]
                if (k4Fn(fv)) {
                    if (!ktClassChainHas(rv, name)) { return fv.apply(undefined, as) }
                }
            }
            // Every Kotlin class inherits equals() from Any. A class that overrides
            // it has it on the chain and is dispatched below.
            if (name == "equals") {
                if (!ktClassChainHas(rv, "equals")) { return ktIdent(rv, k4At(as, 0)) }
            }
        }
    }

    // js_rxktmcall: the Regex / MatchResult surface, plus the String members that
    // take a Regex. ktRxMethod carries its own applicability guard.
    var xv = ktRxMethod(rv, name, as)
    if (!ktMiss(xv)) { return xv }

    // toString() / hashCode() are members of kotlin.Any, so EVERY receiver has
    // them - and after every branch above has declined, nothing else can (e.g. an
    // unqualified `with(p) { toString() }`). A class that OVERRIDES either has it
    // on its descriptor chain and is dispatched by k4BaseMcall below, which is why
    // the chain is asked first - the same guard the `equals` arm above uses.
    if (as.length == 0) {
        if (name == "toString" || name == "hashCode") {
            if (!k4ChainDeclares(rv, name)) {
                if (name == "toString") { return ktRender(rv) }
                return ktElemHash(rv)
            }
        }
    }
    // equals(other) is the third Any member, and it is the SAME comparison `==`
    // makes - js_kteq: `listOf(1, 2).equals(listOf(1, 2))` is true.
    if (as.length == 1) {
        if (name == "equals") {
            if (!k4ChainDeclares(rv, name)) { return js_kteq(rv, as[0]) }
        }
    }

    return k4BaseMcall(rv, name, as)
}

// ktRefRecv (jsrtkotlin.go:5790).
function k4RefRecv(info, args) {
    if (info["bound"] === true) { return info["recv"] }
    if (args.length > 0) { return args[0] }
    return null
}

// ktRefRest (jsrtkotlin.go:5800).
function k4RefRest(info, args) {
    if (info["bound"] === true) { return args }
    if (args.length == 0) { return args }
    return k4Rest(args, 1)
}

// ktRefEq (jsrtkotlin.go:5902): two BOUND references are equal when they name the
// same member of the same receiver, and two class literals when they name the same
// class.
function k4RefEq(l, r) {
    var li = ktRefOf(l)
    var ri = ktRefOf(r)
    var lIsRef = k4IsRef(li)
    var rIsRef = k4IsRef(ri)
    if (lIsRef || rIsRef) {
        if (!lIsRef) { return false }
        if (!rIsRef) { return false }
        if (li["name"] !== ri["name"]) { return false }
        if (li["bound"] !== ri["bound"]) { return false }
        if (li["ctor"] !== ri["ctor"]) { return false }
        if (li["tname"] !== ri["tname"]) { return false }
        return li["recv"] === ri["recv"]
    }
    var lIsCls = ktIsClassLit(l)
    var rIsCls = ktIsClassLit(r)
    if (lIsCls || rIsCls) {
        if (!lIsCls) { return false }
        if (!rIsCls) { return false }
        return l["kname"] === r["kname"]
    }
    return false
}

// ============================================================================
// THE EXPORTS
// ============================================================================

// js_ktsmcall (jsrtkotlin.go:1119).
function js_ktsmcall(recv, name, args) { return ktSmcall(recv, name, args) }

// ktLateinitCheck (jsrtkotlin.go:202): a `lateinit var` that is still null has NOT
// been assigned, and Kotlin throws rather than answering null.
function k4LateinitCheck(o, name, v) {
    if (!rtIsNil(v)) { return v }
    if (!ktIsObj(o)) { return v }
    var cls = o["__class"]
    var guard = 0
    while (guard < 64) {
        guard = guard + 1
        if (!ktIsObj(cls)) { guard = 99 } else {
            var li = cls["__lateinit"]
            if (ktIsObj(li)) {
                if (li[name] === true) {
                    ktRaise("UninitializedPropertyAccessException",
                        "lateinit property " + name + " has not been initialized")
                }
            }
            cls = cls["__super"]
        }
    }
    return v
}

// ============================================================================
// PROGRESSIONS - a range is a VALUE, not a materialized list
// ============================================================================
//
// A progression is a first-class value, the same one the interpreter half has,
// field for field: {__range, from, to, st, down, ch, fl}. It is not materialized,
// because Kotlin answers from the DECLARED bounds: `(5..1).first` is 5 (only
// isEmpty() reports the emptiness, and `first()`, the function, is the one that
// throws) and toString is "5..1", not "[]". `from` and `to` are the INCLUSIVE
// numeric bounds (..< / until subtract one when the range is BUILT), `st` is the
// POSITIVE step, `down` the direction and `ch` remembers that the bounds were
// Chars (and `fl` that they were Doubles) so the elements are boxed back into Chars.
//
// Every Kotlin entry point that can receive one materializes it with
// ktRangeList: js_ktiter, ktSmcall (after the scope functions, so `(1..5).let`
// still sees the range), js_ktindex, ktSeqMethod's callers. The ones where the
// range-ness IS the answer - js_ktfget, k2Render, ktIsType, ktIdent, ktHash -
// answer from the bounds instead. Nothing outside those sites ever sees the
// object, which is why the shared js_* of abnf/jsrt.go need no arm for it.
function ktIsRange(v) {
    if (!ktIsObj(v)) { return false }
    return v["__range"] === true
}

// The numeric reading of a bound: a Char bound progresses in code points and a
// sized integer in its own value. k4RangeNum is ktRangeNum in jsrtkotlin.go.
function k4RangeNum(v) {
    if (ktIsChar(v)) { return ktCharCode(v) }
    if (sintIs(v)) { return sintNum(v) }
    return ktNum(v)
}

// js_ktrange is the extern the emitter's makeRange calls. `down` is 1 for downTo
// and 0 otherwise; the `..<` / until subtraction is the emitter's.
function js_ktrange(from, to, st, down) {
    var stn = k4RangeNum(st)
    if (stn <= 0) { fail("range step must be positive") }
    // `fl` marks a ClosedFloatingPointRange - `1.0..2.0`. Kotlin declares no step
    // and no iteration for one, and its contains is the BOUNDS test alone
    // (`1.5 in 1.0..2.0` is true).
    return {__range: true, from: k4RangeNum(from), to: k4RangeNum(to),
            st: stn, down: down !== 0, ch: ktIsChar(from), fl: floIs(from), pg: false}
}

// `r step k` re-steps an existing progression, keeping its bounds and direction.
function js_ktrestep(r, st) {
    if (!ktIsRange(r)) { fail("step applied to a non-range") }
    var stn = k4RangeNum(st)
    if (stn <= 0) { fail("range step must be positive") }
    // `step` answers an IntProgression, never an IntRange, whatever the step is:
    // `(1..5) step 1` prints "1..5 step 1" and `is IntRange` is false for it.
    return {__range: true, from: r["from"], to: r["to"], st: stn,
            down: r["down"], ch: r["ch"], fl: r["fl"], pg: true}
}

function k4RangeEl(rg, n) {
    if (rg["ch"] === true) { return ktChar(n) }
    if (rg["fl"] === true) { return flo(n, 0) }
    return n
}

// The LAST ELEMENT of a progression, which is what IntProgression.last answers -
// getProgressionLastElement in kotlin.internal.ProgressionUtil. For a step of 1
// it is the bound; for `1..10 step 4` the elements are 1, 5, 9 and the answer is
// 9. An EMPTY progression answers the bound, exactly as getProgressionLastElement
// does when first and last are already crossed.
function ktRangeLastEl(rg) {
    // A floating range has no elements, so its endInclusive IS the bound.
    if (rg["fl"] === true) { return rg["to"] }
    if (rg["down"] === true) {
        if (rg["from"] <= rg["to"]) { return rg["to"] }
        return rg["to"] + ((rg["from"] - rg["to"]) % rg["st"])
    }
    if (rg["from"] >= rg["to"]) { return rg["to"] }
    return rg["to"] - ((rg["to"] - rg["from"]) % rg["st"])
