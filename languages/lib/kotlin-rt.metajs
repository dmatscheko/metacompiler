// jsrtkotlin.go:2008's js_ktvarset: js_kset made DELEGATE-aware, plus the
// __dispatch write arm. A binding holding a delegate box is written through its
// setValue.
function js_ktvarset(env, name, v) {
    var s = k6Owner(env, name)
    if (s !== undefined) {
        var cur = anytype
        cur = scopeGet(s, name)
        if (ktIsObj(cur)) {
            if (cur["__pdeleg"] !== undefined) {
                js_ktdset(cur["d"], cur["owner"], cur["pname"], v)
                return 0
            }
        }
        scopeDecl(s, name, v)
        return 0
    }
