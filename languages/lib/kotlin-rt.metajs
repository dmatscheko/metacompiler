// ktJobMethod (jsrtkotlin.go:5507) is await / join / cancel and the state flags.
// Every one of them is immediate, because the block ran at the point it was
// written.
function ktJobMethod(j, name) {
    if (name == "await") { return j["v"] }
    if (name == "getCompleted") { return j["v"] }
    if (name == "join") { return undefined }
    if (name == "cancel") { return undefined }
    if (name == "cancelAndJoin") { return undefined }
    if (name == "start") { return undefined }
    if (name == "isActive") { return false }
    if (name == "isCancelled") { return false }
