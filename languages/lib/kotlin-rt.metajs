// kotlin-rt.metajs -- KOTLIN'S OWN SEMANTICS, in MetaJS (layer 2).
//
// languages/kotlin-to-llvm-ir.abnf emits handle IR that calls js_* externs; the
// generic ones come from languages/lib/runtime.c (the C floor, layer 1), the
// Kotlin-specific ones are here.
//
// Compile with:
//     mec languages/metajs-to-llvm-ir.abnf languages/lib/kotlin-rt.metajs -q -rt-lib
// which is what tests/gen-kotlin-rt-ll.sh does; the result is the checked-in
// languages/lib/kotlin-rt.ll that kotlin-to-llvm-ir.abnf links next to
// runtime.ll. -rt-lib exports every TOP-LEVEL `function js_*` below under its own
// C symbol, so nothing else in this file is visible to the linker - the helpers
// are deliberately named kt* (file-wide) and k0* .. k6* (per section), and the
// shared regular-expression engine keeps its own rx* / RX_* names.
//
// THE AUTHORITATIVE SPECIFICATION IS abnf/jsrtkotlin.go, abnf/jsrtregexkt.go over
// abnf/jsrtregex.go, the shared externs of abnf/jsrt.go, and the gi* layer of
// abnf/jsrtint.go. This file matches them function for function and names the Go
// function each one ports; where it CANNOT, the site says so.
//
// There is no kotlinc on this machine, so every rule here is CITED from the Go
// twin, and the ground truth is byte-identity between llvm.Run (which uses the Go
// twin) and the native binary (which uses this file).
//
// ----- the value model (abnf/jsrtkotlin.go) ---------------------------------
//
//     null / undefined      Kotlin null. kotlin.Unit renders "kotlin.Unit".
//     boolean               Boolean
//     PLAIN NUMBER          an Int exact in a double
//     tag 13 box            a sized integer: Byte/Short/Int/Long, w = 8/16/32/64.
//                           Only a signed 32 bit value is a plain number; every
//                           other width, a Long included, stays a box (ktNorm).
//     tag 14 box            Double / Float (floIs / floNum / floStyle / floOp)
//     {__char: code}        Char. The Go twin has a real jsChar TYPE; layer 2
//                           cannot make a primitive, so this is the object box
//                           both Kotlin grammars use.
//     string                String
//     array                 List / MutableList / Array
//     {__dict, keys, vals}  Map (the shared handle of dictParts, abnf/jsrt.go)
//     {__set, keys}         Set (ktMakeSet: the map handle WITHOUT vals)
//     {__isclass, __name, __super, ...}   a class descriptor
//     any other object      an instance; its descriptor is __class
//
// Kotlin never marks a 64 bit cell unsigned-for-signed (Java's trick), so
// `to_number` of a tag 13 cell IS the signed reading and js_jflo needs no wrapper.
//
// What Kotlin does NOT need:
//  1. NO `__raw` truthy shim: kotlin-to-llvm-ir.abnf sets no core.truthyExt, so it
//     keeps compile-core's default "js_truthy", the C floor's function, which
//     answers the raw 1/0 that `icmp ne <call>, 0` requires.
//  2. NO coroutine primitive: suspend functions are lowered by the emitter into
//     ordinary calls (see ktCoroRun).
//  3. `_raw` PARAMETERS: one, js_char's code point, which the emitter writes
//     with a bare handle(k).
//
// ----- SECTION 0, THE FOUNDATION -------------------------------------------
//
// The shapes, the readings, equality, hashing, the map/set/pair/entry handles,
// the closure-call helpers, the exception hierarchy and the descriptor walks.
// Section 0 defines NO `function js_*` at all: it is helpers only.
//
// What this section deliberately does NOT port:
// * ktWithRecv's SCOPE half. The Go twin rebinds the closure's `this` in a fresh
//   jsScope; a scope is the floor's private storage and layer 2 cannot open one.
//   The ktRecvStack half - which is what makes an unqualified member resolve
//   inside with/run/apply - is here in full; the `this` binding is the EMITTER's job.
// * ktWithRecv's `defer` pop. MetaJS has no try/finally, so a throw out of the
//   lambda leaves the receiver on the stack. The Go twin pops it.
// * ktRefEq's side table in ktEqVals (the Go twin's ktEqVals has no ref arm
//   either); js_kteq / js_ktne do consult it.
// * ktMemberCall in ktKeyLess. The Go twin routes `compareTo` through the whole
//   js_ktsmcall hub; here the declared member is found on the descriptor chain
//   and called directly, which is what the hub does for a class instance.
//
// MetaJS rules that shape the code (docs/abnf-dialect-gotchas.md): no ASI, so
// every `return` carries its value on the same line and a value-less early
// return is braced; a local keeps the TYPE CLASS it is first assigned, so a slot
// that holds two classes is declared `var x = anytype`; no for..in, no splice, no
// split/join/lastIndexOf, array.length is not assignable, indexOf ignores its
// from-index, no exponent literals; unary minus is `-x`, never `0 - x`.

// The shared layer-2 runtime: the externs every language implements identically,
// parameterised by the rtk* hooks below.
import "./runtime.metajs"
// kotlin.math on doubles, over StrictMath's fdlibm.
import "./fdlibm.js"
// ClassCastException's text is the JVM's.
import "./java-cce.js"
import "./kotlin-math.js"
// sorted / sortedBy / sortedWith / sortWith are java.util.TimSort.
import "./java-timsort.js"

// ----- the rtk* hooks the shared runtime calls -------------------------------
function rtkStr(v) { return k1JStr(v) }
function rtkNum(v) { return ktNum(v) }
function rtkIsChar(v) { return ktIsChar(v) }
function rtkIsArr(v) { return Array.isArray(v) }
// js_supercall's one knob, and Kotlin is the language that forced it: k4bCallAcc
// sets the k4bThis global around the call so a superclass accessor sees its
// receiver. The other three spell it f.apply(undefined, argv).
function rtkCall(f, self, argv) { return k4bCallAcc(f, self, argv) }
// js_pyset's two knobs.
function rtkIsDict(v) { return rtIsDictObj(v) }
function rtkDictFind(keys, k) { return rtDictFind(keys, k) }

// ===================================================== the miss sentinel ====

// A dispatcher that did not handle the call answers KT_MISS. undefined cannot
// mean it: a Kotlin member may legally answer null/undefined (the Go twin's
// second return value is exactly this flag).
var KT_MISS = {__ktmiss: true}

function ktMiss(v) { return v === KT_MISS }

// ===================================================== the shape tests ======

function ktIsObj(v) { return rtIsObj(v) }

// A floor array. The map and set handles are objects WITHOUT a numeric length,
// and they are excluded by tag as well so a caller cannot confuse the two.
function ktIsArr(v) {
    if (!ktIsObj(v)) { return false }
    if (v["__dict"] === true) { return false }
    if (v["__set"] === true) { return false }
    return typeof v["length"] == "number"
}

// An Array or a primitive array, as opposed to a List, a Sequence or a view
// sharing the host array. Twin of ktIsJvmArr in abnf/jsrtkotlin.go.
function ktIsJvmArr(a) {
    var k = arrKind(a)
    return k == 1 || k >= 5
}

// jsrtkotlin.go ktArrStr: an Array's toString is Object's ([I@1); an unsigned
// array's renders its storage's contents.
function ktArrStr(v) {
    var ak = arrKind(v)
    if (ktaIsUnsigned(ak)) { return ktaElems[ak - 5] + "Array(storage=" + ktArrContentStr(v, false) + ")" }
    return jxkClass(v) + "@" + jxkRadix(ktElemHash(v), 16)
}

// jsrtkotlin.go ktArrContentStr: contentToString, deep for contentDeepToString.
function ktArrContentStr(es, deep) {
    var out = "["
    var i = 0
    while (i < es.length) {
        if (i > 0) { out = out + ", " }
        var e = es[i]
        if (deep && Array.isArray(e) && ktIsJvmArr(e)) { out = out + ktArrContentStr(e, true) }
        else { out = out + k2Render(e, 1) }
        i = i + 1
    }
    return out + "]"
}

// jsrtkotlin.go ktArrContentHash: contentHashCode, deep for contentDeepHashCode.
function ktArrContentHash(es, deep) {
    var h = 1
    var i = 0
    while (i < es.length) {
        var e = es[i]
        var eh = 0
        if (deep && Array.isArray(e) && ktIsJvmArr(e)) { eh = ktArrContentHash(e, true) }
        else { eh = ktElemHash(e) }
        h = (Math.imul(31, h) + eh) | 0
        i = i + 1
    }
    return h
}

// jsrtkotlin.go ktNullArrMember: the array content extensions on a null receiver.
// KT_MISS for any other name.
function k4NullArrMember(name, as) {
    if (name == "contentHashCode") { return 0 }
    if (name == "contentDeepHashCode") { return 0 }
    if (name == "contentToString") { return "null" }
    if (name == "contentDeepToString") { return "null" }
    if (name == "contentEquals") { return k4At(as, 0) === null }
    if (name == "contentDeepEquals") { return k4At(as, 0) === null }
    return KT_MISS
}

// k0IsRec is Go's `v.(*jsObject)`: an object that is NOT an array. Every Go arm
// spelled `o, ok := v.(*jsObject)` is this test, because a *jsArray is its own
// Go type there and is a plain object here.
function k0IsRec(v) {
    if (!ktIsObj(v)) { return false }
    return !ktIsArr(v)
}

function ktIsStr(v) { return typeof v == "string" }

// isCallable (abnf/jsrt.go 1695).
function ktIsFn(v) { return typeof v == "function" }

// argAt(args, i): the i'th argument, or undefined past the end. kt* is this
// file's FILE-WIDE helper prefix; k0*..k6* are the per-section ones, and a body
// two sections share belongs under kt*.
function ktArg(args, i) {
    if (i < args.length) { return args[i] }
    return undefined
}

// ===================================================== the Char box =========
//
// rtCharBox / rtIsCharBox are lib/runtime.metajs's.

function ktChar(code) { return rtCharBox(code) }

function ktIsChar(v) { return rtIsCharBox(v) }

function ktCharCode(v) {
    if (ktIsChar(v)) { return v["__char"] }
    return Math.trunc(ktNum(v))
}

// ktChars (jsrtkotlin.go 3344): a string as its Char elements.
function k0Chars(s) {
    var out = []
    var i = 0
    while (i < s.length) {
        out.push(ktChar(s.charCodeAt(i)))
        i = i + 1
    }
    return out
}

// ===================================================== the numeric readings =

// ktIsIntegral (jsrtkotlin.go 135): an operand of INTEGER arithmetic. A Char IS
// one - Kotlin's Char has code arithmetic - and a Double is NOT. Both a sized
// integer (tag 13) and a boxed double (tag 14) answer `typeof v == "number"` in
// the C floor, which is why the tag 14 test is explicit.
// The body is shared as rtIsIntegral (lib/runtime.metajs).
function ktIsInt(v) { return rtIsIntegral(v) }

// ktIsIntegral (jsrtkotlin.go 135) at the OPERAND level: a box, a plain number
// or a Char - and NOT a boxed double, which must never be truncated into an
// integer operation. Not to be confused with k0IsNumeric just below or k1Numeric
// in SECTION 1: those admit a Double and are a different predicate.
function ktIntegral(v) {
    if (ktIsChar(v)) { return true }
    return ktIsInt(v)
}

// k0IsNumeric is giIsNumeric (jsrtint.go 292) over this value model: the {__char}
// box stands for the Go jsChar the switch there lists.
function k0IsNumeric(v) {
    if (ktIsChar(v)) { return true }
    if (typeof v == "number") { return true }
    return false
}

// k0IntVal is the operand giVal (jsrtint.go 105) reads: the floor's sint*
// builtins know tag 13, tag 14 and a plain number, but not the {__char} object,
// so a Char is unboxed to its code before it reaches one.
function k0IntVal(v) {
    if (ktIsChar(v)) { return v["__char"] }
    return v
}

// giFloat (jsrtint.go 302) plus the Char arm ktNum's callers need. sintNum IS
// giFloat for tag 13 - including the unsigned 64 bit reading - and floNum is the
// tag 14 one.
function ktNum(v) {
    if (ktIsChar(v)) { return v["__char"] }
    if (typeof v == "number") {
        if (floIs(v)) { return floNum(v) }
        if (sintIs(v)) { return sintNum(v) }
        return v
    }
    if (v === true) { return 1 }
    if (v === false) { return 0 }
    if (typeof v == "string") { return parseFloat(v) }
    // rt.toNumber's last two arms (abnf/jsrt.go): a NULL is 0, and everything else -
    // undefined (which is how kotlin.Unit arrives), an object, an array, a function -
    // is NaN, so `size + f()` of a Unit-returning `f` is NaN as in the Go twin.
    if (v === null) { return 0 }
    return NaN
}

// ktWU (jsrtkotlin.go 116) is the result type of a binary operator: 64 bits when
// either side is a 64 bit box, 32 otherwise; unsigned when either side is. It
// answers {w, u} because MetaJS has no two-value return, and u is 0 or 1 so the
// slot never has to hold two type classes.
function ktWU(l, r) {
    var w = 32
    var u = 0
    if (sintIs(l)) {
        if (sintWidth(l) == 64) { w = 64 }
        if (sintUns(l)) { u = 1 }
    }
    if (sintIs(r)) {
        if (sintWidth(r) == 64) { w = 64 }
        if (sintUns(r)) { u = 1 }
    }
    var out = {}
    out["w"] = w
    out["u"] = u
    return out
}

// ktNorm (jsrtkotlin.go 103): truncate to w bits at u's signedness, then apply
// the invariant - a signed 32 bit result is a PLAIN NUMBER and EVERY OTHER width
// or signedness, INCLUDING a signed Long at every magnitude, is a box. It is
// deliberately not giNorm, which unboxes at 64 bits.
//
// That matters because ktWU reads the width off the operand BOXES: an unboxed
// small Long would make `1000000L * 1000000L` a 32 bit multiply and answer
// -727379968. So sintConv (which ends in si_norm and unboxes a signed 64 bit
// value a double holds exactly) cannot be the last step here - sintRaw re-boxes
// it, losslessly, since sintHi/sintLo read a plain number exactly. C#'s csNorm
// uses the same recipe.
function ktNorm(x, w, u) {
    var t = anytype
    t = sintConv(k0IntVal(x), w, u == 1)
    if (w == 32) {
        if (u == 0) { return sintNum(t) }
    }
    if (sintIs(t)) { return t }
    return sintRaw(sintHi(t), sintLo(t), w, u == 1)
}

// ktBoxTypeName (jsrtkotlin.go 596). The Go twin takes a jsGInt; this one takes
// any value, because the contract's callers ask it of a value rather than of a
// box. The two EXTRA arms are stated, not ported: a tag 14 box is "Double" (a
// Float shares the box, exactly as the Go comment at ktDblHash records) and a
// plain number is "Int".
function ktBoxTypeName(v) {
    if (floIs(v)) { return "Double" }
    if (!sintIs(v)) { return "Int" }
    var w = sintWidth(v)
    if (sintUns(v)) {
        if (w == 8) { return "UByte" }
        if (w == 16) { return "UShort" }
        if (w == 32) { return "UInt" }
        return "ULong"
    }
    if (w == 8) { return "Byte" }
    if (w == 16) { return "Short" }
    if (w == 32) { return "Int" }
    return "Long"
}

// k0Wrap32 is Go's int32(x) over a plain double: `| 0` is the floor's ToInt32,
// which is a MODULO and not a range test (see to_int32 in lib/runtime.c).
function k0Wrap32(x) { return x | 0 }

// ktCmp("<", l, r) (jsrtkotlin.go 293) - the ordered comparison at the PROMOTED
// width, which giCmp on its own does not give: giCmp compares at the WIDEST
// operand's width, so `val b: Byte = 5; b < 1000` would truncate 1000 into a
// byte. Both operands are converted to the promoted type first, and sintCmp is
// then giCmp on two values of the same width.
function k0IntLess(l, r) {
    var wu = ktWU(l, r)
    var a = anytype
    var b = anytype
    a = sintConv(k0IntVal(l), wu["w"], wu["u"] == 1)
    b = sintConv(k0IntVal(r), wu["w"], wu["u"] == 1)
    return sintCmp(a, b) < 0
}

// ktDblHash (jsrtkotlin.go 583) is java.lang.Double.hashCode: the 64 bit pattern
// XOR its own high half, read as an Int. MetaJS has no math.Float64bits, so the
// bits are derived arithmetically; twin of kDblHash in kotlin-interpreter.abnf.
// doubleToLongBits COLLAPSES every NaN to 0x7ff8000000000000, which is the first
// constant below.
function ktDblHash(d) {
    if (d !== d) { return 2146959360 }
    if (d === Infinity) { return 2146435072 }
    if (d === -Infinity) { return -1048576 }
    if (d === 0) {
        if (1 / d < 0) { return -2147483648 }
        return 0
    }
    var neg = d < 0
    var a = neg ? -d : d
    var e = 0
    while (a >= 2) {
        a = a / 2
        e = e + 1
    }
    while (a < 1) {
        a = a * 2
        e = e - 1
    }
    var m = 0
    var biased = 0
    if (e < -1022) {
        // Subnormal: the biased exponent is 0 and there is no implicit leading 1,
        // so the significand is scaled back down to the fixed exponent -1022.
        var k = -1022 - e
        var sub = a
        while (k > 0) {
            sub = sub / 2
            k = k - 1
        }
        m = sub * 4503599627370496
    } else {
        m = (a - 1) * 4503599627370496
        biased = e + 1023
    }
    var hi20 = Math.floor(m / 4294967296)
    var hi = biased * 1048576 + hi20
    if (neg) { hi = hi - 2147483648 }
    return (hi | 0) ^ ((m - hi20 * 4294967296) | 0)
}

// ktFltHash (jsrtkotlin.go ktFltHash) is java.lang.Float.hashCode, which is what
// Kotlin/JVM's Float.hashCode() IS: floatToIntBits(f) read as a SIGNED Int - the
// raw binary32 pattern, NOT a fold of two halves the way the double's is, so a
// negative float has a negative hash. Same arithmetic derivation as ktDblHash one
// width down: bias 127, 23 significand bits, the subnormal floor at 2^-126.
// The twin is kFltHash in languages/kotlin-interpreter.abnf.
function ktFltHash(d) {
    // floatToIntBits COLLAPSES every NaN to 0x7fc00000.
    if (d !== d) { return 2143289344 }
    if (d === Infinity) { return 2139095040 }
    if (d === -Infinity) { return -8388608 }
    if (d === 0) {
        if (1 / d < 0) { return -2147483648 }
        return 0
    }
    var neg = d < 0
    var a = neg ? -d : d
    var e = 0
    while (a >= 2) {
        a = a / 2
        e = e + 1
    }
    while (a < 1) {
        a = a * 2
        e = e - 1
    }
    // A value too big for a binary32 never reaches here from a Float box (every
    // one is rounded on the way in), but the overflow answer is stated rather than
    // left to wrap.
    if (e > 127) {
        if (neg) { return -8388608 }
        return 2139095040
    }
    var m = 0
    var biased = 0
    if (e < -126) {
        // Subnormal: the biased exponent is 0 and there is no implicit leading 1,
        // so the significand is scaled back down to the fixed exponent -126.
        var k = -126 - e
        var sub = a
        while (k > 0) {
            sub = sub / 2
            k = k - 1
        }
        m = sub * 8388608
    } else {
        m = (a - 1) * 8388608
        biased = e + 127
    }
    var bits = biased * 8388608 + m
    if (neg) { bits = bits - 2147483648 }
    return bits | 0
}

// ktFloHash (jsrtkotlin.go ktFloHash) is the hash of a tag-14 box, which of the
// two depending on the style byte: style 3 is the Float. Every reader of a
// float's hash goes through it, so the width question is asked in ONE place.
function ktFloHash(v) {
    if (floStyle(v) == 3) { return ktFltHash(floNum(v)) }
    return ktDblHash(floNum(v))
}

// ktStrHash (jsrtkotlin.go 2588): java.lang.String.hashCode over UTF-16 CODE
// UNITS, which is what the script string type carries.
function k0StrHash(s) {
    var h = 0
    var i = 0
    while (i < s.length) {
        h = (Math.imul(31, h) + s.charCodeAt(i)) | 0
        i = i + 1
    }
    return h
}

// ===================================================== the map handle =======

// ktMakeMap (jsrtkotlin.go 2795).
function ktMakeMap() {
    var o = {}
    o["__dict"] = true
    o["keys"] = []
    o["vals"] = []
    return o
}

// dictParts (abnf/jsrt.go 2322), split into the three questions layer 2 asks.
function ktMapKeys(m) {
    if (!rtIsDictObj(m)) { return undefined }
    return m["keys"]
}

function ktMapVals(m) {
    if (!rtIsDictObj(m)) { return undefined }
    return m["vals"]
}

// ktMapFind (jsrtkotlin.go 3049): the position of a key in a KEYS ARRAY, or -1.
// A Kotlin Map compares its keys by equals, which for this value model is
// ktEqVals - so a boxed Long 1L and a plain Int 1 are the same key.
function ktMapFind(keys, k) {
    var i = 0
    while (i < keys.length) {
        if (ktEqVals(keys[i], k)) { return i }
        i = i + 1
    }
    return -1
}

// k3GroupingMethod is ktGroupingMethod (jsrtkotlin.go): a Grouping's eachCount,
// fold, reduce and aggregate, each an aggregation per key over the elements in
// order.
function k3GroupingMethod(g, name, args) {
    if (name != "eachCount" && name != "fold" && name != "reduce" && name != "aggregate") { return KT_MISS }
    var es = g["es"]
    var key = g["key"]
    var f = ktArg(args, 0)
    var op = ktArg(args, 1)
    var sel = name == "fold" && ktIsFn(f) && ktIsFn(op)
    var m = ktMakeMap()
    var i = 0
    while (i < es.length) {
        var e = es[i]
        var k = ktCall1(key, e)
        var at = ktMapFind(ktMapKeys(m), k)
        var nv = k3GroupStep(name, sel, f, op, k, at < 0, at < 0 ? null : ktMapVals(m)[at], e)
        if (at < 0) { ktMapPut(m, k, nv) } else { ktMapVals(m)[at] = nv }
        i = i + 1
    }
    return m
}

// One element's step of k3GroupingMethod: the key's new accumulator.
function k3GroupStep(name, sel, f, op, k, first, acc, e) {
    if (name == "eachCount") {
        if (first) { return 1 }
        return ktNum(acc) + 1
    }
    if (name == "reduce") {
        if (first) { return e }
        return ktCall(f, [k, acc, e])
    }
    if (name == "aggregate") { return ktCall(f, [k, acc, e, first]) }
    if (sel) {
        if (first) { return ktCall(op, [k, ktCall2(f, k, e), e]) }
        return ktCall(op, [k, acc, e])
    }
    if (first) { return ktCall2(op, f, e) }
    return ktCall2(op, acc, e)
}

// ktMapPut (jsrtkotlin.go 3035): insert or replace, keeping insertion order
// (key order for a TreeMap).
function ktMapPut(m, k, v) {
    var keys = ktMapKeys(m)
    var vals = ktMapVals(m)
    if (keys === undefined) { return false }
    var ck = ktCanonKey(m, keys, k)
    var i = ktMapFind(keys, ck)
    if (i >= 0) {
        vals[i] = v
        if (m["__vw"] !== undefined) { ktMapViewsPut(m, i) }
        return false
    }
    keys.push(ck)
    vals.push(v)
    arrModBump(keys)
    if (m["__jc"] === "java.util.TreeMap") { ktSortedSink(m, keys, vals) }
    if (m["__vw"] !== undefined) { ktMapViewsPut(m, -1) }
    return true
}
// ktMapDropAt (jsrtkotlin.go): remove entry i of a map, a structural change.
function ktMapDropAt(m, i) {
    var keys = ktMapKeys(m)
    k3RemoveAt(keys, i)
    k3RemoveAt(ktMapVals(m), i)
    arrModBump(keys)
    if (m["__vw"] !== undefined) { ktMapViewsSync(m) }
}
// ktMapViewOf / ktMapViewsSync / ktMapViewsPut (jsrtkotlin.go, which has the rule):
// a map's keys / values / entries views, made once, kept on the map and re-read
// after every change of it.
function ktMapViewOf(m, name) {
    var vw = anytype
    vw = m["__vw"]
    if (vw === undefined) {
        vw = {}
        m["__vw"] = vw
    }
