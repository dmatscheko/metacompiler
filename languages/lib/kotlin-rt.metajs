// jsrtkotlin.go ktLitValue (437). The suffix code is 0 none, 1 L, 2 u/U, 3 uL.
// An unsuffixed literal is an Int when it fits in one and a Long otherwise (so
// 0xFFFFFFFF is a Long 4294967295 here, where Java makes it int -1); a `u`
// literal is a UInt when it fits and a ULong otherwise.
function k1LitValue(acc, sfx) {
    if (sfx == 1) { return ktNorm(acc, 64, 0) }
    if (sfx == 2) {
        if (sintCmp(acc, 4294967295) <= 0) { return ktNorm(acc, 32, 1) }
        return ktNorm(acc, 64, 1)
    }
    if (sfx == 3) { return ktNorm(acc, 64, 1) }
    if (sintCmp(acc, 2147483647) <= 0) { return ktNorm(acc, 32, 0) }
    return ktNorm(acc, 64, 0)
}

// jsrtjvm.go jvmArith (176), the FLOAT half of Kotlin's arithmetic: a double on
// either side makes the whole operation floating point and its result a Double,
// two integral operands keep the 32 bit wrap. floOp IS that function in the
// floor (jf_arith), including the "unknown operator answers +0.0" arm - code 5
// is the one no branch takes.
function k1JvmArith(op, l, r) {
    // The one host call the DOUBLE path pays for the float width: floStyle of a
    // result that is not style 3 is the whole test, because style 3 can only have
    // come off a Float operand.
    var rr = k1JvmArithRaw(op, l, r)
    if (floStyle(rr) == 3) { return k1FloFix(op, rr, l, r) }
    return rr
