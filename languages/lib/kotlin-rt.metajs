                        if (k3Truthy(ktCall1(f, ent))) { ktMapPut(out, keys[i], v) }
                    }
                    else {
                        if (name == "filterNot") {
                            if (!k3Truthy(ktCall1(f, ent))) { ktMapPut(out, keys[i], v) }
                        }
                        else {
