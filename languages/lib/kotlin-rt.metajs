    if (!bad) { bad = !k2DigitsFit(body, neg, long) }
    if (bad) {
        if (orNull) { return null }
        ktRaise("NumberFormatException", "For input string: \"" + s + "\"")
    }
    var acc = k1Digits(body, 10)
    if (neg) { acc = sintOp(1, 0, acc) }
    if (long) { return ktNorm(acc, 64, 0) }
    return ktNorm(acc, 32, 0)
