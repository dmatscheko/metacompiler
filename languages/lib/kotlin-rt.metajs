    // jsrtkotlin.go answers it at the very END of js_ktget, after the receiver
    // stack. Same place here, for the same reason: only a name nothing else
    // resolves can be the package.
    if (name == "kotlin") { return ktPkg("kotlin") }
    return ktGlobalFn(name)
}

// js_kttype (jsrtkotlin.go:901) is ktTypeObj (jsrtkotlin.go:383): the companion of
// one builtin type. MIN_VALUE / MAX_VALUE are the whole reason a sized integer had
// to exist - Long.MAX_VALUE cannot be written as a plain number at all.
function js_kttype(name) {
    var o = {}
    if (name == "Int") {
        o["MAX_VALUE"] = 2147483647
        o["MIN_VALUE"] = -2147483648
        o["SIZE_BITS"] = 32
        o["SIZE_BYTES"] = 4
        return o
    }
    if (name == "Long") {
        o["MAX_VALUE"] = sint(2147483647, 4294967295, 64, 0)
        o["MIN_VALUE"] = sint(2147483648, 0, 64, 0)
        o["SIZE_BITS"] = 64
        o["SIZE_BYTES"] = 8
        return o
    }
    if (name == "Byte") {
        o["MAX_VALUE"] = sint(0, 127, 8, 0)
        o["MIN_VALUE"] = sint(0, 128, 8, 0)
        o["SIZE_BITS"] = 8
        o["SIZE_BYTES"] = 1
        return o
    }
    if (name == "Short") {
        o["MAX_VALUE"] = sint(0, 32767, 16, 0)
        o["MIN_VALUE"] = sint(0, 32768, 16, 0)
        o["SIZE_BITS"] = 16
        o["SIZE_BYTES"] = 2
        return o
    }
    if (name == "UInt") {
        o["MAX_VALUE"] = sint(0, 4294967295, 32, 1)
        o["MIN_VALUE"] = sint(0, 0, 32, 1)
        o["SIZE_BITS"] = 32
        o["SIZE_BYTES"] = 4
        return o
    }
    if (name == "ULong") {
        o["MAX_VALUE"] = sint(4294967295, 4294967295, 64, 1)
        o["MIN_VALUE"] = sint(0, 0, 64, 1)
        o["SIZE_BITS"] = 64
        o["SIZE_BYTES"] = 8
        return o
    }
    if (name == "UByte") {
        o["MAX_VALUE"] = sint(0, 255, 8, 1)
        o["MIN_VALUE"] = sint(0, 0, 8, 1)
        o["SIZE_BITS"] = 8
        o["SIZE_BYTES"] = 1
        return o
    }
    if (name == "UShort") {
        o["MAX_VALUE"] = sint(0, 65535, 16, 1)
        o["MIN_VALUE"] = sint(0, 0, 16, 1)
        o["SIZE_BITS"] = 16
        o["SIZE_BYTES"] = 2
        return o
    }
    if (name == "Char") {
        o["MAX_VALUE"] = ktChar(65535)
        o["MIN_VALUE"] = ktChar(0)
        o["SIZE_BITS"] = 16
        o["SIZE_BYTES"] = 2
        return o
    }
    // The float companions, boxed so that Double.NaN is a Double rather than an
    // Int: kotlin.Double declares MIN_VALUE as the smallest POSITIVE value, the way
    // java.lang.Double does. The magnitudes are spelled through parseFloat because
    // the MetaJS number rule has no exponent form.
    if (name == "Double" || name == "Float") {
        // Float's five constants are FLOAT boxes (style 3), so Float.MAX_VALUE
        // prints "3.4028235E38" and not the double's 17 digits.
        var fsty = 0
        if (name == "Float") {
            fsty = 3
            o["MAX_VALUE"] = flo(parseFloat("3.4028234663852886e38"), 3)
            o["MIN_VALUE"] = flo(parseFloat("1.401298464324817e-45"), 3)
            o["SIZE_BITS"] = 32
            o["SIZE_BYTES"] = 4
        } else {
            o["MAX_VALUE"] = flo(parseFloat("1.7976931348623157e308"), 0)
            o["MIN_VALUE"] = flo(parseFloat("4.9e-324"), 0)
            o["SIZE_BITS"] = 64
            o["SIZE_BYTES"] = 8
        }
        o["NaN"] = flo(NaN, fsty)
        o["POSITIVE_INFINITY"] = flo(Infinity, fsty)
        o["NEGATIVE_INFINITY"] = flo(-Infinity, fsty)
        return o
    }
    return o
}

// js_ktnameval(v, "topFun") (jsrtkotlin.go:1463) remembers the name a `::` spelled
// against the closure it resolved to, so KFunction.name can answer it, and hands
// the value straight back.
// The hub's half of js_ktnameval: section 4b owns the extern and calls this so
// BOTH name tables (the hub's and the reference layer's) see the same binding.
function k4NameVal(v, name) {
    if (k4Fn(v)) {
        k4NameFns.push(v)
        k4NameStrs.push(name)
    }
    return v
}
// ===================================================== SECTION 5 ============
// Regular expressions: Regex / MatchResult.
//
// The Go twin is abnf/jsrtregexkt.go (the Kotlin half) over abnf/jsrtregex.go
// (the shared engine). This section is the layer-2 port of both:
//
//   (a) the shared engine, `import "./regex.js"` immediately below - the SAME
//       text js, python and ruby import. It needs no adaptation: regex.js is
//       already written in this MetaJS subset. Only the rxFail knob is
//       re-pointed, right after the import, so a step-limit blowup reports the
//       Go twin's text rather than the engine's default.
//
//       The import costs nothing measurable at run time, and it keeps kotlin on the
//       same regex.js text the other languages import (abnf/jsrtregex.go ports it
//       line by line), so a change to lib/regex.js cannot fail to arrive here.
//       Kotlin carries six engine bodies its grammar never reaches (rxMatchAt,
//       rxTest, rxGroupCount, rxNameAt, rxReplace, rxSplit); a separate
//       runtime-regex split would drop them at the price of a second regex text
//       to hand-synchronise, so there is none.
//
//       Benchmarking this file: the code layout (and so instructions retired)
//       moves by several percent with anything that lands in the binary, the -exe
//       output path included. Compare means over many builds, never single draws.
//   (b) the Kotlin layer, under the private prefix k5.
//   (c) the two externs js_rxktnew and js_rxktglobal.
//
// SKIPPED, and why: the Go file also registers js_rxktmcall, js_rxktget and
// js_rxktindex. Those three are WRAPPERS - each one tests the receiver, hands a
// Regex / MatchResult / groups-holder to ktRxMethod / ktRxField / ktRxGroupAt and
// otherwise delegates to js_mcall / js_get / js_kindex. Layer 2 does not own
// those hubs (SECTION 4a does), so the wrappers are not reproduced here; the
// hub calls ktRxMethod / ktRxFget / ktRxIndex, which answer KT_MISS on a miss.
//
// The engine's names are rx* / RX_*; everything invented for Kotlin here is k5*.

import "./regex.js"

// ===================================================== the Kotlin layer =====
//
// From here down is the port of abnf/jsrtregexkt.go. The value model is the
// engine's own: a Regex is {__rxsrc, __rxflags}, a MatchResult is that plus
// {__rxmd, __rxtext, __rxcaps} and __ktsrc - the source of the regexp the match
// CAME FROM, which is what next() re-searches with.

// rxFail is the engine's error knob (see its head comment). Point it at the
// Go twin's wording: rt.fail("regexp: step limit exceeded"). The "invalid
// regexp" path of the knob is unreachable from here - k5Check runs first and
// reports the pattern the way ktRxCheck does.
rxFail = function (msg) { fail("regexp: " + msg) }

// The compile cache is shared as rxCache / rxGet (lib/regex.js): ONE cache for
// js, kotlin, python and ruby, as in abnf/jsrtregex.go.

function k5Check(re) {
    if (!re["ok"]) { fail("invalid regex '" + re["src"] + "': " + re["err"]) }
    return re
}

function k5Search(re, text, at) {
    k5Check(re)
    return rxSearch(re, text, at)
}

// k5Whole is Kotlin's matches() / matchEntire(): the pattern must cover the
// WHOLE input. That is the engine's own rxMatchWhole - one program, no anchoring
// wrapper, and therefore no quarrel with the x flag's trailing comments.
function k5Whole(re, text) {
    k5Check(re)
    return rxMatchWhole(re, text, 0)
}

// The two value tests are shared as rxIsRegexObj / rxIsMatchObj (lib/regex.js),
// the Go twin's own names for them.
function ktRxIsRegex(v) { return rxIsRegexObj(v) }

function ktRxIsMatch(v) { return rxIsMatchObj(v) }

function k5IsGroups(v) {
    if (!ktIsObj(v)) { return false }
    return !rtIsNil(v["__ktgroups"])
}

// k5IsCompanion answers the `Regex` name used as a value (Regex.escape(...)).
function k5IsCompanion(v) {
    if (!ktIsObj(v)) { return false }
    return !rtIsNil(v["__ktrxco"])
}

// Shared as rxObjRe (lib/regex.js).
function k5ObjRe(v) { return rxObjRe(v) }

// k5NewMatch builds a MatchResult over `prog` (the program the match ran on)
// while remembering `origSrc`, the pattern of the Regex the match came from.
function k5NewMatch(prog, origSrc, text, m) {
    var caps = []
    var mc = m["caps"]
    var i = 0
    while (i < mc.length) {
        caps.push(mc[i])
        i = i + 1
    }
    return {__rxmd: true, __rxsrc: prog["src"], __rxflags: prog["flags"],
            __rxtext: text, __rxcaps: caps, __ktsrc: origSrc}
}

// k5Orig is the plain (unanchored) program of the regexp a MatchResult came from.
function k5Orig(md) {
    var src = md["__ktsrc"]
    var flags = md["__rxflags"]
    if (typeof src != "string") { src = "" }
    if (typeof flags != "string") { flags = "" }
    return rxGet(src, flags)
}

// The Go twin's rxMatchOf answers three values; MetaJS has one return, so the
// three travel in a record. text stays a STRING: regex.js indexes UTF-16 code
// units where the Go engine indexes runes, which agree throughout the BMP.
// Shared as rxMatchOf (lib/regex.js); see the shared site for the capture coercion.
function k5MatchOf(v) { return rxMatchOf(v) }

// ----- Flags -----
//
// The engine's neutral letters are i (fold case), s (dot matches newline), m
// (^/$ are LINE anchors) and x (extended). Kotlin's RegexOption maps onto them
// one for one; Kotlin, like Java and unlike Ruby, anchors ^/$ to the whole input
// UNLESS MULTILINE is given, so "m" is NOT forced on. LITERAL is not a match
// mode - it quotes the pattern. CANON_EQ and UNIX_LINES are reported rather than
// silently ignored. "q" is unconditional: the JVM dialect always understands
// \Q...\E quote regions, which is what Pattern.quote emits.
function k5Flags(opts) {
    var names = []
    if (!rtIsNil(opts)) {
        if (ktIsArr(opts)) {
            var ai = 0
            while (ai < opts.length) {
                names.push(ktRender(opts[ai]))
                ai = ai + 1
            }
        } else if (ktIsSet(opts)) {
            // setOf(...) is the idiomatic spelling and answers a SET, not a list.
            var es = ktSetElems(opts)
            var si = 0
            while (si < es.length) {
                names.push(ktRender(es[si]))
                si = si + 1
            }
        } else {
            names.push(ktRender(opts))
        }
    }
    var flags = "q"
    var literal = false
    var k = 0
    while (k < names.length) {
        var o = names[k]
        if (o == "IGNORE_CASE") { flags = flags + "i" }
        else if (o == "DOT_MATCHES_ALL") { flags = flags + "s" }
        else if (o == "MULTILINE") { flags = flags + "m" }
        else if (o == "COMMENTS") { flags = flags + "x" }
        else if (o == "LITERAL") { literal = true }
        else if (o == "CANON_EQ" || o == "UNIX_LINES") {
            fail("RegexOption." + o + " is not supported")
        } else {
            fail("unknown RegexOption: " + o)
        }
        k = k + 1
    }
    return {flags: flags, literal: literal}
}

// k5Quote is Regex.escape / RegexOption.LITERAL: Pattern.quote, i.e. a \Q...\E
// quote region, which the shared engine understands - so this answers the SAME
// TEXT the JVM does and not merely an equivalent one. An embedded \E has to close
// and reopen the region, exactly as java.util.regex.Pattern.quote spells it.
function k5Quote(s) {
    var out = ""
    var i = 0
    while (i < s.length) {
        if (s.charAt(i) == "\\" && i + 1 < s.length && s.charAt(i + 1) == "E") {
            out = out + "\\E\\\\E\\Q"
            i = i + 2
            continue
        }
        out = out + s.charAt(i)
        i = i + 1
    }
    return "\\Q" + out + "\\E"
}

// ----- Replacement templates -----
//
// Kotlin's template is $1 / ${name}, with a backslash escaping the next
// character; the shared engine expands \1 / \k<name>. The rewrite happens here.
function k5Template(t) {
    var out = ""
    var i = 0
    var n = t.length
    while (i < n) {
        var c = t.charAt(i)
        if (c == "\\") {
            if (i + 1 >= n) {
                out = out + "\\\\"
                i = i + 1
                continue
            }
            if (t.charAt(i + 1) == "\\") { out = out + "\\\\" } else { out = out + t.charAt(i + 1) }
            i = i + 2
            continue
        }
        if (c == "$" && i + 1 < n) {
            var d = t.charCodeAt(i + 1)
            if (d >= 48 && d <= 57) {
                out = out + "\\" + t.charAt(i + 1)
                i = i + 2
                continue
            }
            if (d == 123) { // {
                var j = i + 2
                while (j < n && t.charCodeAt(j) != 125) { j = j + 1 }
                var nm = t.substring(i + 2, j)
                var c0 = -1
                if (nm.length > 0) { c0 = nm.charCodeAt(0) }
                if (c0 >= 48 && c0 <= 57) {
                    out = out + "\\" + nm.substring(0, 1)
                } else {
                    out = out + "\\k<" + nm + ">"
                }
                i = j + 1
                continue
            }
        }
        out = out + c
        i = i + 1
    }
    return out
}

function k5EscapeRepl(s) {
    var out = ""
    var i = 0
    while (i < s.length) {
        var c = s.charAt(i)
        if (c == "\\" || c == "$") { out = out + "\\" }
        out = out + c
        i = i + 1
    }
    return out
}

// ----- The operations -----

function k5Replace(re, s, repl, all) {
    k5Check(re)
    var out = ""
    var at = 0
    var last = 0
    while (at <= s.length) {
        var m = k5Search(re, s, at)
        if (m === null) { break }
        out = out + s.substring(last, m["begin"]) + rxExpand(re, s, m, repl)
        if (m["end"] == m["begin"]) {
            if (m["end"] < s.length) { out = out + s.charAt(m["end"]) }
            last = m["end"] + 1
            at = m["end"] + 1
        } else {
            last = m["end"]
            at = m["end"]
        }
        if (!all) { break }
    }
    if (last <= s.length) { out = out + s.substring(last, s.length) }
    return out
}

// Regex#replace(input) { m -> ... }: the lambda produces each replacement.
function k5ReplaceFn(re, s, fn) {
    var out = ""
    var at = 0
    var last = 0
    while (at <= s.length) {
        var m = k5Search(re, s, at)
        if (m === null) { break }
        var md = k5NewMatch(re, re["src"], s, m)
        out = out + s.substring(last, m["begin"]) + ktRender(ktCall1(fn, md))
        if (m["end"] == m["begin"]) {
            if (m["end"] < s.length) { out = out + s.charAt(m["end"]) }
            last = m["end"] + 1
            at = m["end"] + 1
        } else {
            last = m["end"]
            at = m["end"]
        }
    }
    if (last <= s.length) { out = out + s.substring(last, s.length) }
    return out
}

// Regex#split. limit 0 (Kotlin's default) means no limit; a positive limit stops
// after limit-1 cuts and keeps the rest of the input as the last part.
function k5Split(re, s, limit) {
    k5Check(re)
    var parts = []
    var at = 0
    var last = 0
    while (at <= s.length) {
        if (limit > 0 && parts.length >= limit - 1) { break }
        var m = k5Search(re, s, at)
        if (m === null) { break }
        if (m["end"] == m["begin"]) {
            if (m["begin"] >= s.length) { break }
            parts.push(s.substring(last, m["begin"] + 1))
            last = m["begin"] + 1
            at = m["begin"] + 1
        } else {
            parts.push(s.substring(last, m["begin"]))
            last = m["end"]
            at = m["end"]
        }
    }
    parts.push(s.substring(last, s.length))
    return parts
}

function k5FindAll(re, s) {
    k5Check(re)
    var out = []
    var at = 0
    while (at <= s.length) {
        var m = k5Search(re, s, at)
        if (m === null) { break }
        out.push(k5NewMatch(re, re["src"], s, m))
        if (m["end"] == m["begin"]) { at = m["end"] + 1 } else { at = m["end"] }
    }
    return out
}

// groupValues: index 0 is the whole match and a group that did not take part
// reads as "" (Kotlin), unlike groups[i], which is null there.
function k5GroupValues(re, text, m) {
    var out = []
    var i = 0
    while (i <= re["ngroups"]) {
        var g = rxGroup(re, text, m, i)
        if (g === null) { out.push("") } else { out.push(g) }
        i = i + 1
    }
    return out
}

// MatchResult.range is a real kotlin.ranges.IntRange - see ktRxRange.
function k5Range(first, last) {
    return {__range: true, from: first, to: last, st: 1, down: false, ch: false, pg: false}
}

// m.groups[i] / m.groups["name"]: a MatchGroup (value + range) or null.
// A group that took no part reads as null; an index or a name that does not
// exist at all is an error, as it is on the JVM.
function k5GroupAt(md, key) {
    var mo = k5MatchOf(md)
    var re = mo["re"]
    var i = -1
    if (ktIsStr(key)) {
        i = rxIndexOfName(re, key)
        if (i < 0) { fail("no group with name '" + key + "'") }
    } else {
        i = Math.trunc(ktNum(key))
        if (i < 0 || i > re["ngroups"]) { fail("group index " + i + " out of range") }
    }
    var g = rxGroup(re, mo["text"], mo["m"], i)
    if (g === null) { return null }
    var caps = mo["m"]["caps"]
    return {value: g, range: k5Range(caps[2 * i], caps[2 * i + 1] - 1)}
}

function k5Arg(args, i) {
    if (i >= args.length) { return undefined }
    return args[i]
}

function k5ArgInt(args, i, dflt) {
    if (i >= args.length) { return dflt }
    if (rtIsNil(args[i])) { return dflt }
    return Math.trunc(ktNum(args[i]))
}

// ----- Construction -----

function ktRxNew(src, flags) {
    var fl = k5Flags(flags)
    var pat = ktRender(src)
    if (fl["literal"]) { pat = k5Quote(pat) }
    k5Check(rxGet(pat, fl["flags"]))
    return {__rxsrc: pat, __rxflags: fl["flags"]}
}

// The `RegexOption` and `Regex` names used as VALUES. A RegexOption is modelled
// as its own name, so it prints the way Kotlin prints an enum entry.
function ktRxGlobal(name) {
    if (ktRender(name) == "Regex") { return {__ktrxco: true} }
    return {IGNORE_CASE: "IGNORE_CASE", MULTILINE: "MULTILINE",
            DOT_MATCHES_ALL: "DOT_MATCHES_ALL", COMMENTS: "COMMENTS",
            LITERAL: "LITERAL", CANON_EQ: "CANON_EQ", UNIX_LINES: "UNIX_LINES"}
}

// ----- The dispatchers -----

// ktRxMethod answers a call whose receiver is the Regex companion, a Regex, a
// MatchResult, or a String with a Regex argument, and KT_MISS otherwise.
function ktRxMethod(recv, name, args) {
    if (k5IsCompanion(recv)) {
        if (name == "escape") { return k5Quote(ktRender(k5Arg(args, 0))) }
        if (name == "escapeReplacement") { return k5EscapeRepl(ktRender(k5Arg(args, 0))) }
        if (name == "fromLiteral") { return ktRxNew(k5Arg(args, 0), "LITERAL") }
        return KT_MISS
    }
    if (ktIsStr(recv)) {
        if (name == "toRegex") { return ktRxNew(recv, k5Arg(args, 0)) }
        // The String members that take a pattern. A non-Regex argument is left to
        // the ordinary String behaviour, so plain replace/split/contains are
        // untouched.
        if (args.length > 0 && ktRxIsRegex(args[0])) {
            var sre = k5ObjRe(args[0])
            if (name == "matches") { return k5Whole(sre, recv) !== null }
            if (name == "contains") { return k5Search(sre, recv, 0) !== null }
            if (name == "split") { return k5Split(sre, recv, k5ArgInt(args, 1, 0)) }
            if (name == "replace") {
                if (ktIsFn(k5Arg(args, 1))) { return k5ReplaceFn(sre, recv, args[1]) }
                return k5Replace(sre, recv, k5Template(ktRender(k5Arg(args, 1))), true)
            }
            if (name == "replaceFirst") {
                return k5Replace(sre, recv, k5Template(ktRender(k5Arg(args, 1))), false)
            }
        }
        return KT_MISS
    }
    if (ktRxIsRegex(recv)) {
        var rre = k5ObjRe(recv)
        if (name == "matches") { return k5Whole(rre, ktRender(k5Arg(args, 0))) !== null }
        if (name == "containsMatchIn") { return k5Search(rre, ktRender(k5Arg(args, 0)), 0) !== null }
        if (name == "find") {
            var fs = ktRender(k5Arg(args, 0))
            var fm = k5Search(rre, fs, k5ArgInt(args, 1, 0))
            if (fm === null) { return null }
            return k5NewMatch(rre, rre["src"], fs, fm)
        }
        if (name == "findAll") { return k5FindAll(rre, ktRender(k5Arg(args, 0))) }
        if (name == "matchEntire") {
            var es = ktRender(k5Arg(args, 0))
            var em = k5Whole(rre, es)
            if (em === null) { return null }
            return k5NewMatch(rre, rre["src"], es, em)
        }
        if (name == "replace") {
            if (ktIsFn(k5Arg(args, 1))) { return k5ReplaceFn(rre, ktRender(k5Arg(args, 0)), args[1]) }
            return k5Replace(rre, ktRender(k5Arg(args, 0)),
                             k5Template(ktRender(k5Arg(args, 1))), true)
        }
        if (name == "replaceFirst") {
            return k5Replace(rre, ktRender(k5Arg(args, 0)),
                             k5Template(ktRender(k5Arg(args, 1))), false)
        }
        if (name == "split") { return k5Split(rre, ktRender(k5Arg(args, 0)), k5ArgInt(args, 1, 0)) }
        if (name == "toString") { return rre["src"] }
        fail("unknown Regex method: " + name)
    }
    if (ktRxIsMatch(recv)) {
        var mo = k5MatchOf(recv)
        if (name == "next") {
            var mm = mo["m"]
            var at = mm["end"]
            if (mm["end"] == mm["begin"]) { at = mm["end"] + 1 }
            var orig = k5Orig(recv)
            if (at > mo["text"].length) { return null }
            var nm = k5Search(orig, mo["text"], at)
            if (nm === null) { return null }
            return k5NewMatch(orig, orig["src"], mo["text"], nm)
        }
        if (name == "toString") {
            var wg = rxGroup(mo["re"], mo["text"], mo["m"], 0)
            if (wg === null) { return "" }
            return wg
        }
        fail("unknown MatchResult method: " + name)
    }
    return KT_MISS
}

// ktRxFget is Regex.pattern and the MatchResult properties.
function ktRxFget(o, name) {
    if (ktRxIsRegex(o)) {
        if (name == "pattern") { return k5ObjRe(o)["src"] }
        if (name == "options") { return [] }
        return KT_MISS
    }
    if (ktRxIsMatch(o)) {
        var mo = k5MatchOf(o)
        if (name == "value") {
            var g = rxGroup(mo["re"], mo["text"], mo["m"], 0)
            if (g === null) { return "" }
            return g
        }
        if (name == "range") { return k5Range(mo["m"]["begin"], mo["m"]["end"] - 1) }
        if (name == "groupValues") { return k5GroupValues(mo["re"], mo["text"], mo["m"]) }
        if (name == "groups") { return {__ktgroups: o} }
        if (name == "destructured") {
            // `val (a, b) = m.destructured` reads componentN, and this subset takes
            // componentN of a LIST positionally - so the holder IS the group list
            // without the whole match, which both halves of the pair agree on.
            var all = k5GroupValues(mo["re"], mo["text"], mo["m"])
            var rest = []
            var di = 1
            while (di < all.length) {
                rest.push(all[di])
                di = di + 1
            }
            return rest
        }
        return KT_MISS
    }
    if (k5IsGroups(o)) {
        // The compiler grammar rewrites a `.size` read to `.length` (its lists are
        // arrays), so both spellings arrive here.
        if (name == "size" || name == "length") {
            var gm = k5MatchOf(o["__ktgroups"])
            return gm["re"]["ngroups"] + 1
        }
        return KT_MISS
    }
    return KT_MISS
}

function ktRxIndex(o, key) {
    if (!k5IsGroups(o)) { return KT_MISS }
    return k5GroupAt(o["__ktgroups"], key)
}

// ----- The externs -----
//
// Regex(pattern) / Regex(pattern, options) / "pat".toRegex(): the pattern is
// validated in ktRxNew, so a bad one is a clean runtime error rather than a
// wrong match.
function js_rxktnew(pat, opts) { return ktRxNew(pat, opts) }

function js_rxktglobal(name) { return ktRxGlobal(name) }
// ============================================================================
// SECTION 6 - THE SCOPE-TAKING EXTERNS
// ============================================================================
//
// Ten of Kotlin's externs take a SCOPE HANDLE. A scope is the C floor's private
// storage: from emitted IR (languages/kotlin-to-llvm-ir.abnf) only the INNERMOST
// binding and the INNERMOST `this` are reachable, through the js_scope_{new,get,
// set,set_or_create,decl,has,typeof} externs, and there is no js_scope_parent.
// scopeNew / scopeParent / scopeGet / scopeHas / scopeDecl (languages/lib/runtime.c,
// abnf/jsrtint.go's scopeBindings and metajs-interpreter.abnf's scNew/scParent/
// scGet/scHas/scDecl) are MetaJS HOST BUILTINS, reachable from a layer-2 file and
// NOT from emitted IR. So the chain walk belongs HERE; languages/lib/ruby-rt.metajs's
// js_rmethodval is the same shape.
//
// THE SPLIT WITH THE EMITTER, and why it is deliberately not all-or-nothing. In
// MetaJS a call is a scope frame (docs/working-on-this-project.md 5.1), and
// kt_ktgetp is the compiler half's hottest name resolution. So the emitter KEEPS
// the arms it can reach - the innermost binding, the innermost `this`, the
// innermost `__dispatch` - and calls in here only when all of them miss.
// Everything below therefore runs on a COLD path and is a strict SUPERSET of what
// the emitter tried: the walks start at the same scope in the same order, so the
// first hit is the same binding, and what is new is only the frames FURTHER OUT.
//
// What only the walk can answer (all asserted in tests/kotlin-test-full.kt):
//
//   * A Unit-valued local read from an ENCLOSING scope. js_scope_typeof cannot
//     tell "holds undefined" from "absent" and js_scope_has does not walk;
//     scopeHas + scopeParent IS that question (docs/working-on-this-project.md 7.3).
//   * An outer-class member read from inside `apply { }` - `Other(5).apply { r =
//     an + on }` inside a member of A.
//   * A member extension of the ENCLOSING class called through `with`:
//     `with(Other(9)) { 2.tripled() }`. The receiver-stack walk below answers it
//     natively; see k6MextFind's header for the other two engines.

// ----- the two walks everything below is written on -----

// The innermost scope of the chain that BINDS `name`, or undefined. scopeHas is
// the OWN-scope test and scopeParent the step, and the pair answers the one
// question js_scope_typeof cannot: a slot HOLDING undefined is bound, an absent
// name is not, and both are "undefined" to a typeof.
function k6Owner(env, name) {
    var s = anytype
    s = env
    while (s !== undefined && s !== null) {
        if (scopeHas(s, name)) { return s }
        s = scopeParent(s)
    }
    return undefined
}

// The value bound to `name` anywhere up the chain, or KT_MISS. This is
// js_scope_get made ASKABLE - js_scope_get aborts on a miss, which is why the
// emitter has to probe with js_scope_typeof first and why a slot holding
// undefined defeated it.
function k6Find(env, name) {
    var s = k6Owner(env, name)
    if (s === undefined) { return KT_MISS }
    return scopeGet(s, name)
}

// A LOCAL or top-level DELEGATED property binds a BOX, not a value, so every
// read goes through the delegate's getValue. The box is an ordinary object
// ({__pdeleg, d, owner, pname}).
function k6DelegRead(v) {
    if (ktIsObj(v)) {
        if (v["__pdeleg"] !== undefined) {
            return js_ktdget(v["d"], v["owner"], v["pname"])
        }
    }
    return v
}

// js_ktget's class-instance arm, kept out of line because js_kset and
// js_ktvarset need the same three tests in the same order. The Go twin is the
// `if obj, isObj := t.(*jsObject)` branch of jsrtkotlin.go's js_ktget: an OWN
// property (lateinit-checked), then a property with an ACCESSOR - which lives on
// the DESCRIPTOR chain (js_defprop) and never on the instance, so the own-property
// test above misses it - and then a MISS, because a method name must fall
// through to the receiver stack rather than bind here.
function k6InstRead(t, name) {
    if (k4Own(t, name)) {
        var own = anytype
        own = t[name]
        k4LateinitCheck(t, name, own)
        return own
    }
    var acc = k4bFindAcc(t, name)
    if (acc !== undefined) {
        if (acc["get"] === undefined) { return undefined }
        return k4bCallAcc(acc["get"], t, [])
    }
    return KT_MISS
}

// ----- js_ktget -----

// jsrtkotlin.go:2131's js_ktget, walk for walk. `iscall` is the SYNTACTIC
// POSITION the emitter recorded - true for `name(...)`, false for a bare `name`
// - and it is what lets `with(1..7 step 2) { first }` read the property while
// `with(listOf(4, 5)) { first() }` still binds the method.
function js_ktget(env, name, iscall) {
    var s = anytype
    var v = anytype
    var t = anytype
    // 1. the innermost BINDING, delegate-unwrapped.
    s = env
    while (s !== undefined && s !== null) {
        if (scopeHas(s, name)) {
            v = scopeGet(s, name)
            return k6DelegRead(v)
        }
        s = scopeParent(s)
    }
    // 2. EVERY `this` up the chain, innermost first. Kotlin's implicit receivers
    //    form a STACK and an unqualified name the innermost one does not answer
    //    falls through to the next one OUT, so this deliberately does not stop at
    //    the first frame carrying a `this` - that is the arm that reads this@Q.tag
    //    from inside `with(P(1)) { tag }` written in a member of Q, and the arm
    //    the emitter could not have.
    s = env
    while (s !== undefined && s !== null) {
        if (scopeHas(s, "this")) {
            t = scopeGet(s, "this")
            if (ktIsObj(t) && t["__class"] !== undefined) {
                var iv = anytype
                iv = k6InstRead(t, name)
                if (!ktMiss(iv)) { return iv }
            } else {
                if (!rtIsNil(t)) {
                    var mv = anytype
                    mv = ktRecvMember(t, name, iscall)
                    if (!ktMiss(mv)) {
                        if (!rtIsNil(mv)) { return mv }
                    }
                }
            }
        }
        s = scopeParent(s)
    }
    // 3. Inside a MEMBER extension function `this` is the EXTENSION receiver, so
    //    a name belonging to the DECLARING class resolves against the dispatch
    //    receiver the frame carries - Kotlin's second implicit receiver. The Go
    //    twin stops at the FIRST frame carrying one; so does this.
    s = env
    while (s !== undefined && s !== null) {
        if (scopeHas(s, "__dispatch")) {
            var dv = anytype
            dv = ktRecvMember(scopeGet(s, "__dispatch"), name, iscall)
            if (!ktMiss(dv)) { return dv }
            s = undefined
        } else {
            s = scopeParent(s)
        }
    }
    // 4. The implicit-receiver STACK and the stdlib. js_ktglobal is the emitter's
    //    own last-but-one arm, so natively this is normally already spent; it is
    //    repeated because js_ktget is also called directly (kt_bareref's fallback).
    var g = anytype
    g = js_ktglobal(name, iscall)
    if (g !== undefined) { return g }
    fail("unknown name: " + name)
    return undefined
}

// ----- the two WRITE externs -----

// abnf/jsrt.go:10855's js_kset: the innermost BINDING, else a property of the
// first `this` up the chain, else an abort. There is no scopeSet builtin on
// purpose - "walk with scopeHas/scopeParent, then scopeDecl" is it, and scopeDecl
// binds in the scope handed to it, which is the owning one here.
function js_kset(env, name, v) {
    var s = k6Owner(env, name)
    if (s !== undefined) {
        scopeDecl(s, name, v)
        return 0
    }
    s = env
    while (s !== undefined && s !== null) {
        if (scopeHas(s, "this")) {
            var t = anytype
            t = scopeGet(s, "this")
            if (ktIsObj(t)) {
                if (k4Own(t, name)) {
                    t[name] = v
                    return 0
                }
                // The write twin of js_ktget's accessor arm: a property with a
                // SETTER is a js_defprop pair on the DESCRIPTOR, so the own-property
                // test missed it. (Under llvm.Run rt.setMember honours the pair
                // itself; natively the floor's member write cannot see it.)
                var acc = k4bFindAcc(t, name)
                if (acc !== undefined) {
                    js_ktset(t, name, v)
                    return 0
                }
            }
            s = undefined
        } else {
            s = scopeParent(s)
        }
    }
    // The IMPLICIT RECEIVER: `with(node) { tag = "x" }`. ktRecvStack is layer 2's
    // own.
    return k6RecvWrite(name, v, "js_kset")
}

// jsrtkotlin.go:2008's js_ktvarset: js_kset made DELEGATE-aware, plus the
// __dispatch write arm. A binding holding a delegate box is written through its
// setValue.
function js_ktvarset(env, name, v) {
    var s = k6Owner(env, name)
    if (s !== undefined) {
        var cur = anytype
        cur = scopeGet(s, name)
        if (ktIsObj(cur)) {
            if (cur["__pdeleg"] !== undefined) {
                js_ktdset(cur["d"], cur["owner"], cur["pname"], v)
                return 0
            }
        }
        scopeDecl(s, name, v)
        return 0
    }
    // The dispatch receiver of a MEMBER extension is a write target too:
    // `fun String.emit() { out += this }` assigns the declaring class's own
    // property while `this` is the String. js_kset stops at the first frame
    // carrying a `this`, so this has to be tried before falling into it.
    s = env
    while (s !== undefined && s !== null) {
        if (scopeHas(s, "this")) {
            var t = anytype
            t = scopeGet(s, "this")
            if (ktIsObj(t)) {
                if (k4Own(t, name)) {
                    t[name] = v
                    return 0
                }
                var acc = k4bFindAcc(t, name)
                if (acc !== undefined) {
                    js_ktset(t, name, v)
                    return 0
                }
            }
        }
        if (scopeHas(s, "__dispatch")) {
            var d = anytype
            d = scopeGet(s, "__dispatch")
            if (ktIsObj(d)) {
                if (k4Own(d, name)) {
                    d[name] = v
                    return 0
                }
            }
        }
        s = scopeParent(s)
    }
    return k6RecvWrite(name, v, "js_ktvarset")
}

// The write that reaches an IMPLICIT RECEIVER - `with(node) { tag = "x" }`.
// ktRecvStack is layer 2's own, so the walk is an ordinary loop over it.
function k6RecvWrite(name, v, who) {
    var i = ktRecvStack.length - 1
    while (i >= 0) {
        var r = ktRecvStack[i]
        if (ktIsObj(r)) {
            if (r[name] !== undefined) {
                r[name] = v
                return 0
            }
        }
        i = i - 1
    }
    fail("assignment to unknown name: " + name)
    return 0
}

// ----- this@Outer, ::name and the delegate's thisRef -----

// jsrtkotlin.go:1126's js_ktouter: `this@Outer`. Walk the scope chain for a
// `this` whose own __class / __super chain declares that name. The emitter's
// `this` whose own __class / __super chain declares that name. Walking the
// innermost instance's __outer chain would give the same answer only when the
// qualified receiver is an enclosing INSTANCE; this is the exact test.
function js_ktouter(env, name) {
    var s = anytype
    s = env
    while (s !== undefined && s !== null) {
        if (scopeHas(s, "this")) {
            var t = anytype
            t = scopeGet(s, "this")
            if (ktIsObj(t)) {
                var cls = anytype
                cls = t["__class"]
                var guard = 0
                while (guard < 64) {
                    guard = guard + 1
                    if (!ktIsObj(cls)) { guard = 99 } else {
                        if (cls["__name"] === name) { return t }
                        cls = cls["__super"]
                    }
                }
            }
        }
        s = scopeParent(s)
    }
    return undefined
}

// jsrtkotlin.go:1564's js_ktrefbase, minus its FIRST arm: a builtin TYPE name is
// decided at EMIT time (makeQualRef in kotlin-to-llvm-ir.abnf), because the
// extern's ktTypeNames test runs before its scope walk and so cannot be lowered
// under it. What is left is the binding walk, the `this` walk, and "nothing
// carries this name, so it names a type". Layer 2 cannot make a Go ktTypeName
// marker, so the marker is the NAME ITSELF as a string - which is exactly the
// shape js_ktref reads as "the base named a type".
function js_ktrefbase(env, name, istype) {
    // The ktTypeNames arm, and why it arrives as a FLAG rather than a fourth copy
    // of the list. The Go twin tests `ktTypeNames[name]` BEFORE its scope walk, so
    // `String::length` is an unbound reference even though a same-named String
    // builder is in scope. The emitter already makes that decision statically -
    // makeQualRef in kotlin-to-llvm-ir.abnf, over ktTypeNameSet, because the base
    // name is a literal at the call site - so it hands the answer over instead of
// this file keeping another copy of a list that abnf/jsrtkotlin.go,
// kotlin-interpreter.abnf and the emitter must already keep in step. The Go
// twin ignores the extra argument and re-decides from its own table, which is
// the same table, so the two engines agree by construction.
    if (istype === true) { return name }
    var v = anytype
    v = k6Find(env, name)
    if (!ktMiss(v)) { return v }
    var s = anytype
    s = env
    while (s !== undefined && s !== null) {
        if (scopeHas(s, "this")) {
            var t = anytype
            t = scopeGet(s, "this")
            if (ktIsObj(t)) {
                if (k4Own(t, name)) { return t }
            }
        }
        s = scopeParent(s)
    }
    return name
}

// jsrtkotlin.go:1619's js_ktbareref: a bare `::name`. A scope binding is the
// value itself, except that a CLASS descriptor becomes a constructor reference
// (js_ktctorref decides); a name the scope does not carry but an enclosing `this`
// DOES becomes a BOUND property reference, which is what makes `::prop` inside a
// member a KProperty0; anything else falls through to ordinary name resolution.
// js_ktnameval is how the name is remembered so KFunction.name still answers.
function js_ktbareref(env, name) {
    var v = anytype
    v = k6Find(env, name)
    if (!ktMiss(v)) { return js_ktctorref(js_ktnameval(v, name)) }
    var s = anytype
    s = env
    while (s !== undefined && s !== null) {
        if (scopeHas(s, "this")) {
            var t = anytype
            t = scopeGet(s, "this")
            if (ktIsObj(t)) {
                if (k4Own(t, name)) { return js_ktref(t, name) }
            }
        }
        s = scopeParent(s)
    }
    return js_ktctorref(js_ktnameval(js_ktget(env, name, false), name))
}

// jsrtkotlin.go:1895's js_ktdthis: the thisRef a delegated property is declared
// against - the FIRST `this` up the chain, null when there is none.
function js_ktdthis(env) {
    var s = anytype
    s = env
    while (s !== undefined && s !== null) {
        if (scopeHas(s, "this")) { return scopeGet(s, "this") }
        s = scopeParent(s)
    }
    return null
}

// ----- the three MEMBER-EXTENSION externs -----

// jsrtkotlin.go's ktMemberExtFind, with one deliberate difference that is a FIX
// and not a port error.
//
// The Go twin collects ONE start per key: the first scope carrying a `this` and
// the first carrying a `__dispatch`, and then walks each start's own
// __class/__outer graph. So inside a member of A, `with(Other(9)) { 2.tripled() }`
// - where `fun Int.tripled()` is a member extension declared in A - finds only
// the `with` receiver and reports the name unresolved. Both the Go twin and
// languages/kotlin-interpreter.abnf's memberExtLookup do this, so that program
// fails in llvm.Run and in the interpreter while the native binary answers 24.
// Per the Kotlin specification `with` takes a `T.() -> R` extension lambda, which
// ADDS an implicit receiver rather than replacing the enclosing member's dispatch
// receiver, so the call resolves and 24 is right. Closing it in the other two
// engines means collecting EVERY frame's this/__dispatch in jsrtkotlin.go's
// ktMemberExtFind and in memberExtLookup instead of breaking at the first; the
// test assertion is written at the shape all three engines agree on.
//
// EVERY frame's `this` and `__dispatch`, innermost first, then the implicit
// receiver stack that ktWithRecv pushes for with / run / apply / buildString /
// buildList / buildMap and for every T.() -> R lambda.
function k6MextFind(env, mangled) {
    var s = anytype
    s = env
    while (s !== undefined && s !== null) {
        if (scopeHas(s, "this")) {
            var r0 = k4bMextWalk(scopeGet(s, "this"), mangled)
            if (r0 !== undefined) { return r0 }
        }
        if (scopeHas(s, "__dispatch")) {
            var r1 = k4bMextWalk(scopeGet(s, "__dispatch"), mangled)
            if (r1 !== undefined) { return r1 }
        }
        s = scopeParent(s)
    }
    var i = ktRecvStack.length - 1
    while (i >= 0) {
        var r2 = k4bMextWalk(ktRecvStack[i], mangled)
        if (r2 !== undefined) { return r2 }
        i = i - 1
    }
    return undefined
}

function js_ktmextget(env, recv, name) {
    var r = k6MextFind(env, "extget$" + name)
    if (r !== undefined) { return ktCall(r["fn"], [r["disp"], recv]) }
    return js_ktfget(recv, name)
}

function js_ktmextset(env, recv, name, v) {
    var r = k6MextFind(env, "extset$" + name)
    if (r !== undefined) {
        ktCall(r["fn"], [r["disp"], recv, v])
        return v
    }
    // NOTHING FOUND MEANS AN ORDINARY MEMBER WRITE, AND AN ORDINARY MEMBER WRITE IS
    // NOT A RAW SLOT STORE: `recv[name] = v` would write an own field straight past
    // any {__acc} accessor pair, and a program that declares `var Int.doubled`
    // inside ANY class makes the emitter route every `x.doubled =` through here,
    // including an unrelated class's `var doubled get()/set(v)`. The Go twin
    // (jsrtkotlin.go's js_ktmextset) uses rt.setMember, whose accessor arm
    // k4bSetMember is the port of.
    k4bSetMember(recv, name, v)
    return v
}

function js_ktmextcall(env, recv, name, args) {
    var r = k6MextFind(env, "ext$" + name)
    if (r !== undefined) {
        var a = [r["disp"], recv]
        var i = 0
        while (i < args.length) {
            a.push(args[i])
            i = i + 1
        }
        return ktCall(r["fn"], a)
    }
    return js_ktsmcall(recv, name, args)
}
