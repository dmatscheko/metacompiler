// go-rt.metajs -- GO'S OWN SEMANTICS, in MetaJS: the layer-2 runtime that
// languages/go-to-llvm-ir.abnf links next to the C floor (languages/lib/runtime.c,
// layer 1). The generic js_* primitives the emitted IR calls are the floor's; the
// Go-specific ones are here.
//
// Compile with:
//     mec languages/metajs-to-llvm-ir.abnf languages/lib/go-rt.metajs -q -rt-lib
// which is what tests/gen-go-rt-ll.sh does; the result is the checked-in
// languages/lib/go-rt.ll that go-to-llvm-ir.abnf links next to runtime.ll.
// -rt-lib exports every TOP-LEVEL `function js_*` below under its own C symbol,
// so nothing else in this file is visible to the linker - the helpers are
// deliberately named go*/gop*.
//
// THE AUTHORITATIVE SPECIFICATION IS abnf/jsrtgolang.go (the fmt renderer and
// the four width-carrying slot writers) plus the shared externs it layers over
// in abnf/jsrt.go (the js_go* family, js_map_get/js_map_del, js_range_*,
// js_rundefers, js_is_type, js_jadd, js_dict_new, js_pyin, js_pyset,
// js_goslice, js_gospread, memberCall) and abnf/jsrtint.go (the sized-integer
// box, whose externs are all in the floor). This file matches them function for
// function. Where it CANNOT, the site says so in full.
//
// ----- the value model -------------------------------------------------------
//
//     null / undefined     ==  nil (a nil interface, pointer, map or slice)
//     a boolean            ==  bool
//     a PLAIN NUMBER       ==  an int/int64/rune whose value is exact in a
//                              double, i.e. |v| <= 2^53. ALSO an untyped
//                              fractional constant (see js_gotypeis).
//     a SIZED INTEGER      ==  any other integer: a sized type (int8..uint64) or
//                              a 64 bit value outside the exact range. The Go
//                              twin uses jsGInt (abnf/jsrtint.go); the C floor
//                              has it as a REAL PRIMITIVE TYPE (tag 13).
//     a BOXED DOUBLE       ==  float64 / float32, style 1 (floGo). The Go twin
//                              uses jsJFlo (abnf/jsrtjvm.go); the floor has it
//                              as tag 14.
//     a string             ==  string. UTF-16 here, as everywhere in this
//                              runtime; len() is the UTF-8 BYTE count (byteLen).
//     an array             ==  a Go ARRAY (a value type), and the backing store
//                              of a slice
//     a {__dict} object    ==  map: keys/vals parallel arrays, insertion ordered,
//                              plus `zero` (the value type's zero value)
//     a {__class: $sl}     ==  a SLICE HEADER: a (backing array), o (offset),
//                              n (length), c (capacity), et (element type text)
//     a {__class: $ptr}    ==  a POINTER CELL: o (the SCOPE or object that holds
//                              the variable) and k (its name)
//     a {__class: $cx}     ==  a complex: re, im
//     any other object     ==  a struct instance; its descriptor is __class,
//                              which carries __isclass, __name, __fields,
//                              __ftypes and the methods
//
// ----- what the FLOOR supplies, so this file does not -------------------------
//
// Go's whole sized-integer surface is already in the C floor: js_giarith,
// js_gicmp / js_gilt / js_gile / js_gigt / js_gige, js_giadd, js_giconv,
// js_gilit, js_gineg, js_ginot, js_gival, js_giis, and js_gflo / js_jfdiv for
// the boxed double, which is why Go's own layer-2 surface is small for a
// language this size.
//
// ----- si_norm: Go WANTS it, like Dart and unlike Java ------------------------
//
// abnf/jsrtint.go states Go's invariant at the type: "plain number == a signed 64
// bit integer whose value is exact in a double; jsGInt == any other integer".
// That IS giNorm, and giNorm IS what sint() applies, so Go needs neither Java's
// marked-unsigned trick nor sintRaw, and there is no pair layer and no box layer
// in this file.
//
// A floor extern reading a tag 13 cell numerically sees a MAGNITUDE: to_number of
// a tag 13 cell is si_float, whose 64-bit UNSIGNED arm answers d_from_ulong(fa(h)).
// That is right for Go: an unsigned-marked width-64 cell really IS a uint64, and
// abnf/jsrtint.go's own js_gival does exactly the same thing
// (`if b.u && b.w == 64 { return float64(uint64(b.v)) }`). si_float IS Go's
// js_gival, si_val is NOT.
//
// ----- what Go does NOT need ---------------------------------------------------
//
//  1. NO `__raw` truthy shim. compile-core's truthy() emits `icmp ne <call>, 0`
//     on core.truthyExt, so that extern must answer a RAW INTEGER - a shim
//     handing back a boolean HANDLE gives 2 for false, which is != 0, so every
//     condition in the program would be taken, silently.
//     `grep -n truthyExt languages/go-to-llvm-ir.abnf` is EMPTY, so Go keeps
//     compile-core's default "js_truthy", which is the C FLOOR's own function
//     and already answers the raw 1/0. Like Swift, Java, C# and Dart, and
//     unlike Lua and PHP.
//  2. NO `_raw` PARAMETER: every bare handle(k) in the grammar goes to
//     js_closure, js_arg or js_gorest, which are floor externs, and every
//     operator selector goes through emitStr/emitNum.
//  3. NO jsChar. Go has no character type; a rune is an int32, which is the
//     sized-integer tag, and the emitter emits js_char / js_char_code /
//     js_kindex zero times.
//  4. NO COROUTINE PRIMITIVE: the grammar emits no js_genfn / js_yield. Go's
//     goroutines are COOPERATIVE and DETERMINISTIC in both halves (the model of
//     go-interpreter.abnf): `go f()` only QUEUES a nullary closure, and a receive
//     that finds its channel empty RUNS THE QUEUE - each queued goroutine to
//     completion, in spawn order - until one of them fills it. There is no
//     suspension point, so there is no second stack to keep and the floor's
//     tag 15/16 coroutine is not needed. The whole model is goQueue
//     below: one array and one drain loop.
//
// ----- js_gounctl is lowered in the EMITTER -----------------------------------
//
// js_gounctl reads the completion value out of a CONTROL SIGNAL, the floor's
// private tag-10 cell, which no host builtin opens - so layer 2 cannot write it.
// js_ctl_kind and js_ctl_value ARE floor externs and an EMITTER may call them, so
// go-to-llvm-ir.abnf's emitUnctl emits the two-arm select in IR.
//
// ----- MetaJS rules that shape the code below --------------------------------
//
// docs/abnf-dialect-gotchas.md: a local (or a reassigned parameter) keeps the
// TYPE CLASS it is first assigned, so a variable that holds a number in one
// branch and an object in another is declared `var x = anytype`; there is no
// ASI, so every `return` carries its value on the same line and a value-less
// early return is BRACED; no for..in, no splice, no split/join/lastIndexOf,
// indexOf ignores its from-index, array.length is not assignable, and there are
// no exponent literals.

// The shared layer-2 runtime. It supplies the externs every language implements
// identically, parameterised by the rtk* hooks below. Same mechanism ruby uses for
// `import "./regex.js"`.
import "./runtime.metajs"

// ----- the rtk* hooks the shared runtime calls -------------------------------
function rtkStr(v) { return goJavaStr(v) }
function rtkNum(v) { return goNum(v) }
// This file keeps its OWN js_is_type, which SHADOWS the shared one: both are
// top-level declarations in one pinned scope, and -rt-lib's lazy boot runs the
// imported file's top level BEFORE this file's, so the later declaration - this
// one - is what the name resolves to. The hooks below exist only so the shared
// body stays resolvable; they are never reached.
function rtkIsChar(v) { return false }
function rtkIsArr(v) { return Array.isArray(v) }
// js_supercall's one knob. This language's emitter never emits js_supercall, so
// the shared body is unreachable here; the hook is defined anyway so that the day
// it IS emitted the answer is the plain one and not a missing name.
function rtkCall(f, self, argv) { return f.apply(undefined, argv) }
// js_pyset's two knobs.
function rtkIsDict(v) { return goIsDict(v) }
function rtkDictFind(keys, k) { return rtDictFind(keys, k) }

// ===================================================== value readings =======

// giNumeric: the two things a declared width may be applied to - a plain number
// and a sized integer, and NOT a boxed double. A float64 value flowing into a
// sized slot keeps its box in the Go twin (`case float64, jsGInt` does not list
// jsJFlo), so the width is not applied to it here either.
function goNumeric(v) {
    if (typeof v != "number") { return false }
    if (floIs(v)) { return false }
    return true
}

// giFloat / rt.toNumber of a Go value: the double reading.
function goNum(v) {
    if (typeof v == "number") {
        if (floIs(v)) { return floNum(v) }
        if (sintIs(v)) { return sintNum(v) }
        return v
    }
    if (typeof v == "string") { return goStrNum(v) }
    if (v === true) { return 1 }
    if (v === false) { return 0 }
    if (v === undefined) { return 0 / 0 }
    if (v === null) { return 0 }
    return 0 / 0
}

// The engine's own string -> number coercion, spelled out because MetaJS has no
// implicit one and parseFloat stops at the first bad character where JS's
// ToNumber answers NaN for the whole string.
function goStrNum(s) {
    var t = goTrim(s)
    if (t.length == 0) { return 0 }
    var f = parseFloat(t)
    return f
}

function goTrim(s) {
    var a = 0
    var b = s.length
    while (a < b) {
        var c = s.charCodeAt(a)
        if (c != 32 && c != 9 && c != 10 && c != 13) { break }
        a = a + 1
    }
    while (b > a) {
        var c2 = s.charCodeAt(b - 1)
        if (c2 != 32 && c2 != 9 && c2 != 10 && c2 != 13) { break }
        b = b - 1
    }
    return s.substring(a, b)
}

// An index / a length / a count: the plain-number reading.
function goIdx(v) { return Math.trunc(goNum(v)) }

// ===================================================== the object shapes ====

function goIsObj(v) {
    if (v === null) { return false }
    if (v === undefined) { return false }
    if (typeof v != "object") { return false }
    if (Array.isArray(v)) { return false }
    return true
}

function goIsDict(v) {
    if (!goIsObj(v)) { return false }
    if (v.__dict !== true) { return false }
    if (!Array.isArray(v.keys)) { return false }
    if (!Array.isArray(v.vals)) { return false }
    return true
}

// The __class descriptor of a value, or undefined. goClassOf.
function goClassOf(v) {
    if (!goIsObj(v)) { return undefined }
    var c = v.__class
    if (!goIsObj(c)) { return undefined }
    return c
}

// rt.dictFind over map m: the index of a key, or -1. Keys compare with Go's ==
// (goValueEq), which is what dictFind's strictEq plus the runtime's number
// identity does for every key type a Go map may have - except that a POINTER key
// (`map[*T]V`, read off the map's type text) is identity, where the struct it
// points at would compare by value. Twins: goMapKeyIdx in abnf/jsrt.go, mapFind in
// go-interpreter.abnf.
function goMapFind(m, k) {
    var keys = m.keys
    // A map whose key type is an interface (`ik`, set by the emitter) tells its
    // keys apart by dynamic type as well: float64(1) and 1 are two keys.
    if (m.ik === true) {
        var ii = 0
        while (ii < keys.length) {
            if (goIfEq(keys[ii], k)) { return ii }
            ii = ii + 1
        }
        return 0 - 1
    }
    // The typeof gate is the fast path: a string or number key - which is nearly every
    // Go map - leaves here without a call.
    if (typeof k == "object" && k !== null && goKeyIsVal(k) && !goPtrKeyed(m)) {
        var i = 0
        while (i < keys.length) {
            if (goValueEq(keys[i], k)) { return i }
            i = i + 1
        }
        return 0 - 1
    }
    return rtDictFind(keys, k)
}
function goPtrKeyed(m) {
    var t = m.mty
    return typeof t == "string" && t.length > 4 && t.charAt(4) == "*"
}

// A Go map key that is a VALUE TYPE - a struct or an array. Go's == on those is
// element-by-element (goValueEq), so `m[Pair{1,2}]` has to find an entry stored under a
// DIFFERENT Pair object holding the same fields, which rtDictFind's === would miss. A
// slice is excluded on purpose: it is not a legal Go map key at all and identity is the
// cheaper answer for it. The twins are the goLang arm of dictKeyEq in abnf/jsrt.go and
// mapFind in languages/go-interpreter.abnf.
function goKeyIsVal(k) {
    if (Array.isArray(k)) { return true }
    var c = goClassOf(k)
    if (c === undefined) { return false }
    return goStrOf(c.__name) != "$sl"
}

// rt.strictEq over the value model Go uses. The two number tags compare by
// VALUE, never by identity: int8(1) == 1 holds and float64(1) == 1 holds.
//
// THE SIZED ARM IS NOT the double reading. giEq is `giVal(l) == giVal(r)` - an
// EXACT int64 comparison - so 9007199254740992 (a plain number, the largest one
// giNorm keeps unboxed) and 9007199254740993 (a box, one past it) are DIFFERENT, as
// in go. Reading both through a double rounds the second one down and answers
// true. sintCmp is the exact comparison: two cells with the same payload compare
// equal whatever the signedness, and two with different payloads never do.
function goStrictEq(a, b) {
    if (typeof a == "number" && typeof b == "number") {
        if (floIs(a)) { return floNum(a) === goNum(b) }
        if (floIs(b)) { return floNum(b) === goNum(a) }
        if (sintIs(a) || sintIs(b)) { return sintCmp(a, b) == 0 }
        return a === b
    }
    return a === b
}

// goIsNilMap: "this is the zero value of a map type" - an empty dict carrying the
// __nil mark. The zero value of a map is a MARKED EMPTY MAP and not nil, because a
// nil map has to READ like an empty one in Go; emitZeroTy in
// languages/go-to-llvm-ir.abnf has the argument. The twins are giIsNilMap in
// abnf/jsrt.go and isNilMap in languages/go-interpreter.abnf.
function goIsNilMap(v) {
    if (!goIsObj(v)) { return false }
    if (v.__dict !== true) { return false }
    return v.__nil === true
}

// goIsNilZero: "this is the zero value of a map OR a slice type", i.e. what `== nil`
// has to answer true for. A slice zeroes to a marked empty HEADER for the same reason
// a map zeroes to a marked empty dict - it has to READ like an empty one (len, range,
// append, print) - and the mark is what makes `var s []int; s == nil` true. Set by
// emitNilSl in languages/go-to-llvm-ir.abnf; the twins are giIsNilZero in abnf/jsrt.go
// and isNilZero in languages/go-interpreter.abnf.
function goIsNilZero(v) {
    if (goIsNilMap(v)) { return true }
    if (!goIsObj(v)) { return false }
    if (v.__nil !== true) { return false }
    var c = goClassOf(v)
    if (c === undefined || c === null) { return false }
    return goStrOf(c.__name) == "$sl"
}

// Go's ==: VALUE equality for structs and arrays (both are value types) and
// identity for everything else; nil compares equal to an unset slice/map/pointer.
// abnf/jsrt.go's goValueEq, function for function.
function goValueEq(a, b) {
    if (a === undefined || a === null) {
        if (b === undefined || b === null) { return true }
        return goIsNilZero(b)
    }
    if (b === undefined || b === null) { return goIsNilZero(a) }
    if (Array.isArray(a)) {
        if (!Array.isArray(b)) { return false }
        if (a.length != b.length) { return false }
        var i = 0
        while (i < a.length) {
            if (!goValueEq(a[i], b[i])) { return false }
            i = i + 1
        }
        return true
    }
    if (Array.isArray(b)) { return false }
    var ac = goClassOf(a)
    var bc = goClassOf(b)
    if (ac !== undefined && bc !== undefined) {
        if (goStrOf(ac.__name) != goStrOf(bc.__name)) { return false }
        var af = ac.__fields
        var bf = bc.__fields
        if (!Array.isArray(af) || !Array.isArray(bf) || af.length != bf.length) { return a === b }
        var j = 0
        while (j < af.length) {
            var k = goStrOf(af[j])
            if (k != goStrOf(bf[j])) { return false }
            if (!goValueEq(goProp(a, k), goProp(b, k))) { return false }
            j = j + 1
        }
        return true
    }
    return goStrictEq(a, b)
}

// The imported package SCOPE an object carries, or undefined for every other value.
// __pkgscope holds a real scope handle (an ordinary value: js_closure has carried one
// since the beginning), which the floor's scope host API - scopeHas / scopeGet /
// scopeDecl, ids 67 / 66 / 68 - can open. See js_gofield.
function goPkgScope(o) {
    if (!goIsObj(o)) { return undefined }
    return o.__pkgscope
}

// o.props[k] with an absent key answering undefined, which is what the Go twin's
// map read does. There is no hasOwn in a -rt-lib module (the floor seeds no such
// builtin), so "present" is spelled "not undefined" - the one difference is a
// property explicitly HOLDING undefined, which this value model uses for nil and
// which every caller here treats the same way as an absent one.
function goProp(o, k) {
    if (!goIsObj(o)) { return undefined }
    return o[k]
}

function goHas(o, k) {
    if (!goIsObj(o)) { return false }
    return o[k] !== undefined
}

function goStrOf(v) {
    if (typeof v == "string") { return v }
    if (v === undefined) { return "undefined" }
    if (v === null) { return "null" }
    return gopStr(v)
}

// js_gocopy(v, code): the copy a store of a struct VALUE makes, by the code
// goCopyCodeC in languages/go-to-llvm-ir.abnf chose - "S" a struct (its fields by
// the descriptor's __fcopy codes), "A" + code an array of such elements, "?" a value
// of a type the front end did not know (a struct as "S", an array with its nested
// arrays), "" nothing (goIsStructVal says what a struct is). js_goptreq /
// js_goptrne: == on pointers, identity for two structs. Twins: goCopyCoded /
// goPtrEq in abnf/jsrtgolang.go, goCopyBy / goPtrEq in languages/go-interpreter.abnf.
function js_gocopy(v, code) { return goCopyCoded(v, goStrOf(code)) }
function goCopyCoded(v, code) {
    if (code == "") { return v }
    if (Array.isArray(v)) {
        if (code.charAt(0) != "A" && code != "?") { return v }
        var ec = "?"
        if (code.charAt(0) == "A") { ec = code.substring(1) }
        var out = []
        var i = 0
        while (i < v.length) {
            if (ec == "?" && !Array.isArray(v[i])) { out.push(v[i]) } else { out.push(goCopyCoded(v[i], ec)) }
            i = i + 1
        }
        return out
    }
    // A defined type's box (js_godtbox) never changes, so it needs no copy.
    if (!goIsStructVal(v) || (code != "S" && code != "?") || goIsDt(v)) { return v }
    var cls = goClassOf(v)
    var fs = cls.__fields
    var fc = cls.__fcopy
    var o = {}
    // THE HIDDEN SLOTS BY HAND: keysOf answers only the own keys whose names do
    // NOT start with "__" (manual 7.9), and a copy without its descriptor breaks
    // every method and builtin on it. __nil goes with it: the zero value of a
    // slice or map type is a MARKED empty container.
    o.__class = cls
    if (v.__nil === true) { o.__nil = true }
    var ks = keysOf(v)
    var j = 0
    while (j < ks.length) {
        var pv = anytype
        pv = v[ks[j]]
        if (Array.isArray(fs) && Array.isArray(fc)) {
            var f = 0
            while (f < fs.length) {
                if (fs[f] === ks[j]) {
                    if (f < fc.length && fc[f] != "") { pv = goCopyCoded(pv, goStrOf(fc[f])) }
                    f = fs.length
                }
                f = f + 1
            }
        }
        o[ks[j]] = pv
        j = j + 1
    }
    return o
}
function js_goptreq(a, b) { return goPtrEq(a, b) }
function js_goptrne(a, b) { return !goPtrEq(a, b) }
function goPtrEq(a, b) {
    if (goIsStructVal(a) && goIsStructVal(b)) { return a === b }
    return goValueEq(a, b)
}
// An instance of a declared struct, not of a "$..." runtime descriptor (a slice
// header, a pointer cell, a complex number).
function goIsStructVal(v) {
    var cls = goClassOf(v)
    if (cls === undefined) { return false }
    var nm = cls.__name
    return !(typeof nm == "string" && nm.length > 0 && nm.charAt(0) == "$")
}

// ===================================================== rendering ============
//
// fmt's %v. abnf/jsrtgolang.go's gopStr / gopRender / gopObj, function for
// function; the interpreter half is gstr in languages/go-interpreter.abnf and
// ./test.sh --cross diffs the two, so all three must stay in step.

function gopStr(v) { return gopRender(v, 0) }

// A depth at or above 64 means "this subtree came through an UNEXPORTED FIELD":
// fmt cannot call Error() or String() there, because reflect's CanInterface is
// false for it and transitively below it. It rides on the depth because the method
// arms are already gated on `depth < 32`, so only the recursion cap has to know.
function gopRender(v, depth) {
    var d = depth
    if (d >= 64) { d = d - 64 }
    if (d > 32) { return "..." }
    if (v === undefined || v === null) { return "<nil>" }
    if (typeof v == "string") { return v }
    if (v === true) { return "true" }
    if (v === false) { return "false" }
    if (typeof v == "number") {
        if (floIs(v)) { return goFloText(v) }
        if (sintIs(v)) { return sintStr(v) }
        return gopNumStr(v)
    }
    if (Array.isArray(v)) {
        // A Go ARRAY is a plain host array; a Go SLICE is the {a,o,n,c} header
        // handled in gopObj. Both print `[e e e]`, space separated.
        var out = "["
        var i = 0
        while (i < v.length) {
            if (i > 0) { out = out + " " }
            out = out + gopRender(v[i], depth + 1)
            i = i + 1
        }
        return out + "]"
    }
    // fmt prints a function or a channel as its address (gfAddrText).
    if (goIsFn(v) || goIsChan(v)) { return gfAddrText(v) }
    if (goIsObj(v)) {
        var r = gopObj(v, depth)
        if (r !== undefined) { return r }
    }
    return goStrOf(v)
}

// A plain number is an integer in the value model, so its text is the engine's
// own - which is the shortest round-tripping form and therefore the decimal
// digits for every value below 2^53. A FRACTIONAL plain number can only be an
// untyped constant that never met a float64 slot, and Go renders one with the
// same 'g' rule as a float64.
function gopNumStr(n) {
    if (n === Math.trunc(n)) {
        if (n === 0) { return "0" }
        return "" + n
    }
    return floStr(flo(n, 1))
}

// Go's visibility rule: an identifier is exported exactly when it starts with an
// upper-case letter. The twins are isExported in both grammars and goNameExported
// in abnf/jsrtgolang.go.
function goNameExported(name) {
    if (name.length == 0) { return false }
    var c0 = name.charCodeAt(0)
    return c0 >= 65 && c0 <= 90
}

// Does fmt call cls's method name on o? An fmt operand statically of a struct type is
// a copy marked __vv (goVvThunk in go-to-llvm-ir.abnf), whose method set lacks the
// pointer-receiver methods. Twins: goPrintMeth in abnf/jsrtgolang.go and
// go-interpreter.abnf.
function goPrintMeth(o, cls, name) {
    if (!goHas(cls, name) || !goIsFn(cls[name])) { return false }
    return !(goIsObj(o) && o.__vv === true && cls["__ptr$" + name] === true)
}

// gopObj renders the object shapes the Go grammars build. It answers undefined
// for a shape it does not know, which falls back to the generic ToString.
function gopObj(o, depth) {
    var cls = goClassOf(o)

    // THE error INTERFACE WINS OVER fmt.Stringer, which wins over every built-in
    // rendering - exactly the order fmt's handleMethods uses.
    if (cls !== undefined && depth < 32) {
        if (goPrintMeth(o, cls, "Error")) { return gopRender(cls.Error(o), depth + 1) }
        if (goPrintMeth(o, cls, "String")) { return gopRender(cls.String(o), depth + 1) }
    }

    // A map: map[k:v k:v], with the keys SORTED, which is what fmt has done
    // since go 1.12. The value model keeps insertion order, so the order is
    // computed here.
