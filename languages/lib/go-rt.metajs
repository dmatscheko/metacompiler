    if (op == "-") { return flo(rtF32Round(a - b), 4) }
    if (op == "*") { return flo(rtF32Round(a * b), 4) }
    if (op == "/") { return flo(rtF32Round(a / b), 4) }
    if (op == "%") { return flo(rtF32Round(a % b), 4) }
