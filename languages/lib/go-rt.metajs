// is "capacity" for a slice, "length" for an array or string. The twins are
// goSliceFail in abnf/jsrtgolang.go and goSliceCheck in
// languages/go-interpreter.abnf.
function goSliceCheck(lo, hi, mx, cp, three, word) {
    var p = "slice bounds out of range ["
    if (three) {
        if (mx < 0) { goBoundsPanic(p + "::" + mx + "]") }
        if (mx > cp) { goBoundsPanic(p + "::" + mx + "] with " + word + " " + cp) }
        if (hi < 0) { goBoundsPanic(p + ":" + hi + ":]") }
        if (hi > mx) { goBoundsPanic(p + ":" + hi + ":" + mx + "]") }
        if (lo < 0) { goBoundsPanic(p + lo + "::]") }
        if (lo > hi) { goBoundsPanic(p + lo + ":" + hi + ":]") }
        return undefined
    }
    if (hi < 0) { goBoundsPanic(p + ":" + hi + "]") }
    if (hi > cp) { goBoundsPanic(p + ":" + hi + "] with " + word + " " + cp) }
    if (lo < 0) { goBoundsPanic(p + lo + ":]") }
    if (lo > hi) { goBoundsPanic(p + lo + ":" + hi + "]") }
    return undefined
}
// Reading a member of nil, writing one and calling a method on one all raise
// this recoverable panic. The twins are goNilDeref in
// languages/go-interpreter.abnf and goNilDeref in abnf/jsrtgolang.go.
function goNilDeref() { goRTPanic("invalid memory address or nil pointer dereference") }

// Go indexing: maps read their ZERO VALUE for a missing key, slices their
// element, a string its i-th BYTE, and a generic instantiation f[int] is the
// identity (generics are ERASED in the Go grammars).
function js_map_get(c, k) {
    if (goIsDict(c)) {
        var i = goMapFind(c, k)
        if (i >= 0) { return c.vals[i] }
        return c.zero
    }
    if (Array.isArray(c)) {
        var ai = goIdx(k)
        if (ai < 0 || ai >= c.length) { goIdxPanic(ai, c.length) }
        return c[ai]
    }
    if (typeof c == "string") {
        var si = goIdx(k)
        var bs = goBytes(c)
        if (si < 0 || si >= bs.length) { goIdxPanic(si, bs.length) }
        return bs[si]
    }
    if (goIsFn(c)) { return c }
    fail("indexing a " + typeof c)
    return undefined
}

// The UTF-8 bytes of a string: s[i] is the i-th BYTE of a Go string, so the
// encoding has to be spelled out here (the runtime's strings are UTF-16).
function goBytes(s) {
    var out = []
    var r = goRunes(s)
    var i = 0
    while (i < r.cps.length) {
        var cp = r.cps[i]
        if (cp < 128) { out.push(cp) }
        else if (cp < 2048) {
            out.push(192 + Math.floor(cp / 64))
            out.push(128 + (cp % 64))
        } else if (cp < 65536) {
            out.push(224 + Math.floor(cp / 4096))
            out.push(128 + (Math.floor(cp / 64) % 64))
            out.push(128 + (cp % 64))
        } else {
            out.push(240 + Math.floor(cp / 262144))
            out.push(128 + (Math.floor(cp / 4096) % 64))
            out.push(128 + (Math.floor(cp / 64) % 64))
            out.push(128 + (cp % 64))
        }
        i = i + 1
    }
    return out
}

// delete(m, k); missing keys are a no-op.
function js_map_del(m, k) {
    if (!goIsDict(m)) { fail("delete() needs a map") }
    var i = goMapFind(m, k)
    if (i >= 0) {
        var nk = []
        var nv = []
        var j = 0
        while (j < m.keys.length) {
            if (j != i) { nk.push(m.keys[j]); nv.push(m.vals[j]) }
            j = j + 1
        }
        m.keys = nk
        m.vals = nv
    }
    return undefined
}

// ----- the Go builtins ------------------------------------------------------

// len() on a Go string counts BYTES - len("hello") is 6 and not 5 and not the
// UTF-16 count; on a slice or map it is the element / entry count. byteLen is
// the floor's own host builtin, which is exactly this measurement.
function js_golen(v) {
    if (typeof v == "string") { return byteLen(v) }
    if (Array.isArray(v)) { return v.length }
    if (v === undefined || v === null) { return 0 }   // a nil slice / map
    if (goIsDict(v)) { return v.keys.length }
    fail("len() of a " + typeof v)
    return 0
}

// `for i, ch := range s` walks a Go string by RUNE: i is the rune's BYTE offset
// and ch its code point (an int32), NOT a one-character substring. Normalizing
// the subject into a keys/vals dict lets js_gorplan read it like a map.
//
// Ranging a CHANNEL yields one received value per iteration and ends when the
// channel is closed and drained. Under the cooperative model every producer runs
// to completion inside the first receive, so the sequence is fully known here:
// drain it into the same keys/vals shape a map uses, with the received value as
// BOTH (the single range name is the value in Go).
function goRangeDict(v) {
    if (goIsChan(v)) {
        var ck = []
        var cv = []
        while (true) {
            var st = goChanRecv(v)
            if (!st.ok) { break }
            ck.push(st.v)
            cv.push(st.v)
        }
        return {__dict: true, keys: ck, vals: cv}
    }
    if (typeof v != "string") { return v }
    var r = goRunes(v)
    var keys = []
    var vals = []
    var i = 0
    while (i < r.cps.length) {
        keys.push(r.offs[i])
        vals.push(r.cps[i])
        i = i + 1
    }
    return {__dict: true, keys: keys, vals: vals}
}

// One arm of a type switch, and the ok of the comma-ok assertion: does v have
// dynamic type `want` (see goTypeIs)? The emitter's $acopy asks "slice" of the
// value of EVERY assignment, so that question is answered here without a call.
function js_gotypeis(v, want) {
    if (want == "slice") { return Array.isArray(v) }
    return goTypeIs(v, goStrOf(want)) == 1
}

// min()/max(), the Go 1.21 builtins, over the callee's whole argument array:
// strings by byte order, integers exactly (sintCmp), and floats by the spec's two
// extra rules - a NaN argument makes the result NaN, and -0.0 is less than 0.0.
// Twins: js_gominmax in abnf/jsrt.go, goMinMax in go-interpreter.abnf.
function js_gominmax(args, wantMax) {
    if (!Array.isArray(args) || args.length == 0) { fail("min()/max() needs an argument") }
    var best = args[0]
    var i = 1
    while (i < args.length) {
        var v = args[i]
        if (typeof best == "string" && typeof v == "string") {
            if (wantMax ? v > best : v < best) { best = v }
        } else if (sintIs(best) || sintIs(v)) {
            var c = sintCmp(v, best)
            if (wantMax ? c > 0 : c < 0) { best = v }
        } else {
            var a = goNum(best)
            var x = goNum(v)
            if (a === a) {
                if (x !== x || (wantMax ? x > a : x < a)) { best = v }
                else if (x == 0 && a == 0 && (wantMax ? 1 / x > 0 : 1 / x < 0)) { best = v }
            }
        }
        i = i + 1
    }
    return best
}

// clear(m) empties a map; clear(s) zeroes a slice's elements in place.
function js_goclear(args) {
    if (!Array.isArray(args) || args.length == 0) { fail("clear() needs an argument") }
    var x = args[0]
    if (goIsDict(x)) {
        x.keys = []
        x.vals = []
        return undefined
    }
    if (Array.isArray(x)) {
        var i = 0
        while (i < x.length) { x[i] = 0; i = i + 1 }
    }
    return undefined
}

// A Go named-type conversion T(v). One numeric type carries every integer width,
// so the sized forms truncate and mask; string(r) is the rune spelling and
// string([]byte{...}) joins the code points. This is the UNSIZED path - the sized
// one is the floor's js_giconv.
function js_goconv(to, v) {
    if (to == "string") {
        if (typeof v == "number") { return goRuneStr(goIdx(v)) }
        if (Array.isArray(v)) {
            var out = ""
            var i = 0
            while (i < v.length) { out = out + goRuneStr(goIdx(v[i])); i = i + 1 }
            return out
        }
        return goStrOf(v)
    }
    if (to == "[]byte" || to == "[]rune") {
        // Both spellings decode to CODE POINTS, exactly like the interpreter's
        // goConvert: the value model has one array type, so a later string(x)
        // cannot tell bytes from runes apart. Identical for ASCII, which is what
        // the byte form is used on.
        var r = goRunes(goStrOf(v))
        var arr = []
        var k = 0
        while (k < r.cps.length) { arr.push(r.cps[k]); k = k + 1 }
        return arr
    }
    if (to == "bool") { return goTruthy(v) }
    if (to == "float64") {
        // float64(x) BOXES: the result is a float64 whatever x was, which is what
        // makes float64(7)/2 == 3.5.
        return flo(goNum(v), 1)
    }
    // float32(x) boxes AT THE 32 BIT WIDTH and therefore ROUNDS.
    if (to == "float32") { return js_gflo32(v) }
    var n = Math.trunc(goNum(v))
    if (to == "byte" || to == "uint8") { return goMask(n, 256) }
    if (to == "uint16") { return goMask(n, 65536) }
    if (to == "uint32") { return goMask(n, 4294967296) }
    if (to == "int8") { return goSignedMask(n, 256) }
    if (to == "int16") { return goSignedMask(n, 65536) }
    if (to == "int32" || to == "rune") { return goSignedMask(n, 4294967296) }
    if (to.indexOf("int") == 0 || to.indexOf("uint") == 0) { return n }
    return v                    // a named struct / interface type: unchanged
}

// int64(n) & (m-1), for a power-of-two m. n is exact in a double here (the sized
// widths are all below 2^53 after the mask), so the remainder is exact too.
function goMask(n, m) {
    var r = n % m
    if (r < 0) { r = r + m }
    return r
}

function goSignedMask(n, m) {
    var r = goMask(n, m)
    if (r >= m / 2) { r = r - m }
    return r
}

// rt.truthy, for the bool(x) conversion only.
function goTruthy(v) {
    if (v === undefined || v === null) { return false }
    if (v === true) { return true }
    if (v === false) { return false }
    if (typeof v == "number") {
        var n = goNum(v)
        if (n !== n) { return false }
        return n != 0
    }
    if (typeof v == "string") { return v.length > 0 }
    return true
}

// Go's == and != (see goValueEq: value equality for structs and arrays).
function js_goeq(a, b) { return goValueEq(a, b) }
function js_gone(a, b) { return !goValueEq(a, b) }
// == on two INTERFACE values: the dynamic types must match as well, and a plain
// number, a float64, a float32 and each sized integer type are different ones.
// Twins: js_goifeq in abnf/jsrtgolang.go, goIfEq in go-interpreter.abnf.
function goDynKind(v) {
    if (typeof v != "number") { return 0 - 1 }
    if (floIs(v)) { return floStyle(v) }
    if (sintIs(v)) { return 16 + sintWidth(v) * 2 + (sintUns(v) ? 1 : 0) }
    return 0
}
function goIfEq(a, b) { return goDynKind(a) == goDynKind(b) && goValueEq(a, b) }
function js_goifeq(a, b) { return goIfEq(a, b) }
function js_goifne(a, b) { return !goIfEq(a, b) }

// ----- struct fields and methods --------------------------------------------

// A Go field read: the struct's own fields, then the PROMOTED fields of an
// embedded struct, then a method VALUE, then a method EXPRESSION off the
// descriptor itself, then the ordinary member lookup.
function js_gofield(o, kv) {
    if (o === undefined || o === null) { goNilDeref() }   // see goNilDeref
    var key = goStrOf(kv)
    if (goIsObj(o)) {
        // AN IMPORTED PACKAGE OBJECT IS LIVE. buildPackages
        // (languages/go-to-llvm-ir.abnf) hangs the package's own runtime SCOPE off the
        // object as __pkgscope beside the snapshot of its exported names; reading the
        // slot out of the scope is what makes `pkga.Counter` see a write the package
        // made afterwards, and the snapshot below stays as the fallback. Read as a bare
        // slot rather than through goPkgScope: this is on every field access in the
        // language, and every receiver that is not a package object pays exactly one
        // property read for it. The twin is goPkgSlot in abnf/jsrtgolang.go.
        var ps = o.__pkgscope
        if (ps !== undefined && scopeHas(ps, key)) { return scopeGet(ps, key) }
        if (goHas(o, key)) { return o[key] }
        var pf = goPromField(o, key, 16)
        if (pf !== undefined) { return pf.v }
        // A METHOD VALUE: the receiver is bound now (and a value receiver is
        // COPIED now), so later writes to the variable do not reach it.
        var mv = goMethod(o, key)
        if (mv !== undefined) { return goBind(mv.fn, mv.recv) }
        // A METHOD EXPRESSION: T.m off the descriptor itself. The compiled method
        // already takes its receiver as the first argument, so the raw function
        // IS the method expression.
        if (o.__isclass === true && goHas(o, key)) { return o[key] }
    }
    return goGetMember(o, key)
}

// The field `name` PROMOTED from an embedded struct of o, searched BREADTH FIRST,
// which is Go's own rule: the shallowest depth wins. The depth cap matches the
// __class walks (manual 7.9): a pointer cycle here would otherwise not terminate.
// Answers undefined when nothing is found.
function goPromField(o, key, maxd) {
    // LEVEL ONE WITHOUT ALLOCATING: js_gofield reaches here on every miss of an own
    // property (a method value, a builtin), so the common answer must cost no array
    // and no frontier. The breadth-first walk below only starts when there IS an
    // embedded struct and the first level did not have the name.
    var cls1 = goClassOf(o)
    if (cls1 === undefined) { return undefined }
    var fs1 = cls1.__fields
    if (!Array.isArray(fs1)) { return undefined }
    var hasEmb = false
    var i1 = 0
    while (i1 < fs1.length) {
        var in1 = o[goStrOf(fs1[i1])]
        i1 = i1 + 1
        if (!goIsObj(in1)) { continue }
        if (in1.__class === undefined) { continue }
        if (goHas(in1, key)) { return {v: in1[key]} }
        hasEmb = true
    }
    if (!hasEmb) { return undefined }
    return goPromDeep(o, key, maxd)
}

// The breadth-first part of goPromField, from level two down. Split out so the
// common case above allocates nothing.
function goPromDeep(o, key, maxd) {
    var level = [o]
    var d = 0
    while (d < maxd && level.length > 0) {
        var next = []
        var i = 0
        while (i < level.length) {
            var cur = level[i]
            i = i + 1
            var cls = goClassOf(cur)
            if (cls === undefined) { continue }
            var fs = cls.__fields
            if (!Array.isArray(fs)) { continue }
            var k = 0
            while (k < fs.length) {
                var inner = cur[goStrOf(fs[k])]
                k = k + 1
                if (!goIsObj(inner)) { continue }
                if (inner.__class === undefined) { continue }
                if (goHas(inner, key)) { return {v: inner[key]} }
                next.push(inner)
            }
        }
        level = next
        d = d + 1
    }
    return undefined
}

// rt.goMethod: the method named `name` on v's descriptor, with Go's receiver
// semantics (a value receiver gets a COPY), or undefined. Promotion: a method of
// an embedded struct is a method of the outer one.
function goMethod(v, name) {
    var cls = goClassOf(v)
    if (cls === undefined) { return undefined }
    var fn = cls[name]
    if (goIsFn(fn)) {
        var recv = v
        if (cls["__ptr$" + name] !== true) { recv = goCopyCoded(v, "S") }
        return {fn: fn, recv: recv}
    }
    var fs = cls.__fields
    if (Array.isArray(fs)) {
        var i = 0
        while (i < fs.length) {
            var inner = v[goStrOf(fs[i])]
            if (goClassOf(inner) !== undefined) {
                var got = goMethod(inner, name)
                if (got !== undefined) { return got }
            }
            i = i + 1
        }
    }
    return undefined
}

// A bound method: a closure that prepends the receiver, which is what the Go
// twin's jsHostFunc wrapper is.
function goBind(fn, recv) {
    return function() { return fn.apply(undefined, goPrepend(recv, arguments)) }
}

function goPrepend(v, args) {
    var out = [v]
    var i = 0
    while (i < args.length) { out.push(args[i]); i = i + 1 }
    return out
}

// A Go method call: the struct's own methods and the promoted methods of an
// embedded struct, with Go's receiver semantics. Anything else - a string or
// slice builtin - falls through to the ordinary member call.
function js_gomcall(recv, namev, args) {
    if (!Array.isArray(args)) { fail("js_gomcall args must be an array") }
    if (recv === undefined || recv === null) { goNilDeref() }   // see goNilDeref
    var name = goStrOf(namev)
    var mv = goMethod(recv, name)
    if (mv !== undefined) { return mv.fn.apply(undefined, goPrepend(mv.recv, args)) }
    // Only after a real method has missed: a package function reaches its receiver's
    // scope, so `pkg.F()` calls the binding rather than the snapshot. See js_gofield.
    var pf = goPkgScope(recv)
    if (pf !== undefined && scopeHas(pf, name)) {
        var pfn = scopeGet(pf, name)
        if (goIsFn(pfn)) { return pfn.apply(undefined, args) }
    }
    return goMemberCall(recv, name, args)
}

// A method of a DEFINED type (go-constfold.js, goDtPlan): fn called with the
// receiver first. dyn = the receiver's static type is unknown, so a struct's own
// method of that name wins, and with no fn the call is an ordinary one. Twins:
// goDtCall in go-interpreter.abnf, js_godtcall in abnf/jsrtgolang.go.
// The method value recv.M of a defined type, its receiver already evaluated. Twins:
// js_godtbind in abnf/jsrtgolang.go, goDtBind in go-interpreter.abnf.
function js_godtbind(recv, fn) { return goBind(fn, recv) }

function js_godtcall(recv, namev, args, fn, dyn) {
    if (!Array.isArray(args)) { fail("js_godtcall args must be an array") }
    if (dyn === true) {
        var mv = goMethod(recv, goStrOf(namev))
        if (mv !== undefined) { return mv.fn.apply(undefined, goPrepend(mv.recv, args)) }
        if (!goIsFn(fn)) { return js_gomcall(recv, namev, args) }
    }
    return fn.apply(undefined, goPrepend(recv, args))
}

// rt.getMember, over what a Go program can reach through it: a package object's
// exported function, a struct field the field walk above did not find, and the
// two lengths. Everything Go spells as a method on a builtin type is a package
// FUNCTION (strings.ToUpper, not "abc".ToUpper), so this surface is small.
function goGetMember(o, key) {
    if (o === undefined || o === null) { goNilDeref() }
    if (typeof o == "string") {
        if (key == "length") { return o.length }
        return undefined
    }
    if (Array.isArray(o)) {
        if (key == "length") { return o.length }
        return undefined
    }
    if (goIsObj(o)) { return o[key] }
    return undefined
}

// rt.memberCall's residue: a callable member, called with the receiver already
// resolved (goMethod handled every case that prepends one).
function goMemberCall(recv, name, args) {
    var f = goGetMember(recv, name)
    if (goIsFn(f)) { return f.apply(undefined, args) }
    goMcallMiss(recv, name)
    return undefined
}

// A method call nothing claimed. THE WORDING IS abnf/jsrt.go's rt.memberCall,
// shape for shape, because llvm.Run's js_gomcall falls back to that shared
// member-call when rt.goMethod misses, and the two compiled halves must print the
// same text:
//
//   s.Nope()   unknown String method: Nope
//   o.Nope()   unknown method 'Nope' on an instance
//
// Go's own toolchain rejects both programs at COMPILE time, so neither wording is
// Go's; agreeing is what is available.
function goMcallMiss(recv, name) {
    if (typeof recv == "string") { fail("unknown String method: " + name); return }
    if (Array.isArray(recv)) { fail("unknown list method '" + name + "'"); return }
    if (goIsDict(recv)) { fail("unknown dict method '" + name + "'"); return }
    if (goIsObj(recv)) {
        if (recv["__class"] !== undefined) { fail("unknown method '" + name + "' on an instance"); return }
        fail("unknown method '" + name + "'")
        return
    }
    fail("method call '" + name + "' on a " + typeof recv)
}

// ----- panic / defer / recover ----------------------------------------------
//
// A compiled Go function runs its BODY in a closure that js_gotry calls, so a
// panic unwinding through the frame is caught HERE: the frame's deferred
// functions still run afterwards, and a recover() in one of them takes the panic
// value and stops the unwinding. js_gorepanic (emitted after the defers)
// re-raises whatever was not recovered.
//
// goPanics is the Go twin's []interface{} with nil for "no panic here"; MetaJS
// has no nil that a Go value cannot also be (a panic(nil) is legal), so the
// "was there one" bit is a parallel array rather than a sentinel.

var goPanics = []
var goPanicSet = []
var goDeferAt = []

// Whether a frame's panic value was computed at the panic ($panicf, see PanicCall
// in the grammars), which goPanicReport needs. The thrown value cannot carry it,
// so js_gopanic and js_gorepanic note it beside the value they throw (goRaised*)
// and the catching frame takes it over when it catches that very value.
var goPanicFresh = []
var goRaisedOn = false
var goRaisedV = anytype
var goRaisedFresh = false

function goCaughtFresh(e) {
    var f = goRaisedOn && goRaisedFresh && goRaisedV === e
    goRaisedOn = false
    return f
}

// Go keeps every panic that has started and not finished on a chain, and reports
// an unrecovered one with all of them. goActiveAt / goActiveV are the panics whose
// frames are running their deferred calls (js_gorundefers), oldest first: the
// frame's goPanics index (-1 once a newer panic of the same frame aborted it, its
// recovered bit then kept in goActiveRec), the value and its fresh bit. A panic's
// own chain ([{v, rec, fresh}], rec when recovered by then) is the active list it was raised under, taken when it first
// reaches a frame's defers or js_gotop - nothing between its raise and there
// changes the list. goPanicChain / goPanicChainSet keep it per goPanics entry, and
// between frames it travels in goFly while goFlyOn and goFlyExc is the value
// thrown. Twins: goActive in languages/go-interpreter.abnf and goChains in
// abnf/jsrtgolang.go.
var goActiveAt = []
var goActiveV = []
var goActiveRec = []
var goActiveFresh = []
var goPanicChain = []
var goPanicChainSet = []
var goFly = []
var goFlyExc = anytype
var goFlyOn = false

function goChainNow() {
    var out = []
    var i = 0
    while (i < goActiveAt.length) {
        var at = goActiveAt[i]
        if (at < 0) { out.push({v: goActiveV[i], rec: goActiveRec[i], fresh: goActiveFresh[i]}) }
        else { out.push({v: goActiveV[i], rec: at >= goPanics.length || !goPanicSet[at], fresh: goActiveFresh[i]}) }
        i = i + 1
    }
    return out
}

function js_gotry(fn) {
    goPanics.push(undefined)
    goPanicSet.push(false)
    goPanicFresh.push(false)
    goPanicChain.push([])
    goPanicChainSet.push(false)
    var res = anytype
    res = undefined
    try {
        res = fn()
    } catch (e) {
        goPanics[goPanics.length - 1] = e
        goPanicSet[goPanicSet.length - 1] = true
        goPanicFresh[goPanicFresh.length - 1] = goCaughtFresh(e)
        if (goFlyOn && goFlyExc === e) {
            goPanicChain[goPanicChain.length - 1] = goFly
            goPanicChainSet[goPanicChainSet.length - 1] = true
        }
        goFlyOn = false
        res = undefined
    }
    return res
}

// THE OUTERMOST js_gotry FRAME, popped by jsmain after the entry function returns.
// An unrecovered panic is reported HERE rather than being let out of the module,
// so the floor's uncaught-throw handler never adds its own prefix. Go writes, on
// stderr with exit status 2:
//
//     panic: abort probe
//     panic: 42
//     panic: runtime error: index out of range [5] with length 0
//     panic: assignment to entry in nil map
//
// followed by a blank line and a "goroutine 1 [running]:" stack trace. "panic: "
// prefixes BOTH kinds - a value the program panicked with and a runtime one.
//
// NOT reproduced: the goroutine trace (no engine here has a call-site line
// table, the same wall as dart's `catch (e, s)`, manual 7.9).
//
// Twins: runEntry in languages/go-interpreter.abnf and js_gotop in
// abnf/jsrtgolang.go - same wording, same stream (stderr, where go puts it), same
// exit status.
function js_gotop() {
    var n = goPanics.length - 1
    if (n < 0) { return undefined }
    var p = goPanics[n]
    var had = goPanicSet[n]
    var ch = goPanicChain[n]
    if (!goPanicChainSet[n]) { ch = goChainNow() }
    var fresh = goPanicFresh[n]
    goPanics.pop()
    goPanicSet.pop()
    goPanicFresh.pop()
    goPanicChain.pop()
    goPanicChainSet.pop()
    if (!had) { return undefined }
    goPanicReport(ch, p, fresh)
    exit(2)
    return undefined
}

// An unrecovered panic as Go reports it, one line each: its chain comes first,
// oldest first, each later one indented by a tab and a recovered one marked
// " [recovered]". A panic raised again with the very value it aborted is printed
// once, marked " [recovered, repanicked]" (go 1.23+); an equal value counts as the
// same one unless the later panic computed it (fresh). Twins: goPanicReport in
// languages/go-interpreter.abnf and abnf/jsrtgolang.go.
function goPanicReport(ch, p, pfresh) {
    var vs = []
    var recs = []
    var same = [false]
    var i = 0
    while (i < ch.length) {
        vs.push(ch[i].v)
        recs.push(ch[i].rec)
        if (i > 0) { same.push(!ch[i].fresh && ch[i].v === ch[i - 1].v) }
        i = i + 1
    }
    if (ch.length > 0) { same.push(!pfresh && p === ch[ch.length - 1].v) }
    vs.push(p)
    recs.push(false)
    var k = 0
    while (k < vs.length) {
        if (!same[k]) {
            var ln = "panic: " + goPanicText(vs[k])
            if (k > 0) { ln = "\t" + ln }
            if (recs[k] && k + 1 < vs.length && same[k + 1]) { ln = ln + " [recovered, repanicked]" }
            else if (recs[k]) { ln = ln + " [recovered]" }
            eprintln(ln)
        }
        k = k + 1
    }
}

function js_gorepanic() {
    var n = goPanics.length - 1
    var p = goPanics[n]
    var had = goPanicSet[n]
    var ch = goPanicChain[n]
    var chSet = goPanicChainSet[n]
    var fresh = goPanicFresh[n]
    goPanics.pop()
    goPanicSet.pop()
    goPanicFresh.pop()
    goPanicChain.pop()
    goPanicChainSet.pop()
    if (had) {
        goFly = ch
        goFlyExc = p
        goFlyOn = chSet
        goRaisedOn = true
        goRaisedV = p
        goRaisedFresh = fresh
        throw p
    }
    return undefined
}

// ----- interface satisfaction -------------------------------------------------
//
// A DECLARED INTERFACE IS MATCHED STRUCTURALLY: a value satisfies it exactly when
// it has every method (js_gotypeis can only compare type NAMES). The method set
// arrives as a comma-joined string the emitter built at parse time from the
// interface declaration (ifaceMethodCsv in languages/go-to-llvm-ir.abnf); an
// interface whose body is not a plain method list contributes NO names, which
// reads as "satisfied by anything". The twins are typeMatches / goSatisfies in
// languages/go-interpreter.abnf.

// A method of v's own descriptor, or one PROMOTED from an embedded struct.
function goHasMethod(v, name) {
    var cls = goClassOf(v)
    if (cls === undefined) { return false }
    if (goIsFn(cls[name])) { return true }
    var fs = cls.__fields
    if (!Array.isArray(fs)) { return false }
    var i = 0
    while (i < fs.length) {
        var inner = v[goStrOf(fs[i])]
        if (goClassOf(inner) !== undefined) {
            if (goHasMethod(inner, name)) { return true }
        }
        i = i + 1
    }
    return false
}

// The comma-joined method set, split without String.split (not in this dialect).
function goCsvSplit(s) {
    var out = []
    var cur = ""
    var i = 0
    while (i < s.length) {
        var ch = s.charAt(i)
        if (ch == ",") { out.push(cur); cur = "" } else { cur = cur + ch }
        i = i + 1
    }
    if (cur.length > 0) { out.push(cur) }
    return out
}

// "" when v has every method, otherwise the FIRST one missing - which is what Go's
// `missing method X` panic text names. A value that is not a struct INSTANCE
// answers "": a method on a defined non-struct type is not reachable from the
// value in this model, so refusing there would panic programs go accepts.
function goMissingMethod(v, csv) {
    if (goClassOf(v) === undefined) { return "" }
    var ms = goCsvSplit(goStrOf(csv))
    var i = 0
    while (i < ms.length) {
        if (!goHasMethod(v, ms[i])) { return ms[i] }
        i = i + 1
    }
    return ""
}

// One arm of a type switch or the ok of `v, ok := x.(I)`: does v satisfy I?
function js_goifis(v, csv) {
    if (goClassOf(v) === undefined) { return false }
    return goMissingMethod(v, csv) == ""
}

// The single-result `x.(I)`: the value, or a panic naming the first missing method.
// Go's own text is `interface conversion: main.Dog is not main.Sp: missing method
// Fly`.
function js_goifas(v, namev, csv) {
    // A NIL INTERFACE ASSERTED TO ANYTHING PANICS, and with a DIFFERENT text: go says
    // `interface conversion: interface is nil, not main.I`, naming no method because
    // there is no dynamic type. It is tested first because goMissingMethod answers ""
    // for a non-instance.
    if (v === undefined || v === null) {
        goConvPanic("interface is nil, not " + gfQualTy(goStrOf(namev)))
    }
    var miss = goMissingMethod(v, csv)
    if (miss == "") { return v }
    goConvPanic(goTypeText(v) + " is not " + gfQualTy(goStrOf(namev)) + ": missing method " + miss)
    return v
}

// The dynamic type name of a value, in the spelling a case label uses: what
// js_gotypeis compares and what the interface-conversion panic names. A float box
// knows its width and a sized-integer box its width and sign; a 64-bit integer
// does not (int and int64 are one plain number, uint and uint64 one box), so it
// answers int / uint. Twin of goTypeNameOf in abnf/jsrtgolang.go and goTypeName in
// languages/go-interpreter.abnf.
function goTypeNameOf(v) {
    if (v === undefined || v === null) { return "nil" }
    if (v === true || v === false) { return "bool" }
    if (typeof v == "string") { return "string" }
    var cls = goClassOf(v)
    if (cls !== undefined) {
        var nm = goStrOf(cls.__name)
        if (nm == "$cx") { return "complex128" }
        return nm
    }
    if (Array.isArray(v)) { return "slice" }
    if (goIsDict(v)) { return "map" }
    if (typeof v == "number") {
        if (floIs(v)) {
            if (goIsF32(v)) { return "float32" }
            return "float64"
        }
        if (sintIs(v)) {
            var base = "int"
            if (sintUns(v)) { base = "uint" }
            var w = sintWidth(v)
            if (w == 64) { return base }
            return base + w
        }
        if (v === Math.trunc(v)) { return "int" }
        return "float64"
    }
    return "any"
}

// The dynamic type a TypeAssertionError names: fmt's %T, except that nil is
// "nil". Twin of goTypeText in abnf/jsrtgolang.go and languages/go-interpreter.abnf.
function goTypeText(v) {
    if (v === undefined || v === null) { return "nil" }
    var t = gfTypeName(v)
    if (t != "") { return t }
    return goTypeNameOf(v)
}

// Does v's dynamic type equal `want`? 1 yes, 0 no, and 2 when the value model
// cannot tell: an int64, and a rune from a literal or a range over a string, are
// the same plain number as an int; a uint64 is the same box as a uint. A type
// switch and the comma-ok form take only a 1; x.(T) panics only on a 0. Twin of
// goTypeIs in abnf/jsrtgolang.go and languages/go-interpreter.abnf.
function goTypeIs(v, want) {
    if (want == "any" || want == "interface{}") {
        if (v === undefined || v === null) { return 0 }
        return 1
    }
    var w = want
    if (w == "byte") { w = "uint8" }
    if (w == "rune") { w = "int32" }
    var got = goTypeNameOf(v)
    if (got == w) { return 1 }
    if (w.charAt(0) == "[" || w.substring(0, 4) == "map[") {
        if (gfTypeName(v) == gfQualTy(w)) { return 1 }
        return 0
    }
    if (got == "int" && (w == "int64" || w == "int32")) { return 2 }
    if (got == "uint" && (w == "uint64" || w == "uintptr")) { return 2 }
    return 0
}

// The single-result x.(T) for a T the emitter can decide (assertTyWant in
// languages/go-to-llvm-ir.abnf): the value, or go's TypeAssertionError panic. The
// static type of x is not known, and interface{} is what it nearly always is, so
// the text names it. Twin of js_goassert in abnf/jsrtgolang.go.
function js_goassert(v, want, disp) {
    if (goTypeIs(v, goStrOf(want)) == 0) {
        goConvPanic("interface {} is " + goTypeText(v) + ", not " + gfQualTy(goStrOf(disp)))
    }
    return goDtUnbox(v, goStrOf(want))
}

// ----- a value of a defined non-struct type in an interface ------------------
//
// js_godtbox(v, cls): v in the box of a defined non-struct type, whose descriptor
// the emitter declared ($dt$T). A box stays itself, and so does a struct instance
// unless a pointer's static type boxes it (a value of `type Q Point` is a Point).
// js_godtas(v, want, disp): x.(T) for such a T - the value inside its box, the
// conversion panic for another box, the identity for a value that is not one (its
// type is not known). Twins: js_godtbox / js_godtas in abnf/jsrtgolang.go, goDtBox
// / goAssertType in languages/go-interpreter.abnf.
function goIsDt(v) {
    var cls = goClassOf(v)
    if (cls === undefined) { return false }
    return cls.__dt === true
}
// The value box v shows fmt: an array type's box shows its elements boxed as
// their element type prints them. Twins: goDtShown in abnf/jsrtgolang.go and
// languages/go-interpreter.abnf.
function goDtShown(v) {
    var dv = anytype
    dv = v.__dv
    var name = goStrOf(goClassOf(v).__name)
    if (!Array.isArray(dv) || name.charAt(0) != "[") { return dv }
    var cls = goSlotCls(name.substring(name.indexOf("]") + 1))
    if (cls === undefined) { return dv }
    var out = []
    var i = 0
    while (i < dv.length) {
        out.push(js_godtbox(dv[i], cls))
        i = i + 1
    }
    return out
}
function goDtUnbox(v, want) {
    if (goIsDt(v) && goStrOf(goClassOf(v).__name) == want) { return v.__dv }
    return v
}
function js_godtbox(v, cls) {
    if (goIsDt(v)) { return v }
    if (goIsStructVal(v) && goStrOf(cls.__name).charAt(0) != "*") { return v }
    var o = {}
    o.__class = cls
    o.__dv = v
    return o
}
// js_godtreg(cls): cls is the box descriptor of a defined type fmt prints through
// Error() or String() inside a composite. goSlotBox is such an element as fmt
// reaches it: boxed when its slot's type ty is registered (goSlotCls answers the
// descriptor, or undefined). Twins: js_godtreg / goSlotBox in abnf/jsrtgolang.go,
// goSlotBox in languages/go-interpreter.abnf.
var GO_DTREG = {}
function js_godtreg(cls) {
    GO_DTREG["$" + goStrOf(cls.__name)] = cls
    return undefined
}
function goSlotCls(ty) {
    var r = anytype
    r = undefined
    if (typeof ty != "string" || ty == "") { return r }
    if (goHas(GO_DTREG, "$" + ty)) { return GO_DTREG["$" + ty] }
    // An array of a registered type prints its elements through that type's
    // method, so its own box descriptor is made on first use.
    var et = goArrElemTy(ty)
    if (et == "" || goSlotCls(et) === undefined) { return r }
    var cls = {}
    cls.__isclass = true
    cls.__dt = true
    cls.__name = ty
    cls.__fields = ["__dv"]
    GO_DTREG["$" + ty] = cls
    return cls
}
// "T" for an array type "[N]T" of literal length N, else "". Twin of
// goArrElemTy in languages/lib/go-constfold.js and abnf/jsrtgolang.go.
function goArrElemTy(t) {
    if (t.length < 4 || t.charAt(0) != "[") { return "" }
    var i = 1
    while (i < t.length && t.charCodeAt(i) >= 48 && t.charCodeAt(i) <= 57) { i = i + 1 }
    if (i == 1 || i >= t.length - 1 || t.charAt(i) != "]") { return "" }
    return t.substring(i + 1)
}
function goSlotBox(v, ty) {
    var cls = goSlotCls(ty)
    if (cls === undefined) { return v }
    return js_godtbox(v, cls)
}
// A map's key and value types, "" when it records none.
function goMapTys(m) {
    if (typeof m.mty != "string") { return ["", ""] }
    var kt = gfMapKeyTy(m.mty)
    return [kt, m.mty.substring(kt.length + 5)]
}
// A struct's declared type of field i, "" when unrecorded.
function goFieldTyAt(cls, i) {
    if (!goHas(cls, "__ftypes") || !Array.isArray(cls.__ftypes) || i >= cls.__ftypes.length) { return "" }
    return goStrOf(cls.__ftypes[i])
}
function js_godtas(v, want, disp) {
    if (!goIsDt(v)) { return v }
    var w = goStrOf(want)
    if (goStrOf(goClassOf(v).__name) != w) {
        goConvPanic("interface {} is " + goTypeText(v) + ", not " + gfQualTy(goStrOf(disp)))
    }
    return v.__dv
}
// A panic value as the runtime prints it: an error's Error() or a Stringer's
// String(), and the value of a defined type as main.T(v), a string kind quoted.
// Twins: goPanicText in abnf/jsrtgolang.go and languages/go-interpreter.abnf.
function goPanicText(v) {
    if (goIsDt(v) && goHas(goClassOf(v), "__pkg") && goMeth(v, "Error") === undefined && goMeth(v, "String") === undefined) {
        var dv = anytype
        dv = v.__dv
        if (typeof dv == "string") { return gfTypeName(v) + "(\"" + dv + "\")" }
        return gfTypeName(v) + "(" + gopStr(dv) + ")"
    }
    return gopStr(v)
}

// ----- multi-value results ---------------------------------------------------
//
// A MULTI-VALUE RESULT IS MARKED with a __gomv slot, because Go EXPANDS a
// multi-value call that is the sole argument of a call - `fmt.Println(f())`
// prints `3 3 3`, not `[3 3 3]` - and an unmarked array could not be told from a
// Go ARRAY value ([3]int is a plain array in this value model, by design). A
// tag-6 object CAN be marked where an array cannot: runtime.c's set_member
// refuses a named key on tag 5. The emitter gates every call to these on
// usesMultiRet, so a program with no 2-result function never reaches them. The
// twins are goMvArr / goMvArgs in languages/go-interpreter.abnf.

// The plain array behind a marked result; the identity on everything else,
// including the plain arrays the comma-ok forms hand to an unpacking assignment.
function js_gomv(v) {
    if (v === undefined || v === null) { return v }
    if (typeof v != "object") { return v }
    if (Array.isArray(v)) { return v }
    var a = v.__gomv
    if (Array.isArray(a)) { return a }
    return v
}

// The argument array of a call whose ONLY argument is a multi-value call: its
// results become the arguments. Any other shape passes through untouched.
function js_gomvargs(args) {
    if (!Array.isArray(args) || args.length != 1) { return args }
    var only = args[0]
    if (only === undefined || only === null || typeof only != "object") { return args }
    if (Array.isArray(only)) { return args }
    var a = only.__gomv
    if (Array.isArray(a)) { return a }
    return args
}

// panic(v): the argument array is the callee's; fresh is 1 for $panicf.
function js_gopanic(args, fresh) {
    var v = anytype
    v = undefined
    if (Array.isArray(args) && args.length > 0) { v = args[0] }
    if (v === undefined || v === null) { v = goPanicNil() }
    goFlyOn = false
    goRaisedOn = true
    goRaisedV = v
    goRaisedFresh = fresh == 1
    throw v
}

// fmt.Errorf and the errors package: mode 0 errors.New, 1 fmt.Errorf, 2 errors.Is,
// 3 errors.Unwrap, 4 errors.As, 5 errors.Join (declared in buildMain, languages/go-to-llvm-ir.abnf). The twin is
// js_goerrors in abnf/jsrtgolang.go.
function js_goerrors(args, mode) {
    var m = goIdx(mode)
    if (m == 0) { return goErrNew("*errors.errorString", {msg: gopStr(args[0])}) }
    if (m == 1) {
        var rest = args.slice(1)
        var wrap = {on: true, idx: []}
        var msg = gfFormat(gopStr(args[0]), rest, wrap)
        return goErrorf(msg, rest, wrap.idx)
    }
    if (m == 2) { return goErrIs(args[0], args[1]) }
    if (m == 4) { return goErrAs(args[0], args[1]) }
    if (m == 5) {
        var js = []
        var ji = 0
        while (ji < args.length) {
            if (args[ji] !== undefined && args[ji] !== null) { js.push(args[ji]) }
            ji = ji + 1
        }
        return goErrJoin(js)
    }
    var u = anytype
    u = goErrUnwrap(args[0])
    if (Array.isArray(u)) { return null }
    var c = goClassOf(u)
    if (c !== undefined && goStrOf(c.__name) == "$sl") { return null }
    return u
}

// recover(): the pending panic of the frame whose defers are running, or nil.
// Only a function DEFERRED by that frame may recover its panic: it is one frame
// deeper (or, for a native callee, none) - which is what the `> at + 2` test says.
function js_gorecover() {
    if (goDeferAt.length == 0) { return null }
    var at = goDeferAt[goDeferAt.length - 1]
    if (at < 0 || at >= goPanics.length || goPanics.length > at + 2) { return null }
    if (!goPanicSet[at]) { return null }
    var p = goPanics[at]
    goPanics[at] = undefined
    goPanicSet[at] = false
    return p
}

// Runs collected [f, args] pairs LIFO (Go defer). goDeferAt records WHICH frame
// these defers belong to, for a recover() inside one of them. While they run for
// the frame's panic, that panic is ACTIVE (goActiveAt). A deferred call that
// panics does not stop the others: its panic becomes the frame's (js_gorepanic
// raises it) and the remaining calls run for it, while the panic it aborted stays
// on the chain with its recovered bit frozen (goActiveAt -1, goActiveRec). Twins:
// goFrameDefers in languages/go-interpreter.abnf, js_gorundefers in
// abnf/jsrtgolang.go.
function js_gorundefers(list) {
    if (!Array.isArray(list)) { fail("js_gorundefers needs the defer list") }
    var at = goPanics.length - 1
    goDeferAt.push(at)
    var base = goActiveAt.length
    if (at >= 0 && goPanicSet[at]) {
        if (!goPanicChainSet[at]) {
            goPanicChain[at] = goChainNow()
            goPanicChainSet[at] = true
        }
        goActiveAt.push(at)
        goActiveV.push(goPanics[at])
        goActiveRec.push(false)
        goActiveFresh.push(goPanicFresh[at])
    }
    var i = list.length - 1
    while (i >= 0) {
        var pair = list[i]
        if (!Array.isArray(pair) || pair.length != 2) { fail("broken defer entry") }
        var f = pair[0]
        var as = pair[1]
        if (!Array.isArray(as)) { as = [] }
        try {
            f.apply(undefined, as)
        } catch (e) {
            if (at < 0) {
                goDeferAt.pop()
                throw e
            }
            var ch = goFly
            if (!(goFlyOn && goFlyExc === e)) { ch = goChainNow() }
            goFlyOn = false
            var fresh = goCaughtFresh(e)
            var top = goActiveAt.length - 1
            if (top >= base) {
                goActiveRec[top] = !goPanicSet[at]
                goActiveAt[top] = -1
            }
            goPanics[at] = e
            goPanicSet[at] = true
            goPanicFresh[at] = fresh
            goPanicChain[at] = ch
            goPanicChainSet[at] = true
            goActiveAt.push(at)
            goActiveV.push(e)
            goActiveRec.push(false)
            goActiveFresh.push(fresh)
        }
        i = i - 1
    }
    goDeferAt.pop()
    while (goActiveAt.length > base) {
        goActiveAt.pop()
        goActiveV.pop()
        goActiveRec.pop()
        goActiveFresh.pop()
    }
    return undefined
}

// ----- goroutines and channels ----------------------------------------------
//
// The floor's coroutine primitive (tags 15/16, a real second stack) is NOT needed.
// Concurrency in both halves is COOPERATIVE and DETERMINISTIC: `go f(...)` puts
// an already-bound nullary closure on goQueue and returns, and a receive that
// finds its channel empty RUNS THE QUEUE - each queued goroutine to completion,
// in spawn order - until one of them fills the channel. Nothing ever suspends
// mid-body, so there is no stack to keep. The buffer size of `make(chan T, n)`
// is not modeled (a send never blocks), the ELEMENT TYPE is, so a receive from a
// closed channel yields its zero value.

var goQueue = []

function goIsChan(v) {
    if (!goIsObj(v)) { return false }
    if (v.__chan !== true) { return false }
    return Array.isArray(v.buf)
}

// goDrain runs every queued goroutine to completion, in spawn order. The guard
// is the Go twin's, and it is what turns a producer that never ends into a
// bounded failure rather than a hang.
function goDrain() {
    var guard = 0
    while (goQueue.length > 0 && guard < 1000000) {
        guard = guard + 1
        var t = goQueue[0]
        var rest = []
        var i = 1
        while (i < goQueue.length) { rest.push(goQueue[i]); i = i + 1 }
        goQueue = rest
        t.apply(undefined, [])
    }
    return undefined
}

// goChanRecv takes one value; ok is false exactly when the channel is closed and
// drained, and the value is then the element type's zero value.
function goChanRecv(ch) {
    if (!goIsChan(ch)) { fail("receive from a non-channel") }
    if (ch.buf.length == 0) { goDrain() }
    if (ch.buf.length == 0) {
        if (ch.closed === true) { return {v: goZeroOf(goStrOf(ch.czero)), ok: false} }
        fail("all goroutines are asleep - deadlock")
    }
    var first = ch.buf[0]
    var rest = []
    var i = 1
    while (i < ch.buf.length) { rest.push(ch.buf[i]); i = i + 1 }
    ch.buf = rest
    return {v: first, ok: true}
}

function goZeroOf(ty) {
    if (ty.indexOf("int") == 0 || ty.indexOf("uint") == 0 || ty.indexOf("byte") == 0
        || ty.indexOf("rune") == 0 || ty.indexOf("float") == 0) { return 0 }
    if (ty.indexOf("string") == 0) { return "" }
    if (ty.indexOf("bool") == 0) { return false }
    return null
}

function js_gochan_new(ty) {
    return {__chan: true, buf: [], closed: false, czero: goStrOf(ty)}
}

function js_gochan_send(ch, v) {
    if (!goIsChan(ch)) { fail("send on a non-channel") }
    if (ch.closed === true) { throw goRTErr("runtime.plainError", "send on closed channel") }
    ch.buf.push(v)
    return undefined
}

function js_gochan_recv(ch) { return goChanRecv(ch).v }

// v, ok := <-ch: the pair, as a two-element array the emitted code indexes.
function js_gochan_recvok(ch) {
    var st = goChanRecv(ch)
    return [st.v, st.ok]
}

// Can a receive proceed WITHOUT blocking? What a select's arms ask before
// falling back to the default arm; it drains the goroutine queue first.
function js_gochan_ready(ch) {
    if (!goIsChan(ch)) { fail("receive from a non-channel") }
    if (ch.buf.length == 0 && ch.closed !== true) { goDrain() }
    if (ch.buf.length > 0) { return true }
    return ch.closed === true
}

// close(ch): the callee's argument array. Closing a nil or an already closed
// channel is a run-time panic. Twins: js_gochan_close in abnf/jsrt.go, close in
// go-interpreter.abnf.
function js_gochan_close(args) {
    if (!Array.isArray(args) || args.length == 0) { fail("close() needs a channel") }
    var ch = args[0]
    if (ch === undefined || ch === null) { throw goRTErr("runtime.plainError", "close of nil channel") }
    if (!goIsChan(ch)) { fail("close() needs a channel") }
    if (ch.closed === true) { throw goRTErr("runtime.plainError", "close of closed channel") }
    ch.closed = true
    return undefined
}

// make([]T, n, c) and make(chan T, n): the run-time panics of a negative length,
// a capacity below the length and a negative buffer size. Twins: js_gomakesl /
// js_gomakech in abnf/jsrtgolang.go, makeMakeCall in go-interpreter.abnf.
function js_gomakesl(n, c) {
    var ln = goNum(n)
    if (ln < 0) { goRTPanic("makeslice: len out of range") }
    if (goNum(c) < ln) { goRTPanic("makeslice: cap out of range") }
    return undefined
}
function js_gomakech(n) {
    if (goNum(n) < 0) { throw goRTErr("runtime.plainError", "makechan: size out of range") }
    return undefined
}

// go f(...): queue the already-bound call.
function js_gospawn(fn) {
    goQueue.push(fn)
    return undefined
}

// ----- fmt ------------------------------------------------------------------

function js_goprint(args, mode) {
    var m = goIdx(mode)
    var out = gopCompose(args, m)
    if (gopNewline(m)) { out = out + "\n" }
    print(out)
    return undefined
}

function js_gowrite(args, mode) {
    var m = goIdx(mode)
    var out = gopCompose(args, m)
    if (gopNewline(m)) { out = out + "\n" }
    print(out)
    return undefined
}

function js_gostr(args, mode) {
    var m = goIdx(mode)
    if (m == GOP_ONE) { return gopStr(args) }
    return gopCompose(args, m)
}

// ----- widths on the SLOTS a Go program declares ----------------------------
//
// The sized-integer box carries a width, but a width only exists where the
// program wrote a type down, and a `var` declaration is not the only place that
// happens: a struct FIELD, a slice ELEMENT and a map VALUE each have a declared
// type of their own, and a value flowing into one has to adopt it or the width
// is lost. A field's type is on the descriptor (__fields / __ftypes); a
// container element has no type text at the write site at all, but its ZERO
// VALUE was built from one, so the box already sitting in the slot IS the record
// of the declared element type.

// giTyBits: the width and signedness of the leading TYPE WORD of a type text.
// undefined for anything that is not a sized integer type. int/int64 answer here
// too - si_norm drops the box for them.
function goTyBits(word) {
    if (word == "int" || word == "int64") { return {w: 64, u: false} }
    if (word == "int8") { return {w: 8, u: false} }
    if (word == "int16") { return {w: 16, u: false} }
    if (word == "int32" || word == "rune") { return {w: 32, u: false} }
    if (word == "uint8" || word == "byte") { return {w: 8, u: true} }
    if (word == "uint16") { return {w: 16, u: true} }
    if (word == "uint32") { return {w: 32, u: true} }
    if (word == "uint" || word == "uint64" || word == "uintptr") { return {w: 64, u: true} }
    return undefined
}

// giTyWord: the leading TYPE WORD of a type text, which may carry trailing
// whitespace, a comment or a following name.
function goTyWord(ty) {
    var i = 0
    while (i < ty.length) {
        var c = ty.charCodeAt(i)
        var okc = (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95
        if (!okc) { break }
        i = i + 1
    }
    return ty.substring(0, i)
}

// giAdoptText applies a declared type TEXT to a value. A float64 / float32 slot
// BOXES, exactly as a `var d float64 = 1` declaration does - without it a
// float64 struct field assigned a plain 1 divides as an integer.
function goAdoptText(ty, v) {
    if (!goNumeric(v)) { return v }
    var word = goTyWord(ty)
    if (word == "float64") { return flo(goNum(v), 1) }
    // A float32 SLOT rounds what is put in it - a struct field, a []float32
    // element, a float32 parameter.
    if (word == "float32") { return js_gflo32(v) }
    var b = goTyBits(word)
    if (b === undefined) { return v }
    return sintConv(v, b.w, b.u)
}

// giAdoptLike applies the width the slot ALREADY carries.
function goAdoptLike(cur, v) {
    if (!sintIs(cur)) { return v }
    if (!goNumeric(v)) { return v }
    return sintConv(v, sintWidth(cur), sintUns(cur))
}

// (typeText, value): the declared width of a slot whose type IS written at the
// site - an append into a []uint8, a parameter binding.
function js_giadopt(ty, v) {
    if (typeof ty != "string") { return v }
    return goAdoptText(ty, v)
}

// obj.name = v, at the field's declared width. Delegates the store itself.
function js_gosetfield(o, namev, v) {
    if (o === undefined || o === null) { goNilDeref() }   // see goNilDeref: was the floor's die()
    var name = goStrOf(namev)
    // A write through a package qualifier goes to the package's OWN variable - see the
    // __pkgscope arm of js_gofield. scopeDecl and not a chain walk: an exported package
    // var is declared in that scope itself, so this rebinds exactly the cell the
    // package's own functions resolve.
    var pw = goIsObj(o) ? o.__pkgscope : undefined
    if (pw !== undefined && scopeHas(pw, name)) { scopeDecl(pw, name, v); return undefined }
    var ty = goFieldTy(o, name)
    if (ty == "") {
        o[name] = v
        return undefined
    }
    o[name] = goAdoptText(ty, v)
    return undefined
}

// giFieldTy: the declared type text of one field of a struct value, read off its
// descriptor. "" when the value is not a struct instance or the name is not one
// of its fields (an embedded promotion, the slice header's own props).
function goFieldTy(o, name) {
    var cls = goClassOf(o)
    if (cls === undefined) { return "" }
    var fs = cls.__fields
    var ft = cls.__ftypes
    if (!Array.isArray(fs) || !Array.isArray(ft)) { return "" }
    var i = 0
    while (i < fs.length) {
        if (fs[i] === name && i < ft.length) {
            if (typeof ft[i] == "string") { return ft[i] }
        }
        i = i + 1
    }
    return ""
}

// s[i] = v THROUGH A SLICE HEADER: one extern (offset, width and store) rather than
// three emitted calls. The width is the header's recorded element type first - an
// empty []uint8 has no element to take one from - and the box already in the slot
// second.
function js_gisetsl(h, iv, v) {
    if (!goIsObj(h)) { return js_pyset(h, iv, v) }
    var arr = h.a
    if (!Array.isArray(arr)) { return js_pyset(h, iv, v) }
    var ui = goIdx(iv)
    var idx = goIdx(h.o) + ui
    var nv = v
    if (typeof h.et == "string") { nv = goAdoptText(h.et, v) }
    else if (idx >= 0 && idx < arr.length) { nv = goAdoptLike(arr[idx], v) }
    // THE BOUND IS THE HEADER'S LENGTH, NOT THE BACKING ARRAY'S, and the index
    // reported is the one the program wrote. `base[0:2]` of a five element slice
    // has cap 5, and sub[4] still panics.
    if (ui < 0 || ui >= goIdx(h.n)) { goIdxPanic(ui, goIdx(h.n)) }
    arr[idx] = nv
    return undefined
}

// The DIVISOR of an integer '/' or '%', checked before the operator runs. Go's
// integer divide by zero is a RECOVERABLE run-time panic, and the floor's si_arith
// raises it with die() - a hard abort no js_gotry can catch. This file cannot call
// the floor's js_giarith by name to wrap it, so the emitter emits this as a
// PRE-CHECK instead (emitDivZ in languages/go-to-llvm-ir.abnf), the mirror image of
// js_gf32fix's post-fix. A FLOAT divisor is passed over: a float64 divided by zero
// is an infinity in Go, not a panic. The twin is js_gidivz in abnf/jsrtgolang.go
// and the interpreter's own check is gIntDivZ in languages/go-interpreter.abnf.
function js_gidivz(r) {
    if (floIs(r)) { return undefined }
    if (goNum(r) === 0) { goRTPanic("integer divide by zero") }
    return undefined
}

// The bounds of a slice EXPRESSION s[lo:hi:mx]: Go requires 0 <= lo <= hi <= mx
// <= cap, and violating it panics. The emitter calls this before it builds the new
// header (see $sslice in languages/go-to-llvm-ir.abnf) with mx undefined in the
// two-index form and isSl false for an array; the twin is js_gislbounds in
// abnf/jsrtgolang.go and the interpreter's own check is in goSlice.
function js_gislbounds(lo, hi, mx, cp, isSl) {
    var c = goIdx(cp)
    var three = mx !== undefined && mx !== null
    var m = c
    if (three) { m = goIdx(mx) }
    var word = "length"
    if (isSl === true) { word = "capacity" }
    goSliceCheck(goIdx(lo), goIdx(hi), m, c, three, word)
    return undefined
}

// x[i] THROUGH A SLICE HEADER: the read that mirrors js_gisetsl. It exists for
// the bound - js_map_get sees only the backing array and cannot know the header's
// length (`base[0:2][4]` must panic).
function js_gislget(h, iv) {
    if (!goIsObj(h)) { return js_map_get(h, iv) }
    var arr = h.a
    if (!Array.isArray(arr)) { return js_map_get(h, iv) }
    var ui = goIdx(iv)
    if (ui < 0 || ui >= goIdx(h.n)) { goIdxPanic(ui, goIdx(h.n)) }
    return arr[goIdx(h.o) + ui]
}

// x[i] = v, at the width the slot already carries. Delegates the store.
function js_gisetat(c, k, v) {
    // A store into a NIL MAP is a panic in Go, and it is the one thing a nil map
    // does not share with an empty one (see goIsNilMap).
    if (goIsNilMap(c)) { throw goRTErr("runtime.plainError", "assignment to entry in nil map") }
    // An out of range ARRAY store panics with the same wording the READ uses,
    // rather than reaching js_pyset, whose own bound is the floor's `fail` (a hard
    // abort no recover() can catch).
    if (Array.isArray(c)) {
        var ai = goIdx(k)
        if (ai < 0 || ai >= c.length) { goIdxPanic(ai, c.length) }
    }
    // A map entry is found by Go's key rule (goMapFind), which the shared
    // js_pyset's key scan cannot see.
    if (goIsDict(c)) {
        var mi = goMapFind(c, k)
        var old = anytype
        old = mi >= 0 ? c.vals[mi] : c.zero
        var nv = anytype
        nv = old === undefined ? v : goAdoptLike(old, v)
        if (mi >= 0) { c.vals[mi] = nv } else {
            c.keys.push(k)
            c.vals.push(nv)
        }
        return undefined
    }
    var cur = goSlotOf(c, k)
    if (cur === undefined) { return js_pyset(c, k, v) }
    return js_pyset(c, k, goAdoptLike(cur, v))
}

// giSlotOf: the value a container slot holds right now - a map's entry (or its
// zero value when the key is absent, which is exactly the boxed zero built from
// the value type) and an array's element. Never fails: an out of range index or
// a non-container simply has no width to offer.
function goSlotOf(x, k) {
    if (goIsDict(x)) {
        var i = goMapFind(x, k)
        if (i >= 0) { return x.vals[i] }
        return x.zero
    }
    if (Array.isArray(x)) {
        var j = goIdx(k)
        if (j < 0) { j = j + x.length }
        if (j >= 0 && j < x.length) { return x[j] }
    }
    return undefined
}
