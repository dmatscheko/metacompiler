// Java identifiers (JLS 3.8): a "Java letter" then "Java letters-or-digits", which
// are exactly Character.isJavaIdentifierStart / isJavaIdentifierPart. That is not
// Unicode's ID_Start / ID_Continue (see lib/ident-unicode.abnf for how they differ),
// and the identifier-IGNORABLE controls U+0000-U+0008, U+000E-U+001B and U+007F are
// identifier parts too, so `zero\u0000zero` is one name. Defines Id and KwEnd in place
// of lib/ident-dollar.abnf; expects Whitespace.
//
// Above ASCII the guards decide by the tables below: the two predicates over
// U+0080-U+10FFFF (surrogates excluded) as delta-varint range lists, the encoding
// lib/ident-unicode.abnf documents. They come from the installed JDK (openjdk 24.0.2)
// and are regenerated by running a class that walks every code point with
// Character.isJavaIdentifierStart / isJavaIdentifierPart and prints the ranges in that
// encoding (lib/ident-unicode.abnf's node command, with those two predicates).

Id          = JIdStart :whitespace() { JIdPart } :whitespace(Whitespace) ;
JIdStart    = "a"..."z" | "A"..."Z" | "_" | "$" | JIdUni JIdStartOk ;
JIdPart     = "a"..."z" | "A"..."Z" | "0"..."9" | "_" | "$"
            | "\x00"..."\x08" | "\x0e"..."\x1b" | "\x7f" | JIdUni JIdPartOk ;
JIdUni      = "\u0080"..."\U0010ffff" ;
// A keyword ends where no identifier character follows. Any non-ASCII byte counts as
// one, so `int\u00e9x` is the name, not the keyword `int`.
