// For a language whose names may contain UNICODE letters, see lib/ident-unicode.abnf:
// it carries the real ID_Start / ID_Continue tables as two guards, defines no Id of its
// own (so it composes with the Id below or with a grammar's own), and its header records
// which languages those tables are and are not the right answer for - the answer differs
// per language and it is not obvious. This module stays ASCII: it is on the hot path of
// every language that includes it.
//
// Identifiers and the keyword boundary: a keyword production ends with KwEnd,
// which fails (via the impossible-token trick) when the next byte would extend
// the word, so 'iffy' or 'variable' stay identifiers. Expects Whitespace.

Id          = ( "a"..."z" | "A"..."Z" | "_" ) :whitespace() { "a"..."z" | "A"..."Z" | "0"..."9" | "_" } :whitespace(Whitespace) ;
KwEnd = :script(~~
    (function() {
        var cc = c.peek(0)
        return ((cc >= 48 && cc <= 57) || (cc >= 65 && cc <= 90) || cc === 95 || (cc >= 97 && cc <= 122))
            ? abnf.newToken("\x01keyword-boundary", 0)
            : undefined
    })()
~~) ;

// A backtick-quoted identifier: `class`, `1M`, `one two`. Several JVM languages
// (Kotlin, Groovy, Scala, F#) spell a name that clashes with a keyword - or that is
// not a legal bare identifier at all - this way. OPT-IN, like the extended number
// literals: nothing references it unless a grammar wires it into its own name
// production, and it must come BEFORE Id there (PEG first-match). The content is any
// character except the closing backtick and a line break.
IdBacktick  = "`" :whitespace() IdBtChar { IdBtChar } "`" :whitespace(Whitespace) ;
IdBtChar    = "\x20"..."\x5f" | "\x61"..."\U0010ffff" ;
