}

// An array created with a declared type carries that type's binary name as its
// kind number, 1000 and up so it meets no other language's kinds; jvArrTagNames
// maps the number back. Twin of js_jvarrtag in abnf/jsrtjava.go and jArrTag in
// java-interpreter.abnf.
var jvArrTagNames = []
var jvArrTagKinds = {}
function js_jvarrtag(a, desc) {
    var k = jvArrTagKinds["$" + desc]
    if (k === undefined) {
        k = 1000 + jvArrTagNames.length
        jvArrTagNames.push(desc)
