function js_jvshift(op, l, r) {
    jvNpeIfNull(l)
    jvNpeIfNull(r)
    return jvShift(op, l, r)
}

// An ordered comparison. Two integers compare at the promoted width; anything
// else (a double, a string pair) keeps the shared comparison, rtCompare.
//
// rtCompare (abnf/jsrt.go's jsCompare) answers the SENTINEL 2 when either operand
// coerces to NaN, meaning "every relation is false" - JLS 15.20.1. It must be
// read that way, not as an ordering: smoothing the 2 to 0 would make `<=` and
// `>=` true. The body is rtjRel - SHARED with csharp's js_cscmp,
// lib/runtime.metajs's JVM-family section; the Go twin is js_jvcmp in
// abnf/jsrtjava.go.
// A float operand promotes the other side to float too (JLS 5.6.2), so
// `16777217 < 16777216f` is false - the int converts to 1.6777216E7 first.
function js_jvcmp(op, l, r) {
