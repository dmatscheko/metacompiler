// System.out.println(x) / System.out.print(x). The argument ARRAY of the emitted
// closure arrives whole, so the no-argument println(), which writes just the line
// terminator, is distinguishable from println(null).
function js_jvprint(args) {
    println(jvOutText(jpFirst(args)))
