// Math.addExact / subtractExact / multiplyExact at the promoted width: the
// wrapped result, or ArithmeticException "integer overflow" / "long overflow"
// when it differs from the true one. Twin of jExact in java-interpreter.abnf,
// whose comment has the two tests, and jvExact in abnf/jsrtjava.go.
function jvExact(op, a, b) {
    var r = jvArith(op, a, b)
    if (!jvIsLong(r)) {
        var x = rtjNum(a)
        var y = rtjNum(b)
        var t = x * y
        if (op == "+") { t = x + y }
        if (op == "-") { t = x - y }
        if (t !== rtjNum(r)) { jvThrowArith("integer overflow") }
        return r
    }
    var na = jvCmp("<", a, 0)
    var nb = jvCmp("<", b, 0)
    var nr = jvCmp("<", r, 0)
    var bad = false
    if (op == "+") { bad = na == nb && nr != na }
    if (op == "-") { bad = na != nb && nr != na }
    if (op == "*") {
        if (jvCmp("!=", b, 0)) { bad = jvCmp("!=", jvArith("/", r, b), a) }
        if (jvCmp("==", a, rtjMinL()) && jvCmp("==", b, 0 - 1)) { bad = true }
    }
    if (bad) { jvThrowArith("long overflow") }
    return r
}

// java.lang.Character's classification and case mapping. Twin of jCharMembers
