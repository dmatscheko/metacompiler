// Math.max / Math.min on doubles: NaN wins, and -0.0 is below 0.0. Twin of
// jMaxD / jMinD in java-interpreter.abnf.
function jvMaxD(a, b) {
    if (a !== a) { return a }
    if (a == 0 && b == 0 && 1 / a < 0) { return b }
    if (a >= b) { return a }
    return b
}
function jvMinD(a, b) {
    if (a !== a) { return a }
    if (a == 0 && b == 0 && 1 / b < 0) { return b }
    if (a <= b) { return a }
    return b
}
