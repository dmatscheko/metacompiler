function jpHash(v) { return jpHex(jpIdNum(v)) }

// %x of a non-negative integer. 439041024 is 0x1a2b3c00, the Go twin's base.
function jpHex(n) {
    var digits = "0123456789abcdef"
    var v = n
    var out = ""
    if (v == 0) { return "0" }
    while (v > 0) {
        var d = v - Math.floor(v / 16) * 16
        out = digits.charAt(d) + out
        v = Math.floor(v / 16)
