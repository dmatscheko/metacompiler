    return arrKindSet(a, k)
}

// jpArrayTag is the array's class name as getName spells it: the type it was
// created with, else one INFERRED from its elements by the Go twin's table.
function jpArrayTag(a) {
    var kind = arrKind(a)
    if (kind >= 1000) { return jvArrTagNames[kind - 1000] }
    var tag = ""
    var i = 0
    while (i < a.length) {
        var t = jpElemTag(a[i])
