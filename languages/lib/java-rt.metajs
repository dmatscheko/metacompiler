// ----- identity hash --------------------------------------------------------
//
// Every object rendered with an `@` gets a stable per-run number. Real java
// prints System.identityHashCode, which is address derived and changes between
// two runs of the SAME program, so no assertion can depend on the digits; what
// the halves must agree on is that one object renders the same way twice and
// that a run is deterministic, which a counter gives. The Go twin keys a map by
// the value; MetaJS has no such map, so the objects are kept in a parallel array
// and found by IDENTITY - which is the same test a Go map on a pointer does.

var jpIdObjs = []
var jpIdNums = []

// The NUMBER behind that rendering, which is what Object#hashCode answers: real
// java's Object.toString is getName() + "@" + Integer.toHexString(hashCode()), so
// the two have to agree, and here they do by construction.
function jpIdNum(v) {
    var i = 0
    while (i < jpIdObjs.length) {
        if (jpIdObjs[i] === v) { return 439041024 + jpIdNums[i] }
        i = i + 1
    }
    var n = jpIdObjs.length + 1
    jpIdObjs.push(v)
    jpIdNums.push(n)
    return 439041024 + n
