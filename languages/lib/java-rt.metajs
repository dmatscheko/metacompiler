// The toString an object inherits from the library when no class on its chain
// declares one: Throwable's, Enum's, Record's or Object's. It is also what
// `super.toString()` reaches past the last user class.
function jpInherited(o, depth) {
    // java.lang.Throwable#toString: the BINARY class name and, only when
    // getMessage() is non-null, ": " and the message - println(new
    // RuntimeException("x")) is "java.lang.RuntimeException: x" (java 24.0.2).
    // It carries NO stack trace (printStackTrace() is the method that does).
    if (jvIsThrowable(o)) { return jvThrowableStr(o) }
    // The class descriptor itself.
    if (o["__isclass"] === true) {
        var cn = o["__name"]
        if (typeof cn == "string") { return "class " + cn }
    }
    var cls = o["__class"]
    if (cls === undefined) { return jpPlainObj(o) }
    if (cls === null) { return jpPlainObj(o) }
    if (typeof cls != "object") { return jpPlainObj(o) }
