    o["asin"] = function(v) { return flo(fdlibm().asin(rtjNum(v)), 0) }
    o["acos"] = function(v) { return flo(fdlibm().acos(rtjNum(v)), 0) }
    o["atan"] = function(v) { return flo(fdlibm().atan(rtjNum(v)), 0) }
    o["sinh"] = function(v) { return flo(fdlibm().sinh(rtjNum(v)), 0) }
    o["cosh"] = function(v) { return flo(fdlibm().cosh(rtjNum(v)), 0) }
    o["tanh"] = function(v) { return flo(fdlibm().tanh(rtjNum(v)), 0) }
    o["atan2"] = function(y, x) { return flo(fdlibm().atan2(rtjNum(y), rtjNum(x)), 0) }
    o["hypot"] = function(x, y) { return flo(fdlibm().hypot(rtjNum(x), rtjNum(y)), 0) }
    o["pow"] = function(x, y) { return flo(fdlibm().pow(rtjNum(x), rtjNum(y)), 0) }
