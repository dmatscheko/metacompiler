// Twin of jvWrapCompare in abnf/jsrtjava.go.
function jvWrapCompare(x, y) {
    if (floIs(x)) { return jvDoubleCompare(floNum(x), rtjNum(y)) }
    if (x === true || x === false) {
        if (x === y) { return 0 }
        return x ? 1 : 0 - 1
    }
    if (jvIsChar(x)) { return x["__char"] - jvI(y) }
    if (sintIs(x) && sintWidth(x) < 32) { return jvI(x) - jvI(y) }
    if (typeof x != "number" && !sintIs(x)) { return undefined }
    if (jvCmp("<", x, y)) { return 0 - 1 }
    if (jvCmp(">", x, y)) { return 1 }
    return 0
}

// 2^n, exactly, by squaring: every product of powers of two is exact down to
// the smallest subnormal, and the squares past the last one used may overflow
// or vanish harmlessly. MetaJS has no exponent literal, so the IEEE-754
// extremes are built from it. Twin of jPow2 in java-interpreter.abnf.
function jvPow2(n) {
    var x = 1
    var base = 2
    if (n < 0) { base = 0.5 }
    var k = n
    if (k < 0) { k = 0 - k }
    while (k > 0) {
        if (k % 2 == 1) { x = x * base }
        base = base * base
        k = (k - k % 2) / 2
    }
    return x
}

// Double.parseDouble's text: String.trim, an optional sign, then NaN, Infinity,
// or decimal digits with an optional point, exponent and f/F/d/D suffix.
// Anything else throws NumberFormatException with java 24.0.2's message:
// "empty String", "multiple points", or `For input string: "x"`. A hexadecimal
// significand is jvParseHex's, rounded once to the target width (f32 for
// Float). Twin of rt.jvParseDbl in abnf/jsrtjava.go and jParseDbl in
// java-interpreter.abnf.
function jvParseDbl(s, f32) {
    var a = 0
    var e = s.length
    while (a < e && s.charCodeAt(a) <= 32) { a = a + 1 }
    while (e > a && s.charCodeAt(e - 1) <= 32) { e = e - 1 }
    if (a == e) { jvThrowCls(jvNfeCls, "empty String") }
    var t = s.substring(a, e)
    var bad = "For input string: \"" + s + "\""
    var i = 0
    var neg = false
    var c0 = t.charAt(0)
    if (c0 == "+" || c0 == "-") {
        neg = c0 == "-"
        i = 1
    }
    var rest = t.substring(i, t.length)
    if (rest == "NaN") { return NaN }
    if (rest == "Infinity") {
        if (neg) { return 0 - Infinity }
        return Infinity
    }
    if (rest.length > 1 && rest.charAt(0) == "0" && (rest.charAt(1) == "x" || rest.charAt(1) == "X")) {
        var hx = jvParseHex(rest.substring(2, rest.length), f32)
        if (hx !== hx) { jvThrowCls(jvNfeCls, bad) }
        if (neg) { return -hx }
        return hx
    }
    var digits = 0
    while (i < t.length && jvIsDigitAt(t, i)) {
        i = i + 1
        digits = digits + 1
    }
    if (i < t.length && t.charAt(i) == ".") {
        i = i + 1
        while (i < t.length && jvIsDigitAt(t, i)) {
            i = i + 1
            digits = digits + 1
        }
        if (i < t.length && t.charAt(i) == ".") { jvThrowCls(jvNfeCls, "multiple points") }
    }
    if (digits == 0) { jvThrowCls(jvNfeCls, bad) }
    if (i < t.length && (t.charAt(i) == "e" || t.charAt(i) == "E")) {
        i = i + 1
        if (i < t.length && (t.charAt(i) == "+" || t.charAt(i) == "-")) { i = i + 1 }
        var ed = 0
        while (i < t.length && jvIsDigitAt(t, i)) {
            i = i + 1
            ed = ed + 1
        }
        if (ed == 0) { jvThrowCls(jvNfeCls, bad) }
    }
    var end = i
    if (i < t.length && "fFdD".indexOf(t.charAt(i)) >= 0) { i = i + 1 }
    if (i != t.length) { jvThrowCls(jvNfeCls, bad) }
    var f = parseFloat(t.substring(0, end))
    if (f == 0 && neg) { return -Math.abs(f) }
    return f
}

// A hexadecimal significand's magnitude, rounded once to a double or (f32) a
// float; NaN when malformed. Twin of jParseHex in java-interpreter.abnf, whose
// comment has the method, and jvParseHex in abnf/jsrtjava.go.
function jvParseHex(t, f32) {
    var ds = ""
    var intDigits = 0 - 1
    var i = 0
    var more = true
    while (more && i < t.length) {
        var c = t.charAt(i)
        if (c == "." && intDigits < 0) {
            intDigits = ds.length
            i = i + 1
        } else if (jvHexVal(c) >= 0) {
            ds = ds + c
            i = i + 1
        } else {
            more = false
        }
    }
    if (intDigits < 0) { intDigits = ds.length }
    if (ds == "" || i >= t.length) { return NaN }
    if (t.charAt(i) != "p" && t.charAt(i) != "P") { return NaN }
    i = i + 1
    var eneg = false
    if (i < t.length && (t.charAt(i) == "+" || t.charAt(i) == "-")) {
        eneg = t.charAt(i) == "-"
        i = i + 1
    }
    var pexp = 0
    var ed = 0
    while (i < t.length && jvIsDigitAt(t, i)) {
        if (pexp < 100000000) { pexp = pexp * 10 + (t.charCodeAt(i) - 48) }
        i = i + 1
        ed = ed + 1
    }
    if (i < t.length && "fFdD".indexOf(t.charAt(i)) >= 0) { i = i + 1 }
    if (ed == 0 || i != t.length) { return NaN }
    if (eneg) { pexp = 0 - pexp }
    var j = 0
    while (j < ds.length && jvHexVal(ds.charAt(j)) == 0) { j = j + 1 }
    if (j == ds.length) { return 0 }
    var lead = jvHexVal(ds.charAt(j))
    var lz = 3
    if (lead >= 2) { lz = 2 }
    if (lead >= 4) { lz = 1 }
    if (lead >= 8) { lz = 0 }
    var e = (intDigits - j) * 4 - 1 - lz + pexp
    var big = 53
    var emin = 0 - 1022
    var emax = 1023
    if (f32) {
        big = 24
        emin = 0 - 126
        emax = 127
    }
    if (e > emax) { return Infinity }
    var p = big
    if (e < emin) { p = big - (emin - e) }
    if (p < 0) { return 0 }
    var m = 0
    var guard = 0
    var sticky = false
    var b = j * 4 + lz
    var n = 0
    while (b < ds.length * 4 || n < p) {
        var bit = 0
        if (b < ds.length * 4) { bit = Math.floor(jvHexVal(ds.charAt(Math.floor(b / 4))) / jvPow2(3 - b % 4)) % 2 }
        if (n < p) {
            m = m * 2 + bit
        } else if (n == p) {
            guard = bit
        } else if (bit == 1) {
            sticky = true
        }
        b = b + 1
        n = n + 1
    }
    if (guard == 1 && (sticky || m % 2 == 1)) { m = m + 1 }
    return m * jvPow2(e - p + 1)
}
function jvHexVal(c) {
    var k = c.charCodeAt(0)
    if (k >= 48 && k <= 57) { return k - 48 }
    if (k >= 97 && k <= 102) { return k - 87 }
    if (k >= 65 && k <= 70) { return k - 55 }
    return 0 - 1
}

function jvIsDigitAt(t, i) {
    var c = t.charCodeAt(i)
    return c >= 48 && c <= 57
}

// Double and Float: the IEEE-754 constants of the width and the static methods
// over it. Twin of jvFloType in abnf/jsrtjava.go and jFloType in
// java-interpreter.abnf.
function jvFloType(o, f32) {
    var sty = 0
    if (f32) { sty = 3 }
    o["NaN"] = flo(NaN, sty)
    o["POSITIVE_INFINITY"] = flo(Infinity, sty)
    o["NEGATIVE_INFINITY"] = flo(0 - Infinity, sty)
    if (f32) {
        o["MAX_VALUE"] = flo((2 - jvPow2(0 - 23)) * jvPow2(127), 3)
        o["MIN_VALUE"] = flo(jvPow2(0 - 149), 3)
        o["MIN_NORMAL"] = flo(jvPow2(0 - 126), 3)
        o["SIZE"] = 32
        o["BYTES"] = 4
    } else {
        o["MAX_VALUE"] = flo((2 - jvPow2(0 - 52)) * jvPow2(1023), 0)
        o["MIN_VALUE"] = flo(jvPow2(0 - 1074), 0)
        o["MIN_NORMAL"] = flo(jvPow2(0 - 1022), 0)
        o["SIZE"] = 64
        o["BYTES"] = 8
    }
    o["isNaN"] = function(v) {
        var f = rtjNum(v)
        return f !== f
    }
    o["isInfinite"] = function(v) {
        var f = rtjNum(v)
        return f == Infinity || f == 0 - Infinity
    }
    o["isFinite"] = function(v) {
        var f = rtjNum(v)
        if (f !== f) { return false }
        return f != Infinity && f != 0 - Infinity
    }
    o["compare"] = function(a, b) { return jvDoubleCompare(rtjNum(a), rtjNum(b)) }
    // The bit patterns, NaN canonical (JLS 4.2.3); hashCode is the boxed
    // value's. Twin of jvFloType in abnf/jsrtjava.go.
    if (f32) {
        o["floatToIntBits"] = function(v) { return jvFloatBits(rtjNum(v)) }
        o["intBitsToFloat"] = function(v) { return flo(jxBitsFlt(jxU32(jvI(v))), 3) }
        o["hashCode"] = function(v) { return jvFloatBits(rtjNum(v)) }
    } else {
        o["doubleToLongBits"] = function(v) {
            var b = jvDblBits(rtjNum(v))
            return sintRaw(b.hi, b.lo, 64, false)
        }
        o["longBitsToDouble"] = function(v) {
            var lb = jvToLongBox(v)
            return flo(jxBitsDbl(sintHi(lb), sintLo(lb)), 0)
        }
        // toHexString is %a's rendering (lib/java-format.js).
        o["toHexString"] = function(v) { return jxHexFloat(rtjNum(v), "", 0, 0 - 1, false) }
        o["hashCode"] = function(v) { return js_jhash(flo(rtjNum(v), 0)) }
    }
    o["sum"] = function(a, b) { return jvFloOf(rtjNum(a) + rtjNum(b), f32) }
    o["max"] = function(a, b) { return jvFloOf(jvMaxD(rtjNum(a), rtjNum(b)), f32) }
    o["min"] = function(a, b) { return jvFloOf(jvMinD(rtjNum(a), rtjNum(b)), f32) }
    var parse = function(s) {
        jvNpeIfNull(s)
        return jvFloOf(jvParseDbl(jpStr(s), f32), f32)
    }
    if (f32) { o["parseFloat"] = parse } else { o["parseDouble"] = parse }
    o["valueOf"] = function(v) {
        if (typeof v == "string") { return jvFloOf(jvParseDbl(v, f32), f32) }
        return jvFloOf(rtjNum(v), f32)
    }
    o["toString"] = function(v) { return jpStr(jvFloOf(rtjNum(v), f32)) }
}

// The number of v converted to a double (f32 false) or a float (f32 true).
function jvFloNum(v, f32) {
    if (f32) { return rtF32Round(rtjNum(v)) }
    return rtjNum(v)
}

// A double (f32 false) or a float (f32 true) box of the number f.
function jvFloOf(f, f32) {
    if (f32) { return flo(rtF32Round(f), 3) }
    return flo(f, 0)
}

// Integer / Long .sum, signum and the bit queries - bitCount,
// numberOfLeadingZeros / numberOfTrailingZeros, highestOneBit / lowestOneBit -
// at the width w, on the value's two unsigned 32 bit halves. Twin of jvBitOps
// in abnf/jsrtjava.go and jAddBitOps in java-interpreter.abnf.
function jvBitOps(o, w) {
    o["sum"] = function(a, b) { return jvNarrow(jvArith("+", a, b), w) }
    o["signum"] = function(v) {
        if (jvCmp("<", v, 0)) { return 0 - 1 }
        if (jvCmp(">", v, 0)) { return 1 }
        return 0
    }
    o["bitCount"] = function(v) { return jvPop32(jvHiOf(v, w)) + jvPop32(jvLow32(v)) }
    o["numberOfLeadingZeros"] = function(v) { return jvLeadZeros(jvHiOf(v, w), jvLow32(v), w) }
    o["numberOfTrailingZeros"] = function(v) { return jvTrailZeros(jvHiOf(v, w), jvLow32(v), w) }
    o["highestOneBit"] = function(v) {
        var h = jvHiOf(v, w)
        var l = jvLow32(v)
        if (h == 0 && l == 0) { return jvNarrow(0, w) }
        return jvOneBit(w - 1 - jvLeadZeros(h, l, w), w)
    }
    o["lowestOneBit"] = function(v) {
        var h = jvHiOf(v, w)
        var l = jvLow32(v)
        if (h == 0 && l == 0) { return jvNarrow(0, w) }
        return jvOneBit(jvTrailZeros(h, l, w), w)
    }
}

// Integer's unsigned readings and bit permutations (lib/java-strings.js).
// Twin of jvUnsignedOps in abnf/jsrtjava.go.
function jvUnsignedOps(o) {
    o["reverse"] = function(v) { return jxReverse32(jvI(v)) }
    o["reverseBytes"] = function(v) { return jxReverseBytes32(jvI(v)) }
    o["rotateLeft"] = function(v, d) { return jxRotl32(jvI(v), jvI(d)) }
    o["rotateRight"] = function(v, d) { return jxRotl32(jvI(v), 0 - jvI(d)) }
    o["toUnsignedLong"] = function(v) { return sintRaw(0, jxU32(jvI(v)), 64, false) }
    o["compareUnsigned"] = function(a, b) {
        var x = jxU32(jvI(a))
        var y = jxU32(jvI(b))
        if (x < y) { return 0 - 1 }
        if (x > y) { return 1 }
        return 0
    }
    o["divideUnsigned"] = function(a, b) {
        var y = jxU32(jvI(b))
        if (y == 0) { jvThrowCls(jvArithExcCls, "/ by zero") }
        return jxI32(Math.floor(jxU32(jvI(a)) / y))
    }
    o["remainderUnsigned"] = function(a, b) {
        var y = jxU32(jvI(b))
        if (y == 0) { jvThrowCls(jvArithExcCls, "/ by zero") }
        return jxI32(jxU32(jvI(a)) % y)
    }
    o["toUnsignedString"] = function(v, r) { return jvRadixStr(sintRaw(0, jxU32(jvI(v)), 64, false), 64, r, false) }
    o["parseUnsignedInt"] = function(s, r) {
        if (s === null) { jvThrowCls(jvNfeCls, "Cannot parse null string") }
        var t = jpStr(s)
        if (t.charAt(0) == "-") { jvThrowCls(jvNfeCls, "Illegal leading minus sign on unsigned string " + t + ".") }
        var l = jvParseInt(t, 64, jvRadixOf(r))
        if (sintHi(l) != 0) { jvThrowCls(jvNfeCls, "String value " + t + " exceeds range of unsigned int.") }
        return jxI32(sintLo(l))
    }
}

// Long's unsigned readings and bit permutations (lib/java-strings.js; the
// division is the floor's on UNSIGNED boxes). Twin of jvUnsignedLongOps in
// abnf/jsrtjava.go and jAddUnsignedLong in java-interpreter.abnf.
function jvUnsignedLongOps(o) {
    o["reverse"] = function(v) { return jvLongOfHalves(jvHalvesFn(v, 0, 0)) }
    o["reverseBytes"] = function(v) { return jvLongOfHalves(jvHalvesFn(v, 1, 0)) }
    o["rotateLeft"] = function(v, d) { return jvLongOfHalves(jvHalvesFn(v, 2, jvI(d))) }
    o["rotateRight"] = function(v, d) { return jvLongOfHalves(jvHalvesFn(v, 2, 0 - jvI(d))) }
    o["compareUnsigned"] = function(a, b) {
        var c = sintCmp(jvUnsignedBox(a), jvUnsignedBox(b))
        if (c < 0) { return 0 - 1 }
        if (c > 0) { return 1 }
        return 0
    }
    o["divideUnsigned"] = function(a, b) { return jvDivUnsigned(a, b, 3) }
    o["remainderUnsigned"] = function(a, b) { return jvDivUnsigned(a, b, 4) }
    o["toUnsignedString"] = function(v, r) { return jvRadixStr(v, 64, r, true) }
    o["parseUnsignedLong"] = function(s, r) {
        if (s === null) { jvThrowCls(jvNfeCls, "Cannot parse null string") }
        var hl = jxParseU64(jpStr(s), jvRadixOf(r))
        return sintRaw(hl[0], hl[1], 64, false)
    }
}

// The long v's bits as an unsigned 64-bit box.
function jvUnsignedBox(v) {
    var b = jvToLongBox(v)
    return sintRaw(sintHi(b), sintLo(b), 64, true)
}

// divideUnsigned (op 3) / remainderUnsigned (op 4) of two longs.
function jvDivUnsigned(a, b, op) {
    var y = jvUnsignedBox(b)
    if (sintHi(y) == 0 && sintLo(y) == 0) { jvThrowArith("/ by zero") }
    var r = sintOp(op, jvUnsignedBox(a), y)
    return sintRaw(sintHi(r), sintLo(r), 64, false)
}

// reverse (kind 0), reverseBytes (1) or rotateLeft by d (2) of the long v, as
// [hi, lo] halves.
function jvHalvesFn(v, kind, d) {
    var b = jvToLongBox(v)
    if (kind == 0) { return jxReverse64(sintHi(b), sintLo(b)) }
    if (kind == 1) { return jxReverseBytes64(sintHi(b), sintLo(b)) }
    return jxRotl64(sintHi(b), sintLo(b), d)
}

function jvLongOfHalves(hl) { return sintRaw(hl[0], hl[1], 64, false) }

// The unsigned upper 32 bits of a value at width w (0 at 32).
function jvHiOf(v, w) {
    if (w == 32) { return 0 }
    return sintHi(jvToLongBox(v))
}

function jvPop32(x) {
    var n = 0
    var y = x
    while (y > 0) {
        if (y % 2 == 1) { n = n + 1 }
        y = (y - y % 2) / 2
    }
    return n
}

function jvClz32(x) {
    if (x == 0) { return 32 }
    var n = 0
    var y = x
    while (y < 2147483648) {
        y = y * 2
        n = n + 1
    }
    return n
}

function jvCtz32(x) {
    if (x == 0) { return 32 }
    var n = 0
    var y = x
    while (y % 2 == 0) {
        y = y / 2
        n = n + 1
    }
    return n
}

function jvLeadZeros(h, l, w) {
    if (w == 32) { return jvClz32(l) }
    if (h != 0) { return jvClz32(h) }
    return 32 + jvClz32(l)
}

function jvTrailZeros(h, l, w) {
    if (w == 32) { return jvCtz32(l) }
    if (l != 0) { return jvCtz32(l) }
    return 32 + jvCtz32(h)
}

// The value of width w with only bit k set.
function jvOneBit(k, w) {
    if (k >= 32) { return jvNarrow(sintRaw(jvPow2(k - 32), 0, 64, false), w) }
    return jvNarrow(sintRaw(0, jvPow2(k), 64, false), w)
}

// toString(v [, radix]) and the three unsigned renderings of Integer (w 32) or
// Long (w 64).
function jvRadixMembers(o, w) {
    o["toString"] = function(v, r) { return jvRadixStr(v, w, r, false) }
    o["toHexString"] = function(v) { return jvRadixStr(v, w, 16, true) }
    o["toOctalString"] = function(v) { return jvRadixStr(v, w, 8, true) }
    o["toBinaryString"] = function(v) { return jvRadixStr(v, w, 2, true) }
}

function jvAddCommon(o, width, size, bytes) {
    o["SIZE"] = size
    o["BYTES"] = bytes
    o["valueOf"] = function(v) { return jvNarrow(v, width) }
    o["toString"] = function(v) { return jpStr(v) }
    o["hashCode"] = function(v) { return js_jhash(jvNarrow(v, width)) }
    // Short.compare and Byte.compare answer x - y, Integer and Long the sign.
    o["compare"] = function(a, b) {
        if (width < 32) { return jvI(a) - jvI(b) }
        if (jvCmp("<", a, b)) { return 0 - 1 }
        if (jvCmp(">", a, b)) { return 1 }
        return 0
    }
    o["max"] = function(a, b) {
        if (jvCmp(">", a, b)) { return jvNarrow(a, width) }
        return jvNarrow(b, width)
    }
    o["min"] = function(a, b) {
        if (jvCmp("<", a, b)) { return jvNarrow(a, width) }
        return jvNarrow(b, width)
    }
}

// Integer / Long .toString(v, radix), toHexString, toOctalString and
// toBinaryString. toString is the SIGNED reading ("-ff"; a radix outside 2..36
// means 10); the other three are the UNSIGNED reading AT THE VALUE'S OWN WIDTH,
// so Integer.toHexString(-1) is "ffffffff". Lowercase, no leading zeros; java
// 24.0.2 is the oracle. The digits come off the two exact 32 bit halves by long
// division in plain doubles (rem * 2^32 + lo < 2^38), in an explicit loop
// because `(255).toString(16)` aborts under -frozen (manual chapter 7.10). Twin
// of jRadixStr in java-interpreter.abnf and jvRadixOf in abnf/jsrtjava.go.
function jvRadixStr(v, w, radixArg, uns) {
    var radix = jvRadixOf(radixArg)
    if (radix < 2 || radix > 36) { radix = 10 }
    var hi = 0
    var lo = jvLow32(v)
    var neg = false
    if (w == 32) {
        if (!uns && lo >= 2147483648) {
            neg = true
            lo = 4294967296 - lo
        }
    } else {
        var t = jvToLongBox(v)
        if (!uns && sintCmp(t, jlZero()) < 0) {
            neg = true
            t = jlNeg(t)
        }
        hi = sintHi(t)
        lo = sintLo(t)
    }
    var out = ""
    while (hi > 0 || lo > 0) {
        var rh = hi % radix
        hi = (hi - rh) / radix
        var cur = rh * 4294967296 + lo
        var r = cur % radix
        lo = (cur - r) / radix
        out = "0123456789abcdefghijklmnopqrstuvwxyz".charAt(r) + out
    }
    if (out == "") { out = "0" }
    if (neg) { return "-" + out }
    return out
}

// Boolean.valueOf / Boolean.parseBoolean. java.lang.Boolean:
// a STRING argument is true iff it equalsIgnoreCase("true") - so "TrUe" is true
// and "no" is false rather than an error - and anything else is its own truth.
function jvBoolOf(v) {
    if (typeof v == "string") { return v.toLowerCase() == "true" }
    return v === true
}

// Integer.parseInt / Long.parseLong and their radix overloads: an optional sign
// and a digit run in the radix; anything else - whitespace and a magnitude past
// the width's range included - throws NumberFormatException. The magnitude
// accumulates as two exact base-2^32 halves in plain doubles (lo * 36 + 35 <
// 2^53), so nothing wraps before the range check. Twin of jParseInt in
// languages/java-interpreter.abnf and rt.jvParseInt in abnf/jsrtjava.go.
function jvParseInt(s, width, radix) {
    var bad = "For input string: \"" + s + "\""
    if (radix != 10) { bad = bad + " under radix " + radix }
    if (radix < 2) { jvThrowCls(jvNfeCls, "radix " + radix + " less than Character.MIN_RADIX") }
    if (radix > 36) { jvThrowCls(jvNfeCls, "radix " + radix + " greater than Character.MAX_RADIX") }
    var neg = false
    var i = 0
    if (s.length > 0) {
        var c0 = s.charAt(0)
        if (c0 == "+") { i = 1 } else if (c0 == "-") {
            neg = true
            i = 1
        }
    }
    if (i >= s.length) { jvThrowCls(jvNfeCls, bad) }
    var hi = 0
    var lo = 0
    while (i < s.length) {
        // Character.digit's value: a decimal digit of any script counts.
        var d = jcDigitVal(s.charCodeAt(i))
        if (d >= radix) { jvThrowCls(jvNfeCls, bad) }
        lo = lo * radix + d
        var carry = Math.floor(lo / 4294967296)
        lo = lo - carry * 4294967296
        hi = hi * radix + carry
        if (hi >= 4294967296) { jvThrowCls(jvNfeCls, bad) }
        i = i + 1
    }
    var over = false
    if (width == 64) {
        over = hi > 2147483648 || (hi == 2147483648 && (lo > 0 || !neg))
    } else {
        over = hi > 0 || lo > 2147483648 || (lo == 2147483648 && !neg)
    }
    if (over) { jvThrowCls(jvNfeCls, bad) }
    var acc = sintRaw(hi, lo, 64, false)
    if (neg) { acc = jlNeg(acc) }
    return jvNarrow(acc, width)
}

// The optional radix argument of parseInt / valueOf: 10 when absent.
function jvRadixOf(r) {
    if (r === undefined) { return 10 }
    return rtjNum(r)
}

// Integer.valueOf / Long.valueOf: a String parses exactly as parseInt /
// parseLong does, anything else narrows.
function jvValueOf(v, width, r) {
    if (typeof v == "string") { return jvParseInt(v, width, jvRadixOf(r)) }
    return jvNarrow(v, width)
}

// ===================================================== the exports ==========
//
// Everything below is a TOP-LEVEL `function js_*`, which is what -rt-lib exports
// under its own C symbol. The order follows abnf/jsrtjava.go and the shared block
// of abnf/jsrt.go.

// ----- the language-NEUTRAL nine --------------------------------------------
// None of these is Java's. They live in abnf/jsrt.go, several languages emit
// them, and they are here only because the C floor does not have them.

// js_arr_new_n is SHARED with csharp - lib/runtime.metajs's JVM-family section.

// js_char is SHARED - lib/runtime.metajs (csharp, java and kotlin); the _raw
// suffix travels with it.

// The shared dynamic type test behind instanceof. abnf/jsrt.go's isTypeName is
// the spec, including the part that surprises: the Int/Long/Short/Byte arm tests
// for a PLAIN number, so a boxed long is NOT `instanceof Long` there either.
// js_is_type is SHARED - lib/runtime.metajs, via the rtkIsChar/rtkIsArr hooks.

// Java/C# +: string concat, 32 bit add for two int values, float add otherwise.
// The STRING rendering here is abnf/jsrt.go's javaString, not jsrtjava.go's
// jvpStr - js_jvadd below is the one that renders through the Java printer.
// js_jadd is SHARED - lib/runtime.metajs, via the rtkStr/rtkNum hooks above.


// Java & | ^: the non-short-circuit boolean operator when both sides are
// booleans, the int32 bit operation otherwise.
//
// DUPLICATED, DELIBERATELY, with kotlin-rt.metajs's js_jband. The bodies differ
// only in the int32 coercion (jvI here, k1I32 there - one per value model), and
// neither emitter produces a call that reaches it: `&` lowers to js_jvarith /
// js_ktarith, and the ONLY js_jband either grammar emits is the boolean fold of
// a structural equality, which returns from the arm above. Sharing it would need
// another rtk* hook in every importer of lib/runtime.metajs for a coercion that
// is dead in both callers.
//
// If an emitter ever routes a non-boolean here: the Go twin (abnf/jsrt.go) has
// ONE js_jband for both languages and coerces with rt.toInt32 for both, so that
// is where java and kotlin would disagree with their own twin.
function js_jband(l, r) {
    if (typeof l == "boolean") { if (typeof r == "boolean") { return l && r } }
    return jvI(l) & jvI(r)
}

// Java's String.charAt: a CHAR, not a one-character String - so s.charAt(1) + 0
// is 101 and not "e0" (JLS 4.2.1, char is an integral type).
function js_jcharat(target, args) {
    if (typeof target == "string") {
        var i = rtjNum(args[0])
        // THROWS StringIndexOutOfBoundsException, which a program can catch.
        // See jStrIdx in java-interpreter.abnf.
        if (i < 0 || i >= target.length) { jvThrowSioobe(i, target.length) }
        return jvChar(target.charCodeAt(i))
    }
    return js_mcall(target, "charAt", args)
}

// Java's == when a char may be involved. String.charAt keeps answering a
// one-character String in the interpreter's world, so a char must compare equal
// to that too. Without a char operand this is exactly js_seq.
function js_jchareq(l, r) {
    if (jvIsChar(l)) {
        if (typeof r == "string") { return r.length == 1 && r.charCodeAt(0) == l["__char"] }
        if (jvIsChar(r)) { return l["__char"] === r["__char"] }
        if (rtIsPlainNum(r)) { return l["__char"] === r }
        if (sintIs(r)) { return jvCmp("==", l, r) }
        if (floIs(r)) { return floEq(flo(l["__char"], 0), r) }
        return false
    }
    if (jvIsChar(r)) { return js_jchareq(r, l) }
    return rtjStrictEq(l, r)
}

// The floor's === with the two boxes taught to it - a sized integer and a boxed
// double are both `typeof "number"`, and MetaJS's own === on two boxes is
// identity, so the numeric cases are spelled out - is rtjStrictEq, SHARED with
// csharp in lib/runtime.metajs's JVM-family section, its ONE knob being rtjkCmp.
// Its sized-integer arm promotes `long == double` (floEq has no tag 13 case);
// see the note at the shared body.

// (target, method name, args array). The Go twin (rt.memberCall in abnf/jsrt.go)
// is a LANGUAGE-NEUTRAL dispatcher; only the arms java-to-llvm-ir.abnf can reach
// are here, and the ones it cannot are named at the fallthrough rather than
// guessed at.
function js_mcall(recv, name, args) {
    if (typeof recv == "string") {
        if (name == "length") { return recv.length }
        if (name == "charAt") {
            var ci = rtjNum(args[0])
            if (ci < 0 || ci >= recv.length) { jvThrowSioobe(ci, recv.length) }
            return recv.charAt(ci)
        }
        if (name == "equals") { return rtjStrictEq(recv, args[0]) }
        if (name == "substring") {
            var b = args.length > 0 ? rtjNum(args[0]) : 0
            var e = args.length > 1 ? rtjNum(args[1]) : recv.length
            // java.lang.String.substring checks the RANGE, so begin > end is out of
            // bounds too - which is why the message names a range and not one index.
            // rtSubstring CLAMPS (the Go twin's substringRange), java throws.
            if (b < 0 || e > recv.length || b > e) { jvThrowRange(b, e, recv.length) }
            return rtSubstring(recv, b, e)
        }
        if (name == "indexOf") { return recv.indexOf(jpStr(args[0])) }
        if (name == "isEmpty") { return recv.length == 0 }
        fail("unknown String method: " + name)
        return undefined
    }
    if (recv === undefined || recv === null) {
        fail("method call '" + name + "' on a " + (recv === null ? "null" : "undefined"))
        return undefined
    }
    if (typeof recv != "object") {
        fail("method call '" + name + "' on a " + typeof recv)
        return undefined
    }
    if (Array.isArray(recv)) {
        if (name == "length") { return recv.length }
        if (name == "size") { return recv.length }
        if (name == "add") {
            recv.push(args[0])
            return true
        }
        if (name == "get") {
            var gi = rtjNum(args[0])
            if (gi < 0 || gi >= recv.length) {
                fail("list index " + gi + " out of range")
                return undefined
            }
            return recv[gi]
        }
        if (name == "contains") {
            var k = 0
            while (k < recv.length) {
                if (rtjStrictEq(recv[k], args[0])) { return true }
                k = k + 1
            }
            return false
        }
        fail("unknown list method '" + name + "'")
        return undefined
    }
    if (jvIsChar(recv)) {
        fail("method call '" + name + "' on a char")
        return undefined
    }
    var cls = recv["__class"]
    if (cls !== undefined) {
        // The __class/__super walk is SHARED - rtFindMethod, lib/runtime.metajs.
        var mm = rtFindMethod(cls, name)
        if (typeof mm == "function") { return mm.apply(undefined, rtPrepend(recv, args)) }
        fail("unknown method '" + name + "' on an instance")
        return undefined
    }
    var f = recv[name]
    if (f !== undefined && typeof f == "function") { return f.apply(undefined, args) }
    fail("unknown method '" + name + "'")
    return undefined
}

// jpPrepend is SHARED as rtPrepend - lib/runtime.metajs.

// js_supercall is SHARED - lib/runtime.metajs (four languages, one knob: rtkCall).

// ----- Java's own externs ---------------------------------------------------

// One runtime-raised exception class descriptor, handed over by NAME at module
// init so that the externs below can THROW rather than abort.
function js_jvexc(name, cls) {
    if (cls === undefined || cls === null || typeof cls != "object") { return undefined }
    jvExcNamed["$" + name] = cls
    if (name == "ArithmeticException") { jvArithExcCls = cls }
    else if (name == "ArrayIndexOutOfBoundsException") { jvAioobeCls = cls }
    else if (name == "StringIndexOutOfBoundsException") { jvSioobeCls = cls }
    else if (name == "NegativeArraySizeException") { jvNegArrCls = cls }
    else if (name == "NullPointerException") { jvNpeCls = cls }
    else if (name == "NumberFormatException") { jvNfeCls = cls }
    else if (name == "IllegalArgumentException") { jvIaeCls = cls }
    else if (name == "ClassCastException") { jvCceCls = cls }
    return undefined
}

// `a[i]`, read or written. EVERY array access is bounds-checked in Java (JLS
// 10.4) and a violation throws ArrayIndexOutOfBoundsException - it does not
// answer a default and it does not extend the array on a write. The emitter
// emits this for both halves: the write site discards the value and keeps only
// the check (emitRefPath in java-to-llvm-ir.abnf).
//
// A NON-array receiver keeps js_get behaviour: `this.f[i]` walks through
// object steps that are not arrays, and a null one is Java's NullPointerException.
function js_jvidx(o, i) {
    if (Array.isArray(o)) {
        var n = rtjNum(i)
        if (n < 0 || n >= o.length) { jvThrowAioobe(n, o.length) }
        return o[n]
    }
    if (o === undefined || o === null) {
        // `int[] z = null; z[0]` - the interpreter half throws the same NPE with a
        // null message (real java's text names the local, which no engine here can).
        jvThrowCls(jvNpeCls, null)
        return undefined
    }
    // The RAW key, not rtjNum(i): the Go twin's fallback is rt.getMember with the
    // key as it arrived, and this arm is only reachable for a receiver Java has no
    // syntax for at all - the two must not answer differently if it ever is.
    return o[i]
}

// Does a thrown value match ONE catch-clause type name? The emitter emits one
// call per name, so a multi-catch `catch (A | B e)` is two calls and nothing here
// has to split a string. The twin of core.excMatches in java-interpreter.abnf.
//
// A value OUTSIDE the Throwable hierarchy - this subset lets a program throw any
// object - is caught by the four general types, which is how `catch (Exception e)`
// is written in practice.
function jvIsThrowable(v) {
    if (v === null || v === undefined) { return false }
    if (typeof v != "object") { return false }
    var c = v["__class"]
    var guard = 0
    while (guard < 64) {
        guard = guard + 1
        if (c === undefined || c === null) { return false }
        if (typeof c != "object") { return false }
        if (c["__name"] === "Throwable") { return true }
        c = c["__super"]
    }
    return false
}
function js_jvexcmatch(v, n) {
    if (js_is_type(v, n)) { return true }
    if (n == "Exception" || n == "Throwable" || n == "RuntimeException" || n == "Error") {
        return !jvIsThrowable(v)
    }
    return false
}

// THE LAUNCHER'S UNCAUGHT-EXCEPTION LINE, and the top of the program. Without it
// the floor's uncaught-throw handler would render the value with the generic
// object toString - no class, no message.
//
// java 24.0.2 (stderr, exit status 1):
//
//     Exception in thread "main" java.lang.RuntimeException: abort probe
//     Exception in thread "main" P2$MyExc: custom msg
//     Exception in thread "main" P2$NoMsg           <- getMessage() == null
//
// The line is the fixed prefix plus Throwable#toString: the BINARY class name
// (jpClassName, which reads the __bname the emitter writes - "java.lang.*" for the
// built-in Throwables) and, only when getMessage() is non-null, ": " and the
// message. The "\tat Main.main(Main.java:4)" frames that follow in real java are
// NOT reproduced: there is no call-site line table here, and inventing frames
// would be a worse divergence than omitting them.
//
// The message slot differs between the halves: the emitted builtin constructor
// writes __msg (emitBuiltinExc in java-to-llvm-ir.abnf), the interpreter half's
// jExcCtor writes `message`, and a user class extending one of them may have gone
// through either. Both are read, in the same order, in all three engines.
//
// Twins: jExcTopLine / jReportUncaught in languages/java-interpreter.abnf and
// js_jvtop in abnf/jsrtjvm.go. The shape - the whole entry call inside one js_try
// whose catch clause calls this - is ruby's js_rtop and go's js_gotop.
// getLocalizedMessage(), which is getMessage() unless a class overrides
// either. Twin of jExcMessageOf in java-interpreter.abnf.
function jvExcMessageOf(v) {
    var f = rtFindMethod(v["__class"], "getLocalizedMessage")
    if (f !== undefined) { return f.apply(undefined, [v]) }
    var m = v["message"]
    if (m === undefined) { m = v["__msg"] }
    return m
}
// java.lang.Throwable#toString - the whole of the abort line after the fixed
// prefix, and also what println(e) prints (jpRender's Throwable arm).
function jvThrowableStr(v) {
    var cls = v["__class"]
    var name = "java.lang.Throwable"
    if (cls !== undefined && cls !== null && typeof cls == "object") { name = jpClassName(cls) }
    var msg = jvExcMessageOf(v)
    if (msg === undefined) { return name }
    if (msg === null) { return name }
    return name + ": " + jpStr(msg)
}
function jvExcTopLine(v) {
    var head = "Exception in thread \"main\" "
    if (v === null || v === undefined) { return head + jpStr(v) }
    if (typeof v != "object") { return head + jpStr(v) }
    var out = head + jvThrowableStr(v)
    var seen = [v]
    var c = v["__cause"]
    while (c !== undefined && c !== null && typeof c == "object") {
        var i = 0
        while (i < seen.length) {
            if (seen[i] === c) { return out + "\nCaused by: [CIRCULAR REFERENCE: " + jvThrowableStr(c) + "]" }
            i = i + 1
        }
        seen.push(c)
        out = out + "\nCaused by: " + jvThrowableStr(c)
        c = c["__cause"]
    }
    return out
}
function js_jvtop(exc) {
    eprintln(jvExcTopLine(exc))
    exit(1)
    return undefined
}

// java.lang.String.substring. A SEPARATE EXTERN rather than a wrapper on js_mcall
// because the Go extern table is filled ONCE for every language: overriding
// js_mcall in abnf/jsrtjava.go would make a C# `Substring` raise java's message.
// js_ktsmcall and js_swmcall are the same pattern for the same reason. Only the
// java emitter emits this, and only for the name `substring`; the range check
// itself lives in js_mcall's arm below, which is java's own copy.
function js_jvsub(target, args) { return js_mcall(target, "substring", args) }

// One dimension of `new T[n]`: answers it, and raises NegativeArraySizeException
// on a negative one (JLS 15.10.1). The message is the offending size, nothing else.
function js_jvnewlen(n) {
    var v = rtjNum(n)
    if (v < 0) { jvThrowCls(jvNegArrCls, "" + v) }
    return v
}

// System.arraycopy(src, srcPos, dest, destPos, length), its argument array
// whole. The checks run in hotspot's order and the messages are java 24.0.2's;
// an overlapping copy within one array reads as if through a temporary, so a
// rightward move runs backwards. A non-array argument (ArrayStoreException in
// java) is not supported. lib/java-util.java's ArrayList shifts with it, which
// is why the move is one extern rather than a loop in the program. Twin of
// js_jvarraycopy in abnf/jsrtjava.go and System.arraycopy in
// java-interpreter.abnf.
function js_jvarraycopy(args) {
    var src = args[0]
    var dst = args[2]
    if (src === undefined || src === null || dst === undefined || dst === null) { jvThrowCls(jvNpeCls, null) }
    if (!Array.isArray(src) || !Array.isArray(dst)) { fail("java: System.arraycopy of a non-array is not supported") }
    var sp = rtjNum(args[1])
    var dp = rtjNum(args[3])
    var n = rtjNum(args[4])
    if (sp < 0) { jvThrowCls(jvAioobeCls, "arraycopy: source index " + sp + " out of bounds for " + jvAcType(src)) }
    if (dp < 0) { jvThrowCls(jvAioobeCls, "arraycopy: destination index " + dp + " out of bounds for " + jvAcType(dst)) }
    if (n < 0) { jvThrowCls(jvAioobeCls, "arraycopy: length " + n + " is negative") }
    if (sp + n > src.length) { jvThrowCls(jvAioobeCls, "arraycopy: last source index " + (sp + n) + " out of bounds for " + jvAcType(src)) }
    if (dp + n > dst.length) { jvThrowCls(jvAioobeCls, "arraycopy: last destination index " + (dp + n) + " out of bounds for " + jvAcType(dst)) }
    var d = dp - sp
    var i = sp
    var e = sp + n
    if (src === dst && d > 0) {
        i = e - 1
        while (i >= sp) { dst[i + d] = src[i]; i = i - 1 }
        return undefined
    }
    while (i < e) { dst[i + d] = src[i]; i = i + 1 }
    return undefined
}

// An array as System.arraycopy's messages name it: "int[5]", "object array[5]".
// The element type is jpArrayTag's inference.
function jvAcType(a) {
    var tag = jpArrayTag(a)
    var k = tag.charAt(1)
    var t = "object array"
    if (k == "I") { t = "int" } else if (k == "J") { t = "long" } else if (k == "S") { t = "short" } else if (k == "B") { t = "byte" } else if (k == "F") { t = "float" } else if (k == "D") { t = "double" } else if (k == "C") { t = "char" } else if (k == "Z") { t = "boolean" }
    return t + "[" + a.length + "]"
}

// One binary integral operator. A double operand keeps the FLOAT path, which is
// where the two boxes meet.
function js_jvarith(op, l, r) {
    // The one host call the DOUBLE path pays for the float width: floStyle of a
    // result that is not style 3 is the whole test, because style 3 can only
    // have come off a Java float operand.
    if (floIs(l) || floIs(r)) { var rf = rtjArith(op, l, r); if (floStyle(rf) == 3) { return jvFloFix(op, rf, l, r) } return rf }
    if (!rtjIsIntegral(l) || !rtjIsIntegral(r)) {
        jvNpeIfNull(l)
        jvNpeIfNull(r)
        // & | ^ on two booleans are Java's non-short-circuit boolean operators;
        // anything else is not a program javac accepts.
        if (typeof l == "boolean" && typeof r == "boolean") {
            if (op == "&") { return l && r }
            if (op == "|") { return l || r }
            if (op == "^") { return l !== r }
        }
        var rg = rtjArith(op, l, r)
        if (floStyle(rg) == 3) { return jvFloFix(op, rg, l, r) }
        return rg
    }
    return jvArith(op, l, r)
