// A String as System.out writes it: UTF-8 cannot carry a lone surrogate, which
// the encoder replaces with '?'. Twin of jOutText in java-interpreter.abnf.
function jvOutText(s) {
    if (byteLen(s) == s.length) { return s }
    var out = ""
    var i = 0
    while (i < s.length) {
        var c = s.charCodeAt(i)
        if (c >= 55296 && c < 56320 && i + 1 < s.length && s.charCodeAt(i + 1) >= 56320 && s.charCodeAt(i + 1) < 57344) {
            out = out + s.substring(i, i + 2)
            i = i + 1
        } else if (c >= 55296 && c < 57344) {
            out = out + "?"
        } else {
            out = out + s.charAt(i)
