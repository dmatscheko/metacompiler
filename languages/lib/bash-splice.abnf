// A here-document as BsSplice left it: `<<`, an optional `-`, the delimiter word as written,
// then the body between \x02 and \x03 - ONE token, which mkHereDoc splits apart again.
HdScan = :script(~~
    (function() {
        var no = abnf.newToken("\x01noheredoc", 0)
        // Whitespace is not skipped before a script, so step over blanks exactly like the
        // token match that follows will.
        var i = 0
        var cc = c.peek(i)
        while (cc === 32 || cc === 9) { i = i + 1; cc = c.peek(i) }
        var start = i
        if (c.peek(i) !== 60 || c.peek(i + 1) !== 60 || c.peek(i + 2) === 60) { return no }
        i = i + 2
        // The delimiter word ends at the \x02; a separator or another redirection first
        // means this is no here-document BsSplice saw.
        cc = c.peek(i)
        while (cc >= 0 && cc !== 2 && cc !== 10 && cc !== 59 && cc !== 38 && cc !== 124 && cc !== 60) { i = i + 1; cc = c.peek(i) }
        if (cc !== 2 || i === start + 2) { return no }
        while (cc >= 0 && cc !== 3) { i = i + 1; cc = c.peek(i) }
        if (cc !== 3) { return no }
        var end = i + 1
        // Rebuild the exact source slice as a token. c.peek answers BYTES, so the UTF-8 has
        // to be decoded here or a non-ASCII body would never match.
        var out = ""
        var p = start
        while (p < end) {
            var b0 = c.peek(p)
            if (b0 < 128) { out = out + String.fromCharCode(b0); p = p + 1; continue }
            if (b0 >= 240) {
                var cp4 = ((b0 - 240) * 262144) + ((c.peek(p + 1) - 128) * 4096) + ((c.peek(p + 2) - 128) * 64) + (c.peek(p + 3) - 128)
                var off = cp4 - 65536
                out = out + String.fromCharCode(55296 + ((off - (off % 1024)) / 1024)) + String.fromCharCode(56320 + (off % 1024))
                p = p + 4
                continue
            }
            if (b0 >= 224) {
                out = out + String.fromCharCode(((b0 - 224) * 4096) + ((c.peek(p + 1) - 128) * 64) + (c.peek(p + 2) - 128))
                p = p + 3
                continue
            }
            if (b0 >= 192) {
                out = out + String.fromCharCode(((b0 - 192) * 64) + (c.peek(p + 1) - 128))
                p = p + 2
                continue
            }
            return no
        }
        return abnf.newToken(out, 0)
    })()
