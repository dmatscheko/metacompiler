        // in src (an inserted \x02 or \x03 stands for its marker's end).
        var out = ""
        var runs = ""
        var pos = 0
        var run = function(from) { runs = runs + (runs === "" ? "" : ",") + out.length + "," + from }
        var e = 0
        while (e < edAt.length) {
            var at = edAt[e]
            if (at > pos) { run(pos); out = out + src.substring(pos, at); pos = at }
            if (edHd[e] < 0) {
                if (at + edDel[e] > pos) { pos = at + edDel[e] }
            } else {
                run(at)
                out = out + "\x02"
                var r = hdFrom[edHd[e]]
                while (r < hdTo[edHd[e]]) {
                    if (rnTo[r] > rnFrom[r]) { run(rnFrom[r]); out = out + src.substring(rnFrom[r], rnTo[r]) }
                    r = r + 1
                }
                run(at)
                out = out + "\x03"
            }
            e = e + 1
        }
        if (pos < n) { run(pos); out = out + src.substring(pos) }
        c.setSrcMap(out, runs)
