    var idx = pySliceIndices(arr.length, lo, hi, step)
    var drop = []
    var d = 0
    while (d < arr.length) {
        drop.push(false)
        d = d + 1
    }
    var i = 0
    while (i < idx.length) {
        if (idx[i] >= 0 && idx[i] < drop.length) { drop[idx[i]] = true }
        i = i + 1
    }
    var w = 0
    var r = 0
    var n = arr.length
    while (r < n) {
        if (!drop[r]) {
            arr[w] = arr[r]
            w = w + 1
        }
        r = r + 1
    }
