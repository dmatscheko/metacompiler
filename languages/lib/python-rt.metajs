// ----- js_pymatchseq ----------------------------------------------------------
// A sequence pattern matches lists and tuples (one type here), never a string
// and never a dict: (value, count before the *rest, count after it, is there a
// *rest) -> does the shape fit.
function js_pymatchseq(v, before, after, hasRest) {
    if (!pyIsArr(v)) { return false }
    var b = Math.trunc(pyNum(before))
    var a = Math.trunc(pyNum(after))
    if (pyCTruthy(hasRest)) { return v.length >= b + a }
    return v.length == b
}


// ----- js_pymatchmap ----------------------------------------------------------
// A mapping pattern matches a dict (not a set) that holds every listed key.
// Membership is pyDictFind, which compares keys with === - Go's rt.dictFind.
function js_pymatchmap(v, want) {
    var els = pySetElemsOf(v)
    if (els !== null && els !== undefined) { return false }
    if (!pyIsDict(v)) { return false }
    if (!pyIsArr(want)) { return false }
    var keys = v["keys"]
    var i = 0
    while (i < want.length) {
        if (pyDictFind(keys, want[i]) < 0) { return false }
        i = i + 1
    }
    return true
}


// ----- js_pymaprest -----------------------------------------------------------
// The **rest of a mapping pattern: a fresh dict of every entry whose key the
// pattern did not name, in the subject's insertion order. The skip test is
// pyEqual - Python's == - and NOT the === of pyDictFind that js_pymatchmap
// above uses. That asymmetry is Go's.
function js_pymaprest(v, want) {
    if (!pyIsDict(v)) { fail("js_pymaprest needs a dict") }
    var keys = v["keys"]
    var vals = v["vals"]
    var out = pyNewDict()
    var ok = out["keys"]
    var ov = out["vals"]
    var i = 0
    var n = keys.length
    while (i < n) {
        var skip = false
        if (pyIsArr(want)) {
            var j = 0
            while (j < want.length) {
                if (pyEqual(want[j], keys[i])) { skip = true }
                j = j + 1
            }
        }
