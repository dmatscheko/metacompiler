    var fill = " "
    var align = ""
    // The Go twin indexes the spec by BYTE (spec[0:1], spec[1]). This port
    // indexes by UTF-16 unit, which is the same thing for every ASCII spec; a
    // non-ASCII FILL character differs - Go would take only its first byte and
    // pad with that broken fragment, and this pads with the whole character.
    if (spec.length > 1 && pyBIsAlign(spec.charAt(1))) {
        fill = spec.substring(0, 1)
        align = spec.charAt(1)
