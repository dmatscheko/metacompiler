// A builtin value with no __dict (None, a number, a str, a list, a dict, a set)
// refuses a new attribute, and its deletion, with a catchable AttributeError.
// Go: rt.pyNoDictAttr in abnf/jsrt.go.
function pyNoDictAttr(obj, name) {
    var tn = pyTypeName(obj)
    if (pyIsCplx(obj)) { tn = "complex" }
    if (tn == "NoneType" || tn == "int" || tn == "float" || tn == "bool" || tn == "str" ||
