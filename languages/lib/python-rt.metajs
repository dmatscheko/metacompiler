    return undefined
}

// ===================================================== builtin classes ======
//
// pyBuiltinClass hands out ONE stable class object per builtin type name, so
// type(x) is type(y) holds for two values of the same builtin type. The table key is
// "$"-prefixed, which is the intern-key rule of docs/abnf-dialect-gotchas.md.

var pyTypeTable = {}

// The name of a TYPE object - a user class (it carries an __mro) or one of the
// interned builtin type objects. The Ellipsis singleton also carries a __name
// and is deliberately not one. Go: rt.pyClassName.
function pyClassName(v) {
    if (!pyIsObj(v)) { return null }
    var n = v["__name"]
    if (n === undefined) { return null }
    var nm = pyToStr(n)
    if (v["__mro"] !== undefined) { return nm }
    if (pyTypeTable["$" + nm] === v) { return nm }
    return null
}

function pyBuiltinClass(name) {
    var k = "$" + name
    var got = pyTypeTable[k]
    if (got !== undefined) { return got }
    var c = {__name: name}
    pyTypeTable[k] = c
    return c
}

// The name of a BUILTIN type object (what pyBuiltinClass hands out: a __name and
// nothing else), and "" for anything else - a user class object included, since
// those carry a __mro and go through pyLookup.
function pyBuiltinClsName(v) {
    if (!pyIsObj(v)) { return "" }
    if (v["__mro"] !== undefined) { return "" }
    if (v["__name"] === undefined) { return "" }
    return pyToStr(v["__name"])
}

// The method surface a builtin TYPE OBJECT itself carries - only dict.fromkeys so
// far. Its RECEIVER is the type rather than an instance, so it reaches neither
// the dict dispatcher nor a class MRO, and each of the three engines resolves
// such a receiver in an arm of its own. Both the mcall path (pyDMethodCall) and
// the value path (pyGetAttr) need it, or it is reachable one way and not the
// other. Keep in step with pyBuiltinClsMethod in abnf/jsrt.go and in
// languages/python-interpreter.abnf.
function pyBuiltinClsMethod(target, name) {
    if (pyBuiltinClsName(target) != "dict") { return undefined }
    if (name != "fromkeys") { return undefined }
    return function(ks, dv) { return pyDictFromKeys(ks, dv) }
}

// dict.fromkeys(iterable[, value]): a fresh dict mapping every element of the
// iterable to the same value, None by default.
function pyDictFromKeys(ks, dv) {
    var d = pyNewDict()
    var a = pyElemsOf(ks)
    var i = 0
    while (i < a.length) {
        pyDictSet(d, a[i], dv)
        i = i + 1
    }
    return d
}

// vars(o) IS o.__dict__ - CPython's own definition.
function js_pyvars(o) { return pyGetAttr(o, "__dict__") }

// abnf/jsrt.go's pyExcInstance: the class is a stable per-name object deriving from
// one called Exception, so the name walk of pyIsInstance answers `except Exception`
// (and `except <ThatName>`) for a StopIteration / UnboundLocalError / AttributeError
// the RUNTIME raised, exactly like for one the program raised.
function pyExcInstance(name, msg) {
    return {__class: pyExcClass(name), args: [msg]}
}

// The class a RUNTIME-raised exception carries, with CPython's hierarchy above
// it rather than a flat derivation from Exception: pyDIsInstance walks the
// __super chain by name, so `except LookupError` must see KeyError's real parent.
// The parent table is pyExcParent in languages/python-interpreter.abnf and the
// excParent block of languages/python-to-llvm-ir.abnf.
function pyExcParentName(name) {
    if (name == "ZeroDivisionError") { return "ArithmeticError" }
    if (name == "IndexError") { return "LookupError" }
    if (name == "KeyError") { return "LookupError" }
    if (name == "UnboundLocalError") { return "NameError" }
    if (name == "NotImplementedError") { return "RuntimeError" }
    if (name == "OverflowError") { return "ArithmeticError" }
    if (name == "Exception") { return "BaseException" }
    return "Exception"
}

function pyExcClass(name) {
    var cls = pyBuiltinClass(name)
    if (name != "BaseException") {
        if (cls["__super"] === undefined) { cls["__super"] = pyExcClass(pyExcParentName(name)) }
    }
    return cls
