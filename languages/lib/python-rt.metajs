// rt.pyGenericAlias: the memoized list[int]-style alias of a type object,
// CPython's types.GenericAlias, {__galias: its repr, __origin__, __args__}. A
// tuple subscript is the argument list. Keyed by the repr, so the same written
// alias is the same value twice and `type X = list[int]` compares equal.
function pyCGenericAlias(origin, param) {
    var isObj = pyIsObj(origin)
