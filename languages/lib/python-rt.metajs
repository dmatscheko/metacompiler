    r["leaves"] = []
    r["msg"] = undefined
    r["ok"] = false
    var cls = pyInstClassOf(v)
    if (cls === null) { return r }
    var mro = pyMRO(cls)
    var isGroup = false
    var i = 0
    while (i < mro.length) {
