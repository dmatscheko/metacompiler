            p = p + 1
            while (p < nm.length && nm.charAt(p) != "." && nm.charAt(p) != "[") {
                an = an + nm.charAt(p)
                p = p + 1
            }
            v = pySGetAttr(v, an)
        } else if (c2 == "[") {
            var key = ""
            p = p + 1
            while (p < nm.length && nm.charAt(p) != "]") {
                key = key + nm.charAt(p)
                p = p + 1
            }
            p = p + 1
            if (pySAllDigits(key)) { v = pySGetItem(v, parseInt(key, 10)) }
            else { v = pySGetItem(v, key) }
        } else {
            pySFail("ValueError: Invalid format field: " + nm)
            p = p + 1
        }
    }
    // A spec may itself carry replacement fields ("{:{w}}").
    if (spec.indexOf("{") >= 0) {
        var inner = pySFormatGo(spec, args, kw, at)
        spec = inner["text"]
        at = inner["auto"]
    }
    var res = {}
    res["text"] = pySFormat1(v, spec, conv)
    res["auto"] = at
