    if (op == "&") {
        var a = 0
        while (a < le.length) {
            if (pySetHas(re, le[a])) { pySetAdd(out, le[a]) }
            a = a + 1
        }
        return {v: pyNewSet(out)}
    }
    if (op == "-") {
        var b = 0
        while (b < le.length) {
            if (!pySetHas(re, le[b])) { pySetAdd(out, le[b]) }
            b = b + 1
        }
        return {v: pyNewSet(out)}
