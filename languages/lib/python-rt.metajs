// The shortest source wins, and every source is materialized first.
function pyZipRows(srcs) {
    var n = 0 - 1
    var i = 0
    while (i < srcs.length) {
        if (n < 0 || srcs[i].length < n) { n = srcs[i].length }
        i = i + 1
    }
    if (n < 0) { n = 0 }
    var out = []
    i = 0
    while (i < n) {
        var row = []
        var k = 0
        while (k < srcs.length) {
            row.push(srcs[k][i])
            k = k + 1
        }
        out.push(row)
        i = i + 1
    }
    return out
