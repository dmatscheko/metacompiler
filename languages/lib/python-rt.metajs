// pyRootExcType (jsrt.go:9593): is the except clause's type the ROOT of the
// exception hierarchy - the only one that catches a raised non-instance value?
// A tuple of types (written as a list here) counts when any element is a root.
function pyDRootExcType(target) {
    var i = 0
    if (pyIsArr(target)) {
        while (i < target.length) {
            if (pyDRootExcType(target[i])) { return true }
            i = i + 1
