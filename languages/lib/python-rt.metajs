    sub["args"] = [r["msg"], matched]
    sub["exceptions"] = matched
    return sub
}

// ----- the context-manager protocol (Go: js_pyenter / js_pyexit) ------------

// A context expression that is NOT a context manager (no __enter__) binds its
// own value and runs the body, so a plain value still works instead of
// aborting.
function js_pyenter(v) {
    var cls = pyInstClassOf(v)
    if (cls !== null) {
        if (pyLookupHas(cls, "__enter__")) {
            var m = pyLookupVal(cls, "__enter__")
            if (pyIsCallable(m)) { return pyCall(m, [v]) }
        }
    }
    return v
}

// __exit__(type, value, traceback) -> truthy swallows the exception. Go passes
// the caught value as BOTH the type and the value argument, and undefined as
// the traceback; kept exactly.
function js_pyexit(mgr, e) {
    var cls = pyInstClassOf(mgr)
    if (cls !== null) {
        if (pyLookupHas(cls, "__exit__")) {
            var m = pyLookupVal(cls, "__exit__")
            if (pyIsCallable(m)) { return pyCall(m, [mgr, e, e, undefined]) }
        }
    }
    return false
}
// ======================================================= the re module ======
//
// The `re` module: the Python half of the shared regular-expression subsystem.
// This is the line-by-line port of the WHOLE of abnf/jsrtregexpy.go.
//
// The ENGINE is NOT here. languages/lib/regex.js is the shared backtracking
// matcher (the Go twin of which is abnf/jsrtregex.go), python-rt.metajs imports
// it, and every match, group, replacement and split below goes through it -
// exactly as Ruby's rbRx* block does. Nothing in this chunk forks it.
//
// Three externs come out of this file:
//   js_pyre_module()                    Go rxPyModule
//   js_pyrxmcall(target, name, a, kw)   Go's js_pyrxmcall wrapper over js_pymcall
//   js_pyrxstr(v)                       Go's js_pyrxstr wrapper over js_pystr
//
// ONE unavoidable divergence, shared with every other language that drives this
// engine (ruby-rt.metajs records it at rbRxMatchOf): the Go twin indexes []rune
// where regex.js indexes UTF-16 code units. The two agree for the whole Basic
// Multilingual Plane, and therefore for every pattern and subject in the corpus.
// Every `text[i]` / `len(text)` in the Go bodies below is a .charAt / .length
// here for that reason, and is called out nowhere else.

// ----- CPython's re constants (sre_constants) -----
//
// Go spells these as untyped consts; MetaJS has no const, and the values are
// small enough that the bitmask below stays inside the int32 & / | the floor
// gives us.
var pyEReI = 2
var pyEReL = 4
var pyEReM = 8
var pyEReS = 16
var pyEReU = 32
var pyEReX = 64
var pyEReA = 256

// pyEReFlagStr is Go pyReFlagStr: the bitmask onto the engine's four neutral
// letters. re.A is the engine's only behaviour and re.U is the py3 default, so
// both are accepted and ignored; re.L has no locale to read.
function pyEReFlagStr(n) {
    var s = ""
    if ((n & pyEReI) != 0) { s = s + "i" }
    if ((n & pyEReS) != 0) { s = s + "s" }
    if ((n & pyEReM) != 0) { s = s + "m" }
    if ((n & pyEReX) != 0) { s = s + "x" }
    return s
}

// pyERePat is Go pyRePat: Python's P-spellings onto the neutral engine's.
// (?P<name>...) is (?<name>...) and (?P=name) is the named backreference
// \k<name>. Escapes and character classes are stepped over, so `[(?P<]` is left
// alone. An unknown name is the ENGINE's error to report, which is why nothing
// is counted here.
//
// Go returns (string, string); MetaJS has one return, so the pair travels in a
// record {out, err}.
function pyERePat(src) {
    var out = ""
    var inCls = false
    var i = 0
    while (i < src.length) {
        var ch = src.charAt(i)
        if (ch == "\\") {
            var end = i + 2
            if (end > src.length) { end = src.length }
            out = out + src.substring(i, end)
            i = end
            continue
        }
        if (inCls) {
            if (ch == "]") { inCls = false }
            out = out + ch
            i = i + 1
            continue
        }
        if (ch == "[") {
            inCls = true
            out = out + ch
            i = i + 1
            continue
        }
        if (ch != "(") {
            out = out + ch
            i = i + 1
            continue
        }
        // Go's strings.HasPrefix(src[i:], "(?P<"); substring clamps at the end
        // of the string, so a short tail simply fails to compare equal.
        if (src.substring(i, i + 4) == "(?P<") {
            var j = i + 4
            while (j < src.length && src.charAt(j) != ">") { j = j + 1 }
            if (j >= src.length) { return {out: "", err: "unterminated group name"} }
            out = out + "(?<" + src.substring(i + 4, j) + ">"
            i = j + 1
            continue
        }
        if (src.substring(i, i + 4) == "(?P=") {
            var k = i + 4
            while (k < src.length && src.charAt(k) != ")") { k = k + 1 }
            if (k >= src.length) { return {out: "", err: "unterminated group name"} }
            out = out + "\\k<" + src.substring(i + 4, k) + ">"
            i = k + 1
            continue
        }
        out = out + ch
        i = i + 1
    }
    return {out: out, err: ""}
}

// ----- The compile cache -----
//
// SHARED as rxCache / rxGet - lib/regex.js, imported at the top of this file,
// which is where abnf/jsrtregex.go keeps it: ONE cache for js, kotlin,
// python and ruby.

// ----- The three value shapes (Go rxPyIsMod / rxPyIsRe / rxPyIsMatch) -----
//
// All three are plain objects, so pyGetAttr already answers re.I, p.pattern,
// p.flags, m.re and m.string without a wrapper of its own. A match additionally
// carries the __rx* slots the engine's group machinery reads, which is what lets
// it share Ruby's shape unchanged.

function pyERxIsMod(v) {
    if (!pyIsObj(v)) { return false }
    return v["__pymod"] === "re"
}

function pyERxIsRe(v) {
    if (!pyIsObj(v)) { return false }
    return v["__pyre"] === true
}

function pyERxIsMatch(v) {
    if (!pyIsObj(v)) { return false }
    return v["__pymatch"] === true
}

// js_pyre_module is Go rxPyModule. `import re` binds no module object in this
// flat import model, so the grammar declares this one into the global scope; it
// is a plain object, which js_pygetattr reads re.I / re.DOTALL out of.
function js_pyre_module() {
    return {
        __pymod: "re",
        NOFLAG: 0,
        A: 256, ASCII: 256,
        I: 2, IGNORECASE: 2,
        L: 4, LOCALE: 4,
        M: 8, MULTILINE: 8,
        S: 16, DOTALL: 16,
        U: 32, UNICODE: 32,
        X: 64, VERBOSE: 64
    }
}

// pyERxCompile is Go (*jsrt).rxPyCompile.
function pyERxCompile(pat, flags) {
    var tr = pyERePat(pat)
    if (tr["err"] != "") { fail("re.error: " + tr["err"]) }
    var src = tr["out"]
    var neutral = pyEReFlagStr(flags)
    var re = rxGet(src, neutral)
    if (!re["ok"]) { fail("re.error: " + re["err"]) }
    // Python's own .flags always reports re.UNICODE for a str pattern.
    return {__pyre: true, pattern: pat, flags: flags | pyEReU, __src: src, __nf: neutral}
}

// pyERxSlotStr reads a string slot off one of the three shapes, defaulting to ""
// - Go's `s, _ := o.props[k].(string)` comma-ok assertion.
function pyERxSlotStr(v, k) {
    var s = v[k]
    if (typeof s != "string") { s = "" }
    return s
}

// pyERxReOf is Go rxPyReOf: the program behind a compiled PATTERN object.
function pyERxReOf(v) {
    return rxGet(pyERxSlotStr(v, "__src"), pyERxSlotStr(v, "__nf"))
}

// pyERxMkMatch is Go rxPyMkMatch composed with rxNewMatchObj: the __rx* slots of
// the neutral match object plus Python's own __pymatch / re / string.
function pyERxMkMatch(rv, anchoredSrc, flags, s, m) {
    var caps = []
    var mc = m["caps"]
    var i = 0
    while (i < mc.length) {
        caps.push(mc[i])
        i = i + 1
    }
    return {
        __pymatch: true, __rxmd: true,
        __rxsrc: anchoredSrc, __rxflags: flags, __rxtext: s, __rxcaps: caps,
        "re": rv, "string": s
    }
}

// pyERxMatchOf is Go rxMatchOf: the program is recovered from the match's own
// __rxsrc/__rxflags (Go rxObjRe), NOT from the pattern object's __src/__nf: a
// match made by re.match carries the ANCHORED source, and the two must not be
// confused. SHARED as rxMatchOf - lib/regex.js.
function pyERxMatchOf(v) { return rxMatchOf(v) }

// pyERxSearch is Go (*jsrt).rxPySearch. The Go body checks the engine's second
// return and fails with "regexp: step limit exceeded"; regex.js raises that
// itself out of rxAttempt (via the rxFail knob), so there is no second return to
// test here and the failure text is the engine's own.
function pyERxSearch(rv, s, from) {
    var re = pyERxReOf(rv)
    var m = rxSearch(re, s, from)
    if (m === null) { return undefined }
    return pyERxMkMatch(rv, rv["__src"], re["flags"], s, m)
}

// pyERxAnchored is Go (*jsrt).rxPyAnchoredMatch - re.match / re.fullmatch. These
// are NOT a search plus a position check: a fullmatch has to BACKTRACK into an
// alternation, so re.fullmatch("a|ab", "ab") is "ab" and not None. The engine's
// own anchored entry points express both, including Python's `pos` argument,
// and unlike a \A(?:...)\z wrapper they have no quarrel with the x flag's
// trailing comments.
function pyERxAnchored(rv, s, from, whole) {
    // The two arms are spelled out rather than assigning into one local: a local
    // keeps the TYPE CLASS it is first assigned, so `var m = null` followed by a
    // match object is the dialect's classic trap.
    var re = pyERxReOf(rv)
    if (whole) {
        var mw = rxMatchWhole(re, s, from)
        if (mw === null) { return undefined }
        return pyERxMkMatch(rv, rv["__src"], re["flags"], s, mw)
    }
    var ma = rxMatchAt(re, s, from)
    if (ma === null) { return undefined }
    return pyERxMkMatch(rv, rv["__src"], re["flags"], s, ma)
}

// ----- Match accessors -----

// pyERxGroupIdx is Go (*jsrt).rxPyGroupIdx. Go calls rt.fail here rather than
// raising a Python IndexError, so this does too - the message is the Go text.
function pyERxGroupIdx(md, key) {
    var mo = pyERxMatchOf(md)
    var re = mo["re"]
    if (typeof key == "number") {
        var i = Math.trunc(key)
        if (i < 0 || i > re["ngroups"]) { fail("IndexError: no such group") }
        return i
    }
    var gi = rxIndexOfName(re, pyToStr(key))
    if (gi < 0) { fail("IndexError: no such group") }
    return gi
}

// pyERxGroup is Go (*jsrt).rxPyGroup.
function pyERxGroup(md, key) {
    var mo = pyERxMatchOf(md)
    var g = rxGroup(mo["re"], mo["text"], mo["m"], pyERxGroupIdx(md, key))
    if (g === null) { return undefined }
    return g
}

// pyERxSpan is Go (*jsrt).rxPySpan.
function pyERxSpan(md, key, which) {
    var mo = pyERxMatchOf(md)
    var slot = 2 * pyERxGroupIdx(md, key) + which
    var caps = mo["m"]["caps"]
    if (slot >= caps.length) { return -1 }
    return caps[slot]
}

// pyERxAppendGroups is Go rxPyAppendGroups.
//
// Python's None is `undefined` in this value model, and it is NOT the same value
// as null - so every non-participating group answers undefined. That is why this
// cannot simply be the engine's own capture array, which fills Ruby's nil.
function pyERxAppendGroups(parts, re, text, m) {
    var g = 1
    while (g <= re["ngroups"]) {
        var v = rxGroup(re, text, m, g)
        if (v === null) { parts.push(undefined) } else { parts.push(v) }
        g = g + 1
    }
}

// pyERxGroups is Go rxPyGroups.
function pyERxGroups(md) {
    var mo = pyERxMatchOf(md)
    var out = []
    pyERxAppendGroups(out, mo["re"], mo["text"], mo["m"])
    return out
}

// pyERxGroupDict is Go rxPyGroupDict. Go appends straight onto the two parallel
// arrays (dictAppend) rather than going through a find-then-set, and group names
// are unique, so this pushes directly too.
function pyERxGroupDict(md) {
    var mo = pyERxMatchOf(md)
    var re = mo["re"]
    var d = pyNewDict()
    var keys = d["keys"]
    var vals = d["vals"]
    var names = re["names"]
    var idx = re["nameGroups"]
    var i = 0
    while (i < names.length) {
        var g = rxGroup(re, mo["text"], mo["m"], idx[i])
        keys.push(names[i])
        if (g === null) { vals.push(undefined) } else { vals.push(g) }
        i = i + 1
    }
    return d
}

// pyERxTemplate is Go rxPyTemplate: Python's \g<1> / \g<name> onto the \1 /
// \k<name> the engine's expander understands. The plain \1 form is already the
// engine's own.
function pyERxTemplate(repl) {
    var out = ""
    var i = 0
    while (i < repl.length) {
        if (repl.substring(i, i + 3) == "\\g<") {
            var j = i + 3
            while (j < repl.length && repl.charAt(j) != ">") { j = j + 1 }
            var nm = repl.substring(i + 3, j)
            var allDigit = nm.length > 0
            var q = 0
            while (q < nm.length) {
                var c = nm.charCodeAt(q)
                if (c < 48 || c > 57) { allDigit = false }
                q = q + 1
            }
            if (allDigit) { out = out + "\\" + nm } else { out = out + "\\k<" + nm + ">" }
            i = j + 1
            continue
        }
        if (repl.charAt(i) == "\\") {
            var end = i + 2
            if (end > repl.length) { end = repl.length }
            out = out + repl.substring(i, end)
            i = end
            continue
        }
        out = out + repl.charAt(i)
        i = i + 1
    }
    return out
}

// ----- The pattern-taking operations -----

// pyERxSub is Go (*jsrt).rxPySub - re.sub / re.subn. `repl` may be a CALLABLE,
// which is why this cannot simply be the engine's rxReplace: the closure has to
// be run per match. Go returns (string, int); the pair travels in a record here.
//
// Note the isFn test: Go asks "not undefined/null AND not a string", so a
// non-callable non-string replacement is handed to the caller as a call, which
// is what CPython does too (it raises). Ported as written.
function pyERxSub(rv, repl, s, count) {
    var re = pyERxReOf(rv)
    var src = rv["__src"]
    var out = ""
    var isFn = !rtIsNil(repl) && typeof repl != "string"
    var tpl = ""
    if (!isFn) { tpl = pyERxTemplate(pyToStr(repl)) }
    var at = 0
    var last = 0
    var n = 0
    while (at <= s.length) {
        if (count > 0 && n >= count) { break }
        var m = rxSearch(re, s, at)
        if (m === null) { break }
        out = out + s.substring(last, m["begin"])
        if (isFn) {
            var md = pyERxMkMatch(rv, src, re["flags"], s, m)
            out = out + pyToStr(pyCall(repl, [md]))
        } else {
            out = out + rxExpand(re, s, m, tpl)
        }
        n = n + 1
        last = m["end"]
        at = m["end"]
        if (m["end"] == m["begin"]) {
            // An empty match must still make progress or this loop never ends.
            if (m["end"] < s.length) { out = out + s.charAt(m["end"]) }
            last = m["end"] + 1
            at = m["end"] + 1
        }
    }
    if (last <= s.length) { out = out + s.substring(last, s.length) }
    return {text: out, n: n}
}

// pyERxSplit is Go (*jsrt).rxPySplit - re.split. Unlike the engine's neutral
// rxSplit, Python SPLICES the capture groups of each separator into the result,
// so this walks the matches itself.
function pyERxSplit(rv, s, maxsplit) {
    var re = pyERxReOf(rv)
    var parts = []
    var at = 0
    var last = 0
    var n = 0
    while (at <= s.length) {
        if (maxsplit > 0 && n >= maxsplit) { break }
        var m = rxSearch(re, s, at)
        if (m === null) { break }
        if (m["end"] == m["begin"]) {
            if (m["begin"] >= s.length) { break }
            parts.push(s.substring(last, m["begin"]))
            pyERxAppendGroups(parts, re, s, m)
            // Go leaves `last` at the match's own begin here, NOT begin+1.
            last = m["begin"]
            at = m["begin"] + 1
            n = n + 1
            continue
        }
        parts.push(s.substring(last, m["begin"]))
        pyERxAppendGroups(parts, re, s, m)
        last = m["end"]
        at = m["end"]
        n = n + 1
    }
    parts.push(s.substring(last, s.length))
    return parts
}

// pyERxFindAll is Go (*jsrt).rxPyFindAll - re.findall / re.finditer: no group ->
// the whole matches, one group -> that group, more -> the capture tuple of each
// match (a tuple is a list in this value model).
function pyERxFindAll(rv, s, asMatch) {
    var re = pyERxReOf(rv)
    var src = rv["__src"]
    var out = []
    var at = 0
    while (at <= s.length) {
        var m = rxSearch(re, s, at)
        if (m === null) { break }
        if (asMatch) {
            out.push(pyERxMkMatch(rv, src, re["flags"], s, m))
        } else if (re["ngroups"] == 0) {
            // Go's `g, _ := re.group(...)` drops the ok here, so a null answers
            // as "" and not as None. Group 0 always participates, so this arm is
            // unreachable in practice; it is spelled Go's way anyway.
            var g0 = rxGroup(re, s, m, 0)
            if (g0 === null) { out.push("") } else { out.push(g0) }
        } else if (re["ngroups"] == 1) {
            var g1 = rxGroup(re, s, m, 1)
            if (g1 === null) { out.push(undefined) } else { out.push(g1) }
        } else {
            var t = []
            pyERxAppendGroups(t, re, s, m)
            out.push(t)
        }
        if (m["end"] == m["begin"]) { at = m["end"] + 1 } else { at = m["end"] }
    }
    return out
}

// pyERxIsSpecial is the membership test of Go rxPyEscape's `special` constant,
// "()[]{}?*+-|^$\\.&~# \t\n\r\v\f", written by code point because \v and \f are
// not spellable as string escapes in this dialect.
function pyERxIsSpecial(c) {
    if (c == 40 || c == 41) { return true }        // ( )
    if (c == 91 || c == 93) { return true }        // [ ]
    if (c == 123 || c == 125) { return true }      // { }
    if (c == 63 || c == 42 || c == 43) { return true }  // ? * +
    if (c == 45 || c == 124) { return true }       // - |
    if (c == 94 || c == 36) { return true }        // ^ $
    if (c == 92 || c == 46) { return true }        // \ .
    if (c == 38 || c == 126 || c == 35) { return true } // & ~ #
    if (c == 32) { return true }                   // space
    if (c >= 9 && c <= 13) { return true }         // \t \n \v \f \r
    return false
}

// pyERxEscape is Go rxPyEscape - re.escape, CPython 3.7+: exactly the characters
// in _special_chars_map.
function pyERxEscape(s) {
    var out = ""
    var i = 0
    while (i < s.length) {
        var c = s.charCodeAt(i)
        if (c < 128 && pyERxIsSpecial(c)) { out = out + "\\" }
        out = out + s.charAt(i)
        i = i + 1
    }
    return out
}

// ----- Dispatch -----

// argAt: the i'th argument, or undefined past the end. Also used by the
// builtin method table below.
function pyEArgAt(args, i) {
    if (i < args.length) { return args[i] }
    return undefined
}

// pyERxArgRe is Go (*jsrt).rxPyArgRe.
function pyERxArgRe(v, flags) {
    if (pyERxIsRe(v)) { return v }
    return pyERxCompile(pyToStr(v), flags)
}

// pyERxIntArg is Go rxPyIntArg: a missing or non-numeric argument is 0.
function pyERxIntArg(args, i) {
    if (i < args.length) {
        if (typeof args[i] == "number") { return Math.trunc(args[i]) }
    }
    return 0
}

// pyERxKeyArg is Go rxPyKeyArg.
function pyERxKeyArg(a) {
    if (a.length > 0) { return a[0] }
    return 0
}

// pyERxModCall is Go (*jsrt).rxPyModCall - re.f(pattern, ...). Every one of those
// is the compiled pattern's own method with the pattern dropped, so the two entry
// points share one body; the only difference is where the optional flags argument
// sits.
function pyERxModCall(name, args) {
    if (name == "escape") { return pyERxEscape(pyToStr(pyEArgAt(args, 0))) }
    if (name == "purge") { return undefined }
    if (name == "compile") { return pyERxArgRe(pyEArgAt(args, 0), pyERxIntArg(args, 1)) }
    var flpos = -1
    if (name == "search" || name == "match" || name == "fullmatch" ||
        name == "findall" || name == "finditer") {
        flpos = 2
    } else if (name == "sub" || name == "subn") {
        flpos = 4
    } else if (name == "split") {
        flpos = 3
    } else {
        fail("unknown re function: " + name)
    }
    var rv = pyERxArgRe(pyEArgAt(args, 0), pyERxIntArg(args, flpos))
    var rest = []
    var i = 1
    while (i < args.length && i < flpos) {
        rest.push(args[i])
        i = i + 1
    }
    return pyERxReMethod(rv, name, rest)
}

// pyERxReMethod is Go (*jsrt).rxPyReMethod.
function pyERxReMethod(rv, name, a) {
    if (name == "search") { return pyERxSearch(rv, pyToStr(pyEArgAt(a, 0)), pyERxIntArg(a, 1)) }
    if (name == "match") { return pyERxAnchored(rv, pyToStr(pyEArgAt(a, 0)), pyERxIntArg(a, 1), false) }
    if (name == "fullmatch") { return pyERxAnchored(rv, pyToStr(pyEArgAt(a, 0)), pyERxIntArg(a, 1), true) }
    if (name == "findall") { return pyERxFindAll(rv, pyToStr(pyEArgAt(a, 0)), false) }
    if (name == "finditer") { return pyERxFindAll(rv, pyToStr(pyEArgAt(a, 0)), true) }
    if (name == "sub" || name == "subn") {
        var r = pyERxSub(rv, pyEArgAt(a, 0), pyToStr(pyEArgAt(a, 1)), pyERxIntArg(a, 2))
        if (name == "sub") { return r["text"] }
        return [r["text"], r["n"]]
    }
    if (name == "split") { return pyERxSplit(rv, pyToStr(pyEArgAt(a, 0)), pyERxIntArg(a, 1)) }
    fail("unknown Pattern method: " + name)
    return undefined
}

// pyERxMatchMethod is Go (*jsrt).rxPyMatchMethod.
function pyERxMatchMethod(md, name, a) {
    if (name == "group") {
        if (a.length == 0) { return pyERxGroup(md, 0) }
        if (a.length == 1) { return pyERxGroup(md, a[0]) }
        var out = []
        var i = 0
        while (i < a.length) {
            out.push(pyERxGroup(md, a[i]))
            i = i + 1
        }
        return out
    }
    if (name == "groups") { return pyERxGroups(md) }
    if (name == "groupdict") { return pyERxGroupDict(md) }
    if (name == "start") { return pyERxSpan(md, pyERxKeyArg(a), 0) }
    if (name == "end") { return pyERxSpan(md, pyERxKeyArg(a), 1) }
    if (name == "span") {
        var k = pyERxKeyArg(a)
        return [pyERxSpan(md, k, 0), pyERxSpan(md, k, 1)]
    }
    if (name == "expand") {
        var mo = pyERxMatchOf(md)
        return rxExpand(mo["re"], mo["text"], mo["m"], pyERxTemplate(pyToStr(pyEArgAt(a, 0))))
    }
    fail("unknown Match method: " + name)
    return undefined
}

// pyERxRepr is Go rxPyRepr: a pattern and a match the way CPython's repr does,
// so str(m)/print(m) agree with the interpreter grammar. Go returns
// (string, bool); the pair travels in a record here.
function pyERxRepr(v) {
    if (pyERxIsRe(v)) {
        var pat = v["pattern"]
        if (typeof pat != "string") { pat = "" }
        return {ok: true, s: "re.compile('" + pat + "')"}
    }
    if (pyERxIsMatch(v)) {
        var mo = pyERxMatchOf(v)
        var w = rxGroup(mo["re"], mo["text"], mo["m"], 0)
        // Go's `g, _ := re.group(...)` leaves g as "" when the group did not
        // participate; regex.js answers null there.
        return {ok: true, s: "<re.Match object; span=(" + pyStr(mo["m"]["begin"]) + ", " +
                             pyStr(mo["m"]["end"]) + "), match='" + (w === null ? "" : w) + "'>"}
    }
    return {ok: false, s: ""}
}

// ----- The externs -----

// js_pyrxmcall is the method-call wrapper: the re module, a compiled pattern and
// a match dispatch here, everything else goes straight on to js_pymcall. The
// keyword dict is carried through untouched, exactly as the Go twin does - no re
// method takes a keyword argument in this dialect.
function js_pyrxmcall(target, name, args, kw) {
    // The `math` module rides the same dispatcher: js_pyrxmcall is the ONE
    // extern the python emitter routes every method call through, and a module
    // object is not an instance, a class, a dict or a list, so nothing further
    // down js_pymcall would find it.
    if (pyMIsMathMod(target)) {
        if (!pyIsArr(args)) { fail("js_pyrxmcall args must be an array") }
        return pyMathCall(pyToStr(name), args)
    }
    if (pyERxIsMod(target) || pyERxIsRe(target) || pyERxIsMatch(target)) {
        if (!pyIsArr(args)) { fail("js_pyrxmcall args must be an array") }
        var nm = pyToStr(name)
        if (pyERxIsMod(target)) { return pyERxModCall(nm, args) }
        if (pyERxIsRe(target)) { return pyERxReMethod(target, nm, args) }
        return pyERxMatchMethod(target, nm, args)
    }
    return js_pymcall(target, name, args, kw)
}

// ================================================ the `math` module ========
//
// Go twin: abnf/jsrtpymath.go. Interpreter: hostGlobals["math"] plus pyMathCall
// in languages/python-interpreter.abnf.
//
// Every arm routes to the host `Math`, which the C floor seeds in full
// (runtime.c host ids 51-93) - d_pow / d_exp / d_log / d_sqrt already exist in
// the floor and must NOT be reimplemented here. What is NOT in Math is written
// out: expm1, log1p, fmod, copysign, gcd, lcm and factorial.
//
// THE ANSWER'S TYPE IS PART OF THE SPECIFICATION, and CPython is not uniform:
// sqrt / exp / log / pow / fabs / hypot / atan2 and the trigonometric family
// answer a FLOAT (math.pow(2, 10) is 1024.0), floor / ceil / trunc / gcd /
// factorial answer an INT, and isnan / isinf / isfinite answer a bool. A float
// is the {__flo} box; a plain number is an int.
//
// The module is a plain object with no function members, dispatched BY NAME
// through js_pyrxmcall: twenty-five stored closures would be twenty-five floor
// cells held forever (live data costs, see pyBBFnObjs).

// ----- the `builtins` module -------------------------------------------------
//
// CPython's len.__self__ IS the builtins module, and `builtins.len is len`
// holds. The emitter fills this object at boot from the very scope bindings the
// global names resolve to (see the builtins-module block of
// languages/python-to-llvm-ir.abnf), so the identity is not a copy.
// ONE builtins module per run, remembered so len.__self__ can answer it without
// a scope lookup layer 2 has no way to make.
var pyDBuiltinsMod = null

function js_pybuiltins_module() {
    if (pyDBuiltinsMod === null) { pyDBuiltinsMod = {__pymod: "builtins"} }
    return pyDBuiltinsMod
}

// Is `name` a function this math module offers? One list, consulted by the
// attribute read (`f = math.sqrt`) and by hasattr; the CALL path does not need
// it, because pyMathCall's own fall-through raises the AttributeError. Keep in
// step with pyMathNames in languages/python-interpreter.abnf and pyMathHas in
// abnf/jsrtpymath.go.
function pyMHas(name) {
    if (name == "sqrt" || name == "exp" || name == "expm1" || name == "log") { return true }
    if (name == "log1p" || name == "log2" || name == "log10" || name == "pow") { return true }
    if (name == "fabs" || name == "fmod" || name == "copysign" || name == "atan2") { return true }
    if (name == "hypot" || name == "sin" || name == "cos" || name == "tan") { return true }
    if (name == "asin" || name == "acos" || name == "atan" || name == "sinh") { return true }
    if (name == "cosh" || name == "tanh" || name == "degrees" || name == "radians") { return true }
    if (name == "floor" || name == "ceil" || name == "trunc" || name == "gcd") { return true }
    if (name == "lcm" || name == "factorial" || name == "isnan" || name == "isinf") { return true }
    if (name == "isfinite" || name == "isclose") { return true }
    return false
}

function js_pymath_module() {
    return {
        __pymod: "math",
        pi: pyMkFlo(3.141592653589793),
        e: pyMkFlo(2.718281828459045),
        tau: pyMkFlo(6.283185307179586),
        inf: pyMkFlo(pyMInf()),
        nan: pyMkFlo(pyMNaN())
    }
}

// MetaJS has no exponent literal (1e308 parses as the identifier e308), so an
// infinity is BUILT. A NaN comes from an invalid operation.
function pyMInf() { return Math.pow(2, 1024) }
function pyMNaN() { return Math.pow(2, 1024) - Math.pow(2, 1024) }

function pyMIsMathMod(v) {
    if (!pyIsObj(v)) { return false }
    return v["__pymod"] === "math"
}

function pyMArg(args, i) {
    if (i >= args.length) { fail("math: missing argument") }
    return pyNum(args[i])
}

// CPython 3.14's own domain-error texts, which quote the offending operand as a
// FLOAT repr ("expected a nonnegative input, got -1.0").
function pyMDom(kind, v) {
    var got = pyStr(pyMkFlo(v))
    if (kind == "nonneg") { pyRaiseExc("ValueError", "expected a nonnegative input, got " + got) }
    if (kind == "pos") { pyRaiseExc("ValueError", "expected a positive input, got " + got) }
    if (kind == "unit") { pyRaiseExc("ValueError", "expected a number in range from -1 up to 1, got " + got) }
    pyRaiseExc("ValueError", "expected argument value > -1, got " + got)
}

// floor / ceil / trunc must answer an INT, and there is no int for a non-finite
// operand, so CPython raises rather than answering an infinity.
function pyMInt(f) {
    // CPython splits the two: an INFINITY is an OverflowError (there is no such
    // int) and a NaN a ValueError, and the two texts differ as well.
    if (f !== f) { pyRaiseExc("ValueError", "cannot convert float NaN to integer") }
    if (f === pyMInf() || f === 0 - pyMInf()) {
        pyRaiseExc("OverflowError", "cannot convert float infinity to integer")
    }
    return f
}

function pyMGcd2(a, b) {
    var x = Math.abs(Math.trunc(a))
    var y = Math.abs(Math.trunc(b))
    while (y !== 0) {
        var t = x - Math.floor(x / y) * y
        x = y
        y = t
    }
    return x
}

// Beyond 20! the product leaves the exact-double range, so it is finished on the
// arbitrary-precision integer this value model already carries - which is what
// makes math.factorial(30) CPython's exact answer rather than a rounded double.
function pyMFactorial(n) {
    if (n <= 20) {
        var r = 1
        var i = 2
        while (i <= n) { r = r * i; i = i + 1 }
        return r
    }
    var acc = rtABigFromNum(1)
    var k = 2
    while (k <= n) { acc = rtABigMul(acc, rtABigFromNum(k)); k = k + 1 }
    return rtABigNarrow(acc)
}

function pyMathCall(name, args) {
    if (name == "sqrt") {
        var sq = pyMArg(args, 0)
        if (sq < 0) { pyMDom("nonneg", sq) }
        return pyMkFlo(Math.sqrt(sq))
    }
    if (name == "exp") { return pyMkFlo(Math.exp(pyMArg(args, 0))) }
    if (name == "expm1") { return pyMkFlo(Math.expm1(pyMArg(args, 0))) }
    if (name == "log") {
        var lg = pyMArg(args, 0)
        if (lg <= 0) { pyMDom("pos", lg) }
        if (args.length > 1) {
            // math.log(x, 1) divides by log(1) == 0: CPython raises
            // ZeroDivisionError, not a domain error.
            var lb = Math.log(pyMArg(args, 1))
            if (lb === 0) { pyRaiseExc("ZeroDivisionError", "division by zero") }
            return pyMkFlo(Math.log(lg) / lb)
        }
        return pyMkFlo(Math.log(lg))
    }
    if (name == "log1p") {
        var l1 = pyMArg(args, 0)
        if (l1 <= 0 - 1) { pyMDom("gt", l1) }
        return pyMkFlo(Math.log1p(l1))
    }
    if (name == "log2") {
        var l2 = pyMArg(args, 0)
        if (l2 <= 0) { pyMDom("pos", l2) }
        return pyMkFlo(Math.log2(l2))
    }
    if (name == "log10") {
        var l10 = pyMArg(args, 0)
        if (l10 <= 0) { pyMDom("pos", l10) }
        return pyMkFlo(Math.log10(l10))
    }
    if (name == "pow") { return pyMkFlo(Math.pow(pyMArg(args, 0), pyMArg(args, 1))) }
    if (name == "fabs") { return pyMkFlo(Math.abs(pyMArg(args, 0))) }
    if (name == "fmod") {
        var fa = pyMArg(args, 0)
        var fb = pyMArg(args, 1)
        return pyMkFlo(fa - Math.trunc(fa / fb) * fb)
    }
    if (name == "copysign") {
        var cm = Math.abs(pyMArg(args, 0))
        var cs = pyMArg(args, 1)
        // The sign BIT, not `cs < 0`: copysign(1, -0.0) is -1.0 in CPython. A
        // negative zero is recognised by 1/x being negative infinity, and the
        // negation divides by -1 rather than subtracting.
        if (cs < 0 || (cs === 0 && 1 / cs < 0)) { return pyMkFlo(cm / (0 - 1)) }
        return pyMkFlo(cm)
    }
    if (name == "atan2") { return pyMkFlo(Math.atan2(pyMArg(args, 0), pyMArg(args, 1))) }
    if (name == "hypot") {
        var mx = 0
        var i = 0
        while (i < args.length) {
            var av = Math.abs(pyNum(args[i]))
            if (av === pyMInf()) { return pyMkFlo(pyMInf()) }
            if (av > mx) { mx = av }
            i = i + 1
        }
        if (mx === 0) { return pyMkFlo(0) }
        var sum = 0
        var j = 0
        while (j < args.length) {
            var t2 = pyNum(args[j]) / mx
            sum = sum + t2 * t2
            j = j + 1
        }
        return pyMkFlo(mx * Math.sqrt(sum))
    }
    if (name == "sin") { return pyMkFlo(Math.sin(pyMArg(args, 0))) }
    if (name == "cos") { return pyMkFlo(Math.cos(pyMArg(args, 0))) }
    if (name == "tan") { return pyMkFlo(Math.tan(pyMArg(args, 0))) }
    if (name == "asin") {
        var as1 = pyMArg(args, 0)
        if (as1 < 0 - 1 || as1 > 1) { pyMDom("unit", as1) }
        return pyMkFlo(Math.asin(as1))
    }
    if (name == "acos") {
        var ac1 = pyMArg(args, 0)
        if (ac1 < 0 - 1 || ac1 > 1) { pyMDom("unit", ac1) }
        return pyMkFlo(Math.acos(ac1))
    }
    if (name == "atan") { return pyMkFlo(Math.atan(pyMArg(args, 0))) }
    if (name == "sinh") { return pyMkFlo(Math.sinh(pyMArg(args, 0))) }
    if (name == "cosh") { return pyMkFlo(Math.cosh(pyMArg(args, 0))) }
    if (name == "tanh") { return pyMkFlo(Math.tanh(pyMArg(args, 0))) }
    if (name == "degrees") { return pyMkFlo(pyMArg(args, 0) * (180 / 3.141592653589793)) }
    if (name == "radians") { return pyMkFlo(pyMArg(args, 0) * (3.141592653589793 / 180)) }
    if (name == "floor") { return pyMInt(Math.floor(pyMArg(args, 0))) }
    if (name == "ceil") { return pyMInt(Math.ceil(pyMArg(args, 0))) }
    if (name == "trunc") { return pyMInt(Math.trunc(pyMArg(args, 0))) }
    if (name == "gcd") {
        if (args.length == 0) { return 0 }
        var g = Math.abs(Math.trunc(pyNum(args[0])))
        var gi = 1
        while (gi < args.length) { g = pyMGcd2(g, pyNum(args[gi])); gi = gi + 1 }
        return g
    }
    if (name == "lcm") {
        if (args.length == 0) { return 1 }
        var l = Math.abs(Math.trunc(pyNum(args[0])))
        var li = 1
        while (li < args.length) {
            var lb = Math.abs(Math.trunc(pyNum(args[li])))
            if (l === 0 || lb === 0) { return 0 }
            l = l / pyMGcd2(l, lb) * lb
            li = li + 1
        }
        return l
    }
    if (name == "factorial") {
        var fn = pyMArg(args, 0)
        if (fn < 0 || Math.trunc(fn) !== fn) {
            pyRaiseExc("ValueError", "factorial() not defined for negative values")
        }
        return pyMFactorial(fn)
    }
    if (name == "isnan") { var nn = pyMArg(args, 0); return nn !== nn }
    if (name == "isinf") {
        var iv = pyMArg(args, 0)
        return iv === pyMInf() || iv === 0 - pyMInf()
    }
    if (name == "isfinite") {
        var fv = pyMArg(args, 0)
        return fv === fv && fv !== pyMInf() && fv !== 0 - pyMInf()
    }
    if (name == "isclose") {
        var ca = pyMArg(args, 0)
        var cb = pyMArg(args, 1)
        if (ca === cb) { return true }
        if (ca !== ca || cb !== cb) { return false }
        if (ca === pyMInf() || ca === 0 - pyMInf()) { return false }
        if (cb === pyMInf() || cb === 0 - pyMInf()) { return false }
        return Math.abs(ca - cb) <= 0.000000001 * Math.max(Math.abs(ca), Math.abs(cb))
    }
    pyRaiseExc("AttributeError", "module 'math' has no attribute '" + name + "'")
}


// js_pyrxstr is str()/print() of a pattern or a match. The Go twin falls through
// to the js_pystr extern; here it falls through to the prelude's pyStr, which is
// that extern's whole body (Go rt.pyString).
function js_pyrxstr(v) {
    var r = pyERxRepr(v)
    if (r["ok"]) { return r["s"] }
    return pyStr(v)
}

// ===================================================== js_pymcall ===========
//
// abnf/jsrt.go's js_pymcall: a METHOD CALL. python-to-llvm-ir.abnf never emits it
// directly - js_pyrxmcall intercepts the `re` module, a Pattern and a
// Match first and falls through to here - so it is not in the export list the
// emitter needs, but it IS the entry point of the whole method surface.
function js_pymcall(target, name, args, kw) { return pyDMethodCall(target, name, args, kw) }

// ============================================================================
// The builtin method table (the pyF* helpers).
//
// Ports abnf/jsrt.go's memberCall(target, name, args) for the Python value
// model. The entry point is deliberately NOT prefixed: pyDMethodCall calls it by
// exactly this name as its final fall-through
// (js_pyrxmcall -> js_pymcall -> pyDMethodCall -> pyMemberCall).
//
// Go's memberCall is the LANGUAGE-NEUTRAL dispatcher shared by Java, Kotlin,
// Go, Dart and Python. Python's own method surface (str methods, the list, dict
// and set surfaces, the generator protocol, `re`) is answered in pyDMethodCall
// before this is reached, and pyDForeign denies the other languages' method
// names first, so what is left here is mostly the error arms.
// ============================================================================

// rt.typeOf, for the final failure message only. The one place
// it differs from the floor's own `typeof` is the arbitrary-precision integer:
// Go's *jsBigInt answers "bigint", while layer 2 represents it as a plain
// object, which `typeof` would call "object".
function pyFTypeOf(v) {
    if (pyIsBig(v)) { return "bigint" }
    return typeof v
}

// pyFCopyArr is SHARED as rtCopyArr - lib/runtime.metajs.

// ---------------------------------------------------------------- strings ---

// The string arm of memberCall - the "Java style builtins" - and NONE of them
// is ported: length / charAt / equals / substring / indexOf / isEmpty are
// Java's and Kotlin's spellings, and CPython raises AttributeError for every
// one of them. pyDForeign denies all six before this table is reached, exactly
// as abnf/jsrt.go's pyForeignMethod does, so what is left is the error arm.
//
// The function itself stays because pyMemberCall dispatches on the RECEIVER and
// pyStrMethod (the real Python string library) dispatches by NAME: a name
// neither knows has to land somewhere and say so.
function pyFStrMethod(o, name, args) {
    fail("unknown String method: " + name)
    return null
}

// ------------------------------------------------------------------ lists ---

// The *jsArray arm of memberCall. Go's o.dropIdx() invalidates the array's dict
// index cache before a mutation; layer 2 has no such cache, so those calls have
// no counterpart and are simply absent.
function pyFListMethod(o, name, args) {
    if (name == "append") {
        // Python: returns None.
        o.push(pyEArgAt(args, 0))
        return undefined
    }
    if (name == "pop") {
        // Python: removes and returns the last element. Go's arm takes NO index
        // argument; pyListMethod answers Python's pop(i) before this is reached.
        if (o.length == 0) { fail("pop from empty list") }
        return o.pop()
    }
    // add / size / get / contains / map / filter / any / sumOf / forEach are
    // KOTLIN's, Java's, Dart's and Swift's list methods and are NOT ported:
    // CPython raises AttributeError for every one of them and pyDForeign denies
    // them before this table is reached. The Go twin still HAS them, because
    // nine languages share that table.
    //
    // `count` is not among them: Python HAS list.count(x), and it counts EQUAL
    // elements where the Go twin's shared arm counts a Kotlin PREDICATE's
    // successes. pyDMethodCall answers it before reaching here (pyDListCount),
    // so this table never sees the name.
    fail("unknown list method '" + name + "'")
    return null
}

// ------------------------------------------------------------------ dicts ---

// The dict prefix of the *jsObject arm of memberCall. dictParts requires
// __dict === true AND both keys and vals to be arrays; the prelude's pyIsDict
// is that test.
//
// UNREACHABLE FROM PYTHON: pyDMethodCall answers the whole dict surface
// (pyDictMethod) before pyMemberCall is ever reached. The function stays for
// the reason pyFStrMethod does: pyMemberCall dispatches on the RECEIVER, so a
// name nothing knows has to land somewhere and say so.
function pyFDictMethod(o, name, args) {
    if (name == "keys") { return rtCopyArr(o["keys"]) }
    if (name == "values") { return rtCopyArr(o["vals"]) }
    if (name == "get") {
        var i = pyDictFind(o["keys"], pyEArgAt(args, 0))
        if (i >= 0) { return o["vals"][i] }
        if (args.length > 1) { return args[1] }
        return undefined
    }
    fail("unknown dict method '" + name + "'")
    return null
}

// ------------------------------------------------------- memberCall itself ---

// memberCall. The method call convention the class based
// language subsets share: instances are objects with a "__class" property
// pointing to their class descriptor object, whose properties hold the method
// closures (called with the instance prepended to the arguments); the lookup
// follows the descriptor's "__super" chain, which gives single inheritance.
// Objects without __class (class descriptors with static methods, plain objects
// with function properties) call the property directly. Strings get the Java
// style builtins.
//
// ORDER: Go dispatches on the Go TYPE, so its arms are disjoint and their order
// is immaterial. Layer 2 has no tags, so the order here is load bearing - a
// generator cell and a __pybig would both answer pyIsObj, and both must be
// taken out of the way before the plain-object arm. That is the only structural
// departure from the Go.
function pyMemberCall(target, name, args) {
    if (pyIsStr(target)) { return pyFStrMethod(target, name, args) }
    if (pyIsArr(target)) { return pyFListMethod(target, name, args) }
    if (pyIsDict(target)) { return pyFDictMethod(target, name, args) }
    if (pyIsGen(target)) {
        // A generator's protocol (next, return, ...) lives in its MEMBER TABLE -
        // the *jsGenerator case of getMember - and not in a property map, so a
        // method call resolves the member and calls it. Delegating rather than
        // repeating the member names here keeps the two in step and stays
        // language neutral: every member getMember exposes is callable as a
        // method, in every grammar that emits js_mcall.
        //
        // Layer 2's equivalent of getMember on a generator is a member read off
        // the floor cell, and the closure it answers is bound to the cell, so it
        // is applied WITH the cell as its receiver (Go's getMember hands back an
        // already-bound *boundMethod and then calls it with jsUndef; the two are
        // the same call). Note that Python's own send/next/__next__/close never
        // arrive here - pyDMethodCall answers them first, with the
        // StopIteration protocol - so this arm covers only the raw JS-shaped
        // members such as `return`.
        var gm = target[name]
        if (gm !== undefined && pyIsCallable(gm)) { return gm.apply(target, args) }
        fail("unknown method '" + name + "' on a generator")
        return null
    }
    // An arbitrary-precision integer is a *jsBigInt in Go - NOT a *jsObject - so
    // it must skip the object arm and land on the final failure, which reports
    // its type as "bigint".
    if (!pyIsBig(target) && pyIsObj(target)) {
        var cls = target["__class"]
        if (cls !== undefined) {
            // The lookup follows the __super chain (single inheritance).
            while (cls !== undefined && cls !== null) {
                if (!pyIsObj(cls)) { break }
                var m = cls[name]
                if (m !== undefined && pyIsCallable(m)) {
                    var argv = [target]
                    var i = 0
                    while (i < args.length) {
                        argv.push(args[i])
                        i = i + 1
                    }
                    return m.apply(undefined, argv)
                }
                cls = cls["__super"]
            }
            fail("unknown method '" + name + "' on an instance")
            return null
        }
        // Go reads o.props[name] - the object's OWN property map. A bare member
        // read here also sees Object.prototype under goja, so a method call
        // literally named "toString" / "valueOf" / "constructor" on a plain
        // object would find an inherited function and call it instead of
        // failing. The same collision is left standing in pyDMethodCall's
        // instance arm and in pyGetAttr, because guarding it with a "$" prefix
        // here would desynchronize this lookup from the one that stores the
        // attributes.
        var own = target[name]
        if (own !== undefined && pyIsCallable(own)) { return own.apply(undefined, args) }
        fail("unknown method '" + name + "'")
        return null
    }
    fail("method call '" + name + "' on a " + pyFTypeOf(target))
    return null
}

// ---- the four engine adapters this chapter is written against ----
function pySFail(msg) { fail(msg) }
// A CATCHABLE KeyError, for the one place in the str-method chunk where CPython
// raises rather than aborts: "{a}".format(b=1). pySFail is the engine's abort
// and cannot be caught.
function pySRaiseKey(nm) { pyRaiseExc("KeyError", nm) }
function pySFormat1(v, spec, conv) { return js_pyformat(v, spec, conv) }
function pySGetAttr(v, nm) { return pyGetAttr(v, nm) }
function pySGetItem(v, k) { return js_pyget(v, k) }
function pySIsArr(v) { return pyIsArr(v) }
function pySTruthy(v) { return pyATruthy(v) }
function pySKwGet(kw, nm) {
    var r = anytype
    r = undefined
    if (kw !== null && kw !== undefined) {
        if (pyIsDict(kw)) {
            var i = pyDictFind(kw["keys"], nm)
            if (i >= 0) { return kw["vals"][i] }
        }
    }
    pySRaiseKey(nm)
    return r
}
// ===================================================== str methods ==========
//
// Python's str method library. Written ONCE and carried in three engines -
// languages/python-interpreter.abnf, languages/lib/python-rt.metajs (this text,
// verbatim) and abnf/pystrmethod.go (a line-by-line Go port) - because a Python
// method call reaches a different implementation in each (interpreter /
// llvm.Run's Go twin / the native C floor + layer 2).
//
// Everything below is built out of the seven string primitives the frozen MetaJS
// subset has (.length, charAt, charCodeAt, substring, indexOf, toUpperCase,
// toLowerCase) plus String.fromCharCode, so that the same source compiles in the
// tag-script host AND through metajs-to-llvm-ir.abnf.
//
// INDEXING. CPython counts CODE POINTS; the floor's strings are UTF-16 and
// js_pyget already indexes a string by CODE UNIT (an inconsistency this project
// records rather than repairs, see the manual 7.9). The search/slice methods here
// therefore work in code UNITS and the length-shaped ones (len via center/ljust/
// rjust/zfill, and the per-character walks of title/swapcase/upper/lower) work in
// code POINTS. For any string inside the BMP - which is everything the corpus and
// the suite contain - the two coincide exactly.
//
// CASE MAPPING is done per code point WITH A LENGTH GUARD: goja's toUpperCase is
// ECMAScript's FULL mapping ("ss" from "ß") while the frozen engine's is Go's
// strings.ToUpper and the C floor's is Go's unicode table, both of which are the
// SIMPLE mapping. Rejecting any mapping that changes the unit count makes all
// three engines agree; the price is that "ß".upper() is "ß" here and
// "SS" in CPython. U+0130 is the one residual: the floor maps it to "i" while the
// other two answer a two-unit sequence that the guard rejects.
//
// CLASSIFICATION (isalpha / isdigit / isspace / isupper / islower) is ASCII-exact.
// Outside ASCII, "cased" is derived from the case mapping (upper != lower), which
// covers Latin, Greek and Cyrillic; isdigit is ASCII-only, so CPython's Arabic-Indic
// digits answer False here. isspace carries the Unicode space code points by hand.
//
// NOT CARRIED: bytes. `encode()` answers the string itself, because there is no
// bytes type in this value model - CPython prints b'abc'.

// ---- the character primitives ----

// The UTF-16 unit width of the code point starting at i.
function pySCPW(s, i) {
    var c = s.charCodeAt(i)
    if (c >= 55296 && c <= 56319 && i + 1 < s.length) {
        var t = s.charCodeAt(i + 1)
        if (t >= 56320 && t <= 57343) { return 2 }
    }
    return 1
}

// The code points of s, each as a one- or two-unit string.
function pySChars(s) {
    var out = []
    var i = 0
    while (i < s.length) {
        var w = pySCPW(s, i)
        out.push(s.substring(i, i + w))
        i = i + w
    }
    return out
}

function pySUpCh(ch) {
    var c = ch.charCodeAt(0)
    if (c < 128) {
        if (c >= 97 && c <= 122) { return String.fromCharCode(c - 32) }
        return ch
    }
    var u = ch.toUpperCase()
    if (u.length != ch.length) { return ch }
    return u
}

function pySLoCh(ch) {
    var c = ch.charCodeAt(0)
    if (c < 128) {
        if (c >= 65 && c <= 90) { return String.fromCharCode(c + 32) }
        return ch
    }
    var u = ch.toLowerCase()
    if (u.length != ch.length) { return ch }
    return u
}

// CASED CHARACTERS THE SIMPLE MAPPING LEAVES ALONE. CPython's cased / lower /
// upper tests read the Unicode Lowercase and Uppercase properties, and some
// characters carry one with no single-character mapping to tell: sharp s (whose
// upper case is "SS"), kra, the IPA and modifier letters, the mathematical
// alphanumerics. Without these, "straße".title() would start a word after the ß.
// [lo, hi] code point pairs, generated with CPython 3.14 (Unicode 16) over every
// code point Go's simple mapping fixes.
var pySLowOnly = [
    170, 170, 186, 186, 223, 223, 312, 312, 329, 329, 397, 397, 426, 427, 442, 442,
    446, 446, 496, 496, 545, 545, 564, 569, 597, 597, 600, 600, 602, 602, 605, 607,
    610, 610, 615, 615, 621, 622, 624, 624, 627, 628, 630, 636, 638, 639, 641, 641,
    644, 646, 653, 657, 659, 659, 661, 668, 671, 696, 704, 705, 736, 740, 890, 890,
    912, 912, 944, 944, 1020, 1020, 1376, 1376, 1415, 1416, 4348, 4348, 7424, 7544,
    7546, 7548, 7550, 7565, 7567, 7615, 7830, 7834, 7836, 7837, 7839, 7839, 8016, 8016,
    8018, 8018, 8020, 8020, 8022, 8022, 8114, 8114, 8116, 8116, 8118, 8119, 8130, 8130,
    8132, 8132, 8134, 8135, 8146, 8147, 8150, 8151, 8162, 8164, 8166, 8167, 8178, 8178,
    8180, 8180, 8182, 8183, 8305, 8305, 8319, 8319, 8336, 8348, 8458, 8458, 8462, 8463,
    8467, 8467, 8495, 8495, 8500, 8500, 8505, 8505, 8508, 8509, 8518, 8521, 11377,
    11377, 11380, 11380, 11383, 11389, 11492, 11492, 42652, 42653, 42800, 42801, 42864,
    42872, 42894, 42894, 42901, 42901, 42927, 42927, 42994, 42996, 43000, 43002, 43824,
    43858, 43860, 43866, 43868, 43881, 64256, 64262, 64275, 64279, 67456, 67456, 67459,
    67461, 67463, 67504, 67506, 67514, 119834, 119859, 119886, 119892, 119894, 119911,
    119938, 119963, 119990, 119993, 119995, 119995, 119997, 120003, 120005, 120015,
    120042, 120067, 120094, 120119, 120146, 120171, 120198, 120223, 120250, 120275,
    120302, 120327, 120354, 120379, 120406, 120431, 120458, 120485, 120514, 120538,
    120540, 120545, 120572, 120596, 120598, 120603, 120630, 120654, 120656, 120661,
    120688, 120712, 120714, 120719, 120746, 120770, 120772, 120777, 120779, 120779,
    122624, 122633, 122635, 122654, 122661, 122666, 122928, 122989
]
var pySUpOnly = [
    978, 980, 8450, 8450, 8455, 8455, 8459, 8461, 8464, 8466, 8469, 8469, 8473, 8477,
    8484, 8484, 8488, 8488, 8492, 8493, 8496, 8497, 8499, 8499, 8510, 8511, 8517, 8517,
    119808, 119833, 119860, 119885, 119912, 119937, 119964, 119964, 119966, 119967,
    119970, 119970, 119973, 119974, 119977, 119980, 119982, 119989, 120016, 120041,
    120068, 120069, 120071, 120074, 120077, 120084, 120086, 120092, 120120, 120121,
    120123, 120126, 120128, 120132, 120134, 120134, 120138, 120144, 120172, 120197,
    120224, 120249, 120276, 120301, 120328, 120353, 120380, 120405, 120432, 120457,
    120488, 120512, 120546, 120570, 120604, 120628, 120662, 120686, 120720, 120744,
    120778, 120778, 127280, 127305, 127312, 127337, 127344, 127369
]
function pySInRanges(t, c) {
    var lo = 0
    var hi = t.length / 2 - 1
    while (lo <= hi) {
        var mid = Math.floor((lo + hi) / 2)
        if (c < t[2 * mid]) { hi = mid - 1 }
        else if (c > t[2 * mid + 1]) { lo = mid + 1 }
        else { return true }
    }
    return false
}
// The TITLECASE letters (category Lt): neither upper nor lower case to CPython,
// but they open a title-cased word the way an uppercase letter does.
var pySTitleOnly = [453, 453, 456, 456, 459, 459, 498, 498, 8072, 8079, 8088, 8095, 8104, 8111, 8124, 8124, 8140, 8140, 8188, 8188]
// 1 for a lowercase and 2 for an uppercase character of those tables, 3 for a
// titlecase one, else 0.
function pySCaseOnly(ch) {
    var c = ch.charCodeAt(0)
    if (c < 170) { return 0 }
    if (ch.length == 2) { c = (c - 55296) * 1024 + (ch.charCodeAt(1) - 56320) + 65536 }
    if (pySInRanges(pySTitleOnly, c)) { return 3 }
    if (pySInRanges(pySLowOnly, c)) { return 1 }
    if (pySInRanges(pySUpOnly, c)) { return 2 }
    return 0
}

function pySIsCased(ch) { return pySUpCh(ch) != pySLoCh(ch) || pySCaseOnly(ch) != 0 }
// The character that opens a title-cased word: the titlecase form of the four
// Latin digraphs (U+01C4..U+01CC, U+01F1..U+01F3 - DZ, LJ, NJ, DZ), whose
// titlecase differs from their uppercase, else the uppercase.
function pySTiCh(ch) {
    var c = ch.charCodeAt(0)
    if (c >= 452 && c <= 460) { return String.fromCharCode(c - (c - 452) % 3 + 1) }
    if (c >= 497 && c <= 499) { return String.fromCharCode(498) }
    return pySUpCh(ch)
}
function pySIsUpCh(ch) {
    var k = pySCaseOnly(ch)
    if (k != 0) { return k == 2 }
    var u = pySUpCh(ch)
    return u != pySLoCh(ch) && ch == u
}
function pySIsLoCh(ch) {
    var k = pySCaseOnly(ch)
    if (k != 0) { return k == 1 }
    var l = pySLoCh(ch)
    return pySUpCh(ch) != l && ch == l
}

function pySIsAlphaCh(ch) {
    var c = ch.charCodeAt(0)
    if (c < 128) { return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) }
    return pySIsCased(ch)
}

function pySIsDigitCh(ch) {
    var c = ch.charCodeAt(0)
    return c >= 48 && c <= 57
}

// Py_UNICODE_ISSPACE: the ASCII set, the C1 and separator code points, and the
// three Unicode space blocks.
function pySIsSpaceCh(ch) {
    var c = ch.charCodeAt(0)
    if (c == 32) { return true }
    if (c >= 9 && c <= 13) { return true }
    if (c >= 28 && c <= 31) { return true }
    if (c == 133 || c == 160 || c == 5760) { return true }
    if (c >= 8192 && c <= 8202) { return true }
    if (c == 8232 || c == 8233 || c == 8239 || c == 8287 || c == 12288) { return true }
    return false
}

// str.splitlines' universal newlines.
function pySIsBreakCh(c) {
    if (c == 10 || c == 11 || c == 12 || c == 13) { return true }
    if (c == 28 || c == 29 || c == 30 || c == 133) { return true }
    if (c == 8232 || c == 8233) { return true }
    return false
}

function pySRepeat(s, n) {
    var out = ""
    var i = 0
    while (i < n) { out = out + s ; i = i + 1 }
    return out
}

function pySLen(s) { return pySChars(s).length }

// ---- searching ----
//
// CPython's ADJUST_INDICES: a negative bound is relative to the end and floors at
// 0; only the END is capped at the length, which is what makes "abc".find("", 4)
// answer -1 while "abc".find("", 3) answers 3.
function pySAdjStart(v, n) {
    var i = v
    if (i < 0) {
        i = i + n
        if (i < 0) { i = 0 }
    }
    return i
}

function pySAdjEnd(v, n) {
    var i = v
    if (i < 0) {
        i = i + n
        if (i < 0) { i = 0 }
    }
    if (i > n) { i = n }
    return i
}

function pySFind(s, sub, start, end) {
    if (start > end) { return -1 }
    var at = s.substring(start, end).indexOf(sub)
    if (at < 0) { return -1 }
    return at + start
}

function pySRFind(s, sub, start, end) {
    if (start > end) { return -1 }
    var i = end - sub.length
    while (i >= start) {
        if (s.substring(i, i + sub.length) == sub) { return i }
        i = i - 1
    }
    return -1
}

function pySCount(s, sub, start, end) {
    if (start > end) { return 0 }
    if (sub.length == 0) { return pySLen(s.substring(start, end)) + 1 }
    var n = 0
    var i = start
    while (i + sub.length <= end) {
        if (s.substring(i, i + sub.length) == sub) {
            n = n + 1
            i = i + sub.length
        } else {
            i = i + 1
        }
    }
    return n
}

function pySStarts(s, pre, start, end) {
    if (start > end) { return false }
    if (start + pre.length > end) { return false }
    return s.substring(start, start + pre.length) == pre
}

function pySEnds(s, suf, start, end) {
    if (start > end) { return false }
    if (end - suf.length < start) { return false }
    return s.substring(end - suf.length, end) == suf
}

// ---- stripping ----
//
// `chars` is a SET of characters, not a prefix; `useWS` is the no-argument form.
function pySStripHit(ch, chars, useWS) {
    if (useWS) { return pySIsSpaceCh(ch) }
    return chars.indexOf(ch) >= 0
}

function pySStrip(s, chars, useWS, doL, doR) {
    var a = 0
    var b = s.length
    if (doL) {
        while (a < b && pySStripHit(s.charAt(a), chars, useWS)) { a = a + 1 }
    }
    if (doR) {
        while (b > a && pySStripHit(s.charAt(b - 1), chars, useWS)) { b = b - 1 }
    }
    return s.substring(a, b)
}

// ---- splitting ----
//
// split() with no argument splits on RUNS of whitespace and drops the leading and
// trailing empties; split(" ") does neither. They are different algorithms, not one
// with a default.
function pySSplitWS(s, maxsplit) {
    var out = []
    var i = 0
    var n = 0
    while (i < s.length) {
        while (i < s.length && pySIsSpaceCh(s.charAt(i))) { i = i + 1 }
        if (i >= s.length) { return out }
        if (maxsplit >= 0 && n >= maxsplit) {
            out.push(s.substring(i, s.length))
            return out
        }
        var j = i
        while (j < s.length && !pySIsSpaceCh(s.charAt(j))) { j = j + 1 }
        out.push(s.substring(i, j))
        n = n + 1
        i = j
    }
    return out
}

function pySSplitSep(s, sep, maxsplit) {
    var out = []
    var start = 0
    var n = 0
    while (maxsplit < 0 || n < maxsplit) {
        var at = pySFind(s, sep, start, s.length)
        if (at < 0) { break }
        out.push(s.substring(start, at))
        start = at + sep.length
        n = n + 1
    }
    out.push(s.substring(start, s.length))
    return out
}

function pySReverse(a) {
    var out = []
    var i = a.length - 1
    while (i >= 0) {
        out.push(a[i])
        i = i - 1
    }
    return out
}

function pySRSplitWS(s, maxsplit) {
    var out = []
    var e = s.length
    var n = 0
    while (e > 0) {
        while (e > 0 && pySIsSpaceCh(s.charAt(e - 1))) { e = e - 1 }
        if (e <= 0) { return pySReverse(out) }
        if (maxsplit >= 0 && n >= maxsplit) {
            out.push(s.substring(0, e))
            return pySReverse(out)
        }
        var j = e
        while (j > 0 && !pySIsSpaceCh(s.charAt(j - 1))) { j = j - 1 }
        out.push(s.substring(j, e))
        n = n + 1
        e = j
    }
    return pySReverse(out)
}

function pySRSplitSep(s, sep, maxsplit) {
    var out = []
    var e = s.length
    var n = 0
    while (maxsplit < 0 || n < maxsplit) {
        var at = pySRFind(s, sep, 0, e)
        if (at < 0) { break }
        out.push(s.substring(at + sep.length, e))
        e = at
        n = n + 1
    }
    out.push(s.substring(0, e))
    return pySReverse(out)
}

// str.splitlines: the boundary set is wider than "\n" and "\r\n" is ONE break.
function pySSplitLines(s, keepends) {
    var out = []
    var i = 0
    var start = 0
    while (i < s.length) {
        var c = s.charCodeAt(i)
        if (pySIsBreakCh(c)) {
            var w = 1
            if (c == 13 && i + 1 < s.length && s.charCodeAt(i + 1) == 10) { w = 2 }
            if (keepends) { out.push(s.substring(start, i + w)) }
            else { out.push(s.substring(start, i)) }
            i = i + w
            start = i
        } else {
            i = i + 1
        }
    }
    if (start < s.length) { out.push(s.substring(start, s.length)) }
    return out
}

// ---- rewriting ----

function pySReplace(s, old, nw, cnt) {
    var out = ""
    var reps = 0
    if (old.length == 0) {
        // An empty pattern inserts between every character and at both ends.
        if (cnt != 0) {
            out = nw
            reps = 1
        }
        var i = 0
        while (i < s.length) {
            var w = pySCPW(s, i)
            out = out + s.substring(i, i + w)
            i = i + w
            if (cnt < 0 || reps < cnt) {
                out = out + nw
                reps = reps + 1
            }
        }
        return out
    }
    var start = 0
    while (cnt < 0 || reps < cnt) {
        var at = pySFind(s, old, start, s.length)
        if (at < 0) { break }
        out = out + s.substring(start, at) + nw
        start = at + old.length
        reps = reps + 1
    }
    return out + s.substring(start, s.length)
}

// do_title (CPython Objects/unicodeobject.c): a character opens a word unless the
// PREVIOUS one was cased, which is why "they're" titles to "They'Re".
function pySTitle(s) {
    var cs = pySChars(s)
    var out = ""
    var prev = false
    var i = 0
    while (i < cs.length) {
        var ch = cs[i]
        if (prev) { out = out + pySLoCh(ch) }
        else { out = out + pySTiCh(ch) }
        prev = pySIsCased(ch)
        i = i + 1
    }
    return out
}

function pySIsTitle(s) {
    var cs = pySChars(s)
    var prev = false
    var any = false
    var i = 0
    while (i < cs.length) {
        var ch = cs[i]
        if (pySIsUpCh(ch) || pySCaseOnly(ch) == 3) {
            if (prev) { return false }
            prev = true
            any = true
        } else if (pySIsLoCh(ch)) {
            if (!prev) { return false }
            prev = true
            any = true
        } else {
            prev = false
        }
        i = i + 1
    }
    return any
}

function pySCapitalize(s) {
    var cs = pySChars(s)
    var out = ""
    var i = 0
    while (i < cs.length) {
        if (i == 0) { out = out + pySTiCh(cs[i]) }
        else { out = out + pySLoCh(cs[i]) }
        i = i + 1
    }
    return out
}

function pySSwapCase(s) {
    var cs = pySChars(s)
    var out = ""
    var i = 0
    while (i < cs.length) {
        var ch = cs[i]
        if (pySIsUpCh(ch)) { out = out + pySLoCh(ch) }
        else if (pySIsLoCh(ch)) { out = out + pySUpCh(ch) }
        else { out = out + ch }
        i = i + 1
    }
    return out
}

function pySMapCase(s, up) {
    var cs = pySChars(s)
    var out = ""
    var i = 0
    while (i < cs.length) {
        if (up) { out = out + pySUpCh(cs[i]) }
        else { out = out + pySLoCh(cs[i]) }
        i = i + 1
    }
    return out
}

function pySExpandTabs(s, tab) {
    var out = ""
    var col = 0
    var i = 0
    while (i < s.length) {
        var c = s.charCodeAt(i)
        if (c == 9) {
            if (tab > 0) {
                var pad = tab - (col - Math.floor(col / tab) * tab)
                out = out + pySRepeat(" ", pad)
                col = col + pad
            }
        } else if (c == 10 || c == 13) {
            out = out + s.charAt(i)
            col = 0
        } else {
            var w = pySCPW(s, i)
            out = out + s.substring(i, i + w)
            col = col + 1
            i = i + w - 1
        }
        i = i + 1
    }
    return out
}

// ---- padding ----

function pySCenter(s, width, fill) {
    var n = pySLen(s)
    var marg = width - n
    if (marg <= 0) { return s }
    // CPython: left = marg / 2 + (marg & width & 1).
    var left = Math.floor(marg / 2)
    if (marg % 2 == 1 && width % 2 == 1) { left = left + 1 }
    return pySRepeat(fill, left) + s + pySRepeat(fill, marg - left)
}

function pySJust(s, width, fill, right) {
    var n = pySLen(s)
    if (width <= n) { return s }
    if (right) { return pySRepeat(fill, width - n) + s }
    return s + pySRepeat(fill, width - n)
}

function pySZfill(s, width) {
    var n = pySLen(s)
    if (width <= n) { return s }
    var sign = ""
    var rest = s
    if (s.length > 0) {
        var c = s.charCodeAt(0)
        if (c == 43 || c == 45) {
            sign = s.substring(0, 1)
            rest = s.substring(1, s.length)
        }
    }
    return sign + pySRepeat("0", width - n) + rest
}

// ---- str.format ----
//
// The replacement-field grammar: {{ and }} are literals, and a field is
// {name[.attr|[key]]*[!conv][:spec]}. The spec goes to the engine's own
// pyFormat, so `.format()` and an f-string share one mini-language (and one set
// of documented gaps - see the format chapter of this file).

function pySAllDigits(t) {
    if (t.length == 0) { return false }
    var i = 0
    while (i < t.length) {
        var c = t.charCodeAt(i)
        if (c < 48 || c > 57) { return false }
        i = i + 1
    }
    return true
}

// One replacement field's body, without the braces. `auto` is the automatic
// field counter, threaded through so that a nested width field ({:{}}) takes the
// next argument the way CPython's does.
function pySFmtOne(body, args, kw, auto) {
    var nm = ""
    var conv = ""
    var spec = ""
    var part = 0
    var depth = 0
    var k = 0
    while (k < body.length) {
        var c = body.charAt(k)
        if (part < 2) {
            if (c == "[") { depth = depth + 1 }
            else if (c == "]") { depth = depth - 1 }
            else if (depth == 0 && c == "!" && part == 0 && k + 1 < body.length && body.charAt(k + 1) != "=") {
                part = 1
                k = k + 1
                continue
            } else if (depth == 0 && c == ":") {
                part = 2
                k = k + 1
                continue
            }
        }
        if (part == 0) { nm = nm + c }
        else if (part == 1) { conv = conv + c }
        else { spec = spec + c }
        k = k + 1
    }
    var at = auto
    // The head: empty (automatic), all digits (positional) or a keyword.
    var head = ""
    var p = 0
    while (p < nm.length && nm.charAt(p) != "." && nm.charAt(p) != "[") {
        head = head + nm.charAt(p)
        p = p + 1
    }
    var v = anytype
    if (head == "") {
        if (at >= args.length) { pySFail("IndexError: Replacement index " + at + " out of range") }
        v = args[at]
        at = at + 1
    } else if (pySAllDigits(head)) {
        var ix = parseInt(head, 10)
        if (ix >= args.length) { pySFail("IndexError: Replacement index " + ix + " out of range") }
        v = args[ix]
    } else {
        v = pySKwGet(kw, head)
    }
    // .attr and [key] accessors.
    while (p < nm.length) {
        var c2 = nm.charAt(p)
        if (c2 == ".") {
            var an = ""
            p = p + 1
            while (p < nm.length && nm.charAt(p) != "." && nm.charAt(p) != "[") {
                an = an + nm.charAt(p)
                p = p + 1
            }
            v = pySGetAttr(v, an)
        } else if (c2 == "[") {
            var key = ""
            p = p + 1
            while (p < nm.length && nm.charAt(p) != "]") {
                key = key + nm.charAt(p)
                p = p + 1
            }
            p = p + 1
            if (pySAllDigits(key)) { v = pySGetItem(v, parseInt(key, 10)) }
            else { v = pySGetItem(v, key) }
        } else {
            pySFail("ValueError: Invalid format field: " + nm)
            p = p + 1
        }
    }
    // A spec may itself carry replacement fields ("{:{w}}").
    if (spec.indexOf("{") >= 0) {
        var inner = pySFormatGo(spec, args, kw, at)
        spec = inner["text"]
        at = inner["auto"]
    }
    var res = {}
    res["text"] = pySFormat1(v, spec, conv)
    res["auto"] = at
    return res
}

function pySFormatGo(s, args, kw, auto) {
    var out = ""
    var i = 0
    var at = auto
    while (i < s.length) {
        var ch = s.charAt(i)
        if (ch == "{") {
            if (i + 1 < s.length && s.charAt(i + 1) == "{") {
                out = out + "{"
                i = i + 2
                continue
            }
            var depth = 1
            var j = i + 1
            while (j < s.length) {
                var c2 = s.charAt(j)
                if (c2 == "{") { depth = depth + 1 }
                else if (c2 == "}") {
                    depth = depth - 1
                    if (depth == 0) { break }
                }
                j = j + 1
            }
            if (depth != 0) { pySFail("ValueError: Single '{' encountered in format string") }
            var r = pySFmtOne(s.substring(i + 1, j), args, kw, at)
            out = out + r["text"]
            at = r["auto"]
            i = j + 1
            continue
        }
        if (ch == "}") {
            if (i + 1 < s.length && s.charAt(i + 1) == "}") {
                out = out + "}"
                i = i + 2
                continue
            }
            pySFail("ValueError: Single '}' encountered in format string")
        }
        out = out + ch
        i = i + 1
    }
    var res = {}
    res["text"] = out
    res["auto"] = at
    return res
}

// ---- the dispatch table ----

function pySOptInt(args, i, dflt) {
    if (i >= args.length) { return dflt }
    var v = args[i]
    if (v === undefined || v === null) { return dflt }
    return v | 0
}

function pySStrArg(v) {
    if (typeof v == "string") { return v }
    pySFail("TypeError: a str argument is required")
    return ""
}

function pySFillArg(args, i) {
    if (i >= args.length) { return " " }
    var v = args[i]
    if (v === undefined || v === null) { return " " }
    var f = pySStrArg(v)
    if (pySLen(f) != 1) { pySFail("TypeError: The fill character must be exactly one character long") }
    return f
}

// isdigit / isalpha / isalnum / isspace / isascii, which share "empty is False
// and every character must qualify".
function pySAllCh(s, kind) {
    var cs = pySChars(s)
    if (cs.length == 0) { return false }
    var i = 0
    while (i < cs.length) {
        var ch = cs[i]
        var ok = false
        if (kind == 1) { ok = pySIsDigitCh(ch) }
        else if (kind == 2) { ok = pySIsAlphaCh(ch) }
        else if (kind == 3) { ok = pySIsAlphaCh(ch) || pySIsDigitCh(ch) }
        else { ok = pySIsSpaceCh(ch) }
        if (!ok) { return false }
        i = i + 1
    }
    return true
}

// islower / isupper: at least one cased character, and no cased character of the
// other case. An uncased character is ignored, which is why "ab1".islower() is True.
function pySCaseAll(s, up) {
    var cs = pySChars(s)
    var any = false
    var i = 0
    while (i < cs.length) {
        var ch = cs[i]
        if (pySIsCased(ch)) {
            if (up) {
                if (!pySIsUpCh(ch)) { return false }
            } else {
                if (!pySIsLoCh(ch)) { return false }
            }
            any = true
        }
        i = i + 1
    }
    return any
}

function pySIsAscii(s) {
    var i = 0
    while (i < s.length) {
        if (s.charCodeAt(i) > 127) { return false }
        i = i + 1
    }
    return true
}

function pySJoin(s, seq) {
    var out = ""
    var i = 0
    while (i < seq.length) {
        if (i > 0) { out = out + s }
        out = out + pySStrArg(seq[i])
        i = i + 1
    }
    return out
}

// The names this table answers. The caller checks it FIRST so that a name it
// does not know falls through to the generic method table.
function pySIsStrMethod(name) {
    if (name == "upper" || name == "lower" || name == "casefold") { return true }
    if (name == "title" || name == "capitalize" || name == "swapcase") { return true }
    if (name == "strip" || name == "lstrip" || name == "rstrip") { return true }
    if (name == "split" || name == "rsplit" || name == "splitlines") { return true }
    if (name == "join" || name == "replace") { return true }
    if (name == "find" || name == "rfind" || name == "index" || name == "rindex") { return true }
    if (name == "count" || name == "startswith" || name == "endswith") { return true }
    if (name == "isdigit" || name == "isdecimal" || name == "isnumeric") { return true }
    if (name == "isalpha" || name == "isalnum" || name == "isspace") { return true }
    if (name == "islower" || name == "isupper" || name == "istitle" || name == "isascii") { return true }
    if (name == "center" || name == "ljust" || name == "rjust" || name == "zfill") { return true }
    if (name == "expandtabs" || name == "encode") { return true }
    if (name == "partition" || name == "rpartition") { return true }
    if (name == "removeprefix" || name == "removesuffix") { return true }
    if (name == "format" || name == "format_map") { return true }
    return false
}

function pyStrMethod(s, name, args, kw) {
    var n = s.length
    if (name == "upper") { return pySMapCase(s, true) }
    if (name == "lower" || name == "casefold") { return pySMapCase(s, false) }
    if (name == "title") { return pySTitle(s) }
    if (name == "capitalize") { return pySCapitalize(s) }
    if (name == "swapcase") { return pySSwapCase(s) }

    if (name == "strip" || name == "lstrip" || name == "rstrip") {
        var chars = ""
        var useWS = true
        if (args.length > 0) {
            if (args[0] !== undefined && args[0] !== null) {
                chars = pySStrArg(args[0])
                useWS = false
            }
        }
        return pySStrip(s, chars, useWS, name != "rstrip", name != "lstrip")
    }

    if (name == "split" || name == "rsplit") {
        var ms = pySOptInt(args, 1, -1)
        var noSep = args.length == 0
        if (!noSep) {
            if (args[0] === undefined || args[0] === null) { noSep = true }
        }
        if (noSep) {
            if (name == "split") { return pySSplitWS(s, ms) }
            return pySRSplitWS(s, ms)
        }
        var sep = pySStrArg(args[0])
        if (sep.length == 0) { pySFail("ValueError: empty separator") }
        if (name == "split") { return pySSplitSep(s, sep, ms) }
        return pySRSplitSep(s, sep, ms)
    }
    if (name == "splitlines") {
        var ke = false
        if (args.length > 0) { ke = pySTruthy(args[0]) }
        return pySSplitLines(s, ke)
    }
    if (name == "join") {
        var seq = anytype
        seq = args[0]
        if (typeof seq == "string") { return pySJoin(s, pySChars(seq)) }
        // A GENERATOR or an ITERATOR object (iter/map/filter/zip/enumerate) is
        // materialized rather than refused - `", ".join(map(str, xs))` is
        // ordinary Python. pySSeqOf answers null for anything else, and is the
        // one hook this chunk needs for it. Keep in step with the join arm in
        // abnf/pystrmethod.go and languages/python-interpreter.abnf.
        var jseq = pySSeqOf(seq)
        if (jseq !== null) { seq = jseq }
        if (!pySIsArr(seq)) { pySFail("TypeError: can only join an iterable") }
        return pySJoin(s, seq)
    }
    if (name == "replace") {
        return pySReplace(s, pySStrArg(args[0]), pySStrArg(args[1]), pySOptInt(args, 2, -1))
    }

    if (name == "find" || name == "index" || name == "rfind" || name == "rindex") {
        var sub = pySStrArg(args[0])
        var st = pySAdjStart(pySOptInt(args, 1, 0), n)
        var en = pySAdjEnd(pySOptInt(args, 2, n), n)
        var at = -1
        if (name == "find" || name == "index") { at = pySFind(s, sub, st, en) }
        else { at = pySRFind(s, sub, st, en) }
        if (at < 0) {
            if (name == "index" || name == "rindex") { pySFail("ValueError: substring not found") }
        }
        return at
    }
    if (name == "count") {
        return pySCount(s, pySStrArg(args[0]), pySAdjStart(pySOptInt(args, 1, 0), n),
                        pySAdjEnd(pySOptInt(args, 2, n), n))
    }
    if (name == "startswith" || name == "endswith") {
        var st2 = pySAdjStart(pySOptInt(args, 1, 0), n)
        var en2 = pySAdjEnd(pySOptInt(args, 2, n), n)
        var pv = args[0]
        if (pySIsArr(pv)) {
            var i2 = 0
            while (i2 < pv.length) {
                var one = pySStrArg(pv[i2])
                if (name == "startswith") {
                    if (pySStarts(s, one, st2, en2)) { return true }
                } else {
                    if (pySEnds(s, one, st2, en2)) { return true }
                }
                i2 = i2 + 1
            }
            return false
        }
        if (name == "startswith") { return pySStarts(s, pySStrArg(pv), st2, en2) }
        return pySEnds(s, pySStrArg(pv), st2, en2)
    }

    if (name == "isdigit" || name == "isdecimal" || name == "isnumeric") { return pySAllCh(s, 1) }
    if (name == "isalpha") { return pySAllCh(s, 2) }
    if (name == "isalnum") { return pySAllCh(s, 3) }
    if (name == "isspace") { return pySAllCh(s, 4) }
    if (name == "islower") { return pySCaseAll(s, false) }
    if (name == "isupper") { return pySCaseAll(s, true) }
    if (name == "istitle") { return pySIsTitle(s) }
    if (name == "isascii") { return pySIsAscii(s) }

    if (name == "center") { return pySCenter(s, pySOptInt(args, 0, 0), pySFillArg(args, 1)) }
    if (name == "ljust") { return pySJust(s, pySOptInt(args, 0, 0), pySFillArg(args, 1), false) }
    if (name == "rjust") { return pySJust(s, pySOptInt(args, 0, 0), pySFillArg(args, 1), true) }
    if (name == "zfill") { return pySZfill(s, pySOptInt(args, 0, 0)) }
    if (name == "expandtabs") { return pySExpandTabs(s, pySOptInt(args, 0, 8)) }
    // There is no bytes type in this value model, so encode() is the identity;
    // CPython answers b'...'. Recorded in the header of this chapter.
    if (name == "encode") { return s }

    if (name == "partition" || name == "rpartition") {
        var psep = pySStrArg(args[0])
        if (psep.length == 0) { pySFail("ValueError: empty separator") }
        var pat = -1
        if (name == "partition") { pat = pySFind(s, psep, 0, n) }
        else { pat = pySRFind(s, psep, 0, n) }
        if (pat < 0) {
            if (name == "partition") { return [s, "", ""] }
            return ["", "", s]
        }
        return [s.substring(0, pat), psep, s.substring(pat + psep.length, n)]
    }
    if (name == "removeprefix") {
        var pre = pySStrArg(args[0])
        if (pre.length > 0 && pySStarts(s, pre, 0, n)) { return s.substring(pre.length, n) }
        return s
    }
    if (name == "removesuffix") {
        var suf = pySStrArg(args[0])
        if (suf.length > 0 && pySEnds(s, suf, 0, n)) { return s.substring(0, n - suf.length) }
        return s
    }

    if (name == "format") { return pySFormatGo(s, args, kw, 0)["text"] }
    if (name == "format_map") {
        var mp = undefined
        if (args.length > 0) { mp = args[0] }
        return pySFormatGo(s, [], mp, 0)["text"]
    }
    pySFail("unknown String method: " + name)
    return ""
}
