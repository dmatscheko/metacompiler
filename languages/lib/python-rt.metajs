// How a bound method prints. CPython appends the receiver's ADDRESS to both
// forms; the address is its own and cannot be matched, so it is left off here
// exactly as it is for <function f> and <map object>.
function pyBMRender(i) {
    var nm = pyToStr(pyBMTab[i + 1])
    var self = pyBMTab[i + 2]
    var kind = pyBMTab[i + 4]
    // An UNBOUND descriptor names the type it belongs to, in single quotes, and
    // says "objects" plural - CPython's own spelling for list.count.
    if (kind == "d") { return "<method '" + nm + "' of '" + pyToStr(self["__name"]) + "' objects>" }
    // A module-level builtin prints exactly like any other builtin function; its
    // module is reachable as __self__ but is not part of the render.
    if (kind == "m") { return "<built-in function " + nm + ">" }
    if (pyBMTab[i + 3] === null) {
        if (pySlotDunder(nm)) { return "<method-wrapper '" + nm + "' of " + pyBMOwner(self) + " object>" }
        return "<built-in method " + nm + " of " + pyBMOwner(self) + " object>"
    }
    var fq = pyFnQual(pyBMTab[i + 3])
    if (fq === undefined) { fq = pyBMOwner(self) + "." + nm }
    return "<bound method " + fq + " of " + pyRepr(self) + ">"
}

// Go: pySlotDunder. A builtin type's dunder that CPython implements as a type
// SLOT binds as a method-wrapper ((5).__add__); the few that are ordinary
// methods (__round__, __format__, ...) bind as built-in methods.
function pySlotDunder(nm) {
    if (nm.length <= 4 || nm.substring(0, 2) != "__" || nm.substring(nm.length - 2, nm.length) != "__") { return false }
    return nm != "__round__" && nm != "__format__" && nm != "__trunc__" && nm != "__floor__" && nm != "__ceil__"
}
// The class a classmethod reached through super() binds to: the ORIGINAL cls -
// `super().who()` inside C.who() must still pass C - which __sobj already is
// when the frame's first argument was a class.
function pyDSuperOwner(s) {
    var o = s["__sobj"]
    if (pyIsClass(o)) { return o }
    return js_pytype(o)
}

function pySuperMCall(s, name, args, kw) {
    pySuperCheck(s)
    var m = pySuperFind(s, name)
    if (m === undefined) {
        pyRaiseExc("AttributeError", "'super' object has no attribute '" + name + "'")
    }
    if (pyDIsStatic(m) || pyDIsClsM(m)) {
        var sd = pyDDescGet(m, pyDSuperOwner(s), name)
        return pyCall(sd, pyBindCall(sd, args, kw))
    }
    if (!pyIsCallable(m) || name == "__new__") { return pyDCallPyValue(m, args, kw) }
    var self = rtPrepend(s["__sobj"], args)
    return pyCall(m, pyBindCall(m, self, kw))
}

// ----- class objects (Go: js_pyclass_new / pyLinearize / js_pyclass_fill) ---

// pyLinearize is the C3 merge of the bases' MROs with the base
// list itself - the order Python computes, minus the class itself (the caller
// prepends it). A hierarchy C3 cannot resolve consistently falls back to
// first-seen order rather than aborting the program. Go consumes each sequence
// by re-slicing it (`seqs[i] = s[1:]`); there is no splice here, so a parallel
// array of cursors does the same job.
function pyDLinearize(bases) {
    var out = []
    if (bases.length == 0) { return out }
    var seqs = []
    var cur = []
    var i = 0
    var j = 0
    var k = 0
    var head = anytype
    var pick = anytype
    var inTail = false
    var empty = false
    while (i < bases.length) {
        seqs.push(pyMRO(bases[i]))
        i = i + 1
    }
    cur = []
    i = 0
    while (i < bases.length) {
        cur.push(bases[i])
        i = i + 1
    }
    seqs.push(cur)
    var pos = []
    i = 0
    while (i < seqs.length) {
        pos.push(0)
        i = i + 1
    }
    while (true) {
        empty = true
        i = 0
        while (i < seqs.length) {
            if (pos[i] < seqs[i].length) { empty = false }
            i = i + 1
        }
        if (empty) { return out }
        pick = null
        i = 0
        while (i < seqs.length) {
            if (pos[i] < seqs[i].length) {
                head = seqs[i][pos[i]]
                inTail = false
                j = 0
                while (j < seqs.length) {
                    k = pos[j] + 1
                    while (k < seqs[j].length) {
                        if (seqs[j][k] === head) { inTail = true }
                        k = k + 1
                    }
                    j = j + 1
                }
                if (!inTail) {
                    pick = head
                    break
                }
            }
            i = i + 1
        }
        if (pick === null) { // Inconsistent hierarchy: take the first head there is.
            i = 0
            while (i < seqs.length) {
                if (pos[i] < seqs[i].length) {
                    pick = seqs[i][pos[i]]
                    break
                }
                i = i + 1
            }
        }
        out.push(pick)
        i = 0
        while (i < seqs.length) {
            if (pos[i] < seqs[i].length) {
                if (seqs[i][pos[i]] === pick) { pos[i] = pos[i] + 1 }
            }
            i = i + 1
        }
    }
    return out
}

// A class object: its own name, its first base as "__super" and the FULL
// linearized MRO as "__mro" (itself first). Multiple inheritance is resolved
// ONCE, here, so every later lookup is a flat walk of "__mro".
function js_pyclass_new(name, bases) {
    var n = pyToStr(name)
    var cls = {}
    cls["__name"] = n
    var baseObjs = []
    if (pyIsArr(bases)) {
        var i = 0
        while (i < bases.length) {
            // Go tests `b.(*jsObject)` - any object, not necessarily a class.
            if (!pyIsObj(bases[i])) { fail("class " + n + ": base is not a class") }
            baseObjs.push(bases[i])
            i = i + 1
        }
    }
    if (baseObjs.length > 0) { cls["__super"] = baseObjs[0] }
    // The declared bases, for __bases__. Kept beside __mro because the
    // linearization cannot be un-merged back into the base list.
    cls["__basesl"] = baseObjs
    var mro = [cls]
    var lin = pyDLinearize(baseObjs)
    var j = 0
    while (j < lin.length) {
        mro.push(lin[j])
        j = j + 1
    }
    cls["__mro"] = mro
    return cls
}

// The class body is a suite: every name it bound (methods, class attributes,
// __slots__) becomes a class member.
//
// DELIBERATE SHAPE CHANGE FROM THE GO TWIN: in Go this takes a SCOPE HANDLE and
// enumerates the scope's names (`sc := rt.scopeOf(a[1])`). A scope is the
// floor's private storage and layer 2 cannot open one, so
// languages/python-to-llvm-ir.abnf hands us a DICT of the class body's bindings
// instead - the ordinary {__dict:true, keys, vals} shape - and this copies
// every key/value pair of that dict onto the class object. The enumeration
// order is the dict's insertion order, which is the scope's binding order, so
// the observable result is the same.
function js_pyclass_fill(cls, bodyDict) {
    if (!pyIsObj(cls)) { fail("js_pyclass_fill: not a class object") }
    if (!pyIsDict(bodyDict)) { fail("js_pyclass_fill: class body is not a dict") }
    var keys = bodyDict["keys"]
    var vals = bodyDict["vals"]
    var i = 0
    while (i < keys.length) {
        cls[pyToStr(keys[i])] = vals[i]
        pyDNoteHook(pyToStr(keys[i]))
        i = i + 1
    }
    return undefined
}

// ----- attributes (Go: js_pygetattr / js_pysetattr) -------------------------

// obj.name: an instance checks its own attributes, then the MRO of its class
// (running a __get__ descriptor found there); a class checks its own MRO.
// Anything else takes the ordinary member read. The whole lookup order is
// rt.pyGetAttr, which the prelude provides.
function js_pygetattr(obj, name) {
    if (pyDHooks > 0 && pyDHasGetHook(obj)) { return pyDHookGet(obj, pyToStr(name)) }
    return pyGetAttrRaw(obj, pyToStr(name))
}

// obj.name = v: a __set__ descriptor on the class wins; __slots__ (when the
// class declares it) rejects an unknown name by raising, like Python.
// rt.pySetAttr is in the prelude.
function js_pysetattr(obj, name, v) {
    if (pyDHooks > 0) {
        pySetAttr(obj, pyToStr(name), v)
        return undefined
    }
    pySetAttrRaw(obj, pyToStr(name), v)
    return undefined
}

// del obj.name (Go: js_pydel_attr). python-to-llvm-ir.abnf's makeDel emits it.
// `delKey` is the floor's js_del under its host-builtin name (runtime.c host id
// 63); it drops the key AND its insertion-order entry, which is what keeps
// keysOf, and therefore vars()/dir(), right after a delete.
function js_pydel_attr(obj, name) {
    if (pyDHooks > 0) {
        var da = pyDUserHook(obj, "__delattr__")
        if (da !== undefined) {
            pyCall(da, [obj, pyToStr(name)])
            return undefined
        }
    }
    return pyDDelAttr(obj, name)
}

// object.__delattr__.
function pyDDelAttr(obj, name) {
    if (typeof obj == "function") {
        var dn = pyToStr(name)
        var fd = pyFnAttrs(pyFnOwner(obj), false)
        var fi = 0 - 1
        if (fd !== undefined) { fi = pyDictFind(fd["keys"], dn) }
        if (fi < 0) { pyRaiseExc("AttributeError", "'" + pyTypeName(obj) + "' object has no attribute '" + dn + "'") }
        pyCRemoveAt(fd["keys"], fi)
        pyCRemoveAt(fd["vals"], fi)
        return undefined
    }
    var dcls = pyInstClassOf(obj)
    if (dcls === null) { pyNoDictAttr(obj, pyToStr(name)) }
    else if (dcls["__mro"] === undefined && dcls["__name"] == "object") { pyAttrError(dcls, pyToStr(name)) }
    else if (pyLookupHas(dcls, pyToStr(name))) {
        var dp = pyLookupVal(dcls, pyToStr(name))
        if (pyDIsProp(dp)) {
            pyDPropCall(dp, "fdel", dcls, [obj])
            return undefined
        }
    }
    if (obj === null || obj === undefined || typeof obj != "object") {
        fail("attribute deletion on a " + pyTypeName(obj))
    }
    var dname = pyToStr(name)
    // Only an OWN attribute can be deleted: a class's member is not the
    // instance's, nor a base's the subclass's. Go: rt.pyDelAttr.
    if (obj[dname] === undefined && !pyNoneBound(obj, dname)) {
        if (pyIsClass(obj)) { pyRaiseExc("AttributeError", "type object '" + pyToStr(obj["__name"]) + "' has no attribute '" + dname + "'") }
        if (dcls !== null) { pyRaiseExc("AttributeError", "'" + pyTypeName(obj) + "' object has no attribute '" + dname + "'") }
    }
    delKey(obj, dname)
    var dord = obj["__ord"]
    if (dord !== undefined) {
        var doi = pyStrAt(dord, dname)
        if (doi >= 0) { pyCRemoveAt(dord, doi) }
    }
    var nk = obj["__nonek"]
    if (nk !== undefined) {
        var ni = 0
        while (ni < nk.length) {
            if (nk[ni] === dname) { pyCRemoveAt(nk, ni) } else { ni = ni + 1 }
        }
    }
    if (dcls !== null && obj["__pydict"] !== undefined) { pyInstDictPull(obj) }
    return undefined
}

// ----- the signature registry (Go: pySig / js_pysig) ----------------------------

// Go keys rt.pySigs by the callee VALUE (a Go map over interface{}). A closure
// here is a floor cell: nothing can be stored on it and there is no Map in the
// frozen subset, so the registry is an identity-keyed side table - four
// parallel arrays and a `===` scan. It is O(n) in the defs a program has ever
// registered, which is a constant per module.
var pyDSigFn = []
var pyDSigNames = []
var pyDSigKwOnly = []
var pyDSigExt = []
var pyDSigDflt = []
// The arity check (Go: pySig.qual / rest / kwrest / nposonly / nreq): the
// qualname, "" for a builtin, which is never checked; the js_pysig flags; the
// count of leading positional parameters without a default.
var pyDSigQual = []
var pyDSigFlags = []
var pyDSigNreq = []

// Fills a defaulted parameter's slot that a keyword call left unbound, so
// js_pyargd can tell it from an explicit None. Go: pyAbsentArg.
var pyDAbsent = {}
// Separates a module function's positionals from its keyword dict (pyBindCall,
// pyDModuleFn). Go: pyKwMark.
var pyDKwMark = {}

function pyDSigIndex(callee) {
    var i = 0
    while (i < pyDSigFn.length) {
        if (pyDSigFn[i] === callee) { return i }
        i = i + 1
    }
    return -1
}

// Register a def's parameter shape, so a keyword call can be bound to it.
// The LAST nkwonly names are keyword-only; `ext` selects prologue layout B
// ([p0..pn-1, *args list, **kwargs dict]) over layout A (a flat positional
// array). `dflt` flags the defaulted names (undefined for a builtin). Go
// overwrites a duplicate map entry; so does this.
function js_pysig(clo, names, nkwonly, ext, dflt, qual, flags) {
    var ns = []
    var ds = []
    var i = 0
    var q = ""
    var fl = 0
    var nreq = 0
    if (pyIsArr(names)) {
        while (i < names.length) {
            ns.push(pyToStr(names[i]))
            i = i + 1
        }
    }
    if (pyIsArr(dflt)) {
        i = 0
        while (i < dflt.length) {
            ds.push(pyDTruthy(dflt[i]))
            i = i + 1
        }
    }
    if (typeof qual == "string") {
        q = qual
        fl = pyNum(flags)
        while (nreq < ns.length - pyNum(nkwonly) && !ds[nreq]) { nreq = nreq + 1 }
    }
    var at = pyDSigIndex(clo)
    if (at < 0) {
        pyDSigFn.push(clo)
        pyDSigNames.push(ns)
        pyDSigKwOnly.push(pyNum(nkwonly))
        pyDSigExt.push(pyDTruthy(ext))
        pyDSigDflt.push(ds)
        pyDSigQual.push(q)
        pyDSigFlags.push(fl)
        pyDSigNreq.push(nreq)
    } else {
        pyDSigNames[at] = ns
        pyDSigKwOnly[at] = pyNum(nkwonly)
        pyDSigExt[at] = pyDTruthy(ext)
        pyDSigDflt[at] = ds
        pyDSigQual[at] = q
        pyDSigFlags[at] = fl
        pyDSigNreq[at] = nreq
    }
    return clo
}

// A defaulted parameter's argument: the default when the call supplied none
// (past the end, or left absent by pyBindCall). Go: js_pyargd.
function js_pyargd(args, i, d) {
    if (i < args.length) {
        var v = args[i]
        if (v !== pyDAbsent) { return v }
    }
    return d
}

// pyBindCall turns (positional, keyword dict) into the callee's argument array.
// Go: rt.pyBindCall. NAMED WITHOUT THE CHUNK PREFIX because the
// other chunks call it by this exact name.
function pyBindCall(callee, pos, kw) {
    var hasKw = pyIsDict(kw)
    var kwKeys = anytype
    var kwVals = anytype
    kwKeys = null
    kwVals = null
    if (hasKw) {
        kwKeys = kw["keys"]
        kwVals = kw["vals"]
        if (kwKeys.length == 0) { hasKw = false }
    }
    var i = 0
    var j = 0
    var out = []
    var si = pyDSigIndex(callee)
    if (si < 0) {
        // A builtin (no declared signature) takes the keyword dict as one extra
        // trailing argument - which is exactly what dict(a=1) / dict(**m) want.
        // A module function (pyDModuleFn), a type's own method
        // (pyBuiltinClsMethod) and a bound method (pyDBindMethod,
        // pyDBoundBuiltin) get pyDKwMark before it, since their positionals may
        // end in a dict.
        if (hasKw) {
            i = 0
            while (i < pos.length) {
                out.push(pos[i])
                i = i + 1
            }
            var bmi = pyBMFind(callee)
            if (bmi >= 0) {
                if (pyBMTab[bmi + 4] !== "d") { out.push(pyDKwMark) }
            }
            out.push(kw)
            return out
        }
        return pos
    }
    var names = pyDSigNames[si]
    var nkwonly = pyDSigKwOnly[si]
    var ext = pyDSigExt[si]
    var dflt = pyDSigDflt[si]
    var qual = pyDSigQual[si]
    var flags = pyDSigFlags[si]
    if (!ext && !hasKw) {
        if (pos.length < pyDSigNreq[si] || (flags % 2 == 0 && pos.length > names.length && qual != "")) {
            pyDArityCheck(callee, si, pos.length, [])
        }
        return pos
    }
    var n = names.length
    var npos = n - nkwonly
    var nposonly = (flags - flags % 4) / 4
    if (qual != "") {
        var kn = []
        if (hasKw) {
            i = 0
            while (i < kwKeys.length) {
                kn.push(pyToStr(kwKeys[i]))
                i = i + 1
            }
        }
        pyDArityCheck(callee, si, pos.length, kn)
    }
    i = 0
    while (i < n) {
        if (i < dflt.length && dflt[i]) {
            out.push(pyDAbsent)
        } else {
            out.push(undefined)
        }
        i = i + 1
    }
    i = 0
    while (i < npos && i < pos.length) {
        out[i] = pos[i]
        i = i + 1
    }
    // Go's `used` is a map[string]bool of parameter names that were filled from
    // the keyword dict; here it is a list of those names, scanned linearly.
    var used = []
    // Go's fromKw(i) closure, inlined at both of its call sites: the LAST
    // matching keyword wins, because Go keeps assigning as it scans.
    i = nposonly
    while (i < npos) {
        if (i >= pos.length) {
            if (hasKw) {
                j = 0
                while (j < kwKeys.length) {
                    if (pyToStr(kwKeys[j]) == names[i]) {
                        out[i] = kwVals[j]
                        used.push(names[i])
                    }
                    j = j + 1
                }
            }
        }
        i = i + 1
    }
    i = npos
    while (i < n) {
        if (hasKw) {
            j = 0
            while (j < kwKeys.length) {
                if (pyToStr(kwKeys[j]) == names[i]) {
                    out[i] = kwVals[j]
                    used.push(names[i])
                }
                j = j + 1
            }
        }
        i = i + 1
    }
    var extra = []
    i = npos
    while (i < pos.length) {
        extra.push(pos[i])
        i = i + 1
    }
    if (!ext) {
        i = 0
        while (i < extra.length) {
            out.push(extra[i])
            i = i + 1
        }
        return out
    }
    var left = pyNewDict()
    if (hasKw) {
        j = 0
        while (j < kwKeys.length) {
            if (!pyDUsed(used, pyToStr(kwKeys[j]))) {
                // Go calls dictAppend directly - an unconditional append. The
                // keys of a keyword dict are distinct by construction, so
                // pyDictSet (which overwrites an existing key) is the same map.
                pyDictSet(left, kwKeys[j], kwVals[j])
            }
            j = j + 1
        }
    }
    out.push(extra)
    out.push(left)
    return out
}

// CPython's TypeError for a call that does not fit signature si: given
// positionals plus the keyword names kn. Go: rt.pyArityCheck, which documents
// the order.
function pyDArityCheck(f, si, given, kn) {
    var names = pyDSigNames[si]
    var dflt = pyDSigDflt[si]
    var flags = pyDSigFlags[si]
    var npos = names.length - pyDSigKwOnly[si]
    var nposonly = (flags - flags % 4) / 4
    var k = 0
    var j = 0
    while (k < kn.length) {
        var at = -1
        j = nposonly
        while (j < names.length) {
            if (names[j] == kn[k]) { at = j }
            j = j + 1
        }
        if (at < 0 && (flags - flags % 2) % 4 == 0) {
            var po = ""
            j = 0
            while (j < nposonly) {
                if (pyDUsed(kn, names[j])) { po = po == "" ? names[j] : po + ", " + names[j] }
                j = j + 1
            }
            if (po != "") { pyDArityFail(f, si, "got some positional-only arguments passed as keyword arguments: '" + po + "'") }
            pyDArityFail(f, si, "got an unexpected keyword argument '" + kn[k] + "'" +
                             pyDidYouMean(kn[k], names.slice(nposonly, names.length)))
        }
        if (at >= 0 && at < npos && at < given) { pyDArityFail(f, si, "got multiple values for argument '" + kn[k] + "'") }
        k = k + 1
    }
    if (flags % 2 == 0 && given > npos) {
        var ndef = 0
        var kwGiven = 0
        j = 0
        while (j < names.length) {
            if (j < npos && j < dflt.length && dflt[j]) { ndef = ndef + 1 }
            if (j >= npos && pyDUsed(kn, names[j])) { kwGiven = kwGiven + 1 }
            j = j + 1
        }
        var sig = "" + npos
        var plural = npos != 1
        if (ndef > 0) {
            sig = "from " + (npos - ndef) + " to " + npos
            plural = true
        }
        var msg = "takes " + sig + " positional argument" + (plural ? "s" : "") + " but " + given
        if (kwGiven > 0) {
            msg = msg + " positional argument" + (given == 1 ? "" : "s") + " (and " + kwGiven
                + " keyword-only argument" + (kwGiven == 1 ? "" : "s") + ")"
        }
        pyDArityFail(f, si, msg + (given == 1 && kwGiven == 0 ? " was given" : " were given"))
    }
    var miss = []
    j = given
    while (j < npos) {
        if (!(j < dflt.length && dflt[j]) && (j < nposonly || !pyDUsed(kn, names[j]))) { miss.push(names[j]) }
        j = j + 1
    }
    if (miss.length > 0) { pyDArityFail(f, si, pyDMissingMsg(miss, "positional")) }
    j = npos
    while (j < names.length) {
        if (!(j < dflt.length && dflt[j]) && !pyDUsed(kn, names[j])) { miss.push(names[j]) }
        j = j + 1
    }
    if (miss.length > 0) { pyDArityFail(f, si, pyDMissingMsg(miss, "keyword-only")) }
}

// The function's __qualname__ names it, an assigned one included.
function pyDArityFail(f, si, msg) {
    var q = pyFnQual(f)
    if (q === undefined) { q = pyDSigQual[si] }
    pyRaiseExc("TypeError", q + "() " + msg)
}

// CPython's missing_arguments, listing 'a' / 'a' and 'b' / 'a', 'b', and 'c'.
function pyDMissingMsg(miss, kind) {
    var list = ""
    var i = 0
    while (i < miss.length) {
        if (i > 0 && miss.length > 2) { list = list + "," }
        if (i > 0 && i == miss.length - 1) { list = list + " and" }
        if (i > 0) { list = list + " " }
        list = list + "'" + miss[i] + "'"
        i = i + 1
    }
    return "missing " + miss.length + " required " + kind + " argument" + (miss.length == 1 ? "" : "s") + ": " + list
}

function pyDUsed(used, name) {
    var i = 0
    while (i < used.length) {
        if (used[i] == name) { return true }
        i = i + 1
    }
    return false
}

// ----- calling (Go: js_pycall / rt.callPyValue / rt.pyMethodCall) -----------

// f(args, kwargs): calling a CLASS instantiates it (allocate, then __init__
// with self prepended); calling an instance runs its __call__. The keyword dict
// is mapped onto the callee's parameters by pyBindCall.
function js_pycall(callee, pos, kw) {
    if (!pyIsArr(pos)) { fail("js_pycall args must be an array") }
    if (pyIsSuper(callee)) { return pySuperCall(callee, pos) }
    // A BUILTIN TYPE OBJECT is callable: `int` is the class, and calling it
    // converts. languages/python-to-llvm-ir.abnf binds int/str/float/bool/list/
