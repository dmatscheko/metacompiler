            throw pyExcInstance("KeyError", pyRepr(pyFArgAt(args, 0)))
        }
    }
    // THE WHOLE LIST METHOD SURFACE - docs/todo.md 1.3. `count` was the only one
    // 6eec533 added (pyMemberCall's `count` arm is KOTLIN's `xs.count { pred }`);
    // sort/insert/remove/extend/index/reverse/clear/copy all aborted with
    // "unknown list method" in every engine, and pop IGNORED its index argument
    // in all three ([3,1,2].pop(0) answered 2 where CPython answers 3). Go:
    // pyListMethod in abnf/jsrt.go; the interpreter: pyListMethod in
    // languages/python-interpreter.abnf.
    if (pyIsArr(target)) {
        if (pyIsListMethod(name)) { return pyListMethod(target, name, args, kw) }
    }
    if (pyDForeign(target, name)) {
        // A REAL, catchable AttributeError and not fail(): CPython's is
        // catchable, and both other engines raise one (pyMethodCall in
        // abnf/jsrt.go panics with a pyExcInstance, pyAttrErr in
        // languages/python-interpreter.abnf calls pyRaise), so
        // `try: xs.add(3) / except AttributeError` behaves the same in all three.
        throw pyExcInstance("AttributeError",
                            "'" + pyTypeName(target) + "' object has no attribute '" + name + "'")
    }
    return pyMemberCall(target, name, args)
