// strconv.FormatFloat(v, 'e', prec, 64): d.dddde+XX, at least two exponent digits.
//
// No path in Python's format mini-language reaches this one - pyFormatBody has no
// 'e' or 'g' case, so `{x:e}` falls into the default branch and prints pyString.
// It is kept here, exported, because chunk B owns the float rendering and any
// other chunk that needs Go's 'e' verb must not re-derive it.
function pyBSci(x, prec) {
    if (x !== x) { return "NaN" }
    if (x - x !== 0) {
        if (x > 0) { return "+Inf" }
        return "-Inf"
    }
    var neg = x < 0
    if (x == 0 && 1 / x < 0) { neg = true }
    var a = neg ? -x : x
    if (a == 0) {
        var z = "0"
        if (prec > 0) {
            z = z + "."
            var zi = 0
            while (zi < prec) {
