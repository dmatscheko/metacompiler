        // read here also sees Object.prototype under goja, so a method call
        // literally named "toString" / "valueOf" / "constructor" on a plain
        // object would find an inherited function and call it instead of
        // failing. The same collision is left standing in chunk D's instance arm
        // and in pyGetAttr, because guarding it with a "$" prefix here would
        // desynchronize this lookup from the one that stores the attributes.
        var own = target[name]
        if (own !== undefined && pyIsCallable(own)) { return own.apply(undefined, args) }
        fail("unknown method '" + name + "'")
        return null
    }
    fail("method call '" + name + "' on a " + pyFTypeOf(target))
