// The representation is {__pybig: true, neg: <bool>, limbs: [...]}: the
// MAGNITUDE as a LITTLE-ENDIAN array of base-10000 limbs and a separate sign, so
// every intermediate of the schoolbook algorithms below stays under 10^8 and a
// double holds it EXACTLY. The limb arithmetic is runtime.metajs's rtABig* layer,
// shared with ruby; this file supplies the {__pybig} constructor rtkABigNew.
//
// Zero is canonical: limbs == [0] and neg == false, so rtABigCmp needs no
// negative-zero case.
//
// Limits, and why:
//
//   * pyNum (rt.toNumber) answers NaN for a big, as Go's toNumber has no
//     *jsBigInt arm. The paths that need a big as a double convert explicitly:
//     pyAToF for `/`, rtABigFromNum for bigEqFloat. Integer arithmetic with a
//     big operand goes through pyABigPair / pyABigBin, the bit operators through
//     pyABitBin, both exact.
//
//   * Base-0 literal parsing. Go's js_bigint calls big.Int.SetString(s, 0),
//     which also accepts 0x / 0o / 0b prefixes and a leading-zero OCTAL. The one
//     caller, makeIntLit in languages/python-to-llvm-ir.abnf, reaches
//     js_bigint ONLY on the radix-10 branch with the '_' separators already
//     stripped, so pyABigFromStr accepts a sign and decimal digits only and
//     fails loudly on anything else - exactly where Go's `!ok` fails.
//
//   * Karatsuba / Knuth-D. The multiplication is O(n*m) schoolbook and the
//     division is a per-limb BINARY SEARCH for the quotient digit (14 compares a
//     limb). The reachable operands are Python integer literals, so this is
//     small and exact rather than fast.

// The rtkABigNew hook of runtime.metajs's rtABig* layer: a normalised {__pybig}.
function rtkABigNew(neg, limbs) {
    var ls = rtABigNorm(limbs)
    var n = neg
    if (ls.length == 1 && ls[0] == 0) { n = false }
    return {__pybig: true, neg: n, limbs: ls}
}

// Go's big.Int.Quo: TRUNCATED toward zero, so the sign is the sign of the product.
function pyABigQuo(x, y) {
    return rtkABigNew(x["neg"] != y["neg"], rtABigDivMag(x["limbs"], y["limbs"])["q"])
}

// Go's big.Int.Rem: the remainder takes the sign of the DIVIDEND.
function pyABigRem(x, y) {
    return rtkABigNew(x["neg"], rtABigDivMag(x["limbs"], y["limbs"])["r"])
}

// Go: big.Int.SetString(text, 0) - see the note above on why only base 10 with
// an optional sign (and the '_' separators Python allows, which the emitter has
// already stripped) is accepted.
function pyABigFromStr(text) {
    var s = text
    var neg = false
    var i = 0
    if (s.charAt(0) == "-") {
        neg = true
        i = 1
    } else {
        if (s.charAt(0) == "+") { i = 1 }
    }
    var digits = ""
    while (i < s.length) {
        var c = s.charAt(i)
        if (c != "_") {
            if (c < "0" || c > "9") { pyFail("invalid BigInt literal " + text) }
            digits = digits + c
        }
        i = i + 1
    }
    if (digits.length == 0) { pyFail("invalid BigInt literal " + text) }
    var limbs = []
    var end = digits.length
    while (end > 0) {
        var from = end - 4
        if (from < 0) { from = 0 }
        limbs.push(parseInt(digits.substring(from, end), 10))
        end = from
    }
    return rtkABigNew(neg, limbs)
}

// Go: bigEqFloat. Only an integral, finite double can equal an
// arbitrary precision int. `f - f != 0` is the finiteness test: it is NaN for
// both an infinity and a NaN and exactly 0 for everything else - there is no
// isFinite and no exponent literal in this dialect.
function pyABigEqFloat(x, f) {
    if (f - f != 0) { return false }
    if (f != Math.trunc(f)) { return false }
    return rtABigCmp(x, rtABigFromNum(f)) == 0
}

// Go: pyBigOperand. An exact bignum for a Python int operand: a big as
// itself, an integral double inside the exactly representable range as itself,
// a bool as 0/1. A float box, a non-integral double and anything past 2^53 - where
// the double is ALREADY an approximation - answer null, so the caller falls back
// to the double path rather than inventing precision the operand never had.
function pyABigOperand(v) {
    if (pyIsBig(v)) { return v }
    if (typeof v == "boolean") {
        if (v) { return rtABigFromNum(1) }
        return rtABigFromNum(0)
    }
    if (typeof v == "number") {
        if (v == Math.trunc(v) && Math.abs(v) <= 9007199254740992) { return rtABigFromNum(v) }
    }
    return null
}

// Go: pyBigBin. Python's integer arithmetic in arbitrary precision.
// `//` and `%` FLOOR, as Python's do: pyABigQuo/pyABigRem truncate (Go's Quo/Rem),
// which is not Python's answer for a negative divisor - 1e30 % -7 is -6, not +1.
// null for an operator with no exact integer form, so the caller falls through to
// the double path it always had.
function pyABigBin(op, x, y) {
    if (op == "+") { return rtABigAdd(x, y) }
    if (op == "-") { return rtABigSub(x, y) }
    if (op == "*") { return rtABigMul(x, y) }
    if (op == "//" || op == "%") {
        if (rtABigIsZero(y)) { return null } // Let the double path raise the usual error.
        var q = pyABigQuo(x, y)
        var rm = pyABigRem(x, y)
        if (!rtABigIsZero(rm) && rm["neg"] != y["neg"]) {
            if (op == "//") { return rtABigSub(q, rtABigFromNum(1)) }
            return rtABigAdd(rm, y)
        }
        if (op == "//") { return q }
        return rm
    }
    if (op == "**") {
        if (y["neg"]) { return null }
        // 0, 1 and -1 answer any exponent, one past 2^53 (no double holds it)
        // too. The limbs are decimal, so the lowest one's parity is the value's.
        var xl = x["limbs"]
        if (xl.length == 1 && xl[0] <= 1) {
            if (rtABigIsZero(y) || (x["neg"] && y["limbs"][0] % 2 == 0)) { return rtABigFromNum(1) }
            return x
        }
        var e = rtABigNarrow(y)
        if (typeof e != "number") { return null }
        return rtABigPow(x, e)
    }
    return null
}

// ----- the BITWISE operators, at arbitrary precision -------------------------
//
// Go: pyBitBin (abnf/jsrt.go), which is math/big's And/Or/Xor/Lsh/Rsh/Not.
// ECMAScript's |, &, ^, << and >> are ToInt32 with a five-bit shift count, which
// is wrong for every operand past 2^31 (`1 << 40` would be 256).
//
// Python's rule is INFINITE two's complement: a negative x behaves like the
// endless run of 1 bits above ~(|x| - 1). Working on magnitudes only, that is
// four identities per operator, all of them in terms of AND, OR, XOR and ANDNOT
// over NON-NEGATIVE bit strings:
//
//   -a & b   ==  b &~ (a-1)            -a | b   == -((a-1) &~ b + 1)
//   a & -b   ==  a &~ (b-1)            a | -b   == -((b-1) &~ a + 1)
//   -a & -b  == -(((a-1) | (b-1)) + 1) -a | -b  == -(((a-1) & (b-1)) + 1)
//   -a ^ b   == -(((a-1) ^ b) + 1)     -a ^ -b  ==  (a-1) ^ (b-1)
//
// The magnitude is carried as a LITTLE-ENDIAN array of single bits: the stored
// bignum is base-10000 decimal limbs, so a bit view has to be built by repeated
// halving either way, and once it is built the increments and decrements the
// identities need are two-line loops on it rather than bignum additions.
//
// js_pybin keeps a fast path in front of all of this for the case that actually
// runs in a loop - two operands inside int32 - where ECMAScript's own operators
// ARE the infinite two's complement answer.

// The largest shift count honoured. CPython answers a MemoryError somewhere above
// this; the cap keeps `1 << 10**9` from asking for a gigabyte of limbs.
var PY_BIT_SHIFT_MAX = 1048576

// bits - 1, IN PLACE; the caller only ever hands this a magnitude of at least 1.
function pyABitsDec(bits) {
    var i = 0
    while (i < bits.length && bits[i] == 0) {
        bits[i] = 1
        i = i + 1
    }
    if (i < bits.length) { bits[i] = 0 }
    return rtABitsTrim(bits)
}

// bits + 1, IN PLACE.
function pyABitsInc(bits) {
    var i = 0
    while (i < bits.length && bits[i] == 1) {
        bits[i] = 0
        i = i + 1
    }
    if (i == bits.length) { bits.push(1) } else { bits[i] = 1 }
    return bits
}

// A bit array back to a bignum.
function pyABitsToBig(neg, bits) { return rtkABigNew(neg, rtABigNorm(pynBitsToLimbs(bits, 10000))) }

// A SHIFT COUNT as a plain number. Anything past the cap answers a value the
// caller will reject, so an absurd count never allocates.
function pyABitsToNum(bits) {
    if (bits.length > 40) { return PY_BIT_SHIFT_MAX + 1 }
    var acc = 0
    var p = 1
    var i = 0
    while (i < bits.length) {
        if (bits[i] == 1) { acc = acc + p }
        p = p * 2
        i = i + 1
    }
    return acc
}

// Python's |, &, ^, << and >> over two exact ints.
function pyABitBin(op, x, y) {
    var an = x["neg"]
    var bn = y["neg"]
    var a = pynLimbsToBits(x["limbs"], 10000)
    var b = pynLimbsToBits(y["limbs"], 10000)
    if (op == "<<" || op == ">>") {
        // Go: rt.pyBitBin. A negative count is CPython's ValueError; past the
        // cap, >> is 0 or -1 and << of a nonzero int is too large to hold.
        if (bn) { pyRaiseExc("ValueError", "negative shift count") }
        var k = pyABitsToNum(b)
        if (k > PY_BIT_SHIFT_MAX) {
            if (op == ">>" && an) { return pyABitsToBig(true, [1]) }
            if (op == ">>" || a.length == 0) { return pyABitsToBig(false, []) }
            pyRaiseExc("OverflowError", "too many digits in integer")
        }
        if (op == "<<") { return pyABitsToBig(an, rtABitsShl(a, k)) }
        if (!an) { return pyABitsToBig(false, rtABitsShr(a, k)) }
        // floor(-a / 2^k) is -(((a-1) >> k) + 1), which is Python's -5 >> 1 == -3.
        return pyABitsToBig(true, pyABitsInc(rtABitsShr(pyABitsDec(a), k)))
    }
    if (op == "&") {
        if (!an && !bn) { return pyABitsToBig(false, rtABitsOp(RT_BIT_AND, a, b)) }
        if (an && !bn) { return pyABitsToBig(false, rtABitsOp(RT_BIT_ANDNOT, b, pyABitsDec(a))) }
        if (!an && bn) { return pyABitsToBig(false, rtABitsOp(RT_BIT_ANDNOT, a, pyABitsDec(b))) }
        return pyABitsToBig(true, pyABitsInc(rtABitsOp(RT_BIT_OR, pyABitsDec(a), pyABitsDec(b))))
    }
    if (op == "|") {
        if (!an && !bn) { return pyABitsToBig(false, rtABitsOp(RT_BIT_OR, a, b)) }
        if (an && !bn) { return pyABitsToBig(true, pyABitsInc(rtABitsOp(RT_BIT_ANDNOT, pyABitsDec(a), b))) }
        if (!an && bn) { return pyABitsToBig(true, pyABitsInc(rtABitsOp(RT_BIT_ANDNOT, pyABitsDec(b), a))) }
        return pyABitsToBig(true, pyABitsInc(rtABitsOp(RT_BIT_AND, pyABitsDec(a), pyABitsDec(b))))
    }
    if (op == "^") {
        if (!an && !bn) { return pyABitsToBig(false, rtABitsOp(RT_BIT_XOR, a, b)) }
        if (an && bn) { return pyABitsToBig(false, rtABitsOp(RT_BIT_XOR, pyABitsDec(a), pyABitsDec(b))) }
        if (an) { return pyABitsToBig(true, pyABitsInc(rtABitsOp(RT_BIT_XOR, pyABitsDec(a), b))) }
        return pyABitsToBig(true, pyABitsInc(rtABitsOp(RT_BIT_XOR, a, pyABitsDec(b))))
    }
    return null
}

// 2^k as an exact double, for k <= 1024. There is no exponent literal in the
// dialect and Math.pow is not part of it either, so it is a doubling loop.
function pyABitPow2(k) {
    var v = 1
    var i = 0
    while (i < k) {
        v = v * 2
        i = i + 1
    }
    return v
}

// ~x is -x - 1 in Python's infinite two's complement, at arbitrary precision.
function pyABitNot(x) {
    return rtABigSub(rtABigNeg(x), rtABigFromNum(1))
}

// An operand of a bit operator that ECMAScript's int32 operators already answer
// EXACTLY: inside int32 the two representations of a value coincide, and so do
// their |, & and ^ results, so the hot path costs one range test and no bignum.
function pyABitIsSmall(v) {
    if (typeof v != "number") { return false }
    // `v | 0` IS ToInt32, so this one test covers the range, the integrality, a
    // NaN and an infinity at once.
    return (v | 0) === v
}

// An operand of a shift that a plain double answers exactly: any integral value
// the double range holds without loss.
function pyABitIsExactInt(v) {
    if (typeof v != "number") { return false }
    if (v != Math.trunc(v)) { return false }
    return v >= 0 - 9007199254740992 && v <= 9007199254740992
}

// Go: pyBigPair. Both operands as exact bignums when AT LEAST ONE is a
// big and the other is an exact Python int. Python has ONE int type and it is
// arbitrary precision, so an int operand meeting a big PROMOTES - which is why
// this is not pyABigArith below, whose ECMAScript-shaped rule (BOTH sides big)
// the generic externals need.
//
// A big meeting a FLOAT answers {flo: true} instead, so js_pybin's float arm
// costs the common path nothing beyond this function's own first test.
function pyABigPair(l, r) {
    if (!pyIsBig(l) && !pyIsBig(r)) { return null }
    if (pyIsFlo(l) || pyIsFlo(r)) { return {flo: true} }
    var x = pyABigOperand(l)
    if (x === null) { return null }
    var y = pyABigOperand(r)
    if (y === null) { return null }
    return {x: x, y: y}
}

// Go: bigArith, including bigPair's rule that BOTH operands must be bigs - a big
// meeting a double falls back to the double path, where the big converts to NaN.
// Answers null for "not applicable", never a value, so the caller can tell it
// apart from a legitimate result.
function pyABigArith(op, l, r) {
    if (!pyIsBig(l)) { return null }
    if (!pyIsBig(r)) { return null }
    if (op == "+") { return rtABigAdd(l, r) }
    if (op == "-") { return rtABigSub(l, r) }
    if (op == "*") { return rtABigMul(l, r) }
    if (op == "/") {
        if (rtABigIsZero(r)) { return null } // Let the double path produce Inf/NaN.
        return pyABigQuo(l, r)
    }
    if (op == "%") {
        // Unreachable from Python (js_pybin's "%" is pyFloorMod on doubles), but
        // bigArith has the arm and the division already answers both halves.
        if (rtABigIsZero(r)) { return null }
        return pyABigRem(l, r)
    }
    return null
}

// ============================================================================
// The shared scalar helpers  (Go: rt.truthy, rt.typeOf, rt.strictEq, jsCompare,
// pyEqual, pyFloorMod)
// ============================================================================

// Go: rt.truthy. A big is truthy when its sign is not 0.
function pyATruthy(v) {
    if (v === null) { return false }
    if (v === undefined) { return false }
    if (typeof v == "boolean") { return v }
    if (typeof v == "number") { return v != 0 && v == v }
    if (typeof v == "string") { return v.length > 0 }
    if (pyIsBig(v)) { return !rtABigIsZero(v) }
    // 0.0 is falsy and NaN is TRUTHY (Go's truthy has no `t.f == t.f` on the
    // Python box); every other object is truthy.
    if (pyIsFlo(v)) { return v["__flo"] != 0 }
    // A complex is false only at 0j, with both parts zero.
    if (pyIsCplx(v)) { return pyCplxRe(v) != 0 || pyCplxIm(v) != 0 }
    var cls = pyInstClassOf(v)
    if (cls !== null) { return pyAUserTruthy(cls, v) }
    pyNotImplBool(v)
    return true
}

// Go: rt.pyNotImplBool. NotImplemented in a boolean context is CPython's
// TypeError.
function pyNotImplBool(v) {
    if (v === pyNotImpl) { pyRaiseExc("TypeError", "NotImplemented should not be used in a boolean context") }
}

// Go: rt.typeOf - the JAVASCRIPT typeof, which is what the two
// failure messages of js_pybin and js_pysum interpolate. It is NOT pyTypeName.
function pyAJsTypeOf(v) {
    if (v === undefined) { return "undefined" }
    if (v === null) { return "object" }
    if (pyIsBig(v)) { return "bigint" }
    if (pyIsFlo(v)) { return "number" } // Go: rt.typeOf's jsPyFlo arm.
    if (typeof v == "boolean") { return "boolean" }
    if (typeof v == "number") { return "number" }
    if (typeof v == "string") { return "string" }
    if (typeof v == "function") { return "function" }
    return "object"
}

// Go: rt.strictEq, narrowed to the Python value model - none of
// the Char / boxed-double / sized-integer arms is reachable from Python. Two
// DISTINCT bigs of the same value are equal (Go compares them with Cmp), so
// `x is y` on two big literals of the same value is true in both engines.
function pyAStrictEq(a, b) {
    if (pyIsBig(a) || pyIsBig(b)) {
        if (pyIsBig(a) && pyIsBig(b)) { return rtABigCmp(a, b) == 0 }
        return false
    }
    // A float box compares by VALUE against ANOTHER FLOAT only - this is what
    // `is` reads, and in Python a float is never `is` an int even when the two
    // are ==. The SAME box is itself even when it holds NaN (`x is x`), and two
    // different boxes are the same value when their doubles are === (CPython
    // folds 1.0 is 1.0 to true).
    if (pyIsFlo(a) || pyIsFlo(b)) {
        if (a === b) { return true }
        if (!pyIsFlo(a) || !pyIsFlo(b)) { return false }
        return a["__flo"] === b["__flo"]
    }
    return a === b
}

// Go: rt.jsCompare. The ONLY comparison path here. It carries two things a plain
// jsCompare port would not: the bigPair arm (both operands big -> Cmp; a big
// against a double falls into toNumber, which is NaN for a big, so EVERY ordering
// against a mixed pair is false in Go) and the answer 2 for NaN, which is what
// makes <, >, <= and >= all false at once.
function pyACompare(a, b) {
    if (typeof a == "string" && typeof b == "string") {
        if (a < b) { return -1 }
        if (a > b) { return 1 }
        return 0
    }
    if (pyIsBig(a) && pyIsBig(b)) { return rtABigCmp(a, b) }
    var an = pyNum(a)
    var bn = pyNum(b)
    if (an !== an || bn !== bn) { return 2 }
    if (an < bn) { return -1 }
    if (an > bn) { return 1 }
    return 0
}

// Go: rt.pyEqual. The set / list / dict arms are the prelude's
// pyEqual; the two bigint arms come FIRST here only because a __pybig is a plain
// object and the prelude's pyEqual has no reason to know about it. A big against
// anything that is neither a big nor a number falls through to strictEq in Go,
// which is false, so this answers false directly.
function pyAEqual(x, y) {
    // A bool IS an int, and the Go twin normalizes it AHEAD of its *jsBigInt cases,
    // so `True == <a big>` has to reach bigEqFloat with 1 and not answer false in
    // the arm below. The prelude's pyEqual carries exactly that arm, bigint case
    // included, so a bool operand goes straight there.
    if (typeof x == "boolean" || typeof y == "boolean") { return pyEqual(x, y) }
    if (pyIsBig(x)) {
        if (pyIsBig(y)) { return rtABigCmp(x, y) == 0 }
        if (pyIsFlo(y)) { return pyABigEqFloat(x, pyNum(y)) }
        if (pyIsNum(y)) { return pyABigEqFloat(x, y) }
        return false
    }
    if (pyIsBig(y)) {
        if (pyIsFlo(x)) { return pyABigEqFloat(y, pyNum(x)) }
        if (pyIsNum(x)) { return pyABigEqFloat(y, x) }
        return false
    }
    return pyEqual(x, y)
}

// Go: rt.pyToF. toNumber for the operands of `/`: a Python bigint is an
// arbitrary precision INT, so 10**28 / 1 has to be the float 1e+28 where pyNum
// (rt.toNumber) answers NaN for one.
function pyAToF(v) {
    if (pyIsBig(v)) { return parseFloat(rtABigStr(v)) }
    return pyNum(v)
}

// Go: pyFloorMod. Python's % of two ints takes the SIGN OF THE DIVISOR, and a
// zero is the int 0, never -0. Two floats go to pynFloMod.
function pyAFloorMod(x, y) {
    if (y == 0) { pyRaiseExc("ZeroDivisionError", "division by zero") }
    var r = x % y
    if (r == 0) { return 0 }
    if ((r < 0) != (y < 0)) { return r + y }
    return r
}

// Go: pyFloorOp. `//` or `%` of two numeric operands.
function pyAFloorOp(op, l, r) {
    var x = pyAOperand(l, op, l, r)
    var y = pyAOperand(r, op, l, r)
    if (y == 0) { pyRaiseExc("ZeroDivisionError", "division by zero") }
    if (pyIsFlo(l) || pyIsFlo(r)) {
        if (op == "//") { return pyMkFlo(pynFloDiv(x, y)) }
        return pyMkFlo(pynFloMod(x, y))
    }
    if (op == "%") { return pyAFloorMod(x, y) }
    var q = Math.floor(x / y)
    if (q == 0) { return 0 }
    return q
}

// ============================================================================
// Go: rt.jsAdd
// ============================================================================
function pyAJsAdd(l, r) {
    if (typeof l == "string" || typeof r == "string") { return pyToStr(l) + pyToStr(r) }
    // THE ONE REORDERING, and the exclusion that goes with it. Go reaches
    // bigArith AFTER the array/object arms because a *jsBigInt is a value of its
    // own and never a *jsObject; here a big IS a plain object, so the bigint arm
    // is taken FIRST (a big + a big has to answer a big, not a concatenation)
    // and the object arms then have to EXCLUDE one, or a MIXED pair would
    // concatenate where Go falls through.
    //
    // Falling through is the whole point: bigArith needs BOTH operands to be
    // bigints (bigPair), and rt.toNumber has no *jsBigInt arm, so
    // `0 + 10000000000000000000000000001` is NaN in the Go twin, not the
    // concatenation '010000000000000000000000000001'.
    var big = pyABigArith("+", l, r)
    if (big !== null) { return big }
    // The float box ahead of the object arms, which would otherwise CONCATENATE
    // it as a string (it is a plain object here, where Go's jsPyFlo is not).
    if (pyIsFlo(l) || pyIsFlo(r)) { return pyMkFlo(pyNum(l) + pyNum(r)) }
    if (pyIsArr(l) || pyIsArr(r)) { return pyToStr(l) + pyToStr(r) }
    if (pyIsBig(l) || pyIsBig(r)) { return pyNum(l) + pyNum(r) }
    if (pyIsObj(l) || pyIsObj(r)) { return pyToStr(l) + pyToStr(r) }
    return pyNum(l) + pyNum(r)
}

// Go: rt.pyArith - the -, * and / that take the bigint path.
// ----- PROMOTION PAST 2^53 ----------------------------------------------------
//
// A plain Python int is a double, so it is EXACT up to 2^53 and silently rounds
// above it. These two helpers are the TRIGGER for promoting to the arbitrary
// precision box, and they sit in the + / - / * arms of js_pybin, which is the
// hot path of every Python program.
//
// pyAOver53 is sound BOTH WAYS, which is what keeps the fast path to two
// comparisons. By the time an arm runs, both operands are plain and therefore
// integers of magnitude <= 2^53 (anything larger is a box and was taken by the
// pyABigPair arm above). If the TRUE result is >= 2^53 then so is the rounded
// double - rounding to nearest of a value at or above 2^53 cannot land below it,
// since 2^53 is representable - and if the true result is < 2^53 the double is
// exact. So no out-of-range answer escapes and no in-range one pays anything
// beyond the two compares. The typeof, which keeps a numeric-looking STRING
// concatenation ("9" + "9...") out of the box, is only reached when they pass.
function pyAOver53(v) {
