        }
        return (neg ? "-" : "") + z + "e+00"
    }
    var dec = pyBExactDec(a)
    var ip = dec["i"]
    var fp = dec["f"]
    var all = ip + fp
    // The exponent of the first significant digit, relative to the point.
    var lead = 0
    while (lead < all.length && all.charAt(lead) == "0") { lead = lead + 1 }
    var e = ip.length - 1 - lead
    var sig = all.substring(lead, all.length)
    var kept = pyBRoundHalfEven(sig, prec + 1)
    if (kept.length > prec + 1) {
        // 9.99 -> 10.0: one digit fell out of the mantissa.
        e = e + 1
        kept = kept.substring(0, prec + 1)
    }
    var m = kept.substring(0, 1)
    if (prec > 0) { m = m + "." + kept.substring(1, kept.length) }
    var es = "" + (e < 0 ? 0 - e : e)
    if (es.length < 2) { es = "0" + es }
