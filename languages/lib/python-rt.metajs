        i = i + 1
    }
    return out
}

// jsGenerator.drain (jsrt.go:566): materialize what is left of a generator.
// There is no tag test in layer 2, so the caller decides with pyIsGen and this
// only drives the protocol: next() -> {value, done} until done.
function pyCDrain(g) {
    var out = []
    var next = g["next"]
    if (!pyIsFn(next)) { return out }
    while (true) {
        var st = next.apply(g, [])
