    // class object type(x) hands out, so `[].__class__ is list` holds.
    if (name == "__class__") { return js_pytype(obj) }
    // CPython names a TYPE OBJECT differently from a value: "type object 'list'
    // has no attribute 'nope'", not "'type' object has no attribute 'nope'".
    var tn2 = pyClassName(obj)
    if (tn2 !== null) {
        pyRaiseExc("AttributeError", "type object '" + tn2 + "' has no attribute '" + name + "'")
    }
    // An attribute a builtin value does NOT have raises AttributeError, as
    // CPython does. An OWN property is still answered first, because a value that
    // really holds None must not be mistaken for a missing one (a compiled regex
    // and a match are read so).
