    if (i < spec.length && (spec.charAt(i) == "+" || spec.charAt(i) == "-" || spec.charAt(i) == " ")) {
        sign = spec.charAt(i)
        i = i + 1
    }
    if (i < spec.length && spec.charAt(i) == "0" && align == "") {
        fill = "0"
        align = "="
        i = i + 1
    }
    var width = 0
    while (i < spec.length && rtDigitAt(spec, i) >= 0) {
        width = width * 10 + rtDigitAt(spec, i)
        i = i + 1
    }
    var prec = 0 - 1
    if (i < spec.length && spec.charAt(i) == ".") {
        i = i + 1
        prec = 0
        while (i < spec.length && rtDigitAt(spec, i) >= 0) {
