function pyRaiseExc(name, msg) { throw pyExcInstance(name, msg) }

// pyExcInstanceV is pyExcInstance with the argument kept as a VALUE rather than
// as text. It exists for KeyError, whose argument is the KEY: CPython's
// KeyError.__str__ is repr(args[0]), so the repr happens in pyUserRender and
// e.args[0] stays the key. A separate function rather than a wider parameter
// because MetaJS is typed and pyExcInstance's msg is a string at every other call
// site.
function pyExcInstanceV(name, arg) {
    return {__class: pyExcClass(name), args: [arg]}
}

function pyRaiseExcV(name, arg) { throw pyExcInstanceV(name, arg) }

// pyIsKeyErrCls reports whether a class IS KeyError or derives from it. KeyError
// is the one builtin exception whose __str__ differs from BaseException's, and a
// subclass INHERITS that, so the test is the class chain rather than the name.
// isKeyErrCls in languages/python-interpreter.abnf and pyIsKeyErrCls in
// abnf/jsrt.go are this body.
function pyIsKeyErrCls(c) {
    var mro = pyMRO(c)
    for (var i = 0; i < mro.length; i++) {
        if (mro[i]["__name"] == "KeyError") { return true }
    }
    return false
}

// ===================================================== calling ==============

function pyCall(f, args) { return f.apply(undefined, args) }

function pyCallSelf(f, self, args) {
    var a = [self]
    for (var i = 0; i < args.length; i++) { a.push(args[i]) }
    return f.apply(undefined, a)
}

// ===================================================== sequences ============
//
// abnf/jsrt.go's pySeqElems: the element list of anything a slice assignment
// may take on its right hand side. A GENERATOR is DRAINED, which is the one arm that
// has to be written structurally here (see pyIsGen).

function pyDrainGen(g) {
    var out = []
    var nx = g["next"]
    while (true) {
        var st = nx.apply(g, [])
        if (st === undefined) { return out }
        if (st["done"] === true) { return out }
        out.push(st["value"])
    }
    return out
}

function pySeqElems(v) {
    var els = pySetElemsOf(v)
    if (els != null) {
        var c = []
        for (var i = 0; i < els.length; i++) { c.push(els[i]) }
        return c
    }
    if (Array.isArray(v)) {
        var a = []
        for (var j = 0; j < v.length; j++) { a.push(v[j]) }
        return a
    }
    if (pyIsGen(v)) { return pyDrainGen(v) }
    // A CURSOR gives what is LEFT of it, and the read exhausts it - the same rule
    // js_pylist and js_pyiter follow, so `xs[1:3] = iter([5, 6])` is [9, 5, 6, 9].
    if (pyIsIter(v)) { return pyIterRest(v) }
