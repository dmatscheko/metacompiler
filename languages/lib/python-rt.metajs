    }
    var icls = pyInstClassOf(target)
    if (icls !== null) {
        // Go reads inst.props[name] - the instance's OWN property map. A bare
        // member read here also sees Object.prototype under goja, so a method
        // call literally named "toString" / "valueOf" / "constructor" on an
        // instance would take this arm instead of the MRO one. The prelude's
        // pyGetAttr / pySetAttr store instance attributes under their plain
        // names, so guarding with a "$" prefix here would desynchronize the two;
        // the collision is left standing, exactly as it is in pyGetAttr.
        var own = target[name]
