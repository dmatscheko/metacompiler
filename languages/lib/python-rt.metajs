        var i = 0
        while (i < els.length) {
            if (pyAEqual(els[i], x)) { return true }
            i = i + 1
        }
        return false
    }
    if (pyIsArr(y)) {
        var j = 0
        while (j < y.length) {
            if (pyAEqual(y[j], x)) { return true }
            j = j + 1
        }
        return false
    }
    if (typeof y == "string") { return y.indexOf(pyToStr(x)) >= 0 }
    if (pyIsDict(y)) { return pyDictFind(y["keys"], x) >= 0 }
