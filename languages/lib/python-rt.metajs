        }
    }
    // set.add(x) and dict.pop(k[, default]) - docs/todo.md 1.4, whose third
    // bullet called them an interpreter-only gap; a probe at 4731755 answered
    // "unknown method 'add'" and "unknown dict method 'pop'" HERE too, so all
    // three engines were missing them. Go: the same two arms of pyMethodCall in
    // abnf/jsrt.go.
    var pdEls = pySetElemsOf(target)
    if (pdEls !== null && pdEls !== undefined) {
        if (name == "add") {
            pySetAdd(pdEls, pyFArgAt(args, 0)) // Already a member: no-op, returns None.
