// An index argument as a plain number. A bool IS an int in Python, a float box
// is not an index at all - and the TypeError is CPython's own text.
function pyListIdx(v) {
    if (typeof v == "number") { return v }
    if (typeof v == "boolean") {
        if (v) { return 1 }
        return 0
    }
    throw pyExcInstance("TypeError",
                        "'" + pyTypeName(v) + "' object cannot be interpreted as an integer")
}

// One end of an index() window: absent means the default, negative wraps, and
// both ends clamp into [0, n] - pySliceRange in abnf/jsrt.go.
function pyListClamp(v, dflt, n) {
    if (v === undefined || v === null) { return dflt }
    var i = pyListIdx(v)
    if (i < 0) { i = i + n }
    if (i < 0) { i = 0 }
    if (i > n) { i = n }
    return i
}

// list.sort(*, key=None, reverse=False), in place. CPython's is STABLE and both
// parameters are KEYWORD-ONLY - a positional argument is a TypeError there, so
// it is one here rather than being read as the key. reverse= is done by
// reversing, sorting ascending and reversing again, which is how CPython keeps
// equal elements in their original order under it; an inverted comparison would
// not. sorted() is this same function run on a copy, as in CPython, which is
// why its unknown-keyword error names sort(). As in CPython the list is EMPTY
// while it sorts, a list the key function grew is ValueError (its additions
// dropped), and an exception leaves the items as they were.
function pySortList(xs, args, kw) {
    if (args.length > 0) {
        throw pyExcInstance("TypeError", "sort() takes no positional arguments")
    }
    pyKwOnly(kw, "sort", "key", "reverse")
    var items = pyCCopyArr(xs)
    pyCReplaceArr(xs, [])
    var vals = []
    try {
        vals = pySortItems(items, kw)
    } catch (e) {
