// ----- strconv.FormatInt(int64(x), base) ------------------------------------
//
// Two things the naive loop got wrong, both measured: the digit alphabet is 36
// long and not 16 (to_s(36) of 100 is "2s"), and Go converts through int64,
// which SATURATES on arm64 - `int64(1e100)` is 0x7fffffffffffffff and its hex is
// "7fffffffffffffff", not the 84 digits a float loop produces. The digits are
// taken with the floor's sized-integer tag (tag 13), which is exact int64
// arithmetic, on the UNSIGNED reading of the magnitude - the one shape whose
// negation is exact for int64's minimum too, which is the trick java-rt.metajs
// records.
//
// Python's own callers always hand this an int32 (pyFormatBody converts with
// rt.toInt32 first), so the saturating branches are unreachable from js_pyformat;
// they are kept because this is the general helper the other chunks share.
var PYB_DIGITS = "0123456789abcdefghijklmnopqrstuvwxyz"

function pyBBaseStr(n, base) {
    var v = Math.trunc(n)
    if (v !== v) { v = 0 }
    if (v == 0) { return "0" }
    var neg = false
    var mag = sintRaw(0, 0, 64, true)
    if (v >= 9223372036854775808) {
        mag = sintRaw(2147483647, 4294967295, 64, true)   // int64 max
    } else if (v <= 0 - 9223372036854775808) {
        neg = true
        mag = sintRaw(2147483648, 0, 64, true)            // |int64 min|
    } else {
        neg = v < 0
        var a = neg ? -v : v
        mag = sintRaw(sintHi(a), sintLo(a), 64, true)
    }
    var b = sintRaw(0, base, 64, true)
    var zero = sintRaw(0, 0, 64, true)
    var out = ""
    while (sintCmp(mag, zero) != 0) {
        var d = sintNum(sintOp(4, mag, b))
        out = PYB_DIGITS.charAt(d) + out
        mag = sintOp(3, mag, b)
    }
    return (neg ? "-" : "") + out
}

// strings.ToUpper / strings.ToLower - the full Unicode SIMPLE mapping. The C
// floor's own toUpperCase / toLowerCase are exactly that (runtime.c generated its
// 328 ranges from the Go runtime's own answers), so an ASCII loop here would be a
// third, worse, copy: it printed "CAFé" for "café".
function pyBUpper(s) { return s.toUpperCase() }
function pyBLower(s) { return s.toLowerCase() }

// The first `n` BYTES of a string, as Go's body[:n] takes them. Every string the
// %s directive can be handed is valid UTF-8 here, and a cut that would land inside
// a multi-byte character stops before it - which is what a Go slice of a valid
// string does to the RUNES, and the corpus has no case that reaches it.
//
// Python's format mini-language never reaches this either: pyFormatBody uses
// `prec` ONLY as the fraction-digit count of the 'f' verb and never truncates a
// string, so `{s:.3}` on a str is a no-op in the Go twin. Exported for the
// other chunks' printf-style paths, where precision does count bytes.
function pyBByteCut(s, n) {
    var out = ""
    var i = 0
    while (i < s.length) {
        var next = out + s.charAt(i)
        if (byteLen(next) > n) { return out }
        out = next
        i = i + 1
    }
    return out
}


// ===================================================== format ===============
//
// rt.pyFormat (jsrt.go:9682) and rt.pyFormatBody (jsrt.go:9737):
// [[fill]align][sign][0][width][.precision][type], which is the slice of the
// format mini-language an f-string replacement field in practice writes.
//
// What the Go twin does NOT implement, and therefore neither does this port:
//   - the ',' and '_' thousands separators. Neither is a digit, so the width
//     scan stops before it and `.` is not next, which leaves it sitting at the
//     TYPE position: `{n:,}` takes pyFormatBody's default branch and prints
//     pyString(n) with no grouping at all. Reproduced exactly.
//   - the 'e', 'E', 'g', 'G', '%', 'c', 'n' and 's' verbs, which likewise fall
//     into the default branch and print pyString / pyRepr.
//   - the '!a' conversion: only conv == "r" is distinguished, so "!s" and "!a"
//     both take the pyString path.
//   - '=' alignment does not put the padding after the sign the way CPython
//     does; the Go twin treats '=' as a synonym for '>'.

// pyIsAlign (jsrt.go:9680).
function pyBIsAlign(ch) { return ch == "<" || ch == ">" || ch == "^" || ch == "=" }

function pyBRepeat(s, n) {
    var out = ""
    var i = 0
    while (i < n) {
        out = out + s
        i = i + 1
    }
    return out
}

// pyFormatBody (jsrt.go:9737). `prec` is -1 when the spec carried no `.`.
function pyBFormatBody(v, typ, prec, sign, conv) {
    var body = ""
    if (typ == "f" || typ == "F") {
        var p = prec
        if (p < 0) { p = 6 }
        body = pyBFixed(pyNum(v), p)
    } else if (typ == "d") {
        body = pyBBaseStr(pyNum(v) | 0, 10)
    } else if (typ == "x") {
        body = pyBBaseStr(pyNum(v) | 0, 16)
    } else if (typ == "X") {
        body = pyBUpper(pyBBaseStr(pyNum(v) | 0, 16))
    } else if (typ == "b") {
        body = pyBBaseStr(pyNum(v) | 0, 2)
    } else if (typ == "o") {
        body = pyBBaseStr(pyNum(v) | 0, 8)
    } else {
        if (conv == "r") { body = pyRepr(v) } else { body = pyStr(v) }
    }
    // The Go twin's guard is `if n, isNum := v.(float64); isNum && n >= 0`, a
    // type assertion on float64: a bool, a bignum and a string are all excluded,
    // and -0.0 >= 0 is TRUE, so `format(-0.0, "+f")` really does answer
    // "+-0.000000" there. Reproduced rather than repaired.
    if (sign == "+") {
        if (pyIsNum(v) && v >= 0) { body = "+" + body }
    }
    return body
}

// js_pyformat (jsrt.go:8022) over rt.pyFormat (jsrt.go:9682).
// format(v, spec, conv); conv is "", "r", "s" or "a" (the !conversion).
function js_pyformat(v, specV, convV) {
    var spec = pyToStr(specV)
    var conv = pyToStr(convV)
    if (spec == "") {
        if (conv == "r") { return pyRepr(v) }
        return pyStr(v)
    }
    var i = 0
    var fill = " "
    var align = ""
    // The Go twin indexes the spec by BYTE (spec[0:1], spec[1]). This port
    // indexes by UTF-16 unit, which is the same thing for every ASCII spec; a
    // non-ASCII FILL character differs - Go would take only its first byte and
    // pad with that broken fragment, and this pads with the whole character.
    if (spec.length > 1 && pyBIsAlign(spec.charAt(1))) {
        fill = spec.substring(0, 1)
        align = spec.charAt(1)
        i = 2
    } else if (spec.length > 0 && pyBIsAlign(spec.charAt(0))) {
        align = spec.charAt(0)
        i = 1
    }
    var sign = ""
    if (i < spec.length && (spec.charAt(i) == "+" || spec.charAt(i) == "-" || spec.charAt(i) == " ")) {
        sign = spec.charAt(i)
        i = i + 1
    }
    if (i < spec.length && spec.charAt(i) == "0" && align == "") {
        fill = "0"
        align = "="
        i = i + 1
    }
    var width = 0
    while (i < spec.length && pyBDigitAt(spec, i) >= 0) {
        width = width * 10 + pyBDigitAt(spec, i)
        i = i + 1
    }
    var prec = 0 - 1
    if (i < spec.length && spec.charAt(i) == ".") {
        i = i + 1
        prec = 0
        while (i < spec.length && pyBDigitAt(spec, i) >= 0) {
            prec = prec * 10 + pyBDigitAt(spec, i)
            i = i + 1
        }
    }
    var typ = ""
    if (i < spec.length) { typ = spec.charAt(i) }
    var body = pyBFormatBody(v, typ, prec, sign, conv)
    // rt.strLen is the UTF-16 code-unit length, NOT the byte length: the width
    // of this directive counts units, unlike the printf-style width the other
    // languages have. `.length` is exactly rt.strLen.
    var pad = width - body.length
    if (pad <= 0) { return body }
    // A number right-aligns by default, everything else left-aligns. `isNum` is
    // Go's float64 assertion, so a bool and a bignum left-align.
    var isNum = pyIsNum(v)
    if (align == ">" || align == "=" || (align == "" && isNum)) {
        return pyBRepeat(fill, pad) + body
    }
    if (align == "^") {
        var left = Math.floor(pad / 2)
        return pyBRepeat(fill, left) + body + pyBRepeat(fill, pad - left)
    }
    return body + pyBRepeat(fill, pad)
}
// ============================================================================
// CHUNK C - containers, indexing, slicing and destructuring
//
// Ports, function for function, from abnf/jsrt.go:
//
//   js_pyget      6297   js_pyset      6339   js_dict_new   6369
//   js_pylen      6974   js_pylist     6997   js_pyiter     7020
//   js_pyrest     7105   js_pyspread   7300   js_pykwspread 7325
//   js_pyset_new  7386   js_pyset_spread 7397 js_pyslice3   7420
//   js_pysetslice 7443   js_pydelslice 7477   js_pydict     7639
//   js_pyellipsis 7677   js_pydel_item 7699   js_pymatchseq 7794
//   js_pymatchmap 7806   js_pymaprest  7827   js_pymatchargs 7856
//   js_is_type    5266  (rt.isTypeName, jsrt.go:8432)
//
// plus the helpers those need that the prelude does not carry:
// rt.pyGenericAlias (8662), rt.pyClampIndex (8728) and rt.pySliceStart (8750).
//
// `js_pyget` / `js_pyset` / `js_pylen` / `js_dict_new` / `js_is_type` were
// already written twice in layer 2 - languages/lib/dart-rt.metajs (1301-1485)
// and languages/lib/ruby-rt.metajs (2111-2216). Those two are the base here;
// what BOTH of them deleted as unreachable from their language is added back:
//
//   - the `__getitem__` / `__setitem__` / `__len__` dunder arms (a Python class
//     may define them; a Dart or Ruby class cannot name a member that way),
//   - the generic-alias arm of js_pyget (list[int] is a VALUE in Python),
//   - the set arm of js_pylen (Ruby's twin has no Python set),
//   - the code-POINT string length of js_pylen (Ruby counted code units).
//
// ---- one Go inconsistency that is ported as it stands -----------------------
// Go indexes and slices a string by UTF-16 CODE UNIT (rt.strLen / rt.strAt /
// rt.strRange) but measures it with `len()` in CODE POINTS (pyStrLen). So
// s[0] of an emoji string is half a surrogate pair while len(s) is 1. That is
// what abnf/jsrt.go does, the brief says the Go code is the specification, and
// so `.length` / `.charAt` (code units) are used everywhere Go used strLen /
// strAt, and the prelude's pyStrLen (code points) only in js_pylen.
// ============================================================================


// ----- module state ---------------------------------------------------------

// rt.pyAliases: the memo table of pyGenericAlias. Keyed by the rendered
// "origin[param]" text with the mandatory "$" prefix, so a user type called
// "constructor" or "toString" cannot collide with an Object.prototype member
// and make goja and -frozen disagree about which keys exist.
var pyCAliases = {}

// rt.pyEllipsis: the ONE ellipsis object of the runtime, so `x is ...` holds.
var pyCEllipsis = null


// ----- small shared helpers -------------------------------------------------

// rt.truthy, for the flag arguments the pattern externs take. The emitter only
// ever writes hTrue / hFalse into them, but Go really does call rt.truthy.
function pyCTruthy(v) {
    if (v === true) { return true }
    if (v === false) { return false }
    if (pyIsNone(v)) { return false }
    if (typeof v == "number") { return v !== 0 && v === v }
    if (typeof v == "string") { return v.length > 0 }
    return true
}

// A fresh copy of an array (Go's `append([]interface{}{}, xs...)`).
function pyCCopyArr(xs) {
    var out = []
    var i = 0
    var n = xs.length
    while (i < n) {
        out.push(xs[i])
        i = i + 1
    }
    return out
}

// The characters of a string as a list, by CODE UNIT - Go's
// `for i, n := 0, rt.strLen(o); i < n; i++ { out = append(out, rt.strAt(o, i)) }`.
function pyCStrChars(s) {
    var out = []
    var i = 0
    var n = s.length
    while (i < n) {
        out.push(s.charAt(i))
        i = i + 1
    }
    return out
}

// jsGenerator.drain (jsrt.go:566): materialize what is left of a generator.
// There is no tag test in layer 2, so the caller decides with pyIsGen and this
// only drives the protocol: next() -> {value, done} until done.
function pyCDrain(g) {
    var out = []
    var next = g["next"]
    if (!pyIsFn(next)) { return out }
    while (true) {
        var st = next.apply(g, [])
        if (!pyIsObj(st)) { break }
        if (st["done"] === true) { break }
        out.push(st["value"])
    }
    return out
}

// rt.pyClampIndex (jsrt.go:8728): one written slice bound as a position -
// negative counts from the end, out of range clamps to the edge the step runs
// towards. Only pyCSliceStart below needs it; the full index list comes from
// the prelude's pySliceIndices.
function pyCClampIndex(i_in, n, step) {
    var i = i_in
    if (i < 0) {
        i = i + n
        if (i < 0) {
            if (step < 0) { return -1 }
            return 0
        }
        return i
    }
    if (i >= n) {
        if (step < 0) { return n - 1 }
        return n
    }
    return i
}

// rt.pySliceStart (jsrt.go:8750): where an EMPTY step-1 slice splices at.
function pyCSliceStart(n, lo) {
    if (pyIsNone(lo)) { return 0 }
    return pyCClampIndex(Math.trunc(pyNum(lo)), n, 1)
}

// Replace an array's contents in place with those of `src`. Go assigns
// arr.elems, which every alias of the handle sees; `array.length` is not
// assignable in this dialect, so the truncation is a pop loop.
function pyCReplaceArr(arr, src) {
    var i = 0
    var n = src.length
    while (i < n) {
        if (i < arr.length) { arr[i] = src[i] } else { arr.push(src[i]) }
        i = i + 1
    }
    while (arr.length > n) { arr.pop() }
    return undefined
}

// Remove index i from an array in place (Go's
// `append(xs[:i], xs[i+1:]...)`); there is no Array.prototype.splice here.
function pyCRemoveAt(arr, i) {
    var j = i
    while (j < arr.length - 1) {
        arr[j] = arr[j + 1]
        j = j + 1
    }
