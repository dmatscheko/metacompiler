            pyRaiseExc("TypeError", fname + "() got an unexpected keyword argument '" + ks[i] + "'" + pyDidYouMean(pyToStr(ks[i]), [a, b]))
        }
        i = i + 1
    }
    return undefined
}

// One keyword argument of a method call, or undefined when it was not passed.
function pyKwArg(kw, name) {
    if (kw === null || kw === undefined) { return undefined }
    if (!pyIsDict(kw)) { return undefined }
    var i = pyDictFind(kw["keys"], name)
    if (i < 0) { return undefined }
    return kw["vals"][i]
}

// ------------------------------------------------------------ dict / set ---
//
// The NAME SETS first, so that hasattr()/getattr() ask exactly what the
// dispatcher answers. Keep in step with pyIsDictMethod/pyIsSetMethod in
// abnf/jsrt.go and in languages/python-interpreter.abnf. dict.fromkeys lives on
// the TYPE object (pyBuiltinClsMethod), not here.
function pyIsDictMethod(name) {
    if (name == "keys" || name == "values" || name == "items") { return true }
    if (name == "get" || name == "pop" || name == "clear") { return true }
    if (name == "copy" || name == "setdefault" || name == "update") { return true }
    if (name == "popitem") { return true }
    return false
}

function pyIsSetMethod(name) {
    if (name == "add" || name == "pop" || name == "clear") { return true }
    if (name == "copy" || name == "remove" || name == "discard") { return true }
    if (name == "union" || name == "update" || name == "issubset") { return true }
    return pyIsSetOnlyAlgebra(name)
}

// The names one of the two types owns and the other does NOT, which is exactly
// what CPython raises AttributeError for. They are narrower than the two sets
// above: pop, clear, copy and update are on BOTH a dict and a set.
function pyIsDictOnly(name) {
    if (name == "keys" || name == "values" || name == "items") { return true }
    if (name == "get" || name == "setdefault" || name == "popitem") { return true }
    return false
}

function pyIsSetOnly(name) {
    if (name == "add" || name == "remove") { return true }
    if (name == "discard" || name == "union" || name == "issubset") { return true }
    return pyIsSetOnlyAlgebra(name)
}

// The set algebra methods, which a dict does not have either.
function pyIsSetOnlyAlgebra(name) {
    if (name == "issuperset" || name == "isdisjoint") { return true }
    if (name == "intersection" || name == "difference" || name == "symmetric_difference") { return true }
    if (name == "intersection_update" || name == "difference_update") { return true }
    return name == "symmetric_difference_update"
}

// Every error below is a CATCHABLE Python exception with CPython 3.14's exact
// text, not fail(), for the same reason the list surface is.
