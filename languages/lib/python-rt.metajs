// ----- js_pyset_new -----------------------------------------------------------
// {a, b, c} / {e for x in it}: a real set from the candidate list the literal or
// the comprehension collected, deduplicated with Python's == (pySetAdd), NOT
// with ===. A non-array argument yields the empty set.
function js_pyset_new(src) {
    var out = []
