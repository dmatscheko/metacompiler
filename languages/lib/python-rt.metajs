// The integer argument of isqrt / comb / perm: an int or a bool, as an int.
// Go: rt.pyMathIntArg.
function pyMIntArg(v) {
    if (v === true) { return 1 }
    if (v === false) { return 0 }
    if (typeof v == "number" || pyIsBig(v)) { return v }
    pyRaiseExc("TypeError", "'" + pyTypeName(v) + "' object cannot be interpreted as an integer")
    return 0
}

function pyMLess(a, b) { return pyATruthy(js_pybin("<", a, b)) }

function pyMAnyBig(args) {
    var i = 0
    while (i < args.length) {
        if (pyIsBig(args[i])) { return true }
        i = i + 1
    }
    return false
}

// gcd / lcm once an operand is past the exact-double range: Euclid on Python
// ints. Go: the big.Int arm of pyMathCall.
function pyMGcdBig(args, gcd) {
    var acc = anytype
    acc = js_pyabs(pyMIntArg(args[0]))
    var i = 1
    while (i < args.length) {
        var b = anytype
        b = js_pyabs(pyMIntArg(args[i]))
        var x = anytype
        x = acc
        var y = anytype
        y = b
        while (pyATruthy(y)) {
            var t = anytype
            t = js_pybin("%", x, y)
            x = y
            y = t
        }
        if (gcd) { acc = x }
        else if (!pyATruthy(x)) { acc = 0 }
        else { acc = js_pybin("*", js_pybin("//", acc, x), b) }
        i = i + 1
    }
    return acc
}

// isqrt by Newton's iteration on Python ints (pyMIsqrt in
// python-interpreter.abnf explains it). Go: big.Int.Sqrt in pyMathCall.
function pyMIsqrt(n) {
    if (pyMLess(n, 0)) { pyRaiseExc("ValueError", "isqrt() argument must be nonnegative") }
    if (pyMLess(n, 2)) { return n }
    var x = anytype
    x = n
    var y = anytype
    y = js_pybin("//", js_pybin("+", x, 1), 2)
    while (pyMLess(y, x)) {
        x = y
        y = js_pybin("//", js_pybin("+", x, js_pybin("//", n, x)), 2)
    }
    return x
}

// comb(n, k) / perm(n, k) on Python ints. Go: rt.pyMathComb.
function pyMComb(n, k, choose) {
    if (pyMLess(n, 0)) { pyRaiseExc("ValueError", "n must be a non-negative integer") }
    if (pyMLess(k, 0)) { pyRaiseExc("ValueError", "k must be a non-negative integer") }
    if (pyMLess(n, k)) { return 0 }
    var steps = anytype
    steps = k
    if (choose && pyMLess(js_pybin("-", n, k), k)) { steps = js_pybin("-", n, k) }
    var r = anytype
    r = 1
    var i = 0
    while (pyMLess(i, steps)) {
        r = js_pybin("*", r, js_pybin("-", n, i))
        i = i + 1
        if (choose) { r = js_pybin("//", r, i) }
    }
    return r
}

// fsum: Shewchuk's exactly rounded sum, CPython's math_fsum. Go:
// rt.pyMathFsum; pyMFsum in python-interpreter.abnf explains it.
function pyMFsum(xs) {
    var partials = []
    var special = 0
    var infSum = 0
    var k = 0
    while (k < xs.length) {
        var x = xs[k]
        var xsave = x
        var n = 0
        var j = 0
        while (j < partials.length) {
            var y = partials[j]
            if (Math.abs(x) < Math.abs(y)) {
                var t = x
                x = y
                y = t
            }
            var hi = x + y
            var lo = y - (hi - x)
            if (lo != 0) {
                partials[n] = lo
                n = n + 1
            }
            x = hi
            j = j + 1
        }
        partials = partials.slice(0, n)
        if (x != 0) {
            if (x - x != 0) {
                if (xsave - xsave == 0) { pyRaiseExc("OverflowError", "intermediate overflow in fsum") }
                if (xsave == xsave) { infSum = infSum + xsave }
                special = special + xsave
                partials = []
            } else {
                partials.push(x)
            }
        }
        k = k + 1
    }
    if (special != 0) {
        if (infSum != infSum) { pyRaiseExc("ValueError", "-inf + inf in fsum") }
        return special
    }
    return pyMFsumTail(partials)
}

function pyMFsumTail(partials) {
    var m = partials.length
    if (m == 0) { return 0 }
    m = m - 1
    var hi = partials[m]
    var lo = 0
    while (m > 0) {
        var x = hi
        m = m - 1
        var y = partials[m]
        hi = x + y
        lo = y - (hi - x)
        if (lo != 0) { break }
    }
    if (m > 0 && ((lo < 0 && partials[m - 1] < 0) || (lo > 0 && partials[m - 1] > 0))) {
        var y2 = lo * 2
        var x2 = hi + y2
        if (y2 == x2 - hi) { hi = x2 }
    }
    return hi
}


// js_pyrxstr is str()/print() of a pattern or a match. The Go twin falls through
// to the js_pystr extern; here it falls through to the prelude's pyStr, which is
// that extern's whole body (Go rt.pyString).
function js_pyrxstr(v) {
    var r = pyERxRepr(v)
    if (r["ok"]) { return r["s"] }
    return pyStr(v)
}

// ===================================================== js_pymcall ===========
//
// abnf/jsrt.go's js_pymcall: a METHOD CALL. python-to-llvm-ir.abnf never emits it
// directly - js_pyrxmcall intercepts the `re` module, a Pattern and a
// Match first and falls through to here - so it is not in the export list the
// emitter needs, but it IS the entry point of the whole method surface.
function js_pymcall(target, name, args, kw) { return pyDMethodCall(target, name, args, kw) }

// ============================================================================
// The builtin method table (the pyF* helpers).
//
// Ports abnf/jsrt.go's memberCall(target, name, args) for the Python value
// model. The entry point is deliberately NOT prefixed: pyDMethodCall calls it by
// exactly this name as its final fall-through
// (js_pyrxmcall -> js_pymcall -> pyDMethodCall -> pyMemberCall).
//
// Go's memberCall is the LANGUAGE-NEUTRAL dispatcher shared by Java, Kotlin,
// Go, Dart and Python. Python's own method surface (str methods, the list, dict
// and set surfaces, the generator protocol, `re`) is answered in pyDMethodCall
// before this is reached, and pyDForeign denies the other languages' method
// names first, so what is left here is mostly the error arms.
// ============================================================================

// rt.typeOf, for the final failure message only. The one place
// it differs from the floor's own `typeof` is the arbitrary-precision integer:
// Go's *jsBigInt answers "bigint", while layer 2 represents it as a plain
// object, which `typeof` would call "object".
function pyFTypeOf(v) {
    if (pyIsBig(v)) { return "bigint" }
    return typeof v
}

// pyFCopyArr is SHARED as rtCopyArr - lib/runtime.metajs.

// ---------------------------------------------------------------- strings ---

// The string arm of memberCall - the "Java style builtins" - and NONE of them
// is ported: length / charAt / equals / substring / indexOf / isEmpty are
// Java's and Kotlin's spellings, and CPython raises AttributeError for every
// one of them. pyDForeign denies all six before this table is reached, exactly
// as abnf/jsrt.go's pyForeignMethod does, so what is left is the error arm.
//
// The function itself stays because pyMemberCall dispatches on the RECEIVER and
// pyStrMethod (the real Python string library) dispatches by NAME: a name
// neither knows has to land somewhere and say so.
function pyFStrMethod(o, name, args) {
    fail("unknown String method: " + name)
    return null
}

// ------------------------------------------------------------------ lists ---

// The *jsArray arm of memberCall. Go's o.dropIdx() invalidates the array's dict
// index cache before a mutation; layer 2 has no such cache, so those calls have
// no counterpart and are simply absent.
function pyFListMethod(o, name, args) {
    if (name == "append") {
        // Python: returns None.
        o.push(pyEArgAt(args, 0))
        return undefined
    }
    if (name == "pop") {
        // Python: removes and returns the last element. Go's arm takes NO index
        // argument; pyListMethod answers Python's pop(i) before this is reached.
        if (o.length == 0) { fail("pop from empty list") }
        return o.pop()
    }
    // add / size / get / contains / map / filter / any / sumOf / forEach are
    // KOTLIN's, Java's, Dart's and Swift's list methods and are NOT ported:
    // CPython raises AttributeError for every one of them and pyDForeign denies
    // them before this table is reached. The Go twin still HAS them, because
    // nine languages share that table.
    //
    // `count` is not among them: Python HAS list.count(x), and it counts EQUAL
    // elements where the Go twin's shared arm counts a Kotlin PREDICATE's
    // successes. pyDMethodCall answers it before reaching here (pyDListCount),
    // so this table never sees the name.
    fail("unknown list method '" + name + "'")
    return null
}

// ------------------------------------------------------------------ dicts ---

// The dict prefix of the *jsObject arm of memberCall. dictParts requires
// __dict === true AND both keys and vals to be arrays; the prelude's pyIsDict
// is that test.
//
// UNREACHABLE FROM PYTHON: pyDMethodCall answers the whole dict surface
// (pyDictMethod) before pyMemberCall is ever reached. The function stays for
// the reason pyFStrMethod does: pyMemberCall dispatches on the RECEIVER, so a
// name nothing knows has to land somewhere and say so.
function pyFDictMethod(o, name, args) {
    if (name == "keys") { return rtCopyArr(o["keys"]) }
    if (name == "values") { return rtCopyArr(o["vals"]) }
    if (name == "get") {
        var i = pyDictFind(o["keys"], pyEArgAt(args, 0))
        if (i >= 0) { return o["vals"][i] }
        if (args.length > 1) { return args[1] }
        return undefined
    }
    fail("unknown dict method '" + name + "'")
    return null
}

// ------------------------------------------------------- memberCall itself ---

// memberCall. The method call convention the class based
// language subsets share: instances are objects with a "__class" property
// pointing to their class descriptor object, whose properties hold the method
// closures (called with the instance prepended to the arguments); the lookup
// follows the descriptor's "__super" chain, which gives single inheritance.
// Objects without __class (class descriptors with static methods, plain objects
// with function properties) call the property directly. Strings get the Java
// style builtins.
//
// ORDER: Go dispatches on the Go TYPE, so its arms are disjoint and their order
// is immaterial. Layer 2 has no tags, so the order here is load bearing - a
// generator cell and a __pybig would both answer pyIsObj, and both must be
// taken out of the way before the plain-object arm. That is the only structural
// departure from the Go.
function pyMemberCall(target, name, args) {
    if (pyIsStr(target)) { return pyFStrMethod(target, name, args) }
    if (pyIsArr(target)) { return pyFListMethod(target, name, args) }
    if (pyIsDict(target)) { return pyFDictMethod(target, name, args) }
    if (pyIsGen(target)) {
        // A generator's protocol (next, return, ...) lives in its MEMBER TABLE -
        // the *jsGenerator case of getMember - and not in a property map, so a
        // method call resolves the member and calls it. Delegating rather than
        // repeating the member names here keeps the two in step and stays
        // language neutral: every member getMember exposes is callable as a
        // method, in every grammar that emits js_mcall.
        //
        // Layer 2's equivalent of getMember on a generator is a member read off
        // the floor cell, and the closure it answers is bound to the cell, so it
        // is applied WITH the cell as its receiver (Go's getMember hands back an
        // already-bound *boundMethod and then calls it with jsUndef; the two are
        // the same call). Note that Python's own send/next/__next__/close never
        // arrive here - pyDMethodCall answers them first, with the
        // StopIteration protocol - so this arm covers only the raw JS-shaped
        // members such as `return`.
        var gm = target[name]
        if (gm !== undefined && pyIsCallable(gm)) { return gm.apply(target, args) }
        fail("unknown method '" + name + "' on a generator")
        return null
    }
    // An arbitrary-precision integer is a *jsBigInt in Go - NOT a *jsObject - so
    // it must skip the object arm and land on the final failure, which reports
    // its type as "bigint".
    if (!pyIsBig(target) && pyIsObj(target)) {
        var cls = target["__class"]
        if (cls !== undefined) {
            // The lookup follows the __super chain (single inheritance).
            while (cls !== undefined && cls !== null) {
                if (!pyIsObj(cls)) { break }
                var m = cls[name]
                if (m !== undefined && pyIsCallable(m)) {
                    var argv = [target]
                    var i = 0
                    while (i < args.length) {
                        argv.push(args[i])
                        i = i + 1
                    }
                    return m.apply(undefined, argv)
                }
                cls = cls["__super"]
            }
            fail("unknown method '" + name + "' on an instance")
            return null
        }
        // Go reads o.props[name] - the object's OWN property map. A bare member
        // read here also sees Object.prototype under goja, so a method call
        // literally named "toString" / "valueOf" / "constructor" on a plain
        // object would find an inherited function and call it instead of
        // failing. The same collision is left standing in pyDMethodCall's
        // instance arm and in pyGetAttr, because guarding it with a "$" prefix
        // here would desynchronize this lookup from the one that stores the
        // attributes.
        var own = target[name]
        if (own !== undefined && pyIsCallable(own)) { return own.apply(undefined, args) }
        fail("unknown method '" + name + "'")
        return null
    }
    fail("method call '" + name + "' on a " + pyFTypeOf(target))
    return null
}

// ---- the four engine adapters this chapter is written against ----
function pySFail(msg) { fail(msg) }
// A catchable exception of class cls; pySRaiseKey is the KeyError whose argument
// is the missing key itself.
function pySRaise(cls, msg) { pyRaiseExc(cls, msg) }
function pySRaiseKey(nm) { pyRaiseExc("KeyError", nm) }
function pySTypeName(v) { return pyTypeName(v) }
function pySUnwrap(v) { return pyUnwrapBuiltin(v) }
function pySFormat1(v, spec, conv) { return js_pyformat(v, spec, conv) }
function pySGetAttr(v, nm) { return pyGetAttr(v, nm) }
function pySGetItem(v, k) { return js_pyidx(v, k) }
function pySIsArr(v) { return pyIsArr(v) }
function pySTruthy(v) { return pyATruthy(v) }
function pySKwGet(kw, nm) {
    var r = anytype
    r = undefined
    if (kw !== null && kw !== undefined) {
        if (pyIsDict(kw)) {
            var i = pyDictFind(kw["keys"], nm)
            if (i >= 0) { return kw["vals"][i] }
        }
    }
    pySRaiseKey(nm)
    return r
}
// ===================================================== str methods ==========
//
// Python's str method library. Written ONCE and carried in three engines -
// languages/python-interpreter.abnf, languages/lib/python-rt.metajs (this text,
// verbatim) and abnf/pystrmethod.go (a line-by-line Go port) - because a Python
// method call reaches a different implementation in each (interpreter /
// llvm.Run's Go twin / the native C floor + layer 2).
//
// Everything below is built out of the five string primitives the frozen MetaJS
// subset has (.length, charAt, charCodeAt, substring, indexOf) plus
// String.fromCharCode and unicodeCase, so that the same source compiles in the
// tag-script host AND through metajs-to-llvm-ir.abnf.
//
// INDEXING. CPython counts CODE POINTS and the floor's strings are UTF-16. The
// searches run on code UNITS and convert their window arguments and answers
// with pySCpUnit / pySUnitCp; the length-shaped methods (center/ljust/rjust/
// zfill, and the per-character walks of title/swapcase/upper/lower) count code
// POINTS directly.
//
// CASE MAPPING. upper() and lower() are CPython's full mapping with Final_Sigma
// (unicodeCase modes 3 and 6, abnf/casemap.go): "ß".upper() is "SS". The per-character
// helpers behind classification, title, capitalize, swapcase and casefold use the
// SIMPLE mapping (modes 1 and 0), one character for one.
//
// CLASSIFICATION (isalpha / isdigit / isspace / isupper / islower) is ASCII-exact.
// Outside ASCII, "cased" is derived from the case mapping (upper != lower), which
// covers Latin, Greek and Cyrillic; isdigit is ASCII-only, so CPython's Arabic-Indic
// digits answer False here. isspace carries the Unicode space code points by hand.

// ---- the character primitives ----

// The UTF-16 unit width of the code point starting at i.
function pySCPW(s, i) {
    var c = s.charCodeAt(i)
    if (c >= 55296 && c <= 56319 && i + 1 < s.length) {
        var t = s.charCodeAt(i + 1)
        if (t >= 56320 && t <= 57343) { return 2 }
    }
    return 1
}

// Python indexes a str by CODE POINT and the strings here are UTF-16: the unit
// index of code point cp, and back. A cp past the end stays as far past it, so
// a search window that starts beyond the string is still empty.
function pySCpUnit(s, cp) {
    if (byteLen(s) == s.length) { return cp } // ASCII: a unit is a code point.
    var i = 0
    var k = 0
    while (k < cp && i < s.length) {
        i = i + pySCPW(s, i)
        k = k + 1
    }
    return i + cp - k
}
function pySUnitCp(s, u) {
    if (byteLen(s) == s.length) { return u }
    var i = 0
    var k = 0
    while (i < u) {
        i = i + pySCPW(s, i)
        k = k + 1
    }
    return k
}

// The code points of s, each as a one- or two-unit string.
function pySChars(s) {
    var out = []
    var i = 0
    while (i < s.length) {
        var w = pySCPW(s, i)
        out.push(s.substring(i, i + w))
        i = i + w
    }
    return out
}

function pySUpCh(ch) {
    var c = ch.charCodeAt(0)
    if (c < 128) {
        if (c >= 97 && c <= 122) { return String.fromCharCode(c - 32) }
        return ch
    }
    return unicodeCase(ch, 1)
