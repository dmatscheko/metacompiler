// MetaJS object cannot be keyed by a function, so this is an identity-keyed
// SIDE TABLE: two parallel arrays and a linear `===` scan.
var pyBFnObjs = []       // the closures a def bound (identity scan)
var pyBFnNames = []      // the name each one was bound under, same index

