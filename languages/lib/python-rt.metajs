// PEP 654 'except* T' dispatch: (ExceptionGroup instance, type, ExceptionGroup
// class) -> a FRESH group over the leaves of the first that the type accepts, or
// undefined when the value is not a group or nothing in it matches.
function js_pyexcsplit(grp, typ, cls) {
