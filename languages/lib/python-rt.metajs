// ----- js_pydelslice ----------------------------------------------------------
// del xs[lo:hi:step]: drop every selected element. Go builds the drop set as a
// map[int]bool and then compacts; a boolean array over the same range is the
// same thing without a map.
function js_pydelslice(arr, lo, hi, step) {
    if (!pyIsArr(arr)) {
        fail("deleting a slice of a " + typeof arr)
        return undefined
    }
    var idx = pySliceIndices(arr.length, lo, hi, step)
    var drop = []
    var d = 0
    while (d < arr.length) {
        drop.push(false)
        d = d + 1
    }
    var i = 0
    while (i < idx.length) {
        if (idx[i] >= 0 && idx[i] < drop.length) { drop[idx[i]] = true }
        i = i + 1
    }
    var w = 0
    var r = 0
    var n = arr.length
    while (r < n) {
        if (!drop[r]) {
            arr[w] = arr[r]
            w = w + 1
        }
        r = r + 1
    }
    while (arr.length > w) { arr.pop() }
    return undefined
}


// ----- js_pydict --------------------------------------------------------------
// dict(x): a fresh dict copying the entries of a dict argument, in its
// insertion order. Anything else - including a list of pairs, which real Python
// accepts - yields the EMPTY dict, which is what the Go twin does.
function js_pydict(src) {
    var out = pyNewDict()
    if (pyIsDict(src)) {
        var keys = out["keys"]
        var vals = out["vals"]
        var sk = src["keys"]
        var sv = src["vals"]
        var i = 0
        var n = sk.length
        while (i < n) {
            // Go calls dictAppend, which APPENDS without a duplicate check.
            keys.push(sk[i])
            vals.push(sv[i])
            i = i + 1
        }
    }
    return out
}


// ----- js_pyellipsis ----------------------------------------------------------
// The Ellipsis singleton: `...` is a value of its own and `x is ...` has to
// hold, so there is exactly one of it per runtime.
function js_pyellipsis() {
    if (pyCEllipsis === null) { pyCEllipsis = {__name: "ellipsis"} }
    return pyCEllipsis
}


// ----- js_pydel_item ----------------------------------------------------------
// del obj[k]. Unlike js_pyget, whose miss is an rt.fail, this one RAISES a
// catchable KeyError / IndexError - the Go twin panics with a jsThrown.
function js_pydel_item(c, k) {
    var cls = pyInstClassOf(c) // A user class may define __delitem__.
    if (cls !== null && cls !== undefined) {
        if (pyLookupHas(cls, "__delitem__")) {
            var m = pyLookupVal(cls, "__delitem__")
            if (pyIsCallable(m)) {
                pyCallSelf(m, c, [k])
                return undefined
            }
        }
    }
    if (pyIsDict(c)) {
        var keys = c["keys"]
        var vals = c["vals"]
        var i = pyDictFind(keys, k)
        if (i < 0) { pyRaiseExcV("KeyError", k) }
        pyCRemoveAt(keys, i)
        pyCRemoveAt(vals, i)
        return undefined
    }
    if (!pyIsArr(c)) { pyNoItemOp(c, true) }
    var ai = pySeqIdx(c, k)
    if (ai < 0) { ai = ai + c.length }
    if (ai < 0 || ai >= c.length) { pyRaiseExc("IndexError", "list assignment index out of range") }
    pyCRemoveAt(c, ai)
