    }
    var cls = pyClassOf(target)
    if (cls !== null) {
        if (pyLookupHas(cls, name)) {
            var cm = pyLookupVal(cls, name)
            if (pyIsCallable(cm)) { return pyCall(cm, pyBindCall(cm, args, kw)) }
            return pyDCallPyValue(cm, args, kw)
