        var i = 0
        while (i < idx.length) {
            out.push(c[idx[i]])
            i = i + 1
        }
        return out
    }
    if (typeof c == "string") {
        // Go: rt.strLen / rt.strAt - UTF-16 code units.
        var sidx = pySliceIndices(c.length, lo, hi, step)
