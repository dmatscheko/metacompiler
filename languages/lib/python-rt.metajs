// CHUNK C - containers, indexing, slicing and destructuring
//
// Ports, function for function, from abnf/jsrt.go:
//
//   js_pyget      6297   js_pyset      6339   js_dict_new   6369
//   js_pylen      6974   js_pylist     6997   js_pyiter     7020
//   js_pyrest     7105   js_pyspread   7300   js_pykwspread 7325
//   js_pyset_new  7386   js_pyset_spread 7397 js_pyslice3   7420
//   js_pysetslice 7443   js_pydelslice 7477   js_pydict     7639
//   js_pyellipsis 7677   js_pydel_item 7699   js_pymatchseq 7794
//   js_pymatchmap 7806   js_pymaprest  7827   js_pymatchargs 7856
//   js_is_type    5266  (rt.isTypeName, jsrt.go:8432)
//
// plus the helpers those need that the prelude does not carry:
// rt.pyGenericAlias (8662), rt.pyClampIndex (8728) and rt.pySliceStart (8750).
//
// `js_pyget` / `js_pyset` / `js_pylen` / `js_dict_new` / `js_is_type` were
// already written twice in layer 2 - languages/lib/dart-rt.metajs (1301-1485)
// and languages/lib/ruby-rt.metajs (2111-2216). Those two are the base here;
// what BOTH of them deleted as unreachable from their language is added back:
//
//   - the `__getitem__` / `__setitem__` / `__len__` dunder arms (a Python class
//     may define them; a Dart or Ruby class cannot name a member that way),
//   - the generic-alias arm of js_pyget (list[int] is a VALUE in Python),
//   - the set arm of js_pylen (Ruby's twin has no Python set),
//   - the code-POINT string length of js_pylen (Ruby counted code units).
//
// ---- one Go inconsistency that is ported as it stands -----------------------
// Go indexes and slices a string by UTF-16 CODE UNIT (rt.strLen / rt.strAt /
// rt.strRange) but measures it with `len()` in CODE POINTS (pyStrLen). So
// s[0] of an emoji string is half a surrogate pair while len(s) is 1. That is
// what abnf/jsrt.go does, the brief says the Go code is the specification, and
// so `.length` / `.charAt` (code units) are used everywhere Go used strLen /
// strAt, and the prelude's pyStrLen (code points) only in js_pylen.
// ============================================================================


// ----- module state ---------------------------------------------------------

// rt.pyAliases: the memo table of pyGenericAlias. Keyed by the rendered
// "origin[param]" text with the mandatory "$" prefix, so a user type called
// "constructor" or "toString" cannot collide with an Object.prototype member
// and make goja and -frozen disagree about which keys exist.
var pyCAliases = {}

// rt.pyEllipsis: the ONE ellipsis object of the runtime, so `x is ...` holds.
var pyCEllipsis = null


// ----- small shared helpers -------------------------------------------------

// rt.truthy, for the flag arguments the pattern externs take. The emitter only
// ever writes hTrue / hFalse into them, but Go really does call rt.truthy.
function pyCTruthy(v) {
    if (v === true) { return true }
    if (v === false) { return false }
    if (pyIsNone(v)) { return false }
    if (typeof v == "number") { return v !== 0 && v === v }
    if (typeof v == "string") { return v.length > 0 }
    return true
}

// A fresh copy of an array (Go's `append([]interface{}{}, xs...)`).
function pyCCopyArr(xs) {
    var out = []
    var i = 0
    var n = xs.length
    while (i < n) {
        out.push(xs[i])
        i = i + 1
    }
    return out
}

// The characters of a string as a list, by CODE UNIT - Go's
// `for i, n := 0, rt.strLen(o); i < n; i++ { out = append(out, rt.strAt(o, i)) }`.
function pyCStrChars(s) {
    var out = []
    var i = 0
    var n = s.length
    while (i < n) {
