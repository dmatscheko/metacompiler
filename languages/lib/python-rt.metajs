// SystemExit.code: None for no argument, the argument for one, the args tuple
// for more. Go: pyExitCode.
function pyExitCode(e) {
    var args = e["args"]
    if (!pyIsArr(args) || args.length == 0) { return undefined }
    if (args.length == 1) { return args[0] }
    return args
