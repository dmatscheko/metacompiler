    if (n == 4) { return "InterruptedError" }
    if (n == 10) { return "ChildProcessError" }
    if (n == 17) { return "FileExistsError" }
    if (n == 20) { return "NotADirectoryError" }
    if (n == 21) { return "IsADirectoryError" }
