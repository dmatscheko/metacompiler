// the whole of Python's builtin hierarchy this subset models:
//
//     object is the base of everything      isinstance(1, object)  -> True
//     bool derives from int                 isinstance(True, int)  -> True
//
// Both were wrong, in two different ways: isinstance(1, object) was True in the
// interpreter and FALSE in both compiled halves (a live halves divergence the
// docs/todo.md 1.4 sweep turned up and the item did not list), while
// isinstance(True, int) and issubclass(bool, int) were False in EVERY engine -
// the defect class byte-identity cannot see. Go: pyBuiltinSub in abnf/jsrt.go.
function pyBuiltinSub(child, base) {
    if (child == base) { return true }
    if (base == "object") { return true }
    return child == "bool" && base == "int"
}

// issubclass(C, B) - docs/todo.md 1.4, one of its two named compiler-half gaps
// (`variable not defined: issubclass`). Go: rt.pyIsSubclass in abnf/jsrt.go;
// interpreter: clsIsSub in languages/python-interpreter.abnf.
