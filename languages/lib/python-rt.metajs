    // value and raise StopIteration - carrying the body's return value - at the
    // end, where JavaScript's next() answers a {value, done} record. There is no
    // tag test in layer 2, so "is this a generator" is pyIsGen's structural one.
    if (pyIsGen(target)) {
        if (name == "send" || name == "next" || name == "__next__") {
            var sent = anytype
            sent = undefined
