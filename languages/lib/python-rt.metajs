// ============================================================================
// Go: rt.pyComplexBin
// ============================================================================
// A real operand is promoted to (n, 0). Python has NO ordering on complex
// numbers, so < > <= >= answer null and js_pybin falls through to its usual
// path - which is what produces the error the two engines share.
function pyAComplexBin(op, l, r) {
    var lr = pyCplxRe(l)
    var li = pyCplxIm(l)
    var rr = pyCplxRe(r)
    var ri = pyCplxIm(r)
    if (op == "**") {
        // An integral power 0..100, by CPython's c_powu square-and-multiply (the
        // order of the products decides the rounding); an infinite part is
        // CPython's OverflowError.
        if (ri != 0 || rr < 0 || rr > 100 || Math.floor(rr) != rr) { return null }
        var ar = 1
        var ai = 0
        var pr = lr
        var pi = li
        var n = rr
        while (n > 0) {
            if (n % 2 == 1) {
                var t = ar * pr - ai * pi
                ai = ar * pi + ai * pr
                ar = t
            }
            var q = pr * pr - pi * pi
            pi = pr * pi + pi * pr
            pr = q
            n = Math.floor(n / 2)
