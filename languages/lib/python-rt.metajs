    var out = []
    if (it["__a"] === undefined) {
        while (true) {
            var st = it["next"]()
            if (st["done"] === true) { return out }
            out.push(st["value"])
        }
    }
    var i = it["__i"]
    while (i < it["__a"].length) {
        out.push(it["__a"][i])
        i = i + 1
    }
    it["__i"] = it["__a"].length
    return out
}

// js_pyiterof's element list, as a fresh array: a generator drains, an iterator
// gives what is left, a set copies, a dict gives its keys, a string its
// characters. Go: rt.pyElemsOf.
// Go: pySetMembers. A set's members in CPython's iteration order where
// pynSetOrder models it, else in insertion order; always a fresh array.
function pySetMembers(els) {
    var ord = pynSetOrder(els)
    if (ord === null) { return pyCCopyArr(els) }
    var out = []
    var i = 0
    while (i < ord.length) {
        out.push(els[ord[i]])
        i = i + 1
    }
    return out
}

function pyElemsOf(v) {
    if (pyIsIter(v)) { return pyIterRest(v) }
    if (pyIsGen(v)) { return pyADrainGen(v) }
    var els = pySetElemsOf(v)
    if (els !== null && els !== undefined) { return pySetMembers(els) }
    if (pyIsArr(v)) { return v }
    if (typeof v == "string") { return pySChars(v) }
    if (pyIsDict(v)) { return pyCCopyArr(v["keys"]) }
    if (typeof v == "object" && pyIsDView(v)) { return pyDViewElems(v) }
    var it = pyAUserIter(v)
    if (it !== undefined) { return pyADrainIter(it) }
    throw pyExcInstance("TypeError", "'" + pyTypeName(v) + "' object is not iterable")
