// Replace an array's contents in place with those of `src`. Go assigns
// arr.elems, which every alias of the handle sees; `array.length` is not
// assignable in this dialect, so the truncation is a pop loop.
function pyCReplaceArr(arr, src) {
    var i = 0
    var n = src.length
    while (i < n) {
        if (i < arr.length) { arr[i] = src[i] } else { arr.push(src[i]) }
        i = i + 1
    }
