    if (!pyIsDict(src)) { fail("cannot unpack a " + typeof src + " with **") }
    var keys = dst["keys"]
    var vals = dst["vals"]
    var sk = src["keys"]
    var sv = src["vals"]
    var i = 0
    var n = sk.length // Read once: Go ranges over the slice header it started with.
    while (i < n) {
        var j = pyDictFind(keys, sk[i])
        if (j >= 0) { vals[j] = sv[i] } else {
            keys.push(sk[i])
            vals.push(sv[i])
