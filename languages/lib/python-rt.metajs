    // pyListMethod in abnf/jsrt.go; the interpreter: pyListMethod in
    // languages/python-interpreter.abnf.
    if (pyIsBytes(target)) { return pyBytesMethod(target, name, args, kw) }
    if (pyIsSlice(target) && name == "indices") { return pySliceIndicesOf(target["__pyslice"], pyEArgAt(args, 0)) }
    if (pyIsArr(target)) {
