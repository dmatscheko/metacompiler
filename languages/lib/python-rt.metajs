    if (pyIsGen(it)) {
        var st = it["next"].apply(it, [undefined])
        if (st === undefined || st === null) { fail("generator step failed") }
        if (st["done"] === true) { return pyStopIter(args, st["value"]) }
        return st["value"]
    }
    // An instance whose class defines __next__ is an iterator: its
    // StopIteration ends it, re-raised as it was unless there is a default.
    var cls = pyInstClassOf(it)
    if (cls !== null && pyLookupHas(cls, "__next__")) {
