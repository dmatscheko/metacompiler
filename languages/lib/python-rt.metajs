// ================================================== the externs =============

// ----- js_dict_new (jsrt.go:6369) -------------------------------------------
// An empty Python dict handle. Identical to the dart-rt.metajs twin.
// js_dict_new is SHARED - lib/runtime.metajs (six identical copies, no knobs).


// ----- js_pyget (jsrt.go:6297) ----------------------------------------------
// Sequence indexing (negative wraps), dict lookup, and - the arm Ruby and Dart
// both deleted - the __getitem__ dunder of a user class plus the generic-alias
// reading of `list[int]`.
function js_pyget(c, k) {
    var cls = pyInstClassOf(c) // A user class may define __getitem__.
    if (cls !== null && cls !== undefined) {
        if (pyLookupHas(cls, "__getitem__")) {
            var m = pyLookupVal(cls, "__getitem__")
            if (pyIsCallable(m)) { return pyCallSelf(m, c, [k]) }
