function pyItStep(it) {
    // A cursor with no element array (pyASeqIter, pyAUserStepper) steps itself.
    if (it["__a"] === undefined) { return it["next"]() }
    if (it["__w"] !== undefined) { pyAWatchCheck(it) }
    if (it["__i"] >= it["__a"].length) { return {value: undefined, done: true} }
    var v = it["__a"][it["__i"]]
    it["__i"] = it["__i"] + 1
    return {value: v, done: false}
}

// Go: rt.pyWatchIter. An iterator over a dict, a set or a dict view WATCHES the
// container (__w, its size __n), as CPython's do: a size change between two
// steps is RuntimeError. A dict's iterator walks the dict's entry order as it is
// NOW: when the key at the cursor no longer matches __k, the surviving keys
// before the cursor give the new cursor and __a is re-read; yielding more items
// than the dict had (__y) is "dictionary keys changed during iteration".
function pyAWatchIter(v) {
    var it = pyMkIter(pyIterKind(v), pyCCopyArr(pyElemsOf(v)))
    var w = v
    if (pyIsDView(v)) { w = v["__vd"] }
    it["__w"] = w
    var els = pySetElemsOf(w)
    if (els !== null) {
        it["__n"] = els.length
    } else {
        it["__n"] = w["keys"].length
        it["__k"] = pyCCopyArr(w["keys"])
        it["__src"] = v
        it["__y"] = 0
    }
    return it
}
function pyAWatchCheck(it) {
    var w = it["__w"]
    var els = pySetElemsOf(w)
    var n = it["__n"]
    var msg = ""
    if (els !== null) {
        if (els.length != n) { msg = "Set changed size during iteration" }
    } else if (w["keys"].length != n) {
        msg = "dictionary changed size during iteration"
    } else if (n > 0) {
        var ks = it["__k"]
        var lk = w["keys"]
        var i = it["__i"]
        var at = i
        if (at > n - 1) { at = n - 1 }
        if (ks[at] !== lk[at]) {
            var j = 0
            var x = 0
            while (x < i) {
                if (ks[x] === lk[j]) { j = j + 1 }
                x = x + 1
            }
            it["__k"] = pyCCopyArr(lk)
            it["__a"] = pyCCopyArr(pyElemsOf(it["__src"]))
            it["__i"] = j
            i = j
        }
        if (i < it["__a"].length) {
            if (it["__y"] >= n) { msg = "dictionary keys changed during iteration" }
            it["__y"] = it["__y"] + 1
            // A value is read when it is reached, as CPython's iterator does.
            var src = it["__src"]
            if (pyIsDView(src)) {
                if (src["__dview"] == "values") { it["__a"][i] = w["vals"][i] }
                if (src["__dview"] == "items") { it["__a"][i] = pyTup([lk[i], w["vals"][i]]) }
            }
