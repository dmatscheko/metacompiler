// "cannot unpack a string into a set". Ported as it stands.
function js_pyset_spread(dst, src) {
    if (!pyIsArr(dst)) { return undefined }
    var els = pySetElemsOf(src)
    if (els !== null && els !== undefined) {
        var i = 0
        var n = els.length
        while (i < n) {
            dst.push(els[i])
            i = i + 1
        }
        return undefined
    }
    if (pyIsArr(src)) {
        var ai = 0
        var an = src.length
        while (ai < an) {
            dst.push(src[ai])
            ai = ai + 1
        }
        return undefined
    }
    if (pyIsDict(src)) {
        var ks = src["keys"]
        var ki = 0
        var kn = ks.length
        while (ki < kn) {
            dst.push(ks[ki])
            ki = ki + 1
        }
        return undefined
    }
    fail("cannot unpack a " + typeof src + " into a set")
    return undefined
}


// ----- js_pyslice3 ------------------------------------------------------------
// s[lo:hi:step] on lists and strings. The open ends arrive as undefined and mean
