        // A copy first, so xs.extend(xs) DOUBLES the list as it does in CPython
        // rather than looping forever. pyElemsOf raises CPython's own "'int'
        // object is not iterable" for a non-iterable.
        var src = pyCCopyArr(pyElemsOf(pyEArgAt(args, 0)))
