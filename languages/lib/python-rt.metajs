// ----- the generator side table --------------------------------------------

// A generator is a floor CELL: nothing can be stored on it, so `close()` - which
// in Go is g.finish(), setting g.done on the generator itself - is recorded in
// an identity-keyed side table instead (two parallel arrays and a `===` scan,
// as rbLambdas does in ruby-rt.metajs). Exhaustion needs no entry: the floor's
// own generator answers {value: undefined, done: true} for every step after the
// body returned, exactly as (*jsGenerator).step does (jsrt.go:483).
var pyDGenCell = []
var pyDGenClosed = []

function pyDGenIsClosed(g) {
    var i = 0
    while (i < pyDGenCell.length) {
        if (pyDGenCell[i] === g) { return pyDGenClosed[i] }
        i = i + 1
    }
    return false
}

