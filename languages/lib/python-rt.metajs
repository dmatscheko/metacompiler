// pyERxSplit is Go (*jsrt).rxPySplit - re.split. Unlike the engine's neutral
// rxSplit, Python SPLICES the capture groups of each separator into the result,
// so this walks the matches itself.
function pyERxSplit(rv, s, maxsplit) {
    var re = pyERxReOf(rv)
    var parts = []
    var at = 0
    var last = 0
    var n = 0
    while (at <= s.length) {
        if (maxsplit > 0 && n >= maxsplit) { break }
        var m = rxSearch(re, s, at)
        if (m === null) { break }
        if (m["end"] == m["begin"]) {
            if (m["begin"] >= s.length) { break }
            parts.push(s.substring(last, m["begin"]))
            pyERxAppendGroups(parts, re, s, m)
            // Go leaves `last` at the match's own begin here, NOT begin+1.
            last = m["begin"]
            at = m["begin"] + 1
            n = n + 1
            continue
        }
        parts.push(s.substring(last, m["begin"]))
        pyERxAppendGroups(parts, re, s, m)
        last = m["end"]
        at = m["end"]
        n = n + 1
    }
    parts.push(s.substring(last, s.length))
    return parts
}

// pyERxFindAll is Go (*jsrt).rxPyFindAll - re.findall / re.finditer: no group ->
// the whole matches, one group -> that group, more -> the capture tuple of each
// match.
function pyERxFindAll(rv, s, asMatch) {
    var re = pyERxReOf(rv)
    var src = rv["__src"]
    var out = []
    var at = 0
    while (at <= s.length) {
        var m = rxSearch(re, s, at)
        if (m === null) { break }
        if (asMatch) {
            out.push(pyERxMkMatch(rv, src, re["flags"], s, m))
        } else if (re["ngroups"] == 0) {
            // Go's `g, _ := re.group(...)` drops the ok here, so a null answers
            // as "" and not as None. Group 0 always participates, so this arm is
            // unreachable in practice; it is spelled Go's way anyway.
            var g0 = rxGroup(re, s, m, 0)
            if (g0 === null) { out.push("") } else { out.push(g0) }
        } else if (re["ngroups"] == 1) {
            var g1 = rxGroup(re, s, m, 1)
            if (g1 === null) { out.push(undefined) } else { out.push(g1) }
        } else {
            var t = pyTup([])
            pyERxAppendGroups(t, re, s, m)
            out.push(t)
        }
        if (m["end"] == m["begin"]) { at = m["end"] + 1 } else { at = m["end"] }
    }
    return out
}

// pyERxIsSpecial is the membership test of Go rxPyEscape's `special` constant,
// "()[]{}?*+-|^$\\.&~# \t\n\r\v\f", written by code point because \v and \f are
// not spellable as string escapes in this dialect.
function pyERxIsSpecial(c) {
    if (c == 40 || c == 41) { return true }        // ( )
    if (c == 91 || c == 93) { return true }        // [ ]
    if (c == 123 || c == 125) { return true }      // { }
    if (c == 63 || c == 42 || c == 43) { return true }  // ? * +
    if (c == 45 || c == 124) { return true }       // - |
    if (c == 94 || c == 36) { return true }        // ^ $
    if (c == 92 || c == 46) { return true }        // \ .
    if (c == 38 || c == 126 || c == 35) { return true } // & ~ #
    if (c == 32) { return true }                   // space
    if (c >= 9 && c <= 13) { return true }         // \t \n \v \f \r
    return false
}

// pyERxEscape is Go rxPyEscape - re.escape, CPython 3.7+: exactly the characters
// in _special_chars_map.
function pyERxEscape(s) {
    var out = ""
    var i = 0
    while (i < s.length) {
        var c = s.charCodeAt(i)
        if (c < 128 && pyERxIsSpecial(c)) { out = out + "\\" }
        out = out + s.charAt(i)
        i = i + 1
    }
    return out
}

// ----- Dispatch -----

// argAt: the i'th argument, or undefined past the end. Also used by the
// builtin method table below.
function pyEArgAt(args, i) {
    if (i < args.length) { return args[i] }
    return undefined
}

// pyERxArgRe is Go (*jsrt).rxPyArgRe.
function pyERxArgRe(v, flags) {
    if (pyERxIsRe(v)) { return v }
    return pyERxCompile(pyToStr(v), flags)
}

// pyERxIntArg is Go rxPyIntArg: a missing or non-numeric argument is 0.
function pyERxIntArg(args, i) {
    if (i < args.length) {
        if (typeof args[i] == "number") { return Math.trunc(args[i]) }
    }
    return 0
}

// pyERxKeyArg is Go rxPyKeyArg.
function pyERxKeyArg(a) {
    if (a.length > 0) { return a[0] }
    return 0
}

// pyERxModCall is Go (*jsrt).rxPyModCall - re.f(pattern, ...). Every one of those
// is the compiled pattern's own method with the pattern dropped, so the two entry
// points share one body; the only difference is where the optional flags argument
// sits.
function pyERxModCall(name, args) {
    if (name == "escape") { return pyERxEscape(pyToStr(pyEArgAt(args, 0))) }
    if (name == "purge") { return undefined }
    if (name == "compile") { return pyERxArgRe(pyEArgAt(args, 0), pyERxIntArg(args, 1)) }
    var flpos = -1
    if (name == "search" || name == "match" || name == "fullmatch" ||
        name == "findall" || name == "finditer") {
        flpos = 2
    } else if (name == "sub" || name == "subn") {
        flpos = 4
    } else if (name == "split") {
        flpos = 3
    } else {
        fail("unknown re function: " + name)
    }
    var rv = pyERxArgRe(pyEArgAt(args, 0), pyERxIntArg(args, flpos))
    var rest = []
    var i = 1
    while (i < args.length && i < flpos) {
        rest.push(args[i])
        i = i + 1
    }
    return pyERxReMethod(rv, name, rest)
}

// pyERxKwArgs is Go (*jsrt).pyReKwArgs: the keyword arguments moved into their
// positional slots, by the parameter names of re.NAME (mod) or Pattern.NAME.
function pyERxKwArgs(name, args, kw, mod) {
    if (!pyIsDict(kw)) { return args }
    if (kw["keys"].length == 0) { return args }
    var names = ["string", "pos", "endpos"]
    if (name == "sub" || name == "subn") { names = ["repl", "string", "count"] }
    if (name == "split") { names = ["string", "maxsplit"] }
    if (mod) {
        names = ["pattern", "string", "flags"]
        if (name == "compile") { names = ["pattern", "flags"] }
        if (name == "escape") { names = ["pattern"] }
        if (name == "purge") { names = [] }
        if (name == "sub" || name == "subn") { names = ["pattern", "repl", "string", "count", "flags"] }
        if (name == "split") { names = ["pattern", "string", "maxsplit", "flags"] }
    }
    return pyKwPos(name, args, kw, names, 0)
}

// pyERxReMethod is Go (*jsrt).rxPyReMethod.
function pyERxReMethod(rv, name, a) {
    if (name == "search") { return pyERxSearch(rv, pyToStr(pyEArgAt(a, 0)), pyERxIntArg(a, 1)) }
    if (name == "match") { return pyERxAnchored(rv, pyToStr(pyEArgAt(a, 0)), pyERxIntArg(a, 1), false) }
    if (name == "fullmatch") { return pyERxAnchored(rv, pyToStr(pyEArgAt(a, 0)), pyERxIntArg(a, 1), true) }
    if (name == "findall") { return pyERxFindAll(rv, pyToStr(pyEArgAt(a, 0)), false) }
    if (name == "finditer") { return pyERxFindAll(rv, pyToStr(pyEArgAt(a, 0)), true) }
    if (name == "sub" || name == "subn") {
        var r = pyERxSub(rv, pyEArgAt(a, 0), pyToStr(pyEArgAt(a, 1)), pyERxIntArg(a, 2))
        if (name == "sub") { return r["text"] }
        return pyTup([r["text"], r["n"]])
    }
    if (name == "split") { return pyERxSplit(rv, pyToStr(pyEArgAt(a, 0)), pyERxIntArg(a, 1)) }
    fail("unknown Pattern method: " + name)
    return undefined
}

// pyERxMatchMethod is Go (*jsrt).rxPyMatchMethod.
function pyERxMatchMethod(md, name, a) {
    if (name == "group") {
        if (a.length == 0) { return pyERxGroup(md, 0) }
        if (a.length == 1) { return pyERxGroup(md, a[0]) }
        var out = pyTup([])
        var i = 0
        while (i < a.length) {
            out.push(pyERxGroup(md, a[i]))
            i = i + 1
        }
        return out
    }
    if (name == "groups") { return pyERxGroups(md) }
    if (name == "groupdict") { return pyERxGroupDict(md) }
    if (name == "start") { return pyERxSpan(md, pyERxKeyArg(a), 0) }
    if (name == "end") { return pyERxSpan(md, pyERxKeyArg(a), 1) }
    if (name == "span") {
        var k = pyERxKeyArg(a)
        return pyTup([pyERxSpan(md, k, 0), pyERxSpan(md, k, 1)])
    }
    if (name == "expand") {
        var mo = pyERxMatchOf(md)
        return rxExpand(mo["re"], mo["text"], mo["m"], pyERxTemplate(pyToStr(pyEArgAt(a, 0))))
    }
    fail("unknown Match method: " + name)
    return undefined
}

// pyERxRepr is Go rxPyRepr: a pattern and a match the way CPython's repr does,
// so str(m)/print(m) agree with the interpreter grammar. Go returns
// (string, bool); the pair travels in a record here.
function pyERxRepr(v) {
    if (pyERxIsRe(v)) {
        var pat = v["pattern"]
        if (typeof pat != "string") { pat = "" }
        return {ok: true, s: "re.compile('" + pat + "')"}
    }
    if (pyERxIsMatch(v)) {
        var mo = pyERxMatchOf(v)
        var w = rxGroup(mo["re"], mo["text"], mo["m"], 0)
        // Go's `g, _ := re.group(...)` leaves g as "" when the group did not
        // participate; regex.js answers null there.
        return {ok: true, s: "<re.Match object; span=(" + pyStr(mo["m"]["begin"]) + ", " +
                             pyStr(mo["m"]["end"]) + "), match='" + (w === null ? "" : w) + "'>"}
    }
    return {ok: false, s: ""}
}

// ----- The externs -----

// js_pyrxmcall is the method-call wrapper: the re module, a compiled pattern and
// a match dispatch here, everything else goes straight on to js_pymcall. A
// module function's or a pattern method's keyword arguments are moved into
// their positional slots (pyERxKwArgs, pyMathKwArgs), as the Go twin does.
function js_pyrxmcall(target, name, args, kw) {
    // The `math` module rides the same dispatcher: js_pyrxmcall is the ONE
    // extern the python emitter routes every method call through, and a module
    // object is not an instance, a class, a dict or a list, so nothing further
    // down js_pymcall would find it.
    if (pyIsObj(target)) {
        var pm = target["__pymod"]
        if (pm === "math") {
            if (!pyIsArr(args)) { fail("js_pyrxmcall args must be an array") }
            var mn = pyToStr(name)
            return pyMathCall(mn, pyMathKwArgs(mn, args, kw))
        }
        if (pm === "sys") { return pySysCall(pyToStr(name), args, kw) }
    }
    if (pyERxIsMod(target) || pyERxIsRe(target) || pyERxIsMatch(target)) {
        if (!pyIsArr(args)) { fail("js_pyrxmcall args must be an array") }
        var nm = pyToStr(name)
        if (pyERxIsMod(target)) {
            // re.error(...) / re.PatternError(...) construct the class.
            if (nm == "error" || nm == "PatternError") { return pyDCallPyValue(target[nm], args, kw) }
            return pyERxModCall(nm, pyERxKwArgs(nm, args, kw, true))
        }
        if (pyERxIsRe(target)) { return pyERxReMethod(target, nm, pyERxKwArgs(nm, args, kw, false)) }
        return pyERxMatchMethod(target, nm, args)
    }
    return js_pymcall(target, name, args, kw)
}

// ================================================ the `math` module ========
//
// Go twin: abnf/jsrtpymath.go. Interpreter: hostGlobals["math"] plus pyMathCall
// in languages/python-interpreter.abnf.
//
// Every arm routes to the host `Math`, which the C floor seeds in full
// (runtime.c host ids 51-93) - d_pow / d_exp / d_log / d_sqrt already exist in
// the floor and must NOT be reimplemented here. What is NOT in Math is written
// out: expm1, log1p, fmod, copysign, factorial, fsum, and the integer helpers
// (isqrt, comb, perm, gcd, lcm), which run on Python's own int operators.
//
// THE ANSWER'S TYPE IS PART OF THE SPECIFICATION, and CPython is not uniform:
// sqrt / exp / log / pow / fabs / hypot / atan2 and the trigonometric family
// answer a FLOAT (math.pow(2, 10) is 1024.0), floor / ceil / trunc / gcd /
// factorial answer an INT, and isnan / isinf / isfinite answer a bool. A float
// is the {__flo} box; a plain number is an int.
//
// The module is a plain object with no function members, dispatched BY NAME
// through js_pyrxmcall: twenty-five stored closures would be twenty-five floor
// cells held forever (live data costs, see pyBBFnObjs).

// ----- the `builtins` module -------------------------------------------------
//
// CPython's len.__self__ IS the builtins module, and `builtins.len is len`
// holds. The emitter fills this object at boot from the very scope bindings the
// global names resolve to (see the builtins-module block of
// languages/python-to-llvm-ir.abnf), so the identity is not a copy.
// ONE builtins module per run, remembered so len.__self__ can answer it without
// a scope lookup layer 2 has no way to make.
var pyDBuiltinsMod = null

function js_pybuiltins_module() {
    if (pyDBuiltinsMod === null) { pyDBuiltinsMod = {__pymod: "builtins"} }
    return pyDBuiltinsMod
}

// Is `name` a function the runtime module `mod` (math, re or sys) offers? One
// list per module, consulted by the attribute read (`f = math.sqrt`, `from re
// import sub`) and by hasattr; the CALL path does not need it, because each
// module's call dispatch raises the AttributeError itself. Keep in step with
// pyModHas in languages/python-interpreter.abnf and in abnf/jsrtpymath.go.
function pyMHas(mod, name) {
    if (mod == "re") {
        if (name == "compile" || name == "search" || name == "match" || name == "fullmatch") { return true }
        if (name == "findall" || name == "finditer" || name == "sub" || name == "subn") { return true }
        return name == "split" || name == "escape" || name == "purge"
    }
    if (mod == "sys") {
        return name == "exit" || name == "get_int_max_str_digits" || name == "set_int_max_str_digits"
    }
    if (mod != "math") { return false }
    if (name == "sqrt" || name == "exp" || name == "expm1" || name == "log") { return true }
    if (name == "log1p" || name == "log2" || name == "log10" || name == "pow") { return true }
    if (name == "fabs" || name == "fmod" || name == "copysign" || name == "atan2") { return true }
    if (name == "hypot" || name == "sin" || name == "cos" || name == "tan") { return true }
    if (name == "asin" || name == "acos" || name == "atan" || name == "sinh") { return true }
    if (name == "cosh" || name == "tanh" || name == "degrees" || name == "radians") { return true }
    if (name == "floor" || name == "ceil" || name == "trunc" || name == "gcd") { return true }
    if (name == "lcm" || name == "factorial" || name == "isnan" || name == "isinf") { return true }
    if (name == "isfinite" || name == "isclose" || name == "cbrt") { return true }
    if (name == "frexp" || name == "ldexp" || name == "modf" || name == "ulp") { return true }
    if (name == "nextafter" || name == "dist") { return true }
    return name == "isqrt" || name == "comb" || name == "perm" || name == "prod" || name == "fsum"
}

function js_pymath_module() {
    return {
        __pymod: "math",
        pi: pyMkFlo(3.141592653589793),
        e: pyMkFlo(2.718281828459045),
        tau: pyMkFlo(6.283185307179586),
        inf: pyMkFlo(pyMInf()),
        nan: pyMkFlo(pyMNaN())
    }
}

// MetaJS has no exponent literal (1e308 parses as the identifier e308), so an
// infinity is BUILT. A NaN comes from an invalid operation.
function pyMInf() { return Math.pow(2, 1024) }
function pyMNaN() { return Math.pow(2, 1024) - Math.pow(2, 1024) }

function pyMIsMathMod(v) {
    if (!pyIsObj(v)) { return false }
    return v["__pymod"] === "math"
}

// Go: pyMathNorm. hypot / dist over the coordinates xs: an infinity wins
// over a NaN, as CPython's math_hypot decides before vector_norm.
function pyMNorm(xs) {
    var mx = 0
    var nan = false
    var abs = []
    var i = 0
    while (i < xs.length) {
        var a = Math.abs(xs[i])
        if (a !== a) { nan = true }
        if (a > mx) { mx = a }
        abs.push(a)
        i = i + 1
    }
    if (mx === pyMInf()) { return mx }
    if (nan) { return mx - pyMInf() + pyMInf() }
    return pynVecNorm(abs, mx)
}

// Go: pyMathLdexpExp. ldexp's exponent: an int (a bool is one), clamped to
// where every finite x has overflowed or underflowed.
function pyMLdexpExp(v) {
    if (typeof v == "boolean") { return v ? 1 : 0 }
    if (pyIsBig(v)) { return v["neg"] ? 0 - 2200 : 2200 }
    if (typeof v != "number") { pyRaiseExc("TypeError", "Expected an int as second argument to ldexp.") }
    if (v > 2200) { return 2200 }
    if (v < 0 - 2200) { return 0 - 2200 }
    return v
}

function pyMArg(args, i) {
    if (i >= args.length) { fail("math: missing argument") }
    return pyNum(args[i])
}

// Go: rt.pyMathKwArgs. math.NAME's arguments with its keyword arguments placed:
// only isclose takes any, rel_tol and abs_tol, which land third and fourth.
function pyMathKwArgs(name, args, kw) {
    if (!pyIsDict(kw)) { return args }
    var ks = kw["keys"]
    if (ks.length == 0 || !pyMHas("math", name)) { return args }
    if (name == "prod" && ks.length == 1 && pyToStr(ks[0]) == "start") { return [pyEArgAt(args, 0), kw["vals"][0]] }
    if (name != "isclose") { pyRaiseExc("TypeError", "math." + name + "() takes no keyword arguments") }
    var out = [pyEArgAt(args, 0), pyEArgAt(args, 1), pyMkFlo(0.000000001), 0]
    var i = 0
    while (i < ks.length) {
        var kn = pyToStr(ks[i])
        if (kn == "rel_tol") { out[2] = kw["vals"][i] }
        else if (kn == "abs_tol") { out[3] = kw["vals"][i] }
        else { pyRaiseExc("TypeError", "isclose() got an unexpected keyword argument '" + kn + "'") }
        i = i + 1
    }
    return out
}

// CPython 3.14's own domain-error texts, which quote the offending operand as a
// FLOAT repr ("expected a nonnegative input, got -1.0").
function pyMDom(kind, v) {
    var got = pyStr(pyMkFlo(v))
    if (kind == "nonneg") { pyRaiseExc("ValueError", "expected a nonnegative input, got " + got) }
    if (kind == "pos") { pyRaiseExc("ValueError", "expected a positive input, got " + got) }
    if (kind == "unit") { pyRaiseExc("ValueError", "expected a number in range from -1 up to 1, got " + got) }
    pyRaiseExc("ValueError", "expected argument value > -1, got " + got)
}

// floor / ceil / trunc must answer an INT, and there is no int for a non-finite
// operand, so CPython raises rather than answering an infinity.
function pyMInt(f) {
    // CPython splits the two: an INFINITY is an OverflowError (there is no such
    // int) and a NaN a ValueError, and the two texts differ as well.
    if (f !== f) { pyRaiseExc("ValueError", "cannot convert float NaN to integer") }
    if (f === pyMInf() || f === 0 - pyMInf()) {
        pyRaiseExc("OverflowError", "cannot convert float infinity to integer")
    }
    if (f == 0) { return 0 }
    return f
}

function pyMGcd2(a, b) {
    var x = Math.abs(Math.trunc(a))
    var y = Math.abs(Math.trunc(b))
    while (y !== 0) {
        var t = x - Math.floor(x / y) * y
        x = y
        y = t
    }
    return x
}

// Beyond 20! the product leaves the exact-double range, so it is finished on the
// arbitrary-precision integer this value model already carries - which is what
// makes math.factorial(30) CPython's exact answer rather than a rounded double.
function pyMFactorial(n) {
    if (n <= 20) {
        var r = 1
        var i = 2
        while (i <= n) { r = r * i; i = i + 1 }
        return r
    }
    var acc = rtABigFromNum(1)
    var k = 2
    while (k <= n) { acc = rtABigMul(acc, rtABigFromNum(k)); k = k + 1 }
    return rtABigNarrow(acc)
}

// CPython's math_1 overflow rule for exp, expm1, sinh and cosh: an infinite result
// from a finite argument is OverflowError("math range error"). `v - v != 0` holds
// for an infinity and a NaN alike, and `v == v` then excludes the NaN.
// Go: pyMathRange in abnf/jsrtpymath.go.
function pyMRange(r, x) {
    if (r - r != 0 && r == r && x - x == 0) { pyRaiseExc("OverflowError", "math range error") }
    return pyMkFlo(r)
}

// math.pow with CPython's errors for two finite operands: a NaN result
// ((-8) ** (1/3)) and 0 ** negative are ValueError("math domain error"), any other
// infinite result OverflowError("math range error"). Go: pyMathPow.
function pyMPow(x, y) {
    var r = Math.pow(x, y)
    if (x - x == 0 && y - y == 0 && r - r != 0) {
        if (r != r || x == 0) { pyRaiseExc("ValueError", "math domain error") }
        pyRaiseExc("OverflowError", "math range error")
    }
    return pyMkFlo(r)
}

function pyMathCall(name, args) {
    if (name == "sqrt") {
        var sq = pyMArg(args, 0)
        if (sq < 0) { pyMDom("nonneg", sq) }
        return pyMkFlo(Math.sqrt(sq))
    }
    if (name == "cbrt") { return pyMkFlo(Math.cbrt(pyMArg(args, 0))) }
    if (name == "exp") {
        var ex = pyMArg(args, 0)
        return pyMRange(Math.exp(ex), ex)
    }
    if (name == "expm1") {
        var em = pyMArg(args, 0)
        return pyMRange(Math.expm1(em), em)
    }
    if (name == "log") {
        var lg = pyMArg(args, 0)
        if (lg <= 0) { pyMDom("pos", lg) }
        if (args.length > 1) {
            // math.log(x, 1) divides by log(1) == 0: CPython raises
            // ZeroDivisionError, not a domain error.
            var lb = Math.log(pyMArg(args, 1))
            if (lb === 0) { pyRaiseExc("ZeroDivisionError", "division by zero") }
            return pyMkFlo(Math.log(lg) / lb)
        }
        return pyMkFlo(Math.log(lg))
    }
    if (name == "log1p") {
        var l1 = pyMArg(args, 0)
        if (l1 <= 0 - 1) { pyMDom("gt", l1) }
        return pyMkFlo(Math.log1p(l1))
    }
    if (name == "log2") {
        var l2 = pyMArg(args, 0)
        if (l2 <= 0) { pyMDom("pos", l2) }
        return pyMkFlo(Math.log2(l2))
    }
    if (name == "log10") {
        var l10 = pyMArg(args, 0)
        if (l10 <= 0) { pyMDom("pos", l10) }
        return pyMkFlo(Math.log10(l10))
    }
    if (name == "pow") { return pyMPow(pyMArg(args, 0), pyMArg(args, 1)) }
    if (name == "fabs") { return pyMkFlo(Math.abs(pyMArg(args, 0))) }
    if (name == "fmod") {
        var fa = pyMArg(args, 0)
        var fb = pyMArg(args, 1)
        return pyMkFlo(fa - Math.trunc(fa / fb) * fb)
    }
    if (name == "copysign") {
        var cm = Math.abs(pyMArg(args, 0))
        var cs = pyMArg(args, 1)
        // The sign BIT, not `cs < 0`: copysign(1, -0.0) is -1.0 in CPython. A
        // negative zero is recognised by 1/x being negative infinity, and the
        // negation divides by -1 rather than subtracting.
        if (cs < 0 || (cs === 0 && 1 / cs < 0)) { return pyMkFlo(cm / (0 - 1)) }
        return pyMkFlo(cm)
    }
    if (name == "atan2") { return pyMkFlo(fdlibm().atan2(pyMArg(args, 0), pyMArg(args, 1))) }
    if (name == "hypot") {
        var hv = []
        var hi = 0
        while (hi < args.length) {
            hv.push(pyNum(args[hi]))
            hi = hi + 1
        }
        return pyMkFlo(pyMNorm(hv))
    }
    if (name == "dist") {
        var dp = pyElemsOf(pyEArgAt(args, 0))
        var dq = pyElemsOf(pyEArgAt(args, 1))
        if (dp.length != dq.length) { pyRaiseExc("ValueError", "both points must have the same number of dimensions") }
        var dv = []
        var di = 0
        while (di < dp.length) {
            dv.push(pyNum(dp[di]) - pyNum(dq[di]))
            di = di + 1
        }
        return pyMkFlo(pyMNorm(dv))
    }
    if (name == "frexp") {
        var fr = pynFrexp(pyMArg(args, 0))
        return pyTup([pyMkFlo(fr.m), fr.e])
    }
    if (name == "ldexp") {
        var lr = pynLdexp(pyMArg(args, 0), pyMLdexpExp(pyEArgAt(args, 1)))
        if (lr === null) { pyRaiseExc("OverflowError", "math range error") }
        return pyMkFlo(lr)
    }
    if (name == "modf") {
        var mr = pynModf(pyMArg(args, 0))
        return pyTup([pyMkFlo(mr.f), pyMkFlo(mr.i)])
    }
    if (name == "ulp") { return pyMkFlo(pynUlp(pyMArg(args, 0))) }
    if (name == "nextafter") { return pyMkFlo(pynNextafter(pyMArg(args, 0), pyMArg(args, 1))) }
    if (name == "sin") { return pyMkFlo(fdlibm().sin(pyMArg(args, 0))) }
    if (name == "cos") { return pyMkFlo(fdlibm().cos(pyMArg(args, 0))) }
    if (name == "tan") { return pyMkFlo(fdlibm().tan(pyMArg(args, 0))) }
    if (name == "asin") {
        var as1 = pyMArg(args, 0)
        if (as1 < 0 - 1 || as1 > 1) { pyMDom("unit", as1) }
        return pyMkFlo(Math.asin(as1))
    }
    if (name == "acos") {
        var ac1 = pyMArg(args, 0)
        if (ac1 < 0 - 1 || ac1 > 1) { pyMDom("unit", ac1) }
        return pyMkFlo(Math.acos(ac1))
    }
    if (name == "atan") { return pyMkFlo(Math.atan(pyMArg(args, 0))) }
    if (name == "sinh") {
        var sh = pyMArg(args, 0)
        return pyMRange(Math.sinh(sh), sh)
    }
    if (name == "cosh") {
        var ch = pyMArg(args, 0)
        return pyMRange(Math.cosh(ch), ch)
    }
    if (name == "tanh") { return pyMkFlo(Math.tanh(pyMArg(args, 0))) }
    if (name == "degrees") { return pyMkFlo(pyMArg(args, 0) * (180 / 3.141592653589793)) }
    if (name == "radians") { return pyMkFlo(pyMArg(args, 0) * (3.141592653589793 / 180)) }
    if (name == "floor") { return pyMInt(Math.floor(pyMArg(args, 0))) }
    if (name == "ceil") { return pyMInt(Math.ceil(pyMArg(args, 0))) }
    if (name == "trunc") { return pyMInt(Math.trunc(pyMArg(args, 0))) }
    if (name == "gcd") {
        if (args.length == 0) { return 0 }
