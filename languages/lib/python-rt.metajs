// pairs consecutive items, and strict= is CPython's ValueError for sources of
// different lengths.
function js_pyzip(args) {
    var pos = args[0]
    var kw = args[1]
    pyKwOnly(kw, "zip", "strict", "strict")
    var strict = pyDTruthy(pyKwArg(kw, "strict"))
    var ss = []
    var i = 0
    while (i < pos.length) {
        ss.push(pyAStepper(pos[i]))
        i = i + 1
