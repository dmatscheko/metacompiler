// ----- js_pysetslice (jsrt.go:7443) -----------------------------------------
// xs[lo:hi:step] = values. A step of 1 SPLICES (the replacement may have a
// different length, so xs[1:3] = [9] shortens the list); an extended step
// assigns element by element and needs exactly as many values as it selects.
function js_pysetslice(arr, lo, hi, step, values) {
    if (!pyIsArr(arr)) {
        fail("slice assignment to a " + typeof arr)
        return undefined
    }
    var vals = pySeqElems(values)
    if (pyIsNone(step) || pyNum(step) == 1) {
        var idx = pySliceIndices(arr.length, lo, hi, step)
        var from = arr.length
        var to = from
        if (idx.length > 0) {
            from = idx[0]
            to = idx[idx.length - 1] + 1
        } else {
            from = pyCSliceStart(arr.length, lo)
            to = from
        }
        var out = []
        var i = 0
        while (i < from) {
            out.push(arr[i])
            i = i + 1
        }
        var v = 0
        while (v < vals.length) {
            out.push(vals[v])
            v = v + 1
