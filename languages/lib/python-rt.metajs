    while (s < vals.length) {
        var kx = anytype
        kx = keys[s]
        var vx = anytype
        vx = vals[s]
        var p = s - 1
        while (p >= 0 && pyAOrder("<", kx, keys[p])) {
            keys[p + 1] = keys[p]
            vals[p + 1] = vals[p]
            p = p - 1
        }
        keys[p + 1] = kx
        vals[p + 1] = vx
        s = s + 1
