// python-rt.metajs -- PYTHON'S OWN SEMANTICS, in MetaJS: python's layer-2 runtime.
//
// languages/python-to-llvm-ir.abnf emits handle IR that calls js_* externs. The
// generic primitives come from languages/lib/runtime.c (the C floor, layer 1); the
// Python-specific ones are here.
//
// Compile with:
//     mec languages/metajs-to-llvm-ir.abnf languages/lib/python-rt.metajs -q -rt-lib
// which is what tests/gen-python-rt-ll.sh does; the result is the checked-in
// languages/lib/python-rt.ll that python-to-llvm-ir.abnf links next to runtime.ll.
// -rt-lib exports every TOP-LEVEL `function js_*` below under its own C symbol, so
// nothing else in this file is visible to the linker - the helpers are deliberately
// named py*, pyA*..pyF*.
//
// THE AUTHORITATIVE SPECIFICATION IS abnf/jsrt.go (Python has NO dedicated Go twin:
// its semantics live in the shared file, in the js_py* extern table and the py*
// helper functions - pyString / pyRepr / pyTypeName / pyEqual / pyMRO / pyLookup /
// pyGetAttr / pySetAttr / pyMethodCall / pyBindCall / pyArith / pyFormat / memberCall)
// plus abnf/jsrtregexpy.go for the `re` module. This file matches them function for
// function; where it CANNOT, the site says so.
//
// ----- the value model -------------------------------------------------------
//
//     null / undefined            ==  None
//     true / false                ==  True / False
//     a PLAIN NUMBER              ==  int. There is no box for an int: pyTypeName
//                                     answers "int" for every plain number.
//     {__flo: f}                  ==  float (a boxed double, see pyIsFlo)
//     {__pybig, neg, limbs}       ==  an arbitrary precision int (js_bigint). Go uses
//                                     math/big; here it is base-10000 limbs.
//     a string                    ==  str
//     an array                    ==  list AND tuple (Python's tuple has no separate
//                                     representation in either half)
//     {__dict, keys, vals}        ==  dict, INSERTION ordered, parallel arrays
//     {__set, elems}              ==  set, duplicate free by pyEqual
//     {__cplx, real, imag}        ==  complex
//     {__mro, __name, __super}    ==  a class object; __mro is the C3 linearization
//     {__class: <class>}          ==  an instance
//     a function                  ==  a function (typeof "function"; tag 16, a
//                                     generator FUNCTION, answers that too)
//     a tag-15 cell               ==  a generator. There is NO tag test in layer 2,
//                                     so pyIsGen below is STRUCTURAL - the floor
//                                     answers exactly one member on a generator,
//                                     "next", and a cursor cannot be stored on one.
//
// ----- what Python needs from the floor --------------------------------------
//
//  1. NO sized-integer tag. Python's int is a plain double, so tag 13 is never
//     reached from this file. Python's ARBITRARY PRECISION int is a base-10000
//     bignum in MetaJS rather than a floor tag: Go reaches math/big through
//     *jsBigInt and the floor has no equivalent.
//  2. `__raw` IS needed. python-to-llvm-ir.abnf sets
//     `core.truthyExt = "js_pytruthy"`, so compile-core's truthy() emits
//     `icmp ne <call>, 0` on THIS FILE's function and consumes the result as a RAW
//     INTEGER. js_pytruthy is therefore written as js_pytruthy__raw.
//  3. The emitter drives the floor's coroutine primitives (js_genfn/js_yield)
//     itself; the generator INSPECTION surface (next / send / close / drain / len)
//     is Python's own and is here.
//  4. NO jsChar. Python has no character type and the emitter emits js_char /
//     js_char_code / js_kindex zero times.
//
// ----- the scope chain: lowered in the EMITTER, not here ---------------------
//
// The externs that take a scope handle (js_pyfnscope, js_pyglobal, js_pynonlocal,
// js_pyset_var, js_pydel_var, js_pyannot, js_pyclass_fill) cannot be written here:
// a scope is the C floor's PRIVATE storage. They are lowered in
// python-to-llvm-ir.abnf instead, over js_scope_new / js_scope_decl / js_scope_get /
// js_scope_set / js_scope_typeof, which BOTH engines have.
//
// ----- the regular-expression engine is IMPORTED, not copied ------------------
//
// languages/lib/regex.js is the shared backtracking engine that every INTERPRETER
// grammar includes into its tag script, and abnf/jsrtregex.go is its line-by-line Go
// port. It is written in the same MetaJS this file is, so layer 2 needs no third
// copy.
//
// ----- MetaJS rules that shape the code below --------------------------------
//
// docs/abnf-dialect-gotchas.md: a local (or a reassigned parameter) keeps the TYPE
// CLASS it is first assigned, so a variable that holds a number in one branch and an
// object in another is declared `var x = anytype`; there is no ASI, so every
// `return` carries its value on the same line and a value-less early return is
// BRACED; no for..in, no splice, no split/join/lastIndexOf, indexOf ignores its
// from-index, array.length is not assignable, and there are no exponent literals.
// There is no hasOwn in a -rt-lib module, so Go's `v, ok := o.props[n]` is spelled
// `o[n] !== undefined` throughout; at RUNTIME an object is a floor cell with no
// prototype, so the Object.prototype hazard of the compiler's own goja objects does
// not arise here.

import "./regex.js"

// The shared layer-2 runtime: the externs every language implements identically,
// parameterised by the rtk* hooks below.
import "./runtime.metajs"

// ----- the rtk* hooks the shared runtime calls -------------------------------
function rtkStr(v) { return pyAJavaStr(v) }
function rtkNum(v) { return pyNum(v) }
function rtkIsChar(v) { return false }
function rtkIsArr(v) { return pyIsArr(v) }

// ===================================================== the value model ======

// DELIBERATELY NOT SHARED. This predicate is asked at ~30 sites, several of
// them inside the arithmetic and attribute paths every Python statement walks,
// and delegating it to a shared body costs a MetaJS call - a scope frame - per
// ask, which is measurably slower on a predicate this hot.
//
// It is NOT rtIsObj either: that one deliberately leaves the array rejection out,
// because its own callers walk __class/__super and an array carries neither.
function pyIsObj(v) {
    if (v === null) { return false }
    if (v === undefined) { return false }
    if (typeof v != "object") { return false }
    return !Array.isArray(v)
}

function pyIsArr(v) { return Array.isArray(v) }
function pyIsStr(v) { return typeof v == "string" }
function pyIsNum(v) { return typeof v == "number" }
function pyIsBool(v) { return typeof v == "boolean" }
function pyIsFn(v) { return typeof v == "function" }
function pyIsCallable(v) { return typeof v == "function" }

// pyIsNone is SHARED as rtIsNil - lib/runtime.metajs.

// pyTag is SHARED as rtTag - lib/runtime.metajs - which inlines the tests pyIsObj
// makes rather than calling it, to keep a frame off the hottest predicate here.
function pyIsDict(v) { return rtTag(v, "__dict") }
function pyIsCplx(v) { return rtTag(v, "__cplx") }
function pyIsBig(v) { return rtTag(v, "__pybig") }

// Python's float: a boxed double (abnf/jsrt.go's jsPyFlo, python-interpreter.abnf's
// pyFlo). int and float are two DIFFERENT Python types - they print differently
// (1 vs 1.0), answer different type()s, and `/` makes a float even out of two
// ints - and one double cannot carry that, because 2.0 and 2 ARE the same double.
// So the float is the boxed one and the int stays the plain number, which leaves
// the common integer path untouched. The field is not `=== true` like the tags
// above, so rtTag cannot answer it.
function pyIsFlo(v) {
    if (!pyIsObj(v)) { return false }
    return v["__flo"] !== undefined
}
function pyMkFlo(f) { return {__flo: f} }

// "this value has a double in it": a float box, a plain int, a bool (True is 1)
// or an arbitrary precision integer. Go: pyIsNumeric.
function pyIsNumeric(v) {
    if (typeof v == "number") { return true }
    if (typeof v == "boolean") { return true }
    if (pyIsFlo(v)) { return true }
    return pyIsBig(v)
}

// The result type of // and %: an int from two ints (7 // 2 is 3) and a float as
// soon as either operand is one (7.5 // 2 is 3.0). Go: pyIntOrFlo.
function pyIntOrFlo(f, l, r) {
    if (pyIsFlo(l) || pyIsFlo(r)) { return pyMkFlo(f) }
    return f
}

// A class object carries its C3 linearization; an instance carries its class.
function pyIsClass(v) {
    if (!pyIsObj(v)) { return false }
    return v["__mro"] !== undefined
}

// A GENERATOR is a floor cell (tag 15). Layer 2 has no tag test, so the question is
// answered structurally: the floor answers exactly ONE member on a generator, "next".
//
// THE __pyit LINE IS LOAD-BEARING: a CURSOR (pyMkIter) is a plain object built to
// look exactly like a generator, callable "next" and all, so without it a
// list_iterator would answer TRUE here. The Go twin asks `target.(*jsGenerator)`, a
// real type test, and the interpreter half asks for a __gen tag. Callers that want
// cursors too ask pyIsIter themselves (pySeqElems, js_pysum, pyDMethodCall).
function pyIsGen(v) {
    if (v === null) { return false }
    if (v === undefined) { return false }
    if (typeof v != "object") { return false }
    if (Array.isArray(v)) { return false }
    if (v["__dict"] === true) { return false }
    if (v["__set"] === true) { return false }
    if (v["__cplx"] === true) { return false }
    if (v["__pybig"] === true) { return false }
    if (v["__pyit"] !== undefined) { return false }
    if (v["__mro"] !== undefined) { return false }
    if (v["__class"] !== undefined) { return false }
    // A MODULE object is not a generator: the `builtins` module holds every
    // builtin under its own name, one of which is `next`, so the structural test
    // would answer TRUE for it (type(builtins) would read "generator" and
    // `builtins.next(it)` would step the MODULE). The Go twin tests a real type.
    if (v["__pymod"] !== undefined) { return false }
    return typeof v["next"] == "function"
}

function pyFail(msg) { fail(msg) }

// ===================================================== dict =================
//
// abnf/jsrt.go's dictParts / dictFind / dictAppend (the Go twin's dictFind is an
// index over the same array; the scan is the same answer). A dict KEY is compared
// with STRICT equality plus the rules in pyKeyEq, and the bool/int alias is
// pyKeyAlias below.
//
// The one CPython rule that needs writing down: `bool` subclasses `int`, so
//
//     d = {}; d[True] = "t"; d[1] = "one"
//
// is ONE entry in CPython 3.14, `d[True]` is "one", and `list(d)` is `[True]` -
// the FIRST key object stays and only the VALUE is overwritten. That is why the
// alias is tried at LOOKUP and the key is never normalized on the way in:
// normalizing would store 1 and print `1` where CPython prints `True`.

function pyNewDict() { return js_dict_new() }

// The other spelling of a key Python considers equal to this one. Only the
// bool/int pair can differ: an int and a float are already the same plain double
// here. -0.0 == 0 is true in this comparison, so a negative zero lands in the
// False arm exactly as CPython puts it there.
function pyKeyAlias(k) {
    if (k === true) { return 1 }
    if (k === false) { return 0 }
    if (pyIsFlo(k)) { return k["__flo"] }
    if (typeof k == "number") {
        if (k == 1) { return true }
        if (k == 0) { return false }
    }
    return undefined
}

// The scan's === plus the float rule: a float box keys with the int of the same
// value ({1.0: "a"}[1] is a hit), and two boxes holding the same double are one
// key though they are two objects. Go: rt.dictKeyEq.
function pyKeyEq(a, b) {
    // === FIRST, because pyDictFind has no index and calls this once per stored
    // key: an identical key is the whole answer under every rule below, so the hit
    // path costs one comparison and no call at all.
    if (a === b) { return true }
    if (pyIsFlo(a) || pyIsFlo(b)) {
        if (!pyIsNumeric(a) || !pyIsNumeric(b)) { return false }
        return pyNum(a) == pyNum(b)
    }
    // A TUPLE key. CPython hashes a tuple by its CONTENTS, so `{(1,2): "x"}[(1,2)]`
    // is a hit off two different objects - and a tuple IS an array in this value
    // model, so arrays compare by Python ==, the same rule the set side uses
    // (pySetHas -> pyEqual). The typeof gate keeps the Array.isArray CALL off the
    // string and number keys that are almost every key.
    if (typeof a == "object") {
        if (Array.isArray(a) && Array.isArray(b)) { return pyEqual(a, b) }
    }
    return false
}

// ----- Hashability -----------------------------------------------------------
// The twin of pyHashName / pyHashCheck in languages/python-interpreter.abnf and of
// pyUnhashName / pyHashCheck in abnf/jsrt.go. CPython:
//
//   {[1]}      TypeError: cannot use 'list' as a set element (unhashable type: 'list')
//   {{}: 1}    TypeError: cannot use 'dict' as a dict key (unhashable type: 'dict')
//
// The wording differs between the two positions. dict and set are refused; the
// ARRAY is not, because a tuple is an array here and refusing it would abort
// `{(1,2)}` and `d[i, j]`, which CPython accepts - see the note at
// python-interpreter.abnf's pyHashCheck. bytearray and frozenset are not in this
// subset at all.
function pyHashName(v) {
    if (!pyIsObj(v)) { return "" }
    if (v["__set"] === true) { return "set" }
    if (v["__dict"] === true) { return "dict" }
    return ""
}

// elem: true for a set MEMBER, false for a dict KEY.
function pyHashCheck(v, elem) {
    var n = pyHashName(v)
    if (n == "") { return undefined }
    var where = "a dict key"
    if (elem) { where = "a set element" }
    pyRaiseExc("TypeError", "cannot use '" + n + "' as " + where
                            + " (unhashable type: '" + n + "')")
    return undefined
}

// The set LOOKUP form. CPython's set.__contains__ / .discard / .remove convert a
// set argument to a frozenset instead of refusing it, so `{1} in {1}` is False
// where `{} in {1}` raises. Only that one pair is exempt; a set used as a DICT
// key still raises.
function pyHashCheckMember(k) {
    if (pyIsObj(k)) {
        if (k["__set"] === true) { return undefined }
    }
    pyHashCheck(k, true)
    return undefined
}

// The alias is tried TWICE: a float box's alias is the plain number and the
// plain number's is the bool, so {True: "t"}[1.0] takes two steps.
function pyDictFind(keys, k) {
    // Every dict lookup, insertion, membership test and removal in this half goes
    // through here, so the unhashable-key refusal needs no other dict site. The
    // typeof guard is inline rather than a pyIsObj call: this is the hottest
    // function in the file and almost every key is a string or a number.
    if (k !== null && k !== undefined) {
        if (typeof k == "object") { pyHashCheck(k, false) }
    }
    for (var i = 0; i < keys.length; i++) {
        if (pyKeyEq(keys[i], k)) { return i }
    }
    var alias = pyKeyAlias(k)
    if (alias === undefined) { return 0 - 1 }
    for (var j = 0; j < keys.length; j++) {
        if (pyKeyEq(keys[j], alias)) { return j }
    }
    var alias2 = pyKeyAlias(alias)
    if (alias2 === undefined) { return 0 - 1 }
    for (var q = 0; q < keys.length; q++) {
        if (pyKeyEq(keys[q], alias2)) { return q }
    }
    return 0 - 1
}

function pyDictSet(d, k, v) {
    var keys = d["keys"]
    var i = pyDictFind(keys, k)
    if (i >= 0) {
        d["vals"][i] = v
        return d
    }
    keys.push(k)
    d["vals"].push(v)
    return d
}

// ===================================================== set ==================
//
// abnf/jsrt.go's newPySet / pySetElems / pySetHas / pySetAdd. MEMBERSHIP is Python
// ==, which the dict keys above reach the other way round (=== plus pyKeyAlias);
// the two answer the same question for every value this model builds.

function pyNewSet(elems) { return {__set: true, elems: elems} }

function pySetElemsOf(v) {
    if (!rtTag(v, "__set")) { return null }
    var e = v["elems"]
    if (!Array.isArray(e)) { return null }
    return e
}

function pySetHas(els, v) {
    for (var i = 0; i < els.length; i++) {
        if (pyEqual(els[i], v)) { return true }
    }
    return false
}

function pySetAdd(els, v) {
    // The INSERT form: no frozenset conversion, so `s.add({1})` raises where
    // `{1} in s` does not.
    pyHashCheck(v, true)
    if (!pySetHas(els, v)) { els.push(v) }
    return els
}

// ===================================================== complex ==============
//
// abnf/jsrt.go's newPyComplex / pyComplexParts: a plain number reads as (n, 0), so
// mixed arithmetic needs no second code path.

function pyNewCplx(re, im) { return {__cplx: true, real: re, imag: im} }

function pyCplxRe(v) {
    if (pyIsCplx(v)) { return pyNum(v["real"]) }
    if (pyIsBig(v)) { return pyBigToF(v) }
    return pyNum(v)
}

function pyCplxIm(v) {
    if (pyIsCplx(v)) { return pyNum(v["imag"]) }
    return 0
}

// One part of repr(complex): repr(float) without its forced ".0".
function pyCplxPart(f) {
    var t = pyBFloStr(f)
    if (t.length > 2 && t.substring(t.length - 2) == ".0") { return t.substring(0, t.length - 2) }
    return t
}

// repr(complex), which is also str(): the real part is left out when it is
// +0.0, otherwise the pair is parenthesized. Go: pyCplxRepr.
function pyCplxRepr(re, im) {
    var ims = pyCplxPart(im)
    if (re == 0 && 1 / re > 0) { return ims + "j" }
    if (ims.charAt(0) != "-") { ims = "+" + ims }
    return "(" + pyCplxPart(re) + ims + "j)"
}

// complex(real=0, imag=0): each argument a real number or a complex, the result
// real.real - imag.imag + (real.imag + imag.real)j as CPython builds it; a lone
// string is parsed. Go: rt.pyComplexNew.
function js_pycomplexnew(args) {
    var r = anytype
    r = 0
    var i = anytype
    i = 0
    if (args.length > 0) { r = args[0] }
    if (args.length > 1) { i = args[1] }
    if (typeof r == "string" && args.length < 2) { return pyCplxFromStr(r) }
    var what = "complex() argument must be a string or a number, not "
    if (args.length > 1) { what = "complex() argument 'real' must be a real number, not " }
    pyCplxArgCheck(r, what)
    pyCplxArgCheck(i, "complex() argument 'imag' must be a real number, not ")
    var re = pyCplxRe(r)
    var im = pyCplxIm(r)
    if (args.length > 1) {
        im = pyCplxRe(i)
        if (pyIsCplx(r)) { im = im + pyCplxIm(r) }
        if (pyIsCplx(i)) { re = re - pyCplxIm(i) }
    }
    return pyNewCplx(re, im)
}

function pyCplxArgCheck(v, what) {
    if (pyIsCplx(v) || pyIsBig(v) || pyIsFlo(v)) { return undefined }
    if (typeof v == "number" || typeof v == "boolean") { return undefined }
    pyRaiseExc("TypeError", what + pyTypeName(v))
    return undefined
}

// complex("1+2j"), CPython's complex_from_string: surrounding spaces and one
// pair of parentheses, then a real, an imaginary (2j), or a real and a signed
// imaginary (1-2j); an imaginary with no digits (j, -j, 1+j) is 1.
// Go: rt.pyCplxFromStr.
function pyCplxFromStr(s0) {
    var s = s0.trim()
    if (s.length > 1 && s.charAt(0) == "(" && s.charAt(s.length - 1) == ")") { s = s.substring(1, s.length - 1).trim() }
    var e1 = pyFloPrefix(s, 0)
    var a = 0
    if (e1 > 0) {
        a = pyStrToF(pyNoUnderscores(s.substring(0, e1)))
        if (e1 == s.length) { return pyNewCplx(a, 0) }
        if (pyIsJAt(s, e1) && e1 + 1 == s.length) { return pyNewCplx(0, a) }
    }
    var sg = s.charAt(e1)
    if (sg == "+" || sg == "-" || e1 == 0) {
        var e2 = pyFloPrefix(s, e1)
        var b = 0
        if (e2 > e1) { b = pyStrToF(pyNoUnderscores(s.substring(e1, e2))) }
        else {
            b = 1
            if (sg == "-") { b = 0 - 1 }
            if (sg == "+" || sg == "-") { e2 = e1 + 1 }
        }
        if (pyIsJAt(s, e2) && e2 + 1 == s.length) { return pyNewCplx(a, b) }
    }
    pyRaiseExc("ValueError", "complex() arg is a malformed string")
    return undefined
}

function pyIsJAt(s, k) { return s.charAt(k) == "j" || s.charAt(k) == "J" }

function pyNoUnderscores(t) {
    var o = ""
    var k = 0
    while (k < t.length) {
        if (t.charAt(k) != "_") { o = o + t.charAt(k) }
        k = k + 1
    }
    return o
}

function pyIsDigitU(ch) { return (ch >= "0" && ch <= "9") || ch == "_" }

// The end of the float literal at i (a sign, digits with an optional point, an
// exponent; or inf / infinity / nan), or i when there is none. Go: pyFloPrefix.
function pyFloPrefix(s, i) {
    var j = i
    if (s.charAt(j) == "+" || s.charAt(j) == "-") { j = j + 1 }
    var low = s.substring(j, j + 8).toLowerCase()
    if (low == "infinity") { return j + 8 }
    if (low.substring(0, 3) == "inf" || low.substring(0, 3) == "nan") { return j + 3 }
    var d = 0
    while (j < s.length && pyIsDigitU(s.charAt(j))) { j = j + 1; d = d + 1 }
    if (s.charAt(j) == ".") {
        j = j + 1
        while (j < s.length && pyIsDigitU(s.charAt(j))) { j = j + 1; d = d + 1 }
    }
    if (d == 0) { return i }
    if (s.charAt(j) == "e" || s.charAt(j) == "E") {
        var k = j + 1
        if (s.charAt(k) == "+" || s.charAt(k) == "-") { k = k + 1 }
        var ed = 0
        while (k < s.length && pyIsDigitU(s.charAt(k))) { k = k + 1; ed = ed + 1 }
        if (ed > 0) { j = k }
    }
    return j
}

// ===================================================== conversions ==========

// rt.toNumber. `v * 1` IS ToNumber: the floor's js_mul coerces both operands the
// same way abnf/jsrt.go's toNumber does, so undefined answers NaN, null 0, a bool
// 1/0, a string its parse and EVERY object (a __pybig and a __cplx included) NaN -
// which is what Go's `default:` arm gives, and what `**`, `//` and `%` on a big or a
// complex depend on.
function pyNum(v) {
    if (pyIsFlo(v)) { return v["__flo"] } // rt.toNumber's jsPyFlo arm.
    return v * 1
}

// rt.toString. The one arm `"" + v` does not give is the bignum, whose Go twin
// answers big.Int.String(); rtABigStr is that, and top-level function
// declarations hoist, so it is reachable from here.
function pyToStr(v) {
    if (pyIsBig(v)) { return rtABigStr(v) }
    return "" + v
}

// pyStrLen counts CODE POINTS (as abnf/jsrt.go does), where the string indexing of
// js_pyget counts UTF-16 code units. That inconsistency is the Go twin's and is
// reproduced rather than repaired.
function pyStrLen(s) {
    var n = 0
    var i = 0
    while (i < s.length) {
        var c = s.charCodeAt(i)
        if (c >= 55296 && c <= 56319 && i + 1 < s.length) { i = i + 1 }
        i = i + 1
        n = n + 1
    }
    return n
}

function pyStrAt(s, i) {
    var n = 0
    var k = 0
    while (k < s.length) {
        var c = s.charCodeAt(k)
        var w = 1
        if (c >= 55296 && c <= 56319 && k + 1 < s.length) { w = 2 }
        if (n == i) { return s.substring(k, k + w) }
        k = k + w
        n = n + 1
    }
    return ""
}

// ===================================================== rendering ============
//
// abnf/jsrt.go's pyString and pyRepr, one for one.

function pyStr(v) {
    if (v === null) { return "None" }
    if (v === undefined) { return "None" }
    if (typeof v == "boolean") {
        if (v) { return "True" }
        return "False"
    }
    if (pyIsFlo(v)) { return pyBFloStr(v["__flo"]) }
    if (pyIsCplx(v)) { return pyCplxRepr(pyCplxRe(v), pyCplxIm(v)) }
    // A TYPE object renders as CPython's <class 'name'>, so print(type(1.0))
    // reads <class 'float'>. rt.pyClassName in the Go twin.
    var cn = pyClassName(v)
    if (cn !== null) {
        var cmod = v["__module__"]
        if (typeof cmod == "string") { return "<class '" + cmod + "." + cn + "'>" }
        return "<class '" + cn + "'>"
    }
    if (Array.isArray(v)) {
        var out = "["
        for (var i = 0; i < v.length; i++) {
            if (i > 0) { out = out + ", " }
            out = out + pyRepr(v[i])
        }
        return out + "]"
    }
    if (pyIsObj(v)) {
        var els = pySetElemsOf(v)
        if (els != null) {
            var so = "{"
            for (var j = 0; j < els.length; j++) {
                if (j > 0) { so = so + ", " }
                so = so + pyRepr(els[j])
            }
            return so + "}"
        }
        if (pyIsDict(v)) {
            var ks = v["keys"]
            var vs = v["vals"]
            var d = "{"
            for (var k = 0; k < ks.length; k++) {
                if (k > 0) { d = d + ", " }
                d = d + pyRepr(ks[k]) + ": " + pyRepr(vs[k])
            }
            return d + "}"
        }
    }
    var ic = pyInstClassOf(v)
    if (ic !== null && ic !== undefined) { return pyUserRender(v, ic, false) }
    // An iterator object. CPython prints <map object at 0x...>; the address is
    // its own and cannot be matched, so it is left off rather than invented, and
    // all three engines print this same short form.
    if (pyIsIter(v)) { return "<" + pyToStr(v["__pyit"]) + " object>" }
    // A MODULE object. CPython prints <module 'builtins' (built-in)> for a
    // built-in module and, for an extension module like math, the .so PATH it was
    // loaded from - machine-specific and unmatchable, so every module here takes
    // the built-in spelling. Without this a module printed [object Object].
    if (pyIsObj(v)) {
        if (v["__pymod"] !== undefined) { return "<module '" + pyToStr(v["__pymod"]) + "' (built-in)>" }
    }
    // A GENERATOR, on the same rule. CPython says <generator object gen at
    // 0x...>; neither the address nor the generating function's name is
    // recoverable from the value, so the short form is printed.
    if (pyIsGen(v)) { return "<generator object>" }
    // A compiled PATTERN and a MATCH render the way CPython's repr does.
    // js_pyrxstr answers them for str()/print(); this covers repr() and every
    // CONTAINER element.
    var rxr = pyERxRepr(v)
    if (rxr["ok"]) { return rxr["s"] }
    // A FUNCTION, on the same rule as the iterator line above: CPython prints
    // <function fn at 0x...> and the address cannot be matched, so it is left off
    // rather than invented. The name comes from the js_pyfnname side table;
    // CPython calls an unnamed one <lambda>, and so does every engine here.
    if (typeof v == "function") { return pyFuncRender(v) }
    return pyToStr(v)
}

function pyFuncRender(v) {
    // A BOUND METHOD prints as one.
    var bmi = pyBMFind(v)
    if (bmi >= 0) { return pyBMRender(bmi) }
    // A BUILTIN prints its own way, and its table is asked FIRST: a user
    // `def len(...)` records its own name against its own closure object, so the
    // two tables cannot collide by identity even when they collide by name.
    var bc = rtPairGet(pyBBFnObjs, pyBBFnCodes, v)
    if (bc !== undefined) { return pyBBFnRender(pyToStr(bc)) }
    var n = rtPairGet(pyBFnObjs, pyBFnNames, v)
    if (n === undefined) { return "<function <lambda>>" }
    return "<function " + pyToStr(n) + ">"
}

// ----- repr() of a str: CPython's unicode_repr -------------------------------
//
// The quote is ' unless the string holds a ' and no " (then it is "), so
// repr("it's") reads "it's" while repr("both ' and \"") reads 'both \' and "'.
// Inside, the quote in force and a backslash DOUBLE UP, \t \n \r have their
// short forms, and every other NON-PRINTABLE code point becomes \xNN (below
// U+0100), \uNNNN (below U+10000) or \UNNNNNNNN. Everything printable - "café"
// and an emoji included - is emitted literally.
//
// "Printable" is Unicode's: NOT in the categories Cc Cf Cs Co Cn Zl Zp Zs, with
// U+0020 itself excepted. The Cn (UNASSIGNED) half of that needs the Unicode
// database, which nothing in this project carries, so pyReprEsc knows the
// CLOSED sets instead - C0/C1, the two Latin-1 strays U+00A0 and U+00AD, the
// separators, the format characters, the surrogates and the private-use planes -
// and leaves an unassigned code point literal. Every ASSIGNED character is
// exact, and the whole of Latin-1 (the only range \xNN can ever come from) is
// exact by construction.
//
// The same three functions are pyStrRepr / pyReprEsc / pyHexPad in
// languages/python-interpreter.abnf and pyStrRepr / pyReprEsc in abnf/jsrt.go.
function pyHexPad(v, n) {
    var digits = "0123456789abcdef"
    var out = ""
    var t = v
    var i = 0
    while (i < n) {
        var q = Math.floor(t / 16)
        out = digits.charAt(t - q * 16) + out
        t = q
        i = i + 1
    }
    return out
}

function pyReprEsc(cp) {
    if (cp < 32) { return true }
    if (cp == 127) { return true }
    if (cp >= 128 && cp <= 160) { return true }         // C1 plus U+00A0 NBSP
    if (cp == 173) { return true }                      // U+00AD SOFT HYPHEN
    if (cp < 256) { return false }
    if (cp >= 1536 && cp <= 1541) { return true }       // U+0600..U+0605
    if (cp == 1564 || cp == 1757 || cp == 1807) { return true }
    if (cp == 2192 || cp == 2193 || cp == 2274) { return true }
    if (cp == 5760 || cp == 6158) { return true }       // U+1680, U+180E
    if (cp >= 8192 && cp <= 8207) { return true }       // U+2000..U+200F
    if (cp >= 8232 && cp <= 8239) { return true }       // U+2028..U+202F
    if (cp >= 8287 && cp <= 8303) { return true }       // U+205F..U+206F
    if (cp == 12288) { return true }                    // U+3000
    if (cp >= 55296 && cp <= 57343) { return true }     // surrogates (Cs)
    if (cp >= 57344 && cp <= 63743) { return true }     // U+E000..U+F8FF (Co)
    if (cp == 65279) { return true }                    // U+FEFF
    if (cp >= 65529 && cp <= 65531) { return true }     // U+FFF9..U+FFFB
    if (cp == 69821 || cp == 69837) { return true }     // U+110BD, U+110CD
    if (cp >= 78896 && cp <= 78911) { return true }     // U+13430..U+1343F
    if (cp >= 113824 && cp <= 113827) { return true }   // U+1BCA0..U+1BCA3
    if (cp >= 119155 && cp <= 119162) { return true }   // U+1D173..U+1D17A
    if (cp == 917505) { return true }                   // U+E0001
    if (cp >= 917536 && cp <= 917631) { return true }   // U+E0020..U+E007F
    if (cp >= 983040 && cp <= 1048573) { return true }  // U+F0000..U+FFFFD
    if (cp >= 1048576 && cp <= 1114109) { return true } // U+100000..U+10FFFD
    return false
}

function pyStrRepr(s) {
    var quote = "'"
    var hasSq = false
    var hasDq = false
    var i = 0
    while (i < s.length) {
        var c0 = s.charAt(i)
        if (c0 == "'") { hasSq = true }
        if (c0 == "\"") { hasDq = true }
        i = i + 1
    }
    if (hasSq && !hasDq) { quote = "\"" }
    var out = quote
    var k = 0
    while (k < s.length) {
        var ch = s.charAt(k)
        var cc = s.charCodeAt(k)
        var cp = cc
        var w = 1
        // An astral character arrives as a UTF-16 surrogate PAIR and is ONE code
        // point to CPython, so it is decoded before the printability test -
        // otherwise every emoji would escape as two lone surrogates.
        if (cc >= 55296 && cc <= 56319 && k + 1 < s.length) {
            var lo = s.charCodeAt(k + 1)
            if (lo >= 56320 && lo <= 57343) {
                cp = 65536 + (cc - 55296) * 1024 + (lo - 56320)
                ch = s.substring(k, k + 2)
                w = 2
            }
        }
        if (ch == quote || cp == 92) { out = out + "\\" + ch }
        else if (cp == 9) { out = out + "\\t" }
        else if (cp == 10) { out = out + "\\n" }
        else if (cp == 13) { out = out + "\\r" }
        else if (!pyReprEsc(cp)) { out = out + ch }
        else if (cp < 256) { out = out + "\\x" + pyHexPad(cp, 2) }
        else if (cp < 65536) { out = out + "\\u" + pyHexPad(cp, 4) }
        else { out = out + "\\U" + pyHexPad(cp, 8) }
        k = k + w
    }
    return out + quote
}

function pyRepr(v) {
    if (typeof v == "string") { return pyStrRepr(v) }
    var rc = pyInstClassOf(v)
    if (rc !== null && rc !== undefined) { return pyUserRender(v, rc, true) }
    return pyStr(v)
}

// pyUserRender renders a USER INSTANCE. It is pyUserRender in
// languages/python-interpreter.abnf and rt.pyUserRender in abnf/jsrt.go, one for
// one: str() and print() prefer __str__ and fall back to __repr__, repr() and
// every CONTAINER element use __repr__ only, an exception falls back to
// Name(args...), and the <Name object> default omits CPython's `at 0x...`
// address, which no engine here can reproduce.
function pyUserRender(v, cls, wantRepr) {
    if (!wantRepr) {
        if (pyLookupHas(cls, "__str__")) {
            var g = pyLookupVal(cls, "__str__")
            if (pyIsCallable(g)) { return pyToStr(pyCallSelf(g, v, [])) }
        }
        // BaseException.__str__, which an exception INHERITS and which therefore
        // beats a __repr__ the class also defines: no args is "", one arg is
        // str(that arg), more is the args TUPLE's repr.
        var ea = v["args"]
        if (Array.isArray(ea)) {
            if (ea.length == 0) { return "" }
            // KeyError OVERRIDES BaseException.__str__ with repr(args[0]), which
            // is why str(KeyError('x')) is "'x'" and not "x". The argument is the
            // key itself and the repr happens here, so repr() is not doubly quoted.
            if (ea.length == 1 && pyIsKeyErrCls(cls)) { return pyRepr(ea[0]) }
            if (ea.length == 1) { return pyStr(ea[0]) }
            var oe = "("
            for (var q = 0; q < ea.length; q++) {
                if (q > 0) { oe = oe + ", " }
                oe = oe + pyRepr(ea[q])
            }
            return oe + ")"
        }
    }
    if (pyLookupHas(cls, "__repr__")) {
        var f = pyLookupVal(cls, "__repr__")
        if (pyIsCallable(f)) { return pyToStr(pyCallSelf(f, v, [])) }
    }
    var nm = cls["__name"]
    if (typeof nm != "string") { nm = "object" }
    var ar = v["args"]
    if (Array.isArray(ar)) {
        var out = nm + "("
        for (var i = 0; i < ar.length; i++) {
            if (i > 0) { out = out + ", " }
            out = out + pyRepr(ar[i])
        }
        return out + ")"
    }
    return "<" + nm + " object>"
}

// abnf/jsrt.go's pyTypeName. A __pybig is an int, which is why the arm is
// ahead of the object arms - Go reaches it earlier because *jsBigInt is not a
// *jsObject and here it IS one.
function pyTypeName(v) {
    if (v === null) { return "NoneType" }
    if (v === undefined) { return "NoneType" }
    if (typeof v == "boolean") { return "bool" }
    if (typeof v == "string") { return "str" }
    if (pyIsBig(v)) { return "int" }
    if (pyIsFlo(v)) { return "float" }
    // A plain number is an INT: 2.0 and 2 are the same double, so nothing about
    // the value can tell the two Python types apart - which is why the float is
    // boxed in the first place.
    if (typeof v == "number") { return "int" }
    if (Array.isArray(v)) { return "list" }
    // CPython's type(gen).__name__, and the name its AttributeError uses.
    if (pyIsGen(v)) { return "generator" }
    if (typeof v == "function") {
        // A BOUND method and a BUILTIN are their own CPython types.
        var bml = pyBMFind(v)
        if (bml >= 0) {
            // An UNBOUND descriptor is its own CPython type; a module-level
            // builtin and a bound builtin method share one.
            if (pyBMTab[bml + 4] == "d") { return "method_descriptor" }
            if (pyBMTab[bml + 3] === null) { return "builtin_function_or_method" }
            return "method"
        }
        var bfk = rtPairGet(pyBBFnObjs, pyBBFnCodes, v)
        if (bfk !== undefined) {
            // range / enumerate / zip / map / filter / reversed really ARE
            // types, and the leading "*" of the code is what says so.
            if (pyToStr(bfk).charAt(0) == "*") { return "type" }
            return "builtin_function_or_method"
        }
        return "function"
    }
    if (pyIsObj(v)) {
        // type(C) is 'type' for a class object - a BUILTIN one (what type(3)
        // hands out, which carries only __name and no __mro) as well as a user
        // class.
        if (pyIsClass(v)) { return "type" }
        if (v["__name"] !== undefined && pyInstClassOf(v) === null) { return "type" }
        if (pySetElemsOf(v) != null) { return "set" }
        if (pyIsDict(v)) { return "dict" }
        if (pyIsCplx(v)) { return "complex" }
        // A CURSOR names its own type: CPython's list_iterator / str_iterator /
        // dict_keyiterator / map / filter / zip / enumerate / reversed. It is
        // what type(it).__name__ answers (js_pytype hands this name to
        // pyBuiltinClass) and what the AttributeError pyDMethodCall's cursor arm
        // raises interpolates - CPython says "'list_iterator' object has no
        // attribute 'send'", not "'object' ...".
        if (pyIsIter(v)) { return pyToStr(v["__pyit"]) }
        // A compiled regexp and a match object name their own CPython types, and
        // the name is MODULE-QUALIFIED here on purpose: this is the string an
        // AttributeError interpolates, and CPython says "'re.Pattern' object has
        // no attribute 'nope'". type(p).__name__ is the SHORT 'Pattern', which is
        // why pyGetAttr's __name__ arm cuts at the last dot (pyShortName).
        if (v["__pyre"] === true) { return "re.Pattern" }
        if (v["__pymatch"] === true) { return "re.Match" }
        if (v["__pysm"] !== undefined) { return "staticmethod" }
        if (v["__pycm"] !== undefined) { return "classmethod" }
        if (v["__pymod"] !== undefined) { return "module" }
        // An instance of a user class is a "'C' object" in every message.
        var ic = pyInstClassOf(v)
        if (ic !== null && ic["__name"] !== undefined) { return pyToStr(ic["__name"]) }
        return "object"
    }
    return "object"
}

// The last component of a possibly module-qualified type name. __name__ and
// __qualname__ of a builtin type object are the SHORT name in CPython
// (type(re.compile('a')).__name__ is 'Pattern') while the type object itself
// renders and reports as 're.Pattern'.
function pyShortName(n) {
    var cut = -1
    for (var i = 0; i < n.length; i++) { if (n.charAt(i) == ".") { cut = i } }
    if (cut < 0) { return n }
    return n.substring(cut + 1, n.length)
}

// ===================================================== equality and order ===
//
// abnf/jsrt.go's pyEqual. The bigint arms are rtABigCmp / pyABigEqFloat; they are
// called from here so every caller of pyEqual gets them.

// The int a bool IS (True is 1, False is 0), against a value that is not a bool.
// The three arms are exactly the three pyEqual takes below for a plain number,
// in the same order, so the two halves answer the same thing for every operand.
function pyEqBoolVal(other, b) {
    var n = b ? 1 : 0
    if (pyIsFlo(other)) { return pyNum(other) == n }
    if (pyIsBig(other)) { return pyABigEqFloat(other, n) }
    if (pyIsCplx(other)) {
        if (pyCplxIm(other) != 0) { return false }
        return pyCplxRe(other) == n
    }
    if (typeof other == "number") { return other == n }
    return false
}

function pyEqual(x, y) {
    var xs = pySetElemsOf(x)
    if (xs != null) {
        var ys = pySetElemsOf(y)
        if (ys == null) { return false }
        if (xs.length != ys.length) { return false }
        for (var i = 0; i < xs.length; i++) {
            if (!pySetHas(ys, xs[i])) { return false }
        }
        return true
    }
    if (pySetElemsOf(y) != null) { return false }
    if (Array.isArray(x)) {
        if (!Array.isArray(y)) { return false }
        if (x.length != y.length) { return false }
        for (var j = 0; j < x.length; j++) {
            if (!pyEqual(x[j], y[j])) { return false }
        }
        return true
    }
    if (pyIsDict(x)) {
        if (!pyIsDict(y)) { return false }
        var xk = x["keys"]
        var yk = y["keys"]
        if (xk.length != yk.length) { return false }
        for (var k = 0; k < xk.length; k++) {
            var p = pyDictFind(yk, xk[k])
            if (p < 0) { return false }
            if (!pyEqual(x["vals"][k], y["vals"][p])) { return false }
        }
        return true
    }
    // A Python bool IS an int - `class bool(int)` - so True == 1, True == 1.0,
    // False == 0 and False == -0.0 all hold, and so does every container equality
    // built on them ([True] == [1], {True: 1} == {1: 1}). The Go twin rewrites the
    // operand in place at this point; MetaJS is TYPED and a variable that held a
    // boolean cannot hold a number, so the arm is taken out of line instead and
    // pyEqBoolVal covers the bigint, the complex and the plain-number case that
    // follow. True == 2 is false because 1 != 2, True == "x" because a string is
    // none of the three.
    if (typeof x == "boolean" || typeof y == "boolean") {
        if (typeof x == "boolean" && typeof y == "boolean") { return x === y }
        if (typeof x == "boolean") { return pyEqBoolVal(y, x) }
        return pyEqBoolVal(x, y)
    }
    if (pyIsBig(x)) {
        if (pyIsBig(y)) { return rtABigCmp(x, y) == 0 }
        if (typeof y == "number") { return pyABigEqFloat(x, y) }
    }
    if (pyIsBig(y)) {
        if (typeof x == "number") { return pyABigEqFloat(y, x) }
    }
    if (pyIsCplx(x)) {
        if (pyIsCplx(y)) {
            if (pyCplxRe(x) != pyCplxRe(y)) { return false }
            return pyCplxIm(x) == pyCplxIm(y)
        }
        if (pyCplxIm(x) != 0) { return false }
        return pyCplxRe(x) == pyNum(y)
    }
    if (pyIsCplx(y)) {
        if (pyCplxIm(y) != 0) { return false }
        return pyCplxRe(y) == pyNum(x)
    }
    // A float equals the int of the same value (1.0 == 1) and two boxes holding
    // the same double are equal though they are two objects.
    if (pyIsFlo(x) || pyIsFlo(y)) {
        if (!pyIsNumeric(x) || !pyIsNumeric(y)) { return false }
        return pyNum(x) == pyNum(y)
    }
    return x === y
}

// ===================================================== classes =============
//
// abnf/jsrt.go's pyClassObj / pyInstance / pyMRO / pyLookup / pyIsDescriptor /
// pyGetAttr / pyInstanceDict / pySetAttr / pySlotAllows / pyAttrError.

function pyClassOf(v) {
    if (pyIsClass(v)) { return v }
    return null
}

function pyInstClassOf(v) {
    if (!pyIsObj(v)) { return null }
    if (v["__mro"] !== undefined) { return null }
    var c = v["__class"]
    if (!pyIsObj(c)) { return null }
    return c
}

// The resolution order of a class, itself first. A class object that predates the
// MRO (an older {__name, __super} exception descriptor) answers with its __super
// chain, so the two shapes stay interchangeable.
function pyMRO(c) {
    var out = []
    var m = c["__mro"]
    if (Array.isArray(m)) {
        for (var i = 0; i < m.length; i++) {
            if (pyIsObj(m[i])) { out.push(m[i]) }
        }
        return out
    }
    var k = c
    while (pyIsObj(k)) {
        out.push(k)
        k = k["__super"]
    }
    return out
}

function pyLookupHas(c, name) {
    if (name == "") { return false }
    var mro = pyMRO(c)
    for (var i = 0; i < mro.length; i++) {
        if (mro[i][name] !== undefined) { return true }
    }
    return false
}

function pyLookupVal(c, name) {
    if (name == "") { return undefined }
    var mro = pyMRO(c)
    for (var i = 0; i < mro.length; i++) {
        if (mro[i][name] !== undefined) { return mro[i][name] }
    }
    return undefined
}

// pyIsDescriptor: an instance whose class defines the given hook.
function pyDescriptor(v, hook) {
    var cls = pyInstClassOf(v)
    if (cls == null) { return undefined }
    var m = pyLookupVal(cls, hook)
    if (typeof m != "function") { return undefined }
    return m
}

// An instance's own attributes as a Python dict (pyInstanceDict). The __-prefixed
// slots are internal and are skipped, which is what Go does with inst.keys.
function pyInstanceDict(inst) {
    var d = pyNewDict()
    var ks = keysOf(inst)
    for (var i = 0; i < ks.length; i++) {
        var k = ks[i]
        if (k.length >= 2 && k.charAt(0) == "_" && k.charAt(1) == "_") { continue }
        d["keys"].push(k)
        d["vals"].push(inst[k])
    }
    return d
}

// C.__mro__ and C.__bases__. The class chains here leave out `object`, which owns
// nothing a lookup could find, while CPython ends every resolution order with it
// and gives a root class the base (object,); a builtin type is its own chain,
// bool's going through int. Go: rt.pyMroAttr in abnf/jsrt.go.
function pyMroAttr(cls, name) {
    var obj = pyBuiltinClass("object")
    if (cls === obj) {
        if (name == "__bases__") { return [] }
        return [obj]
    }
    var out = []
    if (name == "__bases__") {
        var bl = cls["__basesl"]
        if (pyIsArr(bl)) { out = pyCCopyArr(bl) }
    } else if (pyIsArr(cls["__mro"])) {
        out = pyCCopyArr(cls["__mro"])
    } else {
        out.push(cls)
    }
    if (pyBuiltinClsName(cls) == "bool") { out.push(pyBuiltinClass("int")) }
    if (out.length == 0) {
        out.push(obj)
    } else if (name == "__mro__" && out[out.length - 1] !== obj) {
        out.push(obj)
    }
    return out
}

function pyGetAttr(obj, name) {
    // None has no attributes and CPython says so with a catchable AttributeError
    // rather than the floor's uncatchable "member 'x' of undefined". __class__ is
    // the one name None does answer, and it is handled by the instance arm below
    // (pyInstClassOf).
    if (obj === undefined) {
        if (name != "__class__") {
            pyRaiseExc("AttributeError", "'NoneType' object has no attribute '" + name + "'")
        }
    }
    if (pyIsSuper(obj)) { return pySuperAttr(obj, name) }
    if (pyIsClass(obj)) {
        // __qualname__ of a class is its __name__ for every class this subset can
        // write: CPython qualifies only a NESTED class, and a nested `class` here
        // is bound by the same name as a top-level one.
        if (name == "__name__" || name == "__qualname__") { return pyShortName(pyToStr(obj["__name"])) }
        if (name == "__mro__" || name == "__bases__") { return pyMroAttr(obj, name) }
        if (pyLookupHas(obj, name)) {
            var cv = pyLookupVal(obj, name)
            // A staticmethod / classmethod read off the CLASS: the static one
            // loses nothing, the class one binds to this very class.
            if (pyDIsStatic(cv) || pyDIsClsM(cv)) { return pyDDescGet(cv, obj, name) }
            return cv
        }
        // C.mro(), type's own method: the resolution order as a fresh list.
        if (name == "mro") { return function() { return pyMroAttr(obj, "__mro__") } }
        // A CATCHABLE AttributeError, as CPython raises: fail() cannot be caught
        // from layer 2.
        pyRaiseExc("AttributeError",
                   "type object '" + pyToStr(obj["__name"]) + "' has no attribute '" + name + "'")
    }
    var cls = pyInstClassOf(obj)
    if (cls != null) {
        if (name == "__class__") { return cls }
        if (name == "__dict__") { return pyInstanceDict(obj) }
        if (obj[name] !== undefined) { return obj[name] }
        if (pyLookupHas(cls, name)) {
            var v = pyLookupVal(cls, name)
            // staticmethod / classmethod, before every other arm: a static one
            // must NOT pick up the instance as self, and a class one binds to the
            // receiver's OWN class, so D().c() passes D.
            if (pyDIsStatic(v) || pyDIsClsM(v)) { return pyDDescGet(v, cls, name) }
            var get = pyDescriptor(v, "__get__")
            if (get !== undefined) { return get.apply(undefined, [v, obj, cls]) }
            // A METHOD read off an instance comes back BOUND, so `f = a.m; f()`
            // passes the instance as self (the interpreter half's bindMethod).
            if (pyIsCallable(v)) { return pyDBindMethod(obj, v, name) }
            return v
        }
        pyRaiseExc("AttributeError",
                   "'" + pyToStr(cls["__name"]) + "' object has no attribute '" + name + "'")
    }
    // A MODULE object. `builtins.len` resolves through the module's own slot,
    // which the emitter filled with the very binding the global name resolves to,
    // so `builtins.len is len` holds rather than answering a copy; a math
    // function becomes a first-class value the same way `re`'s constants already
    // were readable. Placed before the bound-builtin arm because a module's own
    // data slots (math.pi) must win.
    if (pyIsObj(obj)) {
        if (obj["__pymod"] !== undefined && obj[name] === undefined) {
            if (obj["__pymod"] === "math" && pyMHas(name)) { return pyDModuleFn(obj, name) }
            pyRaiseExc("AttributeError",
                       "module '" + pyToStr(obj["__pymod"]) + "' has no attribute '" + name + "'")
        }
    }
