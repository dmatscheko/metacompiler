    if (!noKey) { bestK = pyDCallPyValue(key, [best], undefined) }
    while (true) {
        st = pyAStep(src)
        if (st["done"]) { break }
        var k = anytype
        k = st["value"]
        if (!noKey) { k = pyDCallPyValue(key, [k], undefined) }
