// ----- the context-manager protocol (Go: js_pyenter / js_pyexit) ------------

// A context expression that is NOT a context manager (no __enter__) binds its
// own value and runs the body: that is the approximation `with` had before the
// protocol existed, kept as the fallback so a plain value still works instead
// of aborting.
function js_pyenter(v) {
    var cls = pyInstClassOf(v)
