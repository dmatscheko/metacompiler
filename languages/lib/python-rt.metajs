    if (op == "-") { return "__sub__" }
    if (op == "*") { return "__mul__" }
    if (op == "/") { return "__truediv__" }
    if (op == "//") { return "__floordiv__" }
    if (op == "%") { return "__mod__" }
    if (op == "@") { return "__matmul__" }
    if (op == "**") { return "__pow__" }
    if (op == "==") { return "__eq__" }
    if (op == "!=") { return "__ne__" }
    if (op == "<") { return "__lt__" }
    if (op == ">") { return "__gt__" }
    if (op == "<=") { return "__le__" }
    if (op == ">=") { return "__ge__" }
    return ""
