            if (tab > 0) {
                var pad = tab - (col - Math.floor(col / tab) * tab)
                out = out + pySRepeat(" ", pad)
                col = col + pad
            }
        } else if (c == 10 || c == 13) {
            out = out + s.charAt(i)
            col = 0
        } else {
            var w = pySCPW(s, i)
