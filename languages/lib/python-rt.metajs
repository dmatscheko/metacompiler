    var ah = t1 - (t1 - a)
    var al = a - ah
    var t2 = 134217729 * b
    var bh = t2 - (t2 - b)
    var bl = b - bh
    var e = al * bl - (((p - ah * bh) - al * bh) - ah * bl)
