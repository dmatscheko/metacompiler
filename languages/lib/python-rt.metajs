// A user function's own attributes (f.k = 4), as the dict f.__dict__ answers,
// in an identity-keyed side table: a function value carries no properties.
// Twin of rt.pyFuncAttrs in abnf/jsrt.go and pyFnAttrs in
// languages/python-interpreter.abnf.
var pyFnAttrFns = []
var pyFnAttrDicts = []
function pyFnAttrs(f, make) {
    var d = rtPairGet(pyFnAttrFns, pyFnAttrDicts, f)
    if (d !== undefined || !make) { return d }
    var nd = pyNewDict()
    pyFnAttrFns.push(f)
    pyFnAttrDicts.push(nd)
    return nd
