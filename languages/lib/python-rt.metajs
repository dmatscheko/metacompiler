// (candidate list, iterable): add every element of an iterable to the list a set
// literal is being built from. NO deduplication here - js_pyset_new does that.
// A non-array destination is silently ignored, exactly as in Go.
//
// Go has NO string arm and NO generator arm: `{*"ab"}` and `{*gen()}` fail with
// "cannot unpack a string into a set". Ported as it stands.
function js_pyset_spread(dst, src) {
    if (!pyIsArr(dst)) { return undefined }
    var els = pySetElemsOf(src)
    if (els !== null && els !== undefined) {
        var i = 0
        var n = els.length
        while (i < n) {
            dst.push(els[i])
            i = i + 1
        }
        return undefined
    }
    if (pyIsArr(src)) {
        var ai = 0
        var an = src.length
        while (ai < an) {
            dst.push(src[ai])
            ai = ai + 1
        }
        return undefined
