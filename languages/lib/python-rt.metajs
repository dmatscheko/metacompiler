// python-rt.metajs -- PYTHON'S OWN SEMANTICS, in MetaJS: python's layer-2 runtime.
//
// languages/python-to-llvm-ir.abnf emits handle IR that calls js_* externs. The
// generic primitives come from languages/lib/runtime.c (the C floor, layer 1); the
// Python-specific ones are here.
//
// Compile with:
//     mec languages/metajs-to-llvm-ir.abnf languages/lib/python-rt.metajs -q -rt-lib
// which is what tests/gen-python-rt-ll.sh does; the result is the checked-in
// languages/lib/python-rt.ll that python-to-llvm-ir.abnf links next to runtime.ll.
// -rt-lib exports every TOP-LEVEL `function js_*` below under its own C symbol, so
// nothing else in this file is visible to the linker - the helpers are deliberately
// named py*, pyA*..pyF*.
//
// THE AUTHORITATIVE SPECIFICATION IS abnf/jsrt.go (Python has NO dedicated Go twin:
// its semantics live in the shared file, in the js_py* extern table and the py*
// helper functions - pyString / pyRepr / pyTypeName / pyEqual / pyMRO / pyLookup /
// pyGetAttr / pySetAttr / pyMethodCall / pyBindCall / pyArith / pyFormat / memberCall)
// plus abnf/jsrtregexpy.go for the `re` module. This file matches them function for
// function; where it CANNOT, the site says so.
//
// ----- the value model -------------------------------------------------------
//
//     null / undefined            ==  None
//     true / false                ==  True / False
//     a PLAIN NUMBER              ==  int. There is no box for an int: pyTypeName
//                                     answers "int" for every plain number.
//     {__flo: f}                  ==  float (a boxed double, see pyIsFlo)
//     {__pybig, neg, limbs}       ==  an arbitrary precision int (js_bigint). Go uses
//                                     math/big; here it is base-10000 limbs.
//     a string                    ==  str
//     an array                    ==  list AND tuple (Python's tuple has no separate
//                                     representation in either half)
//     {__dict, keys, vals}        ==  dict, INSERTION ordered, parallel arrays
//     {__set, elems}              ==  set, duplicate free by pyEqual
//     {__cplx, real, imag}        ==  complex
//     {__mro, __name, __super}    ==  a class object; __mro is the C3 linearization
//     {__class: <class>}          ==  an instance
//     a function                  ==  a function (typeof "function"; tag 16, a
//                                     generator FUNCTION, answers that too)
//     a tag-15 cell               ==  a generator. There is NO tag test in layer 2,
//                                     so pyIsGen below is STRUCTURAL - the floor
//                                     answers exactly one member on a generator,
//                                     "next", and a cursor cannot be stored on one.
//
// ----- what Python needs from the floor --------------------------------------
//
//  1. NO sized-integer tag. Python's int is a plain double, so tag 13 is never
//     reached from this file. Python's ARBITRARY PRECISION int is a base-10000
//     bignum in MetaJS rather than a floor tag: Go reaches math/big through
//     *jsBigInt and the floor has no equivalent.
//  2. `__raw` IS needed. python-to-llvm-ir.abnf sets
//     `core.truthyExt = "js_pytruthy"`, so compile-core's truthy() emits
//     `icmp ne <call>, 0` on THIS FILE's function and consumes the result as a RAW
//     INTEGER. js_pytruthy is therefore written as js_pytruthy__raw.
//  3. The emitter drives the floor's coroutine primitives (js_genfn/js_yield)
//     itself; the generator INSPECTION surface (next / send / close / drain / len)
//     is Python's own and is here.
//  4. NO jsChar. Python has no character type and the emitter emits js_char /
//     js_char_code / js_kindex zero times.
//
// ----- the scope chain: lowered in the EMITTER, not here ---------------------
//
// The externs that take a scope handle (js_pyfnscope, js_pyglobal, js_pynonlocal,
// js_pyset_var, js_pydel_var, js_pyannot, js_pyclass_fill) cannot be written here:
// a scope is the C floor's PRIVATE storage. They are lowered in
// python-to-llvm-ir.abnf instead, over js_scope_new / js_scope_decl / js_scope_get /
// js_scope_set / js_scope_typeof, which BOTH engines have.
//
// ----- the regular-expression engine is IMPORTED, not copied ------------------
//
// languages/lib/regex.js is the shared backtracking engine that every INTERPRETER
// grammar includes into its tag script, and abnf/jsrtregex.go is its line-by-line Go
// port. It is written in the same MetaJS this file is, so layer 2 needs no third
// copy.
//
// ----- MetaJS rules that shape the code below --------------------------------
//
// docs/abnf-dialect-gotchas.md: a local (or a reassigned parameter) keeps the TYPE
// CLASS it is first assigned, so a variable that holds a number in one branch and an
// object in another is declared `var x = anytype`; there is no ASI, so every
// `return` carries its value on the same line and a value-less early return is
// BRACED; no for..in, no splice, no split/join/lastIndexOf, indexOf ignores its
// from-index, array.length is not assignable, and there are no exponent literals.
// There is no hasOwn in a -rt-lib module, so Go's `v, ok := o.props[n]` is spelled
// `o[n] !== undefined` throughout; at RUNTIME an object is a floor cell with no
// prototype, so the Object.prototype hazard of the compiler's own goja objects does
// not arise here.

import "./regex.js"
// (?P...) translation and re.error's message, position and fields.
import "./python-regex.js"

// The shared layer-2 runtime: the externs every language implements identically,
// parameterised by the rtk* hooks below.
import "./runtime.metajs"

// int's and float's own methods at the bit and double level (pyNumMethod),
// and float.fromhex's numeral (hex-float.js).
import "./hex-float.js"
import "./python-num.js"
// "Did you mean" for an unexpected keyword argument.
import "./python-suggest.js"
// The fixed names dir() of a user class answers.
import "./python-dir.js"
// Unicode printability: repr() of a str and str.isprintable().
import "./python-printable.js"

// sin, cos, tan and atan2 (math and the complex power), as the interpreter's.
import "./fdlibm.js"

// ----- the rtk* hooks the shared runtime calls -------------------------------
function rtkStr(v) { return pyAJavaStr(v) }
function rtkNum(v) { return pyNum(v) }
function rtkIsChar(v) { return false }
function rtkIsArr(v) { return pyIsArr(v) }

// ===================================================== the value model ======

// DELIBERATELY NOT SHARED. This predicate is asked at ~30 sites, several of
// them inside the arithmetic and attribute paths every Python statement walks,
// and delegating it to a shared body costs a MetaJS call - a scope frame - per
// ask, which is measurably slower on a predicate this hot.
//
// It is NOT rtIsObj either: that one deliberately leaves the array rejection out,
// because its own callers walk __class/__super and an array carries neither.
function pyIsObj(v) {
    if (v === null) { return false }
    if (v === undefined) { return false }
    if (typeof v != "object") { return false }
    return !Array.isArray(v)
}

function pyIsArr(v) { return Array.isArray(v) }
// Go: pyTupKind / pyTup / pyIsTup in abnf/jsrtpysub.go. A TUPLE is an array
// carrying kind 16 (arrKind / arrKindSet, host ids 99/100: field d of the
// floor's array cell, which a copy does not inherit).
function pyTup(a) { return arrKindSet(a, 16) }
function pyIsTup(v) { return arrKind(v) == 16 }
// Go: pyBytesKind / pyIsBytes / pySeqCls / pySeqTName / pySeqLike in
// abnf/jsrtpybytes.go. bytes and bytearray are arrays of byte values carrying
// kind 17 and 18; == compares kinds by pySeqCls, so bytes equals a bytearray
// of the same bytes and neither equals a list.
function pyIsBytes(v) {
    var k = arrKind(v)
    return k == 17 || k == 18
}
function pySeqCls(v) {
    var k = arrKind(v)
    if (k == 18) { return 17 }
    return k
}
function pySeqTName(v) {
    var k = arrKind(v)
    if (k == 16) { return "tuple" }
    if (k == 17) { return "bytes" }
    if (k == 18) { return "bytearray" }
    return "list"
}
function pySeqLike(o, out) {
    var k = arrKind(o)
    if (k >= 16 && k <= 18) { arrKindSet(out, k) }
    return out
}
// Go: js_pyb. A bytes literal's array, marked.
function js_pyb(a) { return arrKindSet(a, 17) }
// A tuple's two methods.
function pyIsTupleMethod(name) { return name == "count" || name == "index" }
// Go: js_pytup and js_pytupconv. A tuple display marks the array it built, and
// tuple(iterable) is list()'s fresh array, marked - but tuple(t) of a tuple is t
// itself, an immutable value needing no copy.
function js_pytup(a) { return arrKindSet(a, 16) }
function js_pytupconv(v) {
    if (pyIsTup(v)) { return v }
    return arrKindSet(js_pylist(v), 16)
}
function pyIsStr(v) { return typeof v == "string" }
function pyIsNum(v) { return typeof v == "number" }
function pyIsBool(v) { return typeof v == "boolean" }
function pyIsFn(v) { return typeof v == "function" }
function pyIsCallable(v) { return typeof v == "function" }

// pyIsNone is SHARED as rtIsNil - lib/runtime.metajs.

// pyTag is SHARED as rtTag - lib/runtime.metajs - which inlines the tests pyIsObj
// makes rather than calling it, to keep a frame off the hottest predicate here.
function pyIsDict(v) { return rtTag(v, "__dict") }
function pyIsCplx(v) { return rtTag(v, "__cplx") }
function pyIsBig(v) { return rtTag(v, "__pybig") }
function pyIsIntOrBool(v) { return typeof v == "number" || typeof v == "boolean" || pyIsBig(v) }

// Python's float: a boxed double (abnf/jsrt.go's jsPyFlo, python-interpreter.abnf's
// pyFlo). int and float are two DIFFERENT Python types - they print differently
// (1 vs 1.0), answer different type()s, and `/` makes a float even out of two
// ints - and one double cannot carry that, because 2.0 and 2 ARE the same double.
// So the float is the boxed one and the int stays the plain number, which leaves
// the common integer path untouched. The field is not `=== true` like the tags
// above, so rtTag cannot answer it; pyIsObj's tests are inlined for the same
// reason rtTag inlines them - every arithmetic operator asks this.
function pyIsFlo(v) {
    if (v === null) { return false }
    if (v === undefined) { return false }
    if (typeof v != "object") { return false }
    if (Array.isArray(v)) { return false }
    return v["__flo"] !== undefined
}
function pyMkFlo(f) { return {__flo: f} }

// "this value has a double in it": a float box, a plain int, a bool (True is 1)
// or an arbitrary precision integer. Go: pyIsNumeric.
function pyIsNumeric(v) {
    if (typeof v == "number") { return true }
    if (typeof v == "boolean") { return true }
    if (pyIsFlo(v)) { return true }
    return pyIsBig(v)
}

// The result type of // and %: an int from two ints (7 // 2 is 3) and a float as
// soon as either operand is one (7.5 // 2 is 3.0). Go: pyIntOrFlo.
function pyIntOrFlo(f, l, r) {
    if (pyIsFlo(l) || pyIsFlo(r)) { return pyMkFlo(f) }
    return f
}

// A class object carries its C3 linearization; an instance carries its class.
function pyIsClass(v) {
    if (!pyIsObj(v)) { return false }
    return v["__mro"] !== undefined
}

// A GENERATOR is a floor cell (tag 15). Layer 2 has no tag test, so the question is
// answered structurally: the floor answers exactly ONE member on a generator, "next".
//
// THE __pyit LINE IS LOAD-BEARING: a CURSOR (pyMkIter) is a plain object built to
// look exactly like a generator, callable "next" and all, so without it a
// list_iterator would answer TRUE here. The Go twin asks `target.(*jsGenerator)`, a
// real type test, and the interpreter half asks for a __gen tag. Callers that want
// cursors too ask pyIsIter themselves (pySeqElems, js_pysum, pyDMethodCall).
function pyIsGen(v) {
    if (v === null) { return false }
    if (v === undefined) { return false }
    if (typeof v != "object") { return false }
    if (Array.isArray(v)) { return false }
    if (v["__dict"] === true) { return false }
    if (v["__set"] === true) { return false }
    if (v["__cplx"] === true) { return false }
    if (v["__pybig"] === true) { return false }
    if (v["__pyit"] !== undefined) { return false }
    if (v["__mro"] !== undefined) { return false }
    if (v["__class"] !== undefined) { return false }
    // A MODULE object is not a generator: the `builtins` module holds every
    // builtin under its own name, one of which is `next`, so the structural test
    // would answer TRUE for it (type(builtins) would read "generator" and
    // `builtins.next(it)` would step the MODULE). The Go twin tests a real type.
    if (v["__pymod"] !== undefined) { return false }
    return typeof v["next"] == "function"
}

function pyFail(msg) { fail(msg) }

// ===================================================== dict =================
//
// abnf/jsrt.go's dictParts / dictFind / dictAppend (the Go twin's dictFind is an
// index over the same array; the scan is the same answer). A dict KEY is compared
// with STRICT equality plus the rules in pyKeyEq, and the bool/int alias is
// pyKeyAlias below.
//
// The one CPython rule that needs writing down: `bool` subclasses `int`, so
//
//     d = {}; d[True] = "t"; d[1] = "one"
//
// is ONE entry in CPython 3.14, `d[True]` is "one", and `list(d)` is `[True]` -
// the FIRST key object stays and only the VALUE is overwritten. That is why the
// alias is tried at LOOKUP and the key is never normalized on the way in:
// normalizing would store 1 and print `1` where CPython prints `True`.

function pyNewDict() { return js_dict_new() }

// The other spelling of a key Python considers equal to this one. Only the
// bool/int pair can differ: an int and a float are already the same plain double
// here. -0.0 == 0 is true in this comparison, so a negative zero lands in the
// False arm exactly as CPython puts it there.
function pyKeyAlias(k) {
    if (k === true) { return 1 }
    if (k === false) { return 0 }
    if (pyIsFlo(k)) { return k["__flo"] }
    if (typeof k == "number") {
        if (k == 1) { return true }
        if (k == 0) { return false }
    }
    return undefined
}

// The scan's === plus the float rule: a float box keys with the int of the same
// value ({1.0: "a"}[1] is a hit), and two boxes holding the same double are one
// key though they are two objects. Go: rt.dictKeyEq.
function pyKeyEq(a, b) {
    // === FIRST, because pyDictFind has no index and calls this once per stored
    // key: an identical key is the whole answer under every rule below, so the hit
    // path costs one comparison and no call at all.
    if (a === b) { return true }
    if (pyIsFlo(a) || pyIsFlo(b)) {
        if (!pyIsNumeric(a) || !pyIsNumeric(b)) { return false }
        return pyNum(a) == pyNum(b)
    }
    // A TUPLE key. CPython hashes a tuple by its CONTENTS, so `{(1,2): "x"}[(1,2)]`
    // is a hit off two different objects: arrays compare by Python ==, the same
    // rule the set side uses (pySetHas -> pyEqual). The typeof gate keeps the Array.isArray CALL off the
    // string and number keys that are almost every key.
    if (typeof a == "object") {
        if (pyInstClassOf(a) !== null) { return pyUserKeyEq(a, b) }
        if (Array.isArray(a) && Array.isArray(b)) { return pyEqual(a, b) }
        // A frozenset key, by its members; a union key likewise.
        if (pySetElemsOf(a) !== null && pySetElemsOf(b) !== null) { return pyEqual(a, b) }
        if (pyUnionOf(a) !== null && pyUnionOf(b) !== null) { return pyUnionEq(pyUnionOf(a), pyUnionOf(b)) }
        // A slice key, by its bounds.
        if (pyIsSlice(a) && pyIsSlice(b)) { return pyEqual(a, b) }
    }
    return false
}

// ----- Hashability -----------------------------------------------------------
// The twin of pyHashName / pyHashCheck in languages/python-interpreter.abnf and of
// pyUnhashName / pyHashCheck in abnf/jsrt.go. CPython:
//
//   {[1]}      TypeError: cannot use 'list' as a set element (unhashable type: 'list')
//   {{}: 1}    TypeError: cannot use 'dict' as a dict key (unhashable type: 'dict')
//
// The wording differs between the two positions, and the OUTER name is the type
// handed over while the INNER one is the type that is unhashable: a list, or a
// tuple holding one, `{(1, [2]): 3}`. A frozenset and bytes are hashable; a
// bytearray is not.
function pyHashName(v) {
    if (Array.isArray(v)) {
        if (arrKind(v) == 17) { return "" }
        if (!pyIsTup(v)) { return pySeqTName(v) }
        var i = 0
        while (i < v.length) {
            var inner = pyHashName(v[i])
            if (inner != "") { return inner }
            i = i + 1
        }
        return ""
    }
    if (!pyIsObj(v)) { return "" }
    if (v["__set"] === true) {
        if (v["__frozen"] === true) { return "" }
        return "set"
    }
    if (v["__dict"] === true) { return "dict" }
    // A slice hashes as its (start, stop, step) tuple.
    if (v["__pyslice"] !== undefined) {
        var sb = v["__pyslice"]
        var si = 0
        while (si < 3) {
            var sn = pyHashName(sb[si])
            if (sn != "") { return sn }
            si = si + 1
        }
        return ""
    }
    // An instance whose class cannot hash, or whose builtin base cannot, is named
    // by its own class.
    var cls = pyInstClassOf(v)
    if (cls !== null) {
        var how = pyHashOwner(cls)["how"]
        if (how == 2 || (how == 3 && pyHashName(pyUnwrapBuiltin(v)) != "")) { return pyTypeName(v) }
    }
    return ""
}

// elem: true for a set MEMBER, false for a dict KEY.
function pyHashCheck(v, elem) {
    var n = pyHashName(v)
    if (n == "") { return undefined }
    var where = "a dict key"
    if (elem) { where = "a set element" }
    pyRaiseExc("TypeError", "cannot use '" + pyTypeName(v) + "' as " + where
                            + " (unhashable type: '" + n + "')")
    return undefined
}

// The set LOOKUP form. CPython's set.__contains__ / .discard / .remove convert a
// set argument to a frozenset instead of refusing it, so `{1} in {1}` is False
// where `{} in {1}` raises. Only that one pair is exempt; a set used as a DICT
// key still raises.
function pyHashCheckMember(k) {
    if (pyIsObj(k)) {
        if (k["__set"] === true) { return undefined }
    }
    pyHashCheck(k, true)
    return undefined
}

// The alias is tried TWICE: a float box's alias is the plain number and the
// plain number's is the bool, so {True: "t"}[1.0] takes two steps.
function pyDictFind(keys, k) {
    // Every dict lookup, insertion, membership test and removal in this half goes
    // through here, so the unhashable-key refusal needs no other dict site. The
    // typeof guard is inline rather than a pyIsObj call: this is the hottest
    // function in the file and almost every key is a string or a number.
    if (k !== null && k !== undefined) {
        if (typeof k == "object") {
            pyHashCheck(k, false)
            if (pyInstClassOf(k) !== null) { return pyUserKeyFind(keys, k) }
        }
    }
    for (var i = 0; i < keys.length; i++) {
        if (pyKeyEq(keys[i], k)) { return i }
    }
    var alias = pyKeyAlias(k)
    if (alias === undefined) { return 0 - 1 }
    for (var j = 0; j < keys.length; j++) {
        if (pyKeyEq(keys[j], alias)) { return j }
    }
    var alias2 = pyKeyAlias(alias)
    if (alias2 === undefined) { return 0 - 1 }
    for (var q = 0; q < keys.length; q++) {
        if (pyKeyEq(keys[q], alias2)) { return q }
    }
    return 0 - 1
}

function pyDictSet(d, k, v) {
    var keys = d["keys"]
    var i = pyDictFind(keys, k)
    if (i >= 0) {
        d["vals"][i] = v
        return d
    }
    keys.push(k)
    d["vals"].push(v)
    return d
}

// ===================================================== set ==================
//
// abnf/jsrt.go's newPySet / pySetElems / pySetHas / pySetAdd. MEMBERSHIP is Python
// ==, which the dict keys above reach the other way round (=== plus pyKeyAlias);
// the two answer the same question for every value this model builds.

function pyNewSet(elems) { return {__set: true, elems: elems} }

// ----- dict views --------------------------------------------------------------
// keys(), values() and items() answer a live window on the dict, {__dview: the
// method's name, __vd: the dict}. Go: abnf/jsrtpyview.go; the rules are
// pyNewView's in languages/python-interpreter.abnf.
function pyNewDView(d, kind) { return {__dview: kind, __vd: d} }
function pyIsDView(v) {
    if (v === null || v === undefined || typeof v != "object" || Array.isArray(v)) { return false }
    return v["__dview"] !== undefined
}
// The view's elements now, as a fresh list.
function pyDViewElems(v) {
    var d = v["__vd"]
    var kind = v["__dview"]
    if (kind == "keys") { return pyCCopyArr(d["keys"]) }
    if (kind == "values") { return pyCCopyArr(d["vals"]) }
    var pairs = []
    var i = 0
    while (i < d["keys"].length) {
        pairs.push(pyTup([d["keys"][i], d["vals"][i]]))
        i = i + 1
    }
    return pairs
}
function pyDViewLen(v) { return v["__vd"]["keys"].length }
function pyDViewSetLike(v) { return pyIsDView(v) && v["__dview"] != "values" }
// x in view: a key is a lookup, an item a lookup and an ==, a value a scan.
function pyDViewHas(v, x) {
    var d = v["__vd"]
    var kind = v["__dview"]
    if (kind == "keys") { return pyDictFind(d["keys"], x) >= 0 }
    if (kind == "items") {
        if (!pyIsTup(x) || x.length != 2) { return false }
        var i = pyDictFind(d["keys"], x[0])
        return i >= 0 && pyAEqual(d["vals"][i], x[1])
    }
    var vs = d["vals"]
    var j = 0
    while (j < vs.length) {
        if (pyAEqual(vs[j], x)) { return true }
        j = j + 1
    }
    return false
}
// == between a set-like view and a set or another set-like view: the same
// members. A values view equals only itself.
function pyDViewEq(a, b) {
    if (!pyDViewSetLike(a) || !(pyDViewSetLike(b) || pySetElemsOf(b) !== null)) { return a === b }
    var sa = pySetElemsOf(js_pyset_new(a))
    var sb = pySetElemsOf(js_pyset_new(b))
    if (sa.length != sb.length) { return false }
    var i = 0
    while (i < sa.length) {
        if (!pySetHas(sb, sa[i])) { return false }
        i = i + 1
    }
    return true
}

// Go: pySetFrozen / pyFreezeLike / pySetMutator. A frozenset is a set carrying
// __frozen: hashable, and without the methods that mutate. Its set algebra
// answers a frozenset when the frozenset is the left operand or the receiver.
function pySetFrozen(v) { return pyIsObj(v) && v["__frozen"] === true }
function pyFreezeLike(r, frozen) {
    if (frozen && pySetElemsOf(r) !== null) { r["__frozen"] = true }
    return r
}
function pySetMutator(name) {
    if (name == "add" || name == "remove" || name == "discard" || name == "pop") { return true }
    if (name == "clear" || name == "update" || name == "intersection_update") { return true }
    return name == "difference_update" || name == "symmetric_difference_update"
}

// Go: js_pyfrozenset. frozenset(iterable=()).
function js_pyfrozenset(src) {
    var fs = js_pyset_new(src)
    fs["__frozen"] = true
    return fs
}

function pySetElemsOf(v) {
    if (!rtTag(v, "__set")) { return null }
    var e = v["elems"]
    if (!Array.isArray(e)) { return null }
    return e
}

function pySetHas(els, v) {
    if (pyInstClassOf(v) !== null) { return pyUserKeyFind(els, v) >= 0 }
    for (var i = 0; i < els.length; i++) {
        if (pyEqual(els[i], v)) { return true }
    }
    return false
}

function pySetAdd(els, v) {
    // The INSERT form: no frozenset conversion, so `s.add({1})` raises where
    // `{1} in s` does not.
    pyHashCheck(v, true)
    if (!pySetHas(els, v)) { els.push(v) }
    return els
}

// ===================================================== complex ==============
//
// abnf/jsrt.go's newPyComplex / pyComplexParts: a plain number reads as (n, 0), so
// mixed arithmetic needs no second code path.

function pyNewCplx(re, im) { return {__cplx: true, real: re, imag: im} }

function pyCplxRe(v) {
    if (pyIsCplx(v)) { return pyNum(v["real"]) }
