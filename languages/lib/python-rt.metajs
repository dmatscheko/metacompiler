        if (own !== undefined && pyIsCallable(own)) {
            return pyCall(own, pyBindCall(own, args, kw))
        }
        if (pyLookupHas(icls, name)) {
            var m = pyLookupVal(icls, name)
            if (pyIsCallable(m)) {
                var self = rtPrepend(target, args)
                return pyCall(m, pyBindCall(m, self, kw))
            }
            return pyDCallPyValue(m, args, kw)
