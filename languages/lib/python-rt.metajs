// A bound method reads its function's attributes (C().m.k is C.m.k).
function pyFnOwner(f) {
    var bm = pyBMFind(f)
    if (bm >= 0 && pyBMTab[bm + 3] !== null) { return pyBMTab[bm + 3] }
    return f
