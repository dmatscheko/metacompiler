}

function pyDUsed(used, name) {
    var i = 0
    while (i < used.length) {
        if (used[i] == name) { return true }
        i = i + 1
    }
    return false
}

// ----- calling (Go: js_pycall / rt.callPyValue / rt.pyMethodCall) -----------

// f(args, kwargs): calling a CLASS instantiates it (allocate, then __init__
// with self prepended); calling an instance runs its __call__. The keyword dict
// is mapped onto the callee's parameters by pyBindCall.
function js_pycall(callee, pos, kw) {
    if (!pyIsArr(pos)) { fail("js_pycall args must be an array") }
    // A BUILTIN TYPE OBJECT is callable: `int` is the class, and calling it
    // converts. languages/python-to-llvm-ir.abnf binds int/str/float/bool/list/
    // dict/set/tuple to js_pybuiltincls's stable class object with the conversion
    // closure hung on it as __conv, so `type(1) == int` is True (it is the same
    // object) and int("42") still runs the same IR function it always did.
    if (pyIsObj(callee)) {
        var cv = callee["__conv"]
        if (pyIsCallable(cv)) { return pyCall(cv, pos) }
    }
    var cls = pyClassOf(callee)
    if (cls !== null) { return pyDInstantiate(cls, pos, kw) }
    var icls = pyInstClassOf(callee)
    if (icls !== null) {
        if (pyLookupHas(icls, "__call__")) {
            var m = pyLookupVal(icls, "__call__")
            if (pyIsCallable(m)) {
                var self = rtPrepend(callee, pos)
                return pyCall(m, pyBindCall(m, self, kw))
            }
        }
    }
    var bound = pyBindCall(callee, pos, kw)
    // Go asks rt.pyBindCallR whether binding built a NEW array, and passes the
    // caller's own argument HANDLE through when it did not - an identity
    // optimisation, not a semantic choice. Here pyBindCall returns `pos` itself
    // in exactly those cases, so handing `bound` on covers both and needs no
    // test. It must NOT be decided by LENGTH: the extended layout is
    // [p0..pn-1, *args, **kwargs], so a positional count of names.length + 2
    // rebinds to an array of the same length - `def f(a, *rest, **kw)` called
    // `f(1, 2, 3)`, where passing `pos` bound `rest` and `kw` to numbers and
    // the first len(rest) aborted.
    return pyCall(callee, bound)
}

// [v, ...args], the receiver-prepending Python's `self` needs, is SHARED as
// rtPrepend - lib/runtime.metajs. pyDPrepend was recorded as merged in Part A's
// first pass and a fourth copy was still here; rtPrepend's null/undefined guard
// is a superset of it.

// Allocate an instance of cls and run its __init__ with self prepended.
function pyDInstantiate(cls, args, kw) {
    var inst = {}
    inst["__class"] = cls
    if (pyLookupHas(cls, "__init__")) {
        var init = pyLookupVal(cls, "__init__")
        if (pyIsCallable(init)) {
            var self = rtPrepend(inst, args)
            pyCall(init, pyBindCall(init, self, kw))
        }
    }
    return inst
}

// callPyValue (jsrt.go:9260) calls a value that may itself be a class or a
// __call__ instance.
function pyDCallPyValue(v, args, kw) {
    // A BUILTIN TYPE OBJECT is callable and CONVERTS: the emitter binds int/str/
    // float/... to js_pybuiltincls's stable class object with the conversion
    // closure hung on it as __conv (declBind in python-to-llvm-ir.abnf).
    // js_pycall had this arm and this function did not, so `map(str, xs)` - a
    // builtin class passed as a function - died with "call of a non function
    // value". Go: rt.callPyValue in abnf/jsrt.go.
    if (v !== null && v !== undefined && typeof v == "object" && !Array.isArray(v)) {
        var cv = v["__conv"]
        if (typeof cv == "function") { return pyCall(cv, args) }
    }
    var cls = pyClassOf(v)
    if (cls !== null) { return pyDInstantiate(cls, args, kw) }
    var icls = pyInstClassOf(v)
    if (icls !== null) {
        if (pyLookupHas(icls, "__call__")) {
            var m = pyLookupVal(icls, "__call__")
            if (pyIsCallable(m)) {
                var self = rtPrepend(v, args)
                return pyCall(m, pyBindCall(m, self, kw))
            }
        }
    }
    return pyCall(v, pyBindCall(v, args, kw))
}

// pyMethodCall (jsrt.go:9207) is obj.name(args) with Python's binding rule: an
// instance prepends itself, a class object does not (so Base.m(self) works).
//
// NOTE FOR THE CHUNK THAT OWNS js_pymcall: call this as
// pyDMethodCall(target, name, args, kw). Its final fall-through is Go's
// rt.memberCall - the builtin method table for strings / lists / dicts - which
// this chunk does not own; it is spelled pyMemberCall(target, name, args) here.
function pyDMethodCall(target, name, args, kw) {
    // str's own method library (the str-methods chapter at the end of this file).
    // Checked FIRST and by NAME, so a name it does not know still reaches
    // pyFStrMethod's Java-style builtins exactly as it did before.
    if (typeof target == "string") {
        if (pySIsStrMethod(name)) { return pyStrMethod(target, name, args, kw) }
    }
    // A generator's own protocol. Python's send()/next() answer the YIELDED
    // value and raise StopIteration - carrying the body's return value - at the
    // end, where JavaScript's next() answers a {value, done} record. There is no
    // tag test in layer 2, so "is this a generator" is pyIsGen's structural one.
    if (pyIsGen(target)) {
        if (name == "send" || name == "next" || name == "__next__") {
            var sent = anytype
            sent = undefined
            if (args.length > 0) { sent = args[0] }
            var st = anytype
            // A CLOSED generator needs no special case here: close() below is a
            // real close in the floor (runtime.c's gen_close sets the cell's done
            // flag), so gen_next answers {undefined, true} for it exactly as
            // (*jsGenerator).step does. It used to need an identity-keyed side
            // table, which the for-loop's own iteration never consulted - so
            // `for v in g` after g.close() still yielded the rest, natively only.
            st = target["next"].apply(target, [sent])
            if (st === undefined || st === null) { fail("generator step failed") }
            if (st["done"] === true) {
                var exc = pyExcInstance("StopIteration", "")
                // StopIteration carries the body's RETURN value, and a generator
                // that returned nothing (or that close() abandoned) carries None.
                // It has to be spelled null and not undefined: pyGetAttr's own test
                // is `obj[name] !== undefined`, so an undefined-valued attribute
                // reads as ABSENT and `e.value` died natively with "'StopIteration'
                // object has no attribute 'value'" while llvm.Run answered None -
                // a layer-2-only divergence, which only a native probe can see.
                var sv = anytype
                sv = st["value"]
                if (sv === undefined) { sv = null }
                exc["value"] = sv
                throw exc
            }
            return st["value"]
        }
        if (name == "close") {
            // CPython's generator.close() answers None, not a {value, done}
            // record - the record is JavaScript's g.return(v), which is what the
            // floor's tag-15 `return` member builds and what this discards. The
            // close itself runs the body's `finally` clauses (runtime.c's
            // gen_close, abnf/jsrt.go's closeBody).
            target["return"].apply(target, [undefined])
            return undefined
