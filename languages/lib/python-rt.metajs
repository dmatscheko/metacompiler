    // 4 / 2 is 2.0 and 10**30 / 1 is 1e+30.
    if (op == "/") { return pyMkFlo(pyAToF(l) / pyAToF(r)) }
    if (op == "//") { return pyIntOrFlo(Math.floor(pyNum(l) / pyNum(r)), l, r) }
    // "fmt" % args is printf-style FORMATTING, not a remainder.
    if (op == "%" && typeof l == "string") { return pyBPct(l, r) }
    if (op == "%") { return pyIntOrFlo(pyAFloorMod(pyNum(l), pyNum(r)), l, r) }
    // Python's exponentiation. Only js_pybin ever passes this operator, and a
    // user class already had its __pow__ / __rpow__ chance above. int ** NEGATIVE
    // int is a float (2 ** -1 is 0.5); every other pair of ints stays an int.
    // ...and a Python int is ARBITRARY PRECISION, so 10**30 is
    // 1000000000000000000000000000000, not the double 1e+30 this used to fold.
    // pyABigNarrow hands back a plain number whenever it still fits, so nothing
    // below 2^53 changes shape.
    if (op == "**") {
        var ex = pyNum(r)
        if (ex < 0) { return pyMkFlo(Math.pow(pyNum(l), ex)) }
        if (!pyIsFlo(l) && !pyIsFlo(r) && ex == Math.trunc(ex) && ex <= 4096) {
            var bl = pyABigOperand(l)
            if (bl !== null) { return pyABigNarrow(pyABigPow(bl, ex)) }
        }
        return pyIntOrFlo(Math.pow(pyNum(l), ex), l, r)
    }
    if (op == "==") { return pyAEqual(l, r) }
    if (op == "!=") { return !pyAEqual(l, r) }
    if (op == "<") { return pyACompare(l, r) == -1 }
    if (op == ">") { return pyACompare(l, r) == 1 }
    if (op == "<=") {
        var c1 = pyACompare(l, r)
        return c1 == -1 || c1 == 0
    }
    if (op == ">=") {
        var c2 = pyACompare(l, r)
        return c2 == 1 || c2 == 0
    }
    pyFail("unsupported operand type for " + op + ": " + pyAJsTypeOf(l) + " and " + pyAJsTypeOf(r))
    return false
}

// Go: js_pyunary (jsrt.go:7757). Unary - / ~ with the __neg__ / __invert__
// fallback. Go guards the bigint arm with rt.hasBigInt, a flag js_bigint sets;
// the test here is structural instead, which is the same answer because the flag
// can only be false when no big value exists to test.
function js_pyunary(opv, v) {
    var op = pyToStr(opv)
    var name = "__neg__"
    if (op == "~") { name = "__invert__" }
    var cls = pyInstClassOf(v)
    if (cls !== null && pyLookupHas(cls, name)) {
        var m = pyLookupVal(cls, name)
        if (pyIsCallable(m)) { return pyCallSelf(m, v, []) }
    }
    if (op == "~") {
        // ~x is -x-1 at ARBITRARY PRECISION, not ECMAScript's ToInt32 complement:
        // ~(2**40) used to be -257. Inside int32 the two agree exactly, so the
        // hot path is still the floor's own operator.
        if (pyABitIsSmall(v)) { return ~pyNum(v) }
        var bv = pyABigOperand(v)
        if (bv !== null) { return pyABigNarrow(pyABitNot(bv)) }
        return ~pyNum(v)
    }
    if (pyIsCplx(v)) { return pyNewCplx(-pyCplxRe(v), -pyCplxIm(v)) }
    if (pyIsBig(v)) { return pyABigNeg(v) }
    if (pyIsFlo(v)) { return pyMkFlo(pyFloNegate(v["__flo"])) }
    return -pyNum(v)
}

// Go: js_pyint (jsrt.go:7741). int(v): Python's truncation toward zero, and a
// bigint stays exact.
function js_pyint(v) {
    if (pyIsBig(v)) { return v }
    return Math.trunc(pyNum(v))
}

// float("inf") - CPython's float_from_string accepts "inf", "infinity" and "nan"
// case-insensitively, with an optional sign, after stripping whitespace.
// JavaScript's parseFloat accepts "Infinity" and none of the rest, so float("inf")
// was nan in all three engines. pyStrToF in languages/python-interpreter.abnf is
// the same body; the whole reasoning, including why the infinity is BUILT with
// Math.pow(2, 1024) and why only the non-finite spellings are handled, is there.
function pyStrToF(s) {
    var t = s.trim()
    var sign = 1
    if (t.length > 0 && (t.charAt(0) == "+" || t.charAt(0) == "-")) {
        if (t.charAt(0) == "-") { sign = 0 - 1 }
        t = t.slice(1)
    }
    var low = t.toLowerCase()
    if (low == "inf" || low == "infinity") {
        var inf = Math.pow(2, 1024)
        if (sign < 0) { return inf / (0 - 1) }
        return inf
    }
    if (low == "nan") { return parseFloat("nan") }
    return parseFloat(s)
}

// Go: js_pyfloat (jsrt.go:7994). A STRING goes through pyStrToF, which is
// JavaScript's parseFloat (a PREFIX parse: "1.5abc" is 1.5) plus CPython's three
// non-finite spellings, not toNumber.
function js_pyfloat(v) {
    if (typeof v == "string") { return pyMkFlo(pyStrToF(v)) }
    return pyMkFlo(pyNum(v))
}

// js_pyflo: the float LITERAL builder. Constant folding cannot carry a box, so
// languages/python-to-llvm-ir.abnf emits this call for 1.0 and 1e3.
function js_pyflo(v) { return pyMkFlo(pyNum(v)) }

// js_pyabs: abs(), which used to be bound straight from JS Math and would answer
// NaN on a box. It keeps the type: abs(-2) is the int 2, abs(-1.5) the float 1.5,
// and abs() of an arbitrary precision int stays exact.
function js_pyabs(v) {
    if (pyIsFlo(v)) {
        var f = v["__flo"]
        if (f < 0) { return pyMkFlo(pyFloNegate(f)) }
        return pyMkFlo(f)
    }
    if (pyIsBig(v)) {
        if (pyABigCmp(v, pyABigFromNum(0)) < 0) { return pyABigNeg(v) }
        return v
    }
    var n = pyNum(v)
    if (n < 0) { return 0 - n }
    return n
}

// Go: js_pybool (jsrt.go:7981). An empty container is false; everything else is
// the ordinary truthiness.
function js_pybool(v) {
    var els = pySetElemsOf(v)
    if (els !== null) { return els.length > 0 }
    if (pyIsArr(v)) { return v.length > 0 }
    if (pyIsDict(v)) { return v["keys"].length > 0 }
    return pyATruthy(v)
}

// Go: js_pycomplex (jsrt.go:7359).
function js_pycomplex(re, im) { return pyNewCplx(pyNum(re), pyNum(im)) }

// A generator drained to a list - Go's (*jsGenerator).drain, which js_pysum
// calls before summing. There is no tag test in layer 2, so the generator is
// driven structurally, as the brief prescribes.
function pyADrainGen(g) {
    var out = []
    var step = g["next"].apply(g, [])
    while (!pyATruthy(step["done"])) {
        out.push(step["value"])
        step = g["next"].apply(g, [])
    }
    return out
}

// Go: js_pysum (jsrt.go:8000). Note that the failure message interpolates
// rt.typeOf - the JAVASCRIPT type name - and reports it for the ORIGINAL
// argument, not for the drained one.
function js_pysum(v) {
    var it = anytype
    it = v
    if (pyIsGen(it)) { it = pyADrainGen(it) }
    var els = pySetElemsOf(it)
    if (els !== null) { it = els }
    var total = 0
    var anyFlo = false
    if (pyIsArr(it)) {
        var i = 0
        while (i < it.length) {
            if (pyIsFlo(it[i])) { anyFlo = true }
            total = total + pyNum(it[i])
            i = i + 1
        }
    } else {
        pyFail("sum() of a " + pyAJsTypeOf(v))
    }
    if (anyFlo) { return pyMkFlo(total) }
    return total
}

// Go: rt.pyMinMax (jsrt.go:9557). want is +1 for max, -1 for min. A SINGLE
// argument that is a list is iterated; anything else is the argument list itself.
function pyAMinMax(argsV, want) {
    if (!pyIsArr(argsV)) { pyFail("max/min needs an argument array") }
    var elems = argsV
    if (elems.length == 1 && pyIsArr(elems[0])) { elems = elems[0] }
    else if (elems.length == 1 && (pyIsIter(elems[0]) || pyIsGen(elems[0]))) {
        elems = pyElemsOf(elems[0]) // max(map(f, xs)), max(iter(xs)).
    }
    if (elems.length == 0) { pyFail("max/min of an empty sequence") }
    var best = anytype
    best = elems[0]
    var i = 1
    while (i < elems.length) {
        if (pyACompare(elems[i], best) == want) { best = elems[i] }
        i = i + 1
    }
    return best
}

// Go: js_pymax / js_pymin (jsrt.go:7651). declBuiltin passes the WHOLE argument
// array (languages/python-to-llvm-ir.abnf:3165, argc 0).
function js_pymax(args) { return pyAMinMax(args, 1) }
function js_pymin(args) { return pyAMinMax(args, -1) }

// Go: js_pyrange (jsrt.go:7142). range(a) or range(a, b) as a MATERIALIZED list.
// Only a genuinely missing second argument means range(0, a): Go tests jsUndefT,
// so an explicit None still reaches toNumber and answers 0.
function js_pyrange(a, b) {
    var from = Math.trunc(pyNum(a))
    var to = from
    if (b === undefined) {
        from = 0
    } else {
        to = Math.trunc(pyNum(b))
    }
    var out = []
    var i = from
    while (i < to) {
        out.push(i)
        i = i + 1
    }
    return out
}

// ord(c) / chr(n). They were missing from ALL THREE engines (docs/todo.md 2.9
// said the compiled halves had them; a probe at 114fbd5 showed `variable not
// defined: ord` under llvm.Run too), so they land here, in
// languages/python-interpreter.abnf and in abnf/jsrt.go together.
//
// A string is UTF-16 in every engine here, so a character ABOVE the BMP is a
// surrogate PAIR of code units and ONE character to Python: js_pyord decodes the
// pair (ord("\U0001F600") is 128512, not the high surrogate) and js_pychr
// re-encodes it. Length is pyStrLen, which counts CODE POINTS. The domain errors
// use `fail` with CPython's own wording, the way pySFail reports one.
function js_pyord(s) {
    if (!pyIsStr(s)) {
        fail("TypeError: ord() expected string of length 1, but " + pyTypeName(s) + " found")
        return 0
    }
    var n = pyStrLen(s)
    if (n != 1) {
        fail("TypeError: ord() expected a character, but string of length " + n + " found")
        return 0
    }
    var c = s.charCodeAt(0)
    if (c >= 55296 && c <= 56319 && s.length > 1) {
        var t = s.charCodeAt(1)
        if (t >= 56320 && t <= 57343) { return 65536 + (c - 55296) * 1024 + (t - 56320) }
    }
    return c
}

function js_pychr(n) {
    var v = 0
    // A Python bool IS an int, so chr(True) is "\x01" - taken out of line
    // because MetaJS is TYPED and `n` could not be rewritten in place.
    if (typeof n == "boolean") { v = n ? 1 : 0 }
    else if (typeof n == "number") { v = Math.trunc(n) }
    else {
        fail("TypeError: '" + pyTypeName(n) + "' object cannot be interpreted as an integer")
        return ""
    }
    if (v < 0 || v > 1114111) {
        fail("ValueError: chr() arg not in range(0x110000)")
        return ""
    }
    return pyBCodePoint(v)
}

// ===== docs/todo.md 1.4: the builtins missing from ALL THREE engines ========
//
// Each is bound by declBuiltin in languages/python-to-llvm-ir.abnf, has a Go
// twin of the same js_py* name in abnf/jsrt.go and a hostGlobals entry in
// languages/python-interpreter.abnf. The variadic ones (next, round, pow, zip,
// map, enumerate, getattr, setattr, sorted) are declared with argc 0, which
// hands them the whole ARGUMENT ARRAY.
//
// NOT done, each for a reason stated at the binding site: input (reads stdin),
// format, frozenset, hash, id.
//
// THE ITERATOR OBJECT. iter/enumerate/zip/map/filter/reversed answer an ITERATOR
// in CPython and next() drives it, and this project had no such value: the only
// steppable thing was a generator. So an iterator is built to LOOK like one - a
// plain object carrying a callable "next" that answers {value, done} - which is
// exactly what pyIsGen tests for and what the compiled for-loop tests for
// (python-to-llvm-ir.abnf's makeForStmt reads js_get(v, "next")), so a for loop
// over one is LAZY with no change to the emitter and `it.__next__()` raises
// StopIteration through pyDMethodCall's generator arm.
//
// The SOURCE is materialized, and that is the line drawn: CPython's
// map/filter/zip/enumerate are lazy in their input too, so `map(f, endless())`
// works there and hangs here. iter(gen) answers the GENERATOR ITSELF - CPython's
// rule as well - so the lazy case docs/todo.md 1.7 fixed is untouched.
//
// Go: rt.pyMkIter / rt.pyItStep (abnf/jsrt.go).
function pyMkIter(name, arr) {
    var it = {__pyit: name, __a: arr, __i: 0}
    it["next"] = function() { return pyItStep(it) }
    return it
}

function pyItStep(it) {
    if (it["__i"] >= it["__a"].length) { return {value: undefined, done: true} }
    var v = it["__a"][it["__i"]]
    it["__i"] = it["__i"] + 1
    return {value: v, done: false}
}

function pyIsIter(v) {
    if (v === null || v === undefined) { return false }
    if (typeof v != "object") { return false }
    if (Array.isArray(v)) { return false }
    return v["__pyit"] !== undefined
}

// What is LEFT of an iterator; the read EXHAUSTS it, so next(it) followed by
// list(it) does not repeat an element.
function pyIterRest(it) {
    var out = []
    var i = it["__i"]
    while (i < it["__a"].length) {
        out.push(it["__a"][i])
        i = i + 1
    }
    it["__i"] = it["__a"].length
    return out
}

// js_pyiter's element list, as a fresh array: a generator drains, an iterator
// gives what is left, a set copies, a dict gives its keys, a string its
// characters. Go: rt.pyElemsOf.
function pyElemsOf(v) {
    if (pyIsIter(v)) { return pyIterRest(v) }
    if (pyIsGen(v)) { return pyADrainGen(v) }
    var els = pySetElemsOf(v)
    if (els !== null && els !== undefined) { return pyCCopyArr(els) }
    if (pyIsArr(v)) { return v }
    if (typeof v == "string") { return pyCStrChars(v) }
    if (pyIsDict(v)) { return pyCCopyArr(v["keys"]) }
    throw pyExcInstance("TypeError", "'" + pyTypeName(v) + "' object is not iterable")
}

function pyIterKind(v) {
    if (typeof v == "string") { return "str_iterator" }
    if (pyIsArr(v)) { return "list_iterator" }
    return "iterator"
}

function js_pyiterfn(v) {
    if (pyIsGen(v) || pyIsIter(v)) { return v }
    return pyMkIter(pyIterKind(v), pyCCopyArr(pyElemsOf(v)))
}

// next(it[, default]). The COMPILER half had no `next` at all, which is
// docs/todo.md 1.4's sharpest gap: next(g) is the ordinary way to drive a
// generator.
function js_pynext(args) {
    var it = pyFArgAt(args, 0)
    if (pyIsIter(it)) {
        var s = pyItStep(it)
        if (s["done"] === true) { return pyStopIter(args, undefined) }
        return s["value"]
    }
    if (pyIsGen(it)) {
        var st = it["next"].apply(it, [undefined])
        if (st === undefined || st === null) { fail("generator step failed") }
        if (st["done"] === true) { return pyStopIter(args, st["value"]) }
        return st["value"]
    }
    throw pyExcInstance("TypeError", "'" + pyTypeName(it) + "' object is not an iterator")
}

// next()'s end: the default argument when there is one, else StopIteration.
function pyStopIter(args, val) {
    if (args.length > 1) { return args[1] }
    var exc = pyExcInstance("StopIteration", "")
    // Spelled null and not undefined for the reason pyDMethodCall's generator
    // arm records: pyGetAttr treats an undefined-valued attribute as ABSENT.
    var sv = anytype
    sv = val
    if (sv === undefined) { sv = null }
    exc["value"] = sv
    throw exc
}

function js_pyenumerate(args) {
    var start = 0
    if (args.length > 1) { start = pyNum(args[1]) }
    var a = pyElemsOf(pyFArgAt(args, 0))
    var out = []
    var i = 0
    while (i < a.length) {
        out.push([start + i, a[i]])
        i = i + 1
    }
    return pyMkIter("enumerate", out)
}

// The shortest source wins, and every source is materialized first.
function pyZipRows(srcs) {
    var n = 0 - 1
    var i = 0
    while (i < srcs.length) {
        if (n < 0 || srcs[i].length < n) { n = srcs[i].length }
        i = i + 1
    }
    if (n < 0) { n = 0 }
    var out = []
    i = 0
    while (i < n) {
        var row = []
        var k = 0
        while (k < srcs.length) {
            row.push(srcs[k][i])
            k = k + 1
        }
        out.push(row)
        i = i + 1
    }
    return out
}

function js_pyzip(args) {
    var srcs = []
    var i = 0
    while (i < args.length) {
        srcs.push(pyElemsOf(args[i]))
        i = i + 1
    }
    return pyMkIter("zip", pyZipRows(srcs))
}

function js_pymapfn(args) {
    var f = pyFArgAt(args, 0)
    var srcs = []
    var i = 1
    while (i < args.length) {
        srcs.push(pyElemsOf(args[i]))
        i = i + 1
    }
    var rows = pyZipRows(srcs)
    var out = []
    i = 0
    while (i < rows.length) {
        out.push(pyDCallPyValue(f, rows[i], undefined))
        i = i + 1
    }
    return pyMkIter("map", out)
}

// filter(None, xs) keeps the TRUTHY elements - CPython's documented special
// case for a None function.
function js_pyfilterfn(f, src) {
    var a = pyElemsOf(src)
    var out = []
    var i = 0
    while (i < a.length) {
        var keep = false
        if (f === undefined || f === null) { keep = js_pybool(a[i]) }
        else { keep = js_pybool(pyDCallPyValue(f, [a[i]], undefined)) }
        if (keep) { out.push(a[i]) }
        i = i + 1
    }
    return pyMkIter("filter", out)
}

function js_pyreversed(v) {
    var a = pyElemsOf(v)
    var out = []
    var i = a.length - 1
    while (i >= 0) {
        out.push(a[i])
        i = i - 1
    }
    return pyMkIter("reversed", out)
}

// sorted(x): a NEW list, ascending, by the same comparison `<` uses. CPython's
// key= and reverse= are KEYWORD-ONLY and a signature-less builtin here is
// reached positionally only, so they are refused loudly rather than ignored.
// Insertion sort, which is STABLE - Python's sort is.
function js_pysorted(args) {
    if (args.length > 1) { fail("sorted(): key= and reverse= are not supported") }
    var a = pyCCopyArr(pyElemsOf(pyFArgAt(args, 0)))
    var i = 1
    while (i < a.length) {
        var x = anytype
        x = a[i]
        var j = i - 1
        while (j >= 0 && pyACompare(x, a[j]) == -1) {
            a[j + 1] = a[j]
            j = j - 1
        }
        a[j + 1] = x
        i = i + 1
    }
    return a
}

function js_pyall(v) {
    var a = pyElemsOf(v)
    var i = 0
    while (i < a.length) {
        if (!js_pybool(a[i])) { return false }
        i = i + 1
    }
    return true
}

function js_pyany2(v) {
    var a = pyElemsOf(v)
    var i = 0
    while (i < a.length) {
        if (js_pybool(a[i])) { return true }
        i = i + 1
    }
    return false
}

// bin/hex/oct: CPython's 0b/0x/0o prefix with the sign OUTSIDE it, so bin(-5) is
// '-0b101'. The digits come out through pyABin, so an ARBITRARY PRECISION int
// converts exactly - the Go twin uses math/big for the same reason.
function js_pybinstr(n) { return pyRadixOf(n, 2, "0b") }
function js_pyhexstr(n) { return pyRadixOf(n, 16, "0x") }
function js_pyoctstr(n) { return pyRadixOf(n, 8, "0o") }

function pyRadixOf(n, base, prefix) {
    if (typeof n == "boolean") {
        if (n) { return prefix + "1" }
        return prefix + "0"
    }
    if (typeof n != "number" && !pyIsBig(n)) {
        throw pyExcInstance("TypeError",
                            "'" + pyTypeName(n) + "' object cannot be interpreted as an integer")
    }
    var sign = ""
    var v = anytype
    v = pyABigOperand(n)                        // Promotes a plain int too.
    if (pyABigCmp(v, pyABigFromNum(0)) < 0) {
        sign = "-"
        v = pyABigNeg(v)
    }
    var digits = "0123456789abcdef"
    var out = ""
    var bb = pyABigFromNum(base)
    if (pyABigIsZero(v)) { out = "0" }
    while (!pyABigIsZero(v)) {
        out = digits.charAt(Math.trunc(pyNum(pyABigNarrow(pyABigRem(v, bb))))) + out
        v = pyABigQuo(v, bb)
    }
    return sign + prefix + out
}

// INTEGER *, //, % over operands of either width, with a POSITIVE divisor - the
// two callers are the radix loop (base 2/8/16) and modular pow (modulus > 0).
// pyABigArith cannot be used directly: it requires BOTH sides to be big already,
// where these mix a big with a small literal, and its % is the TRUNCATED
// remainder while Python's is FLOORED. Both are handled here: the operands are
// promoted with pyABigOperand and a negative remainder is corrected by adding
// the divisor. Go: math/big does the same job in rt.pyRadix and js_pypow.
function pyAIntOp(op, l, r) {
    if (pyIsBig(l) || pyIsBig(r)) {
        var bl = pyABigOperand(l)
        var br = pyABigOperand(r)
        if (bl !== null && br !== null && !pyABigIsZero(br)) {
            if (op == "*") { return pyABigNarrow(pyABigMul(bl, br)) }
            var q = pyABigQuo(bl, br)
            var m = pyABigRem(bl, br)
            if (pyABigCmp(m, pyABigFromNum(0)) < 0) {
                m = pyABigAdd(m, br)          // The divisor is positive here.
                q = pyABigSub(q, pyABigFromNum(1))
            }
            if (op == "//") { return pyABigNarrow(q) }
            return pyABigNarrow(m)
        }
    }
    if (op == "*") { return pyNum(l) * pyNum(r) }
    if (op == "//") { return Math.floor(pyNum(l) / pyNum(r)) }
    return pyAFloorMod(pyNum(l), pyNum(r))
}

// divmod(a, b) is the pair (a // b, a % b): FLOOR division and the floored
// remainder, so divmod(-7, 2) is (-4, 1). A tuple is a list in this value model
// (docs/working-on-this-project.md 7.9).
function js_pydivmod(l, r) {
    if (pyNum(r) == 0) {
        throw pyExcInstance("ZeroDivisionError", "integer division or modulo by zero")
    }
    return [pyIntOrFlo(Math.floor(pyNum(l) / pyNum(r)), l, r),
            pyIntOrFlo(pyAFloorMod(pyNum(l), pyNum(r)), l, r)]
}

// round(x[, n]) rounds HALF TO EVEN, so round(0.5) is 0, round(1.5) is 2 and
// round(2.5) is 2 - which a Math.floor(x + 0.5) spelling gets wrong on every
// other integer. rtFixed is the shared exact decimal formatter and rounds half
// to even by construction (docs/working-on-this-project.md 7.7).
function js_pyround(args) {
    var v = pyFArgAt(args, 0)
    var f = pyAToF(v)
    if (args.length < 2 || args[1] === undefined || args[1] === null) {
        return parseFloat(rtFixed(f, 0))
    }
    var nd = Math.trunc(pyNum(args[1]))
    if (nd < 0) { nd = 0 }
    var r = parseFloat(rtFixed(f, nd))
    if (nd <= 0 && !pyIsFlo(v)) { return r }
    return pyMkFlo(r)
}

// pow(a, b[, m]): the ** operator, plus CPython's three-argument MODULAR form,
// computed by repeated squaring so an arbitrary-precision base stays exact.
function js_pypow(args) {
    var l = pyFArgAt(args, 0)
    var r = pyFArgAt(args, 1)
    if (args.length > 2 && args[2] !== undefined && args[2] !== null) {
        var m = args[2]
        var base = anytype
        base = pyAIntOp("%", l, m)
        var acc = anytype
        acc = 1
        var e = anytype
        e = r
        while (pyACompare(e, 0) == 1) {
            if (pyAEqual(pyAIntOp("%", e, 2), 1)) { acc = pyAIntOp("%", pyAIntOp("*", acc, base), m) }
            e = pyAIntOp("//", e, 2)
            base = pyAIntOp("%", pyAIntOp("*", base, base), m)
        }
        return acc
    }
    var ex = pyNum(r)
    if (ex < 0) { return pyMkFlo(Math.pow(pyNum(l), ex)) }
    if (!pyIsFlo(l) && !pyIsFlo(r) && ex == Math.trunc(ex) && ex <= 4096) {
        var bl = pyABigOperand(l)
        if (bl !== null) { return pyABigNarrow(pyABigPow(bl, ex)) }
    }
    return pyIntOrFlo(Math.pow(pyNum(l), ex), l, r)
}

// callable(x): a function, a class object, or an instance whose class defines
// __call__.
function js_pycallable(v) {
    if (typeof v == "function") { return true }
    if (v === null || v === undefined) { return false }
    if (typeof v != "object") { return false }
    if (Array.isArray(v)) { return false }
    if (v["__name"] !== undefined) { return true } // A class object, builtin or not.
    var cls = pyInstClassOf(v)
    if (cls !== null && cls !== undefined) { return pyLookupHas(cls, "__call__") }
    return false
}

// ascii(x) is repr(x) with every non-ASCII code point escaped as well.
function js_pyascii(v) {
    var s = pyRepr(v)
    var out = ""
    var k = 0
    while (k < s.length) {
        var cc = s.charCodeAt(k)
        var cp = cc
        var w = 1
        if (cc >= 55296 && cc <= 56319 && k + 1 < s.length) {
            var lo = s.charCodeAt(k + 1)
            if (lo >= 56320 && lo <= 57343) {
                cp = 65536 + (cc - 55296) * 1024 + (lo - 56320)
                w = 2
            }
        }
        if (cp < 128) { out = out + s.charAt(k) }
        else if (cp < 256) { out = out + "\\x" + pyHexPad(cp, 2) }
        else if (cp < 65536) { out = out + "\\u" + pyHexPad(cp, 4) }
        else { out = out + "\\U" + pyHexPad(cp, 8) }
        k = k + w
    }
    return out
}

// getattr(o, n[, default]) / hasattr(o, n) / setattr(o, n, v), over the same
// pyGetAttr / pySetAttr the `.` operator uses. hasattr MIRRORS the lookup rather
// than calling pyGetAttr and catching, because fail() is not catchable here -
// and the Go twin has the same structural form for the same reason.
function js_pygetattr3(args) {
    var o = pyFArgAt(args, 0)
    var n = pyToStr(pyFArgAt(args, 1))
    if (args.length > 2 && !pyDHasAttr(o, n)) { return args[2] }
    return pyGetAttr(o, n)
}

function js_pyhasattr(o, n) { return pyDHasAttr(o, pyToStr(n)) }

function js_pysetattr3(args) {
    pySetAttr(pyFArgAt(args, 0), pyToStr(pyFArgAt(args, 1)), pyFArgAt(args, 2))
    return undefined
}

function pyDHasAttr(obj, name) {
    if (obj === null || obj === undefined) { return name == "__class__" }
    if (pyIsClass(obj)) {
        if (name == "__name__" || name == "__mro__") { return true }
        return pyLookupHas(obj, name)
    }
    var cls = pyInstClassOf(obj)
    if (cls !== null && cls !== undefined) {
        if (name == "__class__" || name == "__dict__") { return true }
        if (obj[name] !== undefined) { return true }
        return pyLookupHas(cls, name)
    }
    // docs/todo.md 1.2: the BUILT-IN methods of str / list / dict / set, and
    // __class__, which EVERY value has (None.__class__ is NoneType).
    if (name == "__class__") { return true }
    if (pyDBuiltinAttr(obj, name)) { return true }
    if (typeof obj != "object") { return false }
    if (Array.isArray(obj)) { return false }
    return obj[name] !== undefined
}

// Go: js_pyeq (jsrt.go:7179). Python's == compares CONTAINERS BY VALUE, unlike
// JavaScript's. 'is' keeps using js_seq, because that one really is identity.
// The str-method chunk's hook for "materialize a generator or an iterator
// object", null when the value is neither. See the join arm of pyStrMethod.
function pySSeqOf(v) {
    if (pyIsIter(v) || pyIsGen(v)) { return pyElemsOf(v) }
    return null
}

function js_pyeq(x, y) { return pyAEqual(x, y) }

// Go: js_jadd (jsrt.go:5151). Java/C# +: string concat, 32 bit add for two int
// values, float add otherwise. The Python emitter reaches it only through
// makeStrConcat / makeFString / emitSpecText (python-to-llvm-ir.abnf:1385,
// 1462, 1478), each of which seeds the chain with emitStr(b, ""), so the STRING
// arm always wins and the numeric arms below are dead - they are ported anyway
// because the extern is shared. Go's jvmIsFlo arm (a boxed double) has no
// counterpart at all: Python has no boxed double in this value model.
// js_jadd is SHARED - lib/runtime.metajs, via the rtkStr/rtkNum hooks above.

// Go: rt.javaString (jsrt.go:2523) - null and undefined render as "null" here,
// NOT as Python's "None". That is what Go does and the difference is
// unobservable: every value the emitter hands to js_jadd has already been
// rendered by js_pyrxstr / js_pyrepr / js_pyformat.
function pyAJavaStr(v) {
    if (v === null) { return "null" }
    if (v === undefined) { return "null" }
    return pyToStr(v)
}


// Go: js_bigint (jsrt.go:5366). The digits of a decimal integer literal too
// large for a double, as an arbitrary precision integer.
function js_bigint(text) { return pyABigFromStr(pyToStr(text)) }
// ============================================================================
// CHUNK B - strings, printing and formatting.
//
// Ports, function for function:
//   js_pyprint   (jsrt.go:8025)
//   js_pyrepr    (jsrt.go:7974)
//   js_pyformat  (jsrt.go:8022) over rt.pyFormat (jsrt.go:9682),
//                rt.pyFormatBody (jsrt.go:9737) and pyIsAlign (jsrt.go:9680)
//   js_pyfnname  (jsrt.go:7749) plus its reader pyBFuncName
//
// and it owns the float/int RENDERING primitives (rtFixed / rtBaseStr and the
// exact-decimal bignum under them), copied from languages/lib/ruby-rt.metajs
// lines ~508-800 where they were written language-neutrally. Ruby's pyBSci
// ('e' verb), pyBByteCut and pyBLower came across with them and were deleted
// again: Python's format mini-language reaches none of the three.
//
// js_num_str is a FLOOR extern (languages/lib/rt-prims.metajs:192) and is not
// written here.
// ============================================================================


// ===================================================== the side table =======
//
// js_pyfnname (jsrt.go:7749) records the name a `def` bound a closure under, so
// that f.__name__ can answer it (a closure carries no name of its own). The Go
// twin keys rt.pyFuncNames by the closure VALUE (map[interface{}]string), and a
// MetaJS object cannot be keyed by a function, so this is the identity-keyed
// SIDE TABLE shape rbLambdas uses in languages/lib/ruby-rt.metajs: two parallel
// arrays and a linear `===` scan.
var pyBFnObjs = []       // the closures a def bound (identity scan)
var pyBFnNames = []      // the name each one was bound under, same index

// The recorded name of fn, or undefined when no def ever bound it. pyGetAttr
// (jsrt.go:9134) and the other chunks read the table through this.
// The two-parallel-array lookup is SHARED as rtPairGet - lib/runtime.metajs.
// kotlin's k4NameOf was the same eight lines over k4NameFns/k4NameStrs.

// (closure, name) -> closure. A Go map assignment REPLACES an existing entry, so
// a second def that binds the same closure object under another name overwrites
// rather than shadowing; the scan below does the same.
function js_pyfnname(fn, name) {
    var nm = pyToStr(name)
    var i = 0
    while (i < pyBFnObjs.length) {
        if (pyBFnObjs[i] === fn) {
            pyBFnNames[i] = nm
            return fn
        }
        i = i + 1
    }
    pyBFnObjs.push(fn)
    pyBFnNames.push(nm)
    return fn
}


// ===================================================== print / repr =========
//
// js_pyprint (jsrt.go:8025): print(...) with Python's rendering - the argument
// array joined with a single space and written with a trailing newline.
//
// The Go twin runs the joined line through wtf8Clean before Fprintln, which
// replaces the lone surrogates a WTF-8 string can carry with U+FFFD. The floor's
// println does its own encoding of the string it is handed and there is no
// wtf8Clean primitive in layer 2, so that one step is NOT reproduced here; it is
// only observable for a string built out of an unpaired surrogate.
function js_pyprint(args) {
    if (!pyIsArr(args)) { fail("js_pyprint needs an argument array") }
    var out = ""
    var i = 0
    while (i < args.length) {
        if (i > 0) { out = out + " " }
        out = out + pyStr(args[i])
        i = i + 1
    }
    println(out)
    return undefined
}

// js_pyrepr (jsrt.go:7974): repr(x).
function js_pyrepr(v) { return pyRepr(v) }


// ===================================================== float rendering ======
//
// The exact-decimal bignum this section carried is now SHARED, in
// languages/lib/runtime.metajs under "the decimal bignum". This file's copy was
// a verbatim transfer out of ruby-rt.metajs and the old comment here said so:
// "Copied verbatim from languages/lib/ruby-rt.metajs (rbDigitAt / rbBigFromNum /
// rbBigMulSmall / rbBigStr / rbExactDec / rbRoundHalfEven / rbFixed / rbSci /
// rbBaseStr / rbByteCut), renamed to the pyB prefix. The comments are theirs."
// A shape scan confirmed nine of the ten were byte-identical and the tenth
// differed only in the NAME of its digit alphabet, so the merge took no knobs.
//
// What stays here is the one thing Python does its own way: where repr(float)
// switches to exponential form.

// ----- repr(float), which in Python 3 is also str(float) --------------------
//
// abnf/jsrt.go's pyFloStr / pyFloDigits and python-interpreter.abnf's floStr /
// floDigits, byte for byte. Take the SHORTEST round-tripping digit string and
// the decimal point position `decpt` (rtSplit10), then use exponential form iff
// `decpt <= -4 || decpt > 16`. In exponential form there is NO forced ".0"
// (2e16 is "2e+16", unlike ruby, whose splitter this is - that is rtSciText's
// `dot` argument), the exponent is signed and zero padded to two digits
// ("1e-05"), and ONE significant digit is allowed ("5e-324"). Non-finite is
// lowercase, and repr(-float('nan')) is "nan". Probed against CPython 3.14.6.
//
// rtkFloDigits is the hook rtFloStr calls; it renders a > 0.
function rtkFloDigits(a) {
    var p = rtSplit10(a)
    var decpt = p.e + 1
    if (decpt <= 0 - 4 || decpt > 16) { return rtSciText(p.d, p.e, false) }
    return rtFixText(p.d, decpt)
}

function pyBFloStr(x) { return rtFloStr(x, "nan", "inf", "-inf") }

// Negation that keeps IEEE's signed zero, for repr(-0.0). `0 - 0.0` is +0.0, so
// dividing a zero by -1 is the only spelling that produces the negative one.
function pyFloNegate(f) {
    if (f == 0) {
        if (1 / f < 0) { return 0 }
        return 0 / (0 - 1)
    }
    return 0 - f
}

// ----- EXACT decimal expansion of a double ---------------------------------
//
// strconv.FormatFloat prints the EXACT value of the double and rounds HALF TO
// EVEN, which the naive `Math.floor(a * 10^prec + 0.5)` gets wrong twice over:
// it rounds half AWAY from zero (Go's %.0f of 2.5 is "2", not "3") and it loses
// every digit past 2^53 ("%f" of 1e100 has to print all 101 of them). Both were
// measured on the differential probe.
//
// A finite double is m * 2^e with m an integer below 2^53, so its exact decimal
// is a bignum: for e >= 0 it is m doubled e times, and for e < 0 it is m
// multiplied by 5 exactly -e times with the point placed -e digits from the
// right (because 2^-e == 5^-e / 10^-e). The bignum is a little-endian array of
// base-10000 limbs; multiplying by 2 or by 5 keeps every intermediate under
// 50000 + 10000, which a double holds exactly.

// The exact decimal of |x| as {i: <integer digits>, f: <fraction digits>}.
// Round the digit string `digits` (an integer written out) to `keep` digits,
// half to EVEN, and answer the kept digits - one longer when the rounding
// carried all the way (999 -> 1000), which the caller detects by the length.
// strconv.FormatFloat(v, 'f', prec, 64), exactly: the true decimal of the double,
// cut to prec fraction digits with half-to-even rounding.
// ----- "fmt" % args, CPython's printf-style formatting -----
//
// UNIMPLEMENTED in both halves until now: js_pybin's "%" on a string fell into
// pyAFloorMod and answered NaN. The whole reasoning - what is supported, what
// fails loudly, and the ARGUMENT TUPLE rule an array has to be read under while a
// tuple is still a list in this value model - is at rt.pyPct in abnf/jsrt.go.
// pyPct in languages/python-interpreter.abnf is this same body.
//
// The float verbs are where the three halves differ in SPELLING and not in
// answer: Go says strconv.FormatFloat, and this half (like the interpreter's)
// builds the same text out of rtFixed and floPrec - host id 70 of
// languages/lib/runtime.c, the one lua's formatter already leans on.
function pyBPctCount(f) {
    var n = 0
    var i = 0
    while (i < f.length) {
        if (f.charAt(i) == "%") {
            if (i + 1 < f.length && f.charAt(i + 1) == "%") { i = i + 2 ; continue }
            n = n + 1
        }
        i = i + 1
    }
    return n
}

// A conversion operand as a double, unwrapping the float box and a big.
function pyBPctNum(v) {
    if (pyIsFlo(v)) { return v["__flo"] }
    if (pyIsBig(v)) { return parseFloat(pyABigStr(v)) }
    return pyNum(v)
}

// %d: the integer part, and an arbitrary precision int stays exact.
function pyBPctDigits(v) {
    if (pyIsBig(v)) { return pyABigStr(v) }
    return "" + Math.trunc(pyBPctNum(v))
}

// The base-N digits of an integral value: exact for every magnitude a double holds
// exactly, and the SAME loop in all three halves (pyBaseStr in
// languages/python-interpreter.abnf, pyPctRadix in abnf/jsrt.go) - deliberately
// not rtBaseStr, whose int64 SATURATION only the {:x} format spec wants.
function pyBPctRadix(v, base, upper) {
    var n = Math.trunc(pyBPctNum(v))
    if (n !== n) { n = 0 }
    if (n == 0) { return "0" }
    var neg = n < 0
    if (neg) { n = 0 - n }
    var out = ""
    while (n > 0) {
        var q = Math.floor(n / base)
        out = "0123456789abcdefghijklmnopqrstuvwxyz".charAt(n - q * base) + out
        n = q
    }
    if (upper) { out = out.toUpperCase() }
    if (neg) { return "-" + out }
    return out
}

// %g strips the trailing zeros of the mantissa in BOTH of its shapes.
function pyBPctStrip(t) {
    var at = t.indexOf("e")
    if (at < 0) { at = t.indexOf("E") }
    if (at < 0) { return t }
    var mant = t.slice(0, at)
    var tail = t.slice(at)
    if (mant.indexOf(".") < 0) { return t }
    while (mant.charAt(mant.length - 1) == "0") { mant = mant.slice(0, mant.length - 1) }
    if (mant.charAt(mant.length - 1) == ".") { mant = mant.slice(0, mant.length - 1) }
    return mant + tail
}

// |a| rounded to nd SIGNIFICANT digits, half to even, as {d, e}: exactly nd digit
// characters and the decimal exponent of the first of them.
//
// The obvious source for this is floPrec, and it is the WRONG one here: floPrec's
// contract is only "at least nd digits" - the floor's implementation (host id 70,
// g_mindig + shortest_digits) answers the SHORTEST round-tripping form when nd is
// smaller than that, so %e of 1234.5678 came out 1.234567e+03 from the native
// binary (a truncation of the 8-digit shortest form) against 1.234568e+03 from Go
// and from the interpreter. Every existing floPrec caller asks for an nd at least
// as large as the shortest form, where the two contracts coincide; %e and %g do
// not. The exact decimal answers it outright and is already here.
function pyBPctSig(a, nd) {
    if (a == 0) {
        var z = ""
        while (z.length < nd) { z = z + "0" }
        return {d: z, e: 0}
    }
    var dec = rtExactDec(a)
    var joined = dec["i"] + dec["f"]
    var lead = 0
    while (lead < joined.length && joined.charAt(lead) == "0") { lead = lead + 1 }
    var ex = dec["i"].length - 1 - lead
    var kept = rtRoundHalfEven(joined.slice(lead), nd)
    if (kept.length > nd) {
        ex = ex + 1
        kept = kept.slice(0, nd)
    }
    while (kept.length < nd) { kept = kept + "0" }
    return {d: kept, e: ex}
}

// |n| to p+1 significant digits in C's %e shape: one digit, a point, p digits, and
// an exponent that is signed and at least two digits.
function pyBPctExpText(n, p, upper) {
    var neg = n < 0
    if (n == 0 && 1 / n < 0) { neg = true }
    var a = neg ? 0 - n : n
    var sig = pyBPctSig(a, p + 1)
    var digs = sig["d"]
    var ex = sig["e"]
    var mant = digs.charAt(0)
    if (p > 0) { mant = mant + "." + digs.slice(1, p + 1) }
    var es = "" + (ex < 0 ? 0 - ex : ex)
    if (es.length < 2) { es = "0" + es }
    var ech = upper ? "E" : "e"
    var sgn = ex < 0 ? "-" : "+"
    var out = mant + ech + sgn + es
    if (neg) { return "-" + out }
    return out
}

function pyBPctExp(n, typ, prec) {
    var upper = (typ == "E" || typ == "G")
    var p = (prec < 0) ? 6 : prec
    if (n !== n) { if (upper) { return "NAN" } ; return "nan" }
    if (n - n !== 0) {
        var inf = upper ? "INF" : "inf"
        if (n < 0) { return "-" + inf }
        return inf
    }
    if (typ == "g" || typ == "G") {
        if (p == 0) { p = 1 }
        var ge = pyBPctSig(n < 0 ? 0 - n : n, p)["e"]
        if (ge < 0 - 4 || ge >= p) { return pyBPctStrip(pyBPctExpText(n, p - 1, upper)) }
        var fx = rtFixed(n, p - 1 - ge)
        if (fx.indexOf(".") >= 0) {
            while (fx.charAt(fx.length - 1) == "0") { fx = fx.slice(0, fx.length - 1) }
            if (fx.charAt(fx.length - 1) == ".") { fx = fx.slice(0, fx.length - 1) }
        }
        return fx
    }
    return pyBPctExpText(n, p, upper)
}

function pyBPctOne(v, typ, left, zero, plus, space, width, prec) {
    var body = ""
    var numeric = false
    if (typ == "s" || typ == "r" || typ == "a") {
        if (typ == "s") { body = pyStr(v) } else { body = pyRepr(v) }
        if (prec >= 0 && pyStrLen(body) > prec) { body = pyStrSlice(body, prec) }
    } else if (typ == "c") {
        if (typeof v == "string") { body = v } else { body = pyBCodePoint(Math.trunc(pyBPctNum(v))) }
    } else if (typ == "d" || typ == "i" || typ == "u") {
        numeric = true
        body = pyBPctDigits(v)
    } else if (typ == "x") { numeric = true ; body = pyBPctRadix(v, 16, false) }
    else if (typ == "X") { numeric = true ; body = pyBPctRadix(v, 16, true) }
    else if (typ == "o") { numeric = true ; body = pyBPctRadix(v, 8, false) }
    else if (typ == "b") { numeric = true ; body = pyBPctRadix(v, 2, false) }
    else if (typ == "f" || typ == "F") {
        numeric = true
        body = rtFixed(pyBPctNum(v), prec < 0 ? 6 : prec)
    } else if (typ == "e" || typ == "E" || typ == "g" || typ == "G") {
        numeric = true
        body = pyBPctExp(pyBPctNum(v), typ, prec)
    } else {
        pyFail("unsupported format character '" + typ + "'")
    }
    if (numeric && body.charAt(0) != "-") {
        if (plus) { body = "+" + body }
        else if (space) { body = " " + body }
    }
    var pad = width - pyStrLen(body)
    if (pad <= 0) { return body }
    if (left) { return body + pyBRepeat(" ", pad) }
    if (zero && numeric) {
        var sgn = body.charAt(0)
        if (sgn == "-" || sgn == "+" || sgn == " ") { return sgn + pyBRepeat("0", pad) + body.slice(1) }
        return pyBRepeat("0", pad) + body
    }
    return pyBRepeat(" ", pad) + body
}

function pyBRepeat(s, n) {
    var out = ""
    var i = 0
    while (i < n) { out = out + s ; i = i + 1 }
    return out
}

// The first `n` CODE POINTS of s - what a %.Ns precision truncates to.
function pyStrSlice(s, n) {
    var out = ""
    var k = 0
    var c = 0
    while (k < s.length && c < n) {
        var ch = s.charCodeAt(k)
        var w = 1
        if (ch >= 55296 && ch <= 56319 && k + 1 < s.length) { w = 2 }
        out = out + s.substring(k, k + w)
        k = k + w
        c = c + 1
    }
    return out
}

// A code point above the BMP becomes its UTF-16 surrogate pair.
function pyBCodePoint(n) {
    if (n <= 65535) { return String.fromCharCode(n) }
    var v = n - 65536
    return String.fromCharCode(55296 + Math.floor(v / 1024)) + String.fromCharCode(56320 + (v - Math.floor(v / 1024) * 1024))
}

function pyBPct(f, arg) {
    var nconv = pyBPctCount(f)
    var args = []
    var dict = null
    if (pyIsArr(arg) && arg.length == nconv) { args = arg }
    else if (pyIsDict(arg) && pySetElemsOf(arg) === null) { dict = arg ; args = [arg] }
    else { args = [arg] }
    var out = ""
    var ai = 0
    var mapped = false
    var i = 0
    while (i < f.length) {
        var c = f.charAt(i)
        if (c != "%") { out = out + c ; i = i + 1 ; continue }
        i = i + 1
        if (i >= f.length) { pyFail("incomplete format") }
        if (f.charAt(i) == "%") { out = out + "%" ; i = i + 1 ; continue }
        var key = ""
        var hasKey = false
        if (f.charAt(i) == "(") {
            i = i + 1
            while (i < f.length && f.charAt(i) != ")") { key = key + f.charAt(i) ; i = i + 1 }
            hasKey = true
            mapped = true
            i = i + 1
        }
        var left = false
        var zero = false
        var plus = false
        var space = false
        var scanning = true
        while (scanning && i < f.length) {
            var fl = f.charAt(i)
            if (fl == "-") { left = true ; i = i + 1 }
            else if (fl == "0") { zero = true ; i = i + 1 }
            else if (fl == "+") { plus = true ; i = i + 1 }
