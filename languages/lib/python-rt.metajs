    }
    if (op == "==") { return {v: lr == rr && li == ri} }
    if (op == "!=") { return {v: lr != rr || li != ri} }
    return null
}

// ============================================================================
// Go: pyBinDunder / pyBinReflected / rt.pyDunderBin
// ============================================================================
// The two maps are written as functions because there is no for..in and an
// object used as a table would need the "$" interning the dialect demands. An
// operator with no dunder answers "", which no class can define.
function pyABinDunder(op) {
