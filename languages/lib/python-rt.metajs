function js_pyiterfn(v) {
    if (pyIsGen(v) || pyIsIter(v)) { return v }
    var it = pyAUserIter(v)
    if (it !== undefined) { return it }
    if (pyIsDict(v) || pySetElemsOf(v) !== null || pyIsDView(v)) { return pyAWatchIter(v) }
    return pyMkIter(pyIterKind(v), pyCCopyArr(pyElemsOf(v)))
}

// The `yield from` RESUME GUARD, emitted once per delegated turn by
// python-to-llvm-ir.abnf's makeYield just before it steps the delegate.
//
// PEP 380 spells the resume out: `if _s is None: _y = _i.__next__()` else
// `_y = _i.send(_s)`. A CURSOR has no send, so sending a non-None value into a
// `yield from` over a list, a string, a dict or any other materialized delegate
// raises AttributeError INSIDE the generator - which ends it, so the next
// send() answers StopIteration. (Forwarding the value to the cursor's next()
// would silently ignore it.)
//
// Delegating to a real GENERATOR is untouched - that is what makes send() reach
// the delegate at all - and so is the first turn, which sends undefined.
function js_pyyfsend(d, sent) {
    if (sent === undefined || sent === null) { return undefined }
    if (!pyIsIter(d)) { return undefined }
    throw pyExcInstance("AttributeError",
                        "'" + pyToStr(d["__pyit"]) + "' object has no attribute 'send'")
}

// g.close() is throw(GeneratorExit()) through the floor's tag-15 `throw` member,
// so the body's `except GeneratorExit` sees it. GeneratorExit propagating out is
// the close completing; a body that returns answers its return value; one that
// yields again raises RuntimeError and stays suspended. Twin of pyGenClose in
// abnf/jsrt.go.
function pyGenClose(g) {
    var ge = {__class: pyExcClass("GeneratorExit"), args: pyTup([])}
    var cst = anytype
    try { cst = g["throw"].apply(g, [ge]) }
    catch (ce) {
        if (pyDIsInstance(ce, pyExcClass("GeneratorExit"))) { return undefined }
        throw ce
    }
    if (cst["done"] === true) { return cst["value"] }
    pyRaiseExc("RuntimeError", "generator ignored GeneratorExit")
}

// The `yield from` CLOSE GUARD, emitted where a thrown value is about to be
// forwarded to the delegate: a GeneratorExit (g.close()) is not forwarded - a
// generator delegate is closed and the GeneratorExit raised in the outer
// generator, PEP 380's rule. Twin of js_pyyfclose in abnf/jsrt.go.
function js_pyyfclose(d, v) {
    if (pyIsIter(d) || !pyIsGen(d)) { return undefined }
    if (!pyDIsInstance(v, pyExcClass("GeneratorExit"))) { return undefined }
    pyGenClose(d)
