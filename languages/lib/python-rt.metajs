    if (typeof y == "object" && pyIsDView(y)) { return pyDViewEq(y, x) }
    if (pyIsDict(x)) {
        if (!pyIsDict(y)) { return false }
        var xk = x["keys"]
        var yk = y["keys"]
        if (xk.length != yk.length) { return false }
