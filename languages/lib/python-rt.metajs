// ----- type(), isinstance() and the builtin class objects -------------------

// type(v): the class object of an instance, else a synthetic class object
// naming the builtin type (so type(x).__name__ answers for everything).
function js_pytype(v) {
    var cls = pyInstClassOf(v)
    if (cls !== null) { return cls }
    return pyBuiltinClass(pyTypeName(v))
}

// isinstance(v, C) / isinstance(v, (A, B)): a walk of the instance's MRO.
// Go: rt.pyIsInstance, jsrt.go:9280.
function pyDIsInstance(v, target) {
    var i = 0
    if (pyIsArr(target)) {
        while (i < target.length) {
            if (pyDIsInstance(v, target[i])) { return true }
            i = i + 1
        }
        return false
    }
    var cls = pyInstClassOf(v)
    if (cls === null) {
        // A builtin value against a builtin class object (int, str, ...): one
        // that carries a __name but NO __mro.
        if (pyIsObj(target)) {
            if (target["__name"] !== undefined && target["__mro"] === undefined) {
                return pyBuiltinSub(pyTypeName(v), pyToStr(target["__name"]))
            }
        }
        return false
    }
    // Every class derives from object, so isinstance(C(), object) is True.
    if (pyIsObj(target)) {
        if (target["__mro"] === undefined && pyToStr(target["__name"]) == "object") { return true }
    }
    var mro = pyMRO(cls)
    i = 0
    while (i < mro.length) {
