// ----- js_pydict (jsrt.go:7639) ---------------------------------------------
// dict(x): a fresh dict copying the entries of a dict argument, in its
// insertion order. Anything else - including a list of pairs, which real Python
// accepts - yields the EMPTY dict, which is what the Go twin does.
function js_pydict(src) {
    var out = pyNewDict()
    if (pyIsDict(src)) {
        var keys = out["keys"]
        var vals = out["vals"]
        var sk = src["keys"]
        var sv = src["vals"]
