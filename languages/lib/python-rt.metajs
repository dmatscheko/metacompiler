            ok.push(keys[i])
            ov.push(vals[i])
        }
        i = i + 1
    }
    return out
}


// ----- js_pymatchargs ---------------------------------------------------------
// The POSITIONAL sub-values of a class pattern: (value, class, count) -> the n
// attributes __match_args__ names, or undefined when the class cannot provide
// them. A class WITHOUT __match_args__ accepts exactly one positional pattern
// and hands the value itself over, which is what makes `case str(sv):` capture
// the string.
function js_pymatchargs(v, cls, count) {
    var n = Math.trunc(pyNum(count))
    var out = []
    var hasMa = false
    if (pyIsObj(cls)) { hasMa = pyLookupHas(cls, "__match_args__") }
    if (!hasMa) {
        if (n == 1) {
            out.push(v)
            return out
        }
        return undefined
    }
    var elems = pySeqElems(pyLookupVal(cls, "__match_args__"))
    if (n > elems.length) { return undefined }
    var i = 0
    while (i < n) {
        out.push(pyGetAttr(v, pyToStr(elems[i])))
        i = i + 1
    }
    return out
}


// ----- js_is_type (Go: rt.isTypeName) -----------------------------------------
// js_is_type is SHARED - lib/runtime.metajs, via the rtkIsChar/rtkIsArr hooks.
// The Python grammars do not emit it; it is exported because -rt-lib must
// export every language-neutral symbol of the table.
// ============================================================================
// Classes, attributes, calls and exceptions (the pyD* helpers).
//
// Each extern below names the abnf/jsrt.go function it ports.
// js_pyannot is LOWERED IN THE EMITTER and is deliberately absent, and
// js_supercall is not emitted by languages/python-to-llvm-ir.abnf.
//
// Every helper carries the `pyD` prefix, EXCEPT `pyBindCall`, which the other
// chunks call by that exact name.
//
// ONE DIVERGENCE THAT APPLIES TO THIS WHOLE FILE, stated once here rather than
// at forty sites: the Go twin distinguishes "the property is ABSENT" from "the
// property HOLDS undefined" (`v, ok := o.props[name]`). A -rt-lib module has no
// hasOwn - the floor seeds no such builtin - so "present" is spelled
// `!== undefined` throughout. The only value that behaves differently is an
// attribute explicitly holding undefined, and undefined is Python's None in
// this value model, which every caller here treats the same way as an absent
// attribute anyway.
// ============================================================================

// ----- Python truthiness (Go: js_pytruthy) ------------------------------------

// A RAW RETURN. languages/python-to-llvm-ir.abnf sets
// `core.truthyExt = "js_pytruthy"` and compile-core's truthy()
// emits `icmp ne <call>, 0` straight on that extern's result, so it must answer
// a RAW INTEGER rather than a handle. The `__raw` suffix is what tells
// languages/metajs-to-llvm-ir.abnf's export scanner to export the symbol as
// `js_pytruthy` and put this function's result through the floor's own
// js_truthy first. Without it a MetaJS `false` would come back as the HANDLE of
// false, which is 2, and 2 != 0, so EVERY condition in the program would be
// taken - silently.
function js_pytruthy__raw(v) {
    var els = pySetElemsOf(v)
    if (els !== null) { return els.length > 0 }
    if (pyIsArr(v)) { return v.length > 0 }
    if (pyIsDict(v)) { return v["keys"].length > 0 }
    return pyDTruthy(v)
}

// Go's rt.truthy for the Python value model. The sized-integer / Java-double
// arms of the Go switch are unreachable from Python, and the *jsBigInt arm
// is `t.v.Sign() != 0` - which here has to be read off the {__pybig} shape,
// because a plain object would otherwise take the `default: true` arm and
// `if 0n:` would be taken. The limbs are scanned directly.
function pyDTruthy(v) {
    if (rtIsNil(v)) { return false }
    if (pyIsBool(v)) { return v }
    // Go's `t != 0 && t == t` - the second half is the NaN test.
    if (pyIsNum(v)) { return v != 0 && v == v }
    // The boxed float: 0.0 is falsy, and every other object is TRUE below.
    // Go's arm is `t.f != 0` with no NaN test, so a NaN float is truthy.
    if (pyIsFlo(v)) { return v["__flo"] != 0 }
    // Go's `len(t) > 0` is a BYTE length, and byteLen(s) == 0 exactly when the
    // code-unit length is 0, so the two agree on emptiness.
    if (pyIsStr(v)) { return v.length > 0 }
    if (pyIsBig(v)) {
        var limbs = v["limbs"]
        var i = 0
        while (i < limbs.length) {
            if (limbs[i] != 0) { return true }
            i = i + 1
        }
        return false
    }
    // Go's default arm. A complex - even complex(0,0) - is an object and is
    // therefore TRUE here, exactly as in the Go twin (Python itself would say
    // false; the twin is the specification).
    return true
}

// ----------------------------------------------------------------- super ---
//
// js_pysuper(cls, self) is what the READ of the name `super` lowers to - see
// makeVarRef in languages/python-to-llvm-ir.abnf for why the magic is in the
// emitter and what the two operands are. The value it hands back is both the
// callable (super() with no arguments answers itself, super(C, o) builds a new
// one) and the proxy an attribute read or a method call goes through.
//
// The lookup is a scan of the INSTANCE's MRO starting one past the class the
// call was written in, which is what makes a diamond resolve as CPython
// resolves it. The one-argument (unbound) form is declined - it is a descriptor
// and there is no protocol for one here. Go: js_pysuper / rt.pySuper* in
// abnf/jsrt.go; interpreter: pySuper* in languages/python-interpreter.abnf.
function js_pysuper(cls, self) {
    var s = {}
    s["__pysup"] = true
    if (cls !== undefined && cls !== null) { s["__scls"] = cls }
    if (self !== undefined) { s["__sobj"] = self }
    return s
}
function pyIsSuper(v) { return rtTag(v, "__pysup") }
// CPython's own two messages for a zero-argument super() with nothing to bind.
function pySuperCheck(s) {
    if (s["__scls"] === undefined) { pyRaiseExc("RuntimeError", "super(): __class__ cell not found") }
    if (s["__sobj"] === undefined) { pyRaiseExc("RuntimeError", "super(): no arguments") }
}
function pySuperCall(s, args) {
    if (args.length == 0) {
        pySuperCheck(s)
        return s
    }
    if (args.length == 2) { return js_pysuper(args[0], args[1]) }
    pyRaiseExc("TypeError", "super(): one-argument (unbound) form is not supported")
    return null
}
function pySuperMRO(s) {
    var o = s["__sobj"]
    if (pyIsClass(o)) { return pyMRO(o) }
    var c = pyInstClassOf(o)
    if (c !== null) { return pyMRO(c) }
    return []
}
// The member, or undefined. A class deriving from a builtin exception needs no
// special case: languages/python-to-llvm-ir.abnf builds the whole builtin
// exception hierarchy out of real js_pyclass_new objects with a real __init__ on
// Exception, so it is already on the MRO this scans.
function pySuperFind(s, name) {
    var mro = pySuperMRO(s)
    var start = s["__scls"]
    var at = -1
    var i = 0
    while (i < mro.length) {
        if (mro[i] === start && at < 0) { at = i }
        i = i + 1
    }
    if (at < 0) {
        pyRaiseExc("TypeError", "super(type, obj): obj must be an instance or subtype of type")
    }
    i = at + 1
    while (i < mro.length) {
        if (mro[i][name] !== undefined) { return mro[i][name] }
        i = i + 1
    }
    return undefined
}
function pySuperAttr(s, name) {
    pySuperCheck(s)
    var m = pySuperFind(s, name)
    if (m === undefined) {
        pyRaiseExc("AttributeError", "'super' object has no attribute '" + name + "'")
    }
    // A staticmethod / classmethod found through super(), same rule as the call
    // path in pySuperMCall.
    if (pyDIsStatic(m) || pyDIsClsM(m)) { return pyDDescGet(m, pyDSuperOwner(s), name) }
    if (pyIsCallable(m)) { return pyDBindMethod(s["__sobj"], m, name) }
    return m
}
// A method read off an instance (or off a super() proxy) is BOUND to it, which
// is what makes `f = a.m; f()` the call CPython makes. Go: rt.pyBindMethod.
function pyDBindMethod(self, m, name) {
    var b = function() {
        var args = []
        var i = 0
        while (i < arguments.length) {
            args.push(arguments[i])
            i = i + 1
        }
        return pyCall(m, pyBindCall(m, rtPrepend(self, args), undefined))
    }
    return pyBMSet(b, name, self, m)
}

// ----- what a BOUND METHOD knows about itself ---------------------------------
//
// getattr([1,2], "count").__name__ is 'count' in CPython. Neither of the two
// name tables above can answer it: pyBFnObjs holds what a `def` bound and
// pyBBFnObjs the builtins, and both are keyed by the closure VALUE, while a
// bound method is a FRESH closure minted at the attribute read.
//
// ONE flat array with a stride of FIVE - closure, method name, receiver,
// underlying function (null for a builtin method), kind - and not parallel
// arrays, because every module-level global in this file costs (see the note
// on pyBBFnObjs above). It starts EMPTY, so it adds no live bytes to a program
// that never reads a method off a value; it then grows with the number of bound
// methods created, exactly as pyBFnObjs grows with the number of times a `def`
// runs. The scan is walked only by introspection, never by a call.
//
// Keep in step with pyBoundInfo / pyBoundOf in abnf/jsrt.go and the pyBM*
// family in languages/python-interpreter.abnf.
// The KIND distinguishes three CPython callables that share this record and
// print, name and introspect differently:
//
//   ""  a bound method
//   "d" an unbound METHOD DESCRIPTOR read off a builtin type object - list.count,
//       str.upper - printed <method 'count' of 'list' objects>, with no __self__
//       at all and the receiver as its FIRST call argument. `self` holds the TYPE
//       OBJECT for it, not a receiver.
//   "m" a MODULE-level builtin function read off a module object - math.sqrt -
//       printed <built-in function sqrt>, whose __self__ IS the module.
var pyBMTab = []

function pyBMSet(f, name, self, fn) { return pyBMSetK(f, name, self, fn, "") }

function pyBMSetK(f, name, self, fn, kind) {
    pyBMTab.push(f)
    pyBMTab.push(pyToStr(name))
    pyBMTab.push(self)
    pyBMTab.push(fn)
    pyBMTab.push(kind)
    return f
}

// The index of f's record, or -1.
function pyBMFind(f) {
    var i = pyBMTab.length - 5
    while (i >= 0) {
        if (pyBMTab[i] === f) { return i }
        i = i - 5
    }
    return 0 - 1
}

// The type name a bound method's __qualname__ and repr are prefixed with: an
// INSTANCE names its class, everything else its builtin type.
function pyBMOwner(self) {
    var c = pyInstClassOf(self)
    if (c !== null && c !== undefined) { return pyToStr(c["__name"]) }
    return pyTypeName(self)
}

// How a bound method prints. CPython appends the receiver's ADDRESS to both
// forms; the address is its own and cannot be matched, so it is left off here
// exactly as it is for <function f> and <map object>.
function pyBMRender(i) {
    var nm = pyToStr(pyBMTab[i + 1])
    var self = pyBMTab[i + 2]
    var kind = pyBMTab[i + 4]
    // An UNBOUND descriptor names the type it belongs to, in single quotes, and
    // says "objects" plural - CPython's own spelling for list.count.
    if (kind == "d") { return "<method '" + nm + "' of '" + pyToStr(self["__name"]) + "' objects>" }
    // A module-level builtin prints exactly like any other builtin function; its
    // module is reachable as __self__ but is not part of the render.
    if (kind == "m") { return "<built-in function " + nm + ">" }
    if (pyBMTab[i + 3] === null) {
        return "<built-in method " + nm + " of " + pyBMOwner(self) + " object>"
    }
    return "<bound method " + pyBMOwner(self) + "." + nm + " of " + pyRepr(self) + ">"
}
// The class a classmethod reached through super() binds to: the ORIGINAL cls -
// `super().who()` inside C.who() must still pass C - which __sobj already is
// when the frame's first argument was a class.
function pyDSuperOwner(s) {
    var o = s["__sobj"]
    if (pyIsClass(o)) { return o }
    return js_pytype(o)
}

function pySuperMCall(s, name, args, kw) {
    pySuperCheck(s)
    var m = pySuperFind(s, name)
    if (m === undefined) {
        pyRaiseExc("AttributeError", "'super' object has no attribute '" + name + "'")
    }
    if (pyDIsStatic(m) || pyDIsClsM(m)) {
        var sd = pyDDescGet(m, pyDSuperOwner(s), name)
        return pyCall(sd, pyBindCall(sd, args, kw))
    }
    if (!pyIsCallable(m)) { return pyDCallPyValue(m, args, kw) }
    var self = rtPrepend(s["__sobj"], args)
    return pyCall(m, pyBindCall(m, self, kw))
}

// ----- class objects (Go: js_pyclass_new / pyLinearize / js_pyclass_fill) ---

// pyLinearize is the C3 merge of the bases' MROs with the base
// list itself - the order Python computes, minus the class itself (the caller
// prepends it). A hierarchy C3 cannot resolve consistently falls back to
// first-seen order rather than aborting the program. Go consumes each sequence
// by re-slicing it (`seqs[i] = s[1:]`); there is no splice here, so a parallel
// array of cursors does the same job.
function pyDLinearize(bases) {
    var out = []
    if (bases.length == 0) { return out }
    var seqs = []
    var cur = []
    var i = 0
    var j = 0
    var k = 0
    var head = anytype
    var pick = anytype
    var inTail = false
    var empty = false
    while (i < bases.length) {
        seqs.push(pyMRO(bases[i]))
        i = i + 1
    }
    cur = []
    i = 0
    while (i < bases.length) {
        cur.push(bases[i])
        i = i + 1
    }
    seqs.push(cur)
    var pos = []
    i = 0
    while (i < seqs.length) {
        pos.push(0)
        i = i + 1
    }
    while (true) {
        empty = true
        i = 0
        while (i < seqs.length) {
            if (pos[i] < seqs[i].length) { empty = false }
            i = i + 1
        }
        if (empty) { return out }
        pick = null
        i = 0
        while (i < seqs.length) {
            if (pos[i] < seqs[i].length) {
                head = seqs[i][pos[i]]
                inTail = false
                j = 0
                while (j < seqs.length) {
                    k = pos[j] + 1
                    while (k < seqs[j].length) {
                        if (seqs[j][k] === head) { inTail = true }
                        k = k + 1
                    }
                    j = j + 1
                }
                if (!inTail) {
                    pick = head
                    break
                }
            }
            i = i + 1
        }
        if (pick === null) { // Inconsistent hierarchy: take the first head there is.
            i = 0
            while (i < seqs.length) {
                if (pos[i] < seqs[i].length) {
                    pick = seqs[i][pos[i]]
                    break
                }
                i = i + 1
            }
        }
        out.push(pick)
        i = 0
        while (i < seqs.length) {
            if (pos[i] < seqs[i].length) {
                if (seqs[i][pos[i]] === pick) { pos[i] = pos[i] + 1 }
            }
            i = i + 1
        }
    }
    return out
}

// A class object: its own name, its first base as "__super" and the FULL
// linearized MRO as "__mro" (itself first). Multiple inheritance is resolved
// ONCE, here, so every later lookup is a flat walk of "__mro".
function js_pyclass_new(name, bases) {
    var n = pyToStr(name)
    var cls = {}
    cls["__name"] = n
    var baseObjs = []
    if (pyIsArr(bases)) {
        var i = 0
        while (i < bases.length) {
            // Go tests `b.(*jsObject)` - any object, not necessarily a class.
            if (!pyIsObj(bases[i])) { fail("class " + n + ": base is not a class") }
            baseObjs.push(bases[i])
            i = i + 1
        }
    }
    if (baseObjs.length > 0) { cls["__super"] = baseObjs[0] }
    // The declared bases, for __bases__. Kept beside __mro because the
    // linearization cannot be un-merged back into the base list.
    cls["__basesl"] = baseObjs
    var mro = [cls]
    var lin = pyDLinearize(baseObjs)
    var j = 0
    while (j < lin.length) {
        mro.push(lin[j])
        j = j + 1
    }
    cls["__mro"] = mro
    return cls
}

// The class body is a suite: every name it bound (methods, class attributes,
// __slots__) becomes a class member.
//
// DELIBERATE SHAPE CHANGE FROM THE GO TWIN: in Go this takes a SCOPE HANDLE and
// enumerates the scope's names (`sc := rt.scopeOf(a[1])`). A scope is the
// floor's private storage and layer 2 cannot open one, so
// languages/python-to-llvm-ir.abnf hands us a DICT of the class body's bindings
// instead - the ordinary {__dict:true, keys, vals} shape - and this copies
// every key/value pair of that dict onto the class object. The enumeration
// order is the dict's insertion order, which is the scope's binding order, so
// the observable result is the same.
function js_pyclass_fill(cls, bodyDict) {
    if (!pyIsObj(cls)) { fail("js_pyclass_fill: not a class object") }
    if (!pyIsDict(bodyDict)) { fail("js_pyclass_fill: class body is not a dict") }
    var keys = bodyDict["keys"]
    var vals = bodyDict["vals"]
    var i = 0
    while (i < keys.length) {
        cls[pyToStr(keys[i])] = vals[i]
        i = i + 1
    }
    return undefined
}

// ----- attributes (Go: js_pygetattr / js_pysetattr) -------------------------

// obj.name: an instance checks its own attributes, then the MRO of its class
// (running a __get__ descriptor found there); a class checks its own MRO.
// Anything else takes the ordinary member read. The whole lookup order is
// rt.pyGetAttr, which the prelude provides.
function js_pygetattr(obj, name) { return pyGetAttr(obj, pyToStr(name)) }

// obj.name = v: a __set__ descriptor on the class wins; __slots__ (when the
// class declares it) rejects an unknown name by raising, like Python.
// rt.pySetAttr is in the prelude.
function js_pysetattr(obj, name, v) {
    pySetAttr(obj, pyToStr(name), v)
    return undefined
}

// del obj.name (Go: js_pydel_attr). python-to-llvm-ir.abnf's makeDel emits it.
// `delKey` is the floor's js_del under its host-builtin name (runtime.c host id
// 63); it drops the key AND its insertion-order entry, which is what keeps
// keysOf, and therefore vars()/dir(), right after a delete.
function js_pydel_attr(obj, name) {
    if (typeof obj == "function") {
        var dn = pyToStr(name)
        var fd = pyFnAttrs(pyFnOwner(obj), false)
        var fi = 0 - 1
        if (fd !== undefined) { fi = pyDictFind(fd["keys"], dn) }
        if (fi < 0) { pyRaiseExc("AttributeError", "'" + pyTypeName(obj) + "' object has no attribute '" + dn + "'") }
        pyCRemoveAt(fd["keys"], fi)
        pyCRemoveAt(fd["vals"], fi)
        return undefined
    }
    if (pyInstClassOf(obj) === null) { pyNoDictAttr(obj, pyToStr(name)) }
    if (obj === null || obj === undefined || typeof obj != "object") {
        fail("attribute deletion on a " + pyTypeName(obj))
    }
    delKey(obj, pyToStr(name))
    return undefined
}

// ----- the signature registry (Go: pySig / js_pysig) ----------------------------

// Go keys rt.pySigs by the callee VALUE (a Go map over interface{}). A closure
// here is a floor cell: nothing can be stored on it and there is no Map in the
// frozen subset, so the registry is an identity-keyed side table - four
// parallel arrays and a `===` scan. It is O(n) in the defs a program has ever
// registered, which is a constant per module.
var pyDSigFn = []
var pyDSigNames = []
var pyDSigKwOnly = []
var pyDSigExt = []

function pyDSigIndex(callee) {
    var i = 0
    while (i < pyDSigFn.length) {
        if (pyDSigFn[i] === callee) { return i }
        i = i + 1
    }
    return -1
}

// Register a def's parameter shape, so a keyword call can be bound to it.
// The LAST nkwonly names are keyword-only; `ext` selects prologue layout B
// ([p0..pn-1, *args list, **kwargs dict]) over layout A (a flat positional
// array). Go overwrites a duplicate map entry; so does this.
function js_pysig(clo, names, nkwonly, ext) {
    var ns = []
    if (pyIsArr(names)) {
        var i = 0
        while (i < names.length) {
            ns.push(pyToStr(names[i]))
            i = i + 1
        }
    }
    var at = pyDSigIndex(clo)
    if (at < 0) {
        pyDSigFn.push(clo)
        pyDSigNames.push(ns)
        pyDSigKwOnly.push(pyNum(nkwonly))
        pyDSigExt.push(pyDTruthy(ext))
    } else {
        pyDSigNames[at] = ns
        pyDSigKwOnly[at] = pyNum(nkwonly)
        pyDSigExt[at] = pyDTruthy(ext)
    }
    return clo
}

// pyBindCall turns (positional, keyword dict) into the callee's argument array.
// Go: rt.pyBindCall. NAMED WITHOUT THE CHUNK PREFIX because the
// other chunks call it by this exact name.
function pyBindCall(callee, pos, kw) {
    var hasKw = pyIsDict(kw)
    var kwKeys = anytype
    var kwVals = anytype
    kwKeys = null
    kwVals = null
    if (hasKw) {
        kwKeys = kw["keys"]
        kwVals = kw["vals"]
        if (kwKeys.length == 0) { hasKw = false }
    }
    var i = 0
    var j = 0
    var out = []
    var si = pyDSigIndex(callee)
    if (si < 0) {
        // A builtin (no declared signature) takes the keyword dict as one extra
        // trailing argument - which is exactly what dict(a=1) / dict(**m) want.
        if (hasKw) {
            i = 0
            while (i < pos.length) {
                out.push(pos[i])
                i = i + 1
            }
            out.push(kw)
            return out
        }
        return pos
    }
    var names = pyDSigNames[si]
    var nkwonly = pyDSigKwOnly[si]
    var ext = pyDSigExt[si]
    if (!ext && !hasKw) { return pos }
    var n = names.length
    var npos = n - nkwonly
    i = 0
    while (i < n) {
        out.push(undefined)
        i = i + 1
    }
    i = 0
    while (i < npos && i < pos.length) {
        out[i] = pos[i]
        i = i + 1
    }
    // Go's `used` is a map[string]bool of parameter names that were filled from
    // the keyword dict; here it is a list of those names, scanned linearly.
    var used = []
    // Go's fromKw(i) closure, inlined at both of its call sites: the LAST
    // matching keyword wins, because Go keeps assigning as it scans.
    i = 0
    while (i < npos) {
        if (i >= pos.length) {
            if (hasKw) {
                j = 0
                while (j < kwKeys.length) {
                    if (pyToStr(kwKeys[j]) == names[i]) {
                        out[i] = kwVals[j]
                        used.push(names[i])
                    }
                    j = j + 1
                }
            }
        }
        i = i + 1
    }
    i = npos
    while (i < n) {
        if (hasKw) {
            j = 0
            while (j < kwKeys.length) {
                if (pyToStr(kwKeys[j]) == names[i]) {
                    out[i] = kwVals[j]
                    used.push(names[i])
                }
                j = j + 1
            }
        }
        i = i + 1
    }
    var extra = []
    i = npos
    while (i < pos.length) {
        extra.push(pos[i])
        i = i + 1
    }
    if (!ext) {
        i = 0
        while (i < extra.length) {
            out.push(extra[i])
            i = i + 1
        }
        return out
    }
    var left = pyNewDict()
    if (hasKw) {
        j = 0
        while (j < kwKeys.length) {
            if (!pyDUsed(used, pyToStr(kwKeys[j]))) {
                // Go calls dictAppend directly - an unconditional append. The
                // keys of a keyword dict are distinct by construction, so
                // pyDictSet (which overwrites an existing key) is the same map.
                pyDictSet(left, kwKeys[j], kwVals[j])
            }
            j = j + 1
        }
    }
    out.push(extra)
    out.push(left)
    return out
}

function pyDUsed(used, name) {
    var i = 0
    while (i < used.length) {
        if (used[i] == name) { return true }
        i = i + 1
    }
    return false
}

// ----- calling (Go: js_pycall / rt.callPyValue / rt.pyMethodCall) -----------

// f(args, kwargs): calling a CLASS instantiates it (allocate, then __init__
// with self prepended); calling an instance runs its __call__. The keyword dict
// is mapped onto the callee's parameters by pyBindCall.
function js_pycall(callee, pos, kw) {
    if (!pyIsArr(pos)) { fail("js_pycall args must be an array") }
    if (pyIsSuper(callee)) { return pySuperCall(callee, pos) }
    // A BUILTIN TYPE OBJECT is callable: `int` is the class, and calling it
    // converts. languages/python-to-llvm-ir.abnf binds int/str/float/bool/list/
    // dict/set/tuple to js_pybuiltincls's stable class object with the conversion
    // closure hung on it as __conv, so `type(1) == int` is True (it is the same
    // object) and int("42") still runs the same IR function it always did.
    if (pyIsObj(callee)) {
        var cv = callee["__conv"]
        if (pyIsCallable(cv)) { return pyCall(cv, pos) }
    }
    var cls = pyClassOf(callee)
    if (cls !== null) { return pyDInstantiate(cls, pos, kw) }
    var icls = pyInstClassOf(callee)
    if (icls !== null) {
        if (pyLookupHas(icls, "__call__")) {
            var m = pyLookupVal(icls, "__call__")
            if (pyIsCallable(m)) {
                var self = rtPrepend(callee, pos)
                return pyCall(m, pyBindCall(m, self, kw))
            }
        }
    }
    var bound = pyBindCall(callee, pos, kw)
    // Go asks rt.pyBindCallR whether binding built a NEW array, and passes the
    // caller's own argument HANDLE through when it did not - an identity
    // optimisation, not a semantic choice. Here pyBindCall returns `pos` itself
    // in exactly those cases, so handing `bound` on covers both and needs no
    // test. It must NOT be decided by LENGTH: the extended layout is
    // [p0..pn-1, *args, **kwargs], so a positional count of names.length + 2
    // rebinds to an array of the same length (`def f(a, *rest, **kw)` called
    // `f(1, 2, 3)`).
    return pyCall(callee, bound)
}

// [v, ...args], the receiver-prepending Python's `self` needs, is SHARED as
// rtPrepend - lib/runtime.metajs.

// Allocate an instance of cls and run its __init__ with self prepended.
function pyDInstantiate(cls, args, kw) {
    var inst = {}
    inst["__class"] = cls
    if (pyLookupHas(cls, "__init__")) {
        var init = pyLookupVal(cls, "__init__")
        if (pyIsCallable(init)) {
            var self = rtPrepend(inst, args)
            pyCall(init, pyBindCall(init, self, kw))
        }
    }
    return inst
}

// The value a `raise` actually raises. `raise SomeClass` names a CLASS, and
// CPython instantiates it with no arguments; anything else is raised as it
// stands (a class OBJECT would match no except clause). The interpreter half's
// makeRaise has the same line. Go: js_pyraiseval in abnf/jsrt.go.
function js_pyraiseval(v) {
    if (pyClassOf(v) === null) { return v }
    return pyDInstantiate(pyClassOf(v), [], undefined)
}

// callPyValue calls a value that may itself be a class or a
// __call__ instance.
function pyDCallPyValue(v, args, kw) {
    if (pyIsSuper(v)) { return pySuperCall(v, args) }
    // A BUILTIN TYPE OBJECT is callable and CONVERTS: the emitter binds int/str/
    // float/... to js_pybuiltincls's stable class object with the conversion
    // closure hung on it as __conv (declBind in python-to-llvm-ir.abnf), so
    // `map(str, xs)` works. Go: rt.callPyValue in abnf/jsrt.go.
    if (v !== null && v !== undefined && typeof v == "object" && !Array.isArray(v)) {
        var cv = v["__conv"]
        if (typeof cv == "function") { return pyCall(cv, args) }
    }
    var cls = pyClassOf(v)
    if (cls !== null) { return pyDInstantiate(cls, args, kw) }
    var icls = pyInstClassOf(v)
    if (icls !== null) {
        if (pyLookupHas(icls, "__call__")) {
            var m = pyLookupVal(icls, "__call__")
            if (pyIsCallable(m)) {
                var self = rtPrepend(v, args)
                return pyCall(m, pyBindCall(m, self, kw))
            }
        }
    }
    return pyCall(v, pyBindCall(v, args, kw))
}

// One {value, done} record from a floor generator step, in PYTHON's protocol: the
// yielded value, or a StopIteration carrying the body's return value. Shared by
// send()/next()/__next__() and by throw(), which answers the same way.
function pyGenValue(st) {
    if (st === undefined || st === null) { fail("generator step failed") }
    if (st["done"] === true) {
        var exc = pyExcInstance("StopIteration", "")
        // CPython's StopIteration carries NO argument when the body returned None
        // and exactly one when it returned a value: repr() says StopIteration()
        // against StopIteration(7). pyExcInstance's one-string args is every other
        // runtime exception's shape, so this one is rewritten here.
        // The value (and e.value) is spelled null and not undefined: pyGetAttr's
        // own test is `obj[name] !== undefined`, so an undefined-valued attribute
        // would read as ABSENT.
        var sv = anytype
        sv = st["value"]
        if (sv === undefined) { sv = null }
        exc["value"] = sv
        var sargs = []
        if (sv !== null) { sargs.push(sv) }
        exc["args"] = sargs
        throw exc
    }
    return st["value"]
}

// pyMethodCall is obj.name(args) with Python's binding rule: an instance
// prepends itself, a class object does not (so Base.m(self) works). Its final
// fall-through is Go's rt.memberCall - the builtin method table for strings /
// lists / dicts - spelled pyMemberCall(target, name, args) here.
function pyDMethodCall(target, name, args, kw) {
    // super().m(...): the lookup starts one past the defining class in the
    // instance's MRO, and the instance is prepended as self.
    if (pyIsSuper(target)) { return pySuperMCall(target, name, args, kw) }
    // str's own method library (the str-methods chapter at the end of this file).
    // Checked FIRST and by NAME, so a name it does not know falls through to
    // pyMemberCall's string arm (pyFStrMethod), which reports it.
    if (typeof target == "string") {
        if (pySIsStrMethod(name)) { return pyStrMethod(target, name, args, kw) }
    }
    // A METHOD CALL THROUGH A MODULE OBJECT - `builtins.len(xs)`. The member is
    // read and called, so `builtins.len(xs)` and `builtins.len` answer the same
    // function. It sits FIRST because a module holds arbitrary member names, one
    // of which is literally `next`: without this the cursor and generator arms
    // below would claim it. math is handled ahead of this, in js_pyrxmcall.
    if (pyIsObj(target)) {
        if (target["__pymod"] !== undefined) {
            var mv = target[pyToStr(name)]
            if (mv === undefined) {
                pyRaiseExc("AttributeError",
                           "module '" + pyToStr(target["__pymod"]) + "' has no attribute '" + pyToStr(name) + "'")
            }
            return pyDCallPyValue(mv, args, kw)
        }
    }
    // A CURSOR (iter(), map(), zip(), ...) is NOT a generator, and this arm
    // keeps it out of the generator arm below.
    //
    // CPython's list_iterator carries __next__ and __iter__ and NOTHING else, so
    // send / close / throw - and every other name - are AttributeError, raised
    // here rather than left to fall through to pyMemberCall, which would abort
    // instead of raising something an `except AttributeError:` can catch.
    if (pyIsIter(target)) {
        // pyItStep answers the same {value, done} record a generator step does,
        // so the StopIteration protocol is pyGenValue's, unchanged. An exhausted
        // cursor has no return value, so the record's value is undefined and the
        // StopIteration carries no argument - CPython's answer too.
        if (name == "__next__") { return pyGenValue(pyItStep(target)) }
        // iter(it) is it, and so is it.__iter__() - CPython's rule for every
        // iterator, and what makes `for x in it` after a partial drain work.
        if (name == "__iter__") { return target }
        throw pyExcInstance("AttributeError",
                            "'" + pyTypeName(target) + "' object has no attribute '" + name + "'")
    }
    // A generator's own protocol. Python's send()/next() answer the YIELDED
    // value and raise StopIteration - carrying the body's return value - at the
    // end, where JavaScript's next() answers a {value, done} record. There is no
    // tag test in layer 2, so "is this a generator" is pyIsGen's structural one.
    if (pyIsGen(target)) {
        if (name == "send" || name == "next" || name == "__next__") {
            var sent = anytype
            sent = undefined
            if (args.length > 0) { sent = args[0] }
            var st = anytype
            // A CLOSED generator needs no special case here: close() below is a
            // real close in the floor (runtime.c's gen_close sets the cell's done
            // flag), so gen_next answers {undefined, true} for it exactly as
            // (*jsGenerator).step does.
            st = target["next"].apply(target, [sent])
            return pyGenValue(st)
        }
        // g.throw(exc): raise exc AT the yield the body is parked at. The floor's
        // tag-15 member table answers it (runtime.c's gen_throw) and the record it
        // builds is JavaScript's, so it is unwrapped into Python's protocol here
        // exactly as send()'s is - the body catching it and returning ends the
        // generator with a StopIteration carrying that return value.
        if (name == "throw") {
            var tv = anytype
            tv = undefined
            if (args.length > 0) { tv = args[0] }
            // g.throw(SomeClass) instantiates it, exactly as `raise SomeClass`
            // does (js_pyraiseval).
            tv = js_pyraiseval(tv)
            var tst = anytype
            tst = target["throw"].apply(target, [tv])
            return pyGenValue(tst)
        }
        if (name == "close") {
            // CPython's generator.close() answers None, not a {value, done}
            // record - the record is JavaScript's g.return(v), which is what the
            // floor's tag-15 `return` member builds and what this discards. The
            // close itself runs the body's `finally` clauses (runtime.c's
            // gen_close, abnf/jsrt.go's closeBody).
            target["return"].apply(target, [undefined])
            return undefined
        }
    }
    // A method the builtin TYPE OBJECT itself carries - dict.fromkeys.
    var bcm = pyBuiltinClsMethod(target, name)
    if (bcm !== undefined) { return bcm.apply(undefined, args) }
    // list.count(xs, 2) - the UNBOUND descriptor CALLED straight off the type
    // object rather than read as a value. The emitter routes a method call
    // through js_pyrxmcall and never through pyGetAttr, so the arm has to exist
    // on both paths or the read works and the call says "unknown method".
    var dtn = pyClassName(target)
    if (dtn !== null) {
        var dsamp = pyDTypeSample(dtn)
        if (dsamp !== undefined && pyDBuiltinAttr(dsamp, name)) {
            if (args.length == 0) {
                pyRaiseExc("TypeError", "unbound method " + dtn + "." + pyToStr(name) + "() needs an argument")
            }
            var drest = []
            var dk = 1
            while (dk < args.length) {
                drest.push(args[dk])
                dk = dk + 1
            }
            return pyDMethodCall(args[0], name, drest, undefined)
        }
    }
    var cls = pyClassOf(target)
    if (cls !== null) {
        if (pyLookupHas(cls, name)) {
            var cm = pyLookupVal(cls, name)
            // C.s(...) / C.c(...) on a staticmethod or classmethod: pyDDescGet
            // answers the callable the attribute read would have handed back, so
            // the call path and the read path cannot drift apart.
            if (pyDIsStatic(cm) || pyDIsClsM(cm)) {
                var cd = pyDDescGet(cm, cls, name)
                return pyCall(cd, pyBindCall(cd, args, kw))
            }
            if (pyIsCallable(cm)) { return pyCall(cm, pyBindCall(cm, args, kw)) }
            return pyDCallPyValue(cm, args, kw)
        }
        if (name == "mro") { return pyMroAttr(cls, "__mro__") }
        fail("type object '" + pyToStr(cls["__name"]) + "' has no method '" + name + "'")
    }
    var icls = pyInstClassOf(target)
    if (icls !== null) {
        // Go reads inst.props[name] - the instance's OWN property map. A bare
        // member read here also sees Object.prototype under goja, so a method
        // call literally named "toString" / "valueOf" / "constructor" on an
        // instance would take this arm instead of the MRO one. The prelude's
        // pyGetAttr / pySetAttr store instance attributes under their plain
        // names, so guarding with a "$" prefix here would desynchronize the two;
        // the collision is left standing, exactly as it is in pyGetAttr.
        var own = target[name]
        // A plain function in an attribute: called WITHOUT self.
        if (own !== undefined && pyIsCallable(own)) {
            return pyCall(own, pyBindCall(own, args, kw))
        }
        if (pyLookupHas(icls, name)) {
            var m = pyLookupVal(icls, name)
            // inst.s(...) on a staticmethod gets NO self, and inst.c(...) on a
            // classmethod gets the receiver's own class - checked before the
            // callable arm, which would otherwise prepend the instance.
            if (pyDIsStatic(m) || pyDIsClsM(m)) {
                var md = pyDDescGet(m, icls, name)
                return pyCall(md, pyBindCall(md, args, kw))
            }
            if (pyIsCallable(m)) {
                var self = rtPrepend(target, args)
                return pyCall(m, pyBindCall(m, self, kw))
            }
            return pyDCallPyValue(m, args, kw)
        }
        // A dict that also carries a __class falls through to the builtin dict
        // methods instead of aborting.
        if (target["__dict"] === undefined) {
            fail("'" + pyToStr(icls["__name"]) + "' object has no method '" + name + "'")
        }
    }
    // THE DICT AND SET METHOD SURFACE. Go: pySetMethod/pyDictMethod in
    // abnf/jsrt.go; the interpreter: the same two in
    // languages/python-interpreter.abnf.
    //
    // A name the OTHER type owns raises AttributeError, which is what CPython
    // does - and the two "only" lists are narrower than the two method sets,
    // because pop/clear/copy/update are on BOTH types.
    var pdEls = pySetElemsOf(target)
    if (pdEls !== null && pdEls !== undefined) {
        if (pyIsSetMethod(name)) { return pySetMethod(pdEls, name, args) }
        if (pyIsDictOnly(name)) {
            throw pyExcInstance("AttributeError",
                                "'" + pyTypeName(target) + "' object has no attribute '" + name + "'")
        }
    }
    if (pyIsDict(target)) {
        if (pyIsDictMethod(name)) { return pyDictMethod(target, name, args, kw) }
        if (pyIsSetOnly(name)) {
            throw pyExcInstance("AttributeError",
                                "'" + pyTypeName(target) + "' object has no attribute '" + name + "'")
        }
    }
    // THE LIST METHOD SURFACE. pyMemberCall's `count` arm is KOTLIN's
    // `xs.count { pred }`, so Python's list methods are answered here first. Go:
    // pyListMethod in abnf/jsrt.go; the interpreter: pyListMethod in
    // languages/python-interpreter.abnf.
    if (pyIsArr(target)) {
        if (pyIsListMethod(name)) { return pyListMethod(target, name, args, kw) }
    }
    if (pyDForeign(target, name)) {
        // A REAL, catchable AttributeError and not fail(): CPython's is
        // catchable, and both other engines raise one (pyMethodCall in
        // abnf/jsrt.go panics with a pyExcInstance, pyAttrErr in
        // languages/python-interpreter.abnf calls pyRaise), so
        // `try: xs.add(3) / except AttributeError` behaves the same in all three.
        throw pyExcInstance("AttributeError",
                            "'" + pyTypeName(target) + "' object has no attribute '" + name + "'")
    }
    return pyMemberCall(target, name, args)
}

// list.count(x): how many elements are == to x. Python's equality, not identity,
// so [1.0, 2].count(1) is 1 (a float box and a plain int compare by value).
function pyDListCount(xs, v) {
    var n = 0
    var i = 0
    while (i < xs.length) {
        if (pyAEqual(xs[i], v)) { n = n + 1 }
        i = i + 1
    }
    return n
}

// Python's list methods, the NAME SET first so that
// hasattr()/getattr() can ask exactly what the dispatcher answers. Keep in step
// with pyIsListMethod in abnf/jsrt.go and in languages/python-interpreter.abnf.
function pyIsListMethod(name) {
    if (name == "append" || name == "pop" || name == "clear") { return true }
    if (name == "copy" || name == "count" || name == "sort") { return true }
    if (name == "insert" || name == "remove" || name == "extend") { return true }
    if (name == "index" || name == "reverse") { return true }
    return false
}

// Every error below is a CATCHABLE Python exception with CPython 3.14's exact
// text, not fail(): `try: xs.remove(9) / except ValueError` has to behave the
// same in all three engines, which is the only thing that makes any of this
// assertable in one ratchet file.
function pyListMethod(xs, name, args, kw) {
    var n = xs.length
    if (name == "append") { xs.push(pyEArgAt(args, 0)); return undefined }
    if (name == "clear") {
        while (xs.length > 0) { xs.pop() }
        return undefined
    }
    if (name == "copy") { return pyCCopyArr(xs) }
    if (name == "reverse") {
        var lo = 0
        var hi = n - 1
        while (lo < hi) {
            var tmp = anytype
            tmp = xs[lo]
            xs[lo] = xs[hi]
            xs[hi] = tmp
            lo = lo + 1
            hi = hi - 1
        }
        return undefined
    }
    if (name == "count") {
        if (args.length != 1) {
            throw pyExcInstance("TypeError", "list.count() takes exactly one argument")
        }
        return pyDListCount(xs, args[0])
    }
    if (name == "pop") {
        if (n == 0) { throw pyExcInstance("IndexError", "pop from empty list") }
        var pi = n - 1
        if (args.length > 0) {
            if (args[0] !== undefined && args[0] !== null) {
                pi = pyListIdx(args[0])
                if (pi < 0) { pi = pi + n }
            }
        }
        if (pi < 0 || pi >= n) { throw pyExcInstance("IndexError", "pop index out of range") }
        var pv = anytype
        pv = xs[pi]
        pyCRemoveAt(xs, pi)
        return pv
    }
    if (name == "insert") {
        // CPython CLAMPS rather than raising: insert(-5, x) on a 2-list prepends
        // and insert(99, x) appends.
        var ii = pyListIdx(pyEArgAt(args, 0))
        if (ii < 0) {
            ii = ii + n
            if (ii < 0) { ii = 0 }
        }
        if (ii > n) { ii = n }
        xs.push(undefined)
        var im = xs.length - 1
        while (im > ii) {
            xs[im] = xs[im - 1]
            im = im - 1
        }
        xs[ii] = pyEArgAt(args, 1)
        return undefined
    }
    if (name == "remove") {
        var ri = 0
        while (ri < n) {
            if (pyAEqual(xs[ri], pyEArgAt(args, 0))) {
                pyCRemoveAt(xs, ri)
                return undefined
            }
            ri = ri + 1
        }
        throw pyExcInstance("ValueError", "list.remove(x): x not in list")
    }
    if (name == "extend") {
        // A copy first, so xs.extend(xs) DOUBLES the list as it does in CPython
        // rather than looping forever. pyElemsOf raises CPython's own "'int'
        // object is not iterable" for a non-iterable.
        var src = pyCCopyArr(pyElemsOf(pyEArgAt(args, 0)))
        var ei = 0
        while (ei < src.length) {
            xs.push(src[ei])
            ei = ei + 1
        }
        return undefined
    }
    if (name == "index") {
        // start/stop clamp exactly like a slice, so index(x, -1) searches the
        // last element only; the ValueError carries no repr in 3.14.
        var from = pyListClamp(pyEArgAt(args, 1), 0, n)
        var to = pyListClamp(pyEArgAt(args, 2), n, n)
        if (to < from) { to = from }
        var xi = from
        while (xi < to) {
            if (pyAEqual(xs[xi], pyEArgAt(args, 0))) { return xi }
            xi = xi + 1
        }
        throw pyExcInstance("ValueError", "list.index(x): x not in list")
    }
    if (name == "sort") {
        pySortList(xs, args, kw)
        return undefined
    }
    fail("unknown list method: " + name)
    return undefined
}

// An index argument as a plain number. A bool IS an int in Python, a float box
// is not an index at all - and the TypeError is CPython's own text.
function pyListIdx(v) {
    if (typeof v == "number") { return v }
    if (typeof v == "boolean") {
        if (v) { return 1 }
        return 0
    }
    throw pyExcInstance("TypeError",
                        "'" + pyTypeName(v) + "' object cannot be interpreted as an integer")
}

// One end of an index() window: absent means the default, negative wraps, and
// both ends clamp into [0, n] - pySliceRange in abnf/jsrt.go.
function pyListClamp(v, dflt, n) {
    if (v === undefined || v === null) { return dflt }
    var i = pyListIdx(v)
    if (i < 0) { i = i + n }
    if (i < 0) { i = 0 }
    if (i > n) { i = n }
    return i
}

// list.sort(*, key=None, reverse=False), in place. CPython's is STABLE and both
// parameters are KEYWORD-ONLY - a positional argument is a TypeError there, so
// it is one here rather than being read as the key. reverse= is done by
// reversing, sorting ascending and reversing again, which is how CPython keeps
// equal elements in their original order under it; an inverted comparison would
// not. The comparison is pyACompare, the same one js_pysorted uses, so sort()
// and sorted() can never disagree.
function pySortList(xs, args, kw) {
    if (args.length > 0) {
        throw pyExcInstance("TypeError", "sort() takes no positional arguments")
    }
    var key = pyKwArg(kw, "key")
    var rev = pyDTruthy(pyKwArg(kw, "reverse"))
    var vals = []
    var keys = []
    var i = 0
    while (i < xs.length) {
        var j = i
        if (rev) { j = xs.length - 1 - i }
        var e = anytype
        e = xs[j]
        vals.push(e)
        if (pyIsCallable(key)) { keys.push(pyCall(key, [e])) } else { keys.push(e) }
        i = i + 1
    }
    // Insertion sort, which is STABLE, exactly as js_pysorted does it.
    var s = 1
    while (s < vals.length) {
        var kx = anytype
        kx = keys[s]
        var vx = anytype
        vx = vals[s]
        var p = s - 1
        while (p >= 0 && pyACompare(kx, keys[p]) == -1) {
            keys[p + 1] = keys[p]
            vals[p + 1] = vals[p]
            p = p - 1
        }
        keys[p + 1] = kx
        vals[p + 1] = vx
        s = s + 1
    }
    var w = 0
    while (w < vals.length) {
        var t = w
        if (rev) { t = vals.length - 1 - w }
        xs[t] = vals[w]
        w = w + 1
    }
    return undefined
}

// One keyword argument of a method call, or undefined when it was not passed.
function pyKwArg(kw, name) {
    if (kw === null || kw === undefined) { return undefined }
    if (!pyIsDict(kw)) { return undefined }
    var i = pyDictFind(kw["keys"], name)
    if (i < 0) { return undefined }
    return kw["vals"][i]
}

// ------------------------------------------------------------ dict / set ---
//
// The NAME SETS first, so that hasattr()/getattr() ask exactly what the
// dispatcher answers. Keep in step with pyIsDictMethod/pyIsSetMethod in
// abnf/jsrt.go and in languages/python-interpreter.abnf. dict.fromkeys lives on
// the TYPE object (pyBuiltinClsMethod), not here.
function pyIsDictMethod(name) {
    if (name == "keys" || name == "values" || name == "items") { return true }
    if (name == "get" || name == "pop" || name == "clear") { return true }
    if (name == "copy" || name == "setdefault" || name == "update") { return true }
    if (name == "popitem") { return true }
    return false
}

function pyIsSetMethod(name) {
    if (name == "add" || name == "pop" || name == "clear") { return true }
    if (name == "copy" || name == "remove" || name == "discard") { return true }
    if (name == "union" || name == "update" || name == "issubset") { return true }
    return pyIsSetOnlyAlgebra(name)
}

// The names one of the two types owns and the other does NOT, which is exactly
// what CPython raises AttributeError for. They are narrower than the two sets
// above: pop, clear, copy and update are on BOTH a dict and a set.
function pyIsDictOnly(name) {
    if (name == "keys" || name == "values" || name == "items") { return true }
    if (name == "get" || name == "setdefault" || name == "popitem") { return true }
    return false
}

function pyIsSetOnly(name) {
    if (name == "add" || name == "remove") { return true }
    if (name == "discard" || name == "union" || name == "issubset") { return true }
    return pyIsSetOnlyAlgebra(name)
}

// The set algebra methods, which a dict does not have either.
function pyIsSetOnlyAlgebra(name) {
    if (name == "issuperset" || name == "isdisjoint") { return true }
    if (name == "intersection" || name == "difference" || name == "symmetric_difference") { return true }
    if (name == "intersection_update" || name == "difference_update") { return true }
    return name == "symmetric_difference_update"
}

// Every error below is a CATCHABLE Python exception with CPython 3.14's exact
// text, not fail(), for the same reason the list surface is.
function pyDictMethod(d, name, args, kw) {
    var keys = d["keys"]
    var vals = d["vals"]
    if (name == "keys") { return pyCCopyArr(keys) }
    if (name == "values") { return pyCCopyArr(vals) }
    // .items(): a list of [key, value] pairs in insertion order (each pair a
    // 2 element list, since the subset has no tuples; CPython answers a
    // dict_items VIEW of TUPLES). Every form, written or via getattr, arrives
    // here.
    if (name == "items") {
        var pairs = []
        var pi2 = 0
        while (pi2 < keys.length) {
            pairs.push([keys[pi2], vals[pi2]])
            pi2 = pi2 + 1
        }
        return pairs
    }
    if (name == "get") {
        var gi = pyDictFind(keys, pyEArgAt(args, 0))
        if (gi >= 0) { return vals[gi] }
        if (args.length > 1) { return args[1] }
        return undefined
    }
    if (name == "pop") {
        var pdI = pyDictFind(keys, pyEArgAt(args, 0))
        if (pdI >= 0) {
            var pdV = anytype
            pdV = vals[pdI]
            pyCRemoveAt(keys, pdI)
            pyCRemoveAt(vals, pdI)
            return pdV
        }
        if (args.length > 1) { return args[1] }
        throw pyExcInstanceV("KeyError", pyEArgAt(args, 0))
    }
    // popitem(): the LAST inserted pair, removed - CPython's is LIFO since 3.7.
    // The pair is a 2-element list, like items()' pairs, because this subset has
    // no tuple. Empty raises the KeyError whose argument is a sentence rather
    // than a key.
    if (name == "popitem") {
        if (keys.length == 0) {
            throw pyExcInstanceV("KeyError", "popitem(): dictionary is empty")
        }
        var ppI = keys.length - 1
        var ppK = anytype
        ppK = keys[ppI]
        var ppV = anytype
        ppV = vals[ppI]
        pyCRemoveAt(keys, ppI)
        pyCRemoveAt(vals, ppI)
        return [ppK, ppV]
    }
    if (name == "clear") {
        pyCTruncate(keys)
        pyCTruncate(vals)
        return undefined
    }
    // SHALLOW, like CPython's: the values are shared, only the two spine arrays
    // are new. d.copy() is not d, and d.copy() == d.
    if (name == "copy") {
        var c = pyNewDict()
        var ci = 0
        while (ci < keys.length) {
            pyDictSet(c, keys[ci], vals[ci])
            ci = ci + 1
        }
        return c
    }
    // setdefault(k[, default]) INSERTS and returns; the default defaults to
    // None, and it is inserted too - d.setdefault("b") leaves {"b": None}.
