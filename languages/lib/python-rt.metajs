function pyABinReflected(op) {
    if (op == "+") { return "__radd__" }
    if (op == "-") { return "__rsub__" }
    if (op == "*") { return "__rmul__" }
    if (op == "/") { return "__rtruediv__" }
    if (op == "//") { return "__rfloordiv__" }
    if (op == "%") { return "__rmod__" }
    if (op == "@") { return "__rmatmul__" }
    if (op == "**") { return "__rpow__" }
    if (op == "==") { return "__eq__" }
    if (op == "!=") { return "__ne__" }
    if (op == "<") { return "__gt__" }
    if (op == ">") { return "__lt__" }
    if (op == "<=") { return "__ge__" }
    if (op == ">=") { return "__le__" }
    return ""
