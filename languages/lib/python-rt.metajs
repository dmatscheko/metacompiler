// "__name__" arm reads that same table - the same answer by a different route.
function pyCGenericAlias(origin, param) {
    var isObj = pyIsObj(origin)
    if (!isObj && !pyIsFn(origin)) { return undefined }
    // Go's switch admits *jsObject / *jsClosure / *hostFunc / *boundMethod;
    // an array is neither (Array.isArray is excluded by pyIsObj).
    if (pyIsDict(origin)) { return undefined }
    if (pyTypeName(origin) != "type") { return undefined } // Only a type takes parameters.
    var name = pyStr(origin)
    if (isObj && origin["__name"] !== undefined) {
        name = pyToStr(origin["__name"])
    } else if (!isObj) {
        var fnName = pyGetAttr(origin, "__name__")
        if (typeof fnName == "string") { name = fnName }
    }
    var key = "$" + name + "[" + pyStr(param) + "]"
    var got = pyCAliases[key]
    if (got !== undefined) { return got }
    var alias = {__name: name + "[" + pyStr(param) + "]", __origin__: origin, __args__: [param]}
    pyCAliases[key] = alias
    return alias
}


// ================================================== the externs =============

// ----- js_dict_new ------------------------------------------------------------
// js_dict_new is SHARED - lib/runtime.metajs.


// ----- js_pyget ---------------------------------------------------------------
// Sequence indexing (negative wraps), dict lookup, the __getitem__ dunder of a
// user class, and the generic-alias reading of `list[int]`.
function js_pyget(c, k) {
    var cls = pyInstClassOf(c) // A user class may define __getitem__.
    if (cls !== null && cls !== undefined) {
        if (pyLookupHas(cls, "__getitem__")) {
            var m = pyLookupVal(cls, "__getitem__")
            if (pyIsCallable(m)) { return pyCallSelf(m, c, [k]) }
        }
    }
    // A subscript MISS is a CATCHABLE exception, not an abort, so
    // `try: d[k] / except KeyError` works. The KeyError carries the KEY ITSELF,
    // never its repr: CPython's KeyError.__str__ is repr(args[0]) and
    // pyUserRender does that. CPython's sequence message carries no index, so
    // neither does this.
    if (pyIsDict(c)) {
        var di = pyDictFind(c["keys"], k)
        if (di < 0) { pyRaiseExcV("KeyError", k) }
        return c["vals"][di]
    }
    var idx = 0
    if (pyIsArr(c)) {
        idx = pySeqIdx(c, k)
        if (idx < 0) { idx = idx + c.length }
        if (idx < 0 || idx >= c.length) { pyRaiseExc("IndexError", "list index out of range") }
        return c[idx]
    }
    if (typeof c == "string") {
        idx = pySeqIdx(c, k)
        // Go: rt.strLen / rt.strAt - UTF-16 code units. See the banner.
        var n = c.length
        if (idx < 0) { idx = idx + n }
        if (idx < 0 || idx >= n) { pyRaiseExc("IndexError", "string index out of range") }
        return c.charAt(idx)
    }
    // list[int] / dict[str, int]: subscripting a TYPE (a class object or a
    // builtin like list) is a generic alias, not an indexing. One object per
    // (origin, parameter) pair, so 'list[int] == list[int]' holds.
    var alias = pyCGenericAlias(c, k)
    if (alias !== undefined) { return alias }
    // CPython's TypeError, and CATCHABLE, so `None[0]` runs the except clause.
    pyRaiseExc("TypeError", "'" + pyTypeName(c) + "' object is not subscriptable")
    return undefined
}


// The position a list or str subscript names: an int (a bool is one), or
// CPython's TypeError naming the key's type. Twin of pySeqIdx in
// python-interpreter.abnf and abnf/jsrt.go.
function pySeqIdx(c, k) {
    if (typeof k == "number") { return k }
    if (typeof k == "boolean") {
        if (k) { return 1 }
        return 0
    }
    var tn = pyTypeName(k)
    if (tn == "int") { pyRaiseExc("IndexError", "cannot fit 'int' into an index-sized integer") }
    if (typeof c == "string") { pyRaiseExc("TypeError", "string indices must be integers, not '" + tn + "'") }
    pyRaiseExc("TypeError", "list indices must be integers or slices, not " + tn)
    return 0
}

// CPython's TypeError for an item write or delete on a value with no such slot;
// deletion says "doesn't" for a type with sequence slots. Twin of pyNoItemOp in
// python-interpreter.abnf, which explains the two spellings.
function pyNoItemOp(c, del) {
    var tn = pyTypeName(c)
    if (!del) { pyRaiseExc("TypeError", "'" + tn + "' object does not support item assignment") }
    var how = "does not"
    if (typeof c == "string" || pySetElemsOf(c) !== null || pyInstClassOf(c) !== null) { how = "doesn't" }
    pyRaiseExc("TypeError", "'" + tn + "' object " + how + " support item deletion")
}


// ----- js_pyset ---------------------------------------------------------------
// List element (negative wraps) or dict entry assignment, with the __setitem__
// dunder arm.
function js_pyset(c, k, v) {
    var cls = pyInstClassOf(c) // A user class may define __setitem__.
    if (cls !== null && cls !== undefined) {
        if (pyLookupHas(cls, "__setitem__")) {
            var m = pyLookupVal(cls, "__setitem__")
            if (pyIsCallable(m)) {
                pyCallSelf(m, c, [k, v])
                return undefined
            }
        }
    }
    if (pyIsDict(c)) {
        pyDictSet(c, k, v)
        return undefined
    }
    if (!pyIsArr(c)) { pyNoItemOp(c, false) }
    var idx = pySeqIdx(c, k)
    if (idx < 0) { idx = idx + c.length }
    if (idx < 0 || idx >= c.length) { pyRaiseExc("IndexError", "list assignment index out of range") }
    c[idx] = v
    return undefined
}


// ----- js_pylen ---------------------------------------------------------------
// len() for strings, lists, sets and dicts, with the __len__ dunder arm. The
// string arm counts CODE POINTS (Go: pyStrLen), so len of
// a single astral character is 1 and not 2 - this is the ONE place Go measures
// a string that way.
//
// Go has NO generator arm here: a generator reaches neither the set, the string,
// the array nor the dict test and lands on the failure. Ported as it stands -
// `len(g)` is an error in real Python too.
function js_pylen(v) {
    var cls = pyInstClassOf(v)
    if (cls !== null && cls !== undefined) {
        if (pyLookupHas(cls, "__len__")) {
            var m = pyLookupVal(cls, "__len__")
            if (pyIsCallable(m)) { return pyCallSelf(m, v, []) }
        }
    }
    var els = pySetElemsOf(v)
    if (els !== null && els !== undefined) { return els.length }
    if (typeof v == "string") { return pyStrLen(v) }
    if (pyIsArr(v)) { return v.length }
    if (pyIsDict(v)) { return v["keys"].length }
    fail("len() of a " + typeof v)
    return 0
}


// ----- js_pylist --------------------------------------------------------------
// list(x): ALWAYS a fresh list. A generator is drained.
function js_pylist(v) {
    // An ITERATOR object gives what is LEFT of it, and the read exhausts it.
    if (pyIsIter(v)) { return pyIterRest(v) }
    if (pyIsGen(v)) { return pyCDrain(v) }
    var els = pySetElemsOf(v)
    if (els !== null && els !== undefined) { return pyCCopyArr(els) }
    if (pyIsArr(v)) { return pyCCopyArr(v) }
    if (typeof v == "string") { return pyCStrChars(v) }
    if (pyIsDict(v)) { return pyCCopyArr(v["keys"]) }
    fail("list() of a " + typeof v)
    return []
}


// ----- js_pyiter --------------------------------------------------------------
// The list a for loop runs over: a generator is drained first, a set gives a
// COPY of its elements, a dict its keys, a string its characters, and a list
// ITSELF - the Go twin returns the handle it was given, not a copy, so a loop
// that mutates the list it walks sees the mutation.
function js_pyiter(v) {
    // An ITERATOR object gives what is LEFT of it, and the read exhausts it.
    if (pyIsIter(v)) { return pyIterRest(v) }
    if (pyIsGen(v)) { return pyCDrain(v) }
    var els = pySetElemsOf(v)
    if (els !== null && els !== undefined) { return pyCCopyArr(els) }
    if (pyIsArr(v)) { return v }
    if (typeof v == "string") { return pyCStrChars(v) }
    if (pyIsDict(v)) { return pyCCopyArr(v["keys"]) }
    fail("iteration over a " + typeof v)
    return []
}


// ----- js_pyrest --------------------------------------------------------------
// *args: the call arguments from index N on, as a list. N is a RAW parameter -
// the emitter writes it with a bare handle(k) (see the js_pyrest entry in the
// raw-argument mask in abnf/jsrt.go), which is what the i_raw name tells
// -rt-lib to box.
function js_pyrest(args, i_raw) {
    var out = []
    if (!pyIsArr(args)) { return out }
    var i = i_raw
    while (i < args.length) {
        out.push(args[i])
        i = i + 1
    }
    return out
}


// ----- js_pyspread ------------------------------------------------------------
// (positional array, iterable): append every element of the iterable.
// The source length is read ONCE, which is what Go's `append(dst, src...)` does
// when dst and src are the same handle.
function js_pyspread(arr, it) {
    if (!pyIsArr(arr)) { fail("js_pyspread needs an array") }
    if (pyIsArr(it)) {
        var i = 0
        var n = it.length
        while (i < n) {
            arr.push(it[i])
            i = i + 1
        }
        return undefined
    }
    if (typeof it == "string") {
        var si = 0
        var sn = it.length
        while (si < sn) {
            arr.push(it.charAt(si))
            si = si + 1
        }
        return undefined
    }
    if (pyIsDict(it)) {
        var ks = it["keys"]
        var ki = 0
        var kn = ks.length
        while (ki < kn) {
            arr.push(ks[ki])
            ki = ki + 1
        }
        return undefined
    }
    fail("cannot unpack a " + typeof it + " with *")
    return undefined
}


// ----- js_pykwspread ----------------------------------------------------------
// (keyword dict, mapping): merge the mapping in, an existing key OVERWRITTEN in
// place so the insertion order of the destination survives.
function js_pykwspread(dst, src) {
