        if (name == "__dict__" && pyTypeName(obj) == "function") { return pyFnAttrs(obj, true) }
    }
    // A BOUND built-in method, so getattr(xs, "count")(1) answers as CPython
    // does. Ahead of pyGetMember because a dict literally has a "keys" property
    // holding its key ARRAY, and CPython's d.keys is the method.
    if (pyDBuiltinAttr(obj, name)) { return pyDBoundBuiltin(obj, name) }
