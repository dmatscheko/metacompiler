// list.count(x): how many elements are == to x. Python's equality, not identity,
// so [1.0, 2].count(1) is 1 (a float box and a plain int compare by value).
function pyDListCount(xs, v) {
    var n = 0
    var i = 0
    while (i < xs.length) {
        if (pyAEqual(xs[i], v)) { n = n + 1 }
        i = i + 1
    }
    return n
}

// Python's list methods, the NAME SET first so that
// hasattr()/getattr() can ask exactly what the dispatcher answers. Keep in step
// with pyIsListMethod in abnf/jsrt.go and in languages/python-interpreter.abnf.
function pyIsListMethod(name) {
    if (name == "append" || name == "pop" || name == "clear") { return true }
    if (name == "copy" || name == "count" || name == "sort") { return true }
    if (name == "insert" || name == "remove" || name == "extend") { return true }
    if (name == "index" || name == "reverse") { return true }
    return false
}

// Every error below is a CATCHABLE Python exception with CPython 3.14's exact
// text, not fail(): `try: xs.remove(9) / except ValueError` has to behave the
// same in all three engines, which is the only thing that makes any of this
// assertable in one ratchet file.
function pyListMethod(xs, name, args, kw) {
    var n = xs.length
    if (name == "append") { xs.push(pyEArgAt(args, 0)); return undefined }
    if (name == "clear") {
        while (xs.length > 0) { xs.pop() }
        return undefined
    }
    if (name == "copy") { return pyCCopyArr(xs) }
    if (name == "reverse") {
        var lo = 0
        var hi = n - 1
        while (lo < hi) {
            var tmp = anytype
            tmp = xs[lo]
            xs[lo] = xs[hi]
            xs[hi] = tmp
