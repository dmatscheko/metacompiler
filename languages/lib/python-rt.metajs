// ----- js_pymatchmap (jsrt.go:7806) -----------------------------------------
// A mapping pattern matches a dict (not a set) that holds every listed key.
// Membership is pyDictFind, which compares keys with === - Go's rt.dictFind.
function js_pymatchmap(v, want) {
    var els = pySetElemsOf(v)
    if (els !== null && els !== undefined) { return false }
    if (!pyIsDict(v)) { return false }
    if (!pyIsArr(want)) { return false }
    var keys = v["keys"]
    var i = 0
    while (i < want.length) {
        if (pyDictFind(keys, want[i]) < 0) { return false }
        i = i + 1
