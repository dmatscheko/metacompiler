}

// One keyword argument of a method call, or undefined when it was not passed.
function pyKwArg(kw, name) {
    if (kw === null || kw === undefined) { return undefined }
    if (!pyIsDict(kw)) { return undefined }
    var i = pyDictFind(kw["keys"], name)
    if (i < 0) { return undefined }
    return kw["vals"][i]
}

// docs/todo.md 1.2. hasattr()/getattr() walked only the user-class MRO and an
// object's own property map, so hasattr([3,1,2], "count") was False and
// hasattr("s", "upper") was False where CPython answers True in both. This is
// the same question the DISPATCHER answers, asked by name: the str table
// (pySIsStrMethod), the list table (pyIsListMethod), and the dict/set arms of
// pyDMethodCall. Keep in step with pyBuiltinAttr in abnf/jsrt.go and in
// languages/python-interpreter.abnf.
//
// A builtin this project does not HAVE stays False on purpose - hasattr(3,
// "bit_length") is False here and True in CPython - because the alternative is
// hasattr answering True for a call that then aborts.
function pyDBuiltinAttr(obj, name) {
    if (typeof obj == "string") { return pySIsStrMethod(name) }
    if (pyIsArr(obj)) { return pyIsListMethod(name) }
    // A set is a dict whose keys are its members, so it is asked FIRST.
    var els = pySetElemsOf(obj)
    if (els !== null && els !== undefined) { return name == "add" }
    if (pyIsDict(obj)) {
        if (name == "keys" || name == "values" || name == "items") { return true }
        if (name == "get" || name == "pop") { return true }
    }
    return false
}

// What getattr() hands back for one of those names: CPython's `<built-in method
// count of list object ...>`, spelled here as a closure that re-enters the
// dispatcher with the receiver captured. Keyword arguments are NOT carried
// through it, so getattr(xs, "sort")(reverse=True) is not the same as
// xs.sort(reverse=True); the direct call is.
function pyDBoundBuiltin(target, name) {
    return function() {
        var args = []
        var i = 0
        while (i < arguments.length) {
            args.push(arguments[i])
            i = i + 1
        }
        return pyDMethodCall(target, name, args, undefined)
    }
}

// docs/todo.md 5.2 and 2.4. pyMemberCall is layer 2's copy of the SHARED
// member-call table rt.memberCall (abnf/jsrt.go), which nine languages land in,
// and sixteen of its names are ones Python cannot utter: `xs.sumOf(f)` answered
// 6 and `xs.size()` answered 2 in both compiled halves where CPython raises
// AttributeError. The names are denied here - AFTER the user-class arms above,
// so a Python class that DEFINES a method called forEach is unaffected - and the
// arms themselves are gone from pyFStrMethod / pyFListMethod below. The same
// table is pyForeignMethod in abnf/jsrt.go, called at the same point by
// pyMethodCall, so the two compiled halves keep agreeing. isEmpty and removeLast
// stay in lib/swift-rt.metajs and lib/dart-rt.metajs, where they are the
// language's real methods.
//
// The denial is keyed by RECEIVER TYPE, not by name alone: `get` is a real dict
// method (d.get(k, default)) and `add` is a real set method, so a flat name
// switch - which is what the four-name version was - would have broken both.
function pyDForeign(target, name) {
    if (pyIsArr(target)) {
        // Kotlin's, Java's, Dart's and Swift's list methods. `count` is NOT here:
        // Python has list.count(x) and it is answered above.
        if (name == "add") { return true }
        if (name == "size") { return true }
        if (name == "get") { return true }
        if (name == "contains") { return true }
        if (name == "map") { return true }
        if (name == "filter") { return true }
        if (name == "any") { return true }
    }
    if (pyIsStr(target)) {
        // Java's and Kotlin's string methods. Python spells them len(s), s[i],
        // s == t, s[a:b] and s.index(t).
        if (name == "length") { return true }
        if (name == "charAt") { return true }
        if (name == "equals") { return true }
        if (name == "substring") { return true }
        if (name == "indexOf") { return true }
    }
    if (name == "isEmpty") { return true }
    if (name == "removeLast") { return true }
    if (name == "sumOf") { return true }
    if (name == "forEach") { return true }
    return false
