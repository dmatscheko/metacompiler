    var i = 0
    while (i < pyDGenCell.length) {
        if (pyDGenCell[i] === g) {
            pyDGenClosed[i] = true
            return undefined
        }
        i = i + 1
    }
    pyDGenCell.push(g)
    pyDGenClosed.push(true)
    return undefined
}

// pyMethodCall (jsrt.go:9207) is obj.name(args) with Python's binding rule: an
// instance prepends itself, a class object does not (so Base.m(self) works).
//
// NOTE FOR THE CHUNK THAT OWNS js_pymcall: call this as
// pyDMethodCall(target, name, args, kw). Its final fall-through is Go's
// rt.memberCall - the builtin method table for strings / lists / dicts - which
// this chunk does not own; it is spelled pyMemberCall(target, name, args) here.
