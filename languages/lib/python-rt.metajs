// ----- js_pyslice3 (jsrt.go:7420) -------------------------------------------
// s[lo:hi:step] on lists and strings. The open ends arrive as undefined and mean
// what Python's defaults mean for the DIRECTION of the step, so xs[::-1] is the
// reversal.
function js_pyslice3(c, lo, hi, step) {
    if (pyIsArr(c)) {
        var idx = pySliceIndices(c.length, lo, hi, step)
        var out = []
        var i = 0
        while (i < idx.length) {
            out.push(c[idx[i]])
            i = i + 1
        }
        return out
    }
    if (typeof c == "string") {
        // Go: rt.strLen / rt.strAt - UTF-16 code units.
        var sidx = pySliceIndices(c.length, lo, hi, step)
