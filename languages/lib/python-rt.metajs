    var bcm = pyBuiltinClsMethod(obj, name)
    if (bcm !== undefined) { return bcm }
    if (name == "__mro__" || name == "__bases__") {
        if (pyClassName(obj) !== null) { return pyMroAttr(obj, name) }
    }
    // list.count / str.upper / dict.get read off the BUILTIN type object: an
    // unbound method descriptor. It sits HERE rather than in the pyIsClass branch
    // above because a builtin type object carries only a __name and no __mro, so
    // pyIsClass declines it - which is also why dict.fromkeys is answered on this
    // same line.
    var dtn0 = pyClassName(obj)
    if (dtn0 !== null) {
        var samp0 = pyDTypeSample(dtn0)
        if (samp0 !== undefined && pyDBuiltinAttr(samp0, name)) { return pyDUnboundDesc(obj, name) }
    }
    // A BOUND METHOD knows its own name, receiver and underlying function.
    // __qualname__ is answered HERE and nowhere else on purpose: 'list.count' and
    // 'C.m' are exactly CPython's answers and both fall out of the record, while a
    // plain function's qualname would need the DEFINING scope recorded at every
    // def site in four places.
    if (typeof obj == "function") {
        var bmj = pyBMFind(obj)
        if (bmj >= 0) {
            var bmk = pyBMTab[bmj + 4]
            if (name == "__name__") { return pyBMTab[bmj + 1] }
            if (name == "__qualname__") {
                // An unbound descriptor's owner is the TYPE OBJECT itself, and a
                // module function's qualname is its bare name.
                if (bmk == "d") { return pyToStr(pyBMTab[bmj + 2]["__name"]) + "." + pyToStr(pyBMTab[bmj + 1]) }
                if (bmk == "m") { return pyBMTab[bmj + 1] }
                return pyBMOwner(pyBMTab[bmj + 2]) + "." + pyToStr(pyBMTab[bmj + 1])
            }
            // CPython gives a method DESCRIPTOR no __self__ at all - it is not
            // bound to anything - and offers __objclass__ instead.
            if (name == "__objclass__" && bmk == "d") { return pyBMTab[bmj + 2] }
            if (name == "__self__" && bmk == "d") {
                pyRaiseExc("AttributeError",
                           "'method_descriptor' object has no attribute '__self__'")
            }
            if (name == "__self__") { return pyBMTab[bmj + 2] }
            if (name == "__func__") {
                if (pyBMTab[bmj + 3] === null) {
                    // CPython: a built-in method has no __func__.
                    pyRaiseExc("AttributeError",
                        "'builtin_function_or_method' object has no attribute '__func__'")
                }
                return pyBMTab[bmj + 3]
            }
        }
    }
    // Not answered: __doc__ and a function's __module__ (an AttributeError, like
    // any other absent attribute). __doc__ needs a def's leading string statement
    // recorded in three engines AND CPython's own text for every builtin; a
    // function's __module__ needs the defining module recorded at every def site.
    // __qualname__ rides with __name__ below. It is EXACT for a module-level
    // def, a lambda, a builtin function and a builtin type, and wrong for exactly
    // one shape: a function read off a class body, where CPython says 'C.m' and
    // this says 'm'. The bound-method arm above already answers 'C.m'.
    // len.__self__ is the builtins MODULE in CPython, not a receiver - the
    // builtin functions are that module's members.
    if (name == "__self__" && typeof obj == "function") {
        var bsc = rtPairGet(pyBBFnObjs, pyBBFnCodes, obj)
        if (bsc !== undefined && pyDBuiltinsMod !== null) { return pyDBuiltinsMod }
    }
    if (name == "__name__" || name == "__qualname__") {
        // A synthetic class object for a BUILTIN type (what type(3) hands out)
        // carries only its name, and a function carries none of its own - the name
        // its def bound it under was recorded by js_pyfnname.
        if (pyIsObj(obj)) {
            if (obj["__name"] !== undefined) { return pyShortName(pyToStr(obj["__name"])) }
        }
        // The BUILTIN table is asked too, and FIRST, exactly as pyFuncRenderOf
        // asks it, so len.__name__ is 'len'. The two tables are keyed by identity,
        // so a user `def len(...)` still answers its own.
        var bfc = rtPairGet(pyBBFnObjs, pyBBFnCodes, obj)
        if (bfc !== undefined) { return pyBBFnName(pyToStr(bfc)) }
        var fn = rtPairGet(pyBFnObjs, pyBFnNames, obj)
        if (fn !== undefined) { return fn }
    }
    // A function's own attributes, and the dict holding them.
    if (typeof obj == "function") {
        var fad = pyFnAttrs(pyFnOwner(obj), false)
        if (fad !== undefined) {
            var fai = pyDictFind(fad["keys"], name)
            if (fai >= 0) { return fad["vals"][fai] }
