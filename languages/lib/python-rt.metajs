// ----- exceptions (Go: js_pyexc / js_pyexcmatch / js_pyexcsplit) ------------

// The older {__class, args} shortcut. Note that the class object it builds is
// FRESH on every call and carries only a __name - it is NOT pyBuiltinClass's
// stable one and it has no __mro - so an except clause reaches it only through
// pyDIsInstance's name walk. Ported exactly; Go's `name, _ := u(a[0]).(string)`
// leaves the name EMPTY when the argument is not a string.
function js_pyexc(name, args) {
    var n = ""
    if (pyIsStr(name)) { n = name }
    var cls = {}
    cls["__name"] = n
    var arr = []
    if (pyIsArr(args)) {
        var i = 0
        while (i < args.length) {
            arr.push(args[i])
            i = i + 1
        }
