    if (alt) { pyFmtErr("ValueError", "Alternate form (#) not allowed with integer format specifier 'c'") }
    if (group != "") { pyFmtErr("ValueError", "Cannot specify '" + group + "' with 'c'.") }
    if (pyIsBig(x)) {
