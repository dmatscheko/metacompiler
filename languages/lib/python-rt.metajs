        var zero = false
        var plus = false
        var space = false
        var alt = false
        var scanning = true
        while (scanning && i < f.length) {
            var fl = f.charAt(i)
            if (fl == "-") { left = true ; i = i + 1 }
            else if (fl == "0") { zero = true ; i = i + 1 }
            else if (fl == "+") { plus = true ; i = i + 1 }
            else if (fl == " ") { space = true ; i = i + 1 }
            else if (fl == "#") { alt = true ; i = i + 1 }
            else { scanning = false }
