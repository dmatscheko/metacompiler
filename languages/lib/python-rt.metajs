    var i = from
    if (step > 0) {
        while (i < to) {
            out.push(i)
            i = i + step
        }
    } else {
        while (i > to) {
            out.push(i)
            i = i + step
        }
    }
    return out
}

// ord(c) / chr(n); the same builtins live in languages/python-interpreter.abnf
// and abnf/jsrt.go.
//
// A string is UTF-16 in every engine here, so a character ABOVE the BMP is a
// surrogate PAIR of code units and ONE character to Python: js_pyord decodes the
// pair (ord("\U0001F600") is 128512, not the high surrogate) and js_pychr
// re-encodes it. Length is pyStrLen, which counts CODE POINTS. The domain errors
// are catchable exceptions in CPython's own wording.
function js_pyord(s) {
    if (!pyIsStr(s)) {
        pyRaiseExc("TypeError", "ord() expected string of length 1, but " + pyTypeName(s) + " found")
        return 0
    }
    var n = pyStrLen(s)
    if (n != 1) {
        pyRaiseExc("TypeError", "ord() expected a character, but string of length " + n + " found")
        return 0
    }
    var c = s.charCodeAt(0)
    if (c >= 55296 && c <= 56319 && s.length > 1) {
        var t = s.charCodeAt(1)
        if (t >= 56320 && t <= 57343) { return 65536 + (c - 55296) * 1024 + (t - 56320) }
    }
    return c
}

function js_pychr(n) {
    var v = 0
    // A Python bool IS an int, so chr(True) is "\x01" - taken out of line
    // because MetaJS is TYPED and `n` could not be rewritten in place.
    if (typeof n == "boolean") { v = n ? 1 : 0 }
    else if (typeof n == "number") { v = Math.trunc(n) }
    else {
        pyRaiseExc("TypeError", "'" + pyTypeName(n) + "' object cannot be interpreted as an integer")
        return ""
    }
    if (v < 0 || v > 1114111) {
        pyRaiseExc("ValueError", "chr() arg not in range(0x110000)")
        return ""
    }
    return pyBCodePoint(v)
}

// ===== iterators and the variadic builtins ===================================
//
// Each is bound by declBuiltin in languages/python-to-llvm-ir.abnf, has a Go
// twin of the same js_py* name in abnf/jsrt.go and a hostGlobals entry in
// languages/python-interpreter.abnf. The variadic ones (next, round, pow, zip,
// map, enumerate, getattr, setattr, sorted) are declared with argc 0, which
// hands them the whole ARGUMENT ARRAY.
//
// NOT done, each for a reason stated at the binding site: input (reads stdin),
// format, frozenset, hash, id.
//
// THE ITERATOR OBJECT. iter/enumerate/zip/map/filter/reversed answer an ITERATOR
// in CPython and next() drives it. An iterator (a CURSOR) is built to LOOK like
// a generator - a plain object carrying a callable "next" that answers
// {value, done} - which is what the compiled for-loop tests for
// (python-to-llvm-ir.abnf's makeForStmt reads js_get(v, "next")), so a for loop
// over one is LAZY with no change to the emitter. The __pyit tag tells it apart
// from a generator (see pyIsGen).
//
// The SOURCE is materialized, and that is the line drawn: CPython's
// map/filter/zip/enumerate are lazy in their input too, so `map(f, endless())`
// works there and hangs here. iter(gen) answers the GENERATOR ITSELF - CPython's
// rule as well.
//
// Go: rt.pyMkIter / rt.pyItStep (abnf/jsrt.go).
function pyMkIter(name, arr) {
    var it = {__pyit: name, __a: arr, __i: 0}
    it["next"] = function() { return pyItStep(it) }
    return it
