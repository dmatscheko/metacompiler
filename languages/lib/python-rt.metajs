        return pyMFactorial(fn)
    }
    if (name == "isnan") { var nn = pyMArg(args, 0); return nn !== nn }
    if (name == "isinf") {
        var iv = pyMArg(args, 0)
        return iv === pyMInf() || iv === 0 - pyMInf()
    }
    if (name == "isfinite") {
        var fv = pyMArg(args, 0)
        return fv === fv && fv !== pyMInf() && fv !== 0 - pyMInf()
    }
    if (name == "isclose") {
        var ca = pyMArg(args, 0)
        var cb = pyMArg(args, 1)
        var crel = 0.000000001
        var cabs = 0
        if (args.length > 2) { crel = pyMArg(args, 2) }
        if (args.length > 3) { cabs = pyMArg(args, 3) }
        if (crel < 0 || cabs < 0) { pyRaiseExc("ValueError", "tolerances must be non-negative") }
        if (ca === cb) { return true }
        if (ca !== ca || cb !== cb) { return false }
        if (ca === pyMInf() || ca === 0 - pyMInf()) { return false }
        if (cb === pyMInf() || cb === 0 - pyMInf()) { return false }
        var cd = Math.abs(ca - cb)
        return cd <= Math.abs(crel * cb) || cd <= Math.abs(crel * ca) || cd <= cabs
    }
    if (name == "isqrt") { return pyMIsqrt(pyMIntArg(args[0])) }
    if (name == "comb") { return pyMComb(pyMIntArg(args[0]), pyMIntArg(args[1]), true) }
    if (name == "perm") {
        var pn = pyMIntArg(args[0])
        if (args.length > 1 && args[1] !== undefined && args[1] !== null) { return pyMComb(pn, pyMIntArg(args[1]), false) }
