// bin/hex/oct: CPython's 0b/0x/0o prefix with the sign OUTSIDE it, so bin(-5) is
// '-0b101'. The digits come out through pyABin, so an ARBITRARY PRECISION int
// converts exactly - the Go twin uses math/big for the same reason.
function js_pybinstr(n) { return pyRadixOf(n, 2, "0b") }
function js_pyhexstr(n) { return pyRadixOf(n, 16, "0x") }
function js_pyoctstr(n) { return pyRadixOf(n, 8, "0o") }

function pyRadixOf(n, base, prefix) {
    if (typeof n == "boolean") {
        if (n) { return prefix + "1" }
        return prefix + "0"
    }
    if (typeof n != "number" && !pyIsBig(n)) {
        throw pyExcInstance("TypeError",
                            "'" + pyTypeName(n) + "' object cannot be interpreted as an integer")
    }
