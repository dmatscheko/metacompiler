// python-rt.metajs -- PYTHON'S OWN SEMANTICS, in MetaJS. Layer 2 of
// docs/runtime-next-plan.md part 3, for the NINTH and last language after the Lua
// pilot, PHP, Swift, Java, C#, Dart, Go and Ruby.
//
// languages/python-to-llvm-ir.abnf emits handle IR that calls 86 js_* externs over
// the full-syntax ratchet. 32 of them are generic primitives languages/lib/runtime.c
// already provides (the C floor, layer 1). The other 54 are here.
//
// Compile with:
//     mec languages/metajs-to-llvm-ir.abnf languages/lib/python-rt.metajs -q -rt-lib
// which is what tests/gen-python-rt-ll.sh does; the result is the checked-in
// languages/lib/python-rt.ll that python-to-llvm-ir.abnf links next to runtime.ll.
// -rt-lib exports every TOP-LEVEL `function js_*` below under its own C symbol, so
// nothing else in this file is visible to the linker - the helpers are deliberately
// named py*, pyA*..pyF*.
//
// THE AUTHORITATIVE SPECIFICATION IS abnf/jsrt.go (Python has NO dedicated Go twin:
// its semantics live in the shared file, in the js_py* extern table and the py*
// helper functions - pyString / pyRepr / pyTypeName / pyEqual / pyMRO / pyLookup /
// pyGetAttr / pySetAttr / pyMethodCall / pyBindCall / pyArith / pyFormat / memberCall)
// plus abnf/jsrtregexpy.go for the `re` module. This file matches them function for
// function; where it CANNOT, the site says so in full.
//
// ----- the value model -------------------------------------------------------
//
//     null / undefined            ==  None
//     true / false                ==  True / False
//     a PLAIN NUMBER              ==  int when it is integral and finite, else float.
//                                     There is no box: pyTypeName decides by
//                                     Math.trunc, exactly like abnf/jsrt.go:9332.
//     {__pybig, neg, limbs}       ==  an arbitrary precision int (js_bigint). Go uses
//                                     math/big; the base-10000 limbs are chunk A's.
//     a string                    ==  str
//     an array                    ==  list AND tuple (Python's tuple has no separate
//                                     representation in either half)
//     {__dict, keys, vals}        ==  dict, INSERTION ordered, parallel arrays
//     {__set, elems}              ==  set, duplicate free by pyEqual
//     {__cplx, real, imag}        ==  complex
//     {__mro, __name, __super}    ==  a class object; __mro is the C3 linearization
//     {__class: <class>}          ==  an instance
//     a function                  ==  a function (typeof "function"; tag 16, a
//                                     generator FUNCTION, answers that too since the
//                                     floor's type_of learned t == 16)
//     a tag-15 cell               ==  a generator. There is NO tag test in layer 2,
//                                     so pyIsGen below is STRUCTURAL - the floor
//                                     answers exactly one member on a generator,
//                                     "next" (runtime.c:2868), and a cursor cannot be
//                                     stored on one, which is php's finding.
//
// ----- what Python needed from the floor, and what it did NOT ----------------
//
//  1. NO sized-integer tag and NO boxed double. Python's int and float are the same
//     plain double, discriminated by Math.trunc, so neither tag 13 nor tag 14 is
//     reached from this file. The si_norm question ("is the language's unboxed
//     representation the one si_norm produces") does not arise. Python's ARBITRARY
//     PRECISION int does, and the answer is a base-10000 bignum in MetaJS rather
//     than a floor tag: Go reaches math/big through *jsBigInt and the floor has no
//     equivalent, so chunk A's pyABig* is the whole of it.
//  2. `__raw` IS needed, and Python is only the third language that needs it (lua
//     and php are the others). `grep -n truthyExt languages/python-to-llvm-ir.abnf`
//     answers `core.truthyExt = "js_pytruthy"`, so compile-core's truthy() emits
//     `icmp ne <call>, 0` on THIS FILE's function and consumes the result as a RAW
//     INTEGER. js_pytruthy is therefore written as js_pytruthy__raw.
//  3. A coroutine primitive IS used: `grep -c 'js_genfn\|js_yield'
//     languages/python-to-llvm-ir.abnf` is 6. Python is the first language on the
//     floor's generators that needed layer-2 lines for them - the emitter drives
//     js_genfn/js_yield itself (csharp's zero-line finding), but the INSPECTION
//     surface (next / send / close / drain / len) is Python's own and is here.
//  4. NO jsChar. Python has no character type and the emitter emits js_char /
//     js_char_code / js_kindex zero times.
//
// ----- the scope chain: lowered in the EMITTER, not here ---------------------
//
// SIX externs took a scope handle - js_pyfnscope, js_pyglobal, js_pynonlocal,
// js_pyset_var, js_pydel_var and js_pyannot - plus js_pyclass_fill, which enumerated
// one. A scope is the C floor's PRIVATE storage, so none of them could be written
// here, and runtime.c says so itself at js_pyset_var ("A Python layer 2 will have to
// add them"). They are lowered in python-to-llvm-ir.abnf instead, over
// js_scope_new / js_scope_decl / js_scope_get / js_scope_set / js_scope_typeof,
// which BOTH engines have. That is the seventh confirmation of the
// private-representation rule and by far the largest: six externs left the module,
// where php lowered 2, swift 2, java 1, csharp 0, dart 2, go 1 and ruby 1.
//
// ----- the regular-expression engine is IMPORTED, not copied ------------------
//
// languages/lib/regex.js is the shared backtracking engine that every INTERPRETER
// grammar includes into its tag script, and abnf/jsrtregex.go is its line-by-line Go
// port. It is written in the same MetaJS this file is, so layer 2 needs no third
// copy - ruby found this and python is the language it was found FOR.
//
// ----- MetaJS rules that shape the code below --------------------------------
//
// docs/abnf-dialect-gotchas.md: a local (or a reassigned parameter) keeps the TYPE
// CLASS it is first assigned, so a variable that holds a number in one branch and an
// object in another is declared `var x = anytype`; there is no ASI, so every
// `return` carries its value on the same line and a value-less early return is
// BRACED; no for..in, no splice, no split/join/lastIndexOf, indexOf ignores its
// from-index, array.length is not assignable, and there are no exponent literals.
// There is no hasOwn in a -rt-lib module, so Go's `v, ok := o.props[n]` is spelled
// `o[n] !== undefined` throughout; at RUNTIME an object is a floor cell with no
// prototype, so the Object.prototype hazard of the compiler's own goja objects does
// not arise here.

import "./regex.js"

// The shared layer-2 runtime (docs/runtime-merge-plan.md part A). It supplies
// the externs every language implements identically, parameterised by the rtk*
// hooks below. Same mechanism ruby uses for `import "./regex.js"`.
import "./runtime.metajs"
import "./runtime-decimal.metajs"
import "./runtime-bignum.metajs"

// ----- the rtk* hooks the shared runtime calls -------------------------------
function rtkStr(v) { return pyAJavaStr(v) }
function rtkNum(v) { return pyNum(v) }
function rtkIsChar(v) { return false }
function rtkIsArr(v) { return pyIsArr(v) }

// ===================================================== the value model ======

// DELIBERATELY NOT SHARED, and this is the one merge in this project that was
// measured as a LOSS after it shipped. 120ba0f made this body
// `return rtIsObjNotArr(v)`, which is a THREE-DEEP CALL CHAIN - pyIsObj ->
// rtIsObjNotArr -> rtIsObj - on a predicate ~30 call sites ask, several of them
// inside the arithmetic and attribute paths every Python statement walks.
//
//   tests/bench.sh --draws 5, python, against the recorded 4b594c1 baseline:
//     4b594c1 (self-contained here)   31.065 G     -2.04%   spread 1.32%
//     120ba0f (delegating)            43.914 G    +41.26%   spread 1.38%
//     de-delegated again              31.845 G     +2.44%   spread 2.06%
//
//   ruby's rbIsObj is the same body and the same story: 6.223 G -> 6.921 G,
//   +11.19% against a 3.73% spread.
//
// So the whole 41% was this one delegation, and the fix is to spell the body out
// again in both languages. THE LESSON IS NOT "do not share": it is that a
// zero-knob difference list is necessary and NOT SUFFICIENT. A shared body costs
// a CALL, and in MetaJS a call is a scope frame - which is free for a body called
// on a cold path and enormous for a hot predicate. Size the CALL SITE, not the
// body. rtIsObjNotArr stays in runtime.metajs for cold callers; ~30 hot sites are
// not one of them.
//
// It is NOT rtIsObj either: that one deliberately leaves the array rejection out,
// because its own callers walk __class/__super and an array carries neither.
function pyIsObj(v) {
    if (v === null) { return false }
    if (v === undefined) { return false }
    if (typeof v != "object") { return false }
    return !Array.isArray(v)
}

function pyIsArr(v) { return Array.isArray(v) }
function pyIsStr(v) { return typeof v == "string" }
function pyIsNum(v) { return typeof v == "number" }
function pyIsBool(v) { return typeof v == "boolean" }
function pyIsFn(v) { return typeof v == "function" }
function pyIsCallable(v) { return typeof v == "function" }

function pyIsNone(v) {
    if (v === null) { return true }
    return v === undefined
}

function pyTag(v, name) {
    if (!pyIsObj(v)) { return false }
    return v[name] === true
}

function pyIsDict(v) { return pyTag(v, "__dict") }
function pyIsCplx(v) { return pyTag(v, "__cplx") }
function pyIsBig(v) { return pyTag(v, "__pybig") }

// Python's float: a boxed double (abnf/jsrt.go's jsPyFlo, python-interpreter.abnf's
// pyFlo). int and float are two DIFFERENT Python types - they print differently
// (1 vs 1.0), answer different type()s, and `/` makes a float even out of two
// ints - and one double cannot carry that, because 2.0 and 2 ARE the same double.
// So the float is the boxed one and the int stays the plain number, which leaves
// the common integer path untouched. The field is not `=== true` like the tags
// above, so pyTag cannot answer it.
function pyIsFlo(v) {
    if (!pyIsObj(v)) { return false }
    return v["__flo"] !== undefined
}
function pyMkFlo(f) { return {__flo: f} }

// "this value has a double in it": a float box, a plain int, a bool (True is 1)
// or an arbitrary precision integer. Go: pyIsNumeric.
function pyIsNumeric(v) {
    if (typeof v == "number") { return true }
    if (typeof v == "boolean") { return true }
    if (pyIsFlo(v)) { return true }
    return pyIsBig(v)
}

// The result type of // and %: an int from two ints (7 // 2 is 3) and a float as
// soon as either operand is one (7.5 // 2 is 3.0). Go: pyIntOrFlo.
function pyIntOrFlo(f, l, r) {
    if (pyIsFlo(l) || pyIsFlo(r)) { return pyMkFlo(f) }
    return f
}

// A class object carries its C3 linearization; an instance carries its class.
function pyIsClass(v) {
    if (!pyIsObj(v)) { return false }
    return v["__mro"] !== undefined
}

// A GENERATOR is a floor cell (tag 15). Layer 2 has no tag test, so the question is
// answered structurally: the floor answers exactly ONE member on a generator, "next"
// (runtime.c:2868), and none of the objects this value model builds carries a
// callable "next" of its own.
function pyIsGen(v) {
    if (v === null) { return false }
    if (v === undefined) { return false }
    if (typeof v != "object") { return false }
    if (Array.isArray(v)) { return false }
    if (v["__dict"] === true) { return false }
    if (v["__set"] === true) { return false }
    if (v["__cplx"] === true) { return false }
    if (v["__pybig"] === true) { return false }
    if (v["__mro"] !== undefined) { return false }
    if (v["__class"] !== undefined) { return false }
    return typeof v["next"] == "function"
}

function pyFail(msg) { fail(msg) }

// ===================================================== dict =================
//
// abnf/jsrt.go's dictParts / dictFind / dictAppend (the Go twin's dictFind is an
// index over the same array; the scan is the same answer). A dict KEY is compared
// with STRICT equality, not with Python ==, and that IS Python: `1 == 1.0` and
// `1 == True` are the only equalities `===` misses, the first is free here (int
// and float are the same plain double) and the second is pyKeyAlias below.
//
// The one CPython rule that needs writing down: `bool` subclasses `int`, so
//
//     d = {}; d[True] = "t"; d[1] = "one"
//
// is ONE entry in CPython 3.14, `d[True]` is "one", and `list(d)` is `[True]` -
// the FIRST key object stays and only the VALUE is overwritten. That is why the
// alias is tried at LOOKUP and the key is never normalized on the way in:
// normalizing would store 1 and print `1` where CPython prints `True`.

function pyNewDict() { return js_dict_new() }

// The other spelling of a key Python considers equal to this one. Only the
// bool/int pair can differ: an int and a float are already the same plain double
// here. -0.0 == 0 is true in this comparison, so a negative zero lands in the
// False arm exactly as CPython puts it there.
function pyKeyAlias(k) {
    if (k === true) { return 1 }
    if (k === false) { return 0 }
    if (pyIsFlo(k)) { return k["__flo"] }
    if (typeof k == "number") {
        if (k == 1) { return true }
        if (k == 0) { return false }
    }
    return undefined
}

// The scan's === plus the float rule: a float box keys with the int of the same
// value ({1.0: "a"}[1] is a hit), and two boxes holding the same double are one
// key though they are two objects. Go: rt.dictKeyEq.
function pyKeyEq(a, b) {
    if (pyIsFlo(a) || pyIsFlo(b)) {
        if (!pyIsNumeric(a) || !pyIsNumeric(b)) { return false }
        return pyNum(a) == pyNum(b)
    }
    return a === b
}

// The alias is tried TWICE: a float box's alias is the plain number and the
// plain number's is the bool, so {True: "t"}[1.0] takes two steps.
function pyDictFind(keys, k) {
    for (var i = 0; i < keys.length; i++) {
        if (pyKeyEq(keys[i], k)) { return i }
    }
    var alias = pyKeyAlias(k)
    if (alias === undefined) { return 0 - 1 }
    for (var j = 0; j < keys.length; j++) {
        if (pyKeyEq(keys[j], alias)) { return j }
    }
    var alias2 = pyKeyAlias(alias)
    if (alias2 === undefined) { return 0 - 1 }
    for (var q = 0; q < keys.length; q++) {
        if (pyKeyEq(keys[q], alias2)) { return q }
    }
    return 0 - 1
}

function pyDictSet(d, k, v) {
    var keys = d["keys"]
    var i = pyDictFind(keys, k)
    if (i >= 0) {
        d["vals"][i] = v
        return d
    }
    keys.push(k)
    d["vals"].push(v)
    return d
}

// ===================================================== set ==================
//
// abnf/jsrt.go's newPySet / pySetElems / pySetHas / pySetAdd. MEMBERSHIP is Python
// ==, which the dict keys above reach the other way round (=== plus pyKeyAlias);
// the two now answer the same question for every value this model builds, and the
// remaining difference is which is cheaper.

function pyNewSet(elems) { return {__set: true, elems: elems} }

function pySetElemsOf(v) {
    if (!pyTag(v, "__set")) { return null }
    var e = v["elems"]
    if (!Array.isArray(e)) { return null }
    return e
}

function pySetHas(els, v) {
    for (var i = 0; i < els.length; i++) {
        if (pyEqual(els[i], v)) { return true }
    }
    return false
}

function pySetAdd(els, v) {
    if (!pySetHas(els, v)) { els.push(v) }
    return els
}

// ===================================================== complex ==============
//
// abnf/jsrt.go's newPyComplex / pyComplexParts: a plain number reads as (n, 0), so
// mixed arithmetic needs no second code path.

function pyNewCplx(re, im) { return {__cplx: true, real: re, imag: im} }

function pyCplxRe(v) {
    if (pyIsCplx(v)) { return pyNum(v["real"]) }
    return pyNum(v)
}

function pyCplxIm(v) {
    if (pyIsCplx(v)) { return pyNum(v["imag"]) }
    return 0
}

// ===================================================== conversions ==========

// rt.toNumber. `v * 1` IS ToNumber: the floor's js_mul coerces both operands the
// same way abnf/jsrt.go's toNumber does, so undefined answers NaN, null 0, a bool
// 1/0, a string its parse and EVERY object (a __pybig and a __cplx included) NaN -
// which is what Go's `default:` arm gives, and what `**`, `//` and `%` on a big or a
// complex depend on.
function pyNum(v) {
    if (pyIsFlo(v)) { return v["__flo"] } // rt.toNumber's jsPyFlo arm.
    return v * 1
}

// rt.toString. The one arm `"" + v` does not give is the bignum, whose Go twin
// answers big.Int.String(); pyABigStr (chunk A) is that, and top-level function
// declarations hoist, so it is reachable from here.
function pyToStr(v) {
    if (pyIsBig(v)) { return pyABigStr(v) }
    return "" + v
}

// pyStrLen counts CODE POINTS (abnf/jsrt.go:9773), where the string indexing of
// js_pyget counts UTF-16 code units. That inconsistency is the Go twin's and is
// reproduced rather than repaired.
function pyStrLen(s) {
    var n = 0
    var i = 0
    while (i < s.length) {
        var c = s.charCodeAt(i)
        if (c >= 55296 && c <= 56319 && i + 1 < s.length) { i = i + 1 }
        i = i + 1
        n = n + 1
    }
    return n
}

function pyStrAt(s, i) {
    var n = 0
    var k = 0
    while (k < s.length) {
        var c = s.charCodeAt(k)
        var w = 1
        if (c >= 55296 && c <= 56319 && k + 1 < s.length) { w = 2 }
        if (n == i) { return s.substring(k, k + w) }
        k = k + w
        n = n + 1
    }
    return ""
}

// ===================================================== rendering ============
//
// abnf/jsrt.go's pyString (2467) and pyRepr (2458), one for one.

function pyStr(v) {
    if (v === null) { return "None" }
    if (v === undefined) { return "None" }
    if (typeof v == "boolean") {
        if (v) { return "True" }
        return "False"
    }
    if (pyIsFlo(v)) { return pyBFloStr(v["__flo"]) }
    // A TYPE object renders as CPython's <class 'name'>, so print(type(1.0))
    // reads <class 'float'>. rt.pyClassName in the Go twin.
    var cn = pyClassName(v)
    if (cn !== null) { return "<class '" + cn + "'>" }
    if (Array.isArray(v)) {
        var out = "["
        for (var i = 0; i < v.length; i++) {
            if (i > 0) { out = out + ", " }
            out = out + pyRepr(v[i])
        }
        return out + "]"
    }
    if (pyIsObj(v)) {
        var els = pySetElemsOf(v)
        if (els != null) {
            var so = "{"
            for (var j = 0; j < els.length; j++) {
                if (j > 0) { so = so + ", " }
                so = so + pyRepr(els[j])
            }
            return so + "}"
        }
        if (pyIsDict(v)) {
            var ks = v["keys"]
            var vs = v["vals"]
            var d = "{"
            for (var k = 0; k < ks.length; k++) {
                if (k > 0) { d = d + ", " }
                d = d + pyRepr(ks[k]) + ": " + pyRepr(vs[k])
            }
            return d + "}"
        }
    }
    var ic = pyInstClassOf(v)
    if (ic !== null && ic !== undefined) { return pyUserRender(v, ic, false) }
    // An iterator object. CPython prints <map object at 0x...>; the address is
    // its own and cannot be matched, so it is left off rather than invented, and
    // all three engines print this same short form.
    if (pyIsIter(v)) { return "<" + pyToStr(v["__pyit"]) + " object>" }
    return pyToStr(v)
}

// ----- repr() of a str: CPython's unicode_repr -------------------------------
//
// The quote is ' unless the string holds a ' and no " (then it is "), so
// repr("it's") reads "it's" while repr("both ' and \"") reads 'both \' and "'.
// Inside, the quote in force and a backslash DOUBLE UP, \t \n \r have their
// short forms, and every other NON-PRINTABLE code point becomes \xNN (below
// U+0100), \uNNNN (below U+10000) or \UNNNNNNNN. Everything printable - "café"
// and an emoji included - is emitted literally.
//
// "Printable" is Unicode's: NOT in the categories Cc Cf Cs Co Cn Zl Zp Zs, with
// U+0020 itself excepted. The Cn (UNASSIGNED) half of that needs the Unicode
// database, which nothing in this project carries, so pyReprEsc knows the
// CLOSED sets instead - C0/C1, the two Latin-1 strays U+00A0 and U+00AD, the
// separators, the format characters, the surrogates and the private-use planes -
// and leaves an unassigned code point literal. Every ASSIGNED character is
// exact, and the whole of Latin-1 (the only range \xNN can ever come from) is
// exact by construction.
//
// The same three functions are pyStrRepr / pyReprEsc / pyHexPad in
// languages/python-interpreter.abnf and pyStrRepr / pyReprEsc in abnf/jsrt.go.
function pyHexPad(v, n) {
    var digits = "0123456789abcdef"
    var out = ""
    var t = v
    var i = 0
    while (i < n) {
        var q = Math.floor(t / 16)
        out = digits.charAt(t - q * 16) + out
        t = q
        i = i + 1
    }
    return out
}

function pyReprEsc(cp) {
    if (cp < 32) { return true }
    if (cp == 127) { return true }
    if (cp >= 128 && cp <= 160) { return true }         // C1 plus U+00A0 NBSP
    if (cp == 173) { return true }                      // U+00AD SOFT HYPHEN
    if (cp < 256) { return false }
    if (cp >= 1536 && cp <= 1541) { return true }       // U+0600..U+0605
    if (cp == 1564 || cp == 1757 || cp == 1807) { return true }
    if (cp == 2192 || cp == 2193 || cp == 2274) { return true }
    if (cp == 5760 || cp == 6158) { return true }       // U+1680, U+180E
    if (cp >= 8192 && cp <= 8207) { return true }       // U+2000..U+200F
    if (cp >= 8232 && cp <= 8239) { return true }       // U+2028..U+202F
    if (cp >= 8287 && cp <= 8303) { return true }       // U+205F..U+206F
    if (cp == 12288) { return true }                    // U+3000
    if (cp >= 55296 && cp <= 57343) { return true }     // surrogates (Cs)
    if (cp >= 57344 && cp <= 63743) { return true }     // U+E000..U+F8FF (Co)
    if (cp == 65279) { return true }                    // U+FEFF
    if (cp >= 65529 && cp <= 65531) { return true }     // U+FFF9..U+FFFB
    if (cp == 69821 || cp == 69837) { return true }     // U+110BD, U+110CD
    if (cp >= 78896 && cp <= 78911) { return true }     // U+13430..U+1343F
    if (cp >= 113824 && cp <= 113827) { return true }   // U+1BCA0..U+1BCA3
    if (cp >= 119155 && cp <= 119162) { return true }   // U+1D173..U+1D17A
    if (cp == 917505) { return true }                   // U+E0001
    if (cp >= 917536 && cp <= 917631) { return true }   // U+E0020..U+E007F
    if (cp >= 983040 && cp <= 1048573) { return true }  // U+F0000..U+FFFFD
    if (cp >= 1048576 && cp <= 1114109) { return true } // U+100000..U+10FFFD
    return false
}

function pyStrRepr(s) {
    var quote = "'"
    var hasSq = false
    var hasDq = false
    var i = 0
    while (i < s.length) {
        var c0 = s.charAt(i)
        if (c0 == "'") { hasSq = true }
        if (c0 == "\"") { hasDq = true }
        i = i + 1
    }
    if (hasSq && !hasDq) { quote = "\"" }
    var out = quote
    var k = 0
    while (k < s.length) {
        var ch = s.charAt(k)
        var cc = s.charCodeAt(k)
        var cp = cc
        var w = 1
        // An astral character arrives as a UTF-16 surrogate PAIR and is ONE code
        // point to CPython, so it is decoded before the printability test -
        // otherwise every emoji would escape as two lone surrogates.
        if (cc >= 55296 && cc <= 56319 && k + 1 < s.length) {
            var lo = s.charCodeAt(k + 1)
            if (lo >= 56320 && lo <= 57343) {
                cp = 65536 + (cc - 55296) * 1024 + (lo - 56320)
                ch = s.substring(k, k + 2)
                w = 2
            }
        }
        if (ch == quote || cp == 92) { out = out + "\\" + ch }
        else if (cp == 9) { out = out + "\\t" }
        else if (cp == 10) { out = out + "\\n" }
        else if (cp == 13) { out = out + "\\r" }
        else if (!pyReprEsc(cp)) { out = out + ch }
        else if (cp < 256) { out = out + "\\x" + pyHexPad(cp, 2) }
        else if (cp < 65536) { out = out + "\\u" + pyHexPad(cp, 4) }
        else { out = out + "\\U" + pyHexPad(cp, 8) }
        k = k + w
    }
    return out + quote
}

function pyRepr(v) {
    if (typeof v == "string") { return pyStrRepr(v) }
    var rc = pyInstClassOf(v)
    if (rc !== null && rc !== undefined) { return pyUserRender(v, rc, true) }
    return pyStr(v)
}

// pyUserRender renders a USER INSTANCE. This half had no such arm at all, so a
// class with a __repr__ printed [object Object] under llvm.Run and the native
// binary where the interpreter and CPython print V(3). It is pyUserRender in
// languages/python-interpreter.abnf and rt.pyUserRender in abnf/jsrt.go, one for
// one: str() and print() prefer __str__ and fall back to __repr__, repr() and
// every CONTAINER element use __repr__ only, an exception falls back to
// Name(args...), and the <Name object> default omits CPython's `at 0x...`
// address, which no engine here can reproduce.
function pyUserRender(v, cls, wantRepr) {
    if (!wantRepr) {
        if (pyLookupHas(cls, "__str__")) {
            var g = pyLookupVal(cls, "__str__")
            if (pyIsCallable(g)) { return pyToStr(pyCallSelf(g, v, [])) }
        }
        // BaseException.__str__, which an exception INHERITS and which therefore
        // beats a __repr__ the class also defines: no args is "", one arg is
        // str(that arg), more is the args TUPLE's repr.
        var ea = v["args"]
        if (Array.isArray(ea)) {
            if (ea.length == 0) { return "" }
            if (ea.length == 1) { return pyStr(ea[0]) }
            var oe = "("
            for (var q = 0; q < ea.length; q++) {
                if (q > 0) { oe = oe + ", " }
                oe = oe + pyRepr(ea[q])
            }
            return oe + ")"
        }
    }
    if (pyLookupHas(cls, "__repr__")) {
        var f = pyLookupVal(cls, "__repr__")
        if (pyIsCallable(f)) { return pyToStr(pyCallSelf(f, v, [])) }
    }
    var nm = cls["__name"]
    if (typeof nm != "string") { nm = "object" }
    var ar = v["args"]
    if (Array.isArray(ar)) {
        var out = nm + "("
        for (var i = 0; i < ar.length; i++) {
            if (i > 0) { out = out + ", " }
            out = out + pyRepr(ar[i])
        }
        return out + ")"
    }
    return "<" + nm + " object>"
}

// abnf/jsrt.go's pyTypeName (9324). A __pybig is an int, which is why the arm is
// ahead of the object arms - Go reaches it earlier because *jsBigInt is not a
// *jsObject and here it IS one.
function pyTypeName(v) {
    if (v === null) { return "NoneType" }
    if (v === undefined) { return "NoneType" }
    if (typeof v == "boolean") { return "bool" }
    if (typeof v == "string") { return "str" }
    if (pyIsBig(v)) { return "int" }
    if (pyIsFlo(v)) { return "float" }
    // A plain number is an INT: 2.0 and 2 are the same double, so nothing about
    // the value can tell the two Python types apart - which is why the float is
    // boxed in the first place.
    if (typeof v == "number") { return "int" }
    if (Array.isArray(v)) { return "list" }
    if (typeof v == "function") { return "function" }
    if (pyIsObj(v)) {
        if (pySetElemsOf(v) != null) { return "set" }
        if (pyIsDict(v)) { return "dict" }
        return "object"
    }
    return "object"
}

// ===================================================== equality and order ===
//
// abnf/jsrt.go's pyEqual (8580). The bigint arms are chunk A's pyABigCmp /
// pyABigEqFloat; they are called from here so every caller of pyEqual gets them.

// The int a bool IS (True is 1, False is 0), against a value that is not a bool.
// The three arms are exactly the three pyEqual takes below for a plain number,
// in the same order, so the two halves answer the same thing for every operand.
function pyEqBoolVal(other, b) {
    var n = b ? 1 : 0
    if (pyIsFlo(other)) { return pyNum(other) == n }
    if (pyIsBig(other)) { return pyABigEqFloat(other, n) }
    if (pyIsCplx(other)) {
        if (pyCplxIm(other) != 0) { return false }
        return pyCplxRe(other) == n
    }
    if (typeof other == "number") { return other == n }
    return false
}

function pyEqual(x, y) {
    var xs = pySetElemsOf(x)
    if (xs != null) {
        var ys = pySetElemsOf(y)
        if (ys == null) { return false }
        if (xs.length != ys.length) { return false }
        for (var i = 0; i < xs.length; i++) {
            if (!pySetHas(ys, xs[i])) { return false }
        }
        return true
    }
    if (pySetElemsOf(y) != null) { return false }
    if (Array.isArray(x)) {
        if (!Array.isArray(y)) { return false }
        if (x.length != y.length) { return false }
        for (var j = 0; j < x.length; j++) {
            if (!pyEqual(x[j], y[j])) { return false }
        }
        return true
    }
    if (pyIsDict(x)) {
        if (!pyIsDict(y)) { return false }
        var xk = x["keys"]
        var yk = y["keys"]
        if (xk.length != yk.length) { return false }
        for (var k = 0; k < xk.length; k++) {
            var p = pyDictFind(yk, xk[k])
            if (p < 0) { return false }
            if (!pyEqual(x["vals"][k], y["vals"][p])) { return false }
        }
        return true
    }
    // A Python bool IS an int - `class bool(int)` - so True == 1, True == 1.0,
    // False == 0 and False == -0.0 all hold, and so does every container equality
    // built on them ([True] == [1], {True: 1} == {1: 1}). The Go twin rewrites the
    // operand in place at this point; MetaJS is TYPED and a variable that held a
    // boolean cannot hold a number, so the arm is taken out of line instead and
    // pyEqBoolVal covers the bigint, the complex and the plain-number case that
    // follow. True == 2 is false because 1 != 2, True == "x" because a string is
    // none of the three.
    if (typeof x == "boolean" || typeof y == "boolean") {
        if (typeof x == "boolean" && typeof y == "boolean") { return x === y }
        if (typeof x == "boolean") { return pyEqBoolVal(y, x) }
        return pyEqBoolVal(x, y)
    }
    if (pyIsBig(x)) {
        if (pyIsBig(y)) { return pyABigCmp(x, y) == 0 }
        if (typeof y == "number") { return pyABigEqFloat(x, y) }
    }
    if (pyIsBig(y)) {
        if (typeof x == "number") { return pyABigEqFloat(y, x) }
    }
    if (pyIsCplx(x)) {
        if (pyIsCplx(y)) {
            if (pyCplxRe(x) != pyCplxRe(y)) { return false }
            return pyCplxIm(x) == pyCplxIm(y)
        }
        if (pyCplxIm(x) != 0) { return false }
        return pyCplxRe(x) == pyNum(y)
    }
    if (pyIsCplx(y)) {
        if (pyCplxIm(y) != 0) { return false }
        return pyCplxRe(y) == pyNum(x)
    }
    // A float equals the int of the same value (1.0 == 1) and two boxes holding
    // the same double are equal though they are two objects.
    if (pyIsFlo(x) || pyIsFlo(y)) {
        if (!pyIsNumeric(x) || !pyIsNumeric(y)) { return false }
        return pyNum(x) == pyNum(y)
    }
    return x === y
}

// ===================================================== classes =============
//
// abnf/jsrt.go's pyClassObj / pyInstance / pyMRO / pyLookup / pyIsDescriptor /
// pyGetAttr / pyInstanceDict / pySetAttr / pySlotAllows / pyAttrError.

function pyClassOf(v) {
    if (pyIsClass(v)) { return v }
    return null
}

function pyInstClassOf(v) {
    if (!pyIsObj(v)) { return null }
    if (v["__mro"] !== undefined) { return null }
    var c = v["__class"]
    if (!pyIsObj(c)) { return null }
    return c
}

// The resolution order of a class, itself first. A class object that predates the
// MRO (an older {__name, __super} exception descriptor) answers with its __super
// chain, so the two shapes stay interchangeable.
function pyMRO(c) {
    var out = []
    var m = c["__mro"]
    if (Array.isArray(m)) {
        for (var i = 0; i < m.length; i++) {
            if (pyIsObj(m[i])) { out.push(m[i]) }
        }
        return out
    }
    var k = c
    while (pyIsObj(k)) {
        out.push(k)
        k = k["__super"]
    }
    return out
}

function pyLookupHas(c, name) {
    if (name == "") { return false }
    var mro = pyMRO(c)
    for (var i = 0; i < mro.length; i++) {
        if (mro[i][name] !== undefined) { return true }
    }
    return false
}

function pyLookupVal(c, name) {
    if (name == "") { return undefined }
    var mro = pyMRO(c)
    for (var i = 0; i < mro.length; i++) {
        if (mro[i][name] !== undefined) { return mro[i][name] }
    }
    return undefined
}

// pyIsDescriptor: an instance whose class defines the given hook.
function pyDescriptor(v, hook) {
    var cls = pyInstClassOf(v)
    if (cls == null) { return undefined }
    var m = pyLookupVal(cls, hook)
    if (typeof m != "function") { return undefined }
    return m
}

// An instance's own attributes as a Python dict (pyInstanceDict). The __-prefixed
// slots are internal and are skipped, which is what Go does with inst.keys.
function pyInstanceDict(inst) {
    var d = pyNewDict()
    var ks = keysOf(inst)
    for (var i = 0; i < ks.length; i++) {
        var k = ks[i]
        if (k.length >= 2 && k.charAt(0) == "_" && k.charAt(1) == "_") { continue }
        d["keys"].push(k)
        d["vals"].push(inst[k])
    }
    return d
}

function pyGetAttr(obj, name) {
    if (pyIsClass(obj)) {
        if (name == "__name__") { return obj["__name"] }
        if (name == "__mro__") { return obj["__mro"] }
        if (pyLookupHas(obj, name)) { return pyLookupVal(obj, name) }
        fail("type object '" + pyToStr(obj["__name"]) + "' has no attribute '" + name + "'")
    }
    var cls = pyInstClassOf(obj)
    if (cls != null) {
        if (name == "__class__") { return cls }
        if (name == "__dict__") { return pyInstanceDict(obj) }
        if (obj[name] !== undefined) { return obj[name] }
        if (pyLookupHas(cls, name)) {
            var v = pyLookupVal(cls, name)
            var get = pyDescriptor(v, "__get__")
            if (get !== undefined) { return get.apply(undefined, [v, obj, cls]) }
            return v
        }
        fail("'" + pyToStr(cls["__name"]) + "' object has no attribute '" + name + "'")
    }
    if (name == "__name__") {
        // A synthetic class object for a BUILTIN type (what type(3) hands out)
        // carries only its name, and a function carries none of its own - the name
        // its def bound it under was recorded by js_pyfnname (chunk B).
        if (pyIsObj(obj)) {
            if (obj["__name"] !== undefined) { return obj["__name"] }
        }
        var fn = rtPairGet(pyBFnObjs, pyBFnNames, obj)
        if (fn !== undefined) { return fn }
    }
    // docs/todo.md 1.2: a BOUND built-in method, so getattr(xs, "count")(1) is
    // the 1 CPython answers rather than whatever pyGetMember made of the name.
    // Ahead of pyGetMember because a dict literally has a "keys" property
    // holding its key ARRAY, and CPython's d.keys is the method.
    if (pyDBuiltinAttr(obj, name)) { return pyDBoundBuiltin(obj, name) }
    // x.__class__ for a value that is not a user instance - the same synthetic
    // class object type(x) hands out, so `[].__class__ is list` holds.
    if (name == "__class__") { return js_pytype(obj) }
    return pyGetMember(obj, name)
}

// rt.getMember for the shapes this value model builds. A dict answers its own
// members, an array its length, a string its length, and anything else the plain
// property.
function pyGetMember(obj, name) {
    if (typeof obj == "string") {
        if (name == "length") { return obj.length }
        return undefined
    }
    if (Array.isArray(obj)) {
        if (name == "length") { return obj.length }
        return undefined
    }
    if (obj === null) { fail("cannot read '" + name + "' of None") }
    if (obj === undefined) { fail("cannot read '" + name + "' of None") }
    return obj[name]
}

function pySlotAllows(slots, name) {
    if (Array.isArray(slots)) {
        for (var i = 0; i < slots.length; i++) {
            if (pyToStr(slots[i]) == name) { return true }
        }
        return false
    }
    if (typeof slots == "string") { return slots == name }
    return true
}

function pySetAttr(obj, name, v) {
    var cls = pyInstClassOf(obj)
    if (cls != null) {
        if (pyLookupHas(cls, name)) {
            var cur = pyLookupVal(cls, name)
            var set = pyDescriptor(cur, "__set__")
            if (set !== undefined) {
                set.apply(undefined, [cur, obj, v])
                return v
            }
        }
        if (pyLookupHas(cls, "__slots__")) {
            if (!pySlotAllows(pyLookupVal(cls, "__slots__"), name)) {
                throw pyExcInstance("AttributeError",
                                    "'" + pyToStr(cls["__name"]) + "' object has no attribute '" + name + "'")
            }
        }
        obj[name] = v
        return v
    }
    if (pyIsClass(obj)) {
        obj[name] = v
        return v
    }
    if (pyIsObj(obj)) {
        obj[name] = v
        return v
    }
    fail("cannot set '" + name + "' on a " + pyTypeName(obj))
    return v
}

// ===================================================== builtin classes ======
//
// pyBuiltinClass hands out ONE stable class object per builtin type name, so
// type(x) is type(y) holds for two values of the same builtin type. The table key is
// "$"-prefixed, which is the intern-key rule of docs/abnf-dialect-gotchas.md.

var pyTypeTable = {}

// The name of a TYPE object - a user class (it carries an __mro) or one of the
// interned builtin type objects. The Ellipsis singleton also carries a __name
// and is deliberately not one. Go: rt.pyClassName.
function pyClassName(v) {
    if (!pyIsObj(v)) { return null }
    var n = v["__name"]
    if (n === undefined) { return null }
    var nm = pyToStr(n)
    if (v["__mro"] !== undefined) { return nm }
    if (pyTypeTable["$" + nm] === v) { return nm }
    return null
}

function pyBuiltinClass(name) {
    var k = "$" + name
    var got = pyTypeTable[k]
    if (got !== undefined) { return got }
    var c = {__name: name}
    pyTypeTable[k] = c
    return c
}

// abnf/jsrt.go's pyExcInstance: the class is a stable per-name object deriving from
// one called Exception, so the name walk of pyIsInstance answers `except Exception`
// (and `except <ThatName>`) for a StopIteration / UnboundLocalError / AttributeError
// the RUNTIME raised, exactly like for one the program raised.
function pyExcInstance(name, msg) {
    var cls = pyBuiltinClass(name)
    if (name != "Exception") {
        if (cls["__super"] === undefined) { cls["__super"] = pyBuiltinClass("Exception") }
    }
    return {__class: cls, args: [msg]}
}

function pyRaiseExc(name, msg) { throw pyExcInstance(name, msg) }

// ===================================================== calling ==============

function pyCall(f, args) { return f.apply(undefined, args) }

function pyCallSelf(f, self, args) {
    var a = [self]
    for (var i = 0; i < args.length; i++) { a.push(args[i]) }
    return f.apply(undefined, a)
}

// ===================================================== sequences ============
//
// abnf/jsrt.go's pySeqElems (8759): the element list of anything a slice assignment
// may take on its right hand side. A GENERATOR is DRAINED, which is the one arm that
// has to be written structurally here (see pyIsGen).

function pyDrainGen(g) {
    var out = []
    var nx = g["next"]
    while (true) {
        var st = nx.apply(g, [])
        if (st === undefined) { return out }
        if (st["done"] === true) { return out }
        out.push(st["value"])
    }
    return out
}

function pySeqElems(v) {
    var els = pySetElemsOf(v)
    if (els != null) {
        var c = []
        for (var i = 0; i < els.length; i++) { c.push(els[i]) }
        return c
    }
    if (Array.isArray(v)) {
        var a = []
        for (var j = 0; j < v.length; j++) { a.push(v[j]) }
        return a
    }
    if (pyIsGen(v)) { return pyDrainGen(v) }
    if (typeof v == "string") {
        var s = []
        var n = pyStrLen(v)
        for (var k = 0; k < n; k++) { s.push(pyStrAt(v, k)) }
        return s
    }
    fail("cannot assign a " + pyTypeName(v) + " to a slice")
    return []
}

// ===================================================== slices ===============
//
// abnf/jsrt.go's pyClampIndex (8729) and pySliceIndices (8699). Go's own
// pySliceRange (2432) has NO counterpart here: every slice this value model
// takes goes through pySliceIndices, whose step-aware clamping answers the
// two-bound case identically, and a second clamper would be a second place to
// keep in step.

function pyClampIndex(i, n, step) {
    var k = i
    if (k < 0) {
        k = k + n
        if (k < 0) {
            if (step < 0) { return 0 - 1 }
            return 0
        }
        return k
    }
    if (k >= n) {
        if (step < 0) { return n - 1 }
        return n
    }
    return k
}

function pySliceIndices(n, loV, hiV, stepV) {
    var step = 1
    if (!pyIsNone(stepV)) {
        step = Math.trunc(pyNum(stepV))
        if (step == 0) { fail("slice step cannot be zero") }
    }
    var lo = 0
    var hi = n
    if (step < 0) {
        lo = n - 1
        hi = (0 - n) - 1
    }
    if (!pyIsNone(loV)) { lo = pyClampIndex(Math.trunc(pyNum(loV)), n, step) }
    if (!pyIsNone(hiV)) { hi = pyClampIndex(Math.trunc(pyNum(hiV)), n, step) }
    var out = []
    var i = lo
    while (true) {
        if (step > 0) {
            if (!(i < hi)) { return out }
        } else {
            if (!(i > hi)) { return out }
        }
        if (i >= 0 && i < n) { out.push(i) }
        i = i + step
    }
    return out
}
// chunkA.metajs -- CHUNK A of languages/lib/python-rt.metajs: NUMBERS,
// OPERATORS and CONVERSIONS, plus the arbitrary precision integer.
//
// THE AUTHORITATIVE SPECIFICATION IS abnf/jsrt.go, not its comments. Every block
// below names the Go function it ports. Where the port CANNOT be exact the site
// says so in full.
//
// Ported here:
//     js_pybin      abnf/jsrt.go:7540   (reaching pySetBin, pyComplexBin,
//                                        pyDunderBin, pyArith, pyFloorMod,
//                                        pyContains, pySeqRepeat, jsAdd,
//                                        jsCompare, pyEqual, toInt32)
//     js_pyunary    abnf/jsrt.go:7757
//     js_pyint      abnf/jsrt.go:7741
//     js_pyfloat    abnf/jsrt.go:7994
//     js_pybool     abnf/jsrt.go:7981
//     js_pycomplex  abnf/jsrt.go:7359
//     js_pysum      abnf/jsrt.go:8000
//     js_pymax / js_pymin   abnf/jsrt.go:7651 -> pyMinMax (jsrt.go:9557)
//     js_pyrange    abnf/jsrt.go:7142
//     js_pyeq       abnf/jsrt.go:7179
//     js_jadd       abnf/jsrt.go:5151
//     js_bigint     abnf/jsrt.go:5366
//
// js_lt is a FLOOR extern and is deliberately absent.

// ============================================================================
// The arbitrary precision integer   (Go: *jsBigInt over math/big, jsrt.go:2561,
// bigPair jsrt.go:2710, bigArith jsrt.go:2724, bigEqFloat jsrt.go:8650)
// ============================================================================
//
// The representation is {__pybig: true, neg: <bool>, limbs: [...]}: the
// MAGNITUDE as a LITTLE-ENDIAN array of base-10000 limbs and a separate sign, so
// every intermediate of the schoolbook algorithms below stays under 10^8 and a
// double holds it EXACTLY. The shape of the limb arithmetic is lifted from
// languages/lib/ruby-rt.metajs (rbBigFromNum / rbBigMulSmall / rbBigStr).
//
// Zero is canonical: limbs == [0] and neg == false, so pyABigCmp needs no
// negative-zero case.
//
// WHAT IS DELIBERATELY NOT IMPLEMENTED, and why:
//
//   * A bignum SHIFT and a bignum BITWISE and/or/xor. Go never has one either:
//     js_pybin's "|" "&" "^" "<<" ">>" arms run rt.toInt32, and toInt32 goes
//     through rt.toNumber, whose *jsBigInt arm does not exist - it falls into
//     the default and answers NaN, hence 0. A big meeting a bit operator is 0 in
//     Go and is 0 here.
//
//   * A bignum <-> double CONVERSION. Same reason: Go's rt.toNumber has NO
//     *jsBigInt case, so `bigval // 2`, `bigval % 2`, `bigval ** 2`, float(big)
//     and int(float) of a big all see NaN in Go. Reproducing that only needs the
//     PRELUDE's pyNum to answer NaN for a plain object, which it does; nothing
//     is needed here. pyABigFromNum below is the one direction that IS needed
//     (bigEqFloat), and it is exact.
//
//   * Base-0 literal parsing. Go's js_bigint calls big.Int.SetString(s, 0),
//     which also accepts 0x / 0o / 0b prefixes and a leading-zero OCTAL. The one
//     caller, makeIntLit in languages/python-to-llvm-ir.abnf:1216, reaches
//     js_bigint ONLY on the radix-10 branch with the '_' separators already
//     stripped, so pyABigFromStr accepts a sign and decimal digits only and
//     fails loudly on anything else - exactly where Go's `!ok` fails.
//
//   * Karatsuba / Knuth-D. The multiplication is O(n*m) schoolbook and the
//     division is a per-limb BINARY SEARCH for the quotient digit (14 compares a
//     limb). The reachable operands are Python integer literals, so this is
//     small and exact rather than fast.

function pyABigNorm(limbs) {
    var out = limbs
    while (out.length > 1 && out[out.length - 1] == 0) { out.pop() }
    if (out.length == 0) { out.push(0) }
    return out
}

function pyABigNew(neg, limbs) {
    var ls = pyABigNorm(limbs)
    var n = neg
    if (ls.length == 1 && ls[0] == 0) { n = false }
    return {__pybig: true, neg: n, limbs: ls}
}

function pyABigIsZero(v) {
    var ls = v["limbs"]
    return ls.length == 1 && ls[0] == 0
}

// |a| <=> |b| over two NORMALIZED limb arrays.
function pyABigCmpMag(a, b) {
    if (a.length != b.length) { return a.length < b.length ? -1 : 1 }
    var i = a.length - 1
    while (i >= 0) {
        if (a[i] != b[i]) { return a[i] < b[i] ? -1 : 1 }
        i = i - 1
    }
    return 0
}

// The signed comparison - Go's big.Int.Cmp, which jsCompare and pyEqual use.
function pyABigCmp(x, y) {
    if (x["neg"] != y["neg"]) { return x["neg"] ? -1 : 1 }
    var c = pyABigCmpMag(x["limbs"], y["limbs"])
    if (x["neg"]) { return -c }
    return c
}

function pyABigAddMag(a, b) {
    var out = []
    var carry = 0
    var n = a.length
    if (b.length > n) { n = b.length }
    var i = 0
    while (i < n) {
        var av = i < a.length ? a[i] : 0
        var bv = i < b.length ? b[i] : 0
        var s = av + bv + carry
        if (s >= 10000) {
            carry = 1
            s = s - 10000
        } else {
            carry = 0
        }
        out.push(s)
        i = i + 1
    }
    if (carry > 0) { out.push(carry) }
    return out
}

// |a| - |b|, and the caller guarantees |a| >= |b|.
function pyABigSubMag(a, b) {
    var out = []
    var borrow = 0
    var i = 0
    while (i < a.length) {
        var bv = i < b.length ? b[i] : 0
        var s = a[i] - bv - borrow
        if (s < 0) {
            s = s + 10000
            borrow = 1
        } else {
            borrow = 0
        }
        out.push(s)
        i = i + 1
    }
    return pyABigNorm(out)
}

// A magnitude times a single limb (0..9999), as a FRESH array: the division
// below needs the multiplicand left alone, unlike ruby-rt's in-place rbBigMulSmall.
function pyABigMulSmall(limbs, k) {
    var out = []
    var carry = 0
    var i = 0
    while (i < limbs.length) {
        var v = limbs[i] * k + carry
        carry = Math.floor(v / 10000)
        out.push(v - carry * 10000)
        i = i + 1
    }
    while (carry > 0) {
        var c2 = Math.floor(carry / 10000)
        out.push(carry - c2 * 10000)
        carry = c2
    }
    return pyABigNorm(out)
}

function pyABigNeg(x) {
    var ls = []
    var i = 0
    while (i < x["limbs"].length) {
        ls.push(x["limbs"][i])
        i = i + 1
    }
    return pyABigNew(!x["neg"], ls)
}

function pyABigAdd(x, y) {
    if (x["neg"] == y["neg"]) { return pyABigNew(x["neg"], pyABigAddMag(x["limbs"], y["limbs"])) }
    var c = pyABigCmpMag(x["limbs"], y["limbs"])
    if (c == 0) { return pyABigNew(false, [0]) }
    if (c > 0) { return pyABigNew(x["neg"], pyABigSubMag(x["limbs"], y["limbs"])) }
    return pyABigNew(y["neg"], pyABigSubMag(y["limbs"], x["limbs"]))
}

function pyABigSub(x, y) { return pyABigAdd(x, pyABigNeg(y)) }

function pyABigMul(x, y) {
    var a = x["limbs"]
    var b = y["limbs"]
    var out = []
    var z = 0
    while (z < a.length + b.length) {
        out.push(0)
        z = z + 1
    }
    var i = 0
    while (i < a.length) {
        var carry = 0
        var j = 0
        while (j < b.length) {
            var cur = out[i + j] + a[i] * b[j] + carry
            carry = Math.floor(cur / 10000)
            out[i + j] = cur - carry * 10000
            j = j + 1
        }
        var k = i + b.length
        while (carry > 0) {
            var cur2 = out[k] + carry
            carry = Math.floor(cur2 / 10000)
            out[k] = cur2 - carry * 10000
            k = k + 1
        }
        i = i + 1
    }
    return pyABigNew(x["neg"] != y["neg"], pyABigNorm(out))
}

// |a| divided by |b| -> {q, r}, both NORMALIZED limb arrays. Schoolbook long
// division a limb at a time; the quotient limb is found by binary search over
// 0..9999 because there is no wide-multiply primitive to estimate it with.
// The caller has already rejected a zero divisor.
function pyABigDivMag(a, b) {
    var qms = []
    var rem = [0]
    var i = a.length - 1
    while (i >= 0) {
        // rem = rem * 10000 + a[i], which in little-endian is a PREPENDED limb.
        var shifted = [a[i]]
        if (!(rem.length == 1 && rem[0] == 0)) {
            var t = 0
            while (t < rem.length) {
                shifted.push(rem[t])
                t = t + 1
            }
        }
        rem = pyABigNorm(shifted)
        var lo = 0
        var hi = 9999
        var d = 0
        while (lo <= hi) {
            var mid = Math.floor((lo + hi) / 2)
            if (pyABigCmpMag(pyABigMulSmall(b, mid), rem) <= 0) {
                d = mid
                lo = mid + 1
            } else {
                hi = mid - 1
            }
        }
        qms.push(d)
        rem = pyABigSubMag(rem, pyABigMulSmall(b, d))
        i = i - 1
    }
    // qms came out most-significant first; the representation is little-endian.
    var q = []
    var m = qms.length - 1
    while (m >= 0) {
        q.push(qms[m])
        m = m - 1
    }
    return {q: pyABigNorm(q), r: pyABigNorm(rem)}
}

// Go's big.Int.Quo: TRUNCATED toward zero, so the sign is the sign of the product.
function pyABigQuo(x, y) {
    return pyABigNew(x["neg"] != y["neg"], pyABigDivMag(x["limbs"], y["limbs"])["q"])
}

// Go's big.Int.Rem: the remainder takes the sign of the DIVIDEND.
function pyABigRem(x, y) {
    return pyABigNew(x["neg"], pyABigDivMag(x["limbs"], y["limbs"])["r"])
}

// Go: big.Int.String().
function pyABigStr(v) {
    var limbs = v["limbs"]
    var out = "" + limbs[limbs.length - 1]
    var i = limbs.length - 2
    while (i >= 0) {
        var s = "" + limbs[i]
        while (s.length < 4) { s = "0" + s }
        out = out + s
        i = i - 1
    }
    if (v["neg"]) { return "-" + out }
    return out
}

// Go: big.Int.SetString(text, 0) - see the note above on why only base 10 with
// an optional sign (and the '_' separators Python allows, which the emitter has
// already stripped) is accepted.
function pyABigFromStr(text) {
    var s = text
    var neg = false
    var i = 0
    if (s.charAt(0) == "-") {
        neg = true
        i = 1
    } else {
        if (s.charAt(0) == "+") { i = 1 }
    }
    var digits = ""
    while (i < s.length) {
        var c = s.charAt(i)
        if (c != "_") {
            if (c < "0" || c > "9") { pyFail("invalid BigInt literal " + text) }
            digits = digits + c
        }
        i = i + 1
    }
    if (digits.length == 0) { pyFail("invalid BigInt literal " + text) }
    var limbs = []
    var end = digits.length
    while (end > 0) {
        var from = end - 4
        if (from < 0) { from = 0 }
        limbs.push(parseInt(digits.substring(from, end), 10))
        end = from
    }
    return pyABigNew(neg, limbs)
}

// An INTEGRAL, FINITE double as an exact bignum - Go's big.NewFloat(f).Int(nil),
// which bigEqFloat uses. An integral double above 2^53 is a multiple of 2, so
// halving it down to a 53 bit mantissa and doubling the bignum back up loses
// nothing (the same argument ruby-rt.metajs's rbExactDec makes).
function pyABigFromNum(n) {
    var neg = n < 0
    var m = Math.abs(n)
    var e = 0
    while (m > 9007199254740992) {
        m = m / 2
        e = e + 1
    }
    var limbs = []
    var x = m
    while (x > 0) {
        var q = Math.floor(x / 10000)
        limbs.push(x - q * 10000)
        x = q
    }
    if (limbs.length == 0) { limbs.push(0) }
    var ls = limbs
    var k = 0
    while (k < e) {
        ls = pyABigMulSmall(ls, 2)
        k = k + 1
    }
    return pyABigNew(neg, ls)
}

// Go: bigEqFloat (jsrt.go:8650). Only an integral, finite double can equal an
// arbitrary precision int. `f - f != 0` is the finiteness test: it is NaN for
// both an infinity and a NaN and exactly 0 for everything else - there is no
// isFinite and no exponent literal in this dialect.
function pyABigEqFloat(x, f) {
    if (f - f != 0) { return false }
    if (f != Math.trunc(f)) { return false }
    return pyABigCmp(x, pyABigFromNum(f)) == 0
}

// Go: bigArith (jsrt.go:2724), including bigPair's rule that BOTH operands must
// be bigs - a big meeting a double falls back to the double path, where the big
// converts to NaN. Answers null for "not applicable", never a value, so the
// caller can tell it apart from a legitimate result.
// Go: pyBigOperand (jsrt.go). An exact bignum for a Python int operand: a big as
// itself, an integral double inside the exactly representable range as itself,
// a bool as 0/1. A float box, a non-integral double and anything past 2^53 - where
// the double is ALREADY an approximation - answer null, so the caller falls back
// to the double path rather than inventing precision the operand never had.
function pyABigOperand(v) {
    if (pyIsBig(v)) { return v }
    if (typeof v == "boolean") {
        if (v) { return pyABigFromNum(1) }
        return pyABigFromNum(0)
    }
    if (typeof v == "number") {
        if (v == Math.trunc(v) && Math.abs(v) <= 9007199254740992) { return pyABigFromNum(v) }
    }
    return null
}

// Go: rt.pyBigNarrow, and the interpreter grammar's bigOut. A big that still fits
// in the exactly representable range comes back as a plain number, so only the
// values that GENUINELY need arbitrary precision carry the {__pybig} shape.
// The reconstruction can ROUND when the true value is past 2^53, so the answer is
// checked by rebuilding the limbs from it - pyABigFromNum is exact, so a mismatch
// means the double is not the value.
function pyABigNarrow(x) {
    var limbs = x["limbs"]
    if (limbs.length > 4) { return x }
    var v = 0
    var i = limbs.length - 1
    while (i >= 0) {
        v = v * 10000 + limbs[i]
        i = i - 1
    }
    if (v > 9007199254740992) { return x }
    if (pyABigCmpMag(pyABigFromNum(v)["limbs"], limbs) != 0) { return x }
    if (x["neg"]) { return 0 - v }
    return v
}

// Go: big.Int.Exp with a nil modulus, and the interpreter grammar's bigPow. The
// exponent is capped by the caller at 4096, so the linear loop is what both other
// engines use too.
function pyABigPow(x, n) {
    var acc = pyABigFromNum(1)
    var i = 0
    while (i < n) {
        acc = pyABigMul(acc, x)
        i = i + 1
    }
    return acc
}

// Go: pyBigBin (jsrt.go). Python's integer arithmetic in arbitrary precision.
// `//` and `%` FLOOR, as Python's do: pyABigQuo/pyABigRem truncate (Go's Quo/Rem),
// which is not Python's answer for a negative divisor - 1e30 % -7 is -6, not +1.
// null for an operator with no exact integer form, so the caller falls through to
// the double path it always had.
function pyABigBin(op, x, y) {
    if (op == "+") { return pyABigAdd(x, y) }
    if (op == "-") { return pyABigSub(x, y) }
    if (op == "*") { return pyABigMul(x, y) }
    if (op == "//" || op == "%") {
        if (pyABigIsZero(y)) { return null } // Let the double path raise the usual error.
        var q = pyABigQuo(x, y)
        var rm = pyABigRem(x, y)
        if (!pyABigIsZero(rm) && rm["neg"] != y["neg"]) {
            if (op == "//") { return pyABigSub(q, pyABigFromNum(1)) }
            return pyABigAdd(rm, y)
        }
        if (op == "//") { return q }
        return rm
    }
    if (op == "**") {
        if (y["neg"]) { return null }
        var e = pyABigNarrow(y)
        if (typeof e != "number") { return null }
        if (e > 4096) { return null }
        return pyABigPow(x, e)
    }
    return null
}

// ----- the BITWISE operators, at arbitrary precision -------------------------
//
// Go: pyBitBin (abnf/jsrt.go), which is math/big's And/Or/Xor/Lsh/Rsh/Not.
//
// Both halves used to run the floor's ECMAScript |, &, ^, << and >>, which are
// ToInt32 and a shift count masked to five bits: `-1 & 0xffffffff` was -1 where
// CPython says 4294967295, `1 << 40` was 256, and every operand past 2^31 was
// truncated. BOTH HALVES AGREED, so --cross and the matrix could not see any of
// it; python3 3.14.6 is the oracle. 439 of 944 rows of a differential probe.
//
// Python's rule is INFINITE two's complement: a negative x behaves like the
// endless run of 1 bits above ~(|x| - 1). Working on magnitudes only, that is
// four identities per operator, all of them in terms of AND, OR, XOR and ANDNOT
// over NON-NEGATIVE bit strings:
//
//   -a & b   ==  b &~ (a-1)            -a | b   == -((a-1) &~ b + 1)
//   a & -b   ==  a &~ (b-1)            a | -b   == -((b-1) &~ a + 1)
//   -a & -b  == -(((a-1) | (b-1)) + 1) -a | -b  == -(((a-1) & (b-1)) + 1)
//   -a ^ b   == -(((a-1) ^ b) + 1)     -a ^ -b  ==  (a-1) ^ (b-1)
//
// The magnitude is carried as a LITTLE-ENDIAN array of single bits: the stored
// bignum is base-10000 decimal limbs, so a bit view has to be built by repeated
// halving either way, and once it is built the increments and decrements the
// identities need are two-line loops on it rather than bignum additions.
//
// js_pybin keeps a fast path in front of all of this for the case that actually
// runs in a loop - two operands inside int32 - where ECMAScript's own operators
// ARE the infinite two's complement answer.

var PY_BIT_AND = 0
var PY_BIT_OR = 1
var PY_BIT_XOR = 2
var PY_BIT_ANDNOT = 3

// The largest shift count honoured. CPython answers a MemoryError somewhere above
// this; the cap keeps `1 << 10**9` from asking for a gigabyte of limbs.
var PY_BIT_SHIFT_MAX = 1048576

// The magnitude of a bignum as little-endian BITS, by repeated halving of a copy
// of the limbs. Zero answers the empty array.
function pyABitsFromLimbs(limbs) {
    var ls = []
    var i = 0
    while (i < limbs.length) {
        ls.push(limbs[i])
        i = i + 1
    }
    var bits = []
    while (!(ls.length == 1 && ls[0] == 0)) {
        var rem = 0
        var j = ls.length - 1
        while (j >= 0) {
            var cur = rem * 10000 + ls[j]
            var q = Math.floor(cur / 2)
            ls[j] = q
            rem = cur - q * 2
            j = j - 1
        }
        while (ls.length > 1 && ls[ls.length - 1] == 0) { ls.pop() }
        bits.push(rem)
    }
    return bits
}

function pyABitsTrim(bits) {
    while (bits.length > 0 && bits[bits.length - 1] == 0) { bits.pop() }
    return bits
}

// bits - 1, IN PLACE; the caller only ever hands this a magnitude of at least 1.
function pyABitsDec(bits) {
    var i = 0
    while (i < bits.length && bits[i] == 0) {
        bits[i] = 1
        i = i + 1
    }
    if (i < bits.length) { bits[i] = 0 }
    return pyABitsTrim(bits)
}

// bits + 1, IN PLACE.
function pyABitsInc(bits) {
    var i = 0
    while (i < bits.length && bits[i] == 1) {
        bits[i] = 0
        i = i + 1
    }
    if (i == bits.length) { bits.push(1) } else { bits[i] = 1 }
    return bits
}

function pyABitsOp(kind, a, b) {
    var n = a.length
    if (b.length > n) { n = b.length }
    var out = []
    var i = 0
    while (i < n) {
        var x = i < a.length ? a[i] : 0
        var y = i < b.length ? b[i] : 0
        var r = 0
        if (kind == PY_BIT_AND) {
            if (x == 1 && y == 1) { r = 1 }
        } else if (kind == PY_BIT_OR) {
            if (x == 1 || y == 1) { r = 1 }
        } else if (kind == PY_BIT_XOR) {
            if (x != y) { r = 1 }
        } else {
            if (x == 1 && y == 0) { r = 1 }
        }
        out.push(r)
        i = i + 1
    }
    return pyABitsTrim(out)
}

function pyABitsShl(bits, k) {
    if (bits.length == 0) { return [] }
    var out = []
    var i = 0
    while (i < k) {
        out.push(0)
        i = i + 1
    }
    var j = 0
    while (j < bits.length) {
        out.push(bits[j])
        j = j + 1
    }
    return out
}

function pyABitsShr(bits, k) {
    var out = []
    var i = k
    while (i < bits.length) {
        out.push(bits[i])
        i = i + 1
    }
    return pyABitsTrim(out)
}

// A bit array back to a bignum, by the schoolbook doubling the limbs already have.
function pyABitsToBig(neg, bits) {
    var limbs = [0]
    var j = bits.length - 1
    while (j >= 0) {
        limbs = pyABigMulSmall(limbs, 2)
        if (bits[j] == 1) { limbs = pyABigAddMag(limbs, [1]) }
        j = j - 1
    }
    return pyABigNew(neg, limbs)
}

// A SHIFT COUNT as a plain number. Anything past the cap answers a value the
// caller will reject, so an absurd count never allocates.
function pyABitsToNum(bits) {
    if (bits.length > 40) { return PY_BIT_SHIFT_MAX + 1 }
    var acc = 0
    var p = 1
    var i = 0
    while (i < bits.length) {
        if (bits[i] == 1) { acc = acc + p }
        p = p * 2
        i = i + 1
    }
    return acc
}

// Python's |, &, ^, << and >> over two exact ints. null for a shift count that is
// negative (CPython raises ValueError) or past the cap.
function pyABitBin(op, x, y) {
    var an = x["neg"]
    var bn = y["neg"]
    var a = pyABitsFromLimbs(x["limbs"])
    var b = pyABitsFromLimbs(y["limbs"])
    if (op == "<<" || op == ">>") {
        if (bn) { return null }
        var k = pyABitsToNum(b)
        if (k > PY_BIT_SHIFT_MAX) { return null }
        if (op == "<<") { return pyABitsToBig(an, pyABitsShl(a, k)) }
        if (!an) { return pyABitsToBig(false, pyABitsShr(a, k)) }
        // floor(-a / 2^k) is -(((a-1) >> k) + 1), which is Python's -5 >> 1 == -3.
        return pyABitsToBig(true, pyABitsInc(pyABitsShr(pyABitsDec(a), k)))
    }
    if (op == "&") {
        if (!an && !bn) { return pyABitsToBig(false, pyABitsOp(PY_BIT_AND, a, b)) }
        if (an && !bn) { return pyABitsToBig(false, pyABitsOp(PY_BIT_ANDNOT, b, pyABitsDec(a))) }
        if (!an && bn) { return pyABitsToBig(false, pyABitsOp(PY_BIT_ANDNOT, a, pyABitsDec(b))) }
        return pyABitsToBig(true, pyABitsInc(pyABitsOp(PY_BIT_OR, pyABitsDec(a), pyABitsDec(b))))
    }
    if (op == "|") {
        if (!an && !bn) { return pyABitsToBig(false, pyABitsOp(PY_BIT_OR, a, b)) }
        if (an && !bn) { return pyABitsToBig(true, pyABitsInc(pyABitsOp(PY_BIT_ANDNOT, pyABitsDec(a), b))) }
        if (!an && bn) { return pyABitsToBig(true, pyABitsInc(pyABitsOp(PY_BIT_ANDNOT, pyABitsDec(b), a))) }
        return pyABitsToBig(true, pyABitsInc(pyABitsOp(PY_BIT_AND, pyABitsDec(a), pyABitsDec(b))))
    }
    if (op == "^") {
        if (!an && !bn) { return pyABitsToBig(false, pyABitsOp(PY_BIT_XOR, a, b)) }
        if (an && bn) { return pyABitsToBig(false, pyABitsOp(PY_BIT_XOR, pyABitsDec(a), pyABitsDec(b))) }
        if (an) { return pyABitsToBig(true, pyABitsInc(pyABitsOp(PY_BIT_XOR, pyABitsDec(a), b))) }
        return pyABitsToBig(true, pyABitsInc(pyABitsOp(PY_BIT_XOR, a, pyABitsDec(b))))
    }
    return null
}

// 2^k as an exact double, for k <= 1024. There is no exponent literal in the
// dialect and Math.pow is not part of it either, so it is a doubling loop.
function pyABitPow2(k) {
    var v = 1
    var i = 0
    while (i < k) {
        v = v * 2
        i = i + 1
    }
    return v
}

// ~x is -x - 1 in Python's infinite two's complement, at arbitrary precision.
function pyABitNot(x) {
    return pyABigSub(pyABigNeg(x), pyABigFromNum(1))
}

// An operand of a bit operator that ECMAScript's int32 operators already answer
// EXACTLY: inside int32 the two representations of a value coincide, and so do
// their |, & and ^ results, so the hot path costs one range test and no bignum.
function pyABitIsSmall(v) {
    if (typeof v != "number") { return false }
    // `v | 0` IS ToInt32, so this one test covers the range, the integrality, a
    // NaN and an infinity at once.
    return (v | 0) === v
}

// An operand of a shift that a plain double answers exactly: any integral value
// the double range holds without loss.
function pyABitIsExactInt(v) {
    if (typeof v != "number") { return false }
    if (v != Math.trunc(v)) { return false }
    return v >= 0 - 9007199254740992 && v <= 9007199254740992
}

// Go: pyBigPair (jsrt.go). Both operands as exact bignums when AT LEAST ONE is a
// big and the other is an exact Python int. Python has ONE int type and it is
// arbitrary precision, so an int operand meeting a big PROMOTES - which is why
// this is not pyABigArith below, whose ECMAScript-shaped rule (BOTH sides big)
// the generic externals need.
function pyABigPair(l, r) {
    if (!pyIsBig(l) && !pyIsBig(r)) { return null }
    var x = pyABigOperand(l)
    if (x === null) { return null }
    var y = pyABigOperand(r)
    if (y === null) { return null }
    return {x: x, y: y}
}

function pyABigArith(op, l, r) {
    if (!pyIsBig(l)) { return null }
    if (!pyIsBig(r)) { return null }
    if (op == "+") { return pyABigAdd(l, r) }
    if (op == "-") { return pyABigSub(l, r) }
    if (op == "*") { return pyABigMul(l, r) }
    if (op == "/") {
        if (pyABigIsZero(r)) { return null } // Let the double path produce Inf/NaN.
        return pyABigQuo(l, r)
    }
    if (op == "%") {
        // Unreachable from Python (js_pybin's "%" is pyFloorMod on doubles), but
        // bigArith has the arm and the division already answers both halves.
        if (pyABigIsZero(r)) { return null }
        return pyABigRem(l, r)
    }
    return null
}

// ============================================================================
// The shared scalar helpers  (Go: rt.truthy, rt.typeOf, rt.strictEq, jsCompare,
// pyEqual, pyFloorMod)
// ============================================================================

// Go: rt.truthy (jsrt.go:~910). A big is truthy when its sign is not 0.
function pyATruthy(v) {
    if (v === null) { return false }
    if (v === undefined) { return false }
    if (typeof v == "boolean") { return v }
    if (typeof v == "number") { return v != 0 && v == v }
    if (typeof v == "string") { return v.length > 0 }
    if (pyIsBig(v)) { return !pyABigIsZero(v) }
    // 0.0 is falsy and NaN is TRUTHY (Go's truthy has no `t.f == t.f` on the
    // Python box); every other object is truthy.
    if (pyIsFlo(v)) { return v["__flo"] != 0 }
    return true
}

// Go: rt.typeOf (jsrt.go:1523) - the JAVASCRIPT typeof, which is what the two
// failure messages of js_pybin and js_pysum interpolate. It is NOT pyTypeName.
function pyAJsTypeOf(v) {
    if (v === undefined) { return "undefined" }
    if (v === null) { return "object" }
    if (pyIsBig(v)) { return "bigint" }
    if (pyIsFlo(v)) { return "number" } // Go: rt.typeOf's jsPyFlo arm.
    if (typeof v == "boolean") { return "boolean" }
    if (typeof v == "number") { return "number" }
    if (typeof v == "string") { return "string" }
