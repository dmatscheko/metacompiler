    if (mv === undefined || mv === null) {
        pyRaiseExc("AttributeError",
                   "'" + pyTypeName(obj) + "' object has no attribute '" + name + "'")
    }
    return mv
}

// rt.getMember for the shapes this value model builds. A dict answers its own
// members, an array its length, a string its length, and anything else the plain
// property.
function pyGetMember(obj, name) {
    if (typeof obj == "string") {
        if (name == "length") { return obj.length }
        return undefined
    }
    if (Array.isArray(obj)) {
        if (name == "length") { return obj.length }
        return undefined
    }
    if (obj === null) { fail("cannot read '" + name + "' of None") }
    if (obj === undefined) { fail("cannot read '" + name + "' of None") }
    return obj[name]
}

// pySlotAllows answers whether ONE __slots__ declaration (a list, a
// tuple-as-list or a single string) names an attribute.
function pySlotAllows(slots, name) {
    if (Array.isArray(slots)) {
        for (var i = 0; i < slots.length; i++) {
            if (pyToStr(slots[i]) == name) { return true }
        }
        return false
    }
    if (typeof slots == "string") { return slots == name }
    return false
}

// pySlotsAllow applies __slots__ over the WHOLE resolution order, which is
// CPython's rule (not the nearest declaration): a name is writable if ANY class
// on the MRO declares it in its own __slots__, and any name at all is writable as
// soon as one class on the MRO declares no __slots__ (that class gives its
// instances a __dict__). Go: rt.pySlotsAllow.
function pySlotsAllow(cls, name) {
    var mro = pyMRO(cls)
    var all = true
    var i = 0
    while (i < mro.length) {
        var sl = mro[i]["__slots__"]
        if (sl === undefined) { all = false } else {
            if (pySlotAllows(sl, name)) { return true }
        }
        i = i + 1
    }
    return !all
