    if (limbs.length == 0) { limbs.push(0) }
    return limbs
}

function pyBBigMulSmall(limbs, k) {
    var carry = 0
    var i = 0
    while (i < limbs.length) {
        var v = limbs[i] * k + carry
        carry = Math.floor(v / 10000)
        limbs[i] = v - carry * 10000
        i = i + 1
    }
    while (carry > 0) {
        var c2 = Math.floor(carry / 10000)
        limbs.push(carry - c2 * 10000)
        carry = c2
    }
    return limbs
}

function pyBBigStr(limbs) {
    var out = "" + limbs[limbs.length - 1]
    var i = limbs.length - 2
    while (i >= 0) {
        var s = "" + limbs[i]
        while (s.length < 4) { s = "0" + s }
        out = out + s
        i = i - 1
