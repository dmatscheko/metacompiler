    var mapped = false
    var i = 0
    while (i < f.length) {
        var c = f.charAt(i)
        if (c != "%") { out = out + c ; i = i + 1 ; continue }
        i = i + 1
        if (i >= f.length) { pyRaiseExc("ValueError", "incomplete format") }
        if (f.charAt(i) == "%") { out = out + "%" ; i = i + 1 ; continue }
        var key = ""
