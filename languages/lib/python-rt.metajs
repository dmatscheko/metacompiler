// ================================================== the externs =============

// ----- js_dict_new (jsrt.go:6369) -------------------------------------------
// An empty Python dict handle. Identical to the dart-rt.metajs twin.
// js_dict_new is SHARED - lib/runtime.metajs (six identical copies, no knobs).


// ----- js_pyget (jsrt.go:6297) ----------------------------------------------
