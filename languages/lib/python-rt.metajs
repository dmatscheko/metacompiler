// Go: js_pysorted. sorted(iterable, /, *, key=None, reverse=False): list.sort
// on a new list, bound by its signature as [positionals, keywords].
function js_pysorted(args) {
    var pos = args[0]
    if (pos.length != 1) {
        pyRaiseExc("TypeError", "sorted expected 1 argument, got " + pyIntStr(pos.length))
    }
    var a = pyCCopyArr(pyElemsOf(pos[0]))
    pySortList(a, [], args[1])
