// the status is 1. Go: js_pyuncaught.
function pyExitIfSystemExit(v) {
    if (pyInstClassOf(v) === null || !pyDIsInstance(v, pyExcClass("SystemExit"))) { return undefined }
    var code = anytype
    code = pyExitCode(v)
