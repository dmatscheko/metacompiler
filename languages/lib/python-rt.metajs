// ============================================================================
// Containers, indexing, slicing and destructuring (the pyC* helpers).
//
// Each extern below names the abnf/jsrt.go function it ports. Python's are the
// fullest of the layer-2 copies: the `__getitem__` / `__setitem__` / `__len__`
// dunder arms (a Python class may define them), the generic-alias arm of
// js_pyidx (list[int] is a VALUE in Python), the set arm and the code-POINT
// string indexing of js_pyidx and length of js_pylen.
//
// ============================================================================


// ----- module state ---------------------------------------------------------

// rt.pyAliases: the memo table of pyGenericAlias. Keyed by the rendered
// "origin[param]" text with the mandatory "$" prefix, so a user type called
// "constructor" or "toString" cannot collide with an Object.prototype member
// and make goja and -frozen disagree about which keys exist.
var pyCAliases = {}

// rt.pyEllipsis: the ONE ellipsis object of the runtime, so `x is ...` holds.
var pyCEllipsis = null


// ----- small shared helpers -------------------------------------------------

// rt.truthy, for the flag arguments the pattern externs take. The emitter only
// ever writes hTrue / hFalse into them, but Go really does call rt.truthy.
function pyCTruthy(v) {
    if (v === true) { return true }
    if (v === false) { return false }
    if (rtIsNil(v)) { return false }
    if (typeof v == "number") { return v !== 0 && v === v }
    if (typeof v == "string") { return v.length > 0 }
    return true
}

// A fresh copy of an array (Go's `append([]interface{}{}, xs...)`).
function pyCCopyArr(xs) {
    var out = []
    var i = 0
    var n = xs.length
    while (i < n) {
        out.push(xs[i])
        i = i + 1
    }
    return out
}

// jsGenerator.drain: materialize what is left of a generator.
// There is no tag test in layer 2, so the caller decides with pyIsGen and this
// only drives the protocol: next() -> {value, done} until done.
function pyCDrain(g) {
    var out = []
    var next = g["next"]
    if (!pyIsFn(next)) { return out }
    while (true) {
        var st = next.apply(g, [])
        if (!pyIsObj(st)) { break }
        if (st["done"] === true) { break }
        out.push(st["value"])
    }
    return out
}

// rt.pyClampIndex: one written slice bound as a position -
// negative counts from the end, out of range clamps to the edge the step runs
// towards. Only pyCSliceStart below needs it; the full index list comes from
// the prelude's pySliceIndices.
function pyCClampIndex(i_in, n, step) {
    var i = i_in
    if (i < 0) {
        i = i + n
        if (i < 0) {
            if (step < 0) { return -1 }
            return 0
        }
        return i
    }
    if (i >= n) {
        if (step < 0) { return n - 1 }
        return n
    }
    return i
