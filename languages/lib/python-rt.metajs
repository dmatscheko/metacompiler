// ===================================================== format ===============
//
// js_pyformat is rt.pyFormat in abnf/jsrt.go, where the rules are described:
// CPython's format mini-language per type, with CPython's errors.

function pyBIsAlign(ch) { return ch == "<" || ch == ">" || ch == "^" || ch == "=" }

