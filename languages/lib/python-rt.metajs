    if (pyIsCplx(obj)) {
        if (name == "real") { return pyMkFlo(pyCplxRe(obj)) }
        if (name == "imag") { return pyMkFlo(pyCplxIm(obj)) }
    }
    if (pyIsObj(obj)) {
        if (obj[name] !== undefined) { return obj[name] }
