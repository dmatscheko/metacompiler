// strict zip's check once source k ran out: a later k is shorter than the ones
// before it; k == 0 asks whether any other source still has an item.
function pyAZipStrict(ss, k) {
    var j = k
    var what = "shorter"
    if (k == 0) {
        what = "longer"
        j = 1
        while (j < ss.length && pyAStep(ss[j])["done"] === true) { j = j + 1 }
        if (j == ss.length) { return undefined }
