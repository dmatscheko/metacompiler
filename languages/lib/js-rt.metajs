// ##########################################################################
// # LAYER 2, PART C - REGULAR EXPRESSIONS (abnf/jsrtregexjs.go over lib/regex.js)
// ##########################################################################

// ===================================================== regular expressions ==
//
// The JavaScript / TypeScript half of the shared regular-expression subsystem, in
// MetaJS. The authoritative specification is abnf/jsrtregexjs.go on top of
// abnf/jsrtregex.go; this file matches jsrtregexjs.go function for
// function, and it does NOT restate the engine.
//
// ----- the engine is IMPORTED, not copied ------------------------------------
//
// languages/lib/regex.js is the shared backtracking engine that every INTERPRETER
// grammar includes into its tag script, and abnf/jsrtregex.go is its line-by-line
// Go port. It is already written in the MetaJS subset - languages/lib/ruby-rt.metajs
// imports it exactly like this - so layer 2 needs no third copy. `import "./regex.js"`
// compiles it into js-rt.ll with everything else, and the whole parser + backtracking
// VM (rxCompile / rxSearch / rxMatchAt / rxGroup / rxReplace) costs this file nothing.
//
// The names below are the jsx* helpers of abnf/jsrtregexjs.go, renamed to the jx
// prefix this file owns. rx* is the engine's own prefix and comes from the import.
//
// ----- positions --------------------------------------------------------------
//
// abnf/jsrtregexjs.go indexes RUNES; regex.js indexes UTF-16 code units, because its
// `text` is a plain string. The two agree over the whole Basic Multilingual Plane,
// which is every test in this tree, and it is the same trade languages/lib/ruby-rt.metajs
// already makes.

import "./regex.js"

// ----- flags ------------------------------------------------------------------
//
// Three of JavaScript's letters are match modes and map straight onto the engine's
// neutral set: i (fold case), s (dot matches newline) and m (^ and $ are line
// anchors). Unlike Ruby, 'm' must NOT be forced on - without it JavaScript's ^ and $
// are string anchors. g (lastIndex iteration), y (sticky), d (hasIndices), u and v
// (the strict parse-time grammar, checked by the ReStrictU guard in the grammar) are
// not match modes at all.

function jxHasFlag(flags, letter) {
    var i = 0
    while (i < flags.length) {
        if (flags.charAt(i) == letter) { return true }
        i = i + 1
    }
    return false
}

// jxCanonFlags is RegExp#flags: the canonical order, not the written one.
function jxCanonFlags(flags) {
    var order = "dgimsuvy"
    var out = ""
    var i = 0
    while (i < order.length) {
        var c = order.charAt(i)
        if (jxHasFlag(flags, c)) { out = out + c }
        i = i + 1
    }
    return out
}

// jxNeutral maps them onto the engine's letters.
//
// "o" is unconditional: in a non-unicode pattern a backslash-digit escape with no
// such group is a LEGACY OCTAL character escape (Annex B), not a backreference -
// /\1/.test("") is false in node because \1 is U+0001. Under u/v that spelling is a
// SyntaxError, which the ReStrictU parse guard already refuses before anything
// reaches the engine.
// "j" is unconditional too: JavaScript has the POSIX-style loop reading. An iteration
// of an unbounded repeat that consumed nothing is DISCARDED rather than kept, so
// /^(a*)*$/.exec("aaa") reports "aaa" for group 1 (node), not "" (Perl, Python, Ruby,
// Java). It also clears the captures inside a repeated atom at the start of every
// iteration, so /(?:(a)|b)+/.exec("ab") leaves group 1 undefined.
function jxNeutral(flags) {
    var out = "oj"
    if (jxHasFlag(flags, "i")) { out = out + "i" }
    if (jxHasFlag(flags, "s")) { out = out + "s" }
    if (jxHasFlag(flags, "m")) { out = out + "m" }
    return out
}

// ----- the RegExp value --------------------------------------------------------
//
// A RegExp is an ordinary object carrying the JavaScript-visible properties plus one
// __-prefixed slot the engine side reads (keysOf hides it, exactly as the Go twin's
// __rx slots are hidden). lastIndex is per-OBJECT state, so a literal inside a loop
// must build a fresh one on every evaluation - which is what the emitted js_jsxnew
// does.

// The compile cache is SHARED as rxCache / rxGet in lib/regex.js, which is where
// abnf/jsrtregex.go has it (ONE rxCache for all four languages).

function jxNewRegex(src, jsFlags) {
    var fl = jxCanonFlags(jsFlags)
    var o = {}
    o["__jxsrc"] = src
    o["__jxneutral"] = jxNeutral(fl)
    o["source"] = src
    o["flags"] = fl
    o["global"] = jxHasFlag(fl, "g")
    o["sticky"] = jxHasFlag(fl, "y")
    o["ignoreCase"] = jxHasFlag(fl, "i")
    o["multiline"] = jxHasFlag(fl, "m")
    o["dotAll"] = jxHasFlag(fl, "s")
    o["unicode"] = jxHasFlag(fl, "u")
    o["unicodeSets"] = jxHasFlag(fl, "v")
    o["hasIndices"] = jxHasFlag(fl, "d")
    o["lastIndex"] = 0
    return o
}

// jxIsRe is the cross-file seam: jvStr and js_jsmcall ask this first.
function jxIsRe(v) {
    if (!jvIsObj(v)) { return false }
    return v["__jxsrc"] !== undefined
}

// jxStr is RegExp#toString, which is also what String(re) and "" + re answer.
function jxStr(v) {
    var src = v["source"]
    var fl = v["flags"]
    if (typeof src != "string") { src = "" }
    if (typeof fl != "string") { fl = "" }
    return "/" + src + "/" + fl
}

// jxProg is the compiled program behind a RegExp value. A pattern the shared engine
// refuses is NOT reported at construction: the engine is deliberately one permissive
// dialect for four languages, so it rejects a few patterns JavaScript accepts
// (lookbehind, [[:alpha:]]). The failure is raised when the pattern is actually
// MATCHED, exactly as js-interpreter.abnf's reProgOf does.
function jxProg(o) {
    var src = o["__jxsrc"]
    var fl = o["__jxneutral"]
    if (typeof src != "string") { src = "" }
    if (typeof fl != "string") { fl = "oj" }
    var re = rxGet(src, fl)
    if (!re["ok"]) {
        fail("invalid regular expression: /" + src + "/: " + re["err"])
    }
    return re
}

function jxBool(o, key) {
    var b = o[key]
    if (typeof b != "boolean") { return false }
    return b
}

function jxLastIndex(o) {
    var f = o["lastIndex"]
    if (typeof f != "number") { return 0 }
    return Math.trunc(f)
}

// ----- small local conversions -------------------------------------------------
//
// jvStr / jvToNumber live in the value half of this module. The two wrappers below
// short-circuit the case that is already the right type, which is every call the
// regular-expression ratchet makes, and only then reach across the seam.

function jxToStr(v) {
    if (typeof v == "string") { return v }
    return jvStr(v)
}

function jxToNum(v) {
    if (typeof v == "number") { return v }
    return jvToNumber(v)
}

// ----- the match record --------------------------------------------------------
//
// An array of the groups carrying three named properties, index, input and groups,
// which the floor's set_member keeps beside the elements (jvArrKeys). Twins:
// jsxResult in abnf/jsrtregexjs.go, reResult in both *-interpreter.abnf.

function jxNameAt(re, i) {
    var names = re["names"]
    var idx = re["nameGroups"]
    var k = 0
    while (k < names.length) {
        if (idx[k] == i) { return names[k] }
        k = k + 1
    }
    return ""
}

function jxResult(re, text, m, input) {
    var o = []
    var n = re["ngroups"]
    var i = 0
    while (i <= n) {
        var g = rxGroup(re, text, m, i)
        if (g === null) { o.push(undefined) } else { o.push(g) }
        i = i + 1
    }
    o["index"] = m["begin"]
    o["input"] = input
    var groups = anytype
    groups = undefined
    if (re["names"].length > 0) {
        var gg = {}
        var j = 1
        while (j <= n) {
            var name = jxNameAt(re, j)
            if (name != "") {
                var v = rxGroup(re, text, m, j)
                if (v === null) { gg[name] = undefined } else { gg[name] = v }
            }
            j = j + 1
        }
        groups = gg
    }
    o["groups"] = groups
    return o
}

// ----- exec / test -------------------------------------------------------------
//
// jxExec is RegExp#exec: g and y both read the search start out of lastIndex and
// reset it to 0 on failure, and y additionally refuses a match that does not BEGIN
// there. Sticky is the engine's own anchored entry point: rxMatchAt tries ONE
// position instead of searching forward and then throwing the answer away.

function jxExec(o, s) {
    var re = jxProg(o)
    var useLast = jxBool(o, "global") || jxBool(o, "sticky")
    var at = 0
    if (useLast) { at = jxLastIndex(o) }
    if (at < 0 || at > s.length) {
        if (useLast) { o["lastIndex"] = 0 }
        return null
    }
    var m = anytype
    if (jxBool(o, "sticky")) { m = rxMatchAt(re, s, at) } else { m = rxSearch(re, s, at) }
    if (m === null) {
        if (useLast) { o["lastIndex"] = 0 }
        return null
    }
    if (useLast) { o["lastIndex"] = m["end"] }
    return jxResult(re, s, m, s)
}

function jxTest(o, s) {
    if (jxBool(o, "global") || jxBool(o, "sticky")) { return jxExec(o, s) !== null }
    return rxSearch(jxProg(o), s, 0) !== null
}

// jxMatchAll walks every match. whole=true collects just the matched text
// (String#match with g), whole=false the full match records (String#matchAll).
// JavaScript's matchAll hands back an iterator; this hands back the array a spread
// would build, which is what a for-of over it needs anyway - the interpreter and the
// Go twin do the same.
function jxMatchAll(o, s, whole) {
    var re = jxProg(o)
    var out = []
    var at = 0
    while (at <= s.length) {
        var m = rxSearch(re, s, at)
        if (m === null) { break }
        if (whole) {
            var g = rxGroup(re, s, m, 0)
            if (g === null) { out.push("") } else { out.push(g) }
        } else {
            out.push(jxResult(re, s, m, s))
        }
        if (m["end"] == m["begin"]) { at = m["end"] + 1 } else { at = m["end"] }
    }
    o["lastIndex"] = 0
    return out
}

// jxSplit follows SplitMatcher: the match is ANCHORED at the scan position, an empty
// match at the current segment start does not split, and the separator's capture
// groups are part of the output.
function jxSplit(o, s, limit) {
    var re = jxProg(o)
    var out = []
    if (s.length == 0) {
        if (rxSearch(re, s, 0) === null) { out.push("") }
        return out
    }
    if (limit == 0) { return out }
    var p = 0
    var q = 0
    while (q < s.length) {
        var m = rxSearch(re, s, q)
        if (m === null || m["begin"] != q || m["end"] == p) {
            q = q + 1
            continue
        }
        out.push(s.substring(p, q))
        if (limit >= 0 && out.length >= limit) { return out }
        var i = 1
        while (i <= re["ngroups"]) {
            var g = rxGroup(re, s, m, i)
            if (g === null) { out.push(undefined) } else { out.push(g) }
            if (limit >= 0 && out.length >= limit) { return out }
            i = i + 1
        }
        p = m["end"]
        q = p
    }
    out.push(s.substring(p, s.length))
    return out
}

// GetSubstitution: a match's replacement template. Twin of jsReSubst in
// languages/js-interpreter.abnf, where the rules are.
function jxReSubst(t, s, re, m) {
    var out = ""
    var ng = rxGroupCount(re)
    var i = 0
    while (i < t.length) {
        var c = t.charCodeAt(i)
        if (c != 36 || i + 1 >= t.length) { out = out + t.charAt(i); i = i + 1; continue }
        var d = t.charCodeAt(i + 1)
        if (d == 36) { out = out + "$"; i = i + 2; continue }                       // $$
        if (d == 38) { out = out + rxGroup(re, s, m, 0); i = i + 2; continue }       // $&
        if (d == 96) { out = out + s.substring(0, m["begin"]); i = i + 2; continue }    // $`
        if (d == 39) { out = out + s.substring(m["end"], s.length); i = i + 2; continue } // $'
        if (d >= 48 && d <= 57) {                                                    // $n, $nn
            var idx = d - 48
            var w = 1
            var e = (i + 2 < t.length) ? t.charCodeAt(i + 2) : 0
            if (e >= 48 && e <= 57 && idx * 10 + e - 48 <= ng) { idx = idx * 10 + e - 48; w = 2 }
            if (idx >= 1 && idx <= ng) {
                var g = anytype // A group that did not take part is null.
                g = rxGroup(re, s, m, idx)
                if (g != null) { out = out + g }
            } else { out = out + t.substring(i, i + 1 + w) }
            i = i + 1 + w
            continue
        }
        if (d == 60) {                                                               // $<name>
            var j = i + 2
            while (j < t.length && t.charCodeAt(j) != 62) { j = j + 1 }
            if (re["names"].length == 0 || j >= t.length) { out = out + "$<"; i = i + 2; continue }
            var ng2 = anytype
            ng2 = rxGroupNamed(re, s, m, t.substring(i + 2, j))
            if (ng2 != null) { out = out + ng2 }
            i = j + 1
            continue
        }
        out = out + "$"
        i = i + 1
    }
    return out
}

// jxReplace is String#replace / #replaceAll with a pattern: each match is replaced
// by the template's substitution (jxReSubst) or by what the function answers when it
// is called with the whole match, the groups, the offset and the input.
function jxReplace(o, s, repl, forceAll) {
    var re = jxProg(o)
    var all = forceAll || jxBool(o, "global")
    var tpl = ""
    if (typeof repl != "function") { tpl = jxToStr(repl) }
    var out = ""
    var at = 0
    var last = 0
    while (at <= s.length) {
        var m = rxSearch(re, s, at)
        if (m === null) { break }
        out = out + s.substring(last, m["begin"])
        if (typeof repl != "function") { out = out + jxReSubst(tpl, s, re, m) }
        else {
            var args = []
            var i = 0
            while (i <= re["ngroups"]) {
                var g = rxGroup(re, s, m, i)
                if (g === null) { args.push(undefined) } else { args.push(g) }
                i = i + 1
            }
            args.push(m["begin"])
            args.push(s)
            out = out + jxToStr(repl.apply(undefined, args))
        }
        last = m["end"]
        at = m["end"]
        if (m["end"] == m["begin"]) {
            if (m["end"] < s.length) { out = out + s.charAt(m["end"]) }
            last = m["end"] + 1
            at = m["end"] + 1
        }
        if (!all) { break }
    }
    if (last <= s.length) { out = out + s.substring(last, s.length) }
    if (jxBool(o, "global")) { o["lastIndex"] = 0 }
    return out
}

// jxRegexArg turns the first argument of String#match / #matchAll / #search into a
// pattern: a RegExp is used as it is, anything else is its SOURCE, exactly as in
// JavaScript ("a1".match("\\d") matches a digit).
function jxRegexArg(v) {
    if (jxIsRe(v)) { return v }
    if (jvUndefOrNull(v)) { return jxNewRegex("", "") }
    return jxNewRegex(jxToStr(v), "")
}

// ----- the dispatcher ----------------------------------------------------------
//
// jxMcall is the cross-file seam abnf/jsrtregexjs.go spells jsxMethod: a RegExp
// receiver, or a string receiver whose argument is a pattern. It answers the sentinel
// jxMiss for everything else, which is every call in a program that uses no regular
// expression at all. js_jsmcall asks this before anything else.

var jxMiss = {}

function jxMcall(recv, name, args) {
    if (jxIsRe(recv)) {
        if (name == "test") { return jxTest(recv, jxToStr(jvArg(args, 0))) }
        if (name == "exec") { return jxExec(recv, jxToStr(jvArg(args, 0))) }
        if (name == "toString") { return jxStr(recv) }
        if (jvMissCallSet) { return jvMissCall }
        fail("unknown RegExp method: " + name)
    }
    if (typeof recv != "string") { return jxMiss }
    if (name == "search") {
        var sre = jxProg(jxRegexArg(jvArg(args, 0)))
        var sm = rxSearch(sre, recv, 0)
        if (sm === null) { return -1 }
        return sm["begin"]
    }
    if (name == "matchAll") { return jxMatchAll(jxRegexArg(jvArg(args, 0)), recv, false) }
    if (name == "match") {
        var mre = jxRegexArg(jvArg(args, 0))
        if (jxBool(mre, "global")) {
            var all = jxMatchAll(mre, recv, true)
            if (all.length == 0) { return null }
            return all
        }
        return jxExec(mre, recv)
    }
    if (name == "replace" || name == "replaceAll" || name == "split") {
        // A plain-string argument keeps the base behaviour.
        if (!jxIsRe(jvArg(args, 0))) { return jxMiss }
        var re = jvArg(args, 0)
        if (name == "replace") { return jxReplace(re, recv, jvArg(args, 1), false) }
        if (name == "replaceAll") { return jxReplace(re, recv, jvArg(args, 1), true) }
        var limit = -1
        var lv = jvArg(args, 1)
        if (!jvUndefOrNull(lv)) { limit = Math.trunc(jxToNum(lv)) }
        return jxSplit(re, recv, limit)
    }
    return jxMiss
}

// jxCtorArgs is new RegExp(src, flags) / RegExp(src, flags): the same construction as
// a literal, with the flags arriving at run time.
function jxCtorArgs(args) {
    var a0 = jvArg(args, 0)
    var src = ""
    var fl = ""
    if (jxIsRe(a0)) {
        var s0 = a0["source"]
        var f0 = a0["flags"]
        if (typeof s0 == "string") { src = s0 }
        if (typeof f0 == "string") { fl = f0 }
    } else if (!jvUndefOrNull(a0)) {
        src = jxToStr(a0)
    }
    var a1 = jvArg(args, 1)
    if (!jvUndefOrNull(a1)) { fl = jxToStr(a1) }
    return jxNewRegex(src, fl)
}

// ----- the externs -------------------------------------------------------------

// A regexp literal: /src/flags, with the JavaScript flag letters. Every EVALUATION
// builds a fresh object, because lastIndex is per-object state.
function js_jsxnew(src, flags) { return jxNewRegex(src, flags) }

// new RegExp(...): the argument array of the emitted call site. makeNew in
// js-to-llvm-ir.abnf special-cases the name, so js_call_new never sees it.
function js_jsxregexp(lit) { return jxCtorArgs(lit) }

// The global binding, so a bare RegExp(...) call and `typeof RegExp` work. The
// grammar declares it in the program's OWN scope, so no other language sees it.
function jxRegExpFn(src, flags) {
    var a = []
    a.push(src)
    a.push(flags)
    return jxCtorArgs(a)
}

function js_jsxctor() { return fnMetaSet(jxRegExpFn, "RegExp", 2) }

// The call wrapper. `replace` and `split` DO have a native for a string receiver, so
// they arrive through js_jsxcall as a BOUND METHOD instead of through js_jsmcall;
// only those two, and only with a pattern argument, are taken over here.
//
// ONE DEVIATION FROM abnf/jsrtregexjs.go, and it is forced. The Go twin reads
// bm.name off its *boundMethod; the C floor's bound method (runtime.c mk_bound, tag 9)
// carries only a receiver handle and a numeric method id, and no floor extern answers
// either - `typeof` says "function", to_string says "[function]" and === is identity,
// so a fresh js_get(s, "replace") never compares equal. What IS observable is the
// RESULT TYPE: String#replace always answers a string and String#split always answers
// an array, for every input, so one probe call on a pure native separates them. The
// probe argument is a plain string, so the probe cannot reach the regexp path and
// cannot recurse. A floor extern that answered a bound method's name would remove
// this.
function js_jsxcall(fn, self, args) {
    if (typeof self == "string" && jxIsRe(jvArg(args, 0))) {
        var probe = fn.apply(self, ["x"])
        var nm = ""
        if (Array.isArray(probe)) { nm = "split" }
        else if (typeof probe == "string") { nm = "replace" }
        if (nm != "") {
            var r = jxMcall(self, nm, args)
            if (r !== jxMiss) { return r }
        }
    }
    // Everything else is an ORDINARY call, and that is the common case: the emitter
    // routes EVERY `obj.m(...)` whose member resolved to a function through here.
    // The dynamic `this` is already armed - the emitter emits js_jssetthis(receiver)
    // immediately before this call - so nothing has to be set up first.
    return fn.apply(self, args)
}


// ===================================================== Promises ============
//
// The twin of the promise machinery in abnf/jsrt.go (promNew ... asyncStep) and
// of the copy in the two *-interpreter.abnf start scripts. The three engines run
// the SAME algorithm over the same value model on purpose: a promise is a plain
// object carrying hidden slots only, so it needs no floor tag, no typeof arm and
// no keysOf exception (keysOf hides a '__' slot, so a promise has no own keys).
//
//      __prom  true            marks the object
//      __ps    0 | 1 | 2       pending / fulfilled / rejected
//      __pv    any             the settled value or the rejection reason
//      __pcb   array           reactions registered while still pending
//
// A reaction is {f, r, p}: the fulfil handler, the reject handler and the derived
// promise then() answered (undefined for an await, which consumes the result).
//
// 'async' is 'awaits as yields': the emitter compiles an async body as an
// ORDINARY GENERATOR body, `await e` as js_yield, and js_jsasyncfn drives that
// generator from the microtask queue. So the floor's coroutines (tag 15/16) carry
// async functions unchanged and neither engine needs a throw-in channel - a
// rejection is sent in as a marker record and re-raised by js_jsawaitv at the
// await site, which is what puts it inside an enclosing try/catch.
var jpQ = []          // The microtask queue: thunks, drained by js_jsdrain.
var jpQi = 0          // Read cursor, so draining does not re-slice the queue.
var jpFn = anytype    // The one `Promise` global value, interned for identity.

function jpNew() {
    var p = {}
    p["__prom"] = true
    p["__ps"] = 0
    p["__pv"] = undefined
    p["__pcb"] = []
    return p
}

function jpIs(v) {
    if (!jvIsObj(v)) { return false }
    return v["__prom"] === true
}

function jpEnq(job) { jpQ.push(job) }

// Move a pending promise to its final state and hand every reaction registered
// while it was pending to the queue, in registration order.
function jpSettle(p, state, v) {
    if (p["__ps"] !== 0) { return }
    p["__ps"] = state
    p["__pv"] = v
    var cbs = p["__pcb"]
    p["__pcb"] = []
    var i = 0
    while (i < cbs.length) {
        jpEnqReact(p, cbs[i])
        i = i + 1
    }
}

// The specification's resolve procedure. Resolving with a THENABLE adopts its
// state through a job of its own, which is where the two extra ticks that every
// ordering test measures come from - `await` avoids them by going through
// jpResolveValue, which answers a promise unchanged.
function jpResolve(p, x) {
    if (p["__ps"] !== 0) { return }
    if (x === p) { jpSettle(p, 2, "TypeError: Chaining cycle detected for promise"); return }
    if (jvIsObj(x)) {
        if (jpIs(x)) { jpEnq(jpAdoptJob(p, x)); return }
        if (jvIsCallable(x["then"])) { jpEnq(jpAdoptJob(p, x)); return }
    }
    jpSettle(p, 1, x)
}

function jpResolveFn(p) { return function (v) { jpResolve(p, v) } }
function jpRejectFn(p) { return function (e) { jpSettle(p, 2, e) } }

function jpAdoptJob(p, x) {
    return function () {
        if (jpIs(x)) { jpThen(x, jpResolveFn(p), jpRejectFn(p), undefined); return }
        try { jvCallT(x["then"], x, [jpResolveFn(p), jpRejectFn(p)]) }
        catch (e) { jpSettle(p, 2, e) }
    }
}

function jpEnqReact(p, reaction) {
    jpEnq(jpReactJob(p["__ps"], p["__pv"], reaction))
}

// The specification's NewPromiseReactionJob: run the handler for the state the
// promise settled in and settle the derived promise with what it answered, or
// with what it threw. A missing handler passes the value straight through, which
// is what makes `p.then(f).catch(g)` and `p.catch(g).then(f)` both work.
function jpReactJob(state, arg, reaction) {
    return function () {
        var handler = anytype
        handler = (state === 1) ? reaction["f"] : reaction["r"]
        var derived = reaction["p"]
        if (!jvIsCallable(handler)) {
            if (jpIs(derived)) {
                if (state === 1) { jpResolve(derived, arg) }
                else { jpSettle(derived, 2, arg) }
            }
            return
        }
        var out = anytype
        out = undefined
        var threw = false
        var thrown = anytype
        thrown = undefined
        try { out = jvCallT(handler, undefined, [arg]) }
        catch (e) { threw = true; thrown = e }
        if (!jpIs(derived)) { return }
        if (threw) { jpSettle(derived, 2, thrown) }
        else { jpResolve(derived, out) }
    }
}

// Register one reaction. derived is the promise then() answered, or undefined for
// an await, which consumes the result itself.
function jpThen(p, onF, onR, derived) {
    var reaction = {}
    reaction["f"] = onF
    reaction["r"] = onR
    reaction["p"] = derived
    if (p["__ps"] === 0) { p["__pcb"].push(reaction); return }
    jpEnqReact(p, reaction)
}

// PromiseResolve: a promise is its own, anything else gets a fresh resolved one.
function jpResolveValue(x) {
    if (jpIs(x)) { return x }
    var p = jpNew()
    jpResolve(p, x)
    return p
}

// p.then / p.catch / p.finally. Answered here rather than stored on the object so
// that a promise keeps no own keys at all.
function jpMethod(p, name, args) {
    if (name == "then") {
        var d1 = jpMake(jpSpecies(p))
        jpThen(p, jvArg(args, 0), jvArg(args, 1), d1)
        return d1
    }
    if (name == "catch") {
        var d2 = jpMake(jpSpecies(p))
        jpThen(p, undefined, jvArg(args, 0), d2)
        return d2
    }
    if (name == "finally") {
        var fn = jvArg(args, 0)
        var d3 = jpMake(jpSpecies(p))
        jpThen(p, jpFinallyPass(fn), jpFinallyRaise(fn), d3)
        return d3
    }
    return jvMiss
}

// SpeciesConstructor(p, %Promise%) for the promise then / catch / finally derive
// from: jvSpeciesOf the class of a Promise subclass instance, undefined for a plain
// promise. Twin of promSpecies in abnf/jsrt.go.
function jpSpecies(p) {
    var cls = anytype
    cls = p["__class"]
    if (cls === undefined) { return undefined }
    return jvSpeciesOf(cls)
}

// A fresh pending promise, made by `new c(executor)` for a Promise subclass c, a
// plain one for undefined. Twin of promMake in abnf/jsrt.go, which states the rule.
function jpMake(c) {
    if (c !== undefined) {
        var r = anytype
        r = jvConstruct(c, [function (res, rej) { return undefined }])
        if (jpIs(r)) { return r }
    }
    return jpNew()
}

// The value `p.then` READ AS A VALUE is: jpMethod bound to its receiver. node's is
// Promise.prototype.then, unbound; there is no prototype chain here, so binding the
// receiver is what makes the shape a program actually writes - `const t = p.then;
// t.call(p, f)` - work.
function jpBound(p, name) {
    return function () {
        var a = []
        var i = 0
        while (i < arguments.length) {
            a.push(arguments[i])
            i = i + 1
        }
        return jpMethod(p, name, a)
    }
}

function jpFinallyPass(fn) {
    return function (v) {
        if (jvIsCallable(fn)) { jvCallT(fn, undefined, []) }
        return v
    }
}
function jpFinallyRaise(fn) {
    return function (e) {
        if (jvIsCallable(fn)) { jvCallT(fn, undefined, []) }
        throw e
    }
}

// Promise.resolve / reject / all / allSettled / race / any. The combinators share
// one state OBJECT rather than captured locals, because a MetaJS local keeps the
// type it was first assigned and a counter written from two closures is exactly
// the shape that trips over.
// Called on Promise (c undefined) or on its subclass c, whose instance each answers
// (jpMake); resolve answers a promise of that very class unchanged. Twin of
// promStatic in abnf/jsrt.go.
function jpStatic(c, name, args) {
    if (name == "resolve") {
        var x = anytype
        x = jvArg(args, 0)
        if (jpIs(x)) {
            if (x["__class"] === c) { return x }
        }
        var pv = jpMake(c)
        jpResolve(pv, x)
        return pv
    }
    if (name == "reject") {
        var pr = jpMake(c)
        jpSettle(pr, 2, jvArg(args, 0))
        return pr
    }
    if (name == "all") { return jpCombine("all", jvArg(args, 0), c) }
    if (name == "allSettled") { return jpCombine("allSettled", jvArg(args, 0), c) }
    if (name == "race") { return jpCombine("race", jvArg(args, 0), c) }
    if (name == "any") { return jpCombine("any", jvArg(args, 0), c) }
    return jvMiss
}

function jpCombine(kind, src, c) {
    if (!Array.isArray(src)) { fail("Promise." + kind + " needs an array") }
    var st = {}
    st["kind"] = kind
    st["out"] = jpMake(c)
    st["results"] = []
    st["left"] = src.length
    var i = 0
    while (i < src.length) {
        st["results"].push(undefined)
        i = i + 1
    }
    if (src.length === 0) {
        if (kind == "all") { jpResolve(st["out"], st["results"]) }
        if (kind == "allSettled") { jpResolve(st["out"], st["results"]) }
        if (kind == "any") { jpSettle(st["out"], 2, "AggregateError: All promises were rejected") }
        return st["out"]
    }
    var j = 0
    while (j < src.length) {
        // On a subclass each element goes through c.resolve and its then makes a
        // derived c (promStatic in abnf/jsrt.go).
        var ep = anytype
        var dp = anytype
        ep = jpResolveValue(src[j])
        dp = undefined
        if (c !== undefined) {
            ep = jpStatic(c, "resolve", [src[j]])
            dp = jpMake(jpSpecies(ep))
        }
        jpThen(ep, jpCombineFn(st, j, true), jpCombineFn(st, j, false), dp)
        j = j + 1
    }
    return st["out"]
}

function jpCombineFn(st, idx, ok) {
    return function (v) {
        var kind = st["kind"]
        if (kind == "race") {
            if (ok) { jpResolve(st["out"], v) } else { jpSettle(st["out"], 2, v) }
            return
        }
        if (kind == "any" && ok) { jpResolve(st["out"], v); return }
        if (kind == "all" && !ok) { jpSettle(st["out"], 2, v); return }
        if (kind == "allSettled") {
            var r = {}
            if (ok) { r["status"] = "fulfilled"; r["value"] = v }
            else { r["status"] = "rejected"; r["reason"] = v }
            st["results"][idx] = r
        } else {
            st["results"][idx] = v
        }
        st["left"] = st["left"] - 1
        if (st["left"] !== 0) { return }
        if (st["kind"] == "any") { jpSettle(st["out"], 2, "AggregateError: All promises were rejected") }
        else { jpResolve(st["out"], st["results"]) }
    }
}

// Resume an async body once and re-arm it. sent is the value the pending await
// answers with; when isThrow is set the await raises it instead.
function jpAsyncStep(g, p, sent, isThrow) {
    var send = anytype
    send = sent
    if (isThrow) {
        var m = {}
        m["__athrow"] = true
        m["v"] = sent
        send = m
    }
    var res = anytype
    res = undefined
    var threw = false
    var thrown = anytype
    thrown = undefined
    try { res = g.next(send) }
    catch (e) { threw = true; thrown = e }
    if (threw) { jpSettle(p, 2, thrown); return }
    if (res["done"] === true) { jpResolve(p, res["value"]); return }
    var awaited = jpResolveValue(res["value"])
    jpThen(awaited, jpResumeFn(g, p, false), jpResumeFn(g, p, true), undefined)
}

function jpResumeFn(g, p, isThrow) {
    return function (v) { jpAsyncStep(g, p, v, isThrow) }
}

// js_jsasyncfn(genFn): the emitter hands over the GENERATOR FUNCTION its async
// body compiled to (js_genfn of the closure), so nothing here has to reach into
// the floor's coroutines. Calling the result creates the generator, runs it to
// its first await and answers a promise for its completion.
function js_jsasyncfn(genFn) {
    return function () {
        var args = []
        var i = 0
        while (i < arguments.length) {
            args.push(arguments[i])
            i = i + 1
        }
        var g = genFn.apply(undefined, args)
        var p = jpNew()
        jpAsyncStep(g, p, undefined, false)
        return p
    }
}

// ============================================================================
// Async generators
//
// An async generator body yields TWO kinds of thing on ONE suspension channel:
// its awaits and its yields. They are told apart by a MARKER RECORD on the
// yielded value - {__awt, v}, built by js_jsawaitmark, which the emitter wraps
// every awaited operand of an async generator body in - and that marker is the
// whole mechanism. The generator model needed nothing added to it: the body is an
// ordinary generator body, exactly as an async function's is, and only the driver
// is new.
//
// The driver is jpAsyncStep with a REQUEST QUEUE in front of it. next(v),
// return(v) and throw(e) each answer a promise and append a request; one request
// is served at a time, an await resumes the body WITHOUT answering the pending
// next(), and a yield answers it and parks.
//
// The twins are agRequest/agStep in abnf/jsrtjsprint.go and jpAg* in the two
// *-interpreter.abnf start scripts.
//
// ag.throw(e) RAISES AT THE SUSPENDED YIELD, and it needs no throw-in channel in
// the generator engine: the resume value is the channel. The driver resumes the
// body with a {__athrow, v} record and the emitter unpacks every yield's result
// through js_jsawaitv, which raises when it sees one - the same record and the
// same unpacker an await's rejected operand already used. Nothing is kept across
// a suspension: the record travels ON the resume, so it is per-coroutine by
// construction. A throw before the body has ever run does NOT start it
// (st["started"]), which is node's suspendedStart rule; one that reaches a `yield*`
// is forwarded to the delegate's throw() by the emitted yield* loop.

function js_jsawaitmark(v) {
    var mk = {}
    mk["__awt"] = true
    mk["v"] = v
    return mk
}
function jpIsAwaitMark(v) {
    if (!jvIsObj(v)) { return false }
    return v["__awt"] === true
}

function jpAgNew(g) {
    var st = {}
    st["g"] = g
    st["q"] = []       // Pending requests, in call order.
    st["run"] = false  // A request is being served.
    st["done"] = false
    st["started"] = false // The body has been entered at least once.
    var ag = {}
    ag["__agen"] = true
    ag["next"] = jpAgMethod(st, 0)
    ag["return"] = jpAgMethod(st, 1)
    ag["throw"] = jpAgMethod(st, 2)
    // An async generator is an async iterable whose [Symbol.asyncIterator]() is itself.
    ag["__#@asyncIterator"] = function () { return ag }
    return ag
}
function jpAgMethod(st, kind) {
    return function () {
        var a = anytype
        a = undefined
        if (arguments.length > 0) { a = arguments[0] }
        return jpAgReq(st, kind, a)
    }
}
function jpAgReq(st, kind, arg) {
    var p = jpNew()
    var req = {}
    req["kind"] = kind
    req["arg"] = arg
    req["p"] = p
    st["q"].push(req)
    jpAgPump(st)
    return p
}
function jpAgPump(st) {
    if (st["run"]) { return undefined }
    if (st["q"].length === 0) { return undefined }
    st["run"] = true
    var req = st["q"][0]
    if (st["done"]) {
        if (req["kind"] === 2) { return jpAgFail(st, req["arg"]) }
        return jpAgComplete(st, jpAgRetArg(req), true)
    }
    // throw(e) on a body that is parked at a yield RESUMES it with a throw
    // completion, so a try around that yield catches. On one that has never been
    // entered there is no yield to raise at, and node does not start it either:
    // it completes the generator and rejects.
    if (req["kind"] === 2 && st["started"]) { jpAgStep(st, req["arg"], true); return undefined }
    if (req["kind"] === 1 || req["kind"] === 2) {
        st["done"] = true
        jpAgClose(st)
        if (req["kind"] === 2) { return jpAgFail(st, req["arg"]) }
        return jpAgComplete(st, req["arg"], true)
    }
    jpAgStep(st, req["arg"], false)
    return undefined
}
function jpAgRetArg(req) {
    if (req["kind"] === 1) { return req["arg"] }
    return undefined
}
function jpAgClose(st) {
    var rf = js_jsmget(st["g"], "return")
    if (jvIsCallable(rf)) { jvCallT(rf, st["g"], []) }
    return undefined
}
function jpAgStep(st, sent, isThrow) {
    var send = anytype
    send = sent
    if (isThrow) {
        var m = {}
        m["__athrow"] = true
        m["v"] = sent
        send = m
    }
    var res = anytype
    res = undefined
    var threw = false
    var thrown = anytype
    thrown = undefined
    st["started"] = true
    try { res = st["g"].next(send) }
    catch (e) { threw = true; thrown = e }
    if (threw) { st["done"] = true; jpAgFail(st, thrown); return undefined }
    if (res["done"] === true) { st["done"] = true; jpAgComplete(st, res["value"], true); return undefined }
    var y = anytype
    y = res["value"]
    if (jpIsAwaitMark(y)) {
        // An AWAIT: resume the body once the operand settles, and leave the pending
        // next() unanswered.
        jpThen(jpResolveValue(y["v"]), jpAgResumeFn(st, false), jpAgResumeFn(st, true), undefined)
        return undefined
    }
    // A YIELD. The specification awaits the operand before handing it over.
    jpThen(jpResolveValue(y), jpAgYieldFn(st), jpAgRaiseFn(st), undefined)
    return undefined
}
function jpAgResumeFn(st, isThrow) {
    return function (v) { jpAgStep(st, v, isThrow) }
}
function jpAgYieldFn(st) {
    return function (v) { jpAgComplete(st, v, false) }
}
function jpAgRaiseFn(st) {
    return function (e) { st["done"] = true; jpAgFail(st, e) }
}
function jpAgShift(st) {
    var req = st["q"][0]
    st["q"] = st["q"].slice(1)
    st["run"] = false
    return req
}
function jpAgComplete(st, v, done) {
    var req = jpAgShift(st)
    var r = {}
    r["value"] = v
    r["done"] = done
    jpSettle(req["p"], 1, r)
    jpAgPump(st)
    return undefined
}
function jpAgFail(st, e) {
    var req = jpAgShift(st)
    jpSettle(req["p"], 2, e)
    jpAgPump(st)
    return undefined
}

// js_jsasyncgen(genFn): the emitter hands over the GENERATOR FUNCTION the async
// generator body compiled to, exactly as it does for js_jsasyncfn. Calling the
// result creates the generator and answers the async-generator OBJECT.
function js_jsasyncgen(genFn) {
    return function () {
        var args = []
        var i = 0
        while (i < arguments.length) {
            args.push(arguments[i])
            i = i + 1
        }
        return jpAgNew(genFn.apply(undefined, args))
    }
}

// The value an `await` answers, given what the driver sent back in.
function js_jsawaitv(v) {
    if (jvIsObj(v)) {
        if (v["__athrow"] === true) { throw v["v"] }
    }
    return v
}

// The `Promise` global: a function value, so `new Promise(exec)` constructs one
// and `typeof Promise` is "function". The executor runs SYNCHRONOUSLY.
function js_jspromfn() {
    if (jpFn === undefined) {
        jpFn = fnMetaSet(function (exec) {
            var p = jpNew()
            // jbRaise, not fail: node throws this and a try/catch recovers it,
            // where fail is the floor's abort and a js_try deliberately does not
            // see it. The resolver's VALUE is part of node's message.
            if (!jvIsCallable(exec)) { jbRaise("TypeError: Promise resolver " + jvStr(exec) + " is not a function") }
            try { jvCallT(exec, undefined, [jpResolveFn(p), jpRejectFn(p)]) }
            catch (e) { jpSettle(p, 2, e) }
            return p
        }, "Promise", 1)
    }
    return jpFn
}

// Run the microtask queue to exhaustion. There are no timers and no I/O here, so
// the one drain the emitter puts after the whole script is every event-loop turn
// a program gets. An UNHANDLED REJECTION is deliberately not reported in any of
// the three engines - see the note in abnf/jsrt.go's drainMicrotasks.
function js_jsdrain() {
    while (jpQi < jpQ.length) {
        var job = jpQ[jpQi]
        jpQi = jpQi + 1
        job()
    }
    jpQ = []
    jpQi = 0
    return undefined
}

// ============================================================================
// CLOSING AN ITERATOR ON AN EARLY EXIT
//
// node closes a for-of's iterator on every abrupt exit from the loop body, not
// just on `break`: a `return` out of the body and a labeled break to an OUTER
// statement run the iterator's return() too, and neither reaches a block
// makeForOf owns - one rets the frame, the other branches to the outer label's
// exit. The emitter closes them BY VALUE instead: a for-of's entry block dominates
// its body, so the loop's iterable handle is a legal operand at every jump inside
// it, and one of these calls is emitted per loop being left.
//
// There is deliberately NO runtime open-iterator stack - see the forOfIters note in
// languages/js-to-llvm-ir.abnf: `for await` suspends INSIDE its own for-of, so a
// stack unwound by DEPTH (what a `throw` would need) would close the wrong loop.
//
// The twins are js_jsiterclose in abnf/jsrtjsprint.go and closeIterator in the two
// *-interpreter.abnf start scripts.
function js_jsiterclose(it) {
    if (jvUndefOrNull(it)) { return undefined }
    var r = js_jsretvget(it, "return") // finds a class instance's return() too
    if (jvIsCallable(r)) { jvCallT(r, it, []) }
    return undefined
}
