        if (st > units) { st = units }
        var n = units - st
        if (args.length > 1) {
            if (!jvUndefOrNull(args[1])) { n = jvToInt(jvToNumber(args[1])) }
        }
        if (n < 0) { n = 0 }
        if (st + n > units) { n = units - st }
        return s.substring(st, st + n)
