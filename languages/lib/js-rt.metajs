    return undefined
}

// ===================================================== 'in' ===============

function jvIndexIn(key, n) {
    var idx = jvToNumber(key)
    if (idx !== idx) { return false }
    if (idx !== Math.trunc(idx)) { return false }
    if (idx < 0) { return false }
    return idx < n
}

