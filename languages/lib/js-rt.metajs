            var cur = o[k]
            if (jvIsAcc(cur)) { return jvAccSet(cur, o, v) }
            if (cur === undefined) {
                var acc = jvFindClassAcc(o, k)
                if (acc !== undefined) { return jvAccSet(acc, o, v) }
            }
