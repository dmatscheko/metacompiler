// clampIndex / sliceRange / substringRange, the twins of abnf/jsrt.go's. The two
// results travel in globals, the way runtime.c's slice_range does.
var jvBegin = 0
var jvEnd = 0

function jvClampIndex(i, length) {
    var v = i
    if (v < 0) { v = v + length }
    if (v < 0) { return 0 }
    if (v > length) { return length }
    return v
}

function jvSliceRange(length, args) {
    jvBegin = 0
    jvEnd = length
    if (args.length > 0) {
        var n = jvToNumber(args[0])
        if (n !== n) { n = 0 }
        jvBegin = jvClampIndex(Math.trunc(n), length)
    }
    if (args.length > 1) {
        if (args[1] !== undefined) {
            var e = jvToNumber(args[1])
            if (e !== e) { e = 0 }
            jvEnd = jvClampIndex(Math.trunc(e), length)
        }
    }
    if (jvEnd < jvBegin) { jvEnd = jvBegin }
    return undefined
}

