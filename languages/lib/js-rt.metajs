// js_jsmget is js_get plus the accessor box plus the hidden method names. The
// emitter routes EVERY member and index read through it under -exe, so the common
// case has to be a straight delegation.
// f.call(thisArg, ...) / f.apply(thisArg, argsArray). getMember (abnf/jsrt.go)
// answers a boundMethod for both, and rt.call then pushes argAt(args, 0) on the
// thisStack - so the callee's `this` is the FIRST ARGUMENT. The C floor answers
// them too (mk_bound 40/41), but its js_call DROPS the receiver for a tag-7
// closure, so nothing would arm js_this() and a decorated method reading
// `this.bonus` through `original.call(this, n)` answered NaN natively where
// llvm.Run answered 10. These two shims are the arming, and they are the only
// place a native build can do it: the dispatch happens inside the floor.
function jvCallShim(f) {
    return function () {
        var rest = []
        var i = 1
        while (i < arguments.length) {
            rest.push(arguments[i])
            i = i + 1
        }
        return jvCallT(f, arguments[0], rest)
    }
}

function jvApplyShim(f) {
    return function () {
        var a = anytype
        a = arguments[1]
        if (!Array.isArray(a)) { a = [] }
        return jvCallT(f, arguments[0], a)
    }
}

function js_jsmget(o, key) {
    if (typeof key == "string") {
