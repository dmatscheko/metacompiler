    if (name == "indexOf") {
        var from = jvToInt(jvNumArg(args, 1, 0))
        if (from < 0) { from = 0 }
        if (from > units) { from = units }
        return jvIndexFrom(s, jvArgS(args, 0), from)
    }
    if (name == "lastIndexOf") {
        var sub = jvArgS(args, 0)
        var best = -1
        var li = 0
        while (li + sub.length <= units) {
            if (s.substring(li, li + sub.length) == sub) { best = li }
            li = li + 1
        }
        return best
    }
    if (name == "includes") { return s.indexOf(jvArgS(args, 0)) >= 0 }
    if (name == "startsWith") {
        var sw = jvArgS(args, 0)
        var at = jvToInt(jvNumArg(args, 1, 0))
        if (at < 0) { at = 0 }
        if (at + sw.length > units) { return false }
        return s.substring(at, at + sw.length) == sw
    }
    if (name == "endsWith") {
        var ew = jvArgS(args, 0)
        var end = units
        if (args.length > 1) {
            if (!jvUndefOrNull(args[1])) { end = jvToInt(jvToNumber(args[1])) }
        }
        var start = end - ew.length
        if (start < 0) { return false }
        if (end > units) { return false }
        return s.substring(start, end) == ew
