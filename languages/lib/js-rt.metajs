// ===================================================== own keys ===========

// jsvOwnKeys: an object's own enumerable keys in insertion order, WITHOUT the
// __-prefixed internal slots (keysOf already skips those).
function jvOwnKeys(v) {
    if (jvIsObj(v)) { return keysOf(v) }
