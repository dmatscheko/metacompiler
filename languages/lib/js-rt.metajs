// slice/splice/fill resolve one (ECMA RelativeIndex).
function jvRelIndex(v, length) {
    var x = v
    if (x !== x) { x = 0 }
    if (x < 0) {
        var i = length + Math.trunc(x)
        if (i < 0) { return 0 }
        return i
    }
    var j = Math.trunc(x)
    if (j > length) { return length }
    return j
