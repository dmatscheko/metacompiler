        done = done + 1
    }
    return out + s.substring(at, s.length)
}

// ===================================================== String methods ======

function jvArgS(args, i) {
    if (i < args.length) { return jvStr(args[i]) }
    return "undefined"
}

function jvStrMethod(s, name, args) {
    var units = s.length
    if (name == "toString" || name == "valueOf") { return s }
    if (name == "charAt") { return s.charAt(jvToInt(jvNumArg(args, 0, 0))) }
    if (name == "charCodeAt") { return s.charCodeAt(jvToInt(jvNumArg(args, 0, 0))) }
    if (name == "codePointAt") {
        var ci = jvToInt(jvNumArg(args, 0, 0))
        if (ci < 0) { return undefined }
        if (ci >= units) { return undefined }
        var hi = s.charCodeAt(ci)
        // A surrogate PAIR is one code point; the string is measured in UTF-16 code
        // units, so the low half has to be folded in by hand.
        if (hi >= 55296) {
            if (hi <= 56319) {
