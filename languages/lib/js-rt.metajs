        var out = []
        var limit = -1
        if (args.length > 1) {
            if (!jvUndefOrNull(args[1])) { limit = jvToInt(jvToNumber(args[1])) }
        }
        if (args.length === 0 || jvUndefOrNull(jvArg(args, 0))) {
            if (limit != 0) { out.push(s) }
            return out
        }
        var sep = jvStr(args[0])
        if (sep == "") {
            var pi = 0
            while (pi < units) {
                if (limit >= 0) {
                    if (out.length >= limit) { return out }
                }
                out.push(s.substring(pi, pi + 1))
                pi = pi + 1
            }
            return out
        }
        var at2 = 0
        while (true) {
            if (limit >= 0) {
                if (out.length >= limit) { return out }
            }
            var hit = jvIndexFrom(s, sep, at2)
            if (hit < 0) {
                out.push(s.substring(at2, units))
                return out
            }
            out.push(s.substring(at2, hit))
            at2 = hit + sep.length
        }
        return out
    }
    if (name == "toUpperCase") { return s.toUpperCase() }
    if (name == "toLowerCase") { return s.toLowerCase() }
    if (name == "trim") { return jvTrim(s, true, true) }
    if (name == "trimStart") { return jvTrim(s, true, false) }
    if (name == "trimEnd") { return jvTrim(s, false, true) }
    if (name == "padStart" || name == "padEnd") {
        var want = jvToInt(jvNumArg(args, 0, 0))
        var fill = " "
        if (args.length > 1) {
            if (!jvUndefOrNull(args[1])) { fill = jvStr(args[1]) }
        }
        if (want <= units) { return s }
        if (fill == "") { return s }
        var pad = ""
        while (pad.length < want - units) { pad = pad + fill }
        pad = pad.substring(0, want - units)
        if (name == "padStart") { return pad + s }
        return s + pad
    }
    if (name == "repeat") {
        var rn = jvToInt(jvNumArg(args, 0, 0))
        if (rn < 0) { fail("Invalid count value: " + rn) }
        var ro = ""
        var rk = 0
        while (rk < rn) {
            ro = ro + s
            rk = rk + 1
        }
        return ro
    }
    if (name == "concat") {
        var co = s
        var ci2 = 0
        while (ci2 < args.length) {
            co = co + jvArgS(args, ci2)
            ci2 = ci2 + 1
        }
        return co
    }
    if (name == "replace" || name == "replaceAll") {
        var pat = jvArgS(args, 0)
        var lim = 1
        if (name == "replaceAll") { lim = -1 }
        var rep = jvArg(args, 1)
        if (jvIsCallable(rep)) { return jvReplaceFn(s, pat, rep, lim) }
        return jvReplaceTemplate(s, pat, jvArgS(args, 1), lim)
    }
    if (name == "localeCompare") {
        var other = jvArgS(args, 0)
        if (s < other) { return -1 }
        if (s > other) { return 1 }
        return 0
    }
    return jvMiss
}

// ===================================================== Array methods =======

function jvSortLess(x, y, cmp) {
    if (jvIsCallable(cmp)) { return jvToNumber(jvCallT(cmp, undefined, [x, y])) < 0 }
    return jvStr(x) < jvStr(y)
}

// Array#sort: undefined sorts last and every other element compares as its STRING
// form. V8's sort is stable, so a stable sort (insertion) is what this is.
function jvSort(a, cmp) {
    var vals = []
    var i = 0
    while (i < a.length) {
        if (a[i] !== undefined) { vals.push(a[i]) }
        i = i + 1
    }
    var j = 1
    while (j < vals.length) {
        var key = vals[j]
        var k = j - 1
        while (k >= 0) {
            if (!jvSortLess(key, vals[k], cmp)) { break }
            vals[k + 1] = vals[k]
            k = k - 1
        }
        vals[k + 1] = key
        j = j + 1
    }
    var w = 0
    while (w < vals.length) {
        a[w] = vals[w]
        w = w + 1
    }
    while (w < a.length) {
        a[w] = undefined
        w = w + 1
    }
    return undefined
}

function jvFlatten(out, elems, depth) {
    var i = 0
    while (i < elems.length) {
        var e = elems[i]
        if (Array.isArray(e) && depth > 0) {
            jvFlatten(out, e, depth - 1)
        } else {
            out.push(e)
        }
        i = i + 1
    }
    return undefined
}

// Replace a's contents with next's, in place (there is no splice and length is not
// assignable, so the floor's pop/push are the only tools).
function jvReplaceAll(a, next) {
    while (a.length > 0) { a.pop() }
    var i = 0
    while (i < next.length) {
        a.push(next[i])
        i = i + 1
    }
    return undefined
}

function jvArrMethod(a, name, args) {
    var n = a.length
    var cb = jvArg(args, 0)
    if (name == "toString") { return jvStr(a) }
    if (name == "at") {
        var ai = jvToInt(jvNumArg(args, 0, 0))
        if (ai < 0) { ai = ai + n }
        if (ai < 0) { return undefined }
        if (ai >= n) { return undefined }
        return a[ai]
    }
    if (name == "push") {
        var pi = 0
        while (pi < args.length) {
            a.push(args[pi])
            pi = pi + 1
        }
        return a.length
    }
    if (name == "pop") { return a.pop() }
    if (name == "shift") { return a.shift() }
    if (name == "unshift") {
        var next = []
        var ui = 0
        while (ui < args.length) {
            next.push(args[ui])
            ui = ui + 1
        }
        var uj = 0
        while (uj < n) {
            next.push(a[uj])
            uj = uj + 1
        }
        jvReplaceAll(a, next)
        return a.length
    }
    if (name == "reverse") { return a.reverse() }
    if (name == "slice") {
        jvSliceRange(n, args)
        var so = []
        var sk = jvBegin
        while (sk < jvEnd) {
            so.push(a[sk])
            sk = sk + 1
        }
        return so
    }
    if (name == "splice") {
        var start = n
        if (args.length > 0) { start = jvRelIndex(jvToNumber(args[0]), n) }
        var del = n - start
        if (args.length > 1) { del = jvToInt(jvToNumber(args[1])) }
        if (del < 0) { del = 0 }
        if (start + del > n) { del = n - start }
        var removed = []
        var si = start
        while (si < start + del) {
            removed.push(a[si])
            si = si + 1
        }
        var nx = []
        var k = 0
        while (k < start) {
            nx.push(a[k])
            k = k + 1
        }
        var ii = 2
        while (ii < args.length) {
            nx.push(args[ii])
            ii = ii + 1
        }
        k = start + del
        while (k < n) {
            nx.push(a[k])
            k = k + 1
        }
        jvReplaceAll(a, nx)
        return removed
    }
    if (name == "indexOf") {
        var from = 0
        if (args.length > 1) { from = jvRelIndex(jvToNumber(args[1]), n) }
        var qi = from
        while (qi < n) {
            if (a[qi] === cb) { return qi }
            qi = qi + 1
        }
        return -1
    }
    if (name == "lastIndexOf") {
        var li = n - 1
        while (li >= 0) {
            if (a[li] === cb) { return li }
            li = li - 1
        }
        return -1
    }
    if (name == "includes") {
        var ci = 0
        while (ci < n) {
            var e = a[ci]
            if (e === cb) { return true }
            // includes, unlike indexOf, finds NaN.
            if (typeof e == "number") {
                if (typeof cb == "number") {
                    if (e !== e && cb !== cb) { return true }
                }
            }
            ci = ci + 1
        }
        return false
    }
    if (name == "join") {
        var sep = ","
        if (args.length > 0) {
            if (!jvUndefOrNull(args[0])) { sep = jvStr(args[0]) }
        }
        var jo = ""
        var ji = 0
        while (ji < n) {
            if (ji > 0) { jo = jo + sep }
            if (!jvUndefOrNull(a[ji])) { jo = jo + jvStr(a[ji]) }
            ji = ji + 1
        }
        return jo
    }
    if (name == "concat") {
        var co = []
        var xi = 0
        while (xi < n) {
            co.push(a[xi])
            xi = xi + 1
        }
        var yi = 0
        while (yi < args.length) {
            var x = args[yi]
            if (Array.isArray(x)) {
                var zi = 0
                while (zi < x.length) {
                    co.push(x[zi])
                    zi = zi + 1
                }
            } else {
                co.push(x)
            }
            yi = yi + 1
        }
        return co
    }
    if (name == "sort") {
        jvSort(a, cb)
        return a
    }
    if (name == "map") {
        var mo = []
        var mi = 0
        while (mi < n && mi < a.length) {
            mo.push(jvCallT(cb, jvArg(args, 1), [a[mi], mi, a]))
            mi = mi + 1
        }
        return mo
    }
    if (name == "filter") {
        var fo = []
        var fi = 0
        while (fi < n && fi < a.length) {
            if (jvCallT(cb, jvArg(args, 1), [a[fi], fi, a])) { fo.push(a[fi]) }
            fi = fi + 1
        }
        return fo
    }
    if (name == "forEach") {
        var ei = 0
        while (ei < n && ei < a.length) {
            jvCallT(cb, jvArg(args, 1), [a[ei], ei, a])
            ei = ei + 1
        }
        return undefined
    }
    if (name == "some") {
        var oi = 0
        while (oi < n && oi < a.length) {
            if (jvCallT(cb, jvArg(args, 1), [a[oi], oi, a])) { return true }
            oi = oi + 1
        }
        return false
    }
    if (name == "every") {
        var vi = 0
        while (vi < n && vi < a.length) {
            if (!jvCallT(cb, jvArg(args, 1), [a[vi], vi, a])) { return false }
            vi = vi + 1
        }
        return true
    }
    if (name == "find") {
        var di = 0
        while (di < n && di < a.length) {
            if (jvCallT(cb, jvArg(args, 1), [a[di], di, a])) { return a[di] }
            di = di + 1
        }
        return undefined
    }
    if (name == "findIndex") {
        var gi = 0
        while (gi < n && gi < a.length) {
            if (jvCallT(cb, jvArg(args, 1), [a[gi], gi, a])) { return gi }
            gi = gi + 1
        }
        return -1
    }
    if (name == "findLast") {
        var hi = n - 1
        while (hi >= 0) {
            if (jvCallT(cb, jvArg(args, 1), [a[hi], hi, a])) { return a[hi] }
            hi = hi - 1
        }
        return undefined
    }
    if (name == "findLastIndex") {
        var ki = n - 1
        while (ki >= 0) {
            if (jvCallT(cb, jvArg(args, 1), [a[ki], ki, a])) { return ki }
            ki = ki - 1
        }
        return -1
    }
    if (name == "reduce" || name == "reduceRight") {
        var idx = []
        if (name == "reduce") {
            var ri = 0
            while (ri < n) {
                idx.push(ri)
                ri = ri + 1
            }
        } else {
            var rj = n - 1
            while (rj >= 0) {
                idx.push(rj)
                rj = rj - 1
            }
        }
        var at = 0
        var acc = anytype
        if (args.length > 1) {
            acc = args[1]
        } else {
            if (n === 0) { fail("Reduce of empty array with no initial value") }
            acc = a[idx[0]]
            at = 1
        }
        while (at < idx.length) {
            var ix = idx[at]
            acc = jvCallT(cb, undefined, [acc, a[ix], ix, a])
            at = at + 1
        }
        return acc
    }
    if (name == "flat") {
        var depth = 1
        if (args.length > 0) {
            if (!jvUndefOrNull(args[0])) {
                var d = jvToNumber(args[0])
                if (d === Infinity) { depth = 1073741824 } else { depth = jvToInt(d) }
            }
        }
        var lo = []
        jvFlatten(lo, a, depth)
        return lo
    }
    if (name == "flatMap") {
        var mo2 = []
        var mi2 = 0
        while (mi2 < n && mi2 < a.length) {
            var v = jvCallT(cb, jvArg(args, 1), [a[mi2], mi2, a])
            if (Array.isArray(v)) {
                var wi = 0
                while (wi < v.length) {
                    mo2.push(v[wi])
                    wi = wi + 1
                }
            } else {
                mo2.push(v)
            }
            mi2 = mi2 + 1
        }
        return mo2
    }
    if (name == "fill") {
        var fv = jvArg(args, 0)
        var fb = 0
        var fe = n
        if (args.length > 1) {
            if (!jvUndefOrNull(args[1])) { fb = jvRelIndex(jvToNumber(args[1]), n) }
        }
        if (args.length > 2) {
            if (!jvUndefOrNull(args[2])) { fe = jvRelIndex(jvToNumber(args[2]), n) }
        }
        while (fb < fe) {
            a[fb] = fv
            fb = fb + 1
        }
        return a
    }
    return jvMiss
}

// ===================================================== Number methods ======

// jsvToFixed. The rounding is spelled the way the interpreter half spells it (scale
// by 10^digits, add a half, floor), and on every value tested that IS node's answer:
// the spec rounds the EXACT binary value half up, and 1.005 * 100 is 100.4999... in
// binary, so both say "1.00".
function jvToFixed(x, digits) {
    if (x !== x) { return "NaN" }
    if (x === Infinity) { return "Infinity" }
    if (x === -Infinity) { return "-Infinity" }
    if (Math.abs(x) >= Math.pow(10, 21)) { return x + "" }
    var sign = ""
    var v = x
    if (v < 0) {
        sign = "-"
        v = -v
    }
    var scale = Math.pow(10, digits)
    var n = Math.floor(v * scale + 0.5)
    var s = n + ""
    if (digits > 0) {
        while (s.length <= digits) { s = "0" + s }
        s = s.substring(0, s.length - digits) + "." + s.substring(s.length - digits, s.length)
    }
    if (sign == "-") {
        if (n === 0) { return s }
    }
    return sign + s
}

// jsvRadixString: Number#toString(radix) for a radix other than 10. The integer part
// is exact; the fraction is emitted to 52 digits and trailing zeros dropped.
function jvRadixString(x, radix) {
    if (x !== x) { return "NaN" }
    if (x === Infinity) { return "Infinity" }
    if (x === -Infinity) { return "-Infinity" }
    var sign = ""
    var v = x
    if (v < 0) {
        sign = "-"
        v = -v
    }
    var ip = Math.floor(v)
    var frac = v - ip
    var digits = "0123456789abcdefghijklmnopqrstuvwxyz"
    var intPart = ""
    if (ip === 0) { intPart = "0" }
    while (ip >= 1) {
        var d = Math.trunc(ip % radix)
        intPart = digits.charAt(d) + intPart
        ip = Math.floor(ip / radix)
    }
    if (frac === 0) { return sign + intPart }
    var out = intPart + "."
    var i = 0
    while (i < 52 && frac > 0) {
        frac = frac * radix
        var fd = Math.floor(frac)
        out = out + digits.charAt(fd)
        frac = frac - fd
        i = i + 1
    }
    var end = out.length
    while (end > 0) {
        if (out.charAt(end - 1) != "0") { break }
        end = end - 1
    }
    if (end > 0) {
        if (out.charAt(end - 1) == ".") { end = end - 1 }
    }
    return sign + out.substring(0, end)
}

// (255n).toString(16). The seam list gives agent A only jbStr, so the conversion
// runs on the DECIMAL TEXT: repeated long division of the digit string by the radix.
// Exact for any magnitude, which is the whole point of a BigInt.
function jvBigRadix(dec, radix) {
    var sign = ""
    var s = dec
    if (s.charAt(0) == "-") {
        sign = "-"
        s = s.substring(1, s.length)
    }
    var digs = "0123456789abcdefghijklmnopqrstuvwxyz"
    var n = []
    var i = 0
    while (i < s.length) {
        n.push(s.charCodeAt(i) - 48)
        i = i + 1
    }
    var out = ""
    while (true) {
        var q = []
        var rem = 0
        var j = 0
        while (j < n.length) {
            var cur = rem * 10 + n[j]
            var d = Math.floor(cur / radix)
            rem = cur - d * radix
            if (q.length > 0 || d > 0) { q.push(d) }
            j = j + 1
        }
        out = digs.charAt(rem) + out
        if (q.length === 0) { break }
        n = q
    }
    if (out == "") { out = "0" }
    return sign + out
}

function jvNumMethod(x, name, args) {
    if (name == "toFixed") { return jvToFixed(x, jvToInt(jvNumArg(args, 0, 0))) }
    if (name == "toString") {
        var radix = jvToInt(jvNumArg(args, 0, 10))
        if (radix === 10) { return x + "" }
        if (radix < 2 || radix > 36) { fail("toString() radix must be between 2 and 36") }
        return jvRadixString(x, radix)
    }
    if (name == "valueOf") { return x }
    return jvMiss
}

// ===================================================== the Object statics ==

function jvObjectGlobalMethod(name, args) {
    var src = jvArg(args, 0)
    if (name == "keys" || name == "getOwnPropertyNames") {
        var out = []
        var ks = jvOwnKeys(src)
        var i = 0
        while (i < ks.length) {
            out.push(ks[i])
            i = i + 1
        }
        return out
    }
    if (name == "values") {
        var vo = []
        var vk = jvOwnKeys(src)
        var vi = 0
        while (vi < vk.length) {
            vo.push(js_jsmget(src, vk[vi]))
            vi = vi + 1
        }
        return vo
    }
    if (name == "entries") {
        var eo = []
        var ek = jvOwnKeys(src)
        var ei = 0
        while (ei < ek.length) {
            var pair = []
            pair.push(ek[ei])
            pair.push(js_jsmget(src, ek[ei]))
            eo.push(pair)
            ei = ei + 1
        }
        return eo
    }
    if (name == "assign") {
        if (!jvIsObj(src)) { fail("Object.assign needs an object target") }
        var ai = 1
        while (ai < args.length) {
            var s = args[ai]
            if (!jvUndefOrNull(s)) {
                var sk = jvOwnKeys(s)
                var sj = 0
                while (sj < sk.length) {
                    js_jsmset(src, sk[sj], js_jsmget(s, sk[sj]))
                    sj = sj + 1
                }
            }
            ai = ai + 1
        }
        return src
    }
    if (name == "fromEntries") {
        var fo = {}
        if (Array.isArray(src)) {
            var fi = 0
            while (fi < src.length) {
                var e = src[fi]
                if (Array.isArray(e)) {
                    if (e.length > 0) { js_jsmset(fo, jvStr(e[0]), jvArg(e, 1)) }
                }
                fi = fi + 1
            }
        }
        return fo
    }
    if (name == "freeze" || name == "seal") { return src }
    if (name == "is") { return jvArg(args, 0) === jvArg(args, 1) }
    return jvMiss
}

// ===================================================== the method call =====
//
// The fallback for a receiver none of the arms claims: abnf/jsrt.go's memberCall,
// which the C floor does not have. A class instance dispatches on the __class /
// __super chain with the receiver PREPENDED; anything else resolves the member and
// calls it.
function jvFallbackCall(recv, name, args) {
    if (jvIsObj(recv)) {
        var cls = recv["__class"]
        if (cls !== undefined) {
            while (jvIsObj(cls)) {
                var m = cls[name]
                if (jvIsCallable(m)) { return jvCallT(m, recv, jvPrepend(recv, args)) }
                cls = cls["__super"]
            }
            // An accessor whose value is callable is still reachable as a method.
            var acc = jvFindClassAcc(recv, name)
            if (acc !== undefined) {
                var av = jvAccGet(acc, recv)
                if (jvIsCallable(av)) { return jvCallT(av, recv, args) }
            }
            fail("unknown method '" + name + "' on an instance")
        }
    }
    var own = js_jsmget(recv, name)
    if (jvIsCallable(own)) { return jvCallT(own, recv, args) }
    fail("unknown method '" + name + "' on " + typeof recv)
    return undefined
}

// js_jsmcall: JavaScript's String / Array / Number / Object method surface, the
// regular-expression surface (agent C's jxMcall, asked FIRST) and the class-method
// dispatch. A receiver none of them claims lands in jvFallbackCall.
function js_jsmcall(recv, key, args) {
    var name = jvStr(key)
    // Promise.prototype.then / catch / finally, and the Promise statics on the
    // `Promise` global (a function value, so js_get finds no member of that name).
    // Asked BEFORE jxMcall: a promise is a plain object and nothing else claims it.
    if (jpIs(recv)) {
        var pm = jpMethod(recv, name, args)
        if (pm !== jvMiss) { return pm }
    }
    if (jpFn !== undefined && recv === jpFn) {
        var ps = jpStatic(name, args)
        if (ps !== jvMiss) { return ps }
    }
    var r = jxMcall(recv, name, args)
    if (r !== jxMiss) { return r }
    // BigInt.prototype: (255n).toString(16), (1n).valueOf().
    if (jbIsBig(recv)) {
        if (name == "valueOf") { return recv }
        if (name == "toString") {
            var radix = jvToInt(jvNumArg(args, 0, 10))
            // The RANGE CHECK is abnf/jsrtjsbig.go's jsvBigIntMethod, and it was
            // MEASURED missing: (255n).toString(40) answered "6f" natively where node
            // and llvm.Run both raise. An unknown method name deliberately falls
            // THROUGH rather than failing, because the Go twin answers (nil, false).
            if (radix < 2 || radix > 36) { fail("RangeError: toString() radix must be between 2 and 36") }
            if (radix === 10) { return jbStr(recv) }
            return jvBigRadix(jbStr(recv), radix)
        }
    }
    // Object.keys / values / entries / assign / freeze / fromEntries.
    if (jvIsObjectGlobal(recv)) {
        var og = jvObjectGlobalMethod(name, args)
        if (og !== jvMiss) { return og }
        return jvFallbackCall(recv, name, args)
    }
    // String.fromCharCode on the `String` global (a function value, so js_get finds
    // no member of that name and the call lands here).
    if (recv === jvStringFn) {
        if (name == "fromCharCode") {
            var out = ""
            var i = 0
            while (i < args.length) {
                out = out + String.fromCharCode(jvToInt(jvToNumber(args[i])))
                i = i + 1
            }
            return out
        }
        fail("unknown String method: " + name)
    }
    if (typeof recv == "string") {
        var sm = jvStrMethod(recv, name, args)
        if (sm !== jvMiss) { return sm }
    }
    if (Array.isArray(recv)) {
        var am = jvArrMethod(recv, name, args)
        if (am !== jvMiss) { return am }
    }
    if (typeof recv == "number") {
        var nm = jvNumMethod(recv, name, args)
        if (nm !== jvMiss) { return nm }
    }
    return jvFallbackCall(recv, name, args)
}

// ##########################################################################
// # LAYER 2, PART B - BIGINT and the arithmetic operators (abnf/jsrtjsbig.go)
// ##########################################################################

// ===========================================================================
// BigInt and the arithmetic operators - layer 2's port of abnf/jsrtjsbig.go.
//
// THE REPRESENTATION
//
//     {__bigint: 1, s: -1|0|1, d: [limb, ...], t: "<cached decimal>"}
//
// magnitude little endian in base 2^24, no leading zero limb, so s is 0 exactly
// when d is empty. 24 bits is the widest limb whose SQUARE (2^48) plus carries
// still lands exactly in a double, which is what makes the schoolbook multiply
// correct with no 64-bit help. This is languages/js-interpreter.abnf's shape
// (its "BigInt" section) function for function, so the interpreter and the
// compiled binary answer alike; abnf/jsrtjsbig.go's math/big is the third twin.
//
// INTERNING, and it is not an optimisation - it is the ONLY way `10n === 10n`
// can hold. `===` lowers to js_seq, the C FLOOR's own extern, and the floor's
// strict_eq has no BigInt case: for a tag 6 object it falls through to
//     return a == b;             /* identity for everything else */
// so two structurally equal BigInts would compare false. jbIntern keeps ONE
// canonical object per value in a 251-bucket table, which turns identity into
// value equality for free. abnf/jsrt.go's strictEq has a *jsBigInt case
// instead, so the two halves agree without the floor having to change.
//
// WHAT INTERNING CANNOT REACH is written up at the end of this file: the C
// floor's type_of, truthy and js_neg have no BigInt case either, and unlike
// strict_eq they cannot be bent from layer 2.
// ===========================================================================

var jbBASE = 16777216
var jbMASK = 16777215
var jbDIGITS = "0123456789abcdefghijklmnopqrstuvwxyz"

// The strict rules are ARMED by a BigInt literal (js_jsbigint) or by BigInt(v),
// exactly as abnf/jsrtjsbig.go's `strict` bool is: until a program evaluates
// one, every wrapper below is a straight pass-through to the plain operator, so
// python-to-llvm-ir.abnf's doubles keep the behaviour they had.
var jbStrict = false

// The miss sentinel of the cross-file seams. jbAdd / jbEq / jbCmp / jbMcall
// answer it when they do not claim the call; it is `undefined`, which none of
// them can produce as a real answer.
var jbMiss = undefined

var jbPool = []

// ----------------------------------------------------- the interning table -

function jbHash(s, d) {
    var h = s + 2
    h = h * 31 + d.length
    if (d.length > 0) { h = h * 31 + d[0] }
    if (d.length > 1) { h = h * 31 + d[d.length - 1] }
    if (h < 0) { h = -h }
    return h % 251
}

function jbIntern(s, d) {
    if (jbPool.length === 0) {
        var n = 0
        while (n < 251) { jbPool.push([]); n = n + 1 }
    }
    var bucket = jbPool[jbHash(s, d)]
    var j = 0
    while (j < bucket.length) {
        var c = bucket[j]
        if (c.s === s && jbCmpD(c.d, d) === 0) { return c }
        j = j + 1
    }
    var v = {__bigint: 1, s: s, d: d, t: ""}
    bucket.push(v)
    return v
}

function jbIsBig(v) {
    if (v === undefined) { return false }
    if (v === null) { return false }
    if (Array.isArray(v)) { return false }
    if (typeof v != "object") { return false }
    return v.__bigint === 1
}

// ------------------------------------- magnitude helpers: plain limb arrays -

function jbTrim(d) {
    while (d.length > 0 && d[d.length - 1] === 0) { d.pop() }
    return d
}

function jbCopy(d) {
    var o = []
    var i = 0
    while (i < d.length) { o.push(d[i]); i = i + 1 }
    return o
}

function jbMake(s, d) {
    var dd = jbTrim(d)
    var sg = s
    if (dd.length === 0) { sg = 0 }
    return jbIntern(sg, dd)
}

function jbZero() { return jbMake(0, []) }

// The BigInt arm of unary minus, which the base file's js_jsneg reaches under
// -exe. It is `-v.s`, NEVER `0 - v.s`: the signed-zero trap of part 3. It needs
// no special case for zero either, because jbMake forces the sign of an empty
// magnitude to 0, so -0n is 0n and stays the ONE interned zero.
function jbNeg(v) { return jbMake(-v.s, jbCopy(v.d)) }

// The BigInt arm of ToBoolean, which the base file's js_jsnot and
// js_jstruthy__raw reach under -exe. 0n is the one falsy BigInt.
function jbTruthy(v) { return v.s !== 0 }

function jbCmpD(a, b) {
    if (a.length !== b.length) {
        if (a.length < b.length) { return -1 }
        return 1
    }
    var i = a.length - 1
    while (i >= 0) {
        if (a[i] !== b[i]) {
            if (a[i] < b[i]) { return -1 }
            return 1
        }
        i = i - 1
    }
    return 0
}

function jbAddD(a, b) {
    var out = []
    var carry = 0
    var n = a.length
    if (b.length > n) { n = b.length }
    var i = 0
    while (i < n) {
        var s = carry
        if (i < a.length) { s = s + a[i] }
        if (i < b.length) { s = s + b[i] }
        if (s >= jbBASE) { out.push(s - jbBASE); carry = 1 } else { out.push(s); carry = 0 }
        i = i + 1
    }
    if (carry > 0) { out.push(carry) }
    return out
}

// Requires |a| >= |b|; the signed layer picks the operands so that it holds.
function jbSubD(a, b) {
    var out = []
    var borrow = 0
    var i = 0
    while (i < a.length) {
        var s = a[i] - borrow
        if (i < b.length) { s = s - b[i] }
        if (s < 0) { s = s + jbBASE; borrow = 1 } else { borrow = 0 }
        out.push(s)
        i = i + 1
    }
    return jbTrim(out)
}

// Schoolbook multiply. The carry is folded INSIDE the inner loop, so the widest
// intermediate is (B-1)^2 + 2(B-1) < 2^48 and stays exact in a double; a version
// that accumulated a whole column first would not.
function jbMulD(a, b) {
    if (a.length === 0 || b.length === 0) { return [] }
    var out = []
    var z = 0
    while (z < a.length + b.length) { out.push(0); z = z + 1 }
    var i = 0
    while (i < a.length) {
        var carry = 0
        var ai = a[i]
        var j = 0
        while (j < b.length) {
            var t = out[i + j] + ai * b[j] + carry
            carry = Math.floor(t / jbBASE)
            out[i + j] = t - carry * jbBASE
            j = j + 1
        }
        var k = i + b.length
        while (carry > 0) {
            var t2 = out[k] + carry
            carry = Math.floor(t2 / jbBASE)
            out[k] = t2 - carry * jbBASE
            k = k + 1
        }
        i = i + 1
    }
    return jbTrim(out)
}

function jbMulSmallD(a, m) {
    var out = []
    var carry = 0
    var i = 0
    while (i < a.length) {
        var t = a[i] * m + carry
        carry = Math.floor(t / jbBASE)
        out.push(t - carry * jbBASE)
        i = i + 1
    }
    while (carry > 0) {
        var c2 = Math.floor(carry / jbBASE)
        out.push(carry - c2 * jbBASE)
        carry = c2
    }
    return jbTrim(out)
}

// m must be <= 2^24 so that rem * jbBASE + limb stays below 2^48.
function jbDivModSmallD(a, m) {
    var q = []
    var z = 0
    while (z < a.length) { q.push(0); z = z + 1 }
    var rem = 0
    var i = a.length - 1
    while (i >= 0) {
        var cur = rem * jbBASE + a[i]
        var dv = Math.floor(cur / m)
        q[i] = dv
        rem = cur - dv * m
        i = i - 1
    }
    return {q: jbTrim(q), r: rem}
}

function jbTopBits(x) {
    var n = 0
    var v = x
    while (v > 0) { n = n + 1; v = Math.floor(v / 2) }
    return n
}

function jbBitsD(d) {
    if (d.length === 0) { return 0 }
    return (d.length - 1) * 24 + jbTopBits(d[d.length - 1])
}

function jbBitD(a, k) {
    var i = Math.floor(k / 24)
    if (i >= a.length) { return 0 }
    return (a[i] >> (k - i * 24)) & 1
}

function jbShl1D(a) {
    var out = []
    var carry = 0
    var i = 0
    while (i < a.length) {
        var t = a[i] * 2 + carry
        if (t >= jbBASE) { out.push(t - jbBASE); carry = 1 } else { out.push(t); carry = 0 }
        i = i + 1
    }
    if (carry > 0) { out.push(carry) }
    return out
}

// Division of magnitudes. A single limb divisor takes the O(n) path; anything
// wider goes through plain binary long division, which is O(bits x limbs) and
// needs none of Knuth D's quotient-digit estimation.
function jbDivModD(a, b) {
    if (jbCmpD(a, b) < 0) { return {q: [], r: jbCopy(a)} }
    if (b.length === 1) {
        var s = jbDivModSmallD(a, b[0])
        var rr = []
        if (s.r !== 0) { rr.push(s.r) }
        return {q: s.q, r: rr}
    }
    var nbits = jbBitsD(a)
    var q = []
    var z = 0
    while (z < a.length) { q.push(0); z = z + 1 }
    var r = []
    var k = nbits - 1
    while (k >= 0) {
        r = jbShl1D(r)
        if (jbBitD(a, k) === 1) {
            if (r.length === 0) { r.push(1) } else { r[0] = r[0] + 1 }
        }
        if (jbCmpD(r, b) >= 0) {
            r = jbSubD(r, b)
            var qi = Math.floor(k / 24)
            q[qi] = q[qi] + (1 << (k - qi * 24))
        }
        k = k - 1
    }
    return {q: jbTrim(q), r: jbTrim(r)}
}

// ------------------------------------------------------ the signed operators -

function jbAddB(a, b) {
    if (a.s === 0) { return b }
    if (b.s === 0) { return a }
    if (a.s === b.s) { return jbMake(a.s, jbAddD(a.d, b.d)) }
    var c = jbCmpD(a.d, b.d)
    if (c === 0) { return jbZero() }
    if (c > 0) { return jbMake(a.s, jbSubD(a.d, b.d)) }
    return jbMake(b.s, jbSubD(b.d, a.d))
}

function jbSubB(a, b) { return jbAddB(a, jbNeg(b)) }

function jbMulB(a, b) {
    if (a.s === 0 || b.s === 0) { return jbZero() }
    return jbMake(a.s * b.s, jbMulD(a.d, b.d))
}

// BigInt division TRUNCATES toward zero and the remainder takes the sign of the
// dividend, so -7n / 2n is -3n and -7n % 3n is -1n (node agrees).
function jbDivB(a, b) {
    if (b.s === 0) { fail("RangeError: Division by zero") }
    return jbMake(a.s * b.s, jbDivModD(a.d, b.d).q)
}

function jbRemB(a, b) {
    if (b.s === 0) { fail("RangeError: Division by zero") }
    return jbMake(a.s, jbDivModD(a.d, b.d).r)
}

// -1 / 0 / 1 for two BigInts.
function jbCmpB(a, b) {
    if (a.s !== b.s) {
        if (a.s < b.s) { return -1 }
        return 1
    }
    if (a.s === 0) { return 0 }
    var c = jbCmpD(a.d, b.d)
    if (a.s > 0) { return c }
    return -c
}

function jbPowB(a, e) {
    if (e.s < 0) { fail("RangeError: Exponent must be non-negative") }
    var r = jbFromNum(1)
    var base = a
    var nbits = jbBitsD(e.d)
    if (nbits > 32) { fail("RangeError: BigInt exponent is too large") }
    var k = 0
    while (k < nbits) {
        if (jbBitD(e.d, k) === 1) { r = jbMulB(r, base) }
        if (k + 1 < nbits) { base = jbMulB(base, base) }
        k = k + 1
    }
    return r
}

function jbShlB(a, k) {
    if (a.s === 0 || k === 0) { return a }
    if (k < 0) { return jbShrB(a, -k) }
    if (k > 1048576) { fail("RangeError: BigInt shift count is too large") }
    var d = jbCopy(a.d)
    var limbs = Math.floor(k / 24)
    var bits = k - limbs * 24
    if (bits > 0) { d = jbMulSmallD(d, Math.pow(2, bits)) }
    var out = []
    var i = 0
    while (i < limbs) { out.push(0); i = i + 1 }
    var j = 0
    while (j < d.length) { out.push(d[j]); j = j + 1 }
    return jbMake(a.s, out)
}

// >> on a BigInt is an ARITHMETIC (floor) shift, so -1n >> 1n is -1n, not 0n:
// a negative value that lost any bit rounds away from zero by one.
function jbShrB(a, k) {
    if (a.s === 0 || k === 0) { return a }
    if (k < 0) { return jbShlB(a, -k) }
    if (k > 1048576) { fail("RangeError: BigInt shift count is too large") }
    var limbs = Math.floor(k / 24)
    var bits = k - limbs * 24
    var lost = false
    var d = []
    var i = 0
    while (i < limbs && i < a.d.length) {
        if (a.d[i] !== 0) { lost = true }
        i = i + 1
    }
    var j = limbs
    while (j < a.d.length) { d.push(a.d[j]); j = j + 1 }
    if (bits > 0) {
        var s = jbDivModSmallD(d, Math.pow(2, bits))
        if (s.r !== 0) { lost = true }
        d = s.q
    }
    d = jbTrim(d)
    if (a.s < 0 && lost) { d = jbAddD(d, [1]) }
    if (d.length === 0) {
        if (a.s < 0) { return jbFromNum(-1) }
        return jbZero()
    }
    return jbMake(a.s, d)
}

// & | ^ are defined on the infinite two's complement bit string. One extra limb
// of sign extension is enough for any pair, because the sign of the result is
// decided by the operator applied to the two sign bits.
function jbTwos(v, w) {
    var out = []
    var i = 0
    while (i < w) {
        if (i < v.d.length) { out.push(v.d[i]) } else { out.push(0) }
        i = i + 1
    }
    if (v.s < 0) {
        var carry = 1
        var j = 0
        while (j < w) {
            var t = (jbMASK - out[j]) + carry
            if (t >= jbBASE) { out[j] = t - jbBASE; carry = 1 } else { out[j] = t; carry = 0 }
            j = j + 1
        }
    }
    return out
}

function jbFromTwos(limbs, neg) {
    if (!neg) { return jbMake(1, limbs) }
    var out = []
    var carry = 1
    var i = 0
    while (i < limbs.length) {
        var t = (jbMASK - limbs[i]) + carry
        if (t >= jbBASE) { out.push(t - jbBASE); carry = 1 } else { out.push(t); carry = 0 }
        i = i + 1
    }
    return jbMake(-1, out)
}

function jbBitOp(op, a, b) {
    var w = a.d.length
    if (b.d.length > w) { w = b.d.length }
    w = w + 1
    var x = jbTwos(a, w)
    var y = jbTwos(b, w)
    var out = []
    var i = 0
    while (i < w) {
        if (op === "&") { out.push(x[i] & y[i]) }
        else if (op === "|") { out.push(x[i] | y[i]) }
        else { out.push(x[i] ^ y[i]) }
        i = i + 1
    }
    var an = a.s < 0
    var bn = b.s < 0
    var neg = false
    if (op === "&") { neg = an && bn }
    else if (op === "|") { neg = an || bn }
    else { neg = an !== bn }
    return jbFromTwos(out, neg)
}

// ~x is exactly -x - 1 in every precision, so it needs no bit machinery at all.
function jbNotB(a) { return jbSubB(jbNeg(a), jbFromNum(1)) }

// ---------------------------------------------------------- conversions ----

function jbFromNum(n) {
    if (n !== n) { fail("RangeError: cannot convert NaN to a BigInt") }
    if (n === Infinity || n === -Infinity) { fail("RangeError: cannot convert Infinity to a BigInt") }
    if (Math.floor(n) !== n) { fail("RangeError: The number " + n + " cannot be converted to a BigInt because it is not an integer") }
    if (n === 0) { return jbZero() }
    var neg = n < 0
    var a = n
    if (neg) { a = -n }
    var d = []
    while (a > 0) {
        var q = Math.floor(a / jbBASE)
        d.push(a - q * jbBASE)
        a = q
    }
    if (neg) { return jbMake(-1, d) }
    return jbMake(1, d)
}

// The double a BigInt denotes - exact up to 2^53, the nearest double above it.
function jbToNum(v) {
    var a = 0
    var i = v.d.length - 1
    while (i >= 0) { a = a * jbBASE + v.d[i]; i = i - 1 }
    if (v.s < 0) { return -a }
    return a
}

// Reads a digit run in the given radix: an optional sign, '_' separators
// skipped, and the scan stops at the first character that is not a digit of the
// radix. Digits go in CHUNKS so the big multiply runs once per 24 bits of input
// rather than once per digit.
function jbFromDigits(src, radix) {
    var s = "" + src
    var d = []
    var neg = false
    var i = 0
    if (i < s.length) {
        var c0 = s.charAt(i)
        if (c0 === "-" || c0 === "+") {
            neg = c0 === "-"
            i = i + 1
        }
    }
    var chunk = 1
    var chunkN = 0
    while (chunk * radix <= jbBASE) { chunk = chunk * radix; chunkN = chunkN + 1 }
    var acc = 0
    var accN = 0
    var stop = false
    while (i < s.length && !stop) {
        var cc = s.charCodeAt(i)
        if (cc !== 95) {
            var dg = 99
            if (cc >= 48 && cc <= 57) { dg = cc - 48 }
            else if (cc >= 97 && cc <= 122) { dg = cc - 87 }
            else if (cc >= 65 && cc <= 90) { dg = cc - 55 }
            if (dg >= radix) {
                stop = true
            } else {
                acc = acc * radix + dg
                accN = accN + 1
                if (accN === chunkN) {
                    d = jbTrim(jbAddD(jbMulSmallD(d, chunk), [acc]))
                    acc = 0
                    accN = 0
                }
            }
        }
        if (!stop) { i = i + 1 }
    }
    if (accN > 0) {
        var m = 1
        var k = 0
        while (k < accN) { m = m * radix; k = k + 1 }
        d = jbTrim(jbAddD(jbMulSmallD(d, m), [acc]))
    }
    if (neg) { return jbMake(-1, d) }
    return jbMake(1, d)
}

function jbToStr(v, radix) {
    if (v.s === 0) { return "0" }
    var chunk = 1
    var chunkN = 0
    while (chunk * radix <= jbBASE) { chunk = chunk * radix; chunkN = chunkN + 1 }
    var parts = []
    var d = jbCopy(v.d)
    while (d.length > 0) {
        var m = jbDivModSmallD(d, chunk)
        d = m.q
        parts.push(m.r)
    }
    var out = ""
    var i = parts.length - 1
    while (i >= 0) {
        var piece = ""
        var x = parts[i]
        while (x > 0) {
            var q = Math.floor(x / radix)
            piece = jbDIGITS.charAt(x - q * radix) + piece
            x = q
        }
        if (piece === "") { piece = "0" }
        if (i < parts.length - 1) {
            while (piece.length < chunkN) { piece = "0" + piece }
        }
        out = out + piece
        i = i - 1
    }
    if (v.s < 0) { return "-" + out }
    return out
}

// The seam agent A's jvStr calls FIRST: a BigInt prints as its digits with no
// 'n' suffix, so String(10n) is "10". The decimal text is cached on the value,
// which is safe precisely because the value is interned and immutable.
function jbStr(v) {
    if (v.t === "") { v.t = jbToStr(v, 10) }
    return v.t
}

// The whitespace StringToBigInt trims. \v is 11 and \f is 12; 0xa0 is NBSP and
// 0xfeff the BOM, both of which node's trim removes too.
function jbIsSpace(cc) {
    if (cc === 32 || cc === 9 || cc === 10 || cc === 13 || cc === 11 || cc === 12) { return true }
    if (cc === 160 || cc === 65279) { return true }
    return false
}

function jbTrimStr(s) {
    var a = 0
    var b = s.length
    while (a < b && jbIsSpace(s.charCodeAt(a))) { a = a + 1 }
    while (b > a && jbIsSpace(s.charCodeAt(b - 1))) { b = b - 1 }
    return s.substring(a, b)
}

// StringToBigInt: the WHOLE string must be an integer literal (with an optional
// sign and an optional 0x/0b/0o prefix), otherwise the conversion has no value
// at all - which is how `1n == "1.0"` comes out false in node while
// `1n == "1"` is true. An empty (or blank) string is 0n. Answers null on a
// string with no value.
function jbFromStrStrict(src) {
    var s = jbTrimStr("" + src)
    if (s === "") { return jbZero() }
    var sign = ""
    var body = s
    var c0 = body.charAt(0)
    if (c0 === "-" || c0 === "+") {
        sign = c0
        body = body.substring(1, body.length)
    }
    var radix = 10
    if (body.length > 2 && body.charAt(0) === "0") {
        var p = body.charAt(1)
        if (p === "x" || p === "X") { radix = 16 }
        else if (p === "b" || p === "B") { radix = 2 }
        else if (p === "o" || p === "O") { radix = 8 }
        if (radix !== 10) {
            if (sign !== "") { return null }
            body = body.substring(2, body.length)
        }
    }
    if (body.length === 0) { return null }
    var i = 0
    while (i < body.length) {
        var cc = body.charCodeAt(i)
        var dg = 99
        if (cc >= 48 && cc <= 57) { dg = cc - 48 }
        else if (cc >= 97 && cc <= 122) { dg = cc - 87 }
        else if (cc >= 65 && cc <= 90) { dg = cc - 55 }
        if (dg >= radix) { return null }
        i = i + 1
    }
    return jbFromDigits(sign + body, radix)
}

// ToBigInt, the conversion the BigInt(v) global performs.
function jbOf(v) {
    if (jbIsBig(v)) { return v }
    if (typeof v == "boolean") {
        if (v) { return jbFromNum(1) }
        return jbFromNum(0)
    }
    if (typeof v == "string") {
        var r = jbFromStrStrict(v)
        if (r === null) { fail("SyntaxError: Cannot convert " + v + " to a BigInt") }
        return r
    }
    if (typeof v == "number") { return jbFromNum(v) }
    fail("TypeError: Cannot convert " + jvStr(v) + " to a BigInt")
    return jbZero()
}

// ------------------------------------------------- the mixed-operand rule ---

function jbMixFail(op) {
    fail("TypeError: Cannot mix BigInt and other types, use explicit conversions (operator '" + op + "')")
    return undefined
}

// The BigInt arm of a binary operator, or jbMiss when NEITHER operand is one.
// When exactly one is, the spec's mixed-operand TypeError is raised instead.
function jbBinary(op, l, r) {
    var lb = jbIsBig(l)
    var rb = jbIsBig(r)
    if (!lb && !rb) { return jbMiss }
    if (!lb || !rb) { return jbMixFail(op) }
    if (op === "+") { return jbAddB(l, r) }
    if (op === "-") { return jbSubB(l, r) }
    if (op === "*") { return jbMulB(l, r) }
    if (op === "/") { return jbDivB(l, r) }
    if (op === "%") { return jbRemB(l, r) }
    if (op === "**") { return jbPowB(l, r) }
    if (op === "&") { return jbBitOp("&", l, r) }
    if (op === "|") { return jbBitOp("|", l, r) }
    if (op === "^") { return jbBitOp("^", l, r) }
    if (op === "<<") { return jbShlB(l, jbToNum(r)) }
    if (op === ">>") { return jbShrB(l, jbToNum(r)) }
    if (op === ">>>") { fail("TypeError: BigInts have no unsigned right shift, use >> instead") }
    return jbMiss
}

// =================================================== the cross-file seams ===
//
// jbIsBig and jbStr are above. The three below answer jbMiss (undefined) when
// they do not claim the operand pair, which is the same protocol jxMcall uses:
//
//     var r = jbAdd(a, b)
//     if (r !== jbMiss) { return r }
//
// Each of them runs jvToPrimitive itself, so agent A may hand over the RAW
// operands; ToPrimitive is idempotent on a primitive, so calling it first does
// no harm either. Running it FIRST is what makes `1n == [1n]` true in node: the
// array stringifies to "1" and StringToBigInt reads it back.

// The BigInt arm of '+'. '+' is the one arithmetic operator a BigInt shares
// with strings, so string concatenation is settled BEFORE the mixed-operand
// rule can fire: `1n + []` is the string "1", not a TypeError.
function jbAdd(l, r) {
    if (!jbIsBig(l) && !jbIsBig(r)) { return jbMiss }
    var lp = jvToPrimitive(l)
    var rp = jvToPrimitive(r)
    // The concatenation is finished HERE rather than handed back as a miss: once
    // either operand is a BigInt this arm owns the answer, and a caller that
    // treats every jbAdd result as final (agent A's js_jsadd does) would
    // otherwise turn `"" + 10n` into undefined.
    if (typeof lp == "string" || typeof rp == "string") { return jvStr(lp) + jvStr(rp) }
    return jbBinary("+", lp, rp)
}

// The BigInt arm of '=='. It compares MATHEMATICALLY across the type line:
// 1n == 1 and 1n == "1" hold, 1n == "1.0" does not.
function jbEq(a, b) {
    var ap = jvToPrimitive(a)
    var bp = jvToPrimitive(b)
    var abig = jbIsBig(ap)
    var bbig = jbIsBig(bp)
    if (!abig && !bbig) { return jbMiss }
    if (abig && bbig) { return jbCmpB(ap, bp) === 0 }
    var n = ap
    var other = bp
    if (!abig) { n = bp; other = ap }
    if (typeof other == "string") {
        var p = jbFromStrStrict(other)
        if (p === null) { return false }
        return jbCmpB(n, p) === 0
    }
    if (typeof other == "boolean") {
        if (other) { return jbCmpB(n, jbFromNum(1)) === 0 }
        return jbCmpB(n, jbFromNum(0)) === 0
    }
    if (typeof other == "number") {
        if (other !== other) { return false }
        if (other === Infinity || other === -Infinity) { return false }
        if (Math.floor(other) !== other) { return false }
        return jbCmpB(n, jbFromNum(other)) === 0
    }
    return false
}

// One relational operand as a double: a BigInt through its value, a string
// through parseFloat (NaN makes every relation false), anything else through
// the floor's ToNumber.
function jbRelNum(v) {
    if (jbIsBig(v)) { return jbToNum(v) }
    if (typeof v == "string") {
        if (jbTrimStr(v) === "") { return 0 }
        return parseFloat(v)
    }
    if (typeof v == "boolean") {
        if (v) { return 1 }
        return 0
    }
    if (v === null) { return 0 }
    if (v === undefined) { return NaN }
    return v - 0
}

// The relational ordering with a BigInt on at least one side: -1 / 0 / 1, or 2
// when NaN was involved. Two BigInts compare exactly; a BigInt against a number
// goes through the double value, the one place a value past 2^53 could round -
// languages/js-interpreter.abnf's biRel does the same, so both halves agree.
function jbCmp(a, b) {
    var ap = jvToPrimitive(a)
    var bp = jvToPrimitive(b)
    var abig = jbIsBig(ap)
    var bbig = jbIsBig(bp)
    if (!abig && !bbig) { return jbMiss }
    if (abig && bbig) { return jbCmpB(ap, bp) }
    var af = jbRelNum(ap)
    var bf = jbRelNum(bp)
    if (af !== af || bf !== bf) { return 2 }
    if (af < bf) { return -1 }
    if (af > bf) { return 1 }
    return 0
}

// ======================================================= the js_* externs ===

// The BigInt literal of languages/js-to-llvm-ir.abnf. The grammar's makeBigInt
// has already dropped the '_' separators and the trailing 'n' but KEPT the
// 0x/0b/0o prefix, which is read here. It differs from the shared js_bigint
// only in arming the strict rules.
function js_jsbigint(src) {
    jbStrict = true
    var body = "" + src
    var radix = 10
    if (body.length > 1 && body.charAt(0) === "0") {
        var p = body.charAt(1)
        if (p === "x" || p === "X") { radix = 16 }
        else if (p === "b" || p === "B") { radix = 2 }
        else if (p === "o" || p === "O") { radix = 8 }
        if (radix !== 10) { body = body.substring(2, body.length) }
    }
    return jbFromDigits(body, radix)
}

// The BigInt(v) global, declared into the program scope by the grammar the way
// String / Object / println already are.
function js_jsbigintfn() {
    return function(v) {
        if (v === undefined) { fail("TypeError: Cannot convert undefined to a BigInt") }
        jbStrict = true
        return jbOf(v)
    }
}

// Number(v): the only way back OUT of a BigInt, since unary '+' refuses it.
function js_jsnumberfn() {
    return function(v) {
        if (jbIsBig(v)) { return jbToNum(v) }
        if (v === undefined) { return NaN }
        return jvToNumber(v)
    }
}

// Unary '+' is the ONE operator a BigInt refuses outright: there is no number
// to coerce it to without losing precision.
function js_jstonumber(v) {
    if (jbStrict && jbIsBig(v)) { fail("TypeError: Cannot convert a BigInt value to a number") }
    return v - 0
}

// ++ and -- are ToNumeric-then-step: a BigInt stays a BigInt and steps by 1n,
// everything else becomes a number and steps by 1. js_jstonumeric answers the
// value ++ reports (the OLD one, for the postfix form) and js_jsstep applies
// the delta to it.
function js_jstonumeric(v) {
    if (jbStrict && jbIsBig(v)) { return v }
    return v - 0
}

function js_jsstep(v, d) {
    if (jbStrict && jbIsBig(v)) { return jbAddB(v, jbFromNum(d - 0)) }
    return (v - 0) + (d - 0)
}

// ~x on a BigInt is exactly -x - 1 in arbitrary precision. The grammar used to
// lower it to `x ^ -1` on the shared xor, which the mixed-operand rule would
// now (correctly) refuse, so it gets an external of its own.
function js_jsbnot(a) {
    if (jbStrict && jbIsBig(a)) { return jbNotB(a) }
    return ~a
}

// The binary arithmetic and bitwise operators. The NON-BigInt arm of each is
// the plain MetaJS operator, which compiles to the C floor's own extern -
// `return a * b` IS js_mul - so a program with no BigInt in it gets bit for bit
// the answer it got before.

function js_jssub(a, b) {
    if (jbStrict) {
        var r = jbBinary("-", a, b)
        if (r !== jbMiss) { return r }
    }
    return a - b
}

function js_jsmul(a, b) {
    if (jbStrict) {
        var r = jbBinary("*", a, b)
        if (r !== jbMiss) { return r }
    }
    return a * b
}

function js_jsdiv(a, b) {
    if (jbStrict) {
        var r = jbBinary("/", a, b)
        if (r !== jbMiss) { return r }
    }
    return a / b
}

function js_jsmod(a, b) {
    if (jbStrict) {
        var r = jbBinary("%", a, b)
        if (r !== jbMiss) { return r }
    }
    return a % b
}

function js_jsband(a, b) {
    if (jbStrict) {
        var r = jbBinary("&", a, b)
        if (r !== jbMiss) { return r }
    }
    return a & b
}

function js_jsbor(a, b) {
    if (jbStrict) {
        var r = jbBinary("|", a, b)
        if (r !== jbMiss) { return r }
    }
    return a | b
}

function js_jsbxor(a, b) {
    if (jbStrict) {
        var r = jbBinary("^", a, b)
        if (r !== jbMiss) { return r }
    }
    return a ^ b
}

function js_jsshl(a, b) {
    if (jbStrict) {
        var r = jbBinary("<<", a, b)
        if (r !== jbMiss) { return r }
    }
    return a << b
}

function js_jsshr(a, b) {
    if (jbStrict) {
        var r = jbBinary(">>", a, b)
        if (r !== jbMiss) { return r }
    }
    return a >> b
}

function js_jsushr(a, b) {
    if (jbStrict) {
        var r = jbBinary(">>>", a, b)
        if (r !== jbMiss) { return r }
    }
    return a >>> b
}

// '**' has no shared external: it lowers to Math.pow, which only has doubles.
// The double arm below IS Math.pow over ToNumber.
function js_jspow(a, b) {
    if (jbStrict) {
        var r = jbBinary("**", a, b)
        if (r !== jbMiss) { return r }
    }
    return Math.pow(a - 0, b - 0)
}

// ##########################################################################
// # LAYER 2, PART C - REGULAR EXPRESSIONS (abnf/jsrtregexjs.go over lib/regex.js)
// ##########################################################################

// ===================================================== regular expressions ==
//
// The JavaScript / TypeScript half of the shared regular-expression subsystem, in
// MetaJS. The authoritative specification is abnf/jsrtregexjs.go (575 lines) on top
// of abnf/jsrtregex.go (2164 lines); this file matches jsrtregexjs.go function for
// function, and it does NOT restate the engine.
//
// ----- the engine is IMPORTED, not copied ------------------------------------
//
// languages/lib/regex.js is the shared backtracking engine that every INTERPRETER
// grammar includes into its tag script, and abnf/jsrtregex.go is its line-by-line
// Go port. It is already written in the MetaJS subset - languages/lib/ruby-rt.metajs
// imports it exactly like this - so layer 2 needs no third copy. `import "./regex.js"`
// compiles it into js-rt.ll with everything else, and the whole parser + backtracking
// VM (rxCompile / rxSearch / rxMatchAt / rxGroup / rxReplace) costs this file nothing.
//
// The names below are the jsx* helpers of abnf/jsrtregexjs.go, renamed to the jx
// prefix this file owns. rx* is the engine's own prefix and comes from the import.
//
// ----- positions --------------------------------------------------------------
//
// abnf/jsrtregexjs.go indexes RUNES; regex.js indexes UTF-16 code units, because its
// `text` is a plain string. The two agree over the whole Basic Multilingual Plane,
// which is every test in this tree, and it is the same trade languages/lib/ruby-rt.metajs
// already makes.

import "./regex.js"

// ----- flags ------------------------------------------------------------------
//
// Three of JavaScript's letters are match modes and map straight onto the engine's
// neutral set: i (fold case), s (dot matches newline) and m (^ and $ are line
// anchors). Unlike Ruby, 'm' must NOT be forced on - without it JavaScript's ^ and $
// are string anchors. g (lastIndex iteration), y (sticky), d (hasIndices), u and v
// (the strict parse-time grammar, checked by the ReStrictU guard in the grammar) are
// not match modes at all.

function jxHasFlag(flags, letter) {
    var i = 0
    while (i < flags.length) {
        if (flags.charAt(i) == letter) { return true }
        i = i + 1
    }
    return false
}

// jxCanonFlags is RegExp#flags: the canonical order, not the written one.
function jxCanonFlags(flags) {
    var order = "dgimsuvy"
    var out = ""
    var i = 0
    while (i < order.length) {
        var c = order.charAt(i)
        if (jxHasFlag(flags, c)) { out = out + c }
        i = i + 1
    }
    return out
}

// jxNeutral maps them onto the engine's letters.
//
// "o" is unconditional: in a non-unicode pattern a backslash-digit escape with no
// such group is a LEGACY OCTAL character escape (Annex B), not a backreference -
// /\1/.test("") is false in node because \1 is U+0001. Under u/v that spelling is a
// SyntaxError, which the ReStrictU parse guard already refuses before anything
// reaches the engine.
// "j" is unconditional too: JavaScript has the POSIX-style loop reading. An iteration
// of an unbounded repeat that consumed nothing is DISCARDED rather than kept, so
// /^(a*)*$/.exec("aaa") reports "aaa" for group 1 (node), not "" (Perl, Python, Ruby,
// Java). It also clears the captures inside a repeated atom at the start of every
// iteration, so /(?:(a)|b)+/.exec("ab") leaves group 1 undefined.
function jxNeutral(flags) {
    var out = "oj"
    if (jxHasFlag(flags, "i")) { out = out + "i" }
    if (jxHasFlag(flags, "s")) { out = out + "s" }
    if (jxHasFlag(flags, "m")) { out = out + "m" }
    return out
}

// ----- the RegExp value --------------------------------------------------------
//
// A RegExp is an ordinary object carrying the JavaScript-visible properties plus one
// __-prefixed slot the engine side reads (keysOf hides it, exactly as the Go twin's
// __rx slots are hidden). lastIndex is per-OBJECT state, so a literal inside a loop
// must build a fresh one on every evaluation - which is what the emitted js_jsxnew
// does.

// The compile cache is SHARED as rxCache / rxGet - lib/regex.js, which is where
// abnf/jsrtregex.go has always had it (ONE rxCache for all four languages). This
// file, kotlin-rt, python-rt and ruby-rt each carried a byte-identical private
// copy under a private prefix; the four are one body now.

function jxNewRegex(src, jsFlags) {
    var fl = jxCanonFlags(jsFlags)
    var o = {}
    o["__jxsrc"] = src
    o["__jxneutral"] = jxNeutral(fl)
    o["source"] = src
    o["flags"] = fl
    o["global"] = jxHasFlag(fl, "g")
    o["sticky"] = jxHasFlag(fl, "y")
    o["ignoreCase"] = jxHasFlag(fl, "i")
    o["multiline"] = jxHasFlag(fl, "m")
    o["dotAll"] = jxHasFlag(fl, "s")
    o["unicode"] = jxHasFlag(fl, "u")
    o["unicodeSets"] = jxHasFlag(fl, "v")
    o["hasIndices"] = jxHasFlag(fl, "d")
    o["lastIndex"] = 0
    return o
}

// jxIsRe is the cross-file seam: agent A's jvStr and js_jsmcall ask this first.
function jxIsRe(v) {
    if (!jvIsObj(v)) { return false }
    return v["__jxsrc"] !== undefined
}

// jxStr is RegExp#toString, which is also what String(re) and "" + re answer.
function jxStr(v) {
    var src = v["source"]
    var fl = v["flags"]
    if (typeof src != "string") { src = "" }
    if (typeof fl != "string") { fl = "" }
    return "/" + src + "/" + fl
}

// jxProg is the compiled program behind a RegExp value. A pattern the shared engine
// refuses is NOT reported at construction: the engine is deliberately one permissive
// dialect for four languages, so it rejects a few patterns JavaScript accepts
// (lookbehind, [[:alpha:]]). The failure is raised when the pattern is actually
// MATCHED, exactly as js-interpreter.abnf's reProgOf does.
function jxProg(o) {
    var src = o["__jxsrc"]
    var fl = o["__jxneutral"]
    if (typeof src != "string") { src = "" }
    if (typeof fl != "string") { fl = "oj" }
    var re = rxGet(src, fl)
    if (!re["ok"]) {
        fail("invalid regular expression: /" + src + "/: " + re["err"])
    }
    return re
}

function jxBool(o, key) {
    var b = o[key]
    if (typeof b != "boolean") { return false }
    return b
}

function jxLastIndex(o) {
    var f = o["lastIndex"]
    if (typeof f != "number") { return 0 }
    return Math.trunc(f)
}

// ----- small local conversions -------------------------------------------------
//
// jvStr / jvToNumber live in agent A's half of this module. The two wrappers below
// short-circuit the case that is already the right type, which is every call the
// regular-expression ratchet makes, and only then reach across the seam.

function jxToStr(v) {
    if (typeof v == "string") { return v }
    return jvStr(v)
}

function jxToNum(v) {
    if (typeof v == "number") { return v }
    return jvToNumber(v)
}

function jxArg(args, i) {
    if (i < args.length) { return args[i] }
    return undefined
}

function jxNullish(v) {
    if (v === undefined) { return true }
    return v === null
}

// ----- the match record --------------------------------------------------------
//
// JavaScript models it as an Array carrying three extra properties; neither runtime
// here allows a non-index property on an array (both report "invalid array index"),
// so it is an array-LIKE object instead - m[0], m.length, m.index, m.input and
// m.groups all read back, and only Array.isArray(m) tells the difference. The
// interpreter side and abnf/jsrtregexjs.go build exactly the same shape.

function jxNameAt(re, i) {
    var names = re["names"]
    var idx = re["nameGroups"]
    var k = 0
    while (k < names.length) {
        if (idx[k] == i) { return names[k] }
        k = k + 1
    }
    return ""
}

function jxResult(re, text, m, input) {
    var o = {}
    var n = re["ngroups"]
    var i = 0
    while (i <= n) {
        var g = rxGroup(re, text, m, i)
        if (g === null) { o["" + i] = undefined } else { o["" + i] = g }
        i = i + 1
    }
    o["length"] = n + 1
    o["index"] = m["begin"]
    o["input"] = input
    var groups = anytype
    groups = undefined
    if (re["names"].length > 0) {
        var gg = {}
        var j = 1
        while (j <= n) {
            var name = jxNameAt(re, j)
            if (name != "") {
                var v = rxGroup(re, text, m, j)
                if (v === null) { gg[name] = undefined } else { gg[name] = v }
            }
            j = j + 1
        }
        groups = gg
    }
    o["groups"] = groups
    return o
}

// ----- exec / test -------------------------------------------------------------
//
// jxExec is RegExp#exec: g and y both read the search start out of lastIndex and
// reset it to 0 on failure, and y additionally refuses a match that does not BEGIN
// there. Sticky is the engine's own anchored entry point: rxMatchAt tries ONE
// position instead of searching forward and then throwing the answer away.

function jxExec(o, s) {
    var re = jxProg(o)
    var useLast = jxBool(o, "global") || jxBool(o, "sticky")
    var at = 0
    if (useLast) { at = jxLastIndex(o) }
    if (at < 0 || at > s.length) {
        if (useLast) { o["lastIndex"] = 0 }
        return null
    }
    var m = anytype
    if (jxBool(o, "sticky")) { m = rxMatchAt(re, s, at) } else { m = rxSearch(re, s, at) }
    if (m === null) {
        if (useLast) { o["lastIndex"] = 0 }
        return null
    }
    if (useLast) { o["lastIndex"] = m["end"] }
    return jxResult(re, s, m, s)
}

function jxTest(o, s) {
    if (jxBool(o, "global") || jxBool(o, "sticky")) { return jxExec(o, s) !== null }
    return rxSearch(jxProg(o), s, 0) !== null
}

// jxMatchAll walks every match. whole=true collects just the matched text
// (String#match with g), whole=false the full match records (String#matchAll).
// JavaScript's matchAll hands back an iterator; this hands back the array a spread
// would build, which is what a for-of over it needs anyway - the interpreter and the
// Go twin do the same.
function jxMatchAll(o, s, whole) {
    var re = jxProg(o)
    var out = []
    var at = 0
    while (at <= s.length) {
        var m = rxSearch(re, s, at)
        if (m === null) { break }
        if (whole) {
            var g = rxGroup(re, s, m, 0)
            if (g === null) { out.push("") } else { out.push(g) }
        } else {
            out.push(jxResult(re, s, m, s))
        }
        if (m["end"] == m["begin"]) { at = m["end"] + 1 } else { at = m["end"] }
    }
    o["lastIndex"] = 0
    return out
}

// jxSplit follows SplitMatcher: the match is ANCHORED at the scan position, an empty
// match at the current segment start does not split, and the separator's capture
// groups are part of the output.
function jxSplit(o, s, limit) {
    var re = jxProg(o)
    var out = []
    if (s.length == 0) {
        if (rxSearch(re, s, 0) === null) { out.push("") }
        return out
    }
    if (limit == 0) { return out }
    var p = 0
    var q = 0
    while (q < s.length) {
        var m = rxSearch(re, s, q)
        if (m === null || m["begin"] != q || m["end"] == p) {
            q = q + 1
            continue
        }
        out.push(s.substring(p, q))
        if (limit >= 0 && out.length >= limit) { return out }
        var i = 1
        while (i <= re["ngroups"]) {
            var g = rxGroup(re, s, m, i)
            if (g === null) { out.push(undefined) } else { out.push(g) }
            if (limit >= 0 && out.length >= limit) { return out }
            i = i + 1
        }
        p = m["end"]
        q = p
    }
    out.push(s.substring(p, s.length))
    return out
}

// jxTemplate rewrites JavaScript's replacement template into the one rxReplace reads.
// The engine expands \1 / \k<name>, which is what Ruby and Python write; JavaScript
// writes $1 / $<name> / $& / $$. The rewrite belongs to the language, not to the
// engine - the interpreter's jsReTemplate is the same function.
// Two forms are NOT covered, because the engine has nothing to rewrite them to: the
// prefix $` and the suffix $' stay the two characters they are written with, and $10
// and up read as $1 followed by a '0', since the expander takes one digit. The
// interpreter side and abnf/jsrtregexjs.go have exactly the same two gaps.
function jxTemplate(t) {
    var out = ""
    var i = 0
    while (i < t.length) {
        var c = t.charCodeAt(i)
        if (c == 92) {                          // a literal backslash must survive rxExpand
            out = out + "\\\\"
            i = i + 1
            continue
        }
        if (c != 36 || i + 1 >= t.length) {     // $
            out = out + t.charAt(i)
            i = i + 1
            continue
        }
        var d = t.charCodeAt(i + 1)
        if (d == 36) {                          // $$
            out = out + "$"
            i = i + 2
            continue
        }
        if (d == 38) {                          // $&
            out = out + "\\0"
            i = i + 2
            continue
        }
        if (d >= 49 && d <= 57) {               // $1 .. $9
            out = out + "\\" + t.charAt(i + 1)
            i = i + 2
            continue
        }
        if (d == 60) {                          // $<name>
            var j = i + 2
            while (j < t.length && t.charCodeAt(j) != 62) { j = j + 1 }
