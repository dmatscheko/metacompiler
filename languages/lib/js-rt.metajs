// which is why `this` travels separately. Nothing on the class chain is undefined,
// and deliberately NOT a read of the receiver: node prints NaN for 'super.zz += 4'
// after 'super.zz = 3'.
function js_supget(sup, self, key) {
    var k = jvStr(key)
    var cls = sup
    while (jvIsObj(cls)) {
        var v = cls[k]
        if (v !== undefined) {
            if (jvIsAcc(v)) { return jvAccGet(v, self) }
            return v
        }
        cls = cls["__super"]
    }
    return undefined
