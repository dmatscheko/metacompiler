        // (js_jsmcall -> jpMethod), so a promise has no own slot of that name and
        // `const t = p.then` answered undefined where node answers a function. The
        // answer is a receiver-BOUND function, which is what makes `t.call(p, f)`
        // work. Same arm in abnf/jsrtjsprint.go's js_jsmget and the interpreters'
        // getMember.
        if (key == "then" || key == "catch" || key == "finally") {
            if (jpIs(o)) { return jpBound(o, key) }
        }
        if (key == "call" || key == "apply") {
            if (jvIsCallable(o)) {
                if (key == "call") { return jvCallShim(o) }
                return jvApplyShim(o)
            }
        }
        if (jvAccN > 0) {
            if (jvIsObj(o)) {
                var cur = o[key]
                if (jvIsAcc(cur)) { return jvAccGet(cur, o) }
                if (cur === undefined) {
                    var acc = jvFindClassAcc(o, key)
                    if (acc !== undefined) { return jvAccGet(acc, o) }
