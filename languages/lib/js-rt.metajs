// ===================================================== replace ============

// jsvExpandDollar: $& the match, $` the prefix, $' the suffix, $$ a literal dollar.
function jvExpandDollar(repl, match, before, after) {
    if (repl.indexOf("$") < 0) { return repl }
    var out = ""
    var i = 0
    while (i < repl.length) {
        var c = repl.charAt(i)
        if (c != "$" || i + 1 >= repl.length) {
            out = out + c
            i = i + 1
        } else {
            var d = repl.charAt(i + 1)
            if (d == "$") {
                out = out + "$"
                i = i + 2
            } else if (d == "&") {
                out = out + match
                i = i + 2
            } else if (d == "`") {
                out = out + before
                i = i + 2
            } else if (d == "'") {
                out = out + after
                i = i + 2
            } else {
                out = out + c
                i = i + 1
            }
