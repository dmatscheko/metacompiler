// declares over the root scope's binding of the same name. Going through a binding
// rather than a call-site rewrite is what keeps shadowing honest.
function js_jsprintfn(name) {
    if (name == "println") {
        return function () {
            var out = ""
            var i = 0
            while (i < arguments.length) {
