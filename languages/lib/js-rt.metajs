                out = out + jvStr(arguments[i])
                i = i + 1
            }
            println(out)
            return undefined
        }
    }
    return function () {
        var out = ""
        var i = 0
        while (i < arguments.length) {
            out = out + jvStr(arguments[i])
            i = i + 1
        }
        print(out)
        return undefined
    }
