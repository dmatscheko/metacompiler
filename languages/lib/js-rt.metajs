    }
    return out
}

// The replacer-FUNCTION form: the callback gets (match, offset, whole).
function jvReplaceFn(s, pat, fn, limit) {
    if (pat == "") { return jvStr(jvCallT(fn, undefined, ["", 0, s])) + s }
    var out = ""
    var at = 0
    var done = 0
    while (true) {
        if (limit >= 0) {
            if (done >= limit) { break }
        }
        var i = jvIndexFrom(s, pat, at)
        if (i < 0) { break }
        out = out + s.substring(at, i)
        out = out + jvStr(jvCallT(fn, undefined, [pat, i, s]))
        at = i + pat.length
        done = done + 1
    }
    return out + s.substring(at, s.length)
}

function jvReplaceTemplate(s, pat, repl, limit) {
    if (pat == "") { return jvExpandDollar(repl, "", "", s) + s }
    var out = ""
    var at = 0
    var done = 0
    while (true) {
        if (limit >= 0) {
            if (done >= limit) { break }
        }
        var i = jvIndexFrom(s, pat, at)
        if (i < 0) { break }
        out = out + s.substring(at, i)
        out = out + jvExpandDollar(repl, pat, s.substring(0, i), s.substring(i + pat.length, s.length))
