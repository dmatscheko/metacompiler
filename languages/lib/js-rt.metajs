// jxReplace is String#replace / #replaceAll with a pattern. A STRING replacement goes
// through the engine's own expander after the template rewrite; a FUNCTION replacement
// is called once per match, with the whole match, the groups, the offset and the input.
function jxReplace(o, s, repl, forceAll) {
    var re = jxProg(o)
    var all = forceAll || jxBool(o, "global")
    if (typeof repl != "function") {
        var res = rxReplace(re, s, jxTemplate(jxToStr(repl)), all)
        if (jxBool(o, "global")) { o["lastIndex"] = 0 }
        return res
    }
    var out = ""
    var at = 0
    var last = 0
    while (at <= s.length) {
        var m = rxSearch(re, s, at)
        if (m === null) { break }
        out = out + s.substring(last, m["begin"])
        var args = []
        var i = 0
        while (i <= re["ngroups"]) {
            var g = rxGroup(re, s, m, i)
            if (g === null) { args.push(undefined) } else { args.push(g) }
            i = i + 1
        }
        args.push(m["begin"])
        args.push(s)
        out = out + jxToStr(repl.apply(undefined, args))
        last = m["end"]
        at = m["end"]
        if (m["end"] == m["begin"]) {
            if (m["end"] < s.length) { out = out + s.charAt(m["end"]) }
            last = m["end"] + 1
            at = m["end"] + 1
