        var j = 0
        while (j < v.length) {
            oa.push(j + "")
            j = j + 1
        }
        return oa
    }
    if (typeof v == "string") {
        var os = []
        var k = 0
        while (k < v.length) {
            os.push(k + "")
            k = k + 1
        }
        return os
    }
    return []
}

// ===================================================== string helpers ======

// indexOf WITH a from-index (the floor's own ignores it).
function jvIndexFrom(s, sub, from) {
    if (from <= 0) { return s.indexOf(sub) }
    if (from > s.length) { return -1 }
    var at = s.substring(from, s.length).indexOf(sub)
    if (at < 0) { return -1 }
    return at + from
}

// jsvSpace, the character set String#trim removes (WhiteSpace + LineTerminator).
function jvIsSpaceCode(c) {
    if (c === 32) { return true }
    if (c >= 9) {
        if (c <= 13) { return true }
    }
    if (c === 160) { return true }
    if (c === 5760) { return true }
    if (c >= 8192) {
        if (c <= 8202) { return true }
    }
    if (c === 8232) { return true }
    if (c === 8233) { return true }
    if (c === 8239) { return true }
    if (c === 8287) { return true }
    if (c === 12288) { return true }
    return c === 65279
}

function jvTrim(s, left, right) {
    var i = 0
    var j = s.length
    if (left) {
        while (i < j && jvIsSpaceCode(s.charCodeAt(i))) { i = i + 1 }
    }
    if (right) {
        while (j > i && jvIsSpaceCode(s.charCodeAt(j - 1))) { j = j - 1 }
    }
