// js-rt.metajs -- JAVASCRIPT'S (AND TYPESCRIPT'S) OWN SEMANTICS, in MetaJS.
// Layer 2 of docs/runtime-next-plan.md part 3, for the eighth and ninth languages
// after the Lua pilot, PHP, Swift, Java, C#, Dart and Go.
//
// ONE FILE FOR BOTH LANGUAGES. languages/js-to-llvm-ir.abnf drives 87 js_* externs
// over every tests/js-test-*.js and languages/typescript-to-llvm-ir.abnf drives 86
// over every tests/typescript-test-*.ts. The two sets differ by three names:
//
//     js_jstonumber   js only  (Number(v), which is TypeScript's too but its
//                               ratchet does not reach it)
//     js_newtarget    js only
//     js_sub          ts only, and it is the C FLOOR'S OWN
//
// so TypeScript's layer 2 is a SUBSET of JavaScript's and typescript-to-llvm-ir.abnf
// links THIS module verbatim. There is no typescript-rt.metajs and there should not
// be one: the two grammars share abnf/jsrt.go + abnf/jsrtjsprint.go +
// abnf/jsrtjsbig.go on the Go side for exactly the same reason.
//
// Compile with:
//     mec languages/metajs-to-llvm-ir.abnf languages/lib/js-rt.metajs -q -rt-lib
// which is what tests/gen-js-rt-ll.sh does; the result is the checked-in
// languages/lib/js-rt.ll that both grammars link next to lib/runtime.ll. -rt-lib
// exports every TOP-LEVEL `function js_*` below under its own C symbol, so nothing
// else in this file is visible to the linker - the helpers are deliberately named
// jv*/jx*/jb*.
//
// THE AUTHORITATIVE SPECIFICATION IS abnf/jsrtjsprint.go (the js_js* value surface),
// abnf/jsrtjsbig.go (BigInt), abnf/jsrtregexjs.go plus abnf/jsrtregex.go (the js_jsx*
// regular expressions), and the js_has / js_defprop / js_iterable / js_supercall /
// js_supget / js_supset / js_call_new / js_this / js_newtarget block of abnf/jsrt.go.
// This file matches them function for function; where it CANNOT, the site says so in
// full. Written against the Go CODE, not the Go comments (docs/runtime-next-plan.md,
// "What DART added").
//
// ----- the extern split ------------------------------------------------------
//
//     the C floor            39   the generic primitives, js_truthy, js_genfn /
//                                 js_yield / js_ctl_*, js_keys, js_scope_*
//     layer 2, NEUTRAL       10   js_has, js_defprop, js_iterable, js_supercall,
//                                 js_supget, js_supset, js_call_new, js_this,
//                                 js_newtarget, js_scope_set_or_create
//     layer 2, JS's own      38   js_js* and js_jsx*
//
// ----- what js/ts did NOT need, checked rather than assumed -------------------
//
//  1. NO `__raw` truthy shim. `grep -n 'truthyExt *=' languages/js-to-llvm-ir.abnf`
//     and the typescript one are EMPTY (the two hits are READS of core.truthyExt in
//     the ||= arm), so both keep compile-core's default "js_truthy", which is the C
//     FLOOR'S OWN function and already answers the raw 1/0 the emitted
//     `icmp ne ..., 0` compares. Swift, Java, C#, Dart and Go were the same; Lua and
//     PHP are the only two that override it.
//  2. ZERO `_raw` PARAMETERS. Every `handle(k)` in either grammar feeds js_num_i,
//     js_closure or js_arg, all three of them floor externs.
//  3. Generators cost this file NOTHING for the DRIVING half, exactly as C# found:
//     both grammars emit js_genfn(js_closure(...)) and then reach the generator
//     through js_get(g, "next") + js_call, which the floor's get_member answers with
//     a bound gen_next. `yield` is js_yield, a floor extern. What js DOES owe, and C#
//     did not, is the INSPECTION half - `.return()` and `.throw()` - and the for-of
//     drain (js_iterable).
//
// ----- MetaJS rules that shape the code below --------------------------------
//
// docs/abnf-dialect-gotchas.md: a local (or a reassigned parameter) keeps the TYPE
// CLASS it is first assigned, so a variable that holds a number in one branch and an
// object in another is declared `var x = anytype`; there is no ASI, so every `return`
// carries its value on the same line and a value-less early return is BRACED; no
// for..in, no splice, no split/join/lastIndexOf, indexOf ignores its from-index,
// array.length is not assignable, and there are no exponent literals.

// ===================================================== the dynamic `this` ===
//
// WALL 1, and it is a NEW SHAPE of the private-representation probe. `js_this` and
// `js_newtarget` read abnf/jsrt.go's thisStack / newTargetStack - the Go runtime's
// own CALL STACK. That is not a scope and not a control signal; it is state the
// floor's js_call does not keep at all (runtime.c's js_call drops `self` for a
// tag-7 closure and hands jsdispatch only (env, args)).
//
// So this is the first wall in part 3 that could NOT be lowered by finding a floor
// extern that already answers it - there is none. What it CAN be is kept HERE, in
// layer 2, because layer 2 is a module with globals of its own and because every
// call that carries a receiver goes through a function in THIS file (js_jsmcall,
// js_supercall, js_call_new) or through a js_call site the emitter owns.
//
// The emitter's half is one extern call, emitted ONLY under -exe (see jsCall in
// js-to-llvm-ir.abnf): `js_jssetthis(receiver)` immediately before each js_call. No
// restore is needed and that is worth stating, because it looks like a bug: `this`
// is read exactly ONCE per function, at ENTRY, where the emitter binds it into the
// scope (`js_scope_decl(scope, "this", js_this())`). A nested call that overwrites
// the cell therefore cannot be observed by the caller, which already copied it.
//
// The module under llvm.Run is UNCHANGED - it still declares js_this/js_newtarget
// and abnf/jsrt.go still answers them from its own stacks - so nothing in the
// matrix moves. The two modules differ, which is already true of emitDispatch.

// `anytype` and not `undefined`: a MetaJS local pins the TYPE CLASS of its first
// assignment, and these two hold every value in the language.
var jvThis = anytype
var jvNewTarget = anytype

function js_jssetthis(v) {
    jvThis = v
    jvNewTarget = undefined
    return undefined
}

// js_jssetnew(ctor, receiver): the js_call_new arming, split out so that the emitter
// can use it directly for `new F()` and layer 2 for a super() chain.
function js_jssetnew(ctor, v) {
    jvThis = v
    jvNewTarget = ctor
    return undefined
}

function js_this() { return jvThis }

function js_newtarget() { return jvNewTarget }

// ===================================================== value predicates =====

function jvIsObjLike(v) {
    if (v === undefined) { return false }
    if (v === null) { return false }
    if (Array.isArray(v)) { return true }
    return typeof v == "object"
}

function jvIsObj(v) {
    if (v === undefined) { return false }
    if (v === null) { return false }
    if (Array.isArray(v)) { return false }
    return typeof v == "object"
}

function jvIsCallable(v) {
    if (v === undefined) { return false }
    if (v === null) { return false }
    return typeof v == "function"
}

// ===================================================== stubs still owed =====
//
// Everything below this line is a LOUD STUB. See docs/runtime-next-plan.md part 3,
// the JS/TS section, for what is measured and what is not.

// `typeof` for a native build. The emitter routes the user-visible `typeof` here
// under -exe only (js-to-llvm-ir.abnf's typeofExt): abnf/jsrtjsbig.go's BigInt is a
// Go TYPE whose js_typeof answers "bigint", and layer 2's is an ordinary object box
// that the floor's type_of can only call "object". Everything else is the floor's
// own answer, tag 16 ("function") included.
function js_jstypeof(v) {
    if (jbIsBig(v)) { return "bigint" }
    return typeof v
}

// ================================ the floor externs a BigInt is taken from ===
//
// Under -exe the emitter routes `===`, `!==`, unary `-`, `!`, `typeof` and
// compile-core's truthy() here (see seqExt / sneExt / negExt / notExt / typeofExt /
// core.truthyExt in js-to-llvm-ir.abnf). Every one of them exists because
// abnf/jsrt.go's BigInt is a Go TYPE with an arm in strictEq / truthy / js_neg /
// typeOf, and layer 2's is an ordinary object box the C floor would answer
// "truthy", "identity", NaN and "object" for. Each delegates to the floor's own
// operator for every value that is not a BigInt, so a program without one pays a
// call and nothing else.

function js_jsseq(a, b) {
    if (jbIsBig(a)) {
        if (jbIsBig(b)) { return jbCmp(a, b) == 0 }
        return false
    }
    if (jbIsBig(b)) { return false }
    return a === b
}

function js_jssne(a, b) { return !js_jsseq(a, b) }

function js_jsneg(v) {
    if (jbIsBig(v)) { return jbNeg(v) }
    return -v   // NEVER `0 - v`: the signed-zero trap of part 3.
}

function js_jsnot(v) {
    if (jbIsBig(v)) { return !jbTruthy(v) }
    return !v
}

// The `__raw` SUFFIX: -rt-lib exports this as js_jstruthy and puts the result
// through the floor's own js_truthy, which is the raw 1/0 compile-core's
// `icmp ne ..., 0` compares. Answering the HANDLE of a MetaJS boolean would answer
// 2 for false, and 2 != 0, so every condition in the program would be taken.
function js_jstruthy__raw(v) {
    if (jbIsBig(v)) { return jbTruthy(v) }
    return v
}

// There is no js_jstpl any more. A native build used to join a template literal with
// a BigInt-aware `+` of its own, because the emitter joined the RAW parts and the
// floor's js_add cannot spell a BigInt. Both emitters now push every interpolated
// PART through js_jsstr (ToString, hint STRING) and join the strings with the floor's
// js_add, which is one function instead of two and is what makes a user `toString`,
// a class instance and a BigInt come out right in ALL THREE engines at once.

// WALL 3 IS CLOSED, and nothing of it is left here. js_scope_set_or_create walks a
// SCOPE, which layer 2 cannot open, and the emitter used to lower it to the floor's
// js_pyset_var - exact for every DECLARED name and wrong only for an implicit global
// created inside a function and read outside it. The C floor now exports the real
// thing (runtime.c, next to js_pyset_var), so both emitters call it under either
// engine and this file must NOT define a twin: a top-level `function js_*` here is
// an exported C symbol and would be a redefinition at link time.

// ##########################################################################
// # LAYER 2, PART A - the JavaScript VALUE SURFACE (abnf/jsrtjsprint.go)
// ##########################################################################

// ===========================================================================
// jsrt-value.metajs -- JavaScript's VALUE SURFACE in MetaJS.
//
// The Go twin, function for function, is abnf/jsrtjsprint.go (1320 lines) plus the
// js_has / js_defprop / js_iterable / js_supercall / js_supget / js_supset /
// js_call_new block of abnf/jsrt.go. Written against the Go CODE.
//
// Helper prefix: jv. Every top-level `function js_*` below is an exported C symbol.
//
// ----- what layer 2 has to supply that the Go runtime got for free ----------
//
//  1. There is NO js_mcall in the C floor (runtime.c exports js_get/js_set and a
//     small bound-method table, nothing that dispatches a method on an instance).
//     abnf/jsrt.go's js_jsmcall falls back to js_mcall -> rt.memberCall; here that
//     fallback is written out at the end of js_jsmcall (jvFallbackCall).
//  2. DELETE was the one floor gap this file paid for, and it is CLOSED: the floor
//     now exports js_del, reachable from MetaJS as the host builtin `delKey`
//     (runtime.c host id 63, abnf/jsrtint.go, metajs-interpreter.abnf). js_jsdel is
//     four lines again and the side table of blanked keys is gone with all its
//     consumers - so key ORDER after delete-then-reinsert, for-in and object spread
//     are node's answers now, not just `delete` + `in` + Object.keys.
//  3. An ACCESSOR is a Go type (*jsAccessor) there and an object box here:
//     {__acc: 1, g: getter, s: setter}. js_jsmget / js_jsmset / js_supget /
//     js_supset / js_has are the five places that know the box.
//  4. accessorCount is jvAccN: while no accessor has ever been defined, js_jsmget
//     and js_jsmset are a straight delegation to js_get / js_set, which matters
//     because the emitter routes EVERY member and index read through js_jsmget.
//
// The MetaJS subset rules apply throughout (docs/abnf-dialect-gotchas.md): no ASI,
// a local keeps the type class it is first assigned, no for..in, no splice/split/
// join/lastIndexOf of our own, array.length is not assignable, no exponent literals.

// ===================================================== small utilities =====

// The "this method / this receiver is not ours" sentinel, the shape jxMiss has.
// A UNIQUE object, so no user value can ever be mistaken for it.
var jvMiss = {}

// The accessor-property count. abnf/jsrt.go's rt.accessorCount: while it is 0 the
// member paths cannot meet an accessor and skip the whole lookup.
var jvAccN = 0

// The `String` global js_jsstringfn handed out, kept so that js_jsmcall can
// recognize the receiver of String.fromCharCode (the Go twin tests hf.name).
var jvStringFn = anytype

function jvIsAcc(v) {
    if (v === undefined) { return false }
    if (v === null) { return false }
    if (Array.isArray(v)) { return false }
    if (typeof v != "object") { return false }
    return v["__acc"] === 1
}

// Call a user function with an explicit `this`. There is no emitter call site
// between layer 2 and a callback, so the receiver has to be armed here.
function jvCallT(f, self, args) {
    js_jssetthis(self)
    return f.apply(self, args)
}

function jvPrepend(recv, args) {
    var out = []
    out.push(recv)
    var i = 0
    while (i < args.length) {
        out.push(args[i])
        i = i + 1
    }
    return out
}

function jvArg(args, i) {
    if (i < args.length) { return args[i] }
    return undefined
}

function jvUndefOrNull(v) {
    if (v === undefined) { return true }
    return v === null
}

// ===================================================== ToString ============
//
// jsvCallMethod (abnf/jsrtjsprint.go): run o's own `name` method if it has one.
// The two places a method can live take DIFFERENT calling conventions - a class
// method sits on the __class descriptor and gets the receiver PREPENDED, an
// object-literal method is an ordinary closure that reads `this`. Answers jvMiss
// when there is no such method, so the "handled" flag needs no global.

function jvCallMethod(o, name) {
    var cls = o["__class"]
    while (jvIsObj(cls)) {
        var m = cls[name]
        if (jvIsCallable(m)) { return jvCallT(m, undefined, [o]) }
        cls = cls["__super"]
    }
    var own = o[name]
    if (jvIsCallable(own)) { return jvCallT(own, o, []) }
    return jvMiss
}

// jsvString: String(v) with a user toString. The BigInt and RegExp arms are the
// other two agents' (jbStr / jxStr), asked FIRST because both of their values are
// carried in an object box that jvIsObj would otherwise claim.
function jvStr(v) {
    if (typeof v == "string") { return v }
    if (jbIsBig(v)) { return jbStr(v) }
    if (jxIsRe(v)) { return jxStr(v) }
    if (jvIsObj(v)) {
        var r = jvCallMethod(v, "toString")
        if (r !== jvMiss) {
            if (typeof r == "string") { return r }
            return jvStr(r)
        }
        // A promise carries hidden slots only, so the generic arm would spell it
        // "[object Object]" where node says "[object Promise]" (Promise.prototype
        // has a @@toStringTag). Same arm in abnf/jsrtjsprint.go's jsvString and in
        // the interpreter halves' jsStr.
        if (jpIs(v)) { return "[object Promise]" }
        return "[object Object]"
    }
    if (Array.isArray(v)) {
        var out = ""
        var i = 0
        while (i < v.length) {
            if (i > 0) { out = out + "," }
            var e = v[i]
            // undefined and null join as the empty string.
            if (!jvUndefOrNull(e)) { out = out + jvStr(e) }
            i = i + 1
        }
        return out
    }
    return v + ""
}

// ============================ ToPrimitive, == and the relational operators ==

function jvToNumber(v) {
    return v * 1
}

// jsvToPrimitive: valueOf first, then toString.
function jvToPrimitive(v) {
    if (jbIsBig(v)) { return v }
    if (jvIsObj(v)) {
        var r = jvCallMethod(v, "valueOf")
        if (r !== jvMiss) {
            if (!jvIsObjLike(r)) { return r }
        }
        return jvStr(v)
    }
    if (Array.isArray(v)) { return jvStr(v) }
    return v
}

// The primitive form of an operand of ==, <, > or +. A BigInt box is already a
// primitive and must NOT be run through jvStr.
function jvPrim(v) {
    if (jbIsBig(v)) { return v }
    return jvToPrimitive(v)
}

// jsvLooseEq: the abstract equality comparison.
function jvLooseEq(a, b) {
    if (typeof a != "object") {
        if (typeof b != "object") { return a == b }   // see js_jsadd's fast path
    }
    if (jbIsBig(a) || jbIsBig(b)) { return jbEq(jvPrim(a), jvPrim(b)) }
    if (jvUndefOrNull(a) || jvUndefOrNull(b)) {
        if (jvUndefOrNull(a)) { return jvUndefOrNull(b) }
        return false
    }
    var ao = jvIsObjLike(a)
    var bo = jvIsObjLike(b)
    if (ao) {
        if (bo) { return a === b }
        return jvLooseEq(jvToPrimitive(a), b)
    }
    if (bo) { return jvLooseEq(a, jvToPrimitive(b)) }
    return a == b
}

// jsCompare over two PRIMITIVES: -1 / 0 / 1, and 2 when a NaN was involved (every
// relation is then false).
function jvCmpPrim(a, b) {
    if (typeof a == "string") {
        if (typeof b == "string") {
            if (a < b) { return -1 }
            if (a > b) { return 1 }
            return 0
        }
    }
    var x = jvToNumber(a)
    var y = jvToNumber(b)
    if (x !== x) { return 2 }
    if (y !== y) { return 2 }
    if (x < y) { return -1 }
    if (x > y) { return 1 }
    return 0
}

// jsvCompare: ToPrimitive on both sides, then the shared ordering.
function jvCompare(a, b) {
    if (typeof a != "object") {
        if (typeof b != "object") { return jvCmpPrim(a, b) }   // see js_jsadd
    }
    var pa = jvPrim(a)
    var pb = jvPrim(b)
    if (jbIsBig(pa) || jbIsBig(pb)) { return jbCmp(pa, pb) }
    return jvCmpPrim(pa, pb)
}

// ===================================================== the operators =======

// '+' WITH ToPrimitive. Two primitive operands go straight to the floor's own
// js_add, which is every addition a program that adds no objects performs.
function js_jsadd(a, b) {
    // The FAST PATH, and the reason it is a typeof test rather than four calls:
    // every value this function has anything of its own to do with - an object, an
    // array, a BigInt box, a RegExp box - is `typeof "object"` on the floor, so two
    // non-objects are exactly the case the floor's own js_add already answers.
    if (typeof a != "object") {
        if (typeof b != "object") { return a + b }
    }
    if (jbIsBig(a) || jbIsBig(b)) { return jbAdd(jvPrim(a), jvPrim(b)) }
    if (!jvIsObjLike(a)) {
        if (!jvIsObjLike(b)) { return a + b }
    }
    var lp = jvToPrimitive(a)
    var rp = jvToPrimitive(b)
    if (typeof lp == "string") { return lp + jvStr(rp) }
    if (typeof rp == "string") { return jvStr(lp) + rp }
    if (jbIsBig(lp) || jbIsBig(rp)) { return jbAdd(lp, rp) }
    return jvToNumber(lp) + jvToNumber(rp)
}

function js_jseq(a, b) { return jvLooseEq(a, b) }

function js_jsne(a, b) {
    if (jvLooseEq(a, b)) { return false }
    return true
}

function js_jslt(a, b) { return jvCompare(a, b) === -1 }

function js_jsgt(a, b) { return jvCompare(a, b) === 1 }

function js_jsle(a, b) {
    var c = jvCompare(a, b)
    if (c === -1) { return true }
    return c === 0
}

function js_jsge(a, b) {
    var c = jvCompare(a, b)
    if (c === 1) { return true }
    return c === 0
}

// ===================================================== delete =============
//
// `delKey` is the floor's js_del under its host-builtin name (runtime.c host id 63,
// abnf/jsrtint.go's keysBindings). It REMOVES the key and its key-order entry, so
// key order after a delete-then-reinsert, for-in, object spread and Object.keys are
// all the floor's own answers and need no bookkeeping here.
//
// What this replaced: a side table of blanked keys (jvDelO/jvDelK/jvDelN), which
// every own-keys walk and every js_has had to consult. It was linear in the number
// of DISTINCT deleted-from objects per delete - quadratic over a loop, measured at
// 61 s for 4000 iterations against 0.03 s now - it never freed an entry, and it
// could not repair key order at all.

// 'delete a[i]' on an ARRAY: the length is unchanged and the slot reads as
// undefined (a real JS hole cannot be modelled - the interpreter half's arrays
// carry no side data, so both halves blank the slot).
function js_jsdel(o, key) {
    if (Array.isArray(o)) {
        var idx = jvToNumber(key)
        if (idx === Math.trunc(idx)) {
            if (idx >= 0) {
                if (idx < o.length) { o[idx] = undefined }
            }
        }
        return true
    }
    if (jvIsObj(o)) { delKey(o, jvStr(key)) }
    return true
}

// ===================================================== accessors ==========

// findClassAccessor (abnf/jsrt.go): an instance does not carry its class's
// accessors; they live on the __class descriptor and its __super chain.
function jvFindClassAcc(o, name) {
    var cls = o["__class"]
    while (jvIsObj(cls)) {
        var v = cls[name]
        if (v !== undefined) {
            if (jvIsAcc(v)) { return v }
            return undefined
        }
        cls = cls["__super"]
    }
    return undefined
}

function jvAccGet(acc, self) {
    var g = acc["g"]
    if (!jvIsCallable(g)) { return undefined }
    return jvCallT(g, self, [])
}

function jvAccSet(acc, self, v) {
    var s = acc["s"]
    if (jvIsCallable(s)) { jvCallT(s, self, [v]) }
    return undefined
}

// js_defprop: (obj, key, getter|undef, setter|undef). Two calls for the same key
// merge, so 'get x' and 'set x' meet on one record.
function js_defprop(o, key, getter, setter) {
    if (!jvIsObj(o)) { fail("js_defprop needs an object") }
    var k = jvStr(key)
    var acc = anytype
    var cur = o[k]
    if (jvIsAcc(cur)) {
        acc = cur
    } else {
        acc = {}
        acc["__acc"] = 1
        acc["g"] = undefined
        acc["s"] = undefined
    }
    if (jvIsCallable(getter)) { acc["g"] = getter }
    if (jvIsCallable(setter)) { acc["s"] = setter }
    o[k] = acc
    jvAccN = jvAccN + 1
    return undefined
}

// ===================================================== member read/write ===
//
// jsvStringMethods / jsvArrayMethods are the names js_jsmget HIDES from js_get, so
// that a call on a string or an array reaches js_jsmcall instead of the floor's
// bound-method path - which implements a different (Java flavoured) semantics for
// several of them.

var jvStrM = {}
var jvArrM = {}

function jvSeedMethodNames() {
    jvStrM["charAt"] = 1
    jvStrM["charCodeAt"] = 1
    jvStrM["codePointAt"] = 1
    jvStrM["at"] = 1
    jvStrM["indexOf"] = 1
    jvStrM["lastIndexOf"] = 1
    jvStrM["includes"] = 1
    jvStrM["startsWith"] = 1
    jvStrM["endsWith"] = 1
    jvStrM["slice"] = 1
    jvStrM["substring"] = 1
    jvStrM["substr"] = 1
    jvStrM["split"] = 1
    jvStrM["toUpperCase"] = 1
    jvStrM["toLowerCase"] = 1
    jvStrM["trim"] = 1
    jvStrM["trimStart"] = 1
    jvStrM["trimEnd"] = 1
    jvStrM["padStart"] = 1
    jvStrM["padEnd"] = 1
    jvStrM["repeat"] = 1
    jvStrM["concat"] = 1
    jvStrM["replace"] = 1
    jvStrM["replaceAll"] = 1
    jvStrM["toString"] = 1
    jvStrM["valueOf"] = 1
    jvStrM["localeCompare"] = 1

    jvArrM["push"] = 1
    jvArrM["pop"] = 1
    jvArrM["shift"] = 1
    jvArrM["unshift"] = 1
    jvArrM["slice"] = 1
    jvArrM["splice"] = 1
    jvArrM["indexOf"] = 1
    jvArrM["lastIndexOf"] = 1
    jvArrM["includes"] = 1
    jvArrM["join"] = 1
    jvArrM["concat"] = 1
    jvArrM["reverse"] = 1
    jvArrM["sort"] = 1
    jvArrM["map"] = 1
    jvArrM["filter"] = 1
    jvArrM["forEach"] = 1
    jvArrM["reduce"] = 1
    jvArrM["reduceRight"] = 1
    jvArrM["some"] = 1
    jvArrM["every"] = 1
    jvArrM["find"] = 1
    jvArrM["findIndex"] = 1
    jvArrM["findLast"] = 1
    jvArrM["findLastIndex"] = 1
    jvArrM["flat"] = 1
    jvArrM["flatMap"] = 1
    jvArrM["fill"] = 1
    jvArrM["at"] = 1
    jvArrM["toString"] = 1
