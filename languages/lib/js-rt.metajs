// part through it. See the note where js_jstpl used to be, in the BASE file.

// The `Object` global, declared by the grammar in the PROGRAM's own scope so no
// other language sees it.
function js_jsobject() {
    var o = {}
    o["__jsobject"] = true
    return o
}

