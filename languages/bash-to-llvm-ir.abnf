    // languages/bash-interpreter.abnf's isPatOp / applyPatOp are the same table.
    function isPatOp(pe) {
        if (pe == "#" || pe == "##" || pe == "%" || pe == "%%") { return true }
        if (pe == "^" || pe == "^^" || pe == "," || pe == ",," || pe == "~" || pe == "\x7e\x7e") { return true }
        return (pe == "/" || pe == "//")
    }
    function patOpKind(pe) {
        if (pe == "#" || pe == "##" || pe == "%" || pe == "%%") { return 0 }
        if (pe == "/" || pe == "//") { return 1 }
        return 2
    }
    function patOpMode(pe, anchor) {
        if (pe == "##") { return 1 }
        if (pe == "%") { return 2 }
        if (pe == "%%") { return 3 }
        if (pe == "^^") { return 1 }
        if (pe == ",") { return 2 }
        if (pe == ",,") { return 3 }
        if (pe == "~") { return 5 }
        if (pe == "\x7e\x7e") { return 6 }
        if (pe == "/" || pe == "//") {
            if (anchor == "#") { return 2 }
            if (anchor == "%") { return 3 }
            return (pe == "//") ? 1 : 0
        }
        return 0
    }

    // The @-transforms rt_mapf can walk element-wise, as an (kind, mode) pair. -1 means
    // "not one of them": @A, @a, @K and @k describe the VARIABLE rather than an element
    // when the subscript is @ or *, so they are handled beside this walk, not by it.
    function xfMapKind(xf) {
        if (xf == "U" || xf == "L" || xf == "u") { return 2 }
        if (xf == "E") { return 4 }
        if (xf == "P") { return 5 }
        if (xf == "Q") { return 3 }
        return -1
    }
    function xfMapMode(xf) {
        if (xf == "U") { return 1 }
        if (xf == "L") { return 3 }
        return 0
    }

    // ${!REF OP ...}: the operator applies to whatever the indirection lands on, found ONCE
    // per expansion (rt_indname), exactly as if the target had been written there: on @ or *
    // and on NAME[SUB] it takes the subscripted path, so a list target is operated on
    // element-wise (set -- p q; x=@; "${!x:1}" is "${@:1}"). So four expansions are emitted
    // and rt_indlist picks one at run time: the scalar arms for a plain NAME (reading it from
    // `cell.tg`), and the subscripted path for the positional parameters, an associative
    // array and any other NAME[SUB], whose name and subscript come from the target (cell.nm,
    // cell.sub). A ${!REF:?} error names "!REF". Twin of mkParamExp in bash-interpreter.abnf.
    // ${...}, through a caller's nameref where one may stand (refMayThunk).
    function mkParamExp(items) {
        var t = mkParamExpAt(items)
        var i
        for (i = 0; i < items.length; i++) {
            if (typeof items[i] != "function" && items[i].pname != undefined) { t.fn = refMayThunk(items[i].pname, t.fn) }
        }
        return t
    }
    function mkParamExpAt(items) {
        var name = "", indp = false, hasIdx = false, bare = true, pfx = false, lenp = false, xfAttr = false
        var idxIt = null
        var wordObjs = []
        var rest = []
        var i
        for (i = 0; i < items.length; i++) {
            var it = items[i]
            if (typeof it != "function" && it.fn != undefined) { wordObjs.push(it); continue }
            if (typeof it != "function") {
                if (it.indp != undefined) { indp = true; continue }
                if (it.pname != undefined) { name = it.pname; continue }
                if (it.hasIdx != undefined) { hasIdx = true; idxIt = it; continue }
                if (it.op != undefined || it.pe != undefined || it.xf != undefined) { bare = false }
                if (it.xf == "a" || it.xf == "A") { xfAttr = true }
                if (it.pfx != undefined) { pfx = true }
                if (it.lenp != undefined) { lenp = true }
            }
            rest.push(it)
        }
        if (!indp || bare || pfx) {
            var pc = paramCore(items, null)
            // @a and @A look a circular chain up twice more, each a warning (rt_nref_end; bash
            // 5.3: three for ${REF@a}, four for ${REF[@]@a}). Twin of the xfAttr arm in
            // bash-interpreter.abnf.
            var xaRef = function(b) {
                if (xfAttr && !pfx) {
                    b.NewCall(rtNrefEnd, gepStr(b, name))
                    b.NewCall(rtNrefEnd, gepStr(b, name))
                }
            }
            var pcFn = pc.fn
            var pcName = name
            if (!hasIdx || pfx) {
                if (xfAttr && !pfx) {
                    pc.fn = function(b) {
                        if (attrOn(refVars, pcName)) { xaRef(b) }
                        return pcFn(b)
                    }
                }
                return pc
            }
            // Through a nameref, NAME[SUB] is the element of the array it names, found when
            // it runs (rt_nref_elems), as an indirection's is.
            var rcell = {tg: null, nm: null, sub: null}
            var ritems = []
            for (i = 0; i < items.length; i++) { ritems.push(items[i]) }
            ritems.push({rtNm: 1})
            var rpc = paramCore(ritems, rcell)
            pc.fn = function(b) {
                if (!attrOn(refVars, pcName)) { return pcFn(b) }
                xaRef(b)
                rcell.nm = b.NewCall(rtNrefElems, [gepStr(b, pcName), (lenp || indp) ? one : zero])
                var rr = rpc.fn(b)
                rr.b.NewCall(rtNrefUnglob)
                return rr
            }
            return pc
        }
        var idxW = hasIdx ? wordObjs[0] : null
        for (i = hasIdx ? 1 : 0; i < wordObjs.length; i++) { rest.push(wordObjs[i]) }
        var cell = {tg: null, nm: null, sub: null}
        var subW = {fn: function(b) { return {b: b, v: cell.sub} }, c: undefined}
        var qn = {qname: "!" + name}
        var forms = [paramCore(items, cell),
                     paramCore(targetItems("@", qn, null, subW, rest), cell),
                     paramCore(targetItems("", qn, {rtNm: 1}, subW, rest), cell)]
        return {c: undefined, f: true, fn: function(b) {
            var tg = null
            if (idxW == null) {
                tg = b.NewCall(rtIndName, [gepStr(b, name), nullStr, varString(b, name), one])
            } else {
                var ikind = idxKind(idxIt, idxW)
                var rs = subKeyOf(b, name, idxW, null, ikind == 0, idxAqOf(idxIt))
                b = rs.b
                var sv = b.NewCall(rtIndSub, [gepStr(b, name), rs.k, subKind(b, ikind, rs.v)])
                tg = b.NewCall(rtIndName, [gepStr(b, name), rs.v, sv, zero])
            }
            var cls = b.NewCall(rtIndList, tg)
            cell.tg = tg
            cell.nm = b.NewCall(rtIndPart, [tg, zero])
            cell.sub = b.NewCall(rtIndPart, [tg, one])
            var merge = curF.NewBlock("")
            var incs = []
            var blks = []
            var k
            for (k = 0; k < forms.length; k++) { blks.push(curF.NewBlock("")) }
            // cls 0 and 1 pick forms[cls], 2 and 3 (an array of either kind) the last: a chain
            // of tests, the last one falling through
            var test = b
            for (k = 0; k < forms.length - 1; k++) {
                var nxt = (k == forms.length - 2) ? blks[k + 1] : curF.NewBlock("")
                test.NewCondBr(test.NewICmp(llvm.enum.IPredEQ, cls, llvm.constant.NewInt(i32, k)), blks[k], nxt)
                test = nxt
            }
            for (k = 0; k < forms.length; k++) {
                var r = forms[k].fn(blks[k])
                r.b.NewBr(merge)
                incs.push(llvm.ir.NewIncoming(r.v, r.b))
            }
            return {b: merge, v: merge.NewPhi(incs)}
        }}
    }
    // The items of ${@[SUB] OP ...} / ${NAME[SUB] OP ...} for a target, around the operator's:
    // `mark` makes the name the target's (rtNm).
    function targetItems(nm, qn, mark, subW, rest) {
        var out = [qn, {pname: nm}, {hasIdx: 1}, subW]
        if (mark != null) { out.push(mark) }
        var i
        for (i = 0; i < rest.length; i++) { out.push(rest[i]) }
        return out
    }
    // ${...} : items are [{pname}, {pe}?, {op}?, {anchor}?, word objects / arithmetic thunks];
    // `cell` carries the run-time target of an indirection with an operator (see mkParamExp).
    function paramCore(items, cell) {
        var pe = "", name = "", op = "", anchor = "", xf = "", pfx = ""
        var lenp = false, indp = false
        var badsub = null
        var badRc = null
        var words = []     // word objects {fn, c}
        var ariths = []    // bare arithmetic thunks (the ${v:off:len} offsets)
        var wordT = null
        var hasIdx = false
        var idxIt = null
        var rtNm = false
        var errName = null
        var i
        for (i = 0; i < items.length; i++) {
            var it = items[i]
            if (typeof it == "function") { ariths.push(it) }
            else if (it.qname != undefined) { errName = it.qname }
            else if (it.hasIdx != undefined) { hasIdx = true; idxIt = it }
            else if (it.rtNm != undefined) { rtNm = true }
            else if (it.fn != undefined) { words.push(it); wordT = it }
            else if (it.lenp != undefined) { lenp = true }
            else if (it.badsub != undefined) { badsub = it.badsub; badRc = it.rec }
            else if (it.indp != undefined) { indp = true }
            else if (it.xf != undefined) { xf = it.xf }
            else if (it.pfx != undefined) { pfx = it.pfx }
            else if (it.pe != undefined) { pe = it.pe }
            else if (it.pname != undefined) { name = it.pname }
            else if (it.op != undefined) { op = it.op }
            else if (it.anchor != undefined) { anchor = it.anchor }
        }
        // A BARE "#"/"!" prefix keeps the dedicated length / indirection paths (including
        // their array forms ${#a[@]} and ${!a[@]}); combined with an operator it does not.
        var bare = (op == "" && pe == "" && xf == "")
        if (lenp && bare) { pe = "len" }
        // `${#x-default}`, `${(m)foo}`: bash's run-time "bad substitution", which abandons
        // the command line with status 1 (arith_err). Twin of the badsub arm of paramCore in
        // bash-interpreter.abnf.
        if (badsub != null) {
            var badMsg = "${" + badsub + "}: bad substitution\n"
            return {c: undefined, fn: function(b) {
                // Only the first error of a command is reported.
                var first = curF.NewBlock(""), done = curF.NewBlock("")
                b.NewCondBr(b.NewICmp(llvm.enum.IPredEQ, b.NewOr(b.NewLoad(i32, gAbort), b.NewLoad(i32, gArithErr)), zero), first, done)
                emitDiag(first, gepStr(first, badSubMsg(badRc(), badsub)))
                first.NewBr(done)
                done.NewStore(one, gArithErr)
                return {b: done, v: emptyPtr(done)}
            }}
        }
        if (indp && bare && pfx == "") { pe = "ind" }
        // ${!prefix*} / ${!prefix@}: sorted, joined by IFS's first character for *.
        if (pfx != "") {
            var pfxAt = pfx.charAt(pfx.length - 1) == "@"
            var pfxName = name
            return {c: undefined, f: pfxAt, fn: function(b) {
                return {b: b, v: b.NewCall(rtPfxNames, [gepStr(b, pfxName), ifsFirstValue(b), pfxAt ? zero : one])}
            }}
        }
        // $@ and $* WITH AN OPERATOR are the positional parameters as a LIST, as
        // ${a[@]} / ${a[*]} are an array's, so they take the subscripted path below with
        // "@"/"*" as both the name and the subscript (rt_sc_count / rt_sc_get /
        // rt_sc_has / rt_sc_list answer the parameters for those names), every
        // @-transform included (rt_declpos has @A's own form). Twin of the same routing
        // in bash-interpreter.abnf.
        if (!hasIdx && (name == "@" || name == "*") && !lenp && !indp
            && (pe == "substr" || isPatOp(pe) || op != "" || xf != "")) {
            hasIdx = true
            var posWords = [makeConst(name)]
            for (var pw = 0; pw < words.length; pw++) { posWords.push(words[pw]) }
            words = posWords
        }
        // The @-transforms. @U/@L/@u are rt_case, @Q/@K/@k are rt_shq, @A is the assignment
        // that would recreate the variable, @E decodes the $'...' escapes at run time and
        // @P is rt_prompt. -r and -x are modelled in neither half, so they are absent from
        // both.
        // The attribute letters of the name, as an i8*: A/a for the two array kinds ahead
        // of i/l/u for the scalar ones, which is what the interpreter half answers too.
        // `nmv` is the name - a constant for a plain expansion, and the value of the
        // reference for ${!r@A}, where bash names the variable the indirection LANDED on.
        // The scalar letters come from the lexical tables, which is the compiler's
        // documented attribute scope (manual 7.9); only array-ness is asked at RUN time,
        // because `q=(1 2)` declares nothing, hence the select. Through a chain of namerefs
        // whose targets are all written literally they are the last target's; a computed
        // target is known at run time only, so its letters are picked there by the name the
        // chain landed on (nmv) from every name the tables know.
        function attrLetters(b, nmv) {
            var xfName = name
            var hop = 0
            while (hop < 8 && typeof attrOn(refVars, xfName) == "string") { xfName = attrOn(refVars, xfName); hop = hop + 1 }
            if (typeof attrOn(refVars, xfName) == "boolean" && attrOn(refVars, xfName)) {
                var pick = emptyPtr(b)
                var k
                for (k = 0; k < varIdList.length; k++) {
                    var lk = scalarAttrLetters(varIdList[k])
                    if (lk != "") { pick = b.NewSelect(b.NewICmp(llvm.enum.IPredNE, b.NewCall(rtStreq, [nmv, gepStr(b, varIdList[k])]), zero), gepStr(b, lk), pick) }
                }
                var arrK = b.NewSelect(b.NewICmp(llvm.enum.IPredNE, b.NewCall(rtArrAny, nmv), zero), gepStr(b, "a"), emptyPtr(b))
                arrK = b.NewSelect(b.NewICmp(llvm.enum.IPredNE, b.NewCall(rtIsAssoc, nmv), zero), gepStr(b, "A"), arrK)
                return b.NewCall(rtXletters, [nmv, b.NewCall(rtStrcat, [arrK, pick])])
            }
            var sc = scalarAttrLetters(xfName)
            var isArrRt = b.NewICmp(llvm.enum.IPredNE, b.NewCall(rtArrAny, nmv), zero)
            var isAsRt = b.NewICmp(llvm.enum.IPredNE, b.NewCall(rtIsAssoc, nmv), zero)
            return b.NewCall(rtXletters, [nmv, b.NewSelect(isAsRt, gepStr(b, "A" + sc), b.NewSelect(isArrRt, gepStr(b, "a" + sc), gepStr(b, sc)))])
        }
        // `isset` is an i32 0/1: ${nosuch@Q} and ${nosuch@A} are EMPTY in bash 5.3.15, while
        // ${empty@Q} is ''.
        function applyXf(b, v, isset, nmv) {
            if (xf == "U") { return b.NewCall(rtCase, [v, one, emptyPtr(b)]) }
            if (xf == "L") { return b.NewCall(rtCase, [v, llvm.constant.NewInt(i32, 3), emptyPtr(b)]) }
            if (xf == "u") { return b.NewCall(rtCase, [v, zero, emptyPtr(b)]) }
            if (xf == "E") { return b.NewCall(rtAnsiC, v) }
            if (xf == "P") { return b.NewCall(rtPrompt, v) }
            if (xf == "a") { return attrLetters(b, nmv) }
            if (xf == "A") { return b.NewCall(rtDeclAsg, [nmv, attrLetters(b, nmv), v, isset]) }
            return b.NewCall(rtShq, [v, isset])
        }
        // NAME[SUBSCRIPT]: the first word is the subscript, the rest belong to the operator.
        // ${!a[k] OP arg} is an indirection through a[k] (resolved by mkParamExp; the scalar
        // arms below); only the bare ${!a[@]} / ${!a[*]} list the keys.
        var indIdxW = null
        if (hasIdx && words.length > 0 && indp && !bare) {
            indIdxW = words[0]
            words = words.slice(1)
            wordT = (words.length > 0) ? words[words.length - 1] : null
        }
        if (hasIdx && words.length > 0 && indIdxW == null) {
            var idxW = words[0]
            words = words.slice(1)
            wordT = (words.length > 0) ? words[words.length - 1] : null
            var nmOf = function(b) { return rtNm ? cell.nm : gepStr(b, name) }
            // The subscript, and the key it names: an associative array's is the text, an
            // indexed array's an arithmetic expression (rt_arr_key; a canonical literal index
            // needs no evaluation). Computed ONCE per expansion, so `${a[i++]}` steps i once.
            var kindC = idxKind(idxIt, idxW)
            var subOf = function(b) { return subKeyOf(b, name, idxW, rtNm ? cell.nm : null, kindC == 0, idxAqOf(idxIt)) }
            var kindOf = function(b, sub) { return subKind(b, kindC, sub) }
            if (pe == "len") {
                // An associative SUB that expands to nothing (rt_sub_empty).
                var lenAs = maybeAssoc(name) && !rtNm && kindC == 0 && idxIt != null
                var lenLbl = lenAs ? peTgt.slice(peTgt.indexOf("[")) : ""
                return {c: undefined, fn: function(b) {
                    var rs = lenAs ? subKeyOf(b, name, idxW, null, false, idxAqOf(idxIt)) : subOf(b)
                    b = rs.b
                    if (lenAs) { b.NewCall(rtSubEmpty, [nmOf(b), rs.k, gepStr(b, lenLbl)]) }
                    var k = kindOf(b, rs.v)
                    var whole = b.NewICmp(llvm.enum.IPredNE, k, zero)
                    return {b: b, v: b.NewSelect(whole,
                        i2s(b, b.NewCall(rtScCount, nmOf(b))),
                        i2s(b, b.NewCall(rtCharLen, b.NewCall(rtScGet, [nmOf(b), rs.k]))))}
                }}
            }
            // ${!a[@]} / ${!a[*]} are the keys; ${!a[k]} is an indirection through a[k].
            if (pe == "ind") {
                return {f: true, c: undefined, fn: function(b) {
                    var rs = subOf(b); b = rs.b
                    var k = kindOf(b, rs.v)
                    var keysB = curF.NewBlock(""), indB = curF.NewBlock(""), jB = curF.NewBlock("")
                    b.NewCondBr(b.NewICmp(llvm.enum.IPredNE, k, zero), keysB, indB)
                    var star = keysB.NewICmp(llvm.enum.IPredEQ, k, llvm.constant.NewInt(i32, 2))
                    var keys = keysB.NewCall(rtScList, [nmOf(keysB), starSepSp(keysB), keysB.NewZExt(star, i32), one])
                    keysB.NewBr(jB)
                    var tg = indB.NewCall(rtIndName, [nmOf(indB), rs.v, indB.NewCall(rtIndSub, [nmOf(indB), rs.k, zero]), zero])
                    var iv = indB.NewCall(rtGetInd, tg)
                    indB.NewBr(jB)
                    return {b: jB, v: jB.NewPhi([llvm.ir.NewIncoming(keys, keysB), llvm.ir.NewIncoming(iv, indB)])}
                }}
            }
            if (pe == "substr") {
                var offT = ar32T(ariths[0])
                var lenT = (ariths.length > 1) ? ar32T(ariths[1]) : null
                return {f: true, c: undefined, fn: function(b) {
                    var rs = subOf(b); b = rs.b
                    var k = kindOf(b, rs.v)
                    var whole = b.NewICmp(llvm.enum.IPredNE, k, zero)
                    var star = b.NewICmp(llvm.enum.IPredEQ, k, llvm.constant.NewInt(i32, 2))
                    var ro = offT(b); b = ro.b
                    var rlv = null
                    if (lenT != null) { var rl = lenT(b); b = rl.b; rlv = rl.v }
                    var rsl = wholeList(b, whole, function(lb) {
                        if (name == "@" || name == "*") {
                            // The positional list counts from $0: "${@:1}" is $1 on.
                            var all = lb.NewCall(rtParams0)
                            var cnt = lb.NewCall(rtNFields, all)
                            var off = lb.NewSelect(lb.NewICmp(llvm.enum.IPredSLT, ro.v, zero), lb.NewAdd(cnt, ro.v), ro.v)
                            // A negative offset reaching past the start selects nothing.
                            off = lb.NewSelect(lb.NewICmp(llvm.enum.IPredSLT, off, zero), cnt, off)
                            var n = lb.NewSub(cnt, off)
                            if (rlv != null) { n = rlv }
                            return lb.NewCall(rtSliceFields, [all, off, n, ifsFirstValue(lb), starArg(lb, lb.NewZExt(star, i32))])
                        }
                        // An indexed array is sliced by INDEX (rt_arr_slice), not by position, an
                        // associative one by position.
                        return lb.NewCall(rtArrSlice, [nmOf(lb), lb.NewSExt(ro.v, i64),
                            (rlv != null) ? lb.NewSExt(rlv, i64) : zero64, (rlv != null) ? one : zero,
                            ifsFirstValue(lb), starArg(lb, lb.NewZExt(star, i32))])
                    })
                    b = rsl.b
                    var lstV = rsl.v
                    // ${a[i]:off:len} slices the ELEMENT, not the element list.
                    var ev = b.NewCall(rtScGet, [nmOf(b), rs.k])
                    var elen = b.NewCall(rtCharLen, ev)
                    var eoff = b.NewSelect(b.NewICmp(llvm.enum.IPredSLT, ro.v, zero), b.NewAdd(elen, ro.v), ro.v)
                    eoff = b.NewSelect(b.NewICmp(llvm.enum.IPredSLT, eoff, zero), elen, eoff)
                    var en = llvm.constant.NewInt(i32, -1)
                    if (rlv != null) {
                        en = b.NewSelect(b.NewICmp(llvm.enum.IPredSLT, rlv, zero),
                                         b.NewSub(b.NewAdd(elen, rlv), eoff), rlv)
                        en = b.NewSelect(b.NewICmp(llvm.enum.IPredSLT, en, zero), zero, en)
                    }
                    var elV = b.NewCall(rtCSubstr, [ev, eoff, en])
                    return {b: b, v: b.NewSelect(whole, lstV, elV)}
                }}
            }
            // A pattern operator on a subscripted expansion applies to EVERY ELEMENT before the join
            // ("${b[*]/a/Q}" for b=(aa ba) is "Qa bQ"), through rt_mapf; the element arm is the plain
            // scalar call. The subscript decides at run time, so both are emitted and selected.
            if (isPatOp(pe)) {
                var mOp = patOpKind(pe)
                var mMode = patOpMode(pe, anchor)
                var mPatW = (words.length > 0) ? words[0] : null
                var mRepW = (words.length > 1) ? words[1] : null
                var mOpC = llvm.constant.NewInt(i32, mOp)
                var mModeC = llvm.constant.NewInt(i32, mMode)
                return {f: true, c: undefined, fn: function(b) {
                    var rs = subOf(b); b = rs.b
                    var k = kindOf(b, rs.v)
                    var whole = b.NewICmp(llvm.enum.IPredNE, k, zero)
                    var star = b.NewICmp(llvm.enum.IPredEQ, k, llvm.constant.NewInt(i32, 2))
                    var pv = emptyPtr(b)
                    if (mPatW != null) { var rp3 = evalWord(b, mPatW); b = rp3.b; pv = rp3.v }
                    var rv3 = emptyPtr(b)
                    if (mRepW != null) { var rr3 = evalWord(b, mRepW); b = rr3.b; rv3 = rr3.v }
                    var rlm = wholeList(b, whole, function(lb) {
                        var allE = lb.NewCall(rtScList, [nmOf(lb), ifsFirstValue(lb), zero, zero])
                        var mSep = (mOp == 0) ? starSepSp(lb) : ifsFirstValue(lb)
                        var mStar = lb.NewZExt(star, i32)
                        if (mOp != 0) { mStar = starArg(lb, mStar) }
                        return lb.NewCall(rtMapf, [allE, mOpC, pv, rv3, mModeC, mSep, mStar])
                    })
                    b = rlm.b
                    var lstM = rlm.v
                    var evM = b.NewCall(rtScGet, [nmOf(b), rs.k])
                    var elM = evM
                    if (mOp == 0) { elM = b.NewCall(rtStrip, [evM, pv, mModeC]) }
                    else if (mOp == 1) { elM = b.NewCall(rtReplace, [evM, pv, rv3, mModeC]) }
                    else { elM = b.NewCall(rtCase, [evM, mModeC, pv]) }
