    // `type` does (emitDescribe) or that it is not found; the status is 1 when no NAME is
    // anything. A computed NAME after the bare wrapper is dispatched at run time. Twin of
    // runWrapper in bash-interpreter.abnf.
    function emitWrapper(b, cmd, argTs, subs) {
        var i = 0
        var query = ""
        while (i < argTs.length && argTs[i].c != undefined && argTs[i].c.length > 1 && argTs[i].c.charAt(0) == "-") {
            var opt = argTs[i].c
            i = i + 1
            if (opt == "--") { break }
            if (cmd == "builtin") { fail(cmd + " " + opt + " is not supported") }
            var oc
            for (oc = 1; oc < opt.length; oc++) { if (opt.charAt(oc) == "v" || opt.charAt(oc) == "V") { query = opt.charAt(oc) } }
        }
        if (i >= argTs.length) { storeStatusI(b, 0); return b }
        if (query == "") { return emitComputedCommand(b, argTs[i], argTs.slice(i + 1), subs, true) }
        var st = one
        for (; i < argTs.length; i++) {
            var lit = argTs[i].c
            var r = evalWord(b, argTs[i])
            b = r.b
            var kd = emitKind(b, r.v, lit)
            b = kd.b
            var yes = curF.NewBlock(""), next = curF.NewBlock("")
            var no = (query == "V") ? curF.NewBlock("") : next
            b.NewCondBr(b.NewICmp(llvm.enum.IPredNE, kd.any, zero), yes, no)
            var ybox = {b: yes}
            var line = (query == "V") ? emitDescribe(ybox, r.v, lit, kd, false, "command") : yes.NewCall(rtStrcat, [r.v, gepStr(yes, "\n")])
            yes = ybox.b
            yes.NewCall(rtPrints, line)
            yes.NewBr(next)
            if (query == "V") {
                emitDiag(no, no.NewCall(rtStrcat, [no.NewCall(rtStrcat, [gepStr(no, "command: "), r.v]), gepStr(no, ": not found\n")]))
                no.NewBr(next)
            }
            b = next
            st = b.NewAnd(st, b.NewXor(kd.any, one))
        }
        storeStatus(b, st)
        return b
    }
    // `type [-t] NAME...`: what each NAME is, looked up as bash does - keyword, function,
    // builtin (emitKind). A function is "NAME is a function" and its definition as bash prints
    // it; -t prints only the kind. A NAME that is none is "type: NAME: not found" (nothing
    // with -t) and makes the status 1. Twin of typeCmd in bash-interpreter.abnf.
    function emitType(b, argTs) {
        var i = 0
        var terse = false
        while (i < argTs.length && argTs[i].c != undefined && argTs[i].c.length > 1 && argTs[i].c.charAt(0) == "-") {
            var opt = argTs[i].c
            i = i + 1
            if (opt == "--") { break }
            if (opt != "-t") { fail("type " + opt + " is not supported") }
            terse = true
        }
        var st = zero
        for (; i < argTs.length; i++) {
            var lit = argTs[i].c
            var r = evalWord(b, argTs[i])
            b = r.b
            var kd = emitKind(b, r.v, lit)
            b = kd.b
            var yes = curF.NewBlock(""), no = curF.NewBlock(""), next = curF.NewBlock("")
            b.NewCondBr(b.NewICmp(llvm.enum.IPredNE, kd.any, zero), yes, no)
            var ybox = {b: yes}
            var desc = emitDescribe(ybox, r.v, lit, kd, terse, "type")
            yes = ybox.b
            yes.NewCall(rtPrints, desc)
            yes.NewBr(next)
            if (!terse) { emitDiag(no, no.NewCall(rtStrcat, [no.NewCall(rtStrcat, [gepStr(no, "type: "), r.v]), gepStr(no, ": not found\n")])) }
            no.NewBr(next)
            b = next
            st = b.NewOr(st, b.NewXor(kd.any, one))
        }
        storeStatus(b, st)
        return b
    }
    // What nameV is, in bash's lookup order: i32 flags kw, fn (a function, not a keyword),
    // and any (one of keyword, function, builtin). lit: the name when it is a literal word.
    function emitKind(b, nameV, lit) {
        var isKw = b.NewCall(rtInWords, [nameV, gepStr(b, "\n" + shellKwWords.join("\n") + "\n")])
        var isBl = b.NewCall(rtInWords, [nameV, gepStr(b, "\n" + shellKnownWords.join("\n") + "\n")])
        var rf = emitIsFnName(b, nameV, lit)
        b = rf.b
        return {b: b, kw: isKw, fn: b.NewAnd(rf.v, b.NewXor(isKw, one)), any: b.NewOr(b.NewOr(isKw, rf.v), isBl)}
    }
    // The line `type` prints for nameV, which is something (kd from emitKind): the kind alone
    // when terse, else "NAME is a shell keyword", "NAME is a function" and the definition in
    // force, or "NAME is a shell builtin". box.b is the block, moved on past the stop a
    // definition the printer does not model makes (emitFnTextOf); who names the builtin.
    function emitDescribe(box, nameV, lit, kd, terse, who) {
        var b = box.b
        var isKw = b.NewICmp(llvm.enum.IPredNE, kd.kw, zero)
        var isFn = b.NewICmp(llvm.enum.IPredNE, kd.fn, zero)
        if (terse) { return b.NewSelect(isKw, gepStr(b, "keyword\n"), b.NewSelect(isFn, gepStr(b, "function\n"), gepStr(b, "builtin\n"))) }
        var text = emitFnTextOf(box, nameV, lit, isFn, who)
        b = box.b
        var fnPart = b.NewCall(rtStrcat, [gepStr(b, " is a function\n"), b.NewCall(rtStrcat, [text, gepStr(b, "\n")])])
        var tail = b.NewSelect(isKw, gepStr(b, " is a shell keyword\n"), b.NewSelect(isFn, fnPart, gepStr(b, " is a shell builtin\n")))
        return b.NewCall(rtStrcat, [nameV, tail])
    }
    // The definition in force of the function nameV names, as bash prints it, or "" when none
    // is. lit: the name when it is a literal word; a computed one is compared with every name
    // the program defines. When isFn holds and the definition is one the printer does not
    // model, the shell stops then (emitPrintStop) instead of refusing the program.
    function emitFnTextOf(box, nameV, lit, isFn, who) {
        var b = box.b
        var acc = gepStr(b, "")
        var stop = null, err = ""
        var i
        for (i = 0; i < declaredFuncList.length; i++) {
            var fn = declaredFuncList[i]
            if (lit != undefined && fn != lit) { continue }
            var hit = b.NewICmp(llvm.enum.IPredNE, b.NewAnd(b.NewCall(rtStreq, [nameV, gepStr(b, fn)]), b.NewZExt(fnIsDefined(b, fn), i32)), zero)
            var bad = emitFnTextBad(b, fn)
            if (bad != null) {
                var sb = b.NewAnd(hit, bad.v)
                stop = (stop == null) ? sb : b.NewOr(stop, sb)
                err = bad.err
            }
            acc = b.NewSelect(hit, emitFnText(b, fn, bad != null), acc)
        }
        if (stop != null) { box.b = emitPrintStop(b, b.NewAnd(isFn, stop), who, err) }
        return acc
    }
    // Stops the shell with status 2 when cond holds: printing a function body that holds err,
    // which the printer does not model, for the builtin who. Answers the block that goes on.
    function emitPrintStop(b, cond, who, err) {
        var stopB = curF.NewBlock(""), goB = curF.NewBlock("")
        b.NewCondBr(cond, stopB, goB)
        emitOnStderr(stopB, gepStr(stopB, c.file + ": " + who + ": printing a function body that holds " + err + " cannot be compiled\n"))
        stopB.NewStore(llvm.constant.NewInt(i32, 2), gExitCode)
        stopB.NewStore(one, gExited)
        stopB.NewBr(viaUnwind(curExit, curExitRd))
        return goB
    }
    // The definition of fn in force (fnk_fn picks it) as bash prints it. A definition the
    // printer does not model is refused here, where printing it is compiled - unless lazy:
    // then the caller has made printing it stop the shell (emitFnTextBad).
    function emitFnText(b, fn, lazy) {
        var nd = funcDefs["$" + fn]
        var k = (nd > 1) ? fnDefOf(b, fn) : null
        var t = null
        var j
        for (j = nd; j >= 1; j--) {
            var d = funcTexts["$" + fn + "#" + j]
            if (d.err != undefined && lazy != true) { fail("printing a function body that holds " + d.err + " is not supported") }
            var g = gepStr(b, (d.err != undefined) ? "" : d.text)
            t = (t == null) ? g : b.NewSelect(b.NewICmp(llvm.enum.IPredEQ, k, llvm.constant.NewInt(i32, j)), g, t)
        }
        return t
    }
    // {v, err}: v an i1, whether the definition of fn in force is one the printer does not
    // model (err names what); null when fn has none.
    function emitFnTextBad(b, fn) {
        var nd = funcDefs["$" + fn]
        var k = (nd > 1) ? fnDefOf(b, fn) : null
        var bad = null
        var err = ""
        var j
        for (j = 1; j <= nd; j++) {
            var d = funcTexts["$" + fn + "#" + j]
            if (d.err == undefined) { continue }
            err = d.err
            var hit = (k == null) ? llvm.constant.NewInt(llvm.types.I1, 1) : b.NewICmp(llvm.enum.IPredEQ, k, llvm.constant.NewInt(i32, j))
            bad = (bad == null) ? hit : b.NewOr(bad, hit)
        }
        return (bad == null) ? null : {v: bad, err: err}
    }
    // declare -f / -F: with names and an attribute (-t, +t) and no -p, they set or clear it
    // on each function, a name that is none failing silently. Otherwise they print: -f the
    // definitions, -F the names, and a function's attribute line `declare -ft NAME` when no
    // name is given or with -p; with no name an attribute picks the functions holding it,
    // and with -p a name that is none is "not found". With no name, the functions printed are
    // the ones defined when it runs, so a definition the printer does not model stops the
    // shell then (status 2) instead of refusing the program. Twin of declFuncs in
    // bash-interpreter.abnf.
    function emitDeclFuncs(b, kw, q, names, flags, plus) {
        var p = flags.indexOf("p") >= 0
        var tOn = flags.indexOf("t") >= 0
        var tOff = plus.indexOf("t") >= 0
        var trB = llvm.constant.NewInt(i32, fnTrBit)
        var st = zero
        var k
        if (!p && names.length > 0 && (tOn || tOff)) {
            for (k = 0; k < names.length; k++) {
                if (funcFor(names[k]) == null) { st = one; continue }
                var sv = b.NewLoad(i32, fnSlot(names[k]))
                var nv = tOff ? b.NewAnd(sv, llvm.constant.NewInt(i32, -1 - fnTrBit)) : b.NewOr(sv, trB)
                var isDef = fnIsDefined(b, names[k])
                fnStore(b, b.NewSelect(isDef, nv, sv), names[k])
                st = b.NewOr(st, b.NewXor(b.NewZExt(isDef, i32), one))
            }
            storeStatus(b, st)
            return b
        }
        var list = (names.length == 0) ? bashSortNames(declaredFuncList) : names
        var full = p || names.length == 0
        for (k = 0; k < list.length; k++) {
            var fn = list[k]
