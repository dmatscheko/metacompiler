    //  Emitter state.
    // ===================================================================================

    var curF = null       // the IR function currently being emitted into
    var curEntry = null   // ...and its entry block, where every alloca goes (slotOf)
    var curExit = null     // its exit block (an `exit N` / propagated exit branches here)
    var curExitRd = 0      // redirStack.length where curExit was set
    // The redirections open around the code being emitted (emitOpenRedirs records), innermost
    // last. A branch that leaves some of them - exit, an expansion error, return, break - has to
    // close them on its way out (unwindRedirs), or the stream stays redirected afterwards.
    var redirStack = []
    var curFrame = null    // null at top level, else {params: [9 i8* values], argc: i32 value}
    var condDepth = 0      // >0 while emitting a CONDITION (set -e must not fire there)
    var loopStack = []     // {brk, cont} target blocks of the loops being emitted
    var trapList = []      // EXIT traps registered in the (sub)shell being emitted
    var trapCount = 0
    var deadCount = 0
