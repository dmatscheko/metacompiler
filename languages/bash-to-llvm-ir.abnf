        var i
        for (i = 0; i < s.length; i++) {
            var cc = s.charCodeAt(i)
            if (cc >= 56448 && cc <= 56575) {
                return {c: undefined, fn: function(b) { return {b: b, v: b.NewCall(rtUnraw, gepStr(b, s))} }}
            }
        }
        return makeConst(s)
    }
    // $'...' body -> the decoded string (bash's ANSI-C escapes). A NUL byte ends it, as it
    // ends a C string: $'g\0h'x is gx.
    function ansiC(t) {
        var out = ""
        var i = 0
        while (i < t.length) {
            var ch = t.charAt(i)
            if (ch != "\\" || i + 1 >= t.length) { out = out + ch; i = i + 1 }
            else {
                var e = t.charAt(i + 1)
                i = i + 2
                if (e == "n") { out = out + "\n" }
                else if (e == "t") { out = out + "\t" }
                else if (e == "r") { out = out + "\r" }
                else if (e == "a") { out = out + String.fromCharCode(7) }
                else if (e == "b") { out = out + String.fromCharCode(8) }
                else if (e == "e" || e == "E") { out = out + String.fromCharCode(27) }
                else if (e == "f") { out = out + String.fromCharCode(12) }
                else if (e == "v") { out = out + String.fromCharCode(11) }
                else if (e == "\\") { out = out + "\\" }
                else if (e == "'") { out = out + "'" }
                else if (e == "\"") { out = out + "\"" }
                else if (e == "?") { out = out + "?" }
                // \cX: the control character of X's first byte, then a multibyte X's other
                // bytes; $'\c\\' and $'\c\' are both 0x1c. Twin of ansiC in bash-interpreter.abnf.
                else if (e == "c" && i < t.length) {
                    var cb = utf8Bytes(t, i)
                    i = i + ((cb.length == 4) ? 2 : 1)
                    if (cb[0] == 92 && i < t.length && t.charAt(i) == "\\") { i = i + 1 }
                    var cv = (cb[0] == 63) ? 127 : (cb[0] & 31)
                    if (cv == 0) { return out }
                    out = out + escByte(cv)
                    var ck
                    for (ck = 1; ck < cb.length; ck++) { out = out + escByte(cb[ck]) }
                }
                // \NNN: one to THREE octal digits in total, so $'\0101' is \b then "1" and
                // $'\101' is "A".
                else if (e >= "0" && e <= "7") {
                    var ov = e.charCodeAt(0) - 48, on = 1
                    while (on < 3 && i < t.length && t.charAt(i) >= "0" && t.charAt(i) <= "7") {
                        ov = ov * 8 + (t.charCodeAt(i) - 48); i = i + 1; on = on + 1
                    }
                    if (ov % 256 == 0) { return out }
                    out = out + escByte(ov % 256)
                }
                else if (e == "x") {
                    // A \x with no hex digit after it stays literal, as bash leaves it.
                    if (i >= t.length || hexVal(t.charCodeAt(i)) < 0) { out = out + "\\x" }
                    else {
                        var v = 0, n = 0
                        while (n < 2 && i < t.length && hexVal(t.charCodeAt(i)) >= 0) { v = v * 16 + hexVal(t.charCodeAt(i)); i = i + 1; n = n + 1 }
                        if (v == 0) { return out }
                        out = out + escByte(v)
                    }
                }
                else if ((e == "u" || e == "U") && i < t.length && hexVal(t.charCodeAt(i)) >= 0) {
                    var uv = 0, un = 0
                    while (un < ((e == "u") ? 4 : 8) && i < t.length && hexVal(t.charCodeAt(i)) >= 0) { uv = uv * 16 + hexVal(t.charCodeAt(i)); i = i + 1; un = un + 1 }
                    if (uv == 0) { return out }
                    out = out + ucsChr(uv)
                }
                else { out = out + "\\" + e }
            }
        }
        return out
    }
    // The UTF-8 bytes of the character at t[i] (a surrogate pair is one character).
    function utf8Bytes(t, i) {
        var cc = t.charCodeAt(i)
        if (cc < 128) { return [cc] }
        if (cc < 2048) { return [192 + (cc >> 6), 128 + (cc & 63)] }
        if (cc >= 55296 && cc <= 56319 && i + 1 < t.length) {
            var cp = 65536 + (cc - 55296) * 1024 + (t.charCodeAt(i + 1) - 56320)
            return [240 + (cp >> 18), 128 + ((cp >> 12) & 63), 128 + ((cp >> 6) & 63), 128 + (cp & 63)]
        }
        return [224 + (cc >> 12), 128 + ((cc >> 6) & 63), 128 + (cc & 63)]
    }
    function hexVal(cc) {
        if (cc >= 48 && cc <= 57) { return cc - 48 }
        if (cc >= 97 && cc <= 102) { return cc - 87 }
        if (cc >= 65 && cc <= 70) { return cc - 55 }
        return -1
    }

    function escChar(t) { return t.slice(1) }
    function dqEsc(t) {
        var c = t.slice(1)
        if (c == "$" || c == "\"" || c == "\\" || c == "`") { return c }
        return t
    }
    function parseDec(s) {
        var neg = false, i = 0
        if (s.charAt(0) == "-") { neg = true; i = 1 } else if (s.charAt(0) == "+") { i = 1 }
        var v = 0
        while (i < s.length) { v = (v * 10 + (s.charCodeAt(i) - 48)) | 0; i = i + 1 }
        return neg ? ((0 - v) | 0) : v
    }
    function utf8Len(s) {
        var n = 0, i = 0
        while (i < s.length) {
            var c = s.charCodeAt(i)
            if (c < 0x80) { n += 1 }
            else if (c < 0x800) { n += 2 }
            else if (c >= 0xd800 && c <= 0xdbff) { n += 4; i += 1 }
            else { n += 3 }
            i += 1
        }
        return n
    }

    // ===================================================================================
    //  LLVM types, module, externs and the runtime globals.
    // ===================================================================================

    var i8 = llvm.types.I8
    var i32 = llvm.types.I32
    var i64 = llvm.types.I64
    var i8ptr = llvm.types.I8Ptr
    var zero = llvm.constant.NewInt(i32, 0)
    var one = llvm.constant.NewInt(i32, 1)
    // Arithmetic is bash's intmax_t: every arithmetic thunk answers an i64.
    var zero64 = llvm.constant.NewInt(i64, 0)
    var one64 = llvm.constant.NewInt(i64, 1)
    var ten = llvm.constant.NewInt(i32, 10)
    var zero8 = llvm.constant.NewInt(i8, 0)
    var nullStr = llvm.constant.NewNull(i8ptr) // the empty string: address 0 is the NUL byte

    var m = llvm.ir.NewModule()
    var extPutchar = m.NewFunc("putchar", i32, llvm.ir.NewParam("", i32))

    // ---- the C runtime -----------------------------------------------------------------
    // The helpers' bodies are languages/lib/bash-rt.c, compiled by languages/c-to-llvm-ir.abnf
    // into the checked-in languages/lib/bash-rt.ll (tests/gen-bash-rt-ll.sh). That module is
    // LINKED with this one - by clang for -exe, by abnf/llvmlink.go for llvm.Run - from the same
    // list (rts, below). Functions and globals bind by NAME, so no bitcast shims are needed.
    // The .ll lives next to THIS grammar so nothing depends on the working directory.
    function libPath(name) {
        var mn = moduleName()
        var cut = -1
        var i = 0
        while (i < mn.length) {
            var ch = mn.charAt(i)
            if (ch == "/" || ch == "\\") { cut = i }
            i = i + 1
        }
        return mn.substring(0, cut + 1) + "lib/" + name
    }
    var rts = c.runtime
    if (rts == undefined || rts.length == 0) { rts = [libPath("bash-rt.ll")] }

    // Every pointer out of c-to-llvm-ir.abnf is an i32*; every string here is an i8*. As the
    // runtime is a separate module resolved by name, each helper is simply DECLARED with the face
    // this emitter wants. `kinds`: one per parameter, 1 = i8*, 2 = i32*, 3 = i64 (a C long),
    // 0 = i32; `ret`: true for an i8* result, 3 for an i64 one, false for an i32 one.
    var i32ptr = llvm.types.NewPointer(i32)
    function rtDecl(name, ret, kinds) {
        var ps = []
        var i = 0
        while (i < kinds.length) {
            if (kinds[i] == 1) { ps.push(llvm.ir.NewParam("s" + i, i8ptr)) }
            else if (kinds[i] == 2) { ps.push(llvm.ir.NewParam("s" + i, i32ptr)) }
            else if (kinds[i] == 3) { ps.push(llvm.ir.NewParam("s" + i, i64)) }
            else { ps.push(llvm.ir.NewParam("s" + i, i32)) }
            i = i + 1
        }
        var rty = i32
        if (ret === true) { rty = i8ptr }
        if (ret === 3) { rty = i64 }
        return m.NewFunc(name, rty, ps)
    }
    // A global the runtime DEFINES, declared here with the type this emitter wants to
    // step through. abnf/llvmlink.go binds it to the one definition and checks the two
    // agree on SIZE; clang resolves the symbol.
    // The linkage has to be spelled: an initializer-less ir.Global prints as
    // `@exited = global i32` by default, which clang rejects outright ("global variable
    // reference must have pointer type"). `external` is what makes it a declaration.
    function rtGlobal(name, ty) {
        var g = m.NewGlobal(name, ty)
        g.Linkage = llvm.enum.LinkageExternal
        return g
    }

    // bash-rt.c's global initializers run in __mec_ginit(); main calls it (see the entry block).
    var rtGinit = m.NewFunc("__mec_ginit", i32)

    // The string heap lives in bash-rt.c; nothing outside rt_bump touches it.

    // ---- the runtime's state ------------------------------------------------------------
    // Every global below is DEFINED in languages/lib/bash-rt.c and shared with the emitted program
    // by name. `char *gvars[1024]` is `[1024 x i32*]` there and `[1024 x i8*]` here - the same
    // size and stride; llvmlink.go checks the sizes match.
    var gStatus = rtGlobal("last_status", i32)   // $?
    var gExited = rtGlobal("exited", i32)        // set by `exit`
    var gExitCode = rtGlobal("exit_code", i32)

    // A real "" at a NONZERO address. The IR interpreter traps loads at address 0, so an
    // empty / unset value must be a genuine pointer to a NUL byte, never a null pointer.
    var emptyTy = llvm.types.NewArray(1, i8)
    var gEmpty = rtGlobal("empty", emptyTy)
    function emptyPtr(b) { return b.NewGetElementPtr(emptyTy, gEmpty, zero, zero) }

    // A SECOND empty string, at a different address: the "variable is unset" marker. It reads
    // as "" everywhere (so no expansion has to special case it), but a pointer comparison
    // against it answers ${v-default} / ${v:+alt} and friends.
    var gUnset = rtGlobal("unset_marker", emptyTy)
    function unsetPtr(b) { return b.NewGetElementPtr(emptyTy, gUnset, zero, zero) }
    // The empty field list. A list is known by its address, not its first byte (rt_islist).
    var nilTy = llvm.types.NewArray(2, i8)
    var gListNil = rtGlobal("list_nil", nilTy)
    function nilList(b) { return b.NewGetElementPtr(nilTy, gListNil, zero, zero) }
    // {b, v}: v is fn(lb) when `whole` holds and the empty field list otherwise, fn's work done
    // only on its own arm (fn emits into the one block it is handed). A subscripted expansion
    // computes its element-list form this way, so reading one element does not cost the array.
    function wholeList(b, whole, fn) {
        var nil0 = nilList(b)
        var lb = curF.NewBlock(""), lm = curF.NewBlock("")
        b.NewCondBr(whole, lb, lm)
        var lv = fn(lb)
        lb.NewBr(lm)
        return {b: lm, v: lm.NewPhi([llvm.ir.NewIncoming(lv, lb), llvm.ir.NewIncoming(nil0, b)])}
    }

    // Variable storage is ONE global array of char*, indexed by a compile-time id, so the
    // `local` unwinder can restore a slot chosen at run time (a per-name global could only
    // be reached through a generated dispatch).
    var NVARS = 1024
    var gvarsTy = llvm.types.NewArray(NVARS, i8ptr)
    var gVars = rtGlobal("gvars", gvarsTy)
    // The {name, slot} table beside it: varnames[i] is the source name of gvars[i]. Only
    // the emitter knows the names, so main's entry block fills it - and that one table is
    // what lets rt_getvar_byname / rt_setvar_byname / rt_eval_assign live in bash-rt.c
    // instead of being generated as a three-fold chain over every name in the program.
    var gVarNames = rtGlobal("varnames", gvarsTy)

    var varIds = {}       // "$"+name -> slot index
    var varIdList = []    // index -> name (creation order, for the deterministic init run)
    function getVarId(name) {
        var key = "$" + name
        if (hasOwn(varIds, key)) { return varIds[key] }
        var id = varIdList.length
        if (id >= NVARS) { fail("too many distinct variables (limit " + NVARS + ")") }
        varIds[key] = id
        varIdList.push(name)
        return id
    }
    function varPtr(b, name) {
        return b.NewGetElementPtr(gvarsTy, gVars, zero, llvm.constant.NewInt(i32, getVarId(name)))
    }
    function varSlot(b, idx) {
        return b.NewGetElementPtr(gvarsTy, gVars, zero, idx)
    }
    function loadVar(b, name) { return b.NewLoad(i8ptr, varPtr(b, name)) }
    // -u / -l are ATTRIBUTES, not a one-off transform of the declaring assignment: bash 5.3
    // upper/lower-cases every later write to the name, including one made by `read` or a
    // `for` head, so the case call belongs on the store funnel. It costs nothing for a name
    // with no case attribute - the maps are compile-time and the call is simply not emitted.
    function storeVar(b, name, v) {
        var al = refAlias(name)
        if (al != null) { storeVar(b, al, v); return }
        if (attrOn(refVars, name)) { b.NewCall(rtSetByName, [gepStr(b, name), v]); return }
        b.NewStore(attrCase(b, name, v), varPtr(b, name))
        heapPin(b)
    }
    // The one store that must NOT be transformed: the unset marker is an identity, and
    // rt_case would hand back a fresh string that no longer compares equal to it.
    function storeVarRaw(b, name, v) { b.NewStore(v, varPtr(b, name)) }
    function attrCase(b, name, v) {
        if (attrOn(upVars, name)) { return b.NewCall(rtCase, [v, one, emptyPtr(b)]) }
        if (attrOn(loVars, name)) { return b.NewCall(rtCase, [v, llvm.constant.NewInt(i32, 3), emptyPtr(b)]) }
        return v
    }

    // The `local` save stack and the capture stack are private to the runtime; only their
    // depths are read here.
    var gLsTop = rtGlobal("ls_top", i32)
    var gLsTb = rtGlobal("ls_tb", i32)
    var gNvars = rtGlobal("nvars", i32)   // filled by main's entry block
    // The standard input a pipeline stage hands on.
    var gStdin = rtGlobal("stdin_buf", i8ptr)

    // Shell options (set -e / -u / -o pipefail) and the abort flag a set -u failure raises
    // during expansion (expansion cannot return a status, so the command about to run picks
    // it up - exactly the shape the interpreter uses).
    var gOptE = rtGlobal("opt_errexit", i32)
    var gOptU = rtGlobal("opt_nounset", i32)
    var gOptPf = rtGlobal("opt_pipefail", i32)
    var gCondRt = rtGlobal("cond_depth", i32)
    var gAbort = rtGlobal("abort_flag", i32)
    var gArithErr = rtGlobal("arith_err", i32)   // an arithmetic or substring error (rt_arith_fail)
    var gCondErr = rtGlobal("cond_err", i32)   // a [[ ]] that could not be evaluated

    // Two output channels. 0 = standard output (captured by $( ) when one is open), 1 = the
    // standard error channel, 2 = discarded. Which channel a redirection routes a command to is
    // modelled exactly.
    var gSinkOut = rtGlobal("sink_out", i32)
    var gSinkErr = rtGlobal("sink_err", i32)
    // Standard input for `read`: the read position (the buffer is gStdin above).
    var gStdinPos = rtGlobal("stdin_pos", i32)

    // Positional parameters live in ONE global stack rather than in function arguments, so
    // "$@" can expand to any number of words and `shift` and `set --` are ordinary writes.
    var gArgvTop = rtGlobal("argv_top", i32)
    var gFrameBase = rtGlobal("frame_base", i32)
    var gFrameN = rtGlobal("frame_n", i32)

    // $0 as the RUNTIME sees it. The emitter answers $0 from c.file directly, but
    // rt_getvar_byname has to answer `z=0; echo "${!z}"`, so main's entry block hands it over.
    var gScriptName = rtGlobal("script_name", i8ptr)

    // The heap's bump positions and string floor (bash-rt.c, "RECLAIMING"). A mark is the
    // two positions; rt_release goes back to the mark taken before a loop ahead of each next
    // pass (before a C-style for's step, whose store would pin the pass's garbage) and at the
    // loop's exit, and to the one taken before a top-level line at its end.
    // A store that outlives the statement (heapPin) raises the floor so no release can reach
    // what it holds.
    var hPosTy = llvm.types.NewArray(2, i64)
    var gHPos = rtGlobal("h_pos", hPosTy)
    var gAFloor = rtGlobal("a_floor", i64)
    // The rows of every array (bash-rt.c): 0 means no name is an array, which an assignment
    // tests before it asks rt_arr_any about its own.
    var gArrRows = rtGlobal("arr_rows", i64)
    // Branches to `yes` when `nm` names an array with an element, else to `no`.
    function brIfArray(b, nm, yes, no) {
        var chk = curF.NewBlock("")
        b.NewCondBr(b.NewICmp(llvm.enum.IPredNE, b.NewLoad(i64, gArrRows), zero64), chk, no)
        chk.NewCondBr(chk.NewICmp(llvm.enum.IPredNE, chk.NewCall(rtArrAny, nm), zero), yes, no)
    }
    function hPos(b, h) { return b.NewLoad(i64, b.NewGetElementPtr(hPosTy, gHPos, zero, llvm.constant.NewInt(i32, h))) }
    function heapMark(b) { return {a: hPos(b, 0), l: hPos(b, 1)} }
    // The call is skipped when it could change nothing: no string above the floor (a
    // release never goes below it) and no list since the mark. Returns the block to go on in.
    function heapRelease(b, mk) {
        var any = b.NewOr(b.NewICmp(llvm.enum.IPredNE, hPos(b, 0), b.NewLoad(i64, gAFloor)),
                          b.NewICmp(llvm.enum.IPredNE, hPos(b, 1), mk.l))
        var rel = curF.NewBlock(""), done = curF.NewBlock("")
        b.NewCondBr(any, rel, done)
        rel.NewCall(rtRelease, [mk.a, mk.l])
        rel.NewBr(done)
        return done
    }
    function heapPin(b) { b.NewStore(hPos(b, 0), gAFloor) }
    // The value of an assignment to `name`, moved down onto the statement's mark or into the
    // slot's own buffer (rt_keep); mk is null when the value's expansion allocates nothing
    // besides the value itself.
    function heapKeep(b, mk, name, v) {
        return mk == null ? v : b.NewCall(rtKeep, [mk.a, mk.l, v, llvm.constant.NewInt(i32, getVarId(name))])
    }

    // ===================================================================================
    //  Emitter state.
    // ===================================================================================

    var curF = null       // the IR function currently being emitted into
    // The heap mark a simple command started at - before its words, prefix assignments and
    // redirections - handed from its wrappers to its body, which takes it at once. A builtin
    // whose last act is its one store (printf -v, read NAME) gives back everything else the
    // command allocated since (rt_keep): none of it is live after the command.
    var cmdMark = null
    // The same way, the save-stack depth where a function call's prefix bindings start (a
    // slot), handed to the call (rt_fn_enter).
    var tmpDepth = null
    // Set when the statement just emitted was an assignment that left no garbage (makeSeq);
    // anything that runs one as a part (an and-or list, a pipeline, a subshell) clears it.
    var asgKept = false
    var curEntry = null   // ...and its entry block, where every alloca goes (slotOf)
    var curExit = null     // its exit block (an `exit N` / propagated exit branches here)
    var curExitRd = 0      // redirStack.length where curExit was set
    // The redirections open around the code being emitted (emitOpenRedirs records), innermost
    // last. A branch that leaves some of them - exit, an expansion error, return, break - has to
    // close them on its way out (unwindRedirs), or the stream stays redirected afterwards.
    var redirStack = []
    var curFrame = null    // null at top level, else {params: [9 i8* values], argc: i32 value}
    var condDepth = 0      // >0 while emitting a CONDITION (set -e must not fire there)
    // Set by a statement that answered set -e itself or is exempt from it - a compound command,
    // an && / || list, a ! pipeline - for the statement list around it (see makeSeq).
    var eeDone = false
    var loopStack = []     // {brk, cont} target blocks of the loops being emitted
    var retInSub = false   // inside a ( ) / $( ) of the function being emitted: return ends it
    var trapList = []      // EXIT traps registered in the (sub)shell being emitted
    var trapCount = 0
    var deadCount = 0
    function deadBlock() { deadCount = deadCount + 1; return curF.NewBlock("dead" + deadCount) }

    var strGlobals = {}   // interned string constants:  "$"+content -> {g, ty}
    var strCount = 0
    function internStr(s) {
        var key = "$" + s
        if (hasOwn(strGlobals, key)) { return strGlobals[key] }
        var ty = llvm.types.NewArray(utf8Len(s) + 1, i8)
        var g = m.NewGlobalDef("str" + strCount, llvm.constant.NewCharArrayFromString(s + "\x00"))
        strCount = strCount + 1
        var rec = {g: g, ty: ty}
        strGlobals[key] = rec
        return rec
    }
    // An i8* value pointing at an interned constant string, materialized in block b.
    function gepStr(b, s) {
        if (s == "") { return emptyPtr(b) }
        var r = internStr(s)
        return b.NewGetElementPtr(r.ty, r.g, zero, zero)
    }

    // Name-based variable access is in bash-rt.c, as loops over the {name, slot} table
    // `varnames`; the emitter only fills that table in main's entry block.
    var rtSetByName = rtDecl("rt_setvar_byname", false, [1, 1])
    var rtEvalAssign = rtDecl("rt_eval_assign", false, [1])
    // i32 rt_decl_word(i8* w, i32 d, i32 x): one computed operand of a declaration (bash-rt.c).
    var rtDeclWord = rtDecl("rt_decl_word", false, [1, 0, 0])
    // The export attribute is the one the runtime keeps per name (rt_xmark), because a
    // computed operand can export a name no lexical table sees.
    var rtXmark = rtDecl("rt_xmark", false, [1, 0])
    var rtXletters = rtDecl("rt_xletters", true, [1, 1])
    // i32 rt_inwords(i8* w, i8* list): 1 when w is one of the newline-separated words of list.
    var rtInWords = rtDecl("rt_inwords", false, [1, 1])
    var rtGetByName = rtDecl("rt_getvar_byname", true, [1])
    var rtGetInd = rtDecl("rt_getvar_ind", true, [1])
    // i8* rt_indsub(i8* nm, i8* k, i32 kind) / i8* rt_indname(i8* nm, i8* sub, i8* v, i32 strict):
    // the variable an indirection lands on (bash-rt.c).
    var rtIndSub = rtDecl("rt_indsub", true, [1, 1, 0])
    var rtIndName = rtDecl("rt_indname", true, [1, 1, 1, 0])
    // i32 rt_indlist(i8* tg) / i8* rt_indpart(i8* tg, i32 sub): which kind of target, and its
    // name and subscript (bash-rt.c).
    var rtIndList = rtDecl("rt_indlist", false, [1])
    var rtIndPart = rtDecl("rt_indpart", true, [1, 0])

    var funcDefs = {}       // "$"+name -> how many definitions of it the program has (counted
                            // during the walk, so a call emitted before a definition sees it)
    var defFuncs = {}       // "$"+name+"#"+k -> the IR function of the k-th definition
    var declaredFuncList = []  // the names of funcDefs, in an enumerable order
    var funcTexts = {}      // "$"+name+"#"+k -> the k-th definition as bash prints it (bashDeparse)
    var fnCount = 0

    function bashFnParams() { return [] }
    // The call of the definition of user function `name` in force (fnSlot), which must be one;
    // its status is $?, and the block after it is returned. With several definitions the slot's
    // number picks the IR function. A call made as a CONDITION counts itself in cond_depth for
    // as long as it runs, which keeps set -e off in the body: the body is emitted once, so only
    // the run time knows how it was called.
    function emitFnCall(b, name) {
        if (condDepth > 0) { b.NewStore(b.NewAdd(b.NewLoad(i32, gCondRt), one), gCondRt) }
        var nd = funcDefs["$" + name]
        if (nd == 1) { storeStatus(b, b.NewCall(defFunc(name, 1))) }
        else {
            var k = b.NewLoad(i32, fnSlot(name))
            var done = curF.NewBlock("")
            var j
            for (j = 1; j < nd; j++) {
                var hit = curF.NewBlock(""), miss = curF.NewBlock("")
                b.NewCondBr(b.NewICmp(llvm.enum.IPredEQ, k, llvm.constant.NewInt(i32, j)), hit, miss)
                storeStatus(hit, hit.NewCall(defFunc(name, j)))
