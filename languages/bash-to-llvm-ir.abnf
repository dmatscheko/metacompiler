        return b.NewICmp(llvm.enum.IPredNE, b.NewLoad(i32, fnSlot(name)), zero)
    }
    // `unset -f`: the function named nameV is no longer defined. lit: the name when it is a
    // literal word; a computed one is compared with every name the program defines.
    function emitUnsetFn(b, nameV, lit) {
        var i
        for (i = 0; i < declaredFuncList.length; i++) {
            var fn = declaredFuncList[i]
            if (lit != undefined) { if (fn == lit) { fnStore(b, zero, fn) }; continue }
            var hit = curF.NewBlock(""), miss = curF.NewBlock("")
            b.NewCondBr(b.NewICmp(llvm.enum.IPredNE, b.NewCall(rtStreq, [nameV, gepStr(b, fn)]), zero), hit, miss)
            fnStore(hit, zero, fn)
            hit.NewBr(miss)
            b = miss
        }
        return b
    }

    // ===================================================================================
    //  The string runtime: one `declare` per helper (see rtDecl), in this emitter's own i8*
    //  types. The BODIES are languages/lib/bash-rt.c.
    // ===================================================================================

    // i8* rt_bump(i32 n): n fresh bytes of the string heap.
    var rtBump = rtDecl("rt_bump", true, [0])
    // i32 rt_release(i64 m, i64 lm) / i8* rt_keep(i64 m, i64 lm, i8* v, i32 id): see heapMark.
    var rtRelease = rtDecl("rt_release", false, [3, 3])
    var rtKeep = rtDecl("rt_keep", true, [3, 3, 1, 0])
    // i32 rt_strlen(i8* s)
    var rtStrlen = rtDecl("rt_strlen", false, [1])
    // i32 rt_charlen(i8* s): the number of CHARACTERS in s, which is what bash's ${#s}
    // counts - not bytes (rt_strlen) and not UTF-16 units.
    var rtCharLen = rtDecl("rt_charlen", false, [1])
    // i32 rt_charoff(i8* s, i32 k): the BYTE offset of character number k, clamped to the
    // length of s. rt_csubstr converts a character range with it.
    var rtCharOff = rtDecl("rt_charoff", false, [1, 0])
    // i32 rt_streq(i8* a, i8* b) -> 1 if equal, else 0.
    var rtStreq = rtDecl("rt_streq", false, [1, 1])
    // i32 rt_strcmp(i8* a, i8* b): -1 / 0 / 1 by unsigned byte order (the shell's < and >).
    var rtStrcmp = rtDecl("rt_strcmp", false, [1, 1])
    // i8* rt_strcat(i8* a, i8* b): fresh arena string = a followed by b.
    var rtStrcat = rtDecl("rt_strcat", true, [1, 1])
    // i8* rt_sput(i8* d, i8* s): s copied to d, answering where the next part goes.
    var rtSput = rtDecl("rt_sput", true, [1, 1])
    // i8* rt_sapp(i32 slot, i8* old, i8* x): the slot's `+=`, appended in place when it can be.
    var rtSapp = rtDecl("rt_sapp", true, [0, 1, 1])
    // i8* rt_int2str(i64 n): decimal string in the arena (mirrors the interpreter's numToStr).
    var rtInt2str = rtDecl("rt_int2str", true, [3])
    // i64 rt_str2int(i8* s): leading spaces/tabs, one +/- sign, digits until non-digit.
    var rtStr2int = rtDecl("rt_str2int", 3, [1])
    // i64 rt_test_int(i8* s, i8* who): an integer operand of test / [, or test_err.
    var rtTestInt = rtDecl("rt_test_int", 3, [1, 1])
    // i32 rt_test_syn(i8* who, i8* pre, i8* arg, i8* post) / rt_test_extra(i8* who, i8* arg):
    // a syntax error of test / [, reported unless an operand already was; sets test_err.
    var rtTestSyn = rtDecl("rt_test_syn", false, [1, 1, 1, 1])
    var rtTestExtra = rtDecl("rt_test_extra", false, [1, 1])
    // i32 rt_test(i8* fields, i8* who): test / [ parsed at run time over a field list.
    // i8* rt_test_one(i8* v): a field-list operand's one field, or test_multi set.
    // i32 rt_test_word(i8* s): whether s is a word test's parser reads as an operator.
    var rtTest = rtDecl("rt_test", false, [1, 1])
    var rtTestOne = rtDecl("rt_test_one", true, [1])
    var rtTestWord = rtDecl("rt_test_word", false, [1])
    // i32 rt_test_opt(i8* s) / rt_test_ref(i8* s): test -o OPTION / -R NAME.
    var rtTestOpt = rtDecl("rt_test_opt", false, [1])
    var rtTestRef = rtDecl("rt_test_ref", false, [1])
    // i64 rt_arith(i8* expr): the arithmetic evaluator for an expression that only exists at
    // run time; rt_idiv / rt_ipow are / % and ** with bash's error cases. Any of them can
    // raise arith_err (see languages/lib/bash-rt.c).
    var rtArith = rtDecl("rt_arith", 3, [1])
    var rtLetFields = rtDecl("rt_letfields", 3, [1, 0])
    var rtPcheck = rtDecl("rt_pcheck", true, [1, 0, 1, 1])
    var rtSubErr = rtDecl("rt_suberr", false, [0, 0])
    var rtIdiv = rtDecl("rt_idiv", 3, [3, 3, 0, 1, 1])
    var rtIpow = rtDecl("rt_ipow", 3, [3, 3, 1, 1])
    // An i32 as a decimal string, and a decimal string read back as an i32 - the status,
