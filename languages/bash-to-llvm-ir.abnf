    // "$@" can expand to any number of words and `shift` and `set --` are ordinary writes.
    var gArgvTop = rtGlobal("argv_top", i32)
    var gFrameBase = rtGlobal("frame_base", i32)
    var gFrameN = rtGlobal("frame_n", i32)

