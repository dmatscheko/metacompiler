    // upper/lower-cases every later write to the name, including one made by `read` or a
    // `for` head, so the case call belongs on the store funnel. It costs nothing for a name
    // with no case attribute - the maps are compile-time and the call is simply not emitted.
    function storeVar(b, name, v) { b.NewStore(attrCase(b, name, v), varPtr(b, name)) }
    // The one store that must NOT be transformed: the unset marker is an identity, and
    // rt_case would hand back a fresh string that no longer compares equal to it.
    function storeVarRaw(b, name, v) { b.NewStore(v, varPtr(b, name)) }
