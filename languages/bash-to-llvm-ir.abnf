        // (rt_glob_swap). For a lexical local of this function the global's attributes are
        // the ones its `local` saved for the return (the name's first undo entry here):
        // the store runs under them, they take the declaration's own, and the local
        // keeps its attributes.
        var declAt = function(b, j, v) {
            if (!global || curFrame == null) { return declOne(b, j, v) }
            var nm = names[j]
            var ge = null
            var u
            for (u = curFrame.undo; u < attrUndo.length && ge == null; u++) {
                if (attrUndo[u].name == nm) { ge = attrUndo[u] }
            }
            var sv = {name: nm, i: attrOn(intVars, nm), u: attrOn(upVars, nm), l: attrOn(loVars, nm), r: attrOn(roVars, nm), n: attrOn(refVars, nm)}
            if (ge != null && hasOwn(curFrame.locs, "$" + nm)) {
                attrUndo.push(ge)
                attrUnwind(attrUndo.length - 1)
            } else { ge = null }
            var id = llvm.constant.NewInt(i32, getVarId(nm))
            b.NewCall(rtGlobSwap, id)
            b = declOne(b, j, v)
            b.NewCall(rtGlobSwap, id)
            if (ge != null) {
                ge.i = attrOn(intVars, nm); ge.u = attrOn(upVars, nm); ge.l = attrOn(loVars, nm); ge.r = attrOn(roVars, nm); ge.n = attrOn(refVars, nm)
                attrUndo.push(sv)
                attrUnwind(attrUndo.length - 1)
            }
            return b
        }
