        var hole2 = e.NewCall(reEmit, [reK(OP_JMP), zero, zero])
        // A THIRD reserved slot, and it is deliberately INSIDE the atom's fragment: it
        // carries the per-iteration capture reset, so every copy re_copy makes for an
        // interval carries its own. Which groups to clear is only known once the atom
        // has been parsed, hence the hole.
        var g0 = e.NewLoad(i32, gReNg)
        var hole3 = e.NewCall(reEmit, [reK(OP_JMP), zero, zero])
        var astart = hole3
        e.NewCall(reAtom)
        var aend = e.NewLoad(i32, gRePc)
        var g1 = e.NewLoad(i32, gReNg)
        // The captures inside a repeated atom are cleared at the start of every
        // iteration, so a group that took part in an earlier iteration but not the last
        // one reads as unset: [[ ab =~ ^((a)|b*)*$ ]] leaves BASH_REMATCH[2] empty. The
        // group numbers inside the atom are contiguous, so one range covers them; with
        // no groups at all the slot degrades to a jump onto the atom.
        var hasG = e.NewICmp(reSGT, g1, g0)
        reSetF(e, hole3, 0, e.NewSelect(hasG, reK(OP_CLEAR), reK(OP_JMP)))
        reSetF(e, hole3, 1, e.NewSelect(hasG, e.NewMul(e.NewAdd(g0, one), reK(2)),
                                        e.NewAdd(hole3, one)))
        // Groups past the 64th get no SAVE either (the call site's caps array ends), so
        // the range stops at the last real capture slot and never reaches the marks
        // that share re_slot with them.
        var hiSlot = e.NewAdd(e.NewMul(g1, reK(2)), one)
        reSetF(e, hole3, 2, e.NewSelect(e.NewICmp(reSLT, hiSlot, reK(RE_NCAP)),
                                        hiSlot, reK(RE_NCAP - 1)))
        var bad0 = f.NewBlock("rpbad"), q = f.NewBlock("rpq")
        e.NewCondBr(e.NewICmp(reNE, e.NewLoad(i32, gReBad), zero), bad0, q)
        bad0.NewRet(zero)

        // "{" opens an interval only when a DIGIT follows; bash 5.3 takes "a{b" and "a{"
        // as a literal brace but rejects "a{1" outright.
        var qc = q.NewCall(reAt, zero)
        var qd = q.NewCall(reAt, one)
        var iv = f.NewBlock("rpiv"), sh = f.NewBlock("rpsh")
        q.NewCondBr(q.NewAnd(q.NewICmp(reEQ, qc, reK(123)),
                             q.NewAnd(q.NewICmp(reSGE, qd, reK(48)),
                                      q.NewICmp(reSLE, qd, reK(57)))), iv, sh)

        // ---- simple quantifiers. Exactly ONE is allowed; a second is a compile error.
        var sstar = f.NewBlock("rpsstar"), splus = f.NewBlock("rpsplus")
        var sopt = f.NewBlock("rpsopt"), snoq = f.NewBlock("rpsnoq")
        var sdone = f.NewBlock("rpsdone")
        var sq = f.NewBlock("rpsq"), badq = f.NewBlock("rpbadq")
        var sc = sh.NewCall(reAt, zero)
        var s1 = f.NewBlock("rpsh1"), s2 = f.NewBlock("rpsh2"), s3 = f.NewBlock("rpsh3")
        var shx = f.NewBlock("rpshx"), shy = f.NewBlock("rpshy")
