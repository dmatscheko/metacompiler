                var uf = false, uv = false, un = false, ubad = ""
                while (uk < argTs.length && argTs[uk].c != undefined && argTs[uk].c.length > 1 && argTs[uk].c.charAt(0) == "-") {
                    var uo = argTs[uk].c
                    uk = uk + 1
                    if (uo == "--") { break }
                    var uc
                    for (uc = 1; uc < uo.length && ubad == ""; uc++) {
                        var ul = uo.charAt(uc)
                        if (ul == "f") { uf = true }
                        else if (ul == "v") { uv = true }
                        else if (ul == "n") { un = true }
                        else { ubad = ul }
                    }
                }
                if (ubad != "" || (uf && uv)) {
                    var ubox = {b: b}
                    evalArgs(ubox, argTs)
                    b = emitAbortCheck(ubox.b)
                    emitDiag(b, gepStr(b, (ubad != "")
                        ? "unset: -" + ubad + ": invalid option\nunset: usage: unset [-f] [-v] [-n] [name ...]\n"
                        : "unset: cannot simultaneously unset a function and a variable\n"))
                    storeStatusI(b, (ubad != "") ? 2 : 1)
                    return b
                }
                if (uf) {
                    for (; uk < argTs.length; uk++) {
                        var rf = evalWord(b, argTs[uk])
                        b = rf.b
                        b = emitUnsetFn(b, rf.v, argTs[uk].c)
                    }
                    storeStatusI(b, 0)
                    return b
                }
                // The status: 1 when an operand failed (rt_arr_unset), else 0.
                var ust = zero
                for (; uk < argTs.length; uk++) {
                    // A name that is no variable (unset, no array, not declared) unsets the
                    // function of that name instead.
                    if (!uv && (argTs[uk].c == undefined || funcFor(argTs[uk].c) != null)) {
                        var rn = evalWord(b, argTs[uk])
                        b = rn.b
                        var noVar = b.NewAnd(b.NewICmp(llvm.enum.IPredEQ, b.NewCall(rtIsset, b.NewCall(rtGetByName, rn.v)), zero),
                                             b.NewICmp(llvm.enum.IPredEQ, b.NewOr(b.NewCall(rtArrAny, rn.v), b.NewCall(rtArrSmarked, rn.v)), zero))
                        var fnB = curF.NewBlock(""), varB = curF.NewBlock("")
                        b.NewCondBr(noVar, fnB, varB)
                        emitUnsetFn(fnB, rn.v, argTs[uk].c).NewBr(varB)
                        b = varB
                    }
                    // A name built by expansion (`unset "d[$((i+1))]"`) is resolved at run time;
                    // the attribute and local bookkeeping below needs a literal one.
                    if (argTs[uk].c == undefined) {
                        var ru = evalWord(b, argTs[uk])
                        b = ru.b
                        ust = b.NewOr(ust, b.NewCall(rtUnsetName, ru.v))
                        continue
                    }
                    var sp0 = splitSubscript(argTs[uk].c)
                    // Without -n, unset acts on the variable a nameref names.
                    if (sp0.key == null && !un && attrOn(refVars, sp0.name)) {
                        ust = b.NewOr(ust, b.NewCall(rtUnsetRef, gepStr(b, sp0.name)))
                        continue
                    }
                    if (sp0.key == null && attrOn(roVars, sp0.name)) {
                        emitDiag(b, gepStr(b, "unset: " + sp0.name + ": cannot unset: readonly variable\n"))
                        ust = one
                    }
                    else if (sp0.key == null) {
                        storeVarRaw(b, sp0.name, unsetPtr(b))
                        b.NewCall(rtArrClear, gepStr(b, sp0.name))
                        b.NewCall(rtXmark, [gepStr(b, sp0.name), zero])
                        // `unset` drops the attributes with the value, in bash and here.
