    // ===================================================================================
    //  Arithmetic thunks (bare functions):  function(b) -> {b, v: i32}
    // ===================================================================================

    // A numeric literal: 0xHH hexadecimal, BASE#DIGITS, a leading 0 octal, else decimal.
    // bash's digit alphabet SEPARATES the two letter cases once the base passes 36, and adds
    // "@" (62) and "_" (63); rt_arith's ar_number in languages/lib/bash-rt.c is the same
    // table. A literal is folded here when its value is exact in a double; a bigger one, or
    // one bash rejects (a digit too great for its base, a base outside 2..64), is handed to
    // rt_arith as text, which wraps it to 64 bits or reports the error at run time.
    function digitsInBase(t, base) {
        if (base < 2 || base > 64) { return null }
        var v = 0
        var i
        for (i = 0; i < t.length; i++) {
            var cc = t.charCodeAt(i)
            var d = 64
            if (cc >= 48 && cc <= 57) { d = cc - 48 }
            else if (cc >= 97 && cc <= 122) { d = cc - 87 }
            else if (cc >= 65 && cc <= 90) { d = (base > 36) ? cc - 29 : cc - 55 }
            else if (cc == 64) { d = 62 }
            else if (cc == 95) { d = 63 }
            if (d >= base) { return null }
            v = v * base + d
            if (v > 9007199254740991) { return null }
        }
        return v
    }
    function parseNumLit(t) {
        if (t.length > 2 && t.charAt(0) == "0" && (t.charAt(1) == "x" || t.charAt(1) == "X")) {
            return digitsInBase(t.slice(2), 16)
        }
        var h = -1
        var i
        for (i = 0; i < t.length; i++) { if (t.charAt(i) == "#") { h = i } }
        if (h > 0) {
            var bs = digitsInBase(t.slice(0, h), 10)
            return (bs == null) ? null : digitsInBase(t.slice(h + 1), bs)
        }
        if (t.length > 1 && t.charAt(0) == "0") { return digitsInBase(t.slice(1), 8) }
        return digitsInBase(t, 10)
    }
    function mkNum(text) {
        var n = parseNumLit(text)
        if (n == null) { return function(b) { return {b: b, v: b.NewCall(rtArith, gepStr(b, text))} } }
        var c = llvm.constant.NewInt(i64, n)
        return function(b) { return {b: b, v: c, lit: n} }
    }
    // items = [baseWordThunk, digitsWordThunk] - see the ArBaseDyn rule. Either side was built
    // by expansion, so the constant is put back together and read by rt_arith.
    function mkArBaseDyn(items) {
        var lw = items[0], rw = items[1]
        return function(b) {
            var rl = evalWord(b, lw)
            var rr = evalWord(rl.b, rw)
            var bb = rr.b
            var txt = bb.NewCall(rtStrcat, [bb.NewCall(rtStrcat, [rl.v, gepStr(bb, "#")]), rr.v])
            return {b: bb, v: bb.NewCall(rtArith, txt)}
        }
    }
    // An arithmetic thunk whose consumer counts in i32 (a substring offset or length): the
    // value saturates rather than wraps, so an offset past 2^31 still selects nothing.
    function ar32T(t) {
        var lo = llvm.constant.NewInt(i64, -2147483647), hi = llvm.constant.NewInt(i64, 2147483647)
        return function(b) {
            var r = t(b)
            var bb = r.b
            var v = bb.NewSelect(bb.NewICmp(llvm.enum.IPredSLT, r.v, lo), lo, r.v)
            v = bb.NewSelect(bb.NewICmp(llvm.enum.IPredSGT, v, hi), hi, v)
            return {b: bb, v: bb.NewTrunc(v, i32)}
        }
    }
    function mkArOfStr(o) { return function(b) { var r = evalWord(b, o); return {b: r.b, v: r.b.NewCall(rtArith, r.v)} } }
    function mkUn(op, t) {
        return function(b) {
            var r = t(b)
            var bb = r.b
            if (op == "-") { return {b: bb, v: bb.NewSub(zero64, r.v)} }
            if (op == "+") { return {b: bb, v: r.v} }
            if (op == "!") { return {b: bb, v: bb.NewZExt(bb.NewICmp(llvm.enum.IPredEQ, r.v, zero64), i64)} }
            return {b: bb, v: bb.NewXor(r.v, llvm.constant.NewInt(i64, -1))}
        }
    }
    function mkIncDec(items) {
        var lhs = null, iop = "++", pre = 0
        var i
        for (i = 0; i < items.length; i++) {
            var it = items[i]
            if (it.lhs != undefined) { lhs = it } else { iop = it.iop; pre = it.pre }
        }
        return function(b) {
            var rk = arLhsKey(b, lhs)
            b = rk.b
            var v = arLhsGet(b, lhs.lhs, rk.k)
            var nv = (iop == "++") ? b.NewAdd(v, one64) : b.NewSub(v, one64)
            b = arLhsSet(b, lhs.lhs, rk.k, nv)
            return {b: b, v: (pre == 1) ? nv : v}
        }
    }
    function mkArAssign(items, at) {
        var lhs = items[0]
        var aop = items[1].aop
        var t = items[2]
        var rc = arRecLa(at)
        return function(b) {
            var rk = arLhsKey(b, lhs)
            b = rk.b
            // Plain = does not read the target: `x=q; (( x = 5 ))` is no recursion error.
            var cur = (aop != "=") ? arLhsGet(b, lhs.lhs, rk.k) : null
            var r = t(b)
            b = r.b
            var nv = r.v
