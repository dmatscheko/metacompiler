                if (vs.length == 2) { return {b: b, v: b.NewCall(rtStrcat, [vs[0], vs[1]])} }
                var tot = one
                for (k = 0; k < vs.length; k++) { tot = b.NewAdd(tot, b.NewCall(rtStrlen, vs[k])) }
                var d = b.NewCall(rtBump, tot)
                var q = d
                for (k = 0; k < vs.length; k++) { q = b.NewCall(rtSput, [q, vs[k]]) }
                return {b: b, v: d}
