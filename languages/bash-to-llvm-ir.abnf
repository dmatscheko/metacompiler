            }
            if (pe == "substr") {
                var offT = ariths[0]
                var lenT = (ariths.length > 1) ? ariths[1] : null
                return {f: true, c: undefined, fn: function(b) {
                    var rs = subOf(b); b = rs.b
                    var k = kindOf(b, rs.v)
                    var whole = b.NewICmp(llvm.enum.IPredNE, k, zero)
                    var star = b.NewICmp(llvm.enum.IPredEQ, k, llvm.constant.NewInt(i32, 2))
                    var all = b.NewCall(rtArrList, [nmOf(b), ifsFirstValue(b), zero, zero])
                    var ro = offT(b); b = ro.b
                    var rlv = null
                    if (lenT != null) { var rl = lenT(b); b = rl.b; rlv = rl.v }
                    var cnt = b.NewCall(rtNFields, all)
                    var off = b.NewSelect(b.NewICmp(llvm.enum.IPredSLT, ro.v, zero), b.NewAdd(cnt, ro.v), ro.v)
                    var n = b.NewSub(cnt, off)
                    if (rlv != null) { n = rlv }
                    var lstV = b.NewCall(rtSliceFields, [all, off, n, ifsFirstValue(b), b.NewZExt(star, i32)])
                    // ${a[i]:off:len} slices the ELEMENT, not the element list - the
                    // list slice was emitted for a plain index too, so ${a[2]:1:2}
                    // answered the whole joined array while the interpreter (and
                    // bash) answered two characters of a[2].
                    var ev = b.NewCall(rtArrGet, [nmOf(b), keyOf(b, rs.v)])
                    var elen = b.NewCall(rtCharLen, ev)
                    var eoff = b.NewSelect(b.NewICmp(llvm.enum.IPredSLT, ro.v, zero), b.NewAdd(elen, ro.v), ro.v)
                    eoff = b.NewSelect(b.NewICmp(llvm.enum.IPredSLT, eoff, zero), zero, eoff)
                    var en = llvm.constant.NewInt(i32, -1)
                    if (rlv != null) {
                        en = b.NewSelect(b.NewICmp(llvm.enum.IPredSLT, rlv, zero),
                                         b.NewSub(b.NewAdd(elen, rlv), eoff), rlv)
                        en = b.NewSelect(b.NewICmp(llvm.enum.IPredSLT, en, zero), zero, en)
