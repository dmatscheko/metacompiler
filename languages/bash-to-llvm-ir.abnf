        // a local of the call where the keyword makes one. A field that is no name is bash's
        // "not a valid identifier" (*badP = 1); one that is an option stops the shell, which
        // cannot apply it here. Twin of makeDeclDyn in bash-interpreter.abnf.
        var emitDeclDyn = function(b, words, badP) {
            var listP = slotOf(i8ptr)
            b.NewStore(nilList(b), listP)
            var w
            for (w = 0; w < words.length; w++) {
                var rw = words[w].fn(b)
