KwIf        = "if" KwEnd ;
KwThen      = "then" KwEnd ;
KwElif      = "elif" KwEnd ;
KwElse      = "else" KwEnd ;
KwFi        = "fi" KwEnd ;
KwFor       = "for" KwEnd ;
KwWhile     = "while" KwEnd ;
KwDo        = "do" KwEnd ;
KwDone      = "done" KwEnd ;
KwIn        = "in" KwEnd ;
KwCase      = "case" KwEnd ;
KwUntil     = "until" KwEnd ;
