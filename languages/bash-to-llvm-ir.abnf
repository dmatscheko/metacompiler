            }
            variants = out
        }
        return variants
    }
    function mkWords(segs) {
        var hasBrace = false
        var i
        for (i = 0; i < segs.length; i++) { if (segs[i].alts != undefined) { hasBrace = true } }
        if (!hasBrace) { return [mkWord(segs)] }
        var vs = braceVariants(segs)
        var out = []
        for (i = 0; i < vs.length; i++) { out.push(mkWord(vs[i])) }
        return out
    }
    function mkTilde() { return mkVarRef("HOME") }

    function mkSplittable(seg) { return {sp: seg, s: seg.s} }
    // The IFS in force, defaulting to " \t\n" when the variable is unset.
    function ifsValue(b) {
        var v = loadVar(b, "IFS")
        return b.NewSelect(b.NewICmp(llvm.enum.IPredEQ, v, unsetPtr(b)), gepStr(b, " \t\n"), v)
