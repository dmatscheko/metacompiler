        //
        // An IFS delimiter at either end of an unquoted expansion separates it from the literal
        // text beside it (`x="  a   b  "; echo w:[$x]` is four words), so the lead/trail flags are
        // asked of the RAW value and `opened` (anything in the field under construction since the
        // last close) joins acc and open as loop-carried state. rt_bnd_acc2 in bash-rt.c has the
        // rule; bash-interpreter.abnf's mkWord is the same state machine.
        return {s: anySub, f: true, c: undefined, fn: function(b) {
            var acc = nilList(b)
            var open = emptyPtr(b)
            var opened = zero
            var k
            for (k = 0; k < segs.length; k++) {
                var sg = segs[k]
                var fv = null
                var lead = zero
                var trail = zero
                if (sg.sp != undefined) {
                    var svq = uqStarEmit
                    uqStarEmit = true
                    var r = sg.sp.fn(b)
                    uqStarEmit = svq
                    b = r.b
                    // An unquoted expansion is split on IFS. "$@" and ${a[@]} are joined
                    // first (rt_uqlist), except under a null IFS, where they stay a list
                    // with no boundary of its own.
                    var ifsv = ifsValue(b)
                    var uv = b.NewCall(rtUqList, [r.v, ifsv])
                    var isL = b.NewICmp(llvm.enum.IPredNE, b.NewCall(rtIsList, uv), zero)
                    fv = b.NewSelect(isL, uv, b.NewCall(rtSplitIfs, [uv, ifsv]))
                    lead = b.NewSelect(isL, zero, b.NewCall(rtIfsLead, [uv, ifsv]))
                    trail = b.NewSelect(isL, zero, b.NewCall(rtIfsTrail, [uv, ifsv]))
                } else if (sg.f == true) {
                    var r2 = sg.fn(b)
                    b = r2.b
                    fv = r2.v
                } else {
                    var r3 = sg.fn(b)
                    b = r3.b
                    open = b.NewCall(rtStrcat, [open, r3.v])
                    opened = one
                }
                if (fv != null) {
                    var nacc = b.NewCall(rtBndAcc2, [acc, open, opened, fv, lead, trail])
                    var nopen = b.NewCall(rtBndOpen2, [open, opened, fv, lead, trail])
                    opened = b.NewCall(rtBndOpened2, [opened, fv, lead, trail])
                    open = nopen
                    acc = nacc
                }
