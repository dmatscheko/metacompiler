                storeStatusI(b, 0)
                return b
            }
            if (cmd == "eval") {
                var esrc = ""
                var ei
                var allConst = true
                if (argTs.length > 0 && argTs[0].c == "--") { argTs = argTs.slice(1) }
                for (ei = 0; ei < argTs.length; ei++) {
