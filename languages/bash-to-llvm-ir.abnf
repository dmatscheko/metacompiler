        }
        if (pe == "len") {
            return {c: undefined, fn: function(b) {
                // ${#v} counts CHARACTERS in bash (rt_strlen counts bytes).
                return {b: b, v: b.NewCall(rtInt2str, b.NewCall(rtCharLen, varString(b, name)))}
            }}
        }
        if (pe == "ind") {
            return {c: undefined, fn: function(b) {
                return {b: b, v: b.NewCall(rtGetByName, varString(b, name))}
            }}
        }
        // ${#v OP arg} is a parse-time-legal, run-time-illegal combination in bash:
        //     $ echo "${#x-default}"   ->  bash: ${#x-default}: bad substitution
        // The shell dies; here that is the abort flag, the same one set -u raises.
        if (lenp) {
