        while (fdGlobals.length <= n) { fdGlobals.push(null) }
        if (fdGlobals[n] == null) { fdGlobals[n] = m.NewGlobalDef("fd_chan" + n, llvm.constant.NewInt(i32, -1)) }
        return fdGlobals[n]
    }
    function emitOpenRedirs(b, redirs) {
        var so = slotOf(i32), se = slotOf(i32)
        b.NewStore(b.NewLoad(i32, gSinkOut), so)
        b.NewStore(b.NewLoad(i32, gSinkErr), se)
        var sb = null, sp = null
        var fsv = []
        var bad = null, badCh = null
        var badFds = []
