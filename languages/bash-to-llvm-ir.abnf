    var rtCSubstr = rtDecl("rt_csubstr", true, [1, 0, 0])
    var rtEgClose = rtDecl("rt_egclose", false, [1])
    var rtEgAlt = rtDecl("rt_egalt", false, [1, 0])
    var rtGlob = rtDecl("rt_glob", false, [1, 1])
    var rtEg = rtDecl("rt_eg", false, [1, 1, 0])
    var rtMatchLen = rtDecl("rt_matchlen", false, [1, 1, 0])
