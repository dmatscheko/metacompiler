    // ===================================================================================
    //  Word / expansion thunks:  {fn: function(b) -> {b, v: i8*}, c: const-string|undefined}
    // ===================================================================================

    function makeConst(s) {
        return {fn: function(b) { return {b: b, v: gepStr(b, s)} }, c: s}
    }
    // Command substitution: divert output into a capture buffer, run the list, take the buffer.
    function mkCmdSub(bodyT) {
        return {s: true, c: undefined, fn: function(b) {
            b.NewCall(rtCapBegin, zero)
            var savedExit = curExit, savedExitRd = curExitRd
            var savedTraps = trapList
            trapList = []
            var subEnd = curF.NewBlock("")
            curExit = subEnd
            curExitRd = redirStack.length
            b.NewCall(rtSsSave, zero)
            var optSave = saveOpts(b)
            var undoBase = attrUndo.length
            subDepth = subDepth + 1
            var svq = uqStarEmit
            uqStarEmit = false
            var eb = bodyT(b)
            uqStarEmit = svq
            subDepth = subDepth - 1
            attrUnwind(undoBase)
            eb.NewBr(subEnd)
            curExit = savedExit
            curExitRd = savedExitRd
            var myTraps = trapList
            trapList = savedTraps
            subEnd = emitTraps(subEnd, myTraps)
            var wasEx = subEnd.NewICmp(llvm.enum.IPredNE, subEnd.NewLoad(i32, gExited), zero)
            var st = subEnd.NewSelect(wasEx, subEnd.NewLoad(i32, gExitCode), subEnd.NewLoad(i32, gStatus))
            subEnd.NewStore(zero, gExited)
            subEnd.NewCall(rtSsRestore, zero)
            restoreOpts(subEnd, optSave)
            subEnd.NewStore(st, gStatus)
            var v = subEnd.NewCall(rtCapEnd, one)
            return {b: subEnd, v: v}
        }}
    }
    function mkArCmdSub(sub) {
        return function(b) { var r = evalWord(b, sub); return {b: r.b, v: r.b.NewCall(rtArith, r.v)} }
    }
    // The parameter-expansion operators that take a GLOB and rewrite the value: the two
    // strips, the two case maps and the two replacements. They are the ones that also apply
    // ELEMENT-WISE to a subscripted expansion, and rt_mapf takes the same (kind, mode) pair
    // the three scalar runtime calls take - kind 0 rt_strip, 1 rt_replace, 2 rt_case.
    // languages/bash-interpreter.abnf's isPatOp / applyPatOp are the same table.
    function isPatOp(pe) {
        if (pe == "#" || pe == "##" || pe == "%" || pe == "%%") { return true }
        if (pe == "^" || pe == "^^" || pe == "," || pe == ",,") { return true }
        return (pe == "/" || pe == "//")
    }
    function patOpKind(pe) {
        if (pe == "#" || pe == "##" || pe == "%" || pe == "%%") { return 0 }
        if (pe == "/" || pe == "//") { return 1 }
        return 2
    }
    function patOpMode(pe, anchor) {
        if (pe == "##") { return 1 }
        if (pe == "%") { return 2 }
        if (pe == "%%") { return 3 }
        if (pe == "^^") { return 1 }
        if (pe == ",") { return 2 }
        if (pe == ",,") { return 3 }
        if (pe == "/" || pe == "//") {
            if (anchor == "#") { return 2 }
            if (anchor == "%") { return 3 }
            return (pe == "//") ? 1 : 0
        }
        return 0
    }

    // The @-transforms rt_mapf can walk element-wise, as an (kind, mode) pair. -1 means
    // "not one of them": @A, @a, @K and @k describe the VARIABLE rather than an element
    // when the subscript is @ or *, so they are handled beside this walk, not by it.
    function xfMapKind(xf) {
        if (xf == "U" || xf == "L" || xf == "u") { return 2 }
        if (xf == "E") { return 4 }
        if (xf == "P") { return 5 }
        if (xf == "Q") { return 3 }
        return -1
    }
    function xfMapMode(xf) {
        if (xf == "U") { return 1 }
        if (xf == "L") { return 3 }
        return 0
    }

    // ${...} : items are [{pname}, {pe}?, {op}?, {anchor}?, word objects / arithmetic thunks]
    function mkParamExp(items) {
        var pe = "", name = "", op = "", anchor = "", xf = "", pfx = ""
        var lenp = false, indp = false
        var words = []     // word objects {fn, c}
        var ariths = []    // bare arithmetic thunks (the ${v:off:len} offsets)
        var wordT = null
        var hasIdx = false
        var i
        for (i = 0; i < items.length; i++) {
            var it = items[i]
            if (typeof it == "function") { ariths.push(it) }
            else if (it.hasIdx != undefined) { hasIdx = true }
            else if (it.fn != undefined) { words.push(it); wordT = it }
            else if (it.lenp != undefined) { lenp = true }
            else if (it.indp != undefined) { indp = true }
            else if (it.xf != undefined) { xf = it.xf }
            else if (it.pfx != undefined) { pfx = it.pfx }
            else if (it.pe != undefined) { pe = it.pe }
            else if (it.pname != undefined) { name = it.pname }
            else if (it.op != undefined) { op = it.op }
            else if (it.anchor != undefined) { anchor = it.anchor }
        }
        // A BARE "#"/"!" prefix keeps the dedicated length / indirection paths (including
        // their array forms ${#a[@]} and ${!a[@]}); combined with an operator it does not.
        var bare = (op == "" && pe == "" && xf == "")
        if (lenp && bare) { pe = "len" }
        if (indp && bare && pfx == "") { pe = "ind" }
        // ${!prefix*} / ${!prefix@}: sorted, joined by IFS's first character for *.
        if (pfx != "") {
            var pfxAt = pfx.charAt(pfx.length - 1) == "@"
            var pfxName = name
            return {c: undefined, f: pfxAt, fn: function(b) {
                return {b: b, v: b.NewCall(rtPfxNames, [gepStr(b, pfxName), ifsFirstValue(b), pfxAt ? zero : one])}
            }}
        }
        // $@ and $* WITH AN OPERATOR are the positional parameters as a LIST, as
        // ${a[@]} / ${a[*]} are an array's, so they take the subscripted path below with
        // "@"/"*" as both the name and the subscript (rt_sc_count / rt_sc_get /
        // rt_sc_has / rt_sc_list answer the parameters for those names), every
        // @-transform included (rt_declpos has @A's own form). Twin of the same routing
        // in bash-interpreter.abnf.
        if (!hasIdx && (name == "@" || name == "*") && !lenp && !indp
            && (pe == "substr" || isPatOp(pe) || op != "" || xf != "")) {
            hasIdx = true
            var posWords = [makeConst(name)]
            for (var pw = 0; pw < words.length; pw++) { posWords.push(words[pw]) }
            words = posWords
        }
        // The @-transforms. @U/@L/@u are rt_case, @Q/@K/@k are rt_shq, @A is the assignment
        // that would recreate the variable, @E decodes the $'...' escapes at run time and
        // @P is rt_prompt. -r and -x are modelled in neither half, so they are absent from
        // both.
        var xfName = name
        // The attribute letters of the name, as an i8*: A/a for the two array kinds ahead
        // of i/l/u for the scalar ones, which is what the interpreter half answers too.
        // `nmv` is the name - a constant for a plain expansion, and the value of the
        // reference for ${!r@A}, where bash names the variable the indirection LANDED on.
        // The scalar letters come from the lexical tables, which is the compiler's
        // documented attribute scope (manual 7.9); only array-ness is asked at RUN time,
        // because `q=(1 2)` declares nothing, hence the select.
        function attrLetters(b, nmv) {
            var sc = scalarAttrLetters(xfName)
            if (hasOwn(assocArrays, "$" + xfName)) { return gepStr(b, "A" + sc) }
            var isArrRt = b.NewICmp(llvm.enum.IPredNE, b.NewCall(rtArrAny, nmv), zero)
            return b.NewSelect(isArrRt, gepStr(b, "a" + sc), gepStr(b, sc))
        }
        // `isset` is an i32 0/1: ${nosuch@Q} and ${nosuch@A} are EMPTY in bash 5.3.15, while
        // ${empty@Q} is ''.
        function applyXf(b, v, isset, nmv) {
            if (xf == "U") { return b.NewCall(rtCase, [v, one, emptyPtr(b)]) }
            if (xf == "L") { return b.NewCall(rtCase, [v, llvm.constant.NewInt(i32, 3), emptyPtr(b)]) }
            if (xf == "u") { return b.NewCall(rtCase, [v, zero, emptyPtr(b)]) }
            if (xf == "E") { return b.NewCall(rtAnsiC, v) }
            if (xf == "P") { return b.NewCall(rtPrompt, v) }
            if (xf == "a") { return attrLetters(b, nmv) }
            if (xf == "A") { return b.NewCall(rtDeclAsg, [nmv, attrLetters(b, nmv), v, isset]) }
            return b.NewCall(rtShq, [v, isset])
        }
        // NAME[SUBSCRIPT]: the first word is the subscript, the rest belong to the operator.
        if (hasIdx && words.length > 0) {
            var idxW = words[0]
            words = words.slice(1)
            wordT = (words.length > 0) ? words[words.length - 1] : null
            var isAssoc = hasOwn(assocArrays, "$" + name)
            var nmOf = function(b) { return gepStr(b, name) }
            // The subscript, and the key it names: an associative array's is the text, an
            // indexed array's an arithmetic expression (rt_arr_key; a canonical literal index
            // needs no evaluation). Computed ONCE per expansion, so `${a[i++]}` steps i once.
            var subOf = function(b) { return subKeyOf(b, name, idxW) }
            var kindOf = function(b, sub) {
                // 0 = a plain key, 1 = "@" (fields), 2 = "*" (joined)
                var isAt = b.NewICmp(llvm.enum.IPredNE, b.NewCall(rtStreq, [sub, gepStr(b, "@")]), zero)
                var isStar = b.NewICmp(llvm.enum.IPredNE, b.NewCall(rtStreq, [sub, gepStr(b, "*")]), zero)
                return b.NewSelect(isAt, one, b.NewSelect(isStar, llvm.constant.NewInt(i32, 2), zero))
            }
            if (pe == "len") {
                return {c: undefined, fn: function(b) {
                    var rs = subOf(b); b = rs.b
                    var k = kindOf(b, rs.v)
                    var whole = b.NewICmp(llvm.enum.IPredNE, k, zero)
                    return {b: b, v: b.NewSelect(whole,
                        i2s(b, b.NewCall(rtScCount, nmOf(b))),
                        i2s(b, b.NewCall(rtCharLen, b.NewCall(rtScGet, [nmOf(b), rs.k]))))}
                }}
            }
            if (pe == "ind") {
                return {f: true, c: undefined, fn: function(b) {
                    var rs = subOf(b); b = rs.b
                    var k = kindOf(b, rs.v)
                    var star = b.NewICmp(llvm.enum.IPredEQ, k, llvm.constant.NewInt(i32, 2))
                    return {b: b, v: b.NewCall(rtScList, [nmOf(b), starSepSp(b),
                        b.NewZExt(star, i32), one])}
                }}
            }
            if (pe == "substr") {
                var offT = ar32T(ariths[0])
                var lenT = (ariths.length > 1) ? ar32T(ariths[1]) : null
                return {f: true, c: undefined, fn: function(b) {
                    var rs = subOf(b); b = rs.b
                    var k = kindOf(b, rs.v)
                    var whole = b.NewICmp(llvm.enum.IPredNE, k, zero)
                    var star = b.NewICmp(llvm.enum.IPredEQ, k, llvm.constant.NewInt(i32, 2))
                    var ro = offT(b); b = ro.b
                    var rlv = null
                    if (lenT != null) { var rl = lenT(b); b = rl.b; rlv = rl.v }
                    var lstV = null
                    if (name == "@" || name == "*" || isAssoc) {
                        // The positional list counts from $0: "${@:1}" is $1 on.
                        var all = (name == "@" || name == "*") ? b.NewCall(rtParams0)
                                                               : b.NewCall(rtScList, [nmOf(b), ifsFirstValue(b), zero, zero])
                        var cnt = b.NewCall(rtNFields, all)
                        var off = b.NewSelect(b.NewICmp(llvm.enum.IPredSLT, ro.v, zero), b.NewAdd(cnt, ro.v), ro.v)
                        // A negative offset reaching past the start selects nothing.
                        off = b.NewSelect(b.NewICmp(llvm.enum.IPredSLT, off, zero), cnt, off)
                        var n = b.NewSub(cnt, off)
                        if (rlv != null) { n = rlv }
                        lstV = b.NewCall(rtSliceFields, [all, off, n, ifsFirstValue(b), starArg(b, b.NewZExt(star, i32))])
                    } else {
                        // An indexed array is sliced by INDEX (rt_arr_slice), not by position.
                        lstV = b.NewCall(rtArrSlice, [nmOf(b), b.NewSExt(ro.v, i64),
                            (rlv != null) ? b.NewSExt(rlv, i64) : zero64, (rlv != null) ? one : zero,
                            ifsFirstValue(b), starArg(b, b.NewZExt(star, i32))])
                    }
                    // ${a[i]:off:len} slices the ELEMENT, not the element list.
                    var ev = b.NewCall(rtScGet, [nmOf(b), rs.k])
                    var elen = b.NewCall(rtCharLen, ev)
                    var eoff = b.NewSelect(b.NewICmp(llvm.enum.IPredSLT, ro.v, zero), b.NewAdd(elen, ro.v), ro.v)
                    eoff = b.NewSelect(b.NewICmp(llvm.enum.IPredSLT, eoff, zero), elen, eoff)
                    var en = llvm.constant.NewInt(i32, -1)
                    if (rlv != null) {
                        en = b.NewSelect(b.NewICmp(llvm.enum.IPredSLT, rlv, zero),
                                         b.NewSub(b.NewAdd(elen, rlv), eoff), rlv)
                        en = b.NewSelect(b.NewICmp(llvm.enum.IPredSLT, en, zero), zero, en)
                    }
                    var elV = b.NewCall(rtCSubstr, [ev, eoff, en])
                    return {b: b, v: b.NewSelect(whole, lstV, elV)}
                }}
            }
            // A pattern operator on a subscripted expansion applies to EVERY ELEMENT before the join
            // ("${b[*]/a/Q}" for b=(aa ba) is "Qa bQ"), through rt_mapf; the element arm is the plain
            // scalar call. The subscript decides at run time, so both are emitted and selected.
            if (isPatOp(pe)) {
                var mOp = patOpKind(pe)
                var mMode = patOpMode(pe, anchor)
                var mPatW = (words.length > 0) ? words[0] : null
                var mRepW = (words.length > 1) ? words[1] : null
                var mOpC = llvm.constant.NewInt(i32, mOp)
                var mModeC = llvm.constant.NewInt(i32, mMode)
                return {f: true, c: undefined, fn: function(b) {
                    var rs = subOf(b); b = rs.b
                    var k = kindOf(b, rs.v)
                    var whole = b.NewICmp(llvm.enum.IPredNE, k, zero)
                    var star = b.NewICmp(llvm.enum.IPredEQ, k, llvm.constant.NewInt(i32, 2))
                    var pv = emptyPtr(b)
                    if (mPatW != null) { var rp3 = evalWord(b, mPatW); b = rp3.b; pv = rp3.v }
                    var rv3 = emptyPtr(b)
                    if (mRepW != null) { var rr3 = evalWord(b, mRepW); b = rr3.b; rv3 = rr3.v }
                    var allE = b.NewCall(rtScList, [nmOf(b), ifsFirstValue(b), zero, zero])
                    var mSep = (mOp == 0) ? starSepSp(b) : ifsFirstValue(b)
                    var mStar = b.NewZExt(star, i32)
                    if (mOp != 0) { mStar = starArg(b, mStar) }
                    var lstM = b.NewCall(rtMapf, [allE, mOpC, pv, rv3, mModeC, mSep, mStar])
                    var evM = b.NewCall(rtScGet, [nmOf(b), rs.k])
                    var elM = evM
                    if (mOp == 0) { elM = b.NewCall(rtStrip, [evM, pv, mModeC]) }
                    else if (mOp == 1) { elM = b.NewCall(rtReplace, [evM, pv, rv3, mModeC]) }
                    else { elM = b.NewCall(rtCase, [evM, mModeC, pv]) }
                    return {b: b, v: b.NewSelect(whole, lstM, elM)}
                }}
            }
            // ${a[k]-default} and its siblings: the scalar arms of mkParamExp below, with "is it set"
            // asked of the element through rt_sc_has instead of the unset marker.
            var idxColon = (op != "") && (op.charAt(0) == ":")
            var idxO = idxColon ? op.slice(1) : op
            var idxWordT = wordT
            return {f: true, c: undefined, fn: function(b) {
                var rs = subOf(b); b = rs.b
                var k = kindOf(b, rs.v)
                var whole = b.NewICmp(llvm.enum.IPredNE, k, zero)
                var star = b.NewICmp(llvm.enum.IPredEQ, k, llvm.constant.NewInt(i32, 2))
                var starA = starArg(b, b.NewZExt(star, i32))
                var lst = b.NewCall(rtScList, [nmOf(b), ifsFirstValue(b), starA, zero])
                var one1 = b.NewCall(rtScGet, [nmOf(b), rs.k])
                if (op != "") {
                    var kk = rs.k
                    var blankE = b.NewICmp(llvm.enum.IPredEQ, b.NewCall(rtScHas, [nmOf(b), kk]), zero)
                    if (idxColon) { blankE = b.NewOr(blankE, isEmptyStr(b, one1)) }
                    // ${a[@]-D} tests whether the array has ANY element, and the ":" form
                    // additionally tests the JOINED value: `d=(""); echo "${d[@]-D}"` is
                    // empty while "${d[@]:-D}" is D. See listOpValue in
                    // languages/bash-interpreter.abnf, which is the same two tests.
                    var blankL = b.NewICmp(llvm.enum.IPredEQ, b.NewCall(rtScCount, nmOf(b)), zero)
                    if (idxColon) {
                        blankL = b.NewOr(blankL, isEmptyStr(b,
                            b.NewCall(rtScList, [nmOf(b), ifsFirstValue(b), one, zero])))
                    }
                    var de = emptyPtr(b)
                    if (idxWordT != null) {
                        var rw = (idxO == "-" || idxO == "+") ? dfltWordEmit(b, idxWordT) : evalWord(b, idxWordT)
                        b = rw.b
                        de = rw.v
                    }
                    var pickedE = b.NewSelect(blankE, de, one1)
                    var pickedL = b.NewSelect(blankL, de, lst)
                    if (idxO == "+") {
                        pickedE = b.NewSelect(blankE, emptyPtr(b), de)
                        // An unset or empty [@] list stays that empty list: "${a[@]+x}" is no word.
                        pickedL = b.NewSelect(blankL, b.NewSelect(star, emptyPtr(b), nilList(b)), de)
                    }
                    if (idxO == "=") { b.NewCall(isAssoc ? rtArrSet : rtArrIset, [nmOf(b), kk, pickedE]) }
                    if (idxO == "?") {
                        var qmsg = gepStr(b, idxColon ? "parameter null or not set" : "parameter not set")
                        if (idxWordT != null) { qmsg = b.NewSelect(isEmptyStr(b, de), qmsg, de) }
                        var qnm = b.NewCall(rtStrcat, [b.NewCall(rtStrcat, [gepStr(b, name + "["), rs.v]), gepStr(b, "]")])
                        // ONE check covers both arms: the subscript decides which emptiness counts.
                        var qbad = b.NewSelect(whole, blankL, blankE)
                        pickedE = b.NewCall(rtPcheck, [one1, b.NewZExt(qbad, i32), qnm, qmsg])
                        pickedL = lst
                    }
                    one1 = pickedE
                    lst = pickedL
                }
                var sel = b.NewSelect(whole, lst, one1)
                // Is the ELEMENT the plain-subscript arm reads actually set? ${a[9]@Q} is
                // empty in bash and ${a[9]@A} is `declare -a a`, both of which need this
                // and neither of which the value alone can answer.
                var elemSet = b.NewCall(rtScHas, [nmOf(b), rs.k])
                var assocI = llvm.constant.NewInt(i32, isAssoc ? 1 : 0)
                // ${a[@]@Q} transforms EVERY ELEMENT and stays a field list (`'pa' 'pb'`), via rt_mapf.
                // @A, @K and @k with a @ or * subscript describe the WHOLE variable instead (a=(pa pb)):
                //     ${a[@]@A} -> the three fields  declare  -a  a=([0]="pa" [1]="pb")
                //     ${a[@]@K} -> one field  0 "pa" 1 "pb"
                //     ${a[@]@k} -> the four fields  0 pa 1 pb
                // and @a repeats the attribute letters once per element (`a a`).
                if (xf != "" && op == "") {
                    var wholeV = null
                    // On $@ / $*, @A is rt_declpos, @K and @k quote each parameter as @Q
                    // does, and @a (rt_attrf) is once per parameter.
                    var posXf = (name == "@" || name == "*") && (xf == "K" || xf == "k") ? "Q" : xf
                    if (xf == "A" && (name == "@" || name == "*")) {
                        var starXp = uqStarEmit ? starArg(b, one) : starA
                        wholeV = b.NewCall(rtDeclPos, [ifsValue(b), ifsFirstValue(b), starXp])
                    } else if (posXf == "Q" && xf != "Q") {
                        var allQ = b.NewCall(rtScList, [nmOf(b), ifsFirstValue(b), zero, zero])
                        wholeV = b.NewCall(rtMapf, [allQ, llvm.constant.NewInt(i32, xfMapKind("Q")),
                                                    emptyPtr(b), emptyPtr(b), zero, ifsFirstValue(b), starA])
                    } else if (xf == "A") {
                        // Unquoted, [@] is the [*] string too, split like any other value.
                        var starXa = uqStarEmit ? starArg(b, one) : starA
                        wholeV = b.NewCall(rtDeclXa, [nmOf(b), attrLetters(b, nmOf(b)), one1, elemSet,
                                                      assocI, ifsValue(b), starXa])
                    } else if (xf == "K") {
                        wholeV = b.NewCall(rtKvq, [nmOf(b), assocI, one1, elemSet])
                    } else if (xf == "k") {
                        wholeV = b.NewCall(rtKvp, [nmOf(b), ifsFirstValue(b), starA,
                                                   one1, elemSet])
                    } else if (xf == "a") {
                        wholeV = b.NewCall(rtAttrf, [nmOf(b), attrLetters(b, nmOf(b)), ifsFirstValue(b), starA])
                    } else if (xfMapKind(xf) >= 0) {
                        var allX = b.NewCall(rtScList, [nmOf(b), ifsFirstValue(b), zero, zero])
                        wholeV = b.NewCall(rtMapf, [allX, llvm.constant.NewInt(i32, xfMapKind(xf)),
                                                    emptyPtr(b), emptyPtr(b),
                                                    llvm.constant.NewInt(i32, xfMapMode(xf)),
                                                    ifsFirstValue(b), starA])
                    }
                    if (wholeV != null) {
                        return {b: b, v: b.NewSelect(whole, wholeV, applyXf(b, one1, elemSet, nmOf(b)))}
                    }
                }
                // ${a[i]@Q} and friends: the transform applies to the ELEMENT, exactly as for a scalar.
                if (xf != "") { return {b: b, v: applyXf(b, sel, elemSet, nmOf(b))} }
                return {b: b, v: sel}
            }}
        }
        if (pe == "len") {
            return {c: undefined, fn: function(b) {
                // ${#v} counts CHARACTERS in bash (rt_strlen counts bytes).
                return {b: b, v: i2s(b, b.NewCall(rtCharLen, varString(b, name)))}
            }}
        }
        // r='arr[@]' (or '@') makes the bare ${!r} a field list, hence f.
        if (pe == "ind") {
            return {f: true, c: undefined, fn: function(b) {
                return {b: b, v: b.NewCall(rtGetInd, varString(b, name))}
            }}
        }
        // ${#v OP arg} is a parse-time-legal, run-time-illegal combination in bash:
        //     $ echo "${#x-default}"   ->  bash: ${#x-default}: bad substitution
        // The shell dies; here that is the abort flag, the same one set -u raises.
        if (lenp) {
            return {c: undefined, fn: function(b) {
                b.NewStore(one, gAbort)
                return {b: b, v: emptyPtr(b)}
            }}
        }
        // ${!ref OP arg}: the operator applies to the variable the indirection LANDED on, so
        // every leaf below reads and writes through valOf/setOf instead of the fixed slot.
        var indirect = indp
        function valOf(b) {
            if (indirect) { return b.NewCall(rtGetByName, varString(b, name)) }
            return varString(b, name)
        }
        function setOf(b, v) {
            if (indirect) { b.NewCall(rtSetByName, [varString(b, name), v]); return }
            storeVar(b, name, v)
        }
        // The @-transforms (see applyXf above). The value is read ONCE and rt_isset asks whether
        // it is the unset marker, so `set -u` fires exactly as for a plain read.
        if (xf != "") {
            return {c: undefined, fn: function(b) {
                var nmv = indirect ? varString(b, name) : gepStr(b, name)
                var v0 = valOf(b)
                return {b: b, v: applyXf(b, v0, b.NewCall(rtIsset, v0), nmv)}
            }}
        }
        if (pe == "substr") {
            var offT = ar32T(ariths[0])
            var lenT = (ariths.length > 1) ? ar32T(ariths[1]) : null
            return {c: undefined, fn: function(b) {
                var v = valOf(b)
                var ro = offT(b)
                b = ro.b
                // Offsets and lengths of ${v:off:len} are in CHARACTERS in bash, so the computation
                // runs in character units and rt_csubstr converts to byte positions.
                var len = b.NewCall(rtCharLen, v)
                // a negative offset counts from the end, and one past the start selects nothing
                var off = b.NewSelect(b.NewICmp(llvm.enum.IPredSLT, ro.v, zero), b.NewAdd(len, ro.v), ro.v)
                off = b.NewSelect(b.NewICmp(llvm.enum.IPredSLT, off, zero), len, off)
                if (lenT == null) {
                    return {b: b, v: b.NewCall(rtCSubstr, [v, off, llvm.constant.NewInt(i32, -1)])}
                }
                var rl = lenT(b)
                b = rl.b
                // a negative length is an offset from the end of the string, and one that ends
                // before the offset is "substring expression < 0"
                var n = b.NewSelect(b.NewICmp(llvm.enum.IPredSLT, rl.v, zero),
                                    b.NewSub(b.NewAdd(len, rl.v), off), rl.v)
                // (an offset outside the string selects nothing and is no error)
                var offIn = b.NewAnd(b.NewICmp(llvm.enum.IPredSGE, b.NewAdd(len, ro.v), zero),
                                     b.NewICmp(llvm.enum.IPredSLE, ro.v, len))
                b.NewCall(rtSubErr, [b.NewZExt(b.NewAnd(offIn, b.NewICmp(llvm.enum.IPredSLT, n, zero)), i32), rl.v])
                n = b.NewSelect(b.NewICmp(llvm.enum.IPredSLT, n, zero), zero, n)
                return {b: b, v: b.NewCall(rtCSubstr, [v, off, n])}
            }}
        }
        if (pe == "#" || pe == "##" || pe == "%" || pe == "%%") {
            var smode = 0
            if (pe == "##") { smode = 1 }
            if (pe == "%") { smode = 2 }
            if (pe == "%%") { smode = 3 }
            var patW = (words.length > 0) ? words[0] : null
            return {c: undefined, fn: function(b) {
                var v = valOf(b)
                if (patW == null) { return {b: b, v: v} }
                var rp = evalWord(b, patW)
                b = rp.b
                return {b: b, v: b.NewCall(rtStrip, [v, rp.v, llvm.constant.NewInt(i32, smode)])}
            }}
        }
        if (pe == "^" || pe == "^^" || pe == "," || pe == ",,") {
            var cmode = 0
            if (pe == "^^") { cmode = 1 }
            if (pe == ",") { cmode = 2 }
            if (pe == ",,") { cmode = 3 }
            // PeCaseForm's optional pattern (${s^^[bn]} on banana is BaNaNa) is rt_case's third
            // operand; "" is the absent case.
            var cpW = (words.length > 0) ? words[0] : null
            return {c: undefined, fn: function(b) {
                var cv = valOf(b)
                var cp = emptyPtr(b)
                if (cpW != null) { var cr = evalWord(b, cpW); b = cr.b; cp = cr.v }
                return {b: b, v: b.NewCall(rtCase, [cv, llvm.constant.NewInt(i32, cmode), cp])}
            }}
        }
        if (pe == "/" || pe == "//") {
            var rmode = (pe == "//") ? 1 : 0
            if (anchor == "#") { rmode = 2 }
            if (anchor == "%") { rmode = 3 }
            var pW = (words.length > 0) ? words[0] : null
            var rW = (words.length > 1) ? words[1] : null
            return {c: undefined, fn: function(b) {
                var v = valOf(b)
                if (pW == null) { return {b: b, v: v} }
                var rp2 = evalWord(b, pW)
                b = rp2.b
                var rep = emptyPtr(b)
                if (rW != null) { var rr = evalWord(b, rW); b = rr.b; rep = rr.v }
                return {b: b, v: b.NewCall(rtReplace, [v, rp2.v, rep, llvm.constant.NewInt(i32, rmode)])}
            }}
        }
        if (op == "" && name == "*" && !indirect) { return {c: undefined, f: true, fn: function(b) { return {b: b, v: starParams(b)} }} }
        if (op == "") { return {c: undefined, f: (name == "@"), fn: function(b) { return {b: b, v: valOf(b)} }} }
        var colon = (op.charAt(0) == ":")
        var o = colon ? op.slice(1) : op
        return {c: undefined, f: (o == "-" || o == "+"), fn: function(b) {
            var v = valOf(b)
            // ":" forms treat "" like unset; the bare forms only test set-ness, which the
            // unset marker (a distinct empty string) records.
            var blank = colon ? isEmptyStr(b, v)
                              : b.NewICmp(llvm.enum.IPredEQ, v, unsetPtr(b))
            var d = emptyPtr(b)
            if (wordT != null) {
                var r = (o == "-" || o == "+") ? dfltWordEmit(b, wordT) : evalWord(b, wordT)
                b = r.b
                d = r.v
            }
            if (o == "+") { return {b: b, v: b.NewSelect(blank, emptyPtr(b), d)} }
            if (o == "?") {
                var dmsg = gepStr(b, colon ? "parameter null or not set" : "parameter not set")
                var msg = (wordT != null) ? b.NewSelect(isEmptyStr(b, d), dmsg, d) : dmsg
                return {b: b, v: b.NewCall(rtPcheck, [v, b.NewZExt(blank, i32), gepStr(b, name), msg])}
            }
            var picked = b.NewSelect(blank, d, v)
            if (o == "=") { setOf(b, picked) }
            return {b: b, v: picked}
