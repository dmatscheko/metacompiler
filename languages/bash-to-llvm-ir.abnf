        var key = "$" + name + "#" + k
        if (!hasOwn(defFuncs, key)) {
            defFuncs[key] = m.NewFunc("bashfn_" + name + ((k == 1) ? "" : "_" + fnCount), i32)
            fnCount = fnCount + 1
