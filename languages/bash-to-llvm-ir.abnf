        if (c.peek(i) !== 60 || c.peek(i + 1) !== 60) { return no }
        i = i + 2
        if (c.peek(i) === 60) { return no }           // <<< is a here-STRING
        var dashed = false
        if (c.peek(i) === 45) { dashed = true; i = i + 1 }
        while (c.peek(i) === 32 || c.peek(i) === 9) { i = i + 1 }
        var quote = 0
        var q = c.peek(i)
        if (q === 39 || q === 34) { quote = q; i = i + 1 }
