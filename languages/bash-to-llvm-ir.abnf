            }
            for (k = 0; k < asgs.length; k++) {
                if (prefixBad(b, asgs[k])) { vals.push(null); continue }
                // A builtin's binding through a nameref is made when it runs (rt_prefix_ref).
                var pRef = !isFn && attrOn(refVars, asgs[k].aname)
                // A readonly name keeps its value, unexpanded; the command still runs.
                if (!pRef && roRefused(b, asgs[k].aname, "")) { vals.push(loadVar(b, asgs[k].aname)); continue }
                // So does one readonly only when this runs (roRtTest).
                var prr = pRef ? null : roRtTest(b, asgs[k].aname)
                var pOld = null
                if (prr != null) {
                    if (hasOwn(roPs, "$" + asgs[k].aname)) { prr.ro.NewStore(one, roPs["$" + asgs[k].aname]) }
                    pOld = loadVar(prr.ro, asgs[k].aname)
                    b = prr.ok
                }
                var r = prefixVal(b, asgs[k])
                b = r.b
                var v = r.v
                if (pRef) {
                    var pnv = gepStr(b, asgs[k].aname)
                    b.NewCall(rtPrefixRef, [pnv, v, refAttrs(b, pnv, true)])
                    vals.push(v)
                    continue
                }
                b.NewCall(isFn ? rtPushTmp : rtPushLocal, llvm.constant.NewInt(i32, getVarId(asgs[k].aname)))
                if (isFn) { b.NewCall(rtArrClear, gepStr(b, asgs[k].aname)) }
                b.NewCall(rtXmark, [gepStr(b, asgs[k].aname), one])
                // No attrCase: the binding takes no attributes but the export. Twin of applyPrefix. Nothing
                // pins it: it is restored before the statement ends, and every release
                // during the command goes to a mark taken after it.
                storeVarRaw(b, asgs[k].aname, v)
                if (prr != null) {
                    var pjB = curF.NewBlock("")
                    b.NewBr(pjB)
                    prr.ro.NewBr(pjB)
                    v = pjB.NewPhi([llvm.ir.NewIncoming(v, b), llvm.ir.NewIncoming(pOld, prr.ro)])
                    b = pjB
                }
                vals.push(v)
            }
            if (!asgConst) { b = emitAbortCheck(b) }
            if (redirs0.length > 0) {
                redirs = []
                for (k = 0; k < redirs0.length; k++) {
                    var rd = redirs0[k]
                    if (rd.target != null && rd.target.c == undefined) { rd = {rd: rd.rd, iofd: rd.iofd, target: prefixOuter(rd.target, asgs, olds)} }
                    redirs.push(rd)
