    // There is no real filesystem behind a compiled run either, so the file predicates go
    // through rt_fskind, a model of the standard paths (see bash-interpreter.abnf).
    var rtFskind = rtDecl("rt_fskind", false, [1])
    var rtTestFcmp = rtDecl("rt_test_fcmp", false, [1, 1, 0])

    // "name" or "name[key]"
    // A subscript text that is already a canonical index needs no evaluation.
    function isIndexLit(t) {
        if (t.length == 0 || t.length > 15 || (t.charAt(0) == "0" && t.length > 1)) { return false }
        var i
        for (i = 0; i < t.length; i++) { var cc = t.charCodeAt(i); if (cc < 48 || cc > 57) { return false } }
        return true
    }
    // The kind of subscript word w names - 0 a key, 1 "@" (fields), 2 "*" (joined) - when it
    // is a literal, else -1: subKind then asks at run time.
    // The subscript of ${NAME[SUB]} as written, when it is @ or * (the whole array), else "".
    // Only a WRITTEN @ or * names the whole array; an expanded one is an element's key. Twin
    // of idxAllOf in bash-interpreter.abnf.
    function idxAllOf(t) {
        var s0 = t.slice(t.indexOf("[") + 1, t.length - 1)
        return (s0 == "@" || s0 == "*") ? s0 : ""
    }
    function idxAqOf(it) { return (it != null && it.idxAq != undefined) ? it.idxAq : null }
    // The subscript kind a PeIdxRef item fixes (subKindC's numbers), or the word's own.
    function idxKind(it, w) {
        if (it == null || it.idxAll == undefined) { return subKindC(w) }
        return (it.idxAll == "@") ? 1 : ((it.idxAll == "*") ? 2 : 0)
    }
    function subKindC(w) { return (w.c == undefined) ? -1 : ((w.c == "@") ? 1 : ((w.c == "*") ? 2 : 0)) }
    function subKind(b, kc, sub) {
        if (kc >= 0) { return llvm.constant.NewInt(i32, kc) }
        var isAt = b.NewICmp(llvm.enum.IPredNE, b.NewCall(rtStreq, [sub, gepStr(b, "@")]), zero)
        var isStar = b.NewICmp(llvm.enum.IPredNE, b.NewCall(rtStreq, [sub, gepStr(b, "*")]), zero)
        return b.NewSelect(isAt, one, b.NewSelect(isStar, llvm.constant.NewInt(i32, 2), zero))
    }
    // A subscript word and the key it names, {b, v: text, k: key}: an associative array's key
    // is the text, an indexed array's the value of the text as an arithmetic expression
    // (rt_arr_key, negative from the end). Evaluated ONCE per use, so `${a[i++]}` steps i once.
    // A literal subscript that is a canonical index needs no evaluation, and one that is a
    // plain variable name reads that variable's slot directly.
    // nmv, when not null, is the array's name as a run-time value (an indirection's target).
    // elem: the subscript names an element even when it expands to @ or * (rt_arr_key1).
    // aq: SUB's arithmetic text when a part of it is quoted (SubIdx). ar: the subscript is
    // met by the arithmetic evaluator, whose subscript errors abandon the line
    // (rt_arr_keyar, ar_subeval).
    function subKeyOf(b, name, w, nmv, elem, aq, ar) {
        if (aq != undefined) {
            var ra = subTextOf(b, name, w, aq, nmv)
            return {b: ra.b, v: ra.v, k: ra.b.NewCall((ar == true) ? rtArrKeyAr : ((elem == true) ? rtArrKey1 : rtArrKey), [(nmv != null) ? nmv : gepStr(ra.b, name), ra.v])}
        }
        var r = evalWord(b, w)
        var key = r.v
        var keyF = (ar == true) ? rtArrKeyAr : ((elem == true) ? rtArrKey1 : rtArrKey)
        if (nmv != null) { key = r.b.NewCall(keyF, [nmv, r.v]) }
        else if (w.c != undefined && isIndexLit(w.c)) { key = gepStr(r.b, w.c) }
        else if (w.c != undefined && isIdentText(w.c)) {
            var bb = r.b
            var isA = bb.NewICmp(llvm.enum.IPredNE, bb.NewCall(rtIsAssoc, gepStr(bb, name)), zero)
            var ib = curF.NewBlock(""), jb = curF.NewBlock("")
            bb.NewCondBr(isA, jb, ib)
            var ik = ib.NewCall(rtArrIkey, [gepStr(ib, name), ib.NewCall((ar == true) ? rtSubEval : rtArith, varString(ib, w.c))])
            ib.NewBr(jb)
            key = jb.NewPhi([llvm.ir.NewIncoming(r.v, bb), llvm.ir.NewIncoming(ik, ib)])
            return {b: jb, v: r.v, k: key}
        }
        else { key = r.b.NewCall(keyF, [gepStr(r.b, name), r.v]) }
        return {b: r.b, v: r.v, k: key}
    }
    function isIdentText(t) {
        if (t.length == 0) { return false }
        var i
        for (i = 0; i < t.length; i++) {
            var cc = t.charCodeAt(i)
            var al = (cc >= 97 && cc <= 122) || (cc >= 65 && cc <= 90) || cc == 95
            if (!al && !(i > 0 && cc >= 48 && cc <= 57)) { return false }
        }
        return true
    }
    // The same for the literal subscript text of test -v / [[ -v ]] (cond) a[k], evaluated
    // as rt_vset does.
    function litKeyOf(b, name, t, cond) {
        if (bashSubNeedsX(t)) {
            var x = cond ? b.NewCall(rtSubx, gepStr(b, t)) : b.NewCall(rtSubxa, [gepStr(b, name), gepStr(b, t)])
            return b.NewCall(rtArrKeyAr, [gepStr(b, name), x])
        }
        if (isIndexLit(t)) { return gepStr(b, t) }
        return b.NewCall(rtArrKeyAr, [gepStr(b, name), gepStr(b, t)])
    }
    function splitSubscript(s0) {
        var i
        for (i = 0; i < s0.length; i++) {
            if (s0.charAt(i) == "[" && s0.charAt(s0.length - 1) == "]") {
                return {name: s0.slice(0, i), key: s0.slice(i + 1, s0.length - 1)}
            }
        }
        return {name: s0, key: null}
    }

    function isTestUnary(t) {
        if (t == "-z" || t == "-n" || t == "-v") { return true }
        if (t == "-e" || t == "-f" || t == "-d" || t == "-s" || t == "-r" || t == "-w") { return true }
        if (t == "-x" || t == "-h" || t == "-L" || t == "-b" || t == "-c" || t == "-p") { return true }
        if (t == "-S" || t == "-t" || t == "-g" || t == "-u" || t == "-k" || t == "-O") { return true }
        if (t == "-a" || t == "-G" || t == "-N" || t == "-o" || t == "-R") { return true }
        return false
    }
    function isTestBinary(t) {
        if (t == "=" || t == "==" || t == "!=" || t == "<" || t == ">") { return true }
        if (t == "-eq" || t == "-ne" || t == "-lt" || t == "-le" || t == "-gt" || t == "-ge") { return true }
        if (t == "-nt" || t == "-ot" || t == "-ef") { return true }
        return false
    }
    function isEmptyStr(b, v) { return b.NewICmp(llvm.enum.IPredEQ, b.NewCall(rtStrlen, v), zero) }
    function isNonEmptyStr(b, v) { return b.NewICmp(llvm.enum.IPredNE, b.NewCall(rtStrlen, v), zero) }
    function boolStatus(b, i1) { return b.NewSelect(i1, zero, one) }

    // cond: the operand of [[ -v ]], whose SUB is expanded as a word (rt_vset).
    function testUnaryIR(b, op, arg, cond) {
        if (op == "-z") { return boolStatus(b, isEmptyStr(b, arg.v)) }
        if (op == "-n") { return boolStatus(b, isNonEmptyStr(b, arg.v)) }
        if (op == "-v") {
            var sv = (arg.c == undefined) ? null : splitSubscript(arg.c)
            // A computed operand, a nameref, and NAME[@] / NAME[*] (any element, unless NAME
            // is associative) are rt_vset's; the rules are at testUnary in the interpreter.
            if (sv == null || attrOn(refVars, sv.name) || sv.key == "@" || sv.key == "*") {
                return boolStatus(b, b.NewICmp(llvm.enum.IPredNE, b.NewCall(rtVset, [arg.v, cond ? one : zero]), zero))
            }
            if (sv.key != null) {
                return boolStatus(b, b.NewICmp(llvm.enum.IPredNE,
                    b.NewCall(rtArrHas, [gepStr(b, sv.name), litKeyOf(b, sv.name, sv.key, cond)]), zero))
            }
            var setScalar = b.NewICmp(llvm.enum.IPredNE, loadVar(b, arg.c), unsetPtr(b))
            var setElem0 = b.NewICmp(llvm.enum.IPredNE, b.NewCall(rtArrHas, [gepStr(b, arg.c), gepStr(b, "0")]), zero)
            var isArray = b.NewICmp(llvm.enum.IPredNE, b.NewCall(rtArrAny, gepStr(b, arg.c)), zero)
            return boolStatus(b, b.NewSelect(isArray, setElem0, setScalar))
        }
        if (op == "-o") { return boolStatus(b, b.NewICmp(llvm.enum.IPredNE, b.NewCall(rtTestOpt, arg.v), zero)) }
        if (op == "-R") { return boolStatus(b, b.NewICmp(llvm.enum.IPredNE, b.NewCall(rtTestRef, arg.v), zero)) }
        var k = b.NewCall(rtFskind, arg.v)
        // The model and the predicate table are documented at fsKind in
        // languages/bash-interpreter.abnf, including why a real stat() was declined.
        var two = llvm.constant.NewInt(i32, 2)
        if (op == "-d") { return boolStatus(b, b.NewICmp(llvm.enum.IPredEQ, k, two)) }
        if (op == "-e" || op == "-a" || op == "-r" || op == "-w") { return boolStatus(b, b.NewICmp(llvm.enum.IPredNE, k, zero)) }
        if (op == "-f") { return boolStatus(b, b.NewICmp(llvm.enum.IPredEQ, k, one)) }
        if (op == "-s") { return boolStatus(b, b.NewOr(b.NewICmp(llvm.enum.IPredEQ, k, one),
                                                      b.NewICmp(llvm.enum.IPredEQ, k, two))) }
        if (op == "-x") { return boolStatus(b, b.NewICmp(llvm.enum.IPredEQ, k, two)) }
        if (op == "-c") { return boolStatus(b, b.NewICmp(llvm.enum.IPredEQ, k, llvm.constant.NewInt(i32, 3))) }
        return one
    }
    // A numeric operand of test: read at compile time when the word is a literal decimal
    // number that a double holds exactly, else rt_test_int's (tc.who names the command in
    // its diagnostic, tc.rt records that emitTest must look at test_err).
    var tc = {who: "test", rt: false, stop: false, a: [], n: 0, i: 0, dyn: []}
    function testInt(b, w) {
        var t = w.c
        var i = (t != undefined && (t.charAt(0) == "-" || t.charAt(0) == "+")) ? 1 : 0
        var n = 0
        var j
        if (t != undefined && t.length > i && t.length - i <= 15) {
            for (j = i; j < t.length && n >= 0; j++) {
                var cc = t.charCodeAt(j)
                n = (cc < 48 || cc > 57) ? -1 : n * 10 + (cc - 48)
            }
            if (n >= 0) { return llvm.constant.NewInt(i64, (t.charAt(0) == "-") ? -n : n) }
        }
        tc.rt = true
        return b.NewCall(rtTestInt, [w.v, gepStr(b, tc.who)])
    }
    function testBinaryIR(b, l, op, r) {
        if (op == "=" || op == "==") { return boolStatus(b, b.NewICmp(llvm.enum.IPredNE, b.NewCall(rtStreq, [l.v, r.v]), zero)) }
        if (op == "!=") { return boolStatus(b, b.NewICmp(llvm.enum.IPredEQ, b.NewCall(rtStreq, [l.v, r.v]), zero)) }
        if (op == "<") { return boolStatus(b, b.NewICmp(llvm.enum.IPredSLT, b.NewCall(rtStrcmp, [l.v, r.v]), zero)) }
        if (op == ">") { return boolStatus(b, b.NewICmp(llvm.enum.IPredSGT, b.NewCall(rtStrcmp, [l.v, r.v]), zero)) }
        if (op == "-nt" || op == "-ot" || op == "-ef") {
            var fop = llvm.constant.NewInt(i32, op.charCodeAt(1))
            return boolStatus(b, b.NewICmp(llvm.enum.IPredNE, b.NewCall(rtTestFcmp, [l.v, r.v, fop]), zero))
        }
        var il = testInt(b, l), ir = testInt(b, r)
        if (op == "-eq") { return boolStatus(b, b.NewICmp(llvm.enum.IPredEQ, il, ir)) }
        if (op == "-ne") { return boolStatus(b, b.NewICmp(llvm.enum.IPredNE, il, ir)) }
        if (op == "-lt") { return boolStatus(b, b.NewICmp(llvm.enum.IPredSLT, il, ir)) }
        if (op == "-le") { return boolStatus(b, b.NewICmp(llvm.enum.IPredSLE, il, ir)) }
        if (op == "-gt") { return boolStatus(b, b.NewICmp(llvm.enum.IPredSGT, il, ir)) }
        if (op == "-ge") { return boolStatus(b, b.NewICmp(llvm.enum.IPredSGE, il, ir)) }
        fail("unsupported binary test operator (must be a literal): " + op)
        return one
    }

    // bash's test.c, parsed at compile time over the argument words tc.a from tc.i: the rules
    // and the order of evaluation are at tstTerm in bash-interpreter.abnf. A word whose text
    // is known only at run time ("\x00val") is taken for an operand, and tc.dyn lists the ones
    // the parse looked at: emitTest checks at run time that they are no operator. Values are
    // i32 statuses (0 is true). A syntax error is emitted as rt_test_syn and ends the emission
    // (tc.stop).
    function tcTok(k) {
        if (k >= tc.n) { return "\x00end" }
        if (tc.a[k].c == undefined) {
            if (tc.dyn.indexOf(k) < 0) { tc.dyn.push(k) }
            return "\x00val"
        }
        return tc.a[k].c
    }
    function tcOne(b, k) { return boolStatus(b, isNonEmptyStr(b, tc.a[k].v)) }
    function tcSyn(b, pre, k, post) {
        if (!tc.stop) {
            tc.stop = true
            tc.rt = true
            b.NewCall(rtTestSyn, [gepStr(b, tc.who), gepStr(b, pre), (k < 0) ? gepStr(b, "") : tc.a[k].v, gepStr(b, post)])
        }
        return one
    }
    function tcAdvance(b, chk) {
        tc.i = tc.i + 1
        if (chk && tc.i >= tc.n) { tcSyn(b, "argument expected", -1, "") }
    }
    function tcAndOr(t) { return t == "-a" || t == "-o" }
    function tcBinary(b) {
        var k = tc.i
        tc.i = k + 3
        return testBinaryIR(b, tc.a[k], tcTok(k + 1), tc.a[k + 2])
    }
    function tcUnary(b) {
        var k = tc.i
        if (tcTok(k) == "-t") {
            if (tc.n >= 4 && tcAndOr(tcTok(k + 1))) { tc.i = k + 1; return one }
            testInt(b, tc.a[k + 1])
            tc.i = k + 2
            return one
        }
        tc.i = k + 2
        return testUnaryIR(b, tcTok(k), tc.a[k + 1], false)
    }
    function tcTwo(b) {
        var k = tc.i
        if (tcTok(k) == "!") { tc.i = k + 2; return b.NewXor(tcOne(b, k + 1), one) }
        if (isTestUnary(tcTok(k))) { return tcUnary(b) }
        return tcSyn(b, "", k, ": unary operator expected")
    }
    function tcThree(b) {
        var k = tc.i
        var w = tcTok(k + 1)
        if (isTestBinary(w)) { return tcBinary(b) }
        if (tcAndOr(w)) {
            tc.i = k + 3
            var l = tcOne(b, k), r = tcOne(b, k + 2)
            return (w == "-a") ? b.NewOr(l, r) : b.NewAnd(l, r)
        }
        if (tcTok(k) == "!") { tcAdvance(b, true); return b.NewXor(tcTwo(b), one) }
        if (tcTok(k) == "(" && tcTok(k + 2) == ")") { tc.i = k + 3; return tcOne(b, k + 1) }
        return tcSyn(b, "", k + 1, ": binary operator expected")
    }
    function tcPosix(b, nargs) {
        var k = tc.i
        if (nargs == 1) { tc.i = k + 1; return tcOne(b, 0) }
        if (nargs == 2) { return tcTwo(b) }
        if (nargs == 3) { return tcThree(b) }
        if (nargs == 4 && tcTok(k) == "!") { tcAdvance(b, true); return b.NewXor(tcThree(b), one) }
        if (nargs == 4 && tcTok(k) == "(" && tcTok(k + 3) == ")") {
            tcAdvance(b, true)
            var v = tcTwo(b)
            tcAdvance(b, false)
            return v
        }
        return tcExpr(b)
    }
    function tcExpr(b) { return (tc.i >= tc.n) ? tcSyn(b, "argument expected", -1, "") : tcOr(b) }
    function tcOr(b) {
        var v = tcAnd(b)
        if (tcTok(tc.i) == "-o") { tc.i = tc.i + 1; return b.NewAnd(v, tcOr(b)) }
        return v
    }
    function tcAnd(b) {
        var v = tcTerm(b)
        if (tcTok(tc.i) == "-a") { tc.i = tc.i + 1; return b.NewOr(v, tcAnd(b)) }
        return v
    }
    function tcTerm(b) {
        if (tc.stop) { return one }
        if (tc.i >= tc.n) { return tcSyn(b, "argument expected", -1, "") }
        var t = tcTok(tc.i)
        if (t == "!") {
            var neg = false
            while (tcTok(tc.i) == "!") { tcAdvance(b, true); neg = !neg }
            var r = tcTerm(b)
            return neg ? b.NewXor(r, one) : r
        }
        if (t == "(") {
            tcAdvance(b, true)
            if (tc.stop) { return one }
            var nargs = 1, depth = 1
            while (tc.i + nargs < tc.n) {
                var u = tcTok(tc.i + nargs)
                if (u == ")") { depth = depth - 1 } else if (u == "(") { depth = depth + 1 }
                if (depth == 0) { break }
                nargs = nargs + 1
            }
            var v = (tc.i + nargs < tc.n && nargs <= 4) ? tcPosix(b, nargs) : tcExpr(b)
            if (tc.i >= tc.n) { tcSyn(b, "`)' expected", -1, "") }
            else if (tcTok(tc.i) != ")") { tcSyn(b, "`)' expected, found ", tc.i, "") }
            tc.i = tc.i + 1
            return v
        }
        if (tc.i + 3 <= tc.n && isTestBinary(tcTok(tc.i + 1))) { return tcBinary(b) }
        if (tc.i + 2 <= tc.n && isTestUnary(t)) { return tcUnary(b) }
        tc.i = tc.i + 1
        return tcOne(b, tc.i - 1)
    }

    // The words are parsed at compile time (tc*), and parsed again when the command runs
    // (rt_test) if a field-list word does not give exactly one field, or a computed word the
    // compile-time parse took for an operand is an operator.
    function emitTest(b, cmd, args) {
        var a = args
        tc.who = cmd
        if (cmd == "[") {
            if (a.length == 0 || a[a.length - 1].c != "]") {
                if (a.length > 0 && a[a.length - 1].c == undefined) { fail("[ whose last word is computed") }
                var bbox = {b: b}
                evalArgs(bbox, a)
                b = emitAbortCheck(bbox.b)
                emitDiag(b, gepStr(b, "[: missing `]'\n"))
                storeStatusI(b, 2)
                return b
            }
            a = a.slice(0, a.length - 1)
        }
        if (a.length == 0) { storeStatusI(b, 1); return b }
        var vals = [], raw = []
        var multi = false
        var i
        for (i = 0; i < a.length; i++) {
            var r = wordFields(b, a[i])
            b = r.b
            raw.push(r.v)
            var v = r.v
            if (a[i].f == true) { v = b.NewCall(rtTestOne, r.v); multi = true }
            vals.push({v: v, c: a[i].c})
        }
        tc.a = vals
        tc.n = vals.length
        tc.i = 0
        tc.rt = false
        tc.stop = false
        tc.dyn = []
        var fast = curF.NewBlock("")
        var res
        if (vals.length == 1) { res = boolStatus(fast, isNonEmptyStr(fast, vals[0].v)) }
        else {
            res = tcPosix(fast, vals.length)
            if (tc.i < tc.n && !tc.stop) {
                tc.rt = true
                fast.NewCall(rtTestExtra, [gepStr(fast, tc.who), vals[tc.i].v])
            }
        }
        // An operand that is no integer, or a syntax error, makes the status 2.
        if (tc.rt) {
            res = fast.NewSelect(fast.NewICmp(llvm.enum.IPredNE, fast.NewLoad(i32, gTestErr), zero), llvm.constant.NewInt(i32, 2), res)
            fast.NewStore(zero, gTestErr)
        }
        storeStatus(fast, res)
        var again = multi ? b.NewICmp(llvm.enum.IPredNE, b.NewLoad(i32, gTestMulti), zero) : null
        for (i = 0; i < tc.dyn.length; i++) {
            var isOp = b.NewICmp(llvm.enum.IPredNE, b.NewCall(rtTestWord, vals[tc.dyn[i]].v), zero)
            again = (again == null) ? isOp : b.NewOr(again, isOp)
        }
        if (again == null) {
            b.NewBr(fast)
            b = fast
        } else {
            var slow = curF.NewBlock(""), done = curF.NewBlock("")
            b.NewCondBr(again, slow, fast)
            var acc = nilList(slow)
            for (i = 0; i < raw.length; i++) { acc = slow.NewCall(rtCatFields, [acc, raw[i]]) }
            storeStatus(slow, slow.NewCall(rtTest, [acc, gepStr(slow, tc.who)]))
            slow.NewBr(done)
            fast.NewBr(done)
            b = done
        }
        // An arithmetic error in a -v subscript abandons the line. Twin of the test arm of
        // runCommand in bash-interpreter.abnf.
        return (vals.length == 1 && again == null) ? b : emitAbortCheck(b)
    }

    // ---- pipelines, subshells, groups, (( )), [[ ]], redirections ----

    // items = [{bang}?, (stageThunk {cpd}?)...] : with two stages or more every stage runs in
    // a subshell (bash without lastpipe). Twin of makePipeline in bash-interpreter.abnf.
    function makePipeline(items) {
        var bang = false
        var stages = []
        var cpds = []
        var i
        for (i = 0; i < items.length; i++) {
            var it = items[i]
            if (typeof it == "function") { stages.push(it); cpds.push(false) }
            else if (it.cpd != undefined) { cpds[cpds.length - 1] = true }
            else { bang = true }
        }
        if (!bang && stages.length == 1) { return stages[0] }
        if (stages.length > 1) {
            for (i = 0; i < stages.length; i++) { stages[i] = subshellOf(stages[i], !cpds[i]) }
        }
        return function(b) {
            var ff = slotOf(i32)
            b.NewStore(zero, ff)
            var psName = gepStr(b, "PIPESTATUS")
            b.NewCall(rtArrClear, psName)
            // a pipeline rebinds standard input for its stages only
            var savedIn = slotOf(i8ptr), savedInPos = slotOf(i32)
            b.NewStore(b.NewLoad(i8ptr, gStdin), savedIn)
            b.NewStore(b.NewLoad(i32, gStdinPos), savedInPos)
            var k
            for (k = 0; k < stages.length; k++) {
                var isLast = (k == stages.length - 1)
                if (!isLast) { b.NewCall(rtCapBegin, zero) }
                b = stages[k](b)
                // The text a stage hands on lives until the pipeline ends: every release
                // the next stage makes goes to a mark taken after it.
                if (!isLast) {
                    b.NewStore(b.NewCall(rtCapEnd, zero), gStdin)
                    b.NewStore(zero, gStdinPos)
                }
                var stv = b.NewLoad(i32, gStatus)
                b.NewCall(rtPstat, [gepStr(b, numToStr(k)), stv])
                var fail0 = b.NewICmp(llvm.enum.IPredEQ, b.NewLoad(i32, ff), zero)
                var bad = b.NewAnd(fail0, b.NewICmp(llvm.enum.IPredNE, stv, zero))
                b.NewStore(b.NewSelect(bad, stv, b.NewLoad(i32, ff)), ff)
            }
            b.NewStore(b.NewLoad(i8ptr, savedIn), gStdin)
            b.NewStore(b.NewLoad(i32, savedInPos), gStdinPos)
            // set -o pipefail: the pipeline reports the first failing stage.
            var st0 = b.NewLoad(i32, gStatus)
            var usePf = b.NewAnd(b.NewICmp(llvm.enum.IPredNE, b.NewLoad(i32, gOptPf), zero),
                                 b.NewICmp(llvm.enum.IPredEQ, st0, zero))
            storeStatus(b, b.NewSelect(usePf, b.NewLoad(i32, ff), st0))
            if (bang) {
                storeStatus(b, b.NewSelect(b.NewICmp(llvm.enum.IPredEQ, b.NewLoad(i32, gStatus), zero), one, zero))
            }
            // a ! pipeline is exempt from set -e; any other answers it by its status
            eeDone = bang
            asgKept = false
            return b
        }
    }

    // ( LIST ) : the variable array is snapshotted and restored, and an `exit` inside branches
    // to the subshell's own end block instead of the enclosing function's. So does a
    // `return`. It starts outside every loop, except a SIMPLE command run as a pipeline stage
    // (keepLoops): there every loop level of `break` / `continue` ends the subshell, with the
    // signal's status. Twin of subshellOf in bash-interpreter.abnf.
    function makeSubshell(bodyT) { return subshellOf(bodyT, false) }
    // The end of a ( ) or $( ): its EXIT traps run, with $? the subshell's status and an
    // `exit` in one ending the subshell with that status; then the variables and options come
    // back and $? is the subshell's status.
    // cs: a command substitution, which an abandoned line ends with status 1 whatever the
    // line's own (bash 5.3: a refused ${NAME=WORD} store gives 2 in ( ) and 1 in $( )).
    function subshellEnd(subEnd, traps, optSave, cs) {
        var b = subEnd
        if (cs) {
            var soft = b.NewICmp(llvm.enum.IPredEQ, b.NewLoad(i32, gExited), llvm.constant.NewInt(i32, 2))
            b.NewStore(b.NewSelect(soft, one, b.NewLoad(i32, gExitCode)), gExitCode)
        }
        if (traps.length > 0) {
            var ex0 = b.NewICmp(llvm.enum.IPredNE, b.NewLoad(i32, gExited), zero)
            storeStatus(b, b.NewSelect(ex0, b.NewLoad(i32, gExitCode), b.NewLoad(i32, gStatus)))
            b.NewStore(zero, gExited)
            var tEnd = curF.NewBlock("")
            var savedExit = curExit, savedExitRd = curExitRd
            curExit = tEnd
            curExitRd = redirStack.length
            b = emitTraps(b, traps)
            curExit = savedExit
            curExitRd = savedExitRd
            b.NewBr(tEnd)
            b = tEnd
        }
        var wasEx = b.NewICmp(llvm.enum.IPredNE, b.NewLoad(i32, gExited), zero)
        var st = b.NewSelect(wasEx, b.NewLoad(i32, gExitCode), b.NewLoad(i32, gStatus))
        b.NewStore(zero, gExited)
        b.NewCall(rtSsRestore, zero)
        restoreOpts(b, optSave)
        b.NewStore(st, gStatus)
        return b
    }
    // The loop frames of a subshell that sees the loops around it: each level branches to the
    // subshell's end, and the signal's status lands in $? (its loop status slot).
    function subLoops(outer, subEnd) {
        var out = []
        var k
        for (k = 0; k < outer.length; k++) { out.push({brk: subEnd, cont: subEnd, lst: gStatus, rd: curExitRd}) }
        return out
    }
    function subshellOf(bodyT, keepLoops) {
        return function(b) {
            b.NewCall(rtSsSave, zero)
            var optSave = saveOpts(b)
            var savedExit = curExit, savedExitRd = curExitRd
            var savedTraps = trapList
            trapList = []
            var subEnd = curF.NewBlock("")
            curExit = subEnd
            curExitRd = redirStack.length
            var savedLoops = loopStack, savedRetSub = retInSub
            loopStack = keepLoops ? subLoops(savedLoops, subEnd) : []
            retInSub = true
            var undoBase = attrUndo.length
            subDepth = subDepth + 1
            subEnter()
            var ft = fnTouchBegin(b)
            var eb = bodyT(ft.body)
            subDepth = subDepth - 1
            subIds.pop()
            attrUnwind(undoBase)
            eb.NewBr(subEnd)
            loopStack = savedLoops
            retInSub = savedRetSub
            curExit = savedExit
            curExitRd = savedExitRd
            var myTraps = trapList
            trapList = savedTraps
            subEnd = subshellEnd(subEnd, myTraps, optSave, false)
            subEnd = fnTouchEnd(ft, subEnd)
            eeDone = false
            asgKept = false
            return subEnd
        }
    }
    function makeGroup(bodyT) { return bodyT }

    // ( LIST ) and { LIST; } carry their own [ RedirList ], so they take takeAll() +
    // mkRedirected exactly like CompoundRedir (`{ echo A; } >&2` sends A to fd 2).
    function withRedirs(bodyT, items) {
        var wrapped = [bodyT]
        var i
        for (i = 1; i < items.length; i++) { wrapped.push(items[i]) }
        return mkRedirected(wrapped)
    }
    function makeSubshellR(items) { return withRedirs(makeSubshell(items[0]), items) }
    function makeGroupR(items) { return withRedirs(makeGroup(items[0]), items) }

    function makeArithCmd(exprT0) {
        var exprT = arIn("((: ", exprT0)
        return function(b) {
            var r = exprT(b)
            b = r.b
            var st = b.NewSelect(b.NewICmp(llvm.enum.IPredNE, r.v, zero64), zero, one)
            storeStatus(b, b.NewSelect(takeArithErr(b), one, st))
            return emitAbortCheck(b)
        }
    }
    // let EXPR ... : status from the LAST expression; the first error stops the command. The
    // arguments are all expanded before any is evaluated (x=1; `let x=5 y=$x` sets y=1). A word
    // argument ({letws}) becomes a field list that rt_letfields evaluates field by field; when
    // every argument is a word they are one list, whose emptiness is "expression expected".
    // Twin of makeLetCmd in bash-interpreter.abnf.
    function makeLetCmd(items) {
        var args = []
        var redirs = []
        var words = []
        var nstatic = 0
        var i
        for (i = 0; i < items.length; i++) {
            var it = items[i]
            if (typeof it == "function") { args.push(it); nstatic = nstatic + 1 }
            else if (it.letws != undefined) {
                args.push(it)
                var j
                for (j = 0; j < it.letws.length; j++) { words.push(it.letws[j]) }
            }
            else { redirs.push(it) }
        }
        if (nstatic == 0) { args = [{letws: words}] }
        var need = (nstatic == 0) ? one : zero
        var core = function(b) {
            var lists = []
            var k
            for (k = 0; k < args.length; k++) {
                var list = zero64
                if (typeof args[k] != "function") {
                    list = nilList(b)
                    var w
                    for (w = 0; w < args[k].letws.length; w++) {
                        var rw = args[k].letws[w].fn(b)
                        b = rw.b
                        list = b.NewCall(rtCatFields, [list, rw.v])
                    }
                }
                lists.push(list)
            }
            b = emitAbortCheck(b)
            var endB = curF.NewBlock("")
            var inc = []
            b.NewStore(gepStr(b, "let: "), gArPfx)
            for (k = 0; k < args.length; k++) {
                var v = zero64
                if (typeof args[k] == "function") { var r = args[k](b); b = r.b; v = r.v }
                else { v = b.NewCall(rtLetFields, [lists[k], need]) }
                inc.push(llvm.ir.NewIncoming(v, b))
                if (k + 1 < args.length) {
                    var nb = curF.NewBlock("")
                    b.NewCondBr(b.NewICmp(llvm.enum.IPredNE, b.NewLoad(i32, gArithErr), zero), endB, nb)
                    b = nb
                } else {
                    b.NewBr(endB)
                }
            }
            b = endB
            var last = b.NewPhi(inc)
            b.NewStore(emptyPtr(b), gArPfx)
            var st = b.NewSelect(b.NewICmp(llvm.enum.IPredNE, last, zero64), zero, one)
            storeStatus(b, b.NewSelect(takeArithErr(b), one, st))
            return emitAbortCheck(b)
        }
        var wrapped = [core]
        for (i = 0; i < redirs.length; i++) { wrapped.push(redirs[i]) }
        return mkRedirected(wrapped)
    }

    // [[ ... ]] : the condition thunks answer an i32 boolean (1 = true).
    function makeCondCmd(t) {
        return function(b) {
            b.NewStore(zero, gCondErr)
            var r = t(b)
            b = r.b
            // 0 true, 1 false, 2 the condition could not be evaluated (a bad =~ pattern).
            var err = b.NewICmp(llvm.enum.IPredNE, b.NewLoad(i32, gCondErr), zero)
            var tf = b.NewSelect(b.NewICmp(llvm.enum.IPredNE, r.v, zero), zero, one)
            tf = b.NewSelect(takeArithErr(b), one, tf)
            storeStatus(b, b.NewSelect(err, llvm.constant.NewInt(i32, 2), tf))
            return emitAbortCheck(b)
        }
    }
    function foldCondOr(items) {
        if (items.length == 1) { return items[0] }
        return function(b) { return condShort(b, items, true) }
    }
    function foldCondAnd(items) {
        if (items.length == 1) { return items[0] }
        return function(b) { return condShort(b, items, false) }
    }
    // The operands of || (or, with or false, &&) left to right, each only while the answer
    // is still open, as bash evaluates them. Twin of foldCondOr and foldCondAnd in
    // bash-interpreter.abnf.
    function condShort(b, items, or) {
        var r = items[0](b)
        var i
        for (i = 1; i < items.length; i++) {
            var fromB = r.b
            var restB = curF.NewBlock(""), joinB = curF.NewBlock("")
            fromB.NewCondBr(fromB.NewICmp(or ? llvm.enum.IPredNE : llvm.enum.IPredEQ, r.v, zero), joinB, restB)
            var r2 = items[i](restB)
            r2.b.NewBr(joinB)
            r = {b: joinB, v: joinB.NewPhi([llvm.ir.NewIncoming(or ? one : zero, fromB), llvm.ir.NewIncoming(r2.v, r2.b)])}
        }
        return r
    }
    function mkCondNot(t) {
        return function(b) { var r = t(b); return {b: r.b, v: r.b.NewXor(r.v, one)} }
    }
    // An operand of [[ ]], expanded. An error of its expansion abandons the line as a
    // subscript's does (arith_err 2), while the command's own arithmetic only fails it.
    // Twin of condWord in bash-interpreter.abnf.
    function condWord(b, w) {
        var r = evalWord(b, w)
        if (w.c != undefined) { return r }
        var ae = r.b.NewLoad(i32, gArithErr)
        r.b.NewStore(r.b.NewSelect(r.b.NewICmp(llvm.enum.IPredNE, ae, zero), llvm.constant.NewInt(i32, 2), zero), gArithErr)
        return r
    }
    function mkCondSingle(w) {
        return function(b) {
            var r = condWord(b, w)
            return {b: r.b, v: r.b.NewZExt(isNonEmptyStr(r.b, r.v), i32)}
        }
    }
    function mkCondUn(items) {
        var op = items[0].cop
        var w = items[1]
        return function(b) {
            var r = condWord(b, w)
            b = r.b
            var st = testUnaryIR(b, op, {v: r.v, c: w.c}, true)
            return {b: b, v: b.NewZExt(b.NewICmp(llvm.enum.IPredEQ, st, zero), i32)}
        }
    }
    // A quoted part of a [[ ]] pattern is literal: escape its glob metacharacters.
    // Make every ERE metacharacter of s literal (a quoted part of a =~ regex); rt_rxescape
    // is the run-time half. Twin of regexEscape in bash-interpreter.abnf.
    function regexEscape(s0) {
        var out = ""
        var i
        for (i = 0; i < s0.length; i++) {
            var ch = s0.charAt(i)
            if ("\\.[]()*+?{}|^$".indexOf(ch) >= 0) { out = out + "\\" }
            out = out + ch
        }
        return out
    }
    // A quoted part of a ${v/p/r} replacement: its "&" and "\" are literal; rt_repescape is
    // the run-time half. Twin of repEscape in bash-interpreter.abnf.
    function repEscape(s0) {
        var out = ""
        var i
        for (i = 0; i < s0.length; i++) {
            var ch = s0.charAt(i)
            if (ch == "&" || ch == "\\") { out = out + "\\" }
            out = out + ch
        }
        return out
    }
    function mkQuotedRep(t) {
        return {c: undefined, fn: function(b) {
            var r = evalWord(b, t)
            return {b: r.b, v: r.b.NewCall(rtRepEsc, r.v)}
        }}
    }
    function mkQuotedRx(t) {
        return {c: undefined, fn: function(b) {
            var r = evalWord(b, t)
            return {b: r.b, v: r.b.NewCall(rtRxEsc, r.v)}
        }}
    }
    function mkQuotedPat(t) {
        return {c: undefined, fn: function(b) {
            var r = evalWord(b, t)
            return {b: r.b, v: r.b.NewCall(rtGlobEsc, r.v)}
        }}
    }
    function globEscape(s0) {
        var out = ""
        var i
        for (i = 0; i < s0.length; i++) {
            var ch = s0.charAt(i)
            if (ch == "*" || ch == "?" || ch == "[" || ch == "]" || ch == "\\") { out = out + "\\" }
            out = out + ch
        }
        return out
    }
    // [[ STR =~ ERE ]] : the match itself is one call; the work here is turning its answer
    // into BASH_REMATCH and into the three statuses bash distinguishes (0 match, 1 no match,
    // 2 the regex could not be used at all).
    var NCAPPAIRS = 64
    var capsTy = llvm.types.NewArray(NCAPPAIRS * 2, i32)
    function mkCondMatch(items) {
        var lw = items[0], rw = items[2]
        return function(b) {
            var rl = condWord(b, lw); b = rl.b
            var rr = condWord(b, rw); b = rr.b
            var subj = rl.v
            var caps = slotOf(capsTy)
            var capsPtr = b.NewGetElementPtr(capsTy, caps, zero, zero)
            var resP = slotOf(i32)
            var ip = slotOf(i32)
            b.NewStore(zero, resP)
            var nm = gepStr(b, "BASH_REMATCH")
            // No flags: bash's =~ is a POSIX ERE where ^ and $ anchor the whole subject and
            // "." does not cross a newline, and nocasematch is off.
            var n = b.NewCall(rtRegexSearch, [rr.v, subj, llvm.constant.NewNull(i8ptr),
                                              capsPtr, llvm.constant.NewInt(i32, NCAPPAIRS * 2)])
            var errB = curF.NewBlock(""), okB = curF.NewBlock("")
            var badPat = curF.NewBlock(""), overrun = curF.NewBlock("")
            var matchB = curF.NewBlock(""), fillH = curF.NewBlock(""), fillB = curF.NewBlock("")
            var merge = curF.NewBlock("")
            b.NewCondBr(b.NewICmp(llvm.enum.IPredSLT, n, zero), errB, okB)

            // -1 / -2: status 2, a diagnostic on standard error, and the shell carries on.
            errB.NewStore(llvm.constant.NewInt(i32, 2), gCondErr)
            errB.NewCondBr(errB.NewICmp(llvm.enum.IPredEQ, n, llvm.constant.NewInt(i32, -1)), badPat, overrun)
            // rt_regex_error allocates per call, so it is called once, here.
            emitDiag(badPat, badPat.NewCall(rtStrcat,
                [gepStr(badPat, "[[: invalid regular expression: "),
                 badPat.NewCall(rtStrcat, [badPat.NewCall(rtRegexError), gepStr(badPat, "\n")])]))
            badPat.NewBr(merge)
            emitDiag(overrun, gepStr(overrun, "[[: regular expression step limit exceeded\n"))
            overrun.NewBr(merge)

            // BASH_REMATCH is rebuilt only when the pattern COULD be used: a match fills
            // it and a failed match empties it, but a pattern that would not compile
            // leaves the previous match in place - which is what real bash does, and
            // why the clear lives here and not before the search.
            okB.NewCall(rtArrClear, nm)
            okB.NewCondBr(okB.NewICmp(llvm.enum.IPredEQ, n, zero), merge, matchB)
            matchB.NewStore(one, resP)
            matchB.NewStore(zero, ip)
            matchB.NewBr(fillH)
            // BASH_REMATCH[0] is the whole match, [i] the i-th group. The TRUE pair count is
            // reported even when it exceeds the caps array, so the entries past it are the
            // empty string rather than missing - ${#BASH_REMATCH[@]} stays exact.
            var i = fillH.NewLoad(i32, ip)
            fillH.NewCondBr(fillH.NewICmp(llvm.enum.IPredSLT, i, n), fillB, merge)
            var inRange = fillB.NewICmp(llvm.enum.IPredSLT, i, llvm.constant.NewInt(i32, NCAPPAIRS))
            var idx = fillB.NewSelect(inRange, i, zero)
            var two2 = llvm.constant.NewInt(i32, 2)
            var bgn = fillB.NewLoad(i32, fillB.NewGetElementPtr(capsTy, caps, zero, fillB.NewMul(idx, two2)))
            var end = fillB.NewLoad(i32, fillB.NewGetElementPtr(capsTy, caps, zero,
                        fillB.NewAdd(fillB.NewMul(idx, two2), one)))
            var have = fillB.NewAnd(inRange, fillB.NewICmp(llvm.enum.IPredSGE, bgn, zero))
            var piece = fillB.NewCall(rtSubstr, [subj, bgn, fillB.NewSub(end, bgn)])
            fillB.NewCall(rtArrSet, [nm, i2s(fillB, i),
                                     fillB.NewSelect(have, piece, emptyPtr(fillB))])
            fillB.NewStore(fillB.NewAdd(i, one), ip)
            fillB.NewBr(fillH)

            return {b: merge, v: merge.NewLoad(i32, resP)}
        }
    }
    // Write a diagnostic on the standard error CHANNEL without disturbing the caller's
    // redirections: routing it through the channel rather than straight to fd 2 is what makes
    // `cmd 2>/dev/null` silence it exactly as the shell does.
    function emitOnStderr(b, msg) {
        var saved = b.NewLoad(i32, gSinkOut)
        b.NewStore(b.NewLoad(i32, gSinkErr), gSinkOut)
        b.NewCall(rtPrints, msg)
        b.NewStore(saved, gSinkOut)
    }
    // A shell diagnostic: msg after bash's "SCRIPT: line N: " (rt_diag_pfx).
    function emitDiag(b, msg) {
        var saved = b.NewLoad(i32, gSinkOut)
        b.NewStore(b.NewLoad(i32, gSinkErr), gSinkOut)
        b.NewCall(rtDiagPfx)
        b.NewCall(rtPrints, msg)
        b.NewStore(saved, gSinkOut)
    }

    function mkCondBin(items) {
        var lw = items[0], op = items[1].cop, rw = items[2]
        return function(b) {
            var rl = condWord(b, lw); b = rl.b
            var rr = condWord(b, rw); b = rr.b
            // == and != glob-match their right hand side inside [[ ]]; = is a synonym of ==.
            if (op == "==" || op == "=") { return {b: b, v: b.NewCall(rtGlobX, [rr.v, rl.v])} }
            if (op == "!=") { return {b: b, v: b.NewXor(b.NewCall(rtGlobX, [rr.v, rl.v]), one)} }
            if (op == "=~") { fail("[[ =~ ]] (regex matching) is not supported") }
            // The numeric tests evaluate BOTH sides as arithmetic expressions inside [[ ]].
            // Twin of mkCondBin in bash-interpreter.abnf.
            var npred = condNumPred(op)
            if (npred != null) {
                b.NewStore(gepStr(b, "[[: "), gArPfx)
                var al = b.NewCall(rtArith, rl.v)
                var ar = b.NewCall(rtArith, rr.v)
                b.NewStore(emptyPtr(b), gArPfx)
                return {b: b, v: b.NewZExt(b.NewICmp(npred, al, ar), i32)}
            }
            var st = testBinaryIR(b, {v: rl.v, c: lw.c}, op, {v: rr.v, c: rw.c})
            return {b: b, v: b.NewZExt(b.NewICmp(llvm.enum.IPredEQ, st, zero), i32)}
        }
    }

    function condNumPred(op) {
        if (op == "-eq") { return llvm.enum.IPredEQ }
        if (op == "-ne") { return llvm.enum.IPredNE }
        if (op == "-lt") { return llvm.enum.IPredSLT }
        if (op == "-le") { return llvm.enum.IPredSLE }
        if (op == "-gt") { return llvm.enum.IPredSGT }
        if (op == "-ge") { return llvm.enum.IPredSGE }
        return null
    }
    function mkRedir(items) {
        var op = "", fd = "", t = null
        var i
        for (i = 0; i < items.length; i++) {
            var it = items[i]
            if (it.fn != undefined) { t = it }
            else if (it.redir != undefined) { op = it.redir }
            else if (it.iofd != undefined) { fd = it.iofd }
        }
        var hf = hiFd(fd)
        if (hf >= 0) { usedFd[hf] = true }
        if (t != null && t.c != undefined && hiFd(t.c) >= 0) { usedFd[hiFd(t.c)] = true }
        return {rd: op, iofd: fd, target: t}
    }
    // eval / trap re-parse a string with THIS grammar, starting at CompoundList (which pushes
    // one statement-sequence thunk); the thunk that comes back is emitted inline.
    // Its continuations are joined first, as in a script (Spliced), so the offsets arSrc reads
    // are those of the joined text.
    // A snippet of nothing but blanks and comments (`eval '# note'`, `trap '# x' EXIT`) runs
    // nothing, with status 0; the grammar's list needs at least one command.
    function snipIsEmpty(src) {
        var i = 0
        while (i < src.length) {
            var ch = src.charAt(i)
            if (ch == "#") { while (i < src.length && src.charAt(i) != "\n") { i = i + 1 } }
            else if (ch == " " || ch == "\t" || ch == "\n" || ch == "\r") { i = i + 1 }
            else { return false }
        }
        return true
    }
    // Its lines count from line0, or from the current command's line when line0 is 0. Twin of
    // compileSnippet in bash-interpreter.abnf.
    function compileSnippet(src, line0, lines) {
        if (snipIsEmpty(src)) { return function(b) { storeStatusI(b, 0); return b } }
        if (src.indexOf("\\\n") >= 0 || src.indexOf("<<") >= 0) { src = c.compile(c.parseFrom(c.agrammar, src, "Spliced")).stack[0] }
        var sv = snipLine0
        snipLine0 = line0 > 0 ? line0 : emitLine
        var t = arCompile(src, lines ? "Snippet" : "CompoundList", false)
        snipLine0 = sv
        return function(b) {
            var svLn = lnCtx
            lnCtx = null
            var r = t(b)
            lnCtx = svLn
            return r
        }
    }

    // printf [-v NAME] [--] FORMAT [ARG...]: the whole command runs in rt_printf
    // (languages/lib/bash-rt.c), so the format may come out of an expansion and `%*d` takes
    // its width from an operand; printf_rc is its status. Twin of printfBuiltin in
    // languages/bash-interpreter.abnf, which documents the conversions.
    // cmk: the mark the command started at, or null (cmdMark).
    function emitPrintf(b, args, cmk) {
        var a = args
        var destW = null
        if (a.length >= 2 && a[0].c == "-v") { destW = a[1]; a = a.slice(2) }
        var dest = (destW != null) ? destW.c : null
        // A name that is no NAME or NAME[SUB] (bashIsRef) fails printf with status 2 before
        // the format is looked at.
        if (dest != null && !bashIsRef(dest)) {
            emitDiag(b, gepStr(b, "printf: `" + dest + "': not a valid identifier\n"))
            storeStatusI(b, 2)
            return b
        }
        if (destW == null || dest != null) { return emitPrintfTo(b, a, destW, null, cmk) }
        var rd = evalWord(b, destW)
        b = emitAbortCheck(rd.b)
        var badB = curF.NewBlock(""), goB = curF.NewBlock(""), done = curF.NewBlock("")
        b.NewCondBr(b.NewICmp(llvm.enum.IPredEQ, b.NewCall(rtIsAsgRef, rd.v), zero), badB, goB)
        emitDiag(badB, badB.NewCall(rtStrcat, [badB.NewCall(rtStrcat, [gepStr(badB, "printf: `"), rd.v]),
                                               gepStr(badB, "': not a valid identifier\n")]))
        storeStatusI(badB, 2)
        badB.NewBr(done)
        emitPrintfTo(goB, a, destW, rd.v, cmk).NewBr(done)
        return done
    }
    // The rest of a printf, the -v name destW already checked: rdv is its value when it is
    // computed, else null.
    function emitPrintfTo(b, a, destW, rdv, cmk) {
        var dest = (destW != null) ? destW.c : null
        if (a.length > 0 && a[0].c == "--") { a = a.slice(1) }
        if (a.length == 0) { storeStatusI(b, 0); return b }
        var mk = (cmk != null) ? cmk : heapMark(b)
        var rf = evalWord(b, a[0])
        b = rf.b
        // The operands as ONE field list: an unquoted operand is field-split, so the number of
        // operands is a run-time fact (`x="  a   b  "; printf '%s|' $x` prints `a|b|`).
        var listV = nilList(b)
        var i
        for (i = 1; i < a.length; i++) {
            var rw = a[i].fn(b)
            b = rw.b
            listV = b.NewCall(rtCatFields, [listV, rw.v])
        }
        b = emitAbortCheck(b)
        var out = b.NewCall(rtPrintf, [rf.v, listV])
        if (destW == null) {
            b.NewCall(rtPfOut, out)
            storeStatus(b, b.NewLoad(i32, gPrintfRc))
            return b
        }
        if (dest != null && roRefusedV(b, dest)) { storeStatusI(b, 1); return b }
        var roJ = null
        var rr = (dest != null) ? roRtTest(b, elemBase(dest)) : null
        if (rr != null) {
            roJ = curF.NewBlock("")
            storeStatusI(rr.ro, 1)
            rr.ro.NewBr(roJ)
            b = rr.ok
        }
        // A refused subscript in the name fails printf with status 1.
        var subP = slotOf(i32)
        b.NewStore(zero, subP)
        if (dest != null) {
            b.NewStore(gepStr(b, "printf: "), gArPfx)
            var pfAsg = namedAsg(dest, b.NewCall(rtPfValue, out), subP)
            var pfOne = function(bb) { return emitAssign(bb, pfAsg, false, mk) }
            b = refMay(dest) ? viaRefMay(b, dest, false, pfOne) : pfOne(b)
            b.NewStore(emptyPtr(b), gArPfx)
        } else {
            // A computed name is stored by name at run time (rt_setvar_byname, as a builtin).
            b.NewCall(rtSetByName, [rdv, b.NewCall(rtPfValue, out), zero, b.NewOr(refAttrs(b, rdv, true), llvm.constant.NewInt(i32, 32))])
            b.NewStore(b.NewCall(rtTakeSubbad), subP)
            b = emitAbortCheck(b)
        }
        storeStatus(b, b.NewSelect(b.NewICmp(llvm.enum.IPredNE, b.NewLoad(i32, subP), zero), one, b.NewLoad(i32, gPrintfRc)))
        if (roJ == null) { return b }
        b.NewBr(roJ)
        return roJ
    }

    // read [-r] [-a NAME] [-d DELIM] [-n|-N COUNT] NAME... (bashReadOpts): one record of standard input
    // (rt_read_line), split on IFS with the last name taking the rest (rt_rd_fields); the
    // status is 1 when no delimiter ended the record. An empty IFS (IFS= read) means no
    // splitting at all; an UNSET IFS is the default. Twin of readBuiltin in
    // bash-interpreter.abnf, which has the cases.
    function emitRead(b, args, cmk) {
        var words = []
        var i
        for (i = 0; i < args.length; i++) {
            if (args[i].c == undefined) { return emitReadDyn(b, args) }
            words.push(args[i].c)
        }
        var o = bashReadOpts(words)
        var names = o.names
        var arrName = o.arr
        if (o.bad != null) {
            storeStatus(b, b.NewCall(rtOptUsage, [gepStr(b, "read"), gepStr(b, o.bad), o.missing ? one : zero, gepStr(b, bashReadSyn)]))
            return b
        }
        if (o.badNum != null) {
            emitDiag(b, gepStr(b, "read: " + o.badNum + ": invalid number\n"))
            storeStatusI(b, 1)
            return b
        }
        if (names.length > 0 && !bashIsRef(names[0])) {
            emitDiag(b, gepStr(b, "read: `" + names[0] + "': not a valid identifier\n"))
            storeStatusI(b, 1)
            return b
        }
        // NO NAMES AT ALL: bash assigns the record to REPLY "without the ending delimiter but
        // otherwise unmodified" - not field 0, and not stripped.
        var rawReply = (arrName == null && names.length == 0)
        var anyElem = false
        for (i = 0; i < names.length; i++) { if (names[i].indexOf("[") > 0) { anyElem = true } }
        var badArr = arrName != null && !isIdentText(arrName)
        // One name is the read's only store: what the read allocated besides goes back.
        // Several are kept in their slots' buffers first (rt_rkeep), and then it goes back.
        var mk = (arrName == null && names.length >= 1 && !anyElem) ? ((cmk != null) ? cmk : heapMark(b)) : null
        var mk1 = (names.length == 1) ? mk : null
        var q = o.raw ? zero : one
        var line = b.NewCall(rtReadLine, [o.raw ? one : zero, llvm.constant.NewInt(i32, utf8Lead(o.dlm)), llvm.constant.NewInt(i32, o.nch)])
        if (badArr) {
            emitDiag(b, gepStr(b, "read: `" + arrName + "': not a valid identifier\n"))
            storeStatusI(b, 1)
            return b
        }
        if ((arrName != null && roRefused(b, arrName, "")) || (rawReply && roRefused(b, "REPLY", ""))) {
            storeStatusI(b, rawReply ? 2 : 1)
            return b
        }
        // The name that stops the read, and its status: one that is no NAME or NAME[SUB] (1),
        // or a readonly one (2, 1 for the last).
        var stopK = names.length
        var stopSt = 0
        var stopBad = false
        var k
        for (k = 0; k < names.length && stopK == names.length; k++) {
            if (!bashIsRef(names[k])) { stopK = k; stopSt = 1; stopBad = true }
            else if (roStoreV(names[k])) { stopK = k; stopSt = (k < names.length - 1) ? 2 : 1 }
        }
        var ifs = emptyPtr(b)
        // -N splits nothing, as an empty IFS.
        if (!o.whole) {
            var ifsRaw = loadVar(b, "IFS")
            ifs = b.NewSelect(b.NewICmp(llvm.enum.IPredEQ, ifsRaw, unsetPtr(b)), gepStr(b, " \t\n"), ifsRaw)
        }
        var merge = curF.NewBlock("")
        var rra = (arrName != null) ? roRtTest(b, arrName) : null
        if (rra != null) {
            storeStatusI(rra.ro, 1)
            rra.ro.NewBr(merge)
            b = rra.ok
        }
        // Through a nameref to a readonly variable the store is refused, naming the nameref
        // after a circular chain's warning (rt_nref_end); through one that is an array
        // (rt_nref_isarr), the record read. Twin of readBuiltin in bash-interpreter.abnf.
        if (arrName != null && attrOn(refVars, arrName) && roNames.length > 0) {
            var anv = gepStr(b, arrName)
            var rroB = curF.NewBlock(""), rgoB = curF.NewBlock("")
            b.NewCondBr(b.NewICmp(llvm.enum.IPredNE, b.NewAnd(refAttrs(b, anv, true), llvm.constant.NewInt(i32, 8)), zero), rroB, rgoB)
            rroB.NewCall(rtNrefEnd, anv)
            emitDiag(rroB, gepStr(rroB, arrName + ": readonly variable\n"))
            storeStatusI(rroB, 1)
            rroB.NewBr(merge)
            b = rgoB
        }
        if (arrName != null && attrOn(refVars, arrName)) {
            var raBad = curF.NewBlock(""), raGo = curF.NewBlock("")
            b.NewCondBr(b.NewICmp(llvm.enum.IPredNE, b.NewCall(rtNrefIsarr, [gepStr(b, arrName), zero]), zero), raBad, raGo)
            emitDiag(raBad, gepStr(raBad, "read: `': not a valid identifier\n"))
            storeStatusI(raBad, 1)
            raBad.NewBr(merge)
            b = raGo
        }
        if (arrName != null) {
            // Through a nameref, its target or, with no value, itself (rt_nref_arrstore).
            var an = attrOn(refVars, arrName) ? b.NewCall(rtNrefArrstore, gepStr(b, arrName)) : gepStr(b, arrName)
            b.NewCall(rtArrClear, an)
            b.NewCall(rtArrMark, an)
            // An element that is an -i arithmetic error abandons the line.
            var rat = elemAttrs(arrName)
            if ((rat & 1) != 0) { b.NewStore(gepStr(b, "read: "), gArPfx) }
            b.NewCall(rtArrLitWords, [an, b.NewCall(rtRdFields, [line, ifs, q, zero]), zero64,
                                      llvm.constant.NewInt(i32, rat)])
            if ((rat & 1) != 0) {
                b.NewStore(emptyPtr(b), gArPfx)
                b = emitAbortCheck(b)
            }
        }
        if (rawReply) { storeVar(b, "REPLY", b.NewCall(rtGetField, [b.NewCall(rtRdFields, [line, emptyPtr(b), q, one]), zero])) }
        // An -i name's arithmetic error abandons the line: the names after it keep their values.
        b.NewStore(gepStr(b, "read: "), gArPfx)
        var fvs = []
        if (stopK > 0) {
            var vs = b.NewCall(rtRdFields, [line, ifs, q, llvm.constant.NewInt(i32, names.length)])
            for (k = 0; k < stopK; k++) { fvs.push(b.NewCall(rtGetField, [vs, llvm.constant.NewInt(i32, k)])) }
        }
        if (mk != null && mk1 == null) {
            for (k = 0; k < stopK; k++) { fvs[k] = b.NewCall(rtRkeep, [mk.a, fvs[k], llvm.constant.NewInt(i32, getVarId(names[k]))]) }
            b.NewCall(rtRkeepEnd, [mk.a, mk.l])
        }
        // A refused subscript stops the read like a readonly name: 2, or 1 for the last name.
        var subP = slotOf(i32)
        b.NewStore(zero, subP)
        for (k = 0; k < stopK; k++) {
            var rrk = roRtTest(b, elemBase(names[k]))
            if (rrk != null) {
                rrk.ro.NewStore(emptyPtr(rrk.ro), gArPfx)
                storeStatusI(rrk.ro, (k < names.length - 1) ? 2 : 1)
                rrk.ro.NewBr(merge)
                b = rrk.ok
            }
            var rdAsg = namedAsg(names[k], fvs[k], subP)
            var rdOne = function(bb) { return emitAssign(bb, rdAsg, false, mk1) }
            var rdMay = refMay(names[k])
            b = rdMay ? viaRefMay(b, names[k], false, rdOne) : rdOne(b)
            if (names[k].indexOf("[") < 0 && !attrOn(refVars, names[k]) && !rdMay) { continue }
            var refB = curF.NewBlock(""), goB = curF.NewBlock("")
            b.NewCondBr(b.NewICmp(llvm.enum.IPredNE, b.NewLoad(i32, subP), zero), refB, goB)
            refB.NewStore(emptyPtr(refB), gArPfx)
            storeStatusI(refB, (k < names.length - 1) ? 2 : 1)
            refB.NewBr(merge)
            b = goB
        }
        if (stopBad) {
            emitDiag(b, gepStr(b, "read: `" + names[stopK] + "': not a valid identifier\n"))
        } else if (stopK < names.length) { roRefused(b, names[stopK], "") }
        b.NewStore(emptyPtr(b), gArPfx)
        storeStatus(b, (stopK < names.length) ? llvm.constant.NewInt(i32, stopSt) : b.NewLoad(i32, gReadEof))
        b.NewBr(merge)
        return merge
    }
    // The byte rt_read_line stops at for a -d delimiter: its first UTF-8 byte, 0 for -d ''.
    function utf8Lead(ch) {
        if (ch == "") { return 0 }
        var cp = ch.charCodeAt(0)
        if (cp < 128) { return cp }
        if (cp < 2048) { return 192 + Math.floor(cp / 64) }
        if (cp >= 55296 && cp <= 56319) { return 240 }
        return 224 + Math.floor(cp / 4096)
    }
    // A read with a computed operand: the operands as one field list, read and stored at run
    // time by rt_rd_parse / rt_rd_run, each variable under the attributes it has here
    // (refAttrs).
    function emitReadDyn(b, args) {
        var listV = nilList(b)
        var i
        for (i = 0; i < args.length; i++) {
            var rw = args[i].fn(b)
            b = rw.b
            listV = b.NewCall(rtCatFields, [listV, rw.v])
        }
        b = emitAbortCheck(b)
        var n = b.NewCall(rtRdParse, listV)
        var iP = slotOf(i32)
        b.NewStore(zero, iP)
        var head = curF.NewBlock(""), step = curF.NewBlock(""), done = curF.NewBlock("")
        b.NewBr(head)
        var iv = head.NewLoad(i32, iP)
        head.NewCondBr(head.NewICmp(llvm.enum.IPredSLT, iv, n), step, done)
        step.NewCall(rtRdAt, [iv, refAttrs(step, step.NewCall(rtRdName, iv), true)])
        step.NewStore(step.NewAdd(iv, one), iP)
        step.NewBr(head)
        var st = done.NewCall(rtRdRun)
        done = emitAbortCheck(done)
        storeStatus(done, st)
        return done
    }

    // mapfile / readarray (see mapfileBuiltin in bash-interpreter.abnf). The options and the
    // array name are read here and must be literal words; an option's value may be any word,
    // checked at run time by rt_mf_begin. The records are read and stored by a loop over
    // rt_mf_next and rt_mf_store, and a -C callback, compiled here as `CALLBACK "$@"`, runs
    // over the index and the record (rt_mf_args) whenever rt_mf_due says so.
    function emitMapfile(b, who, args) {
        var vals = {}
        var trim = 0
        var name = "MAPFILE"
        var cb = null
        var bad = null
        var missing = 0
        var i = 0
        while (i < args.length && bad == null) {
            var a = args[i].c
            if (a == undefined) { fail(who + " needs literal options and a literal array name in this compiler") }
            if (a == "--") { i = i + 1; break }
            if (a.length < 2 || a.charAt(0) != "-") { break }
            var j = 1
            while (j < a.length && bad == null) {
                var f = a.charAt(j)
                if (f == "t") { trim = 1; j = j + 1; continue }
                if ("dnOsuCc".indexOf(f) < 0) { bad = "-" + f; continue }
                var vt = null
                if (j + 1 < a.length) { vt = makeConst(a.slice(j + 1)) }
                else if (i + 1 < args.length) { i = i + 1; vt = args[i] }
                else { bad = "-" + f; missing = 1; continue }
                if (f == "C") {
                    if (vt.c == undefined) { fail(who + " -C needs a literal callback in this compiler") }
                    cb = vt.c
                } else { vals["$" + f] = vt }
                j = a.length
            }
            i = i + 1
        }
        if (bad != null) {
            storeStatus(b, b.NewCall(rtOptUsage, [gepStr(b, who), gepStr(b, bad), llvm.constant.NewInt(i32, missing), gepStr(b, bashMfSyn)]))
            return b
        }
        if (i < args.length) {
            if (args[i].c == undefined) { fail(who + " needs literal options and a literal array name in this compiler") }
            name = args[i].c
        }
        var ops = [gepStr(b, who), gepStr(b, name)]
        var letters = "dnOsuc"
        var k
        for (k = 0; k < letters.length; k++) {
            var w = vals["$" + letters.charAt(k)]
            if (w == undefined) { ops.push(nullStr); continue }
            var rw = evalWord(b, w)
            b = rw.b
            ops.push(rw.v)
        }
        b = emitAbortCheck(b)
        // 8: the name is readonly, which rt_mf_begin reports once the options pass; through
        // a nameref, the variable it lands on is (refAttrs).
        var at = llvm.constant.NewInt(i32, isIdentText(name) ? elemAttrs(name) + (attrOn(roVars, name) ? 8 : 0) : 0)
        if (isIdentText(name) && attrOn(refVars, name)) { at = refAttrs(b, gepStr(b, name), true) }
        ops.push(llvm.constant.NewInt(i32, trim))
        ops.push(at)
        var st = b.NewCall(rtMfBegin, ops)
        var loopB = curF.NewBlock(""), bodyB = curF.NewBlock(""), endB = curF.NewBlock(""), doneB = curF.NewBlock("")
        var refB = curF.NewBlock("")
        b.NewCondBr(b.NewICmp(llvm.enum.IPredSLT, st, zero), loopB, refB)
        storeStatus(refB, st)
        refB.NewBr(doneB)
        loopB.NewCondBr(loopB.NewICmp(llvm.enum.IPredNE, loopB.NewCall(rtMfNext), zero), bodyB, endB)
        var sb = bodyB
        if (cb != null) {
            var cbB = curF.NewBlock(""), stB = curF.NewBlock("")
            bodyB.NewCondBr(bodyB.NewICmp(llvm.enum.IPredNE, bodyB.NewCall(rtMfDue), zero), cbB, stB)
            // The callback's own frame of positional parameters, as a function call has.
            var savedTop = slotOf(i32), savedBase = slotOf(i32), savedN = slotOf(i32)
            cbB.NewStore(cbB.NewLoad(i32, gArgvTop), savedTop)
            cbB.NewStore(cbB.NewLoad(i32, gFrameBase), savedBase)
            cbB.NewStore(cbB.NewLoad(i32, gFrameN), savedN)
            cbB.NewCall(rtArgCall, cbB.NewCall(rtMfArgs))
            var base = cbB.NewLoad(i32, savedTop)
            cbB.NewStore(base, gFrameBase)
            cbB.NewStore(cbB.NewSub(cbB.NewLoad(i32, gArgvTop), base), gFrameN)
            var after = compileSnippet(cb + " \"$@\"", 0)(cbB)
            after.NewStore(after.NewLoad(i32, savedBase), gFrameBase)
            after.NewStore(after.NewLoad(i32, savedN), gFrameN)
            after.NewStore(after.NewLoad(i32, savedTop), gArgvTop)
            after.NewBr(stB)
            sb = stB
        }
        sb.NewCall(rtMfStore)
        if ((at & 1) != 0) { sb = emitAbortCheck(sb) }
        sb.NewBr(loopB)
        storeStatusI(endB, 0)
        endB.NewBr(doneB)
        return doneB
    }

    // set [-e|+e] [-u|+u] [-o pipefail|+o pipefail]: the flags are runtime globals, so
    // set +e later in the program really does turn errexit back off.
    function emitSet(b, args) {
        var i = 0
        while (i < args.length) {
            if (i >= args.length) { i = args.length }
            var a = args[i].c
            if (a == undefined) { fail("set needs literal option words in this compiler") }
            if (a == "-o" || a == "+o") {
                var on = (a == "-o") ? one : zero
                if (i + 1 < args.length) {
                    var nm = args[i + 1].c
                    if (nm == "pipefail") { b.NewStore(on, gOptPf) }
                    if (nm == "errexit") { b.NewStore(on, gOptE) }
                    if (nm == "nounset") { b.NewStore(on, gOptU) }
                    i = i + 1
                }
            } else if (a == "--") {
                // Rebind the positional parameters to the fields of the remaining words.
                var listV = nilList(b)
                var j
                for (j = i + 1; j < args.length; j++) {
                    var ra = args[j].fn(b)
                    b = ra.b
                    listV = b.NewCall(rtCatFields, [listV, ra.v])
                }
                b.NewCall(rtSetArgs, listV)
                i = args.length
            } else if (a.length > 1 && (a.charAt(0) == "-" || a.charAt(0) == "+")) {
                var on2 = (a.charAt(0) == "-") ? one : zero
                var k
                for (k = 1; k < a.length; k++) {
                    var f = a.charAt(k)
                    if (f == "e") { b.NewStore(on2, gOptE) }
                    if (f == "u") { b.NewStore(on2, gOptU) }
                }
            }
            i = i + 1
        }
        storeStatusI(b, 0)
        return b
    }

    // An error an expansion raised, checked before the command runs. set -u and ${v:?} end
    // the (sub)shell (exited 1); an arithmetic or substring error abandons the command line
    // (exited 2, which a subshell treats as any exit and a top-level line catches - see
    // runProgram). Both leave status 1, a refused ${NAME=WORD} store (arith_err 3) status 2.
    // Twin of takeAbort in bash-interpreter.abnf.
    // ug: a global binding a nameref store put in effect goes back first (rt_nref_unglob).
    function emitAbortCheck(b, ug) {
        var ab = b.NewLoad(i32, gAbort)
        var isAb = b.NewICmp(llvm.enum.IPredNE, ab, zero)
        var ae = b.NewLoad(i32, gArithErr)
        var isAr = b.NewICmp(llvm.enum.IPredNE, ae, zero)
        var kill = curF.NewBlock(""), cont = curF.NewBlock("")
        b.NewCondBr(b.NewOr(isAb, isAr), kill, cont)
        if (ug == true) { kill.NewCall(rtNrefUnglob) }
        kill.NewStore(zero, gAbort)
        kill.NewStore(zero, gArithErr)
        kill.NewStore(emptyPtr(kill), gArPfx)   // no command prefix outlives the line
        // arith_err 3 is a refused ${NAME=WORD} store, which leaves status 2.
        var three = llvm.constant.NewInt(i32, 3)
        kill.NewStore(kill.NewSelect(kill.NewICmp(llvm.enum.IPredEQ, ae, three), llvm.constant.NewInt(i32, 2), one), gExitCode)
        kill.NewStore(kill.NewSelect(isAb, one, llvm.constant.NewInt(i32, 2)), gExited)
        kill.NewBr(viaUnwind(curExit, curExitRd))
        return cont
    }
    // A command that evaluates arithmetic ITSELF ((( )), let, [[ -eq ]], for (( ))) fails
    // with status 1 on an error instead: this answers whether one was raised, and clears it.
    // An error in a subscript (arith_err 2, ar_subeval) stays raised, and the caller's
    // emitAbortCheck then abandons the line. Twin of takeArithErr in bash-interpreter.abnf.
    function takeArithErr(b) {
        var ae = b.NewLoad(i32, gArithErr)
        var e = b.NewICmp(llvm.enum.IPredNE, ae, zero)
        var two = llvm.constant.NewInt(i32, 2)
        b.NewStore(b.NewSelect(b.NewICmp(llvm.enum.IPredEQ, ae, two), two, zero), gArithErr)
        return e
    }
    // set -e: leave on a failing command, unless it is running as a condition.
    function emitErrExitCheck(b) {
        if (condDepth > 0) { return b }
        var st = b.NewLoad(i32, gStatus)
        var bad = b.NewAnd(b.NewICmp(llvm.enum.IPredNE, b.NewLoad(i32, gOptE), zero),
                           b.NewICmp(llvm.enum.IPredNE, st, zero))
        bad = b.NewAnd(bad, b.NewICmp(llvm.enum.IPredEQ, b.NewLoad(i32, gCondRt), zero))
        var kill = curF.NewBlock(""), cont = curF.NewBlock("")
        b.NewCondBr(bad, kill, cont)
        kill.NewStore(st, gExitCode)
        kill.NewStore(one, gExited)
        kill.NewBr(viaUnwind(curExit, curExitRd))
        return cont
    }
    // Emit a thunk as a CONDITION.
    function emitCond(t, b) {
        condDepth = condDepth + 1
        var nb = t(b)
        condDepth = condDepth - 1
        return nb
    }
    // A subshell must restore the shell OPTIONS as well as the variables (set -e inside
    // $( ) does not leak out), so they are stashed in allocas around the body.
    function saveOpts(b) {
        var se = slotOf(i32), su = slotOf(i32), sp = slotOf(i32), sx = slotOf(i32)
        b.NewStore(b.NewLoad(i32, gOptE), se)
        b.NewStore(b.NewLoad(i32, gOptU), su)
        b.NewStore(b.NewLoad(i32, gOptPf), sp)
        b.NewStore(b.NewLoad(i32, gOptExtglob), sx)
        var so = slotOf(i32), sr = slotOf(i32), sb = slotOf(i8ptr), si = slotOf(i32)
        b.NewStore(b.NewLoad(i32, gSinkOut), so)
        b.NewStore(b.NewLoad(i32, gSinkErr), sr)
        b.NewStore(b.NewLoad(i8ptr, gStdin), sb)
        b.NewStore(b.NewLoad(i32, gStdinPos), si)
        var fds = []
        var n
        for (n = 3; n <= 9; n++) {
            if (usedFd[n]) { var fs = slotOf(i32); b.NewStore(b.NewLoad(i32, fdGlobal(n)), fs); fds.push({g: fdGlobal(n), s: fs}) }
        }
        var tc = slotOf(i32)
        b.NewStore(b.NewLoad(i32, tcSlot), tc)
        var ros = []
        for (n = 0; n < roNames.length; n++) { var rs = slotOf(i32); b.NewStore(b.NewLoad(i32, roFlag(roNames[n])), rs); ros.push({g: roFlag(roNames[n]), s: rs}) }
        return {e: se, u: su, pf: sp, x: sx, so: so, sr: sr, sb: sb, si: si, fds: fds, tc: tc, ros: ros}
    }
    // The streams an `exec` may have redirected come back too; the standard input only when
    // the subshell REPLACED it, since what it read of an inherited input is consumed for the
    // parent as well. Twin of restoreShellState in bash-interpreter.abnf.
    function restoreOpts(b, sv) {
        b.NewStore(b.NewLoad(i32, sv.e), gOptE)
        b.NewStore(b.NewLoad(i32, sv.u), gOptU)
        b.NewStore(b.NewLoad(i32, sv.pf), gOptPf)
        b.NewStore(b.NewLoad(i32, sv.x), gOptExtglob)
        b.NewStore(b.NewLoad(i32, sv.so), gSinkOut)
        b.NewStore(b.NewLoad(i32, sv.sr), gSinkErr)
        b.NewStore(b.NewLoad(i32, sv.tc), tcSlot)
        var k
        for (k = 0; k < sv.fds.length; k++) { b.NewStore(b.NewLoad(i32, sv.fds[k].s), sv.fds[k].g) }
        for (k = 0; k < sv.ros.length; k++) { b.NewStore(b.NewLoad(i32, sv.ros[k].s), sv.ros[k].g) }
        var ib = b.NewLoad(i8ptr, sv.sb)
        var moved = b.NewICmp(llvm.enum.IPredNE, b.NewLoad(i8ptr, gStdin), ib)
        b.NewStore(b.NewSelect(moved, b.NewLoad(i32, sv.si), b.NewLoad(i32, gStdinPos)), gStdinPos)
        b.NewStore(ib, gStdin)
    }
    // `shopt` knows extglob (-s / -u / -q); every other option is accepted and reported as
    // success, and a -q query of one answers "on". Only LITERAL words are read. Twin of the
    // shopt arm of runCommand in bash-interpreter.abnf.
    function emitShopt(b, argTs) {
        var flag = ""
        var st = zero
        var i
        for (i = 0; i < argTs.length; i++) {
            var a = argTs[i].c
            if (a == "-s" || a == "-u" || a == "-q") { flag = a }
            else if (a == "extglob") {
                if (flag == "-s") { b.NewStore(one, gOptExtglob) }
                if (flag == "-u") { b.NewStore(zero, gOptExtglob) }
                if (flag == "-q") { st = b.NewSelect(b.NewICmp(llvm.enum.IPredNE, b.NewLoad(i32, gOptExtglob), zero), zero, one) }
            }
        }
        storeStatus(b, st)
        return b
    }

    // Emit the EXIT traps a (sub)shell registered, each behind its own flag. What they run
    // leaves $? as it was: bash's status at exit is the one the trap started with.
    function emitTraps(b, list) {
        var i
        if (list.length == 0) { return b }
        var sv = slotOf(i32)
        b.NewStore(b.NewLoad(i32, gStatus), sv)
        for (i = 0; i < list.length; i++) {
            var tr = list[i]
            var run = curF.NewBlock(""), skip = curF.NewBlock("")
            b.NewCondBr(b.NewICmp(llvm.enum.IPredNE, b.NewLoad(i32, tr.flag), zero), run, skip)
            run.NewStore(zero, tr.flag)
            // A line the trap abandons (in a subshell, the rest of the trap) leaves the
            // status. Twin of runExitTrap in bash-interpreter.abnf.
            var savedExit = curExit, savedExitRd = curExitRd
            var trapExit = curF.NewBlock(""), softB = curF.NewBlock("")
            curExit = trapExit
            curExitRd = redirStack.length
            var rb = tr.body(run)
            curExit = savedExit
            curExitRd = savedExitRd
            rb.NewBr(skip)
            trapExit.NewCondBr(trapExit.NewICmp(llvm.enum.IPredEQ, trapExit.NewLoad(i32, gExited), llvm.constant.NewInt(i32, 2)),
                               softB, viaUnwind(savedExit, savedExitRd))
            softB.NewStore(zero, gExited)
            softB.NewBr(skip)
            b = skip
        }
        b.NewStore(b.NewLoad(i32, sv), gStatus)
        return b
    }

    // A command name that comes out of an expansion (`cmd="echo hi"; $cmd`): the command word
    // is field-split and the extra fields become the first arguments. The name is known only at
    // RUN time, so the dispatch is a chain of string compares over echo, the three trivial
    // builtins and every user function. LIMIT: builtins compiled from a literal argument list
    // (printf, test/[, read, eval, set, trap, unset, declare, control flow) are refused at
    // run time here, where the interpreter runs them.
    // subs: a word or prefix assignment holds a command substitution.
    // noFn: reached through `builtin` / `command`, which pass over the user functions.
    function emitComputedCommand(b, cmdT, argTs, subs, noFn) {
        var listP = slotOf(i8ptr)
        b.NewStore(nilList(b), listP)
        var rw = cmdT.fn(b)
        b = rw.b
        b.NewStore(b.NewCall(rtCatFields, [b.NewLoad(i8ptr, listP), rw.v]), listP)
        var i
        for (i = 0; i < argTs.length; i++) {
            var ra = argTs[i].fn(b)
            b = ra.b
            b.NewStore(b.NewCall(rtCatFields, [b.NewLoad(i8ptr, listP), ra.v]), listP)
        }
        b = emitAbortCheck(b)
        var all = b.NewLoad(i8ptr, listP)
        var nf = b.NewCall(rtNFields, all)
        var nameV = b.NewCall(rtGetField, [all, zero])
        var restV = b.NewCall(rtSliceFields, [all, one, b.NewSub(nf, one), ifsFirstValue(b), zero])
        var done = curF.NewBlock("")
        // A command word that expands to NO field at all runs nothing and answers 0 - or the
        // status of the last command substitution it made (`$(exit 4)` answers 4), which is
        // already in $?. Twin of the empty arm of makeSimpleCommand in bash-interpreter.abnf.
        var haveB = curF.NewBlock(""), noneB = curF.NewBlock("")
        b.NewCondBr(b.NewICmp(llvm.enum.IPredSGT, nf, zero), haveB, noneB)
        if (!subs) { storeStatusI(noneB, 0) }
        noneB.NewBr(done)
        b = haveB
        var cands = []
        if (!noFn) { for (i = 0; i < declaredFuncList.length; i++) { cands.push(declaredFuncList[i]) } }
        cands = cands.concat(["echo", ":", "true", "false", "wait"])
        var ci
        for (ci = 0; ci < cands.length; ci++) {
            var cname = cands[ci]
            var hit = curF.NewBlock(""), miss = curF.NewBlock("")
            var same = b.NewCall(rtStreq, [nameV, gepStr(b, cname)])
            if (ci < cands.length - 5) { same = b.NewAnd(same, b.NewZExt(fnIsDefined(b, cname), i32)) }
            b.NewCondBr(b.NewICmp(llvm.enum.IPredNE, same, zero), hit, miss)
            var hb = hit
            if (ci < cands.length - 5) {
                var savedTop = slotOf(i32)
                var savedBase = slotOf(i32)
                var savedN = slotOf(i32)
                hb.NewStore(hb.NewLoad(i32, gArgvTop), savedTop)
                hb.NewStore(hb.NewLoad(i32, gFrameBase), savedBase)
                hb.NewStore(hb.NewLoad(i32, gFrameN), savedN)
                hb.NewCall(rtArgCall, restV)
                var base = hb.NewLoad(i32, savedTop)
                hb.NewStore(base, gFrameBase)
                hb.NewStore(hb.NewSub(hb.NewLoad(i32, gArgvTop), base), gFrameN)
                hb = emitFnCall(hb, cname)
                hb.NewStore(hb.NewLoad(i32, savedBase), gFrameBase)
                hb.NewStore(hb.NewLoad(i32, savedN), gFrameN)
                hb.NewStore(hb.NewLoad(i32, savedTop), gArgvTop)
                hb = emitExitCheck(hb)
            } else if (cname == "echo") {
                hb.NewCall(rtEcho, [restV, one, zero])
                storeStatusI(hb, 0)
            } else if (cname == "false") {
                storeStatusI(hb, 1)
            } else {
                storeStatusI(hb, 0)
            }
            hb.NewBr(done)
            b = miss
        }
        // Any other builtin is refused at run time, exiting with 127; any other name is the
        // literal path's "command not found" with the name from the expansion.
        var bltB = curF.NewBlock(""), nfB = curF.NewBlock("")
        b.NewCondBr(b.NewICmp(llvm.enum.IPredNE, b.NewCall(rtInWords, [nameV, gepStr(b, "\n" + shellKnownWords.join("\n") + "\n")]), zero), bltB, nfB)
        emitOnStderr(bltB, bltB.NewCall(rtStrcat, [bltB.NewCall(rtStrcat, [gepStr(bltB, c.file + ": a computed command name cannot run the builtin "), nameV]),
                                                   gepStr(bltB, "\n")]))
        bltB.NewStore(llvm.constant.NewInt(i32, 127), gExitCode)
        bltB.NewStore(one, gExited)
        bltB.NewBr(viaUnwind(curExit, curExitRd))
        emitDiag(nfB, nfB.NewCall(rtStrcat, [nameV, gepStr(nfB, ": command not found\n")]))
        storeStatusI(nfB, 127)
        nfB.NewBr(done)
        return done
    }

    // A RedirCommand's items in makeSimpleCommand's order: the first word moved to the front,
    // or `:` when there is none. Twin of redirCmdItems in bash-interpreter.abnf.
    function redirCmdItems(items) {
        var w = -1
        var i
        for (i = items.length - 1; i >= 0; i--) {
            if (items[i].rd == undefined) { w = i }
        }
        var out = [w < 0 ? makeConst(":") : items[w]]
        for (i = 0; i < items.length; i++) {
            if (i != w) { out.push(items[i]) }
        }
        return out
    }
    // `builtin NAME ARGS` and `command NAME ARGS` run NAME passing over the user functions.
    // With a literal NAME the wrapper word is dropped here, at compile time; `command -p` and
    // `--` mean nothing without a PATH search. No compiled program runs external programs, so
    // `command` of a name that is not a builtin is not found, and `builtin` of one is bash's
    // "not a shell builtin" (status 1). Twin of runWrapper in bash-interpreter.abnf.
    var shellBuiltins = {}
    var shellKnownWords = ". : [ alias bg bind break builtin caller cd command compgen complete compopt continue declare dirs disown echo enable eval exec exit export false fc fg getopts hash help history jobs kill let local logout mapfile popd printf pushd pwd read readarray readonly return set shift shopt source suspend test times trap true type typeset ulimit umask unalias unset wait".split(" ")
    var shellKwWords = "if then else elif fi case esac for select while until do done in function time { } ! [[ ]] coproc".split(" ")
    var swi
    for (swi = 0; swi < shellKnownWords.length; swi++) { shellBuiltins["$" + shellKnownWords[swi]] = true }
    function wrapperWords(w) {
        var out = {cmdT: w.cmdT, argTs: w.argTs, noFn: false, notBuiltin: null}
        while ((out.cmdT.c == "builtin" || out.cmdT.c == "command") && out.argTs.length > 0 && out.argTs[0].c != undefined) {
            var a = out.argTs[0].c
            if (out.cmdT.c == "command" && (a == "-p" || a == "--")) { out.argTs = out.argTs.slice(1); continue }
            if (a.length > 1 && a.charAt(0) == "-") { break }
            if (out.cmdT.c == "builtin" && !hasOwn(shellBuiltins, "$" + a)) { out.notBuiltin = a; break }
            out.noFn = true
            out.cmdT = out.argTs[0]
            out.argTs = out.argTs.slice(1)
        }
        return out
    }
