    }

    // ===================================================================================
    //  The string runtime: one `declare` per helper (see rtDecl), in this emitter's own i8*
    //  types. The BODIES are languages/lib/bash-rt.c.
    // ===================================================================================

    // i8* rt_bump(i32 n): return &arena[pos]; pos += n.
    var rtBump = rtDecl("rt_bump", true, [0])
    // i32 rt_strlen(i8* s)
