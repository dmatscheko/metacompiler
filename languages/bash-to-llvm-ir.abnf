        var run = inner
        if (redirs.length > 0) { run = function(b) {
            var cmk0 = cmdMark != null ? cmdMark : heapMark(b)
            var tdp0 = tmpDepth
            cmdMark = null
            tmpDepth = null
            var sv = emitOpenRedirs(b, redirs)
            var cmd0 = cmdT, args0 = argTs
            cmdT = preRedirWord(cmd0, sv)
            argTs = []
            var k
            for (k = 0; k < args0.length; k++) { argTs.push(preRedirWord(args0[k], sv)) }
            redirStack.push(sv)
            var gate = redirGate(sv.b, sv, [cmdT].concat(argTs))
            cmdMark = cmk0
            tmpDepth = tdp0
            b = inner(gate.run)
            redirStack.pop()
            cmdT = cmd0
            argTs = args0
            // `exec` with no command makes its redirections the shell's own: they stay in
            // effect until the ( ) or $( ) around it ends (saveOpts). Twin of the exec arm of
            // makeSimpleCommand in bash-interpreter.abnf.
            var isExec = cmd0.c == "exec" && args0.length == 0
            if (isExec && gate.skip != null) { emitCloseRedirs(gate.skip, sv) }
            b = redirJoin(b, gate)
            if (!isExec) { emitCloseRedirs(b, sv) } else { heapPin(b) }
            return b
        } }
        if (asgs == null) { return run }
        // The prefix assignments come AFTER the words, so no word sees them (`x=1; x=2 echo
        // $x` prints 1): every non-literal word is expanded up front and the command reads
        // the result. Then the assignments, undone after the command by the local save
        // stack, then the redirections, whose words do not see them either (prefixOuter).
        // Twin of makeSimpleCommand and applyPrefix in bash-interpreter.abnf.
        var asgConst = true
        var ai
        for (ai = 0; ai < asgs.length; ai++) { if (asgs[ai].val != null && asgs[ai].val.c == undefined) { asgConst = false } }
        return function(b) {
            var cmd0 = cmdT, args0 = argTs, redirs0 = redirs
            var mk0 = heapMark(b)
            var bx = {b: b}
            cmdT = expandedWord(bx, cmd0)
            argTs = []
            var k
            for (k = 0; k < args0.length; k++) { argTs.push(expandedWord(bx, args0[k])) }
            b = emitAbortCheck(bx.b)
            var olds = []
            if (redirs0.length > 0) { for (k = 0; k < asgs.length; k++) { olds.push(loadVar(b, asgs[k].aname)) } }
            var depth = slotOf(i32)
            b.NewStore(b.NewLoad(i32, gLsTop), depth)
