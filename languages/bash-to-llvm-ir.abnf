            b = bbox2.b
            // No compiled program runs external programs: any other name is bash's "NAME:
            // command not found", status 127, and the shell goes on. A builtin this compiler
            // does not build is refused instead. Twin of the end of runCommand in
            // bash-interpreter.abnf.
            if (hasOwn(shellBuiltins, "$" + cmd)) { fail("the " + cmd + " builtin is not supported") }
            emitDiag(b, gepStr(b, cmd + ": command not found\n"))
            storeStatusI(b, 127)
            return b
        }
        var run = inner
        if (redirs.length > 0) { run = function(b) {
            var cmk0 = cmdMark != null ? cmdMark : heapMark(b)
            var tdp0 = tmpDepth
            cmdMark = null
            tmpDepth = null
            var sv = emitOpenRedirs(b, redirs)
            var cmd0 = cmdT, args0 = argTs
            cmdT = preRedirWord(cmd0, sv)
            argTs = []
            var k
            for (k = 0; k < args0.length; k++) { argTs.push(preRedirWord(args0[k], sv)) }
            redirStack.push(sv)
            var gate = redirGate(sv.b, sv, [cmdT].concat(argTs))
            cmdMark = cmk0
            tmpDepth = tdp0
            b = inner(gate.run)
            redirStack.pop()
            cmdT = cmd0
            argTs = args0
            // `exec` with no command makes its redirections the shell's own: they stay in
            // effect until the ( ) or $( ) around it ends (saveOpts). Twin of the exec arm of
            // makeSimpleCommand in bash-interpreter.abnf.
            var isExec = cmd0.c == "exec" && args0.length == 0
            if (isExec && gate.skip != null) { emitCloseRedirs(gate.skip, sv) }
            b = redirJoin(b, gate)
