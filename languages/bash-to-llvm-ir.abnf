    // fields, joined onto the neighbouring text at the boundaries. One whose every part is
    // such a list, and empty, is NO field (`opened` stays 0): with no parameters `f "$@"`
    // passes nothing. Twin of mkDqWord in bash-interpreter.abnf.
    function mkDqWord(segs) {
        if (segs.length == 0) { return makeConst("") }
        var anyFields = false
        var i
        for (i = 0; i < segs.length; i++) { if (segs[i].f == true) { anyFields = true } }
        if (!anyFields) { return mkWord(segs) }
        return {c: undefined, f: true, fn: function(b) {
            // Quoted: a $* inside joins even within an unquoted ${x:-"$*"}.
            var svq = uqStarEmit
            uqStarEmit = false
            var acc = nilList(b)
            var open = emptyPtr(b)      // the field being built
            var opened = zero
            var k
            for (k = 0; k < segs.length; k++) {
                var r = segs[k].fn(b)
                b = r.b
                if (segs[k].f == true) {
                    var nacc = b.NewCall(rtBndAcc, [acc, open, r.v])
                    open = b.NewCall(rtBndOpen, [open, r.v])
                    opened = b.NewCall(rtBndOpened2, [opened, r.v, zero, zero])
                    acc = nacc
                } else {
                    open = b.NewCall(rtStrcat, [open, r.v])
                    opened = one
                }
            }
            uqStarEmit = svq
            var full = b.NewCall(rtFput, [acc, open])
            return {b: b, v: b.NewSelect(b.NewICmp(llvm.enum.IPredNE, opened, zero), full, acc)}
        }}
    }

    // The same segment list, read WITHOUT field splitting - the mode an assignment's right
    // hand side and a double-quoted word share. Dropping mkSplittable's mark is the whole
    // difference, so this delegates rather than duplicating mkDqWord's boundary handling.
    function unSplit(segs) {
        var out = []
        var i
        for (i = 0; i < segs.length; i++) {
            if (segs[i].sp != undefined) { out.push(segs[i].sp) } else { out.push(segs[i]) }
        }
        return out
