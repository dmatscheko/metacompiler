    var rtArrSet = rtDecl("rt_arr_set", false, [1, 1, 1])
    var rtArrGet = rtDecl("rt_arr_get", true, [1, 1])
    var rtArrHas = rtDecl("rt_arr_has", false, [1, 1])
    var rtArrDel = rtDecl("rt_arr_del", false, [1, 1])
    var rtArrAny = rtDecl("rt_arr_any", false, [1])
    var rtArrList = rtDecl("rt_arr_list", true, [1, 1, 0, 0])
    // The scalar-aware quartet, EXPANSION SITES ONLY - see languages/lib/bash-rt.c.
    var rtScGet = rtDecl("rt_sc_get", true, [1, 1])
    var rtScHas = rtDecl("rt_sc_has", false, [1, 1])
    var rtScCount = rtDecl("rt_sc_count", false, [1])
    var rtScList = rtDecl("rt_sc_list", true, [1, 1, 0, 0])
    var rtParams0 = rtDecl("rt_params0", true, [])
    var rtPfxNames = rtDecl("rt_pfxnames", true, [1, 1, 0])
    var rtDeclp = rtDecl("rt_declp", false, [1, 1, 0])
