    function lazyWord(b, take, w, dflt) {
        if (w.c != undefined) { return dflt ? dfltWordEmit(b, w) : evalWord(b, w) }
        var e = emptyPtr(b)
        var wB = curF.NewBlock(""), jB = curF.NewBlock("")
