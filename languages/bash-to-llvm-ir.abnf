        reSetF(snoq, hole2, 1, astart)
        snoq.NewRet(zero)

        reSetF(sopt, hole1, 0, reK(OP_SPLIT))
        reSetF(sopt, hole1, 1, hole2)
        reSetF(sopt, hole1, 2, sopt.NewLoad(i32, gRePc))
        reSetF(sopt, hole2, 1, astart)
        sopt.NewRet(zero)

        var pt = splus.NewCall(reMark)
        reSetF(splus, hole1, 1, hole2)
        reSetF(splus, hole2, 0, reK(OP_SAVE))
        reSetF(splus, hole2, 1, pt)
        splus.NewCall(reEmit, [reK(OP_PROG), pt, zero])
        var ps = splus.NewCall(reEmit, [reK(OP_SPLIT), hole2, zero])
        reSetF(splus, ps, 2, splus.NewLoad(i32, gRePc))
        splus.NewRet(zero)

