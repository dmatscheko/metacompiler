    function foldComma(items) {
        if (items.length == 1) { return items[0] }
        return function(b) {
            var v = zero64
            var i
            for (i = 0; i < items.length; i++) { var r = items[i](b); b = r.b; v = r.v }
            return {b: b, v: v}
        }
    }
    function foldPow(items, at) {
        if (items.length == 1) { return items[0] }
        var bt = items[0], et = items[2]
        var rc = arRecLa(at)
        return function(b) {
            var rb = bt(b)
            var re = et(rb.b)
            var bb = re.b
            return {b: bb, v: bb.NewCall(rtIpow, [rb.v, re.v, rc.ok ? gepStr(bb, rc.expr) : emptyPtr(bb),
