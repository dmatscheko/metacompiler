    var rtReplace = rtDecl("rt_replace", true, [1, 1, 1, 0])
    var rtCase = rtDecl("rt_case", true, [1, 0, 1])
    var rtShQuote = rtDecl("rt_shquote", true, [1])
    var rtAnsiC = rtDecl("rt_ansic", true, [1])
    var rtUnraw = rtDecl("rt_unraw", true, [1])
    var rtHasChar = rtDecl("rt_haschar", false, [1, 0])
