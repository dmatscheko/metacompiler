            // marked as prefix bindings (rt_push_tmp), and each hides an array of its name.
            // Twin of applyPrefix and runPrefixed.
            var isFn = cmd0.c != undefined && !noFn && funcFor(cmd0.c) != null
            var vals = []
            for (k = 0; k < asgs.length; k++) {
                var r = prefixVal(b, asgs[k])
                b = r.b
                var v = r.v
                // A readonly name keeps its value; the command still runs.
                if (roRefused(b, asgs[k].aname, "")) { vals.push(loadVar(b, asgs[k].aname)); continue }
                b.NewCall(isFn ? rtPushTmp : rtPushLocal, llvm.constant.NewInt(i32, getVarId(asgs[k].aname)))
                if (isFn) { b.NewCall(rtArrClear, gepStr(b, asgs[k].aname)) }
                // No attrCase: the binding takes no attributes. Twin of applyPrefix. Nothing
                // pins it: it is restored before the statement ends, and every release
                // during the command goes to a mark taken after it.
                storeVarRaw(b, asgs[k].aname, v)
                vals.push(v)
            }
            if (!asgConst) { b = emitAbortCheck(b) }
            if (redirs0.length > 0) {
                redirs = []
                for (k = 0; k < redirs0.length; k++) {
                    var rd = redirs0[k]
                    if (rd.target != null && rd.target.c == undefined) { rd = {rd: rd.rd, iofd: rd.iofd, target: prefixOuter(rd.target, asgs, olds)} }
                    redirs.push(rd)
                }
            }
