    function pushWords(ws) {
        var i
        for (i = 0; i < ws.length; i++) { push(ws[i]) }
    }
    function mkBraceAlts(items) {
        var alts = []
        var i
        for (i = 0; i < items.length; i++) { alts.push(items[i].alt) }
        return {alts: alts}
    }
    function isAlphaCh(cc) { return (cc >= 97 && cc <= 122) || (cc >= 65 && cc <= 90) }
    function numToStr(n) {
        var v = n | 0
        if (v == 0) { return "0" }
        var neg = false
        if (v < 0) { neg = true; v = (0 - v) | 0 }
        var out = ""
        while (v > 0) {
            var d = v % 10
            out = String.fromCharCode(48 + d) + out
            v = ((v - d) / 10) | 0
        }
        if (neg) { out = "-" + out }
        return out
    }
    function mkBraceRange(items) {
        var ends = []
        var step = 0
        var i
        for (i = 0; i < items.length; i++) {
            var it = items[i]
            if (it.rend != undefined) { ends.push(it.rend) } else { step = parseDec(it.rstep.slice(2)) }
        }
        var lo = ends[0], hi = ends[1]
        var alts = []
        var numeric = !(lo.length == 1 && isAlphaCh(lo.charCodeAt(0)))
        var a = numeric ? parseDec(lo) : lo.charCodeAt(0)
        var b = numeric ? parseDec(hi) : hi.charCodeAt(0)
        var st = (step != 0) ? step : 1
        if (st < 0) { st = (0 - st) | 0 }
