                    var res = arOp(r2.b, op, v, r2.v, r2.lit, rs[(i - 1) / 2])
                    bb = res.b
                    v = res.v
                }
            }
            return {b: bb, v: v}
        }
    }

    // ===================================================================================
    //  Statement / command thunks (bare functions):  function(b) -> continuation block.
    //  They keep the global last_status ($?) up to date.
    // ===================================================================================

    function storeStatus(b, v) { b.NewStore(v, gStatus) }
    function storeStatusI(b, n) { b.NewStore(llvm.constant.NewInt(i32, n), gStatus) }

    // items = [{aname}, {aidx}?, idxWord?, {aop2}, valueWord? | {arr}]
    function mkArrayKV(items) { return {kv: 1, key: items[0], val: items[1]} }
    function mkArrayLit(items) { return {arr: items} }
    function hasIdxMark(items) {
        var i
        for (i = 0; i < items.length; i++) { if (items[i].aidx != undefined) { return true } }
        return false
    }
    function parseAssign(items) {
        var name = items[0].aname
        var idxT = null, op = "=", valT = null, lit = null
        var wantIdx = hasIdxMark(items)
        var i
        for (i = 1; i < items.length; i++) {
            var it = items[i]
            if (it.fn != undefined) {
                if (wantIdx && idxT == null && valT == null && op == "=") { idxT = it } else { valT = it }
            }
            else if (it.aop2 != undefined) { op = it.aop2 }
            else if (it.arr != undefined) { lit = it.arr }
        }
        return {name: name, idxT: idxT, op: op, valT: valT, lit: lit}
    }
    // An array literal element list; a bare word contributes one element per FIELD. Every
    // word is expanded BEFORE the array is cleared: f=([5]=x "${f[@]}") reads the old f.
    function emitArrayLit(b, name, litItems, append, assoc) {
        var nm = gepStr(b, name)
        var vals = []
        var i
        for (i = 0; i < litItems.length; i++) {
            var it = litItems[i]
            if (it.kv != undefined) {
                var rk = it.key.fn(b); b = rk.b
                var rv = it.val.fn(b); b = rv.b
                vals.push({k: wordJoin(b, rk.v), v: wordJoin(b, rv.v)})
            } else {
                var rw = it.fn(b); b = rw.b
                vals.push({k: null, v: rw.v})
            }
        }
        b = emitAbortCheck(b)
        // A replacing literal drops a scalar of the name; an appending one keeps it as element 0.
        if (!append) { b.NewCall(rtArrClear, nm); storeVarRaw(b, name, unsetPtr(b)) }
        else if (!assoc) { b.NewCall(rtArrAdopt, [nm, llvm.constant.NewInt(i32, getVarId(name))]) }
        // A literal makes the name a SET array even with no element (rt_arr_mark).
        b.NewCall(rtArrMark, nm)
        // Bare words in an ASSOCIATIVE array literal are KEY VALUE pairs - bash 5.3.15 reads
        // `declare -A b=(one two three four)` as b[one]=two b[three]=four, and a trailing odd word
        // takes an empty value.
        if (assoc) {
            var pendKey = null
            var abox = {b: b}
            for (i = 0; i < vals.length; i++) {
                if (vals[i].k != null) { emitElemSet(abox, name, nm, vals[i].k, null, vals[i].v, true, null); continue }
                var w = wordJoin(abox.b, vals[i].v)
                if (pendKey == null) { pendKey = w } else { emitElemSet(abox, name, nm, pendKey, null, w, true, null); pendKey = null }
            }
            if (pendKey != null) { emitElemSet(abox, name, nm, pendKey, null, emptyPtr(abox.b), true, null) }
            return abox.b
        }
        // In an INDEXED literal a bare word takes the index after the element before it
        // (b=([3]=c [1]=a b) is 1 2 3 = a b c), so the next index is threaded through
        // rt_arr_litkey / rt_arr_litwords. Twin of applyArrayLit in bash-interpreter.abnf.
        var next = append ? b.NewCall(rtArrNext, nm) : zero64
        var at = elemAttrs(name)
        var atC = llvm.constant.NewInt(i32, at)
        for (i = 0; i < vals.length; i++) {
            if (vals[i].k != null) { next = b.NewCall(rtArrLitKey, [nm, vals[i].k, vals[i].v, next, atC]) }
            else { next = b.NewCall(rtArrLitWords, [nm, vals[i].v, next, atC]) }
        }
        // -i stops the literal at an element that is an arithmetic error, which then
        // abandons the line.
        return (at & 1) != 0 ? emitAbortCheck(b) : b
    }
    // An expansion error in a value abandons the command before anything is stored:
    // `k=$(( 1/0 ))` leaves k as it was. Twin of runAssign in bash-interpreter.abnf.
    function emitAssign(b, a, assoc0, mk) {
        // Associative-ness is a property of the NAME (declare -A), not of this statement.
        var assoc = assoc0 || hasOwn(assocArrays, "$" + a.name)
        var nm = gepStr(b, a.name)
        var viaRef = attrOn(refVars, a.name)
        if (viaRef && (a.lit != null || a.idxT != null)) { refFail() }
        var al = refAlias(a.name)
        if (al != null) { return emitAssign(b, {name: al, op: a.op, idxT: null, lit: null, valT: a.valT}, assoc0, mk) }
        if (a.lit != null) { return emitArrayLit(b, a.name, a.lit, a.op == "+=", assoc) }
        var v = emptyPtr(b)
        if (a.valT != null) {
            var r = a.valT.fn(b)
            b = r.b
            v = (a.valT.f == true) ? wordJoin(b, r.v) : r.v
            if (a.valT.c == undefined && a.valT.done != true) { b = emitAbortCheck(b) }
        }
        if (viaRef) {
            var tg = gepStr(b, a.name)
            if (a.op == "+=") { v = b.NewCall(rtStrcat, [b.NewCall(rtGetByName, tg), v]) }
            b.NewCall(rtSetByName, [tg, v])
            return emitAbortCheck(b)
        }
        if (a.idxT != null) {
            var rk = subKeyOf(b, a.name, a.idxT, null)
            b = rk.b
            b = emitAbortCheck(b)
            if (!assoc) { b.NewCall(rtArrAdopt, [nm, llvm.constant.NewInt(i32, getVarId(a.name))]) }
            var ebox = {b: b}
            emitElemSet(ebox, a.name, nm, rk.k, (a.op == "+=") ? b.NewCall(rtArrGet, [nm, rk.k]) : null, v, assoc, mk)
            return ebox.b
        }
        // On an array name, a scalar assignment is to element 0 and `+=` appends to its text
        // (bash 5.3 answers `abd c` for e=(ab c); e+=d), both under the array's attributes.
        var arrB = curF.NewBlock(""), strB = curF.NewBlock(""), mg = curF.NewBlock("")
        brIfArray(b, nm, arrB, strB)
        var e0 = gepStr(arrB, "0")
        var e0box = {b: arrB}
        emitElemSet(e0box, a.name, nm, e0, (a.op == "+=") ? arrB.NewCall(rtArrGet, [nm, e0]) : null, v, assoc, mk)
        e0box.b.NewBr(mg)
        b = strB
        // `declare -i n` makes n=EXPR evaluate EXPR as arithmetic, and n+=EXPR an arithmetic ADD
        // (n=3; n+=4 is 7), not a concatenation. A literal right hand side is parsed with this
        // grammar and emitted as ordinary IR; an expanded one is read by rt_arith at run time.
        if (attrOn(intVars, a.name) && a.valT != null) {
            var rv = null
            if (a.valT.c != undefined) {
                var ra = arCompile("$((" + a.valT.c + "))", "ArIAsg", false)(b)
                b = ra.b
                rv = ra.v
            } else {
                rv = b.NewCall(rtArith, v)
            }
            if (a.op == "+=") { rv = b.NewAdd(b.NewCall(rtStr2int, loadVar(b, a.name)), rv) }
            b = emitAbortCheck(b)
            storeVar(b, a.name, heapKeep(b, mk, a.name, b.NewCall(rtInt2str, rv)))
        } else if (a.op == "+=") {
