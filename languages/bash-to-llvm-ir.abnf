NotPlus  = :script(~~ (function() { if (c.peek(0) === 43 || c.peek(0) === 61) { return abnf.newToken("\x01plus", 0) } })() ~~) ;
NotMinus = :script(~~ (function() { if (c.peek(0) === 45 || c.peek(0) === 61) { return abnf.newToken("\x01minus", 0) } })() ~~) ;

