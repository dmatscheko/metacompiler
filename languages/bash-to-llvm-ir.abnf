    var rtShq = rtDecl("rt_shq", true, [1, 0])
    var rtDeclAsg = rtDecl("rt_declasg", true, [1, 1, 1, 0])
    var rtDeclXa = rtDecl("rt_declxa", true, [1, 1, 1, 0, 0, 1, 0])
    var rtDeclPos = rtDecl("rt_declpos", true, [1, 1, 0])
    var rtKvq = rtDecl("rt_kvq", true, [1, 0])
    var rtKvp = rtDecl("rt_kvp", true, [1, 1, 0])
    var rtAttrf = rtDecl("rt_attrf", true, [1, 1, 1, 0])
    var rtPrompt = rtDecl("rt_prompt", true, [1])
    var rtArrNext = rtDecl("rt_arr_nextidx", 3, [1])
