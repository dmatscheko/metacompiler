                b = emitAbortCheck(b)
                var evBad = curF.NewBlock(""), evOk = curF.NewBlock("")
                b.NewCondBr(b.NewICmp(llvm.enum.IPredNE, b.NewCall(rtEvalAssign, acc), zero), evBad, evOk)
                emitOnStderr(evBad, evBad.NewCall(rtStrcat, [evBad.NewCall(rtStrcat, [gepStr(evBad, c.file + ": eval: only assignments can be compiled from a computed string: "), acc]),
                                                             gepStr(evBad, "\n")]))
                evBad.NewStore(llvm.constant.NewInt(i32, 2), gExitCode)
                evBad.NewStore(one, gExited)
                evBad.NewBr(viaUnwind(curExit, curExitRd))
                storeStatusI(evOk, 0)
                return evOk
            }
            if (cmd == "read") { return emitRead(b, argTs, cmk) }
            if (cmd == "mapfile" || cmd == "readarray") { return emitMapfile(b, cmd, argTs) }
            if (cmd == "shift") {
                var sn = one
                if (argTs.length > 0) {
                    var rs2 = evalWord(b, argTs[0])
                    b = rs2.b
                    sn = s2i(b, rs2.v)
                }
                b.NewStore(b.NewAdd(b.NewLoad(i32, gFrameBase), sn), gFrameBase)
                b.NewStore(b.NewSub(b.NewLoad(i32, gFrameN), sn), gFrameN)
                storeStatusI(b, 0)
                return b
            }
            // unset [-f] [-v] [-n] NAME...: the options are literal words. Twin of the unset
            // arm of runCommand in bash-interpreter.abnf.
            if (cmd == "unset") {
