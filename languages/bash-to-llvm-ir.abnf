    // which bash still writes in the UTF-8 pattern (six bytes at most, none from 2^31) - raw
    // bytes. Twin of rt_utf8put in lib/bash-rt.c.
    function ucsChr(cp) {
        if (cp < 55296 || (cp > 57343 && cp < 65536)) { return String.fromCharCode(cp) }
        if (cp >= 65536 && cp < 1114112) {
            var off = cp - 65536
            return String.fromCharCode(55296 + (off - off % 1024) / 1024) + String.fromCharCode(56320 + off % 1024)
        }
        if (cp >= 2147483648) { return "" }
        var n = 3
        while (n < 6 && cp >= Math.pow(2, 5 * n + 1)) { n = n + 1 }
        var tail = ""
        var k
        for (k = 1; k < n; k++) { tail = escByte(128 + cp % 64) + tail; cp = (cp - cp % 64) / 64 }
        return escByte(256 - Math.pow(2, 8 - n) + cp) + tail
