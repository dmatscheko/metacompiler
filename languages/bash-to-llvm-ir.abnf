            // The attribute undo record is owed to a SUBSHELL as well as to a function body:
            // `n=5; ( declare -i n; n=2+3 )` leaves n a plain string. -g does not exempt it, which is
            // why subDepth is tested beside `localize` and not inside it.
            if (subDepth > 0 && !(localize && curFrame != null)) { attrPushUndo(names[j]) }
            if (localize && curFrame != null) {
