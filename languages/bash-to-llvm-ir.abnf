                var tb = cl.body(bodies[i])
                if (cl.cterm == ";;&") { tb.NewBr(nextB) }
                else if (cl.cterm == ";&" && i + 1 < clauses.length) { tb.NewBr(bodies[i + 1]) }
                else { tb.NewBr(merge) }
                b = nextB
            }
            storeStatusI(b, 0)
            b.NewBr(merge)
            return merge
        }
    }

    // <<DELIM / <<-DELIM: split the token HdScan read back into marker and body. Twin of
    // mkHereDoc in bash-interpreter.abnf; see there.
    function mkHereDoc(text, at) {
        var i = 2
        var dashed = false
        if (text.charAt(i) == "-") { dashed = true; i = i + 1 }
        var b0 = text.indexOf("\x02")
        var w = text.slice(i, b0)
        var quoted = w.indexOf("'") >= 0 || w.indexOf("\"") >= 0 || w.indexOf("\\") >= 0
        var body = text.slice(b0 + 1, text.length - 1)
        if (dashed) { body = stripLeadingTabs(body) }
        var t = quoted ? makeConst(body) : compileHereBody(body, srcLine(at - text.length))
        return {rd: "<<", iofd: "", target: t}
    }
    function stripLeadingTabs(b) {
        var out = ""
        var atLineStart = true
        var i
        for (i = 0; i < b.length; i++) {
