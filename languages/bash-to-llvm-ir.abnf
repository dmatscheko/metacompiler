    // by name. `char *gvars[1024]` is `[1024 x i32*]` there and `[1024 x i8*]` here - the same
    // size and stride; llvmlink.go checks the sizes match.
    var gStatus = rtGlobal("last_status", i32)   // $?
    var gExited = rtGlobal("exited", i32)        // set by `exit`
    var gExitCode = rtGlobal("exit_code", i32)

    // A real "" at a NONZERO address. The IR interpreter traps loads at address 0, so an
    // empty / unset value must be a genuine pointer to a NUL byte, never a null pointer.
    var emptyTy = llvm.types.NewArray(1, i8)
    var gEmpty = rtGlobal("empty", emptyTy)
    function emptyPtr(b) { return b.NewGetElementPtr(emptyTy, gEmpty, zero, zero) }

    // A SECOND empty string, at a different address: the "variable is unset" marker. It reads
    // as "" everywhere (so no expansion has to special case it), but a pointer comparison
    // against it answers ${v-default} / ${v:+alt} and friends.
    var gUnset = rtGlobal("unset_marker", emptyTy)
    function unsetPtr(b) { return b.NewGetElementPtr(emptyTy, gUnset, zero, zero) }
    // The empty field list. A list is known by its address, not its first byte (rt_islist).
    var nilTy = llvm.types.NewArray(2, i8)
    var gListNil = rtGlobal("list_nil", nilTy)
    function nilList(b) { return b.NewGetElementPtr(nilTy, gListNil, zero, zero) }

    // Variable storage is ONE global array of char*, indexed by a compile-time id, so the
    // `local` unwinder can restore a slot chosen at run time (a per-name global could only
    // be reached through a generated dispatch).
    var NVARS = 1024
    var gvarsTy = llvm.types.NewArray(NVARS, i8ptr)
    var gVars = rtGlobal("gvars", gvarsTy)
    // The {name, slot} table beside it: varnames[i] is the source name of gvars[i]. Only
    // the emitter knows the names, so main's entry block fills it - and that one table is
    // what lets rt_getvar_byname / rt_setvar_byname / rt_eval_assign live in bash-rt.c
    // instead of being generated as a three-fold chain over every name in the program.
    var gVarNames = rtGlobal("varnames", gvarsTy)

    var varIds = {}       // "$"+name -> slot index
    var varIdList = []    // index -> name (creation order, for the deterministic init run)
    function getVarId(name) {
        var key = "$" + name
        if (hasOwn(varIds, key)) { return varIds[key] }
        var id = varIdList.length
        if (id >= NVARS) { fail("too many distinct variables (limit " + NVARS + ")") }
        varIds[key] = id
        varIdList.push(name)
        return id
    }
    function varPtr(b, name) {
        return b.NewGetElementPtr(gvarsTy, gVars, zero, llvm.constant.NewInt(i32, getVarId(name)))
    }
    function varSlot(b, idx) {
        return b.NewGetElementPtr(gvarsTy, gVars, zero, idx)
    }
    function loadVar(b, name) { return b.NewLoad(i8ptr, varPtr(b, name)) }
