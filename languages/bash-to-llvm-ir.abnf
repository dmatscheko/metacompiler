            var merge = curF.NewBlock("")
            var i
            var bodies = []
            for (i = 0; i < clauses.length; i++) { bodies.push(curF.NewBlock("")) }
            for (i = 0; i < clauses.length; i++) {
                var cl = clauses[i]
                var nextB = curF.NewBlock("")
                var k
                // The patterns are expanded in turn up to the first that matches.
                for (k = 0; k < cl.pats.length; k++) {
                    var rp = evalWord(b, cl.pats[k])
                    b = caseWordCheck(rp.b, cl.pats[k])
                    var missB = (k + 1 < cl.pats.length) ? curF.NewBlock("") : nextB
                    b.NewCondBr(b.NewICmp(llvm.enum.IPredNE, b.NewCall(rtGlob, [rp.v, subj]), zero), bodies[i], missB)
                    b = missB
                }
