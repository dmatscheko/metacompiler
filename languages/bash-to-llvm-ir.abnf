                        var onB = curF.NewBlock(""), offB = curF.NewBlock("")
                        b.NewCondBr(b.NewICmp(llvm.enum.IPredNE, b.NewLoad(i32, trapList[ti].flag), zero), onB, offB)
                        onB.NewCall(rtPrints, onB.NewCall(rtStrcat, [onB.NewCall(rtStrcat, [gepStr(onB, "trap -- "),
                            onB.NewCall(rtShQuote, gepStr(onB, trapList[ti].src))]), gepStr(onB, " EXIT\n")]))
                        onB.NewBr(offB)
                        b = offB
                    }
