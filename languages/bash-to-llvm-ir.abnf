            var empty = null
            if (cmdT.pv != undefined && cmd0.f == true) { empty = b.NewICmp(llvm.enum.IPredEQ, b.NewCall(rtNFields, cmdT.pv), zero) }
            cmdMark = mk0
            tmpDepth = isFn ? depth : null
            // eval runs its string with each binding hiding its name's array and attributes,
            // as a function body does. Twin of runPrefixed in bash-interpreter.abnf.
            var hid = []
            if (!isFn && cmd0.c == "eval") {
