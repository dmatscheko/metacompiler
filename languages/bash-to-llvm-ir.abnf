                    // g=1+1; }` prints 1+1, and `arr=(a b); f(){ local arr=Q; }` sees a
                    // one-element array. rt_push_local has just saved all of it for the return.
                    intVars["$" + names[j]] = false
                    upVars["$" + names[j]] = false
                    loVars["$" + names[j]] = false
                }
                if (integer) { intVars["$" + names[j]] = true }
                if (upper) { upVars["$" + names[j]] = true; loVars["$" + names[j]] = false }
                if (lower) { loVars["$" + names[j]] = true; upVars["$" + names[j]] = false }
                // A global `declare -a a` keeps a's elements; only a value or a local starts empty.
                if ((isArray && asgs[j] != null) || (localize && curFrame != null)) { b.NewCall(rtArrClear, gepStr(b, names[j])) }
                if (isArray && asgs[j] == null) { b.NewCall(rtArrDmark, gepStr(b, names[j])) }
                if (asgs[j] != null) {
                    b = emitAssign(b, asgs[j], assoc)
                }
                else if (localize && !isArray) { storeVarRaw(b, names[j], unsetPtr(b)) }
                if (asgs[j] == null && !isArray && kw != "export" && kw != "readonly") { b.NewCall(rtArrSmark, gepStr(b, names[j])) }
            }
            storeStatusI(b, 0)
            return b
        }
    }
    // A declaration CARRYING ITS OWN redirections. The declaration items are the ones
    // makeDecl understands; anything else on the stack is a redirection record and is
    // handed to mkRedirected, exactly as makeSubshellR / makeGroupR do it.
    function makeDeclR(items) {
        var core = []
        var reds = []
        var i
        for (i = 0; i < items.length; i++) {
            var it = items[i]
            if (it.dkw != undefined || it.dflag != undefined || it.dname != undefined || it.a != undefined) { core.push(it) }
            else { reds.push(it) }
        }
        if (reds.length == 0) { return makeDecl(core) }
        var wrapped = [makeDecl(core)]
        for (i = 0; i < reds.length; i++) { wrapped.push(reds[i]) }
        return mkRedirected(wrapped)
    }
    function mkDeclItem(items) { return {a: parseAssign(items)} }
    // ---- variable attributes -------------------------------------------------------------
    // These maps are COMPILE-TIME and filled at EMIT time, in source order, so a name becomes an
    // integer at its `declare -i` and not for the whole file. makeFuncDef unwinds every attribute
    // a function body set (`declare -i` inside a function is function-local in bash).
    //
    // LIMIT: bash's attributes are DYNAMICALLY scoped; here they are LEXICAL (no runtime attribute
    // table, and an integer assignment's right hand side is emitted as IR). The interpreter is
    // dynamic; the two agree whenever an attribute is declared and used in the same function.
    var intVars = {}      // names declared with `declare -i`
    var upVars = {}       // `declare -u`
    var loVars = {}       // `declare -l`
    var assocArrays = {}  // names declared with `declare -A` / `local -A`
    var assocList = []    // the same names in order, registered with the runtime (rt_assoc_add)
    // An attribute map holds FALSE for a name whose attribute was dropped - by `unset`, or by
    // a function body ending - so membership alone is not the answer.
    function attrOn(m, name) {
        var k = "$" + name
        if (!hasOwn(m, k)) { return false }
        return m[k]
    }
    // The SCALAR attribute letters of a name, in bash's own order (i, l, u; the array letter
    // goes in front of them): `declare -iu n` prints `declare -iu`.
    function scalarAttrLetters(name) {
        var out = ""
        if (attrOn(intVars, name)) { out = out + "i" }
        if (attrOn(loVars, name)) { out = out + "l" }
        if (attrOn(upVars, name)) { out = out + "u" }
        return out
    }
    // The undo log makeFuncDef unwinds: one entry per name declared inside a function body or a
    // ( LIST ) / $( LIST ) (counted by subDepth). The ASSOCIATIVE flag is deliberately NOT in it:
    // assocArrays is a whole-program fact (see makeDecl), matched by the interpreter's assocSeen.
    var subDepth = 0
    var attrUndo = []
    function attrPushUndo(name) {
        attrUndo.push({name: name, i: attrOn(intVars, name), u: attrOn(upVars, name), l: attrOn(loVars, name)})
    }
    function attrUnwind(base) {
        while (attrUndo.length > base) {
            var e = attrUndo.pop()
            intVars["$" + e.name] = e.i
            upVars["$" + e.name] = e.u
            loVars["$" + e.name] = e.l
        }
    }

    // After a call that might transitively `exit`, bail out to the current function's exit.
    function emitExitCheck(b) {
        var isEx = b.NewICmp(llvm.enum.IPredNE, b.NewLoad(i32, gExited), zero)
        var cont = curF.NewBlock("")
        b.NewCondBr(isEx, viaUnwind(curExit, curExitRd), cont)
        return cont
    }

    // THE WORD OF ${v-w} / ${v+w} IS EXPANDED WITH ITS OWN QUOTING. Quoted, the ${...} is
    // one more quoted text and its fields survive ("${x:-$@}" is still a list). Unquoted,
    // the word's unquoted parts are split and its quoted parts are not (its `spw` form,
    // mkBraceWord), and the fields that makes are FINAL: rt_finlist marks the list so
    // the enclosing word does not split it again (rt_uqlist). The expansion is marked f.
    // Twin of dfltWord in bash-interpreter.abnf.
    function dfltWordEmit(b, w) {
        if (!uqStarEmit || w.spw == undefined) { return w.fn(b) }
        var r = w.spw.fn(b)
        return {b: r.b, v: r.b.NewCall(rtFinList, [r.v])}
    }
    // A ${v-w} word: the unsplit word every use reads, carrying in `spw` the form whose
    // unquoted parts (BraceUq) split, for dfltWordEmit.
    function mkBraceWord(items) {
        var ns = []
        var sp = []
        for (var i = 0; i < items.length; i++) {
            var it = items[i]
            if (it.uq != undefined) { ns.push(it.uq); sp.push(mkSplittable(it.uq)) }
            else { ns.push(it); sp.push(it) }
        }
        var w = mkWord(ns)
        return {s: w.s, f: w.f, c: w.c, fn: w.fn, spw: mkWord(sp)}
    }
    // Evaluate ONE word to a single string: a word that can produce several fields is
    // flattened (space-joined), which is what every builtin with a fixed argument list wants.
    function evalWord(b, w) {
        var svq = uqStarEmit
        uqStarEmit = false
        var r = w.fn(b)
        uqStarEmit = svq
        if (w.f == true) { return {b: r.b, v: r.b.NewCall(rtWordJoin, r.v)} }
        return r
    }
    // Evaluate argument word objects in order, threading b via a box; returns [{v, c}].
    function evalArgs(bbox, args) {
        var out = []
        var i
        for (i = 0; i < args.length; i++) {
            var r = evalWord(bbox.b, args[i])
            bbox.b = r.b
            out.push({v: r.v, c: args[i].c})
        }
        return out
    }

    // An echo option word is "-" and one or more of n e E (`-en` = `-e -n`); answers its
    // letters, or "" for an ordinary word. Twin of echoFlags in bash-interpreter.abnf and
    // echo_flags in languages/lib/bash-rt.c.
    function echoFlags(a) {
        if (a.length < 2 || a.charAt(0) != "-") { return "" }
        var j
        for (j = 1; j < a.length; j++) {
            var f = a.charAt(j)
            if (f != "n" && f != "e" && f != "E") { return "" }
        }
        return a.slice(1)
    }
    function emitEcho(b, args) {
        var start = 0, newline = true, escapes = false
        var flagging = true
        var runtimeFlags = false
        while (flagging && start < args.length) {
            var fa = args[start].c
            if (fa == undefined) { runtimeFlags = true; flagging = false }
            else if (echoFlags(fa) == "") { flagging = false }
            else {
                var fl = echoFlags(fa)
                var fj
                for (fj = 0; fj < fl.length; fj++) {
                    if (fl.charAt(fj) == "n") { newline = false } else { escapes = (fl.charAt(fj) == "e") }
                }
                start = start + 1
            }
        }
        // A flag can come out of an expansion (`opts="-n"; echo $opts x`). When the scan stops on a
        // non-constant word, the flag scan happens at RUN time over the fields (rt_echo); the constant
        // path stays because it is the common case and emits no call. `echo -e` always goes to
        // rt_echo: its \c ends all further output.
        if (runtimeFlags || escapes) {
            var ei
            var acc = nilList(b)
            // NOT evalWord: that JOINS a field list into one word, and the whole point
            // here is that `a=(-n hi); echo "${a[@]}"` hands echo two words and bash reads
            // the first as a flag. rt_catfields takes a plain string as one field, so the
            // non-splitting words need no special case.
            for (ei = start; ei < args.length; ei++) {
                var re = args[ei].fn(b)
                b = re.b
                acc = b.NewCall(rtCatFields, [acc, re.v])
            }
            b = emitAbortCheck(b)
            b.NewCall(rtEcho, [acc, llvm.constant.NewInt(i32, newline ? 1 : 0),
                               llvm.constant.NewInt(i32, escapes ? 1 : 0)])
            storeStatusI(b, 0)
            return b
        }
        // Evaluate every word first, then check the set -u abort, then print: printing as each word
        // is evaluated would write `set -u; echo "${nope}"`'s newline before the abort is seen
        // (bash prints nothing). The interpreter checks abortSignal at the same point.
        var i
        var vals = []
        for (i = start; i < args.length; i++) {
            var r = evalWord(b, args[i])
            b = r.b
            vals.push(r.v)
        }
        b = emitAbortCheck(b)
        for (i = 0; i < vals.length; i++) {
            if (i > 0) { b.NewCall(rtPrints, gepStr(b, " ")) }
            b.NewCall(rtPrints, vals[i])
        }
        if (newline) { b.NewCall(rtPutc, llvm.constant.NewInt(i32, 10)) }
        storeStatusI(b, 0)
        return b
    }

    // ---- the test builtin ------------------------------------------------------------
    // The operand VALUES are runtime i8*, but the operators are literals, so the argument
    // list is parsed into an expression at COMPILE time and lowered without any branching:
    // every leaf yields an i32 status (0 true / 1 false), `-a` is a bitwise or of the two
    // statuses, `-o` a bitwise and, and `!` an xor with 1.
    //
    // There is no real filesystem behind a compiled run either, so the file predicates go
    // through rt_fskind, a model of the standard paths (see bash-interpreter.abnf).
    var rtFskind = rtDecl("rt_fskind", false, [1])

    // "name" or "name[key]"
    // A subscript text that is already a canonical index needs no evaluation.
    function isIndexLit(t) {
        if (t.length == 0 || t.length > 15 || (t.charAt(0) == "0" && t.length > 1)) { return false }
        var i
        for (i = 0; i < t.length; i++) { var cc = t.charCodeAt(i); if (cc < 48 || cc > 57) { return false } }
        return true
    }
    // A subscript word and the key it names, {b, v: text, k: key}: an associative array's key
    // is the text, an indexed array's the value of the text as an arithmetic expression
    // (rt_arr_key, negative from the end). Evaluated ONCE per use, so `${a[i++]}` steps i once.
    // A literal subscript that is a canonical index needs no evaluation, and one that is a
    // plain variable name reads that variable's slot directly.
    function subKeyOf(b, name, w) {
        var r = evalWord(b, w)
        var key = r.v
        if (hasOwn(assocArrays, "$" + name)) { key = r.v }
        else if (w.c != undefined && isIndexLit(w.c)) { key = gepStr(r.b, w.c) }
        else if (w.c != undefined && isIdentText(w.c)) {
            // (a name declared associative later in the file is still a literal key)
            var bb = r.b
            var isA = bb.NewICmp(llvm.enum.IPredNE, bb.NewCall(rtIsAssoc, gepStr(bb, name)), zero)
            var ib = curF.NewBlock(""), jb = curF.NewBlock("")
            bb.NewCondBr(isA, jb, ib)
            var ik = ib.NewCall(rtArrIkey, [gepStr(ib, name), ib.NewCall(rtArith, varString(ib, w.c))])
            ib.NewBr(jb)
            key = jb.NewPhi([llvm.ir.NewIncoming(r.v, bb), llvm.ir.NewIncoming(ik, ib)])
            return {b: jb, v: r.v, k: key}
        }
        else { key = r.b.NewCall(rtArrKey, [gepStr(r.b, name), r.v]) }
        return {b: r.b, v: r.v, k: key}
    }
    function isIdentText(t) {
        if (t.length == 0) { return false }
        var i
        for (i = 0; i < t.length; i++) {
            var cc = t.charCodeAt(i)
            var al = (cc >= 97 && cc <= 122) || (cc >= 65 && cc <= 90) || cc == 95
            if (!al && !(i > 0 && cc >= 48 && cc <= 57)) { return false }
        }
        return true
    }
    // The same for a literal subscript text (unset 'a[k]', [[ -v a[k] ]]).
    function litKeyOf(b, name, t) {
        if (hasOwn(assocArrays, "$" + name) || isIndexLit(t)) { return gepStr(b, t) }
        return b.NewCall(rtArrKey, [gepStr(b, name), gepStr(b, t)])
    }
    function splitSubscript(s0) {
        var i
        for (i = 0; i < s0.length; i++) {
            if (s0.charAt(i) == "[" && s0.charAt(s0.length - 1) == "]") {
                return {name: s0.slice(0, i), key: s0.slice(i + 1, s0.length - 1)}
            }
        }
        return {name: s0, key: null}
    }

    function isTestUnary(t) {
        if (t == "-z" || t == "-n" || t == "-v") { return true }
        if (t == "-e" || t == "-f" || t == "-d" || t == "-s" || t == "-r" || t == "-w") { return true }
        if (t == "-x" || t == "-h" || t == "-L" || t == "-b" || t == "-c" || t == "-p") { return true }
        if (t == "-S" || t == "-t" || t == "-g" || t == "-u" || t == "-k" || t == "-O") { return true }
        return false
    }
    function isTestBinary(t) {
        if (t == "=" || t == "==" || t == "!=" || t == "<" || t == ">") { return true }
        if (t == "-eq" || t == "-ne" || t == "-lt" || t == "-le" || t == "-gt" || t == "-ge") { return true }
        if (t == "-nt" || t == "-ot" || t == "-ef") { return true }
        return false
    }
    function isEmptyStr(b, v) { return b.NewICmp(llvm.enum.IPredEQ, b.NewCall(rtStrlen, v), zero) }
    function isNonEmptyStr(b, v) { return b.NewICmp(llvm.enum.IPredNE, b.NewCall(rtStrlen, v), zero) }
    function boolStatus(b, i1) { return b.NewSelect(i1, zero, one) }

    function testUnaryIR(b, op, arg) {
        if (op == "-z") { return boolStatus(b, isEmptyStr(b, arg.v)) }
        if (op == "-n") { return boolStatus(b, isNonEmptyStr(b, arg.v)) }
        if (op == "-v") {
            if (arg.c == undefined) { fail("test -v needs a literal variable name in this compiler") }
            var sv = splitSubscript(arg.c)
            if (sv.key != null) {
                return boolStatus(b, b.NewICmp(llvm.enum.IPredNE,
                    b.NewCall(rtArrHas, [gepStr(b, sv.name), litKeyOf(b, sv.name, sv.key)]), zero))
            }
            var setScalar = b.NewICmp(llvm.enum.IPredNE, loadVar(b, arg.c), unsetPtr(b))
            var setArray = b.NewICmp(llvm.enum.IPredNE, b.NewCall(rtArrAny, gepStr(b, arg.c)), zero)
            return boolStatus(b, b.NewOr(setScalar, setArray))
        }
        var k = b.NewCall(rtFskind, arg.v)
        // The model and the predicate table are documented at fsKind in
        // languages/bash-interpreter.abnf, including why a real stat() was declined.
        var two = llvm.constant.NewInt(i32, 2)
        if (op == "-d") { return boolStatus(b, b.NewICmp(llvm.enum.IPredEQ, k, two)) }
        if (op == "-e" || op == "-r" || op == "-w") { return boolStatus(b, b.NewICmp(llvm.enum.IPredNE, k, zero)) }
        if (op == "-f") { return boolStatus(b, b.NewICmp(llvm.enum.IPredEQ, k, one)) }
        if (op == "-s") { return boolStatus(b, b.NewOr(b.NewICmp(llvm.enum.IPredEQ, k, one),
                                                      b.NewICmp(llvm.enum.IPredEQ, k, two))) }
        if (op == "-x") { return boolStatus(b, b.NewICmp(llvm.enum.IPredEQ, k, two)) }
        if (op == "-c") { return boolStatus(b, b.NewICmp(llvm.enum.IPredEQ, k, llvm.constant.NewInt(i32, 3))) }
        return one
    }
    // A numeric operand of test: rt_str2int's value, read at compile time when the word is a
    // literal decimal number that a double holds exactly.
    function testInt(b, w) {
        var t = w.c
        if (t == undefined) { return b.NewCall(rtStr2int, w.v) }
        var i = (t.charAt(0) == "-" || t.charAt(0) == "+") ? 1 : 0
        if (t.length == i || t.length - i > 15) { return b.NewCall(rtStr2int, w.v) }
        var n = 0
        var j
        for (j = i; j < t.length; j++) {
            var cc = t.charCodeAt(j)
            if (cc < 48 || cc > 57) { return b.NewCall(rtStr2int, w.v) }
            n = n * 10 + (cc - 48)
        }
        return llvm.constant.NewInt(i64, (t.charAt(0) == "-") ? -n : n)
    }
    function testBinaryIR(b, l, op, r) {
        if (op == "=" || op == "==") { return boolStatus(b, b.NewICmp(llvm.enum.IPredNE, b.NewCall(rtStreq, [l.v, r.v]), zero)) }
        if (op == "!=") { return boolStatus(b, b.NewICmp(llvm.enum.IPredEQ, b.NewCall(rtStreq, [l.v, r.v]), zero)) }
        if (op == "<") { return boolStatus(b, b.NewICmp(llvm.enum.IPredSLT, b.NewCall(rtStrcmp, [l.v, r.v]), zero)) }
        if (op == ">") { return boolStatus(b, b.NewICmp(llvm.enum.IPredSGT, b.NewCall(rtStrcmp, [l.v, r.v]), zero)) }
        var il = testInt(b, l), ir = testInt(b, r)
        if (op == "-eq") { return boolStatus(b, b.NewICmp(llvm.enum.IPredEQ, il, ir)) }
        if (op == "-ne") { return boolStatus(b, b.NewICmp(llvm.enum.IPredNE, il, ir)) }
        if (op == "-lt") { return boolStatus(b, b.NewICmp(llvm.enum.IPredSLT, il, ir)) }
        if (op == "-le") { return boolStatus(b, b.NewICmp(llvm.enum.IPredSLE, il, ir)) }
        if (op == "-gt") { return boolStatus(b, b.NewICmp(llvm.enum.IPredSGT, il, ir)) }
        if (op == "-ge") { return boolStatus(b, b.NewICmp(llvm.enum.IPredSGE, il, ir)) }
        fail("unsupported binary test operator (must be a literal): " + op)
        return one
    }

    // The literal text of argument st.i, or a sentinel for "runtime value" / "past the end".
    function tcAt(a, st) {
        if (st.i >= a.length) { return "\x00end" }
        if (a[st.i].c == undefined) { return "\x00val" }
        return a[st.i].c
    }
    function tcPrim(b, a, st) {
        var t = tcAt(a, st)
        if (t == "(") {
            st.i = st.i + 1
            var r = tcOr(b, a, st)
            if (tcAt(a, st) == ")") { st.i = st.i + 1 }
            return r
        }
        if (t == "!") {
            st.i = st.i + 1
            return b.NewXor(tcPrim(b, a, st), one)
        }
        if (isTestUnary(t) && st.i + 1 < a.length && !isTestBinary(tcNext(a, st))) {
            var opnd = a[st.i + 1]
            st.i = st.i + 2
            return testUnaryIR(b, t, opnd)
        }
        var lhs = a[st.i]
        st.i = st.i + 1
        if (st.i + 1 < a.length && isTestBinary(tcAt(a, st))) {
            var op = tcAt(a, st)
            var rhs = a[st.i + 1]
            st.i = st.i + 2
            return testBinaryIR(b, lhs, op, rhs)
        }
        return boolStatus(b, isNonEmptyStr(b, lhs.v))
    }
    function tcNext(a, st) {
        if (st.i + 1 >= a.length) { return "\x00end" }
        if (a[st.i + 1].c == undefined) { return "\x00val" }
        return a[st.i + 1].c
    }
    function tcAnd(b, a, st) {
        var v = tcPrim(b, a, st)
        while (tcAt(a, st) == "-a") { st.i = st.i + 1; v = b.NewOr(v, tcPrim(b, a, st)) }
        return v
    }
    function tcOr(b, a, st) {
        var v = tcAnd(b, a, st)
        while (tcAt(a, st) == "-o") { st.i = st.i + 1; v = b.NewAnd(v, tcAnd(b, a, st)) }
        return v
    }

    function emitTest(b, cmd, args) {
        var a = args
        if (cmd == "[") {
            if (a.length == 0 || a[a.length - 1].c != "]") { fail("[ used without the closing ]") }
            a = a.slice(0, a.length - 1)
        }
        var bbox = {b: b}
        var vals = evalArgs(bbox, a)
        b = bbox.b
        if (vals.length == 0) { storeStatusI(b, 1); return b }
        if (vals.length == 1) {
            storeStatus(b, boolStatus(b, isNonEmptyStr(b, vals[0].v)))
            return b
        }
        var st = {i: 0}
        storeStatus(b, tcOr(b, vals, st))
        return b
    }

    // ---- pipelines, subshells, groups, (( )), [[ ]], redirections ----

    function makePipeline(items) {
        var bang = false
        var stages = []
        var i
        for (i = 0; i < items.length; i++) {
            var it = items[i]
            if (typeof it == "function") { stages.push(it) } else { bang = true }
        }
        if (!bang && stages.length == 1) { return stages[0] }
        return function(b) {
            var ff = slotOf(i32)
            b.NewStore(zero, ff)
            var psName = gepStr(b, "PIPESTATUS")
            b.NewCall(rtArrClear, psName)
            // a pipeline rebinds standard input for its stages only
            var savedIn = slotOf(i8ptr), savedInPos = slotOf(i32)
            b.NewStore(b.NewLoad(i8ptr, gStdin), savedIn)
            b.NewStore(b.NewLoad(i32, gStdinPos), savedInPos)
            var k
            for (k = 0; k < stages.length; k++) {
                var isLast = (k == stages.length - 1)
                if (!isLast) { b.NewCall(rtCapBegin, zero) }
                b = isLast ? stages[k](b) : emitCond(stages[k], b)
                if (!isLast) {
                    b.NewStore(b.NewCall(rtCapEnd, zero), gStdin)
                    b.NewStore(zero, gStdinPos)
                }
                var stv = b.NewLoad(i32, gStatus)
                b.NewCall(rtArrSet, [psName, gepStr(b, numToStr(k)), i2s(b, stv)])
                var fail0 = b.NewICmp(llvm.enum.IPredEQ, b.NewLoad(i32, ff), zero)
                var bad = b.NewAnd(fail0, b.NewICmp(llvm.enum.IPredNE, stv, zero))
                b.NewStore(b.NewSelect(bad, stv, b.NewLoad(i32, ff)), ff)
            }
            b.NewStore(b.NewLoad(i8ptr, savedIn), gStdin)
            b.NewStore(b.NewLoad(i32, savedInPos), gStdinPos)
            // set -o pipefail: the pipeline reports the first failing stage.
            var st0 = b.NewLoad(i32, gStatus)
            var usePf = b.NewAnd(b.NewICmp(llvm.enum.IPredNE, b.NewLoad(i32, gOptPf), zero),
                                 b.NewICmp(llvm.enum.IPredEQ, st0, zero))
            storeStatus(b, b.NewSelect(usePf, b.NewLoad(i32, ff), st0))
            if (bang) {
                storeStatus(b, b.NewSelect(b.NewICmp(llvm.enum.IPredEQ, b.NewLoad(i32, gStatus), zero), one, zero))
            }
            return b
        }
    }

    // ( LIST ) : the variable array is snapshotted and restored, and an `exit` inside branches
    // to the subshell's own end block instead of the enclosing function's.
    function makeSubshell(bodyT) {
        return function(b) {
            b.NewCall(rtSsSave, zero)
            var optSave = saveOpts(b)
            var savedExit = curExit, savedExitRd = curExitRd
            var savedTraps = trapList
            trapList = []
            var subEnd = curF.NewBlock("")
            curExit = subEnd
            curExitRd = redirStack.length
            var undoBase = attrUndo.length
            subDepth = subDepth + 1
            var eb = bodyT(b)
            subDepth = subDepth - 1
            attrUnwind(undoBase)
            eb.NewBr(subEnd)
            curExit = savedExit
            curExitRd = savedExitRd
            var myTraps = trapList
            trapList = savedTraps
            subEnd = emitTraps(subEnd, myTraps)
            var wasEx = subEnd.NewICmp(llvm.enum.IPredNE, subEnd.NewLoad(i32, gExited), zero)
            var st = subEnd.NewSelect(wasEx, subEnd.NewLoad(i32, gExitCode), subEnd.NewLoad(i32, gStatus))
            subEnd.NewStore(zero, gExited)
            subEnd.NewCall(rtSsRestore, zero)
            restoreOpts(subEnd, optSave)
            subEnd.NewStore(st, gStatus)
            return subEnd
        }
    }
    function makeGroup(bodyT) { return bodyT }

    // ( LIST ) and { LIST; } carry their own [ RedirList ], so they take takeAll() +
    // mkRedirected exactly like CompoundRedir (`{ echo A; } >&2` sends A to fd 2).
    function withRedirs(bodyT, items) {
        var wrapped = [bodyT]
        var i
        for (i = 1; i < items.length; i++) { wrapped.push(items[i]) }
        return mkRedirected(wrapped)
    }
    function makeSubshellR(items) { return withRedirs(makeSubshell(items[0]), items) }
    function makeGroupR(items) { return withRedirs(makeGroup(items[0]), items) }

    function makeArithCmd(exprT0) {
        var exprT = arIn("((: ", exprT0)
        return function(b) {
            var r = exprT(b)
            b = r.b
            var st = b.NewSelect(b.NewICmp(llvm.enum.IPredNE, r.v, zero64), zero, one)
            storeStatus(b, b.NewSelect(takeArithErr(b), one, st))
            return b
        }
    }
    // let EXPR ... : status from the LAST expression; the first error stops the command. The
    // arguments are all expanded before any is evaluated (x=1; `let x=5 y=$x` sets y=1). A word
    // argument ({letws}) becomes a field list that rt_letfields evaluates field by field; when
    // every argument is a word they are one list, whose emptiness is "expression expected".
    // Twin of makeLetCmd in bash-interpreter.abnf.
    function makeLetCmd(items) {
        var args = []
        var redirs = []
        var words = []
        var nstatic = 0
        var i
        for (i = 0; i < items.length; i++) {
            var it = items[i]
            if (typeof it == "function") { args.push(it); nstatic = nstatic + 1 }
            else if (it.letws != undefined) {
                args.push(it)
                var j
                for (j = 0; j < it.letws.length; j++) { words.push(it.letws[j]) }
            }
            else { redirs.push(it) }
        }
        if (nstatic == 0) { args = [{letws: words}] }
        var need = (nstatic == 0) ? one : zero
        var core = function(b) {
            var lists = []
            var k
            for (k = 0; k < args.length; k++) {
                var list = zero64
                if (typeof args[k] != "function") {
                    list = nilList(b)
                    var w
                    for (w = 0; w < args[k].letws.length; w++) {
                        var rw = args[k].letws[w].fn(b)
                        b = rw.b
                        list = b.NewCall(rtCatFields, [list, rw.v])
                    }
                }
                lists.push(list)
            }
            b = emitAbortCheck(b)
            var endB = curF.NewBlock("")
            var inc = []
            b.NewStore(gepStr(b, "let: "), gArPfx)
            for (k = 0; k < args.length; k++) {
                var v = zero64
                if (typeof args[k] == "function") { var r = args[k](b); b = r.b; v = r.v }
                else { v = b.NewCall(rtLetFields, [lists[k], need]) }
                inc.push(llvm.ir.NewIncoming(v, b))
                if (k + 1 < args.length) {
                    var nb = curF.NewBlock("")
                    b.NewCondBr(b.NewICmp(llvm.enum.IPredNE, b.NewLoad(i32, gArithErr), zero), endB, nb)
                    b = nb
                } else {
                    b.NewBr(endB)
                }
            }
            b = endB
            var last = b.NewPhi(inc)
            b.NewStore(emptyPtr(b), gArPfx)
            var st = b.NewSelect(b.NewICmp(llvm.enum.IPredNE, last, zero64), zero, one)
            storeStatus(b, b.NewSelect(takeArithErr(b), one, st))
            return b
        }
        var wrapped = [core]
        for (i = 0; i < redirs.length; i++) { wrapped.push(redirs[i]) }
        return mkRedirected(wrapped)
    }

    // [[ ... ]] : the condition thunks answer an i32 boolean (1 = true).
    function makeCondCmd(t) {
        return function(b) {
            b.NewStore(zero, gCondErr)
            var r = t(b)
            b = r.b
            // 0 true, 1 false, 2 the condition could not be evaluated (a bad =~ pattern).
            var err = b.NewICmp(llvm.enum.IPredNE, b.NewLoad(i32, gCondErr), zero)
            var tf = b.NewSelect(b.NewICmp(llvm.enum.IPredNE, r.v, zero), zero, one)
            tf = b.NewSelect(takeArithErr(b), one, tf)
            storeStatus(b, b.NewSelect(err, llvm.constant.NewInt(i32, 2), tf))
            return b
        }
    }
    function foldCondOr(items) {
        if (items.length == 1) { return items[0] }
        return function(b) {
            var v = zero
            var i
            for (i = 0; i < items.length; i++) { var r = items[i](b); b = r.b; v = b.NewOr(v, r.v) }
            return {b: b, v: v}
        }
    }
    function foldCondAnd(items) {
        if (items.length == 1) { return items[0] }
        return function(b) {
            var v = one
            var i
            for (i = 0; i < items.length; i++) { var r = items[i](b); b = r.b; v = b.NewAnd(v, r.v) }
            return {b: b, v: v}
        }
    }
    function mkCondNot(t) {
        return function(b) { var r = t(b); return {b: r.b, v: r.b.NewXor(r.v, one)} }
    }
    function mkCondSingle(w) {
        return function(b) {
            var r = evalWord(b, w)
            return {b: r.b, v: r.b.NewZExt(isNonEmptyStr(r.b, r.v), i32)}
        }
    }
    function mkCondUn(items) {
        var op = items[0].cop
        var w = items[1]
        return function(b) {
            var r = evalWord(b, w)
            b = r.b
            var st = testUnaryIR(b, op, {v: r.v, c: w.c})
            return {b: b, v: b.NewZExt(b.NewICmp(llvm.enum.IPredEQ, st, zero), i32)}
        }
    }
    // A quoted part of a [[ ]] pattern is literal: escape its glob metacharacters.
    // Make every ERE metacharacter of s literal (a quoted part of a =~ regex); rt_rxescape
    // is the run-time half. Twin of regexEscape in bash-interpreter.abnf.
    function regexEscape(s0) {
        var out = ""
        var i
        for (i = 0; i < s0.length; i++) {
            var ch = s0.charAt(i)
            if ("\\.[]()*+?{}|^$".indexOf(ch) >= 0) { out = out + "\\" }
            out = out + ch
        }
        return out
    }
    // A quoted part of a ${v/p/r} replacement: its "&" and "\" are literal; rt_repescape is
    // the run-time half. Twin of repEscape in bash-interpreter.abnf.
    function repEscape(s0) {
        var out = ""
        var i
        for (i = 0; i < s0.length; i++) {
            var ch = s0.charAt(i)
            if (ch == "&" || ch == "\\") { out = out + "\\" }
            out = out + ch
        }
        return out
    }
    function mkQuotedRep(t) {
        return {c: undefined, fn: function(b) {
            var r = evalWord(b, t)
            return {b: r.b, v: r.b.NewCall(rtRepEsc, r.v)}
        }}
    }
    function mkQuotedRx(t) {
        return {c: undefined, fn: function(b) {
            var r = evalWord(b, t)
            return {b: r.b, v: r.b.NewCall(rtRxEsc, r.v)}
        }}
    }
    function mkQuotedPat(t) {
        return {c: undefined, fn: function(b) {
            var r = evalWord(b, t)
            return {b: r.b, v: r.b.NewCall(rtGlobEsc, r.v)}
        }}
    }
    function globEscape(s0) {
        var out = ""
        var i
        for (i = 0; i < s0.length; i++) {
            var ch = s0.charAt(i)
            if (ch == "*" || ch == "?" || ch == "[" || ch == "]" || ch == "\\") { out = out + "\\" }
            out = out + ch
        }
        return out
    }
    // [[ STR =~ ERE ]] : the match itself is one call; the work here is turning its answer
    // into BASH_REMATCH and into the three statuses bash distinguishes (0 match, 1 no match,
    // 2 the regex could not be used at all).
    var NCAPPAIRS = 64
    var capsTy = llvm.types.NewArray(NCAPPAIRS * 2, i32)
    function mkCondMatch(items) {
        var lw = items[0], rw = items[2]
        return function(b) {
            var rl = evalWord(b, lw); b = rl.b
            var rr = evalWord(b, rw); b = rr.b
            var subj = rl.v
            var caps = slotOf(capsTy)
            var capsPtr = b.NewGetElementPtr(capsTy, caps, zero, zero)
            var resP = slotOf(i32)
            var ip = slotOf(i32)
            b.NewStore(zero, resP)
            var nm = gepStr(b, "BASH_REMATCH")
            // No flags: bash's =~ is a POSIX ERE where ^ and $ anchor the whole subject and
            // "." does not cross a newline, and nocasematch is off.
            var n = b.NewCall(rtRegexSearch, [rr.v, subj, llvm.constant.NewNull(i8ptr),
                                              capsPtr, llvm.constant.NewInt(i32, NCAPPAIRS * 2)])
            var errB = curF.NewBlock(""), okB = curF.NewBlock("")
            var badPat = curF.NewBlock(""), overrun = curF.NewBlock("")
            var matchB = curF.NewBlock(""), fillH = curF.NewBlock(""), fillB = curF.NewBlock("")
            var merge = curF.NewBlock("")
            b.NewCondBr(b.NewICmp(llvm.enum.IPredSLT, n, zero), errB, okB)

            // -1 / -2: status 2, a diagnostic on standard error, and the shell carries on.
            errB.NewStore(llvm.constant.NewInt(i32, 2), gCondErr)
            errB.NewCondBr(errB.NewICmp(llvm.enum.IPredEQ, n, llvm.constant.NewInt(i32, -1)), badPat, overrun)
            // rt_regex_error allocates per call, so it is called once, here.
            emitOnStderr(badPat, badPat.NewCall(rtStrcat,
                [gepStr(badPat, "bash: [[: invalid regular expression: "),
                 badPat.NewCall(rtStrcat, [badPat.NewCall(rtRegexError), gepStr(badPat, "\n")])]))
            badPat.NewBr(merge)
            emitOnStderr(overrun, gepStr(overrun, "bash: [[: regular expression step limit exceeded\n"))
            overrun.NewBr(merge)

            // BASH_REMATCH is rebuilt only when the pattern COULD be used: a match fills
            // it and a failed match empties it, but a pattern that would not compile
            // leaves the previous match in place - which is what real bash does, and
            // why the clear lives here and not before the search.
            okB.NewCall(rtArrClear, nm)
            okB.NewCondBr(okB.NewICmp(llvm.enum.IPredEQ, n, zero), merge, matchB)
            matchB.NewStore(one, resP)
            matchB.NewStore(zero, ip)
            matchB.NewBr(fillH)
            // BASH_REMATCH[0] is the whole match, [i] the i-th group. The TRUE pair count is
            // reported even when it exceeds the caps array, so the entries past it are the
            // empty string rather than missing - ${#BASH_REMATCH[@]} stays exact.
            var i = fillH.NewLoad(i32, ip)
            fillH.NewCondBr(fillH.NewICmp(llvm.enum.IPredSLT, i, n), fillB, merge)
            var inRange = fillB.NewICmp(llvm.enum.IPredSLT, i, llvm.constant.NewInt(i32, NCAPPAIRS))
            var idx = fillB.NewSelect(inRange, i, zero)
            var two2 = llvm.constant.NewInt(i32, 2)
            var bgn = fillB.NewLoad(i32, fillB.NewGetElementPtr(capsTy, caps, zero, fillB.NewMul(idx, two2)))
            var end = fillB.NewLoad(i32, fillB.NewGetElementPtr(capsTy, caps, zero,
                        fillB.NewAdd(fillB.NewMul(idx, two2), one)))
            var have = fillB.NewAnd(inRange, fillB.NewICmp(llvm.enum.IPredSGE, bgn, zero))
            var piece = fillB.NewCall(rtSubstr, [subj, bgn, fillB.NewSub(end, bgn)])
            fillB.NewCall(rtArrSet, [nm, i2s(fillB, i),
                                     fillB.NewSelect(have, piece, emptyPtr(fillB))])
            fillB.NewStore(fillB.NewAdd(i, one), ip)
            fillB.NewBr(fillH)

            return {b: merge, v: merge.NewLoad(i32, resP)}
        }
    }
    // Write a diagnostic on the standard error CHANNEL without disturbing the caller's
    // redirections: routing it through the channel rather than straight to fd 2 is what makes
    // `cmd 2>/dev/null` silence it exactly as the shell does.
    function emitOnStderr(b, msg) {
        var saved = b.NewLoad(i32, gSinkOut)
        b.NewStore(b.NewLoad(i32, gSinkErr), gSinkOut)
        b.NewCall(rtPrints, msg)
        b.NewStore(saved, gSinkOut)
    }

    function mkCondBin(items) {
        var lw = items[0], op = items[1].cop, rw = items[2]
        return function(b) {
            var rl = evalWord(b, lw); b = rl.b
            var rr = evalWord(b, rw); b = rr.b
            // == and != glob-match their right hand side inside [[ ]]; = is a synonym of ==.
            if (op == "==" || op == "=") { return {b: b, v: b.NewCall(rtGlobX, [rr.v, rl.v])} }
            if (op == "!=") { return {b: b, v: b.NewXor(b.NewCall(rtGlobX, [rr.v, rl.v]), one)} }
            if (op == "=~") { fail("[[ =~ ]] (regex matching) is not supported") }
            // The numeric tests evaluate BOTH sides as arithmetic expressions inside [[ ]].
            // Twin of mkCondBin in bash-interpreter.abnf.
            var npred = condNumPred(op)
            if (npred != null) {
                b.NewStore(gepStr(b, "[[: "), gArPfx)
                var al = b.NewCall(rtArith, rl.v)
                var ar = b.NewCall(rtArith, rr.v)
                b.NewStore(emptyPtr(b), gArPfx)
                return {b: b, v: b.NewZExt(b.NewICmp(npred, al, ar), i32)}
            }
            var st = testBinaryIR(b, {v: rl.v, c: lw.c}, op, {v: rr.v, c: rw.c})
            return {b: b, v: b.NewZExt(b.NewICmp(llvm.enum.IPredEQ, st, zero), i32)}
        }
    }

    function condNumPred(op) {
        if (op == "-eq") { return llvm.enum.IPredEQ }
        if (op == "-ne") { return llvm.enum.IPredNE }
        if (op == "-lt") { return llvm.enum.IPredSLT }
        if (op == "-le") { return llvm.enum.IPredSLE }
        if (op == "-gt") { return llvm.enum.IPredSGT }
        if (op == "-ge") { return llvm.enum.IPredSGE }
        return null
    }
    function mkRedir(items) {
        var op = "", fd = "", t = null
        var i
        for (i = 0; i < items.length; i++) {
            var it = items[i]
            if (it.fn != undefined) { t = it }
            else if (it.redir != undefined) { op = it.redir }
            else if (it.iofd != undefined) { fd = it.iofd }
        }
        return {rd: op, iofd: fd, target: t}
    }
    // eval / trap re-parse a string with THIS grammar, starting at CompoundList (which pushes
    // one statement-sequence thunk); the thunk that comes back is emitted inline.
    function compileSnippet(src) {
        return arCompile(src, "CompoundList", false)
    }

    // printf [-v NAME] [--] FORMAT [ARG...]: the whole command runs in rt_printf
    // (languages/lib/bash-rt.c), so the format may come out of an expansion and `%*d` takes
    // its width from an operand; printf_rc is its status. Twin of printfBuiltin in
    // languages/bash-interpreter.abnf, which documents the conversions.
    function emitPrintf(b, args) {
        var a = args
        var dest = null
        if (a.length >= 2 && a[0].c == "-v") { dest = a[1].c; a = a.slice(2) }
        if (a.length > 0 && a[0].c == "--") { a = a.slice(1) }
        if (a.length == 0) { storeStatusI(b, 0); return b }
        var rf = evalWord(b, a[0])
        b = rf.b
        // The operands as ONE field list: an unquoted operand is field-split, so the number of
        // operands is a run-time fact (`x="  a   b  "; printf '%s|' $x` prints `a|b|`).
        var listV = nilList(b)
        var i
        for (i = 1; i < a.length; i++) {
            var rw = a[i].fn(b)
            b = rw.b
            listV = b.NewCall(rtCatFields, [listV, rw.v])
        }
        b = emitAbortCheck(b)
        var out = b.NewCall(rtPrintf, [rf.v, listV])
        if (dest != null) { storeVar(b, dest, b.NewCall(rtPfValue, out)) } else { b.NewCall(rtPfOut, out) }
        storeStatus(b, b.NewLoad(i32, gPrintfRc))
        return b
    }

    // read [-r] NAME... : one line of standard input, split on IFS, the last name taking the
    // rest. An empty IFS (IFS= read) means no splitting at all; an UNSET IFS is the default.
    function emitRead(b, args) {
        var names = []
        var arrName = null
        var i = 0
        while (i < args.length) {
            var a = args[i].c
            if (a == undefined) { fail("read needs literal variable names in this compiler") }
            if (a == "-a") { i = i + 1; if (i < args.length) { arrName = args[i].c }; i = i + 1; continue }
            if (a == "-d" || a == "-n" || a == "-N" || a == "-p" || a == "-t" || a == "-u") { i = i + 1 }
            else if (a.length > 1 && a.charAt(0) == "-") { }
            else { names.push(a) }
            i = i + 1
        }
        // NO NAMES AT ALL: bash assigns the line to REPLY "without the ending delimiter but
        // otherwise unmodified" - not field 0, and not stripped.
        var rawReply = (arrName == null && names.length == 0)
        var line = b.NewCall(rtReadLine, zero)
        var eof = b.NewICmp(llvm.enum.IPredNE, b.NewLoad(i32, gReadEof), zero)
        var eofB = curF.NewBlock(""), okB = curF.NewBlock(""), merge = curF.NewBlock("")
        b.NewCondBr(eof, eofB, okB)
        var k
        for (k = 0; k < names.length; k++) { storeVar(eofB, names[k], emptyPtr(eofB)) }
        if (rawReply) { storeVar(eofB, "REPLY", emptyPtr(eofB)) }
        if (arrName != null) { eofB.NewCall(rtArrClear, gepStr(eofB, arrName)) }
        eofB.NewStore(one, gStatus)
        eofB.NewBr(merge)
        var ifsRaw = loadVar(okB, "IFS")
        var ifs = okB.NewSelect(okB.NewICmp(llvm.enum.IPredEQ, ifsRaw, unsetPtr(okB)), gepStr(okB, " \t\n"), ifsRaw)
        if (arrName != null) {
            okB.NewCall(rtArrClear, gepStr(okB, arrName))
            okB.NewCall(rtArrAppend, [gepStr(okB, arrName), okB.NewCall(rtSplitIfs, [line, ifs])])
        }
        if (rawReply) { storeVar(okB, "REPLY", line) }
        for (k = 0; k < names.length; k++) {
            var isLast = (k == names.length - 1) ? 1 : 0
            storeVar(okB, names[k], okB.NewCall(rtField, [line, ifs, llvm.constant.NewInt(i32, k),
                                                          llvm.constant.NewInt(i32, isLast)]))
        }
        okB.NewStore(zero, gStatus)
        okB.NewBr(merge)
        return merge
    }

    // set [-e|+e] [-u|+u] [-o pipefail|+o pipefail]: the flags are runtime globals, so
    // set +e later in the program really does turn errexit back off.
    function emitSet(b, args) {
        var i = 0
        while (i < args.length) {
            if (i >= args.length) { i = args.length }
            var a = args[i].c
            if (a == undefined) { fail("set needs literal option words in this compiler") }
            if (a == "-o" || a == "+o") {
                var on = (a == "-o") ? one : zero
                if (i + 1 < args.length) {
                    var nm = args[i + 1].c
                    if (nm == "pipefail") { b.NewStore(on, gOptPf) }
                    if (nm == "errexit") { b.NewStore(on, gOptE) }
                    if (nm == "nounset") { b.NewStore(on, gOptU) }
                    i = i + 1
                }
            } else if (a == "--") {
                // Rebind the positional parameters: push the remaining words as a new frame.
                var base = b.NewLoad(i32, gArgvTop)
                var j
                for (j = i + 1; j < args.length; j++) {
                    var ra = args[j].fn(b)
                    b = ra.b
                    b.NewCall(rtArgPush, ra.v)
                }
                b.NewStore(base, gFrameBase)
                b.NewStore(b.NewSub(b.NewLoad(i32, gArgvTop), base), gFrameN)
                i = args.length
            } else if (a.length > 1 && (a.charAt(0) == "-" || a.charAt(0) == "+")) {
                var on2 = (a.charAt(0) == "-") ? one : zero
                var k
                for (k = 1; k < a.length; k++) {
                    var f = a.charAt(k)
                    if (f == "e") { b.NewStore(on2, gOptE) }
                    if (f == "u") { b.NewStore(on2, gOptU) }
                }
            }
            i = i + 1
        }
        storeStatusI(b, 0)
        return b
    }

    // An error an expansion raised, checked before the command runs. set -u and ${v:?} end
    // the (sub)shell (exited 1); an arithmetic or substring error abandons the command line
    // (exited 2, which a subshell treats as any exit and a top-level line catches - see
    // runProgram). Both leave status 1. Twin of takeAbort in bash-interpreter.abnf.
    function emitAbortCheck(b) {
        var ab = b.NewLoad(i32, gAbort)
        var isAb = b.NewICmp(llvm.enum.IPredNE, ab, zero)
        var isAr = b.NewICmp(llvm.enum.IPredNE, b.NewLoad(i32, gArithErr), zero)
        var kill = curF.NewBlock(""), cont = curF.NewBlock("")
        b.NewCondBr(b.NewOr(isAb, isAr), kill, cont)
        kill.NewStore(zero, gAbort)
        kill.NewStore(zero, gArithErr)
        kill.NewStore(one, gExitCode)
        kill.NewStore(kill.NewSelect(isAb, one, llvm.constant.NewInt(i32, 2)), gExited)
        kill.NewBr(viaUnwind(curExit, curExitRd))
        return cont
    }
    // A command that evaluates arithmetic ITSELF ((( )), let, [[ -eq ]], for (( ))) fails
    // with status 1 on an error instead: this answers whether one was raised, and clears it.
    function takeArithErr(b) {
        var e = b.NewICmp(llvm.enum.IPredNE, b.NewLoad(i32, gArithErr), zero)
        b.NewStore(zero, gArithErr)
        return e
    }
    // set -e: leave on a failing command, unless it is running as a condition.
    function emitErrExitCheck(b) {
        if (condDepth > 0) { return b }
        var st = b.NewLoad(i32, gStatus)
        var bad = b.NewAnd(b.NewICmp(llvm.enum.IPredNE, b.NewLoad(i32, gOptE), zero),
                           b.NewICmp(llvm.enum.IPredNE, st, zero))
        var kill = curF.NewBlock(""), cont = curF.NewBlock("")
        b.NewCondBr(bad, kill, cont)
        kill.NewStore(st, gExitCode)
        kill.NewStore(one, gExited)
        kill.NewBr(viaUnwind(curExit, curExitRd))
        return cont
    }
    // Emit a thunk as a CONDITION.
    function emitCond(t, b) {
        condDepth = condDepth + 1
        var nb = t(b)
        condDepth = condDepth - 1
        return nb
    }
    // A subshell must restore the shell OPTIONS as well as the variables (set -e inside
    // $( ) does not leak out), so they are stashed in allocas around the body.
    function saveOpts(b) {
        var se = slotOf(i32), su = slotOf(i32), sp = slotOf(i32), sx = slotOf(i32)
        b.NewStore(b.NewLoad(i32, gOptE), se)
        b.NewStore(b.NewLoad(i32, gOptU), su)
        b.NewStore(b.NewLoad(i32, gOptPf), sp)
        b.NewStore(b.NewLoad(i32, gOptExtglob), sx)
        return {e: se, u: su, pf: sp, x: sx}
    }
    function restoreOpts(b, sv) {
        b.NewStore(b.NewLoad(i32, sv.e), gOptE)
        b.NewStore(b.NewLoad(i32, sv.u), gOptU)
        b.NewStore(b.NewLoad(i32, sv.pf), gOptPf)
        b.NewStore(b.NewLoad(i32, sv.x), gOptExtglob)
    }
    // `shopt` knows extglob (-s / -u / -q); every other option is accepted and reported as
    // success, and a -q query of one answers "on". Only LITERAL words are read. Twin of the
    // shopt arm of runCommand in bash-interpreter.abnf.
    function emitShopt(b, argTs) {
        var flag = ""
        var st = zero
        var i
        for (i = 0; i < argTs.length; i++) {
            var a = argTs[i].c
            if (a == "-s" || a == "-u" || a == "-q") { flag = a }
            else if (a == "extglob") {
                if (flag == "-s") { b.NewStore(one, gOptExtglob) }
                if (flag == "-u") { b.NewStore(zero, gOptExtglob) }
                if (flag == "-q") { st = b.NewSelect(b.NewICmp(llvm.enum.IPredNE, b.NewLoad(i32, gOptExtglob), zero), zero, one) }
            }
        }
        storeStatus(b, st)
        return b
    }

    // Emit the EXIT traps a (sub)shell registered, each behind its own flag.
    function emitTraps(b, list) {
        var i
        for (i = 0; i < list.length; i++) {
            var tr = list[i]
            var run = curF.NewBlock(""), skip = curF.NewBlock("")
            b.NewCondBr(b.NewICmp(llvm.enum.IPredNE, b.NewLoad(i32, tr.flag), zero), run, skip)
            run.NewStore(zero, tr.flag)
            var rb = tr.body(run)
            rb.NewBr(skip)
            b = skip
        }
        return b
    }

    // A command name that comes out of an expansion (`cmd="echo hi"; $cmd`): the command word
    // is field-split and the extra fields become the first arguments. The name is known only at
    // RUN time, so the dispatch is a chain of string compares over echo, the three trivial
    // builtins and every user function. LIMIT: builtins compiled from a literal argument list
    // (printf, test/[, read, eval, set, trap, unset, declare, control flow) reach the
    // `command not found` fallback here, where the interpreter runs them.
    function emitComputedCommand(b, cmdT, argTs) {
        var listP = slotOf(i8ptr)
        b.NewStore(nilList(b), listP)
        var rw = cmdT.fn(b)
        b = rw.b
        b.NewStore(b.NewCall(rtCatFields, [b.NewLoad(i8ptr, listP), rw.v]), listP)
        var i
        for (i = 0; i < argTs.length; i++) {
            var ra = argTs[i].fn(b)
            b = ra.b
            b.NewStore(b.NewCall(rtCatFields, [b.NewLoad(i8ptr, listP), ra.v]), listP)
        }
        b = emitAbortCheck(b)
        var all = b.NewLoad(i8ptr, listP)
        var nf = b.NewCall(rtNFields, all)
        var nameV = b.NewCall(rtGetField, [all, zero])
        var restV = b.NewCall(rtSliceFields, [all, one, b.NewSub(nf, one), ifsFirstValue(b), zero])
        var done = curF.NewBlock("")
        // A command word that expands to NO field at all runs nothing and answers 0:
        // `e=""; $e` is a successful no-op in bash.
        var haveB = curF.NewBlock(""), noneB = curF.NewBlock("")
        b.NewCondBr(b.NewICmp(llvm.enum.IPredSGT, nf, zero), haveB, noneB)
        storeStatusI(noneB, 0)
        noneB.NewBr(done)
        b = haveB
        var cands = ["echo", ":", "true", "false", "wait"]
        for (i = 0; i < declaredFuncList.length; i++) { cands.push(declaredFuncList[i]) }
        var ci
        for (ci = 0; ci < cands.length; ci++) {
            var cname = cands[ci]
            var hit = curF.NewBlock(""), miss = curF.NewBlock("")
            b.NewCondBr(b.NewICmp(llvm.enum.IPredNE,
                                  b.NewCall(rtStreq, [nameV, gepStr(b, cname)]), zero), hit, miss)
            var hb = hit
            if (cname == "echo") {
                hb.NewCall(rtEcho, [restV, one, zero])
                storeStatusI(hb, 0)
            } else if (cname == "false") {
                storeStatusI(hb, 1)
            } else if (cname == ":" || cname == "true" || cname == "wait") {
                storeStatusI(hb, 0)
            } else {
                var f = funcFor(cname)
                var savedTop = slotOf(i32)
                var savedBase = slotOf(i32)
                var savedN = slotOf(i32)
                hb.NewStore(hb.NewLoad(i32, gArgvTop), savedTop)
                hb.NewStore(hb.NewLoad(i32, gFrameBase), savedBase)
                hb.NewStore(hb.NewLoad(i32, gFrameN), savedN)
                hb.NewCall(rtArgPush, restV)
                var base = hb.NewLoad(i32, savedTop)
                hb.NewStore(base, gFrameBase)
                hb.NewStore(hb.NewSub(hb.NewLoad(i32, gArgvTop), base), gFrameN)
                storeStatus(hb, hb.NewCall(f))
                hb.NewStore(hb.NewLoad(i32, savedBase), gFrameBase)
                hb.NewStore(hb.NewLoad(i32, savedN), gFrameN)
                hb.NewStore(hb.NewLoad(i32, savedTop), gArgvTop)
                hb = emitExitCheck(hb)
            }
            hb.NewBr(done)
            b = miss
        }
        // The same diagnostic and the same 127 the literal path writes, with the name from
        // the expansion. bash carries on after it; this language stops, in both halves.
        b.NewCall(rtPrints, gepStr(b, c.file + ": command not found: "))
        b.NewCall(rtPrints, nameV)
        b.NewCall(rtPrints, gepStr(b, "\n"))
        b.NewStore(llvm.constant.NewInt(i32, 127), gExitCode)
        b.NewStore(one, gExited)
        b.NewBr(viaUnwind(curExit, curExitRd))
        return done
    }

    // words[0] is the command word (a literal, or an expansion - see emitComputedCommand),
    // the rest are arguments.
    function makeSimpleCommand(items0) {
        var cmdT = items0[0]
        var argTs = []
        var redirs = []
        var ri
        for (ri = 1; ri < items0.length; ri++) {
            var it0 = items0[ri]
            if (it0.rd != undefined) { redirs.push(it0) } else { argTs.push(it0) }
        }
        var inner = function(b) {
            b = emitAbortCheck(b)
            var cmd = cmdT.c
            if (cmd == undefined) { return emitComputedCommand(b, cmdT, argTs) }
            if (cmd == "echo") { return emitEcho(b, argTs) }
            if (cmd == "[" || cmd == "test") { return emitTest(b, cmd, argTs) }
            // `cmd &` already ran to completion (see mkAsync), so there is never anything
            // left to wait for. LIMIT: `wait PID` answers 0, not the job's real status.
            // The arguments of these four are still EXPANDED, for their side effects and
            // errors: `: $(( n++ ))` and `: ${v:?unset}` are idioms.
            if (cmd == "true" || cmd == ":" || cmd == "wait" || cmd == "false") {
                var tbox = {b: b}
                evalArgs(tbox, argTs)
                b = emitAbortCheck(tbox.b)
                storeStatusI(b, (cmd == "false") ? 1 : 0)
                return b
            }
            if (cmd == "exit") {
                var code = zero
                // An exit status is N modulo 256: `exit 300` is 44, `exit -2` is 254.
                if (argTs.length > 0) { var r = evalWord(b, argTs[0]); b = r.b; code = b.NewAnd(s2i(b, r.v), llvm.constant.NewInt(i32, 255)) }
                else { code = b.NewLoad(i32, gStatus) }
                b.NewStore(code, gExitCode)
                b.NewStore(one, gExited)
                b.NewBr(viaUnwind(curExit, curExitRd))
                return deadBlock()
            }
            if (cmd == "return") {
                var rv = null
                // `return N` is N modulo 256, like an exit status: 300 is 44, -1 is 255.
                if (argTs.length > 0) { var r2 = evalWord(b, argTs[0]); b = r2.b; rv = b.NewAnd(s2i(b, r2.v), llvm.constant.NewInt(i32, 255)) }
                else { rv = b.NewLoad(i32, gStatus) }
                if (curFrame != null) { emitFnRet(b, rv); return deadBlock() }
                storeStatus(b, rv); return b
            }
            // break / continue are real branches here: the loop being emitted knows both of
            // its target blocks, so no control signal has to travel through the runtime.
            // `break N` / `continue N` past the loops there are act on the outermost one; outside
            // any loop they only complain; a level below 1 is an error that leaves EVERY loop
            // (status 1). A level that is not a
            // literal is compared against each enclosing loop at run time. Twin of the same arm
            // of runCommand in bash-interpreter.abnf.
            if (cmd == "break" || cmd == "continue") {
                var depth = loopStack.length
                var isBrk = cmd == "break"
                if (depth == 0) {
                    emitOnStderr(b, gepStr(b, "bash: " + cmd + ": only meaningful in a `for', `while', or `until' loop\n"))
                    storeStatusI(b, 0)
                    return b
                }
                var rangeMsg = function(bb, lvText) {
                    emitOnStderr(bb, bb.NewCall(rtStrcat, [bb.NewCall(rtStrcat, [gepStr(bb, "bash: " + cmd + ": "), lvText]),
                                                          gepStr(bb, ": loop count out of range\n")]))
                    storeStatusI(bb, 1)
                }
                var target = function(k) { var lp = loopStack[depth - k]; return viaUnwind(isBrk ? lp.brk : lp.cont, lp.rd) }
                if (argTs.length == 0 || argTs[0].c != undefined) {
                    var n = (argTs.length > 0) ? parseDec(argTs[0].c) : 1
                    if (n < 1) { rangeMsg(b, gepStr(b, argTs[0].c)); storeLoopStatus(b, one); b.NewBr(viaUnwind(loopStack[0].brk, loopStack[0].rd)); return deadBlock() }
                    storeLoopStatus(b, zero)
                    b.NewBr(target((n > depth) ? depth : n))
                    return deadBlock()
                }
                var rl = evalWord(b, argTs[0])
                b = rl.b
                var lvl = s2i(b, rl.v)
                var badB = curF.NewBlock(""), okB = curF.NewBlock("")
                b.NewCondBr(b.NewICmp(llvm.enum.IPredSLT, lvl, one), badB, okB)
                rangeMsg(badB, rl.v)
                storeLoopStatus(badB, one)
                badB.NewBr(viaUnwind(loopStack[0].brk, loopStack[0].rd))
                storeLoopStatus(okB, zero)
                var k
                for (k = 1; k < depth; k++) {
                    var nextB = curF.NewBlock("")
                    okB.NewCondBr(okB.NewICmp(llvm.enum.IPredEQ, lvl, llvm.constant.NewInt(i32, k)), target(k), nextB)
                    okB = nextB
                }
                okB.NewBr(target(depth))
                return deadBlock()
            }
            if (cmd == "printf") { return emitPrintf(b, argTs) }
            if (cmd == "set") { return emitSet(b, argTs) }
            if (cmd == "shopt") { return emitShopt(b, argTs) }
            if (cmd == "trap") {
                if (argTs.length == 0 || argTs[0].c == undefined) {
                    fail("trap needs a literal handler in this compiler")
                }
                var src = argTs[0].c
                if (src != "" && src != "-") {
                    var flag = m.NewGlobalDef("trap_flag" + trapCount, zero)
                    trapCount = trapCount + 1
                    trapList.push({flag: flag, body: compileSnippet(src)})
                    b.NewStore(one, flag)
                }
                storeStatusI(b, 0)
                return b
            }
            if (cmd == "eval") {
                var esrc = ""
                var ei
                var allConst = true
                for (ei = 0; ei < argTs.length; ei++) {
                    if (argTs[ei].c == undefined) { allConst = false }
                    else { if (ei > 0) { esrc = esrc + " " }; esrc = esrc + argTs[ei].c }
                }
                if (allConst) {
                    if (esrc == "") { storeStatusI(b, 0); return b }
                    return compileSnippet(esrc)(b)
                }
                // A COMPUTED eval cannot be compiled in general. The one shape a compiler can
                // still honour is the assignment `eval "NAME=VALUE"`, which becomes a runtime
                // name -> slot dispatch over the variable names the program mentions.
                var acc = emptyPtr(b)
                for (ei = 0; ei < argTs.length; ei++) {
                    var re2 = evalWord(b, argTs[ei])
                    b = re2.b
                    if (ei > 0) { acc = b.NewCall(rtStrcat, [acc, gepStr(b, " ")]) }
                    acc = b.NewCall(rtStrcat, [acc, re2.v])
                }
                b.NewCall(rtEvalAssign, acc)
                storeStatusI(b, 0)
                return b
            }
            if (cmd == "read") { return emitRead(b, argTs) }
            if (cmd == "shift") {
                var sn = one
                if (argTs.length > 0) {
                    var rs2 = evalWord(b, argTs[0])
                    b = rs2.b
                    sn = s2i(b, rs2.v)
                }
                b.NewStore(b.NewAdd(b.NewLoad(i32, gFrameBase), sn), gFrameBase)
                b.NewStore(b.NewSub(b.NewLoad(i32, gFrameN), sn), gFrameN)
                storeStatusI(b, 0)
                return b
            }
            if (cmd == "unset") {
                var uk
                for (uk = 0; uk < argTs.length; uk++) {
                    // A name built by expansion (`unset "d[$((i+1))]"`) is resolved at run time;
                    // the attribute and local bookkeeping below needs a literal one.
                    if (argTs[uk].c == undefined) {
                        var ru = evalWord(b, argTs[uk])
                        b = ru.b
                        b.NewCall(rtUnsetName, ru.v)
                        continue
                    }
                    var sp0 = splitSubscript(argTs[uk].c)
                    if (sp0.key == null) {
                        storeVarRaw(b, sp0.name, unsetPtr(b))
                        b.NewCall(rtArrClear, gepStr(b, sp0.name))
                        // `unset` drops the attributes with the value, in bash and here.
                        intVars["$" + sp0.name] = false
                        upVars["$" + sp0.name] = false
                        loVars["$" + sp0.name] = false
                        // A local unset in the function that declared it stays declared
                        // (rt_arr_smark). Twin of localHere in bash-interpreter.abnf.
                        if (curFrame != null && hasOwn(curFrame.locs, "$" + sp0.name)) { b.NewCall(rtArrSmark, gepStr(b, sp0.name)) }
                        // Not ours: a CALLER's local of that name is dropped instead, which
                        // overwrites the unset just stored with the next binding outward.
                        else if (curFrame != null && sp0.name != "FUNCNAME") {
                            b.NewCall(rtUnsetUp, [llvm.constant.NewInt(i32, getVarId(sp0.name)), b.NewLoad(i32, curFrame.depth),
                                                  llvm.constant.NewInt(i32, getVarId("FUNCNAME"))])
                        }
                    } else {
                        b.NewCall(rtArrDel, [gepStr(b, sp0.name), litKeyOf(b, sp0.name, sp0.key)])
                    }
                }
                storeStatusI(b, 0)
                return b
            }
            var f = funcFor(cmd)
            if (f != null) {
                // Push every ARGUMENT FIELD, then make them this call's frame. The stack top,
                // base and count are all restored afterwards, so recursion nests correctly.
                var savedTop = slotOf(i32)
                var savedBase = slotOf(i32)
                var savedN = slotOf(i32)
                b.NewStore(b.NewLoad(i32, gArgvTop), savedTop)
                b.NewStore(b.NewLoad(i32, gFrameBase), savedBase)
                b.NewStore(b.NewLoad(i32, gFrameN), savedN)
                var i
                for (i = 0; i < argTs.length; i++) {
                    var ra = argTs[i].fn(b)
                    b = ra.b
                    b.NewCall(rtArgPush, ra.v)
                }
                b = emitAbortCheck(b)
                var base = b.NewLoad(i32, savedTop)
                b.NewStore(base, gFrameBase)
                b.NewStore(b.NewSub(b.NewLoad(i32, gArgvTop), base), gFrameN)
                storeStatus(b, b.NewCall(f))
                b.NewStore(b.NewLoad(i32, savedBase), gFrameBase)
                b.NewStore(b.NewLoad(i32, savedN), gFrameN)
                b.NewStore(b.NewLoad(i32, savedTop), gArgvTop)
                return emitExitCheck(b)
            }
            var bbox2 = {b: b}
            evalArgs(bbox2, argTs)
            b = bbox2.b
            // Prefixed with $0, like every shell diagnostic; bash-interpreter.abnf prints the same
            // line and exits 127 too.
            b.NewCall(rtPrints, gepStr(b, c.file + ": command not found: " + cmd + "\n"))
            b.NewStore(llvm.constant.NewInt(i32, 127), gExitCode)
            b.NewStore(one, gExited)
            b.NewBr(viaUnwind(curExit, curExitRd))
            return deadBlock()
        }
        if (redirs.length == 0) { return inner }
        return function(b) {
            var sv = emitOpenRedirs(b, redirs)
            b = sv.b
            var cmd0 = cmdT, args0 = argTs
            cmdT = preRedirWord(cmd0, sv)
            argTs = []
            var k
            for (k = 0; k < args0.length; k++) { argTs.push(preRedirWord(args0[k], sv)) }
            redirStack.push(sv)
            b = inner(b)
            redirStack.pop()
            cmdT = cmd0
            argTs = args0
            emitCloseRedirs(b, sv)
            return b
        }
    }
    // bash expands a command's words BEFORE it applies the command's redirections, so what an
    // expansion writes to stderr (a command substitution's own stderr, an arithmetic error) or
    // reads from stdin goes to the streams in effect before them: `echo "$(echo hi >&2)"
    // 2>/dev/null` prints hi. The builtins interleave expansion with their own work, so each
    // non-literal word runs with the saved streams exchanged back in. Twin of makeSimpleCommand
    // in bash-interpreter.abnf, which expands every word before openRedirs.
    function preRedirWord(w, sv) {
        if (w.c != undefined) { return w }
        var o = {s: w.s, f: w.f, c: undefined, fn: preRedirFn(w.fn, sv)}
        if (w.spw != undefined) { o.spw = {s: w.spw.s, f: w.spw.f, c: w.spw.c, fn: preRedirFn(w.spw.fn, sv)} }
        return o
    }
    function preRedirFn(fn, sv) {
        // While swapped the globals already hold the outer streams, so a branch out of the
        // expansion must not "close" sv again: it is off redirStack for the duration.
        return function(b) {
            swapRedirs(b, sv)
            var top = redirStack.pop()
            var r = fn(b)
            redirStack.push(top)
            swapRedirs(r.b, sv)
            return r
        }
    }
    // Exchanges the stream globals with emitOpenRedirs' saved copies.
    function swapRedirs(b, sv) {
        var o = b.NewLoad(i32, gSinkOut), e = b.NewLoad(i32, gSinkErr)
        var ib = null, ip = null
        if (sv.sb != null) { ib = b.NewLoad(i8ptr, gStdin); ip = b.NewLoad(i32, gStdinPos) }
        emitCloseRedirs(b, sv)
        b.NewStore(o, sv.so)
        b.NewStore(e, sv.se)
        if (sv.sb != null) { b.NewStore(ib, sv.sb); b.NewStore(ip, sv.sp) }
    }

    // `cmd &` : the parser leaves an {amp} marker AFTER the statement it applies to, so a
    // statement list is a mix of thunks and markers. linkAsync folds the markers away.
    // The {nl} marker a top-level separator run with a newline in it leaves (see Program).
    function pushLineEnd(t) {
        var i
        for (i = 0; i < t.length; i++) { if (t.charAt(i) == "\n") { push({nl: 1}); return } }
    }
    // The top-level items as lines of statements, each list folded by linkAsync.
    function splitLines(items) {
        var lines = [], cur = []
        var i
        for (i = 0; i < items.length; i++) {
            if (typeof items[i] != "function" && items[i].nl != undefined) { lines.push(linkAsync(cur)); cur = [] }
            else { cur.push(items[i]) }
        }
        lines.push(linkAsync(cur))
        return lines
    }
    function linkAsync(items) {
        var out = []
        var i
        for (i = 0; i < items.length; i++) {
            if (typeof items[i] == "function") { out.push(items[i]) }
            else if (out.length > 0) { out[out.length - 1] = mkAsync(out[out.length - 1]) }
        }
        return out
    }
    // LIMIT, matching the interpreter half exactly: a compiled program has no second process
    // either, so an asynchronous statement is emitted as a SUBSHELL that runs to completion
    // here and then reports status 0. `cmd & wait` observes the same thing a real shell does;
    // what neither half can model is overlap (`sleep 1 & echo hi` prints "hi" second).
    function mkAsync(t) {
        var inner = makeSubshell(t)
        return function(b) {
            var eb = inner(b)
            eb.NewStore(zero, gStatus)
            return eb
        }
    }

    // cmd1 && cmd2 || cmd3 : run left to right, short circuit on the running $?.
    function makeAndOr(items) {
        if (items.length == 1) { return items[0] }
        return function(b) {
            b = emitCond(items[0], b)
            var i
            for (i = 1; i < items.length; i += 2) {
                var op = items[i].op
                var runB = curF.NewBlock(""), merge = curF.NewBlock("")
                var isZero = b.NewICmp(llvm.enum.IPredEQ, b.NewLoad(i32, gStatus), zero)
                if (op == "&&") { b.NewCondBr(isZero, runB, merge) } else { b.NewCondBr(isZero, merge, runB) }
                var isLast = (i + 2 >= items.length)
                var rb = isLast ? items[i + 1](runB) : emitCond(items[i + 1], runB)
                rb.NewBr(merge)
                b = merge
            }
            return b
        }
    }

    function makeSeq(thunks) {
        return function(b) {
            var i
            for (i = 0; i < thunks.length; i++) {
                b = thunks[i](b)
                b = emitErrExitCheck(b)
            }
            return b
        }
    }

    // items = [{pats}, bodyThunk, {cterm}?]
    function mkCaseClause(items) {
        var pats = []
        var body = null
        var term = ";;"
        var i
        for (i = 0; i < items.length; i++) {
            var it = items[i]
            if (typeof it == "function") { body = it }
            else if (it.pats != undefined) { pats = it.pats }
            else if (it.cterm != undefined) { term = it.cterm }
        }
        return {pats: pats, body: body, cterm: term}
    }
    // items = [subjectWordObj, clause...]. One clause = one pattern test and one body block;
    // ";;&" branches on to the NEXT clause's test after its body, ";&" falls into the next
    // clause's BODY without testing it, ";;" ends the case. The status is the last body
    // command's, 0 when no clause matched or the body is empty (`false; case x in x) ;; esac`
    // is 0). Twin of makeCase in bash-interpreter.abnf.
    function makeCase(items) {
        var subjT = items[0]
        var clauses = items.slice(1)
        return function(b) {
            var r0 = evalWord(b, subjT)
            b = r0.b
            var subj = r0.v
            var merge = curF.NewBlock("")
            var i
            var bodies = []
            for (i = 0; i < clauses.length; i++) { bodies.push(curF.NewBlock("")) }
            for (i = 0; i < clauses.length; i++) {
                var cl = clauses[i]
                var hit = zero
                var k
                for (k = 0; k < cl.pats.length; k++) {
                    var rp = evalWord(b, cl.pats[k])
                    b = rp.b
                    hit = b.NewOr(hit, b.NewCall(rtGlob, [rp.v, subj]))
                }
                var nextB = curF.NewBlock("")
                b.NewCondBr(b.NewICmp(llvm.enum.IPredNE, hit, zero), bodies[i], nextB)
                storeStatusI(bodies[i], 0)
                var tb = cl.body(bodies[i])
                if (cl.cterm == ";;&") { tb.NewBr(nextB) }
                else if (cl.cterm == ";&" && i + 1 < clauses.length) { tb.NewBr(bodies[i + 1]) }
                else { tb.NewBr(merge) }
                b = nextB
            }
            storeStatusI(b, 0)
            b.NewBr(merge)
            return merge
        }
    }

    // <<DELIM / <<-DELIM / <<'DELIM' : split the scanned token back into marker and body.
    function mkHereDoc(text) {
        var i = 2
        var dashed = false
        if (text.charAt(i) == "-") { dashed = true; i = i + 1 }
        while (text.charAt(i) == " " || text.charAt(i) == "\t") { i = i + 1 }
        var quote = ""
        var q = text.charAt(i)
        if (q == "'" || q == "\"") { quote = q; i = i + 1 }
        var firstNL = -1
        var lastNL = -1
        var k
        for (k = 0; k < text.length; k++) {
            var ch = text.charAt(k)
            if (ch == "\n") { if (firstNL < 0) { firstNL = k }; lastNL = k }
        }
        var body = ""
        if (firstNL >= 0 && lastNL > firstNL) { body = text.slice(firstNL + 1, lastNL + 1) }
        if (dashed) { body = stripLeadingTabs(body) }
        var t = (quote != "") ? makeConst(body) : compileHereBody(body)
        return {rd: "<<", iofd: "", target: t}
    }
    function stripLeadingTabs(b) {
        var out = ""
        var atLineStart = true
        var i
        for (i = 0; i < b.length; i++) {
            var ch = b.charAt(i)
            if (atLineStart && ch == "\t") { continue }
            atLineStart = (ch == "\n")
            out = out + ch
        }
        return out
    }
    function compileHereBody(body) {
        return arCompile("\x01" + body, "HereBodyW", false)
    }

    // A compound statement plus its redirections; items = [bodyThunk, redir...]
    function mkRedirected(items) {
        var bodyT = items[0]
        var redirs = []
        var i
        for (i = 1; i < items.length; i++) { redirs.push(items[i]) }
        if (redirs.length == 0) { return bodyT }
        return function(b) {
            var sv = emitOpenRedirs(b, redirs)
            b = sv.b
            redirStack.push(sv)
            // An expansion error in a redirection's word abandons the compound command.
            // Twin of mkRedirected in bash-interpreter.abnf.
            b = emitAbortCheck(b)
            b = bodyT(b)
            redirStack.pop()
            emitCloseRedirs(b, sv)
            return b
        }
    }

    // Apply a redirection list by rerouting the two output channels and the stdin buffer.
    // Saves the streams the list changes and applies it; emitCloseRedirs puts them back. The
    // stdin buffer and position are saved only under a stdin redirection: without one, what
    // the command reads stays read (`read x 2>/dev/null; read y` reads two lines).
    function emitOpenRedirs(b, redirs) {
        var so = slotOf(i32), se = slotOf(i32)
        b.NewStore(b.NewLoad(i32, gSinkOut), so)
        b.NewStore(b.NewLoad(i32, gSinkErr), se)
        var sb = null, sp = null
        var i
        for (i = 0; i < redirs.length; i++) {
            if (redirs[i].rd == "<<" || redirs[i].rd == "<<<" || redirs[i].rd == "<") { sb = slotOf(i8ptr); sp = slotOf(i32) }
        }
        if (sb != null) {
            b.NewStore(b.NewLoad(i8ptr, gStdin), sb)
            b.NewStore(b.NewLoad(i32, gStdinPos), sp)
        }
        for (i = 0; i < redirs.length; i++) {
            var r = redirs[i]
            var tgt = null
            if (r.target != null) { var rr = evalWord(b, r.target); b = rr.b; tgt = rr }
            var fd = (r.iofd == "") ? "1" : r.iofd
            if (r.rd == "<<") { b.NewStore(tgt.v, gStdin); b.NewStore(zero, gStdinPos) }
            else if (r.rd == "<<<") {
                b.NewStore(b.NewCall(rtStrcat, [tgt.v, gepStr(b, "\n")]), gStdin)
                b.NewStore(zero, gStdinPos)
            }
            else if (r.rd == "<") { b.NewStore(emptyPtr(b), gStdin); b.NewStore(zero, gStdinPos) }
            else if (r.rd == ">&" || r.rd == "<&") {
                var src = (r.target != null && r.target.c == "2") ? b.NewLoad(i32, gSinkErr) : b.NewLoad(i32, gSinkOut)
                if (fd == "2") { b.NewStore(src, gSinkErr) } else { b.NewStore(src, gSinkOut) }
            }
            else if (r.rd == "&>" || r.rd == "&>>") {
                var ch = llvm.constant.NewInt(i32, (r.target != null && r.target.c == "/dev/stdout") ? 0 : 2)
                b.NewStore(ch, gSinkOut)
                b.NewStore(ch, gSinkErr)
            }
            else {
                var tc = (r.target != null) ? r.target.c : undefined
                var n = 2
                if (tc == "/dev/stdout") { n = 0 }
                if (tc == "/dev/stderr") { n = 1 }
                var ch2 = llvm.constant.NewInt(i32, n)
                if (fd == "2") { b.NewStore(ch2, gSinkErr) } else { b.NewStore(ch2, gSinkOut) }
            }
        }
        return {b: b, so: so, se: se, sb: sb, sp: sp}
    }
    function emitCloseRedirs(b, sv) {
        b.NewStore(b.NewLoad(i32, sv.so), gSinkOut)
        b.NewStore(b.NewLoad(i32, sv.se), gSinkErr)
        if (sv.sb != null) {
            b.NewStore(b.NewLoad(i8ptr, sv.sb), gStdin)
            b.NewStore(b.NewLoad(i32, sv.sp), gStdinPos)
        }
    }
    // Closes every redirection opened above redirStack[base], innermost first.
    function unwindRedirs(b, base) {
        var k
        for (k = redirStack.length - 1; k >= base; k--) { emitCloseRedirs(b, redirStack[k]) }
    }
    // The block to branch to for `target` from inside redirStack[base..]: target itself when
    // nothing is open, else a block that closes those first.
    function viaUnwind(target, base) {
        if (redirStack.length <= base) { return target }
        var u = curF.NewBlock("")
        unwindRedirs(u, base)
        u.NewBr(target)
        return u
    }

    function mkPrefixAsg(items) {
        return {aname: items[0].aname, val: (items.length > 1) ? items[1] : null}
    }
    // NAME=VALUE... COMMAND : the assignments are undone after the command, which the local
    // save stack already does exactly right.
    function makePrefixCmd(items) {
        var asgs = []
        var rest = []
        var i
        for (i = 0; i < items.length; i++) {
            var it = items[i]
            if (it.fn == undefined && it.rd == undefined && it.aname != undefined) { asgs.push(it) }
            else { rest.push(it) }
        }
        var inner = makeSimpleCommand(rest)
        return function(b) {
            var depth = slotOf(i32)
            b.NewStore(b.NewLoad(i32, gLsTop), depth)
            var k
            for (k = 0; k < asgs.length; k++) {
                b.NewCall(rtPushLocal, llvm.constant.NewInt(i32, getVarId(asgs[k].aname)))
                var v = emptyPtr(b)
                if (asgs[k].val != null) { var r = evalWord(b, asgs[k].val); b = r.b; v = r.v }
                storeVar(b, asgs[k].aname, v)
            }
            b = inner(b)
            b.NewCall(rtPopLocals, b.NewLoad(i32, depth))
            return b
        }
    }

    function mkCond(items) { return {cond: items[0], body: items[1]} }
    function mkElse(bodyT) { return {els: bodyT} }

    // clauses = [{cond,body} (if), {cond,body} (elif)*, {els} (else)?].
    function makeIf(clauses) {
        return function(b) {
            var merge = curF.NewBlock("")
            var i
            for (i = 0; i < clauses.length; i++) {
                var cl = clauses[i]
                if (cl.els != undefined) {
                    b = cl.els(b)
                    b.NewBr(merge)
                    return merge
                }
                b = emitCond(cl.cond, b)
                var thenB = curF.NewBlock(""), nextB = curF.NewBlock("")
                b.NewCondBr(b.NewICmp(llvm.enum.IPredEQ, b.NewLoad(i32, gStatus), zero), thenB, nextB)
                var tb = cl.body(thenB)
                tb.NewBr(merge)
                b = nextB
            }
            storeStatusI(b, 0)
            b.NewBr(merge)
            return merge
        }
    }

    // A stack slot of the function being emitted. It is made in that function's entry block
    // whatever block asks for it, so a slot used inside a loop is not a fresh alloca on every
    // pass - which would grow the stack each iteration.
    function slotOf(ty) { return curEntry.NewAlloca(ty) }

    // A loop's status slot: the status of the last body command it ran, 0 when the body never
    // ran. break and continue store their own status (0, or 1 for an out-of-range level) into
    // every enclosing loop's slot - an outer loop that goes on running overwrites it at the end
    // of its body anyway. The exit block hands the slot to $?. Twin of sigStatus in
    // bash-interpreter.abnf.
    function loopStatusSlot(b) {
        var lst = slotOf(i32)
        b.NewStore(zero, lst)
        return lst
    }
    function storeLoopStatus(b, v) {
        var k
        for (k = 0; k < loopStack.length; k++) { b.NewStore(v, loopStack[k].lst) }
    }

    // items = [condThunk, bodyThunk].
    function makeWhile(items) {
        var condT = items[0], bodyT = items[1]
        return function(b) {
            var head = curF.NewBlock(""), body = curF.NewBlock(""), exit = curF.NewBlock("")
            var lst = loopStatusSlot(b)
            b.NewBr(head)
            var hb = emitCond(condT, head)
            hb.NewCondBr(hb.NewICmp(llvm.enum.IPredEQ, hb.NewLoad(i32, gStatus), zero), body, exit)
            loopStack.push({brk: exit, cont: head, lst: lst, rd: redirStack.length})
            var bb = bodyT(body)
            loopStack.pop()
            bb.NewStore(bb.NewLoad(i32, gStatus), lst)
            bb.NewBr(head)
            storeStatus(exit, exit.NewLoad(i32, lst))
            return exit
        }
    }

    function makeUntil(items) {
        var condT = items[0], bodyT = items[1]
        return function(b) {
            var head = curF.NewBlock(""), body = curF.NewBlock(""), ex = curF.NewBlock("")
            var lst = loopStatusSlot(b)
            b.NewBr(head)
            var hb = emitCond(condT, head)
            hb.NewCondBr(hb.NewICmp(llvm.enum.IPredEQ, hb.NewLoad(i32, gStatus), zero), ex, body)
            loopStack.push({brk: ex, cont: head, lst: lst, rd: redirStack.length})
            var bb = bodyT(body)
            loopStack.pop()
            bb.NewStore(bb.NewLoad(i32, gStatus), lst)
            bb.NewBr(head)
            storeStatus(ex, ex.NewLoad(i32, lst))
            return ex
        }
    }
    // items = [initExpr, condExpr, stepExpr, bodyThunk]
    function makeCFor(items) {
        var initT = arIn("((: ", items[0]), condT = arIn("((: ", items[1]), stepT = arIn("((: ", items[2]), bodyT = items[3]
        return function(b) {
            // An arithmetic error in any of the three parts ends the loop with status 1.
            var lst = loopStatusSlot(b)
            var r0 = initT(b)
            b = r0.b
            var head = curF.NewBlock(""), body = curF.NewBlock(""), step = curF.NewBlock(""), ex = curF.NewBlock("")
            var bad = curF.NewBlock("")
            b.NewCondBr(takeArithErr(b), bad, head)
            var rc = condT(head)
            var go = curF.NewBlock("")
            rc.b.NewCondBr(takeArithErr(rc.b), bad, go)
            go.NewCondBr(go.NewICmp(llvm.enum.IPredNE, rc.v, zero64), body, ex)
            loopStack.push({brk: ex, cont: step, lst: lst, rd: redirStack.length})
            var bb = bodyT(body)
            loopStack.pop()
            bb.NewStore(bb.NewLoad(i32, gStatus), lst)
            bb.NewBr(step)
            var rs = stepT(step)
            rs.b.NewCondBr(takeArithErr(rs.b), bad, head)
            bad.NewStore(one, lst)
            bad.NewBr(ex)
            storeStatus(ex, ex.NewLoad(i32, lst))
            return ex
        }
    }

    // items = [{fname}, {words:[wordObjs]}, bodyThunk]. The word list is static -> unrolled.
    function makeFor(items) {
        var fname = "", wordThunks = null, bodyT = null
        var i
        for (i = 0; i < items.length; i++) {
            var it = items[i]
            if (typeof it == "function") { bodyT = it }
            else if (it.words != undefined) { wordThunks = it.words }
            else if (it.fname != undefined) { fname = it.fname }
        }
        return function(b) {
            // Build the whole word list as ONE field list at run time, then walk it: the
            // words can each expand to any number of fields ("${a[@]}", "$@", an unquoted
            // expansion), so the iteration count is not known while emitting.
            var listP = slotOf(i8ptr)
            if (wordThunks == null) {
                b.NewStore(b.NewCall(rtParams, [gepStr(b, " "), zero]), listP)
            } else {
                b.NewStore(nilList(b), listP)
                var k
                for (k = 0; k < wordThunks.length; k++) {
                    var r = wordThunks[k].fn(b)
                    b = r.b
                    b.NewStore(b.NewCall(rtCatFields, [b.NewLoad(i8ptr, listP), r.v]), listP)
                }
            }
            var ip = slotOf(i32)
            b.NewStore(zero, ip)
            var lst = loopStatusSlot(b)
            var head = curF.NewBlock(""), body = curF.NewBlock("")
            var step = curF.NewBlock(""), ex = curF.NewBlock("")
            b.NewBr(head)
            var list = head.NewLoad(i8ptr, listP)
            var i = head.NewLoad(i32, ip)
            head.NewCondBr(head.NewICmp(llvm.enum.IPredSLT, i, head.NewCall(rtNFields, list)), body, ex)
            storeVar(body, fname, body.NewCall(rtGetField, [list, i]))
            loopStack.push({brk: ex, cont: step, lst: lst, rd: redirStack.length})
            var bb = bodyT(body)
            loopStack.pop()
            bb.NewStore(bb.NewLoad(i32, gStatus), lst)
            bb.NewBr(step)
            step.NewStore(step.NewAdd(i, one), ip)
            step.NewBr(head)
            storeStatus(ex, ex.NewLoad(i32, lst))
            return ex
        }
    }

    // items = [{fname}, bodyThunk]. Emits bashfn_NAME immediately (so recursion resolves).
    function makeFuncDef(items) {
        var fname = items[0].fname
        var bodyT = items[1]
        declaredFuncs["$" + fname] = true
        // The same set as an ARRAY: the run-time command dispatch has to enumerate the names, and
        // keysOf is not bound for grammar scripts.
        if (!hasOwn(declaredSeen, "$" + fname)) {
            declaredSeen["$" + fname] = true
            declaredFuncList.push(fname)
        }
        return function(b) {
            var i
            var key = "$" + fname
            var f = null
            if (hasOwn(funcs, key) && !hasOwn(definedFuncs, key)) {
                f = funcs[key]              // a forward declaration made by an earlier call
            } else {
                var suffix = hasOwn(funcs, key) ? ("_" + fnCount) : ""
                fnCount = fnCount + 1
                f = m.NewFunc("bashfn_" + fname + suffix, i32)
                funcs[key] = f
            }
            definedFuncs[key] = true
            // bash's loops do not reach into a called function: the body starts with none.
            var savedF = curF, savedEntry = curEntry, savedExit = curExit, savedFrame = curFrame, savedLoops = loopStack
            var savedExitRd = curExitRd, savedRedirs = redirStack
            loopStack = []
            redirStack = []
            curExitRd = 0
            curF = f
            var entry = f.NewBlock("entry")
            curEntry = entry
            curExit = f.NewBlock("exit")
            // The local-save-stack depth at entry: every ret unwinds back to it.
            var dslot = entry.NewAlloca(i32)
            entry.NewStore(entry.NewLoad(i32, gLsTop), dslot)
            curFrame = {depth: dslot, locs: {}}
            // Every attribute the body declares is function-local, exactly like the value.
            var undoBase = attrUndo.length
            // $FUNCNAME: a local of the call, so the save stack restores it on return.
            entry.NewCall(rtPushLocal, llvm.constant.NewInt(i32, getVarId("FUNCNAME")))
            storeVar(entry, "FUNCNAME", gepStr(entry, fname))
            emitFnRet(curExit, curExit.NewLoad(i32, gStatus))
            var endb = bodyT(entry)
            emitFnRet(endb, endb.NewLoad(i32, gStatus))
            attrUnwind(undoBase)
            curF = savedF; curEntry = savedEntry; curExit = savedExit; curFrame = savedFrame; loopStack = savedLoops
            curExitRd = savedExitRd; redirStack = savedRedirs
            storeStatusI(b, 0)
            return b
        }
    }

    // ===================================================================================
    //  Program: build main(), run the top-level statements, finish.
    // ===================================================================================

    function runProgram(items) {
        var lines = splitLines(items)
        var main = m.NewFunc("main", i32)
        curF = main
        var entry = main.NewBlock("entry")
        curEntry = entry
        var body = main.NewBlock("body")
        curExit = main.NewBlock("exit")
        // An explicit `exit N` still runs the EXIT trap on its way out.
        var mainExit = curExit
        curFrame = null
        // Emit the whole program into `body`; getVarId fills varIdList as a side effect. Each
        // LINE has its own exit block: exited == 2 there is an expansion error abandoning the
        // line (status 1, on to the next one); anything else is a real exit.
        var b = body
        var i
        var li
        for (li = 0; li < lines.length; li++) {
            var stmts = lines[li]
            var lineExit = main.NewBlock(""), next = main.NewBlock("")
            curExit = lineExit
            for (i = 0; i < stmts.length; i++) { b = stmts[i](b); b = emitErrExitCheck(b) }
            b = emitAbortCheck(b)
            b.NewBr(next)
            var soft = lineExit.NewICmp(llvm.enum.IPredEQ, lineExit.NewLoad(i32, gExited), llvm.constant.NewInt(i32, 2))
            var softB = main.NewBlock("")
            lineExit.NewCondBr(soft, softB, mainExit)
            softB.NewStore(zero, gExited)
            storeStatusI(softB, 1)
            softB.NewBr(next)
            b = next
        }
        curExit = mainExit
        var progTraps = trapList
        b = emitTraps(b, progTraps)
        b.NewRet(b.NewLoad(i32, gStatus)) // normal completion -> exit code is $?
        // ... and so does an explicit `exit N`, which lands in main's exit block.
        var xb = emitTraps(mainExit, progTraps)
        xb.NewRet(xb.NewLoad(i32, gExitCode))
        // languages/c-to-llvm-ir.abnf does not put a global's initializer in the global
        // itself; it emits __mec_ginit(), which main calls. bash-rt.c's main is stripped
        // when its module is generated, so THIS main has to make the call - and it is not
        // optional bookkeeping: every string literal in the runtime is materialized there.
        entry.NewCall(rtGinit, [])
        // Native build only: turn the fd-2 writer in rt_putc on. c.exePath is "" under
        // llvm.Run, and rt_putc's comment says why that has to stay silent rather than
        // abort on the first stderr byte.
        entry.NewStore(llvm.constant.NewInt(i32, (c.exePath != undefined && c.exePath != "") ? 1 : 0), gErrNative)
        // $0 for the runtime's own ${!r} lookup.
        entry.NewStore(gepStr(entry, c.file), gScriptName)
        // Now that every variable slot is known, mark them all unset in entry (a raw null
        // would trap on the first load, so the marker is a real pointer to a NUL byte).
        var up0 = unsetPtr(entry)
        for (i = 0; i < varIdList.length; i++) {
            entry.NewStore(up0, varSlot(entry, llvm.constant.NewInt(i32, i)))
        }
        // There is no process environment behind a compiled run, so the few variables a script
        // may reasonably expect to exist get a fixed, documented default.
        storeVar(entry, "HOME", gepStr(entry, "/home/user"))
        storeVar(entry, "PWD", gepStr(entry, "/home/user"))
        // IFS is an ordinary SET variable in a real shell, so saved=$IFS ... IFS=$saved round-trips.
        // ifsValue() already falls back to this default when the slot is unset, so seeding it
        // changes only what READING $IFS answers.
        storeVar(entry, "IFS", gepStr(entry, " \t\n"))
        // varIdList is FINAL only here - storeVar above can still mint a slot for a name the
        // script never mentioned - so the {name, slot} table is filled last, and it has to
        // cover every slot rt_getvar_byname will walk (it walks nvars of them, and a null
        // name would be a load at address 0). Slots the two lines above just created were
        // missed by the unset loop on purpose; they carry a real value already.
        for (i = 0; i < varIdList.length; i++) {
            entry.NewStore(gepStr(entry, varIdList[i]),
                           entry.NewGetElementPtr(gvarsTy, gVarNames, zero, llvm.constant.NewInt(i32, i)))
        }
        entry.NewStore(llvm.constant.NewInt(i32, varIdList.length), gNvars)
        // The run-time half of assocArrays: a subscript the runtime meets in a string
        // (rt_arith, ${!r}) is literal for these names.
        for (i = 0; i < assocList.length; i++) { entry.NewCall(rtAssocAdd, gepStr(entry, assocList[i])) }
        entry.NewBr(body)
    }

    c.compile(c.asg)

    // With -exe PATH, link the module into a native executable (clang) instead of
    // running it in the built-in IR interpreter.
    if (c.exePath != undefined && c.exePath != "") {
        var buildErr = llvm.BuildExecutable(m, c.exePath, rts)
        if (buildErr != "") { println(buildErr); exit(1) }
        println("bash-to-llvm-ir: wrote executable " + c.exePath)
        exit(0)
    }

    println(m)
    var res = llvm.Run(m, "main", "", rts)
    llvm.WriteOut(res)
    println("bash-to-llvm-ir: exit status " + res.Ret)
    exit(res.Ret)

~~) ;
