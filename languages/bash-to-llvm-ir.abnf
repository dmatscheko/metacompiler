        if (attrOn(upVars, name)) { return b.NewCall(rtCase, [v, one, emptyPtr(b)]) }
        if (attrOn(loVars, name)) { return b.NewCall(rtCase, [v, llvm.constant.NewInt(i32, 3), emptyPtr(b)]) }
        return v
