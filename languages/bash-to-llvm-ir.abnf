        // Kept on purpose as a fast path: the boundary machine below costs five runtime calls per
        // word, and this is the commonest splittable word (a loop head like `[ $i -lt N ]`).
        if (segs.length == 1 && segs[0].sp != undefined) {
            var only = segs[0].sp
            return {s: anySub, f: true, c: undefined, fn: function(b) {
                var svq0 = uqStarEmit
                uqStarEmit = true
                var r0 = only.fn(b)
                uqStarEmit = svq0
                b = r0.b
                return {b: b, v: b.NewCall(rtSplitIfs, [r0.v, ifsValue(b)])}
