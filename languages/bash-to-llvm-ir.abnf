        var ivinf = f.NewBlock("rpivinf"), ivnum = f.NewBlock("rpivnum")
        ivc.NewCondBr(ivc.NewICmp(reEQ, ivc.NewCall(reAt, zero), reK(125)), ivinf, ivnum)
        ivinf.NewStore(reK(-1), np)
        ivinf.NewBr(ivn)
        ivnum.NewStore(ivnum.NewCall(reNum), np)
        ivnum.NewBr(ivn)

        var ivbad = f.NewBlock("rpivbad"), ivok = f.NewBlock("rpivok")
        ivn.NewCondBr(ivn.NewICmp(reNE, ivn.NewCall(reAt, zero), reK(125)), ivbad, ivok)
        ivbad.NewStore(reK(3), gReBad)
        ivbad.NewRet(zero)
        reAdv(ivok, 1)
        var nv = ivok.NewLoad(i32, np), mv2 = ivok.NewLoad(i32, mp)
        var ivok1 = f.NewBlock("rpivok1"), ivok2 = f.NewBlock("rpivok2")
