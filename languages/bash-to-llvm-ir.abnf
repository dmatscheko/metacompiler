        var i
        for (i = 0; i < items.length; i++) {
            if (typeof items[i] != "function" && items[i].nl != undefined) { lines.push(linkAsync(cur)); cur = [] }
            else { cur.push(items[i]) }
        }
        lines.push(linkAsync(cur))
        return lines
    }
    function linkAsync(items) {
        var out = []
        var i
        for (i = 0; i < items.length; i++) {
            if (typeof items[i] == "function") { out.push(items[i]) }
            else if (out.length > 0) { out[out.length - 1] = mkAsync(out[out.length - 1]) }
        }
        return out
    }
    // LIMIT, matching the interpreter half exactly: a compiled program has no second process
    // either, so an asynchronous statement is emitted as a SUBSHELL that runs to completion
    // here and then reports status 0. `cmd & wait` observes the same thing a real shell does;
    // what neither half can model is overlap (`sleep 1 & echo hi` prints "hi" second).
    function mkAsync(t) {
        var inner = makeSubshell(t)
        return function(b) {
            var eb = inner(b)
            eb.NewStore(zero, gStatus)
            return eb
        }
    }

    // cmd1 && cmd2 || cmd3 : run left to right, short circuit on the running $?.
    function makeAndOr(items) {
        if (items.length == 1) { return items[0] }
        return function(b) {
            b = emitCond(items[0], b)
            var i
            for (i = 1; i < items.length; i += 2) {
                var op = items[i].op
                var runB = curF.NewBlock(""), merge = curF.NewBlock("")
                var isZero = b.NewICmp(llvm.enum.IPredEQ, b.NewLoad(i32, gStatus), zero)
                if (op == "&&") { b.NewCondBr(isZero, runB, merge) } else { b.NewCondBr(isZero, merge, runB) }
                var isLast = (i + 2 >= items.length)
                // set -e looks only at the LAST command of the list, when it runs
                eeDone = false
                var rb = isLast ? items[i + 1](runB) : emitCond(items[i + 1], runB)
                if (isLast && !eeDone) { rb = emitErrExitCheck(rb) }
                rb.NewBr(merge)
                b = merge
            }
            eeDone = true
            asgKept = false
            return b
        }
    }

    // set -e is answered after each statement, except one that answered it itself or is
    // exempt (eeDone). Twin of makeSeq in bash-interpreter.abnf. Each statement also gives
    // back the strings it allocated and did not store (heapRelease to a mark taken before
    // it): a later statement's store would otherwise raise the floor over them for as long
    // as the enclosing loop runs. An assignment has given back its own already (asgKept).
    // The lines of an eval or trap string (splitLines): an expansion error abandons the rest
    // of its line with status 1 and the next line runs, as in a script (runProgram); each
    // line has its own exit block, and any other exit goes on to the enclosing one. Twin of
    // makeLines in bash-interpreter.abnf.
    function makeLines(lines) {
        var seqs = []
        var i
        for (i = 0; i < lines.length; i++) { seqs.push(makeSeq(lines[i])) }
        return function(b) {
            var savedExit = curExit, savedExitRd = curExitRd
            var li
            for (li = 0; li < seqs.length; li++) {
                var lineExit = curF.NewBlock(""), next = curF.NewBlock("")
                curExit = lineExit
                curExitRd = redirStack.length
                b = emitAbortCheck(seqs[li](b))
                b.NewBr(next)
                curExit = savedExit
                curExitRd = savedExitRd
                // In a subshell the abandoned line ends the subshell instead, status 1.
                var softB = curF.NewBlock("")
                var soft = lineExit.NewICmp(llvm.enum.IPredEQ, lineExit.NewLoad(i32, gExited), llvm.constant.NewInt(i32, 2))
                var top = lineExit.NewICmp(llvm.enum.IPredEQ, lineExit.NewLoad(i32, gSsDepth), zero)
                lineExit.NewCondBr(lineExit.NewAnd(soft, top), softB, viaUnwind(savedExit, savedExitRd))
