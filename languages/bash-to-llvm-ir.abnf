                else if (ch == 36 && n1 == 123 && (c.peek(k + 2) == 32 || c.peek(k + 2) == 9 || c.peek(k + 2) == 10 || c.peek(k + 2) == 124)) {
                    depth = depth + 1
                    k = k + 3
                    cmd = true
                } else if (ch == 123 && cmd && (n1 == 32 || n1 == 9 || n1 == 10)) { depth = depth + 1; k = k + 1 }
                else if (ch == 125 && cmd) {
