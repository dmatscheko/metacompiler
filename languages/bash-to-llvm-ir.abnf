        var mv = iv.NewCall(reNum)
        iv.NewStore(mv, mp)
        var ivc = f.NewBlock("rpivc"), ivn = f.NewBlock("rpivn"), ivm = f.NewBlock("rpivm")
        iv.NewCondBr(iv.NewICmp(reEQ, iv.NewCall(reAt, zero), reK(44)), ivc, ivm)
        ivm.NewStore(mv, np)
        ivm.NewBr(ivn)
