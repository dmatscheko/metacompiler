                // rt_local_here asks.
                if (lexAgain || loopStack.length > 0) {
                    var freshB = curF.NewBlock(""), joinB = curF.NewBlock("")
                    var here = b.NewCall(rtLocalHere, [llvm.constant.NewInt(i32, getVarId(names[j])), b.NewLoad(i32, curFrame.depth)])
                    b.NewCondBr(b.NewICmp(llvm.enum.IPredEQ, here, zero), freshB, joinB)
                    freshLocal(freshB, j)
                    freshB.NewBr(joinB)
                    b = joinB
                } else { freshLocal(b, j) }
            }
