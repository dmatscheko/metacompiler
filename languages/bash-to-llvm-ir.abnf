    var rtPutc = rtDecl("rt_putc", false, [0])
    var rtCapBegin = rtDecl("rt_cap_begin", false, [0])
    var rtCapEnd = rtDecl("rt_cap_end", true, [0])
    var rtPrints = rtDecl("rt_prints", false, [1])
    var rtSsSave = rtDecl("rt_ss_save", false, [0])
    var rtSsRestore = rtDecl("rt_ss_restore", false, [0])
    var rtPushLocal = rtDecl("rt_push_local", false, [0])
    var rtPopLocals = rtDecl("rt_pop_locals", false, [0])
    var rtUnsetUp = rtDecl("rt_unset_up", false, [0, 0, 0])

    // ===================================================================================
    //  Value helpers used by the thunks.
    // ===================================================================================

    // The current string value of a variable / special name, as an i8* in block b.
    function allDigits(t) {
        if (t.length == 0) { return false }
        var i
        for (i = 0; i < t.length; i++) { var cc = t.charCodeAt(i); if (cc < 48 || cc > 57) { return false } }
        return true
    }
    function varString(b, name) {
        if (name == "?") { return i2s(b, b.NewLoad(i32, gStatus)) }
        if (name == "#") { return i2s(b, b.NewLoad(i32, gFrameN)) }
        if (name == "*") { return b.NewCall(rtParams, [ifsFirstValue(b), one]) }
        if (name == "@") { return b.NewCall(rtParams, [ifsFirstValue(b), zero]) }
        // There is no process behind a compiled run, so $$ and $! are fixed values.
        if (name == "$") { return gepStr(b, "1000") }
        if (name == "!") { return gepStr(b, "0") }
        if (name == "-") { return gepStr(b, "hB") }
        if (allDigits(name)) {
            var idx = parseDec(name)
            // $0 IS THE SCRIPT: c.file is the program's path exactly as the metacompiler was
            // given it, which is what a real shell holds.
            if (idx == 0) { return gepStr(b, c.file) }
            return b.NewCall(rtParam, llvm.constant.NewInt(i32, idx))
        }
