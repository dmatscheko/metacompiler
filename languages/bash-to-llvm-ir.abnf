                hid = hidePrefix(hx, asgs, roPs)
                b = hx.b
            }
            if (hid.length > 0) { evalScopes.push({hid: hid, depth: depth, fr: curFrame}) }
            b = run(b)
            if (hid.length > 0) { evalScopes.pop() }
            unhidePrefix(hid)
            cmdT = cmd0
            argTs = args0
            redirs = redirs0
            // The string's own declarations outlive the bindings (rt_env_end).
            if (hid.length > 0) { b.NewCall(rtEnvEnd, [b.NewLoad(i32, depth), llvm.constant.NewInt(i32, hid.length)]) }
            else { b.NewCall(rtPopLocals, b.NewLoad(i32, depth)) }
            if (empty == null) { return b }
            var keepB = curF.NewBlock(""), done = curF.NewBlock("")
            b.NewCondBr(empty, keepB, done)
            for (k = 0; k < asgs.length; k++) { if (vals[k] != null) { keepB = emitStoreAttr(keepB, asgs[k].aname, vals[k]) } }
            keepB.NewBr(done)
            return done
        }
    }
    // A command's word, expanded now: the word the command reads instead, which hands back
    // the value (pv) wherever it is read.
    function expandedWord(bx, w) {
        if (w.c != undefined) { return w }
        var r = w.fn(bx.b)
        bx.b = r.b
        var v = r.v
        return {s: w.s, f: w.f, c: undefined, pv: v, fn: function(b) { return {b: b, v: v} }}
    }
    // A redirection's word under prefix assignments: expanded with the names holding the values
    // they had before them (olds, loaded in order, so restoring them backwards leaves each
    // name's first one).
    function prefixOuter(w, asgs, olds) {
        return {s: w.s, f: w.f, c: undefined, fn: function(b) {
            var cur = []
            var k
            for (k = 0; k < asgs.length; k++) { cur.push(olds[k] == null ? null : loadVar(b, asgs[k].aname)) }
            for (k = asgs.length - 1; k >= 0; k--) { if (olds[k] != null) { storeVarRaw(b, asgs[k].aname, olds[k]) } }
            var r = w.fn(b)
            for (k = 0; k < asgs.length; k++) { if (olds[k] != null) { storeVarRaw(r.b, asgs[k].aname, cur[k]) } }
            return r
        }}
    }
    // Whether a command substitution stands in the command's words or prefix assignments.
    function hasCmdSub(cmdT, argTs, asgs) {
        if (cmdT.s == true) { return true }
        var k
        for (k = 0; k < argTs.length; k++) { if (argTs[k].s == true) { return true } }
        if (asgs == null) { return false }
        for (k = 0; k < asgs.length; k++) { if (asgs[k].val != null && asgs[k].val.s == true) { return true } }
        return false
    }
    // bash expands a command's words BEFORE it applies the command's redirections, so what an
    // expansion writes to stderr (a command substitution's own stderr, an arithmetic error) or
    // reads from stdin goes to the streams in effect before them: `echo "$(echo hi >&2)"
    // 2>/dev/null` prints hi. The builtins interleave expansion with their own work, so each
    // non-literal word runs with the saved streams exchanged back in. Twin of makeSimpleCommand
    // in bash-interpreter.abnf, which expands every word before openRedirs.
    function preRedirWord(w, sv) {
        if (w.c != undefined || w.pv != undefined) { return w }
        var o = {s: w.s, f: w.f, c: undefined, fn: preRedirFn(w.fn, sv)}
        if (w.spw != undefined) { o.spw = {s: w.spw.s, f: w.spw.f, c: w.spw.c, fn: preRedirFn(w.spw.fn, sv)} }
        return o
    }
    function preRedirFn(fn, sv) {
        // While swapped the globals already hold the outer streams, so a branch out of the
        // expansion must not "close" sv again: it is off redirStack for the duration.
        return function(b) {
            swapRedirs(b, sv)
            var top = redirStack.pop()
            var r = fn(b)
            redirStack.push(top)
            swapRedirs(r.b, sv)
            return r
        }
    }
    // Exchanges the stream globals with emitOpenRedirs' saved copies.
    function swapRedirs(b, sv) {
        var o = b.NewLoad(i32, gSinkOut), e = b.NewLoad(i32, gSinkErr)
        var ib = null, ip = null
        if (sv.sb != null) { ib = b.NewLoad(i8ptr, gStdin); ip = b.NewLoad(i32, gStdinPos) }
        emitCloseRedirs(b, sv)
        b.NewStore(o, sv.so)
        b.NewStore(e, sv.se)
        if (sv.sb != null) { b.NewStore(ib, sv.sb); b.NewStore(ip, sv.sp) }
    }

    // `cmd &` : the parser leaves an {amp} marker AFTER the statement it applies to, so a
    // statement list is a mix of thunks and markers. linkAsync folds the markers away.
    // The {nl} marker a top-level separator run with a newline in it leaves (see Program).
    function pushLineEnd(t) {
        var i
        for (i = 0; i < t.length; i++) { if (t.charAt(i) == "\n") { push({nl: 1}); return } }
    }
    // The top-level items as lines of statements, each list folded by linkAsync.
    function splitLines(items) {
