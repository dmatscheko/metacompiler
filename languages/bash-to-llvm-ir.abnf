    // each terminated by "\x01"; rt_fput appends one field, escaped (bash-rt.c).
    var rtFput = rtDecl("rt_fput", true, [1, 1])
    var rtField = rtDecl("rt_field", true, [1, 1, 0, 0])
    var rtPrintf = rtDecl("rt_printf", true, [1, 1])
    var rtPfOut = rtDecl("rt_pf_out", false, [1])
    var rtPfValue = rtDecl("rt_pf_value", true, [1])
    var gPrintfRc = rtGlobal("printf_rc", i32)
    var rtNFields = rtDecl("rt_nfields", false, [1])
    var rtGetField = rtDecl("rt_getfield", true, [1, 0])
    var rtWordJoin = rtDecl("rt_wordjoin", true, [1])
    var rtSplitIfs = rtDecl("rt_splitifs", true, [1, 1])
    var rtUqList = rtDecl("rt_uqlist", true, [1, 1])
    var rtBndAcc = rtDecl("rt_bnd_acc", true, [1, 1, 1])
    var rtBndOpen = rtDecl("rt_bnd_open", true, [1, 1])
    var rtBndAcc2 = rtDecl("rt_bnd_acc2", true, [1, 1, 0, 1, 0, 0])
    var rtBndOpen2 = rtDecl("rt_bnd_open2", true, [1, 0, 1, 0, 0])
    var rtBndOpened2 = rtDecl("rt_bnd_opened2", false, [0, 1, 0, 0])
    var rtIfsLead = rtDecl("rt_ifslead", false, [1, 1])
    var rtIfsTrail = rtDecl("rt_ifstrail", false, [1, 1])

