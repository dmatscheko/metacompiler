    // standard error channel, 2 = discarded. Which channel a redirection routes a command to is
    // modelled exactly.
    var gSinkOut = rtGlobal("sink_out", i32)
    var gSinkErr = rtGlobal("sink_err", i32)
    // 1 only in a native build: lets rt_putc send the standard error channel to fd 2. llvm.Run
    // has no fd 2 and no `write` extern; see rt_putc in languages/lib/bash-rt.c.
    var gErrNative = rtGlobal("err_native", i32)
