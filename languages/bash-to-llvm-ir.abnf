            var empty = null
            if (cmdT.pv != undefined && cmd0.f == true) { empty = b.NewICmp(llvm.enum.IPredEQ, b.NewCall(rtNFields, cmdT.pv), zero) }
            cmdMark = mk0
            tmpDepth = isFn ? depth : null
            b = run(b)
            cmdT = cmd0
            argTs = args0
            redirs = redirs0
            b.NewCall(rtPopLocals, b.NewLoad(i32, depth))
            if (empty == null) { return b }
            var keepB = curF.NewBlock(""), done = curF.NewBlock("")
            b.NewCondBr(empty, keepB, done)
            for (k = 0; k < asgs.length; k++) { keepB = emitStoreAttr(keepB, asgs[k].aname, vals[k]) }
            keepB.NewBr(done)
            return done
