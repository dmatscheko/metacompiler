            if (upper) { upVars["$" + names[j]] = true; loVars["$" + names[j]] = false }
            if (lower) { loVars["$" + names[j]] = true; upVars["$" + names[j]] = false }
            // +i +u +l +n take the attribute away (+x +a +A change nothing here).
            if (plus.indexOf("i") >= 0) { intVars["$" + names[j]] = false }
            if (plus.indexOf("u") >= 0) { upVars["$" + names[j]] = false }
            if (plus.indexOf("l") >= 0) { loVars["$" + names[j]] = false }
            if (plus.indexOf("n") >= 0) { refVars["$" + names[j]] = false; b.NewCall(rtNmark, [gepStr(b, names[j]), zero]) }
            if (isRef && isArray) { refFail() }
