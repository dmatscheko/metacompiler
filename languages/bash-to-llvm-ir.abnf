    // `local` unwinder can restore a slot chosen at run time (a per-name global could only
    // be reached through a generated dispatch).
    var NVARS = 1024
    var gvarsTy = llvm.types.NewArray(NVARS, i8ptr)
    var gVars = m.NewGlobalDef("gvars", llvm.constant.NewZeroInitializer(gvarsTy))

    var varIds = {}       // "$"+name -> slot index
    var varIdList = []    // index -> name (creation order, for the deterministic init run)
    function getVarId(name) {
        var key = "$" + name
        if (hasOwn(varIds, key)) { return varIds[key] }
        var id = varIdList.length
        if (id >= NVARS) { fail("too many distinct variables (limit " + NVARS + ")") }
        varIds[key] = id
        varIdList.push(name)
        return id
    }
    function varPtr(b, name) {
        return b.NewGetElementPtr(gvarsTy, gVars, zero, llvm.constant.NewInt(i32, getVarId(name)))
    }
    function loadVar(b, name) { return b.NewLoad(i8ptr, varPtr(b, name)) }
    function storeVar(b, name, v) { b.NewStore(v, varPtr(b, name)) }

    // The `local` save stack: (slot id, previous value) pairs. A function records the stack
    // depth on entry and unwinds back to it at every return, so a `return` from anywhere -
    // including out of a loop - restores every name the call declared local.
    var LSMAX = 512
    var lsIdTy = llvm.types.NewArray(LSMAX, i32)
    var lsValTy = llvm.types.NewArray(LSMAX, i8ptr)
    var gLsId = m.NewGlobalDef("ls_id", llvm.constant.NewZeroInitializer(lsIdTy))
    var gLsVal = m.NewGlobalDef("ls_val", llvm.constant.NewZeroInitializer(lsValTy))
    var gLsTop = m.NewGlobalDef("ls_top", zero)

    // Output capture for $( ) / ` ` : a stack of fixed-size arena buffers. While the depth is
    // non-zero every byte a command would print lands in the innermost buffer instead of on
    // stdout, which is what makes nesting ( $(echo "$(echo x)") ) work.
    var CAPMAX = 16
    var CAPSZ = 8192
    var capBufTy = llvm.types.NewArray(CAPMAX, i8ptr)
    var capLenTy = llvm.types.NewArray(CAPMAX, i32)
    var gCapBuf = m.NewGlobalDef("cap_buf", llvm.constant.NewZeroInitializer(capBufTy))
    var gCapLen = m.NewGlobalDef("cap_len", llvm.constant.NewZeroInitializer(capLenTy))
    var gCapDepth = m.NewGlobalDef("cap_depth", zero)

    // Subshell isolation: ( LIST ) snapshots the whole variable array and restores it.
    var SSDEPTH = 8
    var ssTy = llvm.types.NewArray(SSDEPTH * NVARS, i8ptr)
    var gSs = m.NewGlobalDef("ss_save", llvm.constant.NewZeroInitializer(ssTy))
    var gSsDepth = m.NewGlobalDef("ss_depth", zero)
    var gNvars = m.NewGlobalDef("nvars", zero)   // filled by main's entry block
    // The standard input a pipeline stage hands on (the compiler has no `read` yet).
    var gStdin = m.NewGlobalDef("stdin_buf", llvm.constant.NewNull(i8ptr))

    // Shell options (set -e / -u / -o pipefail) and the abort flag a set -u failure raises
    // during expansion (expansion cannot return a status, so the command about to run picks
    // it up - exactly the shape the interpreter uses).
    var gOptE = m.NewGlobalDef("opt_errexit", zero)
    var gOptU = m.NewGlobalDef("opt_nounset", zero)
    var gOptPf = m.NewGlobalDef("opt_pipefail", zero)
    var gAbort = m.NewGlobalDef("abort_flag", zero)
    var gCondErr = m.NewGlobalDef("cond_err", zero)   // a [[ ]] that could not be evaluated

    // Two output channels. 0 = standard output (captured by $( ) when one is open), 1 = the
    // standard error channel, 2 = discarded. There is no stderr primitive behind a compiled
    // run either, so channel 1's text is dropped - what MATTERS is which channel a
    // redirection routes a command to, and that is modelled exactly.
    var gSinkOut = m.NewGlobalDef("sink_out", zero)
    var gSinkErr = m.NewGlobalDef("sink_err", one)
    // Standard input for `read`: the buffer and the read position.
    var gStdinPos = m.NewGlobalDef("stdin_pos", zero)

    // Positional parameters live in ONE global stack rather than in function arguments, so
    // "$@" can expand to any number of words and `shift` and `set --` are ordinary writes.
    // A call pushes its (field-expanded) arguments, records base/count, and restores both
    // plus the stack top afterwards - which is what makes recursion work.
    var NARGV = 4096
    var argvTy = llvm.types.NewArray(NARGV, i8ptr)
    var gArgv = m.NewGlobalDef("argv", llvm.constant.NewZeroInitializer(argvTy))
    var gArgvTop = m.NewGlobalDef("argv_top", zero)
    var gFrameBase = m.NewGlobalDef("frame_base", zero)
    var gFrameN = m.NewGlobalDef("frame_n", zero)

    // ===================================================================================
    //  Emitter state.
    // ===================================================================================

    var curF = null       // the IR function currently being emitted into
    var curExit = null     // its exit block (an `exit N` / propagated exit branches here)
    var curFrame = null    // null at top level, else {params: [9 i8* values], argc: i32 value}
    var condDepth = 0      // >0 while emitting a CONDITION (set -e must not fire there)
    var loopStack = []     // {brk, cont} target blocks of the loops being emitted
    var trapList = []      // EXIT traps registered in the (sub)shell being emitted
    var trapCount = 0
    var deadCount = 0
    function deadBlock() { deadCount = deadCount + 1; return curF.NewBlock("dead" + deadCount) }

    var strGlobals = {}   // interned string constants:  "$"+content -> {g, ty}
    var strCount = 0
    function internStr(s) {
        var key = "$" + s
        if (hasOwn(strGlobals, key)) { return strGlobals[key] }
        var ty = llvm.types.NewArray(utf8Len(s) + 1, i8)
        var g = m.NewGlobalDef("str" + strCount, llvm.constant.NewCharArrayFromString(s + "\x00"))
        strCount = strCount + 1
        var rec = {g: g, ty: ty}
        strGlobals[key] = rec
        return rec
    }
    // An i8* value pointing at an interned constant string, materialized in block b.
    function gepStr(b, s) {
        if (s == "") { return emptyPtr(b) }
        var r = internStr(s)
        return b.NewGetElementPtr(r.ty, r.g, zero, zero)
    }

    // i32 rt_setvar_byname(i8* name, i8* val) and i32 rt_eval_assign(i8* "NAME=VALUE"):
    // both filled in once the walk is over and every variable name is known.
    var rtSetByName = m.NewFunc("rt_setvar_byname", i32,
        [llvm.ir.NewParam("n", i8ptr), llvm.ir.NewParam("v", i8ptr)])
    var rtEvalAssign = m.NewFunc("rt_eval_assign", i32, llvm.ir.NewParam("s", i8ptr))

    // i8* rt_getvar_byname(i8* name): ${!ptr} indirection. Its body is a chain over every
    // variable name the program mentions, so it can only be emitted once the walk is over.
    var rtGetByName = m.NewFunc("rt_getvar_byname", i8ptr, llvm.ir.NewParam("n", i8ptr))

    var funcs = {}        // user functions: "$"+name -> IR func (bashfn_NAME)
    var declaredFuncs = {}  // every name the program DEFINES somewhere (collected during the
                            // walk, so a call emitted before the definition still resolves)
    var definedFuncs = {}   // names whose body has already been emitted
    var fnCount = 0

    function bashFnParams() { return [] }
    // The IR function for a bash function name, declared on first reference. A forward call
    // (`f` above its `f() {...}`) is ordinary in a shell script, so it must not fall through
    // to "command not found".
    function funcFor(name) {
        var key = "$" + name
        if (hasOwn(funcs, key)) { return funcs[key] }
        if (!hasOwn(declaredFuncs, key)) { return null }
        var f = m.NewFunc("bashfn_" + name, i32)
        funcs[key] = f
        return f
    }

    // ===================================================================================
    //  The string runtime, hand-emitted as IR functions.
    // ===================================================================================

    // i8* rt_bump(i32 n): return &arena[pos]; pos += n.
    var rtBump = m.NewFunc("rt_bump", i8ptr, llvm.ir.NewParam("n", i32))
    ;(function() {
        var n = rtBump.Params[0]
        var b = rtBump.NewBlock("entry")
        var p = b.NewLoad(i32, gApos)
        var ptr = b.NewGetElementPtr(arenaTy, gArena, zero, p)
        b.NewStore(b.NewAdd(p, n), gApos)
        b.NewRet(ptr)
    })()

    // i32 rt_strlen(i8* s)
    var rtStrlen = m.NewFunc("rt_strlen", i32, llvm.ir.NewParam("s", i8ptr))
    ;(function() {
        var s = rtStrlen.Params[0]
        var e = rtStrlen.NewBlock("entry")
        var h = rtStrlen.NewBlock("head")
        var bd = rtStrlen.NewBlock("body")
        var x = rtStrlen.NewBlock("exit")
        var ip = e.NewAlloca(i32)
        e.NewStore(zero, ip)
        e.NewBr(h)
        var i = h.NewLoad(i32, ip)
        var ch = h.NewLoad(i8, h.NewGetElementPtr(i8, s, i))
        h.NewCondBr(h.NewICmp(llvm.enum.IPredEQ, ch, zero8), x, bd)
        bd.NewStore(bd.NewAdd(i, one), ip)
        bd.NewBr(h)
        x.NewRet(x.NewLoad(i32, ip))
    })()

    // i32 rt_charlen(i8* s): the number of CHARACTERS in s, which is what bash's
    // ${#s} counts - not bytes (rt_strlen) and not UTF-16 units. A UTF-8
    // continuation byte is 10xxxxxx, so every byte with (b & 0xC0) != 0x80 starts
    // one character. `${#s}` on "a<emoji>b" is 3 in bash 5.3, was 6 here.
    // The block labels carry a "cl" prefix: a parameter name and a block label
    // share one per-function namespace in textual IR (see docs/abnf-dialect-gotchas.md).
    var rtCharLen = m.NewFunc("rt_charlen", i32, llvm.ir.NewParam("s", i8ptr))
    ;(function() {
        var s = rtCharLen.Params[0]
        var e = rtCharLen.NewBlock("entry")
        var h = rtCharLen.NewBlock("clhead")
        var bd = rtCharLen.NewBlock("clbody")
        var cnt = rtCharLen.NewBlock("clcount")
        var nx = rtCharLen.NewBlock("clnext")
        var x = rtCharLen.NewBlock("clexit")
        var ip = e.NewAlloca(i32)
        var np = e.NewAlloca(i32)
        e.NewStore(zero, ip)
        e.NewStore(zero, np)
        e.NewBr(h)
        var i = h.NewLoad(i32, ip)
        var ch = h.NewLoad(i8, h.NewGetElementPtr(i8, s, i))
        h.NewCondBr(h.NewICmp(llvm.enum.IPredEQ, ch, zero8), x, bd)
        var c32 = bd.NewZExt(ch, i32)
        var isCont = bd.NewICmp(llvm.enum.IPredEQ,
                                bd.NewAnd(c32, llvm.constant.NewInt(i32, 192)),
                                llvm.constant.NewInt(i32, 128))
        bd.NewCondBr(isCont, nx, cnt)
        cnt.NewStore(cnt.NewAdd(cnt.NewLoad(i32, np), one), np)
        cnt.NewBr(nx)
        nx.NewStore(nx.NewAdd(nx.NewLoad(i32, ip), one), ip)
        nx.NewBr(h)
        x.NewRet(x.NewLoad(i32, np))
    })()

    // i32 rt_charoff(i8* s, i32 k): the BYTE offset of character number k, clamped
    // to the length of s. rt_csubstr converts a character range with it.
    var rtCharOff = m.NewFunc("rt_charoff", i32,
        [llvm.ir.NewParam("s", i8ptr), llvm.ir.NewParam("k", i32)])
    ;(function() {
        var s = rtCharOff.Params[0], k0 = rtCharOff.Params[1]
        var e = rtCharOff.NewBlock("entry")
        var h = rtCharOff.NewBlock("cohead")
        var bd = rtCharOff.NewBlock("cobody")
        var cnt = rtCharOff.NewBlock("cocount")
        var bump = rtCharOff.NewBlock("cobump")
        var nx = rtCharOff.NewBlock("conext")
        var x = rtCharOff.NewBlock("coexit")
        var ip = e.NewAlloca(i32)
        var np = e.NewAlloca(i32)
        e.NewStore(zero, ip)
        e.NewStore(zero, np)
        e.NewBr(h)
        var i = h.NewLoad(i32, ip)
        var ch = h.NewLoad(i8, h.NewGetElementPtr(i8, s, i))
        h.NewCondBr(h.NewICmp(llvm.enum.IPredEQ, ch, zero8), x, bd)
        var c32 = bd.NewZExt(ch, i32)
        var isCont = bd.NewICmp(llvm.enum.IPredEQ,
                                bd.NewAnd(c32, llvm.constant.NewInt(i32, 192)),
                                llvm.constant.NewInt(i32, 128))
        bd.NewCondBr(isCont, nx, cnt)
        // At a character START: this is character number n. Once n has reached k
        // the walk is done and i IS the byte offset asked for; otherwise count it
        // and step over its continuation bytes on the following iterations.
        var n = cnt.NewLoad(i32, np)
        cnt.NewCondBr(cnt.NewICmp(llvm.enum.IPredSGE, n, k0), x, bump)
        bump.NewStore(bump.NewAdd(n, one), np)
        bump.NewBr(nx)
        nx.NewStore(nx.NewAdd(nx.NewLoad(i32, ip), one), ip)
        nx.NewBr(h)
        x.NewRet(x.NewLoad(i32, ip))
    })()

    // i32 rt_streq(i8* a, i8* b) -> 1 if equal, else 0.
    var rtStreq = m.NewFunc("rt_streq", i32, [llvm.ir.NewParam("a", i8ptr), llvm.ir.NewParam("b", i8ptr)])
    ;(function() {
        var a = rtStreq.Params[0], b2 = rtStreq.Params[1]
        var e = rtStreq.NewBlock("entry")
        var h = rtStreq.NewBlock("head")
        var chk = rtStreq.NewBlock("chk")
        var ne = rtStreq.NewBlock("ne")
        var eq = rtStreq.NewBlock("eq")
        var cont = rtStreq.NewBlock("cont")
        var ip = e.NewAlloca(i32)
        e.NewStore(zero, ip)
        e.NewBr(h)
        var i = h.NewLoad(i32, ip)
        var ca = h.NewLoad(i8, h.NewGetElementPtr(i8, a, i))
        var cb = h.NewLoad(i8, h.NewGetElementPtr(i8, b2, i))
        h.NewCondBr(h.NewICmp(llvm.enum.IPredNE, ca, cb), ne, chk)
        chk.NewCondBr(chk.NewICmp(llvm.enum.IPredEQ, ca, zero8), eq, cont)
        cont.NewStore(cont.NewAdd(i, one), ip)
        cont.NewBr(h)
        ne.NewRet(zero)
        eq.NewRet(one)
    })()

    // i32 rt_strcmp(i8* a, i8* b): -1 / 0 / 1 by unsigned byte order (the shell's < and >).
    var rtStrcmp = m.NewFunc("rt_strcmp", i32, [llvm.ir.NewParam("a", i8ptr), llvm.ir.NewParam("b", i8ptr)])
    ;(function() {
        var a = rtStrcmp.Params[0], b2 = rtStrcmp.Params[1]
        var e = rtStrcmp.NewBlock("entry")
        var h = rtStrcmp.NewBlock("head")
        var ck = rtStrcmp.NewBlock("ck")
        var lt = rtStrcmp.NewBlock("lt")
        var gt = rtStrcmp.NewBlock("gt")
        var eq = rtStrcmp.NewBlock("eq")
        var cont = rtStrcmp.NewBlock("cont")
        var ip = e.NewAlloca(i32)
        e.NewStore(zero, ip)
        e.NewBr(h)
        var i = h.NewLoad(i32, ip)
        var ca = h.NewZExt(h.NewLoad(i8, h.NewGetElementPtr(i8, a, i)), i32)
        var cb = h.NewZExt(h.NewLoad(i8, h.NewGetElementPtr(i8, b2, i)), i32)
        h.NewCondBr(h.NewICmp(llvm.enum.IPredSLT, ca, cb), lt, ck)
        ck.NewCondBr(ck.NewICmp(llvm.enum.IPredSGT, ca, cb), gt, cont)
        var step = rtStrcmp.NewBlock("step")
        cont.NewCondBr(cont.NewICmp(llvm.enum.IPredEQ, ca, zero), eq, step)
        step.NewStore(step.NewAdd(i, one), ip)
        step.NewBr(h)
        lt.NewRet(llvm.constant.NewInt(i32, -1))
        gt.NewRet(one)
        eq.NewRet(zero)
    })()

    // i8* rt_strcat(i8* a, i8* b): fresh arena string = a followed by b.
    var rtStrcat = m.NewFunc("rt_strcat", i8ptr, [llvm.ir.NewParam("a", i8ptr), llvm.ir.NewParam("b", i8ptr)])
    ;(function() {
        var a = rtStrcat.Params[0], b2 = rtStrcat.Params[1]
        var e = rtStrcat.NewBlock("entry")
        var la = e.NewCall(rtStrlen, a)
        var lb = e.NewCall(rtStrlen, b2)
        var dst = e.NewCall(rtBump, e.NewAdd(e.NewAdd(la, lb), one))
        var ip = e.NewAlloca(i32) // source index
        var dp = e.NewAlloca(i32) // dest index
        e.NewStore(zero, dp)
        e.NewStore(zero, ip)
        var ha = rtStrcat.NewBlock("ha"), bda = rtStrcat.NewBlock("bda"), xa = rtStrcat.NewBlock("xa")
        e.NewBr(ha)
        var ia = ha.NewLoad(i32, ip)
        var cha = ha.NewLoad(i8, ha.NewGetElementPtr(i8, a, ia))
        ha.NewCondBr(ha.NewICmp(llvm.enum.IPredEQ, cha, zero8), xa, bda)
        var da = bda.NewLoad(i32, dp)
        bda.NewStore(cha, bda.NewGetElementPtr(i8, dst, da))
        bda.NewStore(bda.NewAdd(da, one), dp)
        bda.NewStore(bda.NewAdd(ia, one), ip)
        bda.NewBr(ha)
        xa.NewStore(zero, ip)
        var hb = rtStrcat.NewBlock("hb"), bdb = rtStrcat.NewBlock("bdb"), xb = rtStrcat.NewBlock("xb")
        xa.NewBr(hb)
        var ib = hb.NewLoad(i32, ip)
        var chb = hb.NewLoad(i8, hb.NewGetElementPtr(i8, b2, ib))
        hb.NewCondBr(hb.NewICmp(llvm.enum.IPredEQ, chb, zero8), xb, bdb)
        var db = bdb.NewLoad(i32, dp)
        bdb.NewStore(chb, bdb.NewGetElementPtr(i8, dst, db))
        bdb.NewStore(bdb.NewAdd(db, one), dp)
        bdb.NewStore(bdb.NewAdd(ib, one), ip)
        bdb.NewBr(hb)
        var dn = xb.NewLoad(i32, dp)
        xb.NewStore(zero8, xb.NewGetElementPtr(i8, dst, dn))
        xb.NewRet(dst)
    })()

    // i8* rt_int2str(i32 n): decimal string in the arena (mirrors the interpreter's numToStr).
    var rtInt2str = m.NewFunc("rt_int2str", i8ptr, llvm.ir.NewParam("n", i32))
    ;(function() {
        var tmpArrTy = llvm.types.NewArray(16, i8)
        var n = rtInt2str.Params[0]
        var e = rtInt2str.NewBlock("entry")
        var isZero = rtInt2str.NewBlock("zero")
        var nz = rtInt2str.NewBlock("nz")
        var dst = e.NewCall(rtBump, llvm.constant.NewInt(i32, 16))
        var tmp = e.NewAlloca(tmpArrTy) // digits, filled from the right
        e.NewCondBr(e.NewICmp(llvm.enum.IPredEQ, n, zero), isZero, nz)
        isZero.NewStore(llvm.constant.NewInt(i8, 48), isZero.NewGetElementPtr(i8, dst, zero))
        isZero.NewStore(zero8, isZero.NewGetElementPtr(i8, dst, one))
        isZero.NewRet(dst)
        var neg = nz.NewICmp(llvm.enum.IPredSLT, n, zero)
        var absn = nz.NewSelect(neg, nz.NewSub(zero, n), n)
        var ap = nz.NewAlloca(i32) // running value
        var tp = nz.NewAlloca(i32) // tmp write index (15 -> down)
        nz.NewStore(absn, ap)
        nz.NewStore(llvm.constant.NewInt(i32, 15), tp)
        var dh = rtInt2str.NewBlock("dh"), dbd = rtInt2str.NewBlock("dbd"), dx = rtInt2str.NewBlock("dx")
        nz.NewBr(dh)
        var av = dh.NewLoad(i32, ap)
        dh.NewCondBr(dh.NewICmp(llvm.enum.IPredSLE, av, zero), dx, dbd)
        var d = dbd.NewSRem(av, ten)
        var ti = dbd.NewLoad(i32, tp)
        dbd.NewStore(dbd.NewTrunc(dbd.NewAdd(d, llvm.constant.NewInt(i32, 48)), i8), dbd.NewGetElementPtr(tmpArrTy, tmp, zero, ti))
        dbd.NewStore(dbd.NewSub(ti, one), tp)
        dbd.NewStore(dbd.NewSDiv(av, ten), ap)
        dbd.NewBr(dh)
        var dip = dx.NewAlloca(i32) // dst write index
        dx.NewStore(zero, dip)
        var wsign = rtInt2str.NewBlock("wsign"), asm = rtInt2str.NewBlock("asm")
        dx.NewCondBr(neg, wsign, asm)
        wsign.NewStore(llvm.constant.NewInt(i8, 45), wsign.NewGetElementPtr(i8, dst, zero)) // '-'
        wsign.NewStore(one, dip)
        wsign.NewBr(asm)
        var jp = asm.NewAlloca(i32)
        asm.NewStore(asm.NewAdd(asm.NewLoad(i32, tp), one), jp) // j = ti+1
        var ah = rtInt2str.NewBlock("ah"), abd = rtInt2str.NewBlock("abd"), ax = rtInt2str.NewBlock("ax")
        asm.NewBr(ah)
        var j = ah.NewLoad(i32, jp)
        ah.NewCondBr(ah.NewICmp(llvm.enum.IPredSGT, j, llvm.constant.NewInt(i32, 15)), ax, abd)
        var digit = abd.NewLoad(i8, abd.NewGetElementPtr(tmpArrTy, tmp, zero, j))
        var di = abd.NewLoad(i32, dip)
        abd.NewStore(digit, abd.NewGetElementPtr(i8, dst, di))
        abd.NewStore(abd.NewAdd(di, one), dip)
        abd.NewStore(abd.NewAdd(j, one), jp)
        abd.NewBr(ah)
        ax.NewStore(zero8, ax.NewGetElementPtr(i8, dst, ax.NewLoad(i32, dip))) // NUL
        ax.NewRet(dst)
    })()

    // i32 rt_str2int(i8* s): leading spaces/tabs, one +/- sign, digits until non-digit.
    var rtStr2int = m.NewFunc("rt_str2int", i32, llvm.ir.NewParam("s", i8ptr))
    ;(function() {
        var s = rtStr2int.Params[0]
        var e = rtStr2int.NewBlock("entry")
        var ip = e.NewAlloca(i32)  // index
        var vp = e.NewAlloca(i32)  // value
        var sp = e.NewAlloca(i32)  // sign
        e.NewStore(zero, ip)
        e.NewStore(zero, vp)
        e.NewStore(one, sp)
        var wh = rtStr2int.NewBlock("wh"), wbd = rtStr2int.NewBlock("wbd"), wx = rtStr2int.NewBlock("wx")
        e.NewBr(wh)
        var wi = wh.NewLoad(i32, ip)
        var wc = wh.NewLoad(i8, wh.NewGetElementPtr(i8, s, wi))
        var isSp = wh.NewICmp(llvm.enum.IPredEQ, wc, llvm.constant.NewInt(i8, 32))
        var isTab = wh.NewICmp(llvm.enum.IPredEQ, wc, llvm.constant.NewInt(i8, 9))
        wh.NewCondBr(wh.NewOr(isSp, isTab), wbd, wx)
        wbd.NewStore(wbd.NewAdd(wi, one), ip)
        wbd.NewBr(wh)
        var ci = wx.NewLoad(i32, ip)
        var cc = wx.NewLoad(i8, wx.NewGetElementPtr(i8, s, ci))
        var isMinus = wx.NewICmp(llvm.enum.IPredEQ, cc, llvm.constant.NewInt(i8, 45))
        var isPlus = wx.NewICmp(llvm.enum.IPredEQ, cc, llvm.constant.NewInt(i8, 43))
        var signBlk = rtStr2int.NewBlock("sign"), digs = rtStr2int.NewBlock("digs")
        wx.NewCondBr(wx.NewOr(isMinus, isPlus), signBlk, digs)
        signBlk.NewStore(signBlk.NewSelect(isMinus, llvm.constant.NewInt(i32, -1), one), sp)
        signBlk.NewStore(signBlk.NewAdd(ci, one), ip)
        signBlk.NewBr(digs)
        var dh = rtStr2int.NewBlock("dh"), dbd = rtStr2int.NewBlock("dbd"), dx = rtStr2int.NewBlock("dx")
        digs.NewBr(dh)
        var di = dh.NewLoad(i32, ip)
        var dc = dh.NewLoad(i8, dh.NewGetElementPtr(i8, s, di))
        var dc32 = dh.NewSExt(dc, i32)
        var ge0 = dh.NewICmp(llvm.enum.IPredSGE, dc32, llvm.constant.NewInt(i32, 48))
        var le9 = dh.NewICmp(llvm.enum.IPredSLE, dc32, llvm.constant.NewInt(i32, 57))
        dh.NewCondBr(dh.NewAnd(ge0, le9), dbd, dx)
        var v = dbd.NewLoad(i32, vp)
        dbd.NewStore(dbd.NewAdd(dbd.NewMul(v, ten), dbd.NewSub(dc32, llvm.constant.NewInt(i32, 48))), vp)
        dbd.NewStore(dbd.NewAdd(di, one), ip)
        dbd.NewBr(dh)
        dx.NewRet(dx.NewMul(dx.NewLoad(i32, vp), dx.NewLoad(i32, sp)))
    })()

    // ---- glob (pathname-style) matching in IR: * ? [...] and a backslash escape ------
    // The same matcher backs case and [[ == ]], exactly like the shell. Both functions walk
    // raw i8* pointers; "*" backtracks by CALLING rt_glob again, so the IR call stack is the
    // backtracking stack.

    // i32 rt_class(i8* p, i32 ch): p points at "[". Returns -1 when the bracket expression is
    // unterminated (the "[" is then a literal), else (bytesConsumed << 1) | matched.
    var rtClass = m.NewFunc("rt_class", i32, [llvm.ir.NewParam("p", i8ptr), llvm.ir.NewParam("ch", i32)])
    ;(function() {
        var p2 = rtClass.Params[0], ch = rtClass.Params[1]
        var e = rtClass.NewBlock("entry")
        var h = rtClass.NewBlock("head")
        var it = rtClass.NewBlock("item")
        var mr = rtClass.NewBlock("maybe_range")
        var rg = rtClass.NewBlock("range")
        var sg = rtClass.NewBlock("single")
        var un = rtClass.NewBlock("unterm")
        var dn = rtClass.NewBlock("done")
        var jp = e.NewAlloca(i32), np = e.NewAlloca(i32), mp = e.NewAlloca(i32), fp = e.NewAlloca(i32)
        e.NewStore(one, jp); e.NewStore(zero, np); e.NewStore(zero, mp); e.NewStore(one, fp)
        var c0 = e.NewZExt(e.NewLoad(i8, e.NewGetElementPtr(i8, p2, one)), i32)
        var isNeg = e.NewOr(e.NewICmp(llvm.enum.IPredEQ, c0, llvm.constant.NewInt(i32, 33)),
                            e.NewICmp(llvm.enum.IPredEQ, c0, llvm.constant.NewInt(i32, 94)))
        e.NewStore(e.NewSelect(isNeg, one, zero), np)
        e.NewStore(e.NewSelect(isNeg, llvm.constant.NewInt(i32, 2), one), jp)
        e.NewBr(h)

        var j = h.NewLoad(i32, jp)
        var cj = h.NewZExt(h.NewLoad(i8, h.NewGetElementPtr(i8, p2, j)), i32)
        var atEnd = h.NewICmp(llvm.enum.IPredEQ, cj, zero)
        var closes = h.NewAnd(h.NewICmp(llvm.enum.IPredEQ, cj, llvm.constant.NewInt(i32, 93)),
                              h.NewICmp(llvm.enum.IPredEQ, h.NewLoad(i32, fp), zero))
        var h2 = rtClass.NewBlock("h2")
        h.NewCondBr(atEnd, un, h2)
        h2.NewCondBr(closes, dn, it)

        it.NewStore(zero, fp)
        var cn = it.NewZExt(it.NewLoad(i8, it.NewGetElementPtr(i8, p2, it.NewAdd(j, one))), i32)
        it.NewCondBr(it.NewICmp(llvm.enum.IPredEQ, cn, llvm.constant.NewInt(i32, 45)), mr, sg)

        var cn2 = mr.NewZExt(mr.NewLoad(i8, mr.NewGetElementPtr(i8, p2, mr.NewAdd(j, llvm.constant.NewInt(i32, 2)))), i32)
        var okRange = mr.NewAnd(mr.NewICmp(llvm.enum.IPredNE, cn2, zero),
                                mr.NewICmp(llvm.enum.IPredNE, cn2, llvm.constant.NewInt(i32, 93)))
        mr.NewCondBr(okRange, rg, sg)

        var inR = rg.NewAnd(rg.NewICmp(llvm.enum.IPredSGE, ch, cj), rg.NewICmp(llvm.enum.IPredSLE, ch, cn2))
        rg.NewStore(rg.NewSelect(inR, one, rg.NewLoad(i32, mp)), mp)
        rg.NewStore(rg.NewAdd(j, llvm.constant.NewInt(i32, 3)), jp)
        rg.NewBr(h)

        var eq1 = sg.NewICmp(llvm.enum.IPredEQ, ch, cj)
        sg.NewStore(sg.NewSelect(eq1, one, sg.NewLoad(i32, mp)), mp)
        sg.NewStore(sg.NewAdd(j, one), jp)
        sg.NewBr(h)

        un.NewRet(llvm.constant.NewInt(i32, -1))

        var mv = dn.NewLoad(i32, mp)
        var neg = dn.NewICmp(llvm.enum.IPredNE, dn.NewLoad(i32, np), zero)
        var fin = dn.NewSelect(neg, dn.NewSub(one, mv), mv)
        dn.NewRet(dn.NewOr(dn.NewMul(dn.NewAdd(dn.NewLoad(i32, jp), one), llvm.constant.NewInt(i32, 2)), fin))
    })()

    // i32 rt_glob(i8* pat, i8* s): 1 when the whole subject matches the whole pattern.
    var rtGlob = m.NewFunc("rt_glob", i32, [llvm.ir.NewParam("p", i8ptr), llvm.ir.NewParam("s", i8ptr)])
    ;(function() {
        var p0 = rtGlob.Params[0], s0 = rtGlob.Params[1]
        var e = rtGlob.NewBlock("entry")
        var h = rtGlob.NewBlock("head")
        var pend = rtGlob.NewBlock("pend")
        var nostar = rtGlob.NewBlock("nostar")
        var starsk = rtGlob.NewBlock("starsk")
        var staraf = rtGlob.NewBlock("staraf")
        var kloop = rtGlob.NewBlock("kloop")
        var knext = rtGlob.NewBlock("knext")
        var havec = rtGlob.NewBlock("havec")
        var qm = rtGlob.NewBlock("qmark")
        var nq = rtGlob.NewBlock("nq")
        var brk = rtGlob.NewBlock("brack")
        var cls = rtGlob.NewBlock("cls")
        var clsok = rtGlob.NewBlock("clsok")
        var nb = rtGlob.NewBlock("nb")
        var esc = rtGlob.NewBlock("esc")
        var escok = rtGlob.NewBlock("escok")
        var lit = rtGlob.NewBlock("lit")
        var litok = rtGlob.NewBlock("litok")
        var r0 = rtGlob.NewBlock("ret0")
        var r1 = rtGlob.NewBlock("ret1")
        var two = llvm.constant.NewInt(i32, 2)

        var pp = e.NewAlloca(i8ptr), sp = e.NewAlloca(i8ptr)
        e.NewStore(p0, pp); e.NewStore(s0, sp)
        e.NewBr(h)

        var pcur = h.NewLoad(i8ptr, pp)
        var pc = h.NewZExt(h.NewLoad(i8, h.NewGetElementPtr(i8, pcur, zero)), i32)
        h.NewCondBr(h.NewICmp(llvm.enum.IPredEQ, pc, zero), pend, nostar)

        var sat = pend.NewZExt(pend.NewLoad(i8, pend.NewGetElementPtr(i8, pend.NewLoad(i8ptr, sp), zero)), i32)
        pend.NewCondBr(pend.NewICmp(llvm.enum.IPredEQ, sat, zero), r1, r0)

        nostar.NewCondBr(nostar.NewICmp(llvm.enum.IPredEQ, pc, llvm.constant.NewInt(i32, 42)), starsk, havec)

        // skip a run of "*"
        var sk = starsk.NewLoad(i8ptr, pp)
        var skc = starsk.NewZExt(starsk.NewLoad(i8, starsk.NewGetElementPtr(i8, sk, zero)), i32)
        var skadv = rtGlob.NewBlock("skadv")
        starsk.NewCondBr(starsk.NewICmp(llvm.enum.IPredEQ, skc, llvm.constant.NewInt(i32, 42)), skadv, staraf)
        skadv.NewStore(skadv.NewGetElementPtr(i8, sk, one), pp)
        skadv.NewBr(starsk)

        var pafter = staraf.NewLoad(i8ptr, pp)
        var pac = staraf.NewZExt(staraf.NewLoad(i8, staraf.NewGetElementPtr(i8, pafter, zero)), i32)
        staraf.NewCondBr(staraf.NewICmp(llvm.enum.IPredEQ, pac, zero), r1, kloop)

        var scur = kloop.NewLoad(i8ptr, sp)
        var rec = kloop.NewCall(rtGlob, [pafter, scur])
        kloop.NewCondBr(kloop.NewICmp(llvm.enum.IPredNE, rec, zero), r1, knext)
        var kc = knext.NewZExt(knext.NewLoad(i8, knext.NewGetElementPtr(i8, scur, zero)), i32)
        var kadv = rtGlob.NewBlock("kadv")
        knext.NewCondBr(knext.NewICmp(llvm.enum.IPredEQ, kc, zero), r0, kadv)
        kadv.NewStore(kadv.NewGetElementPtr(i8, scur, one), sp)
        kadv.NewBr(kloop)

        var scur2 = havec.NewLoad(i8ptr, sp)
        var sc = havec.NewZExt(havec.NewLoad(i8, havec.NewGetElementPtr(i8, scur2, zero)), i32)
        var havec2 = rtGlob.NewBlock("havec2")
        havec.NewCondBr(havec.NewICmp(llvm.enum.IPredEQ, sc, zero), r0, havec2)
        havec2.NewCondBr(havec2.NewICmp(llvm.enum.IPredEQ, pc, llvm.constant.NewInt(i32, 63)), qm, nq)

        qm.NewStore(qm.NewGetElementPtr(i8, pcur, one), pp)
        qm.NewStore(qm.NewGetElementPtr(i8, scur2, one), sp)
        qm.NewBr(h)

        nq.NewCondBr(nq.NewICmp(llvm.enum.IPredEQ, pc, llvm.constant.NewInt(i32, 91)), brk, nb)

        var cr = brk.NewCall(rtClass, [pcur, sc])
        brk.NewCondBr(brk.NewICmp(llvm.enum.IPredSLT, cr, zero), lit, cls)
        var matched = cls.NewAnd(cr, one)
        var off = cls.NewSDiv(cr, two)
        cls.NewCondBr(cls.NewICmp(llvm.enum.IPredEQ, matched, zero), r0, clsok)
        clsok.NewStore(clsok.NewGetElementPtr(i8, pcur, off), pp)
        clsok.NewStore(clsok.NewGetElementPtr(i8, scur2, one), sp)
        clsok.NewBr(h)

        var nc = nb.NewZExt(nb.NewLoad(i8, nb.NewGetElementPtr(i8, pcur, one)), i32)
        var isEsc = nb.NewAnd(nb.NewICmp(llvm.enum.IPredEQ, pc, llvm.constant.NewInt(i32, 92)),
                              nb.NewICmp(llvm.enum.IPredNE, nc, zero))
        nb.NewCondBr(isEsc, esc, lit)
        esc.NewCondBr(esc.NewICmp(llvm.enum.IPredEQ, nc, sc), escok, r0)
        escok.NewStore(escok.NewGetElementPtr(i8, pcur, two), pp)
        escok.NewStore(escok.NewGetElementPtr(i8, scur2, one), sp)
        escok.NewBr(h)

        lit.NewCondBr(lit.NewICmp(llvm.enum.IPredEQ, pc, sc), litok, r0)
        litok.NewStore(litok.NewGetElementPtr(i8, pcur, one), pp)
        litok.NewStore(litok.NewGetElementPtr(i8, scur2, one), sp)
        litok.NewBr(h)

        r0.NewRet(zero)
        r1.NewRet(one)
    })()

    // ---- substring / pattern / case helpers for the ${...} family --------------------
    // They are placed after rt_glob because every one of them drives the glob matcher over
    // candidate substrings; rt_substr materializes each candidate in the arena.

    // i8* rt_substr(i8* s, i32 off, i32 n): n < 0 means "to the end". off and n are clamped.
    var rtSubstr = m.NewFunc("rt_substr", i8ptr,
        [llvm.ir.NewParam("s", i8ptr), llvm.ir.NewParam("off", i32), llvm.ir.NewParam("n", i32)])
    ;(function() {
        var s0 = rtSubstr.Params[0], off0 = rtSubstr.Params[1], n0 = rtSubstr.Params[2]
        var e = rtSubstr.NewBlock("entry")
        var h = rtSubstr.NewBlock("head")
        var bd = rtSubstr.NewBlock("body")
        var x = rtSubstr.NewBlock("exit")
        var len = e.NewCall(rtStrlen, s0)
        var off = e.NewSelect(e.NewICmp(llvm.enum.IPredSLT, off0, zero), zero, off0)
        off = e.NewSelect(e.NewICmp(llvm.enum.IPredSGT, off, len), len, off)
        var rest = e.NewSub(len, off)
        var n = e.NewSelect(e.NewICmp(llvm.enum.IPredSLT, n0, zero), rest, n0)
        n = e.NewSelect(e.NewICmp(llvm.enum.IPredSGT, n, rest), rest, n)
        var dst = e.NewCall(rtBump, e.NewAdd(n, one))
        var ip = e.NewAlloca(i32)
        e.NewStore(zero, ip)
        e.NewBr(h)
        var i = h.NewLoad(i32, ip)
        h.NewCondBr(h.NewICmp(llvm.enum.IPredSLT, i, n), bd, x)
        bd.NewStore(bd.NewLoad(i8, bd.NewGetElementPtr(i8, s0, bd.NewAdd(off, i))),
                    bd.NewGetElementPtr(i8, dst, i))
        bd.NewStore(bd.NewAdd(i, one), ip)
        bd.NewBr(h)
        x.NewStore(zero8, x.NewGetElementPtr(i8, dst, n))
        x.NewRet(dst)
    })()

    // i8* rt_csubstr(i8* s, i32 off, i32 n): rt_substr with off and n in CHARACTERS,
    // which is what ${s:off:n} slices in bash. rt_substr itself stays byte-based -
    // every pattern helper above drives it over byte positions.
    var rtCSubstr = m.NewFunc("rt_csubstr", i8ptr,
        [llvm.ir.NewParam("s", i8ptr), llvm.ir.NewParam("off", i32), llvm.ir.NewParam("n", i32)])
    ;(function() {
        var s0 = rtCSubstr.Params[0], off0 = rtCSubstr.Params[1], n0 = rtCSubstr.Params[2]
        var e = rtCSubstr.NewBlock("entry")
        var bo = e.NewCall(rtCharOff, [s0, e.NewSelect(e.NewICmp(llvm.enum.IPredSLT, off0, zero), zero, off0)])
        // n < 0 means "to the end"; otherwise the end is off + n characters in.
        var bend = e.NewCall(rtCharOff, [s0, e.NewAdd(off0, e.NewSelect(
            e.NewICmp(llvm.enum.IPredSLT, n0, zero), zero, n0))])
        var byteN = e.NewSelect(e.NewICmp(llvm.enum.IPredSLT, n0, zero),
                                llvm.constant.NewInt(i32, -1), e.NewSub(bend, bo))
        byteN = e.NewSelect(e.NewICmp(llvm.enum.IPredSLT, byteN, zero),
                            llvm.constant.NewInt(i32, -1), byteN)
        e.NewRet(e.NewCall(rtSubstr, [s0, bo, byteN]))
    })()

    // i32 rt_matchlen(i8* pat, i8* s, i32 i): end index of the LONGEST match of pat starting
    // at i, or -1.
    var rtMatchLen = m.NewFunc("rt_matchlen", i32,
        [llvm.ir.NewParam("p", i8ptr), llvm.ir.NewParam("s", i8ptr), llvm.ir.NewParam("i", i32)])
    ;(function() {
        var pt = rtMatchLen.Params[0], s0 = rtMatchLen.Params[1], i0 = rtMatchLen.Params[2]
        var e = rtMatchLen.NewBlock("entry")
        var h = rtMatchLen.NewBlock("head")
        var bd = rtMatchLen.NewBlock("body")
        var hit = rtMatchLen.NewBlock("hit")
        var no = rtMatchLen.NewBlock("no")
        var jp = e.NewAlloca(i32)
        e.NewStore(e.NewCall(rtStrlen, s0), jp)
        e.NewBr(h)
        var j = h.NewLoad(i32, jp)
        h.NewCondBr(h.NewICmp(llvm.enum.IPredSLT, j, i0), no, bd)
        var cand = bd.NewCall(rtSubstr, [s0, i0, bd.NewSub(j, i0)])
        var st = rtMatchLen.NewBlock("step")
        bd.NewCondBr(bd.NewICmp(llvm.enum.IPredNE, bd.NewCall(rtGlob, [pt, cand]), zero), hit, st)
        st.NewStore(st.NewSub(j, one), jp)
        st.NewBr(h)
        hit.NewRet(j)
        no.NewRet(llvm.constant.NewInt(i32, -1))
    })()

    // i32 rt_matchend(i8* pat, i8* s): start index of the LONGEST match of pat that reaches
    // the end of s, or -1.
    var rtMatchEnd = m.NewFunc("rt_matchend", i32,
        [llvm.ir.NewParam("p", i8ptr), llvm.ir.NewParam("s", i8ptr)])
    ;(function() {
        var pt = rtMatchEnd.Params[0], s0 = rtMatchEnd.Params[1]
        var e = rtMatchEnd.NewBlock("entry")
        var h = rtMatchEnd.NewBlock("head")
        var bd = rtMatchEnd.NewBlock("body")
        var st = rtMatchEnd.NewBlock("step")
        var hit = rtMatchEnd.NewBlock("hit")
        var no = rtMatchEnd.NewBlock("no")
        var len = e.NewCall(rtStrlen, s0)
        var ip = e.NewAlloca(i32)
        e.NewStore(zero, ip)
        e.NewBr(h)
        var i = h.NewLoad(i32, ip)
        h.NewCondBr(h.NewICmp(llvm.enum.IPredSGT, i, len), no, bd)
        var cand = bd.NewCall(rtSubstr, [s0, i, llvm.constant.NewInt(i32, -1)])
        bd.NewCondBr(bd.NewICmp(llvm.enum.IPredNE, bd.NewCall(rtGlob, [pt, cand]), zero), hit, st)
        st.NewStore(st.NewAdd(i, one), ip)
        st.NewBr(h)
        hit.NewRet(i)
        no.NewRet(llvm.constant.NewInt(i32, -1))
    })()

    // i8* rt_strip(i8* s, i8* pat, i32 mode): 0 = #, 1 = ##, 2 = %, 3 = %%.
    var rtStrip = m.NewFunc("rt_strip", i8ptr,
        [llvm.ir.NewParam("s", i8ptr), llvm.ir.NewParam("p", i8ptr), llvm.ir.NewParam("mode", i32)])
    ;(function() {
        var s0 = rtStrip.Params[0], pt = rtStrip.Params[1], md = rtStrip.Params[2]
        var e = rtStrip.NewBlock("entry")
        var h = rtStrip.NewBlock("head")
        var bd = rtStrip.NewBlock("body")
        var st = rtStrip.NewBlock("step")
        var hit = rtStrip.NewBlock("hit")
        var no = rtStrip.NewBlock("no")
        var len = e.NewCall(rtStrlen, s0)
        var isPre = e.NewOr(e.NewICmp(llvm.enum.IPredEQ, md, zero), e.NewICmp(llvm.enum.IPredEQ, md, one))
        // ascending k for # and %%, descending for ## and %
        var asc = e.NewOr(e.NewICmp(llvm.enum.IPredEQ, md, zero),
                          e.NewICmp(llvm.enum.IPredEQ, md, llvm.constant.NewInt(i32, 3)))
        var tp = e.NewAlloca(i32)
        var kp = e.NewAlloca(i32)
        e.NewStore(zero, tp)
        e.NewBr(h)
        var t = h.NewLoad(i32, tp)
        h.NewCondBr(h.NewICmp(llvm.enum.IPredSGT, t, len), no, bd)
        var k = bd.NewSelect(asc, t, bd.NewSub(len, t))
        bd.NewStore(k, kp)
        var pre = bd.NewCall(rtSubstr, [s0, zero, k])
        var suf = bd.NewCall(rtSubstr, [s0, k, llvm.constant.NewInt(i32, -1)])
        var cand = bd.NewSelect(isPre, pre, suf)
        bd.NewCondBr(bd.NewICmp(llvm.enum.IPredNE, bd.NewCall(rtGlob, [pt, cand]), zero), hit, st)
        st.NewStore(st.NewAdd(t, one), tp)
        st.NewBr(h)
        var k2 = hit.NewLoad(i32, kp)
        var rpre = hit.NewCall(rtSubstr, [s0, k2, llvm.constant.NewInt(i32, -1)])
        var rsuf = hit.NewCall(rtSubstr, [s0, zero, k2])
        hit.NewRet(hit.NewSelect(isPre, rpre, rsuf))
        no.NewRet(s0)
    })()

    // i8* rt_replace(i8* s, i8* pat, i8* rep, i32 mode): 0 = first, 1 = all, 2 = anchored at
    // the start (#), 3 = anchored at the end (%).
    var rtReplace = m.NewFunc("rt_replace", i8ptr,
        [llvm.ir.NewParam("s", i8ptr), llvm.ir.NewParam("p", i8ptr),
         llvm.ir.NewParam("r", i8ptr), llvm.ir.NewParam("mode", i32)])
    ;(function() {
        var s0 = rtReplace.Params[0], pt = rtReplace.Params[1], rp = rtReplace.Params[2], md = rtReplace.Params[3]
        var three = llvm.constant.NewInt(i32, 3)
        var two = llvm.constant.NewInt(i32, 2)
        var e = rtReplace.NewBlock("entry")
        var anch = rtReplace.NewBlock("anchored")
        var aHash = rtReplace.NewBlock("a_hash")
        var aPct = rtReplace.NewBlock("a_pct")
        var scan = rtReplace.NewBlock("scan")
        var h = rtReplace.NewBlock("head")
        var bd = rtReplace.NewBlock("body")
        var took = rtReplace.NewBlock("took")
        var copy1 = rtReplace.NewBlock("copy1")
        var stop = rtReplace.NewBlock("stop")
        var fin = rtReplace.NewBlock("fin")
        var len = e.NewCall(rtStrlen, s0)
        var outp = e.NewAlloca(i8ptr)
        var ip = e.NewAlloca(i32)
        var donep = e.NewAlloca(i32)
        e.NewStore(emptyPtr(e), outp)
        e.NewStore(zero, ip)
        e.NewStore(zero, donep)
        e.NewCondBr(e.NewICmp(llvm.enum.IPredSGE, md, two), anch, scan)

        anch.NewCondBr(anch.NewICmp(llvm.enum.IPredEQ, md, two), aHash, aPct)
        var jj = aHash.NewCall(rtMatchLen, [pt, s0, zero])
        var okH = rtReplace.NewBlock("ok_hash"), noH = rtReplace.NewBlock("no_hash")
        aHash.NewCondBr(aHash.NewICmp(llvm.enum.IPredSLT, jj, zero), noH, okH)
        okH.NewRet(okH.NewCall(rtStrcat, [rp, okH.NewCall(rtSubstr, [s0, jj, llvm.constant.NewInt(i32, -1)])]))
        noH.NewRet(s0)
        var ii = aPct.NewCall(rtMatchEnd, [pt, s0])
        var okP = rtReplace.NewBlock("ok_pct"), noP = rtReplace.NewBlock("no_pct")
        aPct.NewCondBr(aPct.NewICmp(llvm.enum.IPredSLT, ii, zero), noP, okP)
        okP.NewRet(okP.NewCall(rtStrcat, [okP.NewCall(rtSubstr, [s0, zero, ii]), rp]))
        noP.NewRet(s0)

        scan.NewBr(h)
        var i = h.NewLoad(i32, ip)
        var over = h.NewICmp(llvm.enum.IPredSGT, i, len)
        var dn = h.NewICmp(llvm.enum.IPredNE, h.NewLoad(i32, donep), zero)
        h.NewCondBr(h.NewOr(over, dn), fin, bd)
        var j = bd.NewCall(rtMatchLen, [pt, s0, i])
        bd.NewCondBr(bd.NewICmp(llvm.enum.IPredSGT, j, i), took, copy1)
        // a real (non empty) match: append the replacement and jump past it
        took.NewStore(took.NewCall(rtStrcat, [took.NewLoad(i8ptr, outp), rp]), outp)
        took.NewStore(j, ip)
        took.NewCondBr(took.NewICmp(llvm.enum.IPredEQ, md, zero), stop, h)
        stop.NewStore(stop.NewCall(rtStrcat, [stop.NewLoad(i8ptr, outp),
                        stop.NewCall(rtSubstr, [s0, j, llvm.constant.NewInt(i32, -1)])]), outp)
        stop.NewStore(one, donep)
        stop.NewBr(h)
        // no match here: carry one character across
        copy1.NewStore(copy1.NewCall(rtStrcat, [copy1.NewLoad(i8ptr, outp),
                        copy1.NewCall(rtSubstr, [s0, i, one])]), outp)
        copy1.NewStore(copy1.NewAdd(i, one), ip)
        copy1.NewBr(h)
        fin.NewRet(fin.NewLoad(i8ptr, outp))
    })()

    // i8* rt_case(i8* s, i32 mode): 0 = ^, 1 = ^^, 2 = ",", 3 = ",,".
    var rtCase = m.NewFunc("rt_case", i8ptr, [llvm.ir.NewParam("s", i8ptr), llvm.ir.NewParam("mode", i32)])
    ;(function() {
        var s0 = rtCase.Params[0], md = rtCase.Params[1]
        var e = rtCase.NewBlock("entry")
        var h = rtCase.NewBlock("head")
        var bd = rtCase.NewBlock("body")
        var x = rtCase.NewBlock("exit")
        var len = e.NewCall(rtStrlen, s0)
        var dst = e.NewCall(rtBump, e.NewAdd(len, one))
        var up = e.NewICmp(llvm.enum.IPredSLT, md, llvm.constant.NewInt(i32, 2))
        var all = e.NewOr(e.NewICmp(llvm.enum.IPredEQ, md, one),
                          e.NewICmp(llvm.enum.IPredEQ, md, llvm.constant.NewInt(i32, 3)))
        var ip = e.NewAlloca(i32)
        e.NewStore(zero, ip)
        e.NewBr(h)
        var i = h.NewLoad(i32, ip)
        h.NewCondBr(h.NewICmp(llvm.enum.IPredSLT, i, len), bd, x)
        var c0 = bd.NewZExt(bd.NewLoad(i8, bd.NewGetElementPtr(i8, s0, i)), i32)
        var isLow = bd.NewAnd(bd.NewICmp(llvm.enum.IPredSGE, c0, llvm.constant.NewInt(i32, 97)),
                              bd.NewICmp(llvm.enum.IPredSLE, c0, llvm.constant.NewInt(i32, 122)))
        var isUp = bd.NewAnd(bd.NewICmp(llvm.enum.IPredSGE, c0, llvm.constant.NewInt(i32, 65)),
                             bd.NewICmp(llvm.enum.IPredSLE, c0, llvm.constant.NewInt(i32, 90)))
        var raised = bd.NewSelect(isLow, bd.NewSub(c0, llvm.constant.NewInt(i32, 32)), c0)
        var lowered = bd.NewSelect(isUp, bd.NewAdd(c0, llvm.constant.NewInt(i32, 32)), c0)
        var mapped = bd.NewSelect(up, raised, lowered)
        var touch = bd.NewOr(all, bd.NewICmp(llvm.enum.IPredEQ, i, zero))
        bd.NewStore(bd.NewTrunc(bd.NewSelect(touch, mapped, c0), i8), bd.NewGetElementPtr(i8, dst, i))
        bd.NewStore(bd.NewAdd(i, one), ip)
        bd.NewBr(h)
        x.NewStore(zero8, x.NewGetElementPtr(i8, dst, len))
        x.NewRet(dst)
    })()

    // i32 rt_haschar(i8* s, i32 ch): is ch one of the characters of s?
    var rtHasChar = m.NewFunc("rt_haschar", i32, [llvm.ir.NewParam("s", i8ptr), llvm.ir.NewParam("ch", i32)])
    ;(function() {
        var s0 = rtHasChar.Params[0], ch = rtHasChar.Params[1]
        var e = rtHasChar.NewBlock("entry")
        var h = rtHasChar.NewBlock("head")
        var st = rtHasChar.NewBlock("step")
        var yes = rtHasChar.NewBlock("yes")
        var no = rtHasChar.NewBlock("no")
        var ip = e.NewAlloca(i32)
        e.NewStore(zero, ip)
        e.NewBr(h)
        var i = h.NewLoad(i32, ip)
        var c0 = h.NewZExt(h.NewLoad(i8, h.NewGetElementPtr(i8, s0, i)), i32)
        h.NewCondBr(h.NewICmp(llvm.enum.IPredEQ, c0, zero), no, st)
        var nx = rtHasChar.NewBlock("next")
        st.NewCondBr(st.NewICmp(llvm.enum.IPredEQ, c0, ch), yes, nx)
        nx.NewStore(nx.NewAdd(i, one), ip)
        nx.NewBr(h)
        yes.NewRet(one)
        no.NewRet(zero)
    })()

    // i8* rt_read_line(i32): the next line of @stdin_buf (without its newline), advancing
    // @stdin_pos. Returns a null-marked empty string and leaves the position at the end when
    // there is nothing left; rt_read_eof answers whether that happened.
    var gReadEof = m.NewGlobalDef("read_eof", zero)
    var rtReadLine = m.NewFunc("rt_read_line", i8ptr, llvm.ir.NewParam("u", i32))
    ;(function() {
        var e = rtReadLine.NewBlock("entry")
        var eof = rtReadLine.NewBlock("eof")
        var go = rtReadLine.NewBlock("go")
        var h = rtReadLine.NewBlock("head")
        var st = rtReadLine.NewBlock("step")
        var dn = rtReadLine.NewBlock("done")
        var buf = e.NewLoad(i8ptr, gStdin)
        var pos = e.NewLoad(i32, gStdinPos)
        var len = e.NewCall(rtStrlen, buf)
        e.NewStore(zero, gReadEof)
        e.NewCondBr(e.NewICmp(llvm.enum.IPredSGE, pos, len), eof, go)
        eof.NewStore(one, gReadEof)
        eof.NewRet(emptyPtr(eof))
        var ep = go.NewAlloca(i32)
        go.NewStore(pos, ep)
        go.NewBr(h)
        var k = h.NewLoad(i32, ep)
        var atEnd = h.NewICmp(llvm.enum.IPredSGE, k, len)
        var ch = h.NewLoad(i8, h.NewGetElementPtr(i8, buf, k))
        var isNL = h.NewICmp(llvm.enum.IPredEQ, ch, llvm.constant.NewInt(i8, 10))
        h.NewCondBr(h.NewOr(atEnd, isNL), dn, st)
        st.NewStore(st.NewAdd(k, one), ep)
        st.NewBr(h)
        var k2 = dn.NewLoad(i32, ep)
        var line = dn.NewCall(rtSubstr, [buf, pos, dn.NewSub(k2, pos)])
        var past = dn.NewSelect(dn.NewICmp(llvm.enum.IPredSLT, k2, len), dn.NewAdd(k2, one), k2)
        dn.NewStore(past, gStdinPos)
        dn.NewRet(line)
    })()

    // i8* rt_field(i8* line, i8* ifs, i32 idx, i32 rest): field `idx` of line split on the
    // characters of ifs (empty fields dropped); with rest != 0 the whole remainder from that
    // field on, which is what the LAST name of a `read` gets.
    var rtField = m.NewFunc("rt_field", i8ptr,
        [llvm.ir.NewParam("l", i8ptr), llvm.ir.NewParam("ifs", i8ptr),
         llvm.ir.NewParam("idx", i32), llvm.ir.NewParam("rest", i32)])
    ;(function() {
        var ln = rtField.Params[0], ifs = rtField.Params[1], idx = rtField.Params[2], rest = rtField.Params[3]
        var e = rtField.NewBlock("entry")
        var h = rtField.NewBlock("head")
        var isSepB = rtField.NewBlock("issep")
        var sepB = rtField.NewBlock("sep")
        var chB = rtField.NewBlock("ch")
        var startB = rtField.NewBlock("start")
        var contB = rtField.NewBlock("cont")
        var hitB = rtField.NewBlock("hit")
        var endB = rtField.NewBlock("end")
        var len = e.NewCall(rtStrlen, ln)
        var ip = e.NewAlloca(i32), np = e.NewAlloca(i32), sp = e.NewAlloca(i32), inp = e.NewAlloca(i32)
        e.NewStore(zero, ip)   // scan index
        e.NewStore(zero, np)   // field number
        e.NewStore(zero, sp)   // current field start
        e.NewStore(zero, inp)  // inside a field?
        e.NewBr(h)
        var i2 = h.NewLoad(i32, ip)
        h.NewCondBr(h.NewICmp(llvm.enum.IPredSGE, i2, len), endB, isSepB)
        // is line[i] one of the ifs characters?
        var cch = isSepB.NewZExt(isSepB.NewLoad(i8, isSepB.NewGetElementPtr(i8, ln, i2)), i32)
        var sepFound = isSepB.NewCall(rtHasChar, [ifs, cch])
        isSepB.NewCondBr(isSepB.NewICmp(llvm.enum.IPredNE, sepFound, zero), sepB, chB)
        // a separator closes the field we were in
        var wasIn = sepB.NewICmp(llvm.enum.IPredNE, sepB.NewLoad(i32, inp), zero)
        var closed = rtField.NewBlock("closed"), skip = rtField.NewBlock("skip")
        sepB.NewCondBr(wasIn, closed, skip)
        var fno = closed.NewLoad(i32, np)
        var want = closed.NewICmp(llvm.enum.IPredEQ, fno, idx)
        var noRest = closed.NewICmp(llvm.enum.IPredEQ, rest, zero)
        closed.NewCondBr(closed.NewAnd(want, noRest), hitB, contB)
        contB.NewStore(contB.NewAdd(fno, one), np)
        contB.NewStore(zero, inp)
        contB.NewBr(skip)
        skip.NewStore(skip.NewAdd(i2, one), ip)
        skip.NewBr(h)
        // a field character
        chB.NewCondBr(chB.NewICmp(llvm.enum.IPredEQ, chB.NewLoad(i32, inp), zero), startB, skip)
        startB.NewStore(one, inp)
        startB.NewStore(i2, sp)
        // the wanted field starts here and the caller asked for the whole remainder
        var fno2 = startB.NewLoad(i32, np)
        var want2 = startB.NewICmp(llvm.enum.IPredEQ, fno2, idx)
        var rr = rtField.NewBlock("restall")
        startB.NewCondBr(startB.NewAnd(want2, startB.NewICmp(llvm.enum.IPredNE, rest, zero)), rr, skip)
        rr.NewRet(rr.NewCall(rtSubstr, [ln, i2, llvm.constant.NewInt(i32, -1)]))
        // end of line: the last field may still be open
        var stillIn = endB.NewICmp(llvm.enum.IPredNE, endB.NewLoad(i32, inp), zero)
        var lastOk = endB.NewICmp(llvm.enum.IPredEQ, endB.NewLoad(i32, np), idx)
        var take = rtField.NewBlock("take"), none = rtField.NewBlock("none")
        endB.NewCondBr(endB.NewAnd(stillIn, lastOk), take, none)
        take.NewRet(take.NewCall(rtSubstr, [ln, take.NewLoad(i32, sp), llvm.constant.NewInt(i32, -1)]))
        none.NewRet(emptyPtr(none))
        var hs = hitB.NewLoad(i32, sp)
        hitB.NewRet(hitB.NewCall(rtSubstr, [ln, hs, hitB.NewSub(i2, hs)]))
    })()

    // i8* rt_pad(i8* s, i32 width, i32 left, i32 zero): printf's field padding.
    var rtPad = m.NewFunc("rt_pad", i8ptr,
        [llvm.ir.NewParam("s", i8ptr), llvm.ir.NewParam("w", i32),
         llvm.ir.NewParam("left", i32), llvm.ir.NewParam("zero", i32)])
    ;(function() {
        var s0 = rtPad.Params[0], w = rtPad.Params[1], left = rtPad.Params[2], zp = rtPad.Params[3]
        var e = rtPad.NewBlock("entry")
        var h = rtPad.NewBlock("head")
        var bd = rtPad.NewBlock("body")
        var x = rtPad.NewBlock("exit")
        var vp = e.NewAlloca(i8ptr)
        e.NewStore(s0, vp)
        e.NewBr(h)
        var cur = h.NewLoad(i8ptr, vp)
        h.NewCondBr(h.NewICmp(llvm.enum.IPredSLT, h.NewCall(rtStrlen, cur), w), bd, x)
        var padCh = bd.NewSelect(bd.NewICmp(llvm.enum.IPredNE, zp, zero), gepStr(bd, "0"), gepStr(bd, " "))
        var padded = bd.NewSelect(bd.NewICmp(llvm.enum.IPredNE, left, zero),
                                  bd.NewCall(rtStrcat, [cur, gepStr(bd, " ")]),
                                  bd.NewCall(rtStrcat, [padCh, cur]))
        bd.NewStore(padded, vp)
        bd.NewBr(h)
        x.NewRet(x.NewLoad(i8ptr, vp))
    })()

    // i8* rt_unescape(i8* s): echo -e / printf backslash escapes.
    var rtUnescape = m.NewFunc("rt_unescape", i8ptr, llvm.ir.NewParam("s", i8ptr))
    ;(function() {
        var s0 = rtUnescape.Params[0]
        var e = rtUnescape.NewBlock("entry")
        var h = rtUnescape.NewBlock("head")
        var esc = rtUnescape.NewBlock("esc")
        var plain = rtUnescape.NewBlock("plain")
        var wr = rtUnescape.NewBlock("write")
        var x = rtUnescape.NewBlock("exit")
        var len = e.NewCall(rtStrlen, s0)
        var dst = e.NewCall(rtBump, e.NewAdd(len, one))
        var ip = e.NewAlloca(i32), op = e.NewAlloca(i32), cp = e.NewAlloca(i32)
        e.NewStore(zero, ip)
        e.NewStore(zero, op)
        e.NewBr(h)
        var i = h.NewLoad(i32, ip)
        var c0 = h.NewZExt(h.NewLoad(i8, h.NewGetElementPtr(i8, s0, i)), i32)
        var isEsc = h.NewAnd(h.NewICmp(llvm.enum.IPredEQ, c0, llvm.constant.NewInt(i32, 92)),
                             h.NewICmp(llvm.enum.IPredSLT, h.NewAdd(i, one), len))
        var more = rtUnescape.NewBlock("more")
        h.NewCondBr(h.NewICmp(llvm.enum.IPredEQ, c0, zero), x, more)
        more.NewCondBr(isEsc, esc, plain)
        var n1 = esc.NewZExt(esc.NewLoad(i8, esc.NewGetElementPtr(i8, s0, esc.NewAdd(i, one))), i32)
        var mapped = n1
        mapped = esc.NewSelect(esc.NewICmp(llvm.enum.IPredEQ, n1, llvm.constant.NewInt(i32, 110)), llvm.constant.NewInt(i32, 10), mapped)
        mapped = esc.NewSelect(esc.NewICmp(llvm.enum.IPredEQ, n1, llvm.constant.NewInt(i32, 116)), llvm.constant.NewInt(i32, 9), mapped)
        mapped = esc.NewSelect(esc.NewICmp(llvm.enum.IPredEQ, n1, llvm.constant.NewInt(i32, 114)), llvm.constant.NewInt(i32, 13), mapped)
        mapped = esc.NewSelect(esc.NewICmp(llvm.enum.IPredEQ, n1, llvm.constant.NewInt(i32, 97)), llvm.constant.NewInt(i32, 7), mapped)
        mapped = esc.NewSelect(esc.NewICmp(llvm.enum.IPredEQ, n1, llvm.constant.NewInt(i32, 98)), llvm.constant.NewInt(i32, 8), mapped)
        mapped = esc.NewSelect(esc.NewICmp(llvm.enum.IPredEQ, n1, llvm.constant.NewInt(i32, 102)), llvm.constant.NewInt(i32, 12), mapped)
        mapped = esc.NewSelect(esc.NewICmp(llvm.enum.IPredEQ, n1, llvm.constant.NewInt(i32, 118)), llvm.constant.NewInt(i32, 11), mapped)
        mapped = esc.NewSelect(esc.NewICmp(llvm.enum.IPredEQ, n1, llvm.constant.NewInt(i32, 101)), llvm.constant.NewInt(i32, 27), mapped)
        mapped = esc.NewSelect(esc.NewICmp(llvm.enum.IPredEQ, n1, llvm.constant.NewInt(i32, 48)), zero, mapped)
        esc.NewStore(mapped, cp)
        esc.NewStore(esc.NewAdd(i, llvm.constant.NewInt(i32, 2)), ip)
        esc.NewBr(wr)
        plain.NewStore(c0, cp)
        plain.NewStore(plain.NewAdd(i, one), ip)
        plain.NewBr(wr)
        var o = wr.NewLoad(i32, op)
        wr.NewStore(wr.NewTrunc(wr.NewLoad(i32, cp), i8), wr.NewGetElementPtr(i8, dst, o))
        wr.NewStore(wr.NewAdd(o, one), op)
        wr.NewBr(h)
        x.NewStore(zero8, x.NewGetElementPtr(i8, dst, x.NewLoad(i32, op)))
        x.NewRet(dst)
    })()

    // ---- field lists ------------------------------------------------------------------
    // The same encoding the interpreter uses: a plain string is ONE field; a string that
    // starts with "\x02" is a list, each field followed by "\x01" (so the empty list and the
    // one-empty-field list stay different).

    // i32 rt_nfields(i8* v)
    var rtNFields = m.NewFunc("rt_nfields", i32, llvm.ir.NewParam("v", i8ptr))
    ;(function() {
        var v = rtNFields.Params[0]
        var e = rtNFields.NewBlock("entry")
        var one1 = rtNFields.NewBlock("single")
        var h = rtNFields.NewBlock("head")
        var bd = rtNFields.NewBlock("body")
        var x = rtNFields.NewBlock("exit")
        var c0 = e.NewZExt(e.NewLoad(i8, e.NewGetElementPtr(i8, v, zero)), i32)
        e.NewCondBr(e.NewICmp(llvm.enum.IPredEQ, c0, llvm.constant.NewInt(i32, 2)), h, one1)
        one1.NewRet(one)
        var ip = e.NewAlloca(i32), np = e.NewAlloca(i32)
        e.NewStore(one, ip)
        e.NewStore(zero, np)
        var len = e.NewCall(rtStrlen, v)
        var i = h.NewLoad(i32, ip)
        h.NewCondBr(h.NewICmp(llvm.enum.IPredSLT, i, len), bd, x)
        var ch = bd.NewZExt(bd.NewLoad(i8, bd.NewGetElementPtr(i8, v, i)), i32)
        var hit = bd.NewICmp(llvm.enum.IPredEQ, ch, one)
        bd.NewStore(bd.NewSelect(hit, bd.NewAdd(bd.NewLoad(i32, np), one), bd.NewLoad(i32, np)), np)
        bd.NewStore(bd.NewAdd(i, one), ip)
        bd.NewBr(h)
        x.NewRet(x.NewLoad(i32, np))
    })()

    // i8* rt_getfield(i8* v, i32 k)
    var rtGetField = m.NewFunc("rt_getfield", i8ptr, [llvm.ir.NewParam("v", i8ptr), llvm.ir.NewParam("k", i32)])
    ;(function() {
        var v = rtGetField.Params[0], k = rtGetField.Params[1]
        var e = rtGetField.NewBlock("entry")
        var one1 = rtGetField.NewBlock("single")
        var h = rtGetField.NewBlock("head")
        var bd = rtGetField.NewBlock("body")
        var sepB = rtGetField.NewBlock("sep")
        var hit = rtGetField.NewBlock("hit")
        var next = rtGetField.NewBlock("next")
        var step = rtGetField.NewBlock("step")
        var x = rtGetField.NewBlock("exit")
        var c0 = e.NewZExt(e.NewLoad(i8, e.NewGetElementPtr(i8, v, zero)), i32)
        var ip = e.NewAlloca(i32), np = e.NewAlloca(i32), sp = e.NewAlloca(i32)
        e.NewStore(one, ip)
        e.NewStore(zero, np)
        e.NewStore(one, sp)
        var len = e.NewCall(rtStrlen, v)
        e.NewCondBr(e.NewICmp(llvm.enum.IPredEQ, c0, llvm.constant.NewInt(i32, 2)), h, one1)
        one1.NewRet(one1.NewSelect(one1.NewICmp(llvm.enum.IPredEQ, k, zero), v, emptyPtr(one1)))
        var i = h.NewLoad(i32, ip)
        h.NewCondBr(h.NewICmp(llvm.enum.IPredSLT, i, len), bd, x)
        var ch = bd.NewZExt(bd.NewLoad(i8, bd.NewGetElementPtr(i8, v, i)), i32)
        bd.NewCondBr(bd.NewICmp(llvm.enum.IPredEQ, ch, one), sepB, step)
        sepB.NewCondBr(sepB.NewICmp(llvm.enum.IPredEQ, sepB.NewLoad(i32, np), k), hit, next)
        var st0 = hit.NewLoad(i32, sp)
        hit.NewRet(hit.NewCall(rtSubstr, [v, st0, hit.NewSub(i, st0)]))
        next.NewStore(next.NewAdd(next.NewLoad(i32, np), one), np)
        next.NewStore(next.NewAdd(i, one), sp)
        next.NewBr(step)
        step.NewStore(step.NewAdd(i, one), ip)
        step.NewBr(h)
        x.NewRet(emptyPtr(x))
    })()

    // i8* rt_wordjoin(i8* v): a field list flattened back to one string, fields space-joined.
    var rtWordJoin = m.NewFunc("rt_wordjoin", i8ptr, llvm.ir.NewParam("v", i8ptr))
    ;(function() {
        var v = rtWordJoin.Params[0]
        var e = rtWordJoin.NewBlock("entry")
        var one1 = rtWordJoin.NewBlock("single")
        var h = rtWordJoin.NewBlock("head")
        var bd = rtWordJoin.NewBlock("body")
        var x = rtWordJoin.NewBlock("exit")
        var c0 = e.NewZExt(e.NewLoad(i8, e.NewGetElementPtr(i8, v, zero)), i32)
        var n = e.NewCall(rtNFields, v)
        var op = e.NewAlloca(i8ptr), ip = e.NewAlloca(i32)
        e.NewStore(emptyPtr(e), op)
        e.NewStore(zero, ip)
        e.NewCondBr(e.NewICmp(llvm.enum.IPredEQ, c0, llvm.constant.NewInt(i32, 2)), h, one1)
        one1.NewRet(v)
        var i = h.NewLoad(i32, ip)
        h.NewCondBr(h.NewICmp(llvm.enum.IPredSLT, i, n), bd, x)
        var cur = bd.NewLoad(i8ptr, op)
        cur = bd.NewSelect(bd.NewICmp(llvm.enum.IPredSGT, i, zero), bd.NewCall(rtStrcat, [cur, gepStr(bd, " ")]), cur)
        bd.NewStore(bd.NewCall(rtStrcat, [cur, bd.NewCall(rtGetField, [v, i])]), op)
        bd.NewStore(bd.NewAdd(i, one), ip)
        bd.NewBr(h)
        x.NewRet(x.NewLoad(i8ptr, op))
    })()

    // i8* rt_splitifs(i8* v, i8* ifs): an unquoted expansion split into a field list.
    var rtSplitIfs = m.NewFunc("rt_splitifs", i8ptr, [llvm.ir.NewParam("v", i8ptr), llvm.ir.NewParam("ifs", i8ptr)])
    ;(function() {
        var v = rtSplitIfs.Params[0], ifs = rtSplitIfs.Params[1]
        var e = rtSplitIfs.NewBlock("entry")
        var h = rtSplitIfs.NewBlock("head")
        var bd = rtSplitIfs.NewBlock("body")
        var sepB = rtSplitIfs.NewBlock("sep")
        var closeB = rtSplitIfs.NewBlock("close")
        var step = rtSplitIfs.NewBlock("step")
        var x = rtSplitIfs.NewBlock("exit")
        var tail = rtSplitIfs.NewBlock("tail")
        var len = e.NewCall(rtStrlen, v)
        var op = e.NewAlloca(i8ptr), ip = e.NewAlloca(i32), sp = e.NewAlloca(i32), inp = e.NewAlloca(i32)
        e.NewStore(gepStr(e, "\x02"), op)
        e.NewStore(zero, ip)
        e.NewStore(zero, sp)
        e.NewStore(zero, inp)
        e.NewBr(h)
        var i = h.NewLoad(i32, ip)
        h.NewCondBr(h.NewICmp(llvm.enum.IPredSLT, i, len), bd, tail)
        var ch = bd.NewZExt(bd.NewLoad(i8, bd.NewGetElementPtr(i8, v, i)), i32)
        bd.NewCondBr(bd.NewICmp(llvm.enum.IPredNE, bd.NewCall(rtHasChar, [ifs, ch]), zero), sepB, closeB)
        var emitB = rtSplitIfs.NewBlock("emit")
        var openB = rtSplitIfs.NewBlock("open")
        var emitT = rtSplitIfs.NewBlock("emit_tail")
        sepB.NewCondBr(sepB.NewICmp(llvm.enum.IPredNE, sepB.NewLoad(i32, inp), zero), emitB, step)
        // close the field that ends here
        var st1 = emitB.NewLoad(i32, sp)
        emitB.NewStore(emitB.NewCall(rtStrcat, [emitB.NewCall(rtStrcat, [emitB.NewLoad(i8ptr, op),
                        emitB.NewCall(rtSubstr, [v, st1, emitB.NewSub(i, st1)])]), gepStr(emitB, "\x01")]), op)
        emitB.NewStore(zero, inp)
        emitB.NewBr(step)
        closeB.NewCondBr(closeB.NewICmp(llvm.enum.IPredEQ, closeB.NewLoad(i32, inp), zero), openB, step)
        openB.NewStore(one, inp)
        openB.NewStore(i, sp)
        openB.NewBr(step)
        step.NewStore(step.NewAdd(i, one), ip)
        step.NewBr(h)
        tail.NewCondBr(tail.NewICmp(llvm.enum.IPredNE, tail.NewLoad(i32, inp), zero), emitT, x)
        var st2 = emitT.NewLoad(i32, sp)
        emitT.NewStore(emitT.NewCall(rtStrcat, [emitT.NewCall(rtStrcat, [emitT.NewLoad(i8ptr, op),
                        emitT.NewCall(rtSubstr, [v, st2, emitT.NewSub(len, st2)])]), gepStr(emitT, "\x01")]), op)
        emitT.NewBr(x)
        x.NewRet(x.NewLoad(i8ptr, op))
    })()

    // Appending a field list to a word under construction. The word is kept as a CLOSED list
    // `acc` (each field followed by "\x01") plus the text of the field still `open`:
    //   n == 0            nothing changes
    //   n == 1            open = open + f[0]
    //   n >= 2            acc = acc + (open + f[0]) + f[1] .. f[n-2], each closed; open = f[n-1]
    // which is exactly bash's rule that x"$@"y with (a b c) is "xa" "b" "cy".
    var rtBndAcc = m.NewFunc("rt_bnd_acc", i8ptr,
        [llvm.ir.NewParam("acc", i8ptr), llvm.ir.NewParam("open", i8ptr), llvm.ir.NewParam("f", i8ptr)])
    ;(function() {
        var acc = rtBndAcc.Params[0], open = rtBndAcc.Params[1], f = rtBndAcc.Params[2]
        var e = rtBndAcc.NewBlock("entry")
        var go = rtBndAcc.NewBlock("go")
        var h = rtBndAcc.NewBlock("head")
        var bd = rtBndAcc.NewBlock("body")
        var x = rtBndAcc.NewBlock("exit")
        var n = e.NewCall(rtNFields, f)
        var op = e.NewAlloca(i8ptr), ip = e.NewAlloca(i32)
        e.NewStore(acc, op)
        e.NewStore(one, ip)
        e.NewCondBr(e.NewICmp(llvm.enum.IPredSLT, n, llvm.constant.NewInt(i32, 2)), x, go)
        go.NewStore(go.NewCall(rtStrcat, [go.NewCall(rtStrcat, [go.NewCall(rtStrcat, [acc, open]),
                                          go.NewCall(rtGetField, [f, zero])]), gepStr(go, "\x01")]), op)
        go.NewBr(h)
        var i = h.NewLoad(i32, ip)
        h.NewCondBr(h.NewICmp(llvm.enum.IPredSLT, i, h.NewSub(n, one)), bd, x)
        bd.NewStore(bd.NewCall(rtStrcat, [bd.NewCall(rtStrcat, [bd.NewLoad(i8ptr, op),
                                          bd.NewCall(rtGetField, [f, i])]), gepStr(bd, "\x01")]), op)
        bd.NewStore(bd.NewAdd(i, one), ip)
        bd.NewBr(h)
        x.NewRet(x.NewLoad(i8ptr, op))
    })()
    var rtBndOpen = m.NewFunc("rt_bnd_open", i8ptr,
        [llvm.ir.NewParam("open", i8ptr), llvm.ir.NewParam("f", i8ptr)])
    ;(function() {
        var open = rtBndOpen.Params[0], f = rtBndOpen.Params[1]
        var e = rtBndOpen.NewBlock("entry")
        var zeroB = rtBndOpen.NewBlock("none")
        var oneB = rtBndOpen.NewBlock("one")
        var manyB = rtBndOpen.NewBlock("many")
        var more = rtBndOpen.NewBlock("more")
        var n = e.NewCall(rtNFields, f)
        e.NewCondBr(e.NewICmp(llvm.enum.IPredEQ, n, zero), zeroB, more)
        more.NewCondBr(more.NewICmp(llvm.enum.IPredEQ, n, one), oneB, manyB)
        zeroB.NewRet(open)
        oneB.NewRet(oneB.NewCall(rtStrcat, [open, oneB.NewCall(rtGetField, [f, zero])]))
        manyB.NewRet(manyB.NewCall(rtGetField, [f, manyB.NewSub(n, one)]))
    })()

    // ---- arrays ------------------------------------------------------------------------
    // One flat store of (arrayName, key, value) triples with a linear scan. Keys are strings
    // for both kinds of array; entries stay in INSERTION order, which is also the order
    // ${!a[*]} and ${a[@]} report.
    var NARR = 4096
    var arrSlotTy = llvm.types.NewArray(NARR, i8ptr)
    var gArrNm = m.NewGlobalDef("arr_nm", llvm.constant.NewZeroInitializer(arrSlotTy))
    var gArrK = m.NewGlobalDef("arr_k", llvm.constant.NewZeroInitializer(arrSlotTy))
    var gArrV = m.NewGlobalDef("arr_v", llvm.constant.NewZeroInitializer(arrSlotTy))
    var gArrN = m.NewGlobalDef("arr_n", zero)

    var rtArrFind = m.NewFunc("rt_arr_find", i32, [llvm.ir.NewParam("nm", i8ptr), llvm.ir.NewParam("k", i8ptr)])
    ;(function() {
        var nm = rtArrFind.Params[0], k = rtArrFind.Params[1]
        var e = rtArrFind.NewBlock("entry")
        var h = rtArrFind.NewBlock("head")
        var bd = rtArrFind.NewBlock("body")
        var hit = rtArrFind.NewBlock("hit")
        var st = rtArrFind.NewBlock("step")
        var no = rtArrFind.NewBlock("no")
        var n = e.NewLoad(i32, gArrN)
        var ip = e.NewAlloca(i32)
        e.NewStore(zero, ip)
        e.NewBr(h)
        var i = h.NewLoad(i32, ip)
        h.NewCondBr(h.NewICmp(llvm.enum.IPredSLT, i, n), bd, no)
        var sameNm = bd.NewICmp(llvm.enum.IPredNE, bd.NewCall(rtStreq,
            [nm, bd.NewLoad(i8ptr, bd.NewGetElementPtr(arrSlotTy, gArrNm, zero, i))]), zero)
        var sameK = bd.NewICmp(llvm.enum.IPredNE, bd.NewCall(rtStreq,
            [k, bd.NewLoad(i8ptr, bd.NewGetElementPtr(arrSlotTy, gArrK, zero, i))]), zero)
        bd.NewCondBr(bd.NewAnd(sameNm, sameK), hit, st)
        hit.NewRet(i)
        st.NewStore(st.NewAdd(i, one), ip)
        st.NewBr(h)
        no.NewRet(llvm.constant.NewInt(i32, -1))
    })()

    var rtArrSet = m.NewFunc("rt_arr_set", i32,
        [llvm.ir.NewParam("nm", i8ptr), llvm.ir.NewParam("k", i8ptr), llvm.ir.NewParam("v", i8ptr)])
    ;(function() {
        var nm = rtArrSet.Params[0], k = rtArrSet.Params[1], v = rtArrSet.Params[2]
        var e = rtArrSet.NewBlock("entry")
        var upd = rtArrSet.NewBlock("upd")
        var add = rtArrSet.NewBlock("add")
        var at = e.NewCall(rtArrFind, [nm, k])
        e.NewCondBr(e.NewICmp(llvm.enum.IPredSGE, at, zero), upd, add)
        upd.NewStore(v, upd.NewGetElementPtr(arrSlotTy, gArrV, zero, at))
        upd.NewRet(zero)
        var n = add.NewLoad(i32, gArrN)
        add.NewStore(nm, add.NewGetElementPtr(arrSlotTy, gArrNm, zero, n))
        add.NewStore(k, add.NewGetElementPtr(arrSlotTy, gArrK, zero, n))
        add.NewStore(v, add.NewGetElementPtr(arrSlotTy, gArrV, zero, n))
        add.NewStore(add.NewAdd(n, one), gArrN)
        add.NewRet(zero)
    })()

    var rtArrGet = m.NewFunc("rt_arr_get", i8ptr, [llvm.ir.NewParam("nm", i8ptr), llvm.ir.NewParam("k", i8ptr)])
    ;(function() {
        var e = rtArrGet.NewBlock("entry")
        var ok = rtArrGet.NewBlock("ok")
        var no = rtArrGet.NewBlock("no")
        var at = e.NewCall(rtArrFind, [rtArrGet.Params[0], rtArrGet.Params[1]])
        e.NewCondBr(e.NewICmp(llvm.enum.IPredSGE, at, zero), ok, no)
        ok.NewRet(ok.NewLoad(i8ptr, ok.NewGetElementPtr(arrSlotTy, gArrV, zero, at)))
        no.NewRet(emptyPtr(no))
    })()

    var rtArrHas = m.NewFunc("rt_arr_has", i32, [llvm.ir.NewParam("nm", i8ptr), llvm.ir.NewParam("k", i8ptr)])
    ;(function() {
        var e = rtArrHas.NewBlock("entry")
        var at = e.NewCall(rtArrFind, [rtArrHas.Params[0], rtArrHas.Params[1]])
        e.NewRet(e.NewZExt(e.NewICmp(llvm.enum.IPredSGE, at, zero), i32))
    })()

    // Remove one entry (rt_arr_del) or every entry of an array (rt_arr_clear), shifting the
    // tail of the store down over the hole.
    var rtArrDel = m.NewFunc("rt_arr_del", i32, [llvm.ir.NewParam("nm", i8ptr), llvm.ir.NewParam("k", i8ptr)])
    ;(function() {
        var e = rtArrDel.NewBlock("entry")
        var go = rtArrDel.NewBlock("go")
        var h = rtArrDel.NewBlock("head")
        var bd = rtArrDel.NewBlock("body")
        var x = rtArrDel.NewBlock("exit")
        var at = e.NewCall(rtArrFind, [rtArrDel.Params[0], rtArrDel.Params[1]])
        var ip = e.NewAlloca(i32)
        e.NewStore(at, ip)
        e.NewCondBr(e.NewICmp(llvm.enum.IPredSGE, at, zero), go, x)
        go.NewBr(h)
        var n = h.NewLoad(i32, gArrN)
        var i = h.NewLoad(i32, ip)
        var fin = rtArrDel.NewBlock("fin")
        h.NewCondBr(h.NewICmp(llvm.enum.IPredSLT, i, h.NewSub(n, one)), bd, fin)
        fin.NewStore(fin.NewSub(fin.NewLoad(i32, gArrN), one), gArrN)
        fin.NewBr(x)
        var j = bd.NewAdd(i, one)
        bd.NewStore(bd.NewLoad(i8ptr, bd.NewGetElementPtr(arrSlotTy, gArrNm, zero, j)), bd.NewGetElementPtr(arrSlotTy, gArrNm, zero, i))
        bd.NewStore(bd.NewLoad(i8ptr, bd.NewGetElementPtr(arrSlotTy, gArrK, zero, j)), bd.NewGetElementPtr(arrSlotTy, gArrK, zero, i))
        bd.NewStore(bd.NewLoad(i8ptr, bd.NewGetElementPtr(arrSlotTy, gArrV, zero, j)), bd.NewGetElementPtr(arrSlotTy, gArrV, zero, i))
        bd.NewStore(j, ip)
        bd.NewBr(h)
        x.NewRet(zero)
    })()

    var rtArrCount = m.NewFunc("rt_arr_count", i32, llvm.ir.NewParam("nm", i8ptr))
    ;(function() {
        var nm = rtArrCount.Params[0]
        var e = rtArrCount.NewBlock("entry")
        var h = rtArrCount.NewBlock("head")
        var bd = rtArrCount.NewBlock("body")
        var x = rtArrCount.NewBlock("exit")
        var n = e.NewLoad(i32, gArrN)
        var ip = e.NewAlloca(i32), cp = e.NewAlloca(i32)
        e.NewStore(zero, ip)
        e.NewStore(zero, cp)
        e.NewBr(h)
        var i = h.NewLoad(i32, ip)
        h.NewCondBr(h.NewICmp(llvm.enum.IPredSLT, i, n), bd, x)
        var same = bd.NewICmp(llvm.enum.IPredNE, bd.NewCall(rtStreq,
            [nm, bd.NewLoad(i8ptr, bd.NewGetElementPtr(arrSlotTy, gArrNm, zero, i))]), zero)
        bd.NewStore(bd.NewSelect(same, bd.NewAdd(bd.NewLoad(i32, cp), one), bd.NewLoad(i32, cp)), cp)
        bd.NewStore(bd.NewAdd(i, one), ip)
        bd.NewBr(h)
        x.NewRet(x.NewLoad(i32, cp))
    })()

    // i8* rt_arr_list(i8* nm, i8* sep, i32 star, i32 keys): the keys or the values of an
    // array, as a field list (star == 0) or joined with sep (star != 0).
    var rtArrList = m.NewFunc("rt_arr_list", i8ptr,
        [llvm.ir.NewParam("nm", i8ptr), llvm.ir.NewParam("sep", i8ptr),
         llvm.ir.NewParam("star", i32), llvm.ir.NewParam("keys", i32)])
    ;(function() {
        var nm = rtArrList.Params[0], sep = rtArrList.Params[1]
        var star = rtArrList.Params[2], keys = rtArrList.Params[3]
        var e = rtArrList.NewBlock("entry")
        var h = rtArrList.NewBlock("head")
        var bd = rtArrList.NewBlock("body")
        var take = rtArrList.NewBlock("take")
        var st = rtArrList.NewBlock("step")
        var x = rtArrList.NewBlock("exit")
        var n = e.NewLoad(i32, gArrN)
        var op = e.NewAlloca(i8ptr), ip = e.NewAlloca(i32), cp = e.NewAlloca(i32)
        e.NewStore(e.NewSelect(e.NewICmp(llvm.enum.IPredNE, star, zero), emptyPtr(e), gepStr(e, "\x02")), op)
        e.NewStore(zero, ip)
        e.NewStore(zero, cp)
        e.NewBr(h)
        var i = h.NewLoad(i32, ip)
        h.NewCondBr(h.NewICmp(llvm.enum.IPredSLT, i, n), bd, x)
        var same = bd.NewICmp(llvm.enum.IPredNE, bd.NewCall(rtStreq,
            [nm, bd.NewLoad(i8ptr, bd.NewGetElementPtr(arrSlotTy, gArrNm, zero, i))]), zero)
        bd.NewCondBr(same, take, st)
        var kv = take.NewSelect(take.NewICmp(llvm.enum.IPredNE, keys, zero),
            take.NewLoad(i8ptr, take.NewGetElementPtr(arrSlotTy, gArrK, zero, i)),
            take.NewLoad(i8ptr, take.NewGetElementPtr(arrSlotTy, gArrV, zero, i)))
        var cur = take.NewLoad(i8ptr, op)
        var isStar = take.NewICmp(llvm.enum.IPredNE, star, zero)
        var needSep = take.NewAnd(isStar, take.NewICmp(llvm.enum.IPredSGT, take.NewLoad(i32, cp), zero))
        cur = take.NewSelect(needSep, take.NewCall(rtStrcat, [cur, sep]), cur)
        cur = take.NewCall(rtStrcat, [cur, kv])
        cur = take.NewSelect(isStar, cur, take.NewCall(rtStrcat, [cur, gepStr(take, "\x01")]))
        take.NewStore(cur, op)
        take.NewStore(take.NewAdd(take.NewLoad(i32, cp), one), cp)
        take.NewBr(st)
        st.NewStore(st.NewAdd(i, one), ip)
        st.NewBr(h)
        x.NewRet(x.NewLoad(i8ptr, op))
    })()

    // i32 rt_arr_nextidx(i8* nm): one past the largest numeric key.
    var rtArrNext = m.NewFunc("rt_arr_nextidx", i32, llvm.ir.NewParam("nm", i8ptr))
    ;(function() {
        var nm = rtArrNext.Params[0]
        var e = rtArrNext.NewBlock("entry")
        var h = rtArrNext.NewBlock("head")
        var bd = rtArrNext.NewBlock("body")
        var x = rtArrNext.NewBlock("exit")
        var n = e.NewLoad(i32, gArrN)
        var ip = e.NewAlloca(i32), mp = e.NewAlloca(i32)
        e.NewStore(zero, ip)
        e.NewStore(zero, mp)
        e.NewBr(h)
        var i = h.NewLoad(i32, ip)
        h.NewCondBr(h.NewICmp(llvm.enum.IPredSLT, i, n), bd, x)
        var same = bd.NewICmp(llvm.enum.IPredNE, bd.NewCall(rtStreq,
            [nm, bd.NewLoad(i8ptr, bd.NewGetElementPtr(arrSlotTy, gArrNm, zero, i))]), zero)
        var kn = bd.NewCall(rtStr2int, bd.NewLoad(i8ptr, bd.NewGetElementPtr(arrSlotTy, gArrK, zero, i)))
        var bigger = bd.NewAnd(same, bd.NewICmp(llvm.enum.IPredSGE, kn, bd.NewLoad(i32, mp)))
        bd.NewStore(bd.NewSelect(bigger, bd.NewAdd(kn, one), bd.NewLoad(i32, mp)), mp)
        bd.NewStore(bd.NewAdd(i, one), ip)
        bd.NewBr(h)
        x.NewRet(x.NewLoad(i32, mp))
    })()

    // i32 rt_arr_clear(i8* nm): drop every entry of one array.
    var rtArrClear = m.NewFunc("rt_arr_clear", i32, llvm.ir.NewParam("nm", i8ptr))
    ;(function() {
        var nm = rtArrClear.Params[0]
        var e = rtArrClear.NewBlock("entry")
        var h = rtArrClear.NewBlock("head")
        var bd = rtArrClear.NewBlock("body")
        var keep = rtArrClear.NewBlock("keep")
        var st = rtArrClear.NewBlock("step")
        var x = rtArrClear.NewBlock("exit")
        var ip = e.NewAlloca(i32), op = e.NewAlloca(i32)
        e.NewStore(zero, ip)
        e.NewStore(zero, op)
        e.NewBr(h)
        var i = h.NewLoad(i32, ip)
        h.NewCondBr(h.NewICmp(llvm.enum.IPredSLT, i, h.NewLoad(i32, gArrN)), bd, x)
        var same = bd.NewICmp(llvm.enum.IPredNE, bd.NewCall(rtStreq,
            [nm, bd.NewLoad(i8ptr, bd.NewGetElementPtr(arrSlotTy, gArrNm, zero, i))]), zero)
        bd.NewCondBr(same, st, keep)
        var o = keep.NewLoad(i32, op)
        keep.NewStore(keep.NewLoad(i8ptr, keep.NewGetElementPtr(arrSlotTy, gArrNm, zero, i)), keep.NewGetElementPtr(arrSlotTy, gArrNm, zero, o))
        keep.NewStore(keep.NewLoad(i8ptr, keep.NewGetElementPtr(arrSlotTy, gArrK, zero, i)), keep.NewGetElementPtr(arrSlotTy, gArrK, zero, o))
        keep.NewStore(keep.NewLoad(i8ptr, keep.NewGetElementPtr(arrSlotTy, gArrV, zero, i)), keep.NewGetElementPtr(arrSlotTy, gArrV, zero, o))
        keep.NewStore(keep.NewAdd(o, one), op)
        keep.NewBr(st)
        st.NewStore(st.NewAdd(i, one), ip)
        st.NewBr(h)
        x.NewStore(x.NewLoad(i32, op), gArrN)
        x.NewRet(zero)
    })()

    // i32 rt_arr_append(i8* nm, i8* fields): append every field with the next numeric index.
    var rtArrAppend = m.NewFunc("rt_arr_append", i32, [llvm.ir.NewParam("nm", i8ptr), llvm.ir.NewParam("f", i8ptr)])
    ;(function() {
        var nm = rtArrAppend.Params[0], f = rtArrAppend.Params[1]
        var e = rtArrAppend.NewBlock("entry")
        var h = rtArrAppend.NewBlock("head")
        var bd = rtArrAppend.NewBlock("body")
        var x = rtArrAppend.NewBlock("exit")
        var n = e.NewCall(rtNFields, f)
        var ip = e.NewAlloca(i32)
        e.NewStore(zero, ip)
        e.NewBr(h)
        var i = h.NewLoad(i32, ip)
        h.NewCondBr(h.NewICmp(llvm.enum.IPredSLT, i, n), bd, x)
        var idx = bd.NewCall(rtArrNext, nm)
        bd.NewCall(rtArrSet, [nm, bd.NewCall(rtInt2str, idx), bd.NewCall(rtGetField, [f, i])])
        bd.NewStore(bd.NewAdd(i, one), ip)
        bd.NewBr(h)
        x.NewRet(zero)
    })()

    // i8* rt_slicefields(i8* f, i32 off, i32 n, i8* sep, i32 star)
    var rtSliceFields = m.NewFunc("rt_slicefields", i8ptr,
        [llvm.ir.NewParam("f", i8ptr), llvm.ir.NewParam("off", i32), llvm.ir.NewParam("n", i32),
         llvm.ir.NewParam("sep", i8ptr), llvm.ir.NewParam("star", i32)])
    ;(function() {
        var f = rtSliceFields.Params[0], off = rtSliceFields.Params[1]
        var n = rtSliceFields.Params[2], sep = rtSliceFields.Params[3], star = rtSliceFields.Params[4]
        var e = rtSliceFields.NewBlock("entry")
        var h = rtSliceFields.NewBlock("head")
        var bd = rtSliceFields.NewBlock("body")
        var x = rtSliceFields.NewBlock("exit")
        var cnt = e.NewCall(rtNFields, f)
        var op = e.NewAlloca(i8ptr), ip = e.NewAlloca(i32), cp = e.NewAlloca(i32)
        var isStar = e.NewICmp(llvm.enum.IPredNE, star, zero)
        e.NewStore(e.NewSelect(isStar, emptyPtr(e), gepStr(e, "\x02")), op)
        e.NewStore(off, ip)
        e.NewStore(zero, cp)
        e.NewBr(h)
        var i = h.NewLoad(i32, ip)
        var taken = h.NewLoad(i32, cp)
        h.NewCondBr(h.NewAnd(h.NewICmp(llvm.enum.IPredSLT, i, cnt),
                             h.NewICmp(llvm.enum.IPredSLT, taken, n)), bd, x)
        var cur = bd.NewLoad(i8ptr, op)
        var needSep = bd.NewAnd(isStar, bd.NewICmp(llvm.enum.IPredSGT, bd.NewLoad(i32, cp), zero))
        cur = bd.NewSelect(needSep, bd.NewCall(rtStrcat, [cur, sep]), cur)
        cur = bd.NewCall(rtStrcat, [cur, bd.NewCall(rtGetField, [f, i])])
        cur = bd.NewSelect(isStar, cur, bd.NewCall(rtStrcat, [cur, gepStr(bd, "\x01")]))
        bd.NewStore(cur, op)
        bd.NewStore(bd.NewAdd(i, one), ip)
        bd.NewStore(bd.NewAdd(bd.NewLoad(i32, cp), one), cp)
        bd.NewBr(h)
        x.NewRet(x.NewLoad(i8ptr, op))
    })()

    // i8* rt_globescape(i8* s): make every glob metacharacter of s literal, which is what a
    // QUOTED part of a [[ ]] pattern is ( [[ $s == "h*" ]] does not glob ).
    var rtGlobEsc = m.NewFunc("rt_globescape", i8ptr, llvm.ir.NewParam("s", i8ptr))
    ;(function() {
        var s0 = rtGlobEsc.Params[0]
        var e = rtGlobEsc.NewBlock("entry")
        var h = rtGlobEsc.NewBlock("head")
        var bd = rtGlobEsc.NewBlock("body")
        var esc = rtGlobEsc.NewBlock("esc")
        var wr = rtGlobEsc.NewBlock("write")
        var x = rtGlobEsc.NewBlock("exit")
        var len = e.NewCall(rtStrlen, s0)
        var dst = e.NewCall(rtBump, e.NewAdd(e.NewMul(len, llvm.constant.NewInt(i32, 2)), one))
        var ip = e.NewAlloca(i32), op = e.NewAlloca(i32)
        e.NewStore(zero, ip)
        e.NewStore(zero, op)
        e.NewBr(h)
        var i = h.NewLoad(i32, ip)
        h.NewCondBr(h.NewICmp(llvm.enum.IPredSLT, i, len), bd, x)
        var ch = bd.NewZExt(bd.NewLoad(i8, bd.NewGetElementPtr(i8, s0, i)), i32)
        var meta = bd.NewOr(bd.NewOr(bd.NewICmp(llvm.enum.IPredEQ, ch, llvm.constant.NewInt(i32, 42)),
                                     bd.NewICmp(llvm.enum.IPredEQ, ch, llvm.constant.NewInt(i32, 63))),
                            bd.NewOr(bd.NewOr(bd.NewICmp(llvm.enum.IPredEQ, ch, llvm.constant.NewInt(i32, 91)),
                                              bd.NewICmp(llvm.enum.IPredEQ, ch, llvm.constant.NewInt(i32, 93))),
                                     bd.NewICmp(llvm.enum.IPredEQ, ch, llvm.constant.NewInt(i32, 92))))
        bd.NewCondBr(meta, esc, wr)
        var o1 = esc.NewLoad(i32, op)
        esc.NewStore(llvm.constant.NewInt(i8, 92), esc.NewGetElementPtr(i8, dst, o1))
        esc.NewStore(esc.NewAdd(o1, one), op)
        esc.NewBr(wr)
        var o2 = wr.NewLoad(i32, op)
        wr.NewStore(wr.NewTrunc(ch, i8), wr.NewGetElementPtr(i8, dst, o2))
        wr.NewStore(wr.NewAdd(o2, one), op)
        wr.NewStore(wr.NewAdd(i, one), ip)
        wr.NewBr(h)
        x.NewStore(zero8, x.NewGetElementPtr(i8, dst, x.NewLoad(i32, op)))
        x.NewRet(dst)
    })()

    // i8* rt_catfields(i8* a, i8* b): concatenate two field lists.
    var rtCatFields = m.NewFunc("rt_catfields", i8ptr, [llvm.ir.NewParam("a", i8ptr), llvm.ir.NewParam("b", i8ptr)])
    ;(function() {
        var a = rtCatFields.Params[0], bb = rtCatFields.Params[1]
        var e = rtCatFields.NewBlock("entry")
        var h = rtCatFields.NewBlock("head")
        var bd = rtCatFields.NewBlock("body")
        var x = rtCatFields.NewBlock("exit")
        var n = e.NewCall(rtNFields, bb)
        var op = e.NewAlloca(i8ptr), ip = e.NewAlloca(i32)
        e.NewStore(a, op)
        e.NewStore(zero, ip)
        e.NewBr(h)
        var i = h.NewLoad(i32, ip)
        h.NewCondBr(h.NewICmp(llvm.enum.IPredSLT, i, n), bd, x)
        bd.NewStore(bd.NewCall(rtStrcat, [bd.NewCall(rtStrcat, [bd.NewLoad(i8ptr, op),
                                          bd.NewCall(rtGetField, [bb, i])]), gepStr(bd, "\x01")]), op)
        bd.NewStore(bd.NewAdd(i, one), ip)
        bd.NewBr(h)
        x.NewRet(x.NewLoad(i8ptr, op))
    })()

    // i32 rt_argpush(i8* v): append every FIELD of v to the argv stack.
    var rtArgPush = m.NewFunc("rt_argpush", i32, llvm.ir.NewParam("v", i8ptr))
    ;(function() {
        var v = rtArgPush.Params[0]
        var e = rtArgPush.NewBlock("entry")
        var h = rtArgPush.NewBlock("head")
        var bd = rtArgPush.NewBlock("body")
        var x = rtArgPush.NewBlock("exit")
        var n = e.NewCall(rtNFields, v)
        var ip = e.NewAlloca(i32)
        e.NewStore(zero, ip)
        e.NewBr(h)
        var i = h.NewLoad(i32, ip)
        h.NewCondBr(h.NewICmp(llvm.enum.IPredSLT, i, n), bd, x)
        var t = bd.NewLoad(i32, gArgvTop)
        bd.NewStore(bd.NewCall(rtGetField, [v, i]), bd.NewGetElementPtr(argvTy, gArgv, zero, t))
        bd.NewStore(bd.NewAdd(t, one), gArgvTop)
        bd.NewStore(bd.NewAdd(i, one), ip)
        bd.NewBr(h)
        x.NewRet(zero)
    })()

    // i8* rt_param(i32 n): the n-th positional parameter ("" past the end).
    var rtParam = m.NewFunc("rt_param", i8ptr, llvm.ir.NewParam("n", i32))
    ;(function() {
        var n = rtParam.Params[0]
        var e = rtParam.NewBlock("entry")
        var ok = rtParam.NewBlock("ok")
        var no = rtParam.NewBlock("no")
        var cnt = e.NewLoad(i32, gFrameN)
        e.NewCondBr(e.NewAnd(e.NewICmp(llvm.enum.IPredSGE, n, one),
                             e.NewICmp(llvm.enum.IPredSLE, n, cnt)), ok, no)
        var idx = ok.NewAdd(ok.NewLoad(i32, gFrameBase), ok.NewSub(n, one))
        ok.NewRet(ok.NewLoad(i8ptr, ok.NewGetElementPtr(argvTy, gArgv, zero, idx)))
        no.NewRet(emptyPtr(no))
    })()

    // i8* rt_params(i8* sep): "$@" when sep is the field marker, "$*" when it is a separator.
    var rtParams = m.NewFunc("rt_params", i8ptr, [llvm.ir.NewParam("sep", i8ptr), llvm.ir.NewParam("star", i32)])
    ;(function() {
        var sep = rtParams.Params[0], star = rtParams.Params[1]
        var e = rtParams.NewBlock("entry")
        var h = rtParams.NewBlock("head")
        var bd = rtParams.NewBlock("body")
        var x = rtParams.NewBlock("exit")
        var cnt = e.NewLoad(i32, gFrameN)
        var base = e.NewLoad(i32, gFrameBase)
        var op = e.NewAlloca(i8ptr)
        var ip = e.NewAlloca(i32)
        e.NewStore(e.NewSelect(e.NewICmp(llvm.enum.IPredNE, star, zero), emptyPtr(e), gepStr(e, "\x02")), op)
        e.NewStore(zero, ip)
        e.NewBr(h)
        var i = h.NewLoad(i32, ip)
        h.NewCondBr(h.NewICmp(llvm.enum.IPredSLT, i, cnt), bd, x)
        var v = bd.NewLoad(i8ptr, bd.NewGetElementPtr(argvTy, gArgv, zero, bd.NewAdd(base, i)))
        var cur = bd.NewLoad(i8ptr, op)
        var isStar = bd.NewICmp(llvm.enum.IPredNE, star, zero)
        var needSep = bd.NewAnd(isStar, bd.NewICmp(llvm.enum.IPredSGT, i, zero))
        cur = bd.NewSelect(needSep, bd.NewCall(rtStrcat, [cur, sep]), cur)
        cur = bd.NewCall(rtStrcat, [cur, v])
        cur = bd.NewSelect(isStar, cur, bd.NewCall(rtStrcat, [cur, gepStr(bd, "\x01")]))
        bd.NewStore(cur, op)
        bd.NewStore(bd.NewAdd(i, one), ip)
        bd.NewBr(h)
        x.NewRet(x.NewLoad(i8ptr, op))
    })()

    // ---- [[ str =~ ere ]] -----------------------------------------------------------------
    // Two externs the IR machine provides, backed by the SAME rxCompile/rxSearch engine the
    // interpreter grammar uses through lib/regex.js - there is no second matcher.
    //   rt_regex_search > 0  matched; the number of capture PAIRS, i.e. ${#BASH_REMATCH[@]}
    //                  == 0  no match
    //                  == -1 the pattern did not compile; rt_regex_error() has the text
    //                  == -2 the engine's step cap was hit on a pathological pattern
    // caps is caller-allocated, ncaps SLOTS (ncaps/2 pairs), pre-filled with -1, so a group
    // that did not participate reads -1/-1 - bash's empty-but-counted BASH_REMATCH entry.
    // Offsets are BYTES into the subject, which is what bash indexes.
    var i32ptr = llvm.types.NewPointer(i32)
    var rtRegexSearch = m.NewFunc("rt_regex_search", i32,
        [llvm.ir.NewParam("pat", i8ptr), llvm.ir.NewParam("subj", i8ptr),
         llvm.ir.NewParam("flags", i8ptr), llvm.ir.NewParam("caps", i32ptr),
         llvm.ir.NewParam("ncaps", i32)])
    var rtRegexError = m.NewFunc("rt_regex_error", i8ptr)

    // i8* rt_nounset(i8* v): under set -u, reading an unset variable raises the abort flag.
    var rtNounset = m.NewFunc("rt_nounset", i8ptr, llvm.ir.NewParam("v", i8ptr))
    ;(function() {
        var v = rtNounset.Params[0]
        var e = rtNounset.NewBlock("entry")
        var hit = rtNounset.NewBlock("hit")
        var x = rtNounset.NewBlock("exit")
        var um = e.NewGetElementPtr(emptyTy, gUnset, zero, zero)
        var bad = e.NewAnd(e.NewICmp(llvm.enum.IPredNE, e.NewLoad(i32, gOptU), zero),
                           e.NewICmp(llvm.enum.IPredEQ, v, um))
        e.NewCondBr(bad, hit, x)
        hit.NewStore(one, gAbort)
        hit.NewBr(x)
        x.NewRet(v)
    })()

    // i32 rt_putc(i32 c): one output byte - into the innermost capture buffer if a command
    // substitution is running, otherwise to stdout.
    var rtPutc = m.NewFunc("rt_putc", i32, llvm.ir.NewParam("c", i32))
    ;(function() {
        var cv = rtPutc.Params[0]
        var e = rtPutc.NewBlock("entry")
        var cap = rtPutc.NewBlock("cap")
        var out = rtPutc.NewBlock("out")
        var x = rtPutc.NewBlock("exit")
        var chan = e.NewLoad(i32, gSinkOut)
        var drop = rtPutc.NewBlock("drop")
        var live = rtPutc.NewBlock("live")
        e.NewCondBr(e.NewICmp(llvm.enum.IPredEQ, chan, zero), live, drop)
        drop.NewBr(x)
        var d = live.NewLoad(i32, gCapDepth)
        live.NewCondBr(live.NewICmp(llvm.enum.IPredSGT, d, zero), cap, out)
        var idx = cap.NewSub(d, one)
        var buf = cap.NewLoad(i8ptr, cap.NewGetElementPtr(capBufTy, gCapBuf, zero, idx))
        var lenp = cap.NewGetElementPtr(capLenTy, gCapLen, zero, idx)
        var l = cap.NewLoad(i32, lenp)
        cap.NewStore(cap.NewTrunc(cv, i8), cap.NewGetElementPtr(i8, buf, l))
        cap.NewStore(cap.NewAdd(l, one), lenp)
        cap.NewBr(x)
        out.NewCall(extPutchar, cv)
        out.NewBr(x)
        x.NewRet(zero)
    })()

    // i32 rt_cap_begin(i32): open a fresh capture buffer.
    var rtCapBegin = m.NewFunc("rt_cap_begin", i32, llvm.ir.NewParam("u", i32))
    ;(function() {
        var e = rtCapBegin.NewBlock("entry")
        var d = e.NewLoad(i32, gCapDepth)
        var buf = e.NewCall(rtBump, llvm.constant.NewInt(i32, CAPSZ))
        e.NewStore(buf, e.NewGetElementPtr(capBufTy, gCapBuf, zero, d))
        e.NewStore(zero, e.NewGetElementPtr(capLenTy, gCapLen, zero, d))
        e.NewStore(e.NewAdd(d, one), gCapDepth)
        e.NewRet(zero)
    })()

    // i8* rt_cap_end(i32): close the innermost buffer, drop its trailing newlines, NUL it.
    var rtCapEnd = m.NewFunc("rt_cap_end", i8ptr, llvm.ir.NewParam("u", i32))
    ;(function() {
        var e = rtCapEnd.NewBlock("entry")
        var h = rtCapEnd.NewBlock("head")
        var chk = rtCapEnd.NewBlock("chk")
        var bd = rtCapEnd.NewBlock("body")
        var dn = rtCapEnd.NewBlock("done")
        var d2 = e.NewSub(e.NewLoad(i32, gCapDepth), one)
        e.NewStore(d2, gCapDepth)
        var buf = e.NewLoad(i8ptr, e.NewGetElementPtr(capBufTy, gCapBuf, zero, d2))
        var lp = e.NewAlloca(i32)
        e.NewStore(e.NewLoad(i32, e.NewGetElementPtr(capLenTy, gCapLen, zero, d2)), lp)
        e.NewBr(h)
        var l = h.NewLoad(i32, lp)
        h.NewCondBr(h.NewICmp(llvm.enum.IPredSGT, l, zero), chk, dn)
        var lm = chk.NewSub(chk.NewLoad(i32, lp), one)
        var ch = chk.NewLoad(i8, chk.NewGetElementPtr(i8, buf, lm))
        chk.NewCondBr(chk.NewICmp(llvm.enum.IPredEQ, ch, llvm.constant.NewInt(i8, 10)), bd, dn)
        bd.NewStore(bd.NewSub(bd.NewLoad(i32, lp), one), lp)
        bd.NewBr(h)
        dn.NewStore(zero8, dn.NewGetElementPtr(i8, buf, dn.NewLoad(i32, lp)))
        dn.NewRet(buf)
    })()

    // rt_prints(i8* s): emit each byte until NUL (no trailing newline).
    var rtPrints = m.NewFunc("rt_prints", i32, llvm.ir.NewParam("s", i8ptr))
    ;(function() {
        var s = rtPrints.Params[0]
        var e = rtPrints.NewBlock("entry")
        var h = rtPrints.NewBlock("head")
        var bd = rtPrints.NewBlock("body")
        var x = rtPrints.NewBlock("exit")
        var ip = e.NewAlloca(i32)
        e.NewStore(zero, ip)
        e.NewBr(h)
        var i = h.NewLoad(i32, ip)
        var ch = h.NewLoad(i8, h.NewGetElementPtr(i8, s, i))
        h.NewCondBr(h.NewICmp(llvm.enum.IPredEQ, ch, zero8), x, bd)
        bd.NewCall(rtPutc, bd.NewZExt(ch, i32))
        bd.NewStore(bd.NewAdd(i, one), ip)
        bd.NewBr(h)
        x.NewRet(zero)
    })()

    // i32 rt_ss_save(i32) / rt_ss_restore(i32): push and pop a whole variable snapshot.
    var rtSsSave = m.NewFunc("rt_ss_save", i32, llvm.ir.NewParam("u", i32))
    ;(function() {
        var e = rtSsSave.NewBlock("entry")
        var h = rtSsSave.NewBlock("head")
        var bd = rtSsSave.NewBlock("body")
        var x = rtSsSave.NewBlock("exit")
        var d = e.NewLoad(i32, gSsDepth)
        var base = e.NewMul(d, llvm.constant.NewInt(i32, NVARS))
        var ip = e.NewAlloca(i32)
        e.NewStore(zero, ip)
        e.NewBr(h)
        var i = h.NewLoad(i32, ip)
        h.NewCondBr(h.NewICmp(llvm.enum.IPredSLT, i, h.NewLoad(i32, gNvars)), bd, x)
        var v = bd.NewLoad(i8ptr, bd.NewGetElementPtr(gvarsTy, gVars, zero, i))
        bd.NewStore(v, bd.NewGetElementPtr(ssTy, gSs, zero, bd.NewAdd(base, i)))
        bd.NewStore(bd.NewAdd(i, one), ip)
        bd.NewBr(h)
        x.NewStore(x.NewAdd(d, one), gSsDepth)
        x.NewRet(zero)
    })()
    var rtSsRestore = m.NewFunc("rt_ss_restore", i32, llvm.ir.NewParam("u", i32))
    ;(function() {
        var e = rtSsRestore.NewBlock("entry")
        var h = rtSsRestore.NewBlock("head")
        var bd = rtSsRestore.NewBlock("body")
        var x = rtSsRestore.NewBlock("exit")
        var d = e.NewSub(e.NewLoad(i32, gSsDepth), one)
        e.NewStore(d, gSsDepth)
        var base = e.NewMul(d, llvm.constant.NewInt(i32, NVARS))
        var ip = e.NewAlloca(i32)
        e.NewStore(zero, ip)
        e.NewBr(h)
        var i = h.NewLoad(i32, ip)
        h.NewCondBr(h.NewICmp(llvm.enum.IPredSLT, i, h.NewLoad(i32, gNvars)), bd, x)
        var v = bd.NewLoad(i8ptr, bd.NewGetElementPtr(ssTy, gSs, zero, bd.NewAdd(base, i)))
        bd.NewStore(v, bd.NewGetElementPtr(gvarsTy, gVars, zero, i))
        bd.NewStore(bd.NewAdd(i, one), ip)
        bd.NewBr(h)
        x.NewRet(zero)
    })()

    // i32 rt_push_local(i32 id): remember gvars[id]'s current value on the local save stack.
    var rtPushLocal = m.NewFunc("rt_push_local", i32, llvm.ir.NewParam("id", i32))
    ;(function() {
        var id = rtPushLocal.Params[0]
        var e = rtPushLocal.NewBlock("entry")
        var t = e.NewLoad(i32, gLsTop)
        e.NewStore(id, e.NewGetElementPtr(lsIdTy, gLsId, zero, t))
        var v = e.NewLoad(i8ptr, e.NewGetElementPtr(gvarsTy, gVars, zero, id))
        e.NewStore(v, e.NewGetElementPtr(lsValTy, gLsVal, zero, t))
        e.NewStore(e.NewAdd(t, one), gLsTop)
        e.NewRet(zero)
    })()

    // i32 rt_pop_locals(i32 depth): restore every entry above `depth` (innermost first).
    var rtPopLocals = m.NewFunc("rt_pop_locals", i32, llvm.ir.NewParam("d", i32))
    ;(function() {
        var d = rtPopLocals.Params[0]
        var e = rtPopLocals.NewBlock("entry")
        var h = rtPopLocals.NewBlock("head")
        var bd = rtPopLocals.NewBlock("body")
        var x = rtPopLocals.NewBlock("exit")
        e.NewBr(h)
        var t = h.NewLoad(i32, gLsTop)
        h.NewCondBr(h.NewICmp(llvm.enum.IPredSLE, t, d), x, bd)
        var t2 = bd.NewSub(t, one)
        bd.NewStore(t2, gLsTop)
        var sid = bd.NewLoad(i32, bd.NewGetElementPtr(lsIdTy, gLsId, zero, t2))
        var sv = bd.NewLoad(i8ptr, bd.NewGetElementPtr(lsValTy, gLsVal, zero, t2))
        bd.NewStore(sv, bd.NewGetElementPtr(gvarsTy, gVars, zero, sid))
        bd.NewBr(h)
        x.NewRet(zero)
    })()

    // ===================================================================================
    //  Value helpers used by the thunks.
    // ===================================================================================

    // The current string value of a variable / special name, as an i8* in block b.
    function allDigits(t) {
        if (t.length == 0) { return false }
        var i
        for (i = 0; i < t.length; i++) { var cc = t.charCodeAt(i); if (cc < 48 || cc > 57) { return false } }
        return true
    }
    function varString(b, name) {
        if (name == "?") { return b.NewCall(rtInt2str, b.NewLoad(i32, gStatus)) }
        if (name == "#") { return b.NewCall(rtInt2str, b.NewLoad(i32, gFrameN)) }
        if (name == "*") { return b.NewCall(rtParams, [ifsFirstValue(b), one]) }
        if (name == "@") { return b.NewCall(rtParams, [ifsFirstValue(b), zero]) }
        // There is no process behind a compiled run, so $$ and $! are fixed values.
        if (name == "$") { return gepStr(b, "1000") }
        if (name == "!") { return gepStr(b, "0") }
        if (name == "-") { return gepStr(b, "hB") }
        if (allDigits(name)) {
            var idx = parseDec(name)
            if (idx == 0) { return gepStr(b, "bash") }
            return b.NewCall(rtParam, llvm.constant.NewInt(i32, idx))
        }
        // an array name expands to its element 0
        var isA = b.NewICmp(llvm.enum.IPredSGT, b.NewCall(rtArrCount, gepStr(b, name)), zero)
        return b.NewSelect(isA, b.NewCall(rtArrGet, [gepStr(b, name), gepStr(b, "0")]),
                                b.NewCall(rtNounset, loadVar(b, name)))
    }

    // ===================================================================================
    //  Word / expansion thunks:  {fn: function(b) -> {b, v: i8*}, c: const-string|undefined}
    // ===================================================================================

    function makeConst(s) {
        return {fn: function(b) { return {b: b, v: gepStr(b, s)} }, c: s}
    }
    // Command substitution: divert output into a capture buffer, run the list, take the buffer.
    function mkCmdSub(bodyT) {
        return {s: true, c: undefined, fn: function(b) {
            b.NewCall(rtCapBegin, zero)
            var savedExit = curExit
            var savedTraps = trapList
            trapList = []
            var subEnd = curF.NewBlock("")
            curExit = subEnd
            b.NewCall(rtSsSave, zero)
            var optSave = saveOpts(b)
            var eb = bodyT(b)
            eb.NewBr(subEnd)
            curExit = savedExit
            var myTraps = trapList
            trapList = savedTraps
            subEnd = emitTraps(subEnd, myTraps)
            var wasEx = subEnd.NewICmp(llvm.enum.IPredNE, subEnd.NewLoad(i32, gExited), zero)
            var st = subEnd.NewSelect(wasEx, subEnd.NewLoad(i32, gExitCode), subEnd.NewLoad(i32, gStatus))
            subEnd.NewStore(zero, gExited)
            subEnd.NewCall(rtSsRestore, zero)
            restoreOpts(subEnd, optSave)
            subEnd.NewStore(st, gStatus)
            var v = subEnd.NewCall(rtCapEnd, zero)
            return {b: subEnd, v: v}
        }}
    }
    function mkArCmdSub(sub) {
        return function(b) { var r = evalWord(b, sub); return {b: r.b, v: r.b.NewCall(rtStr2int, r.v)} }
    }
    // ${...} : items are [{pname}, {pe}?, {op}?, {anchor}?, word objects / arithmetic thunks]
    function mkParamExp(items) {
        var pe = "", name = "", op = "", anchor = ""
        var words = []     // word objects {fn, c}
        var ariths = []    // bare arithmetic thunks (the ${v:off:len} offsets)
        var wordT = null
        var hasIdx = false
        var i
        for (i = 0; i < items.length; i++) {
            var it = items[i]
            if (typeof it == "function") { ariths.push(it) }
            else if (it.hasIdx != undefined) { hasIdx = true }
            else if (it.fn != undefined) { words.push(it); wordT = it }
            else if (it.pe != undefined) { pe = it.pe }
            else if (it.pname != undefined) { name = it.pname }
            else if (it.op != undefined) { op = it.op }
            else if (it.anchor != undefined) { anchor = it.anchor }
        }
        // NAME[SUBSCRIPT]: the first word is the subscript, the rest belong to the operator.
        if (hasIdx && words.length > 0) {
            var idxW = words[0]
            words = words.slice(1)
            wordT = (words.length > 0) ? words[words.length - 1] : null
            var isAssoc = hasOwn(assocArrays, "$" + name)
            var nmOf = function(b) { return gepStr(b, name) }
            var subOf = function(b) {
                var r = evalWord(b, idxW)
                var sub = r.v
                return {b: r.b, v: sub}
            }
            var kindOf = function(b, sub) {
                // 0 = a plain key, 1 = "@" (fields), 2 = "*" (joined)
                var isAt = b.NewICmp(llvm.enum.IPredNE, b.NewCall(rtStreq, [sub, gepStr(b, "@")]), zero)
                var isStar = b.NewICmp(llvm.enum.IPredNE, b.NewCall(rtStreq, [sub, gepStr(b, "*")]), zero)
                return b.NewSelect(isAt, one, b.NewSelect(isStar, llvm.constant.NewInt(i32, 2), zero))
            }
            var keyOf = function(b, sub) {
                if (isAssoc) { return sub }
                return b.NewCall(rtInt2str, b.NewCall(rtStr2int, sub))
            }
            if (pe == "len") {
                return {c: undefined, fn: function(b) {
                    var rs = subOf(b); b = rs.b
                    var k = kindOf(b, rs.v)
                    var whole = b.NewICmp(llvm.enum.IPredNE, k, zero)
                    return {b: b, v: b.NewSelect(whole,
                        b.NewCall(rtInt2str, b.NewCall(rtArrCount, nmOf(b))),
                        b.NewCall(rtInt2str, b.NewCall(rtCharLen, b.NewCall(rtArrGet, [nmOf(b), keyOf(b, rs.v)]))))}
                }}
            }
            if (pe == "ind") {
                return {f: true, c: undefined, fn: function(b) {
                    var rs = subOf(b); b = rs.b
                    var k = kindOf(b, rs.v)
                    var star = b.NewICmp(llvm.enum.IPredEQ, k, llvm.constant.NewInt(i32, 2))
                    return {b: b, v: b.NewCall(rtArrList, [nmOf(b), ifsFirstValue(b),
                        b.NewZExt(star, i32), one])}
                }}
            }
            if (pe == "substr") {
                var offT = ariths[0]
                var lenT = (ariths.length > 1) ? ariths[1] : null
                return {f: true, c: undefined, fn: function(b) {
                    var rs = subOf(b); b = rs.b
                    var k = kindOf(b, rs.v)
                    var whole = b.NewICmp(llvm.enum.IPredNE, k, zero)
                    var star = b.NewICmp(llvm.enum.IPredEQ, k, llvm.constant.NewInt(i32, 2))
                    var all = b.NewCall(rtArrList, [nmOf(b), ifsFirstValue(b), zero, zero])
                    var ro = offT(b); b = ro.b
                    var rlv = null
                    if (lenT != null) { var rl = lenT(b); b = rl.b; rlv = rl.v }
                    var cnt = b.NewCall(rtNFields, all)
                    var off = b.NewSelect(b.NewICmp(llvm.enum.IPredSLT, ro.v, zero), b.NewAdd(cnt, ro.v), ro.v)
                    var n = b.NewSub(cnt, off)
                    if (rlv != null) { n = rlv }
                    var lstV = b.NewCall(rtSliceFields, [all, off, n, ifsFirstValue(b), b.NewZExt(star, i32)])
                    // ${a[i]:off:len} slices the ELEMENT, not the element list - the
                    // list slice was emitted for a plain index too, so ${a[2]:1:2}
                    // answered the whole joined array while the interpreter (and
                    // bash) answered two characters of a[2].
                    var ev = b.NewCall(rtArrGet, [nmOf(b), keyOf(b, rs.v)])
                    var elen = b.NewCall(rtCharLen, ev)
                    var eoff = b.NewSelect(b.NewICmp(llvm.enum.IPredSLT, ro.v, zero), b.NewAdd(elen, ro.v), ro.v)
                    eoff = b.NewSelect(b.NewICmp(llvm.enum.IPredSLT, eoff, zero), zero, eoff)
                    var en = llvm.constant.NewInt(i32, -1)
                    if (rlv != null) {
                        en = b.NewSelect(b.NewICmp(llvm.enum.IPredSLT, rlv, zero),
                                         b.NewSub(b.NewAdd(elen, rlv), eoff), rlv)
                        en = b.NewSelect(b.NewICmp(llvm.enum.IPredSLT, en, zero), zero, en)
                    }
                    var elV = b.NewCall(rtCSubstr, [ev, eoff, en])
                    return {b: b, v: b.NewSelect(whole, lstV, elV)}
                }}
            }
            return {f: true, c: undefined, fn: function(b) {
                var rs = subOf(b); b = rs.b
                var k = kindOf(b, rs.v)
                var whole = b.NewICmp(llvm.enum.IPredNE, k, zero)
                var star = b.NewICmp(llvm.enum.IPredEQ, k, llvm.constant.NewInt(i32, 2))
                var lst = b.NewCall(rtArrList, [nmOf(b), ifsFirstValue(b), b.NewZExt(star, i32), zero])
                var one1 = b.NewCall(rtArrGet, [nmOf(b), keyOf(b, rs.v)])
                return {b: b, v: b.NewSelect(whole, lst, one1)}
            }}
        }
        if (pe == "substr") {
            var offT = ariths[0]
            var lenT = (ariths.length > 1) ? ariths[1] : null
            return {c: undefined, fn: function(b) {
                var v = varString(b, name)
                var ro = offT(b)
                b = ro.b
                // Offsets and lengths of ${v:off:len} are in CHARACTERS in bash,
                // so the whole computation runs in character units and rt_csubstr
                // converts to byte positions. rt_strlen/rt_substr here made
                // ${s:1:2} on "h<e-acute>llo" answer one byte, not two characters.
                var len = b.NewCall(rtCharLen, v)
                // a negative offset counts from the end
                var off = b.NewSelect(b.NewICmp(llvm.enum.IPredSLT, ro.v, zero), b.NewAdd(len, ro.v), ro.v)
                if (lenT == null) {
                    return {b: b, v: b.NewCall(rtCSubstr, [v, off, llvm.constant.NewInt(i32, -1)])}
                }
                var rl = lenT(b)
                b = rl.b
                // a negative length is an offset from the end of the string
                var n = b.NewSelect(b.NewICmp(llvm.enum.IPredSLT, rl.v, zero),
                                    b.NewSub(b.NewAdd(len, rl.v), off), rl.v)
                n = b.NewSelect(b.NewICmp(llvm.enum.IPredSLT, n, zero), zero, n)
                return {b: b, v: b.NewCall(rtCSubstr, [v, off, n])}
            }}
        }
        if (pe == "#" || pe == "##" || pe == "%" || pe == "%%") {
            var smode = 0
            if (pe == "##") { smode = 1 }
            if (pe == "%") { smode = 2 }
            if (pe == "%%") { smode = 3 }
            var patW = (words.length > 0) ? words[0] : null
            return {c: undefined, fn: function(b) {
                var v = varString(b, name)
                if (patW == null) { return {b: b, v: v} }
                var rp = evalWord(b, patW)
                b = rp.b
                return {b: b, v: b.NewCall(rtStrip, [v, rp.v, llvm.constant.NewInt(i32, smode)])}
            }}
        }
        if (pe == "^" || pe == "^^" || pe == "," || pe == ",,") {
            var cmode = 0
            if (pe == "^^") { cmode = 1 }
            if (pe == ",") { cmode = 2 }
            if (pe == ",,") { cmode = 3 }
            return {c: undefined, fn: function(b) {
                return {b: b, v: b.NewCall(rtCase, [varString(b, name), llvm.constant.NewInt(i32, cmode)])}
            }}
        }
        if (pe == "/" || pe == "//") {
            var rmode = (pe == "//") ? 1 : 0
            if (anchor == "#") { rmode = 2 }
            if (anchor == "%") { rmode = 3 }
            var pW = (words.length > 0) ? words[0] : null
            var rW = (words.length > 1) ? words[1] : null
            return {c: undefined, fn: function(b) {
                var v = varString(b, name)
                if (pW == null) { return {b: b, v: v} }
                var rp2 = evalWord(b, pW)
                b = rp2.b
                var rep = emptyPtr(b)
                if (rW != null) { var rr = evalWord(b, rW); b = rr.b; rep = rr.v }
                return {b: b, v: b.NewCall(rtReplace, [v, rp2.v, rep, llvm.constant.NewInt(i32, rmode)])}
            }}
        }
        if (pe == "len") {
            return {c: undefined, fn: function(b) {
                // ${#v} counts CHARACTERS in bash (rt_strlen counts bytes).
                return {b: b, v: b.NewCall(rtInt2str, b.NewCall(rtCharLen, varString(b, name)))}
            }}
        }
        if (pe == "ind") {
            return {c: undefined, fn: function(b) {
                return {b: b, v: b.NewCall(rtGetByName, varString(b, name))}
            }}
        }
        if (op == "") { return mkVarRef(name) }
        var colon = (op.charAt(0) == ":")
        var o = colon ? op.slice(1) : op
        return {c: undefined, fn: function(b) {
            var v = varString(b, name)
            // ":" forms treat "" like unset; the bare forms only test set-ness, which the
            // unset marker (a distinct empty string) records.
            var blank = colon ? isEmptyStr(b, v)
                              : b.NewICmp(llvm.enum.IPredEQ, v, unsetPtr(b))
            var d = emptyPtr(b)
            if (wordT != null) { var r = evalWord(b, wordT); b = r.b; d = r.v }
            if (o == "+") { return {b: b, v: b.NewSelect(blank, emptyPtr(b), d)} }
            var picked = b.NewSelect(blank, d, v)
            if (o == "=") { storeVar(b, name, picked) }
            return {b: b, v: picked}
        }}
    }
    function mkVarRef(name) {
        var multi = (name == "@")
        return {f: multi, fn: function(b) { return {b: b, v: varString(b, name)} }, c: undefined}
    }
    function mkArith(intThunk) {
        return {fn: function(b) { var r = intThunk(b); return {b: r.b, v: r.b.NewCall(rtInt2str, r.v)} }, c: undefined}
    }
    // ---- brace expansion (purely syntactic, so it is done once at BUILD time) ----
    function pushWords(ws) {
        var i
        for (i = 0; i < ws.length; i++) { push(ws[i]) }
    }
    function mkBraceAlts(items) {
        var alts = []
        var i
        for (i = 0; i < items.length; i++) { alts.push(items[i].alt) }
        return {alts: alts}
    }
    function isAlphaCh(cc) { return (cc >= 97 && cc <= 122) || (cc >= 65 && cc <= 90) }
    function numToStr(n) {
        var v = n | 0
        if (v == 0) { return "0" }
        var neg = false
        if (v < 0) { neg = true; v = (0 - v) | 0 }
        var out = ""
        while (v > 0) {
            var d = v % 10
            out = String.fromCharCode(48 + d) + out
            v = ((v - d) / 10) | 0
        }
        if (neg) { out = "-" + out }
        return out
    }
    function mkBraceRange(items) {
        var ends = []
        var step = 0
        var i
        for (i = 0; i < items.length; i++) {
            var it = items[i]
            if (it.rend != undefined) { ends.push(it.rend) } else { step = parseDec(it.rstep.slice(2)) }
        }
        var lo = ends[0], hi = ends[1]
        var alts = []
        var numeric = !(lo.length == 1 && isAlphaCh(lo.charCodeAt(0)))
        var a = numeric ? parseDec(lo) : lo.charCodeAt(0)
        var b = numeric ? parseDec(hi) : hi.charCodeAt(0)
        var st = (step != 0) ? step : 1
        if (st < 0) { st = (0 - st) | 0 }
        var v = a
        var guard = 0
        while (guard < 100000) {
            guard = guard + 1
            alts.push([makeConst(numeric ? numToStr(v) : String.fromCharCode(v))])
            if (a <= b) { if (v + st > b) { guard = 100000 } else { v = v + st } }
            else { if (v - st < b) { guard = 100000 } else { v = v - st } }
        }
        return {alts: alts}
    }
    function concatSegs(a, b) {
        var out = []
        var i
        for (i = 0; i < a.length; i++) { out.push(a[i]) }
        for (i = 0; i < b.length; i++) { out.push(b[i]) }
        return out
    }
    function braceVariants(segs) {
        var variants = [[]]
        var i
        for (i = 0; i < segs.length; i++) {
            var sg = segs[i]
            var out = []
            var v
            if (sg.alts == undefined) {
                for (v = 0; v < variants.length; v++) { out.push(concatSegs(variants[v], [sg])) }
            } else {
                for (v = 0; v < variants.length; v++) {
                    var a
                    for (a = 0; a < sg.alts.length; a++) {
                        var subs = braceVariants(sg.alts[a])
                        var k
                        for (k = 0; k < subs.length; k++) { out.push(concatSegs(variants[v], subs[k])) }
                    }
                }
            }
            variants = out
        }
        return variants
    }
    function mkWords(segs) {
        var hasBrace = false
        var i
        for (i = 0; i < segs.length; i++) { if (segs[i].alts != undefined) { hasBrace = true } }
        if (!hasBrace) { return [mkWord(segs)] }
        var vs = braceVariants(segs)
        var out = []
        for (i = 0; i < vs.length; i++) { out.push(mkWord(vs[i])) }
        return out
    }
    function mkTilde() { return mkVarRef("HOME") }

    function mkSplittable(seg) { return {sp: seg, s: seg.s} }
    // The IFS in force, defaulting to " \t\n" when the variable is unset.
    function ifsValue(b) {
        var v = loadVar(b, "IFS")
        return b.NewSelect(b.NewICmp(llvm.enum.IPredEQ, v, unsetPtr(b)), gepStr(b, " \t\n"), v)
    }
    function ifsFirstValue(b) {
        var v = ifsValue(b)
        return b.NewCall(rtSubstr, [v, zero, one])
    }
    // A double-quoted string: no splitting, but "$@" / "${a[@]}" still contribute several
    // fields, joined onto the neighbouring text at the boundaries.
    function mkDqWord(segs) {
        if (segs.length == 0) { return makeConst("") }
        var anyFields = false
        var i
        for (i = 0; i < segs.length; i++) { if (segs[i].f == true) { anyFields = true } }
        if (!anyFields) { return mkWord(segs) }
        return {c: undefined, f: true, fn: function(b) {
            var acc = gepStr(b, "\x02")
            var open = emptyPtr(b)      // the field being built
            var k
            for (k = 0; k < segs.length; k++) {
                var r = segs[k].fn(b)
                b = r.b
                if (segs[k].f == true) {
                    var nacc = b.NewCall(rtBndAcc, [acc, open, r.v])
                    open = b.NewCall(rtBndOpen, [open, r.v])
                    acc = nacc
                } else {
                    open = b.NewCall(rtStrcat, [open, r.v])
                }
            }
            return {b: b, v: b.NewCall(rtStrcat, [b.NewCall(rtStrcat, [acc, open]), gepStr(b, "\x01")])}
        }}
    }

    // A word is the concatenation of its segment objects. All static -> one interned constant.
    function mkWord(segs) {
        if (segs.length == 0) { return makeConst("") }
        var allConst = true, joined = "", anySub = false, anyField = false
        var i
        for (i = 0; i < segs.length; i++) {
            if (segs[i].s == true) { anySub = true }
            if (segs[i].sp != undefined || segs[i].f == true) { anyField = true }
            if (segs[i].c == undefined) { allConst = false } else { joined = joined + segs[i].c }
        }
        if (allConst) { return makeConst(joined) }
        if (!anyField && segs.length == 1) { return segs[0] }
        if (!anyField) {
            return {s: anySub, fn: function(b) {
                var r = segs[0].fn(b)
                var bb = r.b, v = r.v
                var k
                for (k = 1; k < segs.length; k++) {
                    var r2 = segs[k].fn(bb)
                    bb = r2.b
                    v = bb.NewCall(rtStrcat, [v, r2.v])
                }
                return {b: bb, v: v}
            }, c: undefined}
        }
        // Some segment can produce several fields: build the list, joining at the boundaries.
        // A word made only of expansions that produced nothing disappears entirely.
        return {s: anySub, f: true, c: undefined, fn: function(b) {
            var acc = gepStr(b, "\x02")
            var open = emptyPtr(b)
            var lit = zero
            var k
            for (k = 0; k < segs.length; k++) {
                var sg = segs[k]
                var fv = null
                if (sg.sp != undefined) {
                    var r = sg.sp.fn(b)
                    b = r.b
                    // an unquoted expansion: already a field list, or split on IFS
                    var isL = b.NewICmp(llvm.enum.IPredEQ,
                                b.NewZExt(b.NewLoad(i8, b.NewGetElementPtr(i8, r.v, zero)), i32),
                                llvm.constant.NewInt(i32, 2))
                    fv = b.NewSelect(isL, r.v, b.NewCall(rtSplitIfs, [r.v, ifsValue(b)]))
                } else if (sg.f == true) {
                    var r2 = sg.fn(b)
                    b = r2.b
                    fv = r2.v
                } else {
                    var r3 = sg.fn(b)
                    b = r3.b
                    lit = one
                    open = b.NewCall(rtStrcat, [open, r3.v])
                }
                if (fv != null) {
                    var nacc = b.NewCall(rtBndAcc, [acc, open, fv])
                    open = b.NewCall(rtBndOpen, [open, fv])
                    acc = nacc
                }
            }
            var full = b.NewCall(rtStrcat, [b.NewCall(rtStrcat, [acc, open]), gepStr(b, "\x01")])
            // nothing literal AND every expansion empty -> no field at all
            var empty = b.NewAnd(b.NewICmp(llvm.enum.IPredEQ, lit, zero),
                                 b.NewICmp(llvm.enum.IPredEQ, b.NewCall(rtStrlen, full), llvm.constant.NewInt(i32, 2)))
            return {b: b, v: b.NewSelect(empty, gepStr(b, "\x02"), full)}
        }}
    }

    // ===================================================================================
    //  Arithmetic thunks (bare functions):  function(b) -> {b, v: i32}
    // ===================================================================================

    function mkInt(text) { var c = llvm.constant.NewInt(i32, parseDec(text)); return function(b) { return {b: b, v: c} } }
    // A numeric literal: 0xHH hexadecimal, BASE#DIGITS, a leading 0 octal, else decimal.
    function digitsInBase(t, base) {
        var v = 0
        var i
        for (i = 0; i < t.length; i++) {
            var cc = t.charCodeAt(i)
            var d = -1
            if (cc >= 48 && cc <= 57) { d = cc - 48 }
            else if (cc >= 97 && cc <= 122) { d = cc - 87 }
            else if (cc >= 65 && cc <= 90) { d = cc - 55 }
            if (d < 0 || d >= base) { d = 0 }
            v = (v * base + d) | 0
        }
        return v
    }
    function parseNumLit(t) {
        if (t.length > 2 && t.charAt(0) == "0" && (t.charAt(1) == "x" || t.charAt(1) == "X")) {
            return digitsInBase(t.slice(2), 16)
        }
        var h = -1
        var i
        for (i = 0; i < t.length; i++) { if (t.charAt(i) == "#") { h = i } }
        if (h > 0) { return digitsInBase(t.slice(h + 1), parseDec(t.slice(0, h))) }
        if (t.length > 1 && t.charAt(0) == "0") { return digitsInBase(t.slice(1), 8) }
        return parseDec(t)
    }
    function mkNum(text) { var c = llvm.constant.NewInt(i32, parseNumLit(text)); return function(b) { return {b: b, v: c} } }
    function mkArOfStr(o) { return function(b) { var r = evalWord(b, o); return {b: r.b, v: r.b.NewCall(rtStr2int, r.v)} } }
    function mkUn(op, t) {
        return function(b) {
            var r = t(b)
            var bb = r.b
            if (op == "-") { return {b: bb, v: bb.NewSub(zero, r.v)} }
            if (op == "+") { return {b: bb, v: r.v} }
            if (op == "!") { return {b: bb, v: bb.NewZExt(bb.NewICmp(llvm.enum.IPredEQ, r.v, zero), i32)} }
            return {b: bb, v: bb.NewXor(r.v, llvm.constant.NewInt(i32, -1))}
        }
    }
    function mkIncDec(items) {
        var lhs = "", iop = "++", pre = 0
        var i
        for (i = 0; i < items.length; i++) {
            var it = items[i]
            if (it.lhs != undefined) { lhs = it.lhs } else { iop = it.iop; pre = it.pre }
        }
        return function(b) {
            var v = b.NewCall(rtStr2int, varString(b, lhs))
            var nv = (iop == "++") ? b.NewAdd(v, one) : b.NewSub(v, one)
            storeVar(b, lhs, b.NewCall(rtInt2str, nv))
            return {b: b, v: (pre == 1) ? nv : v}
        }
    }
    function mkArAssign(items) {
        var lhs = items[0].lhs
        var aop = items[1].aop
        var t = items[2]
        return function(b) {
            var cur = b.NewCall(rtStr2int, varString(b, lhs))
            var r = t(b)
            b = r.b
            var nv = r.v
            if (aop != "=") {
                var res = arOp(b, aop.slice(0, aop.length - 1), cur, r.v)
                b = res.b
                nv = res.v
            }
            storeVar(b, lhs, b.NewCall(rtInt2str, nv))
            return {b: b, v: nv}
        }
    }
    function mkArCond(items) {
        if (items.length == 1) { return items[0] }
        var c0 = items[0], t1 = items[1], t2 = items[2]
        return function(b) {
            var rc = c0(b)
            var r1 = t1(rc.b)
            var r2 = t2(r1.b)
            var bb = r2.b
            return {b: bb, v: bb.NewSelect(bb.NewICmp(llvm.enum.IPredNE, rc.v, zero), r1.v, r2.v)}
        }
    }
    function foldComma(items) {
        if (items.length == 1) { return items[0] }
        return function(b) {
            var v = zero
            var i
            for (i = 0; i < items.length; i++) { var r = items[i](b); b = r.b; v = r.v }
            return {b: b, v: v}
        }
    }
    // base ** exponent : a counted multiply loop (the exponent can be a run time value).
    function foldPow(items) {
        if (items.length == 1) { return items[0] }
        var bt = items[0], et = items[2]
        return function(b) {
            var rb = bt(b)
            var re = et(rb.b)
            b = re.b
            var acc = b.NewAlloca(i32), ip = b.NewAlloca(i32)
            b.NewStore(one, acc)
            b.NewStore(zero, ip)
            var h = curF.NewBlock(""), bd = curF.NewBlock(""), x = curF.NewBlock("")
            b.NewBr(h)
            var iv = h.NewLoad(i32, ip)
            h.NewCondBr(h.NewICmp(llvm.enum.IPredSLT, iv, re.v), bd, x)
            bd.NewStore(bd.NewMul(bd.NewLoad(i32, acc), rb.v), acc)
            bd.NewStore(bd.NewAdd(iv, one), ip)
            bd.NewBr(h)
            return {b: x, v: x.NewLoad(i32, acc)}
        }
    }
    function mkArVar(name) { return function(b) { return {b: b, v: b.NewCall(rtStr2int, varString(b, name))} } }
    function mkNeg(t) { return function(b) { var r = t(b); return {b: r.b, v: r.b.NewSub(zero, r.v)} } }
    // Returns {b, v}: only / and % branch (a zero divisor yields 0, like the interpreter's
    // (l/r)|0 / (l%r)|0, and unlike a raw sdiv/srem which would trap in the IR interpreter).
    function arOp(b, op, l, r) {
        if (op == "+") { return {b: b, v: b.NewAdd(l, r)} }
        if (op == "-") { return {b: b, v: b.NewSub(l, r)} }
        if (op == "*") { return {b: b, v: b.NewMul(l, r)} }
        if (op == "/" || op == "%") {
            var isz = b.NewICmp(llvm.enum.IPredEQ, r, zero)
            var zb = curF.NewBlock(""), db = curF.NewBlock(""), cb = curF.NewBlock("")
            b.NewCondBr(isz, zb, db)
            zb.NewBr(cb)
            var dv = (op == "/") ? db.NewSDiv(l, r) : db.NewSRem(l, r)
            db.NewBr(cb)
            return {b: cb, v: cb.NewPhi([llvm.ir.NewIncoming(zero, zb), llvm.ir.NewIncoming(dv, db)])}
        }
        var pred = null
        if (op == "<") { pred = llvm.enum.IPredSLT }
        if (op == ">") { pred = llvm.enum.IPredSGT }
        if (op == "<=") { pred = llvm.enum.IPredSLE }
        if (op == ">=") { pred = llvm.enum.IPredSGE }
        if (op == "==") { pred = llvm.enum.IPredEQ }
        if (op == "!=") { pred = llvm.enum.IPredNE }
        if (pred == null) {
            if (op == "<<") { return {b: b, v: b.NewShl(l, r)} }
            if (op == ">>") { return {b: b, v: b.NewAShr(l, r)} }
            if (op == "&") { return {b: b, v: b.NewAnd(l, r)} }
            if (op == "|") { return {b: b, v: b.NewOr(l, r)} }
            if (op == "^") { return {b: b, v: b.NewXor(l, r)} }
            var ln = b.NewICmp(llvm.enum.IPredNE, l, zero)
            var rn = b.NewICmp(llvm.enum.IPredNE, r, zero)
            if (op == "&&") { return {b: b, v: b.NewZExt(b.NewAnd(ln, rn), i32)} }
            if (op == "||") { return {b: b, v: b.NewZExt(b.NewOr(ln, rn), i32)} }
            fail("unsupported arithmetic operator: " + op)
        }
        return {b: b, v: b.NewZExt(b.NewICmp(pred, l, r), i32)}
    }
    function foldBin(items) {
        if (items.length == 1) { return items[0] }
        return function(b) {
            var r = items[0](b)
            var bb = r.b, v = r.v
            var i
            for (i = 1; i < items.length; i += 2) {
                var r2 = items[i + 1](bb)
                var res = arOp(r2.b, items[i].op, v, r2.v)
                bb = res.b
                v = res.v
            }
            return {b: bb, v: v}
        }
    }

    // ===================================================================================
    //  Statement / command thunks (bare functions):  function(b) -> continuation block.
    //  They keep the global last_status ($?) up to date.
    // ===================================================================================

    function storeStatus(b, v) { b.NewStore(v, gStatus) }
    function storeStatusI(b, n) { b.NewStore(llvm.constant.NewInt(i32, n), gStatus) }

    // items = [{aname}, {aidx}?, idxWord?, {aop2}, valueWord? | {arr}]
    function mkArrayKV(items) { return {kv: 1, key: items[0], val: items[1]} }
    function mkArrayLit(items) { return {arr: items} }
    function hasIdxMark(items) {
        var i
        for (i = 0; i < items.length; i++) { if (items[i].aidx != undefined) { return true } }
        return false
    }
    function parseAssign(items) {
        var name = items[0].aname
        var idxT = null, op = "=", valT = null, lit = null
        var wantIdx = hasIdxMark(items)
        var i
        for (i = 1; i < items.length; i++) {
            var it = items[i]
            if (it.fn != undefined) {
                if (wantIdx && idxT == null && valT == null && op == "=") { idxT = it } else { valT = it }
            }
            else if (it.aop2 != undefined) { op = it.aop2 }
            else if (it.arr != undefined) { lit = it.arr }
        }
        return {name: name, idxT: idxT, op: op, valT: valT, lit: lit}
    }
    // An array literal element list; a bare word contributes one element per FIELD.
    function emitArrayLit(b, name, litItems, append, assoc) {
        var nm = gepStr(b, name)
        if (!append) { b.NewCall(rtArrClear, nm) }
        var i
        for (i = 0; i < litItems.length; i++) {
            var it = litItems[i]
            if (it.kv != undefined) {
                var rk = it.key.fn(b); b = rk.b
                var rv = it.val.fn(b); b = rv.b
                b.NewCall(rtArrSet, [nm, b.NewCall(rtWordJoin, rk.v), b.NewCall(rtWordJoin, rv.v)])
            } else {
                var rw = it.fn(b); b = rw.b
                b.NewCall(rtArrAppend, [nm, rw.v])
            }
        }
        return b
    }
    function emitAssign(b, a, assoc0) {
        // Associative-ness is a property of the NAME (declare -A), not of this statement.
        var assoc = assoc0 || hasOwn(assocArrays, "$" + a.name)
        var nm = gepStr(b, a.name)
        if (a.lit != null) { return emitArrayLit(b, a.name, a.lit, a.op == "+=", assoc) }
        var v = emptyPtr(b)
        if (a.valT != null) { var r = a.valT.fn(b); b = r.b; v = b.NewCall(rtWordJoin, r.v) }
        if (a.idxT != null) {
            var rk = a.idxT.fn(b)
            b = rk.b
            var key = b.NewCall(rtWordJoin, rk.v)
            if (!assoc) { key = b.NewCall(rtInt2str, b.NewCall(rtStr2int, key)) }
            if (a.op == "+=") { v = b.NewCall(rtStrcat, [b.NewCall(rtArrGet, [nm, key]), v]) }
            b.NewCall(rtArrSet, [nm, key, v])
            return b
        }
        if (a.op == "+=") {
            var isA = b.NewICmp(llvm.enum.IPredSGT, b.NewCall(rtArrCount, nm), zero)
            var arrB = curF.NewBlock(""), strB = curF.NewBlock(""), mg = curF.NewBlock("")
            b.NewCondBr(isA, arrB, strB)
            arrB.NewCall(rtArrAppend, [nm, v])
            arrB.NewBr(mg)
            storeVar(strB, a.name, strB.NewCall(rtStrcat, [loadVar(strB, a.name), v]))
            strB.NewBr(mg)
            return mg
        }
        // `declare -i n` makes n=EXPR evaluate EXPR as arithmetic. The right hand side is a
        // literal here, so it is parsed with this grammar and emitted as ordinary IR.
        if (hasOwn(intVars, "$" + a.name) && a.valT != null && a.valT.c != undefined) {
            var frag = c.parseFrom(c.agrammar, a.valT.c, "ArList")
            var at = c.compile(frag).stack[0]
            var ra2 = at(b)
            b = ra2.b
            storeVar(b, a.name, b.NewCall(rtInt2str, ra2.v))
            return b
        }
        // an ordinary scalar assignment - unless the name is an array, where it is element 0
        var isA2 = b.NewICmp(llvm.enum.IPredSGT, b.NewCall(rtArrCount, nm), zero)
        var arrB2 = curF.NewBlock(""), strB2 = curF.NewBlock(""), mg2 = curF.NewBlock("")
        b.NewCondBr(isA2, arrB2, strB2)
        arrB2.NewCall(rtArrSet, [nm, gepStr(arrB2, "0"), v])
        arrB2.NewBr(mg2)
        storeVar(strB2, a.name, v)
        strB2.NewBr(mg2)
        return mg2
    }
    function makeAssign(items) {
        var a = parseAssign(items)
        return function(b) {
            b = emitAssign(b, a, false)
            if (a.valT == null || a.valT.s != true) { storeStatusI(b, 0) }
            return b
        }
    }

    // Every `ret` out of a user function first unwinds the local save stack back to the
    // depth the call recorded on entry, so `local` bindings do not leak to the caller.
    function emitFnRet(b, v) {
        if (curFrame != null) { b.NewCall(rtPopLocals, b.NewLoad(i32, curFrame.depth)) }
        b.NewRet(v)
    }

    // items = [{dkw}, {dflag}*, ({dname} | {a: assignment})*]
    function makeDecl(items) {
        var kw = items[0].dkw
        var flags = ""
        var names = []
        var asgs = []
        var i
        for (i = 1; i < items.length; i++) {
            var it = items[i]
            if (it.dflag != undefined) { flags = flags + it.dflag; continue }
            if (it.dname != undefined) { names.push(it.dname); asgs.push(null) }
            else { names.push(it.a.name); asgs.push(it.a) }
        }
        var isArray = (flags.indexOf("a") >= 0) || (flags.indexOf("A") >= 0)
        var assoc = (flags.indexOf("A") >= 0)
        var upper = (flags.indexOf("u") >= 0)
        var lower = (flags.indexOf("l") >= 0)
        var integer = (flags.indexOf("i") >= 0)
        var k
        for (k = 0; k < names.length; k++) {
            if (integer) { intVars["$" + names[k]] = true }
            if (assoc) { assocArrays["$" + names[k]] = true }
        }
        return function(b) {
            var j
            for (j = 0; j < names.length; j++) {
                if (kw == "local" && curFrame != null) {
                    b.NewCall(rtPushLocal, llvm.constant.NewInt(i32, getVarId(names[j])))
                }
                if (isArray) { b.NewCall(rtArrClear, gepStr(b, names[j])) }
                if (asgs[j] != null) {
                    b = emitAssign(b, asgs[j], assoc)
                    if (upper) { storeVar(b, names[j], b.NewCall(rtCase, [loadVar(b, names[j]), one])) }
                    if (lower) { storeVar(b, names[j], b.NewCall(rtCase, [loadVar(b, names[j]), llvm.constant.NewInt(i32, 3)])) }
                }
                else if (kw == "local" && !isArray) { storeVar(b, names[j], unsetPtr(b)) }
            }
            storeStatusI(b, 0)
            return b
        }
    }
    function mkDeclItem(items) { return {a: parseAssign(items)} }
    var intVars = {}      // names declared with `declare -i`
    var assocArrays = {}  // names declared with `declare -A` / `local -A`

    // After a call that might transitively `exit`, bail out to the current function's exit.
    function emitExitCheck(b) {
        var isEx = b.NewICmp(llvm.enum.IPredNE, b.NewLoad(i32, gExited), zero)
        var cont = curF.NewBlock("")
        b.NewCondBr(isEx, curExit, cont)
        return cont
    }

    // Evaluate ONE word to a single string: a word that can produce several fields is
    // flattened (space-joined), which is what every builtin with a fixed argument list wants.
    function evalWord(b, w) {
        var r = w.fn(b)
        if (w.f == true) { return {b: r.b, v: r.b.NewCall(rtWordJoin, r.v)} }
        return r
    }
    // Evaluate argument word objects in order, threading b via a box; returns [{v, c}].
    function evalArgs(bbox, args) {
        var out = []
        var i
        for (i = 0; i < args.length; i++) {
            var r = evalWord(bbox.b, args[i])
            bbox.b = r.b
            out.push({v: r.v, c: args[i].c})
        }
        return out
    }

    function emitEcho(b, args) {
        var start = 0, newline = true, escapes = false
        var flagging = true
        while (flagging && start < args.length) {
            var fa = args[start].c
            if (fa == "-n") { newline = false; start = start + 1 }
            else if (fa == "-e") { escapes = true; start = start + 1 }
            else if (fa == "-E") { escapes = false; start = start + 1 }
            else { flagging = false }
        }
        var i
        for (i = start; i < args.length; i++) {
            if (i > start) { b.NewCall(rtPrints, gepStr(b, " ")) }
            var r = evalWord(b, args[i])
            b = r.b
            b.NewCall(rtPrints, escapes ? b.NewCall(rtUnescape, r.v) : r.v)
        }
        if (newline) { b.NewCall(rtPutc, llvm.constant.NewInt(i32, 10)) }
        storeStatusI(b, 0)
        return b
    }

    // ---- the test builtin ------------------------------------------------------------
    // The operand VALUES are runtime i8*, but the operators are literals, so the argument
    // list is parsed into an expression at COMPILE time and lowered without any branching:
    // every leaf yields an i32 status (0 true / 1 false), `-a` is a bitwise or of the two
    // statuses, `-o` a bitwise and, and `!` an xor with 1.
    //
    // There is no real filesystem behind a compiled run either, so the file predicates go
    // through rt_fskind, a model of the standard paths (see bash-interpreter.abnf).
    var fsFiles = ["/dev/null", "/dev/zero", "/dev/tty", "/dev/stdin", "/dev/stdout", "/dev/stderr"]
    var fsDirs = ["/", "/dev", "/tmp", "/usr", "/etc", "/var", "/bin", "/usr/bin"]
    var rtFskind = m.NewFunc("rt_fskind", i32, llvm.ir.NewParam("p", i8ptr))
    ;(function() {
        var p2 = rtFskind.Params[0]
        var e = rtFskind.NewBlock("entry")
        var k = zero
        var i
        for (i = 0; i < fsFiles.length; i++) {
            var hit = e.NewICmp(llvm.enum.IPredNE, e.NewCall(rtStreq, [p2, gepStr(e, fsFiles[i])]), zero)
            k = e.NewSelect(hit, one, k)
        }
        for (i = 0; i < fsDirs.length; i++) {
            var hit2 = e.NewICmp(llvm.enum.IPredNE, e.NewCall(rtStreq, [p2, gepStr(e, fsDirs[i])]), zero)
            k = e.NewSelect(hit2, llvm.constant.NewInt(i32, 2), k)
        }
        e.NewRet(k)
    })()

    // "name" or "name[key]"
    function splitSubscript(s0) {
        var i
        for (i = 0; i < s0.length; i++) {
            if (s0.charAt(i) == "[" && s0.charAt(s0.length - 1) == "]") {
                return {name: s0.slice(0, i), key: s0.slice(i + 1, s0.length - 1)}
            }
        }
        return {name: s0, key: null}
    }

    function isTestUnary(t) {
        if (t == "-z" || t == "-n" || t == "-v") { return true }
        if (t == "-e" || t == "-f" || t == "-d" || t == "-s" || t == "-r" || t == "-w") { return true }
        if (t == "-x" || t == "-h" || t == "-L" || t == "-b" || t == "-c" || t == "-p") { return true }
        if (t == "-S" || t == "-t" || t == "-g" || t == "-u" || t == "-k" || t == "-O") { return true }
        return false
    }
    function isTestBinary(t) {
        if (t == "=" || t == "==" || t == "!=" || t == "<" || t == ">") { return true }
        if (t == "-eq" || t == "-ne" || t == "-lt" || t == "-le" || t == "-gt" || t == "-ge") { return true }
        if (t == "-nt" || t == "-ot" || t == "-ef") { return true }
        return false
    }
    function isEmptyStr(b, v) { return b.NewICmp(llvm.enum.IPredEQ, b.NewCall(rtStrlen, v), zero) }
    function isNonEmptyStr(b, v) { return b.NewICmp(llvm.enum.IPredNE, b.NewCall(rtStrlen, v), zero) }
    function boolStatus(b, i1) { return b.NewSelect(i1, zero, one) }

    function testUnaryIR(b, op, arg) {
        if (op == "-z") { return boolStatus(b, isEmptyStr(b, arg.v)) }
        if (op == "-n") { return boolStatus(b, isNonEmptyStr(b, arg.v)) }
        if (op == "-v") {
            if (arg.c == undefined) { fail("test -v needs a literal variable name in this compiler") }
            var sv = splitSubscript(arg.c)
            if (sv.key != null) {
                var kk2 = sv.key
                if (!hasOwn(assocArrays, "$" + sv.name)) { kk2 = numToStr(parseDec(kk2)) }
                return boolStatus(b, b.NewICmp(llvm.enum.IPredNE,
                    b.NewCall(rtArrHas, [gepStr(b, sv.name), gepStr(b, kk2)]), zero))
            }
            var setScalar = b.NewICmp(llvm.enum.IPredNE, loadVar(b, arg.c), unsetPtr(b))
            var setArray = b.NewICmp(llvm.enum.IPredSGT, b.NewCall(rtArrCount, gepStr(b, arg.c)), zero)
            return boolStatus(b, b.NewOr(setScalar, setArray))
        }
        var k = b.NewCall(rtFskind, arg.v)
        if (op == "-d") { return boolStatus(b, b.NewICmp(llvm.enum.IPredEQ, k, llvm.constant.NewInt(i32, 2))) }
        if (op == "-e" || op == "-r" || op == "-w") { return boolStatus(b, b.NewICmp(llvm.enum.IPredNE, k, zero)) }
        if (op == "-f" || op == "-s" || op == "-c" || op == "-b") { return boolStatus(b, b.NewICmp(llvm.enum.IPredEQ, k, one)) }
        return one
    }
    function testBinaryIR(b, l, op, r) {
        if (op == "=" || op == "==") { return boolStatus(b, b.NewICmp(llvm.enum.IPredNE, b.NewCall(rtStreq, [l.v, r.v]), zero)) }
        if (op == "!=") { return boolStatus(b, b.NewICmp(llvm.enum.IPredEQ, b.NewCall(rtStreq, [l.v, r.v]), zero)) }
        if (op == "<") { return boolStatus(b, b.NewICmp(llvm.enum.IPredSLT, b.NewCall(rtStrcmp, [l.v, r.v]), zero)) }
        if (op == ">") { return boolStatus(b, b.NewICmp(llvm.enum.IPredSGT, b.NewCall(rtStrcmp, [l.v, r.v]), zero)) }
        var il = b.NewCall(rtStr2int, l.v), ir = b.NewCall(rtStr2int, r.v)
        if (op == "-eq") { return boolStatus(b, b.NewICmp(llvm.enum.IPredEQ, il, ir)) }
        if (op == "-ne") { return boolStatus(b, b.NewICmp(llvm.enum.IPredNE, il, ir)) }
        if (op == "-lt") { return boolStatus(b, b.NewICmp(llvm.enum.IPredSLT, il, ir)) }
        if (op == "-le") { return boolStatus(b, b.NewICmp(llvm.enum.IPredSLE, il, ir)) }
        if (op == "-gt") { return boolStatus(b, b.NewICmp(llvm.enum.IPredSGT, il, ir)) }
        if (op == "-ge") { return boolStatus(b, b.NewICmp(llvm.enum.IPredSGE, il, ir)) }
        fail("unsupported binary test operator (must be a literal): " + op)
        return one
    }

    // The literal text of argument st.i, or a sentinel for "runtime value" / "past the end".
    function tcAt(a, st) {
        if (st.i >= a.length) { return "\x00end" }
        if (a[st.i].c == undefined) { return "\x00val" }
        return a[st.i].c
    }
    function tcPrim(b, a, st) {
        var t = tcAt(a, st)
        if (t == "(") {
            st.i = st.i + 1
            var r = tcOr(b, a, st)
            if (tcAt(a, st) == ")") { st.i = st.i + 1 }
            return r
        }
        if (t == "!") {
            st.i = st.i + 1
            return b.NewXor(tcPrim(b, a, st), one)
        }
        if (isTestUnary(t) && st.i + 1 < a.length && !isTestBinary(tcNext(a, st))) {
            var opnd = a[st.i + 1]
            st.i = st.i + 2
            return testUnaryIR(b, t, opnd)
        }
        var lhs = a[st.i]
        st.i = st.i + 1
        if (st.i + 1 < a.length && isTestBinary(tcAt(a, st))) {
            var op = tcAt(a, st)
            var rhs = a[st.i + 1]
            st.i = st.i + 2
            return testBinaryIR(b, lhs, op, rhs)
        }
        return boolStatus(b, isNonEmptyStr(b, lhs.v))
    }
    function tcNext(a, st) {
        if (st.i + 1 >= a.length) { return "\x00end" }
        if (a[st.i + 1].c == undefined) { return "\x00val" }
        return a[st.i + 1].c
    }
    function tcAnd(b, a, st) {
        var v = tcPrim(b, a, st)
        while (tcAt(a, st) == "-a") { st.i = st.i + 1; v = b.NewOr(v, tcPrim(b, a, st)) }
        return v
    }
    function tcOr(b, a, st) {
        var v = tcAnd(b, a, st)
        while (tcAt(a, st) == "-o") { st.i = st.i + 1; v = b.NewAnd(v, tcAnd(b, a, st)) }
        return v
    }

    function emitTest(b, cmd, args) {
        var a = args
        if (cmd == "[") {
            if (a.length == 0 || a[a.length - 1].c != "]") { fail("[ used without the closing ]") }
            a = a.slice(0, a.length - 1)
        }
        var bbox = {b: b}
        var vals = evalArgs(bbox, a)
        b = bbox.b
        if (vals.length == 0) { storeStatusI(b, 1); return b }
        if (vals.length == 1) {
            storeStatus(b, boolStatus(b, isNonEmptyStr(b, vals[0].v)))
            return b
        }
        var st = {i: 0}
        storeStatus(b, tcOr(b, vals, st))
        return b
    }

    // ---- pipelines, subshells, groups, (( )), [[ ]], redirections ----

    function makePipeline(items) {
        var bang = false
        var stages = []
        var i
        for (i = 0; i < items.length; i++) {
            var it = items[i]
            if (typeof it == "function") { stages.push(it) } else { bang = true }
        }
        if (!bang && stages.length == 1) { return stages[0] }
        return function(b) {
            var ff = b.NewAlloca(i32)
            b.NewStore(zero, ff)
            var psName = gepStr(b, "PIPESTATUS")
            b.NewCall(rtArrClear, psName)
            // a pipeline rebinds standard input for its stages only
            var savedIn = b.NewAlloca(i8ptr), savedInPos = b.NewAlloca(i32)
            b.NewStore(b.NewLoad(i8ptr, gStdin), savedIn)
            b.NewStore(b.NewLoad(i32, gStdinPos), savedInPos)
            var k
            for (k = 0; k < stages.length; k++) {
                var isLast = (k == stages.length - 1)
                if (!isLast) { b.NewCall(rtCapBegin, zero) }
                b = isLast ? stages[k](b) : emitCond(stages[k], b)
                if (!isLast) {
                    b.NewStore(b.NewCall(rtCapEnd, zero), gStdin)
                    b.NewStore(zero, gStdinPos)
                }
                var stv = b.NewLoad(i32, gStatus)
                b.NewCall(rtArrSet, [psName, gepStr(b, numToStr(k)), b.NewCall(rtInt2str, stv)])
                var fail0 = b.NewICmp(llvm.enum.IPredEQ, b.NewLoad(i32, ff), zero)
                var bad = b.NewAnd(fail0, b.NewICmp(llvm.enum.IPredNE, stv, zero))
                b.NewStore(b.NewSelect(bad, stv, b.NewLoad(i32, ff)), ff)
            }
            b.NewStore(b.NewLoad(i8ptr, savedIn), gStdin)
            b.NewStore(b.NewLoad(i32, savedInPos), gStdinPos)
            // set -o pipefail: the pipeline reports the first failing stage.
            var st0 = b.NewLoad(i32, gStatus)
            var usePf = b.NewAnd(b.NewICmp(llvm.enum.IPredNE, b.NewLoad(i32, gOptPf), zero),
                                 b.NewICmp(llvm.enum.IPredEQ, st0, zero))
            storeStatus(b, b.NewSelect(usePf, b.NewLoad(i32, ff), st0))
            if (bang) {
                storeStatus(b, b.NewSelect(b.NewICmp(llvm.enum.IPredEQ, b.NewLoad(i32, gStatus), zero), one, zero))
            }
            return b
        }
    }

    // ( LIST ) : the variable array is snapshotted and restored, and an `exit` inside branches
    // to the subshell's own end block instead of the enclosing function's.
    function makeSubshell(bodyT) {
        return function(b) {
            b.NewCall(rtSsSave, zero)
            var optSave = saveOpts(b)
            var savedExit = curExit
            var savedTraps = trapList
            trapList = []
            var subEnd = curF.NewBlock("")
            curExit = subEnd
            var eb = bodyT(b)
            eb.NewBr(subEnd)
            curExit = savedExit
            var myTraps = trapList
            trapList = savedTraps
            subEnd = emitTraps(subEnd, myTraps)
            var wasEx = subEnd.NewICmp(llvm.enum.IPredNE, subEnd.NewLoad(i32, gExited), zero)
            var st = subEnd.NewSelect(wasEx, subEnd.NewLoad(i32, gExitCode), subEnd.NewLoad(i32, gStatus))
            subEnd.NewStore(zero, gExited)
            subEnd.NewCall(rtSsRestore, zero)
            restoreOpts(subEnd, optSave)
            subEnd.NewStore(st, gStatus)
            return subEnd
        }
    }
    function makeGroup(bodyT) { return bodyT }

    function makeArithCmd(exprT) {
        return function(b) {
            var r = exprT(b)
            b = r.b
            storeStatus(b, b.NewSelect(b.NewICmp(llvm.enum.IPredNE, r.v, zero), zero, one))
            return b
        }
    }
    function makeLetCmd(items) {
        return function(b) {
            var v = zero
            var i
            for (i = 0; i < items.length; i++) { var r = items[i](b); b = r.b; v = r.v }
            storeStatus(b, b.NewSelect(b.NewICmp(llvm.enum.IPredNE, v, zero), zero, one))
            return b
        }
    }

    // [[ ... ]] : the condition thunks answer an i32 boolean (1 = true).
    function makeCondCmd(t) {
        return function(b) {
            b.NewStore(zero, gCondErr)
            var r = t(b)
            b = r.b
            // 0 true, 1 false, 2 the condition could not be evaluated (a bad =~ pattern).
            var err = b.NewICmp(llvm.enum.IPredNE, b.NewLoad(i32, gCondErr), zero)
            var tf = b.NewSelect(b.NewICmp(llvm.enum.IPredNE, r.v, zero), zero, one)
            storeStatus(b, b.NewSelect(err, llvm.constant.NewInt(i32, 2), tf))
            return b
        }
    }
    function foldCondOr(items) {
        if (items.length == 1) { return items[0] }
        return function(b) {
            var v = zero
            var i
            for (i = 0; i < items.length; i++) { var r = items[i](b); b = r.b; v = b.NewOr(v, r.v) }
            return {b: b, v: v}
        }
    }
    function foldCondAnd(items) {
        if (items.length == 1) { return items[0] }
        return function(b) {
            var v = one
            var i
            for (i = 0; i < items.length; i++) { var r = items[i](b); b = r.b; v = b.NewAnd(v, r.v) }
            return {b: b, v: v}
        }
    }
    function mkCondNot(t) {
        return function(b) { var r = t(b); return {b: r.b, v: r.b.NewXor(r.v, one)} }
    }
    function mkCondSingle(w) {
        return function(b) {
            var r = evalWord(b, w)
            return {b: r.b, v: r.b.NewZExt(isNonEmptyStr(r.b, r.v), i32)}
        }
    }
    function mkCondUn(items) {
        var op = items[0].cop
        var w = items[1]
        return function(b) {
            var r = evalWord(b, w)
            b = r.b
            var st = testUnaryIR(b, op, {v: r.v, c: w.c})
            return {b: b, v: b.NewZExt(b.NewICmp(llvm.enum.IPredEQ, st, zero), i32)}
        }
    }
    // A quoted part of a [[ ]] pattern is literal: escape its glob metacharacters.
    function mkQuotedPat(t) {
        return {c: undefined, fn: function(b) {
            var r = evalWord(b, t)
            return {b: r.b, v: r.b.NewCall(rtGlobEsc, r.v)}
        }}
    }
    function globEscape(s0) {
        var out = ""
        var i
        for (i = 0; i < s0.length; i++) {
            var ch = s0.charAt(i)
            if (ch == "*" || ch == "?" || ch == "[" || ch == "]" || ch == "\\") { out = out + "\\" }
            out = out + ch
        }
        return out
    }
    // [[ STR =~ ERE ]] : the match itself is one call; the work here is turning its answer
    // into BASH_REMATCH and into the three statuses bash distinguishes (0 match, 1 no match,
    // 2 the regex could not be used at all).
    var NCAPPAIRS = 64
    var capsTy = llvm.types.NewArray(NCAPPAIRS * 2, i32)
    function mkCondMatch(items) {
        var lw = items[0], rw = items[2]
        return function(b) {
            var rl = evalWord(b, lw); b = rl.b
            var rr = evalWord(b, rw); b = rr.b
            var subj = rl.v
            var caps = b.NewAlloca(capsTy)
            var capsPtr = b.NewGetElementPtr(capsTy, caps, zero, zero)
            var resP = b.NewAlloca(i32)
            var ip = b.NewAlloca(i32)
            b.NewStore(zero, resP)
            var nm = gepStr(b, "BASH_REMATCH")
            b.NewCall(rtArrClear, nm)
            // No flags: bash's =~ is a POSIX ERE where ^ and $ anchor the whole subject and
            // "." does not cross a newline, and nocasematch is off.
            var n = b.NewCall(rtRegexSearch, [rr.v, subj, llvm.constant.NewNull(i8ptr),
                                              capsPtr, llvm.constant.NewInt(i32, NCAPPAIRS * 2)])
            var errB = curF.NewBlock(""), okB = curF.NewBlock("")
            var badPat = curF.NewBlock(""), overrun = curF.NewBlock("")
            var matchB = curF.NewBlock(""), fillH = curF.NewBlock(""), fillB = curF.NewBlock("")
            var merge = curF.NewBlock("")
            b.NewCondBr(b.NewICmp(llvm.enum.IPredSLT, n, zero), errB, okB)

            // -1 / -2: status 2, a diagnostic on standard error, and the shell carries on.
            errB.NewStore(llvm.constant.NewInt(i32, 2), gCondErr)
            errB.NewCondBr(errB.NewICmp(llvm.enum.IPredEQ, n, llvm.constant.NewInt(i32, -1)), badPat, overrun)
            // rt_regex_error allocates per call, so it is called once, here.
            emitOnStderr(badPat, badPat.NewCall(rtStrcat,
                [gepStr(badPat, "bash: [[: invalid regular expression: "),
                 badPat.NewCall(rtStrcat, [badPat.NewCall(rtRegexError), gepStr(badPat, "\n")])]))
            badPat.NewBr(merge)
            emitOnStderr(overrun, gepStr(overrun, "bash: [[: regular expression step limit exceeded\n"))
            overrun.NewBr(merge)

            okB.NewCondBr(okB.NewICmp(llvm.enum.IPredEQ, n, zero), merge, matchB)
            matchB.NewStore(one, resP)
            matchB.NewStore(zero, ip)
            matchB.NewBr(fillH)
            // BASH_REMATCH[0] is the whole match, [i] the i-th group. The TRUE pair count is
            // reported even when it exceeds the caps array, so the entries past it are the
            // empty string rather than missing - ${#BASH_REMATCH[@]} stays exact.
            var i = fillH.NewLoad(i32, ip)
            fillH.NewCondBr(fillH.NewICmp(llvm.enum.IPredSLT, i, n), fillB, merge)
            var inRange = fillB.NewICmp(llvm.enum.IPredSLT, i, llvm.constant.NewInt(i32, NCAPPAIRS))
            var idx = fillB.NewSelect(inRange, i, zero)
            var two2 = llvm.constant.NewInt(i32, 2)
            var bgn = fillB.NewLoad(i32, fillB.NewGetElementPtr(capsTy, caps, zero, fillB.NewMul(idx, two2)))
            var end = fillB.NewLoad(i32, fillB.NewGetElementPtr(capsTy, caps, zero,
                        fillB.NewAdd(fillB.NewMul(idx, two2), one)))
            var have = fillB.NewAnd(inRange, fillB.NewICmp(llvm.enum.IPredSGE, bgn, zero))
            var piece = fillB.NewCall(rtSubstr, [subj, bgn, fillB.NewSub(end, bgn)])
            fillB.NewCall(rtArrSet, [nm, fillB.NewCall(rtInt2str, i),
                                     fillB.NewSelect(have, piece, emptyPtr(fillB))])
            fillB.NewStore(fillB.NewAdd(i, one), ip)
            fillB.NewBr(fillH)

            return {b: merge, v: merge.NewLoad(i32, resP)}
        }
    }
    // Write a diagnostic on the standard error CHANNEL (whose text is dropped, like every
    // other stderr write here) without disturbing the caller's redirections.
    function emitOnStderr(b, msg) {
        var saved = b.NewLoad(i32, gSinkOut)
        b.NewStore(b.NewLoad(i32, gSinkErr), gSinkOut)
        b.NewCall(rtPrints, msg)
        b.NewStore(saved, gSinkOut)
    }

    function mkCondBin(items) {
        var lw = items[0], op = items[1].cop, rw = items[2]
        return function(b) {
            var rl = evalWord(b, lw); b = rl.b
            var rr = evalWord(b, rw); b = rr.b
            // == and != glob-match their right hand side inside [[ ]]; = is a synonym of ==.
            if (op == "==" || op == "=") { return {b: b, v: b.NewCall(rtGlob, [rr.v, rl.v])} }
            if (op == "!=") { return {b: b, v: b.NewXor(b.NewCall(rtGlob, [rr.v, rl.v]), one)} }
            if (op == "=~") { fail("[[ =~ ]] (regex matching) is not supported") }
            var st = testBinaryIR(b, {v: rl.v, c: lw.c}, op, {v: rr.v, c: rw.c})
            return {b: b, v: b.NewZExt(b.NewICmp(llvm.enum.IPredEQ, st, zero), i32)}
        }
    }

    function mkRedir(items) {
        var op = "", fd = "", t = null
        var i
        for (i = 0; i < items.length; i++) {
            var it = items[i]
            if (it.fn != undefined) { t = it }
            else if (it.redir != undefined) { op = it.redir }
            else if (it.iofd != undefined) { fd = it.iofd }
        }
        return {rd: op, iofd: fd, target: t}
    }
    // eval / trap re-parse a string with THIS grammar, starting at CompoundList (which pushes
    // one statement-sequence thunk); the thunk that comes back is emitted inline.
    function compileSnippet(src) {
        var frag = c.parseFrom(c.agrammar, src, "CompoundList")
        return c.compile(frag).stack[0]
    }

    // printf FORMAT [ARG...] : the format is a compile-time literal, so it is parsed here and
    // the passes over the argument list are unrolled. The result is built with rt_strcat and
    // then printed, or stored when -v NAME was given.
    function emitPrintf(b, args) {
        var a = args
        var dest = null
        if (a.length >= 2 && a[0].c == "-v") { dest = a[1].c; a = a.slice(2) }
        if (a.length == 0) { storeStatusI(b, 0); return b }
        if (a[0].c == undefined) { fail("printf needs a literal format string in this compiler") }
        var fmt = a[0].c
        var rest = a.slice(1)
        var vals = []
        var i
        for (i = 0; i < rest.length; i++) { var rv = evalWord(b, rest[i]); b = rv.b; vals.push(rv.v) }
        var out = emptyPtr(b)
        var ai = 0
        var pass = 0
        while (pass == 0 || ai < vals.length) {
            pass = pass + 1
            var used = false
            var lit = ""
            i = 0
            while (i < fmt.length) {
                var ch = fmt.charAt(i)
                if (ch == "\\" && i + 1 < fmt.length) {
                    var e = fmt.charAt(i + 1)
                    i = i + 2
                    if (e == "n") { lit = lit + "\n" }
                    else if (e == "t") { lit = lit + "\t" }
                    else if (e == "r") { lit = lit + "\r" }
                    else if (e == "\\") { lit = lit + "\\" }
                    else { lit = lit + "\\" + e }
                } else if (ch == "%") {
                    i = i + 1
                    if (fmt.charAt(i) == "%") { lit = lit + "%"; i = i + 1 }
                    else {
                        if (lit != "") { out = b.NewCall(rtStrcat, [out, gepStr(b, lit)]); lit = "" }
                        var left = 0, zpad = 0
                        var flagging = true
                        while (flagging && i < fmt.length) {
                            var fc = fmt.charAt(i)
                            if (fc == "-") { left = 1; i = i + 1 }
                            else if (fc == "0") { zpad = 1; i = i + 1 }
                            else if (fc == "+" || fc == " " || fc == "#") { i = i + 1 }
                            else { flagging = false }
                        }
                        var width = 0
                        while (i < fmt.length && fmt.charCodeAt(i) >= 48 && fmt.charCodeAt(i) <= 57) {
                            width = width * 10 + (fmt.charCodeAt(i) - 48)
                            i = i + 1
                        }
                        if (fmt.charAt(i) == ".") {
                            i = i + 1
                            while (i < fmt.length && fmt.charCodeAt(i) >= 48 && fmt.charCodeAt(i) <= 57) { i = i + 1 }
                        }
                        var conv = fmt.charAt(i)
                        i = i + 1
                        var av = (ai < vals.length) ? vals[ai] : emptyPtr(b)
                        ai = ai + 1
                        used = true
                        var piece = av
                        if (conv == "d" || conv == "i") { piece = b.NewCall(rtInt2str, b.NewCall(rtStr2int, av)) }
                        else if (conv == "c") { piece = b.NewCall(rtSubstr, [av, zero, one]) }
                        if (width > 0) {
                            piece = b.NewCall(rtPad, [piece, llvm.constant.NewInt(i32, width),
                                                      llvm.constant.NewInt(i32, left),
                                                      llvm.constant.NewInt(i32, zpad)])
                        }
                        out = b.NewCall(rtStrcat, [out, piece])
                    }
                } else { lit = lit + ch; i = i + 1 }
            }
            if (lit != "") { out = b.NewCall(rtStrcat, [out, gepStr(b, lit)]) }
            if (!used) { ai = vals.length }
        }
        if (dest != null) { storeVar(b, dest, out) } else { b.NewCall(rtPrints, out) }
        storeStatusI(b, 0)
        return b
    }

    // read [-r] NAME... : one line of standard input, split on IFS, the last name taking the
    // rest. An empty IFS (IFS= read) means no splitting at all; an UNSET IFS is the default.
    function emitRead(b, args) {
        var names = []
        var arrName = null
        var i = 0
        while (i < args.length) {
            var a = args[i].c
            if (a == undefined) { fail("read needs literal variable names in this compiler") }
            if (a == "-a") { i = i + 1; if (i < args.length) { arrName = args[i].c }; i = i + 1; continue }
            if (a == "-d" || a == "-n" || a == "-N" || a == "-p" || a == "-t" || a == "-u") { i = i + 1 }
            else if (a.length > 1 && a.charAt(0) == "-") { }
            else { names.push(a) }
            i = i + 1
        }
        if (arrName == null && names.length == 0) { names.push("REPLY") }
        var line = b.NewCall(rtReadLine, zero)
        var eof = b.NewICmp(llvm.enum.IPredNE, b.NewLoad(i32, gReadEof), zero)
        var eofB = curF.NewBlock(""), okB = curF.NewBlock(""), merge = curF.NewBlock("")
        b.NewCondBr(eof, eofB, okB)
        var k
        for (k = 0; k < names.length; k++) { storeVar(eofB, names[k], emptyPtr(eofB)) }
        if (arrName != null) { eofB.NewCall(rtArrClear, gepStr(eofB, arrName)) }
        eofB.NewStore(one, gStatus)
        eofB.NewBr(merge)
        var ifsRaw = loadVar(okB, "IFS")
        var ifs = okB.NewSelect(okB.NewICmp(llvm.enum.IPredEQ, ifsRaw, unsetPtr(okB)), gepStr(okB, " \t\n"), ifsRaw)
        if (arrName != null) {
            okB.NewCall(rtArrClear, gepStr(okB, arrName))
            okB.NewCall(rtArrAppend, [gepStr(okB, arrName), okB.NewCall(rtSplitIfs, [line, ifs])])
        }
        for (k = 0; k < names.length; k++) {
            var isLast = (k == names.length - 1) ? 1 : 0
            storeVar(okB, names[k], okB.NewCall(rtField, [line, ifs, llvm.constant.NewInt(i32, k),
                                                          llvm.constant.NewInt(i32, isLast)]))
        }
        okB.NewStore(zero, gStatus)
        okB.NewBr(merge)
        return merge
    }

    // set [-e|+e] [-u|+u] [-o pipefail|+o pipefail]: the flags are runtime globals, so
    // set +e later in the program really does turn errexit back off.
    function emitSet(b, args) {
        var i = 0
        while (i < args.length) {
            if (i >= args.length) { i = args.length }
            var a = args[i].c
            if (a == undefined) { fail("set needs literal option words in this compiler") }
            if (a == "-o" || a == "+o") {
                var on = (a == "-o") ? one : zero
                if (i + 1 < args.length) {
                    var nm = args[i + 1].c
                    if (nm == "pipefail") { b.NewStore(on, gOptPf) }
                    if (nm == "errexit") { b.NewStore(on, gOptE) }
                    if (nm == "nounset") { b.NewStore(on, gOptU) }
                    i = i + 1
                }
            } else if (a == "--") {
                // Rebind the positional parameters: push the remaining words as a new frame.
                var base = b.NewLoad(i32, gArgvTop)
                var j
                for (j = i + 1; j < args.length; j++) {
                    var ra = args[j].fn(b)
                    b = ra.b
                    b.NewCall(rtArgPush, ra.v)
                }
                b.NewStore(base, gFrameBase)
                b.NewStore(b.NewSub(b.NewLoad(i32, gArgvTop), base), gFrameN)
                i = args.length
            } else if (a.length > 1 && (a.charAt(0) == "-" || a.charAt(0) == "+")) {
                var on2 = (a.charAt(0) == "-") ? one : zero
                var k
                for (k = 1; k < a.length; k++) {
                    var f = a.charAt(k)
                    if (f == "e") { b.NewStore(on2, gOptE) }
                    if (f == "u") { b.NewStore(on2, gOptU) }
                }
            }
            i = i + 1
        }
        storeStatusI(b, 0)
        return b
    }

    // The abort a set -u expansion raised: end the (sub)shell before running the command.
    function emitAbortCheck(b) {
        var isAb = b.NewICmp(llvm.enum.IPredNE, b.NewLoad(i32, gAbort), zero)
        var kill = curF.NewBlock(""), cont = curF.NewBlock("")
        b.NewCondBr(isAb, kill, cont)
        kill.NewStore(zero, gAbort)
        kill.NewStore(one, gExitCode)
        kill.NewStore(one, gExited)
        kill.NewBr(curExit)
        return cont
    }
    // set -e: leave on a failing command, unless it is running as a condition.
    function emitErrExitCheck(b) {
        if (condDepth > 0) { return b }
        var st = b.NewLoad(i32, gStatus)
        var bad = b.NewAnd(b.NewICmp(llvm.enum.IPredNE, b.NewLoad(i32, gOptE), zero),
                           b.NewICmp(llvm.enum.IPredNE, st, zero))
        var kill = curF.NewBlock(""), cont = curF.NewBlock("")
        b.NewCondBr(bad, kill, cont)
        kill.NewStore(st, gExitCode)
        kill.NewStore(one, gExited)
        kill.NewBr(curExit)
        return cont
    }
    // Emit a thunk as a CONDITION.
    function emitCond(t, b) {
        condDepth = condDepth + 1
        var nb = t(b)
        condDepth = condDepth - 1
        return nb
    }
    // A subshell must restore the shell OPTIONS as well as the variables (set -e inside
    // $( ) does not leak out), so they are stashed in allocas around the body.
    function saveOpts(b) {
        var se = b.NewAlloca(i32), su = b.NewAlloca(i32), sp = b.NewAlloca(i32)
        b.NewStore(b.NewLoad(i32, gOptE), se)
        b.NewStore(b.NewLoad(i32, gOptU), su)
        b.NewStore(b.NewLoad(i32, gOptPf), sp)
        return {e: se, u: su, pf: sp}
    }
    function restoreOpts(b, sv) {
        b.NewStore(b.NewLoad(i32, sv.e), gOptE)
        b.NewStore(b.NewLoad(i32, sv.u), gOptU)
        b.NewStore(b.NewLoad(i32, sv.pf), gOptPf)
    }

    // Emit the EXIT traps a (sub)shell registered, each behind its own flag.
    function emitTraps(b, list) {
        var i
        for (i = 0; i < list.length; i++) {
            var tr = list[i]
            var run = curF.NewBlock(""), skip = curF.NewBlock("")
            b.NewCondBr(b.NewICmp(llvm.enum.IPredNE, b.NewLoad(i32, tr.flag), zero), run, skip)
            run.NewStore(zero, tr.flag)
            var rb = tr.body(run)
            rb.NewBr(skip)
            b = skip
        }
        return b
    }

    // words[0] is the command word (must be a literal here), the rest are arguments.
    function makeSimpleCommand(items0) {
        var cmdT = items0[0]
        var argTs = []
        var redirs = []
        var ri
        for (ri = 1; ri < items0.length; ri++) {
            var it0 = items0[ri]
            if (it0.rd != undefined) { redirs.push(it0) } else { argTs.push(it0) }
        }
        var inner = function(b) {
            b = emitAbortCheck(b)
            var cmd = cmdT.c
            if (cmd == undefined) { fail("a computed command name is not supported by this compiler") }
            if (cmd == "echo") { return emitEcho(b, argTs) }
            if (cmd == "[" || cmd == "test") { return emitTest(b, cmd, argTs) }
            if (cmd == "true" || cmd == ":") { storeStatusI(b, 0); return b }
            if (cmd == "false") { storeStatusI(b, 1); return b }
            if (cmd == "exit") {
                var code = zero
                if (argTs.length > 0) { var r = evalWord(b, argTs[0]); b = r.b; code = b.NewCall(rtStr2int, r.v) } else { code = b.NewLoad(i32, gStatus) }
                b.NewStore(code, gExitCode)
                b.NewStore(one, gExited)
                b.NewBr(curExit)
                return deadBlock()
            }
            if (cmd == "return") {
                var rv = null
                if (argTs.length > 0) { var r2 = evalWord(b, argTs[0]); b = r2.b; rv = b.NewCall(rtStr2int, r2.v) } else { rv = b.NewLoad(i32, gStatus) }
                if (curFrame != null) { emitFnRet(b, rv); return deadBlock() }
                storeStatus(b, rv); return b
            }
            // break / continue are real branches here: the loop being emitted knows both of
            // its target blocks, so no control signal has to travel through the runtime.
            if (cmd == "break" || cmd == "continue") {
                var n = 1
                if (argTs.length > 0) {
                    if (argTs[0].c == undefined) { fail(cmd + " needs a literal level in this compiler") }
                    n = parseDec(argTs[0].c)
                }
                if (n < 1) { n = 1 }
                if (loopStack.length < n) { fail(cmd + " used outside a loop") }
                var lp = loopStack[loopStack.length - n]
                b.NewBr((cmd == "break") ? lp.brk : lp.cont)
                return deadBlock()
            }
            if (cmd == "printf") { return emitPrintf(b, argTs) }
            if (cmd == "set") { return emitSet(b, argTs) }
            if (cmd == "trap") {
                if (argTs.length == 0 || argTs[0].c == undefined) {
                    fail("trap needs a literal handler in this compiler")
                }
                var src = argTs[0].c
                if (src != "" && src != "-") {
                    var flag = m.NewGlobalDef("trap_flag" + trapCount, zero)
                    trapCount = trapCount + 1
                    trapList.push({flag: flag, body: compileSnippet(src)})
                    b.NewStore(one, flag)
                }
                storeStatusI(b, 0)
                return b
            }
            if (cmd == "eval") {
                var esrc = ""
                var ei
                var allConst = true
                for (ei = 0; ei < argTs.length; ei++) {
                    if (argTs[ei].c == undefined) { allConst = false }
                    else { if (ei > 0) { esrc = esrc + " " }; esrc = esrc + argTs[ei].c }
                }
                if (allConst) {
                    if (esrc == "") { storeStatusI(b, 0); return b }
                    return compileSnippet(esrc)(b)
                }
                // A COMPUTED eval cannot be compiled in general. The one shape a compiler can
                // still honour is the assignment `eval "NAME=VALUE"`, which becomes a runtime
                // name -> slot dispatch over the variable names the program mentions.
                var acc = emptyPtr(b)
                for (ei = 0; ei < argTs.length; ei++) {
                    var re2 = evalWord(b, argTs[ei])
                    b = re2.b
                    if (ei > 0) { acc = b.NewCall(rtStrcat, [acc, gepStr(b, " ")]) }
                    acc = b.NewCall(rtStrcat, [acc, re2.v])
                }
                b.NewCall(rtEvalAssign, acc)
                storeStatusI(b, 0)
                return b
            }
            if (cmd == "read") { return emitRead(b, argTs) }
            if (cmd == "shift") {
                var sn = one
                if (argTs.length > 0) {
                    var rs2 = evalWord(b, argTs[0])
                    b = rs2.b
                    sn = b.NewCall(rtStr2int, rs2.v)
                }
                b.NewStore(b.NewAdd(b.NewLoad(i32, gFrameBase), sn), gFrameBase)
                b.NewStore(b.NewSub(b.NewLoad(i32, gFrameN), sn), gFrameN)
                storeStatusI(b, 0)
                return b
            }
            if (cmd == "unset") {
                var uk
                for (uk = 0; uk < argTs.length; uk++) {
                    if (argTs[uk].c == undefined) { fail("unset needs a literal name in this compiler") }
                    var sp0 = splitSubscript(argTs[uk].c)
                    if (sp0.key == null) {
                        storeVar(b, sp0.name, unsetPtr(b))
                        b.NewCall(rtArrClear, gepStr(b, sp0.name))
                    } else {
                        var kk = sp0.key
                        if (!hasOwn(assocArrays, "$" + sp0.name)) { kk = numToStr(parseDec(kk)) }
                        b.NewCall(rtArrDel, [gepStr(b, sp0.name), gepStr(b, kk)])
                    }
                }
                storeStatusI(b, 0)
                return b
            }
            var f = funcFor(cmd)
            if (f != null) {
                // Push every ARGUMENT FIELD, then make them this call's frame. The stack top,
                // base and count are all restored afterwards, so recursion nests correctly.
                var savedTop = b.NewAlloca(i32)
                var savedBase = b.NewAlloca(i32)
                var savedN = b.NewAlloca(i32)
                b.NewStore(b.NewLoad(i32, gArgvTop), savedTop)
                b.NewStore(b.NewLoad(i32, gFrameBase), savedBase)
                b.NewStore(b.NewLoad(i32, gFrameN), savedN)
                var i
                for (i = 0; i < argTs.length; i++) {
                    var ra = argTs[i].fn(b)
                    b = ra.b
                    b.NewCall(rtArgPush, ra.v)
                }
                var base = b.NewLoad(i32, savedTop)
                b.NewStore(base, gFrameBase)
                b.NewStore(b.NewSub(b.NewLoad(i32, gArgvTop), base), gFrameN)
                storeStatus(b, b.NewCall(f))
                b.NewStore(b.NewLoad(i32, savedBase), gFrameBase)
                b.NewStore(b.NewLoad(i32, savedN), gFrameN)
                b.NewStore(b.NewLoad(i32, savedTop), gArgvTop)
                return emitExitCheck(b)
            }
            var bbox2 = {b: b}
            evalArgs(bbox2, argTs)
            b = bbox2.b
            b.NewCall(rtPrints, gepStr(b, "bash-to-llvm-ir: command not found: " + cmd + "\n"))
            b.NewStore(llvm.constant.NewInt(i32, 127), gExitCode)
            b.NewStore(one, gExited)
            b.NewBr(curExit)
            return deadBlock()
        }
        if (redirs.length == 0) { return inner }
        return function(b) {
            var sv = emitOpenRedirs(b, redirs)
            b = sv.b
            b = inner(b)
            emitCloseRedirs(b, sv)
            return b
        }
    }

    // cmd1 && cmd2 || cmd3 : run left to right, short circuit on the running $?.
    function makeAndOr(items) {
        if (items.length == 1) { return items[0] }
        return function(b) {
            b = emitCond(items[0], b)
            var i
            for (i = 1; i < items.length; i += 2) {
                var op = items[i].op
                var runB = curF.NewBlock(""), merge = curF.NewBlock("")
                var isZero = b.NewICmp(llvm.enum.IPredEQ, b.NewLoad(i32, gStatus), zero)
                if (op == "&&") { b.NewCondBr(isZero, runB, merge) } else { b.NewCondBr(isZero, merge, runB) }
                var isLast = (i + 2 >= items.length)
                var rb = isLast ? items[i + 1](runB) : emitCond(items[i + 1], runB)
                rb.NewBr(merge)
                b = merge
            }
            return b
        }
    }

    function makeSeq(thunks) {
        return function(b) {
            var i
            for (i = 0; i < thunks.length; i++) {
                b = thunks[i](b)
                b = emitErrExitCheck(b)
            }
            return b
        }
    }

    // items = [{pats}, bodyThunk, {cterm}?]
    function mkCaseClause(items) {
        var pats = []
        var body = null
        var term = ";;"
        var i
        for (i = 0; i < items.length; i++) {
            var it = items[i]
            if (typeof it == "function") { body = it }
            else if (it.pats != undefined) { pats = it.pats }
            else if (it.cterm != undefined) { term = it.cterm }
        }
        return {pats: pats, body: body, cterm: term}
    }
    // items = [subjectWordObj, clause...]. One clause = one pattern test and one body block;
    // ";;&" branches on to the NEXT clause after its body instead of to the merge block.
    function makeCase(items) {
        var subjT = items[0]
        var clauses = items.slice(1)
        return function(b) {
            var r0 = evalWord(b, subjT)
            b = r0.b
            var subj = r0.v
            var merge = curF.NewBlock("")
            var i
            for (i = 0; i < clauses.length; i++) {
                var cl = clauses[i]
                var hit = zero
                var k
                for (k = 0; k < cl.pats.length; k++) {
                    var rp = evalWord(b, cl.pats[k])
                    b = rp.b
                    hit = b.NewOr(hit, b.NewCall(rtGlob, [rp.v, subj]))
                }
                var thenB = curF.NewBlock(""), nextB = curF.NewBlock("")
                b.NewCondBr(b.NewICmp(llvm.enum.IPredNE, hit, zero), thenB, nextB)
                var tb = cl.body(thenB)
                if (cl.cterm == ";;&") { tb.NewBr(nextB) } else { tb.NewBr(merge) }
                b = nextB
            }
            b.NewBr(merge)
            return merge
        }
    }

    // <<DELIM / <<-DELIM / <<'DELIM' : split the scanned token back into marker and body.
    function mkHereDoc(text) {
        var i = 2
        var dashed = false
        if (text.charAt(i) == "-") { dashed = true; i = i + 1 }
        while (text.charAt(i) == " " || text.charAt(i) == "\t") { i = i + 1 }
        var quote = ""
        var q = text.charAt(i)
        if (q == "'" || q == "\"") { quote = q; i = i + 1 }
        var firstNL = -1
        var lastNL = -1
        var k
        for (k = 0; k < text.length; k++) {
            var ch = text.charAt(k)
            if (ch == "\n") { if (firstNL < 0) { firstNL = k }; lastNL = k }
        }
        var body = ""
        if (firstNL >= 0 && lastNL > firstNL) { body = text.slice(firstNL + 1, lastNL + 1) }
        if (dashed) { body = stripLeadingTabs(body) }
        var t = (quote != "") ? makeConst(body) : compileHereBody(body)
        return {rd: "<<", iofd: "", target: t}
    }
    function stripLeadingTabs(b) {
        var out = ""
        var atLineStart = true
        var i
        for (i = 0; i < b.length; i++) {
            var ch = b.charAt(i)
            if (atLineStart && ch == "\t") { continue }
            atLineStart = (ch == "\n")
            out = out + ch
        }
        return out
    }
    function compileHereBody(body) {
        var frag = c.parseFrom(c.agrammar, "\x01" + body, "HereBodyW")
        return c.compile(frag).stack[0]
    }

    // A compound statement plus its redirections; items = [bodyThunk, redir...]
    function mkRedirected(items) {
        var bodyT = items[0]
        var redirs = []
        var i
        for (i = 1; i < items.length; i++) { redirs.push(items[i]) }
        if (redirs.length == 0) { return bodyT }
        return function(b) {
            var sv = emitOpenRedirs(b, redirs)
            b = sv.b
            b = bodyT(b)
            emitCloseRedirs(b, sv)
            return b
        }
    }

    // Apply a redirection list by rerouting the two output channels and the stdin buffer.
    function emitOpenRedirs(b, redirs) {
        var so = b.NewAlloca(i32), se = b.NewAlloca(i32)
        var sb = b.NewAlloca(i8ptr), sp = b.NewAlloca(i32)
        b.NewStore(b.NewLoad(i32, gSinkOut), so)
        b.NewStore(b.NewLoad(i32, gSinkErr), se)
        b.NewStore(b.NewLoad(i8ptr, gStdin), sb)
        b.NewStore(b.NewLoad(i32, gStdinPos), sp)
        var i
        for (i = 0; i < redirs.length; i++) {
            var r = redirs[i]
            var tgt = null
            if (r.target != null) { var rr = evalWord(b, r.target); b = rr.b; tgt = rr }
            var fd = (r.iofd == "") ? "1" : r.iofd
            if (r.rd == "<<") { b.NewStore(tgt.v, gStdin); b.NewStore(zero, gStdinPos) }
            else if (r.rd == "<<<") {
                b.NewStore(b.NewCall(rtStrcat, [tgt.v, gepStr(b, "\n")]), gStdin)
                b.NewStore(zero, gStdinPos)
            }
            else if (r.rd == "<") { b.NewStore(emptyPtr(b), gStdin); b.NewStore(zero, gStdinPos) }
            else if (r.rd == ">&" || r.rd == "<&") {
                var src = (r.target != null && r.target.c == "2") ? b.NewLoad(i32, gSinkErr) : b.NewLoad(i32, gSinkOut)
                if (fd == "2") { b.NewStore(src, gSinkErr) } else { b.NewStore(src, gSinkOut) }
            }
            else if (r.rd == "&>" || r.rd == "&>>") {
                var ch = llvm.constant.NewInt(i32, (r.target != null && r.target.c == "/dev/stdout") ? 0 : 2)
                b.NewStore(ch, gSinkOut)
                b.NewStore(ch, gSinkErr)
            }
            else {
                var tc = (r.target != null) ? r.target.c : undefined
                var n = 2
                if (tc == "/dev/stdout") { n = 0 }
                if (tc == "/dev/stderr") { n = 1 }
                var ch2 = llvm.constant.NewInt(i32, n)
                if (fd == "2") { b.NewStore(ch2, gSinkErr) } else { b.NewStore(ch2, gSinkOut) }
            }
        }
        return {b: b, so: so, se: se, sb: sb, sp: sp}
    }
    function emitCloseRedirs(b, sv) {
        b.NewStore(b.NewLoad(i32, sv.so), gSinkOut)
        b.NewStore(b.NewLoad(i32, sv.se), gSinkErr)
        b.NewStore(b.NewLoad(i8ptr, sv.sb), gStdin)
        b.NewStore(b.NewLoad(i32, sv.sp), gStdinPos)
    }

    function mkPrefixAsg(items) {
        return {aname: items[0].aname, val: (items.length > 1) ? items[1] : null}
    }
    // NAME=VALUE... COMMAND : the assignments are undone after the command, which the local
    // save stack already does exactly right.
    function makePrefixCmd(items) {
        var asgs = []
        var rest = []
        var i
        for (i = 0; i < items.length; i++) {
            var it = items[i]
            if (it.fn == undefined && it.rd == undefined && it.aname != undefined) { asgs.push(it) }
            else { rest.push(it) }
        }
        var inner = makeSimpleCommand(rest)
        return function(b) {
            var depth = b.NewAlloca(i32)
            b.NewStore(b.NewLoad(i32, gLsTop), depth)
            var k
            for (k = 0; k < asgs.length; k++) {
                b.NewCall(rtPushLocal, llvm.constant.NewInt(i32, getVarId(asgs[k].aname)))
                var v = emptyPtr(b)
                if (asgs[k].val != null) { var r = evalWord(b, asgs[k].val); b = r.b; v = r.v }
                storeVar(b, asgs[k].aname, v)
            }
            b = inner(b)
            b.NewCall(rtPopLocals, b.NewLoad(i32, depth))
            return b
        }
    }

    function mkCond(items) { return {cond: items[0], body: items[1]} }
    function mkElse(bodyT) { return {els: bodyT} }

    // clauses = [{cond,body} (if), {cond,body} (elif)*, {els} (else)?].
    function makeIf(clauses) {
        return function(b) {
            var merge = curF.NewBlock("")
            var i
            for (i = 0; i < clauses.length; i++) {
                var cl = clauses[i]
                if (cl.els != undefined) {
                    b = cl.els(b)
                    b.NewBr(merge)
                    return merge
                }
                b = emitCond(cl.cond, b)
                var thenB = curF.NewBlock(""), nextB = curF.NewBlock("")
                b.NewCondBr(b.NewICmp(llvm.enum.IPredEQ, b.NewLoad(i32, gStatus), zero), thenB, nextB)
                var tb = cl.body(thenB)
                tb.NewBr(merge)
                b = nextB
            }
            storeStatusI(b, 0)
            b.NewBr(merge)
            return merge
        }
    }

    // items = [condThunk, bodyThunk].
    function makeWhile(items) {
        var condT = items[0], bodyT = items[1]
        return function(b) {
            var head = curF.NewBlock(""), body = curF.NewBlock(""), exit = curF.NewBlock("")
            b.NewBr(head)
            var hb = emitCond(condT, head)
            hb.NewCondBr(hb.NewICmp(llvm.enum.IPredEQ, hb.NewLoad(i32, gStatus), zero), body, exit)
            loopStack.push({brk: exit, cont: head})
            var bb = bodyT(body)
            loopStack.pop()
            bb.NewBr(head)
            return exit
        }
    }

    function makeUntil(items) {
        var condT = items[0], bodyT = items[1]
        return function(b) {
            var head = curF.NewBlock(""), body = curF.NewBlock(""), ex = curF.NewBlock("")
            b.NewBr(head)
            var hb = emitCond(condT, head)
            hb.NewCondBr(hb.NewICmp(llvm.enum.IPredEQ, hb.NewLoad(i32, gStatus), zero), ex, body)
            loopStack.push({brk: ex, cont: head})
            var bb = bodyT(body)
            loopStack.pop()
            bb.NewBr(head)
            return ex
        }
    }
    // items = [initExpr, condExpr, stepExpr, bodyThunk]
    function makeCFor(items) {
        var initT = items[0], condT = items[1], stepT = items[2], bodyT = items[3]
        return function(b) {
            var r0 = initT(b)
            b = r0.b
            var head = curF.NewBlock(""), body = curF.NewBlock(""), step = curF.NewBlock(""), ex = curF.NewBlock("")
            b.NewBr(head)
            var rc = condT(head)
            rc.b.NewCondBr(rc.b.NewICmp(llvm.enum.IPredNE, rc.v, zero), body, ex)
            loopStack.push({brk: ex, cont: step})
            var bb = bodyT(body)
            loopStack.pop()
            bb.NewBr(step)
            var rs = stepT(step)
            rs.b.NewBr(head)
            return ex
        }
    }

    // items = [{fname}, {words:[wordObjs]}, bodyThunk]. The word list is static -> unrolled.
    function makeFor(items) {
        var fname = "", wordThunks = null, bodyT = null
        var i
        for (i = 0; i < items.length; i++) {
            var it = items[i]
            if (typeof it == "function") { bodyT = it }
            else if (it.words != undefined) { wordThunks = it.words }
            else if (it.fname != undefined) { fname = it.fname }
        }
        return function(b) {
            // Build the whole word list as ONE field list at run time, then walk it: the
            // words can each expand to any number of fields ("${a[@]}", "$@", an unquoted
            // expansion), so the iteration count is not known while emitting.
            var listP = b.NewAlloca(i8ptr)
            if (wordThunks == null) {
                b.NewStore(b.NewCall(rtParams, [gepStr(b, " "), zero]), listP)
            } else {
                b.NewStore(gepStr(b, "\x02"), listP)
                var k
                for (k = 0; k < wordThunks.length; k++) {
                    var r = wordThunks[k].fn(b)
                    b = r.b
                    b.NewStore(b.NewCall(rtCatFields, [b.NewLoad(i8ptr, listP), r.v]), listP)
                }
            }
            var ip = b.NewAlloca(i32)
            b.NewStore(zero, ip)
            var head = curF.NewBlock(""), body = curF.NewBlock("")
            var step = curF.NewBlock(""), ex = curF.NewBlock("")
            b.NewBr(head)
            var list = head.NewLoad(i8ptr, listP)
            var i = head.NewLoad(i32, ip)
            head.NewCondBr(head.NewICmp(llvm.enum.IPredSLT, i, head.NewCall(rtNFields, list)), body, ex)
            storeVar(body, fname, body.NewCall(rtGetField, [list, i]))
            loopStack.push({brk: ex, cont: step})
            var bb = bodyT(body)
            loopStack.pop()
            bb.NewBr(step)
            step.NewStore(step.NewAdd(i, one), ip)
            step.NewBr(head)
            return ex
        }
    }

    // items = [{fname}, bodyThunk]. Emits bashfn_NAME immediately (so recursion resolves).
    function makeFuncDef(items) {
        var fname = items[0].fname
        var bodyT = items[1]
        declaredFuncs["$" + fname] = true
        return function(b) {
            var i
            var key = "$" + fname
            var f = null
            if (hasOwn(funcs, key) && !hasOwn(definedFuncs, key)) {
                f = funcs[key]              // a forward declaration made by an earlier call
            } else {
                var suffix = hasOwn(funcs, key) ? ("_" + fnCount) : ""
                fnCount = fnCount + 1
                f = m.NewFunc("bashfn_" + fname + suffix, i32)
                funcs[key] = f
            }
            definedFuncs[key] = true
            var savedF = curF, savedExit = curExit, savedFrame = curFrame
            curF = f
            var entry = f.NewBlock("entry")
            curExit = f.NewBlock("exit")
            // The local-save-stack depth at entry: every ret unwinds back to it.
            var dslot = entry.NewAlloca(i32)
            entry.NewStore(entry.NewLoad(i32, gLsTop), dslot)
            curFrame = {depth: dslot}
            // $FUNCNAME: a local of the call, so the save stack restores it on return.
            entry.NewCall(rtPushLocal, llvm.constant.NewInt(i32, getVarId("FUNCNAME")))
            storeVar(entry, "FUNCNAME", gepStr(entry, fname))
            emitFnRet(curExit, curExit.NewLoad(i32, gStatus))
            var endb = bodyT(entry)
            emitFnRet(endb, endb.NewLoad(i32, gStatus))
            curF = savedF; curExit = savedExit; curFrame = savedFrame
            storeStatusI(b, 0)
            return b
        }
    }

    // ===================================================================================
    //  Program: build main(), run the top-level statements, finish.
    // ===================================================================================

    function runProgram(stmts) {
        var main = m.NewFunc("main", i32)
        curF = main
        var entry = main.NewBlock("entry")
        var body = main.NewBlock("body")
        curExit = main.NewBlock("exit")
        // An explicit `exit N` still runs the EXIT trap on its way out.
        var mainExit = curExit
        curFrame = null
        // Emit the whole program into `body`; getVarId fills varIdList as a side effect.
        var b = body
        var i
        for (i = 0; i < stmts.length; i++) { b = stmts[i](b); b = emitErrExitCheck(b) }
        var progTraps = trapList
        b = emitTraps(b, progTraps)
        b.NewRet(b.NewLoad(i32, gStatus)) // normal completion -> exit code is $?
        // ... and so does an explicit `exit N`, which lands in main's exit block.
        var xb = emitTraps(mainExit, progTraps)
        xb.NewRet(xb.NewLoad(i32, gExitCode))
        // Now that every variable slot is known, mark them all unset in entry (a raw null
        // would trap on the first load, so the marker is a real pointer to a NUL byte).
        var up0 = unsetPtr(entry)
        for (i = 0; i < varIdList.length; i++) {
            entry.NewStore(up0, entry.NewGetElementPtr(gvarsTy, gVars, zero, llvm.constant.NewInt(i32, i)))
        }
        // There is no process environment behind a compiled run, so the few variables a script
        // may reasonably expect to exist get a fixed, documented default.
        storeVar(entry, "HOME", gepStr(entry, "/home/user"))
        storeVar(entry, "PWD", gepStr(entry, "/home/user"))
        entry.NewStore(llvm.constant.NewInt(i32, varIdList.length), gNvars)
        entry.NewBr(body)
        // ${!name}: compare against every known name and load the matching slot.
        var gb = rtGetByName.NewBlock("entry")
        var nm = rtGetByName.Params[0]
        var sel = unsetPtr(gb)
        for (i = 0; i < varIdList.length; i++) {
            var hit = gb.NewICmp(llvm.enum.IPredNE, gb.NewCall(rtStreq, [nm, gepStr(gb, varIdList[i])]), zero)
            var slot = gb.NewLoad(i8ptr, gb.NewGetElementPtr(gvarsTy, gVars, zero, llvm.constant.NewInt(i32, i)))
            sel = gb.NewSelect(hit, slot, sel)
        }
        gb.NewRet(sel)
        // rt_setvar_byname: the same chain, writing instead of reading.
        var sb = rtSetByName.NewBlock("entry")
        var snm = rtSetByName.Params[0]
        var sval = rtSetByName.Params[1]
        for (i = 0; i < varIdList.length; i++) {
            var shit = sb.NewICmp(llvm.enum.IPredNE, sb.NewCall(rtStreq, [snm, gepStr(sb, varIdList[i])]), zero)
            var slot = sb.NewGetElementPtr(gvarsTy, gVars, zero, llvm.constant.NewInt(i32, i))
            sb.NewStore(sb.NewSelect(shit, sval, sb.NewLoad(i8ptr, slot)), slot)
        }
        sb.NewRet(zero)
        // rt_eval_assign: split "NAME=VALUE" at the first "=" and assign.
        var eb = rtEvalAssign.NewBlock("entry")
        var eh = rtEvalAssign.NewBlock("head")
        var ebd = rtEvalAssign.NewBlock("body")
        var efound = rtEvalAssign.NewBlock("found")
        var estep = rtEvalAssign.NewBlock("step")
        var ex2 = rtEvalAssign.NewBlock("exit")
        var esrc2 = rtEvalAssign.Params[0]
        var elen = eb.NewCall(rtStrlen, esrc2)
        var eip = eb.NewAlloca(i32)
        eb.NewStore(zero, eip)
        eb.NewBr(eh)
        var ei2 = eh.NewLoad(i32, eip)
        eh.NewCondBr(eh.NewICmp(llvm.enum.IPredSLT, ei2, elen), ebd, ex2)
        var ec = ebd.NewZExt(ebd.NewLoad(i8, ebd.NewGetElementPtr(i8, esrc2, ei2)), i32)
        ebd.NewCondBr(ebd.NewICmp(llvm.enum.IPredEQ, ec, llvm.constant.NewInt(i32, 61)), efound, estep)
        efound.NewCall(rtSetByName, [efound.NewCall(rtSubstr, [esrc2, zero, ei2]),
                                     efound.NewCall(rtSubstr, [esrc2, efound.NewAdd(ei2, one), llvm.constant.NewInt(i32, -1)])])
        efound.NewBr(ex2)
        estep.NewStore(estep.NewAdd(ei2, one), eip)
        estep.NewBr(eh)
        ex2.NewRet(zero)
    }

    c.compile(c.asg)

    // With -exe PATH, link the module into a native executable (clang) instead of
    // running it in the built-in IR interpreter.
    if (c.exePath != undefined && c.exePath != "") {
        var buildErr = llvm.BuildExecutable(m, c.exePath)
        if (buildErr != "") { println(buildErr); exit(1) }
        println("bash-to-llvm-ir: wrote executable " + c.exePath)
        exit(0)
    }

    println(m)
    var res = llvm.Run(m, "main")
    print(res.Out)
    println("bash-to-llvm-ir: exit status " + res.Ret)
    exit(res.Ret)

~~) ;
