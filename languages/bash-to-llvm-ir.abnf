            if (anyDyn) { b.NewStore(zero, badP) }
            selfBadP = isRef ? slotOf(i32) : null
            if (isRef) { b.NewStore(zero, selfBadP) }
            var o
            for (o = 0; o < order.length; o++) {
                if (order[o].dyn != undefined) { b = emitDeclDyn(b, order[o].dyn, badP); continue }
                j = order[o].j
                if (asgs[j] == null || asgs[j].lit == null) { b = declAt(b, j, pre.vals[j]) }
            }
            storeStatusI(b, roFail ? 1 : 0)
            if (anyDyn) { storeStatus(b, b.NewOr(b.NewLoad(i32, gStatus), b.NewLoad(i32, badP))) }
            if (isRef) { storeStatus(b, b.NewOr(b.NewLoad(i32, gStatus), b.NewLoad(i32, selfBadP))) }
