        var ivFin = f.NewBlock("rpivfin"), ivz2 = f.NewBlock("rpivz2")
        ivok2.NewCondBr(ivok2.NewAnd(ivok2.NewICmp(reEQ, nv, zero),
                                     ivok2.NewICmp(reEQ, mv2, zero)), ivZero, ivz2)
