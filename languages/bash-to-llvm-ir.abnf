        // the declaration assigns it.
        var freshLocal = function(b, j) {
            b.NewCall(rtLocalNew, [llvm.constant.NewInt(i32, getVarId(names[j])), b.NewLoad(i32, curFrame.depth),
                                   (asgs[j] == null) ? one : zero])
