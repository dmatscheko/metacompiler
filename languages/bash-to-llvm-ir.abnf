//     @a -> the attribute letters (a for an indexed array, empty for a plain variable)
PeXform     = PeTarget "@" PeXfOp ;
PeXfOp      <~~ push({xf: up.in}) ~~> = "Q" | "E" | "P" | "A" | "K" | "a" | "k" | "L" | "U" | "u" ;

