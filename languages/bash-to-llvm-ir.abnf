        reAdv(s3, 1); s3.NewStore(one, emptyp); s3.NewStore(one, anyp)
        s3.NewBr(sq)
        sq.NewCondBr(sq.NewICmp(reNE, sq.NewCall(reIsq), zero), badq, sdone)
