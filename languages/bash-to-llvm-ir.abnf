        // $x` prints 1): every non-literal word is expanded up front and the command reads
        // the result. Then the assignments, undone after the command by the local save
        // stack, then the redirections, whose words do not see them either (prefixOuter).
        // Twin of makeSimpleCommand and applyPrefix in bash-interpreter.abnf.
        var asgConst = true
        var ai
        for (ai = 0; ai < asgs.length; ai++) { if (asgs[ai].val != null && asgs[ai].val.c == undefined) { asgConst = false } }
        return function(b) {
            var cmd0 = cmdT, args0 = argTs, redirs0 = redirs
            var mk0 = heapMark(b)
            var bx = {b: b}
            cmdT = expandedWord(bx, cmd0)
            argTs = []
            var k
            for (k = 0; k < args0.length; k++) { argTs.push(expandedWord(bx, args0[k])) }
            b = emitAbortCheck(bx.b)
            var olds = []
            if (redirs0.length > 0) { for (k = 0; k < asgs.length; k++) { olds.push(asgs[k].bad != null ? null : loadVar(b, asgs[k].aname)) } }
            var depth = slotOf(i32)
            b.NewStore(b.NewLoad(i32, gLsTop), depth)
            // For a function the bindings begin the call's frame (tmpDepth, rt_fn_enter),
            // marked as prefix bindings (rt_push_tmp), and each hides an array of its name.
            // Twin of applyPrefix and runPrefixed.
            var isFn = cmd0.c != undefined && !noFn && funcFor(cmd0.c) != null
            var vals = []
            // Before eval, a name refused only when this runs sets its slot in roPs, and
            // hidePrefix leaves its array and run-time marks.
            var roPs = {}
            for (k = 0; k < asgs.length; k++) {
                var an = asgs[k].aname
                if (!isFn && cmd0.c == "eval" && asgs[k].bad == null && !roStore(an) && roRtMay(an) && !attrOn(refVars, an) && !hasOwn(roPs, "$" + an)) {
                    roPs["$" + an] = slotOf(i32)
                    b.NewStore(zero, roPs["$" + an])
