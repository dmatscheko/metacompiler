    var rtArrKey = rtDecl("rt_arr_key", true, [1, 1])
    var rtAssocAdd = rtDecl("rt_assoc_add", false, [1])
    var rtUnsetName = rtDecl("rt_unset_name", false, [1])
    var rtIsAssoc = rtDecl("rt_isassoc", false, [1])
    var rtArrIkey = rtDecl("rt_arr_ikey", true, [1, 3])
    var rtArrLitKey = rtDecl("rt_arr_litkey", 3, [1, 1, 1, 3])
    var rtArrLitWords = rtDecl("rt_arr_litwords", 3, [1, 1, 3])
    var rtArrSlice = rtDecl("rt_arr_slice", true, [1, 3, 3, 0, 1, 0])
    var rtArrClear = rtDecl("rt_arr_clear", false, [1])
    var rtArrMark = rtDecl("rt_arr_mark", false, [1])
    var rtArrDmark = rtDecl("rt_arr_dmark", false, [1])
    var rtArrSmark = rtDecl("rt_arr_smark", false, [1])
    var rtFinList = rtDecl("rt_finlist", true, [1])
    var rtArrAppend = rtDecl("rt_arr_append", false, [1, 1])
    var rtSliceFields = rtDecl("rt_slicefields", true, [1, 0, 0, 1, 0])
    var rtGlobEsc = rtDecl("rt_globescape", true, [1])
    var rtRxEsc = rtDecl("rt_rxescape", true, [1])
    var rtRepEsc = rtDecl("rt_repescape", true, [1])
    // [[ == ]] matches with the extended globs on whatever shopt says (rt_glob_x).
    var rtGlobX = rtDecl("rt_glob_x", false, [1, 1])
    var gOptExtglob = rtGlobal("opt_extglob", i32)
    var rtCatFields = rtDecl("rt_catfields", true, [1, 1])
    var rtMapf = rtDecl("rt_mapf", true, [1, 0, 1, 1, 0, 1, 0])

