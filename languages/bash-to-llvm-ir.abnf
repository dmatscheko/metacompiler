                var keepV = assoc ? null : b.NewICmp(llvm.enum.IPredNE, b.NewCall(rtArrAny, gepStr(b, names[j])), zero)
                storeVarRaw(b, names[j], assoc ? unsetPtr(b) : b.NewSelect(keepV, loadVar(b, names[j]), unsetPtr(b)))
            }
            if (isArray && asgs[j] == null) { b.NewCall(rtArrDmark, gepStr(b, names[j])) }
            if (asgs[j] != null) {
                var a = asgs[j]
                if (v != null) { a = {name: a.name, op: a.op, idxT: a.idxT, lit: null, valT: doneWord(v)} }
                var prevV = selfRef ? loadVar(b, names[j]) : null
                b = emitAssign(b, a, assoc, null)
                if (selfRef) {
                    var selfB = curF.NewBlock(""), okB = curF.NewBlock("")
                    b.NewCondBr(b.NewICmp(llvm.enum.IPredNE, b.NewCall(rtStreq, [loadVar(b, names[j]), gepStr(b, names[j])]), zero), selfB, okB)
                    storeVarRaw(selfB, names[j], prevV)
