        badq.NewRet(zero)

        var sd1 = f.NewBlock("rpsd1"), sd2 = f.NewBlock("rpsd2")
        sdone.NewCondBr(sdone.NewICmp(reEQ, sdone.NewLoad(i32, anyp), zero), snoq, sd1)
        sd1.NewCondBr(sd1.NewICmp(reEQ, sd1.NewLoad(i32, infp), zero), sopt, sd2)
        sd2.NewCondBr(sd2.NewICmp(reEQ, sd2.NewLoad(i32, emptyp), zero), splus, sstar)

