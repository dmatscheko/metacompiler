        if (cc == 40 || cc == 41 || cc == 60 || cc == 62) { return undefined }
        return abnf.newToken("\x01brace-boundary", 0)
    })()
~~) ;

// Succeeds (consumes nothing) unless the upcoming word is a reserved keyword with a boundary,
// in which case it fails so the SimpleCommand does not swallow the keyword.
NotReserved = :script(~~
    (function() {
        var i = 0
        var cc = c.peek(i)
        while (cc == 32 || cc == 9) { i = i + 1; cc = c.peek(i) }
        // "}" standing alone is the reserved word that closes a brace group, never a command
        // (a bare "{" or "}" IS an ordinary word character elsewhere, for {single} and a}b).
        if (cc == 125) {
            var nb = c.peek(i + 1)
            if (nb == -1 || nb == 32 || nb == 9 || nb == 10 || nb == 13 || nb == 59 || nb == 38 || nb == 124 || nb == 41) {
                return abnf.newToken("\x01close-brace", 0)
            }
        }
        // "[[" with a boundary is the reserved word that opens a conditional command, never a
        // command NAME: if CondCmd could not parse the [[ ... ]] the file IS a syntax error.
        // (`echo [[ a ]]` still works - this only bites in COMMAND position.)
        if (cc == 91 && c.peek(i + 1) == 91) {
            var ab = c.peek(i + 2)
            if (ab == -1 || ab == 32 || ab == 9 || ab == 10 || ab == 13) {
                return abnf.newToken("\x01dbracket", 0)
            }
        }
        var w = ""
        cc = c.peek(i)
        while ((cc >= 97 && cc <= 122) || (cc >= 65 && cc <= 90)) { w = w + String.fromCharCode(cc); i = i + 1; cc = c.peek(i) }
        var boundary = (cc == -1 || cc == 32 || cc == 9 || cc == 10 || cc == 13 || cc == 59 || cc == 38 || cc == 124 || cc == 40 || cc == 41 || cc == 60 || cc == 62 || cc == 35)
        var kw = (w == "if" || w == "then" || w == "elif" || w == "else" || w == "fi" || w == "for" || w == "while" || w == "do" || w == "done" || w == "in" || w == "case" || w == "esac" || w == "until" || w == "function")
        if (kw && boundary) { return abnf.newToken("\x01reserved-word", 0) }
        return undefined
    })()
~~) ;


// --- whitespace: spaces, tabs, CR and # line comments; NEVER a newline (that is structure).

Whitespace  = { @+" \t\r" | Comment } ;
Comment     = "#" :whitespace() { NotNL } :whitespace(Whitespace) ;
NotNL       = "\x00"..."\x09" | "\x0b"..."\U0010ffff" ;


// ---

:startScript(~~

    // ===================================================================================
    //  Stack / string helpers (self contained, no shared core).
    //  NOTE: the local stack preserves plain objects but strips expando properties off
    //  pushed FUNCTIONS, so a string-producing thunk is carried as a plain object
    //  {fn: function(b) -> {b, v}, c: constant-string-or-undefined}. Statement and
    //  arithmetic thunks, which need no attached data, stay bare functions.
    // ===================================================================================

    function takeAll() {
        var items = []
        var v = anytype
        while ((v = pop()) != null) items.unshift(v)
        return items
    }
    function hasOwn(o, name) { return Object.prototype.hasOwnProperty.call(o, name) }
    function fail(msg) { println("bash-to-llvm-ir error: " + msg); exit(2) }

    // $'...' body -> the decoded string (bash's ANSI-C escapes).
    function ansiC(t) {
        var out = ""
        var i = 0
        while (i < t.length) {
            var ch = t.charAt(i)
            if (ch != "\\" || i + 1 >= t.length) { out = out + ch; i = i + 1 }
            else {
                var e = t.charAt(i + 1)
                i = i + 2
                if (e == "n") { out = out + "\n" }
                else if (e == "t") { out = out + "\t" }
                else if (e == "r") { out = out + "\r" }
                else if (e == "a") { out = out + String.fromCharCode(7) }
                else if (e == "b") { out = out + String.fromCharCode(8) }
                else if (e == "e" || e == "E") { out = out + String.fromCharCode(27) }
                else if (e == "f") { out = out + String.fromCharCode(12) }
                else if (e == "v") { out = out + String.fromCharCode(11) }
                else if (e == "0") { out = out + String.fromCharCode(0) }
                else if (e == "\\") { out = out + "\\" }
                else if (e == "'") { out = out + "'" }
                else if (e == "\"") { out = out + "\"" }
                else if (e == "x") {
                    var v = 0, n = 0
                    while (n < 2 && i < t.length && hexVal(t.charCodeAt(i)) >= 0) { v = v * 16 + hexVal(t.charCodeAt(i)); i = i + 1; n = n + 1 }
                    out = out + String.fromCharCode(v)
                }
                else { out = out + "\\" + e }
            }
        }
        return out
    }
    function hexVal(cc) {
        if (cc >= 48 && cc <= 57) { return cc - 48 }
        if (cc >= 97 && cc <= 102) { return cc - 87 }
        if (cc >= 65 && cc <= 70) { return cc - 55 }
        return -1
    }

    function escChar(t) { return t.slice(1) }
    function dqEsc(t) {
        var c = t.slice(1)
        if (c == "$" || c == "\"" || c == "\\" || c == "`") { return c }
        return t
    }
    function parseDec(s) {
        var neg = false, i = 0
        if (s.charAt(0) == "-") { neg = true; i = 1 } else if (s.charAt(0) == "+") { i = 1 }
        var v = 0
        while (i < s.length) { v = (v * 10 + (s.charCodeAt(i) - 48)) | 0; i = i + 1 }
        return neg ? ((0 - v) | 0) : v
    }
    function utf8Len(s) {
        var n = 0, i = 0
        while (i < s.length) {
            var c = s.charCodeAt(i)
            if (c < 0x80) { n += 1 }
            else if (c < 0x800) { n += 2 }
            else if (c >= 0xd800 && c <= 0xdbff) { n += 4; i += 1 }
            else { n += 3 }
            i += 1
        }
        return n
    }

    // ===================================================================================
    //  LLVM types, module, externs and the runtime globals.
    // ===================================================================================

    var i8 = llvm.types.I8
    var i32 = llvm.types.I32
    var i8ptr = llvm.types.I8Ptr
    var zero = llvm.constant.NewInt(i32, 0)
    var one = llvm.constant.NewInt(i32, 1)
    var ten = llvm.constant.NewInt(i32, 10)
    var zero8 = llvm.constant.NewInt(i8, 0)
    var nullStr = llvm.constant.NewNull(i8ptr) // the empty string: address 0 is the NUL byte

    var m = llvm.ir.NewModule()
    var extPutchar = m.NewFunc("putchar", i32, llvm.ir.NewParam("", i32))

    // The string heap: one big byte arena plus a bump offset. rt_bump hands out slices.
    var ARENA = 1 << 22
    var arenaTy = llvm.types.NewArray(ARENA, i8)
    var gArena = m.NewGlobalDef("arena", llvm.constant.NewZeroInitializer(arenaTy))
    var gApos = m.NewGlobalDef("arena_pos", zero)

    var gStatus = m.NewGlobalDef("last_status", zero) // $?
    var gExited = m.NewGlobalDef("exited", zero)       // set by `exit`
    var gExitCode = m.NewGlobalDef("exit_code", zero)

    // A real "" at a NONZERO address. The IR interpreter traps loads at address 0, so an
    // empty / unset value must be a genuine pointer to a NUL byte, never a null pointer.
    var gEmpty = m.NewGlobalDef("empty", llvm.constant.NewCharArrayFromString("\x00"))
    var emptyTy = llvm.types.NewArray(1, i8)
    function emptyPtr(b) { return b.NewGetElementPtr(emptyTy, gEmpty, zero, zero) }

    // A SECOND empty string, at a different address: the "variable is unset" marker. It reads
    // as "" everywhere (so no expansion has to special case it), but a pointer comparison
    // against it answers ${v-default} / ${v:+alt} and friends.
    var gUnset = m.NewGlobalDef("unset_marker", llvm.constant.NewCharArrayFromString("\x00"))
    function unsetPtr(b) { return b.NewGetElementPtr(emptyTy, gUnset, zero, zero) }

    // Variable storage is ONE global array of i8*, indexed by a compile-time id, so the
    // `local` unwinder can restore a slot chosen at run time (a per-name global could only
    // be reached through a generated dispatch).
    var NVARS = 1024
    var gvarsTy = llvm.types.NewArray(NVARS, i8ptr)
    var gVars = m.NewGlobalDef("gvars", llvm.constant.NewZeroInitializer(gvarsTy))

    var varIds = {}       // "$"+name -> slot index
    var varIdList = []    // index -> name (creation order, for the deterministic init run)
    function getVarId(name) {
        var key = "$" + name
        if (hasOwn(varIds, key)) { return varIds[key] }
        var id = varIdList.length
        if (id >= NVARS) { fail("too many distinct variables (limit " + NVARS + ")") }
        varIds[key] = id
        varIdList.push(name)
        return id
    }
    function varPtr(b, name) {
        return b.NewGetElementPtr(gvarsTy, gVars, zero, llvm.constant.NewInt(i32, getVarId(name)))
    }
    function loadVar(b, name) { return b.NewLoad(i8ptr, varPtr(b, name)) }
    function storeVar(b, name, v) { b.NewStore(v, varPtr(b, name)) }

    // The `local` save stack: (slot id, previous value) pairs. A function records the stack
    // depth on entry and unwinds back to it at every return, so a `return` from anywhere -
    // including out of a loop - restores every name the call declared local.
    var LSMAX = 512
    var lsIdTy = llvm.types.NewArray(LSMAX, i32)
    var lsValTy = llvm.types.NewArray(LSMAX, i8ptr)
    var gLsId = m.NewGlobalDef("ls_id", llvm.constant.NewZeroInitializer(lsIdTy))
    var gLsVal = m.NewGlobalDef("ls_val", llvm.constant.NewZeroInitializer(lsValTy))
    var gLsTop = m.NewGlobalDef("ls_top", zero)

    // Output capture for $( ) / ` ` : a stack of fixed-size arena buffers. While the depth is
    // non-zero every byte a command would print lands in the innermost buffer instead of on
    // stdout, which is what makes nesting ( $(echo "$(echo x)") ) work.
    var CAPMAX = 16
    var CAPSZ = 8192
    var capBufTy = llvm.types.NewArray(CAPMAX, i8ptr)
    var capLenTy = llvm.types.NewArray(CAPMAX, i32)
    var gCapBuf = m.NewGlobalDef("cap_buf", llvm.constant.NewZeroInitializer(capBufTy))
    var gCapLen = m.NewGlobalDef("cap_len", llvm.constant.NewZeroInitializer(capLenTy))
    var gCapDepth = m.NewGlobalDef("cap_depth", zero)

    // Subshell isolation: ( LIST ) snapshots the whole variable array and restores it.
    var SSDEPTH = 8
    var ssTy = llvm.types.NewArray(SSDEPTH * NVARS, i8ptr)
    var gSs = m.NewGlobalDef("ss_save", llvm.constant.NewZeroInitializer(ssTy))
    var gSsDepth = m.NewGlobalDef("ss_depth", zero)
    var gNvars = m.NewGlobalDef("nvars", zero)   // filled by main's entry block
    // The standard input a pipeline stage hands on (the compiler has no `read` yet).
    var gStdin = m.NewGlobalDef("stdin_buf", llvm.constant.NewNull(i8ptr))

    // Shell options (set -e / -u / -o pipefail) and the abort flag a set -u failure raises
    // during expansion (expansion cannot return a status, so the command about to run picks
    // it up - exactly the shape the interpreter uses).
    var gOptE = m.NewGlobalDef("opt_errexit", zero)
    var gOptU = m.NewGlobalDef("opt_nounset", zero)
    var gOptPf = m.NewGlobalDef("opt_pipefail", zero)
    var gAbort = m.NewGlobalDef("abort_flag", zero)
    var gCondErr = m.NewGlobalDef("cond_err", zero)   // a [[ ]] that could not be evaluated

    // Two output channels. 0 = standard output (captured by $( ) when one is open), 1 = the
    // standard error channel, 2 = discarded. There is no stderr primitive behind a compiled
    // run either, so channel 1's text is dropped - what MATTERS is which channel a
    // redirection routes a command to, and that is modelled exactly.
    var gSinkOut = m.NewGlobalDef("sink_out", zero)
    var gSinkErr = m.NewGlobalDef("sink_err", one)
    // Standard input for `read`: the buffer and the read position.
    var gStdinPos = m.NewGlobalDef("stdin_pos", zero)

    // Positional parameters live in ONE global stack rather than in function arguments, so
    // "$@" can expand to any number of words and `shift` and `set --` are ordinary writes.
    // A call pushes its (field-expanded) arguments, records base/count, and restores both
    // plus the stack top afterwards - which is what makes recursion work.
    var NARGV = 4096
    var argvTy = llvm.types.NewArray(NARGV, i8ptr)
    var gArgv = m.NewGlobalDef("argv", llvm.constant.NewZeroInitializer(argvTy))
    var gArgvTop = m.NewGlobalDef("argv_top", zero)
    var gFrameBase = m.NewGlobalDef("frame_base", zero)
    var gFrameN = m.NewGlobalDef("frame_n", zero)

    // ===================================================================================
    //  Emitter state.
    // ===================================================================================

    var curF = null       // the IR function currently being emitted into
    var curExit = null     // its exit block (an `exit N` / propagated exit branches here)
    var curFrame = null    // null at top level, else {params: [9 i8* values], argc: i32 value}
    var condDepth = 0      // >0 while emitting a CONDITION (set -e must not fire there)
    var loopStack = []     // {brk, cont} target blocks of the loops being emitted
    var trapList = []      // EXIT traps registered in the (sub)shell being emitted
    var trapCount = 0
    var deadCount = 0
    function deadBlock() { deadCount = deadCount + 1; return curF.NewBlock("dead" + deadCount) }

    var strGlobals = {}   // interned string constants:  "$"+content -> {g, ty}
    var strCount = 0
    function internStr(s) {
        var key = "$" + s
        if (hasOwn(strGlobals, key)) { return strGlobals[key] }
        var ty = llvm.types.NewArray(utf8Len(s) + 1, i8)
        var g = m.NewGlobalDef("str" + strCount, llvm.constant.NewCharArrayFromString(s + "\x00"))
        strCount = strCount + 1
        var rec = {g: g, ty: ty}
        strGlobals[key] = rec
        return rec
    }
    // An i8* value pointing at an interned constant string, materialized in block b.
    function gepStr(b, s) {
        if (s == "") { return emptyPtr(b) }
        var r = internStr(s)
        return b.NewGetElementPtr(r.ty, r.g, zero, zero)
    }

    // i32 rt_setvar_byname(i8* name, i8* val) and i32 rt_eval_assign(i8* "NAME=VALUE"):
    // both filled in once the walk is over and every variable name is known.
    var rtSetByName = m.NewFunc("rt_setvar_byname", i32,
        [llvm.ir.NewParam("n", i8ptr), llvm.ir.NewParam("v", i8ptr)])
    var rtEvalAssign = m.NewFunc("rt_eval_assign", i32, llvm.ir.NewParam("s", i8ptr))

    // i8* rt_getvar_byname(i8* name): ${!ptr} indirection. Its body is a chain over every
    // variable name the program mentions, so it can only be emitted once the walk is over.
    var rtGetByName = m.NewFunc("rt_getvar_byname", i8ptr, llvm.ir.NewParam("n", i8ptr))

    var funcs = {}        // user functions: "$"+name -> IR func (bashfn_NAME)
    var declaredFuncs = {}  // every name the program DEFINES somewhere (collected during the
                            // walk, so a call emitted before the definition still resolves)
    var definedFuncs = {}   // names whose body has already been emitted
    var fnCount = 0

    function bashFnParams() { return [] }
    // The IR function for a bash function name, declared on first reference. A forward call
    // (`f` above its `f() {...}`) is ordinary in a shell script, so it must not fall through
    // to "command not found".
    function funcFor(name) {
        var key = "$" + name
        if (hasOwn(funcs, key)) { return funcs[key] }
        if (!hasOwn(declaredFuncs, key)) { return null }
        var f = m.NewFunc("bashfn_" + name, i32)
        funcs[key] = f
        return f
    }

    // ===================================================================================
    //  The string runtime, hand-emitted as IR functions.
    // ===================================================================================

    // i8* rt_bump(i32 n): return &arena[pos]; pos += n.
    var rtBump = m.NewFunc("rt_bump", i8ptr, llvm.ir.NewParam("n", i32))
    ;(function() {
        var n = rtBump.Params[0]
        var b = rtBump.NewBlock("entry")
        var p = b.NewLoad(i32, gApos)
        var ptr = b.NewGetElementPtr(arenaTy, gArena, zero, p)
        b.NewStore(b.NewAdd(p, n), gApos)
        b.NewRet(ptr)
    })()

    // i32 rt_strlen(i8* s)
    var rtStrlen = m.NewFunc("rt_strlen", i32, llvm.ir.NewParam("s", i8ptr))
    ;(function() {
        var s = rtStrlen.Params[0]
        var e = rtStrlen.NewBlock("entry")
        var h = rtStrlen.NewBlock("head")
        var bd = rtStrlen.NewBlock("body")
        var x = rtStrlen.NewBlock("exit")
        var ip = e.NewAlloca(i32)
        e.NewStore(zero, ip)
        e.NewBr(h)
        var i = h.NewLoad(i32, ip)
        var ch = h.NewLoad(i8, h.NewGetElementPtr(i8, s, i))
        h.NewCondBr(h.NewICmp(llvm.enum.IPredEQ, ch, zero8), x, bd)
        bd.NewStore(bd.NewAdd(i, one), ip)
        bd.NewBr(h)
        x.NewRet(x.NewLoad(i32, ip))
    })()

    // i32 rt_charlen(i8* s): the number of CHARACTERS in s, which is what bash's
    // ${#s} counts - not bytes (rt_strlen) and not UTF-16 units. A UTF-8
    // continuation byte is 10xxxxxx, so every byte with (b & 0xC0) != 0x80 starts
    // one character. `${#s}` on "a<emoji>b" is 3 in bash 5.3, was 6 here.
    // The block labels carry a "cl" prefix: a parameter name and a block label
    // share one per-function namespace in textual IR (see docs/abnf-dialect-gotchas.md).
    var rtCharLen = m.NewFunc("rt_charlen", i32, llvm.ir.NewParam("s", i8ptr))
    ;(function() {
        var s = rtCharLen.Params[0]
        var e = rtCharLen.NewBlock("entry")
        var h = rtCharLen.NewBlock("clhead")
        var bd = rtCharLen.NewBlock("clbody")
        var cnt = rtCharLen.NewBlock("clcount")
        var nx = rtCharLen.NewBlock("clnext")
        var x = rtCharLen.NewBlock("clexit")
        var ip = e.NewAlloca(i32)
        var np = e.NewAlloca(i32)
        e.NewStore(zero, ip)
        e.NewStore(zero, np)
        e.NewBr(h)
        var i = h.NewLoad(i32, ip)
        var ch = h.NewLoad(i8, h.NewGetElementPtr(i8, s, i))
        h.NewCondBr(h.NewICmp(llvm.enum.IPredEQ, ch, zero8), x, bd)
        var c32 = bd.NewZExt(ch, i32)
        var isCont = bd.NewICmp(llvm.enum.IPredEQ,
                                bd.NewAnd(c32, llvm.constant.NewInt(i32, 192)),
                                llvm.constant.NewInt(i32, 128))
        bd.NewCondBr(isCont, nx, cnt)
        cnt.NewStore(cnt.NewAdd(cnt.NewLoad(i32, np), one), np)
        cnt.NewBr(nx)
        nx.NewStore(nx.NewAdd(nx.NewLoad(i32, ip), one), ip)
        nx.NewBr(h)
        x.NewRet(x.NewLoad(i32, np))
    })()

    // i32 rt_charoff(i8* s, i32 k): the BYTE offset of character number k, clamped
    // to the length of s. rt_csubstr converts a character range with it.
    var rtCharOff = m.NewFunc("rt_charoff", i32,
        [llvm.ir.NewParam("s", i8ptr), llvm.ir.NewParam("k", i32)])
    ;(function() {
        var s = rtCharOff.Params[0], k0 = rtCharOff.Params[1]
        var e = rtCharOff.NewBlock("entry")
        var h = rtCharOff.NewBlock("cohead")
        var bd = rtCharOff.NewBlock("cobody")
        var cnt = rtCharOff.NewBlock("cocount")
        var bump = rtCharOff.NewBlock("cobump")
        var nx = rtCharOff.NewBlock("conext")
        var x = rtCharOff.NewBlock("coexit")
        var ip = e.NewAlloca(i32)
        var np = e.NewAlloca(i32)
        e.NewStore(zero, ip)
        e.NewStore(zero, np)
        e.NewBr(h)
        var i = h.NewLoad(i32, ip)
        var ch = h.NewLoad(i8, h.NewGetElementPtr(i8, s, i))
        h.NewCondBr(h.NewICmp(llvm.enum.IPredEQ, ch, zero8), x, bd)
        var c32 = bd.NewZExt(ch, i32)
        var isCont = bd.NewICmp(llvm.enum.IPredEQ,
                                bd.NewAnd(c32, llvm.constant.NewInt(i32, 192)),
                                llvm.constant.NewInt(i32, 128))
        bd.NewCondBr(isCont, nx, cnt)
        // At a character START: this is character number n. Once n has reached k
        // the walk is done and i IS the byte offset asked for; otherwise count it
        // and step over its continuation bytes on the following iterations.
        var n = cnt.NewLoad(i32, np)
        cnt.NewCondBr(cnt.NewICmp(llvm.enum.IPredSGE, n, k0), x, bump)
        bump.NewStore(bump.NewAdd(n, one), np)
        bump.NewBr(nx)
        nx.NewStore(nx.NewAdd(nx.NewLoad(i32, ip), one), ip)
        nx.NewBr(h)
        x.NewRet(x.NewLoad(i32, ip))
    })()

    // i32 rt_streq(i8* a, i8* b) -> 1 if equal, else 0.
    var rtStreq = m.NewFunc("rt_streq", i32, [llvm.ir.NewParam("a", i8ptr), llvm.ir.NewParam("b", i8ptr)])
    ;(function() {
        var a = rtStreq.Params[0], b2 = rtStreq.Params[1]
        var e = rtStreq.NewBlock("entry")
        var h = rtStreq.NewBlock("head")
        var chk = rtStreq.NewBlock("chk")
        var ne = rtStreq.NewBlock("ne")
        var eq = rtStreq.NewBlock("eq")
        var cont = rtStreq.NewBlock("cont")
        var ip = e.NewAlloca(i32)
        e.NewStore(zero, ip)
        e.NewBr(h)
        var i = h.NewLoad(i32, ip)
        var ca = h.NewLoad(i8, h.NewGetElementPtr(i8, a, i))
        var cb = h.NewLoad(i8, h.NewGetElementPtr(i8, b2, i))
        h.NewCondBr(h.NewICmp(llvm.enum.IPredNE, ca, cb), ne, chk)
        chk.NewCondBr(chk.NewICmp(llvm.enum.IPredEQ, ca, zero8), eq, cont)
        cont.NewStore(cont.NewAdd(i, one), ip)
        cont.NewBr(h)
        ne.NewRet(zero)
        eq.NewRet(one)
    })()

    // i32 rt_strcmp(i8* a, i8* b): -1 / 0 / 1 by unsigned byte order (the shell's < and >).
    var rtStrcmp = m.NewFunc("rt_strcmp", i32, [llvm.ir.NewParam("a", i8ptr), llvm.ir.NewParam("b", i8ptr)])
    ;(function() {
        var a = rtStrcmp.Params[0], b2 = rtStrcmp.Params[1]
        var e = rtStrcmp.NewBlock("entry")
        var h = rtStrcmp.NewBlock("head")
        var ck = rtStrcmp.NewBlock("ck")
        var lt = rtStrcmp.NewBlock("lt")
        var gt = rtStrcmp.NewBlock("gt")
        var eq = rtStrcmp.NewBlock("eq")
        var cont = rtStrcmp.NewBlock("cont")
        var ip = e.NewAlloca(i32)
        e.NewStore(zero, ip)
        e.NewBr(h)
        var i = h.NewLoad(i32, ip)
        var ca = h.NewZExt(h.NewLoad(i8, h.NewGetElementPtr(i8, a, i)), i32)
        var cb = h.NewZExt(h.NewLoad(i8, h.NewGetElementPtr(i8, b2, i)), i32)
        h.NewCondBr(h.NewICmp(llvm.enum.IPredSLT, ca, cb), lt, ck)
        ck.NewCondBr(ck.NewICmp(llvm.enum.IPredSGT, ca, cb), gt, cont)
        var step = rtStrcmp.NewBlock("step")
        cont.NewCondBr(cont.NewICmp(llvm.enum.IPredEQ, ca, zero), eq, step)
        step.NewStore(step.NewAdd(i, one), ip)
        step.NewBr(h)
        lt.NewRet(llvm.constant.NewInt(i32, -1))
        gt.NewRet(one)
        eq.NewRet(zero)
    })()

    // i8* rt_strcat(i8* a, i8* b): fresh arena string = a followed by b.
    var rtStrcat = m.NewFunc("rt_strcat", i8ptr, [llvm.ir.NewParam("a", i8ptr), llvm.ir.NewParam("b", i8ptr)])
    ;(function() {
        var a = rtStrcat.Params[0], b2 = rtStrcat.Params[1]
        var e = rtStrcat.NewBlock("entry")
        var la = e.NewCall(rtStrlen, a)
        var lb = e.NewCall(rtStrlen, b2)
        var dst = e.NewCall(rtBump, e.NewAdd(e.NewAdd(la, lb), one))
        var ip = e.NewAlloca(i32) // source index
        var dp = e.NewAlloca(i32) // dest index
        e.NewStore(zero, dp)
        e.NewStore(zero, ip)
        var ha = rtStrcat.NewBlock("ha"), bda = rtStrcat.NewBlock("bda"), xa = rtStrcat.NewBlock("xa")
        e.NewBr(ha)
        var ia = ha.NewLoad(i32, ip)
        var cha = ha.NewLoad(i8, ha.NewGetElementPtr(i8, a, ia))
        ha.NewCondBr(ha.NewICmp(llvm.enum.IPredEQ, cha, zero8), xa, bda)
        var da = bda.NewLoad(i32, dp)
        bda.NewStore(cha, bda.NewGetElementPtr(i8, dst, da))
        bda.NewStore(bda.NewAdd(da, one), dp)
        bda.NewStore(bda.NewAdd(ia, one), ip)
        bda.NewBr(ha)
        xa.NewStore(zero, ip)
        var hb = rtStrcat.NewBlock("hb"), bdb = rtStrcat.NewBlock("bdb"), xb = rtStrcat.NewBlock("xb")
        xa.NewBr(hb)
        var ib = hb.NewLoad(i32, ip)
        var chb = hb.NewLoad(i8, hb.NewGetElementPtr(i8, b2, ib))
        hb.NewCondBr(hb.NewICmp(llvm.enum.IPredEQ, chb, zero8), xb, bdb)
        var db = bdb.NewLoad(i32, dp)
        bdb.NewStore(chb, bdb.NewGetElementPtr(i8, dst, db))
        bdb.NewStore(bdb.NewAdd(db, one), dp)
        bdb.NewStore(bdb.NewAdd(ib, one), ip)
        bdb.NewBr(hb)
        var dn = xb.NewLoad(i32, dp)
        xb.NewStore(zero8, xb.NewGetElementPtr(i8, dst, dn))
        xb.NewRet(dst)
    })()

    // i8* rt_int2str(i32 n): decimal string in the arena (mirrors the interpreter's numToStr).
    var rtInt2str = m.NewFunc("rt_int2str", i8ptr, llvm.ir.NewParam("n", i32))
    ;(function() {
        var tmpArrTy = llvm.types.NewArray(16, i8)
        var n = rtInt2str.Params[0]
        var e = rtInt2str.NewBlock("entry")
        var isZero = rtInt2str.NewBlock("zero")
        var nz = rtInt2str.NewBlock("nz")
        var dst = e.NewCall(rtBump, llvm.constant.NewInt(i32, 16))
        var tmp = e.NewAlloca(tmpArrTy) // digits, filled from the right
        e.NewCondBr(e.NewICmp(llvm.enum.IPredEQ, n, zero), isZero, nz)
        isZero.NewStore(llvm.constant.NewInt(i8, 48), isZero.NewGetElementPtr(i8, dst, zero))
        isZero.NewStore(zero8, isZero.NewGetElementPtr(i8, dst, one))
        isZero.NewRet(dst)
        var neg = nz.NewICmp(llvm.enum.IPredSLT, n, zero)
        var absn = nz.NewSelect(neg, nz.NewSub(zero, n), n)
        var ap = nz.NewAlloca(i32) // running value
        var tp = nz.NewAlloca(i32) // tmp write index (15 -> down)
        nz.NewStore(absn, ap)
        nz.NewStore(llvm.constant.NewInt(i32, 15), tp)
        var dh = rtInt2str.NewBlock("dh"), dbd = rtInt2str.NewBlock("dbd"), dx = rtInt2str.NewBlock("dx")
        nz.NewBr(dh)
        var av = dh.NewLoad(i32, ap)
        dh.NewCondBr(dh.NewICmp(llvm.enum.IPredSLE, av, zero), dx, dbd)
        var d = dbd.NewSRem(av, ten)
        var ti = dbd.NewLoad(i32, tp)
        dbd.NewStore(dbd.NewTrunc(dbd.NewAdd(d, llvm.constant.NewInt(i32, 48)), i8), dbd.NewGetElementPtr(tmpArrTy, tmp, zero, ti))
        dbd.NewStore(dbd.NewSub(ti, one), tp)
        dbd.NewStore(dbd.NewSDiv(av, ten), ap)
        dbd.NewBr(dh)
        var dip = dx.NewAlloca(i32) // dst write index
        dx.NewStore(zero, dip)
        var wsign = rtInt2str.NewBlock("wsign"), asm = rtInt2str.NewBlock("asm")
        dx.NewCondBr(neg, wsign, asm)
        wsign.NewStore(llvm.constant.NewInt(i8, 45), wsign.NewGetElementPtr(i8, dst, zero)) // '-'
        wsign.NewStore(one, dip)
        wsign.NewBr(asm)
        var jp = asm.NewAlloca(i32)
        asm.NewStore(asm.NewAdd(asm.NewLoad(i32, tp), one), jp) // j = ti+1
        var ah = rtInt2str.NewBlock("ah"), abd = rtInt2str.NewBlock("abd"), ax = rtInt2str.NewBlock("ax")
        asm.NewBr(ah)
        var j = ah.NewLoad(i32, jp)
        ah.NewCondBr(ah.NewICmp(llvm.enum.IPredSGT, j, llvm.constant.NewInt(i32, 15)), ax, abd)
        var digit = abd.NewLoad(i8, abd.NewGetElementPtr(tmpArrTy, tmp, zero, j))
        var di = abd.NewLoad(i32, dip)
        abd.NewStore(digit, abd.NewGetElementPtr(i8, dst, di))
        abd.NewStore(abd.NewAdd(di, one), dip)
        abd.NewStore(abd.NewAdd(j, one), jp)
        abd.NewBr(ah)
        ax.NewStore(zero8, ax.NewGetElementPtr(i8, dst, ax.NewLoad(i32, dip))) // NUL
        ax.NewRet(dst)
    })()

    // i32 rt_str2int(i8* s): leading spaces/tabs, one +/- sign, digits until non-digit.
    var rtStr2int = m.NewFunc("rt_str2int", i32, llvm.ir.NewParam("s", i8ptr))
    ;(function() {
        var s = rtStr2int.Params[0]
        var e = rtStr2int.NewBlock("entry")
        var ip = e.NewAlloca(i32)  // index
        var vp = e.NewAlloca(i32)  // value
        var sp = e.NewAlloca(i32)  // sign
        e.NewStore(zero, ip)
        e.NewStore(zero, vp)
        e.NewStore(one, sp)
        var wh = rtStr2int.NewBlock("wh"), wbd = rtStr2int.NewBlock("wbd"), wx = rtStr2int.NewBlock("wx")
        e.NewBr(wh)
        var wi = wh.NewLoad(i32, ip)
        var wc = wh.NewLoad(i8, wh.NewGetElementPtr(i8, s, wi))
        var isSp = wh.NewICmp(llvm.enum.IPredEQ, wc, llvm.constant.NewInt(i8, 32))
        var isTab = wh.NewICmp(llvm.enum.IPredEQ, wc, llvm.constant.NewInt(i8, 9))
        wh.NewCondBr(wh.NewOr(isSp, isTab), wbd, wx)
        wbd.NewStore(wbd.NewAdd(wi, one), ip)
        wbd.NewBr(wh)
        var ci = wx.NewLoad(i32, ip)
        var cc = wx.NewLoad(i8, wx.NewGetElementPtr(i8, s, ci))
        var isMinus = wx.NewICmp(llvm.enum.IPredEQ, cc, llvm.constant.NewInt(i8, 45))
        var isPlus = wx.NewICmp(llvm.enum.IPredEQ, cc, llvm.constant.NewInt(i8, 43))
        var signBlk = rtStr2int.NewBlock("sign"), digs = rtStr2int.NewBlock("digs")
        wx.NewCondBr(wx.NewOr(isMinus, isPlus), signBlk, digs)
        signBlk.NewStore(signBlk.NewSelect(isMinus, llvm.constant.NewInt(i32, -1), one), sp)
        signBlk.NewStore(signBlk.NewAdd(ci, one), ip)
        signBlk.NewBr(digs)
        var dh = rtStr2int.NewBlock("dh"), dbd = rtStr2int.NewBlock("dbd"), dx = rtStr2int.NewBlock("dx")
        digs.NewBr(dh)
        var di = dh.NewLoad(i32, ip)
        var dc = dh.NewLoad(i8, dh.NewGetElementPtr(i8, s, di))
        var dc32 = dh.NewSExt(dc, i32)
        var ge0 = dh.NewICmp(llvm.enum.IPredSGE, dc32, llvm.constant.NewInt(i32, 48))
        var le9 = dh.NewICmp(llvm.enum.IPredSLE, dc32, llvm.constant.NewInt(i32, 57))
        dh.NewCondBr(dh.NewAnd(ge0, le9), dbd, dx)
        var v = dbd.NewLoad(i32, vp)
        dbd.NewStore(dbd.NewAdd(dbd.NewMul(v, ten), dbd.NewSub(dc32, llvm.constant.NewInt(i32, 48))), vp)
        dbd.NewStore(dbd.NewAdd(di, one), ip)
        dbd.NewBr(dh)
        dx.NewRet(dx.NewMul(dx.NewLoad(i32, vp), dx.NewLoad(i32, sp)))
    })()

    // ---- shared IR-emitting shorthand, used by the @-transforms below and by the ERE
    // engine further down. `var` initialisers do not hoist, so these live above their first
    // use rather than beside the engine that grew them.
    function reK(n) { return llvm.constant.NewInt(i32, n) }
    var reEQ = llvm.enum.IPredEQ, reNE = llvm.enum.IPredNE
    var reSLT = llvm.enum.IPredSLT, reSLE = llvm.enum.IPredSLE
    var reSGT = llvm.enum.IPredSGT, reSGE = llvm.enum.IPredSGE
    var one8 = llvm.constant.NewInt(i8, 1)
    var ff8 = llvm.constant.NewInt(i8, 255)
    // re_bad, declared here because reForL's guard reads it before the engine defines the
    // rest of its state.
    var gReBad = m.NewGlobalDef("re_bad", zero)

    // Emit `for (*ip = from; *ip < to; ++*ip) body`. `ip` must come from the function's
    // ENTRY block: an alloca reached repeatedly grows the native stack, which our machine
    // would never have shown us. `live` also stops the loop once re_bad is set, which is
    // what keeps a {1000} that overruns re_prog from running the emitter dry.
    function reForG(f, tag, b, ip, from, to, live, body) {
        b.NewStore(from, ip)
        var h = f.NewBlock(tag + "h")
        var bd = f.NewBlock(tag + "b")
        var x = f.NewBlock(tag + "x")
        b.NewBr(h)
        var i = h.NewLoad(i32, ip)
        var go = h.NewICmp(reSLT, i, to)
        if (live) { go = h.NewAnd(go, h.NewICmp(reEQ, h.NewLoad(i32, gReBad), zero)) }
        h.NewCondBr(go, bd, x)
        var e2 = body(bd, i)
        e2.NewStore(e2.NewAdd(e2.NewLoad(i32, ip), one), ip)
        e2.NewBr(h)
        return x
    }
    function reFor(f, tag, b, ip, from, to, body) { return reForG(f, tag, b, ip, from, to, false, body) }
    function reForL(f, tag, b, ip, from, to, body) { return reForG(f, tag, b, ip, from, to, true, body) }

    // ---- glob (pathname-style) matching in IR: * ? [...] and a backslash escape ------
    // The same matcher backs case and [[ == ]], exactly like the shell. Both functions walk
    // raw i8* pointers; "*" backtracks by CALLING rt_glob again, so the IR call stack is the
    // backtracking stack.

    // i32 rt_class(i8* p, i32 ch): p points at "[". Returns -1 when the bracket expression is
    // unterminated (the "[" is then a literal), else (bytesConsumed << 1) | matched.
    var rtClass = m.NewFunc("rt_class", i32, [llvm.ir.NewParam("p", i8ptr), llvm.ir.NewParam("ch", i32)])
    ;(function() {
        var p2 = rtClass.Params[0], ch = rtClass.Params[1]
        var e = rtClass.NewBlock("entry")
        var h = rtClass.NewBlock("head")
        var it = rtClass.NewBlock("item")
        var mr = rtClass.NewBlock("maybe_range")
        var rg = rtClass.NewBlock("range")
        var sg = rtClass.NewBlock("single")
        var un = rtClass.NewBlock("unterm")
        var dn = rtClass.NewBlock("done")
        var jp = e.NewAlloca(i32), np = e.NewAlloca(i32), mp = e.NewAlloca(i32), fp = e.NewAlloca(i32)
        e.NewStore(one, jp); e.NewStore(zero, np); e.NewStore(zero, mp); e.NewStore(one, fp)
        var c0 = e.NewZExt(e.NewLoad(i8, e.NewGetElementPtr(i8, p2, one)), i32)
        var isNeg = e.NewOr(e.NewICmp(llvm.enum.IPredEQ, c0, llvm.constant.NewInt(i32, 33)),
                            e.NewICmp(llvm.enum.IPredEQ, c0, llvm.constant.NewInt(i32, 94)))
        e.NewStore(e.NewSelect(isNeg, one, zero), np)
        e.NewStore(e.NewSelect(isNeg, llvm.constant.NewInt(i32, 2), one), jp)
        e.NewBr(h)

        var j = h.NewLoad(i32, jp)
        var cj = h.NewZExt(h.NewLoad(i8, h.NewGetElementPtr(i8, p2, j)), i32)
        var atEnd = h.NewICmp(llvm.enum.IPredEQ, cj, zero)
        var closes = h.NewAnd(h.NewICmp(llvm.enum.IPredEQ, cj, llvm.constant.NewInt(i32, 93)),
                              h.NewICmp(llvm.enum.IPredEQ, h.NewLoad(i32, fp), zero))
        var h2 = rtClass.NewBlock("h2")
        h.NewCondBr(atEnd, un, h2)
        h2.NewCondBr(closes, dn, it)

        it.NewStore(zero, fp)
        var cn = it.NewZExt(it.NewLoad(i8, it.NewGetElementPtr(i8, p2, it.NewAdd(j, one))), i32)
        it.NewCondBr(it.NewICmp(llvm.enum.IPredEQ, cn, llvm.constant.NewInt(i32, 45)), mr, sg)

        var cn2 = mr.NewZExt(mr.NewLoad(i8, mr.NewGetElementPtr(i8, p2, mr.NewAdd(j, llvm.constant.NewInt(i32, 2)))), i32)
        var okRange = mr.NewAnd(mr.NewICmp(llvm.enum.IPredNE, cn2, zero),
                                mr.NewICmp(llvm.enum.IPredNE, cn2, llvm.constant.NewInt(i32, 93)))
        mr.NewCondBr(okRange, rg, sg)

        var inR = rg.NewAnd(rg.NewICmp(llvm.enum.IPredSGE, ch, cj), rg.NewICmp(llvm.enum.IPredSLE, ch, cn2))
        rg.NewStore(rg.NewSelect(inR, one, rg.NewLoad(i32, mp)), mp)
        rg.NewStore(rg.NewAdd(j, llvm.constant.NewInt(i32, 3)), jp)
        rg.NewBr(h)

        var eq1 = sg.NewICmp(llvm.enum.IPredEQ, ch, cj)
        sg.NewStore(sg.NewSelect(eq1, one, sg.NewLoad(i32, mp)), mp)
        sg.NewStore(sg.NewAdd(j, one), jp)
        sg.NewBr(h)

        un.NewRet(llvm.constant.NewInt(i32, -1))

        var mv = dn.NewLoad(i32, mp)
        var neg = dn.NewICmp(llvm.enum.IPredNE, dn.NewLoad(i32, np), zero)
        var fin = dn.NewSelect(neg, dn.NewSub(one, mv), mv)
        dn.NewRet(dn.NewOr(dn.NewMul(dn.NewAdd(dn.NewLoad(i32, jp), one), llvm.constant.NewInt(i32, 2)), fin))
    })()

    // i32 rt_eg(i8* p, i8* s, i32 star): the extended globs. Declared here because rt_glob
    // dispatches into it and it calls rt_glob straight back; its body needs rt_substr and so
    // is emitted below that.
    var rtEg = m.NewFunc("rt_eg", i32,
        [llvm.ir.NewParam("egp", i8ptr), llvm.ir.NewParam("egs", i8ptr),
         llvm.ir.NewParam("egstar", i32)])

    // i32 rt_glob(i8* pat, i8* s): 1 when the whole subject matches the whole pattern.
    var rtGlob = m.NewFunc("rt_glob", i32, [llvm.ir.NewParam("p", i8ptr), llvm.ir.NewParam("s", i8ptr)])
    ;(function() {
        var p0 = rtGlob.Params[0], s0 = rtGlob.Params[1]
        var e = rtGlob.NewBlock("entry")
        var h = rtGlob.NewBlock("head")
        var pend = rtGlob.NewBlock("pend")
        var nostar = rtGlob.NewBlock("nostar")
        var starsk = rtGlob.NewBlock("starsk")
        var staraf = rtGlob.NewBlock("staraf")
        var kloop = rtGlob.NewBlock("kloop")
        var knext = rtGlob.NewBlock("knext")
        var havec = rtGlob.NewBlock("havec")
        var qm = rtGlob.NewBlock("qmark")
        var nq = rtGlob.NewBlock("nq")
        var brk = rtGlob.NewBlock("brack")
        var cls = rtGlob.NewBlock("cls")
        var clsok = rtGlob.NewBlock("clsok")
        var nb = rtGlob.NewBlock("nb")
        var esc = rtGlob.NewBlock("esc")
        var escok = rtGlob.NewBlock("escok")
        var lit = rtGlob.NewBlock("lit")
        var litok = rtGlob.NewBlock("litok")
        var r0 = rtGlob.NewBlock("ret0")
        var r1 = rtGlob.NewBlock("ret1")
        var two = llvm.constant.NewInt(i32, 2)

        var pp = e.NewAlloca(i8ptr), sp = e.NewAlloca(i8ptr)
        e.NewStore(p0, pp); e.NewStore(s0, sp)
        e.NewBr(h)

        var pcur = h.NewLoad(i8ptr, pp)
        var pc = h.NewZExt(h.NewLoad(i8, h.NewGetElementPtr(i8, pcur, zero)), i32)
        // An extglob head has to be recognised BEFORE the plain "*" and "?" arms, or "*(x)"
        // and "?(x)" would be eaten as an ordinary star / any-char followed by a literal
        // paren. All five prefixes are only that when "(" is the very next byte.
        var heg = rtGlob.NewBlock("heg")
        var egb = rtGlob.NewBlock("egb")
        h.NewCondBr(h.NewICmp(llvm.enum.IPredEQ, pc, zero), pend, heg)
        var isPfx = heg.NewOr(heg.NewOr(heg.NewOr(
            heg.NewICmp(llvm.enum.IPredEQ, pc, llvm.constant.NewInt(i32, 64)),
            heg.NewICmp(llvm.enum.IPredEQ, pc, llvm.constant.NewInt(i32, 63))),
            heg.NewOr(heg.NewICmp(llvm.enum.IPredEQ, pc, llvm.constant.NewInt(i32, 42)),
                      heg.NewICmp(llvm.enum.IPredEQ, pc, llvm.constant.NewInt(i32, 43)))),
            heg.NewICmp(llvm.enum.IPredEQ, pc, llvm.constant.NewInt(i32, 33)))
        var nextc = heg.NewZExt(heg.NewLoad(i8, heg.NewGetElementPtr(i8, pcur, one)), i32)
        heg.NewCondBr(heg.NewAnd(isPfx, heg.NewICmp(llvm.enum.IPredEQ, nextc,
                                                    llvm.constant.NewInt(i32, 40))), egb, nostar)
        egb.NewRet(egb.NewCall(rtEg, [pcur, egb.NewLoad(i8ptr, sp), zero]))

        var sat = pend.NewZExt(pend.NewLoad(i8, pend.NewGetElementPtr(i8, pend.NewLoad(i8ptr, sp), zero)), i32)
        pend.NewCondBr(pend.NewICmp(llvm.enum.IPredEQ, sat, zero), r1, r0)

        nostar.NewCondBr(nostar.NewICmp(llvm.enum.IPredEQ, pc, llvm.constant.NewInt(i32, 42)), starsk, havec)

        // skip a run of "*"
        var sk = starsk.NewLoad(i8ptr, pp)
        var skc = starsk.NewZExt(starsk.NewLoad(i8, starsk.NewGetElementPtr(i8, sk, zero)), i32)
        var skadv = rtGlob.NewBlock("skadv")
        starsk.NewCondBr(starsk.NewICmp(llvm.enum.IPredEQ, skc, llvm.constant.NewInt(i32, 42)), skadv, staraf)
        skadv.NewStore(skadv.NewGetElementPtr(i8, sk, one), pp)
        skadv.NewBr(starsk)

        var pafter = staraf.NewLoad(i8ptr, pp)
        var pac = staraf.NewZExt(staraf.NewLoad(i8, staraf.NewGetElementPtr(i8, pafter, zero)), i32)
        staraf.NewCondBr(staraf.NewICmp(llvm.enum.IPredEQ, pac, zero), r1, kloop)

        var scur = kloop.NewLoad(i8ptr, sp)
        var rec = kloop.NewCall(rtGlob, [pafter, scur])
        kloop.NewCondBr(kloop.NewICmp(llvm.enum.IPredNE, rec, zero), r1, knext)
        var kc = knext.NewZExt(knext.NewLoad(i8, knext.NewGetElementPtr(i8, scur, zero)), i32)
        var kadv = rtGlob.NewBlock("kadv")
        knext.NewCondBr(knext.NewICmp(llvm.enum.IPredEQ, kc, zero), r0, kadv)
        kadv.NewStore(kadv.NewGetElementPtr(i8, scur, one), sp)
        kadv.NewBr(kloop)

        var scur2 = havec.NewLoad(i8ptr, sp)
        var sc = havec.NewZExt(havec.NewLoad(i8, havec.NewGetElementPtr(i8, scur2, zero)), i32)
        var havec2 = rtGlob.NewBlock("havec2")
        havec.NewCondBr(havec.NewICmp(llvm.enum.IPredEQ, sc, zero), r0, havec2)
        havec2.NewCondBr(havec2.NewICmp(llvm.enum.IPredEQ, pc, llvm.constant.NewInt(i32, 63)), qm, nq)

        qm.NewStore(qm.NewGetElementPtr(i8, pcur, one), pp)
        qm.NewStore(qm.NewGetElementPtr(i8, scur2, one), sp)
        qm.NewBr(h)

        nq.NewCondBr(nq.NewICmp(llvm.enum.IPredEQ, pc, llvm.constant.NewInt(i32, 91)), brk, nb)

        var cr = brk.NewCall(rtClass, [pcur, sc])
        brk.NewCondBr(brk.NewICmp(llvm.enum.IPredSLT, cr, zero), lit, cls)
        var matched = cls.NewAnd(cr, one)
        var off = cls.NewSDiv(cr, two)
        cls.NewCondBr(cls.NewICmp(llvm.enum.IPredEQ, matched, zero), r0, clsok)
        clsok.NewStore(clsok.NewGetElementPtr(i8, pcur, off), pp)
        clsok.NewStore(clsok.NewGetElementPtr(i8, scur2, one), sp)
        clsok.NewBr(h)

        var nc = nb.NewZExt(nb.NewLoad(i8, nb.NewGetElementPtr(i8, pcur, one)), i32)
        var isEsc = nb.NewAnd(nb.NewICmp(llvm.enum.IPredEQ, pc, llvm.constant.NewInt(i32, 92)),
                              nb.NewICmp(llvm.enum.IPredNE, nc, zero))
        nb.NewCondBr(isEsc, esc, lit)
        esc.NewCondBr(esc.NewICmp(llvm.enum.IPredEQ, nc, sc), escok, r0)
        escok.NewStore(escok.NewGetElementPtr(i8, pcur, two), pp)
        escok.NewStore(escok.NewGetElementPtr(i8, scur2, one), sp)
        escok.NewBr(h)

        lit.NewCondBr(lit.NewICmp(llvm.enum.IPredEQ, pc, sc), litok, r0)
        litok.NewStore(litok.NewGetElementPtr(i8, pcur, one), pp)
        litok.NewStore(litok.NewGetElementPtr(i8, scur2, one), sp)
        litok.NewBr(h)

        r0.NewRet(zero)
        r1.NewRet(one)
    })()

    // ---- substring / pattern / case helpers for the ${...} family --------------------
    // They are placed after rt_glob because every one of them drives the glob matcher over
    // candidate substrings; rt_substr materializes each candidate in the arena.

    // i8* rt_substr(i8* s, i32 off, i32 n): n < 0 means "to the end". off and n are clamped.
    var rtSubstr = m.NewFunc("rt_substr", i8ptr,
        [llvm.ir.NewParam("s", i8ptr), llvm.ir.NewParam("off", i32), llvm.ir.NewParam("n", i32)])
    ;(function() {
        var s0 = rtSubstr.Params[0], off0 = rtSubstr.Params[1], n0 = rtSubstr.Params[2]
        var e = rtSubstr.NewBlock("entry")
        var h = rtSubstr.NewBlock("head")
        var bd = rtSubstr.NewBlock("body")
        var x = rtSubstr.NewBlock("exit")
        var len = e.NewCall(rtStrlen, s0)
        var off = e.NewSelect(e.NewICmp(llvm.enum.IPredSLT, off0, zero), zero, off0)
        off = e.NewSelect(e.NewICmp(llvm.enum.IPredSGT, off, len), len, off)
        var rest = e.NewSub(len, off)
        var n = e.NewSelect(e.NewICmp(llvm.enum.IPredSLT, n0, zero), rest, n0)
        n = e.NewSelect(e.NewICmp(llvm.enum.IPredSGT, n, rest), rest, n)
        var dst = e.NewCall(rtBump, e.NewAdd(n, one))
        var ip = e.NewAlloca(i32)
        e.NewStore(zero, ip)
        e.NewBr(h)
        var i = h.NewLoad(i32, ip)
        h.NewCondBr(h.NewICmp(llvm.enum.IPredSLT, i, n), bd, x)
        bd.NewStore(bd.NewLoad(i8, bd.NewGetElementPtr(i8, s0, bd.NewAdd(off, i))),
                    bd.NewGetElementPtr(i8, dst, i))
        bd.NewStore(bd.NewAdd(i, one), ip)
        bd.NewBr(h)
        x.NewStore(zero8, x.NewGetElementPtr(i8, dst, n))
        x.NewRet(dst)
    })()

    // i8* rt_csubstr(i8* s, i32 off, i32 n): rt_substr with off and n in CHARACTERS,
    // which is what ${s:off:n} slices in bash. rt_substr itself stays byte-based -
    // every pattern helper above drives it over byte positions.
    var rtCSubstr = m.NewFunc("rt_csubstr", i8ptr,
        [llvm.ir.NewParam("s", i8ptr), llvm.ir.NewParam("off", i32), llvm.ir.NewParam("n", i32)])
    ;(function() {
        var s0 = rtCSubstr.Params[0], off0 = rtCSubstr.Params[1], n0 = rtCSubstr.Params[2]
        var e = rtCSubstr.NewBlock("entry")
        var bo = e.NewCall(rtCharOff, [s0, e.NewSelect(e.NewICmp(llvm.enum.IPredSLT, off0, zero), zero, off0)])
        // n < 0 means "to the end"; otherwise the end is off + n characters in.
        var bend = e.NewCall(rtCharOff, [s0, e.NewAdd(off0, e.NewSelect(
            e.NewICmp(llvm.enum.IPredSLT, n0, zero), zero, n0))])
        var byteN = e.NewSelect(e.NewICmp(llvm.enum.IPredSLT, n0, zero),
                                llvm.constant.NewInt(i32, -1), e.NewSub(bend, bo))
        byteN = e.NewSelect(e.NewICmp(llvm.enum.IPredSLT, byteN, zero),
                            llvm.constant.NewInt(i32, -1), byteN)
        e.NewRet(e.NewCall(rtSubstr, [s0, bo, byteN]))
    })()

    // ---- the extended globs @(a|b) ?(a|b) *(a|b) +(a|b) !(a|b) --------------------------
    //
    // Two scanners plus rt_eg. Both scanners count nested parens and step over a backslash
    // escape, so `@(a\)b|c)` splits where bash splits it.

    // i32 rt_egclose(i8* q): q points at "("; the offset from q of the MATCHING ")", or -1.
    var rtEgClose = m.NewFunc("rt_egclose", i32, llvm.ir.NewParam("ecq", i8ptr))
    ;(function() {
        var f = rtEgClose
        var q = f.Params[0]
        var e = f.NewBlock("ecent")
        var h = f.NewBlock("ech")
        var ip = e.NewAlloca(i32), dp = e.NewAlloca(i32)
        e.NewStore(zero, ip)
        e.NewStore(zero, dp)
        e.NewBr(h)
        var i = h.NewLoad(i32, ip)
        var c = h.NewZExt(h.NewLoad(i8, h.NewGetElementPtr(i8, q, i)), i32)
        var bad = f.NewBlock("ecbad"), h2 = f.NewBlock("ech2")
        h.NewCondBr(h.NewICmp(llvm.enum.IPredEQ, c, zero), bad, h2)
        bad.NewRet(llvm.constant.NewInt(i32, -1))
        var esc = f.NewBlock("ecesc"), h3 = f.NewBlock("ech3")
        h2.NewCondBr(h2.NewAnd(h2.NewICmp(llvm.enum.IPredEQ, c, llvm.constant.NewInt(i32, 92)),
                     h2.NewICmp(llvm.enum.IPredNE,
                       h2.NewZExt(h2.NewLoad(i8, h2.NewGetElementPtr(i8, q, h2.NewAdd(i, one))), i32),
                       zero)), esc, h3)
        esc.NewStore(esc.NewAdd(i, llvm.constant.NewInt(i32, 2)), ip)
        esc.NewBr(h)
        var nx = f.NewBlock("ecnext")
        var opn = f.NewBlock("ecopen"), h4 = f.NewBlock("ech4")
        h3.NewCondBr(h3.NewICmp(llvm.enum.IPredEQ, c, llvm.constant.NewInt(i32, 40)), opn, h4)
        opn.NewStore(opn.NewAdd(opn.NewLoad(i32, dp), one), dp)
        opn.NewBr(nx)
        var cls = f.NewBlock("ecclose")
        h4.NewCondBr(h4.NewICmp(llvm.enum.IPredEQ, c, llvm.constant.NewInt(i32, 41)), cls, nx)
        var d2 = cls.NewSub(cls.NewLoad(i32, dp), one)
        cls.NewStore(d2, dp)
        var hit = f.NewBlock("echit")
        cls.NewCondBr(cls.NewICmp(llvm.enum.IPredEQ, d2, zero), hit, nx)
        hit.NewRet(i)
        nx.NewStore(nx.NewAdd(i, one), ip)
        nx.NewBr(h)
    })()

    // i32 rt_egalt(i8* q, i32 a): q points at "(" and a is the offset of an alternative's
    // first byte; the offset of its terminator - a "|" at depth 0, or the group's own ")".
    var rtEgAlt = m.NewFunc("rt_egalt", i32,
        [llvm.ir.NewParam("eaq", i8ptr), llvm.ir.NewParam("eaa", i32)])
    ;(function() {
        var f = rtEgAlt
        var q = f.Params[0]
        var e = f.NewBlock("eaent")
        var h = f.NewBlock("eah")
        var ip = e.NewAlloca(i32), dp = e.NewAlloca(i32)
        e.NewStore(f.Params[1], ip)
        e.NewStore(zero, dp)
        e.NewBr(h)
        var i = h.NewLoad(i32, ip)
        var c = h.NewZExt(h.NewLoad(i8, h.NewGetElementPtr(i8, q, i)), i32)
        var stop = f.NewBlock("eastop"), h2 = f.NewBlock("eah2")
        h.NewCondBr(h.NewICmp(llvm.enum.IPredEQ, c, zero), stop, h2)
        stop.NewRet(i)
        var esc = f.NewBlock("eaesc"), h3 = f.NewBlock("eah3")
        h2.NewCondBr(h2.NewAnd(h2.NewICmp(llvm.enum.IPredEQ, c, llvm.constant.NewInt(i32, 92)),
                     h2.NewICmp(llvm.enum.IPredNE,
                       h2.NewZExt(h2.NewLoad(i8, h2.NewGetElementPtr(i8, q, h2.NewAdd(i, one))), i32),
                       zero)), esc, h3)
        esc.NewStore(esc.NewAdd(i, llvm.constant.NewInt(i32, 2)), ip)
        esc.NewBr(h)
        var nx = f.NewBlock("eanext")
        var opn = f.NewBlock("eaopen"), h4 = f.NewBlock("eah4")
        h3.NewCondBr(h3.NewICmp(llvm.enum.IPredEQ, c, llvm.constant.NewInt(i32, 40)), opn, h4)
        opn.NewStore(opn.NewAdd(opn.NewLoad(i32, dp), one), dp)
        opn.NewBr(nx)
        var d = h4.NewLoad(i32, dp)
        var cls = f.NewBlock("eaclose"), h5 = f.NewBlock("eah5")
        h4.NewCondBr(h4.NewICmp(llvm.enum.IPredEQ, c, llvm.constant.NewInt(i32, 41)), cls, h5)
        var atTop = f.NewBlock("eatop"), dec = f.NewBlock("eadec")
        cls.NewCondBr(cls.NewICmp(llvm.enum.IPredEQ, d, zero), atTop, dec)
        atTop.NewRet(i)
        dec.NewStore(dec.NewSub(d, one), dp)
        dec.NewBr(nx)
        h5.NewCondBr(h5.NewAnd(h5.NewICmp(llvm.enum.IPredEQ, c, llvm.constant.NewInt(i32, 124)),
                               h5.NewICmp(llvm.enum.IPredEQ, d, zero)), atTop, nx)
        nx.NewStore(nx.NewAdd(i, one), ip)
        nx.NewBr(h)
    })()

    // i32 rt_eg(i8* p, i8* s, i32 star): p points at the prefix character of an extglob and
    // s at the subject; 1 when p (group AND everything after it) matches all of s.
    //
    // Each alternative is tried against every PREFIX of the subject and the rest of the
    // pattern against what is left - the same "split and recurse" shape rt_glob already uses
    // for "*", with the IR call stack as the backtracking stack. `star` is the +(...)
    // continuation: after one mandatory occurrence the group carries on with *(...)
    // semantics, and because a repeat must consume at least one byte the recursion is finite.
    //   @(A|B)  exactly one alternative        !(A|B)  a prefix NO alternative matches
    //   ?(A|B)  zero or one                    *(A|B)  zero or more
    //   +(A|B)  one or more
    ;(function() {
        var f = rtEg
        var p = f.Params[0], s = f.Params[1], star = f.Params[2]
        var e = f.NewBlock("egent")
        var kind = e.NewSelect(e.NewICmp(llvm.enum.IPredNE, star, zero),
                               llvm.constant.NewInt(i32, 42),
                               e.NewZExt(e.NewLoad(i8, e.NewGetElementPtr(i8, p, zero)), i32))
        var open = e.NewGetElementPtr(i8, p, one)
        var clo = e.NewCall(rtEgClose, open)
        var bad = f.NewBlock("egbad"), ok = f.NewBlock("egok")
        e.NewCondBr(e.NewICmp(llvm.enum.IPredSLT, clo, zero), bad, ok)
        bad.NewRet(zero)
        var rest = ok.NewGetElementPtr(i8, p, ok.NewAdd(clo, llvm.constant.NewInt(i32, 2)))
        var slen = ok.NewCall(rtStrlen, s)
        function isk(b, v) { return b.NewICmp(llvm.enum.IPredEQ, kind, llvm.constant.NewInt(i32, v)) }
        var isBang = isk(ok, 33)
        var isAt = isk(ok, 64), isQ = isk(ok, 63)
        var zeroOk = ok.NewOr(isQ, isk(ok, 42))
        var one1 = ok.NewOr(isAt, isQ)              // exactly one occurrence, so k may be 0
        var ret1 = f.NewBlock("egret1"), ret0 = f.NewBlock("egret0")
        ret1.NewRet(one)
        ret0.NewRet(zero)
        var bang = f.NewBlock("egbang"), pos = f.NewBlock("egpos")
        ok.NewCondBr(isBang, bang, pos)

        // ---- @ ? * + : zero occurrences first (? and *), then one alternative at a time.
        var z1 = f.NewBlock("egz1"), z2 = f.NewBlock("egz2")
        pos.NewCondBr(zeroOk, z1, z2)
        z1.NewCondBr(z1.NewICmp(llvm.enum.IPredNE, z1.NewCall(rtGlob, [rest, s]), zero), ret1, z2)
        var minK = z2.NewSelect(one1, zero, one)
        var ap = e.NewAlloca(i32), kp = e.NewAlloca(i32)
        var ah = f.NewBlock("egah"), abody = f.NewBlock("egab"), adone = f.NewBlock("egad")
        z2.NewStore(one, ap)
        z2.NewBr(ah)
        var a = ah.NewLoad(i32, ap)
        ah.NewCondBr(ah.NewICmp(llvm.enum.IPredSLT, a, clo), abody, adone)
        var aend = abody.NewCall(rtEgAlt, [open, a])
        var alt = abody.NewCall(rtSubstr, [abody.NewGetElementPtr(i8, open, a), zero,
                                           abody.NewSub(aend, a)])
        var kx = reFor(f, "egk", abody, kp, minK, abody.NewAdd(slen, one), function(b, k) {
            var m1 = f.NewBlock("egm1"), cont = f.NewBlock("egkc")
            var pre = b.NewCall(rtSubstr, [s, zero, k])
            b.NewCondBr(b.NewICmp(llvm.enum.IPredNE, b.NewCall(rtGlob, [alt, pre]), zero), m1, cont)
            var m2 = f.NewBlock("egm2"), m3 = f.NewBlock("egm3")
            m1.NewCondBr(one1, m2, m3)
            var tail = m2.NewGetElementPtr(i8, s, k)
            m2.NewCondBr(m2.NewICmp(llvm.enum.IPredNE, m2.NewCall(rtGlob, [rest, tail]), zero),
                         ret1, cont)
            // a * / + repeat must consume something, or the recursion would not terminate
            var t3 = m3.NewGetElementPtr(i8, s, k)
            m3.NewCondBr(m3.NewAnd(m3.NewICmp(llvm.enum.IPredSGT, k, zero),
                         m3.NewICmp(llvm.enum.IPredNE, m3.NewCall(rtEg, [p, t3, one]), zero)),
                         ret1, cont)
            return cont
        })
        var anx = f.NewBlock("egan"), aend2 = f.NewBlock("egae")
        kx.NewCondBr(kx.NewICmp(llvm.enum.IPredEQ,
                       kx.NewZExt(kx.NewLoad(i8, kx.NewGetElementPtr(i8, open, aend)), i32),
                       llvm.constant.NewInt(i32, 41)), aend2, anx)
        aend2.NewBr(adone)
        anx.NewStore(anx.NewAdd(aend, one), ap)
        anx.NewBr(ah)
        adone.NewRet(zero)

        // ---- ! : a prefix that NO alternative matches, with the rest matching what is left.
        var bp = e.NewAlloca(i32), bap = e.NewAlloca(i32), anyp = e.NewAlloca(i32)
        var bx = reFor(f, "egb", bang, bp, zero, bang.NewAdd(slen, one), function(b, k) {
            b.NewStore(zero, anyp)
            b.NewStore(one, bap)
            // NOT "egbh"/"egbb": reForG derives its own header and body labels from the
            // tag ("egb" -> egbh/egbb/egbx), and a duplicate label is invalid LLVM that
            // llvm.Run resolves by handle and runs anyway. clang caught this one.
            var bh = f.NewBlock("egb2h"), bb = f.NewBlock("egb2b"), bd2 = f.NewBlock("egb2d")
            b.NewBr(bh)
            var ba = bh.NewLoad(i32, bap)
            bh.NewCondBr(bh.NewICmp(llvm.enum.IPredSLT, ba, clo), bb, bd2)
            var be = bb.NewCall(rtEgAlt, [open, ba])
            var balt = bb.NewCall(rtSubstr, [bb.NewGetElementPtr(i8, open, ba), zero,
                                             bb.NewSub(be, ba)])
            var bpre = bb.NewCall(rtSubstr, [s, zero, k])
            bb.NewStore(bb.NewSelect(bb.NewICmp(llvm.enum.IPredNE,
                          bb.NewCall(rtGlob, [balt, bpre]), zero), one, bb.NewLoad(i32, anyp)), anyp)
            var bn = f.NewBlock("egb2n"), be2 = f.NewBlock("egb2e")
            bb.NewCondBr(bb.NewICmp(llvm.enum.IPredEQ,
                           bb.NewZExt(bb.NewLoad(i8, bb.NewGetElementPtr(i8, open, be)), i32),
                           llvm.constant.NewInt(i32, 41)), be2, bn)
            be2.NewBr(bd2)
            bn.NewStore(bn.NewAdd(be, one), bap)
            bn.NewBr(bh)
            var cont2 = f.NewBlock("egb2c")
            var btail = bd2.NewGetElementPtr(i8, s, k)
            bd2.NewCondBr(bd2.NewAnd(bd2.NewICmp(llvm.enum.IPredEQ, bd2.NewLoad(i32, anyp), zero),
                            bd2.NewICmp(llvm.enum.IPredNE, bd2.NewCall(rtGlob, [rest, btail]), zero)),
                          ret1, cont2)
            return cont2
        })
        bx.NewBr(ret0)
    })()

    // i32 rt_matchlen(i8* pat, i8* s, i32 i): end index of the LONGEST match of pat starting
    // at i, or -1.
    var rtMatchLen = m.NewFunc("rt_matchlen", i32,
        [llvm.ir.NewParam("p", i8ptr), llvm.ir.NewParam("s", i8ptr), llvm.ir.NewParam("i", i32)])
    ;(function() {
        var pt = rtMatchLen.Params[0], s0 = rtMatchLen.Params[1], i0 = rtMatchLen.Params[2]
        var e = rtMatchLen.NewBlock("entry")
        var h = rtMatchLen.NewBlock("head")
        var bd = rtMatchLen.NewBlock("body")
        var hit = rtMatchLen.NewBlock("hit")
        var no = rtMatchLen.NewBlock("no")
        var jp = e.NewAlloca(i32)
        e.NewStore(e.NewCall(rtStrlen, s0), jp)
        e.NewBr(h)
        var j = h.NewLoad(i32, jp)
        h.NewCondBr(h.NewICmp(llvm.enum.IPredSLT, j, i0), no, bd)
        var cand = bd.NewCall(rtSubstr, [s0, i0, bd.NewSub(j, i0)])
        var st = rtMatchLen.NewBlock("step")
        bd.NewCondBr(bd.NewICmp(llvm.enum.IPredNE, bd.NewCall(rtGlob, [pt, cand]), zero), hit, st)
        st.NewStore(st.NewSub(j, one), jp)
        st.NewBr(h)
        hit.NewRet(j)
        no.NewRet(llvm.constant.NewInt(i32, -1))
    })()

    // i32 rt_matchend(i8* pat, i8* s): start index of the LONGEST match of pat that reaches
    // the end of s, or -1.
    var rtMatchEnd = m.NewFunc("rt_matchend", i32,
        [llvm.ir.NewParam("p", i8ptr), llvm.ir.NewParam("s", i8ptr)])
    ;(function() {
        var pt = rtMatchEnd.Params[0], s0 = rtMatchEnd.Params[1]
        var e = rtMatchEnd.NewBlock("entry")
        var h = rtMatchEnd.NewBlock("head")
        var bd = rtMatchEnd.NewBlock("body")
        var st = rtMatchEnd.NewBlock("step")
        var hit = rtMatchEnd.NewBlock("hit")
        var no = rtMatchEnd.NewBlock("no")
        var len = e.NewCall(rtStrlen, s0)
        var ip = e.NewAlloca(i32)
        e.NewStore(zero, ip)
        e.NewBr(h)
        var i = h.NewLoad(i32, ip)
        h.NewCondBr(h.NewICmp(llvm.enum.IPredSGT, i, len), no, bd)
        var cand = bd.NewCall(rtSubstr, [s0, i, llvm.constant.NewInt(i32, -1)])
        bd.NewCondBr(bd.NewICmp(llvm.enum.IPredNE, bd.NewCall(rtGlob, [pt, cand]), zero), hit, st)
        st.NewStore(st.NewAdd(i, one), ip)
        st.NewBr(h)
        hit.NewRet(i)
        no.NewRet(llvm.constant.NewInt(i32, -1))
    })()

    // i8* rt_strip(i8* s, i8* pat, i32 mode): 0 = #, 1 = ##, 2 = %, 3 = %%.
    var rtStrip = m.NewFunc("rt_strip", i8ptr,
        [llvm.ir.NewParam("s", i8ptr), llvm.ir.NewParam("p", i8ptr), llvm.ir.NewParam("mode", i32)])
    ;(function() {
        var s0 = rtStrip.Params[0], pt = rtStrip.Params[1], md = rtStrip.Params[2]
        var e = rtStrip.NewBlock("entry")
        var h = rtStrip.NewBlock("head")
        var bd = rtStrip.NewBlock("body")
        var st = rtStrip.NewBlock("step")
        var hit = rtStrip.NewBlock("hit")
        var no = rtStrip.NewBlock("no")
        var len = e.NewCall(rtStrlen, s0)
        var isPre = e.NewOr(e.NewICmp(llvm.enum.IPredEQ, md, zero), e.NewICmp(llvm.enum.IPredEQ, md, one))
        // ascending k for # and %%, descending for ## and %
        var asc = e.NewOr(e.NewICmp(llvm.enum.IPredEQ, md, zero),
                          e.NewICmp(llvm.enum.IPredEQ, md, llvm.constant.NewInt(i32, 3)))
        var tp = e.NewAlloca(i32)
        var kp = e.NewAlloca(i32)
        e.NewStore(zero, tp)
        e.NewBr(h)
        var t = h.NewLoad(i32, tp)
        h.NewCondBr(h.NewICmp(llvm.enum.IPredSGT, t, len), no, bd)
        var k = bd.NewSelect(asc, t, bd.NewSub(len, t))
        bd.NewStore(k, kp)
        var pre = bd.NewCall(rtSubstr, [s0, zero, k])
        var suf = bd.NewCall(rtSubstr, [s0, k, llvm.constant.NewInt(i32, -1)])
        var cand = bd.NewSelect(isPre, pre, suf)
        bd.NewCondBr(bd.NewICmp(llvm.enum.IPredNE, bd.NewCall(rtGlob, [pt, cand]), zero), hit, st)
        st.NewStore(st.NewAdd(t, one), tp)
        st.NewBr(h)
        var k2 = hit.NewLoad(i32, kp)
        var rpre = hit.NewCall(rtSubstr, [s0, k2, llvm.constant.NewInt(i32, -1)])
        var rsuf = hit.NewCall(rtSubstr, [s0, zero, k2])
        hit.NewRet(hit.NewSelect(isPre, rpre, rsuf))
        no.NewRet(s0)
    })()

    // i8* rt_replace(i8* s, i8* pat, i8* rep, i32 mode): 0 = first, 1 = all, 2 = anchored at
    // the start (#), 3 = anchored at the end (%).
    var rtReplace = m.NewFunc("rt_replace", i8ptr,
        [llvm.ir.NewParam("s", i8ptr), llvm.ir.NewParam("p", i8ptr),
         llvm.ir.NewParam("r", i8ptr), llvm.ir.NewParam("mode", i32)])
    ;(function() {
        var s0 = rtReplace.Params[0], pt = rtReplace.Params[1], rp = rtReplace.Params[2], md = rtReplace.Params[3]
        var three = llvm.constant.NewInt(i32, 3)
        var two = llvm.constant.NewInt(i32, 2)
        var e = rtReplace.NewBlock("entry")
        var anch = rtReplace.NewBlock("anchored")
        var aHash = rtReplace.NewBlock("a_hash")
        var aPct = rtReplace.NewBlock("a_pct")
        var scan = rtReplace.NewBlock("scan")
        var h = rtReplace.NewBlock("head")
        var bd = rtReplace.NewBlock("body")
        var took = rtReplace.NewBlock("took")
        var copy1 = rtReplace.NewBlock("copy1")
        var stop = rtReplace.NewBlock("stop")
        var fin = rtReplace.NewBlock("fin")
        var len = e.NewCall(rtStrlen, s0)
        var outp = e.NewAlloca(i8ptr)
        var ip = e.NewAlloca(i32)
        var donep = e.NewAlloca(i32)
        e.NewStore(emptyPtr(e), outp)
        e.NewStore(zero, ip)
        e.NewStore(zero, donep)
        e.NewCondBr(e.NewICmp(llvm.enum.IPredSGE, md, two), anch, scan)

        anch.NewCondBr(anch.NewICmp(llvm.enum.IPredEQ, md, two), aHash, aPct)
        var jj = aHash.NewCall(rtMatchLen, [pt, s0, zero])
        var okH = rtReplace.NewBlock("ok_hash"), noH = rtReplace.NewBlock("no_hash")
        aHash.NewCondBr(aHash.NewICmp(llvm.enum.IPredSLT, jj, zero), noH, okH)
        okH.NewRet(okH.NewCall(rtStrcat, [rp, okH.NewCall(rtSubstr, [s0, jj, llvm.constant.NewInt(i32, -1)])]))
        noH.NewRet(s0)
        var ii = aPct.NewCall(rtMatchEnd, [pt, s0])
        var okP = rtReplace.NewBlock("ok_pct"), noP = rtReplace.NewBlock("no_pct")
        aPct.NewCondBr(aPct.NewICmp(llvm.enum.IPredSLT, ii, zero), noP, okP)
        okP.NewRet(okP.NewCall(rtStrcat, [okP.NewCall(rtSubstr, [s0, zero, ii]), rp]))
        noP.NewRet(s0)

        scan.NewBr(h)
        var i = h.NewLoad(i32, ip)
        var over = h.NewICmp(llvm.enum.IPredSGT, i, len)
        var dn = h.NewICmp(llvm.enum.IPredNE, h.NewLoad(i32, donep), zero)
        h.NewCondBr(h.NewOr(over, dn), fin, bd)
        var j = bd.NewCall(rtMatchLen, [pt, s0, i])
        bd.NewCondBr(bd.NewICmp(llvm.enum.IPredSGT, j, i), took, copy1)
        // a real (non empty) match: append the replacement and jump past it
        took.NewStore(took.NewCall(rtStrcat, [took.NewLoad(i8ptr, outp), rp]), outp)
        took.NewStore(j, ip)
        took.NewCondBr(took.NewICmp(llvm.enum.IPredEQ, md, zero), stop, h)
        stop.NewStore(stop.NewCall(rtStrcat, [stop.NewLoad(i8ptr, outp),
                        stop.NewCall(rtSubstr, [s0, j, llvm.constant.NewInt(i32, -1)])]), outp)
        stop.NewStore(one, donep)
        stop.NewBr(h)
        // no match here: carry one character across
        copy1.NewStore(copy1.NewCall(rtStrcat, [copy1.NewLoad(i8ptr, outp),
                        copy1.NewCall(rtSubstr, [s0, i, one])]), outp)
        copy1.NewStore(copy1.NewAdd(i, one), ip)
        copy1.NewBr(h)
        fin.NewRet(fin.NewLoad(i8ptr, outp))
    })()

    // i8* rt_case(i8* s, i32 mode): 0 = ^, 1 = ^^, 2 = ",", 3 = ",,".
    var rtCase = m.NewFunc("rt_case", i8ptr, [llvm.ir.NewParam("s", i8ptr), llvm.ir.NewParam("mode", i32)])
    ;(function() {
        var s0 = rtCase.Params[0], md = rtCase.Params[1]
        var e = rtCase.NewBlock("entry")
        var h = rtCase.NewBlock("head")
        var bd = rtCase.NewBlock("body")
        var x = rtCase.NewBlock("exit")
        var len = e.NewCall(rtStrlen, s0)
        var dst = e.NewCall(rtBump, e.NewAdd(len, one))
        var up = e.NewICmp(llvm.enum.IPredSLT, md, llvm.constant.NewInt(i32, 2))
        var all = e.NewOr(e.NewICmp(llvm.enum.IPredEQ, md, one),
                          e.NewICmp(llvm.enum.IPredEQ, md, llvm.constant.NewInt(i32, 3)))
        var ip = e.NewAlloca(i32)
        e.NewStore(zero, ip)
        e.NewBr(h)
        var i = h.NewLoad(i32, ip)
        h.NewCondBr(h.NewICmp(llvm.enum.IPredSLT, i, len), bd, x)
        var c0 = bd.NewZExt(bd.NewLoad(i8, bd.NewGetElementPtr(i8, s0, i)), i32)
        var isLow = bd.NewAnd(bd.NewICmp(llvm.enum.IPredSGE, c0, llvm.constant.NewInt(i32, 97)),
                              bd.NewICmp(llvm.enum.IPredSLE, c0, llvm.constant.NewInt(i32, 122)))
        var isUp = bd.NewAnd(bd.NewICmp(llvm.enum.IPredSGE, c0, llvm.constant.NewInt(i32, 65)),
                             bd.NewICmp(llvm.enum.IPredSLE, c0, llvm.constant.NewInt(i32, 90)))
        var raised = bd.NewSelect(isLow, bd.NewSub(c0, llvm.constant.NewInt(i32, 32)), c0)
        var lowered = bd.NewSelect(isUp, bd.NewAdd(c0, llvm.constant.NewInt(i32, 32)), c0)
        var mapped = bd.NewSelect(up, raised, lowered)
        var touch = bd.NewOr(all, bd.NewICmp(llvm.enum.IPredEQ, i, zero))
        bd.NewStore(bd.NewTrunc(bd.NewSelect(touch, mapped, c0), i8), bd.NewGetElementPtr(i8, dst, i))
        bd.NewStore(bd.NewAdd(i, one), ip)
        bd.NewBr(h)
        x.NewStore(zero8, x.NewGetElementPtr(i8, dst, len))
        x.NewRet(dst)
    })()

    // i8* rt_shquote(i8* s): the ${v@Q} / ${v@K} / ${v@k} form - s quoted so the shell would
    // read it back unchanged. Mirrors bash-interpreter.abnf's shellQuote: single quotes
    // normally, with an embedded ' spelled '\'', and the $'...' form as soon as the value
    // holds a control character, where the C escapes bash prints are used.
    var rtShQuote = m.NewFunc("rt_shquote", i8ptr, llvm.ir.NewParam("sq", i8ptr))
    ;(function() {
        var f = rtShQuote
        var s0 = f.Params[0]
        var e = f.NewBlock("sqent")
        var len = e.NewCall(rtStrlen, s0)
        // 4 bytes per input byte is the worst case ('\'' and \xNN alike), plus $'' and NUL.
        var dst = e.NewCall(rtBump, e.NewAdd(e.NewMul(len, llvm.constant.NewInt(i32, 4)),
                                             llvm.constant.NewInt(i32, 8)))
        var op = e.NewAlloca(i32), ip = e.NewAlloca(i32), ctlp = e.NewAlloca(i32)
        e.NewStore(zero, op)
        e.NewStore(zero, ctlp)
        function put(b, ch) {
            var o = b.NewLoad(i32, op)
            b.NewStore(b.NewTrunc(ch, i8), b.NewGetElementPtr(i8, dst, o))
            b.NewStore(b.NewAdd(o, one), op)
        }
        function putK(b, n) { put(b, llvm.constant.NewInt(i32, n)) }
        // pass 1: is there a control character?
        var cx = reFor(f, "sqscan", e, ip, zero, len, function(b, i) {
            var c0 = b.NewZExt(b.NewLoad(i8, b.NewGetElementPtr(i8, s0, i)), i32)
            var isCtl = b.NewOr(b.NewICmp(llvm.enum.IPredSLT, c0, llvm.constant.NewInt(i32, 32)),
                                b.NewICmp(llvm.enum.IPredEQ, c0, llvm.constant.NewInt(i32, 127)))
            b.NewStore(b.NewSelect(isCtl, one, b.NewLoad(i32, ctlp)), ctlp)
            return b
        })
        var plain = f.NewBlock("sqplain"), ansi = f.NewBlock("sqansi"), done = f.NewBlock("sqdone")
        cx.NewCondBr(cx.NewICmp(llvm.enum.IPredNE, cx.NewLoad(i32, ctlp), zero), ansi, plain)

        putK(plain, 39)
        var jp = e.NewAlloca(i32)
        var px = reFor(f, "sqp", plain, jp, zero, len, function(b, i) {
            var c0 = b.NewZExt(b.NewLoad(i8, b.NewGetElementPtr(i8, s0, i)), i32)
            var q = f.NewBlock("sqpq"), n = f.NewBlock("sqpn"), j = f.NewBlock("sqpj")
            b.NewCondBr(b.NewICmp(llvm.enum.IPredEQ, c0, llvm.constant.NewInt(i32, 39)), q, n)
            putK(q, 39); putK(q, 92); putK(q, 39); putK(q, 39)
            q.NewBr(j)
            put(n, c0)
            n.NewBr(j)
            return j
        })
        putK(px, 39)
        px.NewBr(done)

        putK(ansi, 36); putK(ansi, 39)
        var kp = e.NewAlloca(i32)
        var ax = reFor(f, "sqa", ansi, kp, zero, len, function(b, i) {
            var c0 = b.NewZExt(b.NewLoad(i8, b.NewGetElementPtr(i8, s0, i)), i32)
            var j = f.NewBlock("sqaj")
            var nb = b
            var an = 0
            function esc(code, letter) {
                an = an + 1
                var hit = f.NewBlock("sqah" + an)
                var nx = f.NewBlock("sqan" + an)
                nb.NewCondBr(nb.NewICmp(llvm.enum.IPredEQ, c0, llvm.constant.NewInt(i32, code)), hit, nx)
                putK(hit, 92); putK(hit, letter)
                hit.NewBr(j)
                nb = nx
            }
            esc(39, 39)   // \'
            esc(92, 92)   // backslash
            esc(7, 97)    // \a
            esc(8, 98)    // \b
            esc(9, 116)   // \t
            esc(10, 110)  // \n
            esc(11, 118)  // \v
            esc(12, 102)  // \f
            esc(13, 114)  // \r
            var hx = f.NewBlock("sqahex"), lit = f.NewBlock("sqalit")
            nb.NewCondBr(nb.NewOr(nb.NewICmp(llvm.enum.IPredSLT, c0, llvm.constant.NewInt(i32, 32)),
                                  nb.NewICmp(llvm.enum.IPredEQ, c0, llvm.constant.NewInt(i32, 127))),
                         hx, lit)
            putK(hx, 92); putK(hx, 120)
            var hi = hx.NewSDiv(c0, llvm.constant.NewInt(i32, 16))
            var lo = hx.NewSRem(c0, llvm.constant.NewInt(i32, 16))
            function hexd(b, v) {
                return b.NewSelect(b.NewICmp(llvm.enum.IPredSLT, v, ten),
                                   b.NewAdd(v, llvm.constant.NewInt(i32, 48)),
                                   b.NewAdd(v, llvm.constant.NewInt(i32, 87)))
            }
            put(hx, hexd(hx, hi))
            put(hx, hexd(hx, lo))
            hx.NewBr(j)
            put(lit, c0)
            lit.NewBr(j)
            return j
        })
        putK(ax, 39)
        ax.NewBr(done)

        done.NewStore(zero8, done.NewGetElementPtr(i8, dst, done.NewLoad(i32, op)))
        done.NewRet(dst)
    })()

    // i8* rt_ansic(i8* s): the ${v@E} form - the $'...' escapes decoded at RUN time.
    var rtAnsiC = m.NewFunc("rt_ansic", i8ptr, llvm.ir.NewParam("ac", i8ptr))
    ;(function() {
        var f = rtAnsiC
        var s0 = f.Params[0]
        var e = f.NewBlock("acent")
        var h = f.NewBlock("ach")
        var bd = f.NewBlock("acb")
        var x = f.NewBlock("acx")
        var len = e.NewCall(rtStrlen, s0)
        var dst = e.NewCall(rtBump, e.NewAdd(len, one))
        var ip = e.NewAlloca(i32), op = e.NewAlloca(i32)
        e.NewStore(zero, ip)
        e.NewStore(zero, op)
        e.NewBr(h)
        var i = h.NewLoad(i32, ip)
        h.NewCondBr(h.NewICmp(llvm.enum.IPredSLT, i, len), bd, x)
        var c0 = bd.NewZExt(bd.NewLoad(i8, bd.NewGetElementPtr(i8, s0, i)), i32)
        var c1 = bd.NewZExt(bd.NewLoad(i8, bd.NewGetElementPtr(i8, s0,
                    bd.NewSelect(bd.NewICmp(llvm.enum.IPredSLT, bd.NewAdd(i, one), len),
                                 bd.NewAdd(i, one), i))), i32)
        var esc = f.NewBlock("acesc"), lit = f.NewBlock("aclit")
        bd.NewCondBr(bd.NewAnd(bd.NewICmp(llvm.enum.IPredEQ, c0, llvm.constant.NewInt(i32, 92)),
                               bd.NewICmp(llvm.enum.IPredSLT, bd.NewAdd(i, one), len)), esc, lit)
        var mapped = c1
        function em(code, out) {
            mapped = esc.NewSelect(esc.NewICmp(llvm.enum.IPredEQ, c1, llvm.constant.NewInt(i32, code)),
                                   llvm.constant.NewInt(i32, out), mapped)
        }
        em(97, 7); em(98, 8); em(116, 9); em(110, 10)
        em(118, 11); em(102, 12); em(114, 13); em(101, 27); em(69, 27)
        esc.NewStore(esc.NewTrunc(mapped, i8), esc.NewGetElementPtr(i8, dst, esc.NewLoad(i32, op)))
        esc.NewStore(esc.NewAdd(esc.NewLoad(i32, op), one), op)
        esc.NewStore(esc.NewAdd(i, llvm.constant.NewInt(i32, 2)), ip)
        esc.NewBr(h)
        lit.NewStore(lit.NewTrunc(c0, i8), lit.NewGetElementPtr(i8, dst, lit.NewLoad(i32, op)))
        lit.NewStore(lit.NewAdd(lit.NewLoad(i32, op), one), op)
        lit.NewStore(lit.NewAdd(i, one), ip)
        lit.NewBr(h)
        x.NewStore(zero8, x.NewGetElementPtr(i8, dst, x.NewLoad(i32, op)))
        x.NewRet(dst)
    })()

    // i32 rt_haschar(i8* s, i32 ch): is ch one of the characters of s?
    var rtHasChar = m.NewFunc("rt_haschar", i32, [llvm.ir.NewParam("s", i8ptr), llvm.ir.NewParam("ch", i32)])
    ;(function() {
        var s0 = rtHasChar.Params[0], ch = rtHasChar.Params[1]
        var e = rtHasChar.NewBlock("entry")
        var h = rtHasChar.NewBlock("head")
        var st = rtHasChar.NewBlock("step")
        var yes = rtHasChar.NewBlock("yes")
        var no = rtHasChar.NewBlock("no")
        var ip = e.NewAlloca(i32)
        e.NewStore(zero, ip)
        e.NewBr(h)
        var i = h.NewLoad(i32, ip)
        var c0 = h.NewZExt(h.NewLoad(i8, h.NewGetElementPtr(i8, s0, i)), i32)
        h.NewCondBr(h.NewICmp(llvm.enum.IPredEQ, c0, zero), no, st)
        var nx = rtHasChar.NewBlock("next")
        st.NewCondBr(st.NewICmp(llvm.enum.IPredEQ, c0, ch), yes, nx)
        nx.NewStore(nx.NewAdd(i, one), ip)
        nx.NewBr(h)
        yes.NewRet(one)
        no.NewRet(zero)
    })()

    // i8* rt_read_line(i32): the next line of @stdin_buf (without its newline), advancing
    // @stdin_pos. Returns a null-marked empty string and leaves the position at the end when
    // there is nothing left; rt_read_eof answers whether that happened.
    var gReadEof = m.NewGlobalDef("read_eof", zero)
    var rtReadLine = m.NewFunc("rt_read_line", i8ptr, llvm.ir.NewParam("u", i32))
    ;(function() {
        var e = rtReadLine.NewBlock("entry")
        var eof = rtReadLine.NewBlock("eof")
        var go = rtReadLine.NewBlock("go")
        var h = rtReadLine.NewBlock("head")
        var st = rtReadLine.NewBlock("step")
        var dn = rtReadLine.NewBlock("done")
        var buf = e.NewLoad(i8ptr, gStdin)
        var pos = e.NewLoad(i32, gStdinPos)
        var len = e.NewCall(rtStrlen, buf)
        e.NewStore(zero, gReadEof)
        e.NewCondBr(e.NewICmp(llvm.enum.IPredSGE, pos, len), eof, go)
        eof.NewStore(one, gReadEof)
        eof.NewRet(emptyPtr(eof))
        var ep = go.NewAlloca(i32)
        go.NewStore(pos, ep)
        go.NewBr(h)
        var k = h.NewLoad(i32, ep)
        var atEnd = h.NewICmp(llvm.enum.IPredSGE, k, len)
        var ch = h.NewLoad(i8, h.NewGetElementPtr(i8, buf, k))
        var isNL = h.NewICmp(llvm.enum.IPredEQ, ch, llvm.constant.NewInt(i8, 10))
        h.NewCondBr(h.NewOr(atEnd, isNL), dn, st)
        st.NewStore(st.NewAdd(k, one), ep)
        st.NewBr(h)
        var k2 = dn.NewLoad(i32, ep)
        var line = dn.NewCall(rtSubstr, [buf, pos, dn.NewSub(k2, pos)])
        var past = dn.NewSelect(dn.NewICmp(llvm.enum.IPredSLT, k2, len), dn.NewAdd(k2, one), k2)
        dn.NewStore(past, gStdinPos)
        dn.NewRet(line)
    })()

    // i8* rt_field(i8* line, i8* ifs, i32 idx, i32 rest): field `idx` of line split on the
    // characters of ifs (empty fields dropped); with rest != 0 the whole remainder from that
    // field on, which is what the LAST name of a `read` gets.
    var rtField = m.NewFunc("rt_field", i8ptr,
        [llvm.ir.NewParam("l", i8ptr), llvm.ir.NewParam("ifs", i8ptr),
         llvm.ir.NewParam("idx", i32), llvm.ir.NewParam("rest", i32)])
    ;(function() {
        var ln = rtField.Params[0], ifs = rtField.Params[1], idx = rtField.Params[2], rest = rtField.Params[3]
        var e = rtField.NewBlock("entry")
        var h = rtField.NewBlock("head")
        var isSepB = rtField.NewBlock("issep")
        var sepB = rtField.NewBlock("sep")
        var chB = rtField.NewBlock("ch")
        var startB = rtField.NewBlock("start")
        var contB = rtField.NewBlock("cont")
        var hitB = rtField.NewBlock("hit")
        var endB = rtField.NewBlock("end")
        var len = e.NewCall(rtStrlen, ln)
        var ip = e.NewAlloca(i32), np = e.NewAlloca(i32), sp = e.NewAlloca(i32), inp = e.NewAlloca(i32)
        e.NewStore(zero, ip)   // scan index
        e.NewStore(zero, np)   // field number
        e.NewStore(zero, sp)   // current field start
        e.NewStore(zero, inp)  // inside a field?
        e.NewBr(h)
        var i2 = h.NewLoad(i32, ip)
        h.NewCondBr(h.NewICmp(llvm.enum.IPredSGE, i2, len), endB, isSepB)
        // is line[i] one of the ifs characters?
        var cch = isSepB.NewZExt(isSepB.NewLoad(i8, isSepB.NewGetElementPtr(i8, ln, i2)), i32)
        var sepFound = isSepB.NewCall(rtHasChar, [ifs, cch])
        isSepB.NewCondBr(isSepB.NewICmp(llvm.enum.IPredNE, sepFound, zero), sepB, chB)
        // a separator closes the field we were in
        var wasIn = sepB.NewICmp(llvm.enum.IPredNE, sepB.NewLoad(i32, inp), zero)
        var closed = rtField.NewBlock("closed"), skip = rtField.NewBlock("skip")
        sepB.NewCondBr(wasIn, closed, skip)
        var fno = closed.NewLoad(i32, np)
        var want = closed.NewICmp(llvm.enum.IPredEQ, fno, idx)
        var noRest = closed.NewICmp(llvm.enum.IPredEQ, rest, zero)
        closed.NewCondBr(closed.NewAnd(want, noRest), hitB, contB)
        contB.NewStore(contB.NewAdd(fno, one), np)
        contB.NewStore(zero, inp)
        contB.NewBr(skip)
        skip.NewStore(skip.NewAdd(i2, one), ip)
        skip.NewBr(h)
        // a field character
        chB.NewCondBr(chB.NewICmp(llvm.enum.IPredEQ, chB.NewLoad(i32, inp), zero), startB, skip)
        startB.NewStore(one, inp)
        startB.NewStore(i2, sp)
        // the wanted field starts here and the caller asked for the whole remainder
        var fno2 = startB.NewLoad(i32, np)
        var want2 = startB.NewICmp(llvm.enum.IPredEQ, fno2, idx)
        var rr = rtField.NewBlock("restall")
        startB.NewCondBr(startB.NewAnd(want2, startB.NewICmp(llvm.enum.IPredNE, rest, zero)), rr, skip)
        rr.NewRet(rr.NewCall(rtSubstr, [ln, i2, llvm.constant.NewInt(i32, -1)]))
        // end of line: the last field may still be open
        var stillIn = endB.NewICmp(llvm.enum.IPredNE, endB.NewLoad(i32, inp), zero)
        var lastOk = endB.NewICmp(llvm.enum.IPredEQ, endB.NewLoad(i32, np), idx)
        var take = rtField.NewBlock("take"), none = rtField.NewBlock("none")
        endB.NewCondBr(endB.NewAnd(stillIn, lastOk), take, none)
        take.NewRet(take.NewCall(rtSubstr, [ln, take.NewLoad(i32, sp), llvm.constant.NewInt(i32, -1)]))
        none.NewRet(emptyPtr(none))
        var hs = hitB.NewLoad(i32, sp)
        hitB.NewRet(hitB.NewCall(rtSubstr, [ln, hs, hitB.NewSub(i2, hs)]))
    })()

    // i8* rt_pad(i8* s, i32 width, i32 left, i32 zero): printf's field padding.
    var rtPad = m.NewFunc("rt_pad", i8ptr,
        [llvm.ir.NewParam("s", i8ptr), llvm.ir.NewParam("w", i32),
         llvm.ir.NewParam("left", i32), llvm.ir.NewParam("zero", i32)])
    ;(function() {
        var s0 = rtPad.Params[0], w = rtPad.Params[1], left = rtPad.Params[2], zp = rtPad.Params[3]
        var e = rtPad.NewBlock("entry")
        var h = rtPad.NewBlock("head")
        var bd = rtPad.NewBlock("body")
        var x = rtPad.NewBlock("exit")
        var vp = e.NewAlloca(i8ptr)
        e.NewStore(s0, vp)
        e.NewBr(h)
        var cur = h.NewLoad(i8ptr, vp)
        h.NewCondBr(h.NewICmp(llvm.enum.IPredSLT, h.NewCall(rtStrlen, cur), w), bd, x)
        var padCh = bd.NewSelect(bd.NewICmp(llvm.enum.IPredNE, zp, zero), gepStr(bd, "0"), gepStr(bd, " "))
        var padded = bd.NewSelect(bd.NewICmp(llvm.enum.IPredNE, left, zero),
                                  bd.NewCall(rtStrcat, [cur, gepStr(bd, " ")]),
                                  bd.NewCall(rtStrcat, [padCh, cur]))
        bd.NewStore(padded, vp)
        bd.NewBr(h)
        x.NewRet(x.NewLoad(i8ptr, vp))
    })()

    // i8* rt_unescape(i8* s): echo -e / printf backslash escapes.
    var rtUnescape = m.NewFunc("rt_unescape", i8ptr, llvm.ir.NewParam("s", i8ptr))
    ;(function() {
        var s0 = rtUnescape.Params[0]
        var e = rtUnescape.NewBlock("entry")
        var h = rtUnescape.NewBlock("head")
        var esc = rtUnescape.NewBlock("esc")
        var plain = rtUnescape.NewBlock("plain")
        var wr = rtUnescape.NewBlock("write")
        var x = rtUnescape.NewBlock("exit")
        var len = e.NewCall(rtStrlen, s0)
        var dst = e.NewCall(rtBump, e.NewAdd(len, one))
        var ip = e.NewAlloca(i32), op = e.NewAlloca(i32), cp = e.NewAlloca(i32)
        e.NewStore(zero, ip)
        e.NewStore(zero, op)
        e.NewBr(h)
        var i = h.NewLoad(i32, ip)
        var c0 = h.NewZExt(h.NewLoad(i8, h.NewGetElementPtr(i8, s0, i)), i32)
        var isEsc = h.NewAnd(h.NewICmp(llvm.enum.IPredEQ, c0, llvm.constant.NewInt(i32, 92)),
                             h.NewICmp(llvm.enum.IPredSLT, h.NewAdd(i, one), len))
        var more = rtUnescape.NewBlock("more")
        h.NewCondBr(h.NewICmp(llvm.enum.IPredEQ, c0, zero), x, more)
        more.NewCondBr(isEsc, esc, plain)
        var n1 = esc.NewZExt(esc.NewLoad(i8, esc.NewGetElementPtr(i8, s0, esc.NewAdd(i, one))), i32)
        var mapped = n1
        mapped = esc.NewSelect(esc.NewICmp(llvm.enum.IPredEQ, n1, llvm.constant.NewInt(i32, 110)), llvm.constant.NewInt(i32, 10), mapped)
        mapped = esc.NewSelect(esc.NewICmp(llvm.enum.IPredEQ, n1, llvm.constant.NewInt(i32, 116)), llvm.constant.NewInt(i32, 9), mapped)
        mapped = esc.NewSelect(esc.NewICmp(llvm.enum.IPredEQ, n1, llvm.constant.NewInt(i32, 114)), llvm.constant.NewInt(i32, 13), mapped)
        mapped = esc.NewSelect(esc.NewICmp(llvm.enum.IPredEQ, n1, llvm.constant.NewInt(i32, 97)), llvm.constant.NewInt(i32, 7), mapped)
        mapped = esc.NewSelect(esc.NewICmp(llvm.enum.IPredEQ, n1, llvm.constant.NewInt(i32, 98)), llvm.constant.NewInt(i32, 8), mapped)
        mapped = esc.NewSelect(esc.NewICmp(llvm.enum.IPredEQ, n1, llvm.constant.NewInt(i32, 102)), llvm.constant.NewInt(i32, 12), mapped)
        mapped = esc.NewSelect(esc.NewICmp(llvm.enum.IPredEQ, n1, llvm.constant.NewInt(i32, 118)), llvm.constant.NewInt(i32, 11), mapped)
        mapped = esc.NewSelect(esc.NewICmp(llvm.enum.IPredEQ, n1, llvm.constant.NewInt(i32, 101)), llvm.constant.NewInt(i32, 27), mapped)
        mapped = esc.NewSelect(esc.NewICmp(llvm.enum.IPredEQ, n1, llvm.constant.NewInt(i32, 48)), zero, mapped)
        esc.NewStore(mapped, cp)
        esc.NewStore(esc.NewAdd(i, llvm.constant.NewInt(i32, 2)), ip)
        esc.NewBr(wr)
        plain.NewStore(c0, cp)
        plain.NewStore(plain.NewAdd(i, one), ip)
        plain.NewBr(wr)
        var o = wr.NewLoad(i32, op)
        wr.NewStore(wr.NewTrunc(wr.NewLoad(i32, cp), i8), wr.NewGetElementPtr(i8, dst, o))
        wr.NewStore(wr.NewAdd(o, one), op)
        wr.NewBr(h)
        x.NewStore(zero8, x.NewGetElementPtr(i8, dst, x.NewLoad(i32, op)))
        x.NewRet(dst)
    })()

    // ---- field lists ------------------------------------------------------------------
    // The same encoding the interpreter uses: a plain string is ONE field; a string that
    // starts with "\x02" is a list, each field followed by "\x01" (so the empty list and the
    // one-empty-field list stay different).

    // i32 rt_nfields(i8* v)
    var rtNFields = m.NewFunc("rt_nfields", i32, llvm.ir.NewParam("v", i8ptr))
    ;(function() {
        var v = rtNFields.Params[0]
        var e = rtNFields.NewBlock("entry")
        var one1 = rtNFields.NewBlock("single")
        var h = rtNFields.NewBlock("head")
        var bd = rtNFields.NewBlock("body")
        var x = rtNFields.NewBlock("exit")
        var c0 = e.NewZExt(e.NewLoad(i8, e.NewGetElementPtr(i8, v, zero)), i32)
        e.NewCondBr(e.NewICmp(llvm.enum.IPredEQ, c0, llvm.constant.NewInt(i32, 2)), h, one1)
        one1.NewRet(one)
        var ip = e.NewAlloca(i32), np = e.NewAlloca(i32)
        e.NewStore(one, ip)
        e.NewStore(zero, np)
        var len = e.NewCall(rtStrlen, v)
        var i = h.NewLoad(i32, ip)
        h.NewCondBr(h.NewICmp(llvm.enum.IPredSLT, i, len), bd, x)
        var ch = bd.NewZExt(bd.NewLoad(i8, bd.NewGetElementPtr(i8, v, i)), i32)
        var hit = bd.NewICmp(llvm.enum.IPredEQ, ch, one)
        bd.NewStore(bd.NewSelect(hit, bd.NewAdd(bd.NewLoad(i32, np), one), bd.NewLoad(i32, np)), np)
        bd.NewStore(bd.NewAdd(i, one), ip)
        bd.NewBr(h)
        x.NewRet(x.NewLoad(i32, np))
    })()

    // i8* rt_getfield(i8* v, i32 k)
    var rtGetField = m.NewFunc("rt_getfield", i8ptr, [llvm.ir.NewParam("v", i8ptr), llvm.ir.NewParam("k", i32)])
    ;(function() {
        var v = rtGetField.Params[0], k = rtGetField.Params[1]
        var e = rtGetField.NewBlock("entry")
        var one1 = rtGetField.NewBlock("single")
        var h = rtGetField.NewBlock("head")
        var bd = rtGetField.NewBlock("body")
        var sepB = rtGetField.NewBlock("sep")
        var hit = rtGetField.NewBlock("hit")
        var next = rtGetField.NewBlock("next")
        var step = rtGetField.NewBlock("step")
        var x = rtGetField.NewBlock("exit")
        var c0 = e.NewZExt(e.NewLoad(i8, e.NewGetElementPtr(i8, v, zero)), i32)
        var ip = e.NewAlloca(i32), np = e.NewAlloca(i32), sp = e.NewAlloca(i32)
        e.NewStore(one, ip)
        e.NewStore(zero, np)
        e.NewStore(one, sp)
        var len = e.NewCall(rtStrlen, v)
        e.NewCondBr(e.NewICmp(llvm.enum.IPredEQ, c0, llvm.constant.NewInt(i32, 2)), h, one1)
        one1.NewRet(one1.NewSelect(one1.NewICmp(llvm.enum.IPredEQ, k, zero), v, emptyPtr(one1)))
        var i = h.NewLoad(i32, ip)
        h.NewCondBr(h.NewICmp(llvm.enum.IPredSLT, i, len), bd, x)
        var ch = bd.NewZExt(bd.NewLoad(i8, bd.NewGetElementPtr(i8, v, i)), i32)
        bd.NewCondBr(bd.NewICmp(llvm.enum.IPredEQ, ch, one), sepB, step)
        sepB.NewCondBr(sepB.NewICmp(llvm.enum.IPredEQ, sepB.NewLoad(i32, np), k), hit, next)
        var st0 = hit.NewLoad(i32, sp)
        hit.NewRet(hit.NewCall(rtSubstr, [v, st0, hit.NewSub(i, st0)]))
        next.NewStore(next.NewAdd(next.NewLoad(i32, np), one), np)
        next.NewStore(next.NewAdd(i, one), sp)
        next.NewBr(step)
        step.NewStore(step.NewAdd(i, one), ip)
        step.NewBr(h)
        x.NewRet(emptyPtr(x))
    })()

    // i8* rt_wordjoin(i8* v): a field list flattened back to one string, fields space-joined.
    var rtWordJoin = m.NewFunc("rt_wordjoin", i8ptr, llvm.ir.NewParam("v", i8ptr))
    ;(function() {
        var v = rtWordJoin.Params[0]
        var e = rtWordJoin.NewBlock("entry")
        var one1 = rtWordJoin.NewBlock("single")
        var h = rtWordJoin.NewBlock("head")
        var bd = rtWordJoin.NewBlock("body")
        var x = rtWordJoin.NewBlock("exit")
        var c0 = e.NewZExt(e.NewLoad(i8, e.NewGetElementPtr(i8, v, zero)), i32)
        var n = e.NewCall(rtNFields, v)
        var op = e.NewAlloca(i8ptr), ip = e.NewAlloca(i32)
        e.NewStore(emptyPtr(e), op)
        e.NewStore(zero, ip)
        e.NewCondBr(e.NewICmp(llvm.enum.IPredEQ, c0, llvm.constant.NewInt(i32, 2)), h, one1)
        one1.NewRet(v)
        var i = h.NewLoad(i32, ip)
        h.NewCondBr(h.NewICmp(llvm.enum.IPredSLT, i, n), bd, x)
        var cur = bd.NewLoad(i8ptr, op)
        cur = bd.NewSelect(bd.NewICmp(llvm.enum.IPredSGT, i, zero), bd.NewCall(rtStrcat, [cur, gepStr(bd, " ")]), cur)
        bd.NewStore(bd.NewCall(rtStrcat, [cur, bd.NewCall(rtGetField, [v, i])]), op)
        bd.NewStore(bd.NewAdd(i, one), ip)
        bd.NewBr(h)
        x.NewRet(x.NewLoad(i8ptr, op))
    })()

    // i8* rt_splitifs(i8* v, i8* ifs): an unquoted expansion split into a field list.
    var rtSplitIfs = m.NewFunc("rt_splitifs", i8ptr, [llvm.ir.NewParam("v", i8ptr), llvm.ir.NewParam("ifs", i8ptr)])
    ;(function() {
        var v = rtSplitIfs.Params[0], ifs = rtSplitIfs.Params[1]
        var e = rtSplitIfs.NewBlock("entry")
        var h = rtSplitIfs.NewBlock("head")
        var bd = rtSplitIfs.NewBlock("body")
        var sepB = rtSplitIfs.NewBlock("sep")
        var closeB = rtSplitIfs.NewBlock("close")
        var step = rtSplitIfs.NewBlock("step")
        var x = rtSplitIfs.NewBlock("exit")
        var tail = rtSplitIfs.NewBlock("tail")
        var len = e.NewCall(rtStrlen, v)
        var op = e.NewAlloca(i8ptr), ip = e.NewAlloca(i32), sp = e.NewAlloca(i32), inp = e.NewAlloca(i32)
        e.NewStore(gepStr(e, "\x02"), op)
        e.NewStore(zero, ip)
        e.NewStore(zero, sp)
        e.NewStore(zero, inp)
        e.NewBr(h)
        var i = h.NewLoad(i32, ip)
        h.NewCondBr(h.NewICmp(llvm.enum.IPredSLT, i, len), bd, tail)
        var ch = bd.NewZExt(bd.NewLoad(i8, bd.NewGetElementPtr(i8, v, i)), i32)
        bd.NewCondBr(bd.NewICmp(llvm.enum.IPredNE, bd.NewCall(rtHasChar, [ifs, ch]), zero), sepB, closeB)
        var emitB = rtSplitIfs.NewBlock("emit")
        var openB = rtSplitIfs.NewBlock("open")
        var emitT = rtSplitIfs.NewBlock("emit_tail")
        sepB.NewCondBr(sepB.NewICmp(llvm.enum.IPredNE, sepB.NewLoad(i32, inp), zero), emitB, step)
        // close the field that ends here
        var st1 = emitB.NewLoad(i32, sp)
        emitB.NewStore(emitB.NewCall(rtStrcat, [emitB.NewCall(rtStrcat, [emitB.NewLoad(i8ptr, op),
                        emitB.NewCall(rtSubstr, [v, st1, emitB.NewSub(i, st1)])]), gepStr(emitB, "\x01")]), op)
        emitB.NewStore(zero, inp)
        emitB.NewBr(step)
        closeB.NewCondBr(closeB.NewICmp(llvm.enum.IPredEQ, closeB.NewLoad(i32, inp), zero), openB, step)
        openB.NewStore(one, inp)
        openB.NewStore(i, sp)
        openB.NewBr(step)
        step.NewStore(step.NewAdd(i, one), ip)
        step.NewBr(h)
        tail.NewCondBr(tail.NewICmp(llvm.enum.IPredNE, tail.NewLoad(i32, inp), zero), emitT, x)
        var st2 = emitT.NewLoad(i32, sp)
        emitT.NewStore(emitT.NewCall(rtStrcat, [emitT.NewCall(rtStrcat, [emitT.NewLoad(i8ptr, op),
                        emitT.NewCall(rtSubstr, [v, st2, emitT.NewSub(len, st2)])]), gepStr(emitT, "\x01")]), op)
        emitT.NewBr(x)
        x.NewRet(x.NewLoad(i8ptr, op))
    })()

    // Appending a field list to a word under construction. The word is kept as a CLOSED list
    // `acc` (each field followed by "\x01") plus the text of the field still `open`:
    //   n == 0            nothing changes
    //   n == 1            open = open + f[0]
    //   n >= 2            acc = acc + (open + f[0]) + f[1] .. f[n-2], each closed; open = f[n-1]
    // which is exactly bash's rule that x"$@"y with (a b c) is "xa" "b" "cy".
    var rtBndAcc = m.NewFunc("rt_bnd_acc", i8ptr,
        [llvm.ir.NewParam("acc", i8ptr), llvm.ir.NewParam("open", i8ptr), llvm.ir.NewParam("f", i8ptr)])
    ;(function() {
        var acc = rtBndAcc.Params[0], open = rtBndAcc.Params[1], f = rtBndAcc.Params[2]
        var e = rtBndAcc.NewBlock("entry")
        var go = rtBndAcc.NewBlock("go")
        var h = rtBndAcc.NewBlock("head")
        var bd = rtBndAcc.NewBlock("body")
        var x = rtBndAcc.NewBlock("exit")
        var n = e.NewCall(rtNFields, f)
        var op = e.NewAlloca(i8ptr), ip = e.NewAlloca(i32)
        e.NewStore(acc, op)
        e.NewStore(one, ip)
        e.NewCondBr(e.NewICmp(llvm.enum.IPredSLT, n, llvm.constant.NewInt(i32, 2)), x, go)
        go.NewStore(go.NewCall(rtStrcat, [go.NewCall(rtStrcat, [go.NewCall(rtStrcat, [acc, open]),
                                          go.NewCall(rtGetField, [f, zero])]), gepStr(go, "\x01")]), op)
        go.NewBr(h)
        var i = h.NewLoad(i32, ip)
        h.NewCondBr(h.NewICmp(llvm.enum.IPredSLT, i, h.NewSub(n, one)), bd, x)
        bd.NewStore(bd.NewCall(rtStrcat, [bd.NewCall(rtStrcat, [bd.NewLoad(i8ptr, op),
                                          bd.NewCall(rtGetField, [f, i])]), gepStr(bd, "\x01")]), op)
        bd.NewStore(bd.NewAdd(i, one), ip)
        bd.NewBr(h)
        x.NewRet(x.NewLoad(i8ptr, op))
    })()
    var rtBndOpen = m.NewFunc("rt_bnd_open", i8ptr,
        [llvm.ir.NewParam("open", i8ptr), llvm.ir.NewParam("f", i8ptr)])
    ;(function() {
        var open = rtBndOpen.Params[0], f = rtBndOpen.Params[1]
        var e = rtBndOpen.NewBlock("entry")
        var zeroB = rtBndOpen.NewBlock("none")
        var oneB = rtBndOpen.NewBlock("one")
        var manyB = rtBndOpen.NewBlock("many")
        var more = rtBndOpen.NewBlock("more")
        var n = e.NewCall(rtNFields, f)
        e.NewCondBr(e.NewICmp(llvm.enum.IPredEQ, n, zero), zeroB, more)
        more.NewCondBr(more.NewICmp(llvm.enum.IPredEQ, n, one), oneB, manyB)
        zeroB.NewRet(open)
        oneB.NewRet(oneB.NewCall(rtStrcat, [open, oneB.NewCall(rtGetField, [f, zero])]))
        manyB.NewRet(manyB.NewCall(rtGetField, [f, manyB.NewSub(n, one)]))
    })()

    // ---- arrays ------------------------------------------------------------------------
    // One flat store of (arrayName, key, value) triples with a linear scan. Keys are strings
    // for both kinds of array; entries stay in INSERTION order, which is also the order
    // ${!a[*]} and ${a[@]} report.
    var NARR = 4096
    var arrSlotTy = llvm.types.NewArray(NARR, i8ptr)
    var gArrNm = m.NewGlobalDef("arr_nm", llvm.constant.NewZeroInitializer(arrSlotTy))
    var gArrK = m.NewGlobalDef("arr_k", llvm.constant.NewZeroInitializer(arrSlotTy))
    var gArrV = m.NewGlobalDef("arr_v", llvm.constant.NewZeroInitializer(arrSlotTy))
    var gArrN = m.NewGlobalDef("arr_n", zero)

    var rtArrFind = m.NewFunc("rt_arr_find", i32, [llvm.ir.NewParam("nm", i8ptr), llvm.ir.NewParam("k", i8ptr)])
    ;(function() {
        var nm = rtArrFind.Params[0], k = rtArrFind.Params[1]
        var e = rtArrFind.NewBlock("entry")
        var h = rtArrFind.NewBlock("head")
        var bd = rtArrFind.NewBlock("body")
        var hit = rtArrFind.NewBlock("hit")
        var st = rtArrFind.NewBlock("step")
        var no = rtArrFind.NewBlock("no")
        var n = e.NewLoad(i32, gArrN)
        var ip = e.NewAlloca(i32)
        e.NewStore(zero, ip)
        e.NewBr(h)
        var i = h.NewLoad(i32, ip)
        h.NewCondBr(h.NewICmp(llvm.enum.IPredSLT, i, n), bd, no)
        var sameNm = bd.NewICmp(llvm.enum.IPredNE, bd.NewCall(rtStreq,
            [nm, bd.NewLoad(i8ptr, bd.NewGetElementPtr(arrSlotTy, gArrNm, zero, i))]), zero)
        var sameK = bd.NewICmp(llvm.enum.IPredNE, bd.NewCall(rtStreq,
            [k, bd.NewLoad(i8ptr, bd.NewGetElementPtr(arrSlotTy, gArrK, zero, i))]), zero)
        bd.NewCondBr(bd.NewAnd(sameNm, sameK), hit, st)
        hit.NewRet(i)
        st.NewStore(st.NewAdd(i, one), ip)
        st.NewBr(h)
        no.NewRet(llvm.constant.NewInt(i32, -1))
    })()

    var rtArrSet = m.NewFunc("rt_arr_set", i32,
        [llvm.ir.NewParam("nm", i8ptr), llvm.ir.NewParam("k", i8ptr), llvm.ir.NewParam("v", i8ptr)])
    ;(function() {
        var nm = rtArrSet.Params[0], k = rtArrSet.Params[1], v = rtArrSet.Params[2]
        var e = rtArrSet.NewBlock("entry")
        var upd = rtArrSet.NewBlock("upd")
        var add = rtArrSet.NewBlock("add")
        var at = e.NewCall(rtArrFind, [nm, k])
        e.NewCondBr(e.NewICmp(llvm.enum.IPredSGE, at, zero), upd, add)
        upd.NewStore(v, upd.NewGetElementPtr(arrSlotTy, gArrV, zero, at))
        upd.NewRet(zero)
        var n = add.NewLoad(i32, gArrN)
        add.NewStore(nm, add.NewGetElementPtr(arrSlotTy, gArrNm, zero, n))
        add.NewStore(k, add.NewGetElementPtr(arrSlotTy, gArrK, zero, n))
        add.NewStore(v, add.NewGetElementPtr(arrSlotTy, gArrV, zero, n))
        add.NewStore(add.NewAdd(n, one), gArrN)
        add.NewRet(zero)
    })()

    var rtArrGet = m.NewFunc("rt_arr_get", i8ptr, [llvm.ir.NewParam("nm", i8ptr), llvm.ir.NewParam("k", i8ptr)])
    ;(function() {
        var e = rtArrGet.NewBlock("entry")
        var ok = rtArrGet.NewBlock("ok")
        var no = rtArrGet.NewBlock("no")
        var at = e.NewCall(rtArrFind, [rtArrGet.Params[0], rtArrGet.Params[1]])
        e.NewCondBr(e.NewICmp(llvm.enum.IPredSGE, at, zero), ok, no)
        ok.NewRet(ok.NewLoad(i8ptr, ok.NewGetElementPtr(arrSlotTy, gArrV, zero, at)))
        no.NewRet(emptyPtr(no))
    })()

    var rtArrHas = m.NewFunc("rt_arr_has", i32, [llvm.ir.NewParam("nm", i8ptr), llvm.ir.NewParam("k", i8ptr)])
    ;(function() {
        var e = rtArrHas.NewBlock("entry")
        var at = e.NewCall(rtArrFind, [rtArrHas.Params[0], rtArrHas.Params[1]])
        e.NewRet(e.NewZExt(e.NewICmp(llvm.enum.IPredSGE, at, zero), i32))
    })()

    // Remove one entry (rt_arr_del) or every entry of an array (rt_arr_clear), shifting the
    // tail of the store down over the hole.
    var rtArrDel = m.NewFunc("rt_arr_del", i32, [llvm.ir.NewParam("nm", i8ptr), llvm.ir.NewParam("k", i8ptr)])
    ;(function() {
        var e = rtArrDel.NewBlock("entry")
        var go = rtArrDel.NewBlock("go")
        var h = rtArrDel.NewBlock("head")
        var bd = rtArrDel.NewBlock("body")
        var x = rtArrDel.NewBlock("exit")
        var at = e.NewCall(rtArrFind, [rtArrDel.Params[0], rtArrDel.Params[1]])
        var ip = e.NewAlloca(i32)
        e.NewStore(at, ip)
        e.NewCondBr(e.NewICmp(llvm.enum.IPredSGE, at, zero), go, x)
        go.NewBr(h)
        var n = h.NewLoad(i32, gArrN)
        var i = h.NewLoad(i32, ip)
        var fin = rtArrDel.NewBlock("fin")
        h.NewCondBr(h.NewICmp(llvm.enum.IPredSLT, i, h.NewSub(n, one)), bd, fin)
        fin.NewStore(fin.NewSub(fin.NewLoad(i32, gArrN), one), gArrN)
        fin.NewBr(x)
        var j = bd.NewAdd(i, one)
        bd.NewStore(bd.NewLoad(i8ptr, bd.NewGetElementPtr(arrSlotTy, gArrNm, zero, j)), bd.NewGetElementPtr(arrSlotTy, gArrNm, zero, i))
        bd.NewStore(bd.NewLoad(i8ptr, bd.NewGetElementPtr(arrSlotTy, gArrK, zero, j)), bd.NewGetElementPtr(arrSlotTy, gArrK, zero, i))
        bd.NewStore(bd.NewLoad(i8ptr, bd.NewGetElementPtr(arrSlotTy, gArrV, zero, j)), bd.NewGetElementPtr(arrSlotTy, gArrV, zero, i))
        bd.NewStore(j, ip)
        bd.NewBr(h)
        x.NewRet(zero)
    })()

    var rtArrCount = m.NewFunc("rt_arr_count", i32, llvm.ir.NewParam("nm", i8ptr))
    ;(function() {
        var nm = rtArrCount.Params[0]
        var e = rtArrCount.NewBlock("entry")
        var h = rtArrCount.NewBlock("head")
        var bd = rtArrCount.NewBlock("body")
        var x = rtArrCount.NewBlock("exit")
        var n = e.NewLoad(i32, gArrN)
        var ip = e.NewAlloca(i32), cp = e.NewAlloca(i32)
        e.NewStore(zero, ip)
        e.NewStore(zero, cp)
        e.NewBr(h)
        var i = h.NewLoad(i32, ip)
        h.NewCondBr(h.NewICmp(llvm.enum.IPredSLT, i, n), bd, x)
        var same = bd.NewICmp(llvm.enum.IPredNE, bd.NewCall(rtStreq,
            [nm, bd.NewLoad(i8ptr, bd.NewGetElementPtr(arrSlotTy, gArrNm, zero, i))]), zero)
        bd.NewStore(bd.NewSelect(same, bd.NewAdd(bd.NewLoad(i32, cp), one), bd.NewLoad(i32, cp)), cp)
        bd.NewStore(bd.NewAdd(i, one), ip)
        bd.NewBr(h)
        x.NewRet(x.NewLoad(i32, cp))
    })()

    // i8* rt_arr_list(i8* nm, i8* sep, i32 star, i32 keys): the keys or the values of an
    // array, as a field list (star == 0) or joined with sep (star != 0).
    var rtArrList = m.NewFunc("rt_arr_list", i8ptr,
        [llvm.ir.NewParam("nm", i8ptr), llvm.ir.NewParam("sep", i8ptr),
         llvm.ir.NewParam("star", i32), llvm.ir.NewParam("keys", i32)])
    ;(function() {
        var nm = rtArrList.Params[0], sep = rtArrList.Params[1]
        var star = rtArrList.Params[2], keys = rtArrList.Params[3]
        var e = rtArrList.NewBlock("entry")
        var h = rtArrList.NewBlock("head")
        var bd = rtArrList.NewBlock("body")
        var take = rtArrList.NewBlock("take")
        var st = rtArrList.NewBlock("step")
        var x = rtArrList.NewBlock("exit")
        var n = e.NewLoad(i32, gArrN)
        var op = e.NewAlloca(i8ptr), ip = e.NewAlloca(i32), cp = e.NewAlloca(i32)
        e.NewStore(e.NewSelect(e.NewICmp(llvm.enum.IPredNE, star, zero), emptyPtr(e), gepStr(e, "\x02")), op)
        e.NewStore(zero, ip)
        e.NewStore(zero, cp)
        e.NewBr(h)
        var i = h.NewLoad(i32, ip)
        h.NewCondBr(h.NewICmp(llvm.enum.IPredSLT, i, n), bd, x)
        var same = bd.NewICmp(llvm.enum.IPredNE, bd.NewCall(rtStreq,
            [nm, bd.NewLoad(i8ptr, bd.NewGetElementPtr(arrSlotTy, gArrNm, zero, i))]), zero)
        bd.NewCondBr(same, take, st)
        var kv = take.NewSelect(take.NewICmp(llvm.enum.IPredNE, keys, zero),
            take.NewLoad(i8ptr, take.NewGetElementPtr(arrSlotTy, gArrK, zero, i)),
            take.NewLoad(i8ptr, take.NewGetElementPtr(arrSlotTy, gArrV, zero, i)))
        var cur = take.NewLoad(i8ptr, op)
        var isStar = take.NewICmp(llvm.enum.IPredNE, star, zero)
        var needSep = take.NewAnd(isStar, take.NewICmp(llvm.enum.IPredSGT, take.NewLoad(i32, cp), zero))
        cur = take.NewSelect(needSep, take.NewCall(rtStrcat, [cur, sep]), cur)
        cur = take.NewCall(rtStrcat, [cur, kv])
        cur = take.NewSelect(isStar, cur, take.NewCall(rtStrcat, [cur, gepStr(take, "\x01")]))
        take.NewStore(cur, op)
        take.NewStore(take.NewAdd(take.NewLoad(i32, cp), one), cp)
        take.NewBr(st)
        st.NewStore(st.NewAdd(i, one), ip)
        st.NewBr(h)
        x.NewRet(x.NewLoad(i8ptr, op))
    })()

    // i32 rt_arr_nextidx(i8* nm): one past the largest numeric key.
    var rtArrNext = m.NewFunc("rt_arr_nextidx", i32, llvm.ir.NewParam("nm", i8ptr))
    ;(function() {
        var nm = rtArrNext.Params[0]
        var e = rtArrNext.NewBlock("entry")
        var h = rtArrNext.NewBlock("head")
        var bd = rtArrNext.NewBlock("body")
        var x = rtArrNext.NewBlock("exit")
        var n = e.NewLoad(i32, gArrN)
        var ip = e.NewAlloca(i32), mp = e.NewAlloca(i32)
        e.NewStore(zero, ip)
        e.NewStore(zero, mp)
        e.NewBr(h)
        var i = h.NewLoad(i32, ip)
        h.NewCondBr(h.NewICmp(llvm.enum.IPredSLT, i, n), bd, x)
        var same = bd.NewICmp(llvm.enum.IPredNE, bd.NewCall(rtStreq,
            [nm, bd.NewLoad(i8ptr, bd.NewGetElementPtr(arrSlotTy, gArrNm, zero, i))]), zero)
        var kn = bd.NewCall(rtStr2int, bd.NewLoad(i8ptr, bd.NewGetElementPtr(arrSlotTy, gArrK, zero, i)))
        var bigger = bd.NewAnd(same, bd.NewICmp(llvm.enum.IPredSGE, kn, bd.NewLoad(i32, mp)))
        bd.NewStore(bd.NewSelect(bigger, bd.NewAdd(kn, one), bd.NewLoad(i32, mp)), mp)
        bd.NewStore(bd.NewAdd(i, one), ip)
        bd.NewBr(h)
        x.NewRet(x.NewLoad(i32, mp))
    })()

    // i32 rt_arr_clear(i8* nm): drop every entry of one array.
    var rtArrClear = m.NewFunc("rt_arr_clear", i32, llvm.ir.NewParam("nm", i8ptr))
    ;(function() {
        var nm = rtArrClear.Params[0]
        var e = rtArrClear.NewBlock("entry")
        var h = rtArrClear.NewBlock("head")
        var bd = rtArrClear.NewBlock("body")
        var keep = rtArrClear.NewBlock("keep")
        var st = rtArrClear.NewBlock("step")
        var x = rtArrClear.NewBlock("exit")
        var ip = e.NewAlloca(i32), op = e.NewAlloca(i32)
        e.NewStore(zero, ip)
        e.NewStore(zero, op)
        e.NewBr(h)
        var i = h.NewLoad(i32, ip)
        h.NewCondBr(h.NewICmp(llvm.enum.IPredSLT, i, h.NewLoad(i32, gArrN)), bd, x)
        var same = bd.NewICmp(llvm.enum.IPredNE, bd.NewCall(rtStreq,
            [nm, bd.NewLoad(i8ptr, bd.NewGetElementPtr(arrSlotTy, gArrNm, zero, i))]), zero)
        bd.NewCondBr(same, st, keep)
        var o = keep.NewLoad(i32, op)
        keep.NewStore(keep.NewLoad(i8ptr, keep.NewGetElementPtr(arrSlotTy, gArrNm, zero, i)), keep.NewGetElementPtr(arrSlotTy, gArrNm, zero, o))
        keep.NewStore(keep.NewLoad(i8ptr, keep.NewGetElementPtr(arrSlotTy, gArrK, zero, i)), keep.NewGetElementPtr(arrSlotTy, gArrK, zero, o))
        keep.NewStore(keep.NewLoad(i8ptr, keep.NewGetElementPtr(arrSlotTy, gArrV, zero, i)), keep.NewGetElementPtr(arrSlotTy, gArrV, zero, o))
        keep.NewStore(keep.NewAdd(o, one), op)
        keep.NewBr(st)
        st.NewStore(st.NewAdd(i, one), ip)
        st.NewBr(h)
        x.NewStore(x.NewLoad(i32, op), gArrN)
        x.NewRet(zero)
    })()

    // i32 rt_arr_append(i8* nm, i8* fields): append every field with the next numeric index.
    var rtArrAppend = m.NewFunc("rt_arr_append", i32, [llvm.ir.NewParam("nm", i8ptr), llvm.ir.NewParam("f", i8ptr)])
    ;(function() {
        var nm = rtArrAppend.Params[0], f = rtArrAppend.Params[1]
        var e = rtArrAppend.NewBlock("entry")
        var h = rtArrAppend.NewBlock("head")
        var bd = rtArrAppend.NewBlock("body")
        var x = rtArrAppend.NewBlock("exit")
        var n = e.NewCall(rtNFields, f)
        var ip = e.NewAlloca(i32)
        e.NewStore(zero, ip)
        e.NewBr(h)
        var i = h.NewLoad(i32, ip)
        h.NewCondBr(h.NewICmp(llvm.enum.IPredSLT, i, n), bd, x)
        var idx = bd.NewCall(rtArrNext, nm)
        bd.NewCall(rtArrSet, [nm, bd.NewCall(rtInt2str, idx), bd.NewCall(rtGetField, [f, i])])
        bd.NewStore(bd.NewAdd(i, one), ip)
        bd.NewBr(h)
        x.NewRet(zero)
    })()

    // i8* rt_slicefields(i8* f, i32 off, i32 n, i8* sep, i32 star)
    var rtSliceFields = m.NewFunc("rt_slicefields", i8ptr,
        [llvm.ir.NewParam("f", i8ptr), llvm.ir.NewParam("off", i32), llvm.ir.NewParam("n", i32),
         llvm.ir.NewParam("sep", i8ptr), llvm.ir.NewParam("star", i32)])
    ;(function() {
        var f = rtSliceFields.Params[0], off = rtSliceFields.Params[1]
        var n = rtSliceFields.Params[2], sep = rtSliceFields.Params[3], star = rtSliceFields.Params[4]
        var e = rtSliceFields.NewBlock("entry")
        var h = rtSliceFields.NewBlock("head")
        var bd = rtSliceFields.NewBlock("body")
        var x = rtSliceFields.NewBlock("exit")
        var cnt = e.NewCall(rtNFields, f)
        var op = e.NewAlloca(i8ptr), ip = e.NewAlloca(i32), cp = e.NewAlloca(i32)
        var isStar = e.NewICmp(llvm.enum.IPredNE, star, zero)
        e.NewStore(e.NewSelect(isStar, emptyPtr(e), gepStr(e, "\x02")), op)
        e.NewStore(off, ip)
        e.NewStore(zero, cp)
        e.NewBr(h)
        var i = h.NewLoad(i32, ip)
        var taken = h.NewLoad(i32, cp)
        h.NewCondBr(h.NewAnd(h.NewICmp(llvm.enum.IPredSLT, i, cnt),
                             h.NewICmp(llvm.enum.IPredSLT, taken, n)), bd, x)
        var cur = bd.NewLoad(i8ptr, op)
        var needSep = bd.NewAnd(isStar, bd.NewICmp(llvm.enum.IPredSGT, bd.NewLoad(i32, cp), zero))
        cur = bd.NewSelect(needSep, bd.NewCall(rtStrcat, [cur, sep]), cur)
        cur = bd.NewCall(rtStrcat, [cur, bd.NewCall(rtGetField, [f, i])])
        cur = bd.NewSelect(isStar, cur, bd.NewCall(rtStrcat, [cur, gepStr(bd, "\x01")]))
        bd.NewStore(cur, op)
        bd.NewStore(bd.NewAdd(i, one), ip)
        bd.NewStore(bd.NewAdd(bd.NewLoad(i32, cp), one), cp)
        bd.NewBr(h)
        x.NewRet(x.NewLoad(i8ptr, op))
    })()

    // i8* rt_globescape(i8* s): make every glob metacharacter of s literal, which is what a
    // QUOTED part of a [[ ]] pattern is ( [[ $s == "h*" ]] does not glob ).
    var rtGlobEsc = m.NewFunc("rt_globescape", i8ptr, llvm.ir.NewParam("s", i8ptr))
    ;(function() {
        var s0 = rtGlobEsc.Params[0]
        var e = rtGlobEsc.NewBlock("entry")
        var h = rtGlobEsc.NewBlock("head")
        var bd = rtGlobEsc.NewBlock("body")
        var esc = rtGlobEsc.NewBlock("esc")
        var wr = rtGlobEsc.NewBlock("write")
        var x = rtGlobEsc.NewBlock("exit")
        var len = e.NewCall(rtStrlen, s0)
        var dst = e.NewCall(rtBump, e.NewAdd(e.NewMul(len, llvm.constant.NewInt(i32, 2)), one))
        var ip = e.NewAlloca(i32), op = e.NewAlloca(i32)
        e.NewStore(zero, ip)
        e.NewStore(zero, op)
        e.NewBr(h)
        var i = h.NewLoad(i32, ip)
        h.NewCondBr(h.NewICmp(llvm.enum.IPredSLT, i, len), bd, x)
        var ch = bd.NewZExt(bd.NewLoad(i8, bd.NewGetElementPtr(i8, s0, i)), i32)
        var meta = bd.NewOr(bd.NewOr(bd.NewICmp(llvm.enum.IPredEQ, ch, llvm.constant.NewInt(i32, 42)),
                                     bd.NewICmp(llvm.enum.IPredEQ, ch, llvm.constant.NewInt(i32, 63))),
                            bd.NewOr(bd.NewOr(bd.NewICmp(llvm.enum.IPredEQ, ch, llvm.constant.NewInt(i32, 91)),
                                              bd.NewICmp(llvm.enum.IPredEQ, ch, llvm.constant.NewInt(i32, 93))),
                                     bd.NewICmp(llvm.enum.IPredEQ, ch, llvm.constant.NewInt(i32, 92))))
        bd.NewCondBr(meta, esc, wr)
        var o1 = esc.NewLoad(i32, op)
        esc.NewStore(llvm.constant.NewInt(i8, 92), esc.NewGetElementPtr(i8, dst, o1))
        esc.NewStore(esc.NewAdd(o1, one), op)
        esc.NewBr(wr)
        var o2 = wr.NewLoad(i32, op)
        wr.NewStore(wr.NewTrunc(ch, i8), wr.NewGetElementPtr(i8, dst, o2))
        wr.NewStore(wr.NewAdd(o2, one), op)
        wr.NewStore(wr.NewAdd(i, one), ip)
        wr.NewBr(h)
        x.NewStore(zero8, x.NewGetElementPtr(i8, dst, x.NewLoad(i32, op)))
        x.NewRet(dst)
    })()

    // i8* rt_catfields(i8* a, i8* b): concatenate two field lists.
    var rtCatFields = m.NewFunc("rt_catfields", i8ptr, [llvm.ir.NewParam("a", i8ptr), llvm.ir.NewParam("b", i8ptr)])
    ;(function() {
        var a = rtCatFields.Params[0], bb = rtCatFields.Params[1]
        var e = rtCatFields.NewBlock("entry")
        var h = rtCatFields.NewBlock("head")
        var bd = rtCatFields.NewBlock("body")
        var x = rtCatFields.NewBlock("exit")
        var n = e.NewCall(rtNFields, bb)
        var op = e.NewAlloca(i8ptr), ip = e.NewAlloca(i32)
        e.NewStore(a, op)
        e.NewStore(zero, ip)
        e.NewBr(h)
        var i = h.NewLoad(i32, ip)
        h.NewCondBr(h.NewICmp(llvm.enum.IPredSLT, i, n), bd, x)
        bd.NewStore(bd.NewCall(rtStrcat, [bd.NewCall(rtStrcat, [bd.NewLoad(i8ptr, op),
                                          bd.NewCall(rtGetField, [bb, i])]), gepStr(bd, "\x01")]), op)
        bd.NewStore(bd.NewAdd(i, one), ip)
        bd.NewBr(h)
        x.NewRet(x.NewLoad(i8ptr, op))
    })()

    // i32 rt_argpush(i8* v): append every FIELD of v to the argv stack.
    var rtArgPush = m.NewFunc("rt_argpush", i32, llvm.ir.NewParam("v", i8ptr))
    ;(function() {
        var v = rtArgPush.Params[0]
        var e = rtArgPush.NewBlock("entry")
        var h = rtArgPush.NewBlock("head")
        var bd = rtArgPush.NewBlock("body")
        var x = rtArgPush.NewBlock("exit")
        var n = e.NewCall(rtNFields, v)
        var ip = e.NewAlloca(i32)
        e.NewStore(zero, ip)
        e.NewBr(h)
        var i = h.NewLoad(i32, ip)
        h.NewCondBr(h.NewICmp(llvm.enum.IPredSLT, i, n), bd, x)
        var t = bd.NewLoad(i32, gArgvTop)
        bd.NewStore(bd.NewCall(rtGetField, [v, i]), bd.NewGetElementPtr(argvTy, gArgv, zero, t))
        bd.NewStore(bd.NewAdd(t, one), gArgvTop)
        bd.NewStore(bd.NewAdd(i, one), ip)
        bd.NewBr(h)
        x.NewRet(zero)
    })()

    // i8* rt_param(i32 n): the n-th positional parameter ("" past the end).
    var rtParam = m.NewFunc("rt_param", i8ptr, llvm.ir.NewParam("n", i32))
    ;(function() {
        var n = rtParam.Params[0]
        var e = rtParam.NewBlock("entry")
        var ok = rtParam.NewBlock("ok")
        var no = rtParam.NewBlock("no")
        var cnt = e.NewLoad(i32, gFrameN)
        e.NewCondBr(e.NewAnd(e.NewICmp(llvm.enum.IPredSGE, n, one),
                             e.NewICmp(llvm.enum.IPredSLE, n, cnt)), ok, no)
        var idx = ok.NewAdd(ok.NewLoad(i32, gFrameBase), ok.NewSub(n, one))
        ok.NewRet(ok.NewLoad(i8ptr, ok.NewGetElementPtr(argvTy, gArgv, zero, idx)))
        no.NewRet(emptyPtr(no))
    })()

    // i8* rt_params(i8* sep): "$@" when sep is the field marker, "$*" when it is a separator.
    var rtParams = m.NewFunc("rt_params", i8ptr, [llvm.ir.NewParam("sep", i8ptr), llvm.ir.NewParam("star", i32)])
    ;(function() {
        var sep = rtParams.Params[0], star = rtParams.Params[1]
        var e = rtParams.NewBlock("entry")
        var h = rtParams.NewBlock("head")
        var bd = rtParams.NewBlock("body")
        var x = rtParams.NewBlock("exit")
        var cnt = e.NewLoad(i32, gFrameN)
        var base = e.NewLoad(i32, gFrameBase)
        var op = e.NewAlloca(i8ptr)
        var ip = e.NewAlloca(i32)
        e.NewStore(e.NewSelect(e.NewICmp(llvm.enum.IPredNE, star, zero), emptyPtr(e), gepStr(e, "\x02")), op)
        e.NewStore(zero, ip)
        e.NewBr(h)
        var i = h.NewLoad(i32, ip)
        h.NewCondBr(h.NewICmp(llvm.enum.IPredSLT, i, cnt), bd, x)
        var v = bd.NewLoad(i8ptr, bd.NewGetElementPtr(argvTy, gArgv, zero, bd.NewAdd(base, i)))
        var cur = bd.NewLoad(i8ptr, op)
        var isStar = bd.NewICmp(llvm.enum.IPredNE, star, zero)
        var needSep = bd.NewAnd(isStar, bd.NewICmp(llvm.enum.IPredSGT, i, zero))
        cur = bd.NewSelect(needSep, bd.NewCall(rtStrcat, [cur, sep]), cur)
        cur = bd.NewCall(rtStrcat, [cur, v])
        cur = bd.NewSelect(isStar, cur, bd.NewCall(rtStrcat, [cur, gepStr(bd, "\x01")]))
        bd.NewStore(cur, op)
        bd.NewStore(bd.NewAdd(i, one), ip)
        bd.NewBr(h)
        x.NewRet(x.NewLoad(i8ptr, op))
    })()

    // ---- [[ str =~ ere ]] -----------------------------------------------------------------
    //
    // A POSIX ERE engine, EMITTED AS IR. Same contract as before:
    //   rt_regex_search > 0  matched; the number of capture PAIRS, i.e. ${#BASH_REMATCH[@]}
    //                  == 0  no match
    //                  == -1 the pattern did not compile; rt_regex_error() has the text
    //                  == -2 the engine's step cap was hit on a pathological pattern
    // caps is caller-allocated, ncaps SLOTS (ncaps/2 pairs), pre-filled with -1, so a group
    // that did not participate reads -1/-1 - bash's empty-but-counted BASH_REMATCH entry.
    // Offsets are BYTES into the subject, which is what bash indexes.
    //
    // WHY IT IS EMITTED AND NOT AN EXTERN, which is what it used to be.
    //
    // rt_regex_search and rt_regex_error were Go functions (abnf/jsrtregexptr.go) reached
    // through the IR machine's extern table, sharing rxCompile/rxSearch with lib/regex.js so
    // the two halves could not drift. Under llvm.Run that is exactly right. In a clang-built
    // executable it was INVISIBLY BROKEN: a Go function has no C symbol, so `-exe` had
    // nothing to link, and buildExecutable's stubUndefined gave the DECLARATION a
    // `ret i32 0` body. 0 means NO MATCH. Every =~ in a native binary therefore answered
    // "no match", and every uncompilable pattern answered "no match" instead of status 2.
    //
    // Measured 2026-07-27 on tests/bash-test-full.sh: 289/289 under llvm.Run, 282/289 in the
    // clang executable, and the seven were exactly the =~ assertions that need a MATCH or a
    // compile ERROR - dbr5 dbr6 dbr7 dbr15 dbr16 dbr19 dbr21. dbr17 and dbr18, the two that
    // expect NO match, passed for entirely the wrong reason. ./test.sh cannot see any of
    // this: it compares each engine against ITSELF, and both engines called the same Go
    // extern, so they agreed. `clang -S -x ir` cannot see it either - the module is
    // well-formed; the defect is a symbol that is not there.
    //
    // Emitting the engine closes the class BY CONSTRUCTION rather than by test: llvm.Run and
    // clang now execute the same instructions, so there is nothing left that can diverge.
    // The price is that this, not lib/regex.js, is now the compiler half's matcher, so the
    // two halves CAN drift - which is why section 11 of the ratchet grew a block of =~
    // assertions (dbr22..dbr45), every one settled against the real bash 5.3 first. That is
    // a gap a test can see, where the old one was a gap no test could see.
    //
    // The design is Thompson-style codegen plus a recursive backtracking VM, both in IR:
    //   * re_alt/re_cat/re_rep/re_atom parse the ERE and emit a 4-word instruction into
    //     re_prog. Recursion is the IR call stack, exactly as rt_glob already does it.
    //   * re_run walks that program, recursing at SPLIT. Leftmost-first, greedy - which is
    //     what bash reports: `^(foo|foobar)bar$` on "foobar" yields BASH_REMATCH[1]=foo.
    //   * a * or + loop is fenced by SAVE/PROG on a scratch slot, so an iteration that
    //     consumed nothing cannot repeat. Without it `^(a*)*$` on "aaa" would leave
    //     BASH_REMATCH[1] empty; bash says "aaa".
    var i32ptr = llvm.types.NewPointer(i32)
    var rtRegexSearch = m.NewFunc("rt_regex_search", i32,
        [llvm.ir.NewParam("pat", i8ptr), llvm.ir.NewParam("subj", i8ptr),
         llvm.ir.NewParam("flags", i8ptr), llvm.ir.NewParam("caps", i32ptr),
         llvm.ir.NewParam("ncaps", i32)])
    var rtRegexError = m.NewFunc("rt_regex_error", i8ptr)

    var RE_PROG  = 4096   // instruction slots
    var RE_NCLS  = 64     // bracket-expression bitmaps, 32 bytes each
    var RE_NCAP  = 128    // capture slots - 64 pairs, matching NCAPPAIRS at the call site
    var RE_NMARK = 64     // empty-iteration guard slots, one per * or + loop
    var RE_SLOTS = RE_NCAP + RE_NMARK
    var RE_STEPS = 400000 // total VM steps per rt_regex_search call

    var OP_CHAR = 1, OP_ANY = 2, OP_CLASS = 3, OP_SPLIT = 4, OP_JMP = 5
    var OP_SAVE = 6, OP_MATCH = 7, OP_BOL = 8, OP_EOL = 9, OP_PROG = 10
    // OP_CLEAR x,y: set capture slots x..y to -1 (the per-iteration capture reset). x > y
    // is a legal no-op, which is what a repeated atom with no groups inside it gets.
    var OP_CLEAR = 11

    // Indexed by re_bad. The text only ever reaches the stderr CHANNEL, whose bytes this
    // runtime drops, but a wrong code would still be a wrong status, so they are real.
    var reErrText = ["", "Unmatched ( or \\(", "Unmatched [, [^, [:, [., or [=",
                     "Invalid content of \\{\\}", "Regular expression too big",
                     "Invalid preceding regular expression", "Trailing backslash",
                     "Invalid range end", "empty (sub)expression",
                     "Invalid character class name"]

    var reProgTy = llvm.types.NewArray(RE_PROG * 4, i32)
    var gReProg = m.NewGlobalDef("re_prog", llvm.constant.NewZeroInitializer(reProgTy))
    var reClsTy = llvm.types.NewArray(RE_NCLS * 32, i8)
    var gReCls = m.NewGlobalDef("re_cls", llvm.constant.NewZeroInitializer(reClsTy))
    var reSlotTy = llvm.types.NewArray(RE_SLOTS, i32)
    var gReSlot = m.NewGlobalDef("re_slot", llvm.constant.NewZeroInitializer(reSlotTy))
    var gRePc = m.NewGlobalDef("re_pc", zero)
    var gRePat = m.NewGlobalDef("re_pat", nullStr)
    var gRePos = m.NewGlobalDef("re_pos", zero)
    var gReNg = m.NewGlobalDef("re_ng", zero)
    var gReNcls = m.NewGlobalDef("re_ncls", zero)
    var gReNmark = m.NewGlobalDef("re_nmark", zero)
    var gReDepth = m.NewGlobalDef("re_depth", zero)
    var gReErr = m.NewGlobalDef("re_err", nullStr)
    var gReSubj = m.NewGlobalDef("re_subj", nullStr)
    var gReSlen = m.NewGlobalDef("re_slen", zero)
    var gReSteps = m.NewGlobalDef("re_steps", zero)
    // The undo stack for OP_CLEAR. A cleared slot has to come BACK when the iteration
    // that cleared it fails, exactly as OP_SAVE puts its old offset back - but a CLEAR
    // writes a whole range, which will not fit in the re_run frame (one frame per
    // backtracking choice: an alloca that big would be paid on every one of them). So
    // the old values go on a stack of their own, pushed on the way in and popped on the
    // way out, and an overrun fails the attempt the way the step cap does.
    var RE_CSTK = 8192
    var reCstkTy = llvm.types.NewArray(RE_CSTK, i32)
    var gReCstk = m.NewGlobalDef("re_cstk", llvm.constant.NewZeroInitializer(reCstkTy))
    var gReCtop = m.NewGlobalDef("re_ctop", zero)
    var gReFold = m.NewGlobalDef("re_fold", zero)

    // The mutually recursive halves, declared before any body needs them.
    var reAlt = m.NewFunc("re_alt", i32)
    var reCat = m.NewFunc("re_cat", i32)
    var reRep = m.NewFunc("re_rep", i32)
    var reAtom = m.NewFunc("re_atom", i32)
    var reRun = m.NewFunc("re_run", i32,
        [llvm.ir.NewParam("rpc", i32), llvm.ir.NewParam("rsp", i32)])

    // ---- program store ----
    // i32 re_get(i32 pc, i32 k) / re_set(i32 pc, i32 k, i32 v): word k of instruction pc.
    var reGet = m.NewFunc("re_get", i32,
        [llvm.ir.NewParam("gpc", i32), llvm.ir.NewParam("gk", i32)])
    ;(function() {
        var pc = reGet.Params[0], k = reGet.Params[1]
        var e = reGet.NewBlock("rgent")
        e.NewRet(e.NewLoad(i32, e.NewGetElementPtr(reProgTy, gReProg, zero,
                 e.NewAdd(e.NewMul(pc, reK(4)), k))))
    })()
    var reSet = m.NewFunc("re_set", i32,
        [llvm.ir.NewParam("spc", i32), llvm.ir.NewParam("sk", i32), llvm.ir.NewParam("sv", i32)])
    ;(function() {
        var pc = reSet.Params[0], k = reSet.Params[1], v = reSet.Params[2]
        var e = reSet.NewBlock("rsent")
        e.NewStore(v, e.NewGetElementPtr(reProgTy, gReProg, zero,
                   e.NewAdd(e.NewMul(pc, reK(4)), k)))
        e.NewRet(zero)
    })()
    function reSetF(b, pc, k, v) { b.NewCall(reSet, [pc, reK(k), v]) }
    function reGetF(b, pc, k) { return b.NewCall(reGet, [pc, reK(k)]) }

    // i32 re_emit(op, x, y): append one instruction, answer its pc. An overrun raises
    // re_bad rather than writing past re_prog - the arena would have absorbed that write.
    var reEmit = m.NewFunc("re_emit", i32,
        [llvm.ir.NewParam("eop", i32), llvm.ir.NewParam("ex", i32), llvm.ir.NewParam("ey", i32)])
    ;(function() {
        var op = reEmit.Params[0], x = reEmit.Params[1], y = reEmit.Params[2]
        var e = reEmit.NewBlock("reent")
        var ov = reEmit.NewBlock("reover")
        var ok = reEmit.NewBlock("reok")
        var pc = e.NewLoad(i32, gRePc)
        e.NewCondBr(e.NewICmp(reSGE, pc, reK(RE_PROG)), ov, ok)
        ov.NewStore(reK(4), gReBad)
        ov.NewRet(zero)
        reSetF(ok, pc, 0, op)
        reSetF(ok, pc, 1, x)
        reSetF(ok, pc, 2, y)
        ok.NewStore(ok.NewAdd(pc, one), gRePc)
        ok.NewRet(pc)
    })()
    function reEmitF(b, op, x, y) { return b.NewCall(reEmit, [reK(op), x, y]) }

    // i32 re_mark(): the next empty-iteration guard slot. Slots wrap rather than run out,
    // so a pattern with more than RE_NMARK loops degrades to sharing a guard instead of
    // indexing off the end of re_slot.
    var reMark = m.NewFunc("re_mark", i32)
    ;(function() {
        var e = reMark.NewBlock("rment")
        var n = e.NewLoad(i32, gReNmark)
        e.NewStore(e.NewAdd(n, one), gReNmark)
        e.NewRet(e.NewAdd(reK(RE_NCAP), e.NewSRem(n, reK(RE_NMARK))))
    })()

    // ---- pattern cursor ----
    // i32 re_at(i32 d): the pattern byte d ahead of the cursor, 0 at or past the end. The
    // scan STOPS at the NUL, so a two-character lookahead at the last character never reads
    // the byte after the terminator - our arena tolerates that, a real heap need not.
    var reAt = m.NewFunc("re_at", i32, llvm.ir.NewParam("atd", i32))
    ;(function() {
        var d = reAt.Params[0]
        var e = reAt.NewBlock("raent")
        var h = reAt.NewBlock("rahead")
        var bd = reAt.NewBlock("rabody")
        var x = reAt.NewBlock("raexit")
        var p = e.NewLoad(i8ptr, gRePat)
        var ip = e.NewAlloca(i32), kp = e.NewAlloca(i32), cp = e.NewAlloca(i32)
        e.NewStore(e.NewLoad(i32, gRePos), ip)
        e.NewStore(zero, kp)
        e.NewStore(zero, cp)
        e.NewBr(h)
        var ch = h.NewZExt(h.NewLoad(i8, h.NewGetElementPtr(i8, p, h.NewLoad(i32, ip))), i32)
        h.NewStore(ch, cp)
        h.NewCondBr(h.NewAnd(h.NewICmp(reNE, ch, zero),
                             h.NewICmp(reSLT, h.NewLoad(i32, kp), d)), bd, x)
        bd.NewStore(bd.NewAdd(bd.NewLoad(i32, ip), one), ip)
        bd.NewStore(bd.NewAdd(bd.NewLoad(i32, kp), one), kp)
        bd.NewBr(h)
        x.NewRet(x.NewLoad(i32, cp))
    })()
    function reAtF(b, d) { return b.NewCall(reAt, reK(d)) }
