    // depths are read here.
    var gLsTop = rtGlobal("ls_top", i32)
    var gNvars = rtGlobal("nvars", i32)   // filled by main's entry block
    // The standard input a pipeline stage hands on.
    var gStdin = rtGlobal("stdin_buf", i8ptr)

    // Shell options (set -e / -u / -o pipefail) and the abort flag a set -u failure raises
    // during expansion (expansion cannot return a status, so the command about to run picks
    // it up - exactly the shape the interpreter uses).
    var gOptE = rtGlobal("opt_errexit", i32)
    var gOptU = rtGlobal("opt_nounset", i32)
    var gOptPf = rtGlobal("opt_pipefail", i32)
    var gAbort = rtGlobal("abort_flag", i32)
    var gArithErr = rtGlobal("arith_err", i32)   // an arithmetic or substring error (rt_arith_fail)
    var gCondErr = rtGlobal("cond_err", i32)   // a [[ ]] that could not be evaluated

