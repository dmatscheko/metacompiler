        var declOne = function(b, j, v) {
            // WHICH KEYWORDS ARE LOCAL. bash 5.3: `local`, `declare` and `typeset` inside a
            // function declare a function-local name (value AND attributes restored on
            // return) unless -g is given; `export` and `readonly` always act on the global.
            var localize = !global && (kw == "local" || ((kw == "declare" || kw == "typeset") && curFrame != null))
            var fresh = localize && curFrame != null && !hasOwn(curFrame.locs, "$" + names[j])
            // A nameref to itself is refused outside a function, and nothing is declared
            // (bash 5.3; inside one bash only warns, which is not modelled): a literal value
            // here, a computed one when it is stored (selfRef). Twin of the same check in
            // makeDecl in bash-interpreter.abnf.
            var selfMsg = kw + ": " + names[j] + ": nameref variable self references not allowed\n"
            var selfRef = isRef && curFrame == null && asgs[j] != null
            if (selfRef && v == null && asgs[j].valT != null && asgs[j].valT.c != undefined) {
                selfRef = false
