    // length of s. rt_csubstr converts a character range with it.
    var rtCharOff = rtDecl("rt_charoff", false, [1, 0])
    // i32 rt_streq(i8* a, i8* b) -> 1 if equal, else 0.
    var rtStreq = rtDecl("rt_streq", false, [1, 1])
    // i32 rt_strcmp(i8* a, i8* b): -1 / 0 / 1 by unsigned byte order (the shell's < and >).
    var rtStrcmp = rtDecl("rt_strcmp", false, [1, 1])
    // i8* rt_strcat(i8* a, i8* b): fresh arena string = a followed by b.
    var rtStrcat = rtDecl("rt_strcat", true, [1, 1])
    // i8* rt_int2str(i64 n): decimal string in the arena (mirrors the interpreter's numToStr).
    var rtInt2str = rtDecl("rt_int2str", true, [3])
    // i64 rt_str2int(i8* s): leading spaces/tabs, one +/- sign, digits until non-digit.
    var rtStr2int = rtDecl("rt_str2int", 3, [1])
    // i64 rt_arith(i8* expr): the arithmetic evaluator for an expression that only exists at
    // run time; rt_idiv / rt_ipow are / % and ** with bash's error cases. Any of them can
    // raise arith_err (see languages/lib/bash-rt.c).
    var rtArith = rtDecl("rt_arith", 3, [1])
    var rtLetFields = rtDecl("rt_letfields", 3, [1, 0])
    var rtPcheck = rtDecl("rt_pcheck", true, [1, 0, 1, 1])
    var rtSubErr = rtDecl("rt_suberr", false, [0, 0])
    var rtIdiv = rtDecl("rt_idiv", 3, [3, 3, 0, 1, 1])
    var rtIpow = rtDecl("rt_ipow", 3, [3, 3, 1, 1])
