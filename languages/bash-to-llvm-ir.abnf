    function mkArCond(items) {
        if (items.length == 1) { return items[0] }
        var c0 = items[0], t1 = items[1], t2 = items[2]
        return function(b) {
            var rc = c0(b)
            var tb = curF.NewBlock(""), fb = curF.NewBlock(""), jb = curF.NewBlock("")
            rc.b.NewCondBr(rc.b.NewICmp(llvm.enum.IPredNE, rc.v, zero64), tb, fb)
            var r1 = t1(tb)
            r1.b.NewBr(jb)
            var r2 = t2(fb)
            r2.b.NewBr(jb)
            return {b: jb, v: jb.NewPhi([llvm.ir.NewIncoming(r1.v, r1.b), llvm.ir.NewIncoming(r2.v, r2.b)])}
