        var lhs = items[0]
        var aop = items[1].aop
        var t = items[2]
        var rc = arRecLa(at)
        return refMayThunk(lhs.lhs, function(b) {
            var rk = arLhsKey(b, lhs)
            b = rk.b
            // Plain = does not read the target: `x=q; (( x = 5 ))` is no recursion error.
            var cur = (aop != "=") ? arLhsGet(b, lhs.lhs, rk) : null
            var r = t(b)
            b = r.b
            var nv = r.v
            if (aop != "=") {
