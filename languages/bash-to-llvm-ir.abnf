        ifend.NewBr(ifh)
        var pv = ifh.NewLoad(i32, endp)
        ifh.NewCondBr(ifh.NewICmp(reSGE, pv, zero), ifb, ifx)
        ifb.NewStore(reGetF(ifb, pv, 2), endp)
        reSetF(ifb, pv, 2, endv)
        ifb.NewBr(ifh)
        ifx.NewRet(zero)
    })()

    // i32 re_cat(): a run of quantified atoms; answers how many there were, so re_alt can
    // reject an EMPTY branch - bash 5.3 rejects "(a|)", "|a" and "" alike, status 2.
    ;(function() {
        var f = reCat
        var e = f.NewBlock("rctent")
        var h = f.NewBlock("rcth")
        var bd = f.NewBlock("rctb")
        var x = f.NewBlock("rctx")
        var np = e.NewAlloca(i32)
        e.NewStore(zero, np)
        e.NewBr(h)
        var c = h.NewCall(reAt, zero)
        // A ")" only closes a group when one is open; at the top level bash takes it as a
        // literal - [[ "a)b" =~ ")" ]] matches, it is not "unmatched )".
        var isRp = h.NewAnd(h.NewICmp(reEQ, c, reK(41)),
                            h.NewICmp(reSGT, h.NewLoad(i32, gReDepth), zero))
        var stop = h.NewOr(h.NewOr(h.NewICmp(reEQ, c, zero), h.NewICmp(reEQ, c, reK(124))), isRp)
        h.NewCondBr(h.NewOr(stop, h.NewICmp(reNE, h.NewLoad(i32, gReBad), zero)), x, bd)
        bd.NewCall(reRep)
        bd.NewStore(bd.NewAdd(bd.NewLoad(i32, np), one), np)
        bd.NewBr(h)
        x.NewRet(x.NewLoad(i32, np))
    })()

    // i32 re_alt(): branch | branch | ...
    ;(function() {
        var f = reAlt
        var e = f.NewBlock("ralent")
        var lp = f.NewBlock("rallp")
        var lp1 = f.NewBlock("rallp1"), lp2 = f.NewBlock("rallp2")
        var mt = f.NewBlock("ralmt")
        var more = f.NewBlock("ralmore"), last = f.NewBlock("rallast")
        var ph = f.NewBlock("ralph"), pb = f.NewBlock("ralpb"), x = f.NewBlock("ralx")
        var pendp = e.NewAlloca(i32)
        e.NewStore(reK(-1), pendp)
        // An empty BRANCH is not decided here: whether it is an error depends on how
        // many branches there turn out to be. emptyp remembers that one was seen and
        // naltp counts them; the verdict is at the end.
        var emptyp = e.NewAlloca(i32), naltp = e.NewAlloca(i32)
        e.NewStore(zero, emptyp)
        e.NewStore(zero, naltp)
        e.NewBr(lp)

        lp.NewStore(lp.NewAdd(lp.NewLoad(i32, naltp), one), naltp)
        var sp = lp.NewCall(reEmit, [reK(OP_JMP), zero, zero])
        var body = lp.NewLoad(i32, gRePc)
        var n = lp.NewCall(reCat)
        lp.NewCondBr(lp.NewAnd(lp.NewICmp(reEQ, n, zero),
                               lp.NewICmp(reEQ, lp.NewLoad(i32, gReBad), zero)), mt, lp1)
        mt.NewStore(one, emptyp)
        mt.NewBr(lp1)
        lp1.NewCondBr(lp1.NewICmp(reNE, lp1.NewLoad(i32, gReBad), zero), last, lp2)
        lp2.NewCondBr(lp2.NewICmp(reEQ, lp2.NewCall(reAt, zero), reK(124)), more, last)

        reAdv(more, 1)
        var j = more.NewCall(reEmit, [reK(OP_JMP), zero, more.NewLoad(i32, pendp)])
        more.NewStore(j, pendp)
        reSetF(more, sp, 0, reK(OP_SPLIT))
        reSetF(more, sp, 1, body)
        reSetF(more, sp, 2, more.NewLoad(i32, gRePc))
        more.NewBr(lp)

        reSetF(last, sp, 1, body)
        var endv = last.NewLoad(i32, gRePc)
        last.NewBr(ph)
        var pv = ph.NewLoad(i32, pendp)
        ph.NewCondBr(ph.NewICmp(reSGE, pv, zero), pb, x)
        pb.NewStore(reGetF(pb, pv, 2), pendp)
        reSetF(pb, pv, 1, endv)
        pb.NewBr(ph)
        // A POSIX ERE branch may not be empty: bash rejects "", "a|", "|a", "(a|)" and
        // "(|a)" alike with "empty (sub)expression". The one exception is a group whose
        // WHOLE body is empty - "()", "(())" and "(a)()" match the empty string in bash
        // 5.3 - so the emptiness is only an error for a branch of a real alternation, or
        // for the top level of the pattern. Same rule as lib/regex.js rxParseAlt.
        var xbad = f.NewBlock("ralxbad"), xret = f.NewBlock("ralxret")
        var wasEmpty = x.NewICmp(reNE, x.NewLoad(i32, emptyp), zero)
        var isReal = x.NewOr(x.NewICmp(reSGT, x.NewLoad(i32, naltp), one),
                             x.NewICmp(reEQ, x.NewLoad(i32, gReDepth), zero))
        var stillOK = x.NewICmp(reEQ, x.NewLoad(i32, gReBad), zero)
        x.NewCondBr(x.NewAnd(x.NewAnd(wasEmpty, isReal), stillOK), xbad, xret)
        xbad.NewStore(reK(8), gReBad)   // empty (sub)expression
        xbad.NewBr(xret)
        xret.NewRet(zero)
    })()

    // i32 re_run(i32 pc, i32 sp): the backtracking VM. 1 match, 0 fail, -2 step cap.
    ;(function() {
        var f = reRun
        var e = f.NewBlock("rvent")
        var h = f.NewBlock("rvh")
        var over = f.NewBlock("rvover"), go = f.NewBlock("rvgo")
        var fail = f.NewBlock("rvfail"), hit = f.NewBlock("rvhit")
        var pcp = e.NewAlloca(i32), spp = e.NewAlloca(i32)
        var cip = e.NewAlloca(i32)
        e.NewStore(f.Params[0], pcp)
        e.NewStore(f.Params[1], spp)
        e.NewBr(h)
        var st = h.NewLoad(i32, gReSteps)
        h.NewCondBr(h.NewICmp(reSGE, st, reK(RE_STEPS)), over, go)
        over.NewRet(reK(-2))
        go.NewStore(go.NewAdd(st, one), gReSteps)
        var pc = go.NewLoad(i32, pcp), sp = go.NewLoad(i32, spp)
        var op = go.NewCall(reGet, [pc, zero])
        var vx = go.NewCall(reGet, [pc, one])
        var vy = go.NewCall(reGet, [pc, reK(2)])
        var slen = go.NewLoad(i32, gReSlen)
        var subj = go.NewLoad(i8ptr, gReSubj)
        var atEnd = go.NewICmp(reSGE, sp, slen)
        var pc1 = go.NewAdd(pc, one), sp1 = go.NewAdd(sp, one)
        fail.NewRet(zero)
        hit.NewRet(one)

        var bChar = f.NewBlock("rvchar"), bAny = f.NewBlock("rvany")
        var bCls = f.NewBlock("rvcls"), bSplit = f.NewBlock("rvsplit")
        var bJmp = f.NewBlock("rvjmp"), bSave = f.NewBlock("rvsave")
        var bBol = f.NewBlock("rvbol"), bEol = f.NewBlock("rveol")
        var bProg = f.NewBlock("rvprog")
        var bClear = f.NewBlock("rvclear")
        var nb = go
        var vn = 0
        function vchain(cond, tgt) {
            vn = vn + 1
            var nx = f.NewBlock("rvn" + vn)
            nb.NewCondBr(cond, tgt, nx)
            nb = nx
        }
        function isop(v) { return go.NewICmp(reEQ, op, reK(v)) }
        vchain(isop(OP_CHAR), bChar)
        vchain(isop(OP_ANY), bAny)
        vchain(isop(OP_CLASS), bCls)
        vchain(isop(OP_SPLIT), bSplit)
        vchain(isop(OP_JMP), bJmp)
        vchain(isop(OP_SAVE), bSave)
        vchain(isop(OP_MATCH), hit)
        vchain(isop(OP_BOL), bBol)
        vchain(isop(OP_EOL), bEol)
        vchain(isop(OP_PROG), bProg)
        vchain(isop(OP_CLEAR), bClear)
        nb.NewBr(fail)

        // Every byte read is fenced by sp < slen, so no path loads the NUL terminator or
        // anything after it.
        var bc2 = f.NewBlock("rvchar2")
        bChar.NewCondBr(atEnd, fail, bc2)
        var cb = bc2.NewCall(reFold1,
                   bc2.NewZExt(bc2.NewLoad(i8, bc2.NewGetElementPtr(i8, subj, sp)), i32))
        var bc3 = f.NewBlock("rvchar3")
        bc2.NewCondBr(bc2.NewICmp(reNE, cb, vx), fail, bc3)
        bc3.NewStore(pc1, pcp); bc3.NewStore(sp1, spp); bc3.NewBr(h)

        var ba2 = f.NewBlock("rvany2")
        bAny.NewCondBr(atEnd, fail, ba2)
        ba2.NewStore(pc1, pcp); ba2.NewStore(sp1, spp); ba2.NewBr(h)

        var bl2 = f.NewBlock("rvcls2"), bl3 = f.NewBlock("rvcls3")
        bCls.NewCondBr(atEnd, fail, bl2)
        var lb = bl2.NewCall(reFold1,
                   bl2.NewZExt(bl2.NewLoad(i8, bl2.NewGetElementPtr(i8, subj, sp)), i32))
        var byt = bl2.NewZExt(bl2.NewLoad(i8, bl2.NewGetElementPtr(reClsTy, gReCls, zero,
                    bl2.NewAdd(bl2.NewMul(vx, reK(32)), bl2.NewSDiv(lb, reK(8))))), i32)
        var got = bl2.NewAnd(bl2.NewLShr(byt, bl2.NewSRem(lb, reK(8))), one)
        bl2.NewCondBr(bl2.NewICmp(reEQ, got, zero), fail, bl3)
        bl3.NewStore(pc1, pcp); bl3.NewStore(sp1, spp); bl3.NewBr(h)

        // The IR call stack IS the backtracking stack, exactly as rt_glob's "*" does it.
        var sr = bSplit.NewCall(reRun, [vx, sp])
        var sp2 = f.NewBlock("rvsplit2"), sret = f.NewBlock("rvsret")
        bSplit.NewCondBr(bSplit.NewICmp(reNE, sr, zero), sret, sp2)
        sret.NewRet(sr)
        sp2.NewStore(vy, pcp); sp2.NewBr(h)

        bJmp.NewStore(vx, pcp); bJmp.NewBr(h)

        // A capture (or a loop's empty-iteration mark) is UNDONE when the branch that set
        // it fails, so a dead alternative cannot leave an offset behind.
        var slp = bSave.NewGetElementPtr(reSlotTy, gReSlot, zero, vx)
        var old = bSave.NewLoad(i32, slp)
        bSave.NewStore(sp, slp)
        var vr = bSave.NewCall(reRun, [pc1, sp])
        var und = f.NewBlock("rvundo"), vrt = f.NewBlock("rvsavret")
        bSave.NewCondBr(bSave.NewICmp(reEQ, vr, zero), und, vrt)
        und.NewStore(old, slp)
        und.NewBr(vrt)
        vrt.NewRet(vr)

        // OP_CLEAR: the same write / recurse / put-it-back discipline as OP_SAVE, over a
        // RANGE of slots. The old values go on re_cstk (see there for why not the frame),
        // and an overrun of that stack fails the attempt rather than writing past it.
        var cbase = bClear.NewLoad(i32, gReCtop)
        var cn = bClear.NewAdd(bClear.NewSub(vy, vx), one)
        var cGo = f.NewBlock("rvclgo")
        bClear.NewCondBr(bClear.NewICmp(reSGT, bClear.NewAdd(cbase, cn), reK(RE_CSTK)),
                         fail, cGo)
        var cPushX = reFor(f, "rvclp", cGo, cip, vx, cGo.NewAdd(vy, one), function(b, i) {
            var sl = b.NewGetElementPtr(reSlotTy, gReSlot, zero, i)
            b.NewStore(b.NewLoad(i32, sl),
                       b.NewGetElementPtr(reCstkTy, gReCstk, zero,
                                          b.NewAdd(cbase, b.NewSub(i, vx))))
            b.NewStore(reK(-1), sl)
            return b
        })
        cPushX.NewStore(cPushX.NewAdd(cbase, cn), gReCtop)
        var cr = cPushX.NewCall(reRun, [pc1, sp])
        cPushX.NewStore(cbase, gReCtop)
        var cUndo = f.NewBlock("rvclun"), cRet = f.NewBlock("rvclrt")
        cPushX.NewCondBr(cPushX.NewICmp(reEQ, cr, zero), cUndo, cRet)
        var cPopX = reFor(f, "rvclq", cUndo, cip, vx, cUndo.NewAdd(vy, one), function(b, i) {
            b.NewStore(b.NewLoad(i32, b.NewGetElementPtr(reCstkTy, gReCstk, zero,
                                       b.NewAdd(cbase, b.NewSub(i, vx)))),
                       b.NewGetElementPtr(reSlotTy, gReSlot, zero, i))
            return b
        })
        cPopX.NewBr(cRet)
        cRet.NewRet(cr)

        var pg2 = f.NewBlock("rvprog2")
        bProg.NewCondBr(bProg.NewICmp(reEQ, sp,
                          bProg.NewLoad(i32, bProg.NewGetElementPtr(reSlotTy, gReSlot, zero, vx))),
                        fail, pg2)
        pg2.NewStore(pc1, pcp); pg2.NewBr(h)

        var bb2 = f.NewBlock("rvbol2")
        bBol.NewCondBr(bBol.NewICmp(reNE, sp, zero), fail, bb2)
        bb2.NewStore(pc1, pcp); bb2.NewBr(h)
        var be2 = f.NewBlock("rveol2")
        bEol.NewCondBr(bEol.NewICmp(reNE, sp, slen), fail, be2)
        be2.NewStore(pc1, pcp); be2.NewBr(h)
    })()

    // ---- the two entry points ----
    ;(function() {
        var f = rtRegexSearch
        var pat = f.Params[0], subj = f.Params[1], flg = f.Params[2]
        var caps = f.Params[3], ncaps = f.Params[4]
        var e = f.NewBlock("rxent")
        var ip = e.NewAlloca(i32), jp = e.NewAlloca(i32), kp = e.NewAlloca(i32)
        var startp = e.NewAlloca(i32)
        // Pre-fill with -1 so no caller can read a stale offset, whatever it does with the
        // answer - the contract the Go extern documented and this must keep.
        var hasCaps = e.NewICmp(reNE, caps, llvm.constant.NewNull(i32ptr))
        var cl0 = f.NewBlock("rxcl0"), cl1 = f.NewBlock("rxcl1")
        e.NewCondBr(hasCaps, cl0, cl1)
        var cl0x = reFor(f, "rxcl", cl0, ip, zero, ncaps, function(b, i) {
            b.NewStore(reK(-1), b.NewGetElementPtr(i32, caps, i))
            return b
        })
        cl0x.NewBr(cl1)

        // flags: only "i" is meaningful to bash's =~ (shopt -s nocasematch); a null pointer
        // is "no flags" and must not be dereferenced.
        cl1.NewStore(zero, gReFold)
        var fl0 = f.NewBlock("rxfl0"), fl1 = f.NewBlock("rxfl1")
        cl1.NewCondBr(cl1.NewICmp(reNE, flg, llvm.constant.NewNull(i8ptr)), fl0, fl1)
        var flh = f.NewBlock("rxflh"), flb = f.NewBlock("rxflb"), flset = f.NewBlock("rxflset")
        fl0.NewStore(zero, jp)
        fl0.NewBr(flh)
        var fc = flh.NewZExt(flh.NewLoad(i8, flh.NewGetElementPtr(i8, flg, flh.NewLoad(i32, jp))), i32)
        flh.NewCondBr(flh.NewICmp(reEQ, fc, zero), fl1, flb)
        var flb2 = f.NewBlock("rxflb2")
        flb.NewCondBr(flb.NewICmp(reEQ, fc, reK(105)), flset, flb2)
        flset.NewStore(one, gReFold)
        flset.NewBr(flb2)
        flb2.NewStore(flb2.NewAdd(flb2.NewLoad(i32, jp), one), jp)
        flb2.NewBr(flh)

        // ---- compile
        fl1.NewStore(fl1.NewSelect(fl1.NewICmp(reEQ, pat, llvm.constant.NewNull(i8ptr)),
                                   emptyPtr(fl1), pat), gRePat)
        fl1.NewStore(zero, gRePos)
        fl1.NewStore(zero, gRePc)
        fl1.NewStore(zero, gReNg)
        fl1.NewStore(zero, gReNcls)
        fl1.NewStore(zero, gReNmark)
        fl1.NewStore(zero, gReBad)
        fl1.NewStore(zero, gReDepth)
        fl1.NewCall(reEmit, [reK(OP_SAVE), zero, zero])
        fl1.NewCall(reAlt)
        var cbad = f.NewBlock("rxcbad"), cok = f.NewBlock("rxcok")
        fl1.NewCondBr(fl1.NewICmp(reNE, fl1.NewLoad(i32, gReBad), zero), cbad, cok)
        var bad = cbad.NewLoad(i32, gReBad)
        var msg = emptyPtr(cbad)
        var t
        for (t = 1; t < reErrText.length; t = t + 1) {
            msg = cbad.NewSelect(cbad.NewICmp(reEQ, bad, reK(t)), gepStr(cbad, reErrText[t]), msg)
        }
        cbad.NewStore(msg, gReErr)
        cbad.NewRet(reK(-1))

        cok.NewStore(emptyPtr(cok), gReErr)
        cok.NewCall(reEmit, [reK(OP_SAVE), one, zero])
        cok.NewCall(reEmit, [reK(OP_MATCH), zero, zero])
        var slen = cok.NewCall(rtStrlen, subj)
        cok.NewStore(subj, gReSubj)
        cok.NewStore(slen, gReSlen)
        cok.NewStore(zero, gReSteps)
        cok.NewStore(zero, gReCtop)
        var pairs = cok.NewAdd(cok.NewLoad(i32, gReNg), one)

        // ---- search: leftmost wins, so the start position is tried in order.
        var sh = f.NewBlock("rxsh"), sb = f.NewBlock("rxsb"), nom = f.NewBlock("rxnom")
        cok.NewStore(zero, startp)
        cok.NewBr(sh)
        var start = sh.NewLoad(i32, startp)
        sh.NewCondBr(sh.NewICmp(reSLE, start, slen), sb, nom)
        var sbx = reFor(f, "rxsl", sb, kp, zero, reK(RE_SLOTS), function(b, i) {
            b.NewStore(reK(-1), b.NewGetElementPtr(reSlotTy, gReSlot, zero, i))
            return b
        })
        var r = sbx.NewCall(reRun, [zero, start])
        var lim = f.NewBlock("rxlim"), r2 = f.NewBlock("rxr2")
        sbx.NewCondBr(sbx.NewICmp(reEQ, r, reK(-2)), lim, r2)
        lim.NewRet(reK(-2))
        var won = f.NewBlock("rxwon"), nxt = f.NewBlock("rxnxt")
        r2.NewCondBr(r2.NewICmp(reEQ, r, one), won, nxt)
        nxt.NewStore(nxt.NewAdd(start, one), startp)
        nxt.NewBr(sh)
        nom.NewRet(zero)

        // The TRUE pair count is answered even when it exceeds the caps array, so
        // ${#BASH_REMATCH[@]} stays exact and the entries past it read as empty.
        var room = won.NewSDiv(ncaps, reK(2))
        var lastp = won.NewSelect(won.NewICmp(reSLT, pairs, room), pairs, room)
        var slots = won.NewSelect(hasCaps, won.NewMul(lastp, reK(2)), zero)
        var wonx = reFor(f, "rxfill", won, jp, zero, slots, function(b, i) {
            b.NewStore(b.NewLoad(i32, b.NewGetElementPtr(reSlotTy, gReSlot, zero, i)),
                       b.NewGetElementPtr(i32, caps, i))
            return b
        })
        wonx.NewRet(pairs)
    })()

    ;(function() {
        var f = rtRegexError
        var e = f.NewBlock("rxeent")
        var nn = f.NewBlock("rxenn"), x = f.NewBlock("rxex")
        var v = e.NewLoad(i8ptr, gReErr)
        // Never a null: the caller concatenates this straight into a message, and reading
        // byte 0 of address 0 is the documented trap our machine forgives and a real
        // process does not.
        e.NewCondBr(e.NewICmp(reEQ, v, llvm.constant.NewNull(i8ptr)), nn, x)
        nn.NewRet(emptyPtr(nn))
        x.NewRet(v)
    })()

    // i8* rt_nounset(i8* v): under set -u, reading an unset variable raises the abort flag.
    var rtNounset = m.NewFunc("rt_nounset", i8ptr, llvm.ir.NewParam("v", i8ptr))
    ;(function() {
        var v = rtNounset.Params[0]
        var e = rtNounset.NewBlock("entry")
        var hit = rtNounset.NewBlock("hit")
        var x = rtNounset.NewBlock("exit")
        var um = e.NewGetElementPtr(emptyTy, gUnset, zero, zero)
        var bad = e.NewAnd(e.NewICmp(llvm.enum.IPredNE, e.NewLoad(i32, gOptU), zero),
                           e.NewICmp(llvm.enum.IPredEQ, v, um))
        e.NewCondBr(bad, hit, x)
        hit.NewStore(one, gAbort)
        hit.NewBr(x)
        x.NewRet(v)
    })()

    // i32 rt_putc(i32 c): one output byte - into the innermost capture buffer if a command
    // substitution is running, otherwise to stdout.
    var rtPutc = m.NewFunc("rt_putc", i32, llvm.ir.NewParam("c", i32))
    ;(function() {
        var cv = rtPutc.Params[0]
        var e = rtPutc.NewBlock("entry")
        var cap = rtPutc.NewBlock("cap")
        var out = rtPutc.NewBlock("out")
        var x = rtPutc.NewBlock("exit")
        var chan = e.NewLoad(i32, gSinkOut)
        var drop = rtPutc.NewBlock("drop")
        var live = rtPutc.NewBlock("live")
        e.NewCondBr(e.NewICmp(llvm.enum.IPredEQ, chan, zero), live, drop)
        drop.NewBr(x)
        var d = live.NewLoad(i32, gCapDepth)
        live.NewCondBr(live.NewICmp(llvm.enum.IPredSGT, d, zero), cap, out)
        var idx = cap.NewSub(d, one)
        var buf = cap.NewLoad(i8ptr, cap.NewGetElementPtr(capBufTy, gCapBuf, zero, idx))
        var lenp = cap.NewGetElementPtr(capLenTy, gCapLen, zero, idx)
        var l = cap.NewLoad(i32, lenp)
        cap.NewStore(cap.NewTrunc(cv, i8), cap.NewGetElementPtr(i8, buf, l))
        cap.NewStore(cap.NewAdd(l, one), lenp)
        cap.NewBr(x)
        out.NewCall(extPutchar, cv)
        out.NewBr(x)
        x.NewRet(zero)
    })()

    // i32 rt_cap_begin(i32): open a fresh capture buffer.
    var rtCapBegin = m.NewFunc("rt_cap_begin", i32, llvm.ir.NewParam("u", i32))
    ;(function() {
        var e = rtCapBegin.NewBlock("entry")
        var d = e.NewLoad(i32, gCapDepth)
        var buf = e.NewCall(rtBump, llvm.constant.NewInt(i32, CAPSZ))
        e.NewStore(buf, e.NewGetElementPtr(capBufTy, gCapBuf, zero, d))
        e.NewStore(zero, e.NewGetElementPtr(capLenTy, gCapLen, zero, d))
        e.NewStore(e.NewAdd(d, one), gCapDepth)
        e.NewRet(zero)
    })()

    // i8* rt_cap_end(i32): close the innermost buffer, drop its trailing newlines, NUL it.
    var rtCapEnd = m.NewFunc("rt_cap_end", i8ptr, llvm.ir.NewParam("u", i32))
    ;(function() {
        var e = rtCapEnd.NewBlock("entry")
        var h = rtCapEnd.NewBlock("head")
        var chk = rtCapEnd.NewBlock("chk")
        var bd = rtCapEnd.NewBlock("body")
        var dn = rtCapEnd.NewBlock("done")
        var d2 = e.NewSub(e.NewLoad(i32, gCapDepth), one)
        e.NewStore(d2, gCapDepth)
        var buf = e.NewLoad(i8ptr, e.NewGetElementPtr(capBufTy, gCapBuf, zero, d2))
        var lp = e.NewAlloca(i32)
        e.NewStore(e.NewLoad(i32, e.NewGetElementPtr(capLenTy, gCapLen, zero, d2)), lp)
        e.NewBr(h)
        var l = h.NewLoad(i32, lp)
        h.NewCondBr(h.NewICmp(llvm.enum.IPredSGT, l, zero), chk, dn)
        var lm = chk.NewSub(chk.NewLoad(i32, lp), one)
        var ch = chk.NewLoad(i8, chk.NewGetElementPtr(i8, buf, lm))
        chk.NewCondBr(chk.NewICmp(llvm.enum.IPredEQ, ch, llvm.constant.NewInt(i8, 10)), bd, dn)
        bd.NewStore(bd.NewSub(bd.NewLoad(i32, lp), one), lp)
        bd.NewBr(h)
        dn.NewStore(zero8, dn.NewGetElementPtr(i8, buf, dn.NewLoad(i32, lp)))
        dn.NewRet(buf)
    })()

    // rt_prints(i8* s): emit each byte until NUL (no trailing newline).
    var rtPrints = m.NewFunc("rt_prints", i32, llvm.ir.NewParam("s", i8ptr))
    ;(function() {
        var s = rtPrints.Params[0]
        var e = rtPrints.NewBlock("entry")
        var h = rtPrints.NewBlock("head")
        var bd = rtPrints.NewBlock("body")
        var x = rtPrints.NewBlock("exit")
        var ip = e.NewAlloca(i32)
        e.NewStore(zero, ip)
        e.NewBr(h)
        var i = h.NewLoad(i32, ip)
        var ch = h.NewLoad(i8, h.NewGetElementPtr(i8, s, i))
        h.NewCondBr(h.NewICmp(llvm.enum.IPredEQ, ch, zero8), x, bd)
        bd.NewCall(rtPutc, bd.NewZExt(ch, i32))
        bd.NewStore(bd.NewAdd(i, one), ip)
        bd.NewBr(h)
        x.NewRet(zero)
    })()

    // i32 rt_ss_save(i32) / rt_ss_restore(i32): push and pop a whole variable snapshot.
    var rtSsSave = m.NewFunc("rt_ss_save", i32, llvm.ir.NewParam("u", i32))
    ;(function() {
        var e = rtSsSave.NewBlock("entry")
        var h = rtSsSave.NewBlock("head")
        var bd = rtSsSave.NewBlock("body")
        var x = rtSsSave.NewBlock("exit")
        var d = e.NewLoad(i32, gSsDepth)
        var base = e.NewMul(d, llvm.constant.NewInt(i32, NVARS))
        var ip = e.NewAlloca(i32)
        e.NewStore(zero, ip)
        e.NewBr(h)
        var i = h.NewLoad(i32, ip)
        h.NewCondBr(h.NewICmp(llvm.enum.IPredSLT, i, h.NewLoad(i32, gNvars)), bd, x)
        var v = bd.NewLoad(i8ptr, bd.NewGetElementPtr(gvarsTy, gVars, zero, i))
        bd.NewStore(v, bd.NewGetElementPtr(ssTy, gSs, zero, bd.NewAdd(base, i)))
        bd.NewStore(bd.NewAdd(i, one), ip)
        bd.NewBr(h)
        x.NewStore(x.NewAdd(d, one), gSsDepth)
        x.NewRet(zero)
    })()
    var rtSsRestore = m.NewFunc("rt_ss_restore", i32, llvm.ir.NewParam("u", i32))
    ;(function() {
        var e = rtSsRestore.NewBlock("entry")
        var h = rtSsRestore.NewBlock("head")
        var bd = rtSsRestore.NewBlock("body")
        var x = rtSsRestore.NewBlock("exit")
        var d = e.NewSub(e.NewLoad(i32, gSsDepth), one)
        e.NewStore(d, gSsDepth)
        var base = e.NewMul(d, llvm.constant.NewInt(i32, NVARS))
        var ip = e.NewAlloca(i32)
        e.NewStore(zero, ip)
        e.NewBr(h)
        var i = h.NewLoad(i32, ip)
        h.NewCondBr(h.NewICmp(llvm.enum.IPredSLT, i, h.NewLoad(i32, gNvars)), bd, x)
        var v = bd.NewLoad(i8ptr, bd.NewGetElementPtr(ssTy, gSs, zero, bd.NewAdd(base, i)))
        bd.NewStore(v, bd.NewGetElementPtr(gvarsTy, gVars, zero, i))
        bd.NewStore(bd.NewAdd(i, one), ip)
        bd.NewBr(h)
        x.NewRet(zero)
    })()

    // i32 rt_push_local(i32 id): remember gvars[id]'s current value on the local save stack.
    var rtPushLocal = m.NewFunc("rt_push_local", i32, llvm.ir.NewParam("id", i32))
    ;(function() {
        var id = rtPushLocal.Params[0]
        var e = rtPushLocal.NewBlock("entry")
        var t = e.NewLoad(i32, gLsTop)
        e.NewStore(id, e.NewGetElementPtr(lsIdTy, gLsId, zero, t))
        var v = e.NewLoad(i8ptr, e.NewGetElementPtr(gvarsTy, gVars, zero, id))
        e.NewStore(v, e.NewGetElementPtr(lsValTy, gLsVal, zero, t))
        e.NewStore(e.NewAdd(t, one), gLsTop)
        e.NewRet(zero)
    })()

    // i32 rt_pop_locals(i32 depth): restore every entry above `depth` (innermost first).
    var rtPopLocals = m.NewFunc("rt_pop_locals", i32, llvm.ir.NewParam("d", i32))
    ;(function() {
        var d = rtPopLocals.Params[0]
        var e = rtPopLocals.NewBlock("entry")
        var h = rtPopLocals.NewBlock("head")
        var bd = rtPopLocals.NewBlock("body")
        var x = rtPopLocals.NewBlock("exit")
        e.NewBr(h)
        var t = h.NewLoad(i32, gLsTop)
        h.NewCondBr(h.NewICmp(llvm.enum.IPredSLE, t, d), x, bd)
        var t2 = bd.NewSub(t, one)
        bd.NewStore(t2, gLsTop)
        var sid = bd.NewLoad(i32, bd.NewGetElementPtr(lsIdTy, gLsId, zero, t2))
        var sv = bd.NewLoad(i8ptr, bd.NewGetElementPtr(lsValTy, gLsVal, zero, t2))
        bd.NewStore(sv, bd.NewGetElementPtr(gvarsTy, gVars, zero, sid))
        bd.NewBr(h)
        x.NewRet(zero)
    })()

    // ===================================================================================
    //  Value helpers used by the thunks.
    // ===================================================================================

    // The current string value of a variable / special name, as an i8* in block b.
    function allDigits(t) {
        if (t.length == 0) { return false }
        var i
        for (i = 0; i < t.length; i++) { var cc = t.charCodeAt(i); if (cc < 48 || cc > 57) { return false } }
        return true
    }
    function varString(b, name) {
        if (name == "?") { return b.NewCall(rtInt2str, b.NewLoad(i32, gStatus)) }
        if (name == "#") { return b.NewCall(rtInt2str, b.NewLoad(i32, gFrameN)) }
        if (name == "*") { return b.NewCall(rtParams, [ifsFirstValue(b), one]) }
        if (name == "@") { return b.NewCall(rtParams, [ifsFirstValue(b), zero]) }
        // There is no process behind a compiled run, so $$ and $! are fixed values.
        if (name == "$") { return gepStr(b, "1000") }
        if (name == "!") { return gepStr(b, "0") }
        if (name == "-") { return gepStr(b, "hB") }
        if (allDigits(name)) {
            var idx = parseDec(name)
            if (idx == 0) { return gepStr(b, "bash") }
            return b.NewCall(rtParam, llvm.constant.NewInt(i32, idx))
        }
        // an array name expands to its element 0
        var isA = b.NewICmp(llvm.enum.IPredSGT, b.NewCall(rtArrCount, gepStr(b, name)), zero)
        return b.NewSelect(isA, b.NewCall(rtArrGet, [gepStr(b, name), gepStr(b, "0")]),
                                b.NewCall(rtNounset, loadVar(b, name)))
    }

    // ===================================================================================
    //  Word / expansion thunks:  {fn: function(b) -> {b, v: i8*}, c: const-string|undefined}
    // ===================================================================================

    function makeConst(s) {
        return {fn: function(b) { return {b: b, v: gepStr(b, s)} }, c: s}
    }
    // Command substitution: divert output into a capture buffer, run the list, take the buffer.
    function mkCmdSub(bodyT) {
        return {s: true, c: undefined, fn: function(b) {
            b.NewCall(rtCapBegin, zero)
            var savedExit = curExit
            var savedTraps = trapList
            trapList = []
            var subEnd = curF.NewBlock("")
            curExit = subEnd
            b.NewCall(rtSsSave, zero)
            var optSave = saveOpts(b)
            var eb = bodyT(b)
            eb.NewBr(subEnd)
            curExit = savedExit
            var myTraps = trapList
            trapList = savedTraps
            subEnd = emitTraps(subEnd, myTraps)
            var wasEx = subEnd.NewICmp(llvm.enum.IPredNE, subEnd.NewLoad(i32, gExited), zero)
            var st = subEnd.NewSelect(wasEx, subEnd.NewLoad(i32, gExitCode), subEnd.NewLoad(i32, gStatus))
            subEnd.NewStore(zero, gExited)
            subEnd.NewCall(rtSsRestore, zero)
            restoreOpts(subEnd, optSave)
            subEnd.NewStore(st, gStatus)
            var v = subEnd.NewCall(rtCapEnd, zero)
            return {b: subEnd, v: v}
        }}
    }
    function mkArCmdSub(sub) {
        return function(b) { var r = evalWord(b, sub); return {b: r.b, v: r.b.NewCall(rtStr2int, r.v)} }
    }
    // ${...} : items are [{pname}, {pe}?, {op}?, {anchor}?, word objects / arithmetic thunks]
    function mkParamExp(items) {
        var pe = "", name = "", op = "", anchor = "", xf = ""
        var lenp = false, indp = false
        var words = []     // word objects {fn, c}
        var ariths = []    // bare arithmetic thunks (the ${v:off:len} offsets)
        var wordT = null
        var hasIdx = false
        var i
        for (i = 0; i < items.length; i++) {
            var it = items[i]
            if (typeof it == "function") { ariths.push(it) }
            else if (it.hasIdx != undefined) { hasIdx = true }
            else if (it.fn != undefined) { words.push(it); wordT = it }
            else if (it.lenp != undefined) { lenp = true }
            else if (it.indp != undefined) { indp = true }
            else if (it.xf != undefined) { xf = it.xf }
            else if (it.pe != undefined) { pe = it.pe }
            else if (it.pname != undefined) { name = it.pname }
            else if (it.op != undefined) { op = it.op }
            else if (it.anchor != undefined) { anchor = it.anchor }
        }
        // A BARE "#"/"!" prefix keeps the dedicated length / indirection paths (including
        // their array forms ${#a[@]} and ${!a[@]}); combined with an operator it does not.
        var bare = (op == "" && pe == "" && xf == "")
        if (lenp && bare) { pe = "len" }
        if (indp && bare) { pe = "ind" }
        // The @-transforms. @U/@L/@u are rt_case, @Q/@K/@k are rt_shquote, @A is the
        // assignment that would recreate the variable and @E decodes the $'...' escapes at
        // run time. @a answers the attribute letters, which for this compiler is "a" for a
        // name it saw declared as an associative array and empty otherwise. @P (prompt
        // expansion) is NOT modelled: it answers the value unchanged, which is right for
        // every value holding no backslash escape and wrong for one that does.
        var xfIsArr = hasOwn(assocArrays, "$" + name)
        var xfName = name
        function applyXf(b, v) {
            if (xf == "U") { return b.NewCall(rtCase, [v, one]) }
            if (xf == "L") { return b.NewCall(rtCase, [v, llvm.constant.NewInt(i32, 3)]) }
            if (xf == "u") { return b.NewCall(rtCase, [v, zero]) }
            if (xf == "E") { return b.NewCall(rtAnsiC, v) }
            if (xf == "P") { return v }
            if (xf == "a") { return gepStr(b, xfIsArr ? "a" : "") }
            var q = b.NewCall(rtShQuote, v)
            if (xf == "A") { return b.NewCall(rtStrcat, [gepStr(b, xfName + "="), q]) }
            return q
        }
        // NAME[SUBSCRIPT]: the first word is the subscript, the rest belong to the operator.
        if (hasIdx && words.length > 0) {
            var idxW = words[0]
            words = words.slice(1)
            wordT = (words.length > 0) ? words[words.length - 1] : null
