        }
    }
    // A name's value is itself an expression (x=010 is 8, r=a reads a), so rt_arith reads it.
    // An arithmetic read: a nameref that is an array reads as unset, silently (bash 5.3).
    function arString(b, name) {
        if (attrOn(refVars, name)) { return b.NewCall(rtGetRef, [gepStr(b, name), one]) }
        return varString(b, name)
    }
    function mkArVar(name) { return refMayThunk(name, function(b) { return {b: b, v: b.NewCall(rtArith, arString(b, name))} }) }
    // NAME[SUB]: items = [{lhs}, subscriptWord]. Twin of mkArLhs / mkArElem in
    // bash-interpreter.abnf.
    function mkArLhs(items) { return {lhs: items[0].lhs, sub: items[1], aq: items[2].aqa} }
    function mkArElem(items) {
        var name = items[0].lhs, w = items[1], aq = items[2].aqa
        return function(b) {
            var nmv = arrNameOf(b, name)
            var rk = subKeyOf(b, name, w, nmv, false, aq, true)
            return {b: rk.b, v: rk.b.NewCall(rtArith, (nmv != null) ? rk.b.NewCall(rtArNget, [nmv, rk.k]) : rk.b.NewCall(rtScGet, [gepStr(rk.b, name), rk.k]))}
        }
    }
    // The array NAME[SUB] is in, as an i8*, when NAME is a nameref: the array it names, or
    // the nameref itself for a circular chain (rt_nref_arname); else null, for the name
    // itself. Its element is read by rt_ar_nget and stored by rt_ar_nset. Twin of
    // arElemName in bash-interpreter.abnf.
    function arrNameOf(b, name) { return attrOn(refVars, name) ? b.NewCall(rtNrefArname, gepStr(b, name)) : null }
    // An assignment target's key ({b, k, nm}: k null for a plain name, nm as arrNameOf), its
    // value, and the store.
    function arLhsKey(b, lhs) {
        if (lhs.sub == undefined) { return {b: b, k: null, nm: null} }
        var nmv = arrNameOf(b, lhs.lhs)
        var rk = subKeyOf(b, lhs.lhs, lhs.sub, nmv, false, lhs.aq, true)
        return {b: rk.b, k: rk.k, nm: nmv}
    }
    // Only an operator that stores back reads its target here (++, op=): through a nameref
    // the store then looks the name up once more (ar_rmw).
    function arLhsGet(b, name, rk) {
        if (rk.k == null) { return b.NewCall(rtArith, arString(b, name)) }
        if (rk.nm == null) { return b.NewCall(rtArith, b.NewCall(rtScGet, [gepStr(b, name), rk.k])) }
        var ev = b.NewCall(rtArNget, [rk.nm, rk.k])
        b.NewCall(rtArRmw, [rk.nm, rk.k])
        return b.NewCall(rtArith, ev)
    }
    // Nothing is stored once an error has been raised: bash abandons the whole expression,
    // so `(( w = 2, w2 = 1/0 ))` sets w alone. Twin of arLhsSet in bash-interpreter.abnf.
    function arLhsSet(b, name, rk, v) {
        var k = rk.k
        var st = curF.NewBlock(""), jb = curF.NewBlock("")
        b.NewCondBr(b.NewICmp(llvm.enum.IPredEQ, b.NewLoad(i32, gArithErr), zero), st, jb)
        // A readonly name is an arithmetic error: (( )) and let fail, $(( )) abandons the line.
        // A nameref whose target is known here is tested as that name.
        var al = (k == null) ? refAlias(name) : null
        var roNow = roRefusedV(st, name)
        var rr = roNow ? null : roRtTest(st, (al != null) ? al : name)
        if (rr != null) {
            rr.ro.NewStore(one, gArithErr)
            rr.ro.NewBr(jb)
            st = rr.ok
        }
        if (roNow) { st.NewStore(one, gArithErr) }
        else if (k == null && attrOn(refVars, name) && al == null) {
            var nv = gepStr(st, name)
            st.NewCall(rtArNset, [nv, nullStr, st.NewCall(rtInt2str, v), refAttrs(st, nv, true), nv])
        }
        else if (k == null) { storeVar(st, name, st.NewCall(rtInt2str, v)) }
        else if (rk.nm != null) {
            // Through a nameref, the readonly of the variable it lands on (refAttrs).
            var eat = attrOn(refVars, name) ? refAttrs(st, rk.nm, true) : zero
            st.NewCall(rtArNset, [rk.nm, k, st.NewCall(rtInt2str, v), eat, gepStr(st, name)])
        }
        else {
            // An element store makes a set scalar its element 0 (rt_arr_adopt).
            var adB = curF.NewBlock(""), isB = curF.NewBlock("")
            st.NewCondBr(st.NewICmp(llvm.enum.IPredNE, loadVar(st, name), unsetPtr(st)), adB, isB)
            adB.NewCall(rtArrAdopt, [gepStr(adB, name), llvm.constant.NewInt(i32, getVarId(name))])
            adB.NewBr(isB)
            st = isB
            st.NewCall(rtArrIset, [gepStr(st, name), k, st.NewCall(rtInt2str, v)])
        }
        st.NewBr(jb)
        return jb
    }
    // / and % go through rt_idiv, which knows bash's two cases the hardware does not (a zero
    // divisor, LONG_MIN / -1); a literal divisor (rlit, never negative: a sign is a unary
    // operator) other than 0 has neither, so it divides inline. A shift count is taken
    // modulo 64, which is what bash's own shift instruction does on both arm64 and x86-64;
    // an unmasked count is poison in LLVM.
    function arOp(b, op, l, r, rlit, rec) {
        if (op == "+") { return {b: b, v: b.NewAdd(l, r)} }
        if (op == "-") { return {b: b, v: b.NewSub(l, r)} }
        if (op == "*") { return {b: b, v: b.NewMul(l, r)} }
        if ((op == "/" || op == "%") && rlit != undefined && rlit != 0) {
            return {b: b, v: (op == "%") ? b.NewSRem(l, r) : b.NewSDiv(l, r)}
        }
        if (op == "/" || op == "%") {
            var known = rec != undefined && rec.ok
            return {b: b, v: b.NewCall(rtIdiv, [l, r, (op == "%") ? one : zero,
                known ? gepStr(b, rec.expr) : emptyPtr(b), known ? gepStr(b, rec.tok) : emptyPtr(b)])}
        }
        var pred = null
        if (op == "<") { pred = llvm.enum.IPredSLT }
        if (op == ">") { pred = llvm.enum.IPredSGT }
        if (op == "<=") { pred = llvm.enum.IPredSLE }
        if (op == ">=") { pred = llvm.enum.IPredSGE }
        if (op == "==") { pred = llvm.enum.IPredEQ }
        if (op == "!=") { pred = llvm.enum.IPredNE }
        if (pred == null) {
