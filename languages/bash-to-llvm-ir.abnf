    // passes nothing. Twin of mkDqWord in bash-interpreter.abnf.
    function mkDqWord(segs0) {
        if (segs0.length == 0) { return makeConst("") }
        var segs = []
        var anyFields = false
        var i
        for (i = 0; i < segs0.length; i++) {
            var sg = segs0[i]
            if (sg.dqs == true) { sg = {s: sg.s, c: sg.c, fn: sg.fn} }
            segs.push(sg)
            if (sg.f == true) { anyFields = true }
