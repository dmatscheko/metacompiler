        // own gvars slot is the unset marker, so rt_nounset is told which arm is live - otherwise
        // `set -u; a=(11 22); echo "$a"` would abort where bash prints 11.
        var isA = b.NewICmp(llvm.enum.IPredNE, b.NewCall(rtArrAny, gepStr(b, name)), zero)
