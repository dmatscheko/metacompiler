        reSetF(ii0, hole2, 1, it0)
        ii0.NewCall(reEmit, [reK(OP_PROG), it0, zero])
        ii0.NewCall(reEmit, [reK(OP_JMP), hole1, zero])
        reSetF(ii0, hole1, 0, reK(OP_SPLIT))
        reSetF(ii0, hole1, 1, hole2)
        reSetF(ii0, hole1, 2, ii0.NewLoad(i32, gRePc))
        ii0.NewRet(zero)

        reSetF(ii1, hole1, 1, hole2)
        reSetF(ii1, hole2, 1, astart)
        var ii1x = reForL(f, "rpii1c", ii1, ip, one, mv2, function(b, i) {
            b.NewCall(reCopy, [astart, aend])
            return b
        })
        var isp = ii1x.NewCall(reEmit, [reK(OP_SPLIT), zero, zero])
        var it1 = ii1x.NewCall(reMark)
        var imk = ii1x.NewCall(reEmit, [reK(OP_SAVE), it1, zero])
        ii1x.NewCall(reCopy, [astart, aend])
        ii1x.NewCall(reEmit, [reK(OP_PROG), it1, zero])
        ii1x.NewCall(reEmit, [reK(OP_JMP), isp, zero])
        reSetF(ii1x, isp, 1, imk)
        reSetF(ii1x, isp, 2, ii1x.NewLoad(i32, gRePc))
        ii1x.NewRet(zero)

        // {m,n}: n-m of the copies are optional. Each optional SPLIT parks its END target
        // in word 2 as a chain link and the walk at the bottom fills them all in.
        var if0 = f.NewBlock("rpif0"), if1 = f.NewBlock("rpif1"), ifend = f.NewBlock("rpifend")
        ivFin.NewCondBr(ivFin.NewICmp(reEQ, mv2, zero), if0, if1)

        reSetF(if0, hole1, 0, reK(OP_SPLIT))
        reSetF(if0, hole1, 1, hole2)
        reSetF(if0, hole1, 2, if0.NewLoad(i32, endp))
        if0.NewStore(hole1, endp)
        reSetF(if0, hole2, 1, astart)
        var if0x = reForL(f, "rpif0c", if0, ip, one, nv, function(b, i) {
            var s = b.NewCall(reEmit, [reK(OP_SPLIT), zero, b.NewLoad(i32, endp)])
            b.NewStore(s, endp)
            var cs = b.NewLoad(i32, gRePc)
            b.NewCall(reCopy, [astart, aend])
            reSetF(b, s, 1, cs)
            return b
        })
        if0x.NewBr(ifend)

        reSetF(if1, hole1, 1, hole2)
        reSetF(if1, hole2, 1, astart)
        var if1a = reForL(f, "rpif1a", if1, ip, one, mv2, function(b, i) {
            b.NewCall(reCopy, [astart, aend])
            return b
        })
        var if1x = reForL(f, "rpif1b", if1a, jp, mv2, nv, function(b, i) {
            var s = b.NewCall(reEmit, [reK(OP_SPLIT), zero, b.NewLoad(i32, endp)])
            b.NewStore(s, endp)
            var cs = b.NewLoad(i32, gRePc)
            b.NewCall(reCopy, [astart, aend])
            reSetF(b, s, 1, cs)
            return b
