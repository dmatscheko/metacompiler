            var sid = llvm.constant.NewInt(i32, getVarId(a.name))
            storeVar(b, a.name, heapKeep(b, mk, a.name, b.NewCall(rtSapp, [sid, loadVar(b, a.name), v])))
        } else if (a.valT != null && a.valT.vref == true) {
            // `x=$y` takes its own copy of a value in y's buffer (rt_vown).
            storeVar(b, a.name, b.NewCall(rtVown, [llvm.constant.NewInt(i32, getVarId(a.name)), v]))
        } else {
            storeVar(b, a.name, heapKeep(b, mk, a.name, v))
        }
        b.NewBr(mg)
        return mg
    }
    // v (already expanded) stored as NAME's value the way `NAME=v` stores it: element 0 of an
    // array name, the value of v as arithmetic under -i (an error abandons the line), the case
    // map under -u / -l. read, printf -v, a for loop's name, ${v:=w} and a declaration's
    // expanded value store this way. Twin of storeAttr in bash-interpreter.abnf.
    function emitStoreAttr(b, name, v) {
        return emitAssign(b, {name: name, op: "=", idxT: null, lit: null, valT: doneWord(v)}, false, null)
    }
    // A word whose value is already expanded.
    function doneWord(v) { return {fn: function(b) { return {b: b, v: v} }, c: undefined, done: true} }
    // Stores v as element `key` of array `name` (nm, its name as an i8*) under the array's
    // attributes; old is the element's value for `+=`, else null. -i's arithmetic error
    // abandons the line before the store. An assignment command passes its statement's mark
    // mk, and rt_arr_keep then gives back what the statement allocated (bash-rt.c, "element
    // buffers"). box.b is the block, moved on past the store.
    function emitElemSet(box, name, nm, key, old, v, assoc, mk) {
        var b = box.b
        var at = elemAttrs(name)
        if (at != 0) { v = b.NewCall(rtAttrv, [(old == null) ? nullStr : old, v, llvm.constant.NewInt(i32, at)]) }
        else if (old != null) { v = b.NewCall(rtStrcat, [old, v]) }
        if ((at & 1) != 0) { b = emitAbortCheck(b) }
        if (mk != null) { b.NewCall(rtArrKeep, [mk.a, mk.l, nm, key, v, assoc ? one : zero]) }
        else { b.NewCall(assoc ? rtArrSet : rtArrIset, [nm, key, v]) }
        box.b = b
    }
    // The attributes rt_attrv applies to an element of `name`: 1 -i, 2 -u, 4 -l.
    function elemAttrs(name) {
        return (attrOn(intVars, name) ? 1 : 0) + (attrOn(upVars, name) ? 2 : 0) + (attrOn(loVars, name) ? 4 : 0)
    }
    // items: one {a} per assignment and the redirection records, interleaved. Twin of
    // makeAssign in bash-interpreter.abnf.
    function makeAssign(items) {
        var as = []
        var redirs = []
        var subs = false
        var i
        for (i = 0; i < items.length; i++) {
            if (items[i].a != undefined) {
                as.push(items[i].a)
                if (items[i].a.valT != null && items[i].a.valT.s == true) { subs = true }
            } else { redirs.push(items[i]) }
        }
        // The values worth an rt_keep: an expansion that may leave garbage besides its value,
        // and any expanded value an element takes (rt_arr_keep).
        var keep = false
        for (i = 0; i < as.length; i++) {
            var vt = as[i].valT
            if (as[i].lit == null && vt != null && vt.c == undefined && (vt.lean != true || as[i].idxT != null)) { keep = true }
        }
        // No array literal and no redirection: what the statement allocated is its values,
        // kept, or given back by rt_keep (makeSeq).
        var kept = redirs.length == 0
        for (i = 0; i < as.length; i++) { if (as[i].lit != null) { kept = false } }
        return function(b) {
            var k
            var mk = keep ? heapMark(b) : null
            for (k = 0; k < as.length; k++) {
                // A readonly name abandons the command line, as an arithmetic error does.
                if (roRefused(b, as[k].name, "")) { b.NewStore(one, gArithErr); return emitAbortCheck(b) }
                b = emitAssign(b, as[k], false, mk)
            }
            asgKept = kept
            if (!subs) { storeStatusI(b, 0) }
            if (redirs.length > 0) {
                var sv = emitOpenRedirs(b, redirs)
                var gate = redirGate(sv.b, sv, [])
                b = redirJoin(gate.run, gate)
                emitCloseRedirs(b, sv)
            }
            return b
        }
    }

    // Every `ret` out of a user function first unwinds the local save stack back to the
    // depth the call recorded on entry, so `local` bindings do not leak to the caller.
    function emitFnRet(b, v) {
        unwindRedirs(b, 0)
        if (curFrame != null) { b.NewCall(rtPopLocals, b.NewLoad(i32, curFrame.depth)) }
        b.NewRet(v)
    }

    // items = [{dkw}, {dflag}*, ({dname} | {a: assignment})*]. A declaration runs in two phases,
    // as bash's does: its words are expanded, and an array literal is assigned, before its
    // redirections apply; then the names are declared and the expanded values stored under
    // them. Twin of makeDecl in bash-interpreter.abnf, which has the cases.
    function makeDecl(items, redirs) {
        var kw = items[0].dkw
        var flags = ""
        var plus = ""
        var names = []
        var asgs = []
        // The operands in order: {j} a written name or assignment (names[j] / asgs[j]), or
        // {dyn} the words of a computed one (emitDeclDyn).
        var order = []
        var anyDyn = false
        var i
        for (i = 1; i < items.length; i++) {
            var it = items[i]
            if (it.dflag != undefined && it.dflag.charAt(0) == "+") { plus = plus + it.dflag; continue }
            if (it.dflag != undefined) { flags = flags + it.dflag; continue }
            // `--` ends the options.
            if (it.dyn != undefined && order.length == 0 && it.dyn.length == 1 && it.dyn[0].c == "--") { continue }
            if (it.dyn != undefined) { order.push({dyn: it.dyn}); anyDyn = true; continue }
            order.push({j: names.length})
            if (it.dname != undefined) { names.push(it.dname); asgs.push(null) }
            else { names.push(it.a.name); asgs.push(it.a) }
        }
        // A computed operand names its variable only at run time, where this compiler keeps
        // no attributes: it takes no attribute option and no readonly.
        var fk
        var attrOpt = false
        for (fk = 0; fk < flags.length; fk++) { if ("-+xg".indexOf(flags.charAt(fk)) < 0 && !(kw == "export" && flags.charAt(fk) == "n")) { attrOpt = true } }
        for (fk = 0; fk < plus.length; fk++) { if ("-+xg".indexOf(plus.charAt(fk)) < 0) { attrOpt = true } }
        if (anyDyn && (kw == "readonly" || attrOpt)) {
            fail("a computed operand of `" + kw + " " + flags + plus + "` is not supported by this compiler")
        }
        var isArray = (flags.indexOf("a") >= 0) || (flags.indexOf("A") >= 0)
        var assoc = (flags.indexOf("A") >= 0)
        var upper = (flags.indexOf("u") >= 0)
        var lower = (flags.indexOf("l") >= 0)
        var integer = (flags.indexOf("i") >= 0)
        var global = (flags.indexOf("g") >= 0)
        // -p/-f/-F are QUERIES, not declarations: -p with names prints, -f/-F print functions
        // (emitDeclFuncs). None of them may be read as `declare NAME`, which below would make
        // the name a fresh unset local.
        var query = (flags.indexOf("p") >= 0) || (flags.indexOf("f") >= 0) || (flags.indexOf("F") >= 0)
        var fnQuery = (flags.indexOf("F") >= 0) ? "F" : ((flags.indexOf("f") >= 0) ? "f" : "")
        var fqi
        for (fqi = 0; fnQuery != "" && fqi < flags.length; fqi++) {
            if (flags.charAt(fqi) != "-" && flags.charAt(fqi) != "f" && flags.charAt(fqi) != "F") { fail(kw + " " + flags + " is not supported") }
        }
        var isPrint = (flags.indexOf("p") >= 0) && (flags.indexOf("f") < 0) && (flags.indexOf("F") < 0)
        var setRo = kw == "readonly" || flags.indexOf("r") >= 0
        var isRef = kw != "export" && flags.indexOf("n") >= 0
        var selfBadP = null      // i32 slot: a computed nameref value named its own variable
        // 1: the declaration exports its names, -1: it takes the attribute away (rt_xmark).
        var xCode = 0
        if (kw == "export" || flags.indexOf("x") >= 0) { xCode = 1 }
        if ((kw == "export" && flags.indexOf("n") >= 0) || plus.indexOf("x") >= 0) { xCode = -1 }
        // A readonly name the declaration would assign or make local is refused (status 1).
        var roFail = false
        var k
        // The ASSOCIATIVE flag alone stays a walk-time, whole-program fact: it decides how a
        // subscript is normalised at two sites that are themselves walk-time (${v@a} and the
        // NAME[SUB] split), and a name is never both kinds in one program.
        for (k = 0; k < names.length; k++) {
            if (assoc && !query && !hasOwn(assocArrays, "$" + names[k])) { assocArrays["$" + names[k]] = true; assocList.push(names[k]) }
        }
