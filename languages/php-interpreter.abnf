    // ----- arithmetic: int stays int, and any float operand makes the result float --
    function phpArith(op, l, r) {
        var a = toNumV(l)
        var b = toNumV(r)
        var f = isFlo(a) || isFlo(b)
        var x = numOf(a)
        var y = numOf(b)
        if (op == "+") { return f ? mkFlo(x + y) : x + y }
        if (op == "-") { return f ? mkFlo(x - y) : x - y }
        if (op == "*") { return f ? mkFlo(x * y) : x * y }
        if (op == "/") {
            if (y === 0) { fail("division by zero") }
            var q = x / y
            if (!f && q === trunc(q)) { return q }
            return mkFlo(q)
        }
        if (op == "%") {
            var iy = trunc(y)
            if (iy === 0) { fail("modulo by zero") }
            return trunc(x) % iy
        }
        if (op == "**") {
            var p = Math.pow(x, y)
            if (!f && y >= 0 && p === trunc(p)) { return p }
            return mkFlo(p)
