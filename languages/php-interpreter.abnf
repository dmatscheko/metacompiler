InstDyn     <~~ push({idyn: pop()}) ~~> = VarRef | "(" Expression ")" ;
InstName    <~~ push({iname: up.in}) ~~> = ExtName ;
PreIncDec   <~~ push(makePreIncDec(pop(), pop())) ~~>
