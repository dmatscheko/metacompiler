    // No importable builtins: PHP's count/strlen/... are always in scope, never imported,
    // so every include/require path is a project file (resolveImport, lib/interp-core.js).
    core.stdlibImports = []
    // Project-file imports: `require 'geomlib.php'` looks for geomlib.php (a leading ./ is
    // dropped and a missing .php extension added) under the program's directory and the -i
    // roots (c.findImport). The file is parsed with this grammar and walked with the same
    // tags: its top level runs right here (real PHP include-time execution) and its
    // function / class definitions land in the global scope. A file is imported once;
    // repeats and cycles are no-ops. The imported names bind flat (global), like PHP require.
    var importedFiles = {}
    core.importFile = function(path, pos) {
        if (path.length >= 2 && path.charAt(0) == "." && path.charAt(1) == "/") { path = path.substring(2) }
        if (!(path.length >= 4 && path.substring(path.length - 4) == ".php")) { path = path + ".php" }
        var file = c.findImport(path)
        if (file == "") { return false }
        if (importedFiles["$" + file] == true) { return true }
        importedFiles["$" + file] = true
        var text = c.readFile(file)
        var asg = c.parse(c.agrammar, text, null, file)
        c.pushSource(file, text)
        c.compile(asg)
        c.popSource()
        return true
    }

    c.compile(c.asg)

    println("php interpreter: program finished")
    exit(0)

