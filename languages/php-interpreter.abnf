        for (var i = 0; i < items.length; i++) {
            var it = items[i]
            if (typeof it == "string") { nm = it }
            else if (typeof it == "function") { init = it }
            else if (it != null && it != undefined && it.hooks != undefined) { hooks = it.hooks }
