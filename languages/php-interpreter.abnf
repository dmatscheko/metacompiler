    // The engine's exception hierarchy, far enough for user classes to extend it.
    function declBuiltinClass(name, superName) {
        var sup = superName == null ? null : getVar(superName)
        var cls = {__isclass: true, __name: name, __super: sup, __props: [], __ifaces: ["Throwable"]}
        cls["__construct"] = function(self, argset) {
            dictSet(self.p, "message", argset.pos.length > 0 ? argset.pos[0] : "")
            dictSet(self.p, "code", argset.pos.length > 1 ? argset.pos[1] : 0)
            return null
        }
        cls["getMessage"] = function(self, argset) { return phpGetProp(self, "message") }
        cls["getCode"] = function(self, argset) { return phpGetProp(self, "code") }
        scopePut(globalScope, name, cls)
    }
    declBuiltinClass("Exception", null)
    declBuiltinClass("Error", null)
    declBuiltinClass("RuntimeException", "Exception")
    declBuiltinClass("LogicException", "Exception")
    declBuiltinClass("InvalidArgumentException", "LogicException")
    declBuiltinClass("TypeError", "Error")
    declBuiltinClass("ValueError", "Error")
    declBuiltinClass("DivisionByZeroError", "Error")

    // ----- core config -----
    core.lang = "php"
    core.test = phptest
    binOp = function(op, l, r) {
        if (op == ".") { return phpConcat(l, r) }
        if (op == "===") { return phpIdentical(l, r) }
        if (op == "!==") { return !phpIdentical(l, r) }
        if (op == "==") { return phpLoose(l, r) }
        if (op == "!=" || op == "<>") { return !phpLoose(l, r) }
        if (op == "<=>") { return phpCmp(l, r) }
        if (op == "<")  { return phpCmp(l, r) < 0 }
        if (op == ">")  { return phpCmp(l, r) > 0 }
        if (op == "<=") { return phpCmp(l, r) <= 0 }
        if (op == ">=") { return phpCmp(l, r) >= 0 }
