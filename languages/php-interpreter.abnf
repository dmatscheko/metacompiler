    function phpLoose(l, r) {
        if (l === undefined) { l = null }
        if (r === undefined) { r = null }
        if (typeof l == "boolean" || typeof r == "boolean") { return phptest(l) === phptest(r) }
        if (l === null && r === null) { return true }
        if (l === null) { return looseNull(r) }
        if (r === null) { return looseNull(l) }
