    }
    // Walk the path to the container that the last step writes into, creating the
    // arrays along the way (PHP auto-vivifies: $a["x"]["y"] = 1 makes both levels).
    function resolveRefPhp(ref) {
        var o = anytype
        var sc = ref.sref == null ? null : ref.sref()
