MethodSfx   = NsMethodSfx | PlMethodSfx ;
PlMethodSfx <~~ push({kind: "mcall", ns: false, name: popName(), args: takeAll()}) ~~>
            = "->" MemberName <~~ push({mname: up.in}) ~~> "(" [ ArgList ] ")" ;
NsMethodSfx <~~ push({kind: "mcall", ns: true, name: popName(), args: takeAll()}) ~~>
