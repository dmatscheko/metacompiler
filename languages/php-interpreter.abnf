    function hexVal(ch) {
        var cc = ch.charCodeAt(0)
        if (cc >= 48 && cc <= 57) { return cc - 48 }
        if (cc >= 97) { return cc - 87 }
        return cc - 55
    }
    function codePointStr(cp) {
        if (cp < 65536) { return String.fromCharCode(cp) }
        var off = cp - 65536
        return String.fromCharCode(55296 + ((off - (off % 1024)) / 1024)) + String.fromCharCode(56320 + (off % 1024))
    }

    // ----- '$name', '$name[key]' and '$name->prop' inside a double-quoted string ---
    // The bracket key of the SIMPLE form is a bare word taken as a string
    // ("$map[key]" reads the "key" entry), an integer, or another variable.
    function makeTplVar(items) {
        var name = ""
        var idx = null
        var prop = null
        for (var i = 0; i < items.length; i++) {
            if (items[i].tvar != undefined) { name = items[i].tvar }
            else if (items[i].tidx != undefined) { idx = items[i].tidx }
            else if (items[i].tprop != undefined) { prop = items[i].tprop }
        }
        if (idx != null) {
            var key = anytype
            if (idx.charAt(0) == "$") { key = null } else if (isCanonInt(idx)) { key = parseInt(idx, 10) } else { key = idx }
            var vn = idx
            return function() {
                var k = anytype
                k = (idx.charAt(0) == "$") ? getVar(vn) : key
                return phpIndex(getVar(name), k)
            }
        }
        if (prop != null) {
            var pn = prop.substring(2)
            return function() { return phpGetProp(getVar(name), pn) }
        }
        return function() { return getVar(name) }
    }

    // ----- heredoc / nowdoc -----
    // HdScan handed over the WHOLE literal as one token: the '<<<MARK' line, the body
    // lines and the terminator. The terminator's own indentation is removed from every
    // body line (PHP 7.3+) and the newline in front of the terminator is dropped.
    function makeHeredoc(text) {
        var i = 3
        while (i < text.length && (text.charAt(i) == " " || text.charAt(i) == "\t")) { i++ }
        var quote = ""
        if (text.charAt(i) == "'" || text.charAt(i) == "\"") { quote = text.charAt(i) }
        var nl = -1
        for (var a = 0; a < text.length; a++) { if (text.charAt(a) == "\n") { nl = a; break } }
        var rest = nl < 0 ? "" : text.substring(nl + 1)
        // The scanner stopped right after the terminator marker, so the last line of
        // `rest` is that terminator: its indentation is the strip width.
        var lastNl = -1
        for (var b = rest.length - 1; b >= 0; b--) { if (rest.charAt(b) == "\n") { lastNl = b; break } }
        var termLine = lastNl < 0 ? rest : rest.substring(lastNl + 1)
        var indent = 0
        while (indent < termLine.length && (termLine.charAt(indent) == " " || termLine.charAt(indent) == "\t")) { indent++ }
        var body = lastNl < 0 ? "" : rest.substring(0, lastNl)
        if (indent > 0) { body = stripHdIndent(body, indent) }
        if (quote == "'") { return makeConst(body) }
        return makeTemplate(hdParts(body))
    }
    function nlAt(s, from) {
        for (var i = from; i < s.length; i++) { if (s.charAt(i) == "\n") { return i } }
        return -1
    }
    function stripHdIndent(body, n) {
        var out = ""
        var j = 0
        while (j <= body.length) {
            var e = nlAt(body, j)
            var hasNl = e >= 0
            if (e < 0) { e = body.length }
            var take = j + n < e ? j + n : e
            out += body.substring(take, e)
            if (hasNl) { out += "\n" } else { break }
            j = e + 1
        }
        return out
    }
    // Split an interpolating heredoc body into the {s}/{e} pieces makeTemplate wants.
    // '{$expr}' is parsed with the grammar itself, from the Expression production -
    // the same door include/require uses to pull in another file.
    function hdParts(body) {
        var parts = []
        var lit = ""
        var i = 0
        while (i < body.length) {
            var ch = body.charAt(i)
            if (ch == "\\" && i + 1 < body.length) { lit += ch + body.charAt(i + 1); i += 2; continue }
            if (ch == "{" && i + 1 < body.length && body.charAt(i + 1) == "$") {
                var depth = 0
                var j = i
                while (j < body.length) {
                    if (body.charAt(j) == "{") { depth++ }
                    else if (body.charAt(j) == "}") { depth--; if (depth == 0) { break } }
                    j++
                }
                if (j < body.length) {
                    if (lit != "") { parts.push({s: unescapeDq(lit)}); lit = "" }
                    parts.push({e: compileSnippet(body.substring(i + 1, j))})
                    i = j + 1
                    continue
                }
            }
            if (ch == "$" && i + 1 < body.length && isNameStart(body.charAt(i + 1))) {
                var k = i + 1
                while (k < body.length && isNameChar(body.charAt(k))) { k++ }
                var expr = body.substring(i, k)
                // one optional '[key]' or '->prop' step, like the string form
                if (k < body.length && body.charAt(k) == "[") {
                    var e2 = k
                    while (e2 < body.length && body.charAt(e2) != "]") { e2++ }
                    if (e2 < body.length) {
                        var inner = body.substring(k + 1, e2)
                        if (inner.length > 0 && inner.charAt(0) != "$" && !isCanonInt(inner)) { inner = "'" + inner + "'" }
                        expr = expr + "[" + inner + "]"
                        k = e2 + 1
                    }
                } else if (k + 2 < body.length && body.charAt(k) == "-" && body.charAt(k + 1) == ">" && isNameStart(body.charAt(k + 2))) {
                    var p2 = k + 2
                    while (p2 < body.length && isNameChar(body.charAt(p2))) { p2++ }
                    expr = expr + body.substring(k, p2)
                    k = p2
                }
                if (lit != "") { parts.push({s: unescapeDq(lit)}); lit = "" }
                parts.push({e: compileSnippet(expr)})
                i = k
                continue
            }
            lit += ch
            i++
        }
        if (lit != "") { parts.push({s: unescapeDq(lit)}) }
        return parts
    }
    function isNameStart(ch) { return (ch >= "a" && ch <= "z") || (ch >= "A" && ch <= "Z") || ch == "_" }
    function isNameChar(ch) { return isNameStart(ch) || (ch >= "0" && ch <= "9") }
    function compileSnippet(src) {
        var frag = c.parseFrom(c.agrammar, src, "Expression")
        return c.compile(frag).stack[0]
    }

    // ----- length / indexing -----
    function phpIndex(o, i) {
        if (isArr(o)) { return arrGet(o, i) }
        if (typeof o == "string") {
            var n = trunc(numOf(toNumV(i)))
            if (n < 0) { n = o.length + n }
            if (n < 0 || n >= o.length) { return "" }
            return o.charAt(n)
        }
        if (o === null || o === undefined) { return null }
        if (isObj(o)) { return phpGetProp(o, phpStr(i)) }
        return null
    }

    // ----- objects ---------------------------------------------------------------
    // An instance is {__obj, __class, p} with its properties in an ordered map, so
    // they can be ENUMERATED (== between two objects, clone) without for..in - which
    // the frozen engine does not have. Methods live on the class descriptor and are
    // looked up along __super.
    function isObj(v) { return v !== null && v !== undefined && typeof v == "object" && v.__obj === true }
    function newObj(cls) { return {__obj: true, __class: cls, p: newArr()} }
    function classFind(cls, name) {
        var k = cls
        while (k != undefined && k != null) {
            if (hasOwn(k, name) && typeof k[name] == "function") { return k[name] }
            k = k.__super
        }
        return null
    }
    // hookBacking is the property whose HOOK is running right now: inside it
    // '$this->x' is the backing store rather than another hook call, which is what
    // stops a backed hook recursing into itself. Every ordinary method call CLEARS it
    // again (callMethod), so the exemption covers the hook body itself and nothing it
    // calls out to - PHP's rule is lexical, and this is how a tree-walking engine
    // spells the same thing.
    var hookBacking = ""
    function callMethod(o, fn, args) {
        var saved = hookBacking
        hookBacking = ""
        var r = anytype
        r = fn(o, argsOf(args))
        hookBacking = saved
        return r
    }
    function callHook(o, fn, name, args) {
        var saved = hookBacking
        hookBacking = name
        var r = anytype
        r = fn(o, argsOf(args))
        hookBacking = saved
        return r
    }
    function phpGetProp(o, name) {
        if (o === null || o === undefined) { fail("property ->" + name + " of null") }
        if (!isObj(o)) { return null }
        if (name != hookBacking) {
            var hg = classFind(o.__class, "__hget_" + name)
            if (hg != null) { return callHook(o, hg, name, []) }
        }
        // phpSetProp writes through arrSet, which folds a canonical decimal key to an
        // INT the way PHP's arrays do, so the lookup has to fold the same way or a
        // numeric property name ('$o->{1234}') would never be found again.
        var i = dictFind(o.p, phpKey(name))
        if (i >= 0) { return deref(o.p.vals[i]) }
        var g = classFind(o.__class, "__get")
        if (g != null) { return callMethod(o, g, [name]) }
        return null
    }
    function phpSetProp(o, name, v) {
        if (!isObj(o)) { fail("property write ->" + name + " on a non-object") }
        if (name != hookBacking) {
            var hs = classFind(o.__class, "__hset_" + name)
            if (hs != null) { callHook(o, hs, name, [v]); return }
        }
        if (dictFind(o.p, phpKey(name)) < 0) {
            var s = classFind(o.__class, "__set")
            if (s != null) { callMethod(o, s, [name, v]); return }
        }
        // arrSet, not dictSet: a slot holding a cell is written THROUGH, which is
        // what makes `$r = &$o->p; $o->p = 5;` visible through $r.
        arrSet(o.p, name, v)
    }
    function objToString(o) {
        var m = classFind(o.__class, "__toString")
        if (m != null) { return phpStr(m(o, argsOf([]))) }
        fail("object of class " + o.__class.__name + " could not be converted to string")
    }

    // ----- method dispatch and member chains -----
    function mcall(target, name, args) {
        if (target === null || target === undefined) { fail("method ->" + name + "() on null") }
        if (isObj(target)) {
            if (args.fcc === true) {
                var fm = classFind(target.__class, name)
                if (fm != null) { return function(a2) { return fm(target, a2) } }
            }
            var m = classFind(target.__class, name)
            if (m != null) { return m(target, args) }
            // A closure stored in a property is callable through ->name() only via
            // __call in real PHP; the magic method is the documented door.
            var mc = classFind(target.__class, "__call")
            if (mc != null) { return mc(target, argsOf([name, arrOf(args.pos)])) }
            fail("unknown method '" + name + "' on " + target.__class.__name)
        }
        if (isGen(target)) { return genMethod(target, name, args) }
        fail("method ->" + name + "() on a non-object")
    }
    foldCallMember = function(items) {
        if (items.length == 1) { return items[0] }
        var primary = items[0]
        var suffixes = items.slice(1)
        return function() {
            var cur = anytype
            cur = primary()
            for (var i = 0; i < suffixes.length; i++) {
                var s = suffixes[i]
                // '?->' on a null receiver short circuits the WHOLE remaining chain,
                // arguments included - which is why this test sits before evalArgs.
                if (s.ns === true && (cur === null || cur === undefined)) { return null }
                if (s.kind == "mcall") { cur = mcall(cur, s.name, evalArgs(s.args)) }
                else if (s.kind == "dmcall") { cur = mcall(cur, phpStr(s.name()), evalArgs(s.args)) }
                else if (s.kind == "field") { cur = phpGetProp(cur, s.name) }
                else if (s.kind == "dfield") { cur = phpGetProp(cur, phpStr(s.name())) }
                else if (s.kind == "call") { cur = phpInvoke(cur, evalArgs(s.args)) }
                else if (s.kind == "static") { cur = s.run(cur) }
                else { cur = phpIndex(cur, s.idx()) }
            }
            return cur
        }
    }
    // Calling a value: a closure, a function NAME held in a string (PHP's variable
    // functions), or an object with __invoke.
    function phpInvoke(cur, argset) {
        if (argset.fcc === true) { return asCallable(cur) }
        if (typeof cur == "function") { return cur(argset) }
        if (typeof cur == "string") { return callNamed(cur, argset) }
        if (isObj(cur)) {
            var m = classFind(cur.__class, "__invoke")
            if (m != null) { return m(cur, argset) }
        }
        fail("call of a non-callable value")
    }
    // '|>' folds LEFT: makePipe receives [v, f1, f2, ...] and builds f2(f1(v)).
    // pipeStep is a named function rather than an inline closure so each step
    // captures its OWN operands (an inline closure in the loop would share the
    // loop variable, and the frozen engine is stricter about that than goja).
    function pipeStep(lhs, rhs) {
        return function() {
            var v = anytype
            v = lhs()
            return asCallable(rhs())(argsOf([v]))
        }
    }
    function makePipe(items) {
        var cur = items[0]
        for (var i = 1; i < items.length; i++) { cur = pipeStep(cur, items[i]) }
        return cur
    }
    function asCallable(cur) {
        if (typeof cur == "function") { return cur }
        var nm = phpStr(cur)
        return function(argset) { return callNamed(nm, argset) }
    }
    function callNamed(name, argset) {
        if (hasOwn(phpBuiltins, name)) { return phpBuiltins[name].apply(undefined, argset.pos) }
        var f = getVar(name)
        if (typeof f != "function") { fail("call of an undefined function: " + name) }
        return f(argset)
    }
    // ----- statics: class constants, static properties and '::' -------------------
    // A class descriptor carries three more ordered maps beside its methods:
    //   __constT   the DECLARED constants as {name, init} records. The initializer is
    //              a thunk because a constant may read another one (const TWICE =
    //              self::SIZE * 2), so it cannot be evaluated at declaration time.
    //   __constV   the memoized values: a constant is evaluated once, on first use.
    //   __statics  the static properties, each in a reference CELL - which is what
    //              makes a subclass share the storage its parent declared, as PHP
    //              does, and what lets self::$made = ... be an assignment target.
    //
    // self:: and static:: are per-CALL context. They are declared in the call FRAME
    // rather than in module-level variables, so everything that already snapshots and
    // restores the scope chain - a call, a closure, and the try-entry snapshot in
    // lib/interp-core.js - restores them too, with no extra bookkeeping and no way
    // for an exception to leave them pointing at the wrong class.
    var SELF_KEY = "\x00self"
    var STATIC_KEY = "\x00static"
    // The class a static call was written through, handed to the callee. It is set
    // immediately before the call and read-and-cleared on entry, so it can never
    // outlive one dispatch. A parameter would be cleaner, but every method closure is
    // reached through classFind and called from eight places with two arguments.
    var pendingStatic = null

    function ctxSelf() { return varExists(SELF_KEY) ? getVar(SELF_KEY) : null }
    function ctxStatic() { return varExists(STATIC_KEY) ? getVar(STATIC_KEY) : null }

    // The class descriptor a '::' base names. self / static / parent read the running
    // call's context; anything else is an ordinary class name.
    function resolveClassName(name) {
        if (name == "self") {
            var s = ctxSelf()
            if (s == null) { fail("cannot use 'self' outside a class") }
            return s
        }
        if (name == "static") {
            var t = ctxStatic()
            if (t == null) { fail("cannot use 'static' outside a class") }
            return t
        }
        if (name == "parent") {
            var p = ctxSelf()
            if (p == null || p.__super == null || p.__super == undefined) { fail("cannot use 'parent' without a parent class") }
            return p.__super
        }
        var v = anytype
        v = getVar(name)
        if (v == null || v == undefined || v.__isclass !== true) { fail("unknown class " + name) }
        return v
    }
    // The class behind a '::' whose base is a VALUE: $obj::CONST, or a class name
    // held in a string ($cn::make()).
    function classOfValue(v) {
        if (isObj(v)) { return v.__class }
        if (v != null && v != undefined && v.__isclass === true) { return v }
        if (typeof v == "string") { return resolveClassName(v) }
        fail(":: on a value that is neither an object nor a class name")
    }
    // A constant is looked up along the base chain AND through the implemented
    // interfaces (an interface constant is visible on every implementor), and is
    // evaluated on first use with self:: bound to the class that declared it.
    function constFind(cls, name) {
        var k = cls
        while (k != undefined && k != null) {
            var cv = k.__constV
            if (cv != undefined && cv != null) {
                var i = dictFind(cv, name)
                if (i >= 0) { return {v: cv.vals[i]} }
            }
            var t = k.__constT
            if (t != undefined && t != null) {
                for (var j = 0; j < t.length; j++) {
                    if (t[j].name == name) {
                        var val = anytype
                        val = constEval(k, t[j])
                        dictSet(k.__constV, name, val)
                        return {v: val}
                    }
                }
            }
            var ifs = k.__ifaces
            if (ifs != undefined && ifs != null) {
                for (var q = 0; q < ifs.length; q++) {
                    if (!varExists(ifs[q])) { continue }
                    var iv = anytype
                    iv = getVar(ifs[q])
                    if (iv != null && iv != undefined && iv.__isclass === true) {
                        var r = constFind(iv, name)
                        if (r != null) { return r }
                    }
                }
            }
            k = k.__super
        }
        return null
    }
    function constEval(cls, rec) {
        if (rec.init == null) { return null }
        var saved = scopes
        scopes = [globalScope, {}]
        declVar(SELF_KEY, cls)
        declVar(STATIC_KEY, cls)
        var v = anytype
        v = rec.init()
        scopes = saved
        return v
    }
    // The CELL of a static property: the first declaration found walking up, so a
    // subclass reads and writes the same storage as its parent.
    function staticCell(cls, name) {
        var k = cls
        while (k != undefined && k != null) {
            var st = k.__statics
            if (st != undefined && st != null) {
                var i = dictFind(st, name)
                if (i >= 0) { return st.vals[i] }
            }
            k = k.__super
        }
        fail("unknown static property " + cls.__name + "::$" + name)
    }

    // One '::' access, whatever its base was. Exactly one of prop / name is set;
    // args is non-null when the source wrote a parenthesized argument list.
    // A FORWARDING base (self / static / parent) hands $this and the current static::
    // binding on, which is what makes parent::describe() run against this object and
    // static::who() resolve in the called class.
    function staticAccess(cls, name, prop, args, baseText) {
        var forwards = (baseText == "self" || baseText == "static" || baseText == "parent")
        if (prop != null) {
            if (args != null) { fail("cannot call a static property") }
            return deref(staticCell(cls, prop).v)
        }
        if (name == "class" && args == null) { return cls.__name }
        if (args == null) {
            var cr = constFind(cls, name)
            if (cr != null) { return cr.v }
            fail("unknown class constant " + cls.__name + "::" + name)
        }
        var argset = evalArgs(args)
        var m = classFind(cls, name)
        if (m == null && cls.__isenum === true) {
            var er = enumStatic(cls, name, argset)
            if (er != null) { return er.v }
        }
        var self = anytype
        self = (forwards && varExists("$this")) ? getVar("$this") : null
        var bind = forwards ? ctxStatic() : cls
        if (bind == null || bind == undefined) { bind = cls }
        if (argset.fcc === true) {
            if (m == null) { fail("unknown static method " + cls.__name + "::" + name) }
            var mm = m
            var bs = bind
            var fself = self
            return function(a2) { pendingStatic = bs; return mm(fself, a2) }
        }
        if (m != null) {
            pendingStatic = bind
            return m(self, argset)
        }
        var cs = classFind(cls, "__callStatic")
        if (cs != null) {
            pendingStatic = bind
            return cs(null, argsOf([name, arrOf(argset.pos)]))
        }
        fail("unknown static method " + cls.__name + "::" + name)
    }
    // Splits the parsed pieces of a '::' form apart. Shared by the three sites that
    // parse one: a primary (Class::x), a member-chain suffix ($obj::x) and an
    // assignment head (self::$x = ...).
    function splitStatic(items) {
        var r = {base: null, name: null, prop: null, args: null}
        for (var i = 0; i < items.length; i++) {
            var it = items[i]
            if (it.sbase != undefined) { r.base = it.sbase }
            else if (it.sname != undefined) { r.name = it.sname }
            else if (it.sprop != undefined) { r.prop = it.sprop.substring(1) }
            else if (it.sargs != undefined) { r.args = it.sargs }
        }
        return r
    }
    // ----- global constants and magic constants ----------------------------------
    // Constants live in their own namespace (never in a scope), so a constant and a
    // variable of the same name are unrelated. Only true/false/null are
    // case-INsensitive in PHP; every other constant is matched exactly.
    var phpConsts = {}
    var FN_KEY = "\x00fn"
    function makeConstDecl(items) {
        var recs = []
        collectConsts(items, recs)
        return function() {
            for (var i = 0; i < recs.length; i++) {
                rawSet(phpConsts, recs[i].name, recs[i].init == null ? null : recs[i].init())
            }
            return null
        }
    }
    // "Foo\\Bar" -> "Bar": the unqualified tail of a qualified name.
    function lastSeg(s) {
        var out = s
        for (var i = 0; i < s.length; i++) {
            if (s.charCodeAt(i) == 92) { out = s.substring(i + 1) }
        }
        return out
    }
    function makeConstRef(name) {
        return function() {
            var lo = name.toLowerCase()
            if (lo == "true") { return true }
            if (lo == "false") { return false }
            if (lo == "null") { return null }
            if (name == "__FUNCTION__" || name == "__METHOD__") { return varExists(FN_KEY) ? getVar(FN_KEY) : "" }
            if (name == "__CLASS__") { var s = ctxSelf(); return s == null ? "" : s.__name }
            if (name == "PHP_EOL") { return "\n" }
            // PHP's int is 64 bit two's complement on every build this project
            // targets, so PHP_INT_MAX / PHP_INT_MIN are the boxed extremes rather
            // than a double's 9223372036854775808.
            if (name == "PHP_INT_SIZE") { return 8 }
            if (name == "PHP_INT_MAX") { return mkInt(I64_MAX_P) }
            if (name == "PHP_INT_MIN") { return mkInt(I64_MIN_P) }
            // Spelled with Math.pow because the grammar-script dialect has no
            // exponent literals ("1e-16" is 1 followed by the name e, see
            // js-interpreter.abnf); every value below is exact in binary anyway.
            if (name == "PHP_FLOAT_EPSILON") { return mkFlo(Math.pow(2, 0 - 52)) }
            if (name == "PHP_FLOAT_MAX") { return mkFlo((2 - Math.pow(2, 0 - 52)) * Math.pow(2, 1023)) }
            if (name == "PHP_FLOAT_MIN") { return mkFlo(Math.pow(2, 0 - 1022)) }
            if (name == "PHP_FLOAT_DIG") { return 15 }
            if (name == "INF") { return mkFlo(PHP_INF) }
            if (name == "NAN") { return mkFlo(0 / 0) }
            if (name == "M_PI") { return mkFlo(Math.PI) }
            if (name == "E_ALL") { return 32767 }
            if (name == "E_ERROR") { return 1 }
            if (name == "E_WARNING") { return 2 }
            if (name == "E_NOTICE") { return 8 }
            if (name == "E_DEPRECATED") { return 8192 }
            if (hasOwn(phpConsts, name)) { return phpConsts[name] }
            fail("undefined constant " + name)
        }
    }
    // static $n = 0; - the cells belong to the STATEMENT, so every call re-binds the
    // same storage into its fresh frame. They are created on first execution rather
    // than at build time because the initializer is an ordinary expression.
    function makeStaticVars(items) {
        var decls = []
        for (var i = 0; i < items.length; i++) {
            if (typeof items[i] == "string") { decls.push({name: items[i], init: null}) }
            else if (typeof items[i] == "function" && decls.length > 0) { decls[decls.length - 1].init = items[i] }
        }
        var cells = null
        return function() {
            if (cells == null) {
