        if (isArr(v)) { return v.keys.length === 0 }
        if (isNum(v)) { return numOf(v) === 0 }
        return false
    }
    function strNumLoose(s, n) {
        var ns = numStrVal(s)
        if (ns != null) { return numOf(ns) === numOf(n) }
        return s === phpStr(n)
    }
    function cmpNum(a, b) { return a < b ? -1 : (a > b ? 1 : 0) }
    function cmpStr(a, b) { return a < b ? -1 : (a > b ? 1 : 0) }
    // The spaceship, and the engine behind < > <= >=.
    function phpCmp(l, r) {
        if (l === undefined) { l = null }
        if (r === undefined) { r = null }
        if (typeof l == "boolean" || typeof r == "boolean" || l === null || r === null) {
            return cmpNum(phptest(l) ? 1 : 0, phptest(r) ? 1 : 0)
        }
        if (isArr(l) && isArr(r)) {
            if (l.keys.length != r.keys.length) { return cmpNum(l.keys.length, r.keys.length) }
            for (var i = 0; i < l.keys.length; i++) {
                var j = dictFind(r, l.keys[i])
                if (j < 0) { return 1 }
                var cv = phpCmp(deref(l.vals[i]), deref(r.vals[j]))
                if (cv != 0) { return cv }
            }
            return 0
        }
        if (typeof l == "string" && typeof r == "string") {
            var nl = numStrVal(l)
            var nr = numStrVal(r)
            if (nl != null && nr != null) { return cmpNum(numOf(nl), numOf(nr)) }
            return cmpStr(l, r)
        }
        if (typeof l == "string" && isNum(r)) {
            var x = numStrVal(l)
            if (x == null) { return cmpStr(l, phpStr(r)) }
            return cmpNum(numOf(x), numOf(r))
        }
        if (typeof r == "string" && isNum(l)) {
