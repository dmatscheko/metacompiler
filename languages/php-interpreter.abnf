    // ----- inline HTML (text outside <?php ... ?>) -----
    // The run is echoed verbatim. After a CLOSE tag PHP swallows one immediately
    // following newline, so that '?>' at the end of a template line does not add a
    // blank line to the output; text before the FIRST open tag keeps its newlines.
    function makeHtmlOut(text, afterClose) {
        var s = text
        if (afterClose === true && s.length > 0) {
            if (s.charCodeAt(0) === 10) { s = s.substring(1) }
            else if (s.charCodeAt(0) === 13 && s.length > 1 && s.charCodeAt(1) === 10) { s = s.substring(2) }
            else if (s.charCodeAt(0) === 13) { s = s.substring(1) }
        }
        return function() {
            if (s.length > 0) { print(s) }
            return null
        }
    }

    // ----- echo / print -----
    function makeEcho(items) {
        var args = items.slice(1)
        return function() {
            var out = ""
            for (var i = 0; i < args.length; i++) { out += phpStr(args[i]()) }
            print(out)
            return null
        }
    }

    // ----- assignment (locals, ->field, [index], [] append) -----
    makeTargetRef = function(items) {
