        var d = splitClosure(items)
        var params = d.params
        var body = d.body
        var byval = d.byval
        var byref = d.byref
        return function() {
            var captured = scopes.slice(0)
            var env = {}
            for (var i = 0; i < byval.length; i++) { scopePut(env, byval[i], phpCopy(getVar(byval[i]))) }
            for (var j = 0; j < byref.length; j++) { scopePut(env, byref[j], varCell(byref[j])) }
