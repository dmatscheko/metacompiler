BitXorExpr  <~~ push(foldOps(takeAll(), up.start)) ~~>
            = BitAndExpr { "^" <~~ push(up.in) ~~> BitAndExpr } ;
BitAndExpr  <~~ push(foldOps(takeAll(), up.start)) ~~>
            = EqExpr { SingleAmp <~~ push(up.in) ~~> EqExpr } ;
SingleAmp   = "&" !"&" ;
EqExpr      <~~ push(foldBinary(takeAll())) ~~>
            = RelExpr { ( "===" | "!==" | "==" | "!=" | "<=>" | "<>" ) <~~ push(up.in) ~~> RelExpr } ;
RelExpr     <~~ push(foldBinary(takeAll())) ~~>
            = ConcatExpr { RelOp <~~ push(up.in) ~~> ConcatExpr } ;
RelOp       = LeNotSpaceship | ">=" | SingleLt | SingleGt ;
LeNotSpaceship = "<=" !">" ;
SingleLt    = "<" !"<" ;
SingleGt    = ">" !">" ;
ConcatExpr  <~~ push(foldOps(takeAll(), up.start)) ~~>
            = ShiftExpr { DotOp <~~ push(up.in) ~~> ShiftExpr } ;
DotOp       = "." !"=" ;
ShiftExpr   <~~ push(foldOps(takeAll(), up.start)) ~~>
