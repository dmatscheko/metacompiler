    phpBuiltins["exit"] = function(code) { exit(code === undefined ? 0 : trunc(numOf(toNumV(code)))) }
    phpBuiltins["die"] = phpBuiltins["exit"]

    // ----- comparison: ===, ==, <=> and the relational operators ------------------
    // === is identity: same type, and for arrays the same keys in the same ORDER.
    function phpIdentical(l, r) {
        if (isFlo(l) || isFlo(r)) { return isFlo(l) && isFlo(r) && l.f === r.f }
        if (isArr(l) || isArr(r)) {
            if (!(isArr(l) && isArr(r))) { return false }
            if (l.keys.length != r.keys.length) { return false }
            for (var i = 0; i < l.keys.length; i++) {
                if (l.keys[i] !== r.keys[i]) { return false }
