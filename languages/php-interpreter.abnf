        "array_keys": function(d) { return arrOf(d.keys) },
        "array_values": function(d) { return arrOf(derefAll(d.vals)) },
        "abs": function(n) { var v = toNumV(n); return numOf(v) < 0 ? phpArith("-", 0, v) : v },
        "max": function(a, b) { return phpCmp(a, b) > 0 ? a : b },
        "min": function(a, b) { return phpCmp(a, b) < 0 ? a : b },
        "intdiv": function(a, b) { return trunc(numOf(toNumV(a)) / numOf(toNumV(b))) }
    }
    function phpLen(v) {
        if (isArr(v)) { return v.keys.length }
        if (typeof v == "string") { return byteLen(v) }
        if (v === null || v === undefined) { return 0 }
        return 1
