AddExpr     <~~ push(foldOps(takeAll(), up.start)) ~~>
            = MulExpr { ( "+" | "-" ) <~~ push(up.in) ~~> MulExpr } ;
MulExpr     <~~ push(foldOps(takeAll(), up.start)) ~~>
