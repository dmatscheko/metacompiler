KeyedRef    <~~ push({hr: pop()}) ~~> = "&" !"&" Target ;
KeyedVal    <~~ push({hv: pop()}) ~~> = Expression ;
PlainItem   <~~ push({elem: pop()}) ~~>
            = Expression ;

// f(args): a top-level function or builtin call.
Call        <~~ push(makeCall(takeAll(), up.start)) ~~>
            = QName <~~ push(lastSeg(up.in)) ~~> "(" [ ArgList ] ")" ;

VarRef      <~~ push(makeVarRead(pop(), up.start)) ~~>
