    function runClosureRun(params, body, captured, argset) {
        return function() {
            var saved = scopes
            scopes = captured.slice(0)
            scopes.push({})
            bindParams(params, argset)
            var r = anytype
            r = body()
            scopes = saved
            if (isSig(r) && r.ret === true) { return r.v }
            return null
        }
    }
    function splitClosure(items) {
        var out = {params: [], body: null, byval: [], byref: []}
        var ps = out.params
        var bv = out.byval
        var br = out.byref
        for (var i = 0; i < items.length; i++) {
            if (items[i].body != undefined) { out.body = items[i].body }
            else if (items[i].param != undefined) { ps.push(items[i].param) }
            else if (items[i].useval != undefined) { bv.push(items[i].useval) }
            else if (items[i].useref != undefined) { br.push(items[i].useref) }
