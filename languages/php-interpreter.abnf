    // ----- closures ---------------------------------------------------------
    // function (...) use ($a, &$b) {...}: 'use ($a)' snapshots the VALUE at creation
    // time, 'use (&$b)' shares the caller's storage cell. The enclosing scope chain
    // is captured too, so the closure can still see the globals and its own class.
    function closureBody(params, body, captured, isGen) {
        return function(argset) {
            if (isGen === true) { return newGen(runClosureRun(params, body, captured, argset)) }
            return runClosureRun(params, body, captured, argset)()
        }
    }
