        if (head.staticvar != undefined) {
            return {name: null, nameT: null, sref: makeStaticRef(head.staticvar), path: items.slice(1)}
        }
        return {name: head.var == undefined ? null : head.var, nameT: head.varexpr == undefined ? null : head.varexpr,
