            if (!(isArr(l) && isArr(r))) { return false }
            if (l.keys.length != r.keys.length) { return false }
            for (var i = 0; i < l.keys.length; i++) {
                var j = dictFind(r, l.keys[i])
                if (j < 0) { return false }
