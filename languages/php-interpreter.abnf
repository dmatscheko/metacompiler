        var param = null
        var arrow = null
        var block = null
        for (var i = 0; i < items.length; i++) {
            var it = items[i]
            if (it == null || it == undefined) { continue }
            if (it.hname != undefined) { kind = it.hname }
            else if (it.harrow != undefined) { arrow = it.harrow }
            else if (it.hblock != undefined) { block = it.hblock }
            else if (it.param != undefined) { param = it.param }
