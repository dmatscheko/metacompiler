    }
    // $$name resolves its name on every use, so it cannot be baked in at build time.
    function refName(ref) { return ref.nameT == null ? ref.name : "$" + phpStr(ref.nameT()) }
    function phpSet(name, value) {
        for (var i = scopes.length - 1; i >= 0; i--) {
