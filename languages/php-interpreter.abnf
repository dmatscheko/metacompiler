        var p = splitStatic(items)
        return function() { return staticCell(resolveClassName(p.base), p.prop) }
    }

    // include / require: a single-quoted literal path is resolved to a project file
    // (resolveImport -> core.importFile below, so the file's defs register during the walk);
    // a dynamic / double-quoted operand stays notImplemented. The expression yields a
    // harmless true so the enclosing statement still evaluates.
    function makeInclude(items, pos) {
        for (var i = 0; i < items.length; i++) {
            if (items[i].incpath != undefined) {
                resolveImport(items[i].incpath, pos)
                return makeConst(true)
