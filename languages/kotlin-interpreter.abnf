    // The Go twin is rxKtMethod in abnf/jsrtregexkt.go - keep the two in step.
    function krxMethod(target, name, args) {
        // Regex.escape(s) / Regex.escapeReplacement(s) / Regex.fromLiteral(s): the
        // companion. `Regex` is a builtin FUNCTION here (Regex(pat) constructs), and
        // Kotlin defines none of these names on a function value, so no ordinary call
        // can reach this branch.
        if (typeof target == "function") {
            if (name == "escape") { return {v: krxQuote(kstr2(args[0]))} }
            if (name == "escapeReplacement") { return {v: krxEscapeRepl(kstr2(args[0]))} }
            if (name == "fromLiteral") { return {v: mkKRegex(kstr2(args[0]), "LITERAL")} }
            return null
        }
        if (typeof target == "string") {
            if (name == "toRegex") { return {v: mkKRegex(target, args.length > 0 ? args[0] : null)} }
            // The String members that take a pattern. A non-Regex argument is left to
            // the ordinary String behaviour, so plain replace/split/contains are
            // untouched.
            if (args.length > 0 && isKRegex(args[0])) {
                var rx = args[0]
                if (name == "matches") { return {v: rxMatchWhole(rx.prog, target, 0) != null} }
                if (name == "contains") { return {v: rxTest(rx.prog, target)} }
                if (name == "split") { return {v: krxSplit(rx.prog, target, krxArgInt(args, 1, 0))} }
                if (name == "replace") {
                    if (typeof args[1] == "function") { return {v: krxReplaceFn(rx, target, args[1])} }
                    return {v: rxReplace(rx.prog, target, krxTemplate(kstr2(args[1])), true)}
                }
                if (name == "replaceFirst") { return {v: rxReplace(rx.prog, target, krxTemplate(kstr2(args[1])), false)} }
            }
            return null
        }
        if (isKRegex(target)) {
            if (name == "matches") { return {v: rxMatchWhole(target.prog, kstr2(args[0]), 0) != null} }
            if (name == "containsMatchIn") { return {v: rxTest(target.prog, kstr2(args[0]))} }
            if (name == "find") {
                var fs = kstr2(args[0])
                var fm = rxSearch(target.prog, fs, krxArgInt(args, 1, 0))
                return {v: fm == null ? null : krxMk(target, target.prog, fs, fm)}
            }
            if (name == "findAll") { return {v: krxFindAll(target, kstr2(args[0]))} }
            if (name == "matchEntire") {
                var es = kstr2(args[0])
                var em = rxMatchWhole(target.prog, es, 0)
                return {v: em == null ? null : krxMk(target, target.prog, es, em)}
            }
            if (name == "replace") {
                if (typeof args[1] == "function") { return {v: krxReplaceFn(target, kstr2(args[0]), args[1])} }
                return {v: rxReplace(target.prog, kstr2(args[0]), krxTemplate(kstr2(args[1])), true)}
            }
            if (name == "replaceFirst") { return {v: rxReplace(target.prog, kstr2(args[0]), krxTemplate(kstr2(args[1])), false)} }
            if (name == "split") { return {v: krxSplit(target.prog, kstr2(args[0]), krxArgInt(args, 1, 0))} }
            if (name == "toString") { return {v: target.src} }
            fail("unknown Regex method: " + name)
        }
        if (isKMatch(target)) {
            if (name == "next") {
                var at = target.m.end == target.m.begin ? target.m.end + 1 : target.m.end
                if (at > target.text.length) { return {v: null} }
                var nm = rxSearch(target.rx.prog, target.text, at)
                return {v: nm == null ? null : krxMk(target.rx, target.rx.prog, target.text, nm)}
            }
            if (name == "toString") { return {v: rxGroup(target.prog, target.text, target.m, 0)} }
            fail("unknown MatchResult method: " + name)
        }
        return null
    }
    // The property surface (Regex.pattern, MatchResult.value/range/groupValues/...).
    function krxField(o, name) {
        if (isKRegex(o)) {
            if (name == "pattern") { return {v: o.src} }
            if (name == "options") { return {v: []} }
            return null
        }
        if (isKMatch(o)) {
            if (name == "value") { return {v: rxGroup(o.prog, o.text, o.m, 0)} }
            if (name == "range") { return {v: krxRange(o.m.begin, o.m.end - 1)} }
            if (name == "groupValues") { return {v: krxGroupValues(o)} }
            if (name == "groups") { return {v: {__kmg: true, md: o}} }
            // Destructuring: `val (a, b) = m.destructured` reads componentN, and this
            // subset takes componentN of a LIST positionally - so the holder IS the
            // group list without the whole match, which both engines agree on.
            if (name == "destructured") { return {v: krxGroupValues(o).slice(1)} }
            return null
        }
        if (isKGroups(o)) {
            if (name == "size") { return {v: o.md.prog.ngroups + 1} }
            return null
        }
        return null
    }

    // The text of a value: what println writes, what "$v" interpolates and what
    // v.toString() answers. The Go twin for the compiled half is ktpRender in
    // abnf/jsrtkotlin.go and the two MUST stay in step - ./test.sh --cross diffs them.
    // Verified against java 24 (there is no kotlinc here, and Kotlin/JVM's Int, Double
    // and String ARE java.lang.*, so println IS System.out.println).
    function kstr(v) {
        if (v === undefined) return "kotlin.Unit"
        if (v === null) return "null"
        if (kIsChar(v)) return kChStr(v)
        if (kIsFlo(v)) return kFloStr(v.__flo)
        // A sized integer prints its exact digits, and an UNSIGNED one its unsigned
        // reading: ULong.MAX_VALUE is 18446744073709551615, not -1. "" + v would
        // print [object Object] and szNum rounds above 2^53.
        if (szIs(v)) return szStr(v)
        // A range renders as the list of its elements. Real Kotlin prints an IntRange
        // as "1..3", but the COMPILED half has no first-class range value at all (a
        // range is materialised into a list at the point of use), so this is the only
        // answer the two halves can share; the divergence is deliberate.
        if (isRange(v)) { return kstr(rangeList(v)) }
        // A list (and an array, which this value model cannot tell apart from a list)
        // renders as java.util.AbstractCollection.toString does: "[1, 2]", elements
        // separated by a comma and a space, a String element unquoted. Falling through
        // to JavaScript's Array.prototype.toString spelled it "1,2".
        if (Array.isArray(v)) {
            var out = "["
            for (var ai = 0; ai < v.length; ai++) {
                if (ai > 0) { out += ", " }
                out += kstr(v[ai])
            }
            return out + "]"
        }
        if (typeof v == "object" && v.__sb === true) { return v.s }
        // A SET renders like a List - java.util.AbstractCollection.toString again -
        // in its iteration order: [1, 2].
        if (kIsSet(v)) { return kstr(v.keys) }
        // A MAP renders as java.util.AbstractMap.toString does: {a=1, b=2}.
        if (kIsMap(v)) {
            var mo = "{"
            for (var mi = 0; mi < v.keys.length; mi++) {
                if (mi > 0) { mo += ", " }
                mo += kstr(v.keys[mi]) + "=" + kstr(v.vals[mi])
            }
            return mo + "}"
        }
        // A Map.Entry renders as a=1 (java.util.AbstractMap's entry toString), NOT as
        // the Pair it also destructures as - so `println(m.entries)` is [a=1, b=2].
        if (kIsEntry(v)) { return kstr(v.key) + "=" + kstr(v.value) }
        // A Pair / Triple renders as (a, b) / (a, b, c) - kotlin.Pair.toString.
        if (kIsPair(v)) {
            var po = "(" + kstr(v.first) + ", " + kstr(v.second)
            if (v.third !== undefined) { po += ", " + kstr(v.third) }
            return po + ")"
        }
        // A class descriptor printed on its own is its name.
        if (typeof v == "object" && v.__isclass === true) { return v.__name }
        // A user object renders through its toString(): the data-class generated one
        // (Pt13(x=1, y=2)), an explicit override, or the Kotlin default Name@hash shape.
        if (typeof v == "object" && v.__class != undefined && v.__class != null) {
            var ts = clsFind(v.__class, "toString")
            if (typeof ts == "function") { return ts.apply(undefined, [v]) }
            // An enum entry prints its NAME (java.lang.Enum.toString), not Name@1.
            if (clsIsEnum(v.__class) && typeof v.name == "string") { return v.name }
            var g = dataMember(v, "toString", [], {pos: [], named: null})
            if (g != null) { return g.v }
        }
        // A Regex renders as its pattern and a MatchResult as the matched text (their
        // own toString); neither carries a __class, so both used to fall through to
        // JavaScript's "[object Object]".
        if (typeof v == "object") {
            var rx = krxMethod(v, "toString", [])
            if (rx != null) { return kstr2(rx.v) }
        }
        return "" + v
    }
    // Whether a descriptor belongs to an enum class - an entry WITH A BODY is an
    // anonymous subclass, so the __super chain has to be walked.
    function clsIsEnum(cls) {
        var c = anytype
        c = cls
        for (var ei = 0; c != undefined && c != null && ei < 32; ei++) {
            if (c.__isenum === true) { return true }
            c = c.__super
        }
        return false
    }

    // ----- Extension functions: dispatch by name, the receiver becomes `this` -----
    // Method names the runtime implements on strings/lists/dicts (the compiler
    // grammar uses the same list): an extension function never shadows them, so
    // both engines make the same dispatch decision for every (receiver, name).
    var extFuns = {}
    var classMethodNames = {}
    var builtinMethodNames = {}
    var bmn = ["length", "charAt", "equals", "substring", "indexOf", "isEmpty",
               "keys", "values", "get", "add", "append", "pop", "removeLast", "size",
               "contains", "map", "filter", "sumOf", "forEach", "count", "any"]
    for (var bi = 0; bi < bmn.length; bi++) { builtinMethodNames["$" + bmn[bi]] = true }
    // Run a function/method/lambda body in a fresh frame: install `base` as the scope
    // chain (its last element is the body's own scope), optionally bind `this` to self,
    // bind the params from args starting at argOff, run the frame hooks, then restore
    // the scopes and unwrap an {isRet}. Generalises invokeBody (interp-core) over the
    // base chain (global-rooted vs a captured closure chain) and the this-policy
    // (forced, even when null, vs none) that the three closures below need.
    function runFrame(base, self, bindThis, params, args, argOff, body) {
        var saved = scopes
        scopes = base
        if (bindThis) { declVar("this", self) }
        bindParams(params, args, argOff, kTakeNamed())
        var r = anytype
        try {
            r = nlrRun(body)
        } finally {
            scopes = saved
        }
        return (r != undefined && r.isRet) ? r.v : undefined
    }
    // items = [name, {params}, body]: the receiver type was dropped by RecvSeg. `this`
    // is bound UNCONDITIONALLY (even to null: a nullable-receiver extension runs with
    // this = null, and the compiled twin binds args[0] unconditionally). Global-rooted
    // like a top-level function; the receiver is args[0], so params start at argOff 1.
    function registerExtFun(items) {
        var params = items[1].params
        var body = items[2]
        extFuns["$" + items[0]] = function() {
            return runFrame([globalScope, {}], arguments[0], true, params, arguments, 1, body)
        }
    }
    function extResolves(name) {
        if (extFuns["$" + name] == undefined) { return false }
        if (builtinMethodNames["$" + name] == true) { return false }
        if (classMethodNames["$" + name] == true) { return false }
        return true
    }

    // args is the positional argument list; spec (optional) additionally carries the
    // named arguments, so a call into a user-declared method or extension can fit them
    // to its parameter list. Builtins take the positional list as-is.
    // ================= The member surface: Char, String, collections, maps =================
    //
    // The twins of ktCharMethod / ktStrMethod2 / ktSeqMethod / ktMapMethod /
    // ktScopeMethod in abnf/jsrtkotlin.go, which is what the COMPILED half calls
    // through js_ktsmcall. ./test.sh --cross diffs the two, so a change here needs the
    // same change there. Each answers {v: ...} for a name it implements and null for
    // one it does not, so the dispatch below it is unchanged.
    //
    // No kotlinc here: the semantics are kotlin.text / kotlin.collections as
    // documented, and the ones Kotlin shares with java.lang were checked against the
    // equivalent Java program under `java` (JDK 24).

    // A MAP is the runtime's shared dict handle {__dict, keys, vals} - the same shape
    // Go maps and Python dicts use (dictParts in abnf/jsrt.go), so js_pyset / js_pyget
    // and iteration already understand it and the compiled half needs no new value type.
    function kMakeMap() { return {__dict: true, keys: [], vals: []} }
    function kIsMap(v) {
        return v !== null && v !== undefined && typeof v == "object" && !Array.isArray(v) && v.__dict === true
    }
    function kMapFind(m, k) {
        var ks = m.keys
        for (var i = 0; i < ks.length; i++) { if (kEqVals(ks[i], k)) { return i } }
        return 0 - 1
    }
    // A SET is its own shape, {__set: true, keys: []} - the map handle without the
    // parallel `vals` array, which is exactly what java.util.LinkedHashSet is. Before
    // this every set constructor was an alias of listOf, so setOf(1, 1, 2) did not
    // deduplicate, setOf(2, 1) == setOf(1, 2) was FALSE (java: true) and
    // listOf(1) == setOf(1) was TRUE (java: false). Three properties come with the
    // shape at once: uniqueness on insertion, order-INDEPENDENT equality, and
    // java.util.AbstractSet's hashCode, which is the plain SUM of the element hashes
    // (java: Set.of(1, 2).hashCode() is 3, where the list fold answers 994).
    // The ITERATION order is insertion order for setOf / mutableSetOf / linkedSetOf
    // (LinkedHashSet, which is what kotlin.collections.setOf returns) and ascending
    // for sortedSetOf / toSortedSet. hashSetOf / toHashSet are java.util.HashSet,
    // whose order is unspecified; insertion order is used for them too, because two
    // halves that must print identically cannot model "unspecified".
    // The twin is ktMakeSet / ktSetMethod in abnf/jsrtkotlin.go.
    function kMakeSet() { return {__set: true, keys: []} }
    function kIsSet(v) {
        return v !== null && v !== undefined && typeof v == "object" && !Array.isArray(v) && v.__set === true
    }
    function kSetFind(s, e) {
        var ks = s.keys
        for (var i = 0; i < ks.length; i++) { if (kEqVals(ks[i], e)) { return i } }
        return 0 - 1
    }
    function kSetAdd(s, e) {
        if (kSetFind(s, e) >= 0) { return false }
        s.keys.push(e)
        return true
    }
    function kSetFrom(es) {
        var s = kMakeSet()
        for (var i = 0; i < es.length; i++) { kSetAdd(s, es[i]) }
        return s
    }
    // A set whose elements are ALREADY distinct (a map's keys, its entries), so the
    // quadratic uniqueness scan is skipped.
    function kSetOfDistinct(es) {
        var s = kMakeSet()
        for (var i = 0; i < es.length; i++) { s.keys.push(es[i]) }
        return s
    }
    // One Map.Entry. It carries key/value for the Kotlin member names AND first/second
    // so `for ((k, v) in m)` destructures it as a Pair - but it is NOT a Pair, and the
    // __entry marker is what says so: java.util.AbstractMap.SimpleEntry.toString is
    // `a=1` where kotlin.Pair.toString is `(a, 1)`, and Map.Entry.hashCode is
    // key.hashCode() XOR value.hashCode() where a Pair uses the data-class 31-fold.
    // Verified against java (JDK 24): for {a=1, b=2}, entrySet() prints [a=1, b=2],
    // one entry prints a=1 and hashes to 96 ("a".hashCode() ^ 1), and the entry SET
    // hashes to 192, which is the map's own hash.
    function kMapEntry(k, v) { return {__entry: true, key: k, value: v, first: k, second: v} }
    function kIsEntry(v) {
        return v !== null && v !== undefined && typeof v == "object" && v.__entry === true
    }
    function kMapPut(m, k, v) {
        var i = kMapFind(m, k)
        if (i >= 0) { m.vals[i] = v; return }
        m.keys.push(k)
        m.vals.push(v)
    }
    // `==` for the collection operations: numeric across the box, otherwise kEq.
    function kEqVals(a, b) { return kEq(a, b) }
    // The {first, second[, third]} shape `to`, Pair() and Triple() build. It is a plain
    // object rather than a class instance in both halves, so its rendering, its
    // componentN and its destructuring all live with the runtime.
    function kIsPair(v) {
        if (v === null || v === undefined || typeof v != "object" || Array.isArray(v)) { return false }
        if (v.__dict === true || v.__isclass !== undefined) { return false }
        if (v.first === undefined || v.second === undefined) { return false }
        // The COMPILED half builds a real Pair class instance where this one builds a
        // plain object; both are a Pair, and a user class that merely has `first` and
        // `second` is not (only Kotlin's own two tuple names are accepted).
        var cls = v.__class
        if (cls != undefined && cls != null) {
            return cls.__name == "Pair" || cls.__name == "Triple"
        }
        return true
    }
    function kPair(a, b) { return {first: a, second: b} }

    // let / run / apply / also / takeIf / takeUnless: extensions on ANY receiver, so no
    // receiver branch owns them. A class MEMBER of the same name wins, exactly as it
    // does in Kotlin, which is what the lookupMethod probe is for.
    function kScopeMethod(target, name, args) {
        if (name != "let" && name != "run" && name != "apply" && name != "also" &&
            name != "takeIf" && name != "takeUnless") { return null }
        if (args.length != 1 || typeof args[0] != "function") { return null }
        if (target !== null && target !== undefined && typeof target == "object" &&
            target.__class != undefined && target.__class != null) {
            if (clsFind(target.__class, name) != undefined) { return null }
        }
        var f = args[0]
        // `x.run { ... }` binds the receiver as `this`; a bare closure value has no
        // receiver channel in this model, so the receiver arrives as `it` instead -
        // and the compiled half does exactly the same.
        // `run` and `apply` bind the receiver as `this` (kSetRecv is the channel a
        // lambda-with-receiver already uses), so an UNQUALIFIED member call inside the
        // lambda resolves against it; the receiver also arrives as `it`, which `let`
        // and `also` are defined to do.
        if (name == "let") { return {v: f(target)} }
        if (name == "run") { kSetRecv({v: target}); return {v: f(target)} }
        if (name == "apply") { kSetRecv({v: target}); f(target); return {v: target} }
        if (name == "also") { f(target); return {v: target} }
        if (name == "takeIf") { return {v: f(target) ? target : null} }
        return {v: f(target) ? null : target}
    }

    // ----- Char -----
    function kIsLetterCh(code) {
        if ((code >= 97 && code <= 122) || (code >= 65 && code <= 90)) { return true }
        if (code <= 127) { return false }
        var g = String.fromCharCode(code)
        return g.toUpperCase() != g.toLowerCase()
    }
    function kUpperCode(code) {
        var u = String.fromCharCode(code).toUpperCase()
        return u.length == 1 ? u.charCodeAt(0) : code
    }
    function kLowerCode(code) {
        var l = String.fromCharCode(code).toLowerCase()
        return l.length == 1 ? l.charCodeAt(0) : code
    }
    function kCharMethod(cv, name, args) {
        var code = cv.__char
        if (name == "code") { return {v: code} }
        if (name == "toString") { return {v: String.fromCharCode(code)} }
        if (name == "isLetter") { return {v: kIsLetterCh(code)} }
        if (name == "isDigit") { return {v: code >= 48 && code <= 57} }
        if (name == "isLetterOrDigit") { return {v: kIsLetterCh(code) || (code >= 48 && code <= 57)} }
        if (name == "isWhitespace") {
            return {v: code == 32 || code == 9 || code == 10 || code == 13 || code == 12 || code == 11}
        }
        if (name == "isUpperCase") { return {v: code >= 65 && code <= 90} }
        if (name == "isLowerCase") { return {v: code >= 97 && code <= 122} }
        if (name == "uppercaseChar") { return {v: kChar(kUpperCode(code))} }
        if (name == "lowercaseChar") { return {v: kChar(kLowerCode(code))} }
        if (name == "uppercase") { return {v: String.fromCharCode(kUpperCode(code))} }
        if (name == "lowercase") { return {v: String.fromCharCode(kLowerCode(code))} }
        if (name == "digitToInt") {
            if (code < 48 || code > 57) { fail("Char \"" + String.fromCharCode(code) + "\" is not a digit") }
            return {v: code - 48}
        }
        if (name == "compareTo") {
            var o = kIsChar(args[0]) ? args[0].__char : kNum(args[0])
            return {v: code < o ? 0 - 1 : (code > o ? 1 : 0)}
        }
        if (name == "equals") { return {v: kIsChar(args[0]) && args[0].__char === code} }
        if (name == "hashCode") { return {v: code} }
        return null
    }

    // ----- String -----
    function kChars(sv) {
        var out = []
        for (var i = 0; i < sv.length; i++) { out.push(kChar(sv.charCodeAt(i))) }
        return out
    }
    // A Char argument to a String member is its glyph, so s.indexOf('B') and
    // s.indexOf("B") agree.
    function kStrArg(v) { return kIsChar(v) ? String.fromCharCode(v.__char) : kstr2(v) }
    function kIsSpaceCh(code) {
        return code == 32 || code == 9 || code == 10 || code == 13 || code == 12
    }
    function kTrimSide(sv, left, right) {
        var b = 0
        var e = sv.length
        while (left && b < e && kIsSpaceCh(sv.charCodeAt(b))) { b++ }
        while (right && e > b && kIsSpaceCh(sv.charCodeAt(e - 1))) { e-- }
        return sv.substring(b, e)
    }
    // The frozen engine has no String.split, so the scan is written out.
    function kSplitStr(sv, sep) {
        var out = []
        var start = 0
        var i = 0
        while (i + sep.length <= sv.length) {
            if (sv.substring(i, i + sep.length) === sep) {
                out.push(sv.substring(start, i))
                i = i + sep.length
                start = i
                continue
            }
            i++
        }
        out.push(sv.substring(start, sv.length))
        return out
    }
    function kLastIndexOfStr(sv, sub) {
        var found = 0 - 1
        var i = 0
        while (i + sub.length <= sv.length) {
            if (sv.substring(i, i + sub.length) === sub) { found = i }
            i++
        }
        return found
    }
    function kStrMethod2(sv, name, args) {
        var n = sv.length
        if (name == "charAt" || name == "first" || name == "last" || name == "single" ||
            name == "firstOrNull" || name == "lastOrNull") {
            if (name == "charAt") {
                var ci = kNum(args[0])
                if (ci < 0 || ci >= n) { fail("charAt(" + ci + ") out of range for " + sv) }
                return {v: kChar(sv.charCodeAt(ci))}
            }
            if (name == "firstOrNull") { return {v: n == 0 ? null : kChar(sv.charCodeAt(0))} }
            if (name == "lastOrNull") { return {v: n == 0 ? null : kChar(sv.charCodeAt(n - 1))} }
            if (name == "single") {
                // single(predicate) filters first - the predicate used to be IGNORED,
                // so `"hello".single { it == 'h' }` aborted with "single() on a string
                // of length 5" in both halves instead of answering 'h'.
                if (args.length > 0 && typeof args[0] == "function") { return kSeqMethod(kChars(sv), name, args) }
                if (n != 1) { fail("single() on a string of length " + n) }
                return {v: kChar(sv.charCodeAt(0))}
            }
            if (n == 0) { fail(name + "() on an empty string") }
            return {v: kChar(sv.charCodeAt(name == "first" ? 0 : n - 1))}
        }
        if (name == "toCharArray" || name == "toList") { return {v: kChars(sv)} }
        if (name == "trim") { return {v: kTrimSide(sv, true, true)} }
        if (name == "trimStart") { return {v: kTrimSide(sv, true, false)} }
        if (name == "trimEnd") { return {v: kTrimSide(sv, false, true)} }
        if (name == "startsWith") {
