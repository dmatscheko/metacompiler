// the ordered choice, and dropping that requirement would let PropAccessor swallow
// TopVisProp's `val x = 1 private set`.
AccGetB     = [ Modifiers ] Getter [ ";" ] ;
AccSetB     = [ Modifiers ] Setter [ ";" ] ;
AccGetV     = [ Modifiers ] KwGet NotParen [ ";" ] ;
AccSetV     = [ Modifiers ] KwSet NotParen [ ";" ] ;
AccGetPart  = AccGetB | AccGetV ;
AccSetPart  = AccSetB | AccSetV ;
AccRun      = AccGetPart [ AccSetPart ] | AccSetPart [ AccGetPart ] ;
AccRunB     = AccGetB [ AccSetPart ] | AccSetB [ AccGetPart ] | AccGetV AccSetB | AccSetV AccGetB ;
AccRunV     = AccGetV [ AccSetPart ] | AccSetV [ AccGetPart ] ;
