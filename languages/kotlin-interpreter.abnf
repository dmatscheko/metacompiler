// Type is parsed and (apart from steering as/is) ignored. Generics (<...>) and the
// nullable ? are accepted and dropped; dotted names and function types too. A leading
// type annotation (@Composable () -> Unit) is accepted. A parenthesized group without
// a trailing -> is a grouped type, so a nullable function type ((Intent) -> Unit)?
// parses: the inner function type is the group, then ? applies to the whole. A leading
// `suspend` (a suspending function type: suspend () -> Unit, suspend Recv.() -> R) is
// accepted and dropped - KwEnd stops it from eating a `suspend`-prefixed type name.
// A parenthesized type may equally carry a receiver function tail - (@A C).() -> C,
// (suspend () -> Unit).() -> Unit - and any type may be an INTERSECTION, T & Any.
// The receiver of a receiver function type may itself be NULLABLE - RS?.(P) -> Unit,
// (@A C)?.() -> C - so the `?` is offered before the tail as well as after the whole
// type; NullRecvFnTail is tried first because the plain tail would leave the `?`
// stranded and the trailing `[ "?" NotColon ]` only covers a type that ENDS there.
Type        = { TypeAnno } [ ContextClause ] [ "suspend" KwEnd ] [ ContextClause ] { TypeAnno } ( "(" [ FnTypeParam { "," FnTypeParam } [ "," ] ] ")" ( "->" Type | NullRecvFnTail | RecvFnTail )
            | "(" FnTypeParam { "," FnTypeParam } [ "," ] ")"
            | KId [ SkipAngle ] { "." KId [ SkipAngle ] } [ NullRecvFnTail | RecvFnTail ] ) [ "?" NotColon ] [ "&" Type ] ;
// A DOUBLED question mark is still just a nullable receiver: `X??.() -> Unit` and
// `X?? .() -> Unit` are FUNCTION_TYPEs with a NULLABLE_TYPE receiver in Kotlin's own
// tree (psi/greatSyntacticShift/nullableTypes.txt), with no PsiErrorElement - the second
// `?` is redundant, not wrong.
NullRecvFnTail = "?" [ "?" ] RecvFnTail ;
// A function-type parameter: an optional name (Kotlin allows named function-type
// parameters, onRun: (root: Boolean) -> Unit) then the type. Also serves the
// grouped-type case (a bare type with no name, in parentheses without a following ->).
FnTypeParam = [ KId ":" ] Type ;
// A receiver function type tail: Recv.() -> R / Recv.(A) -> R (a lambda-with-receiver
// type, e.g. @Composable RowScope.() -> Unit). The receiver type is the dotted name;
// this consumes the `.(params) -> Ret`. Parsed and ignored like any type.
RecvFnTail  = "." "(" [ FnTypeParam ] { "," [ FnTypeParam ] } ")" "->" Type ;
// A type annotation: an argument list is consumed only when a `->` does NOT follow,
// so `@Composable () -> Unit` leaves the `()` for the function type (NotArrow rolls
// the parens back), while `@Tag("x") Foo` keeps them as the annotation's arguments.
// The NoSpaceParen guard settles the other ambiguity, `@Foo (X)`: in TYPE position a
// parenthesis is the annotation's argument list only when it touches the name. Kotlin
// reads `@Bar(10) T` as an annotation with arguments but `@Foo (() -> Unit)` as a
// bare annotation on a PARENTHESIZED type - its own PSI dump for the second form has
// a CONSTRUCTOR_CALLEE with no VALUE_ARGUMENT_LIST and leaves the LPAR to the type.
TypeAnno    = "@" [ AnnTarget ":" ] ( AnnSet | KId { "." KId } [ NoSpaceParen SkipParen NotArrow ] ) ;
// A zero-width guard that fails unless the very next character is `(` - i.e. unless
// the parenthesis touches what came before it, with no whitespace in between.
NoSpaceParen = :script(~~
    (function() {
        return (c.peek(0) === 40) ? undefined : abnf.newToken("\x01space-before-paren", 0)
    })()
~~) ;

// Every statement production pushes exactly one thunk: function() -> undefined | signal.
// A statement may carry a label (loop@ ...); the label is parsed and ignored, so the
// labelled statement still runs. Labelled jumps (break@l / continue@l / return@l)
// route to notImpl (the target label cannot be resolved in the subset).
Statement   = { Annotation } ( ReturnAt | Return | BreakAt | Break | ContinueAt | Continue
            | Labeled | PlainStmt ) ;
PlainStmt   = Block | LocalTypeAlias | LocalClass | LocalTypeDecl | LocalExtFun | LocalFun | Destructure | DestructAssign | DelegateDecl | Decl | BareDecl | LocalModDecl | If | While | Do | For | TryStmt | Throw | Empty | ExprStmt ;
// A local declaration carrying MODIFIERS - `private fun bar() {}`, `inline fun foo()`,
// `noinline val x1 = 1`, `out val foo = 5`. LocalClass and LocalTypeDecl already take a
// modifier run of their own; the function and property forms did not, so the modifier
// was read as a bare expression statement and the declaration became a SECOND statement
// on the same line. Kotlin keeps each of those lines whole (psi/LocalDeclarations.txt,
// psi/annotation/modifiersMigration/newModifiers.txt), which is what NewStmtLine above
// needs to be true before it can refuse the genuine same-line files.
// It sits AFTER the unmodified forms so the common path is untouched, and ModRun
// requires at least one real modifier so an ordinary statement never reaches it twice.
LocalModDecl = ModRun LocalModTarget ;
// The modifiers are parsed and DROPPED: none of the targets below reads pendingMods, so
// the run has to be drained here or it would leak into the next declaration that does.
ModRun      <~~ takeMods() ~~>
            = ( Modifier | CompanionMod | AnnEnumMod | VarianceMod ) Modifiers ;
LocalModTarget = LocalExtFun | LocalFun | Destructure | DestructAssign | DelegateDecl | Decl | BareDecl ;
Labeled     <~~ push(makeLabeled(takeAll(), up.pos)) ~~>
            = LabelDef PlainStmt ;
// A local function declaration (fun name(...) { ... } inside a block): genuine. It
// binds a closure over the enclosing scope under its name in the CURRENT scope, so
// it sees the enclosing locals and can recurse. Comes before ExprStmt, which would
// otherwise read the `fun` keyword as an identifier. FunDecl pushes {name,params,body}.
// A local typealias. The alias is registered while the declaration is WALKED (types
// are erased, so there is nothing to do at run time), and the statement itself is a
// no-op thunk - every statement production must leave exactly one on the stack.
LocalTypeAlias <~~ push(function() {}) ~~>
            = TypeAlias ;
// A LOCAL class / interface / object - a type declared inside a function body, built
// for real. The REAL builders run at WALK time (a class descriptor is static) and bind
// the name in globalScope; what the statement adds is the run-time binding in the
// enclosing scope, so the name is visible from the declaration onwards exactly like a
// local function's. The captured-variable part of Kotlin's local classes is NOT here:
// makeCtor resets `scopes` to [globalScope, {}], so a local class body sees the same
// scope a top-level one does. Two local classes of the same name in different functions
// therefore share one globalScope slot - the last one walked wins for anything that
// resolves through globalScope, while the statement binding is per-frame and correct.
LocalClass  <~~ push(makeLocalTypeStmt(pop())) ~~>
            = [ Modifiers ] ( ClassReal | InterfaceReal | ObjectReal ) ;
// The shapes the real builders decline (an enum, or a body outside the member set):
// only the SKIP forms are offered, the shape is accepted, reported as not implemented,
// and the statement is a no-op thunk. takeAll drains the placeholder the skip form
// pushed, so the statement leaves exactly one.
LocalTypeDecl <~~ takeAll(); takeMods(); push(notImplStmt("local type declaration", up.pos)) ~~>
            = [ Modifiers ] ( EnumSkip | ClassSkip | InterfaceSkip | ObjectSkip ) ;
LocalFun    <~~ push(makeLocalFunStmt(pop())) ~~>
            = FunDecl ;
// A local EXTENSION function (fun Int.tripled(): Int = this * 3 inside a body): the
// same dispatch-by-name registration a top-level extension gets, performed when the
// declaration statement runs.
LocalExtFun <~~ push(makeLocalExtFun(takeAll())); retLblPop() ~~>
            = KwFun [ SkipAngle ] AnnoRecv { RecvSeg } KId <~~ push(up.in); retLblPush(up.in, "fun") ~~> [ SkipAngle ] ParamList [ ":" Type ] [ WhereClause ] [ ContractClause ] [ WhereClause ] FunBody ;

// try/catch/finally and throw are implemented (excThrow/excTryTyped, languages/lib):
// throw raises the value, catch binds it (the first clause whose declared type accepts
// the value wins), finally always runs. return/break/continue
// inside a try still propagate to the enclosing loop or function. Each part is marked
// so excTry can tell them apart on the stack.
TryStmt     <~~ push(excTryTyped(takeAll())) ~~>
            = KwTry TryBody { CatchClause } [ FinallyClause ] ;
TryBody     <~~ push({trybody: pop()}) ~~>
            = Block ;
// The declared type of the catch parameter is kept: excTryTyped (lib/interp-core.js)
// runs the FIRST clause whose type accepts the thrown value, so
// `catch (e: AppError) ... catch (e: Exception)` discriminates the way Kotlin does.
CatchClause <~~ push(kCatchStmt(takeAll())) ~~>
            = KwCatch "(" KId <~~ push({ctchname: up.in}) ~~> [ ":" CatchType ] [ "," ] ")" Block ;
CatchType   <~~ push({ctchtype: pop()}) ~~>
            = TypeName ;
FinallyClause <~~ push({finbody: pop()}) ~~>
            = KwFinally Block ;
Throw       <~~ push(excThrow(pop())) ~~>
            = KwThrow Expression [ ";" ] ;

Block       <~~ push(makeBlockStmt(takeAll())) ~~>
            = "{" [ Statement ] { NewStmtLine Statement } "}" ;
// Kotlin refuses two statements on ONE line without a `;` between them: "Unexpected
// tokens (use ';' to separate expressions on the same line)". The guard sits at the
// block-item boundary and scans FORWARD - the whitespace after the previous statement's
// last token is still ahead at a :script, so a backward scan sees nothing and silently
// does nothing (docs/abnf-dialect-gotchas.md). It accepts a newline, a `;` (either just
// consumed by the previous statement or still ahead), a `}` (the block is over) and end
// of input, and refuses everything else. Comments are skipped like whitespace, and a
// comment containing a newline separates - Kotlin's parser sees the same line breaks the
// lexer does, whether or not a comment is wrapped around them.
NewStmtLine = :script(~~
    (function() {
        if (c.peek(-1) === 59) { return undefined }
        var i = 0
        var steps = 0
        while (steps < 100000) {
            steps++
            var ch = c.peek(i)
            if (ch < 0) { return undefined }
            if (ch === 10 || ch === 59 || ch === 125) { return undefined }
            if (ch === 32 || ch === 9 || ch === 13 || ch === 12) { i++; continue }
            if (ch === 47 && c.peek(i + 1) === 47) { return undefined }
            if (ch === 47 && c.peek(i + 1) === 42) {
                var d = 1
                i = i + 2
                while (d > 0 && steps < 100000) {
                    steps++
                    var b = c.peek(i)
                    if (b < 0) { return undefined }
                    if (b === 10) { return undefined }
                    if (b === 47 && c.peek(i + 1) === 42) { d = d + 1; i = i + 2; continue }
                    if (b === 42 && c.peek(i + 1) === 47) { d = d - 1; i = i + 2; continue }
                    i++
                }
                continue
            }
            return abnf.newToken("\x01same-line-statement", 0)
        }
        return undefined
    })()
~~) ;
// MEASURED, REVERTED, AND NOW LANDED (2026-07-28). The guard above was written twice
// before it stuck. Both rows, each against the baseline of its day:
//
//     backward scan (wrong, kept only as the reason the forward one exists)
//                              parse 284 (-102)   reject 292 (+3)
//     forward scan, first try  parse 378 (-8)     reject 292 (+3)     net -5, reverted
//     forward scan, landed     parse 384 (-0)     reject 297 (+3)
//
// The eight files the first try cost were all places where THIS grammar split a
// construct Kotlin keeps whole, and every one of them was a real gap:
//
//     psi/LocalDeclarations.kt                   LabelDef matched `abstract @` ACROSS
//     psi/newLabels/oldSyntaxExpressions.kt      a space, and a local declaration took
//                                                no modifier run    -> AtAdjacent on
//                                                LabelDef, LocalModDecl
//     psi/annotation/at/blockLevelExpressions*   `x7 infix x9` is an infix CALL; the
//     psi/annotation/modifiersMigration/         soft-keyword modifiers were excluded
//       newModifiers.kt                          from infix position -> NotInfixKw
//     psi/contextParameters/parsing…Incorrect
//     psi/trailingCommaAllowed.kt                `x[1, 3, ]` is a variadic index with a
//                                                trailing comma     -> IndexSfx
//     psi/DoubleColon.kt                         `X()::class`, `super<a>@b::foo`,
//                                                `++a::b`           -> RefSfx, SuperExpr,
//                                                PreIncRef
//
// With those eight parsing for the RIGHT reason the guard costs nothing and takes the
// three files it was written for (psi/AssertNotNull.kt, psi/primaryConstructor/local.kt,
// psi/annotation/lambda.kt), which is what closed the reject row.

// A declared RECEIVER function type - val dot: Int.(Int) -> Int - makes the
// initializing lambda a lambda-with-receiver: its first argument becomes `this`, so it
// can be called both as dot(recv, arg) and, through the receiver-call fallback, as
// recv.dot(arg). Any other type annotation is parsed and dropped as before.
Decl        <~~ push(makeDecl(takeAll())) ~~>
            = ( "val" | "var" ) KwEnd { Annotation } KId <~~ push(up.in) ~~> [ ":" DeclType ] "=" Expression [ ";" ] ;
// The declared type is pushed as {dty}: an INTEGRAL one retypes the initializer.
// RecvFnType and DeclTypeName each push exactly ONE item, so makeDecl's item count
// does not depend on which alternative matched.
DeclType    = RecvFnType | DeclTypeName ;
DeclTypeName <~~ push({dty: up.in}) ~~> = Type ;
// The same declaration WITHOUT an initializer - `val f1: File` - which Kotlin allows
// wherever a definite assignment follows. It binds the name to null so later reads and
// the assignment that fills it in both resolve. Tried after Decl, so an initialized
// declaration is never split at its `=`.
BareDecl    <~~ push(makeDecl(takeAll())) ~~>
            = ( "val" | "var" ) KwEnd { Annotation } KId <~~ push(up.in) ~~> [ ":" DeclType ] [ ";" ] ;
RecvFnType  <~~ push({recvFn: true}) ~~>
            = { TypeAnno } [ "suspend" KwEnd ] KId [ SkipAngle ] { "." KId [ SkipAngle ] } RecvFnTail [ "?" ] ;
// A local or top-level delegated property (val x by <delegate>). Same split as
// PropDelegate: `val x by lazy { init }` is GENUINE (LazyDecl - the initializer runs
// once and x becomes an ordinary binding); every other delegate is not implemented -
// including an EXTENSION delegated property (val Recv.x by preferencesDataStore(...)):
// its receiver is absorbed by the tag-less RecvSeg, and it never matches genuine LazyDecl
// (which has no receiver), so it lands in UnsupDelegateDecl.
DelegateDecl = LazyDecl | RealDelegateDecl | UnsupDelegateDecl ;
LazyDecl    <~~ push(makeDecl(unwrapInit(takeAll()))) ~~>
            = "val" KwEnd KId <~~ push(up.in) ~~> [ ":" Type ] KwBy KwLazy [ SkipParen ] LazyInit [ ";" ] ;
// The same delegate protocol for a local or top-level `val x by d`: the binding holds
// a delegate box, and reads (makeVarRef) and writes (kSetName) go through
// getValue/setValue. thisRef is null, as it is in Kotlin for a non-member property.
RealDelegateDecl <~~ push(makeDelegDecl(takeAll(), up.pos)) ~~>
            = ( "val" | "var" ) KwEnd KId <~~ push(up.in) ~~> [ ":" Type ] KwBy DelegSrc [ ";" ] [ AccRun ] [ ";" ] ;
UnsupDelegateDecl <~~ push(notImplStmt("delegated property", up.pos)) ~~>
            = ( "val" | "var" ) KwEnd [ RecvSeg { RecvSeg } ] KId [ ":" Type ] KwBy DiscardExpr [ SkipBlock ] [ ";" ] ;

If          <~~ push(makeIf(takeAll())) ~~>
            = KwIf "(" Expression ")" Statement [ KwElse Statement ] ;

While       <~~ push(makeWhile(pop(), pop())) ~~>
            = KwWhile "(" Expression ")" Statement ;

Do          <~~ push(makeDo(pop(), pop())) ~~>
            = KwDo Statement KwWhile "(" Expression ")" [ ";" ] ;

// for (x in <iterable>): ONE rule for every source, because a range is now a genuine
// value (see makeRange) rather than a for-loop-only shape. The subject expression may
// therefore be a range (1..n, 0..<n, a until b, n downTo 1, any of them `step k`), a
// char range ('a'..'c'), a list, or a string; makeForIn dispatches at run time. The
// destructuring form for ((a, b) in pairs) is tried second (it opens with a second
// paren, which ForIn's leading Id rejects).
For         = ForIn | ForDestruct ;
ForIn       <~~ push(makeForIn(pop(), pop(), pop())) ~~>
            = KwFor "(" KId <~~ push(up.in) ~~> KwIn Expression ")" Statement ;
// A destructuring for-loop, for ((px, py) in points): the element is decomposed with
// the same componentN protocol as a destructuring declaration, once per iteration.
ForDestruct <~~ push(makeForDestruct(takeAll())) ~~>
            = KwFor "(" ( ( "val" | "var" ) KwEnd { AnnNoArgs } DTuple | { AnnNoArgs } DTupleKwV | { AnnNoArgs } DTuple ) KwIn Expression ")" Statement ;
DTuple      <~~ push({dnames: takeAll()}) ~~>
            = "(" DName { "," DName } [ "," ] ")" | "[" DName { "," DName } [ "," ] "]" ;
DTupleKwV   <~~ push({dnames: takeAll()}) ~~>
            = "(" DNameKwV { "," DNameKwV } [ "," ] ")" | "[" DNameKwV { "," DNameKwV } [ "," ] "]" ;

Return      <~~ push(makeReturn(takeAll())) ~~>
            = KwReturn NoSpacedAt [ Expression ] [ ";" ] ;

Break       <~~ push(makeBreak()) ~~>    = KwBreak NoSpacedAt [ ";" ] ;
Continue    <~~ push(makeContinue()) ~~> = KwContinue NoSpacedAt [ ";" ] ;

Empty       <~~ push(function() {}) ~~>
            = ";" ;

ExprStmt    <~~ push(exprToStmt(pop())) ~~>
            = Expression [ ";" ] ;

// Every expression production pushes exactly one thunk: function() -> value.
// A leading annotation - when (@Ann "") { }, `@ann x += f()` as a when-arm body - is
// parsed and dropped; Annotation pushes nothing, so the alternatives below still leave
// exactly one thunk on the stack.
Expression  = { Annotation } ( Assignment | CallAssign | OrExpr ) ;
Assignment  <~~ push(makeAssign(takeAll())) ~~>
            = Target ( "+=" | "-=" | "*=" | "/=" | "%=" | "=" ) <~~ push(up.in) ~~> Expression ;
// An assignment whose left side is a postfix expression containing a call, so a plain
// Target (Id rooted, dot/index steps) cannot cover it: foo(x).field = y,
// items(k)[0] += 1. GENUINE - the chain up to the last step is evaluated once and the
// last step is written like any other slot. A chain that ENDS in a call is not an
// lvalue; for a compound operator it then goes through Kotlin's plusAssign/minusAssign/
// timesAssign/divAssign/remAssign convention, and only a plain `=` onto a call result
// remains unsupported (both sides still run, so their calls stay visible).
CallAssign  <~~ push(makeCallAssign(takeAll(), up.pos)) ~~>
            = CallChain ( "+=" | "-=" | "*=" | "/=" | "%=" | "=" ) <~~ push(up.in) ~~> Expression ;
// The same postfix chain as CallMember, but kept UNFOLDED so the assignment can split
// off the last step: everything before it is the container, and the last `.name` or
// `[i]` is the slot written (through a property setter or an `operator fun set`).
CallChain   <~~ push({chain: takeAll()}) ~~>
            = Primary { MethodSfx | SafeMethodSfx | FieldSfx | SafeFieldSfx | IndexSfx | "!!" } ;

// The chain may carry a `!!` (the non-null assertion, which is the identity for an
// untyped value and is simply dropped) and a `?.` step - `t!!.i++` and `t?.i++` are both
// ordinary Kotlin, and psiUtil/isSelectorInExpression.kt spells them out. The `?.` step
// is read like a plain `.`: on a NON-null receiver, which is the only case a ++ can
// mean anything on, the two are the same access.
Target      <~~ push(makeTargetRef(takeAll())) ~~>
            = KId <~~ push(up.in) ~~> { "." KId <~~ push({key: up.in}) ~~> | "?." KId <~~ push({key: up.in}) ~~> | "!!" | TIndex } ;
TIndex      <~~ push({idx: kIndexArg(takeAll(), up.pos)}) ~~>
            = "[" Expression { "," Expression } [ "," ] "]" ;

// if as an expression needs both arms.
IfExpr      <~~ push(makeIfExpr(pop(), pop(), pop())) ~~>
            = KwIf "(" Expression ")" ( ValueBlock | Expression ) KwElse ( ValueBlock | Expression ) ;

// when { c1 -> e1; else -> e } and when (x) { 1, 2 -> e1; else -> e }.
WhenExpr    <~~ push(makeWhen(takeAll())) ~~>
            = KwWhen [ "(" WhenSubj ")" ] "{"
              { WhenElse | WhenArm } "}" ;
// The subject is a plain expression, or a val/var binding - when (val x = e) { ... } -
// whose name is in scope in every arm body. The type annotation is parsed and ignored.
// The subject variable may be ANNOTATED - `when (@Ann val x6a = foo)`. Annotation
// pushes nothing, so the run is item-neutral for every alternative below.
WhenSubj    = { Annotation } ( WhenBind | WhenBindDestr | WhenExprSubj ) ;
// The initializer may be missing (when (val x: T) { }); the subject is Unit then.
WhenBind    <~~ var e = pop(); push({subj: e, subjName: pop()}) ~~>
// The bound name may carry a RECEIVER type - `when (val T.x5 = foo)`,
// `when (val T1.x5t: T2 = foo)` - which psi/WhenWithSubjectVariable.txt records with a
// clean tree. RecvSeg is tag-less, so the receiver is parsed and dropped and the item
// count the tag pops is unchanged.
            = ( "val" | "var" ) KwEnd { RecvSeg } KId <~~ push(up.in) ~~> [ ":" Type ] "=" Expression
            | ( "val" | "var" ) KwEnd { RecvSeg } KId <~~ push(up.in); push(makeConst(undefined)) ~~> [ ":" Type ] ;
// A DESTRUCTURING subject variable - when (val (x, y) = foo) { ... }. The components are
// parsed and dropped (nothing binds them), so only the subject EXPRESSION is genuine;
// the arms still see the value they compare against. psi/WhenWithSubjectVariable.kt.
WhenBindDestr <~~ push({subj: pop()}) ~~>
            = ( "val" | "var" ) KwEnd SkipParen "=" Expression ;
WhenExprSubj <~~ push({subj: pop()}) ~~>
            = Expression ;
// The else arm must be tried first: otherwise 'else' would parse as a variable arm
// (and only fail at run time, when no other arm matches).
WhenElse    = KwElse "->" ( ValueBlock | Expression ) <~~ push({els: pop()}) ~~> [ ";" ] ;
WhenArm     <~~ push(makeWhenArm(takeAll())) ~~>
            = WhenCond { "," WhenCond } [ "," ] "->" ( ValueBlock | Expression ) [ ";" ] ;
// A branch condition: an inclusive range test (in / !in), a type test (is T / !is T,
// undecidable so it never matches and warns), or a value to compare with.
WhenCond    = WhenIn | WhenNotIn | WhenIs | WhenVal ;
WhenIs      <~~ var t = pop(); push({isType: true, neg: pop(), tname: t, pos: up.pos}) ~~> = IsKw TypeName ;
WhenIn      <~~ var h = pop(); push({lo: pop(), hi: h, neg: false}) ~~>
            = KwIn AddExpr ".." AddExpr ;
WhenNotIn   <~~ var h = pop(); push({lo: pop(), hi: h, neg: true}) ~~>
            = "!" KwIn AddExpr ".." AddExpr ;
WhenVal     <~~ push({v: pop()}) ~~>
            = Expression ;

OrExpr      <~~ push(makeOrAnd(takeAll(), true)) ~~>
            = AndExpr { "||" AndExpr } ;

AndExpr     <~~ push(makeOrAnd(takeAll(), false)) ~~>
            = EqExpr { "&&" EqExpr } ;

// Referential equality === / !== is evaluated like structural == / != (untyped values
// compare by identity for objects), so the operands still run and fold.
EqExpr      <~~ push(foldBinary(takeAll())) ~~>
            = RelExpr { EqOp RelExpr } ;
EqOp        = "===" <~~ push("==") ~~> | "!==" <~~ push("!=") ~~>
            | "==" <~~ push("==") ~~> | "!=" <~~ push("!=") ~~> ;

RelExpr     <~~ push(foldBinary(takeAll())) ~~>
            = InExpr { ( "<=" | ">=" | "<" | ">" ) <~~ push(up.in) ~~> InExpr } ;

// x in coll / x !in coll (membership): binds tighter than comparison, as in Kotlin.
// Lowered to coll.contains(x) (the same mcall the compiler emits), so both engines
// agree; !in negates. The receiver is a list here (contains checks membership).
InExpr      <~~ push(makeInExpr(takeAll())) ~~>
            = Elvis { InOp Elvis } ;
InOp        = "!" KwIn <~~ push({inop: "!in"}) ~~> | KwIn <~~ push({inop: "in"}) ~~> ;

// x as T / x as? T = identity (untyped values); x is T / x !is T undecidable, so
// not implemented. The suffix is optional, so plain expressions are unaffected.
// `as` / `is` bind TIGHTER than the elvis operator (Kotlin's precedence), so the
// type-op level sits below Elvis: `num as? Int ?: 0` is `(num as? Int) ?: 0`.
TypeOp      <~~ push(applyTypeOp(takeAll())) ~~> = InfixExpr { IsSfx | AsSfx } ;
// A postfix `is T` needs two guards, both defending the `when`-arm boundary where a
// bare `is T` leads the NEXT arm. SameLine: the `is` must sit on the operand's line, so
// an arm value never reaches across the newline to swallow the next arm's leading
// `is T,` (a multi-condition arm) - otherwise `... -> v` then `is B,` on the next line
// parses as `v is B` and strands the comma. NotArrow: on the SAME line, `is T ->` still
// leads an arm (is CellInfoGsm -> ...), so the postfix must not fire there either.
// Together they leave same-line `x is T` (not arrow-led) as the only postfix type test.
IsSfx       <~~ var t = pop(); push({isType: true, neg: pop(), tname: t, pos: up.pos}) ~~> = SameLine IsKw TypeName NotArrow ;
AsSfx       <~~ var t = pop(); push({asType: true, safe: pop(), tname: t}) ~~> = AsKw TypeName ;
IsKw        = KwIs <~~ push(false) ~~> | KwNotIs <~~ push(true) ~~> ;
AsKw        = KwAsSafe <~~ push(true) ~~> | KwAs <~~ push(false) ~~> ;
TypeName    <~~ push(stripWs(up.in)) ~~> = Type ;
// A zero-width guard that fails when the next non-whitespace token is `->`.
NotArrow    = :script(~~
    (function() {
        var i = 0
        var cc = c.peek(i)
        while (cc === 32 || cc === 9 || cc === 10 || cc === 13) { i++; cc = c.peek(i) }
        return (cc === 45 && c.peek(i + 1) === 62)
            ? abnf.newToken("\x01arrow-follows", 0)
            : undefined
    })()
~~) ;

// A zero-width guard that fails at end of line (a newline or a // comment before
// the next token): the value of a labelled return must start on the SAME line,
// otherwise `return@lbl` followed by another statement would swallow that
// statement as its return value (newlines are insignificant everywhere else).
SameLine    = :script(~~
    (function() {
        var i = 0
        var cc = c.peek(i)
        while (cc === 32 || cc === 9) { i++; cc = c.peek(i) }
        return (cc === 10 || cc === 13 || (cc === 47 && c.peek(i + 1) === 47))
            ? abnf.newToken("\x01newline-follows", 0)
            : undefined
    })()
~~) ;

// A zero-width guard that fails when the next non-whitespace token is `(` - used to
// tell a visibility-only accessor (private set) from a body accessor (set(v) { ... }).
NotParen    = :script(~~
    (function() {
        var i = 0
        var cc = c.peek(i)
        while (cc === 32 || cc === 9 || cc === 10 || cc === 13) { i++; cc = c.peek(i) }
        return (cc === 40) ? abnf.newToken("\x01paren-follows", 0) : undefined
    })()
~~) ;

// A zero-width guard that fails when the next non-whitespace character is `{`.
NotBrace    = :script(~~
    (function() {
        var i = 0
        var cc = c.peek(i)
        while (cc === 32 || cc === 9 || cc === 10 || cc === 13) { i++; cc = c.peek(i) }
        return (cc === 123) ? abnf.newToken("\x01brace-follows", 0) : undefined
    })()
~~) ;

// A zero-width guard that fails when the next non-whitespace token is `:` - used so a
// soft-keyword modifier (data/value/inner/...) that is really a parameter or property
// NAME is not consumed as a modifier (a genuine modifier is never followed by `:`).
NotColon    = :script(~~
    (function() {
        var i = 0
        var cc = c.peek(i)
        while (cc === 32 || cc === 9 || cc === 10 || cc === 13) { i++; cc = c.peek(i) }
        return (cc === 58) ? abnf.newToken("\x01colon-follows", 0) : undefined
    })()
~~) ;

// A zero-width guard that fails when the next non-whitespace token is the keyword
// `object` - it keeps the `companion` MODIFIER (companion fun / companion val) from
// consuming the `companion` of a `companion object` declaration.
NotObjectKw = :script(~~
    (function() {
        var i = 0
        var cc = c.peek(i)
        while (cc === 32 || cc === 9 || cc === 10 || cc === 13) { i++; cc = c.peek(i) }
        var w = "object"
        var k = 0
        while (k < 6) {
            if (c.peek(i + k) !== w.charCodeAt(k)) { return undefined }
            k++
        }
        var n = c.peek(i + 6)
        var isWord = (n >= 48 && n <= 57) || (n >= 65 && n <= 90) || (n >= 97 && n <= 122) || n === 95
        return isWord ? undefined : abnf.newToken("\x01object-follows", 0)
    })()
~~) ;

// A zero-width guard that fails when the very next character is `=` - it separates a
// named argument's `name =` from the equality operator in `name == value`.
NotEqSign   = :script(~~
    (function() {
        return (c.peek(0) === 61) ? abnf.newToken("\x01eq-follows", 0) : undefined
    })()
~~) ;

// a ?: b yields a unless it is null (the elvis operator; the right side only runs then).
Elvis       <~~ push(makeElvis(takeAll())) ~~>
            = TypeOp { "?:" TypeOp } ;

// A stdlib infix call - a to b (Pair), a and b / a shl b - binds tighter than elvis
// and looser than +/-, matching Kotlin. All seven are genuine: `to` builds a Pair
// (read via .first/.second), and/or/xor are the non-short-circuit boolean operators
// on two booleans and the int32 bit operations otherwise, shl/shr/ushr are the int32
// shifts. Only these built-in infix names are recognised (not arbitrary user infix
// funs); the names stay usable as identifiers (KwEnd word boundary).
// A USER infix function - `a dot b`, lowered to a.dot(b) - is accepted at the same
// level, after the built-in names. Two guards keep it from swallowing ordinary code:
// SameLine (the operator must sit on the left operand's line, so two statements on
// consecutive lines never join into one infix call - Kotlin's own rule) and NotInfixKw
// (a keyword that can legally follow an expression - else, is, as, in, by, while, ... -
// is never an infix operator).
InfixExpr   <~~ push(makeInfix(takeAll())) ~~>
            = RangeExpr { InfixOp RangeExpr } ;
InfixOp     = ( "to" | "and" | "or" | "xor" | "shl" | "shr" | "ushr" ) <~~ push({iop: up.in}) ~~> KwEnd
            | SameLine NotInfixKw KId <~~ push({uiop: up.in}) ~~> ;
// A zero-width guard that fails when the identifier at the parse position is one of
// the keywords that may follow an expression; without it `a else b`, `x is T` and
// `do { } while (c)` would parse as infix calls.
// The DECLARATION MODIFIERS that are soft keywords are deliberately NOT in the list:
// they are ordinary names, so Kotlin reads `x7 infix x9` and `inline data annotation`
// as infix calls and says so in as many words - psi/annotation/modifiersMigration/
// newModifiers.kt carries the comment `// infix call` on that very line, and
// psi/annotation/at/blockLevelExpressions.txt makes `x6 ?: x7 infix x9 + 10` one
// BINARY_EXPRESSION whose OPERATION_REFERENCE is `infix`. Excluding them split those
// lines into two statements, which NewStmtLine then refused.
// The VISIBILITY modifiers and `get`/`set`/`init`/`constructor`/`companion` stay out of
// infix position: `var x = 0` followed on the SAME line by `private set` is an accessor
// run, and an infix reading would swallow it.
NotInfixKw  = :script(~~
    (function() {
        var kws = ["else", "is", "as", "in", "by", "while", "catch", "finally", "where",
                   "step", "until", "downTo", "to", "and", "or", "xor", "shl", "shr",
                   "ushr", "val", "var", "fun", "if", "for", "do", "when", "try",
                   "throw", "return", "break", "continue", "class", "object", "interface",
                   "get", "set", "init", "constructor", "companion", "private",
                   "public", "protected", "internal",
                   "typealias", "import", "package", "this", "super",
                   "null", "true", "false"]
        var i = 0
        var word = ""
        var cc = c.peek(i)
        while (cc === 32 || cc === 9) { i++; cc = c.peek(i) }   // Whitespace is skipped
        while ((cc >= 97 && cc <= 122) || (cc >= 65 && cc <= 90) || (cc >= 48 && cc <= 57) || cc === 95) {   // by the token AFTER this guard.
            word += String.fromCharCode(cc)
            i++
            cc = c.peek(i)
        }
        for (var k = 0; k < kws.length; k++) {
            if (kws[k] === word) { return abnf.newToken("\x01infix-keyword", 0) }
        }
        return undefined
    })()
~~) ;

// A range expression as a VALUE - a..b, a..<b, a until b, a downTo b, a step b - in
// general operand position ((0 until n).joinToString(...)). The range value itself is
// not modelled (no iterable range object), so a range is not implemented; both bounds
// still run so their calls stay visible. Without a range operator RangeExpr is a pure
// pass-through (its single AddExpr thunk is returned unchanged), so ordinary
// expressions are byte-identical. The for-loop and when(x){ in a..b } forms bind their
// bounds at AddExpr, below this level, so they keep splitting on their own range token.
RangeExpr   <~~ push(makeRange(takeAll(), up.pos)) ~~>
            = AddExpr { RangeInfix AddExpr } ;
RangeInfix  = ( "..<" | ".." "<" ) <~~ push({rop: "..<"}) ~~>
            | ".." <~~ push({rop: ".."}) ~~>
            | KwUntil <~~ push({rop: "until"}) ~~>
            | KwDownTo <~~ push({rop: "downTo"}) ~~>
            | KwStep <~~ push({rop: "step"}) ~~> ;

AddExpr     <~~ push(foldBinary(takeAll())) ~~>
            = MulExpr { ( "+" | "-" ) <~~ push(up.in) ~~> MulExpr } ;

MulExpr     <~~ push(foldBinary(takeAll())) ~~>
            = UnaryExpr { ( "*" | "/" | "%" ) <~~ push(up.in) ~~> UnaryExpr } ;

UnaryExpr   = { Annotation } ( PreIncDec | PreIncRef | Neg | Not | PostfixExpr ) ;
// PREFIX ++x / --x. Kotlin has both fixities and they differ in their VALUE: the postfix
// form yields the old value, the prefix form the new one (`var i = 1; println(++i)`
// prints 2, `println(i++)` prints 1). It must precede Neg, or `--a` reads as a double
// negation - which quietly gives the right answer for a number and never assigns.
PreIncDec   <~~ push(makePreIncDec(takeAll())) ~~>
            = ( "++" | "--" ) <~~ push(up.in) ~~> Target NotDblColon ;
// `++a::b` is a prefix operator applied to a CALLABLE REFERENCE, not to the target `a`
// with a stray `::b` after it - psi/DoubleColon.txt makes it one PREFIX_EXPRESSION over
// a CALLABLE_REFERENCE_EXPRESSION. Target would happily match the `a` and leave the
// `::b` stranded (a PEG never re-enters an alternative that succeeded), so the guard
// declines the assignable reading when a `::` is glued to it and this form takes over.
// A callable reference is not an assignable target, so the value is reported.
PreIncRef   <~~ takeAll(); push(notImplExpr("prefix ++/-- of a callable reference", up.pos)) ~~>
            = ( "++" | "--" ) CallMember ;
NotDblColon = :script(~~
    (function() {
        if (c.peek(0) === 58 && c.peek(1) === 58) { return abnf.newToken("\x01glued-double-colon", 0) }
    })()
~~) ;
Neg         <~~ push(kNegFold(pop(), up.in)) ~~>
            = "-" UnaryExpr ;
Not         <~~ push(makeNot(pop())) ~~>
            = "!" UnaryExpr ;

PostfixExpr = IncDec | CallMember ;
IncDec      <~~ push(makeIncDec(takeAll())) ~~>
            = Target ( "++" | "--" ) <~~ push(up.in) ~~> ;

// Counter(5) is a constructor call, this.m() and list.add() are method calls,
// p.x is a property read, list[i] an indexed read. The ?. variants yield null
// (instead of failing) when their receiver is null. A method call may take a
// trailing lambda - list.map { it * 2 } - which becomes the last argument.
// A trailing "!!" (non-null assertion) is consumed and dropped: for untyped values it
// is the identity, so x!! evaluates exactly like x (and x!!.m() still chains).
CallMember  <~~ push(foldCallMember(takeAll())) ~~>
            = Primary { MethodSfx | SafeMethodSfx | FieldSfx | SafeFieldSfx | IndexSfx | GenericSfx | DotAnonSfx | InvokeSfx | RefSfx | "!!" } ;
// A callable reference or class literal whose RECEIVER is an arbitrary expression:
// `X()::class`, `object {}::class`, `foo()::bar`. CallableRef in Primary covers only a
// dotted NAME on the left (`a.b::c`), so these three lines of psi/DoubleColon.kt had no
// reading at all and the parse died on the `::`. The value is not modelled - a class
// literal has no runtime representation in this subset - so it is reported.
// RefName PUSHES its text, so the tag drains it before pushing the suffix record.
RefSfx      <~~ takeAll(); push({kind: "dotanon", t: notImplExpr("callable reference on an expression", up.pos)}) ~~>
            = "::" RefName ;
MethodSfx   <~~ push({kind:"mcall", name: popName(), args: takeAll()}); retLblPop() ~~>
            = "." KId <~~ push({mname: up.in}); retLblPush(up.in, "lam") ~~> [ SkipAngle ] MArgs ;
SafeMethodSfx <~~ push({kind:"mcall", name: popName(), args: takeAll(), safe: true}); retLblPop() ~~>
            = "?." KId <~~ push({mname: up.in}); retLblPush(up.in, "lam") ~~> [ SkipAngle ] MArgs ;
FieldSfx    = "." KId <~~ push({kind:"field", name: up.in}) ~~> ;
// `receiver.{ ... }` and `receiver.(expr)` - the anonymous-method syntax of very early
// Kotlin. psi/examples/With.kt (`System.out.{ println("foo"); ... }`),
// psi/CallsInWhen.kt (`a.{bar} -> a`) and psi/DoubleColon.kt (`a.(b::c)()`) all record it
// with a clean tree, so it is a SYNTAX this file grammar has to recognise. The construct
// no longer exists in the language and has no defined meaning in this subset, so the body
// is consumed and the step is reported as not implemented rather than guessed at.
// Both spellings may be INVOKED straight away - `System.out.{ ... }()`, `a.(b::c)()` -
// which is how Kotlin's own tree reads them (a CALL_EXPRESSION whose callee is the
// parenthesized or brace-delimited body), so an immediately following argument list is
// part of the step.
DotAnonSfx  <~~ push({kind:"dotanon", t: notImplExpr("anonymous method", up.pos)}) ~~>
            = "." ( SkipBlock | "(" DiscardExpr ")" ) [ SkipParen ] ;
SafeFieldSfx = "?." KId <~~ push({kind:"field", name: up.in, safe: true}) ~~> ;
// An EXPLICIT TYPE ARGUMENT LIST in expression position that is NOT followed by a call:
// `p(qux<a, b>)`, `a.foo<T> -> a` in a when arm, `Foo<out Int>` as a statement. Kotlin
// resolves the `a < b` ambiguity with a continuation/stop-token rule (the same rule Dart
// states verbatim in its own corpus - see docs/abnf-dialect-gotchas.md); InstAhead below
// implements it, and the run itself is parsed and dropped, so the suffix is item-neutral
// and foldCallMember pops exactly what it did before.
GenericSfx  = InstAhead SkipAngle ;
// A zero-width guard deciding whether the `<` at the parse position opens a type
// argument list rather than a comparison. It scans a BALANCED angle run built only of
// type-shaped characters and accepts only when the token AFTER the closing `>` cannot
// follow a comparison's right operand: a stop token ( ) ] } , ; : . ? end of line, end
// of file ) or a continuation token ( ( . == != -> ). `a < b` never reaches a closing
// `>`; `a < b && c > d` bails on the `&`; `f(a < b, c > d)` closes but is followed by
// `d`, so all three keep parsing as comparisons.
InstAhead   = :script(~~
    (function () {
        var i = 0
        var cc = c.peek(0)
        var steps = 0
        // The guard sees RAW input, so the whitespace and comments in front of the `<`
        // are still ahead of the position and have to be stepped over here.
        while (steps < 4000) {
            steps = steps + 1
            if (cc === 32 || cc === 9 || cc === 13 || cc === 10 || cc === 12) { i = i + 1; cc = c.peek(i); continue }
            if (cc === 47 && c.peek(i + 1) === 47) {
                while (cc >= 0 && cc !== 10) { i = i + 1; cc = c.peek(i) }
                continue
            }
            if (cc === 47 && c.peek(i + 1) === 42) {
                i = i + 2
                cc = c.peek(i)
                while (cc >= 0 && !(cc === 42 && c.peek(i + 1) === 47)) { i = i + 1; cc = c.peek(i) }
                if (cc < 0) { return abnf.newToken("\x01unterminated-comment", 0) }
                i = i + 2
                cc = c.peek(i)
                continue
            }
            break
        }
        if (cc !== 60) { return abnf.newToken("\x01no-angle", 0) }
        // An EMPTY run is "Type expected" in Kotlin, not an instantiation: psi/Super.kt
        // spells `super<>.foo()` out as a PsiErrorElement, so the guard must decline it
        // and leave the `<` to the comparison operator that will fail on it.
        if (c.peek(i + 1) === 62) { return abnf.newToken("\x01empty-angle", 0) }
        var depth = 0
        var n = 0
        while (n < 4000) {
            n = n + 1
            cc = c.peek(i)
            if (cc < 0) { return abnf.newToken("\x01eof-in-angle", 0) }
            if (cc === 60) { depth = depth + 1; i = i + 1; continue }
            if (cc === 62) {
                depth = depth - 1
                i = i + 1
                if (depth === 0) { break }
                continue
            }
            // `->` of a function type argument, HashMap<String, () -> Unit>.
            if (cc === 45 && c.peek(i + 1) === 62) { i = i + 2; continue }
            var ok = (cc >= 97 && cc <= 122) || (cc >= 65 && cc <= 90) || (cc >= 48 && cc <= 57)
                  || cc === 95 || cc === 32 || cc === 9 || cc === 13 || cc === 10
                  || cc === 44 || cc === 46 || cc === 63 || cc === 42 || cc === 40 || cc === 41
                  || cc === 58 || cc === 64 || cc === 91 || cc === 93
            if (!ok) { return abnf.newToken("\x01not-a-type", 0) }
            i = i + 1
        }
        if (depth !== 0) { return abnf.newToken("\x01unbalanced-angle", 0) }
        cc = c.peek(i)
        while (cc === 32 || cc === 9) { i = i + 1; cc = c.peek(i) }
        if (cc < 0) { return undefined }
        if (cc === 41 || cc === 93 || cc === 125 || cc === 44 || cc === 59 || cc === 58
            || cc === 46 || cc === 40 || cc === 63 || cc === 10 || cc === 13) { return undefined }
        if (cc === 61 && c.peek(i + 1) === 61) { return undefined }
        if (cc === 33 && c.peek(i + 1) === 61) { return undefined }
        if (cc === 45 && c.peek(i + 1) === 62) { return undefined }
        return abnf.newToken("\x01not-instantiation", 0)
    })()
~~) ;
// Kotlin's index operator is variadic - `a[i, j]` lowers to `get(i, j)` - and its
// argument list takes a trailing comma like every other one (psi/trailingCommaAllowed.kt
// writes `x[ 1, 3 , ]`). Only the ONE-argument form is implemented; a wider one is
// accepted and reported, rather than silently indexing by its first argument.
IndexSfx    <~~ push({kind: "index", idx: kIndexArg(takeAll(), up.pos)}) ~~>
            = "[" Expression { "," Expression } [ "," ] "]" ;
// More than one trailing lambda is a SEMANTIC error in Kotlin, not a syntactic one:
// psi/CallWithManyClosures.kt writes `f() {} {} {}` and `f {} {} {}` and carries a clean
// parse tree. Only the FIRST lambda is passed as an argument (makeCall reads one), which
// is what the single-lambda form already did.
// The argument list must OPEN on the callee's own line. Kotlin's own tree settles this:
// psi/DoubleColon.txt has `a::b.c` followed by a blank line and then `(a::b)()`, and
// records them as TWO statements - a DOT_QUALIFIED_EXPRESSION and a separate
// CALL_EXPRESSION with a PARENTHESIZED callee - not as one call of `c`. Without the
// guard the `(` on the next line is read as this call's arguments, the following `()` is
// then left over, and the parse dies on a `)` two lines below the mistake. A trailing
// LAMBDA is deliberately not guarded: Kotlin does allow it after a line break.
// A trailing lambda may carry ANNOTATIONS, which is also Kotlin's OLD label syntax:
// `x2.filter @f { return 2 }` is a LAMBDA_ARGUMENT whose child is an ANNOTATED_EXPRESSION
// wrapping the lambda (psi/newLabels/oldSyntaxExpressions.txt). Without them the `@f`
// ended the call and the `{ ... }` became a second statement on the same line.
MArgs       = SameLine "(" [ Arg { "," Arg } [ "," ] ] ")" { AnnLambda } | AnnLambda { AnnLambda } ;
// Annotation pushes nothing, so this stays item-neutral: the parent still pops one
// lambda per repetition.
AnnLambda   = { Annotation } Lambda ;

// A call argument: a spread (*array, which splices the array into the positional
// arguments of a vararg parameter), a NAMED argument (name = value, matched against
// the callee's parameter names by kfit) or a plain positional expression. The named
// form has to be tried before the plain one, because `d = 7` would otherwise parse as
// the assignment expression `d = 7`; NotEqSign keeps `a == b` out of it (the `=` of a
// named argument is never followed by another `=`).
Arg         = SpreadArg | NamedArg | Expression ;
SpreadArg   <~~ push({spread: pop()}) ~~>
            = "*" Expression ;
NamedArg    <~~ var v = pop(); push({argname: pop(), av: v}) ~~>
            = KId <~~ push(up.in) ~~> "=" NotEqSign Expression ;

// RawStr before Template (both open with "), KHexLit/KBinLit before FloatLit/KIntLit
// (0x/0b prefixes), FloatLit before KIntLit (a plain integer falls through),
// AnonFun/CallableRef before Call/VarRef (they would otherwise eat the leading
// identifier). AnonFun and qualified callable references are recognised, not run.
// IfExpr/WhenExpr/TryExpr live here (before Call/VarRef, which would read the `if`/
// `when`/`try` keyword as an identifier) as their ONLY expression home, so each is a
// primary: it can be an operand - a + if (c) x else y, "n=" + when (k) { ... } - AND
// take a postfix chain - when (x) { ... }.also { ... }, try { ... }.getOrNull(). The
// else/arm bodies are full Expressions, so `if (c) a else b + 1` still binds b + 1 as
// the else. A leading `if` at statement level is the If statement (matched before
// ExprStmt); a leading `when` is this expression form.
Primary     = CollectionLit | ParenApply | "(" Expression ")" | RawStr | Template | KHexLit | KBinLit | DotFloatLit | FloatLit | KIntLit | CharLit | True | False | Null | Lambda | AnonFun | CallableRef | ObjectExpr | DeclExpr | IfExpr | WhenExpr | TryExpr | ThrowExpr | ReturnAtExpr | BreakAtExpr | ContinueAtExpr | ReturnExpr | BreakExpr | ContinueExpr | ThisExpr | SuperExpr | LabeledPrim | Call | VarRef ;

// `throw e` in EXPRESSION position - a Nothing-typed expression body
// (fun bail(msg: String): Nothing = throw AppError(msg)) or the body of a when arm.
// It raises the exception exactly like the statement form and never yields a value.
// A class or interface DECLARATION in operand position. Kotlin's parser builds one -
// psi/recovery/InterfaceInExpressionPosition.kt makes `val p = 1 < interface I { fun f()
// {} }` a binary expression whose right operand is a CLASS, and
// psi/recovery/binaryExpression/SoftModifierAsInfixFunction.kt makes
// `val x = @Ann() class C annotation y` a BINARY_EXPRESSION whose LEFT operand is a
// CLASS and whose operator is the soft keyword `annotation`. Both trees are clean, so
// this is recovery Kotlin's parser performs rather than an error. The SKIP forms are
// used because there is nothing to attach a built declaration to here, and the value the
// operand yields is reported as unsupported.
DeclExpr    <~~ takeAll(); takeMods(); push(notImplExpr("declaration in expression position", up.pos)) ~~>
            = ClassSkip | InterfaceSkip ;
ThrowExpr   <~~ push(excThrow(pop())) ~~>
            = KwThrow Expression ;

// `return`, `break` and `continue` in EXPRESSION position - `val v = map[k] ?: return`,
// `val line = it.next() ?: break`. Each is Nothing-typed: it never yields a value, it
// transfers control out of the whole surrounding expression. An interpreter cannot do
// that by RETURNING a signal (the enclosing operator would fold the signal as if it
// were a value), so each RAISES one instead. `return` raises the same __nlret marker a
// non-local return already uses, which every function frame catches through nlrRun;
// break/continue raise a __kloop marker that kLoopBody turns back into the ordinary
// BRK / CONT the statement forms return.
// NotAtLbl declines the labelled spellings (return@loop, break@outer): those name a
// target this form does not model, and the statement-level ReturnAt / BreakAt /
// ContinueAt productions own them. Without the guard `x ?: return@forEach true` would
// match `return` here and leave the `@forEach` behind as a wrong parse.
// The LABELLED spellings in expression position - psi/SimpleExpressions.kt puts
// `break@la` and `continue@la` in a parameter default with a clean tree. break@l and
// continue@l raise the label with the marker, and kLoopBody hands loopSignal exactly the
// {brkL} / {contL} record makeBreakTo / makeContinueTo return, so a label naming an OUTER
// loop still travels out through the inner one. `return@l` is genuine only when `l` is
// the DIRECTLY enclosing function's name (kReturnAtExpr checks the walk-time retLabels
// stack, as makeReturnAt does); a lambda's label would need the lambda body itself to
// catch the marker, which it does not, so that case stays not implemented rather than
// returning from the wrong frame.
ReturnAtExpr <~~ push(kReturnAtExpr(takeAll(), up.pos)) ~~>
            = KwReturn AtAdjacent "@" KId <~~ push({rlbl: up.in}) ~~> [ SameLine Expression ] ;
BreakAtExpr <~~ push(kBreakAtExpr(pop().lbl)) ~~>
            = KwBreak AtAdjacent "@" KId <~~ push({lbl: up.in}) ~~> ;
ContinueAtExpr <~~ push(kContinueAtExpr(pop().lbl)) ~~>
            = KwContinue AtAdjacent "@" KId <~~ push({lbl: up.in}) ~~> ;
ReturnExpr  <~~ push(kReturnExpr(takeAll())) ~~>
            = KwReturn NotAtLbl NoSpacedAt [ SameLine Expression ] ;
BreakExpr    <~~ push(kBreakExpr()) ~~>    = KwBreak NotAtLbl NoSpacedAt ;
ContinueExpr <~~ push(kContinueExpr()) ~~> = KwContinue NotAtLbl NoSpacedAt ;
// A LABEL on an ordinary operand - `1 + label3@ 3 + 4`, `l1@ foo bar l2@ baz`. Kotlin's
// own tree (psi/newLabels/basic.txt) records each as a LABELED_EXPRESSION wrapping the
// operand, so the label binds at the PRIMARY level, not at the statement level. A label
// only names something on a loop (statement-level Labeled) or a lambda (LamLabel); on an
// ordinary operand it names nothing, so it is consumed and dropped and the operand is its
// own value - which is what the tree says too.
LabeledPrim <~~ var t = pop(); pop(); push(t) ~~>
            = LabelDef Primary ;
NotAtLbl    = :script(~~
    (function() {
        return (c.peek(0) === 64) ? abnf.newToken("\x01labelled", 0) : undefined
    })()
~~) ;

// `super` as the receiver of a member access - super.describe(). It evaluates to a
// {__superref, self, cls} marker naming the SUPERCLASS of the class whose body is
// being walked (curClassTop), so the member lookup starts one level up while `this`
// stays the same instance.
// The qualifier is `super<Base>`; an EMPTY `super<>` is "Type expected" in Kotlin
// (psi/Super.kt), so the angle run must hold at least one item.
SuperExpr   <~~ push(makeSuperRef(curClassTop())) ~~>
// `super<Base>@Outer` names one supertype of one outer receiver. The type argument was
// already skipped; the label was not, so psi/DoubleColon.kt's `super<a>@b::foo` had no
// reading. The `@` is glued to the qualifier, like every other label in Kotlin, so
// AtAdjacent keeps a following ANNOTATION (`super @Ann`) out of it.
            = "super" KwEnd [ SkipAngle1 ] [ AtAdjacent "@" KId ] ;
SkipAngle1  = "<" ( SkipAngle | "->" | SkipAngleItem ) { SkipAngle | "->" | SkipAngleItem } ">" ;

// try { ... } catch (e) { ... } used as an EXPRESSION (val x = try { ... } catch ...,
// or an expression-body function fun f() = try { ... } catch ...). The try/catch/finally
// bodies genuinely run with exception handling (the same excTry the statement form uses),
// so their calls stay visible, but the VALUE of the try-expression is not modelled (a
// statement block yields a control signal, not its last-expression value): it is reported
// as not implemented and evaluates to a placeholder. Must precede Call/VarRef so `try`
// is not read as an identifier.
TryExpr     <~~ push(kTryExpr(takeAll())) ~~>
            = KwTry VTryBody { VCatch } [ VFinally ] ;
VTryBody    <~~ push({vtry: pop()}) ~~>
            = ValueBlock ;
// The catch clauses of a try EXPRESSION are type-discriminated: the first clause whose
// declared type matches the thrown value wins (a clause without a type catches
// anything), which is what a `catch (e: AppError) ... catch (e: Exception)` pair needs.
VCatch      <~~ push(kCatchClause(takeAll())) ~~>
            = KwCatch "(" KId <~~ push({vcname: up.in}) ~~> [ ":" VCatchType ] [ "," ] ")" ValueBlock ;
VCatchType  <~~ push({vctype: pop()}) ~~>
            = TypeName ;
VFinally    <~~ push({vfin: pop()}) ~~>
            = KwFinally ValueBlock ;

// An anonymous object expression - object [: Supertypes] { members } - in value
// position, e.g. passed as an argument (object : IHasComponent<Navigator> { ... }).
// GENUINE: each evaluation builds a fresh instance whose descriptor holds the
// methods and whose fields are the initialized properties. Methods and property
// initializers see the expression site's scope chain (a real closure, like a
// lambda) plus the new object as `this`. Supertypes are parsed and ignored (no
// inheritance; passing the object where an interface is expected still works
// because method calls dispatch by name). A body outside the member subset falls
// back to ObjectExprSkip (notImplemented). Must precede Call/VarRef, which would
// otherwise read `object` as an identifier.
ObjectExpr  = ObjectExprReal | ObjectExprSkip ;
// The header pieces after `object` - type parameters, a visibility modifier and a
// constructor parameter list - are all SEMANTIC errors on an object expression, never
// syntactic ones: psi/recovery/objects/expressions/Everything.txt records
// `object<T, R> private (x: Int, y: Int) : Bar, Baz { ... }` with no PsiErrorElement at
// all. They are parsed and dropped (an object expression has no type parameters and no
// constructor to give them to).
ObjectExprReal <~~ push(makeObjectExpr(takeAll())) ~~>
            = KwObject [ SkipAngle ] [ ObjVis ] [ CtorParamsSkip ] [ ":" SuperList ] "{" { Member } "}" ;
ObjectExprSkip <~~ push(notImplExpr("object expression", up.pos)) ~~>
            = KwObject [ SkipAngle ] [ ObjVis ] [ CtorParamsSkip ] [ ":" SuperList ] SkipBlock ;
ObjVis      = ( "private" | "protected" | "internal" | "public" ) KwEnd ;

// A labelled receiver - this@Outer11. It walks out from the innermost `this` along the
// __outer chain an inner class instance carries until it reaches an instance whose
// class is named by the label, so an inner class can read the enclosing instance.
// Bare `this` is a plain VarRef; this rule must precede Call/VarRef so `this` is not
// read as an identifier before the `@Label` is seen.
ThisExpr    <~~ push(makeThisAt(pop())) ~~>
            = "this" KwEnd "@" KId <~~ push(up.in) ~~> ;

// A lambda: { it * 2 }, { x -> x * 2 }, { a: Int, b: Int -> a + b }. The body is
// one expression; without parameters the single argument is bound to 'it'.
// A lambda may carry an explicit label - exec06 lab@{ ... }, which names the target of
// a return@lab inside it. The label is pushed onto the walk-time retLabels stack the
// moment it is seen (before the body walks), so a return@lab inside resolves against
// it rather than against the callee name the enclosing Call pushed; makeLambda pops it
// again. Tags run while the parse tree is walked, so the optional prefix needs no
// rollback care.
Lambda      <~~ push(makeLambda(takeAll())) ~~>
            = [ LamLabel ] "{" [ LambdaParams ] { LamStmt } "}" ;
LamLabel    = KId <~~ push({lamlbl: up.in}); retLblPush(up.in, "lam") ~~> AtAdjacent "@" ;
// A { ... } in value position (an if / when arm) is a BLOCK, not a lambda: it runs its
// statements in a fresh scope and its value is the last expression (Unit if it ends in a
// statement). Tried before a plain Expression in those arms; a real lambda ({ x -> ... })
// has parameters, so it fails ValueBlock and falls through to Lambda.
ValueBlock  <~~ push(makeValueBlock(takeAll())) ~~>
            = "{" { LamStmt } "}" ;
// A lambda body is a sequence of statements whose value is its last expression
// (a single expression is the common case). Genuinely lowered, not notImpl.
// A leading annotation (runCatching { @Suppress("DEPRECATION") val x = ... }) is
// parsed and ignored, exactly as at the top statement level; keyword-led statements
// first; then an if/else whose arms are expressions (an IfExpr keeps its value); then
// any REMAINING if statement - a bare `if (c) s` must be consumed here, BEFORE LamExpr,
// which would otherwise read the keyword `if` as an identifier (`if (c)` parses as the
// call if(c)) and only fail at run time; then any expression; then an empty statement.
LamStmt     = { Annotation } ( LamCtrl | LamIfValue | LamIf | LamExpr ) | ";" ;
LamCtrl     <~~ push({stmt: pop()}) ~~>
            = ReturnAt | Return | BreakAt | Break | ContinueAt | Continue
            | Labeled | LocalTypeDecl | LocalExtFun | LocalFun | Destructure | Decl | BareDecl | While | Do | For | TryStmt | Throw ;
LamIfValue  <~~ push({expr: pop()}) ~~>
            = IfExpr ;
LamIf       <~~ push({stmt: pop()}) ~~>
            = If ;
LamExpr     <~~ push({expr: pop()}) ~~>
            = Expression [ ";" ] ;
LambdaParams <~~ push({lparams: takeAll()}) ~~>
            = [ LParam ] { "," [ LParam ] } "->" ;
// A lambda parameter is a plain name or a destructuring pattern - { (a, b) -> ... }
// over a Pair/data-class/Triple argument. Destructuring is recognised but not lowered
// (like a val destructuring declaration): the names bind to undefined and makeLambda
// warns once, so the lambda still parses and runs under -warn-unsupported.
LParam      = { Annotation } ( DestructLParam | KId <~~ push(up.in) ~~> [ ":" Type ] ) ;
DestructLParam <~~ push({destruct: takeAll(), pos: up.pos}) ~~>
            = ( "(" DNameKwV { "," DNameKwV } [ "," ] ")" | "[" DNameKwV { "," DNameKwV } [ "," ] "]"
              | "(" DName { "," DName } [ "," ] ")" | "[" DName { "," DName } [ "," ] "]" ) [ ":" Type ] ;
// No `val` / `var` on an entry. Kotlin's name-based destructuring forbids it in every
// position - declaration, for-loop and lambda parameter - and
// psi/destructuring/fullNameBasedDestructuringErrors.kt records each of
// `val (val first, var second,) = x`, `for ((first, val second) in x)` and
// `foo { (var first) -> }` as a syntax error ("Expecting ')'", "Expecting a name").
DName       <~~ push(dName(takeAll())) ~~>
            = KId <~~ push(up.in) ~~> [ ":" Type ] [ "=" KId <~~ push({dfrom: up.in}) ~~> ] ;
// The two KEYWORD-carrying entry forms. DNameKw takes val or var and is what the
// SHORT declaration form `(val first, var second) = x` is made of; DNameKwV takes only
// `val`, which is what a for-loop and a lambda parameter allow (`for ((var first) in x)`
// and `foo { (var first) -> }` are both errors in
// psi/destructuring/fullNameBasedDestructuringErrors.kt, while
// `for ((val key, val value) in l)` in variableNamedValueInSquareBrackets.kt is clean).
DNameKw     <~~ push(dName(takeAll())) ~~>
            = ( "val" | "var" ) KwEnd KId <~~ push(up.in) ~~> [ ":" Type ] [ "=" KId <~~ push({dfrom: up.in}) ~~> ] ;
DNameKwV    <~~ push(dName(takeAll())) ~~>
            = "val" KwEnd KId <~~ push(up.in) ~~> [ ":" Type ] [ "=" KId <~~ push({dfrom: up.in}) ~~> ] ;

// f(a, b): a top level function, a builtin, or a class constructor. A trailing lambda
// becomes the last argument (Kotlin): after a parenthesized list - f(a) { ... } - or on
// its own - f { ... } (the sole argument, e.g. module { single { ... } }). Either form
// works as a Primary anywhere, including as an argument to an outer call
// (modules(module(createdAtStart = true) { ... }, module { ... }, ...)).
Call        <~~ push(makeCall(takeAll())); retLblPop() ~~>
            = KId <~~ push(up.in); retLblPush(up.in, "lam") ~~> [ TypeArgs ] ( SameLine "(" [ Arg { "," Arg } [ "," ] ] ")" { Lambda } | Lambda { Lambda } ) ;
// The explicit type arguments of a call - tag17<String>(x) - kept so that a reified
// type parameter inside the callee resolves to the real type name.
TypeArgs    <~~ push({targs: up.in}) ~~>
            = SkipAngle ;

// String templates: "x=$x sum=${a + b}".
Template    <~~ push(makeTemplate(takeAll())) ~~>
            = '"' :whitespace() { TplExpr | TplVar | TplChunk } '"' :whitespace(Whitespace) ;
TplExpr     <~~ push({e: pop()}) ~~>
            = "${" :whitespace(Whitespace) Expression "}" ;
// The SHORT entry is a simple name, and a hard keyword is not one: `"$try"` is
// "Keyword cannot be used as a reference" in Kotlin
// (psi/stringTemplates/StringTemplateWithTryWithoutBlockInShortEntry.kt), and the long
// `"${try { … } catch …}"` form is what that file's neighbours use instead. `$` is not
// in TplPlain, so a refused TplVar cannot fall through to TplChunk and the whole
// template - and with it the file - is refused, which is the point.
// NotHardKw is the same guard KId uses; it leaves `this` and `super` alone, so `"$this"`
// keeps working.
TplVar      = "$" NotHardKw TplName <~~ push({e: makeVarRef(up.in)}) ~~> ;
TplName     = ( "a"..."z" | "A"..."Z" | "_" ) { "a"..."z" | "A"..."Z" | "0"..."9" | "_" } ;
TplChunk    <~~ push({s: unescapeJs(up.in)}) ~~>
            = TplChar { TplChar } ;
TplChar     = TplEsc | TplPlain ;
TplEsc      = "\\" "\x20"..b"\x7e" ;
// The tab, the vertical tab and the form feed are the control characters a Kotlin
// string may carry literally (the lexer's whitespaceCharacters test data lexes all
// three into REGULAR_STRING_PART); a bare newline or carriage return is not - it ends
// the literal, which is why they stay out of the set.
TplPlain    = "\x20"..."\x21" | "\x23"..."\x23" | "\x25"..."\x5b" | "\x5d"..."\x7e" | @"\t\x0b\x0c" | "\x7f"..."\U0010ffff" ;

// CALLING a parenthesized expression - `(f)()`, `(f) {} {} {}`, `(a::b)()`
// (psi/CallWithManyClosures.txt and psi/DoubleColon.txt both record these with clean
// trees). `f()` and `f { }` are matched by Call, which is keyed on a NAME; once the
// callee is an arbitrary expression there is no name, so the call becomes a SUFFIX of
// the member chain and the value in hand is invoked. It is confined to a parenthesized
// seed on purpose: a general trailing-lambda suffix on every primary would read
//     val x = y
//     { ... }
// as `y { ... }`, which is a wrong parse with no error anywhere.
ParenApply  <~~ push(foldCallMember(takeAll())) ~~>
            = ParenSeed InvokeLike { InvokeLike } ;
ParenSeed   = "(" Expression ")" ;
InvokeLike  = InvokeSfx | TrailLamSfx | GenericSfx ;
// SameLine, for the reason MArgs carries it: psi/DoubleColon.txt records a `(` that
// OPENS a line as a new statement, not as the previous expression's argument list.
InvokeSfx   <~~ push({kind:"invoke", args: takeAll()}) ~~>
            = SameLine "(" [ Arg { "," Arg } [ "," ] ] ")" { AnnLambda } ;
TrailLamSfx <~~ push({kind:"invoke", args: takeAll()}) ~~>
            = AnnLambda { AnnLambda } ;
// A collection literal, [1, 2]. Kotlin allows it only as an annotation argument (the
// spelling of an array constant); it is lowered to a list, which is how this subset
// models an array anyway.
// An argument slot may not be EMPTY: `f(1, ,)`, `@Ann(,)` and `[1, , 3]` are
// "Expecting an argument" / "Expecting an index element" in Kotlin
// (psi/emptyArgumentsInAnnotations.txt, psi/emptyArgumentsInArrayAccesses.txt), and the
// old spelling `[ Arg ] { "," [ Arg ] }` accepted every one of them. A TRAILING comma is
// real Kotlin and stays. The compiler half's CallArgs / CollLit were already in this
// shape, so this also converges the two.
CollectionLit <~~ push(makeListLit(takeAll())) ~~>
            = "[" [ Expression { "," Expression } [ "," ] ] "]" ;

Null        <~~ push(makeConst(null)) ~~>  = "null" KwEnd ;

VarRef      <~~ push(makeVarRef(up.in)) ~~>
            = KId ;

// ----- Widened surface: constructs accepted structurally but not lowered -----

// A balanced { ... } body consumed without interpreting it, so a construct can be
// ACCEPTED without being understood. Full string/char literals and ${...} templates
// are matched first, so braces inside them are never miscounted. No tags: nothing is
// pushed, so the consuming production is free to push its own placeholder.
SkipBlock   = "{" { SkipItem } "}" ;
SkipItem    = SkipStr | SkipChar | SkipBlock | SkipOther ;
SkipStr     = '"' :whitespace() { SkipTpl | SkipStrEsc | SkipStrChar } '"' :whitespace(Whitespace) ;
SkipTpl     = "${" :whitespace(Whitespace) { SkipItem } "}" ;
SkipStrEsc  = "\\" "\x00"..."\U0010ffff" ;
SkipStrChar = "\x00"..."\x21" | "\x23"..."\x5b" | "\x5d"..."\U0010ffff" ;
SkipChar    = "'" :whitespace() { SkipChEsc | SkipChChar } "'" :whitespace(Whitespace) ;
SkipChEsc   = "\\" "\x00"..."\U0010ffff" ;
SkipChChar  = "\x00"..."\x26" | "\x28"..."\x5b" | "\x5d"..."\U0010ffff" ;
SkipOther   = "\x00"..."\x21" | "\x23"..."\x26" | "\x28"..."\x7a" | "\x7c" | "\x7e"..."\U0010ffff" ;

// A balanced < ... > run (generic parameters / arguments), parsed and ignored.
// A `->` inside the run is matched as ONE token before the item alternative gets to
// see its `-`, so a function type among the arguments - HashMap<String, () -> Unit>,
// <T3 : (Int) -> Int> - does not have its arrow's `>` mistaken for the closing angle.
SkipAngle   = "<" { SkipAngle | "->" | SkipAngleItem } ">" ;
SkipAngleItem = "\x00"..."\x3b" | "\x3d" | "\x3f"..."\U0010ffff" ;

// A balanced ( ... ) run (used to skip an anonymous function's parameter list, which
// may hold nested parens from function types). No tags: nothing is pushed.
SkipParen   = "(" { SkipParen | SkipParenItem } ")" ;
SkipParenItem = "\x00"..."\x27" | "\x2a"..."\U0010ffff" ;

// A statement label (loop@, outer@): the Labeled wrapper offers the name to
// the labelled loop and absorbs a matching labelled break (see makeLabeled).
// break@l / continue@l jump to the loop labelled l. return@l is genuine when l
// names the INNERMOST enclosing lambda's implicit label (the callee name: forEach
// in list.forEach { return@forEach v }) or the directly enclosing function (then
// it is a plain return); the walk-time retLabels stack decides (see makeReturnAt).
// A NON-LOCAL labelled return (an outer lambda's label) stays not implemented.
// The DEFINING half of the same one-token rule: `loop@ while (...)`. The `@` has to be
// glued to the name here for exactly the reason AtAdjacent exists on the reference
// side, and without the guard the `"@"` token skipped the whitespace in front of it
// (docs/abnf-dialect-gotchas.md, `!"literal"` skips leading whitespace - a plain token
// does too). That made LabelDef match ACROSS a space, so `abstract @a class F {}` was
// read as the label `abstract@` on the statement `a`, leaving `class F {}` as a second
// statement on the same line. Kotlin lexes `abstract` as a modifier and `@a` as an
// annotation there; its tree for psi/LocalDeclarations.kt and for
// psi/newLabels/oldSyntaxExpressions.kt records both files as ONE declaration per line.
LabelDef    = KId <~~ push({lbl: up.in}) ~~> AtAdjacent "@" ;
BreakAt     <~~ push(makeBreakTo(pop().lbl)) ~~>
            = KwBreak AtAdjacent "@" KId <~~ push({lbl: up.in}) ~~> [ ";" ] ;
ContinueAt  <~~ push(makeContinueTo(pop().lbl)) ~~>
            = KwContinue AtAdjacent "@" KId <~~ push({lbl: up.in}) ~~> [ ";" ] ;
ReturnAt    <~~ push(makeReturnAt(takeAll(), up.pos)) ~~>
            = KwReturn AtAdjacent "@" KId <~~ push({rlbl: up.in}) ~~> [ SameLine Expression ] [ ";" ] ;
// A zero-width guard that fails unless the VERY NEXT character is `@`, with no
// whitespace in between. Kotlin's label reference is one token: `break@loop` is a
// labelled break, `break @loop` is a break followed by a dangling annotation and is
// rejected (psi/newLabels/spaceBeforeLabelReference). Written as a guard rather than
// with :whitespace() so that a failing alternative cannot leak the whitespace setting.
AtAdjacent  = :script(~~
    (function() {
        return (c.peek(0) === 64) ? undefined : abnf.newToken("\x01need-adjacent-at", 0)
    })()
~~) ;
// The other half of the same rule, and the one that makes the file REJECT rather than
// merely mis-parse. AtAdjacent only declines the labelled alternative; the bare
// `break` / `continue` / `return` then matches and the stranded `@l1` is read as an
// ANNOTATION on the next declaration, so `break @l1` parsed clean. Kotlin's parser
// reports "There should be no space or comments before '@' in label reference"
// (psi/newLabels/spaceBeforeLabelReference.kt) for every one of `break @l1`,
// `return @l2 1`, `continue @l4 5`, `break/**/@l5` and `return//\n@l7 4` - so a `@`
// reachable from a control keyword across whitespace OR comments is an error, not an
// annotation. This guard therefore does the full skip (spaces, tabs, CR, LF, form
// feed, `//` to end of line and `/* */`) the way a refusing guard must, and fails the
// unlabelled alternative outright.
NoSpacedAt  = :script(~~
    (function() {
        var i = 0
        var steps = 0
        while (steps < 100000) {
            steps++
            var ch = c.peek(i)
            if (ch === 32 || ch === 9 || ch === 10 || ch === 13 || ch === 12) { i++ }
            else if (ch === 47 && c.peek(i + 1) === 47) {
                i = i + 2
                var d = c.peek(i)
                while (d >= 0 && d !== 10 && steps < 100000) { steps++; i++; d = c.peek(i) }
            }
            else if (ch === 47 && c.peek(i + 1) === 42) {
                i = i + 2
                var e = c.peek(i)
                while (e >= 0 && steps < 100000) {
                    steps++
                    if (e === 42 && c.peek(i + 1) === 47) { i = i + 2; break }
                    i++
                    e = c.peek(i)
                }
            }
            else { break }
        }
        if (c.peek(i) === 64) { return abnf.newToken("\x01spaced-label-ref", 0) }
        return undefined
    })()
~~) ;

// A floating-point literal (1.5, 2.0f, 1e9, 3.14E-2, digit-group underscores):
// a genuine double value (parseFloat stops before the f/F suffix). Comparisons
// are exact; see the arithmetic note at the core config for the int-wrap caveat.
FloatLit    <~~ push(makeConst(kFlo(parseFloat(up.in.split("_").join(""))))) ~~>
            = ( "0" | "1"..."9" ) :whitespace() { "0"..."9" | "_" }
              ( "." "0"..."9" { "0"..."9" | "_" } [ FloatExp ] [ FloatSfx ]
              | FloatExp [ FloatSfx ]
              | FloatSfx ) :whitespace(Whitespace) ;
FloatExp    = ( "e" | "E" ) [ "+" | "-" ] "0"..."9" { "0"..."9" | "_" } ;
// A float literal written without its integer part (.5, .1_1). Only reachable at the
// start of an operand, where a lone `.` cannot mean anything else.
DotFloatLit <~~ push(makeConst(kFlo(parseFloat("0" + up.in.split("_").join(""))))) ~~>
            = "." :whitespace() "0"..."9" { "0"..."9" | "_" } [ FloatExp ] [ FloatSfx ] :whitespace(Whitespace) ;
FloatSfx    = "f" | "F" ;

// Integer literal forms beyond the plain decimal IntLit: hex, binary, digit-group
// underscores and the L / u / U / uL / UL suffixes. Each tag DROPS the constant the
// shared NumInt / NumHex / NumBin pushed (a JS double, which already rounds
// 9223372036854775807) and rebuilds the literal from its own text, so kIntLit sees
// the digits exactly and can type the literal by its suffix AND its value.
// The suffix is matched with whitespace OFF, so `1 L` stays an Int followed by a name.
KHexLit     <~~ pop(); push(makeConst(kIntLit(up.in))) ~~>
            = NumHex :whitespace() [ IntSfx ] :whitespace(Whitespace) ;
KBinLit     <~~ pop(); push(makeConst(kIntLit(up.in))) ~~>
            = NumBin :whitespace() [ IntSfx ] :whitespace(Whitespace) ;
KIntLit     <~~ pop(); push(makeConst(kIntLit(up.in))) ~~>
            = NumInt :whitespace() [ IntSfx ] :whitespace(Whitespace) ;
IntSfx      = ( "u" | "U" ) [ "l" | "L" ] | "l" | "L" ;

// A character literal. Char is its own value type - a boxed {__char: code} - so it
// prints and concatenates as the CHARACTER ("a" + 'b' == "ab", "$ch" renders the
// glyph) while every arithmetic and comparison operator unboxes it to its code, which
// keeps 'A' + 1 == 'B', 'z' > 'a' and 'a'..'c' working exactly as in Kotlin.
CharLit     <~~ push(makeConst(kChar(kCharCode(up.in)))) ~~>
            = "'" :whitespace() CharBody "'" :whitespace(Whitespace) ;
CharBody    = "\\" ( "u" NumHexDig NumHexDig NumHexDig NumHexDig | CharEsc ) | CharPlain ;
CharEsc     = "n" | "t" | "r" | "b" | "'" | '"' | "\\" | "$" | "0" ;
CharPlain   = "\x09" | "\x0b"..."\x0c" | "\x20"..."\x26" | "\x28"..."\x5b" | "\x5d"..."\U0010ffff" ;

// A triple-quoted raw string: content up to the closing """ (internal runs of one
// or two quotes are allowed), kept verbatim - no escape processing - with genuine
// $name / ${expr} interpolation (same maker as Template). A $ directly after an
// internal quote is consumed as raw text (exotic corner, kept simple).
RawStr      <~~ push(makeTemplate(takeAll())) ~~>
            = '"""' :whitespace() { TplExpr | TplVar | RawChunk } RawClose :whitespace(Whitespace) ;
// A raw string ends at the LAST """ of a run of quotes, so the extra quotes in
// psi/stringTemplates/RawStringsWithManyQuotes.kt (""""""" is the one-character string
// ") belong to the CONTENT. RawChunk cannot take a quote that is glued to the
// terminator, so the closer absorbs the surplus itself and pushes it back as text; the
// ordered choice tries the longer reading first and falls back to the bare terminator.
RawClose    = RawCloseQ RawClose | '"""' ;
RawCloseQ   <~~ push({s: up.in}) ~~> = '"' ;
RawChunk    <~~ push({s: up.in}) ~~>
            = ( RawTwoQ | RawOneQ | RawPlain ) { RawTwoQ | RawOneQ | RawPlain } ;
RawPlain    = "\x00"..."\x21" | "\x23"..."\x23" | "\x25"..."\U0010ffff" ;
RawOneQ     = '"' ( "\x00"..."\x21" | "\x23"..."\U0010ffff" ) ;
RawTwoQ     = '"' '"' ( "\x00"..."\x21" | "\x23"..."\U0010ffff" ) ;

// A callable reference. A bare ::fn is genuine: top-level functions and builtins are
// already first-class closures, so ::fn evaluates like the name itself (stored, passed
// as a lambda, called later). A QUALIFIED reference binds the receiver: recv::member
// yields a property reference {__propref, obj, name} - readable through .isInitialized
// (the lateinit test), callable through .invoke(), and otherwise the bound member.
CallableRef = BareClassRef | BareRef | QualRef ;
// A RECEIVERLESS class literal, `::class` (psi/DoubleColon.kt line 40, clean tree). It
// names the class of the implicit receiver, which this subset does not model, so it is
// recognised and reported rather than guessed at. It must precede BareRef, whose KId
// cannot match the `class` keyword anyway - the ordering is what keeps the two apart if
// KId ever widens.
BareClassRef <~~ push(notImplExpr("receiverless class literal", up.pos)) ~~>
            = "::" "class" KwEnd ;
BareRef     = "::" KId <~~ push(makeBareRef(up.in)) ~~> ;
// A TYPE-qualified reference - String::length - is a different construct: it is a
// KProperty1 over an unbound receiver, which this interpreter does not implement, and
// the compiler half routes it to notImplExpr. The two are told apart only at run time,
// by whether the base name resolves to a value, so makePropRef makes that test itself
// rather than evaluating the base unconditionally (which aborted with "unknown name:
// String" before the not-implemented path could warn).
// A NULLABLE receiver is allowed in front of the `::` - `X?::x`, `X ?:: x`, `X? ?:: x`,
// `X ??:: x`, `X ?? :: x`. All five are CALLABLE_REFERENCE_EXPRESSIONs in Kotlin's own
// tree (psi/greatSyntacticShift/nullableTypes.txt), differing only in where the QUEST
// tokens sit, and none of them is a syntax error. The `?`s belong to the receiver TYPE,
// which this form drops anyway, so they are consumed and ignored.
// This has to be matched at the Primary level, before Elvis gets to see the `?:` of
// `a?::b` as its own operator.
QualRef     <~~ var n = pop(); push(makePropRef(pop(), n, up.pos)) ~~>
            = QualRefBase [ "?" ] [ "?" ] "::" RefName ;
