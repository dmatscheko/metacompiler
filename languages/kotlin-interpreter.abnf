            } else if (Array.isArray(add)) {
                for (i = 0; i < add.length; i++) { if (kIsPair(add[i])) { kMapPut(pm, add[i].first, add[i].second) } }
            } else if (kIsPair(add)) { kMapPut(pm, add.first, add.second) }
