        var u = kUns(l, r)
        if (w == 32 && !u) { return kArith32(op, szNum(kNumD(l)) | 0, szNum(kNumD(r)) | 0) }
        var la = kSz(l, w, u)
        var lb = kSz(r, w, u)
        if ((op == "/" || op == "%") && i64IsZero(lb.p)) { kThrowExc("ArithmeticException", "/ by zero") }
        return kNorm(szPair(szArith(op, la, lb)), w, u)
