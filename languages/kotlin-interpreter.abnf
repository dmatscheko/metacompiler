    function makeMemberExtGetter(body) {
        return function() {
            var argv = arguments
            var saved = scopes
            scopes = [globalScope, {}]
            declVar("this", argv[1])
            declVar("__dispatch", argv[0])
            var r = anytype
            try { r = nlrRun(body) } finally { scopes = saved }
            return (r != undefined && r.isRet) ? r.v : undefined
