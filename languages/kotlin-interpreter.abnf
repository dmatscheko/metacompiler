            // here, so the qualified spelling matched nothing and the `is` branch of an
            // ordinary `when (this)` over a sealed class silently fell through to the
            // else (both halves; the compiled twin is the js_ktis wrapper in
            // abnf/jsrtkotlin.go). Dropping the qualifier is the same convention the
            // rest of this subset already applies to packages and imports.
            var segs = t.split(".")
            if (segs.length > 1) { return clsNamed(v.__class, segs[segs.length - 1]) }
            return false
        }
        return rtIsType(v, t)
    }

    // ----- Exceptions declared in the program -----
    // The builtin throwable hierarchy: a class whose supertype list names one of these
    // gets `message` from it, so `catch (e: Exception) { e.message }` works.
    function installThrowables() {
        // The REAL java.lang throwable chain, which is Kotlin/JVM's: every builtin used
        // to be parented directly to Throwable, so `IllegalStateException("z") is
        // Exception` answered FALSE here while the compiled half - whose ktExcHierarchy
        // in abnf/jsrtkotlin.go always chained properly - answered true. The shape below
        // was checked against java (JDK 24) with instanceof, class by class.
        // Order matters: a parent must be installed before its children, because
        // resolveParents looks the name up in globalScope.
        var names = ["Throwable", "Exception", "Error", "RuntimeException",
                     "IllegalArgumentException", "IllegalStateException",
                     "IndexOutOfBoundsException", "NullPointerException",
                     "UnsupportedOperationException", "ArithmeticException",
                     "NoSuchElementException", "ConcurrentModificationException",
                     "ClassCastException", "NumberFormatException",
                     "IllegalAccessException", "StackOverflowError", "OutOfMemoryError",
                     "NotImplementedError", "UninitializedPropertyAccessException"]
        var supers = ["", "Throwable", "Throwable", "Exception",
                      "RuntimeException", "RuntimeException",
                      "RuntimeException", "RuntimeException",
                      "RuntimeException", "RuntimeException",
                      "RuntimeException", "RuntimeException",
                      "RuntimeException", "IllegalArgumentException",
                      "Exception", "Error", "Error",
                      "Error", "RuntimeException"]
        for (var i = 0; i < names.length; i++) {
            var cls = newDescriptor(names[i], i == 0 ? [] : [{name: supers[i], args: null, deleg: null}])
            cls.__ctor = function() {
                var self = arguments[0]
                kTakeNamed()
                self.message = arguments.length > 1 ? arguments[1] : null
            }
            cls.__cparams = [{pname: "message", def: null, vararg: false}]
            globalScope[names[i]] = cls
        }
    }
    installThrowables()

    // Set by makeCall around its callee resolution and cleared by core.varMiss - see
    // both. A name the scope walk answers never reaches varMiss, so makeCall clears it
    // too rather than leaving it for the next miss to read. Declared HERE, textually
    // before both of its readers: the frozen host resolves a var by position where goja
    // hoists (docs/working-on-this-project.md 7.12).
    var kCallPos = false

    // f(args): a global function, a builtin, a class constructor, or an object with an
    // `operator fun invoke`.
    function makeCall(items) {
        var name = items[0]
        var targs = null
        var start = 1
        if (items.length > 1 && items[1] != undefined && items[1] != null && items[1].targs != undefined) {
            targs = parseTypeArgs(items[1].targs)
            start = 2
        }
        var args = items.slice(start)
        return function() {
            var spec = kevalArgs(args)
            // THE SYNTACTIC POSITION, and the whole of todo.md 1.6's first bullet in
            // this half. `first` is a PROPERTY of IntProgression and a member FUNCTION
            // of List, so the NAME cannot decide which read an unqualified `first`
            // wants - but the SITE can, and `name(...)` is the only production that
            // spells a name and means a call. kCallPos is a ONE-SHOT: core.varMiss
            // clears it before it does anything that could re-enter (a getter body is
            // ordinary user code and resolves names of its own), and it is cleared
            // here too, because a name the SCOPE walk answers never reaches varMiss at
            // all and the flag would otherwise survive into the next miss.
            kCallPos = true
            var f = getVar(name)
            kCallPos = false
            if (f != undefined && f !== null && f.__isclass) { return kNew(f, spec) }
            if (typeof f != "function") {
                // A local holding a callable reference - `val g = b::twice; g()`.
                if (kIsRef(f)) { return kRefApply(f, spec.pos) }
                var inv = lookupMethod(f, "invoke")
                if (inv != null) { return inv.apply(undefined, concat2impl([f], spec.pos)) }
                fail("call of a non function: " + name)
            }
            kSetNamed(spec.named)
            if (targs == null) { return f.apply(undefined, spec.pos) }
            kTypeArgsPush(targs)
            try { return f.apply(undefined, spec.pos) } finally { kTypeArgsPop() }
        }
    }

    function makeAssign(items) {
        var ref = items[0]
        var op = items[1]
        var valT = items[2]
        return function() {
            var v = anytype // An assignment moves a value of any type.
            v = valT()
            if (ref.path.length == 0) {
                return kSetName(ref.name, op, v)
            } else {
                var p = resolveRef(ref)
                if (op != "=") v = applyOp(op, kReadSlot(p), v)
                if (p.isIndex) { kSetIndex(p.obj, p.key, v) } else { kSetField(p.obj, p.key, v) }
            }
            return v
        }
    }
    function kReadSlot(p) {
        return p.isIndex ? kIndex(p.obj, p.key) : kGetField(p.obj, p.key)
    }
    function kSetIndex(o, i, v) {
        if (Array.isArray(o)) { o[kNum(i)] = v; return }
        if (kIsMap(o)) { kMapPut(o, i, v); return }
        if (typeof o == "object" && o != null && o.__class != undefined && o.__class != null) {
            var st = clsFind(o.__class, "set")
            if (typeof st == "function") { st(o, i, v); return }
        }
        scopePut(o, i, v)
    }
    // resolveRef walks the path; the last step needs to say whether it is a `.name` or
    // an `[index]`, so the write can route through a setter or an `operator fun set`.
    resolveRef = function(ref) {
        var o = anytype
        o = getVar(ref.name)
        for (var i = 0; i < ref.path.length - 1; i++) {
            var s = ref.path[i]
            if (s.key != undefined) { o = kGetField(o, s.key) }
            else { o = kIndex(o, s.idx()) }
            if (o === undefined || o === null) fail("null in assignment path of " + ref.name)
        }
        var last = ref.path[ref.path.length - 1]
        if (last.key != undefined) { return {obj: o, key: last.key, isIndex: false} }
        return {obj: o, key: last.idx(), isIndex: true}
    }
    // ++ / -- keep the type of what they step: a Double stays a Double, a sized
    // integer steps at its OWN width (so `var b: Byte = 127; b++` is -128), and
    // everything else steps as an Int32 (a Char as its code, like before).
    function kStep(v, d) {
        // ++/-- keeps the operand's own type, WIDTH included: a Float steps as a
        // Float, so `var f = 16777216f; f++` stays 1.6777216E7.
        if (kIsFlo(v)) { return kIsF32(v) ? kFlo32(v.__flo + d) : kFlo(v.__flo + d) }
        if (szIs(v)) { return kNorm(szPair(szArith("+", v, kSz(d, v.w, v.u))), v.w, v.u) }
        return (kNum(v) + d) | 0
    }
    // items = [op, ref]: the PREFIX form. It writes the same slot makeIncDec writes and
    // differs only in what it hands back - the NEW value rather than the old one.
    function makePreIncDec(items) {
        var d = (items[0] == "++") ? 1 : -1
        var ref = items[1]
        return function() {
            if (ref.path.length == 0) {
                var n = anytype // The variable may hold a Char or a delegate box.
                n = getVar(ref.name)
                if (isPDeleg(n)) { var nd = kStep(pdelegGet(n), d); pdelegSet(n, nd); return nd }
                var nv0 = kStep(n, d)
                setVar(ref.name, nv0)
                return nv0
            }
            var p = resolveRef(ref)
            var mv = anytype // The slot may hold a number, a Char or a Double.
            mv = kReadSlot(p)
            var nv = kStep(mv, d)
            if (p.isIndex) { kSetIndex(p.obj, p.key, nv) } else { kSetField(p.obj, p.key, nv) }
            return nv
        }
    }
    function makeIncDec(items) {
        var ref = items[0]
        var d = (items[1] == "++") ? 1 : -1
        return function() {
            if (ref.path.length == 0) {
                var n = anytype // The variable may hold a Char or a delegate box.
                n = getVar(ref.name)
                if (isPDeleg(n)) { var dv = pdelegGet(n); pdelegSet(n, kStep(dv, d)); return dv }
                setVar(ref.name, kStep(n, d))
                return n
            }
            var p = resolveRef(ref)
            var mv = anytype // The slot may hold a number, a Char or a Double.
            mv = kReadSlot(p)
            var nv = kStep(mv, d)
            if (p.isIndex) { kSetIndex(p.obj, p.key, nv) } else { kSetField(p.obj, p.key, nv) }
            return mv
        }
    }

    // ----- Core library config (see lib/interp-core.js) -----
    core.lang = "kotlin"
    core.add = kadd
    core.excMatches = kExcMatches
    core.getField = kGetField
    core.getIndex = kIndex
    // An unqualified name inside a member resolves against the IMPLICIT RECEIVER chain:
    // the enclosing `this`, then (for an inner class) each enclosing instance along the
    // __outer chain. On each of them it may be a field, a property with a getter, a
    // METHOD (so `hidden()` works without `this.`), or a static of its class - a
    // companion member or, inside an enum, one of the enum's own entries (N -> S).
    core.varMiss = function(name) {
        var iscall = kCallPos
        kCallPos = false
        // Kotlin's implicit receivers form a STACK and lookup walks OUTWARD: a name the
        // innermost receiver does not answer falls through to the next one out. Only
        // findThis() - the innermost - used to be consulted, so `with(P(1)) { tag }`
        // written inside a member of Q, where P has no `tag`, failed with "unknown
        // name: tag" in BOTH halves instead of reading this@Q.tag.
        var chain = findThisChain()
        for (var ci = 0; ci < chain.length; ci++) {
            var hc = recvLookup(chain[ci], name, iscall)
            if (hc != null) { return hc }
        }
        // Inside a member extension the DISPATCH receiver is a second implicit
        // receiver: the declaring class's own members stay reachable unqualified.
        var h = recvLookup(findDispatch(), name, iscall)
        if (h != null) { return h }
        // A property registered as a top-level computed property.
        if (hasOwn(topProps, "$" + name)) { return {v: kGetField(topProps["$" + name], name)} }
        // A STRING implicit receiver's METHODS, answered LAST. `with("abcd")
        // { substring(1) }` and `{ uppercase() }` aborted with "unknown name" in this
        // half while the compiler ran them (ktIsBuiltinRecv covers a string there), and
        // the LATENESS is the whole point: a member extension on String -
        // `fun String.emit()` declared inside a class - binds the string as `this`, so
        // answering here early swallows every name of the DECLARING class and broke
        // three ratchet assertions when it was tried. The compiler half has exactly
        // this ordering: kt_ktget probes the dispatch receiver before it ever reaches
        // ktRecvStack. The hostGlobals guard is recvLookup's, for its reason.
        if (!hasOwn(hostGlobals, name)) {
            for (var cj = 0; cj < chain.length; cj++) {
                if (typeof chain[cj] == "string") { return {v: kBoundBuiltin(chain[cj], name)} }
            }
        }
        return null
    }
    // Walk one implicit-receiver chain (a receiver and its enclosing __outer instances)
    // for `name` as a field, a property with a getter, a METHOD (so an unqualified
    // member call works) or a static of its class - a companion member or, inside an
    // enum, one of the enum's own entries.
    // `iscall` is the syntactic position - see core.varMiss above and the twins
    // ktRecvMember in abnf/jsrtkotlin.go and languages/lib/kotlin-rt.metajs.
    function recvLookup(start, name, iscall) {
        var cur = start
        while (cur != undefined && cur != null) {
            if (typeof cur != "object") {
                // A STRING receiver is a BUILTIN receiver like any other, and only
                // `length` resolved here: `with("abcd") { substring(1) }`,
                // `{ uppercase() }`, `{ lastIndex }` and `{ indices }` all aborted with
                // "unknown name" while the compiler half answered every one of them
                // (ktIsBuiltinRecv in abnf/jsrtkotlin.go covers a string). A live
                // halves divergence, found sweeping todo.md 1.8's neighbourhood. The
                // two guards below are the ones the object arm further down uses, for
                // the same reasons.
                if (typeof cur == "string") {
                    if (kRecvProps["$" + name] === true) { return {v: kGetField(cur, name)} }
                    if (!iscall) {
                        var sv = anytype
                        sv = kGetField(cur, name)
                        if (sv !== undefined) { return {v: sv} }
                    }
                }
                return null
            }
            if (hasOwn(cur, name)) { return {v: kLateinitCheck(cur, name, cur[name])} }
            var cls = cur.__class
            if (cls != undefined && cls != null) {
                var g = clsFind(cls, "get$" + name)
                if (typeof g == "function") { return {v: g(cur)} }
                var m = clsFind(cls, name)
                if (typeof m == "function") { return {v: boundMethod(cur, m)} }
                var st = clsStatic(cls, name)
                if (st != null) { return st }
                // Inside a COMPANION object, the OWNER's statics are in scope too
                // (attachCompanion records the owner) - an enum's entries above all.
                if (cls.__owner != undefined && cls.__owner != null) {
                    var ost = clsStatic(cls.__owner, name)
                    if (ost != null) { return ost }
                }
                // Bare `entries` inside an enum's own member or its companion: Kotlin
                // 1.9's EnumEntries is a member of the enum, so it needs no qualifier
                // there. Only `L.entries` resolved before, in BOTH halves.
                if (name == "entries") {
                    var ecl = cls.__isenum === true ? cls
                              : (cls.__owner != undefined && cls.__owner != null
                                 && cls.__owner.__isenum === true ? cls.__owner : null)
                    if (ecl != null && ecl.__entries != undefined) { return {v: ecl.__entries.slice(0)} }
                }
            }
            // A BUILTIN receiver - the StringBuilder box, a list, a map - reached
            // through `with(x) { ... }` / `x.apply { ... }`, where Kotlin binds the
            // receiver as `this` and an unqualified `append("a")` is a member call on
            // it. The few PROPERTIES come from kGetField; everything else is a bound
            // method, so the lookup never turns a property into a callable.
            // A SET was missing from this list in BOTH halves (ktIsBuiltinRecv in
            // abnf/jsrtkotlin.go names "a list, a map, a StringBuilder box or a
            // String" and its code agrees), so `with(setOf(1, 2)) { size }` and
            // `{ contains(1) }` aborted with "unknown name" everywhere - both halves
            // agreeing and both wrong, which byte-identity cannot see. Kotlin's `with`
            // binds any receiver, and Set.size is Collection.size.
            // The RECEIVER SHAPES whose members come from the runtime rather than
            // from a class descriptor. A RANGE, a REGEX, a MATCHRESULT, a RESULT and a
            // CHAR were all missing, in this half and in both compiled ones, so
            // `with(1..7 step 2) { first }`, `with(Regex("a")) { pattern }`, an
            // unqualified `find()`, `with(runCatching { 7 }) { getOrNull() }` and
            // `with('q') { isLetter() }` reached nothing anywhere - todo.md 1.6 and its
            // neighbourhood. Every one of them has a real method surface in mcall and
            // a real property surface in kGetField, which is what makes them belong
            // here rather than in the plain-object arm below.
            if (cls == undefined && cur.__isclass == undefined &&
                (Array.isArray(cur) || kIsMap(cur) || kIsSet(cur) || cur.__sb === true ||
                 isRange(cur) || isKRegex(cur) || isKMatch(cur) || kIsResult(cur) ||
                 kIsChar(cur))) {
                if (kRecvProps["$" + name] === true) { return {v: kGetField(cur, name)} }
                // VALUE POSITION: the field read is TRIED for any name, and only a miss
                // falls through to the bound method below - so nothing that resolved
                // stops resolving. `first`/`last`/`step` on a progression land here.
                if (!iscall) {
                    var bv = anytype
                    bv = kGetField(cur, name)
                    if (bv !== undefined) { return {v: bv} }
                }
                // A name the RUNTIME provides as a global is not a member of the
                // receiver: `buildList { addAll(listOf(2, 3)) }` bound `listOf` as a
                // method of the list under construction and aborted with "unknown list
                // method: listOf", because core.varMiss runs BEFORE the hostGlobals
                // lookup in getVar. Declining here lets it fall through, which is what
                // the compiler half does (js_ktget consults the scope first). A builtin
                // receiver has no member of any of these names, so nothing that used to
                // resolve stops resolving.
                if (hasOwn(hostGlobals, name)) { return null }
                return {v: kBoundBuiltin(cur, name)}
            }
            // A PLAIN OBJECT receiver that is neither a class instance nor one of the
            // collection kinds: a lazy, a Result, a MatchResult. Its OWN properties
            // were already answered at the top of the loop, which is what makes
            // `with(Pair(1, "x")) { first }` work; what was missing is the group the
            // runtime SYNTHESISES - kotlin.Lazy's value / isInitialized,
            // kotlin.Result's isSuccess / isFailure, MatchResult.value - all of which
            // kGetField answers and none of which is an own property. `with(lazy {
            // 42 }) { value }` aborted with "unknown name: value" here while the
            // compiler half answered 42. Nothing is bound as a METHOD: a plain object
            // has no builtin method table to dispatch into.
            if (cls == undefined && cur.__isclass == undefined &&
                (kRecvProps["$" + name] === true || !iscall)) {
                var pv = anytype
                pv = kGetField(cur, name)
                if (pv != undefined && pv != null) { return {v: pv} }
            }
            cur = hasOwn(cur, "__outer") ? cur.__outer : null
        }
        return null
    }
    var kRecvProps = {}
    // The last four are the properties of the receivers that are neither collections
    // nor class instances - kotlin.Lazy's value / isInitialized and kotlin.Result's
    // isSuccess / isFailure, plus MatchResult.value, and Char.code. All five are `val`s in the
    // stdlib and no builtin receiver here has a zero-argument METHOD of any of those
    // names, which is what makes adding them safe: this table's whole job is to say
    // which unqualified names are a FIELD READ rather than a bound call. Keep it in
    // step with ktRecvProp (abnf/jsrtkotlin.go), k4RecvProp
    // (languages/lib/kotlin-rt.metajs) and kt_recvprop (kotlin-to-llvm-ir.abnf).
    var krpn = ["size", "length", "keys", "values", "entries", "indices", "lastIndex",
                "value", "isInitialized", "isSuccess", "isFailure", "code"]
    for (var krpi = 0; krpi < krpn.length; krpi++) { kRecvProps["$" + krpn[krpi]] = true }
    function kBoundBuiltin(self, name) {
        return function() {
            var args = []
            for (var i = 0; i < arguments.length; i++) { args.push(arguments[i]) }
            return mcall(self, name, args)
        }
    }
    // A method value with the receiver already bound, so an unqualified member call
    // (hidden(), secret()) is an ordinary callable.
    function boundMethod(self, m) {
        return function() {
            var args = []
            for (var i = 0; i < arguments.length; i++) { args.push(arguments[i]) }
            return m.apply(undefined, concat2impl([self], args))
        }
    }
    core.setMiss = function(name, value) {
        if (recvStore(findThis(), name, value)) { return true }
        if (recvStore(findDispatch(), name, value)) { return true }
        if (hasOwn(topProps, "$" + name)) { kSetField(topProps["$" + name], name, value); return true }
        return false
    }
    function recvStore(start, name, value) {
        var cur = start
        while (cur != undefined && cur != null && typeof cur == "object") {
            var cls = cur.__class
            if (cls != undefined && cls != null) {
                var st = clsFind(cls, "set$" + name)
                if (typeof st == "function") { st(cur, value); return true }
            }
            if (hasOwn(cur, name)) { scopePut(cur, name, value); return true }
            cur = hasOwn(cur, "__outer") ? cur.__outer : null
        }
        return false
    }

    c.compile(c.asg)

    // The entry point defaults to main(), but the -main flag (c.mainName) can override it.
    // A bare identifier (no '(') names a top-level function to call; anything else is a
    // snippet of Kotlin - a single statement such as greet("a", 2) - parsed with the same
    // grammar (from its Statement rule) and run in the program's already-populated scope,
    // so it can call the file's functions with real arguments.
    var mainName = c.mainName
    if (mainName == undefined || mainName == "") { mainName = "main" }
    var ret = anytype
    if (mainIsSnippet(mainName)) {
        try {
            ret = runMainSnippet(mainName, "Statement")
        } catch (e) {
            if (excIsUser(e)) { fail("uncaught exception: " + e.v) }
            throw e
        }
        println("kotlin interpreter: -main snippet returned " + (ret === undefined ? 0 : ret))
    } else {
        if (typeof globalScope[mainName] != "function") {
            fail("Kotlin programs need a top level " + mainName + "() function.")
        }
        // A user exception that escapes the entry point is reported like a runtime error.
        try {
            ret = globalScope[mainName]()
        } catch (e) {
            if (excIsUser(e)) { fail("uncaught exception: " + e.v) }
            throw e
        }
        println("kotlin interpreter: " + mainName + "() returned " + (ret === undefined ? 0 : ret))
    }
    exit(ret === undefined ? 0 : ret | 0)

~~) ;
