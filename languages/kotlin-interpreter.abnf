            // 32 bits, which IS Kotlin's Int rule; >>> yields an unsigned value there,
            // so it is wrapped back into the Int range.
            if (op == "shl") return a << n
            if (op == "shr") return a >> n
            return (a >>> n) | 0
        }
        var m = n & (w == 64 ? 63 : 31)
        var la = kSz(l, w, u)
        if (op == "shl") { return kNorm(szPair(szArith("<<", la, m)), w, u) }
        if (op == "shr" && !u) { return kNorm(szPair(szArith(">>", la, m)), w, u) }
        // A logical shift: read the operand as unsigned at its width, shift, read the
        // result back at the operand's own signedness. `shr` on an unsigned type IS
        // the logical shift, and `ushr` is it for a signed one.
        return kNorm(szPair(szArith(">>", szConv(la, w, true), m)), w, u)
    }
    // The ordered comparison of two integral operands, at the promoted width. szCmp on
    // its own is NOT usable here: it compares at the WIDEST operand's width, so
    // `val b: Byte = 5; b < 1000` would truncate 1000 into a byte and answer false
    // where Kotlin promotes both to Int and answers true.
    function kCmp32(op, a, b) {
