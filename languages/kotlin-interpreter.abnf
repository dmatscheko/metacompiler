KwUntil     = "until" KwEnd ;
KwDownTo    = "downTo" KwEnd ;
KwStep      = "step" KwEnd ;
KwWhere     = "where" KwEnd ;

// A zero-width guard that fails when what follows is a class MEMBER rather than an
// enum entry. Both start with modifiers and annotations, so it skips those first and
// then decides on the hard declaration keyword behind them: `FIRST` and `private X()`
// are entries, `fun foo()`, `inline fun foo()` and `@inline fun foo()` are members.
NotMemberKw = :script(~~
    (function() {
        var hard = ["fun", "val", "var", "class", "object", "interface", "companion",
                    "init", "constructor", "typealias", "enum", "annotation"]
        var soft = ["public", "private", "protected", "internal", "open", "final",
                    "abstract", "sealed", "data", "override", "lateinit", "const",
                    "inner", "vararg", "noinline", "crossinline", "tailrec", "operator",
                    "infix", "inline", "external", "suspend", "expect", "actual",
                    "reified", "value"]
        var i = 0
        var cc = 0
        var skipWs = function() {
            cc = c.peek(i)
            while (true) {
                while (cc === 32 || cc === 9 || cc === 10 || cc === 13) { i++; cc = c.peek(i) }
                if (cc !== 47) { return }
                var n = c.peek(i + 1)
                if (n === 47) { while (cc !== 10 && cc !== -1) { i++; cc = c.peek(i) } }
                else if (n === 42) {
                    i += 2
                    cc = c.peek(i)
                    while (cc !== -1 && !(cc === 42 && c.peek(i + 1) === 47)) { i++; cc = c.peek(i) }
                    i += 2
                    cc = c.peek(i)
                } else { return }
            }
        }
        var word = function() {
            var w = ""
            while ((cc >= 97 && cc <= 122) || (cc >= 65 && cc <= 90) || (cc >= 48 && cc <= 57) || cc === 95) {
                w += String.fromCharCode(cc)
                i++
                cc = c.peek(i)
            }
            return w
        }
        var balanced = function(open, close) {
            var depth = 0
            while (cc !== -1) {
                if (cc === open) { depth++ }
                else if (cc === close) { depth--; if (depth === 0) { i++; cc = c.peek(i); return } }
                i++
                cc = c.peek(i)
            }
        }
        var guard = 0
        while (guard < 64) {
            guard++
            skipWs()
            if (cc === 64) {                       // an annotation: @Name(...) or @[...]
                i++
                cc = c.peek(i)
                if (cc === 91) { balanced(91, 93) } else { word(); if (cc === 58) { i++; cc = c.peek(i); word() }; if (cc === 40) { balanced(40, 41) } }
                continue
            }
            var w = word()
            if (w === "") { break }
            var isSoft = false
            for (var k = 0; k < soft.length; k++) { if (soft[k] === w) { isSoft = true } }
            if (isSoft) { continue }
            for (var h = 0; h < hard.length; h++) {
