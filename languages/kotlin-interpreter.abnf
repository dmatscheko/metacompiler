    // unsigned operand pays for the exact 64 bit pair path.
    // The Int case, on two operands already known to be plain numbers. It is kept as
    // its own function so the FAST PATH below - two plain numbers, which is what an
    // ordinary Kotlin program is made of - costs one typeof pair and nothing else:
    // no width computation, no unboxing, no allocation.
    function kArith32(op, a, b) {
        if (op == "+") return (a + b) | 0
        if (op == "-") return (a - b) | 0
        if (op == "*") return kMul32(a, b)
        if (op == "/") {
            if (b == 0) { kThrowExc("ArithmeticException", "/ by zero") }
            // |0 truncates toward zero inside the Int range and wraps outside it,
            // which is exactly what Int.MIN_VALUE / -1 needs: the mathematical
            // 2147483648 wraps back to Int.MIN_VALUE, as the JVM's idiv does.
            return (a / b) | 0
