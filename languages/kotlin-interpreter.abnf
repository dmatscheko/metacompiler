        var hi = lines.length
        while (lo < hi && kTrimSide(lines[lo], true, true).length == 0) { lo++ }
        while (hi > lo && kTrimSide(lines[hi - 1], true, true).length == 0) { hi-- }
        var ind = 0 - 1
        for (var j = lo; j < hi; j++) {
            if (kTrimSide(lines[j], true, true).length == 0) { continue }
            var k = 0
            while (k < lines[j].length && (lines[j].charAt(k) == " " || lines[j].charAt(k) == "\t")) { k++ }
            if (ind < 0 || k < ind) { ind = k }
