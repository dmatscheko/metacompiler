        if (name == "filterKeys" || name == "filterValues" || name == "filter" ||
            name == "filterNot" || name == "mapValues" || name == "mapKeys") {
            var fm = kMakeMap()
            for (i = 0; i < m.keys.length; i++) {
                var ent = {key: m.keys[i], value: m.vals[i], first: m.keys[i], second: m.vals[i]}
                if (name == "filterKeys") { if (f(m.keys[i])) { kMapPut(fm, m.keys[i], m.vals[i]) }; continue }
                if (name == "filterValues") { if (f(m.vals[i])) { kMapPut(fm, m.keys[i], m.vals[i]) }; continue }
                if (name == "filter") { if (f(ent)) { kMapPut(fm, m.keys[i], m.vals[i]) }; continue }
                if (name == "filterNot") { if (!f(ent)) { kMapPut(fm, m.keys[i], m.vals[i]) }; continue }
