    // same type, so the only widenings a program kotlinc accepts can exhibit are
    // Byte+Byte -> Int, Short+Short -> Int, Int+Long -> Long and UInt+ULong -> ULong:
    // 64 bits if either side is 64, else 32; unsigned if either side is unsigned.
    // There is no `uint + int -> long` ladder to model - in Kotlin that is a compile
    // error, because the language has NO implicit numeric conversions at all.
    function kWidth(l, r) {
        if (kIsLong(l) || kIsLong(r)) { return 64 }
        return 32
    }
    function kUns(l, r) {
        if (szIs(l) && l.u) { return true }
        return szIs(r) && r.u
