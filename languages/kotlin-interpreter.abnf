            if (i >= 0) { return {v: m.vals[i]} }
            if (name == "getValue") { fail("key " + kstr(f) + " is missing in the map") }
            if (name == "getOrDefault") { return {v: args[1]} }
            if (name == "getOrElse") { return {v: args[1]()} }
