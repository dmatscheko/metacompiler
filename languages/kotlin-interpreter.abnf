    // kSz is "read this at (w, u)": ALWAYS a box, never a plain number.
    function kSz(v, w, u) { return szMake(i64Trunc(szIs(v) ? v.p : i64FromNum(kNumD(v)), w, u), w, u) }
    // kNorm applies the Kotlin invariant to a 64 bit pair: a signed 32 bit result is a
    // plain number, everything else a box.
    function kNorm(p, w, u) {
