    // shl / shr / ushr. The result type is the LEFT operand's alone and the COUNT is
    // MASKED - & 31 for a 32 bit left operand, & 63 for a 64 bit one - which is why
    // `1 shl 32` is 1 rather than 0.
    function kShift(op, l, r) {
