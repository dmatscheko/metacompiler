        var hi = lines.length
        while (lo < hi && kTrimSide(lines[lo], true, true).length == 0) { lo++ }
        while (hi > lo && kTrimSide(lines[hi - 1], true, true).length == 0) { hi-- }
        var ind = 0 - 1
        for (var j = lo; j < hi; j++) {
