KwObject    = "object" KwEnd ;
KwEnum      = "enum" KwEnd ;
KwAnnotation = "annotation" KwEnd ;
KwCompanion = "companion" KwEnd ;
KwTypealias = "typealias" KwEnd ;
KwConstructor = "constructor" KwEnd ;
KwInit      = "init" KwEnd ;
KwGet       = "get" KwEnd ;
KwSet       = "set" KwEnd ;

KwFun       = "fun" KwEnd ;
KwImport    = "import" KwEnd ;
KwPackage   = "package" KwEnd ;
KwAs        = "as" KwEnd ;
KwAsSafe    = "as?" ;
KwTry       = "try" KwEnd ;
KwCatch     = "catch" KwEnd ;
KwFinally   = "finally" KwEnd ;
KwThrow     = "throw" KwEnd ;
KwIs        = "is" KwEnd ;
KwNotIs     = "!is" KwEnd ;
KwClass     = "class" KwEnd ;
KwIf        = "if" KwEnd ;
KwElse      = "else" KwEnd ;
KwWhile     = "while" KwEnd ;
KwDo        = "do" KwEnd ;
KwFor       = "for" KwEnd ;
KwIn        = "in" KwEnd ;
KwBy        = "by" KwEnd ;
KwWhen      = "when" KwEnd ;
KwReturn    = "return" KwEnd ;
KwBreak     = "break" KwEnd ;
