        var x = neg ? 0 - f : f
        var scale = 1
        for (var p = 0; p < prec; p++) { scale = scale * 10 }
        var scaled = Math.floor(x * scale + 0.5)
        var whole = Math.floor(scaled / scale)
        var frac = scaled - whole * scale
        var fs = "" + frac
        while (fs.length < prec) { fs = "0" + fs }
