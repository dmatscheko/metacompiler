        if (name == "remove") {
            i = kMapFind(m, f)
            if (i < 0) { return {v: null} }
            var gone = anytype
            gone = m.vals[i]
            // No array.splice under the frozen engine: the two arrays are rebuilt.
            var nk = []
            var nv = []
            for (var j = 0; j < m.keys.length; j++) {
                if (j == i) { continue }
                nk.push(m.keys[j])
                nv.push(m.vals[j])
            }
