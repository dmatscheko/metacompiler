ParamSkip   = { Annotation | ParamMod } [ ( "val" | "var" ) KwEnd ] KId [ ":" Type ] [ "=" DiscardExpr ] ;

ParamList   <~~ push({params: takeAll()}) ~~>
            = "(" [ Param { "," Param } [ "," ] ] ")" ;
// A parameter is a {pname, def, vararg} record. The DEFAULT value is genuine: its thunk
// is kept and evaluated inside the callee's frame, after the preceding parameters are
// bound (so a default may read an earlier one), whenever the call site left the slot
// empty. `vararg` is genuine too: the matching call-site arguments are packed into a
// list bound to the parameter (see kfit). The remaining modifiers (noinline,
// crossinline, the annotations) are parsed and dropped.
