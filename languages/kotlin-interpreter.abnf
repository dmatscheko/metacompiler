SkipBracket = "[" { SkipBracket | SkipParen | SkipBlock | SkipStr | SkipChar | SkipBracketItem } "]" ;
SkipBracketItem = "\x00"..."\x21" | "\x23"..."\x26" | "\x28"..."\x5a" | "\x5c" | "\x5e"..."\x7a" | "\x7c"..."\U0010ffff" ;
