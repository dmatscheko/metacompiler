    // Is this an operand of INTEGER arithmetic (as opposed to a String, a Boolean, a
    // reference)? A Char counts - Kotlin's Char does code arithmetic.
    function kIsIntegral(v) {
        if (typeof v == "number") { return true }
        if (v === null || v === undefined || typeof v != "object") { return false }
        return v.__sz === true || v.__char !== undefined
    }
    // ArithmeticException, THROWN rather than failed, so a program can catch it.
    // interp-core's exception protocol is {__exc: true, v: <thrown value>}.
    function kThrowExc(clsName, msg) {
        throw {__exc: true, v: {__class: globalScope[clsName], message: msg}}
    }
    // (a * b) mod 2^32. `(a * b) | 0` is WRONG: the exact product needs up to 62 bits
    // and a double keeps only 53, so the low bits - the only ones that survive - are
    // already gone by the time |0 runs. Splitting into 16 bit halves keeps every
    // partial product exact.
    function kMul32(a, b) {
        var ah = (a >>> 16) & 65535
        var al = a & 65535
        var bh = (b >>> 16) & 65535
        var bl = b & 65535
        return (((ah * bl + al * bh) << 16) + al * bl) | 0
