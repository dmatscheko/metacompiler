// ---


:startScript(~~

    // Shared interpreter machinery (scopes, BRK/CONT protocol, expression and
    // statement builders); language-specific behavior is configured on `core` below.
    include("lib/interp-core.js")

    // The shared regular-expression engine (rxCompile / rxSearch / rxGroup / ...). It
    // is language neutral, so the RegexOption enum is translated to its own flag
    // letters in krxFlags below. rxFail is a KNOB, overridden by ASSIGNMENT (not by
    // declaration, see docs/abnf-dialect-gotchas.md) so a bad pattern reports like
    // every other Kotlin runtime error.
    include("lib/regex.js")
    rxFail = function (msg) { fail(msg) }

    // ----- Imports (same policy as the compiler grammar) -----
    // Prefixes the runtime already provides as builtins; importing them is a no-op.
    core.stdlibImports = ["kotlin", "kotlin.math", "kotlin.collections", "kotlin.system", "kotlin.text", "kotlin.ranges", "kotlin.sequences"]

    // Project-file imports: 'import a.b.C' looks for a/b/C.kt, then a/b.kt
    // under the program's directory and the -i roots (c.findImport). The file
    // is parsed with this grammar and walked with the same tags, so its
    // classes and functions register exactly like the main file's; the entry
    // point only runs for the main file (the start script calls it once).
    // A file is imported once; repeats and cycles are no-ops.
    var importedFiles = {}
    core.importFile = function(path, pos) {
        if (path.length > 2 && path.substring(path.length - 2) == ".*") { return false }
        var rel = path.split(".").join("/")
        var cands = [rel + ".kt"]
        var cut = -1
        for (var k = 0; k < rel.length; k++) { if (rel.charAt(k) == "/") { cut = k } }
        if (cut > 0) { cands.push(rel.substring(0, cut) + ".kt") }
        for (var i = 0; i < cands.length; i++) {
            var file = c.findImport(cands[i])
            if (file == "") { continue }
            if (importedFiles["$" + file] == true) { return true }
            importedFiles["$" + file] = true
            var text = c.readFile(file)
            var asg = c.parse(c.agrammar, text, null, file)
            c.pushSource(file, text)
            c.compile(asg)
            c.popSource()
            return true
        }
        return false
    }

    // stripWs, importResolvable, resolveImport and the notImpl / notImplStmt /
    // notImplExpr family now live in lib/interp-core.js (shared). This grammar sets
    // core.stdlibImports (above) and keeps the Kotlin-specific builders below.
    // try/catch/finally and throw are handled by excTry/excThrow (lib/interp-core.js).
    // Decodes a character literal's source text ('A', '\n', '￿') to its code.
    function kCharCode(t) {
        if (t.charAt(1) == "\\") {
            var e = t.charAt(2)
            if (e == "n") { return 10 }
            if (e == "t") { return 9 }
            if (e == "r") { return 13 }
            if (e == "b") { return 8 }
            if (e == "0") { return 0 }
            if (e == "u") { return parseInt(t.substring(3, 7), 16) }
            return e.charCodeAt(0)
        }
        return t.charCodeAt(1)
    }
    // ----- Char: a boxed {__char: code} value -----
    // Kotlin's Char is neither an Int nor a one-character String: it renders as the
    // glyph but compares and does arithmetic on its code. Boxing keeps the two apart
    // in the untyped value model. kChar builds one, kIsChar tests, kNum unboxes to the
    // code (the identity for everything else) and kChStr renders the glyph.
    function kChar(code) { return {__char: code} }
    function kIsChar(v) { return v !== null && v !== undefined && typeof v == "object" && v.__char !== undefined }
    // The PLAIN NUMBER reading of any numeric operand - what an array index, a
    // string offset, a list length and a range bound all want. A sized integer box
    // unwraps through szNum (exact below 2^53, the nearest double above it).
    function kNum(v) { return kIsChar(v) ? v.__char : (kIsFlo(v) ? v.__flo : szNum(v)) }

    // ----- Double / Float: a boxed {__flo: value} -----
    // Kotlin's Double is a DIFFERENT type from Int, and this value model is untyped,
    // so 1.0 and 1 would both be the JS number 1: 1.0 / 3.0 would divide as integers
    // (0 instead of 0.3333333333333333) and println(1.0) would print "1" instead of
    // "1.0". Boxing every floating-point value keeps them apart, exactly like kChar
    // keeps a Char apart from its code and like the compiled half's js_jflo box (see
    // abnf/jsrtjvm.go). Invariant: a PLAIN number is an integral type (Int/Long/
    // Short/Byte), a {__flo} box is a Double or a Float.
    var kNegOne = 0 - 1
    var kZeroF = 0
    var kInf = 1 / kZeroF
    function kFlo(f) { return {__flo: f} }
    function kIsFlo(v) { return v !== null && v !== undefined && typeof v == "object" && v.__flo !== undefined }
    // The numeric value of any numeric operand: a plain number, a Char, a Double or a
    // sized integer (which reads as the nearest double above 2^53, the way a
    // Long -> Double conversion does).
    function kNumD(v) {
        if (v === null || v === undefined) return v
        if (typeof v == "object") {
            if (v.__flo !== undefined) return v.__flo
            if (v.__char !== undefined) return v.__char
            if (v.__sz === true) return szNum(v)
        }
        return v
    }
    function kNegF(f) { return f * kNegOne }
    // Double.toString (Kotlin/JVM delegates to java.lang.Double): always a decimal
    // point, the shortest digit run that round-trips, plain decimal for
    // 1e-3 <= |d| < 1e7 and scientific notation ("1.0E20") outside it.
    function kFloStr(d) {
        if (d !== d) return "NaN"
        if (d === kInf) return "Infinity"
        if (d === kNegF(kInf)) return "-Infinity"
        if (d === 0) return (1 / d < 0) ? "-0.0" : "0.0"
        var neg = d < 0
        var a = neg ? kNegF(d) : d
        var s = (a >= 0.001 && a < 10000000) ? kFloPlain(a) : kFloSci(a)
        return neg ? "-" + s : s
    }
    function kFloPlain(a) {
        var s = "" + a
        if (s.indexOf(".") < 0) { s = s + ".0" }
        return s
    }
    function kFloSci(a) {
        var s = "" + a
        var mant = s
        var exp = 0
        var ei = 0 - 1
        for (var i = 0; i < s.length; i++) { if (s.charAt(i) == "e" || s.charAt(i) == "E") { ei = i } }
        if (ei >= 0) {
            mant = s.substring(0, ei)
            var et = s.substring(ei + 1)
            if (et.charAt(0) == "+") { et = et.substring(1) }
            exp = parseInt(et, 10)
        }
        var digits = ""
        var pt = 0 - 1
        for (var j = 0; j < mant.length; j++) {
            var ch = mant.charAt(j)
            if (ch == ".") { pt = digits.length } else { digits = digits + ch }
        }
        if (pt < 0) { pt = digits.length }
        var lead = 0
        while (lead < digits.length - 1 && digits.charAt(lead) == "0") { lead++ }
        digits = digits.substring(lead)
        pt = pt - lead
        var endz = digits.length
        while (endz > 1 && digits.charAt(endz - 1) == "0") { endz-- }
        digits = digits.substring(0, endz)
        var frac = digits.substring(1)
        if (frac == "") { frac = "0" }
        return digits.charAt(0) + "." + frac + "E" + (pt + exp - 1)
    }
    function kChStr(v) { return String.fromCharCode(v.__char) }

    // ----- Int / Long / Byte / Short and the four UNSIGNED types -----
    // Kotlin's integral types have fixed widths and WRAP silently on overflow (unlike
    // Swift, which traps), and the width has to survive into the next operation -
    // `var b: Byte = 127; b++` is -128, and nothing about the value 127 says so. That
    // is the same problem the {__flo} box solves for floating point and it gets the
    // same answer: the type goes ON the value. The machinery is the language-neutral
    // sz* layer in lib/interp-core.js (szArith / szConv / szCmp / szStr on exact 64
    // bit pairs); abnf/jsrtkotlin.go implements the identical rules for the compiled
    // half and ./test.sh --cross diffs the two, so the two MUST stay in step.
    //
    // The INVARIANT is Java's, because Kotlin/JVM's Int and Long ARE Java's:
    //
    //     a plain number   ==  an `Int`, i.e. a SIGNED 32 BIT value
    //     an {__sz} box    ==  Long / Byte / Short, or any UNSIGNED type
    //     an {__flo} box   ==  a Double / Float
