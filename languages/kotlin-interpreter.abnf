    function kF32Sig(a) {
        var full = kDecDigits(a)
        var n = 1
        while (n < 9) {
            var c = kRoundDig(full, n)
            if (kF32Round(kDecVal(c)) === a) { return c }
            n = n + 1
        }
        return kRoundDig(full, 9)
