        if (e10 >= 0) {
            var ip = ""
            for (var i = 0; i <= e10; i++) { ip = ip + (i < ds.length ? ds.charAt(i) : "0") }
            var fp = ds.length > e10 + 1 ? ds.substring(e10 + 1) : "0"
