    //
    // floPrec CAN be asked, and its two implementations no longer disagree -
    // the note that used to sit here (abnf/commonscript.go exactly n digits,
    // languages/lib/runtime.c's max(n, shortest)) was made false by
    // docs/todo.md 2.8, which taught the C floor's host id 70 the exactly-n
    // contract that abnf/commonscript.go always had. The shortest round-tripping
    // form is then a search rather than a host question - ask for n digits,
    // parse the result back, stop at the first n that reproduces the value - and
    // the answer is the same in every engine by construction. parseFloat is
    // exact in both hosts (jsParseFloat in abnf/jsrt.go is strconv.ParseFloat;
    // goja's is too), which is what makes the test decide rather than
    // approximate.

    // The value of a floPrec-shaped DIGITS "e" EXP form, exactly. EXP is the
    // decimal exponent of the FIRST digit, so the text handed to parseFloat
    // carries the point after that digit.
    function kSigVal(s) {
        var ei = s.indexOf("e")
        var ds = s.substring(0, ei)
        var frac = ds.substring(1)
        if (frac == "") { frac = "0" }
        return parseFloat(ds.charAt(0) + "." + frac + "e" + s.substring(ei + 1))
    }
    // The shortest round-tripping decimal of the double a > 0, as DIGITS "e" EXP,
    // EXP being the decimal exponent of the FIRST digit. Seventeen digits always
    // round-trip a binary64, so the loop always terminates with an exact answer.
    function kDecDigits(a) {
        var n = 1
        while (n < 17) {
            var c = floPrec(a, n)
            if (kSigVal(c) === a) { return c }
            n = n + 1
        }
        return floPrec(a, 17)
    }
    // A DIGITS "e" EXP form rounded to n significant digits, half to even.
    function kRoundDig(s, n) {
        var ei = s.indexOf("e")
        var ds = s.substring(0, ei)
        var ex = parseInt(s.substring(ei + 1), 10)
        if (ds.length <= n) { return s }
        var keep = ds.substring(0, n)
        var nxt = ds.charCodeAt(n) - 48
        var up = false
        if (nxt > 5) { up = true }
        if (nxt == 5) {
            var rest = false
            for (var i = n + 1; i < ds.length; i++) { if (ds.charCodeAt(i) != 48) { rest = true } }
            if (rest) { up = true } else {
                var last = ds.charCodeAt(n - 1) - 48
                if (last - Math.floor(last / 2) * 2 == 1) { up = true }
            }
        }
        if (up) {
            var out = ""
            var carry = 1
            for (var k = n - 1; k >= 0; k--) {
                var dg = ds.charCodeAt(k) - 48 + carry
                carry = 0
                if (dg == 10) { dg = 0; carry = 1 }
                out = "" + dg + out
            }
            if (carry == 1) { out = ("1" + out).substring(0, n); ex = ex + 1 }
            keep = out
        }
        var ez = keep.length
        while (ez > 1 && keep.charAt(ez - 1) == "0") { ez-- }
        return keep.substring(0, ez) + "e" + ex
    }
    // The value of a DIGITS "e" EXP form. At most nine digits, so the integer is
    // exact; the power of ten goes in chunks of 10^15, the largest one a double
    // holds exactly. The relative error stays under ~1e-15, five million times
    // finer than a float's half-ulp, and the only consumer is the round-trip TEST
    // below - an error that small cannot pick a wrong length.
    function kDecVal(s) {
        var ei = s.indexOf("e")
        var ds = s.substring(0, ei)
        var k = parseInt(s.substring(ei + 1), 10) - ds.length + 1
        var m = 0
        for (var i = 0; i < ds.length; i++) { m = m * 10 + (ds.charCodeAt(i) - 48) }
        while (k >= 15) { m = m * 1000000000000000; k = k - 15 }
        while (k <= 0 - 15) { m = m / 1000000000000000; k = k + 15 }
        while (k > 0) { m = m * 10; k = k - 1 }
        while (k < 0) { m = m / 10; k = k + 1 }
        return m
    }
