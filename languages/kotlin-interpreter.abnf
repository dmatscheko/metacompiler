            var saved = scopes        // does not resolve `arguments` from inside one).
            scopes = [globalScope, {}]
            declVar("this", argv[1])
            declVar("__dispatch", argv[0])
            bindParams(f.params, argv, 2, kTakeNamed())
            var r = anytype
            try { r = nlrRun(f.body) } finally { scopes = saved }
            return (r != undefined && r.isRet) ? r.v : undefined
        }
