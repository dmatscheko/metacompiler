~~) ;

// A zero-width guard that fails when the next non-whitespace token is `(` - used to
// tell a visibility-only accessor (private set) from a body accessor (set(v) { ... }).
NotParen    = :script(~~
    (function() {
        var i = 0
        var cc = c.peek(i)
        while (cc === 32 || cc === 9 || cc === 10 || cc === 13) { i++; cc = c.peek(i) }
        return (cc === 40) ? abnf.newToken("\x01paren-follows", 0) : undefined
    })()
~~) ;

// A zero-width guard that fails when the next non-whitespace character is `{`.
NotBrace    = :script(~~
    (function() {
        var i = 0
        var cc = c.peek(i)
        while (cc === 32 || cc === 9 || cc === 10 || cc === 13) { i++; cc = c.peek(i) }
        return (cc === 123) ? abnf.newToken("\x01brace-follows", 0) : undefined
    })()
~~) ;

// A zero-width guard that fails when the next non-whitespace token is `:` - used so a
// soft-keyword modifier (data/value/inner/...) that is really a parameter or property
// NAME is not consumed as a modifier (a genuine modifier is never followed by `:`).
NotColon    = :script(~~
    (function() {
        var i = 0
        var cc = c.peek(i)
        while (cc === 32 || cc === 9 || cc === 10 || cc === 13) { i++; cc = c.peek(i) }
        return (cc === 58) ? abnf.newToken("\x01colon-follows", 0) : undefined
    })()
~~) ;

// A zero-width guard that fails when the next non-whitespace token is the keyword
// `object` - it keeps the `companion` MODIFIER (companion fun / companion val) from
// consuming the `companion` of a `companion object` declaration.
NotObjectKw = :script(~~
    (function() {
        var i = 0
        var cc = c.peek(i)
        while (cc === 32 || cc === 9 || cc === 10 || cc === 13) { i++; cc = c.peek(i) }
        var w = "object"
        var k = 0
        while (k < 6) {
            if (c.peek(i + k) !== w.charCodeAt(k)) { return undefined }
            k++
