        if (sfx == 3) { return szMake(i64Trunc(p, 64, true), 64, true) }
        if (sfx == 2) {
            if (i64CmpU(p, i64Make(0, 0xffffffff)) <= 0) { return szMake(i64Trunc(p, 32, true), 32, true) }
            return szMake(i64Trunc(p, 64, true), 64, true)
