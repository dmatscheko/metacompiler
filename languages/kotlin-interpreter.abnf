    function kF32Str(d) {
        if (d !== d) return "NaN"
        if (d === kInf) return "Infinity"
        if (d === kNegF(kInf)) return "-Infinity"
        if (d === 0) return (1 / d < 0) ? "-0.0" : "0.0"
        var neg = d < 0
        var a = neg ? kNegF(d) : d
        var sig = kF32Sig(a)
        var ei = sig.indexOf("e")
        var ds = sig.substring(0, ei)
        var e10 = parseInt(sig.substring(ei + 1), 10)
        var body = ""
        if (a >= 0.001 && a < 10000000) {
            body = kPlainDec(ds, e10)
        } else {
