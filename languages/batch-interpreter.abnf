    function intToStr(n) {
        var m = n | 0
        if (m == 0) { return "0" }
        var neg = m < 0
        if (neg) { m = (0 - m) | 0 }
        var s = ""
        while (m > 0) {
            var d = m % 10
            s = DIGITS.charAt(d) + s
            m = (m / 10) | 0
        }
        return neg ? ("-" + s) : s
    }
    function toInt(s) {
        var i = 0, sign = 1, v = 0
        while (i < s.length && (s.charAt(i) == " " || s.charAt(i) == "\t")) { i = i + 1 }
        if (i < s.length && (s.charAt(i) == "-" || s.charAt(i) == "+")) {
            if (s.charAt(i) == "-") { sign = -1 }
            i = i + 1
        }
        while (i < s.length) {
            var cc = s.charCodeAt(i)
            if (cc < 48 || cc > 57) { break }
            v = (v * 10 + (cc - 48)) | 0
            i = i + 1
        }
        return (sign * v) | 0
    }
    function parseRadix(text, radix, skip) {
        var v = 0, i = skip
        while (i < text.length) {
            var cc = text.charCodeAt(i)
            var d = -1
            if (cc >= 48 && cc <= 57) { d = cc - 48 }
            else if (cc >= 97 && cc <= 102) { d = cc - 87 }
            else if (cc >= 65 && cc <= 70) { d = cc - 55 }
            if (d < 0 || d >= radix) { break }
            v = (v * radix + d) | 0
            i = i + 1
        }
        return v
    }
    function escBody(s) { return s.substring(1) }
    function noQuotes(s) {
        var out = "", i = 0
        for (i = 0; i < s.length; i++) { if (s.charAt(i) != "\x22") { out = out + s.charAt(i) } }
        return out
    }
    // Each ^ makes the character after it literal: `^<^<=` -> `<<=`, `^^=` -> `^=`.
    function unCaret(s) {
        var out = "", i = 0
        while (i < s.length) {
            if (s.charAt(i) == "^" && i + 1 < s.length) { i = i + 1 }
            out = out + s.charAt(i)
            i = i + 1
        }
        return out
    }

    // ===================================================================================
    //  The environment.
    //
    //  Variable names are case insensitive, so the table is keyed by the lower-cased name.
    //  `lineOld` is the PARSE-TIME snapshot that makes %VAR% behave the way cmd.exe's
    //  expansion does: a whole command line is expanded BEFORE it runs, so %VAR% inside a
    //  ( ) block is the value from before the block, while !VAR! is the current one. Rather
    //  than copy the environment at every line, each write records the pre-write value once;
    //  %VAR% reads that overlay when it exists, !VAR! always reads live.
    // ===================================================================================

    var vars = {}, defs = {}, varKeys = []
    var errlvl = 0
    var delayedOn = false
    var localStack = []
    var lineOld = {}

    function ensureKey(k) { if (!hasOwn(defs, k)) { varKeys.push(k); vars[k] = ""; defs[k] = false } }
    function noteWrite(k) {
        if (!hasOwn(lineOld, k)) {
            lineOld[k] = {v: (hasOwn(vars, k) ? vars[k] : ""), d: (hasOwn(defs, k) ? defs[k] : false)}
        }
    }
    function setVar(name, val) {
        var k = "$" + lower(name)
        noteWrite(k); ensureKey(k)
        vars[k] = "" + val; defs[k] = true
    }
    function unsetVar(name) {
        var k = "$" + lower(name)
        noteWrite(k); ensureKey(k)
        vars[k] = ""; defs[k] = false
    }
    function isDefined(name) { var k = "$" + lower(name); return hasOwn(defs, k) && defs[k] }
    function liveVal(name) {
        var k = "$" + lower(name)
        if (hasOwn(defs, k) && defs[k]) { return vars[k] }
        if (k == "$errorlevel") { return intToStr(errlvl) }
        return ""
    }
    function snapVal(name) {
        var k = "$" + lower(name)
        if (hasOwn(lineOld, k)) {
            if (lineOld[k].d) { return lineOld[k].v }
            if (k == "$errorlevel") { return intToStr(errlvl) }
            return ""
        }
        return liveVal(name)
    }
    // for-loop variables live in their own table, keyed by the %%x letter (case SENSITIVE).
    var forVars = {}
    function setForVar(letter, val) { forVars["$" + letter] = "" + val }
    // A for-variable no loop has set is left as written: %%z reads `%z` (the %% already
    // became one %). Twin of the gf_ slot initializer in batch-to-llvm-ir.abnf.
    function getForVar(letter) { return hasOwn(forVars, "$" + letter) ? forVars["$" + letter] : "%" + letter }
    function nextLetter(letter, n) {
        var cc = letter.charCodeAt(0) + n
        return String.fromCharCode(cc)
    }

    // ----- call arguments: %0..%9, %* and shift -----
    // The script's own %0 is the batch file as it was named to run it.
    var argFrames = [{lbl: c.file, a: []}]
    function curFrame() { return argFrames[argFrames.length - 1] }
    function argAt(n) {
        var f = curFrame()
        if (n == 0) { return f.lbl }
        return (n <= f.a.length) ? f.a[n - 1] : ""
    }
    function argTail() {
        var f = curFrame(), out = "", i = 0
        for (i = 0; i < f.a.length; i++) { out = out + ((i > 0) ? " " : "") + f.a[i] }
        return out
    }
    function shiftArgs(from) {
        var a = curFrame().a, i = from
        while (i + 1 <= a.length - 1) { a[i] = a[i + 1]; i = i + 1 }
        if (a.length > from) { a.pop() }
    }

    // ----- output capture (redirection discards; for /f 'echo ...' parses what it caught) --
    var capStack = []
    function outLine(s) {
        if (capStack.length > 0) {
            capStack[capStack.length - 1] = capStack[capStack.length - 1] + s + "\n"
        } else { println(s) }
    }
    function capStart() { capStack.push("") }
    function capEnd() { return capStack.pop() }

    // ===================================================================================
    //  The string operators of %VAR:~n,m% / %VAR:a=b% and of the ~ modifiers.
    // ===================================================================================

    function stripQuotes(s) {
        if (s.length >= 2 && s.charAt(0) == "\x22" && s.charAt(s.length - 1) == "\x22") {
            return s.substring(1, s.length - 1)
        }
        return s
    }
    function substrOp(s, startText, lenText, hasLen) {
        var n = s.length
        var st = (startText == null) ? 0 : toInt(startText)
        if (st < 0) { st = n + st; if (st < 0) { st = 0 } }
        if (st > n) { st = n }
        var end = n
        if (hasLen) {
            var L = toInt(lenText)
            end = (L < 0) ? (n + L) : (st + L)
        }
        if (end < st) { end = st }
        if (end > n) { end = n }
        return s.substring(st, end)
    }
    // The match is case insensitive; a leading * replaces everything up to and INCLUDING it.
    function substOp(s, from, to, star) {
        if (from == "") { return s }
        var ls = lower(s), lf = lower(from)
        if (star) {
            var at = findAt(ls, lf, 0)
            if (at < 0) { return s }
            return to + s.substring(at + from.length)
        }
        var out = "", i = 0
        while (i < s.length) {
            if (i + from.length <= s.length && ls.substring(i, i + from.length) == lf) {
                out = out + to; i = i + from.length
            } else { out = out + s.charAt(i); i = i + 1 }
        }
        return out
    }
    function hasMod(mods, ch) {
        var i = 0
        for (i = 0; i < mods.length; i++) { if (lower(mods.charAt(i)) == ch) { return true } }
        return false
    }
    // The effective set of path components a ~ modifier run asks for: 1 = drive, 2 = path,
    // 4 = name, 8 = extension. ~f is all four. ~s asks for the SHORT path, and on a volume
    // with 8.3 names switched off the short path is the long one, so it is a no-op flag on
    // top of the others (%%~sdi is a drive) and means the whole path when it stands alone.
    // ~a ~t ~z would have to stat the file, which the path model cannot do, so they ask for
    // nothing and the result is empty - which is also what cmd.exe answers for a file that
    // is not there.
    function effMask(mods) {
        var mask = 0
        if (hasMod(mods, "f")) { mask = 15 }
        if (hasMod(mods, "d")) { mask = mask | 1 }
        if (hasMod(mods, "p")) { mask = mask | 2 }
        if (hasMod(mods, "n")) { mask = mask | 4 }
        if (hasMod(mods, "x")) { mask = mask | 8 }
        if (mask == 0 && hasMod(mods, "s")) { mask = 15 }
        return mask
    }
    // Pure string path arithmetic.
    function applyMods(mods, raw) {
        var s = stripQuotes(raw)
        if (mods == "") { return s }
        var drive = "", rest = s
        if (s.length >= 2 && s.charAt(1) == ":") { drive = s.substring(0, 2); rest = s.substring(2) }
        var cut = -1, i = 0
        for (i = 0; i < rest.length; i++) {
            var ch = rest.charAt(i)
            if (ch == "\x5c" || ch == "/") { cut = i }
        }
        var path = (cut >= 0) ? rest.substring(0, cut + 1) : ""
        var base = (cut >= 0) ? rest.substring(cut + 1) : rest
        var dot = -1
        for (i = 0; i < base.length; i++) { if (base.charAt(i) == ".") { dot = i } }
        var nm = (dot > 0) ? base.substring(0, dot) : base
        var ext = (dot > 0) ? base.substring(dot) : ""
        var mask = effMask(mods)
        var out = ""
        if ((mask & 1) != 0) { out = out + drive }
        if ((mask & 2) != 0) { out = out + path }
        if ((mask & 4) != 0) { out = out + nm }
        if ((mask & 8) != 0) { out = out + ext }
        return out
    }

    // ===================================================================================
    //  Value / word thunks: function() -> string
    // ===================================================================================

    function makeStr(s) { return function() { return s } }
    function makeWord(parts) {
        return function() {
            var out = "", i = 0
            for (i = 0; i < parts.length; i++) { out = out + parts[i]() }
            return out
        }
    }
    function modsOf(items, upto) {
        var i = 0
        for (i = 0; i < upto; i++) { if (items[i].mods != undefined) { return items[i].mods.substring(1) } }
        return null                                // null = no ~ at all, so the value is raw
    }
    function mkSubStr(items) {                     // [{start}?, {len}?]
        var st = null, ln = null, hasLen = false, i = 0
        for (i = 0; i < items.length; i++) {
            if (items[i].start != undefined) { st = items[i].start }
            if (items[i].len != undefined) { ln = items[i].len; hasLen = true }
        }
        return function(s) { return substrOp(s, st, ln, hasLen) }
    }
    function mkSubst(items) {                      // [{star}?, {from}, {to}?]
        var star = false, from = "", to = "", i = 0
        for (i = 0; i < items.length; i++) {
            if (items[i].star != undefined) { star = true }
            if (items[i].from != undefined) { from = items[i].from }
            if (items[i].to != undefined) { to = items[i].to }
        }
        return function(s) { return substOp(s, from, to, star) }
    }
    function mkVarRef(items) {                     // [{nm}, mod?]
        var nm = items[0].nm
        var mod = (items.length > 1) ? items[1] : null
        return function() {
            var v = snapVal(nm)
            if (mod != null) { v = mod(v) }
            return v
        }
    }
    function mkBangRef(items) {                    // [{nm}, mod?]
        var nm = items[0].nm
        var mod = (items.length > 1) ? items[1] : null
        return function() {
            if (!delayedOn) { return "!" + nm + "!" }
            var v = liveVal(nm)
            if (mod != null) { v = mod(v) }
            return v
        }
    }
    function mkForRef(items) {                     // [{mods}?, {fv}]
        var letter = items[items.length - 1].fv
        var mods = modsOf(items, items.length - 1)
        return function() {
            var v = getForVar(letter)
            return (mods == null) ? v : applyMods(mods, v)
        }
    }
    function mkParamRef(items) {                   // [{mods}?, {pn}]
        var n = toInt(items[items.length - 1].pn)
        var mods = modsOf(items, items.length - 1)
        // Inside `call :label` a %0 is the label, but a modifier that splits a path
        // (%~n0, %~dp0) still names the batch file (wine's cmd tests).
        var file0 = n == 0 && mods != null && mods != ""
        return function() {
            var v = file0 ? argFrames[0].lbl : argAt(n)
            return (mods == null) ? v : applyMods(mods, v)
        }
    }
    function mkParamStar() { return function() { return argTail() } }

    // ===================================================================================
    //  Arithmetic thunks: function() -> 32 bit int
    // ===================================================================================

    function mkANum(s) { var n = toInt(s); return function() { return n } }
    function mkAHex(s) { var n = parseRadix(s, 16, 2); return function() { return n } }
    function mkAOct(s) { var n = parseRadix(s, 8, 1); return function() { return n } }
    function mkAVar(name) { return function() { return toInt(liveVal(name)) } }
    function mkAStr(t) { return function() { return toInt(t()) } }
    function mkANeg(t) { return function() { return (0 - t()) | 0 } }
    function mkANot(t) { return function() { return (t() == 0) ? 1 : 0 } }
    function mkABNot(t) { return function() { return (~t()) | 0 } }
    function aOp(op, l, r) {
        if (op == "+") return (l + r) | 0
        if (op == "-") return (l - r) | 0
        if (op == "*") return Math.imul(l, r)
        if (op == "/") return (r == 0) ? 0 : ((l / r) | 0)
        if (op == "%" || op == "%%") return (r == 0) ? 0 : ((l % r) | 0)
        if (op == "<<") return (l << (r & 31)) | 0
        if (op == ">>") return (l >> (r & 31)) | 0
        if (op == "&") return (l & r) | 0
        if (op == "|") return (l | r) | 0
        if (op == "^") return (l ^ r) | 0
        return 0
    }
    function foldArith(items) {
        if (items.length == 1) return items[0]
        return function() {
            var v = items[0](), i = 1
            for (i = 1; i < items.length; i += 2) { v = aOp(items[i], v, items[i + 1]()) }
            return v
        }
    }
    function foldSeq(items) {
        if (items.length == 1) return items[0]
        return function() {
            var v = 0, i = 0
            for (i = 0; i < items.length; i++) { v = items[i]() }
            return v
        }
    }
    function mkAssign(items) {                     // [name, op, valueThunk]
        var name = items[0], op = items[1], vT = items[2]
        return function() {
            var v = vT()
            var res = v
            if (op != "=") {
                var cur = toInt(liveVal(name))
                res = aOp(op.substring(0, op.length - 1), cur, v)
            }
            setVar(name, intToStr(res))
            return res
        }
    }

    // ===================================================================================
    //  Condition thunks: function() -> boolean
    // ===================================================================================

    function mkDefined(name) { return function(ci) { return isDefined(name) } }
    function mkErrLevel(wT) { return function(ci) { return errlvl >= toInt(wT()) } }
    // The path model (see :description): 0 = absent, 1 = exists and is not a directory,
    // 2 = directory.
    var FSDIRS = ["c:", "c:\x5c", "c:\x5cwindows", "c:\x5cwindows\x5csystem32",
                  "c:\x5cusers", "c:\x5cprogram files", "c:\x5cprogramdata"]
    function fsKind(raw) {
        var s = lower(stripQuotes(raw))
        if (s == "nul" || s == "con" || s == "prn" || s == "aux") { return 1 }
        if (s.length == 4 && (s.substring(0, 3) == "com" || s.substring(0, 3) == "lpt")) {
            var cc = s.charCodeAt(3)
            if (cc >= 49 && cc <= 57) { return 1 }
        }
        if (s.length > 3 && s.charAt(s.length - 1) == "\x5c") { s = s.substring(0, s.length - 1) }
        var i = 0
        for (i = 0; i < FSDIRS.length; i++) { if (s == FSDIRS[i]) { return 2 } }
        return 0
    }
    function mkExist(wT) { return function(ci) { return fsKind(wT()) != 0 } }
    function mkStrCmp(items) {                     // [leftWord, "==", rightWord]
        var lT = items[0], rT = items[2]
        return function(ci) {
            var a = lT(), b = rT()
            if (ci) { a = lower(a); b = lower(b) }
            return a == b
        }
    }
    function mkCmp(items) {                        // [leftWord, OP, rightWord]
        var lT = items[0], opl = items[1], rT = items[2]
        return function(ci) {
            var x = toInt(lT()), y = toInt(rT())
            if (opl == "EQU" || opl == "equ") return x == y
            if (opl == "NEQ" || opl == "neq") return x != y
            if (opl == "LSS" || opl == "lss") return x < y
            if (opl == "LEQ" || opl == "leq") return x <= y
            if (opl == "GTR" || opl == "gtr") return x > y
            if (opl == "GEQ" || opl == "geq") return x >= y
            return false
        }
    }

    // ===================================================================================
    //  Statement thunks: function() -> undefined | signal
    //  signals: {gotoLbl}, {ret: code|null}, {procexit: code}
    // ===================================================================================

    function makeNop() { return function() { return undefined } }
    // A construct this grammar recognizes but does not run: fatal unless
    // -warn-unsupported, which turns it into a warning and a no-op.
    function batUnsup(what, pos) {
        var where = c.file + ":" + c.lineOf(pos)
        if (!c.warnUnsupported) {
            eprintln(what + " not implemented (" + where + "); use -warn-unsupported to ignore")
            exit(2)
        }
        eprintln("warning: " + where + ": " + what + " not implemented (ignored)")
        return makeNop()
    }
    function makeExtCmd(items, pos) { return batUnsup("the command " + items[0], pos) }
    function makePipe(items, pos) { return items.length == 1 ? items[0] : batUnsup("a pipe", pos) }
    function makeGroup(rec) { return rec.body }
    function makeEcho(wordT) { return function() { outLine(wordT()); return undefined } }
    function makeVer() {
        return function() {
            outLine("Microsoft Windows [Version 10.0.19045.0]")
            errlvl = 0
            return undefined
        }
    }
    function makeSet(items) {                      // [name, valueThunk]
        var name = items[0], valT = items[1]
        return function() {
            var v = valT()
            if (v == "") { unsetVar(name) } else { setVar(name, v) }
            return undefined
        }
    }
    function makeSetP(items) {                     // [name, promptThunk] - no stdin here
        var promptT = items[1]
        return function() { promptT(); return undefined }
    }
    function makeSetA(arithT) { return function() { arithT(); return undefined } }
    function makeShift(items) {
        var from = 0
        if (items.length > 0) { from = toInt(items[0].substring(1)) }
        return function() { shiftArgs(from); return undefined }
    }
    function makeSetlocal(opts) {
        return function() {
            var snapV = {}, snapD = {}, i = 0
            for (i = 0; i < varKeys.length; i++) { snapV[varKeys[i]] = vars[varKeys[i]]; snapD[varKeys[i]] = defs[varKeys[i]] }
            localStack.push({v: snapV, d: snapD, dly: delayedOn})
            for (i = 0; i < opts.length; i++) {
                var o = lower(opts[i])
                if (o == "enabledelayedexpansion") { delayedOn = true }
                if (o == "disabledelayedexpansion") { delayedOn = false }
            }
            return undefined
        }
    }
    function makeEndlocal() {
        return function() {
            if (localStack.length == 0) { return undefined }
            var s = localStack.pop()
            var i = 0
            // Record every pre-restore value first, so that `endlocal & set X=%inner%` still
            // sees the local value on the right hand side - cmd expands the whole line first.
            for (i = 0; i < varKeys.length; i++) { noteWrite(varKeys[i]) }
            for (i = 0; i < varKeys.length; i++) {
                var k = varKeys[i]
                if (hasOwn(s.d, k)) { vars[k] = s.v[k]; defs[k] = s.d[k] } else { vars[k] = ""; defs[k] = false }
            }
            delayedOn = s.dly
            return undefined
        }
    }
    // 'call set NAME=text' runs its argument through a SECOND expansion pass.
    function expandPct(s) {
        var out = "", i = 0
        while (i < s.length) {
            if (s.charAt(i) == "%") {
                var j = i + 1, nm = ""
                while (j < s.length && s.charAt(j) != "%") { nm = nm + s.charAt(j); j = j + 1 }
                if (j < s.length && nm.length > 0) { out = out + liveVal(nm); i = j + 1; continue }
            }
            out = out + s.charAt(i); i = i + 1
        }
        return out
    }
    function makeCallSet(items) {
        var name = items[0], valT = items[1]
        return function() {
            var v = expandPct(valT())
            if (v == "") { unsetVar(name) } else { setVar(name, v) }
            return undefined
        }
    }
    function makeGoto(name) { return function() { return {gotoLbl: name} } }
    function makeExitB(items) {
        var codeT = (items.length > 0) ? items[0] : null
        return function() {
            if (codeT == null) { return {retbare: 1} }        // 'exit /b' keeps the old code
            return {ret: toInt(codeT())}
        }
    }
    function makeExit(items) {
        var codeT = (items.length > 0) ? items[0] : null
        return function() { return {procexit: (codeT != null) ? toInt(codeT()) : errlvl} }
    }
    function makeSeq(items) {
        return function() {
            var i = 0, r = undefined
            for (i = 0; i < items.length; i++) {
                r = items[i]()
                if (r != undefined) return r
            }
            return undefined
        }
    }
    // A redirection has nowhere to go in this runtime, so an output redirection swallows the
    // output; an input redirection is a no-op (set /p already reads nothing).
    // items = [{out}..., stmt, {out}...]: the redirections around one statement.
    function makeRedir(items) {
        if (items.length == 1) { return items[0] }
        var out = false, i = 0, si = 0
        for (i = 0; i < items.length; i++) {
            if (items[i].out == undefined) { si = i } else if (items[i].out) { out = true }
        }
        var st = items[si]
        if (!out) { return st }
        return function() {
            capStart()
            var r = st()
            capEnd()
            return r
        }
    }
    function mkRedir(items) {
        var op = "", i = 0
        for (i = 0; i < items.length; i++) { if (items[i].op != undefined) { op = items[i].op } }
        return {out: (op != "<")}
    }
    function makeChain(items) {                    // [stmt, op, stmt, op, stmt, ...]
        if (items.length == 1) { return items[0] }
        return function() {
            var r = items[0]()
            if (r != undefined) { return r }
            var i = 1
            for (i = 1; i < items.length; i += 2) {
                var op = items[i]
                if (op == "&&" && errlvl != 0) { continue }
                if (op == "||" && errlvl == 0) { continue }
                r = items[i + 1]()
                if (r != undefined) { return r }
            }
            return undefined
        }
    }
    // items = [ {neg}|{ci} ..., condThunk, {body:thenSeq}, {body:elseSeq}? ]
    function makeIf(items) {
        var neg = false, ci = false, idx = 0
        while (idx < items.length && items[idx] != null && typeof items[idx] == "object"
               && (items[idx].neg != undefined || items[idx].ci != undefined)) {
            if (items[idx].neg != undefined) { neg = true }
            if (items[idx].ci != undefined) { ci = true }
            idx = idx + 1
        }
        var condT = items[idx]
        var thenT = items[idx + 1].body
        var elseT = (items.length > idx + 2) ? items[idx + 2].body : null
        return function() {
            var c2 = condT(ci)
            if (neg) { c2 = !c2 }
            if (c2) { return thenT() }
            if (elseT != null) { return elseT() }
            return undefined
        }
    }
    // items = [letter, wordThunk..., {body:bodySeq}]
    function makeFor(items) {
        var letter = items[0].fv
        var bodyT = items[items.length - 1].body
        var words = items.slice(1, items.length - 1)
        return function() {
            var j = 0
            for (j = 0; j < words.length; j++) {
                setForVar(letter, words[j]())
                var r = bodyT()
                if (r != undefined) return r
            }
            return undefined
        }
    }
    // items = [letter, startW, stepW, endW, {body}]
    function makeForL(items) {
        var letter = items[0].fv
        var sT = items[1], pT = items[2], eT = items[3]
        var bodyT = items[4].body
        return function() {
            var from = toInt(sT()), step = toInt(pT()), to = toInt(eT())
            if (step == 0) { return undefined }         // cmd would loop forever; refuse to hang
            var i = from
            while ((step > 0) ? (i <= to) : (i >= to)) {
                setForVar(letter, intToStr(i))
                var r = bodyT()
                if (r != undefined) return r
                i = (i + step) | 0
            }
            return undefined
        }
    }

    // ----- for /f: options, tokenizing and the line walk -----
    function parseFOpts(raw) {
        var o = {eol: ";", skip: 0, delims: " \t", tokens: "1", bq: false}
        if (raw == null) { return o }
        var s = raw.substring(1, raw.length - 1)
        var i = 0
        while (i < s.length) {
            while (i < s.length && (s.charAt(i) == " " || s.charAt(i) == "\t")) { i = i + 1 }
            var ks = i
            while (i < s.length && s.charAt(i) != "=" && s.charAt(i) != " " && s.charAt(i) != "\t") { i = i + 1 }
            var key = lower(s.substring(ks, i))
            var val = ""
            if (i < s.length && s.charAt(i) == "=") {
                i = i + 1
                var vs = i
                while (i < s.length && s.charAt(i) != " " && s.charAt(i) != "\t") { i = i + 1 }
                val = s.substring(vs, i)
            }
            if (key == "eol") { o.eol = val }
            if (key == "skip") { o.skip = toInt(val) }
            if (key == "delims") { o.delims = val }
            if (key == "tokens") { o.tokens = val }
            if (key == "usebackq") { o.bq = true }
        }
        return o
    }
    function isDelim(ch, delims) {
        var i = 0
        for (i = 0; i < delims.length; i++) { if (delims.charAt(i) == ch) { return true } }
        return false
    }
    function splitLines(text) {
        var out = [], cur = "", i = 0
        for (i = 0; i < text.length; i++) {
            var ch = text.charAt(i)
            if (ch == "\n") { out.push(cur); cur = "" }
            else if (ch != "\r") { cur = cur + ch }
        }
        if (cur != "") { out.push(cur) }
        return out
    }
    // tokens=1,3 / tokens=* / tokens=1* / tokens=2-4 -> a list of 1-based indices + a star flag
    function parseTokens(spec) {
        var nums = [], star = false, i = 0, cur = "", lastNum = 0
        var s = spec + ","
        for (i = 0; i < s.length; i++) {
            var ch = s.charAt(i)
            if (ch == "*") { star = true; continue }
            if (ch == ",") {
                if (cur != "") {
                    var dash = -1, k = 0
                    for (k = 1; k < cur.length; k++) { if (cur.charAt(k) == "-") { dash = k } }
                    if (dash > 0) {
                        var a = toInt(cur.substring(0, dash)), b = toInt(cur.substring(dash + 1))
                        var j = a
                        while (j <= b) { nums.push(j); lastNum = j; j = j + 1 }
                    } else { var n1 = toInt(cur); nums.push(n1); lastNum = n1 }
                }
                cur = ""
                continue
            }
            cur = cur + ch
        }
        return {nums: nums, star: star, last: lastNum}
    }
    function forFTokens(line, delims, spec) {
        var toks = [], starts = [], ends = []
        var i = 0, n = line.length
        while (i < n) {
            while (i < n && isDelim(line.charAt(i), delims)) { i = i + 1 }
            if (i >= n) { break }
            var st = i
            while (i < n && !isDelim(line.charAt(i), delims)) { i = i + 1 }
            toks.push(line.substring(st, i)); starts.push(st); ends.push(i)
        }
        if (toks.length == 0) { return null }
        var out = [], k = 0
        for (k = 0; k < spec.nums.length; k++) {
            var idx = spec.nums[k]
            out.push((idx >= 1 && idx <= toks.length) ? toks[idx - 1] : "")
        }
        if (spec.star) {
            var rest = ""
            if (spec.last == 0) { rest = line.substring(starts[0]) }
            else if (spec.last <= toks.length) {
                var p = ends[spec.last - 1]
                while (p < n && isDelim(line.charAt(p), delims)) { p = p + 1 }
                rest = line.substring(p)
            }
            out.push(rest)
        }
        return out
    }
    // items = [{opts}?, letter, {lit}|{cmd}, {body}]
    function makeForF(items, pos) {
        var idx = 0, optRaw = null
        if (items[0].opts != undefined) { optRaw = items[0].opts; idx = 1 }
        var letter = items[idx].fv
        var src = items[idx + 1]
        var bodyT = items[idx + 2].body
        // usebackq turns 'text' into a literal string and `cmd` into the command; the
        // command half of each pairing is modelled, the other half is not.
        var bqOpt = optRaw != null && lower(optRaw).indexOf("usebackq") >= 0
        if (src.cmd != undefined && (src.bq == true) != bqOpt) {
            return batUnsup("for /f over a usebackq 'string' (or a `command` without it)", pos)
        }
        return function() {
            var o = parseFOpts(optRaw)
            var spec = parseTokens(o.tokens)
            var text = ""
            if (src.lit != undefined && o.bq) { src.lit(); text = "" }       // a file name
            else if (src.lit != undefined) { text = stripQuotes(src.lit()) }
            else if (src.file != undefined) { src.file(); text = "" }   // no contents in the model
            else { capStart(); src.cmd(); text = capEnd() }
            var lines = splitLines(text)
            var i = 0
            for (i = o.skip; i < lines.length; i++) {
                var line = lines[i]
                if (o.eol != "" && line.length > 0 && line.charAt(0) == o.eol.charAt(0)) { continue }
                var vals = forFTokens(line, o.delims, spec)
                if (vals == null) { continue }
                var k = 0
                for (k = 0; k < vals.length; k++) { setForVar(nextLetter(letter, k), vals[k]) }
                var r = bodyT()
                if (r != undefined) return r
            }
            return undefined
        }
    }

    // ===================================================================================
    //  The program counter: runs the flat line list, honouring goto/call/exit.
    // ===================================================================================

    var progItems = null
    var progLabels = null
    // 'call :label' runs the subroutine INLINE, right where the call stands. Returning a
    // signal to the program counter instead would make every enclosing block treat the call
    // as a control transfer (a 'call' inside a for body would end the loop).
    function batCall(label, args) {
        if (progItems == null || !hasOwn(progLabels, "$" + label)) {
            println("The system cannot find the batch label specified - " + label)
            exit(1)
        }
        // cmd.exe expanded this whole line before it started, so a %VAR% that FOLLOWS the
        // call must still read the pre-call value. Freeze every name into the caller's
        // overlay here (noteWrite keeps the earliest value, so this is idempotent).
        var f = 0
        for (f = 0; f < varKeys.length; f++) { noteWrite(varKeys[f]) }
        argFrames.push({lbl: ":" + label, a: args})
        var savedLine = lineOld
        var pc = progLabels["$" + label] + 1
        var out = undefined
        while (pc < progItems.length) {
            var it = progItems[pc]
            if (it.lbl != undefined) { break }          // running into the next label ends it
            lineOld = {}
            var sig = it.stmt()
            if (sig != undefined) {
                if (sig.procexit != undefined) { out = sig; break }
                if (sig.retbare != undefined) { break }
                if (sig.ret != undefined) { errlvl = sig.ret; break }
                if (sig.gotoLbl != undefined) {
                    if (sig.gotoLbl == "eof") { break }
                    if (!hasOwn(progLabels, "$" + sig.gotoLbl)) {
                        println("The system cannot find the batch label specified - " + sig.gotoLbl)
                        exit(1)
                    }
                    pc = progLabels["$" + sig.gotoLbl] + 1
                    continue
                }
            }
            pc = pc + 1
        }
        lineOld = savedLine
        argFrames.pop()
        return out
    }
    function makeCall(items) {
        var label = items[0]
        var argTs = items.slice(1)
        return function() {
            var args = [], i = 0
            for (i = 0; i < argTs.length; i++) { args.push(argTs[i]()) }
            return batCall(label, args)
        }
    }

    function runProgram(items) {
        var labelMap = {}
        var i = 0
        for (i = 0; i < items.length; i++) {
            if (items[i].lbl != undefined) { labelMap["$" + items[i].lbl] = i }
        }
        progItems = items
        progLabels = labelMap
        var pc = 0
        while (pc < items.length) {
            var it = items[pc]
            if (it.lbl != undefined) { pc = pc + 1; continue }
            lineOld = {}
            var sig = it.stmt()
            if (sig == undefined) { pc = pc + 1; continue }
            if (sig.procexit != undefined) { exit(sig.procexit) }
            if (sig.gotoLbl != undefined) {
                if (sig.gotoLbl == "eof") { exit(errlvl) }
                if (hasOwn(labelMap, "$" + sig.gotoLbl)) { pc = labelMap["$" + sig.gotoLbl]; continue }
                println("The system cannot find the batch label specified - " + sig.gotoLbl)
                exit(1)
            }
            if (sig.retbare != undefined) { exit(errlvl) }
            if (sig.ret != undefined) { exit(sig.ret) }
            pc = pc + 1
        }
        exit(errlvl)
        return undefined
    }

    c.compile(c.asg)

~~) ;
