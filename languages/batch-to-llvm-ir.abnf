            if (op == "EQU" || op == "equ") { pred = EQ }
            if (op == "NEQ" || op == "neq") { pred = NE }
            if (op == "LSS" || op == "lss") { pred = SLT }
            if (op == "LEQ" || op == "leq") { pred = SLE }
            if (op == "GTR" || op == "gtr") { pred = SGT }
            if (op == "GEQ" || op == "geq") { pred = SGE }
