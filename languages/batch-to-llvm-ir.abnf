    // ===================================================================================
    //  Statement thunks (bare functions):  function(b) -> continuation block.
    // ===================================================================================

    var Lblocks = null      // one block per top-level item (+ end)
    var labelIdx = null
    var exitBlock = null
    var returnDispatch = null
    var retSites = []
    var batSetlocal = null, batEndlocal = null, batShift = null, batLookup = null, rtExpand = null

    function makeNop() { return function(b) { return b } }
    function makeGroup(rec) { return rec.body }
    function makeEcho(wordT) {
        return function(b) {
            var r = wordT.fn(b)
            b = r.b
            b.NewCall(rtPrintln, r.v)
            return b
        }
    }
    function makeVer() {
        return function(b) {
            b.NewCall(rtPrintln, gepStr(b, "Microsoft Windows [Version 10.0.19045.0]"))
            b.NewStore(zero, gErrLvl)
            return b
        }
    }
    function makeSet(items) {
        var name = items[0], valT = items[1]
        return function(b) {
            var r = valT.fn(b)
            b = r.b
            var isEmpty = b.NewICmp(EQ, b.NewCall(rtStrlen, r.v), zero)
            b.NewStore(r.v, getVarSlot(name))
            b.NewStore(b.NewSelect(isEmpty, zero, one), getDefSlot(name))
            return b
        }
    }
    function makeSetP(items) {                     // no stdin here: the prompt is evaluated only
        var promptT = items[1]
        return function(b) { var r = promptT.fn(b); return r.b }
    }
    function makeSetA(arithT) { return function(b) { var r = arithT(b); return r.b } }
    function makeShift(items) {
        var from = 0
        if (items.length > 0) { from = parseDec(items[0].substring(1)) }
        return function(b) { b.NewCall(batShift, ci32(from)); return b }
    }
    function makeSetlocal(opts) {
        var dly = 0                                // 0 = leave, 1 = enable, 2 = disable
        var i
        for (i = 0; i < opts.length; i++) {
            var o = lower(opts[i])
            if (o == "enabledelayedexpansion") { dly = 1 }
            if (o == "disabledelayedexpansion") { dly = 2 }
        }
        return function(b) {
            b.NewCall(batSetlocal)
            if (dly == 1) { b.NewStore(one, gDelayed) }
            if (dly == 2) { b.NewStore(zero, gDelayed) }
            return b
        }
    }
    function makeEndlocal() { return function(b) { b.NewCall(batEndlocal); return b } }
    function makeCallSet(items) {
        var name = items[0], valT = items[1]
        return function(b) {
            var r = valT.fn(b)
            b = r.b
            var v = b.NewCall(rtExpand, r.v)
            var isEmpty = b.NewICmp(EQ, b.NewCall(rtStrlen, v), zero)
            b.NewStore(v, getVarSlot(name))
            b.NewStore(b.NewSelect(isEmpty, zero, one), getDefSlot(name))
            return b
        }
    }

    // Pop a return id (or leave main with the current errorlevel when the stack is empty).
    function emitReturn(b) {
        var sp = b.NewLoad(i32, gCsp)
        var exitP = nb(), popP = nb()
        b.NewCondBr(b.NewICmp(EQ, sp, zero), exitP, popP)
        exitP.NewStore(exitP.NewLoad(i32, gErrLvl), gExitCode)
        exitP.NewBr(exitBlock)
        var sp2 = popP.NewSub(sp, one)
        popP.NewStore(sp2, gCsp)
        popP.NewStore(popP.NewLoad(i32, popP.NewGetElementPtr(cstackTy, gCstack, zero, sp2)), gRetId)
        popP.NewBr(returnDispatch)
    }
    function labelMissing(b, name) {
        b.NewCall(rtPrintln, gepStr(b, "The system cannot find the batch label specified - " + name))
        b.NewStore(one, gExitCode)
        b.NewBr(exitBlock)
    }
    function makeGoto(name) {
        return function(b) {
            if (name == "eof") { emitReturn(b); return deadBlock() }
            if (!hasOwn(labelIdx, "$" + name)) { labelMissing(b, name); return deadBlock() }
            b.NewBr(Lblocks[labelIdx["$" + name]])
            return deadBlock()
        }
    }
    function makeCall(items) {
        var label = items[0]
        var argTs = items.slice(1)
        return function(b) {
            if (!hasOwn(labelIdx, "$" + label)) { labelMissing(b, label); return deadBlock() }
            // Evaluate the arguments in the CALLER's frame, then open a new one.
            var vals = [], tail = null, i
            for (i = 0; i < argTs.length; i++) {
                var r = argTs[i].fn(b)
                b = r.b
                vals.push(r.v)
                tail = (tail == null) ? r.v : b.NewCall(rtStrcat, [b.NewCall(rtStrcat, [tail, gepStr(b, " ")]), r.v])
            }
            if (tail == null) { tail = emptyPtr(b) }
            var fr = b.NewAdd(b.NewLoad(i32, gFrame), one)
            var base = b.NewMul(fr, ci32(ARGN))
            for (i = 0; i < ARGN; i++) {
                var v = (i < vals.length) ? vals[i] : emptyPtr(b)
                b.NewStore(v, b.NewGetElementPtr(argsTy, gArgs, zero, b.NewAdd(base, ci32(i))))
            }
            b.NewStore(tail, b.NewGetElementPtr(frameTy, gArgTail, zero, fr))
            b.NewStore(gepStr(b, ":" + label), b.NewGetElementPtr(frameTy, gArgLbl, zero, fr))
            b.NewStore(fr, gFrame)
            // The call returns to RIGHT HERE, not to the next top-level line: a fresh
            // continuation block is registered as the return site and handed back as the
            // current block. Returning to the next line instead made a 'call' inside a for
            // body end the LOOP after one round.
            var contB = nb()
            var retid = retSites.length
            retSites.push(contB)
            var sp = b.NewLoad(i32, gCsp)
            b.NewStore(ci32(retid), b.NewGetElementPtr(cstackTy, gCstack, zero, sp))
            b.NewStore(b.NewAdd(sp, one), gCsp)
            b.NewBr(Lblocks[labelIdx["$" + label]])
            contB.NewStore(contB.NewSub(contB.NewLoad(i32, gFrame), one), gFrame)
            return contB
        }
    }
    function makeExitB(items) {
        var codeT = (items.length > 0) ? items[0] : null
        return function(b) {
            if (codeT != null) {
                var r = codeT.fn(b); b = r.b
                b.NewStore(b.NewCall(rtStr2int, r.v), gErrLvl)
            }
            emitReturn(b)
            return deadBlock()
        }
    }
    function makeExit(items) {
        var codeT = (items.length > 0) ? items[0] : null
        return function(b) {
            var code = b.NewLoad(i32, gErrLvl)
            if (codeT != null) { var r = codeT.fn(b); b = r.b; code = b.NewCall(rtStr2int, r.v) }
            b.NewStore(code, gExitCode)
            b.NewBr(exitBlock)
            return deadBlock()
        }
    }
    function makeSeq(items) {
        return function(b) {
            var i
            for (i = 0; i < items.length; i++) { b = items[i](b) }
            return b
        }
    }
    function mkRedir(items) {
        var op = "", i
        for (i = 0; i < items.length; i++) { if (items[i].op != undefined) { op = items[i].op } }
        return {out: (op != "<")}
    }
    function makeRedir(items) {
        var st = items[0]
        if (items.length == 1) { return st }
        var out = false, i
        for (i = 1; i < items.length; i++) { if (items[i].out) { out = true } }
        if (!out) { return st }
        return function(b) {
            b.NewCall(rtCapStart)
            b = st(b)
            b.NewCall(rtCapEnd)
            return b
        }
    }
    function makeChain(items) {
        if (items.length == 1) { return items[0] }
        return function(b) {
            b = items[0](b)
            var i
            for (i = 1; i < items.length; i += 2) {
                var op = items[i]
                if (op == "&") { b = items[i + 1](b); continue }
                var el = b.NewLoad(i32, gErrLvl)
                var cond = (op == "&&") ? b.NewICmp(EQ, el, zero) : b.NewICmp(NE, el, zero)
                var runB = nb(), skipB = nb()
                b.NewCondBr(cond, runB, skipB)
                items[i + 1](runB).NewBr(skipB)
                b = skipB
            }
            return b
        }
    }
    function makeIf(items) {
        var neg = false, ci = false, idx = 0
        while (idx < items.length && items[idx] != null && typeof items[idx] == "object"
               && (items[idx].neg != undefined || items[idx].ci != undefined)) {
            if (items[idx].neg != undefined) { neg = true }
            if (items[idx].ci != undefined) { ci = true }
            idx = idx + 1
        }
        var condT = items[idx]
        var thenT = items[idx + 1].body
        var elseT = (items.length > idx + 2) ? items[idx + 2].body : null
        return function(b) {
            var rc = condT(b, ci)
            b = rc.b
            var cond = rc.v
            if (neg) { cond = b.NewXor(cond, truei1) }
            var thenB = nb(), merge = nb()
            var elseB = (elseT != null) ? nb() : merge
            b.NewCondBr(cond, thenB, elseB)
            thenT(thenB).NewBr(merge)
            if (elseT != null) { elseT(elseB).NewBr(merge) }
            return merge
        }
    }
    // items = [letter, wordObj..., {body:bodySeq}]. The word list is static -> unrolled.
    function makeFor(items) {
        var letter = items[0].fv
        var bodyT = items[items.length - 1].body
        var words = items.slice(1, items.length - 1)
        return function(b) {
            var j
            for (j = 0; j < words.length; j++) {
                var r = words[j].fn(b)
                b = r.b
                b.NewStore(r.v, getForSlot(letter))
                b = bodyT(b)
            }
            return b
        }
    }
    // for /l: a real counted loop. Counter, step and end live in globals rather than phis,
    // so a `call` in the body (which returns through the shared dispatch block, and so does
    // not preserve dominance) cannot invalidate them.
    var loopCount = 0
    function makeForL(items) {
        var letter = items[0].fv
        var sT = items[1], pT = items[2], eT = items[3]
        var bodyT = items[4].body
        loopCount = loopCount + 1
        var gI = m.NewGlobalDef("fl_i" + loopCount, zero)
        var gStep = m.NewGlobalDef("fl_s" + loopCount, zero)
        var gEnd = m.NewGlobalDef("fl_e" + loopCount, zero)
        return function(b) {
            var r1 = sT.fn(b); b = r1.b
            b.NewStore(b.NewCall(rtStr2int, r1.v), gI)
            var r2 = pT.fn(b); b = r2.b
            b.NewStore(b.NewCall(rtStr2int, r2.v), gStep)
            var r3 = eT.fn(b); b = r3.b
            b.NewStore(b.NewCall(rtStr2int, r3.v), gEnd)
            var head = nb(), body = nb(), done = nb()
            b.NewBr(head)
            var iv = head.NewLoad(i32, gI), sv = head.NewLoad(i32, gStep), ev = head.NewLoad(i32, gEnd)
            var up = head.NewICmp(SGT, sv, zero)
            var goOn = head.NewSelect(up, head.NewICmp(SLE, iv, ev), head.NewICmp(SGE, iv, ev))
            var alive = head.NewAnd(goOn, head.NewICmp(NE, sv, zero))
            head.NewCondBr(alive, body, done)
            body.NewStore(body.NewCall(rtInt2str, body.NewLoad(i32, gI)), getForSlot(letter))
            var after = bodyT(body)
            after.NewStore(after.NewAdd(after.NewLoad(i32, gI), after.NewLoad(i32, gStep)), gI)
            after.NewBr(head)
            return done
        }
    }
    // ----- for /f -----
    function parseFOpts(raw) {
        var o = {eol: ";", skip: 0, delims: " \t", tokens: "1"}
        if (raw == null) { return o }
        var s = raw.substring(1, raw.length - 1)
        var i = 0
        while (i < s.length) {
            while (i < s.length && (s.charAt(i) == " " || s.charAt(i) == "\t")) { i = i + 1 }
            var ks = i
            while (i < s.length && s.charAt(i) != "=" && s.charAt(i) != " " && s.charAt(i) != "\t") { i = i + 1 }
            var key = lower(s.substring(ks, i))
            var val = ""
            if (i < s.length && s.charAt(i) == "=") {
                i = i + 1
                var vs = i
                while (i < s.length && s.charAt(i) != " " && s.charAt(i) != "\t") { i = i + 1 }
                val = s.substring(vs, i)
            }
            if (key == "eol") { o.eol = val }
            if (key == "skip") { o.skip = parseDec(val) }
            if (key == "delims") { o.delims = val }
            if (key == "tokens") { o.tokens = val }
        }
        return o
    }
    function parseTokens(spec) {
        var nums = [], star = false, cur = "", lastNum = 0, i
        var s = spec + ","
        for (i = 0; i < s.length; i++) {
            var ch = s.charAt(i)
            if (ch == "*") { star = true; continue }
            if (ch == ",") {
                if (cur != "") {
                    var dash = -1, k
                    for (k = 1; k < cur.length; k++) { if (cur.charAt(k) == "-") { dash = k } }
                    if (dash > 0) {
                        var a = parseDec(cur.substring(0, dash)), z = parseDec(cur.substring(dash + 1))
                        var j = a
                        while (j <= z) { nums.push(j); lastNum = j; j = j + 1 }
                    } else { var n1 = parseDec(cur); nums.push(n1); lastNum = n1 }
                }
                cur = ""
                continue
            }
            cur = cur + ch
        }
        return {nums: nums, star: star, last: lastNum}
    }
    function makeForF(items) {
        var idx = 0, optRaw = null
        if (items[0].opts != undefined) { optRaw = items[0].opts; idx = 1 }
        var letter = items[idx].fv
        var src = items[idx + 1]
        var bodyT = items[idx + 2].body
        var o = parseFOpts(optRaw)
        var spec = parseTokens(o.tokens)
        loopCount = loopCount + 1
        var gText = m.NewGlobalDef("ff_t" + loopCount, nullStr)
        var gIdx = m.NewGlobalDef("ff_i" + loopCount, zero)
        return function(b) {
            var txt
            if (src.lit != undefined) {
                var r = src.lit.fn(b); b = r.b
                txt = b.NewCall(rtStripq, r.v)
            } else if (src.file != undefined) {
                var rf = src.file.fn(b); b = rf.b
                txt = emptyPtr(b)                      // no contents in the path model
            } else {
                b.NewCall(rtCapStart)
                b = src.cmd(b)
                txt = b.NewCall(rtCapEnd)
            }
            b.NewStore(txt, gText)
            b.NewStore(ci32(o.skip), gIdx)
            var head = nb(), body = nb(), cont = nb(), done = nb()
            b.NewBr(head)
            var t = head.NewLoad(i8ptr, gText)
            var iv = head.NewLoad(i32, gIdx)
            head.NewCondBr(head.NewICmp(SGE, iv, head.NewCall(rtNlines, t)), done, body)
            var line = body.NewCall(rtLineat, [t, iv])
            var dl = gepStr(body, o.delims)
            // skip a comment line (eol=) and a line with no tokens at all
            var bad = body.NewICmp(SLT, body.NewCall(rtTokb, [line, dl, one, zero]), zero)
            if (o.eol != "") {
                var c0 = body.NewSExt(body.NewLoad(i8, body.NewGetElementPtr(i8, line, zero)), i32)
                bad = body.NewOr(bad, body.NewICmp(EQ, c0, ci32(o.eol.charCodeAt(0))))
            }
            var run = nb()
            body.NewCondBr(bad, cont, run)
            var k
            for (k = 0; k < spec.nums.length; k++) {
                var tk = spec.nums[k]
                var st = run.NewCall(rtTokb, [line, dl, ci32(tk), zero])
                var en = run.NewCall(rtTokb, [line, dl, ci32(tk), one])
                var have = run.NewICmp(SGE, st, zero)
                var val = run.NewCall(rtSub, [line, run.NewSelect(have, st, zero), run.NewSelect(have, en, zero)])
                run.NewStore(val, getForSlot(nextLetter(letter, k)))
            }
            if (spec.star) {
                var rest
                if (spec.last == 0) {
                    var s0 = run.NewCall(rtTokb, [line, dl, one, zero])
                    rest = run.NewCall(rtSub, [line, s0, run.NewCall(rtStrlen, line)])
                } else {
                    var p0 = run.NewCall(rtTokb, [line, dl, ci32(spec.last), two])
                    var okp = run.NewICmp(SGE, p0, zero)
                    var ln = run.NewCall(rtStrlen, line)
                    rest = run.NewCall(rtSub, [line, run.NewSelect(okp, p0, ln), ln])
                }
                run.NewStore(rest, getForSlot(nextLetter(letter, spec.nums.length)))
            }
            bodyT(run).NewBr(cont)
            cont.NewStore(cont.NewAdd(cont.NewLoad(i32, gIdx), one), gIdx)
            cont.NewBr(head)
            return done
        }
    }

    // ===================================================================================
    //  Program: the flat line list becomes a chain of blocks driven by branches.
    // ===================================================================================

    function fillReturnDispatch() {
        if (retSites.length == 0) { returnDispatch.NewBr(exitBlock); return }
        var rid = returnDispatch.NewLoad(i32, gRetId)
        var cur = returnDispatch, i
        for (i = 0; i < retSites.length; i++) {
            var isMatch = cur.NewICmp(EQ, rid, ci32(i))
            var nextChk = (i < retSites.length - 1) ? nb() : exitBlock
            cur.NewCondBr(isMatch, retSites[i], nextChk)
            cur = nextChk
        }
    }

    // setlocal / endlocal snapshot the whole environment. The slot list is only complete
    // once every line has been emitted, so the two functions are declared up front and
    // their bodies are filled in at the end.
    function fillLocals() {
        var N = varSlotList.length
        if (N == 0) { N = 1 }
        var LDEPTH = 32
        var lvTy = llvm.types.NewArray(LDEPTH * N, i8ptr)
        var ldTy = llvm.types.NewArray(LDEPTH * N, i32)
        var gLv = m.NewGlobalDef("loc_v", llvm.constant.NewZeroInitializer(lvTy))
        var gLd = m.NewGlobalDef("loc_d", llvm.constant.NewZeroInitializer(ldTy))
        var gLy = m.NewGlobalDef("loc_dly", llvm.constant.NewZeroInitializer(llvm.types.NewArray(LDEPTH, i32)))
        var gLsp = m.NewGlobalDef("loc_sp", zero)
        var i
        var e = batSetlocal.NewBlock("entry")
        var sp = e.NewLoad(i32, gLsp)
        var base = e.NewMul(sp, ci32(N))
        for (i = 0; i < varSlotList.length; i++) {
            e.NewStore(e.NewLoad(i8ptr, varSlotList[i]), e.NewGetElementPtr(lvTy, gLv, zero, e.NewAdd(base, ci32(i))))
            e.NewStore(e.NewLoad(i32, defSlotList[i]), e.NewGetElementPtr(ldTy, gLd, zero, e.NewAdd(base, ci32(i))))
        }
        e.NewStore(e.NewLoad(i32, gDelayed), e.NewGetElementPtr(llvm.types.NewArray(LDEPTH, i32), gLy, zero, sp))
        e.NewStore(e.NewAdd(sp, one), gLsp)
        e.NewRet(zero)
        var x = batEndlocal.NewBlock("entry")
        var xEmpty = batEndlocal.NewBlock("empty"), xPop = batEndlocal.NewBlock("pop")
        var sp0 = x.NewLoad(i32, gLsp)
        x.NewCondBr(x.NewICmp(EQ, sp0, zero), xEmpty, xPop)
        xEmpty.NewRet(zero)
        var sp1 = xPop.NewSub(sp0, one)
        xPop.NewStore(sp1, gLsp)
        var base2 = xPop.NewMul(sp1, ci32(N))
        for (i = 0; i < varSlotList.length; i++) {
            xPop.NewStore(xPop.NewLoad(i8ptr, xPop.NewGetElementPtr(lvTy, gLv, zero, xPop.NewAdd(base2, ci32(i)))), varSlotList[i])
            xPop.NewStore(xPop.NewLoad(i32, xPop.NewGetElementPtr(ldTy, gLd, zero, xPop.NewAdd(base2, ci32(i)))), defSlotList[i])
        }
        xPop.NewStore(xPop.NewLoad(i32, xPop.NewGetElementPtr(llvm.types.NewArray(LDEPTH, i32), gLy, zero, sp1)), gDelayed)
        xPop.NewRet(zero)
    }
    function fillShift() {
        var from = batShift.Params[0]
        var e = batShift.NewBlock("entry"), h = batShift.NewBlock("h")
        var bd = batShift.NewBlock("bd"), x = batShift.NewBlock("x")
        var base = e.NewMul(e.NewLoad(i32, gFrame), ci32(ARGN))
        var ip = e.NewAlloca(i32)
        e.NewStore(from, ip); e.NewBr(h)
        var i = h.NewLoad(i32, ip)
        h.NewCondBr(h.NewICmp(SGE, i, ci32(ARGN - 1)), x, bd)
        bd.NewStore(bd.NewLoad(i8ptr, bd.NewGetElementPtr(argsTy, gArgs, zero, bd.NewAdd(bd.NewAdd(base, i), one))),
                    bd.NewGetElementPtr(argsTy, gArgs, zero, bd.NewAdd(base, i)))
        bd.NewStore(bd.NewAdd(i, one), ip); bd.NewBr(h)
        x.NewStore(emptyPtr(x), x.NewGetElementPtr(argsTy, gArgs, zero, x.NewAdd(base, ci32(ARGN - 1))))
        x.NewRet(zero)
    }
    // bat_lookup(name) backs the SECOND expansion pass of `call set NAME=%%%indirect%%%`.
    function fillLookup() {
        var nm = batLookup.Params[0]
        var cur = batLookup.NewBlock("entry"), i
        for (i = 0; i < varNameList.length; i++) {
            var hit = batLookup.NewBlock(""), miss = batLookup.NewBlock("")
            cur.NewCondBr(cur.NewICmp(NE, cur.NewCall(rtStreqi, [nm, gepStr(cur, varNameList[i])]), zero), hit, miss)
            hit.NewRet(hit.NewLoad(i8ptr, varSlotList[i]))
            cur = miss
        }
        cur.NewRet(emptyPtr(cur))
    }
    function fillExpand() {
        var s = rtExpand.Params[0]
        var e = rtExpand.NewBlock("entry"), h = rtExpand.NewBlock("h")
        var bd = rtExpand.NewBlock("bd"), pct = rtExpand.NewBlock("pct")
        var name = rtExpand.NewBlock("name"), lit = rtExpand.NewBlock("lit"), x = rtExpand.NewBlock("x")
        var n = e.NewCall(rtStrlen, s)
        var op = e.NewAlloca(i8ptr), ip = e.NewAlloca(i32)
        e.NewStore(emptyPtr(e), op); e.NewStore(zero, ip); e.NewBr(h)
        var i = h.NewLoad(i32, ip)
        h.NewCondBr(h.NewICmp(SGE, i, n), x, bd)
        var ch = bd.NewSExt(bd.NewLoad(i8, bd.NewGetElementPtr(i8, s, i)), i32)
        bd.NewCondBr(bd.NewICmp(EQ, ch, ci32(37)), pct, lit)
        var j = pct.NewCall(rtFindch, [s, ci32(37), pct.NewAdd(i, one)])
        pct.NewCondBr(pct.NewAnd(pct.NewICmp(SGE, j, zero), pct.NewICmp(SGT, j, pct.NewAdd(i, one))), name, lit)
        var got = name.NewCall(batLookup, name.NewCall(rtSub, [s, name.NewAdd(i, one), j]))
        name.NewStore(name.NewCall(rtStrcat, [name.NewLoad(i8ptr, op), got]), op)
        name.NewStore(name.NewAdd(j, one), ip); name.NewBr(h)
        lit.NewStore(lit.NewCall(rtStrcat, [lit.NewLoad(i8ptr, op), lit.NewCall(rtSub, [s, i, lit.NewAdd(i, one)])]), op)
        lit.NewStore(lit.NewAdd(i, one), ip); lit.NewBr(h)
        x.NewRet(x.NewLoad(i8ptr, op))
    }

    function runProgram(items) {
        batSetlocal = m.NewFunc("bat_setlocal", i32)
        batEndlocal = m.NewFunc("bat_endlocal", i32)
        batShift = m.NewFunc("bat_shift", i32, llvm.ir.NewParam("from", i32))
        batLookup = m.NewFunc("bat_lookup", i8ptr, llvm.ir.NewParam("nm", i8ptr))
        rtExpand = m.NewFunc("rt_expand", i8ptr, llvm.ir.NewParam("s", i8ptr))
        var main = m.NewFunc("main", i32)
        curF = main
        var entry = main.NewBlock("entry")
        exitBlock = main.NewBlock("exit")
        returnDispatch = main.NewBlock("retdisp")
        Lblocks = []
        var k
        for (k = 0; k < items.length; k++) { Lblocks.push(main.NewBlock("L" + k)) }
        Lblocks.push(main.NewBlock("Lend")) // one past the end
        labelIdx = {}
        for (k = 0; k < items.length; k++) { if (items[k].lbl != undefined) { labelIdx["$" + items[k].lbl] = k } }
        // Emit each line into its block; fall-through branches to the next block. Lblocks[k]
        // is the line PROLOGUE: the %VAR% snapshot stores land there, and it is terminated
        // only once the whole line has been emitted.
        for (k = 0; k < items.length; k++) {
            var it = items[k]
            if (it.lbl != undefined) {
                Lblocks[k].NewBr(Lblocks[k + 1])
            } else {
                linePro = Lblocks[k]
                lineNoted = {}
                var body = main.NewBlock("S" + k)
                var cont = it.stmt(body)
                cont.NewBr(Lblocks[k + 1])
                linePro.NewBr(body)
            }
        }
        // Falling off the end -> exit with the current errorlevel.
        Lblocks[items.length].NewStore(Lblocks[items.length].NewLoad(i32, gErrLvl), gExitCode)
        Lblocks[items.length].NewBr(exitBlock)
        exitBlock.NewRet(exitBlock.NewLoad(i32, gExitCode))
        fillReturnDispatch()
        fillLocals(); fillShift(); fillLookup(); fillExpand()
        // entry: initialize every slot, empty the stacks, jump to the first line.
        var ep = emptyPtr(entry)
        var i
        for (i = 0; i < varSlotList.length; i++) { entry.NewStore(ep, varSlotList[i]) }
        for (i = 0; i < pctSlotList.length; i++) { entry.NewStore(ep, pctSlotList[i]) }
        for (i = 0; i < forSlotList.length; i++) { entry.NewStore(ep, forSlotList[i]) }
        for (i = 0; i < defSlotList.length; i++) { entry.NewStore(zero, defSlotList[i]) }
        for (i = 0; i < ARGN; i++) { entry.NewStore(ep, entry.NewGetElementPtr(argsTy, gArgs, zero, ci32(i))) }
        entry.NewStore(ep, entry.NewGetElementPtr(frameTy, gArgTail, zero, zero))
        entry.NewStore(ep, entry.NewGetElementPtr(frameTy, gArgLbl, zero, zero))
        entry.NewStore(zero, gCsp)
        entry.NewStore(zero, gFrame)
        entry.NewStore(zero, gCapSp)
        entry.NewStore(zero, gErrLvl)
        entry.NewStore(zero, gDelayed)
        entry.NewBr(items.length > 0 ? Lblocks[0] : exitBlock)
    }

    c.compile(c.asg)

    // With -exe PATH, link the module into a native executable (clang) instead of
    // running it in the built-in IR interpreter.
    if (c.exePath != undefined && c.exePath != "") {
        var buildErr = llvm.BuildExecutable(m, c.exePath)
        if (buildErr != "") { println(buildErr); exit(1) }
        println("batch-to-llvm-ir: wrote executable " + c.exePath)
        exit(0)
    }

    println(m)
    var res = llvm.Run(m, "main")
    print(res.Out)
    println("batch-to-llvm-ir: exit status " + res.Ret)
    exit(res.Ret)

~~) ;
