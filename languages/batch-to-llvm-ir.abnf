    // ===================================================================================
    //  Value / word thunks:  {fn: function(b) -> {b, v: i8*}, c: const-string|undefined}
    // ===================================================================================

    function makeStr(s) { return {fn: function(b) { return {b: b, v: gepStr(b, s)} }, c: s} }
    function makeWord(parts) {
        if (parts.length == 0) { return makeStr("") }
        var allConst = true, joined = "", i
        for (i = 0; i < parts.length; i++) {
            if (parts[i].c == undefined) { allConst = false } else { joined = joined + parts[i].c }
        }
        if (allConst) { return makeStr(joined) }
        if (parts.length == 1) { return parts[0] }
        return {fn: function(b) {
            var r = parts[0].fn(b)
            var bb = r.b, v = r.v, k
            for (k = 1; k < parts.length; k++) {
                var r2 = parts[k].fn(bb)
                bb = r2.b
                v = bb.NewCall(rtStrcat, [v, r2.v])
            }
            return {b: bb, v: v}
        }, c: undefined}
    }

    // The %VAR% operators arrive as plain records (a function property would not survive
    // the tag stack), so each one is turned into IR here.
    function mkSubStr(items) {
        var st = 0, ln = 0, hasLen = false, i
        for (i = 0; i < items.length; i++) {
            if (items[i].start != undefined) { st = parseDec(items[i].start) }
            if (items[i].len != undefined) { ln = parseDec(items[i].len); hasLen = true }
        }
        return {kind: "substr", start: st, len: ln, haslen: hasLen}
    }
    function mkSubst(items) {
        var star = false, from = "", to = "", i
        for (i = 0; i < items.length; i++) {
            if (items[i].star != undefined) { star = true }
            if (items[i].from != undefined) { from = items[i].from }
            if (items[i].to != undefined) { to = items[i].to }
        }
        return {kind: "subst", from: from, to: to, star: star}
    }
    function applyMod(b, v, mod) {
        if (mod.kind == "substr") {
            return b.NewCall(rtSubstr, [v, ci32(mod.start), ci32(mod.len), ci32(mod.haslen ? 1 : 0)])
        }
        return b.NewCall(rtSubst, [v, gepStr(b, mod.from), gepStr(b, mod.to), ci32(mod.star ? 1 : 0)])
    }
    // The effective set of path components a ~ modifier run asks for: 1 = drive, 2 = path,
    // 4 = name, 8 = extension; -1 = there was no ~ at all (the value is raw) and -2 = a bare
    // ~ (strip the quotes and nothing else). ~s asks for the SHORT path, which on a volume
    // with 8.3 names switched off is the long one, so it is a no-op flag on top of the others
    // and means the whole path when it stands alone. ~a ~t ~z would have to stat the file,
    // which the path model cannot do, so they ask for nothing - which is also what cmd.exe
    // answers for a file that is not there.
    function maskOf(mods) {
        if (mods == null) { return -1 }
        if (mods == "") { return -2 }
        var mask = 0, i
        for (i = 0; i < mods.length; i++) {
            var ch = lower(mods.charAt(i))
            if (ch == "f") { mask = mask | 15 }
            if (ch == "d") { mask = mask | 1 }
            if (ch == "p") { mask = mask | 2 }
            if (ch == "n") { mask = mask | 4 }
            if (ch == "x") { mask = mask | 8 }
        }
        if (mask == 0 && lower(mods).indexOf("s") >= 0) { mask = 15 }
        return mask
    }
    function applyTilde(b, v, mask) {
        if (mask == -1) { return v }
        if (mask == -2) { return b.NewCall(rtStripq, v) }
        if (mask == 0) { return gepStr(b, "") }
        return b.NewCall(rtMods, [v, ci32(mask)])
    }
    function modsOf(items, upto) {
        var i
        for (i = 0; i < upto; i++) { if (items[i].mods != undefined) { return items[i].mods.substring(1) } }
        return null                               // null = no ~ at all, so the value is raw
    }
    function mkVarRef(items) {
        var nm = items[0].nm
        var mod = (items.length > 1) ? items[1] : null
        var isErr = (lower(nm) == "errorlevel")
        return {fn: function(b) {
            var v
            if (isErr) { v = b.NewCall(rtInt2str, b.NewLoad(i32, gErrLvl)) }
            else { notePct(nm); v = b.NewLoad(i8ptr, getPctSlot(nm)) }
            if (mod != null) { v = applyMod(b, v, mod) }
            return {b: b, v: v}
        }, c: undefined}
    }
    function mkBangRef(items) {
        var nm = items[0].nm
        var mod = (items.length > 1) ? items[1] : null
