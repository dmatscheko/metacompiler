    function mkANum(text) { var k = llvm.constant.NewInt(i32, parseDec(text)); return function(b) { return {b: b, v: k} } }
    function mkAHex(text) { var k = llvm.constant.NewInt(i32, parseRadix(text, 16, 2)); return function(b) { return {b: b, v: k} } }
    function mkAOct(text) { var k = llvm.constant.NewInt(i32, parseRadix(text, 8, 1)); return function(b) { return {b: b, v: k} } }
    function mkAVar(name) { return function(b) { return {b: b, v: b.NewCall(rtStr2int, b.NewLoad(i8ptr, getVarSlot(name)))} } }
    function mkAStr(t) { return function(b) { var r = t.fn(b); return {b: r.b, v: r.b.NewCall(rtStr2int, r.v)} } }
    function mkANeg(t) { return function(b) { var r = t(b); return {b: r.b, v: r.b.NewSub(zero, r.v)} } }
    function mkANot(t) { return function(b) { var r = t(b); return {b: r.b, v: r.b.NewZExt(r.b.NewICmp(EQ, r.v, zero), i32)} } }
    function mkABNot(t) { return function(b) { var r = t(b); return {b: r.b, v: r.b.NewXor(r.v, minusOne)} } }
    function aOp(b, op, l, r) {
        if (op == "+") { return {b: b, v: b.NewAdd(l, r)} }
        if (op == "-") { return {b: b, v: b.NewSub(l, r)} }
        if (op == "*") { return {b: b, v: b.NewMul(l, r)} }
        if (op == "<<") { return {b: b, v: b.NewShl(l, b.NewAnd(r, ci32(31)))} }
        if (op == ">>") { return {b: b, v: b.NewAShr(l, b.NewAnd(r, ci32(31)))} }
        if (op == "&") { return {b: b, v: b.NewAnd(l, r)} }
        if (op == "|") { return {b: b, v: b.NewOr(l, r)} }
        if (op == "^") { return {b: b, v: b.NewXor(l, r)} }
        if (op == "/" || op == "%" || op == "%%") {
            // guard a zero divisor -> 0 (branch, since sdiv/srem by 0 traps).
            var isz = b.NewICmp(EQ, r, zero)
            var zb = nb(), db = nb(), cb = nb()
            b.NewCondBr(isz, zb, db)
            zb.NewBr(cb)
            var dv = (op == "/") ? db.NewSDiv(l, r) : db.NewSRem(l, r)
            db.NewBr(cb)
