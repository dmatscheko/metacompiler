:title("Batch to LLVM IR compiler") ;
:description("Compiles the Windows Batch (.bat) language that batch-interpreter.abnf interprets
to an LLVM IR module, then runs it with the built-in IR interpreter. The parse grammar is
byte-for-byte the interpreter's; only the startScript changes from executing the tree to
emitting IR. The supported language and the explicit non-goals are documented in
batch-interpreter.abnf.

A Batch script is a flat list of labels and statement-lines driven by a program counter, so
the control model maps directly onto basic blocks: every top-level line becomes a block, a
label is the block you can branch to, and fall-through is a branch to the next line's block.
`goto :label` is a direct branch (the target is a compile-time label); `goto :eof`, `exit /b`
and the end of a called subroutine are a RETURN, which pops a small call stack of return ids
(a global [N x i32] array) and dispatches back to the line after the matching `call`, or ends
the program when the stack is empty. `exit` ends the program unconditionally. if/for bodies are
parenthesized blocks emitted as nested control flow inline in main; a goto/call/exit inside a
body simply branches out, which reproduces the interpreter's signal that unwinds the body to
the program counter. for /l and for /f are real loops whose counter, bounds and line index live
in globals rather than in phi nodes, because a `call` in the body returns through the shared
dispatch block and so does not preserve dominance.

Every value is a string, so the module carries a hand-emitted string runtime: rt_bump over a
global arena, rt_strlen / rt_streq / rt_streqi / rt_strcat / rt_sub / rt_findch / rt_findstr,
rt_int2str / rt_str2int for the 32-bit integers of set /a and if EQU/..., rt_substr / rt_subst /
rt_stripq / rt_mods for the %VAR% operators and the ~ modifiers, rt_tokb / rt_nlines /
rt_lineat for for /f, and rt_fskind for the path model that answers `if exist`. Output goes through rt_println, which appends to a capture buffer when
one is open - that one mechanism backs both an output redirection (which discards) and
for /f over the output of a command. Variables are gv_NAME i8* slots with a gd_NAME i32
'defined' flag; setlocal and endlocal snapshot every slot into a stack in bat_setlocal /
bat_endlocal, whose bodies can only be filled once the last line has been emitted and the slot
list is complete. Call arguments are frames of a global array indexed by a frame counter.

%VAR% is expanded the way cmd.exe expands it, before the command line runs. Each top-level line
therefore begins with a PROLOGUE block that copies gv_NAME into a gp_NAME snapshot slot for
every name the line expands with %..%, and the line's terminator is only added once the whole
line has been emitted; %VAR% reads gp_NAME while !VAR! reads gv_NAME. set /a division and
modulo guard a zero divisor (result 0), matching the interpreter and cmd.exe.

The generated module is printed (this is the compiler output) and is valid LLVM IR: clang can
turn the compiled batch script into a native executable, either from the printed .ll or by
passing -exe PATH to mec (mec languages/batch-to-llvm-ir.abnf script.bat -exe out && ./out).
Run that after touching the emitter, and not only ./test.sh: an LLVM function's parameter names
and its block labels share ONE namespace, and a collision between them produces a module the
built-in IR interpreter runs perfectly and clang rejects - so the byte-identical invariant
cannot see it. See docs/abnf-dialect-gotchas.md.") ;

:startRule(Program) ;
:whitespace(Hspace) ;

// ----- program: a flat list of labels and statement-lines (PC executes them) -----
Program     <~~ push(runProgram(takeAll())) ~~>
            = { Line } ;
Line        = BlankLine | ColonComment | LabelLine | StmtLine ;
BlankLine   = Newline ;
ColonComment = "::" :whitespace() { NotNL } Newline ;
LabelLine   <~~ push({lbl: pop()}) ~~>
            = ":" LabelName :whitespace() { NotNL } Newline ;
StmtLine    <~~ push({stmt: pop()}) ~~>
            = [ At ] Chain Newline ;
At          = "@" :whitespace() ;

// ----- command chains and redirection -----
// 'a & b' runs both, 'a && b' runs b only after success, 'a || b' only after failure.
// A redirection is attached to the piece it follows; there is no filesystem here, so an
// output redirection DISCARDS (the same capture machinery that backs for /f 'command').
Chain       <~~ push(makeChain(takeAll())) ~~>
            = Piece { ChainOp Piece } ;
ChainOp     <~~ push(up.in) ~~> = "&&" | "||" | "&" ;
Piece       <~~ push(makeRedir(takeAll())) ~~>
            = Stmt { Redir } ;
Redir       <~~ push(mkRedir(takeAll())) ~~>
            = [ RedirFd ] RedirOp RedirTarget ;
RedirFd     <~~ push({fd: up.in}) ~~> = "0"..."9" ;
RedirOp     <~~ push({op: up.in}) ~~> = ">>" | ">&" | ">" | "<" ;
RedirTarget <~~ push({tgt: up.in}) ~~> = RTChar :whitespace() { RTChar } :whitespace(Hspace) ;

// A statement (also used inside ( ) blocks, where Newlines separate them).
Stmt        = Rem | EchoCtl | EchoDot | EchoParen | Echo
            | SetA | SetP | SetQ | Set
            | Setlocal | Endlocal | Shift | Ver
            | If | ForL | ForF | For
            | GotoEof | Goto | CallSet | Call | ExitB | Exit | Group ;

// ----- echo -----
Rem         <~~ push(makeNop()) ~~> = KwRem { NotNL } ;
// `echo on` / `echo off` toggle command echoing - but ONLY when the on/off is the whole
// rest of the line. Wine's expectation file records `echo off now` printing "off now"
// (test_builtins.cmd.exp line 58), i.e. it is an ordinary echo, so EchoEol asserts the
// end of the line before this rule may claim the statement.
EchoCtl     <~~ push(makeNop()) ~~> = KwEcho ( KwOn | KwOff ) EchoEol ;
EchoEol = :script(~~
    (function() {
        var i = 0
        var cc = c.peek(i)
        while (cc == 32 || cc == 9) { i = i + 1; cc = c.peek(i) }
        if (cc == -1 || cc == 10 || cc == 13) { return undefined }
        return abnf.newToken("\x01echo-eol", 0)
    })()
~~) ;
// `echo` glued to a "." ":" or "/" with NO space: the punctuation is a separator, not part
// of the text, and whatever follows it on the line IS the text. Ground truth is wine's own
// expectation file (tests/reference/batch/wine-cmd-tests/tests/test_builtins.cmd.exp - there
// is no cmd.exe or wine on this machine to run):
//     echo.       -> (empty line)      echo.word  -> word
//     echo:       -> (empty line)      echo:word  -> word
//     echo/       -> (empty line)      echo/word  -> word
// while the SPACED forms go through Echo and keep the punctuation:
//     echo .      -> .                 echo .word -> .word
// The :whitespace() comes BEFORE the separator: only the GLUED form is this rule.
EchoDot     <~~ push(makeEcho(pop())) ~~> = KwEchoW :whitespace() EchoSepCh LineText ;
EchoSepCh   = "." | ":" | "/" ;
EchoParen   <~~ push(makeEcho(makeStr(""))) ~~> = KwEchoW "(" :whitespace(Hspace) ;
Echo        <~~ push(makeEcho(pop())) ~~> = KwEcho LineText ;

// ----- set VAR=value  /  set /a expr  /  set /p VAR=prompt -----
SetA        <~~ push(makeSetA(pop())) ~~> = KwSet "/a" :whitespace(Hspace) ArithBody ;
ArithBody   = ArithQuoted | Arith ;
ArithQuoted <~~ push(pop()) ~~> = '"' :whitespace(Hspace) Arith '"' :whitespace(Hspace) ;
// set /p prompts and reads a line; there is no stdin in this runtime, so it always reads
// nothing and (as cmd.exe does on end of file) leaves the variable unchanged.
SetP        <~~ push(makeSetP(takeAll())) ~~>
            = KwSet "/p" :whitespace(Hspace) SetName "=" ( LineText | Empty ) ;
// 'set "name=value"' is the quoted form: the quotes delimit the assignment rather than
// becoming part of the value, which is how a value with a trailing space is written.
SetQ        <~~ push(makeSet(takeAll())) ~~>
            = KwSet '"' :whitespace() SetName "=" ( QLineText | Empty ) '"' :whitespace(Hspace) ;
QLineText   <~~ push(makeWord(takeAll())) ~~>
            = :whitespace() { QLinePart } :whitespace() ;
QLinePart   = ForRef | PctPct | VarPct | ParamStar | ParamRef | BangVar | PctLit | BangLit | QLineChars ;
QLineChars  <~~ push(makeStr(up.in)) ~~> = QLineChar :whitespace() { QLineChar } ;
QLineChar   = "\x09" | "\x20" | "\x23"..."\x24" | "\x26"..."\U0010ffff" ;   // not ! " or %
Set         <~~ push(makeSet(takeAll())) ~~>
            = KwSet SetName "=" ( LineText | Empty ) ;
SetName     <~~ push(up.in) ~~>
            = ( "a"..."z" | "A"..."Z" | "_" ) :whitespace() { "a"..."z" | "A"..."Z" | "0"..."9" | "_" } :whitespace() ;
Empty       <~~ push(makeStr("")) ~~> = "" ;

// ----- setlocal / endlocal / shift / ver -----
Setlocal    <~~ push(makeSetlocal(takeAll())) ~~> = KwSetlocal { SlOpt } ;
SlOpt       <~~ push(up.in) ~~> = SlChar :whitespace() { SlChar } :whitespace(Hspace) ;
SlChar      = "a"..."z" | "A"..."Z" ;
Endlocal    <~~ push(makeEndlocal()) ~~> = KwEndlocal ;
Shift       <~~ push(makeShift(takeAll())) ~~> = KwShift [ ShiftOpt ] ;
ShiftOpt    <~~ push(up.in) ~~> = "/" :whitespace() "0"..."9" :whitespace(Hspace) ;
Ver         <~~ push(makeVer()) ~~> = KwVer ;

// ----- goto / call / exit -----
GotoEof     <~~ push(makeGoto("eof")) ~~> = KwGoto ":eof" :whitespace(Hspace) ;
// 'goto :label' and 'goto label' are the same jump; ':eof' is matched by GotoEof above.
Goto        <~~ push(makeGoto(pop())) ~~> = KwGoto [ ":" ] LabelName :whitespace(Hspace) ;
// 'call set NAME=text' re-parses its argument, so the text goes through a SECOND round of
// %VAR% expansion - the documented way to expand a name that another variable holds.
CallSet     <~~ push(makeCallSet(takeAll())) ~~>
            = KwCall KwSet SetName "=" ( LineText | Empty ) ;
Call        <~~ push(makeCall(takeAll())) ~~> = KwCall ":" LabelName { ArgWord } :whitespace(Hspace) ;
ExitB       <~~ push(makeExitB(takeAll())) ~~> = KwExit "/b" :whitespace(Hspace) [ Word ] :whitespace(Hspace) ;
Exit        <~~ push(makeExit(takeAll())) ~~> = KwExit [ Word ] :whitespace(Hspace) ;

// ----- if / for (parenthesized bodies) -----
If          <~~ push(makeIf(takeAll())) ~~>
            = KwIf { IfFlag } Cond Body [ KwElse Body ] ;
IfFlag      = IfNot | IfCi ;
IfNot       <~~ push({neg: true}) ~~> = KwNot ;
IfCi        <~~ push({ci: true}) ~~> = "/i" :whitespace(Hspace) ;
// for /l counts start,step,end; for /f parses text; the plain for walks a word list.
ForL        <~~ push(makeForL(takeAll())) ~~>
            = KwFor "/l" :whitespace(Hspace) ForVar KwIn "(" :whitespace(Hspace)
              ForNum "," :whitespace(Hspace) ForNum "," :whitespace(Hspace) ForNum
              ")" :whitespace(Hspace) KwDo Body ;
ForF        <~~ push(makeForF(takeAll())) ~~>
            = KwFor "/f" :whitespace(Hspace) [ ForOpts ] ForVar KwIn "(" :whitespace(Hspace)
              ForFSrc ")" :whitespace(Hspace) KwDo Body ;
ForOpts     <~~ push({opts: up.in}) ~~> = '"' :whitespace() { NotDQ } '"' :whitespace(Hspace) ;
ForFSrc     = ForFLit | ForFCmd | ForFFile ;
ForFLit     <~~ push({lit: pop()}) ~~> = RawQuoted ;
// The single-quoted form is a COMMAND whose output is parsed. External programs are out of
// scope for this runtime, so the command is a chain of the internal commands that produce
// capturable output - echo and ver.
ForFCmd     <~~ push({cmd: pop()}) ~~> = "'" :whitespace(Hspace) SqChain "'" :whitespace(Hspace) ;
SqChain     <~~ push(makeSeq(takeAll())) ~~> = SqCmd { "&" SqCmd } ;
SqCmd       = SqEchoDot | SqEcho | SqVer ;
SqVer       <~~ push(makeVer()) ~~> = KwVer ;
// cmd parses the command inside for /f ('...') with the same command parser, so the glued
// `echo.` / `echo:` / `echo/` separator (see EchoDot) applies here too.
SqEchoDot   <~~ push(makeEcho(pop())) ~~> = KwEchoW :whitespace() EchoSepCh SqText ;
SqEcho      <~~ push(makeEcho(pop())) ~~> = KwEcho SqText ;
// A bare word is a FILE set. The path model behind this runtime answers existence, not
// contents, so a file set always reads nothing and the loop runs zero times.
ForFFile    <~~ push({file: pop()}) ~~> = Word ;
SqText      <~~ push(makeWord(takeAll())) ~~> = [ SqPart ] :whitespace() { SqPart } ;
SqPart      = ForRef | PctPct | VarPct | ParamStar | ParamRef | BangVar | PctLit | BangLit | SqChars ;
SqChars     <~~ push(makeStr(up.in)) ~~> = SqChar :whitespace() { SqChar } ;
For         <~~ push(makeFor(takeAll())) ~~>
            = KwFor ForVar KwIn "(" :whitespace(Hspace) { Word } ")" :whitespace(Hspace) KwDo Body ;
ForVar      = "%%" :whitespace() ForLetter :whitespace(Hspace) ;
ForNum      <~~ push(makeWord(takeAll())) ~~>
            = ForNumPart :whitespace() { ForNumPart } :whitespace(Hspace) ;
ForNumPart  = ForRef | VarPct | ParamRef | BangVar | ForNumChars ;
ForNumChars <~~ push(makeStr(up.in)) ~~> = FNChar :whitespace() { FNChar } ;
FNChar      = "0"..."9" | "-" | "+" ;
// A body is a ( ... ) block (statements separated by newlines) or a single statement.
Body        = Block | Single ;
Block       <~~ push({body: makeSeq(takeAll())}) ~~>
            = "(" :whitespace(Hspace) OptNL { Chain SepNL } ")" :whitespace(Hspace) ;
Single      <~~ push({body: pop()}) ~~> = Stmt ;
Group       <~~ push(makeGroup(pop())) ~~> = Block ;
OptNL       = { Newline } ;
SepNL       = { Newline } ;

// ----- conditions -----
Cond        = ErrCond | ExistCond | DefinedCond | CmpCond | StrCond ;
// 'if errorlevel N' is true when the code is N or greater.
ErrCond     <~~ push(mkErrLevel(pop())) ~~> = KwErrorlevel Word ;
// There is no filesystem here, so `if exist` can only answer for the reserved device names
// (nul, con, prn, aux, com1-9, lpt1-9), which always exist; anything else answers false.
ExistCond   <~~ push(mkExist(pop())) ~~> = KwExist Word ;
DefinedCond <~~ push(mkDefined(pop())) ~~> = KwDefined SetName ;
CmpCond     <~~ push(mkCmp(takeAll())) ~~> = CmpArg CmpOp CmpArg ;
StrCond     <~~ push(mkStrCmp(takeAll())) ~~> = CmpArg "==" <~~ push("==") ~~> CmpArg ;
CmpArg      = QWord | Word ;
QWord       <~~ push(pop()) ~~> = DQuote ;
CmpOp       = ( "EQU" | "NEQ" | "LSS" | "LEQ" | "GTR" | "GEQ"
              | "equ" | "neq" | "lss" | "leq" | "gtr" | "geq" ) <~~ push(up.in) ~~> ;

// ----- words & %expansion% -----
// After the first Part, :whitespace() keeps the remaining Parts ADJACENT (no space
// between them); the word ends at the first space, which :whitespace(Hspace) then skips.
// Without this the engine's leading skip would let { Part } slurp across spaces and
// swallow the next token (1 EQU 1 became one word 1EQU1).
Word        <~~ push(makeWord(takeAll())) ~~>
            = Part :whitespace() { Part } :whitespace(Hspace) ;
Part        = DQuote | ForRef | PctPct | VarPct | ParamStar | ParamRef | BangVar
            | EscNL | EscCh | PctLit | BangLit | Bareword ;
// An argument keeps its quotes (%~1 is what strips them), so it uses RawQuoted.
ArgWord     <~~ push(makeWord(takeAll())) ~~>
            = ArgPart :whitespace() { ArgPart } :whitespace(Hspace) ;
ArgPart     = RawQuoted | ForRef | PctPct | VarPct | ParamStar | ParamRef | BangVar
            | EscNL | EscCh | PctLit | BangLit | Bareword ;

// %VAR%, with the substring (:~n,m) and substitution (:from=to) operators.
VarPct      <~~ push(mkVarRef(takeAll())) ~~>
            = "%" :whitespace() VarNm [ VarMod ] "%" :whitespace() ;
VarNm       <~~ push({nm: up.in}) ~~>
            = ( "a"..."z" | "A"..."Z" | "_" ) :whitespace() { "a"..."z" | "A"..."Z" | "0"..."9" | "_" } :whitespace() ;
VarMod      = SubStrMod | SubstMod ;
SubStrMod   <~~ push(mkSubStr(takeAll())) ~~> = ":~" [ SubStart ] [ SubLenPart ] ;
SubStart    <~~ push({start: up.in}) ~~> = SNum ;
SubLenPart  = "," [ SubLen ] ;
SubLen      <~~ push({len: up.in}) ~~> = SNum ;
SNum        = [ "-" ] "0"..."9" { "0"..."9" } ;
SubstMod    <~~ push(mkSubst(takeAll())) ~~>
            = ":" [ SubStar ] SubFrom "=" [ SubTo ] ;
SubStar     <~~ push({star: true}) ~~> = "*" ;
SubFrom     <~~ push({from: up.in}) ~~> = SubFChar { SubFChar } ;
SubTo       <~~ push({to: up.in}) ~~> = SubTChar { SubTChar } ;
SubFChar    = "\x09" | "\x20"..."\x24" | "\x26"..."\x3c" | "\x3e"..."\U0010ffff" ;  // not % or =
SubTChar    = "\x09" | "\x20"..."\x24" | "\x26"..."\U0010ffff" ;                    // not %

// %%i for-variables, with the ~ modifiers (pure string operations on the value).
// A for-variable is a LETTER, and so is every modifier, so `%%~ff` (the ~f modifier on the
// variable f) and `%%~pd` (~p on d) are ambiguous to a greedy scan - it eats the variable
// and then finds none. The wine cmd suite settles it: tests/reference/batch/wine-cmd-tests
// has `for %%f in ("C D" E) do echo %%~ff` and `for %%d in ("I J" K) do echo %%~pd`, whose
// .exp files expect the path of the loop variable. So the rule is: take the maximal run of
// modifier letters, and if what follows it is NOT another letter, hand the run's LAST letter
// back to be the variable. ModOkFor is that decision, as a pure lookahead.
ForRef      <~~ push(mkForRef(takeAll())) ~~>
            = "%%" :whitespace() [ TildeModF ] ForLetter :whitespace() ;
TildeModF   <~~ push({mods: up.in}) ~~> = "~" :whitespace() { ModLetterF } :whitespace() ;
ModLetterF  = ModOkFor ModLetter ;
// A %1..%9 argument is a DIGIT, which no modifier ever is, so there the scan can stay greedy.
TildeMod    <~~ push({mods: up.in}) ~~> = "~" :whitespace() { ModLetter } :whitespace() ;
ModLetter   = "d" | "p" | "n" | "x" | "f" | "s" | "a" | "t" | "z"
            | "D" | "P" | "N" | "X" | "F" | "S" | "A" | "T" | "Z" ;
ModOkFor    = :script(~~
    (function() {
        function isMod(cc) {
            return cc === 100 || cc === 112 || cc === 110 || cc === 120 || cc === 102
                || cc === 115 || cc === 97 || cc === 116 || cc === 122
                || cc === 68 || cc === 80 || cc === 78 || cc === 88 || cc === 70
                || cc === 83 || cc === 65 || cc === 84 || cc === 90
        }
        var n = 0
        while (n < 16) {
            var cc = c.peek(n)
            if (cc < 0 || !isMod(cc)) { break }
            n = n + 1
        }
        if (n === 0) { return abnf.newToken("\x01not-a-modifier", 0) }
        var x = c.peek(n)
        if (x >= 0 && ((x >= 65 && x <= 90) || (x >= 97 && x <= 122))) { return undefined }
        if (n >= 2) { return undefined }
        return abnf.newToken("\x01this-modifier-is-the-variable", 0)
    })()
~~) ;
ForLetter   <~~ push({fv: up.in}) ~~>
            = ( "a"..."z" | "A"..."Z" ) :whitespace() ;
// %1..%9 call arguments (%0 is the label), %* the whole tail, %~1 with the same modifiers.
ParamStar   <~~ push(mkParamStar()) ~~> = "%*" :whitespace() ;
ParamRef    <~~ push(mkParamRef(takeAll())) ~~>
            = "%" :whitespace() [ TildeMod ] ParamDigit :whitespace() ;
ParamDigit  <~~ push({pn: up.in}) ~~> = "0"..."9" ;
// !VAR! is the delayed-expansion form: it reads the CURRENT value even inside a block.
// Outside `setlocal enabledelayedexpansion` it is literal text, which the thunk decides.
BangVar     <~~ push(mkBangRef(takeAll())) ~~>
            = "!" :whitespace() VarNm [ VarMod ] "!" :whitespace() ;
// In a batch file %% is a literal percent sign; a lone % or ! that starts nothing is itself.
PctPct      <~~ push(makeStr("%")) ~~> = "%%" :whitespace() ;
PctLit      <~~ push(makeStr("%")) ~~> = "%" :whitespace() ;
BangLit     <~~ push(makeStr("!")) ~~> = "!" :whitespace() ;
// A caret escapes the next character; a caret at end of line continues the line.
EscNL       <~~ push(makeStr("")) ~~> = "^" :whitespace() NLChars :whitespace() ;
EscCh       <~~ push(makeStr(escBody(up.in))) ~~> = "^" :whitespace() AnyChar :whitespace() ;
NLChars     = "\r\n" | "\n" | "\r" ;
AnyChar     = "\x00"..."\U0010ffff" ;

// A double-quoted run. DQuote drops the quotes (an `if` argument), RawQuoted keeps them
// (a call argument, and text inside a value, where the quotes are part of the string).
DQuote      <~~ push(makeWord(takeAll())) ~~>
            = '"' :whitespace() { DPart } '"' :whitespace() ;
RawQuoted   <~~ push(makeWord(takeAll())) ~~>
            = DqOpen :whitespace() { DPart } DqClose :whitespace() ;
DqOpen      <~~ push(makeStr("\x22")) ~~> = '"' ;
DqClose     <~~ push(makeStr("\x22")) ~~> = '"' ;
DPart       = ForRef | PctPct | VarPct | ParamStar | ParamRef | BangVar | PctLit | BangLit | DText ;
DText       <~~ push(makeStr(up.in)) ~~> = NotDQPct :whitespace() { NotDQPct } ;
Bareword    <~~ push(makeStr(up.in)) ~~>
            = BareChar :whitespace() { BareChar } :whitespace() ;

// LineText: the rest of the line (for echo / set value), with %expansion%.
// The FIRST part is matched with the ambient whitespace rule in force, so the single
// separator after 'echo' is skipped; whitespace is then turned OFF, so a space that sits
// between two parts is text and survives ('echo a %x% b' really prints 'a 7 b'). Without
// that the engine's leading skip ate every space that followed an expansion.
LineText    <~~ push(makeWord(takeAll())) ~~>
            = [ LinePart ] :whitespace() { LinePart } :whitespace(Hspace) ;
LinePart    = RawQuoted | ForRef | PctPct | VarPct | ParamStar | ParamRef | BangVar
            | EscNL | EscCh | PctLit | BangLit | DqLit | LineParen | LParenLit | LineChars ;
// A ( ) pair is ordinary text - `echo Done (ok)` and `set x=(a)` are values, not blocks.
// Requiring the run to be BALANCED is what keeps it from stealing the ) that closes an
// enclosing block: inside `(set x=1)` the value has no ( , so the ) still terminates.
LineParen   <~~ push(makeWord(takeAll())) ~~>
            = LParen :whitespace() { LinePart } RParen :whitespace() ;
LParen      <~~ push(makeStr("(")) ~~> = "(" ;
RParen      <~~ push(makeStr(")")) ~~> = ")" ;
LParenLit   <~~ push(makeStr("(")) ~~> = "(" :whitespace() ;
DqLit       <~~ push(makeStr("\x22")) ~~> = '"' :whitespace() ;
LineChars   <~~ push(makeStr(up.in)) ~~> = LineChar :whitespace() { LineChar } ;

// ----- arithmetic (32 bit integer), in the precedence set /? documents -----
Arith       = ArithSeq ;
ArithSeq    <~~ push(foldSeq(takeAll())) ~~> = ArithAssign { "," :whitespace(Hspace) ArithAssign } ;
ArithAssign = ArithSet | ArithOr ;
ArithSet    <~~ push(mkAssign(takeAll())) ~~> = ArithName AssignOp ArithAssign ;
ArithName   <~~ push(up.in) ~~>
            = ( "a"..."z" | "A"..."Z" | "_" ) :whitespace() { "a"..."z" | "A"..."Z" | "0"..."9" | "_" } :whitespace(Hspace) ;
AssignOp    <~~ push(up.in) ~~>
            = ( "*=" | "/=" | "%%=" | "%=" | "+=" | "-=" | "&=" | "^=" | "|=" | "<<=" | ">>=" | AssignEq )
              :whitespace(Hspace) ;
AssignEq    = "=" ;
ArithOr     <~~ push(foldArith(takeAll())) ~~> = ArithXor { OrOp ArithXor } ;
OrOp        <~~ push(up.in) ~~> = "|" :whitespace(Hspace) ;
ArithXor    <~~ push(foldArith(takeAll())) ~~> = ArithAnd { XorOp ArithAnd } ;
XorOp       <~~ push(up.in) ~~> = "^" :whitespace(Hspace) ;
ArithAnd    <~~ push(foldArith(takeAll())) ~~> = ArithShift { AndOp ArithShift } ;
AndOp       <~~ push(up.in) ~~> = "&" :whitespace(Hspace) ;
ArithShift  <~~ push(foldArith(takeAll())) ~~> = ArithAdd { ShiftOp ArithAdd } ;
ShiftOp     <~~ push(up.in) ~~> = ( "<<" | ">>" ) :whitespace(Hspace) ;
ArithAdd    <~~ push(foldArith(takeAll())) ~~> = ArithMul { AddOp ArithMul } ;
AddOp       <~~ push(up.in) ~~> = ( "+" | "-" ) :whitespace(Hspace) ;
ArithMul    <~~ push(foldArith(takeAll())) ~~> = ArithUnary { MulOp ArithUnary } ;
MulOp       <~~ push(up.in) ~~> = ( "*" | "/" | "%%" | "%" ) :whitespace(Hspace) ;
// ArithExp comes FIRST: !counter! is a delayed expansion, not a logical not of 'counter!'.
ArithUnary  = ArithExp | ArithNot | ArithBNot | ArithNeg | ArithAtom ;
ArithNot    <~~ push(mkANot(pop())) ~~> = "!" :whitespace(Hspace) ArithUnary ;
ArithBNot   <~~ push(mkABNot(pop())) ~~> = "~" :whitespace(Hspace) ArithUnary ;
ArithNeg    <~~ push(mkANeg(pop())) ~~> = "-" :whitespace(Hspace) ArithUnary ;
ArithAtom   = ArithParen | ArithHex | ArithOct | ArithNum | ArithExp | ArithVar ;
ArithParen  <~~ push(pop()) ~~> = "(" :whitespace(Hspace) Arith ")" :whitespace(Hspace) ;
ArithHex    <~~ push(mkAHex(up.in)) ~~> = ( "0x" | "0X" ) :whitespace() HexDig :whitespace() { HexDig } :whitespace(Hspace) ;
HexDig      = "0"..."9" | "a"..."f" | "A"..."F" ;
ArithOct    <~~ push(mkAOct(up.in)) ~~> = "0" :whitespace() OctDig :whitespace() { OctDig } :whitespace(Hspace) ;
OctDig      = "0"..."7" ;
ArithNum    <~~ push(mkANum(up.in)) ~~> = "0"..."9" :whitespace() { "0"..."9" } :whitespace(Hspace) ;
// A %VAR% / %1 expansion is a value inside set /a too.
ArithExp    <~~ push(mkAStr(pop())) ~~> = ArithExpPart :whitespace(Hspace) ;
ArithExpPart = ForRef | VarPct | ParamRef | BangVar ;
ArithVar    <~~ push(mkAVar(up.in)) ~~>
            = ( "a"..."z" | "A"..."Z" | "_" ) :whitespace() { "a"..."z" | "A"..."Z" | "0"..."9" | "_" } :whitespace(Hspace) ;

// ----- keywords (lowercase or UPPERCASE; word-boundary terminated) -----
KwRem     = ( "rem" | "REM" ) KwEnd ;
KwEcho    = ( "echo" | "ECHO" ) KwEnd ;
KwEchoW   = ( "echo" | "ECHO" ) ;                 // no boundary: echo. is echo + '.'
KwOn      = ( "on" | "ON" ) KwEnd ;
KwOff     = ( "off" | "OFF" ) KwEnd ;
KwSet     = ( "set" | "SET" ) KwEnd ;
KwSetlocal = ( "setlocal" | "SETLOCAL" ) KwEnd ;
KwEndlocal = ( "endlocal" | "ENDLOCAL" ) KwEnd ;
KwShift   = ( "shift" | "SHIFT" ) KwEnd ;
KwVer     = ( "ver" | "VER" ) KwEnd ;
KwIf      = ( "if" | "IF" ) KwEnd ;
KwNot     = ( "not" | "NOT" ) KwEnd ;
KwElse    = ( "else" | "ELSE" ) KwEnd ;
KwDefined = ( "defined" | "DEFINED" ) KwEnd ;
KwExist   = ( "exist" | "EXIST" ) KwEnd ;
KwErrorlevel = ( "errorlevel" | "ERRORLEVEL" ) KwEnd ;
KwFor     = ( "for" | "FOR" ) KwEnd ;
KwIn      = ( "in" | "IN" ) KwEnd ;
KwDo      = ( "do" | "DO" ) KwEnd ;
KwGoto    = ( "goto" | "GOTO" ) KwEnd ;
KwCall    = ( "call" | "CALL" ) KwEnd ;
KwExit    = ( "exit" | "EXIT" ) KwEnd ;
KwEnd     = :script(~~
    (function() {
        var cc = c.peek(0)
        return ((cc >= 48 && cc <= 57) || (cc >= 65 && cc <= 90) || cc === 95 || (cc >= 97 && cc <= 122))
            ? abnf.newToken("\x01keyword-boundary", 0)
            : undefined
    })()
~~) ;

// ----- character classes -----
Hspace      = { @+" \t" | LineCont } ;
LineCont    = "^" ( "\r\n" | "\n" | "\r" ) ;
Newline     = ( "\r\n" | "\n" | "\r" ) :whitespace(Hspace) ;
LabelName   <~~ push(up.in) ~~>
            = ( "a"..."z" | "A"..."Z" | "0"..."9" | "_" | "." ) :whitespace() { "a"..."z" | "A"..."Z" | "0"..."9" | "_" | "." } :whitespace() ;
// A bareword char: printable except whitespace and the characters that start something
// else - % ! " ( ) & | < > ^ .
BareChar    = "\x23"..."\x24" | "\x27" | "\x2a"..."\x3b" | "\x3d" | "\x3f"..."\x5d"
            | "\x5f"..."\x7b" | "\x7d"..."\x7e" | "\U000000a1"..."\U0010ffff" ;
// A line-text char: the same set plus space, tab and , but not % ! " ( ) & | < > ^ .
// ( and ) are excluded so a run stops at them and LineParen gets its chance; an unbalanced
// ( then falls through to LParenLit.
LineChar    = "\x09" | "\x20" | "\x23"..."\x24" | "\x27" | "\x2a"..."\x3b" | "\x3d"
            | "\x3f"..."\x5d" | "\x5f"..."\x7b" | "\x7d"..."\U0010ffff" ;
// A redirection target: printable except whitespace " & < > | .
RTChar      = "\x21" | "\x23"..."\x25" | "\x27"..."\x3b" | "\x3d" | "\x3f"..."\x7b"
            | "\x7d"..."\U0010ffff" ;
// Text inside a single-quoted for /f command: not ' % ! & and not a newline.
SqChar      = "\x09" | "\x20" | "\x22"..."\x24" | "\x28"..."\U0010ffff" ;
NotNL       = "\x00"..."\x09" | "\x0b"..."\U0010ffff" ;
NotDQ       = "\x00"..."\x21" | "\x23"..."\U0010ffff" ;                     // not " (0x22)
NotDQPct    = "\x09" | "\x20" | "\x23"..."\x24" | "\x26"..."\U0010ffff" ;   // not ! " % newline

:startScript(~~

    // ===================================================================================
    //  Stack / string helpers. String-producing thunks are plain objects {fn, c} (the
    //  local stack strips expando properties off pushed functions but keeps plain objects);
    //  statement / arithmetic / condition thunks are bare functions.
    // ===================================================================================

    function takeAll() {
        var items = []
        var v = anytype
        while ((v = pop()) != null) items.unshift(v)
        return items
    }
    function hasOwn(o, name) { return Object.prototype.hasOwnProperty.call(o, name) }
    function fail(msg) { println("batch-to-llvm-ir error: " + msg); exit(2) }
    function lower(s) {
        var out = "", i = 0
        for (i = 0; i < s.length; i++) {
            var cc = s.charCodeAt(i)
            out = out + ((cc >= 65 && cc <= 90) ? String.fromCharCode(cc + 32) : s.charAt(i))
        }
        return out
    }
    function parseDec(s) {
        var neg = false, i = 0
        if (s.charAt(0) == "-") { neg = true; i = 1 } else if (s.charAt(0) == "+") { i = 1 }
        var v = 0
        while (i < s.length) {
            var cc = s.charCodeAt(i)
            if (cc < 48 || cc > 57) { break }
            v = (v * 10 + (cc - 48)) | 0
            i = i + 1
        }
        return neg ? ((0 - v) | 0) : v
    }
    function parseRadix(text, radix, skip) {
        var v = 0, i = skip
        while (i < text.length) {
            var cc = text.charCodeAt(i)
            var d = -1
            if (cc >= 48 && cc <= 57) { d = cc - 48 }
            else if (cc >= 97 && cc <= 102) { d = cc - 87 }
            else if (cc >= 65 && cc <= 70) { d = cc - 55 }
            if (d < 0 || d >= radix) { break }
            v = (v * radix + d) | 0
            i = i + 1
        }
        return v
    }
    function escBody(s) { return s.substring(1) }
    function nextLetter(letter, n) { return String.fromCharCode(letter.charCodeAt(0) + n) }
    function utf8Len(s) {
        var n = 0, i = 0
        while (i < s.length) {
            var c = s.charCodeAt(i)
            if (c < 0x80) { n += 1 }
            else if (c < 0x800) { n += 2 }
            else if (c >= 0xd800 && c <= 0xdbff) { n += 4; i += 1 }
            else { n += 3 }
            i += 1
        }
        return n
    }

    // ===================================================================================
    //  LLVM types, module, externs and the runtime globals.
    // ===================================================================================

    var i1 = llvm.types.I1
    var i8 = llvm.types.I8
    var i32 = llvm.types.I32
    var i8ptr = llvm.types.I8Ptr
    var zero = llvm.constant.NewInt(i32, 0)
    var one = llvm.constant.NewInt(i32, 1)
    var two = llvm.constant.NewInt(i32, 2)
    var ten = llvm.constant.NewInt(i32, 10)
    var minusOne = llvm.constant.NewInt(i32, -1)
    var zero8 = llvm.constant.NewInt(i8, 0)
    var truei1 = llvm.constant.NewInt(i1, 1)
    var nullStr = llvm.constant.NewNull(i8ptr)
    var EQ = llvm.enum.IPredEQ, NE = llvm.enum.IPredNE
    var SLT = llvm.enum.IPredSLT, SLE = llvm.enum.IPredSLE
    var SGT = llvm.enum.IPredSGT, SGE = llvm.enum.IPredSGE
    function ci32(n) { return llvm.constant.NewInt(i32, n) }

    var m = llvm.ir.NewModule()
    var extPutchar = m.NewFunc("putchar", i32, llvm.ir.NewParam("", i32))

    var ARENA = 1 << 21
    var arenaTy = llvm.types.NewArray(ARENA, i8)
    var gArena = m.NewGlobalDef("arena", llvm.constant.NewZeroInitializer(arenaTy))
    var gApos = m.NewGlobalDef("arena_pos", zero)
    var gExitCode = m.NewGlobalDef("exit_code", zero)
    var gErrLvl = m.NewGlobalDef("errorlevel", zero)
    var gDelayed = m.NewGlobalDef("delayed_on", zero)

    // A real "" at a nonzero address (the IR interpreter traps loads at address 0).
    var gEmpty = m.NewGlobalDef("empty", llvm.constant.NewCharArrayFromString("\x00"))
    var emptyTy = llvm.types.NewArray(1, i8)
    function emptyPtr(b) { return b.NewGetElementPtr(emptyTy, gEmpty, zero, zero) }

    // The call/return stack: return ids pushed by `call`, popped by `exit /b` / `goto :eof`.
    var DEPTH = 256
    var cstackTy = llvm.types.NewArray(DEPTH, i32)
    var gCstack = m.NewGlobalDef("call_stack", llvm.constant.NewZeroInitializer(cstackTy))
    var gCsp = m.NewGlobalDef("call_sp", zero)
    var gRetId = m.NewGlobalDef("ret_id", zero)

    // Call arguments: DEPTH frames of ARGN slots, plus %* and %0 per frame.
    var ARGN = 10
    var argsTy = llvm.types.NewArray(DEPTH * ARGN, i8ptr)
    var frameTy = llvm.types.NewArray(DEPTH, i8ptr)
    var gArgs = m.NewGlobalDef("args", llvm.constant.NewZeroInitializer(argsTy))
    var gArgTail = m.NewGlobalDef("arg_tail", llvm.constant.NewZeroInitializer(frameTy))
    var gArgLbl = m.NewGlobalDef("arg_lbl", llvm.constant.NewZeroInitializer(frameTy))
    var gFrame = m.NewGlobalDef("frame", zero)

    // Output capture: a redirection discards, for /f 'echo ...' parses what it caught.
    var CAPN = 8, CAPSZ = 8192
    var capBufTy = llvm.types.NewArray(CAPN, i8ptr)
    var capLenTy = llvm.types.NewArray(CAPN, i32)
    var gCapBufs = m.NewGlobalDef("cap_bufs", llvm.constant.NewZeroInitializer(capBufTy))
    var gCapLens = m.NewGlobalDef("cap_lens", llvm.constant.NewZeroInitializer(capLenTy))
    var gCapSp = m.NewGlobalDef("cap_sp", zero)

    // ===================================================================================
    //  Emitter state.
    // ===================================================================================

    var curF = null
    var deadCount = 0
    function deadBlock() { deadCount = deadCount + 1; return curF.NewBlock("dead" + deadCount) }
    var tmpCount = 0
    function nb() { tmpCount = tmpCount + 1; return curF.NewBlock("b" + tmpCount) }

    var strGlobals = {}, strCount = 0
    function internStr(s) {
        var key = "$" + s
        if (hasOwn(strGlobals, key)) { return strGlobals[key] }
        var ty = llvm.types.NewArray(utf8Len(s) + 1, i8)
        var g = m.NewGlobalDef("str" + strCount, llvm.constant.NewCharArrayFromString(s + "\x00"))
        strCount = strCount + 1
        var rec = {g: g, ty: ty}
        strGlobals[key] = rec
        return rec
    }
    function gepStr(b, s) {
        if (s == "") { return emptyPtr(b) }
        var r = internStr(s)
        return b.NewGetElementPtr(r.ty, r.g, zero, zero)
    }

    var varSlots = {}, varSlotList = [], varNameList = [], defSlotList = []
    // gv_NAME (the value) and gd_NAME (the `if defined` flag) are always created together,
    // so varSlotList and defSlotList stay index-parallel - setlocal snapshots both by index.
    function getVarSlot(name) {
        var key = "$" + lower(name)
        if (hasOwn(varSlots, key)) { return varSlots[key] }
        var g = m.NewGlobalDef("gv_" + lower(name), nullStr)
        var d = m.NewGlobalDef("gd_" + lower(name), zero)
        varSlots[key] = g
        varSlotList.push(g)
        defSlotList.push(d)
        varNameList.push(lower(name))
        return g
    }
    var defSlots = {}
    function getDefSlot(name) {
        var key = "$" + lower(name)
        if (hasOwn(defSlots, key)) { return defSlots[key] }
        getVarSlot(name)
        var i
        for (i = 0; i < varNameList.length; i++) {
            if (varNameList[i] == lower(name)) { defSlots[key] = defSlotList[i]; return defSlotList[i] }
        }
        return defSlotList[0]
    }

    // The PARSE-TIME snapshot slot of a variable. cmd.exe expands a whole command line
    // before running it, so %VAR% inside a ( ) block is the value from BEFORE the block
    // while !VAR! is the current one. Every top-level line therefore starts with a prologue
    // block that copies gv_NAME into gp_NAME for each name the line expands with %..%.
    var pctSlots = {}, pctSlotList = []
    function getPctSlot(name) {
        var key = "$" + lower(name)
        if (hasOwn(pctSlots, key)) { return pctSlots[key] }
        getVarSlot(name); getDefSlot(name)
        var g = m.NewGlobalDef("gp_" + lower(name), nullStr)
        pctSlots[key] = g
        pctSlotList.push(g)
        return g
    }
    var forSlots = {}, forSlotList = []
    function getForSlot(letter) {
        var key = "$" + letter
        if (hasOwn(forSlots, key)) { return forSlots[key] }
        var g = m.NewGlobalDef("gf_" + letter, nullStr)
        forSlots[key] = g
        forSlotList.push(g)
        return g
    }

    var linePro = null, lineNoted = {}
    function notePct(name) {
        var key = "$" + lower(name)
        if (hasOwn(lineNoted, key)) { return }
        lineNoted[key] = true
        var slot = getPctSlot(name)
        linePro.NewStore(linePro.NewLoad(i8ptr, getVarSlot(name)), slot)
    }

    // ===================================================================================
    //  The string runtime, hand-emitted as IR functions.
    // ===================================================================================

    var rtBump = m.NewFunc("rt_bump", i8ptr, llvm.ir.NewParam("n", i32))
    ;(function() {
        var n = rtBump.Params[0]
        var b = rtBump.NewBlock("entry")
        var p = b.NewLoad(i32, gApos)
        var ptr = b.NewGetElementPtr(arenaTy, gArena, zero, p)
        b.NewStore(b.NewAdd(p, n), gApos)
        b.NewRet(ptr)
    })()

    var rtStrlen = m.NewFunc("rt_strlen", i32, llvm.ir.NewParam("s", i8ptr))
    ;(function() {
        var s = rtStrlen.Params[0]
        var e = rtStrlen.NewBlock("entry"), h = rtStrlen.NewBlock("head")
        var bd = rtStrlen.NewBlock("body"), x = rtStrlen.NewBlock("exit")
        var ip = e.NewAlloca(i32)
        e.NewStore(zero, ip); e.NewBr(h)
        var i = h.NewLoad(i32, ip)
        var ch = h.NewLoad(i8, h.NewGetElementPtr(i8, s, i))
        h.NewCondBr(h.NewICmp(EQ, ch, zero8), x, bd)
        bd.NewStore(bd.NewAdd(i, one), ip); bd.NewBr(h)
        x.NewRet(x.NewLoad(i32, ip))
    })()

    var rtStreq = m.NewFunc("rt_streq", i32, [llvm.ir.NewParam("a", i8ptr), llvm.ir.NewParam("b", i8ptr)])
    ;(function() {
        var a = rtStreq.Params[0], b2 = rtStreq.Params[1]
        var e = rtStreq.NewBlock("entry"), h = rtStreq.NewBlock("head"), chk = rtStreq.NewBlock("chk")
        var ne = rtStreq.NewBlock("ne"), eq = rtStreq.NewBlock("eq"), cont = rtStreq.NewBlock("cont")
        var ip = e.NewAlloca(i32)
        e.NewStore(zero, ip); e.NewBr(h)
        var i = h.NewLoad(i32, ip)
        var ca = h.NewLoad(i8, h.NewGetElementPtr(i8, a, i))
        var cb = h.NewLoad(i8, h.NewGetElementPtr(i8, b2, i))
        h.NewCondBr(h.NewICmp(NE, ca, cb), ne, chk)
        chk.NewCondBr(chk.NewICmp(EQ, ca, zero8), eq, cont)
        cont.NewStore(cont.NewAdd(i, one), ip); cont.NewBr(h)
        ne.NewRet(zero); eq.NewRet(one)
    })()

    // lower-case one byte (ASCII only, which is what cmd.exe's comparisons do)
    var rtLc = m.NewFunc("rt_lc", i8, llvm.ir.NewParam("c", i8))
    ;(function() {
        var c8 = rtLc.Params[0]
        var e = rtLc.NewBlock("entry")
        var v = e.NewSExt(c8, i32)
        var isUp = e.NewAnd(e.NewICmp(SGE, v, ci32(65)), e.NewICmp(SLE, v, ci32(90)))
        e.NewRet(e.NewSelect(isUp, e.NewTrunc(e.NewAdd(v, ci32(32)), i8), c8))
    })()

    var rtStreqi = m.NewFunc("rt_streqi", i32, [llvm.ir.NewParam("a", i8ptr), llvm.ir.NewParam("b", i8ptr)])
    ;(function() {
        var a = rtStreqi.Params[0], b2 = rtStreqi.Params[1]
        var e = rtStreqi.NewBlock("entry"), h = rtStreqi.NewBlock("head"), chk = rtStreqi.NewBlock("chk")
        var ne = rtStreqi.NewBlock("ne"), eq = rtStreqi.NewBlock("eq"), cont = rtStreqi.NewBlock("cont")
        var ip = e.NewAlloca(i32)
        e.NewStore(zero, ip); e.NewBr(h)
        var i = h.NewLoad(i32, ip)
        var ca = h.NewCall(rtLc, h.NewLoad(i8, h.NewGetElementPtr(i8, a, i)))
        var cb = h.NewCall(rtLc, h.NewLoad(i8, h.NewGetElementPtr(i8, b2, i)))
        h.NewCondBr(h.NewICmp(NE, ca, cb), ne, chk)
        chk.NewCondBr(chk.NewICmp(EQ, ca, zero8), eq, cont)
        cont.NewStore(cont.NewAdd(i, one), ip); cont.NewBr(h)
        ne.NewRet(zero); eq.NewRet(one)
    })()

    var rtStrcat = m.NewFunc("rt_strcat", i8ptr, [llvm.ir.NewParam("a", i8ptr), llvm.ir.NewParam("b", i8ptr)])
    ;(function() {
        var a = rtStrcat.Params[0], b2 = rtStrcat.Params[1]
        var e = rtStrcat.NewBlock("entry")
        var la = e.NewCall(rtStrlen, a), lb = e.NewCall(rtStrlen, b2)
        var dst = e.NewCall(rtBump, e.NewAdd(e.NewAdd(la, lb), one))
        var ip = e.NewAlloca(i32), dp = e.NewAlloca(i32)
        e.NewStore(zero, dp); e.NewStore(zero, ip)
        var ha = rtStrcat.NewBlock("ha"), bda = rtStrcat.NewBlock("bda"), xa = rtStrcat.NewBlock("xa")
        e.NewBr(ha)
        var ia = ha.NewLoad(i32, ip)
        var cha = ha.NewLoad(i8, ha.NewGetElementPtr(i8, a, ia))
        ha.NewCondBr(ha.NewICmp(EQ, cha, zero8), xa, bda)
        var da = bda.NewLoad(i32, dp)
        bda.NewStore(cha, bda.NewGetElementPtr(i8, dst, da))
        bda.NewStore(bda.NewAdd(da, one), dp); bda.NewStore(bda.NewAdd(ia, one), ip); bda.NewBr(ha)
        xa.NewStore(zero, ip)
        var hb = rtStrcat.NewBlock("hb"), bdb = rtStrcat.NewBlock("bdb"), xb = rtStrcat.NewBlock("xb")
        xa.NewBr(hb)
        var ib = hb.NewLoad(i32, ip)
        var chb = hb.NewLoad(i8, hb.NewGetElementPtr(i8, b2, ib))
        hb.NewCondBr(hb.NewICmp(EQ, chb, zero8), xb, bdb)
        var db = bdb.NewLoad(i32, dp)
        bdb.NewStore(chb, bdb.NewGetElementPtr(i8, dst, db))
        bdb.NewStore(bdb.NewAdd(db, one), dp); bdb.NewStore(bdb.NewAdd(ib, one), ip); bdb.NewBr(hb)
        var dn = xb.NewLoad(i32, dp)
        xb.NewStore(zero8, xb.NewGetElementPtr(i8, dst, dn))
        xb.NewRet(dst)
    })()

    // rt_sub(s, from, to): the byte range [from, to) as a fresh string. The caller clamps.
    var rtSub = m.NewFunc("rt_sub", i8ptr, [llvm.ir.NewParam("s", i8ptr), llvm.ir.NewParam("f", i32), llvm.ir.NewParam("t", i32)])
    ;(function() {
        var s = rtSub.Params[0], f = rtSub.Params[1], t = rtSub.Params[2]
        var e = rtSub.NewBlock("entry"), h = rtSub.NewBlock("head")
        var bd = rtSub.NewBlock("body"), x = rtSub.NewBlock("exit")
        var raw = e.NewSub(t, f)
        var n = e.NewSelect(e.NewICmp(SLT, raw, zero), zero, raw)
        var dst = e.NewCall(rtBump, e.NewAdd(n, one))
        var ip = e.NewAlloca(i32)
        e.NewStore(zero, ip); e.NewBr(h)
        var i = h.NewLoad(i32, ip)
        h.NewCondBr(h.NewICmp(SGE, i, n), x, bd)
        bd.NewStore(bd.NewLoad(i8, bd.NewGetElementPtr(i8, s, bd.NewAdd(f, i))), bd.NewGetElementPtr(i8, dst, i))
        bd.NewStore(bd.NewAdd(i, one), ip); bd.NewBr(h)
        x.NewStore(zero8, x.NewGetElementPtr(i8, dst, n))
        x.NewRet(dst)
    })()

    // rt_lastch(s, ch): index of the LAST occurrence of ch, or -1.
    var rtLastch = m.NewFunc("rt_lastch", i32, [llvm.ir.NewParam("s", i8ptr), llvm.ir.NewParam("c", i32)])
    ;(function() {
        var s = rtLastch.Params[0], c8 = rtLastch.Params[1]
        var e = rtLastch.NewBlock("entry"), h = rtLastch.NewBlock("head")
        var bd = rtLastch.NewBlock("body"), hit = rtLastch.NewBlock("hit")
        var nx = rtLastch.NewBlock("nx"), x = rtLastch.NewBlock("exit")
        var ip = e.NewAlloca(i32), rp = e.NewAlloca(i32)
        e.NewStore(zero, ip); e.NewStore(minusOne, rp); e.NewBr(h)
        var i = h.NewLoad(i32, ip)
        var ch = h.NewSExt(h.NewLoad(i8, h.NewGetElementPtr(i8, s, i)), i32)
        h.NewCondBr(h.NewICmp(EQ, ch, zero), x, bd)
        bd.NewCondBr(bd.NewICmp(EQ, ch, c8), hit, nx)
        hit.NewStore(i, rp); hit.NewBr(nx)
        nx.NewStore(nx.NewAdd(i, one), ip); nx.NewBr(h)
        x.NewRet(x.NewLoad(i32, rp))
    })()

    // rt_findch(s, ch, from): index of the first occurrence at or after from, or -1.
    var rtFindch = m.NewFunc("rt_findch", i32, [llvm.ir.NewParam("s", i8ptr), llvm.ir.NewParam("c", i32), llvm.ir.NewParam("f", i32)])
    ;(function() {
        var s = rtFindch.Params[0], c8 = rtFindch.Params[1], f = rtFindch.Params[2]
        var e = rtFindch.NewBlock("entry"), h = rtFindch.NewBlock("h")
        var bd = rtFindch.NewBlock("bd"), nx = rtFindch.NewBlock("nx")
        var hit = rtFindch.NewBlock("hit"), x = rtFindch.NewBlock("x")
        var ip = e.NewAlloca(i32)
        e.NewStore(f, ip); e.NewBr(h)
        var i = h.NewLoad(i32, ip)
        var ch = h.NewSExt(h.NewLoad(i8, h.NewGetElementPtr(i8, s, i)), i32)
        h.NewCondBr(h.NewICmp(EQ, ch, zero), x, bd)
        bd.NewCondBr(bd.NewICmp(EQ, ch, c8), hit, nx)
        hit.NewRet(i)
        nx.NewStore(nx.NewAdd(i, one), ip); nx.NewBr(h)
        x.NewRet(minusOne)
    })()

    // rt_findstr(s, needle, from): case-insensitive index of needle at or after from, or -1.
    var rtFindstr = m.NewFunc("rt_findstr", i32, [llvm.ir.NewParam("s", i8ptr), llvm.ir.NewParam("nd", i8ptr), llvm.ir.NewParam("f", i32)])
    ;(function() {
        var s = rtFindstr.Params[0], nd = rtFindstr.Params[1], f = rtFindstr.Params[2]
        var e = rtFindstr.NewBlock("entry")
        var oh = rtFindstr.NewBlock("oh"), ob = rtFindstr.NewBlock("ob")
        var ih = rtFindstr.NewBlock("ih"), ib = rtFindstr.NewBlock("ib"), ibn = rtFindstr.NewBlock("ibn")
        var hit = rtFindstr.NewBlock("hit"), miss = rtFindstr.NewBlock("miss"), x = rtFindstr.NewBlock("x")
        var ls = e.NewCall(rtStrlen, s), ln = e.NewCall(rtStrlen, nd)
        var ip = e.NewAlloca(i32), jp = e.NewAlloca(i32)
        e.NewStore(f, ip); e.NewBr(oh)
        var i = oh.NewLoad(i32, ip)
        oh.NewCondBr(oh.NewICmp(SGT, oh.NewAdd(i, ln), ls), x, ob)
        ob.NewStore(zero, jp); ob.NewBr(ih)
        var j = ih.NewLoad(i32, jp)
        ih.NewCondBr(ih.NewICmp(SGE, j, ln), hit, ib)
        var ca = ib.NewCall(rtLc, ib.NewLoad(i8, ib.NewGetElementPtr(i8, s, ib.NewAdd(i, j))))
        var cb = ib.NewCall(rtLc, ib.NewLoad(i8, ib.NewGetElementPtr(i8, nd, j)))
        ib.NewCondBr(ib.NewICmp(NE, ca, cb), miss, ibn)
        ibn.NewStore(ibn.NewAdd(j, one), jp); ibn.NewBr(ih)
        miss.NewStore(miss.NewAdd(i, one), ip); miss.NewBr(oh)
        hit.NewRet(i)
        x.NewRet(minusOne)
    })()

    var rtInt2str = m.NewFunc("rt_int2str", i8ptr, llvm.ir.NewParam("n", i32))
    ;(function() {
        var tmpArrTy = llvm.types.NewArray(16, i8)
        var n = rtInt2str.Params[0]
        var e = rtInt2str.NewBlock("entry"), isZero = rtInt2str.NewBlock("zero"), nz = rtInt2str.NewBlock("nz")
        var dst = e.NewCall(rtBump, ci32(16))
        var tmp = e.NewAlloca(tmpArrTy)
        e.NewCondBr(e.NewICmp(EQ, n, zero), isZero, nz)
        isZero.NewStore(llvm.constant.NewInt(i8, 48), isZero.NewGetElementPtr(i8, dst, zero))
        isZero.NewStore(zero8, isZero.NewGetElementPtr(i8, dst, one))
        isZero.NewRet(dst)
        var neg = nz.NewICmp(SLT, n, zero)
        var absn = nz.NewSelect(neg, nz.NewSub(zero, n), n)
        var ap = nz.NewAlloca(i32), tp = nz.NewAlloca(i32)
        nz.NewStore(absn, ap); nz.NewStore(ci32(15), tp)
        var dh = rtInt2str.NewBlock("dh"), dbd = rtInt2str.NewBlock("dbd"), dx = rtInt2str.NewBlock("dx")
        nz.NewBr(dh)
        var av = dh.NewLoad(i32, ap)
        dh.NewCondBr(dh.NewICmp(SLE, av, zero), dx, dbd)
        var d = dbd.NewSRem(av, ten)
        var ti = dbd.NewLoad(i32, tp)
        dbd.NewStore(dbd.NewTrunc(dbd.NewAdd(d, ci32(48)), i8), dbd.NewGetElementPtr(tmpArrTy, tmp, zero, ti))
        dbd.NewStore(dbd.NewSub(ti, one), tp); dbd.NewStore(dbd.NewSDiv(av, ten), ap); dbd.NewBr(dh)
        var dip = dx.NewAlloca(i32)
        dx.NewStore(zero, dip)
        var wsign = rtInt2str.NewBlock("wsign"), asm = rtInt2str.NewBlock("asm")
        dx.NewCondBr(neg, wsign, asm)
        wsign.NewStore(llvm.constant.NewInt(i8, 45), wsign.NewGetElementPtr(i8, dst, zero))
        wsign.NewStore(one, dip); wsign.NewBr(asm)
        var jp = asm.NewAlloca(i32)
        asm.NewStore(asm.NewAdd(asm.NewLoad(i32, tp), one), jp)
        var ah = rtInt2str.NewBlock("ah"), abd = rtInt2str.NewBlock("abd"), ax = rtInt2str.NewBlock("ax")
        asm.NewBr(ah)
        var j = ah.NewLoad(i32, jp)
        ah.NewCondBr(ah.NewICmp(SGT, j, ci32(15)), ax, abd)
        var digit = abd.NewLoad(i8, abd.NewGetElementPtr(tmpArrTy, tmp, zero, j))
        var di = abd.NewLoad(i32, dip)
        abd.NewStore(digit, abd.NewGetElementPtr(i8, dst, di))
        abd.NewStore(abd.NewAdd(di, one), dip); abd.NewStore(abd.NewAdd(j, one), jp); abd.NewBr(ah)
        ax.NewStore(zero8, ax.NewGetElementPtr(i8, dst, ax.NewLoad(i32, dip)))
        ax.NewRet(dst)
    })()

    var rtStr2int = m.NewFunc("rt_str2int", i32, llvm.ir.NewParam("s", i8ptr))
    ;(function() {
        var s = rtStr2int.Params[0]
        var e = rtStr2int.NewBlock("entry")
        var ip = e.NewAlloca(i32), vp = e.NewAlloca(i32), sp = e.NewAlloca(i32)
        e.NewStore(zero, ip); e.NewStore(zero, vp); e.NewStore(one, sp)
        var wh = rtStr2int.NewBlock("wh"), wbd = rtStr2int.NewBlock("wbd"), wx = rtStr2int.NewBlock("wx")
        e.NewBr(wh)
        var wi = wh.NewLoad(i32, ip)
        var wc = wh.NewLoad(i8, wh.NewGetElementPtr(i8, s, wi))
        var isSp = wh.NewICmp(EQ, wc, llvm.constant.NewInt(i8, 32))
        var isTab = wh.NewICmp(EQ, wc, llvm.constant.NewInt(i8, 9))
        wh.NewCondBr(wh.NewOr(isSp, isTab), wbd, wx)
        wbd.NewStore(wbd.NewAdd(wi, one), ip); wbd.NewBr(wh)
        var cidx = wx.NewLoad(i32, ip)
        var cc = wx.NewLoad(i8, wx.NewGetElementPtr(i8, s, cidx))
        var isMinus = wx.NewICmp(EQ, cc, llvm.constant.NewInt(i8, 45))
        var isPlus = wx.NewICmp(EQ, cc, llvm.constant.NewInt(i8, 43))
        var signBlk = rtStr2int.NewBlock("sign"), digs = rtStr2int.NewBlock("digs")
        wx.NewCondBr(wx.NewOr(isMinus, isPlus), signBlk, digs)
        signBlk.NewStore(signBlk.NewSelect(isMinus, minusOne, one), sp)
        signBlk.NewStore(signBlk.NewAdd(cidx, one), ip); signBlk.NewBr(digs)
        var dh = rtStr2int.NewBlock("dh"), dbd = rtStr2int.NewBlock("dbd"), dx = rtStr2int.NewBlock("dx")
        digs.NewBr(dh)
        var di = dh.NewLoad(i32, ip)
        var dc = dh.NewLoad(i8, dh.NewGetElementPtr(i8, s, di))
        var dc32 = dh.NewSExt(dc, i32)
        var ge0 = dh.NewICmp(SGE, dc32, ci32(48))
        var le9 = dh.NewICmp(SLE, dc32, ci32(57))
        dh.NewCondBr(dh.NewAnd(ge0, le9), dbd, dx)
        var v = dbd.NewLoad(i32, vp)
        dbd.NewStore(dbd.NewAdd(dbd.NewMul(v, ten), dbd.NewSub(dc32, ci32(48))), vp)
        dbd.NewStore(dbd.NewAdd(di, one), ip); dbd.NewBr(dh)
        dx.NewRet(dx.NewMul(dx.NewLoad(i32, vp), dx.NewLoad(i32, sp)))
    })()

    var rtPrints = m.NewFunc("rt_prints", i32, llvm.ir.NewParam("s", i8ptr))
    ;(function() {
        var s = rtPrints.Params[0]
        var e = rtPrints.NewBlock("entry"), h = rtPrints.NewBlock("head")
        var bd = rtPrints.NewBlock("body"), x = rtPrints.NewBlock("exit")
        var ip = e.NewAlloca(i32)
        e.NewStore(zero, ip); e.NewBr(h)
        var i = h.NewLoad(i32, ip)
        var ch = h.NewLoad(i8, h.NewGetElementPtr(i8, s, i))
        h.NewCondBr(h.NewICmp(EQ, ch, zero8), x, bd)
        bd.NewCall(extPutchar, bd.NewZExt(ch, i32))
        bd.NewStore(bd.NewAdd(i, one), ip); bd.NewBr(h)
        x.NewRet(zero)
    })()

    // ----- output capture -----
    var rtCapStart = m.NewFunc("rt_capstart", i32)
    ;(function() {
        var e = rtCapStart.NewBlock("entry")
        var sp = e.NewLoad(i32, gCapSp)
        e.NewStore(e.NewCall(rtBump, ci32(CAPSZ)), e.NewGetElementPtr(capBufTy, gCapBufs, zero, sp))
        e.NewStore(zero, e.NewGetElementPtr(capLenTy, gCapLens, zero, sp))
        e.NewStore(e.NewAdd(sp, one), gCapSp)
        e.NewRet(zero)
    })()
    var rtCapEnd = m.NewFunc("rt_capend", i8ptr)
    ;(function() {
        var e = rtCapEnd.NewBlock("entry")
        var sp = e.NewSub(e.NewLoad(i32, gCapSp), one)
        e.NewStore(sp, gCapSp)
        var buf = e.NewLoad(i8ptr, e.NewGetElementPtr(capBufTy, gCapBufs, zero, sp))
        var len = e.NewLoad(i32, e.NewGetElementPtr(capLenTy, gCapLens, zero, sp))
        e.NewStore(zero8, e.NewGetElementPtr(i8, buf, len))
        e.NewRet(buf)
    })()
    var rtPrintln = m.NewFunc("rt_println", i32, llvm.ir.NewParam("s", i8ptr))
    ;(function() {
        var s = rtPrintln.Params[0]
        var e = rtPrintln.NewBlock("entry"), direct = rtPrintln.NewBlock("direct"), cap = rtPrintln.NewBlock("cap")
        var sp = e.NewLoad(i32, gCapSp)
        e.NewCondBr(e.NewICmp(EQ, sp, zero), direct, cap)
        direct.NewCall(rtPrints, s)
        direct.NewCall(extPutchar, ci32(10))
        direct.NewRet(zero)
        var top = cap.NewSub(sp, one)
        var buf = cap.NewLoad(i8ptr, cap.NewGetElementPtr(capBufTy, gCapBufs, zero, top))
        var lenp = cap.NewGetElementPtr(capLenTy, gCapLens, zero, top)
        var ip = cap.NewAlloca(i32)
        cap.NewStore(zero, ip)
        var h = rtPrintln.NewBlock("h"), bd = rtPrintln.NewBlock("bd"), x = rtPrintln.NewBlock("x")
        cap.NewBr(h)
        var i = h.NewLoad(i32, ip)
        var ch = h.NewLoad(i8, h.NewGetElementPtr(i8, s, i))
        h.NewCondBr(h.NewICmp(EQ, ch, zero8), x, bd)
        bd.NewStore(ch, bd.NewGetElementPtr(i8, buf, bd.NewAdd(bd.NewLoad(i32, lenp), i)))
        bd.NewStore(bd.NewAdd(i, one), ip); bd.NewBr(h)
        var ln = x.NewAdd(x.NewLoad(i32, lenp), x.NewLoad(i32, ip))
        x.NewStore(llvm.constant.NewInt(i8, 10), x.NewGetElementPtr(i8, buf, ln))
        x.NewStore(x.NewAdd(ln, one), lenp)
        x.NewRet(zero)
    })()

    // ----- the %VAR% operators -----
    var rtStripq = m.NewFunc("rt_stripq", i8ptr, llvm.ir.NewParam("s", i8ptr))
    ;(function() {
        var s = rtStripq.Params[0]
        var e = rtStripq.NewBlock("entry")
        var n = e.NewCall(rtStrlen, s)
        var big = e.NewICmp(SGE, n, two)
        var lastIdx = e.NewSelect(big, e.NewSub(n, one), zero)
        var q = llvm.constant.NewInt(i8, 34)
        var c0 = e.NewICmp(EQ, e.NewLoad(i8, e.NewGetElementPtr(i8, s, zero)), q)
        var cl = e.NewICmp(EQ, e.NewLoad(i8, e.NewGetElementPtr(i8, s, lastIdx)), q)
        var ok = e.NewAnd(big, e.NewAnd(c0, cl))
        e.NewRet(e.NewCall(rtSub, [s, e.NewSelect(ok, one, zero), e.NewSelect(ok, e.NewSub(n, one), n)]))
    })()

    var rtSubstr = m.NewFunc("rt_substr", i8ptr, [llvm.ir.NewParam("s", i8ptr), llvm.ir.NewParam("st", i32),
                                                  llvm.ir.NewParam("ln", i32), llvm.ir.NewParam("hl", i32)])
    ;(function() {
        var s = rtSubstr.Params[0], st0 = rtSubstr.Params[1], ln = rtSubstr.Params[2], hl = rtSubstr.Params[3]
        var e = rtSubstr.NewBlock("entry")
        var n = e.NewCall(rtStrlen, s)
        var st1 = e.NewSelect(e.NewICmp(SLT, st0, zero), e.NewAdd(n, st0), st0)
        var st2 = e.NewSelect(e.NewICmp(SLT, st1, zero), zero, st1)
        var st = e.NewSelect(e.NewICmp(SGT, st2, n), n, st2)
        var endL = e.NewSelect(e.NewICmp(SLT, ln, zero), e.NewAdd(n, ln), e.NewAdd(st, ln))
        var end0 = e.NewSelect(e.NewICmp(NE, hl, zero), endL, n)
        var end1 = e.NewSelect(e.NewICmp(SLT, end0, st), st, end0)
        var end = e.NewSelect(e.NewICmp(SGT, end1, n), n, end1)
        e.NewRet(e.NewCall(rtSub, [s, st, end]))
    })()

    var rtSubst = m.NewFunc("rt_subst", i8ptr, [llvm.ir.NewParam("s", i8ptr), llvm.ir.NewParam("fr", i8ptr),
                                                llvm.ir.NewParam("to", i8ptr), llvm.ir.NewParam("star", i32)])
    ;(function() {
        var s = rtSubst.Params[0], fr = rtSubst.Params[1], to = rtSubst.Params[2], star = rtSubst.Params[3]
        var e = rtSubst.NewBlock("entry")
        var retS = rtSubst.NewBlock("rets"), notEmpty = rtSubst.NewBlock("ne")
        var starB = rtSubst.NewBlock("bstar"), plainB = rtSubst.NewBlock("bplain")
        var lf = e.NewCall(rtStrlen, fr), ls = e.NewCall(rtStrlen, s)
        e.NewCondBr(e.NewICmp(EQ, lf, zero), retS, notEmpty)
        retS.NewRet(s)
        notEmpty.NewCondBr(notEmpty.NewICmp(NE, star, zero), starB, plainB)
        // *from=to : everything up to and including the match is replaced
        var sp0 = starB.NewCall(rtFindstr, [s, fr, zero])
        var sHit = rtSubst.NewBlock("shit"), sMiss = rtSubst.NewBlock("smiss")
        starB.NewCondBr(starB.NewICmp(SLT, sp0, zero), sMiss, sHit)
        sMiss.NewRet(s)
        sHit.NewRet(sHit.NewCall(rtStrcat, [to, sHit.NewCall(rtSub, [s, sHit.NewAdd(sp0, lf), ls])]))
        // from=to : every occurrence
        var op = plainB.NewAlloca(i8ptr), ip = plainB.NewAlloca(i32)
        plainB.NewStore(emptyPtr(plainB), op); plainB.NewStore(zero, ip)
        var h = rtSubst.NewBlock("h"), hit = rtSubst.NewBlock("hit"), done = rtSubst.NewBlock("done")
        plainB.NewBr(h)
        var i = h.NewLoad(i32, ip)
        var p = h.NewCall(rtFindstr, [s, fr, i])
        h.NewCondBr(h.NewICmp(SLT, p, zero), done, hit)
        var acc = hit.NewCall(rtStrcat, [hit.NewLoad(i8ptr, op), hit.NewCall(rtSub, [s, i, p])])
        hit.NewStore(hit.NewCall(rtStrcat, [acc, to]), op)
        hit.NewStore(hit.NewAdd(p, lf), ip); hit.NewBr(h)
        done.NewRet(done.NewCall(rtStrcat, [done.NewLoad(i8ptr, op), done.NewCall(rtSub, [s, i, ls])]))
    })()

    // rt_mods(s, mask): the ~ modifiers as pure string arithmetic.
    // mask bits: 1 = drive, 2 = path, 4 = name, 8 = extension (~f is 1|2|4|8).
    var rtMods = m.NewFunc("rt_mods", i8ptr, [llvm.ir.NewParam("s", i8ptr), llvm.ir.NewParam("mask", i32)])
    ;(function() {
        var s = rtMods.Params[0], mask = rtMods.Params[1]
        var e = rtMods.NewBlock("entry")
        var q = e.NewCall(rtStripq, s)
        var n = e.NewCall(rtStrlen, q)
        var colonIdx = e.NewSelect(e.NewICmp(SGE, n, two), one, zero)
        var hasDrv = e.NewAnd(e.NewICmp(SGE, n, two),
                              e.NewICmp(EQ, e.NewLoad(i8, e.NewGetElementPtr(i8, q, colonIdx)), llvm.constant.NewInt(i8, 58)))
        var dEnd = e.NewSelect(hasDrv, two, zero)
        var drive = e.NewCall(rtSub, [q, zero, dEnd])
        var rest = e.NewCall(rtSub, [q, dEnd, n])
        var rn = e.NewCall(rtStrlen, rest)
        var c1 = e.NewCall(rtLastch, [rest, ci32(92)])
        var c2 = e.NewCall(rtLastch, [rest, ci32(47)])
        var cut = e.NewSelect(e.NewICmp(SGT, c1, c2), c1, c2)
        var path = e.NewCall(rtSub, [rest, zero, e.NewAdd(cut, one)])
        var base = e.NewCall(rtSub, [rest, e.NewAdd(cut, one), rn])
        var bn = e.NewCall(rtStrlen, base)
        var dot = e.NewCall(rtLastch, [base, ci32(46)])
        var split = e.NewSelect(e.NewICmp(SGT, dot, zero), dot, bn)
        var nm = e.NewCall(rtSub, [base, zero, split])
        var ext = e.NewCall(rtSub, [base, split, bn])
        var emp = emptyPtr(e)
        function pick(bit, val) { return e.NewSelect(e.NewICmp(NE, e.NewAnd(mask, ci32(bit)), zero), val, emp) }
        var out = e.NewCall(rtStrcat, [pick(1, drive), pick(2, path)])
        out = e.NewCall(rtStrcat, [out, pick(4, nm)])
        out = e.NewCall(rtStrcat, [out, pick(8, ext)])
        e.NewRet(out)
    })()

    // There is NO filesystem behind a compiled run either, so `if exist` answers from the same
    // small MODEL of the standard paths the interpreter uses - the shape bash-to-llvm-ir.abnf
    // established for its -e/-f/-d predicates. 0 = absent, 1 = exists and is not a directory,
    // 2 = directory. Both spellings of a directory (with and without the trailing separator)
    // are in the table, which is cheaper than emitting the strip.
    var FSMODEL = [
        {p: "nul", k: 1}, {p: "con", k: 1}, {p: "prn", k: 1}, {p: "aux", k: 1},
        {p: "com1", k: 1}, {p: "com2", k: 1}, {p: "com3", k: 1}, {p: "com4", k: 1}, {p: "com5", k: 1},
        {p: "com6", k: 1}, {p: "com7", k: 1}, {p: "com8", k: 1}, {p: "com9", k: 1},
        {p: "lpt1", k: 1}, {p: "lpt2", k: 1}, {p: "lpt3", k: 1}, {p: "lpt4", k: 1}, {p: "lpt5", k: 1},
        {p: "lpt6", k: 1}, {p: "lpt7", k: 1}, {p: "lpt8", k: 1}, {p: "lpt9", k: 1},
        {p: "c:", k: 2}, {p: "c:\x5c", k: 2},
        {p: "c:\x5cwindows", k: 2}, {p: "c:\x5cwindows\x5c", k: 2},
        {p: "c:\x5cwindows\x5csystem32", k: 2}, {p: "c:\x5cwindows\x5csystem32\x5c", k: 2},
        {p: "c:\x5cusers", k: 2}, {p: "c:\x5cusers\x5c", k: 2},
        {p: "c:\x5cprogram files", k: 2}, {p: "c:\x5cprogram files\x5c", k: 2},
        {p: "c:\x5cprogramdata", k: 2}, {p: "c:\x5cprogramdata\x5c", k: 2}
    ]
    var rtFskind = m.NewFunc("rt_fskind", i32, llvm.ir.NewParam("s", i8ptr))
    ;(function() {
        var s = rtFskind.Params[0]
        var e = rtFskind.NewBlock("entry")
        var q = e.NewCall(rtStripq, s)
        var cur = e, i
        for (i = 0; i < FSMODEL.length; i++) {
            var hitB = rtFskind.NewBlock(""), missB = rtFskind.NewBlock("")
            cur.NewCondBr(cur.NewICmp(NE, cur.NewCall(rtStreqi, [q, gepStr(cur, FSMODEL[i].p)]), zero), hitB, missB)
            hitB.NewRet(ci32(FSMODEL[i].k))
            cur = missB
        }
        cur.NewRet(zero)
    })()

    // ----- for /f: line and token boundaries -----
    var rtIsdelim = m.NewFunc("rt_isdelim", i32, [llvm.ir.NewParam("c", i32), llvm.ir.NewParam("d", i8ptr)])
    ;(function() {
        var c8 = rtIsdelim.Params[0], d = rtIsdelim.Params[1]
        var e = rtIsdelim.NewBlock("entry"), h = rtIsdelim.NewBlock("h")
        var bd = rtIsdelim.NewBlock("bd"), nx = rtIsdelim.NewBlock("nx")
        var yes = rtIsdelim.NewBlock("yes"), no = rtIsdelim.NewBlock("no")
        var ip = e.NewAlloca(i32)
        e.NewStore(zero, ip); e.NewBr(h)
        var i = h.NewLoad(i32, ip)
        var ch = h.NewSExt(h.NewLoad(i8, h.NewGetElementPtr(i8, d, i)), i32)
        h.NewCondBr(h.NewICmp(EQ, ch, zero), no, bd)
        bd.NewCondBr(bd.NewICmp(EQ, ch, c8), yes, nx)
        nx.NewStore(nx.NewAdd(i, one), ip); nx.NewBr(h)
        yes.NewRet(one); no.NewRet(zero)
    })()

    // rt_tokb(s, delims, idx, which): boundary of the idx-th (1-based) token.
    //   which 0 = its start, 1 = its end, 2 = the start of the remainder after it.
    // Answers -1 when there is no such token. The terminating NUL is never a delimiter,
    // so both scans stop at the end of the string without a separate length check.
    var rtTokb = m.NewFunc("rt_tokb", i32, [llvm.ir.NewParam("s", i8ptr), llvm.ir.NewParam("d", i8ptr),
                                            llvm.ir.NewParam("idx", i32), llvm.ir.NewParam("which", i32)])
    ;(function() {
        var s = rtTokb.Params[0], d = rtTokb.Params[1], idx = rtTokb.Params[2], which = rtTokb.Params[3]
        var e = rtTokb.NewBlock("entry")
        var skipH = rtTokb.NewBlock("skiph"), skipB = rtTokb.NewBlock("skipb"), skipX = rtTokb.NewBlock("skipx")
        var startT = rtTokb.NewBlock("startt"), noneB = rtTokb.NewBlock("none")
