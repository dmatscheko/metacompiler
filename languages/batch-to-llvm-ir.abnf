:title("Batch to LLVM IR compiler") ;
:description("Compiles the Windows Batch (.bat) language that batch-interpreter.abnf interprets
to an LLVM IR module, then runs it with the built-in IR interpreter. The parse grammar is
byte-for-byte the interpreter's; only the startScript changes from executing the tree to
emitting IR. The supported language and the explicit non-goals are documented in
batch-interpreter.abnf.

A Batch script is a flat list of labels and statement-lines driven by a program counter, so
the control model maps directly onto basic blocks: every top-level line becomes a block, a
label is the block you can branch to, and fall-through is a branch to the next line's block.
`goto :label` is a direct branch (the target is a compile-time label); `goto :eof`, `exit /b`
and the end of a called subroutine are a RETURN, which pops a small call stack of return ids
(a global [N x i32] array) and dispatches back to the line after the matching `call`, or ends
the program when the stack is empty. `exit` ends the program unconditionally. if/for bodies are
parenthesized blocks emitted as nested control flow inline in main; a goto/call/exit inside a
body simply branches out, which reproduces the interpreter's signal that unwinds the body to
the program counter. for /l and for /f are real loops whose counter, bounds and line index live
in globals rather than in phi nodes, because a `call` in the body returns through the shared
dispatch block and so does not preserve dominance.

Every value is a string, so the module carries a hand-emitted string runtime: rt_bump over a
global arena, rt_strlen / rt_streq / rt_streqi / rt_strcat / rt_sub / rt_findch / rt_findstr,
rt_int2str / rt_str2int for the 32-bit integers of set /a and if EQU/..., rt_substr / rt_subst /
rt_stripq / rt_mods for the %VAR% operators and the ~ modifiers, rt_tokb / rt_nlines /
rt_lineat for for /f, and rt_fskind for the path model that answers `if exist`. Output goes through rt_println, which appends to a capture buffer when
one is open - that one mechanism backs both an output redirection (which discards) and
for /f over the output of a command. Variables are gv_NAME i8* slots with a gd_NAME i32
'defined' flag; setlocal and endlocal snapshot every slot into a stack in bat_setlocal /
bat_endlocal, whose bodies can only be filled once the last line has been emitted and the slot
list is complete. Call arguments are frames of a global array indexed by a frame counter.

%VAR% is expanded the way cmd.exe expands it, before the command line runs. Each top-level line
therefore begins with a PROLOGUE block that copies gv_NAME into a gp_NAME snapshot slot for
every name the line expands with %..%, and the line's terminator is only added once the whole
line has been emitted; %VAR% reads gp_NAME while !VAR! reads gv_NAME. set /a division and
modulo guard a zero divisor (result 0), matching the interpreter and cmd.exe.

The generated module is printed (this is the compiler output) and is valid LLVM IR: clang can
turn the compiled batch script into a native executable, either from the printed .ll or by
passing -exe PATH to mec (mec languages/batch-to-llvm-ir.abnf script.bat -exe out && ./out).
Run that after touching the emitter, and not only ./test.sh: an LLVM function's parameter names
and its block labels share ONE namespace, and a collision between them produces a module the
built-in IR interpreter runs perfectly and clang rejects - so the byte-identical invariant
cannot see it. See docs/abnf-dialect-gotchas.md.") ;

:startRule(Program) ;
:whitespace(Hspace) ;

// ----- program: a flat list of labels and statement-lines (PC executes them) -----
Program     <~~ push(runProgram(takeAll())) ~~>
            = { Line } ;
Line        = BlankLine | ColonComment | LabelLine | StmtLine ;
BlankLine   = Newline ;
ColonComment = "::" :whitespace() { NotNL } Newline ;
LabelLine   <~~ push({lbl: pop()}) ~~>
            = ":" LabelName :whitespace() { NotNL } Newline ;
StmtLine    <~~ push({stmt: pop()}) ~~>
            = [ At ] Chain Newline ;
At          = "@" :whitespace() ;

// ----- command chains and redirection -----
// 'a & b' runs both, 'a && b' runs b only after success, 'a || b' only after failure.
// A redirection is attached to the piece it follows; there is no filesystem here, so an
// output redirection DISCARDS (the same capture machinery that backs for /f 'command').
Chain       <~~ push(makeChain(takeAll())) ~~>
            = Piece { ChainOp Piece } ;
ChainOp     <~~ push(up.in) ~~> = "&&" | "||" | "&" ;
Piece       <~~ push(makeRedir(takeAll())) ~~>
            = Stmt { Redir } ;
Redir       <~~ push(mkRedir(takeAll())) ~~>
            = [ RedirFd ] RedirOp RedirTarget ;
RedirFd     <~~ push({fd: up.in}) ~~> = "0"..."9" ;
RedirOp     <~~ push({op: up.in}) ~~> = ">>" | ">&" | ">" | "<" ;
RedirTarget <~~ push({tgt: up.in}) ~~> = RTChar :whitespace() { RTChar } :whitespace(Hspace) ;

// A statement (also used inside ( ) blocks, where Newlines separate them).
Stmt        = Rem | EchoCtl | EchoDot | EchoParen | Echo
            | SetA | SetP | SetQ | Set
            | Setlocal | Endlocal | Shift | Ver
            | If | ForL | ForF | For
            | GotoEof | Goto | CallSet | Call | ExitB | Exit | Group ;

// ----- echo -----
Rem         <~~ push(makeNop()) ~~> = KwRem { NotNL } ;
// `echo on` / `echo off` toggle command echoing - but ONLY when the on/off is the whole
// rest of the line. Wine's expectation file records `echo off now` printing "off now"
// (test_builtins.cmd.exp line 58), i.e. it is an ordinary echo, so EchoEol asserts the
// end of the line before this rule may claim the statement.
EchoCtl     <~~ push(makeNop()) ~~> = KwEcho ( KwOn | KwOff ) EchoEol ;
EchoEol = :script(~~
    (function() {
        var i = 0
        var cc = c.peek(i)
        while (cc == 32 || cc == 9) { i = i + 1; cc = c.peek(i) }
        if (cc == -1 || cc == 10 || cc == 13) { return undefined }
        return abnf.newToken("\x01echo-eol", 0)
    })()
~~) ;
// `echo` glued to a "." ":" or "/" with NO space: the punctuation is a separator, not part
// of the text, and whatever follows it on the line IS the text. Ground truth is wine's own
// expectation file (tests/reference/batch/wine-cmd-tests/tests/test_builtins.cmd.exp - there
// is no cmd.exe or wine on this machine to run):
//     echo.       -> (empty line)      echo.word  -> word
//     echo:       -> (empty line)      echo:word  -> word
//     echo/       -> (empty line)      echo/word  -> word
// while the SPACED forms go through Echo and keep the punctuation:
//     echo .      -> .                 echo .word -> .word
// The :whitespace() comes BEFORE the separator: only the GLUED form is this rule.
EchoDot     <~~ push(makeEcho(pop())) ~~> = KwEchoW :whitespace() EchoSepCh LineText ;
EchoSepCh   = "." | ":" | "/" ;
EchoParen   <~~ push(makeEcho(makeStr(""))) ~~> = KwEchoW "(" :whitespace(Hspace) ;
Echo        <~~ push(makeEcho(pop())) ~~> = KwEcho LineText ;

// ----- set VAR=value  /  set /a expr  /  set /p VAR=prompt -----
SetA        <~~ push(makeSetA(pop())) ~~> = KwSet "/a" :whitespace(Hspace) ArithBody ;
ArithBody   = ArithQuoted | Arith ;
ArithQuoted <~~ push(pop()) ~~> = '"' :whitespace(Hspace) Arith '"' :whitespace(Hspace) ;
// set /p prompts and reads a line; there is no stdin in this runtime, so it always reads
// nothing and (as cmd.exe does on end of file) leaves the variable unchanged.
SetP        <~~ push(makeSetP(takeAll())) ~~>
            = KwSet "/p" :whitespace(Hspace) SetName "=" ( LineText | Empty ) ;
// 'set "name=value"' is the quoted form: the quotes delimit the assignment rather than
// becoming part of the value, which is how a value with a trailing space is written.
SetQ        <~~ push(makeSet(takeAll())) ~~>
            = KwSet '"' :whitespace() SetName "=" ( QLineText | Empty ) '"' :whitespace(Hspace) ;
QLineText   <~~ push(makeWord(takeAll())) ~~>
            = :whitespace() { QLinePart } :whitespace() ;
QLinePart   = ForRef | PctPct | VarPct | ParamStar | ParamRef | BangVar | PctLit | BangLit | QLineChars ;
QLineChars  <~~ push(makeStr(up.in)) ~~> = QLineChar :whitespace() { QLineChar } ;
QLineChar   = "\x09" | "\x20" | "\x23"..."\x24" | "\x26"..."\U0010ffff" ;   // not ! " or %
Set         <~~ push(makeSet(takeAll())) ~~>
            = KwSet SetName "=" ( LineText | Empty ) ;
SetName     <~~ push(up.in) ~~>
            = ( "a"..."z" | "A"..."Z" | "_" ) :whitespace() { "a"..."z" | "A"..."Z" | "0"..."9" | "_" } :whitespace() ;
Empty       <~~ push(makeStr("")) ~~> = "" ;

// ----- setlocal / endlocal / shift / ver -----
Setlocal    <~~ push(makeSetlocal(takeAll())) ~~> = KwSetlocal { SlOpt } ;
SlOpt       <~~ push(up.in) ~~> = SlChar :whitespace() { SlChar } :whitespace(Hspace) ;
SlChar      = "a"..."z" | "A"..."Z" ;
Endlocal    <~~ push(makeEndlocal()) ~~> = KwEndlocal ;
Shift       <~~ push(makeShift(takeAll())) ~~> = KwShift [ ShiftOpt ] ;
ShiftOpt    <~~ push(up.in) ~~> = "/" :whitespace() "0"..."9" :whitespace(Hspace) ;
Ver         <~~ push(makeVer()) ~~> = KwVer ;

// ----- goto / call / exit -----
GotoEof     <~~ push(makeGoto("eof")) ~~> = KwGoto ":eof" :whitespace(Hspace) ;
// 'goto :label' and 'goto label' are the same jump; ':eof' is matched by GotoEof above.
Goto        <~~ push(makeGoto(pop())) ~~> = KwGoto [ ":" ] LabelName :whitespace(Hspace) ;
// 'call set NAME=text' re-parses its argument, so the text goes through a SECOND round of
// %VAR% expansion - the documented way to expand a name that another variable holds.
CallSet     <~~ push(makeCallSet(takeAll())) ~~>
            = KwCall KwSet SetName "=" ( LineText | Empty ) ;
Call        <~~ push(makeCall(takeAll())) ~~> = KwCall ":" LabelName { ArgWord } :whitespace(Hspace) ;
ExitB       <~~ push(makeExitB(takeAll())) ~~> = KwExit "/b" :whitespace(Hspace) [ Word ] :whitespace(Hspace) ;
Exit        <~~ push(makeExit(takeAll())) ~~> = KwExit [ Word ] :whitespace(Hspace) ;

// ----- if / for (parenthesized bodies) -----
If          <~~ push(makeIf(takeAll())) ~~>
            = KwIf { IfFlag } Cond Body [ KwElse Body ] ;
IfFlag      = IfNot | IfCi ;
IfNot       <~~ push({neg: true}) ~~> = KwNot ;
IfCi        <~~ push({ci: true}) ~~> = "/i" :whitespace(Hspace) ;
// for /l counts start,step,end; for /f parses text; the plain for walks a word list.
ForL        <~~ push(makeForL(takeAll())) ~~>
            = KwFor "/l" :whitespace(Hspace) ForVar KwIn "(" :whitespace(Hspace)
              ForNum "," :whitespace(Hspace) ForNum "," :whitespace(Hspace) ForNum
              ")" :whitespace(Hspace) KwDo Body ;
ForF        <~~ push(makeForF(takeAll())) ~~>
            = KwFor "/f" :whitespace(Hspace) [ ForOpts ] ForVar KwIn "(" :whitespace(Hspace)
              ForFSrc ")" :whitespace(Hspace) KwDo Body ;
ForOpts     <~~ push({opts: up.in}) ~~> = '"' :whitespace() { NotDQ } '"' :whitespace(Hspace) ;
ForFSrc     = ForFLit | ForFCmd | ForFFile ;
ForFLit     <~~ push({lit: pop()}) ~~> = RawQuoted ;
// The single-quoted form is a COMMAND whose output is parsed. External programs are out of
// scope for this runtime, so the command is a chain of the internal commands that produce
// capturable output - echo and ver.
ForFCmd     <~~ push({cmd: pop()}) ~~> = "'" :whitespace(Hspace) SqChain "'" :whitespace(Hspace) ;
SqChain     <~~ push(makeSeq(takeAll())) ~~> = SqCmd { "&" SqCmd } ;
SqCmd       = SqEchoDot | SqEcho | SqVer ;
SqVer       <~~ push(makeVer()) ~~> = KwVer ;
// cmd parses the command inside for /f ('...') with the same command parser, so the glued
// `echo.` / `echo:` / `echo/` separator (see EchoDot) applies here too.
SqEchoDot   <~~ push(makeEcho(pop())) ~~> = KwEchoW :whitespace() EchoSepCh SqText ;
SqEcho      <~~ push(makeEcho(pop())) ~~> = KwEcho SqText ;
// A bare word is a FILE set. The path model behind this runtime answers existence, not
// contents, so a file set always reads nothing and the loop runs zero times.
ForFFile    <~~ push({file: pop()}) ~~> = Word ;
SqText      <~~ push(makeWord(takeAll())) ~~> = [ SqPart ] :whitespace() { SqPart } ;
SqPart      = ForRef | PctPct | VarPct | ParamStar | ParamRef | BangVar | PctLit | BangLit | SqChars ;
SqChars     <~~ push(makeStr(up.in)) ~~> = SqChar :whitespace() { SqChar } ;
For         <~~ push(makeFor(takeAll())) ~~>
            = KwFor ForVar KwIn "(" :whitespace(Hspace) { Word } ")" :whitespace(Hspace) KwDo Body ;
ForVar      = "%%" :whitespace() ForLetter :whitespace(Hspace) ;
ForNum      <~~ push(makeWord(takeAll())) ~~>
            = ForNumPart :whitespace() { ForNumPart } :whitespace(Hspace) ;
ForNumPart  = ForRef | VarPct | ParamRef | BangVar | ForNumChars ;
ForNumChars <~~ push(makeStr(up.in)) ~~> = FNChar :whitespace() { FNChar } ;
FNChar      = "0"..."9" | "-" | "+" ;
// A body is a ( ... ) block (statements separated by newlines) or a single statement.
Body        = Block | Single ;
Block       <~~ push({body: makeSeq(takeAll())}) ~~>
            = "(" :whitespace(Hspace) OptNL { Chain SepNL } ")" :whitespace(Hspace) ;
Single      <~~ push({body: pop()}) ~~> = Stmt ;
Group       <~~ push(makeGroup(pop())) ~~> = Block ;
OptNL       = { Newline } ;
SepNL       = { Newline } ;

// ----- conditions -----
Cond        = ErrCond | ExistCond | DefinedCond | CmpCond | StrCond ;
// 'if errorlevel N' is true when the code is N or greater.
ErrCond     <~~ push(mkErrLevel(pop())) ~~> = KwErrorlevel Word ;
// There is no filesystem here, so `if exist` can only answer for the reserved device names
// (nul, con, prn, aux, com1-9, lpt1-9), which always exist; anything else answers false.
ExistCond   <~~ push(mkExist(pop())) ~~> = KwExist Word ;
DefinedCond <~~ push(mkDefined(pop())) ~~> = KwDefined SetName ;
CmpCond     <~~ push(mkCmp(takeAll())) ~~> = CmpArg CmpOp CmpArg ;
StrCond     <~~ push(mkStrCmp(takeAll())) ~~> = CmpArg "==" <~~ push("==") ~~> CmpArg ;
CmpArg      = QWord | Word ;
QWord       <~~ push(pop()) ~~> = DQuote ;
CmpOp       = ( "EQU" | "NEQ" | "LSS" | "LEQ" | "GTR" | "GEQ"
              | "equ" | "neq" | "lss" | "leq" | "gtr" | "geq" ) <~~ push(up.in) ~~> ;

// ----- words & %expansion% -----
// After the first Part, :whitespace() keeps the remaining Parts ADJACENT (no space
// between them); the word ends at the first space, which :whitespace(Hspace) then skips.
// Without this the engine's leading skip would let { Part } slurp across spaces and
// swallow the next token (1 EQU 1 became one word 1EQU1).
Word        <~~ push(makeWord(takeAll())) ~~>
            = Part :whitespace() { Part } :whitespace(Hspace) ;
Part        = DQuote | ForRef | PctPct | VarPct | ParamStar | ParamRef | BangVar
            | EscNL | EscCh | PctLit | BangLit | Bareword ;
// An argument keeps its quotes (%~1 is what strips them), so it uses RawQuoted.
ArgWord     <~~ push(makeWord(takeAll())) ~~>
            = ArgPart :whitespace() { ArgPart } :whitespace(Hspace) ;
ArgPart     = RawQuoted | ForRef | PctPct | VarPct | ParamStar | ParamRef | BangVar
            | EscNL | EscCh | PctLit | BangLit | Bareword ;

// %VAR%, with the substring (:~n,m) and substitution (:from=to) operators.
VarPct      <~~ push(mkVarRef(takeAll())) ~~>
            = "%" :whitespace() VarNm [ VarMod ] "%" :whitespace() ;
VarNm       <~~ push({nm: up.in}) ~~>
            = ( "a"..."z" | "A"..."Z" | "_" ) :whitespace() { "a"..."z" | "A"..."Z" | "0"..."9" | "_" } :whitespace() ;
VarMod      = SubStrMod | SubstMod ;
SubStrMod   <~~ push(mkSubStr(takeAll())) ~~> = ":~" [ SubStart ] [ SubLenPart ] ;
SubStart    <~~ push({start: up.in}) ~~> = SNum ;
SubLenPart  = "," [ SubLen ] ;
SubLen      <~~ push({len: up.in}) ~~> = SNum ;
SNum        = [ "-" ] "0"..."9" { "0"..."9" } ;
SubstMod    <~~ push(mkSubst(takeAll())) ~~>
            = ":" [ SubStar ] SubFrom "=" [ SubTo ] ;
SubStar     <~~ push({star: true}) ~~> = "*" ;
SubFrom     <~~ push({from: up.in}) ~~> = SubFChar { SubFChar } ;
SubTo       <~~ push({to: up.in}) ~~> = SubTChar { SubTChar } ;
SubFChar    = "\x09" | "\x20"..."\x24" | "\x26"..."\x3c" | "\x3e"..."\U0010ffff" ;  // not % or =
SubTChar    = "\x09" | "\x20"..."\x24" | "\x26"..."\U0010ffff" ;                    // not %

// %%i for-variables, with the ~ modifiers (pure string operations on the value).
// A for-variable is a LETTER, and so is every modifier, so `%%~ff` (the ~f modifier on the
// variable f) and `%%~pd` (~p on d) are ambiguous to a greedy scan - it eats the variable
// and then finds none. The wine cmd suite settles it: tests/reference/batch/wine-cmd-tests
// has `for %%f in ("C D" E) do echo %%~ff` and `for %%d in ("I J" K) do echo %%~pd`, whose
// .exp files expect the path of the loop variable. So the rule is: take the maximal run of
// modifier letters, and if what follows it is NOT another letter, hand the run's LAST letter
// back to be the variable. ModOkFor is that decision, as a pure lookahead.
ForRef      <~~ push(mkForRef(takeAll())) ~~>
            = "%%" :whitespace() [ TildeModF ] ForLetter :whitespace() ;
TildeModF   <~~ push({mods: up.in}) ~~> = "~" :whitespace() { ModLetterF } :whitespace() ;
ModLetterF  = ModOkFor ModLetter ;
// A %1..%9 argument is a DIGIT, which no modifier ever is, so there the scan can stay greedy.
TildeMod    <~~ push({mods: up.in}) ~~> = "~" :whitespace() { ModLetter } :whitespace() ;
ModLetter   = "d" | "p" | "n" | "x" | "f" | "s" | "a" | "t" | "z"
            | "D" | "P" | "N" | "X" | "F" | "S" | "A" | "T" | "Z" ;
ModOkFor    = :script(~~
    (function() {
        function isMod(cc) {
            return cc === 100 || cc === 112 || cc === 110 || cc === 120 || cc === 102
                || cc === 115 || cc === 97 || cc === 116 || cc === 122
                || cc === 68 || cc === 80 || cc === 78 || cc === 88 || cc === 70
                || cc === 83 || cc === 65 || cc === 84 || cc === 90
        }
        var n = 0
        while (n < 16) {
            var cc = c.peek(n)
            if (cc < 0 || !isMod(cc)) { break }
            n = n + 1
        }
        if (n === 0) { return abnf.newToken("\x01not-a-modifier", 0) }
        var x = c.peek(n)
        if (x >= 0 && ((x >= 65 && x <= 90) || (x >= 97 && x <= 122))) { return undefined }
        if (n >= 2) { return undefined }
        return abnf.newToken("\x01this-modifier-is-the-variable", 0)
    })()
~~) ;
ForLetter   <~~ push({fv: up.in}) ~~>
            = ( "a"..."z" | "A"..."Z" ) :whitespace() ;
// %1..%9 call arguments (%0 is the label), %* the whole tail, %~1 with the same modifiers.
ParamStar   <~~ push(mkParamStar()) ~~> = "%*" :whitespace() ;
ParamRef    <~~ push(mkParamRef(takeAll())) ~~>
            = "%" :whitespace() [ TildeMod ] ParamDigit :whitespace() ;
ParamDigit  <~~ push({pn: up.in}) ~~> = "0"..."9" ;
// !VAR! is the delayed-expansion form: it reads the CURRENT value even inside a block.
// Outside `setlocal enabledelayedexpansion` it is literal text, which the thunk decides.
BangVar     <~~ push(mkBangRef(takeAll())) ~~>
            = "!" :whitespace() VarNm [ VarMod ] "!" :whitespace() ;
// In a batch file %% is a literal percent sign; a lone % or ! that starts nothing is itself.
PctPct      <~~ push(makeStr("%")) ~~> = "%%" :whitespace() ;
PctLit      <~~ push(makeStr("%")) ~~> = "%" :whitespace() ;
BangLit     <~~ push(makeStr("!")) ~~> = "!" :whitespace() ;
// A caret escapes the next character; a caret at end of line continues the line.
EscNL       <~~ push(makeStr("")) ~~> = "^" :whitespace() NLChars :whitespace() ;
EscCh       <~~ push(makeStr(escBody(up.in))) ~~> = "^" :whitespace() AnyChar :whitespace() ;
NLChars     = "\r\n" | "\n" | "\r" ;
AnyChar     = "\x00"..."\U0010ffff" ;

// A double-quoted run. DQuote drops the quotes (an `if` argument), RawQuoted keeps them
// (a call argument, and text inside a value, where the quotes are part of the string).
DQuote      <~~ push(makeWord(takeAll())) ~~>
            = '"' :whitespace() { DPart } '"' :whitespace() ;
RawQuoted   <~~ push(makeWord(takeAll())) ~~>
            = DqOpen :whitespace() { DPart } DqClose :whitespace() ;
DqOpen      <~~ push(makeStr("\x22")) ~~> = '"' ;
DqClose     <~~ push(makeStr("\x22")) ~~> = '"' ;
DPart       = ForRef | PctPct | VarPct | ParamStar | ParamRef | BangVar | PctLit | BangLit | DText ;
DText       <~~ push(makeStr(up.in)) ~~> = NotDQPct :whitespace() { NotDQPct } ;
Bareword    <~~ push(makeStr(up.in)) ~~>
            = BareChar :whitespace() { BareChar } :whitespace() ;

// LineText: the rest of the line (for echo / set value), with %expansion%.
// The FIRST part is matched with the ambient whitespace rule in force, so the single
// separator after 'echo' is skipped; whitespace is then turned OFF, so a space that sits
// between two parts is text and survives ('echo a %x% b' really prints 'a 7 b'). Without
// that the engine's leading skip ate every space that followed an expansion.
LineText    <~~ push(makeWord(takeAll())) ~~>
            = [ LinePart ] :whitespace() { LinePart } :whitespace(Hspace) ;
LinePart    = RawQuoted | ForRef | PctPct | VarPct | ParamStar | ParamRef | BangVar
            | EscNL | EscCh | PctLit | BangLit | DqLit | LineParen | LParenLit | LineChars ;
// A ( ) pair is ordinary text - `echo Done (ok)` and `set x=(a)` are values, not blocks.
// Requiring the run to be BALANCED is what keeps it from stealing the ) that closes an
// enclosing block: inside `(set x=1)` the value has no ( , so the ) still terminates.
LineParen   <~~ push(makeWord(takeAll())) ~~>
            = LParen :whitespace() { LinePart } RParen :whitespace() ;
LParen      <~~ push(makeStr("(")) ~~> = "(" ;
RParen      <~~ push(makeStr(")")) ~~> = ")" ;
LParenLit   <~~ push(makeStr("(")) ~~> = "(" :whitespace() ;
DqLit       <~~ push(makeStr("\x22")) ~~> = '"' :whitespace() ;
LineChars   <~~ push(makeStr(up.in)) ~~> = LineChar :whitespace() { LineChar } ;

// ----- arithmetic (32 bit integer), in the precedence set /? documents -----
Arith       = ArithSeq ;
ArithSeq    <~~ push(foldSeq(takeAll())) ~~> = ArithAssign { "," :whitespace(Hspace) ArithAssign } ;
ArithAssign = ArithSet | ArithOr ;
ArithSet    <~~ push(mkAssign(takeAll())) ~~> = ArithName AssignOp ArithAssign ;
ArithName   <~~ push(up.in) ~~>
            = ( "a"..."z" | "A"..."Z" | "_" ) :whitespace() { "a"..."z" | "A"..."Z" | "0"..."9" | "_" } :whitespace(Hspace) ;
AssignOp    <~~ push(up.in) ~~>
            = ( "*=" | "/=" | "%%=" | "%=" | "+=" | "-=" | "&=" | "^=" | "|=" | "<<=" | ">>=" | AssignEq )
              :whitespace(Hspace) ;
AssignEq    = "=" ;
ArithOr     <~~ push(foldArith(takeAll())) ~~> = ArithXor { OrOp ArithXor } ;
OrOp        <~~ push(up.in) ~~> = "|" :whitespace(Hspace) ;
ArithXor    <~~ push(foldArith(takeAll())) ~~> = ArithAnd { XorOp ArithAnd } ;
XorOp       <~~ push(up.in) ~~> = "^" :whitespace(Hspace) ;
ArithAnd    <~~ push(foldArith(takeAll())) ~~> = ArithShift { AndOp ArithShift } ;
AndOp       <~~ push(up.in) ~~> = "&" :whitespace(Hspace) ;
ArithShift  <~~ push(foldArith(takeAll())) ~~> = ArithAdd { ShiftOp ArithAdd } ;
ShiftOp     <~~ push(up.in) ~~> = ( "<<" | ">>" ) :whitespace(Hspace) ;
ArithAdd    <~~ push(foldArith(takeAll())) ~~> = ArithMul { AddOp ArithMul } ;
AddOp       <~~ push(up.in) ~~> = ( "+" | "-" ) :whitespace(Hspace) ;
ArithMul    <~~ push(foldArith(takeAll())) ~~> = ArithUnary { MulOp ArithUnary } ;
MulOp       <~~ push(up.in) ~~> = ( "*" | "/" | "%%" | "%" ) :whitespace(Hspace) ;
// ArithExp comes FIRST: !counter! is a delayed expansion, not a logical not of 'counter!'.
ArithUnary  = ArithExp | ArithNot | ArithBNot | ArithNeg | ArithAtom ;
ArithNot    <~~ push(mkANot(pop())) ~~> = "!" :whitespace(Hspace) ArithUnary ;
ArithBNot   <~~ push(mkABNot(pop())) ~~> = "~" :whitespace(Hspace) ArithUnary ;
ArithNeg    <~~ push(mkANeg(pop())) ~~> = "-" :whitespace(Hspace) ArithUnary ;
ArithAtom   = ArithParen | ArithHex | ArithOct | ArithNum | ArithExp | ArithVar ;
ArithParen  <~~ push(pop()) ~~> = "(" :whitespace(Hspace) Arith ")" :whitespace(Hspace) ;
ArithHex    <~~ push(mkAHex(up.in)) ~~> = ( "0x" | "0X" ) :whitespace() HexDig :whitespace() { HexDig } :whitespace(Hspace) ;
HexDig      = "0"..."9" | "a"..."f" | "A"..."F" ;
ArithOct    <~~ push(mkAOct(up.in)) ~~> = "0" :whitespace() OctDig :whitespace() { OctDig } :whitespace(Hspace) ;
OctDig      = "0"..."7" ;
ArithNum    <~~ push(mkANum(up.in)) ~~> = "0"..."9" :whitespace() { "0"..."9" } :whitespace(Hspace) ;
// A %VAR% / %1 expansion is a value inside set /a too.
ArithExp    <~~ push(mkAStr(pop())) ~~> = ArithExpPart :whitespace(Hspace) ;
ArithExpPart = ForRef | VarPct | ParamRef | BangVar ;
ArithVar    <~~ push(mkAVar(up.in)) ~~>
            = ( "a"..."z" | "A"..."Z" | "_" ) :whitespace() { "a"..."z" | "A"..."Z" | "0"..."9" | "_" } :whitespace(Hspace) ;

// ----- keywords (lowercase or UPPERCASE; word-boundary terminated) -----
KwRem     = ( "rem" | "REM" ) KwEnd ;
KwEcho    = ( "echo" | "ECHO" ) KwEnd ;
KwEchoW   = ( "echo" | "ECHO" ) ;                 // no boundary: echo. is echo + '.'
KwOn      = ( "on" | "ON" ) KwEnd ;
KwOff     = ( "off" | "OFF" ) KwEnd ;
KwSet     = ( "set" | "SET" ) KwEnd ;
KwSetlocal = ( "setlocal" | "SETLOCAL" ) KwEnd ;
KwEndlocal = ( "endlocal" | "ENDLOCAL" ) KwEnd ;
KwShift   = ( "shift" | "SHIFT" ) KwEnd ;
KwVer     = ( "ver" | "VER" ) KwEnd ;
KwIf      = ( "if" | "IF" ) KwEnd ;
KwNot     = ( "not" | "NOT" ) KwEnd ;
KwElse    = ( "else" | "ELSE" ) KwEnd ;
KwDefined = ( "defined" | "DEFINED" ) KwEnd ;
KwExist   = ( "exist" | "EXIST" ) KwEnd ;
KwErrorlevel = ( "errorlevel" | "ERRORLEVEL" ) KwEnd ;
KwFor     = ( "for" | "FOR" ) KwEnd ;
KwIn      = ( "in" | "IN" ) KwEnd ;
KwDo      = ( "do" | "DO" ) KwEnd ;
KwGoto    = ( "goto" | "GOTO" ) KwEnd ;
KwCall    = ( "call" | "CALL" ) KwEnd ;
KwExit    = ( "exit" | "EXIT" ) KwEnd ;
KwEnd     = :script(~~
    (function() {
        var cc = c.peek(0)
        return ((cc >= 48 && cc <= 57) || (cc >= 65 && cc <= 90) || cc === 95 || (cc >= 97 && cc <= 122))
            ? abnf.newToken("\x01keyword-boundary", 0)
            : undefined
    })()
~~) ;

// ----- character classes -----
Hspace      = { @+" \t" | LineCont } ;
LineCont    = "^" ( "\r\n" | "\n" | "\r" ) ;
Newline     = ( "\r\n" | "\n" | "\r" ) :whitespace(Hspace) ;
LabelName   <~~ push(up.in) ~~>
            = ( "a"..."z" | "A"..."Z" | "0"..."9" | "_" | "." ) :whitespace() { "a"..."z" | "A"..."Z" | "0"..."9" | "_" | "." } :whitespace() ;
// A bareword char: printable except whitespace and the characters that start something
// else - % ! " ( ) & | < > ^ .
BareChar    = "\x23"..."\x24" | "\x27" | "\x2a"..."\x3b" | "\x3d" | "\x3f"..."\x5d"
            | "\x5f"..."\x7b" | "\x7d"..."\x7e" | "\U000000a1"..."\U0010ffff" ;
// A line-text char: the same set plus space, tab and , but not % ! " ( ) & | < > ^ .
// ( and ) are excluded so a run stops at them and LineParen gets its chance; an unbalanced
// ( then falls through to LParenLit.
LineChar    = "\x09" | "\x20" | "\x23"..."\x24" | "\x27" | "\x2a"..."\x3b" | "\x3d"
            | "\x3f"..."\x5d" | "\x5f"..."\x7b" | "\x7d"..."\U0010ffff" ;
// A redirection target: printable except whitespace " & < > | .
RTChar      = "\x21" | "\x23"..."\x25" | "\x27"..."\x3b" | "\x3d" | "\x3f"..."\x7b"
            | "\x7d"..."\U0010ffff" ;
// Text inside a single-quoted for /f command: not ' % ! & and not a newline.
SqChar      = "\x09" | "\x20" | "\x22"..."\x24" | "\x28"..."\U0010ffff" ;
NotNL       = "\x00"..."\x09" | "\x0b"..."\U0010ffff" ;
NotDQ       = "\x00"..."\x21" | "\x23"..."\U0010ffff" ;                     // not " (0x22)
NotDQPct    = "\x09" | "\x20" | "\x23"..."\x24" | "\x26"..."\U0010ffff" ;   // not ! " % newline

:startScript(~~

    // ===================================================================================
    //  Stack / string helpers. String-producing thunks are plain objects {fn, c} (the
    //  local stack strips expando properties off pushed functions but keeps plain objects);
    //  statement / arithmetic / condition thunks are bare functions.
    // ===================================================================================

    function takeAll() {
        var items = []
        var v = anytype
        while ((v = pop()) != null) items.unshift(v)
        return items
    }
    function hasOwn(o, name) { return Object.prototype.hasOwnProperty.call(o, name) }
    function fail(msg) { println("batch-to-llvm-ir error: " + msg); exit(2) }
    function lower(s) {
        var out = "", i = 0
        for (i = 0; i < s.length; i++) {
            var cc = s.charCodeAt(i)
            out = out + ((cc >= 65 && cc <= 90) ? String.fromCharCode(cc + 32) : s.charAt(i))
        }
        return out
    }
    function parseDec(s) {
        var neg = false, i = 0
        if (s.charAt(0) == "-") { neg = true; i = 1 } else if (s.charAt(0) == "+") { i = 1 }
        var v = 0
        while (i < s.length) {
            var cc = s.charCodeAt(i)
            if (cc < 48 || cc > 57) { break }
            v = (v * 10 + (cc - 48)) | 0
            i = i + 1
        }
        return neg ? ((0 - v) | 0) : v
    }
    function parseRadix(text, radix, skip) {
        var v = 0, i = skip
        while (i < text.length) {
            var cc = text.charCodeAt(i)
            var d = -1
            if (cc >= 48 && cc <= 57) { d = cc - 48 }
            else if (cc >= 97 && cc <= 102) { d = cc - 87 }
            else if (cc >= 65 && cc <= 70) { d = cc - 55 }
            if (d < 0 || d >= radix) { break }
            v = (v * radix + d) | 0
            i = i + 1
        }
        return v
    }
    function escBody(s) { return s.substring(1) }
    function nextLetter(letter, n) { return String.fromCharCode(letter.charCodeAt(0) + n) }
    function utf8Len(s) {
        var n = 0, i = 0
        while (i < s.length) {
            var c = s.charCodeAt(i)
            if (c < 0x80) { n += 1 }
            else if (c < 0x800) { n += 2 }
            else if (c >= 0xd800 && c <= 0xdbff) { n += 4; i += 1 }
            else { n += 3 }
            i += 1
        }
        return n
    }

    // ===================================================================================
    //  LLVM types, module, externs and the runtime globals.
    // ===================================================================================

    var i1 = llvm.types.I1
    var i8 = llvm.types.I8
    var i32 = llvm.types.I32
    var i8ptr = llvm.types.I8Ptr
    var zero = llvm.constant.NewInt(i32, 0)
    var one = llvm.constant.NewInt(i32, 1)
    var two = llvm.constant.NewInt(i32, 2)
    var ten = llvm.constant.NewInt(i32, 10)
    var minusOne = llvm.constant.NewInt(i32, -1)
    var zero8 = llvm.constant.NewInt(i8, 0)
    var truei1 = llvm.constant.NewInt(i1, 1)
    var nullStr = llvm.constant.NewNull(i8ptr)
    var EQ = llvm.enum.IPredEQ, NE = llvm.enum.IPredNE
    var SLT = llvm.enum.IPredSLT, SLE = llvm.enum.IPredSLE
    var SGT = llvm.enum.IPredSGT, SGE = llvm.enum.IPredSGE
    function ci32(n) { return llvm.constant.NewInt(i32, n) }

    var m = llvm.ir.NewModule()

    // The arena (rt_bump) and the output capture stack live in languages/lib/batch-rt.c
    // now, as statics of the runtime module, so nothing here declares or initializes them.
    var gExitCode = m.NewGlobalDef("exit_code", zero)
    var gErrLvl = m.NewGlobalDef("errorlevel", zero)
    var gDelayed = m.NewGlobalDef("delayed_on", zero)

    // A real "" at a nonzero address (the IR interpreter traps loads at address 0).
    var gEmpty = m.NewGlobalDef("empty", llvm.constant.NewCharArrayFromString("\x00"))
    var emptyTy = llvm.types.NewArray(1, i8)
    function emptyPtr(b) { return b.NewGetElementPtr(emptyTy, gEmpty, zero, zero) }

    // The call/return stack: return ids pushed by `call`, popped by `exit /b` / `goto :eof`.
    var DEPTH = 256
    var cstackTy = llvm.types.NewArray(DEPTH, i32)
    var gCstack = m.NewGlobalDef("call_stack", llvm.constant.NewZeroInitializer(cstackTy))
    var gCsp = m.NewGlobalDef("call_sp", zero)
    var gRetId = m.NewGlobalDef("ret_id", zero)

    // Call arguments: DEPTH frames of ARGN slots, plus %* and %0 per frame.
    var ARGN = 10
    var argsTy = llvm.types.NewArray(DEPTH * ARGN, i8ptr)
    var frameTy = llvm.types.NewArray(DEPTH, i8ptr)
    // args and frame are DEFINED in languages/lib/batch-rt.c, because bat_shift lives
    // there now; the linker binds these declarations to those definitions by name
    // (abnf/llvmlink.go for llvm.Run, clang for -exe). Every other byte of runtime state
    // is still private to one side or the other.
    var gArgs = m.NewGlobal("args", argsTy)
    gArgs.Linkage = llvm.enum.LinkageExternal
    var gArgTail = m.NewGlobalDef("arg_tail", llvm.constant.NewZeroInitializer(frameTy))
    var gArgLbl = m.NewGlobalDef("arg_lbl", llvm.constant.NewZeroInitializer(frameTy))
    var gFrame = m.NewGlobal("frame", i32)
    gFrame.Linkage = llvm.enum.LinkageExternal

    // ===================================================================================
    //  Emitter state.
    // ===================================================================================

    var curF = null
    var deadCount = 0
    function deadBlock() { deadCount = deadCount + 1; return curF.NewBlock("dead" + deadCount) }
    var tmpCount = 0
    function nb() { tmpCount = tmpCount + 1; return curF.NewBlock("b" + tmpCount) }

    var strGlobals = {}, strCount = 0
    function internStr(s) {
        var key = "$" + s
        if (hasOwn(strGlobals, key)) { return strGlobals[key] }
        var ty = llvm.types.NewArray(utf8Len(s) + 1, i8)
        var g = m.NewGlobalDef("str" + strCount, llvm.constant.NewCharArrayFromString(s + "\x00"))
        strCount = strCount + 1
        var rec = {g: g, ty: ty}
        strGlobals[key] = rec
        return rec
    }
    function gepStr(b, s) {
        if (s == "") { return emptyPtr(b) }
        var r = internStr(s)
        return b.NewGetElementPtr(r.ty, r.g, zero, zero)
    }

    var varSlots = {}, varSlotList = [], varNameList = [], defSlotList = []
    // gv_NAME (the value) and gd_NAME (the `if defined` flag) are always created together,
    // so varSlotList and defSlotList stay index-parallel - setlocal snapshots both by index.
    function getVarSlot(name) {
        var key = "$" + lower(name)
        if (hasOwn(varSlots, key)) { return varSlots[key] }
        var g = m.NewGlobalDef("gv_" + lower(name), nullStr)
        var d = m.NewGlobalDef("gd_" + lower(name), zero)
        varSlots[key] = g
        varSlotList.push(g)
        defSlotList.push(d)
        varNameList.push(lower(name))
        return g
    }
    var defSlots = {}
    function getDefSlot(name) {
        var key = "$" + lower(name)
        if (hasOwn(defSlots, key)) { return defSlots[key] }
        getVarSlot(name)
        var i
        for (i = 0; i < varNameList.length; i++) {
            if (varNameList[i] == lower(name)) { defSlots[key] = defSlotList[i]; return defSlotList[i] }
        }
        return defSlotList[0]
    }

    // The PARSE-TIME snapshot slot of a variable. cmd.exe expands a whole command line
    // before running it, so %VAR% inside a ( ) block is the value from BEFORE the block
    // while !VAR! is the current one. Every top-level line therefore starts with a prologue
    // block that copies gv_NAME into gp_NAME for each name the line expands with %..%.
    var pctSlots = {}, pctSlotList = []
    function getPctSlot(name) {
        var key = "$" + lower(name)
        if (hasOwn(pctSlots, key)) { return pctSlots[key] }
        getVarSlot(name); getDefSlot(name)
        var g = m.NewGlobalDef("gp_" + lower(name), nullStr)
        pctSlots[key] = g
        pctSlotList.push(g)
        return g
    }
    var forSlots = {}, forSlotList = []
    function getForSlot(letter) {
        var key = "$" + letter
        if (hasOwn(forSlots, key)) { return forSlots[key] }
        var g = m.NewGlobalDef("gf_" + letter, nullStr)
        forSlots[key] = g
        forSlotList.push(g)
        return g
    }

    var linePro = null, lineNoted = {}
    function notePct(name) {
        var key = "$" + lower(name)
        if (hasOwn(lineNoted, key)) { return }
        lineNoted[key] = true
        var slot = getPctSlot(name)
        linePro.NewStore(linePro.NewLoad(i8ptr, getVarSlot(name)), slot)
    }

    // ===================================================================================
    //  The string runtime: languages/lib/batch-rt.c, compiled by languages/c-to-llvm-ir.abnf
    //  into languages/lib/batch-rt.ll (tests/gen-batch-rt-ll.sh) and LINKED, not emitted.
    //
    //  These were 26 hand-written IR bodies inside this grammar. The ABI is unchanged -
    //  a string is a char* into the runtime's arena, an integer is an int - so no call
    //  site below changed; only where the bodies come from. The arena and the output
    //  capture stack moved with them and are now statics of batch-rt.c, which is why
    //  main no longer initializes them (a C static starts at zero by itself).
    //
    //  rt_expand was the last to move, and only after e8bf2c3: it CALLS BACK into this
    //  module, through the bat_lookup generated below, and c-to-llvm-ir.abnf used to
    //  emit a declared-only function's pointer parameter as a plain i32. It now emits
    //  `declare i32* @bat_lookup(i32* %0)`, so the C prototype survives and the call is
    //  resolved across the two modules by name (clang, and abnf/llvmlink.go for llvm.Run).
    // ===================================================================================

    var rtStrlen = m.NewFunc("rt_strlen", i32, llvm.ir.NewParam("s", i8ptr))
    var rtStreq = m.NewFunc("rt_streq", i32, [llvm.ir.NewParam("a", i8ptr), llvm.ir.NewParam("b", i8ptr)])
    var rtStreqi = m.NewFunc("rt_streqi", i32, [llvm.ir.NewParam("a", i8ptr), llvm.ir.NewParam("b", i8ptr)])
    var rtStrcat = m.NewFunc("rt_strcat", i8ptr, [llvm.ir.NewParam("a", i8ptr), llvm.ir.NewParam("b", i8ptr)])
    // rt_sub(s, from, to): the byte range [from, to) as a fresh string. The caller clamps.
    var rtSub = m.NewFunc("rt_sub", i8ptr, [llvm.ir.NewParam("s", i8ptr), llvm.ir.NewParam("f", i32), llvm.ir.NewParam("t", i32)])
    // rt_findch(s, ch, from): index of the first occurrence at or after from, or -1.
    var rtFindch = m.NewFunc("rt_findch", i32, [llvm.ir.NewParam("s", i8ptr), llvm.ir.NewParam("c", i32), llvm.ir.NewParam("f", i32)])
    var rtInt2str = m.NewFunc("rt_int2str", i8ptr, llvm.ir.NewParam("n", i32))
    var rtStr2int = m.NewFunc("rt_str2int", i32, llvm.ir.NewParam("s", i8ptr))

    // ----- output capture: a redirection discards, for /f 'echo ...' parses what it caught
    var rtCapStart = m.NewFunc("rt_capstart", i32)
    var rtCapEnd = m.NewFunc("rt_capend", i8ptr)
    var rtPrintln = m.NewFunc("rt_println", i32, llvm.ir.NewParam("s", i8ptr))

    // ----- the %VAR% operators -----
    var rtStripq = m.NewFunc("rt_stripq", i8ptr, llvm.ir.NewParam("s", i8ptr))
    var rtSubstr = m.NewFunc("rt_substr", i8ptr, [llvm.ir.NewParam("s", i8ptr), llvm.ir.NewParam("st", i32),
                                                  llvm.ir.NewParam("ln", i32), llvm.ir.NewParam("hl", i32)])
    var rtSubst = m.NewFunc("rt_subst", i8ptr, [llvm.ir.NewParam("s", i8ptr), llvm.ir.NewParam("fr", i8ptr),
                                                llvm.ir.NewParam("to", i8ptr), llvm.ir.NewParam("star", i32)])
    // rt_mods(s, mask): the ~ modifiers as pure string arithmetic.
    // mask bits: 1 = drive, 2 = path, 4 = name, 8 = extension (~f is 1|2|4|8).
    var rtMods = m.NewFunc("rt_mods", i8ptr, [llvm.ir.NewParam("s", i8ptr), llvm.ir.NewParam("mask", i32)])
    // There is NO filesystem behind a compiled run either, so `if exist` answers from a
    // small MODEL of the standard paths the interpreter uses (batch-rt.c, rt_fskind):
    // 0 = absent, 1 = exists and is not a directory, 2 = directory.
    var rtFskind = m.NewFunc("rt_fskind", i32, llvm.ir.NewParam("s", i8ptr))

    // ----- for /f: line and token boundaries -----
    // rt_tokb(s, delims, idx, which): boundary of the idx-th (1-based) token.
    //   which 0 = its start, 1 = its end, 2 = the start of the remainder after it.
    // Answers -1 when there is no such token.
    var rtTokb = m.NewFunc("rt_tokb", i32, [llvm.ir.NewParam("s", i8ptr), llvm.ir.NewParam("d", i8ptr),
                                            llvm.ir.NewParam("idx", i32), llvm.ir.NewParam("which", i32)])
    var rtNlines = m.NewFunc("rt_nlines", i32, llvm.ir.NewParam("s", i8ptr))
    // rt_lineat(s, idx): the idx-th newline-separated line, with a trailing CR removed.
    var rtLineat = m.NewFunc("rt_lineat", i8ptr, [llvm.ir.NewParam("s", i8ptr), llvm.ir.NewParam("idx", i32)])

    // rt_expand(s): one more %VAR% pass, for `call set NAME=%%%indirect%%%`. It is the
    // one runtime helper that calls back into this module, through bat_lookup below.
    var rtExpand = m.NewFunc("rt_expand", i8ptr, llvm.ir.NewParam("s", i8ptr))


    // ===================================================================================
    //  Value / word thunks:  {fn: function(b) -> {b, v: i8*}, c: const-string|undefined}
    // ===================================================================================

    function makeStr(s) { return {fn: function(b) { return {b: b, v: gepStr(b, s)} }, c: s} }
    function makeWord(parts) {
        if (parts.length == 0) { return makeStr("") }
        var allConst = true, joined = "", i
        for (i = 0; i < parts.length; i++) {
            if (parts[i].c == undefined) { allConst = false } else { joined = joined + parts[i].c }
        }
        if (allConst) { return makeStr(joined) }
        if (parts.length == 1) { return parts[0] }
        return {fn: function(b) {
            var r = parts[0].fn(b)
            var bb = r.b, v = r.v, k
            for (k = 1; k < parts.length; k++) {
                var r2 = parts[k].fn(bb)
                bb = r2.b
                v = bb.NewCall(rtStrcat, [v, r2.v])
            }
            return {b: bb, v: v}
        }, c: undefined}
    }

    // The %VAR% operators arrive as plain records (a function property would not survive
    // the tag stack), so each one is turned into IR here.
    function mkSubStr(items) {
        var st = 0, ln = 0, hasLen = false, i
        for (i = 0; i < items.length; i++) {
            if (items[i].start != undefined) { st = parseDec(items[i].start) }
            if (items[i].len != undefined) { ln = parseDec(items[i].len); hasLen = true }
        }
        return {kind: "substr", start: st, len: ln, haslen: hasLen}
    }
    function mkSubst(items) {
        var star = false, from = "", to = "", i
        for (i = 0; i < items.length; i++) {
            if (items[i].star != undefined) { star = true }
            if (items[i].from != undefined) { from = items[i].from }
            if (items[i].to != undefined) { to = items[i].to }
        }
        return {kind: "subst", from: from, to: to, star: star}
    }
    function applyMod(b, v, mod) {
        if (mod.kind == "substr") {
            return b.NewCall(rtSubstr, [v, ci32(mod.start), ci32(mod.len), ci32(mod.haslen ? 1 : 0)])
        }
        return b.NewCall(rtSubst, [v, gepStr(b, mod.from), gepStr(b, mod.to), ci32(mod.star ? 1 : 0)])
    }
    // The effective set of path components a ~ modifier run asks for: 1 = drive, 2 = path,
    // 4 = name, 8 = extension; -1 = there was no ~ at all (the value is raw) and -2 = a bare
    // ~ (strip the quotes and nothing else). ~s asks for the SHORT path, which on a volume
    // with 8.3 names switched off is the long one, so it is a no-op flag on top of the others
    // and means the whole path when it stands alone. ~a ~t ~z would have to stat the file,
    // which the path model cannot do, so they ask for nothing - which is also what cmd.exe
    // answers for a file that is not there.
    function maskOf(mods) {
        if (mods == null) { return -1 }
        if (mods == "") { return -2 }
        var mask = 0, i
        for (i = 0; i < mods.length; i++) {
            var ch = lower(mods.charAt(i))
            if (ch == "f") { mask = mask | 15 }
            if (ch == "d") { mask = mask | 1 }
            if (ch == "p") { mask = mask | 2 }
            if (ch == "n") { mask = mask | 4 }
            if (ch == "x") { mask = mask | 8 }
        }
        if (mask == 0 && lower(mods).indexOf("s") >= 0) { mask = 15 }
        return mask
    }
    function applyTilde(b, v, mask) {
        if (mask == -1) { return v }
        if (mask == -2) { return b.NewCall(rtStripq, v) }
        if (mask == 0) { return gepStr(b, "") }
        return b.NewCall(rtMods, [v, ci32(mask)])
    }
    function modsOf(items, upto) {
        var i
        for (i = 0; i < upto; i++) { if (items[i].mods != undefined) { return items[i].mods.substring(1) } }
        return null                               // null = no ~ at all, so the value is raw
    }
    function mkVarRef(items) {
        var nm = items[0].nm
        var mod = (items.length > 1) ? items[1] : null
        var isErr = (lower(nm) == "errorlevel")
        return {fn: function(b) {
            var v
            if (isErr) { v = b.NewCall(rtInt2str, b.NewLoad(i32, gErrLvl)) }
            else { notePct(nm); v = b.NewLoad(i8ptr, getPctSlot(nm)) }
            if (mod != null) { v = applyMod(b, v, mod) }
            return {b: b, v: v}
        }, c: undefined}
    }
    function mkBangRef(items) {
        var nm = items[0].nm
        var mod = (items.length > 1) ? items[1] : null
        var lit = "!" + nm + "!"
        return {fn: function(b) {
            var v = b.NewLoad(i8ptr, getVarSlot(nm))
            if (mod != null) { v = applyMod(b, v, mod) }
            var on = b.NewICmp(NE, b.NewLoad(i32, gDelayed), zero)
            return {b: b, v: b.NewSelect(on, v, gepStr(b, lit))}
        }, c: undefined}
    }
    function mkForRef(items) {
        var letter = items[items.length - 1].fv
        var mask = maskOf(modsOf(items, items.length - 1))
        return {fn: function(b) {
            var v = b.NewLoad(i8ptr, getForSlot(letter))
            v = applyTilde(b, v, mask)
            return {b: b, v: v}
        }, c: undefined}
    }
    function argSlot(b, n) {
        var fr = b.NewLoad(i32, gFrame)
        return b.NewGetElementPtr(argsTy, gArgs, zero, b.NewAdd(b.NewMul(fr, ci32(ARGN)), ci32(n - 1)))
    }
    function mkParamRef(items) {
        var n = parseDec(items[items.length - 1].pn)
        var mask = maskOf(modsOf(items, items.length - 1))
        return {fn: function(b) {
            var v
            if (n == 0) { v = b.NewLoad(i8ptr, b.NewGetElementPtr(frameTy, gArgLbl, zero, b.NewLoad(i32, gFrame))) }
            else { v = b.NewLoad(i8ptr, argSlot(b, n)) }
            v = applyTilde(b, v, mask)
            return {b: b, v: v}
        }, c: undefined}
    }
    function mkParamStar() {
        return {fn: function(b) {
            return {b: b, v: b.NewLoad(i8ptr, b.NewGetElementPtr(frameTy, gArgTail, zero, b.NewLoad(i32, gFrame)))}
        }, c: undefined}
    }

    // ===================================================================================
    //  Arithmetic thunks (bare functions):  function(b) -> {b, v: i32}
    // ===================================================================================

    function mkANum(text) { var k = llvm.constant.NewInt(i32, parseDec(text)); return function(b) { return {b: b, v: k} } }
    function mkAHex(text) { var k = llvm.constant.NewInt(i32, parseRadix(text, 16, 2)); return function(b) { return {b: b, v: k} } }
    function mkAOct(text) { var k = llvm.constant.NewInt(i32, parseRadix(text, 8, 1)); return function(b) { return {b: b, v: k} } }
    function mkAVar(name) { return function(b) { return {b: b, v: b.NewCall(rtStr2int, b.NewLoad(i8ptr, getVarSlot(name)))} } }
    function mkAStr(t) { return function(b) { var r = t.fn(b); return {b: r.b, v: r.b.NewCall(rtStr2int, r.v)} } }
    function mkANeg(t) { return function(b) { var r = t(b); return {b: r.b, v: r.b.NewSub(zero, r.v)} } }
    function mkANot(t) { return function(b) { var r = t(b); return {b: r.b, v: r.b.NewZExt(r.b.NewICmp(EQ, r.v, zero), i32)} } }
    function mkABNot(t) { return function(b) { var r = t(b); return {b: r.b, v: r.b.NewXor(r.v, minusOne)} } }
    function aOp(b, op, l, r) {
        if (op == "+") { return {b: b, v: b.NewAdd(l, r)} }
        if (op == "-") { return {b: b, v: b.NewSub(l, r)} }
        if (op == "*") { return {b: b, v: b.NewMul(l, r)} }
        if (op == "<<") { return {b: b, v: b.NewShl(l, b.NewAnd(r, ci32(31)))} }
        if (op == ">>") { return {b: b, v: b.NewAShr(l, b.NewAnd(r, ci32(31)))} }
        if (op == "&") { return {b: b, v: b.NewAnd(l, r)} }
        if (op == "|") { return {b: b, v: b.NewOr(l, r)} }
        if (op == "^") { return {b: b, v: b.NewXor(l, r)} }
        if (op == "/" || op == "%" || op == "%%") {
            // guard a zero divisor -> 0 (branch, since sdiv/srem by 0 traps).
            var isz = b.NewICmp(EQ, r, zero)
            var zb = nb(), db = nb(), cb = nb()
            b.NewCondBr(isz, zb, db)
            zb.NewBr(cb)
            var dv = (op == "/") ? db.NewSDiv(l, r) : db.NewSRem(l, r)
            db.NewBr(cb)
            var phi = cb.NewPhi([llvm.ir.NewIncoming(zero, zb), llvm.ir.NewIncoming(dv, db)])
            return {b: cb, v: phi}
        }
        return {b: b, v: zero}
    }
    function foldArith(items) {
        if (items.length == 1) { return items[0] }
        return function(b) {
            var r = items[0](b)
            var bb = r.b, v = r.v, i
            for (i = 1; i < items.length; i += 2) {
                var r2 = items[i + 1](bb)
                var res = aOp(r2.b, items[i], v, r2.v)
                bb = res.b
                v = res.v
            }
            return {b: bb, v: v}
        }
    }
    function foldSeq(items) {
        if (items.length == 1) { return items[0] }
        return function(b) {
            var bb = b, v = zero, i
            for (i = 0; i < items.length; i++) { var r = items[i](bb); bb = r.b; v = r.v }
            return {b: bb, v: v}
        }
    }
    function mkAssign(items) {                     // [name, op, valueThunk]
        var name = items[0], op = items[1], vT = items[2]
        return function(b) {
            var r = vT(b)
            var bb = r.b, v = r.v
            if (op != "=") {
                var cur = bb.NewCall(rtStr2int, bb.NewLoad(i8ptr, getVarSlot(name)))
                var rr = aOp(bb, op.substring(0, op.length - 1), cur, v)
                bb = rr.b; v = rr.v
            }
            bb.NewStore(bb.NewCall(rtInt2str, v), getVarSlot(name))
            bb.NewStore(one, getDefSlot(name))
            return {b: bb, v: v}
        }
    }

    // ===================================================================================
    //  Condition thunks (bare functions):  function(b, ci) -> {b, v: i1}
    // ===================================================================================

    function mkDefined(name) {
        return function(b, ci) { return {b: b, v: b.NewICmp(NE, b.NewLoad(i32, getDefSlot(name)), zero)} }
    }
    function mkErrLevel(wT) {
        return function(b, ci) {
            var r = wT.fn(b)
            var bb = r.b
            return {b: bb, v: bb.NewICmp(SGE, bb.NewLoad(i32, gErrLvl), bb.NewCall(rtStr2int, r.v))}
        }
    }
    function mkExist(wT) {
        return function(b, ci) {
            var r = wT.fn(b)
            var bb = r.b
            return {b: bb, v: bb.NewICmp(NE, bb.NewCall(rtFskind, r.v), zero)}
        }
    }
    function mkStrCmp(items) {
        var lT = items[0], rT = items[2]
        return function(b, ci) {
            var rl = lT.fn(b), rr = rT.fn(rl.b)
            var bb = rr.b
            var f = ci ? rtStreqi : rtStreq
            return {b: bb, v: bb.NewICmp(NE, bb.NewCall(f, [rl.v, rr.v]), zero)}
        }
    }
    function mkCmp(items) {
        var lT = items[0], op = items[1], rT = items[2]
        return function(b, ci) {
            var rl = lT.fn(b), rr = rT.fn(rl.b)
            var bb = rr.b
            var il = bb.NewCall(rtStr2int, rl.v), ir = bb.NewCall(rtStr2int, rr.v)
            var pred = null
            if (op == "EQU" || op == "equ") { pred = EQ }
            if (op == "NEQ" || op == "neq") { pred = NE }
            if (op == "LSS" || op == "lss") { pred = SLT }
            if (op == "LEQ" || op == "leq") { pred = SLE }
            if (op == "GTR" || op == "gtr") { pred = SGT }
            if (op == "GEQ" || op == "geq") { pred = SGE }
            return {b: bb, v: bb.NewICmp(pred, il, ir)}
        }
    }

    // ===================================================================================
    //  Statement thunks (bare functions):  function(b) -> continuation block.
    // ===================================================================================

    var Lblocks = null      // one block per top-level item (+ end)
    var labelIdx = null
    var exitBlock = null
    var returnDispatch = null
    var retSites = []
    var batSetlocal = null, batEndlocal = null, batShift = null, batLookup = null

    function makeNop() { return function(b) { return b } }
    function makeGroup(rec) { return rec.body }
    function makeEcho(wordT) {
        return function(b) {
            var r = wordT.fn(b)
            b = r.b
            b.NewCall(rtPrintln, r.v)
            return b
        }
    }
    function makeVer() {
        return function(b) {
            b.NewCall(rtPrintln, gepStr(b, "Microsoft Windows [Version 10.0.19045.0]"))
            b.NewStore(zero, gErrLvl)
            return b
        }
    }
    function makeSet(items) {
        var name = items[0], valT = items[1]
        return function(b) {
            var r = valT.fn(b)
            b = r.b
            var isEmpty = b.NewICmp(EQ, b.NewCall(rtStrlen, r.v), zero)
            b.NewStore(r.v, getVarSlot(name))
            b.NewStore(b.NewSelect(isEmpty, zero, one), getDefSlot(name))
            return b
        }
    }
    function makeSetP(items) {                     // no stdin here: the prompt is evaluated only
        var promptT = items[1]
        return function(b) { var r = promptT.fn(b); return r.b }
    }
    function makeSetA(arithT) { return function(b) { var r = arithT(b); return r.b } }
    function makeShift(items) {
        var from = 0
        if (items.length > 0) { from = parseDec(items[0].substring(1)) }
        return function(b) { b.NewCall(batShift, ci32(from)); return b }
    }
    function makeSetlocal(opts) {
        var dly = 0                                // 0 = leave, 1 = enable, 2 = disable
        var i
        for (i = 0; i < opts.length; i++) {
            var o = lower(opts[i])
            if (o == "enabledelayedexpansion") { dly = 1 }
            if (o == "disabledelayedexpansion") { dly = 2 }
        }
        return function(b) {
            b.NewCall(batSetlocal)
            if (dly == 1) { b.NewStore(one, gDelayed) }
            if (dly == 2) { b.NewStore(zero, gDelayed) }
            return b
        }
    }
    function makeEndlocal() { return function(b) { b.NewCall(batEndlocal); return b } }
    function makeCallSet(items) {
        var name = items[0], valT = items[1]
        return function(b) {
            var r = valT.fn(b)
            b = r.b
            var v = b.NewCall(rtExpand, r.v)
            var isEmpty = b.NewICmp(EQ, b.NewCall(rtStrlen, v), zero)
            b.NewStore(v, getVarSlot(name))
            b.NewStore(b.NewSelect(isEmpty, zero, one), getDefSlot(name))
            return b
        }
    }

    // Pop a return id (or leave main with the current errorlevel when the stack is empty).
    function emitReturn(b) {
        var sp = b.NewLoad(i32, gCsp)
        var exitP = nb(), popP = nb()
        b.NewCondBr(b.NewICmp(EQ, sp, zero), exitP, popP)
        exitP.NewStore(exitP.NewLoad(i32, gErrLvl), gExitCode)
        exitP.NewBr(exitBlock)
        var sp2 = popP.NewSub(sp, one)
        popP.NewStore(sp2, gCsp)
        popP.NewStore(popP.NewLoad(i32, popP.NewGetElementPtr(cstackTy, gCstack, zero, sp2)), gRetId)
        popP.NewBr(returnDispatch)
    }
    function labelMissing(b, name) {
        b.NewCall(rtPrintln, gepStr(b, "The system cannot find the batch label specified - " + name))
        b.NewStore(one, gExitCode)
        b.NewBr(exitBlock)
    }
    function makeGoto(name) {
        return function(b) {
            if (name == "eof") { emitReturn(b); return deadBlock() }
            if (!hasOwn(labelIdx, "$" + name)) { labelMissing(b, name); return deadBlock() }
            b.NewBr(Lblocks[labelIdx["$" + name]])
            return deadBlock()
        }
    }
    function makeCall(items) {
        var label = items[0]
        var argTs = items.slice(1)
        return function(b) {
            if (!hasOwn(labelIdx, "$" + label)) { labelMissing(b, label); return deadBlock() }
            // Evaluate the arguments in the CALLER's frame, then open a new one.
            var vals = [], tail = null, i
            for (i = 0; i < argTs.length; i++) {
                var r = argTs[i].fn(b)
                b = r.b
                vals.push(r.v)
                tail = (tail == null) ? r.v : b.NewCall(rtStrcat, [b.NewCall(rtStrcat, [tail, gepStr(b, " ")]), r.v])
            }
            if (tail == null) { tail = emptyPtr(b) }
            var fr = b.NewAdd(b.NewLoad(i32, gFrame), one)
            var base = b.NewMul(fr, ci32(ARGN))
            for (i = 0; i < ARGN; i++) {
                var v = (i < vals.length) ? vals[i] : emptyPtr(b)
                b.NewStore(v, b.NewGetElementPtr(argsTy, gArgs, zero, b.NewAdd(base, ci32(i))))
            }
            b.NewStore(tail, b.NewGetElementPtr(frameTy, gArgTail, zero, fr))
            b.NewStore(gepStr(b, ":" + label), b.NewGetElementPtr(frameTy, gArgLbl, zero, fr))
            b.NewStore(fr, gFrame)
            // The call returns to RIGHT HERE, not to the next top-level line: a fresh
            // continuation block is registered as the return site and handed back as the
            // current block. Returning to the next line instead made a 'call' inside a for
            // body end the LOOP after one round.
            var contB = nb()
            var retid = retSites.length
            retSites.push(contB)
            var sp = b.NewLoad(i32, gCsp)
            b.NewStore(ci32(retid), b.NewGetElementPtr(cstackTy, gCstack, zero, sp))
            b.NewStore(b.NewAdd(sp, one), gCsp)
            b.NewBr(Lblocks[labelIdx["$" + label]])
            contB.NewStore(contB.NewSub(contB.NewLoad(i32, gFrame), one), gFrame)
            return contB
        }
    }
    function makeExitB(items) {
        var codeT = (items.length > 0) ? items[0] : null
        return function(b) {
            if (codeT != null) {
                var r = codeT.fn(b); b = r.b
                b.NewStore(b.NewCall(rtStr2int, r.v), gErrLvl)
            }
            emitReturn(b)
            return deadBlock()
        }
    }
    function makeExit(items) {
        var codeT = (items.length > 0) ? items[0] : null
        return function(b) {
            var code = b.NewLoad(i32, gErrLvl)
            if (codeT != null) { var r = codeT.fn(b); b = r.b; code = b.NewCall(rtStr2int, r.v) }
            b.NewStore(code, gExitCode)
            b.NewBr(exitBlock)
            return deadBlock()
        }
    }
    function makeSeq(items) {
        return function(b) {
            var i
            for (i = 0; i < items.length; i++) { b = items[i](b) }
            return b
        }
    }
    function mkRedir(items) {
        var op = "", i
        for (i = 0; i < items.length; i++) { if (items[i].op != undefined) { op = items[i].op } }
        return {out: (op != "<")}
    }
    function makeRedir(items) {
        var st = items[0]
        if (items.length == 1) { return st }
        var out = false, i
        for (i = 1; i < items.length; i++) { if (items[i].out) { out = true } }
        if (!out) { return st }
        return function(b) {
            b.NewCall(rtCapStart)
            b = st(b)
            b.NewCall(rtCapEnd)
            return b
        }
    }
    function makeChain(items) {
        if (items.length == 1) { return items[0] }
        return function(b) {
            b = items[0](b)
            var i
            for (i = 1; i < items.length; i += 2) {
                var op = items[i]
                if (op == "&") { b = items[i + 1](b); continue }
                var el = b.NewLoad(i32, gErrLvl)
                var cond = (op == "&&") ? b.NewICmp(EQ, el, zero) : b.NewICmp(NE, el, zero)
                var runB = nb(), skipB = nb()
                b.NewCondBr(cond, runB, skipB)
                items[i + 1](runB).NewBr(skipB)
                b = skipB
            }
            return b
        }
    }
    function makeIf(items) {
        var neg = false, ci = false, idx = 0
        while (idx < items.length && items[idx] != null && typeof items[idx] == "object"
               && (items[idx].neg != undefined || items[idx].ci != undefined)) {
            if (items[idx].neg != undefined) { neg = true }
            if (items[idx].ci != undefined) { ci = true }
            idx = idx + 1
        }
        var condT = items[idx]
        var thenT = items[idx + 1].body
        var elseT = (items.length > idx + 2) ? items[idx + 2].body : null
        return function(b) {
            var rc = condT(b, ci)
            b = rc.b
            var cond = rc.v
            if (neg) { cond = b.NewXor(cond, truei1) }
            var thenB = nb(), merge = nb()
            var elseB = (elseT != null) ? nb() : merge
            b.NewCondBr(cond, thenB, elseB)
            thenT(thenB).NewBr(merge)
            if (elseT != null) { elseT(elseB).NewBr(merge) }
            return merge
        }
    }
    // items = [letter, wordObj..., {body:bodySeq}]. The word list is static -> unrolled.
    function makeFor(items) {
        var letter = items[0].fv
        var bodyT = items[items.length - 1].body
        var words = items.slice(1, items.length - 1)
        return function(b) {
            var j
            for (j = 0; j < words.length; j++) {
                var r = words[j].fn(b)
                b = r.b
                b.NewStore(r.v, getForSlot(letter))
                b = bodyT(b)
            }
            return b
        }
    }
    // for /l: a real counted loop. Counter, step and end live in globals rather than phis,
    // so a `call` in the body (which returns through the shared dispatch block, and so does
    // not preserve dominance) cannot invalidate them.
    var loopCount = 0
    function makeForL(items) {
        var letter = items[0].fv
        var sT = items[1], pT = items[2], eT = items[3]
        var bodyT = items[4].body
        loopCount = loopCount + 1
        var gI = m.NewGlobalDef("fl_i" + loopCount, zero)
        var gStep = m.NewGlobalDef("fl_s" + loopCount, zero)
        var gEnd = m.NewGlobalDef("fl_e" + loopCount, zero)
        return function(b) {
            var r1 = sT.fn(b); b = r1.b
            b.NewStore(b.NewCall(rtStr2int, r1.v), gI)
            var r2 = pT.fn(b); b = r2.b
            b.NewStore(b.NewCall(rtStr2int, r2.v), gStep)
            var r3 = eT.fn(b); b = r3.b
            b.NewStore(b.NewCall(rtStr2int, r3.v), gEnd)
            var head = nb(), body = nb(), done = nb()
            b.NewBr(head)
            var iv = head.NewLoad(i32, gI), sv = head.NewLoad(i32, gStep), ev = head.NewLoad(i32, gEnd)
            var up = head.NewICmp(SGT, sv, zero)
            var goOn = head.NewSelect(up, head.NewICmp(SLE, iv, ev), head.NewICmp(SGE, iv, ev))
            var alive = head.NewAnd(goOn, head.NewICmp(NE, sv, zero))
            head.NewCondBr(alive, body, done)
            body.NewStore(body.NewCall(rtInt2str, body.NewLoad(i32, gI)), getForSlot(letter))
            var after = bodyT(body)
            after.NewStore(after.NewAdd(after.NewLoad(i32, gI), after.NewLoad(i32, gStep)), gI)
            after.NewBr(head)
            return done
        }
    }
    // ----- for /f -----
    function parseFOpts(raw) {
        var o = {eol: ";", skip: 0, delims: " \t", tokens: "1"}
        if (raw == null) { return o }
        var s = raw.substring(1, raw.length - 1)
        var i = 0
        while (i < s.length) {
            while (i < s.length && (s.charAt(i) == " " || s.charAt(i) == "\t")) { i = i + 1 }
            var ks = i
            while (i < s.length && s.charAt(i) != "=" && s.charAt(i) != " " && s.charAt(i) != "\t") { i = i + 1 }
            var key = lower(s.substring(ks, i))
            var val = ""
            if (i < s.length && s.charAt(i) == "=") {
                i = i + 1
                var vs = i
                while (i < s.length && s.charAt(i) != " " && s.charAt(i) != "\t") { i = i + 1 }
                val = s.substring(vs, i)
            }
            if (key == "eol") { o.eol = val }
            if (key == "skip") { o.skip = parseDec(val) }
            if (key == "delims") { o.delims = val }
            if (key == "tokens") { o.tokens = val }
        }
        return o
    }
    function parseTokens(spec) {
        var nums = [], star = false, cur = "", lastNum = 0, i
        var s = spec + ","
        for (i = 0; i < s.length; i++) {
            var ch = s.charAt(i)
            if (ch == "*") { star = true; continue }
            if (ch == ",") {
                if (cur != "") {
                    var dash = -1, k
                    for (k = 1; k < cur.length; k++) { if (cur.charAt(k) == "-") { dash = k } }
                    if (dash > 0) {
                        var a = parseDec(cur.substring(0, dash)), z = parseDec(cur.substring(dash + 1))
                        var j = a
                        while (j <= z) { nums.push(j); lastNum = j; j = j + 1 }
                    } else { var n1 = parseDec(cur); nums.push(n1); lastNum = n1 }
                }
                cur = ""
                continue
            }
            cur = cur + ch
        }
        return {nums: nums, star: star, last: lastNum}
    }
    function makeForF(items) {
        var idx = 0, optRaw = null
        if (items[0].opts != undefined) { optRaw = items[0].opts; idx = 1 }
        var letter = items[idx].fv
        var src = items[idx + 1]
        var bodyT = items[idx + 2].body
        var o = parseFOpts(optRaw)
        var spec = parseTokens(o.tokens)
        loopCount = loopCount + 1
        var gText = m.NewGlobalDef("ff_t" + loopCount, nullStr)
        var gIdx = m.NewGlobalDef("ff_i" + loopCount, zero)
        return function(b) {
            var txt
            if (src.lit != undefined) {
                var r = src.lit.fn(b); b = r.b
                txt = b.NewCall(rtStripq, r.v)
            } else if (src.file != undefined) {
                var rf = src.file.fn(b); b = rf.b
                txt = emptyPtr(b)                      // no contents in the path model
            } else {
                b.NewCall(rtCapStart)
                b = src.cmd(b)
                txt = b.NewCall(rtCapEnd)
            }
            b.NewStore(txt, gText)
            b.NewStore(ci32(o.skip), gIdx)
            var head = nb(), body = nb(), cont = nb(), done = nb()
            b.NewBr(head)
            var t = head.NewLoad(i8ptr, gText)
            var iv = head.NewLoad(i32, gIdx)
            head.NewCondBr(head.NewICmp(SGE, iv, head.NewCall(rtNlines, t)), done, body)
            var line = body.NewCall(rtLineat, [t, iv])
            var dl = gepStr(body, o.delims)
            // skip a comment line (eol=) and a line with no tokens at all
            var bad = body.NewICmp(SLT, body.NewCall(rtTokb, [line, dl, one, zero]), zero)
            if (o.eol != "") {
                var c0 = body.NewSExt(body.NewLoad(i8, body.NewGetElementPtr(i8, line, zero)), i32)
                bad = body.NewOr(bad, body.NewICmp(EQ, c0, ci32(o.eol.charCodeAt(0))))
            }
            var run = nb()
            body.NewCondBr(bad, cont, run)
            var k
            for (k = 0; k < spec.nums.length; k++) {
                var tk = spec.nums[k]
                var st = run.NewCall(rtTokb, [line, dl, ci32(tk), zero])
                var en = run.NewCall(rtTokb, [line, dl, ci32(tk), one])
                var have = run.NewICmp(SGE, st, zero)
                var val = run.NewCall(rtSub, [line, run.NewSelect(have, st, zero), run.NewSelect(have, en, zero)])
                run.NewStore(val, getForSlot(nextLetter(letter, k)))
            }
            if (spec.star) {
                var rest
                if (spec.last == 0) {
                    var s0 = run.NewCall(rtTokb, [line, dl, one, zero])
                    rest = run.NewCall(rtSub, [line, s0, run.NewCall(rtStrlen, line)])
                } else {
                    var p0 = run.NewCall(rtTokb, [line, dl, ci32(spec.last), two])
                    var okp = run.NewICmp(SGE, p0, zero)
                    var ln = run.NewCall(rtStrlen, line)
                    rest = run.NewCall(rtSub, [line, run.NewSelect(okp, p0, ln), ln])
                }
                run.NewStore(rest, getForSlot(nextLetter(letter, spec.nums.length)))
            }
            bodyT(run).NewBr(cont)
            cont.NewStore(cont.NewAdd(cont.NewLoad(i32, gIdx), one), gIdx)
            cont.NewBr(head)
            return done
        }
    }

    // ===================================================================================
    //  Program: the flat line list becomes a chain of blocks driven by branches.
    // ===================================================================================

    function fillReturnDispatch() {
        if (retSites.length == 0) { returnDispatch.NewBr(exitBlock); return }
        var rid = returnDispatch.NewLoad(i32, gRetId)
        var cur = returnDispatch, i
        for (i = 0; i < retSites.length; i++) {
            var isMatch = cur.NewICmp(EQ, rid, ci32(i))
            var nextChk = (i < retSites.length - 1) ? nb() : exitBlock
            cur.NewCondBr(isMatch, retSites[i], nextChk)
            cur = nextChk
        }
    }

    // setlocal / endlocal snapshot the whole environment. The slot list is only complete
    // once every line has been emitted, so the two functions are declared up front and
    // their bodies are filled in at the end.
    function fillLocals() {
        var N = varSlotList.length
        if (N == 0) { N = 1 }
        var LDEPTH = 32
        var lvTy = llvm.types.NewArray(LDEPTH * N, i8ptr)
        var ldTy = llvm.types.NewArray(LDEPTH * N, i32)
        var gLv = m.NewGlobalDef("loc_v", llvm.constant.NewZeroInitializer(lvTy))
        var gLd = m.NewGlobalDef("loc_d", llvm.constant.NewZeroInitializer(ldTy))
        var gLy = m.NewGlobalDef("loc_dly", llvm.constant.NewZeroInitializer(llvm.types.NewArray(LDEPTH, i32)))
        var gLsp = m.NewGlobalDef("loc_sp", zero)
        var i
        var e = batSetlocal.NewBlock("entry")
        var sp = e.NewLoad(i32, gLsp)
        var base = e.NewMul(sp, ci32(N))
        for (i = 0; i < varSlotList.length; i++) {
            e.NewStore(e.NewLoad(i8ptr, varSlotList[i]), e.NewGetElementPtr(lvTy, gLv, zero, e.NewAdd(base, ci32(i))))
            e.NewStore(e.NewLoad(i32, defSlotList[i]), e.NewGetElementPtr(ldTy, gLd, zero, e.NewAdd(base, ci32(i))))
        }
        e.NewStore(e.NewLoad(i32, gDelayed), e.NewGetElementPtr(llvm.types.NewArray(LDEPTH, i32), gLy, zero, sp))
        e.NewStore(e.NewAdd(sp, one), gLsp)
        e.NewRet(zero)
        var x = batEndlocal.NewBlock("entry")
        var xEmpty = batEndlocal.NewBlock("empty"), xPop = batEndlocal.NewBlock("pop")
        var sp0 = x.NewLoad(i32, gLsp)
        x.NewCondBr(x.NewICmp(EQ, sp0, zero), xEmpty, xPop)
        xEmpty.NewRet(zero)
        var sp1 = xPop.NewSub(sp0, one)
        xPop.NewStore(sp1, gLsp)
        var base2 = xPop.NewMul(sp1, ci32(N))
        for (i = 0; i < varSlotList.length; i++) {
            xPop.NewStore(xPop.NewLoad(i8ptr, xPop.NewGetElementPtr(lvTy, gLv, zero, xPop.NewAdd(base2, ci32(i)))), varSlotList[i])
            xPop.NewStore(xPop.NewLoad(i32, xPop.NewGetElementPtr(ldTy, gLd, zero, xPop.NewAdd(base2, ci32(i)))), defSlotList[i])
        }
        xPop.NewStore(xPop.NewLoad(i32, xPop.NewGetElementPtr(llvm.types.NewArray(LDEPTH, i32), gLy, zero, sp1)), gDelayed)
        xPop.NewRet(zero)
    }
    // bat_lookup(name) backs the SECOND expansion pass of `call set NAME=%%%indirect%%%`.
    function fillLookup() {
        var nm = batLookup.Params[0]
        var cur = batLookup.NewBlock("entry"), i
        for (i = 0; i < varNameList.length; i++) {
            var hit = batLookup.NewBlock(""), miss = batLookup.NewBlock("")
            cur.NewCondBr(cur.NewICmp(NE, cur.NewCall(rtStreqi, [nm, gepStr(cur, varNameList[i])]), zero), hit, miss)
            hit.NewRet(hit.NewLoad(i8ptr, varSlotList[i]))
            cur = miss
        }
        cur.NewRet(emptyPtr(cur))
    }
    function runProgram(items) {
        batSetlocal = m.NewFunc("bat_setlocal", i32)
        batEndlocal = m.NewFunc("bat_endlocal", i32)
        // bat_shift is DEFINED in languages/lib/batch-rt.c - it walks ARGN and the frame
        // stride, both compile-time constants, so unlike the other four it never depended
        // on the program being compiled.
        batShift = m.NewFunc("bat_shift", i32, llvm.ir.NewParam("from", i32))
        batLookup = m.NewFunc("bat_lookup", i8ptr, llvm.ir.NewParam("nm", i8ptr))
        var main = m.NewFunc("main", i32)
        curF = main
        var entry = main.NewBlock("entry")
        exitBlock = main.NewBlock("exit")
        returnDispatch = main.NewBlock("retdisp")
        Lblocks = []
        var k
        for (k = 0; k < items.length; k++) { Lblocks.push(main.NewBlock("L" + k)) }
        Lblocks.push(main.NewBlock("Lend")) // one past the end
        labelIdx = {}
        for (k = 0; k < items.length; k++) { if (items[k].lbl != undefined) { labelIdx["$" + items[k].lbl] = k } }
        // Emit each line into its block; fall-through branches to the next block. Lblocks[k]
        // is the line PROLOGUE: the %VAR% snapshot stores land there, and it is terminated
        // only once the whole line has been emitted.
        for (k = 0; k < items.length; k++) {
            var it = items[k]
            if (it.lbl != undefined) {
                Lblocks[k].NewBr(Lblocks[k + 1])
            } else {
                linePro = Lblocks[k]
                lineNoted = {}
                var body = main.NewBlock("S" + k)
                var cont = it.stmt(body)
                cont.NewBr(Lblocks[k + 1])
                linePro.NewBr(body)
            }
        }
        // Falling off the end -> exit with the current errorlevel.
        Lblocks[items.length].NewStore(Lblocks[items.length].NewLoad(i32, gErrLvl), gExitCode)
        Lblocks[items.length].NewBr(exitBlock)
        exitBlock.NewRet(exitBlock.NewLoad(i32, gExitCode))
        fillReturnDispatch()
        fillLocals(); fillLookup()
        // entry: initialize every slot, empty the stacks, jump to the first line.
        var ep = emptyPtr(entry)
        var i
        for (i = 0; i < varSlotList.length; i++) { entry.NewStore(ep, varSlotList[i]) }
        for (i = 0; i < pctSlotList.length; i++) { entry.NewStore(ep, pctSlotList[i]) }
        for (i = 0; i < forSlotList.length; i++) { entry.NewStore(ep, forSlotList[i]) }
        for (i = 0; i < defSlotList.length; i++) { entry.NewStore(zero, defSlotList[i]) }
        for (i = 0; i < ARGN; i++) { entry.NewStore(ep, entry.NewGetElementPtr(argsTy, gArgs, zero, ci32(i))) }
        entry.NewStore(ep, entry.NewGetElementPtr(frameTy, gArgTail, zero, zero))
        entry.NewStore(ep, entry.NewGetElementPtr(frameTy, gArgLbl, zero, zero))
        entry.NewStore(zero, gCsp)
        entry.NewStore(zero, gFrame)
        entry.NewStore(zero, gErrLvl)
        entry.NewStore(zero, gDelayed)
        entry.NewBr(items.length > 0 ? Lblocks[0] : exitBlock)
    }

    c.compile(c.asg)

    // The runtime lives next to THIS grammar, so neither the build nor the run depends
    // on the working directory. An explicit -rt REPLACES it.
    function libPath(name) {
        var mn = moduleName()
        var cut = -1
        var i = 0
        while (i < mn.length) {
            var ch = mn.charAt(i)
            if (ch == "/" || ch == "\\") { cut = i }
            i = i + 1
        }
        return mn.substring(0, cut + 1) + "lib/" + name
    }
    var rts = c.runtime
    if (rts == undefined || rts.length == 0) { rts = [libPath("batch-rt.ll")] }

    // With -exe PATH, link the module into a native executable (clang) instead of
    // running it in the built-in IR interpreter. Both paths link the SAME runtime
    // module: llvm.Run parses it and binds the declarations (abnf/llvmlink.go),
    // clang links the two objects.
    if (c.exePath != undefined && c.exePath != "") {
        var buildErr = llvm.BuildExecutable(m, c.exePath, rts)
        if (buildErr != "") { println(buildErr); exit(1) }
        println("batch-to-llvm-ir: wrote executable " + c.exePath)
        exit(0)
    }

    println(m)
    var res = llvm.Run(m, "main", "", rts)
    print(res.Out)
    println("batch-to-llvm-ir: exit status " + res.Ret)
    exit(res.Ret)

~~) ;
