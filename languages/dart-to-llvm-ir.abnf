            else if (it.field != undefined) { fields.push(it) }
            else if (it.sfield != undefined) { sfields.push(it) }
            else if (it.method != undefined) { methods.push(it.method) }
            else if (it.smethod != undefined) { smethods.push(it.smethod) }
