    // Inheritance is FLATTENED at class-creation time: the members of the superclass and
    // then of each mixin (a later mixin winning over an earlier one) are copied onto the
    // descriptor before its own members are set, which is the linearisation Dart
    // specifies for the shapes this front end supports. __-prefixed slots are not copied
    // (js_keys skips them), so __ctor and __super stay the class's own.

    // Names any class declares as a getter / setter / operator anywhere in the program.
    // A member access has no static type here, so these drive a RUNTIME probe at the use
    // site - and a program that declares none emits exactly the IR it did before.
    var getterNames = {}
    var setterNames = {}
    var operatorNames = {}

    function bodyOf(items) {
        for (var i = items.length - 1; i >= 0; i--) {
            var it = items[i]
            if (it != undefined && (it.body != undefined || it.ebody != undefined || it.none != undefined
                                    || it.redirectTo != undefined)) { return it }
