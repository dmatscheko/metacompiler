:title("Dart to LLVM IR compiler") ;
:description("Compiles a practical subset of Dart to an LLVM IR module and runs it with the
built-in IR interpreter.

The language is exactly the one of dart-interpreter.abnf; see there for a description. It
has top level and nested functions (block and arrow bodies), typed declarations whose type
is erased, var/final/const, classes with fields, methods, constructors and
field-initialising formals, construction with or without new, this.field and implicit field
access inside methods, List and Map literals, index/member access, string interpolation
($name and ${expr}) inside single and double quotes, if/else, while, C-style for and
for (x in coll), closures with real captured scopes, print(...), + - * / ~/ % , comparisons,
&& || ! and the ternary operator.

The emitted IR is handle-threaded code: every dynamic value is an i64 handle into the value
table of the shared Go side runtime (abnf/jsrt.go), and every operation with real semantics
is a call to one of its js_* externals (js_jadd, js_get, js_call, js_mcall, js_pyget, ...).
Only the control flow is real IR. Variables live in scope-chain objects (js_scope_* and the
this-aware js_kget/js_kset); a function/closure becomes an own IR function jsf_N(env, args)
plus a js_closure at the site of its creation. Classes become descriptor objects: an
instance is a js_obj_new carrying a __class handle, methods are closures on the descriptor,
and construction runs the __ctor closure with the fresh instance prepended, so a member call
dispatches through js_mcall (Go memberCall) exactly like the interpreter.

The top level becomes dartmain(env, args), which runs the program declarations and then
calls int main(); its return value is the exit code of the metacompiler run, so the test
programs are self checking (0 on success). The same subset is interpreted directly by
dart-interpreter.abnf. Constructs outside the subset (mixins/inheritance, async/await, named
constructors, the null-assertion !) are accepted structurally and reported as not
implemented under -warn-unsupported; the nullable type marker ? is erased.") ;


// --- main rules

// Shared token productions (languages/lib).
:include("lib/cstyle-comments.abnf") ;
:include("lib/ident.abnf") ;
:include("lib/numbers.abnf") ;
:include("lib/bools.abnf") ;

:startRule(Program) ;
:whitespace(Whitespace) ;

// The merged statement thunks of the top level become dartmain(env, args) in the module.
// Leading directives (import / export / part / library) are accepted and not implemented.
Program     <~~ buildMain(takeAll()) ~~>
            = { Directive } { Statement } ;

// Library directives: accepted, not implemented (there is no module system). Each pushes
// nothing, so only the statement thunks reach buildMain.
Directive   = ImportD | ExportD | PartD | LibraryD ;
// import 'lib.dart'; maps to a project file (searched under the program's directory and the
// -i roots); a dart: import (dart:math, ...) is a builtin no-op. ImportUri captures the main
// URI with its surrounding quotes stripped and hands it to resolveImport; the show/hide
// combinators and a conditional-import URI are parsed and ignored.
ImportD     <~~ resolveImport(pop(), up.pos) ~~>
            = KwImport ImportUri [ KwAs Id ] { Combinator } [ KwIf SkipParen UriStr ] ";" ;
ImportUri   <~~ push(uriPath(up.in)) ~~>
            = UriStr ;
ExportD     <~~ notImpl("export directive", up.pos) ~~>
            = KwExport UriStr { Combinator } ";" ;
PartD       <~~ notImpl("part directive", up.pos) ~~>
            = KwPart [ KwOf ] ( UriStr | QualName ) ";" ;
LibraryD    <~~ notImpl("library directive", up.pos) ~~>
            = KwLibrary [ QualName ] ";" ;
Combinator  = ( KwShow | KwHide ) Id { "," Id } ;
UriStr      = SkipSqStr | SkipDqStr ;
QualName    = Id { "." Id } ;

// Every statement production pushes exactly one thunk: function(block) -> block.
// The keyword-led statements come first: otherwise 'return x;' would parse as a variable
// declaration of a variable x with the (identifier-shaped) type 'return'.
Statement   <~~ push(stmtPos(pop())) ~~>
            = [ Annotations ] StatementBody ;
StatementBody = Block | ClassDecl | EnumDecl | MixinDecl | ExtensionDecl | TypedefDecl
            | If | Switch | While | DoWhile | For | TryStmt | Return
            | Break | Continue | Rethrow | ThrowStmt | Assert | TopGetter | TopSetter
            | FuncDecl | VarDecl | LabeledStmt
            | Empty | ExprStmt ;

// Metadata annotations (@Foo, @Foo.bar, @Foo(args)) are parsed and erased, like in Java.
Annotations = Annotation { Annotation } ;
Annotation  = "@" Id { "." Id } [ SkipParen ] ;

// Top-level declarations accepted structurally and reported as not implemented; their
// bodies are matched with SkipBlock so a full file parses.
EnumDecl    <~~ push(notImplStmt("enum declaration", up.pos)) ~~>
            = KwEnum Id [ SkipAngle ] [ KwWith Type { "," Type } ] [ KwImplements Type { "," Type } ] SkipBlock ;
// A mixin is a class body with no constructor. Its `on` type is the superclass interface
// it may call through with super, so it becomes the mixin descriptor's __super.
MixinDecl   <~~ push(makeClassStmt(takeAll())) ~~>
            = [ MixinMods ] KwMixin [ KwClass ] CName [ SkipAngle ] [ KwOn OnType { "," OnType } ]
              [ ImplementsClause ] "{" { Member } "}" ;
OnType      <~~ push({con: up.in}) ~~> = TypeNamed ;
ExtensionDecl <~~ push(notImplStmt("extension declaration", up.pos)) ~~>
            = KwExtension [ KwType ] [ Id ] [ SkipAngle ] KwOn Type SkipBlock ;
// A typedef only names a type, and all types are erased here, so it compiles to nothing.
TypedefDecl <~~ push(function(b) { return b }) ~~>
            = KwTypedef ( TypedefNew | TypedefOld ) ;
TypedefNew  = Id [ SkipAngle ] "=" Type ";" ;
TypedefOld  = Type Id [ SkipAngle ] SkipParen ";" ;

Block       <~~ push(makeBlockStmt(takeAll())) ~~>
            = "{" { Statement } "}" ;

// class Name { fields; constructors; methods }. Class modifiers (abstract, base, final,
// interface, sealed, mixin) are parsed and erased so the class still compiles.
// extends contributes implementation, with contributes mixins (a later one wins over an
// earlier one) and implements contributes nothing but a nominal type.
ClassDecl   <~~ push(makeClassStmt(takeAll())) ~~>
            = [ ClassMods ] KwClass CName [ SkipAngle ]
              [ ExtendsClause ] [ WithClause ] [ ImplementsClause ] "{" { Member } "}" ;
CName       <~~ push({cname: up.in}); curClassName = up.in ~~> = Id ;
ClassMods   = { ClassMod } ;
ClassMod    = ( "abstract" | "base" | "final" | "interface" | "sealed" | "mixin" ) KwEnd ;
// The same modifiers WITHOUT "mixin": a greedy ClassMods would eat the `mixin` keyword of
// a mixin declaration itself, and this is a PEG - the committed repetition never gives it back.
MixinMods   = MixinMod { MixinMod } ;
MixinMod    = ( "abstract" | "base" | "final" | "interface" | "sealed" ) KwEnd ;
ExtendsClause = KwExtends SuperType ;
SuperType   <~~ push({csuper: up.in}) ~~> = TypeNamed ;
WithClause  = KwWith MixinType { "," MixinType } ;
MixinType   <~~ push({cmixin: up.in}) ~~> = TypeNamed ;
ImplementsClause = KwImplements IfaceType { "," IfaceType } ;
IfaceType   <~~ push({ciface: up.in}) ~~> = TypeNamed ;

// A member is a field, a method (Type? name(params) body) or a constructor (name == the
// class name). One Member can declare SEVERAL things (`final int x, y;`), so the tag
// pushes one descriptor per declared member rather than a single one. Metadata
// annotations are erased; the member modifiers reach pushMembers as {mmod} markers.
Member      <~~ pushMembers(takeAll()) ~~>
            = [ Annotations ] [ MemberMods ] MemberCore ;
MemberCore  = GetterMember | SetterMember | OperatorMember | FactoryMember
            | NamedCtorMember | PlainFnMember | TypedFnMember | FieldMember ;
MemberMods  = MemberMod { MemberMod } ;
MemberMod   <~~ push({mmod: up.in}) ~~>
            = ( "static" | "covariant" | "external" | "abstract" ) KwEnd ;
// The bare (no return type) form is tried first: an optional leading Type would greedily
// consume the get/set/operator keyword itself (it is a valid identifier) and then commit.
// A getter becomes the class entry "get$name" and a setter "set$name" - a field read /
// write finds them by key - and an operator its own symbol.
GetterMember   <~~ push(makeAccessor("get$", takeAll())) ~~>
            = KwGet MName MemberBody | Type KwGet MName MemberBody ;
SetterMember   <~~ push(makeAccessor("set$", takeAll())) ~~>
            = KwSet MName ParamList MemberBody | Type KwSet MName ParamList MemberBody ;
OperatorMember <~~ push(makeAccessor("", takeAll())) ~~>
            = KwOperator OpName ParamList MemberBody | Type KwOperator OpName ParamList MemberBody ;
OpName      <~~ push({mn: up.in}) ~~> = OverloadableOp ;
// A factory constructor RETURNS an instance rather than initialising a fresh one.
FactoryMember  <~~ push(makeCtorMember(true, takeAll())) ~~>
            = [ KwConst ] KwFactory Id [ "." MName ] ParamList ( MemberBody | FactoryRedirect ) ;
FactoryRedirect <~~ push(makeFactoryRedirect(takeAll())) ~~> = "=" FRTarget ";" ;
FRTarget    <~~ push({frto: up.in}) ~~> = Type [ "." Id ] ;
OverloadableOp = "[]=" | "[]" | "==" | "<=" | ">=" | ">>>" | "<<" | ">>" | "~/"
            | "+" | "-" | "*" | "/" | "%" | "<" | ">" | "&" | "|" | "^" | "~" ;
NamedCtorMember <~~ push(makeCtorMember(false, takeAll())) ~~>
            = [ CtorConst ] Id "." MName [ SkipAngle ] ParamList [ CtorInit ] MemberBody ;
// A const constructor CANONICALIZES: two creations with equal arguments are identical().
CtorConst   <~~ push({cconst: true}) ~~> = KwConst ;
PlainFnMember <~~ push(makeMember(false, takeAll())) ~~>
            = [ KwConst ] MName [ SkipAngle ] ParamList [ CtorInit ] MemberBody ;
TypedFnMember <~~ push(makeMember(true, takeAll())) ~~>
            = Type MName [ SkipAngle ] ParamList MemberBody ;
MName       <~~ push({mn: up.in}) ~~> = Id ;

// A constructor initializer list: `: assert(c), this.x = e, super(a)` or the redirect
// `: this(1, 1)`. The asserts are evaluated, the field initialisers run before the body,
// and the super / redirect call chains to the other constructor.
CtorInit    = ":" InitItem { "," InitItem } ;
InitItem    = CtorAssert | SuperCall | RedirectCall | FieldInit ;
CtorAssert  <~~ push({ciassert: takeAll()}) ~~>
            = KwAssert "(" Expression [ "," Expression ] [ "," ] ")" ;
SuperCall   <~~ push(makeSuperCall(takeAll())) ~~>
            = "super" KwEnd [ "." SCName ] "(" [ Arg { "," Arg } [ "," ] ] ")" ;
RedirectCall <~~ push(makeRedirectCall(takeAll())) ~~>
            = "this" KwEnd [ "." SCName ] "(" [ Arg { "," Arg } [ "," ] ] ")" ;
SCName      <~~ push({scname: up.in}) ~~> = Id ;
FieldInit   <~~ push(makeFieldInit(takeAll())) ~~>
            = [ "this" KwEnd "." ] FIName "=" AssignExpr ;
FIName      <~~ push({finame: up.in}) ~~> = Id ;

MemberBody  = [ AsyncMod ] MemberBodyKind ;
MemberBodyKind = MBlock | MArrow | MSemi ;
MBlock      <~~ push({body: pop()}) ~~>  = Block ;
MArrow      <~~ push({ebody: pop()}) ~~> = "=>" Expression ";" ;
MSemi       <~~ push({none: true}) ~~>   = ";" ;
AsyncMod    <~~ notImpl("async function", up.pos) ~~> = ( "async" | "sync" ) KwEnd [ "*" ] ;

// Fields: (Type | var | final [Type]) name [= init] { , name [= init] } ; - separate
// complete alternatives so the leading-type / no-type cases never get stuck in an optional.
FieldMember = FieldVar | FieldFinalTyped | FieldFinal | FieldConstTyped | FieldConst | FieldLate | FieldTyped ;
FieldVar        = KwVar        FieldList ";" ;
FieldFinalTyped = KwFinal Type FieldList ";" ;
FieldFinal      = KwFinal      FieldList ";" ;
FieldConstTyped = KwConst Type FieldList ";" ;
FieldConst      = KwConst      FieldList ";" ;
FieldLate       = KwLate ( KwFinal Type | KwFinal | KwVar | Type ) FieldList ";" ;
FieldTyped      = Type         FieldList ";" ;
FieldList   = FieldDecl { "," FieldDecl } ;
FieldDecl   <~~ push(makeFieldDecl(takeAll())) ~~>
            = Id <~~ push({fn: up.in}) ~~> [ "=" AssignExpr ] ;

// Function declarations (top level and nested). Two alternatives so the optional return
// type does not get stuck when it is absent.
FuncDecl    = FuncTyped | FuncPlain ;
FuncTyped   <~~ push(makeFuncDecl(takeAll())) ~~>
            = Type FName [ SkipAngle ] ParamList FnBody ;
FuncPlain   <~~ push(makeFuncDecl(takeAll())) ~~>
            = FName [ SkipAngle ] ParamList FnBody ;
FName       <~~ push({fname: up.in}) ~~> = Id ;
FnBody      = [ AsyncMod ] FnBodyKind ;
FnBodyKind  = FBlock | FArrow ;
FBlock      <~~ push({body: pop()}) ~~>  = Block ;
FArrow      <~~ push({ebody: pop()}) ~~> = "=>" Expression ";" ;

// A parameter list. this.x is a field-initialising formal; a bare or typed name is a plain
// parameter. TypedParam is tried before PlainParam (both are separate alternatives).
ParamList   <~~ push({params: takeAll()}) ~~>
            = "(" [ ParamItems ] ")" ;
ParamItems  = TailGroup | Param { "," Param } [ "," TailGroup ] [ "," ] ;
TailGroup   = NamedGroup | OptGroup ;
Param       = [ ParamMods ] ParamCore ;
ParamCore   = ThisParam | SuperParam | TypedParam | PlainParam ;
ParamMods   = ParamMod { ParamMod } ;
ParamMod    = ( "covariant" | "required" | "final" ) KwEnd ;
ThisParam   <~~ push({thisf: popName()}) ~~>
            = "this" KwEnd "." Id <~~ push({mname: up.in}) ~~> [ SkipParen ] ;
// A super parameter (2.17): IhKid(super.v) forwards v to the superclass constructor.
SuperParam  <~~ push(makeSuperParam(false, takeAll())) ~~>
            = "super" KwEnd "." Id <~~ push({mname: up.in}) ~~> [ SkipParen ] ;
TypedParam  <~~ push({pname: popName()}) ~~>
            = Type Id <~~ push({mname: up.in}) ~~> [ SkipParen ] ;
PlainParam  <~~ push({pname: up.in}) ~~> = Id ;

// Named (curly) parameters: foo({int a = 1, required int b, this.x = 0}). Optional, each
// with a default; unsupplied ones fall back to the default, else null. Marked named:true.
NamedGroup  = "{" NamedParam { "," NamedParam } [ "," ] "}" ;
NamedParam  = [ ParamMods ] NamedParamCore ;
NamedParamCore = NamedThisParam | NamedSuperParam | NamedTypedParam | NamedPlainParam ;
NamedThisParam  <~~ push(makeNamedParam(true, takeAll())) ~~>
            = "this" KwEnd "." Id <~~ push({mname: up.in}) ~~> [ "=" AssignExpr ] ;
NamedSuperParam <~~ push(makeSuperParam(true, takeAll())) ~~>
            = "super" KwEnd "." Id <~~ push({mname: up.in}) ~~> [ "=" AssignExpr ] ;
NamedTypedParam <~~ push(makeNamedParam(false, takeAll())) ~~>
            = Type Id <~~ push({mname: up.in}) ~~> [ "=" AssignExpr ] ;
NamedPlainParam <~~ push(makeNamedParam(false, takeAll())) ~~>
            = Id <~~ push({mname: up.in}) ~~> [ "=" AssignExpr ] ;

// Optional POSITIONAL parameters: foo(int a, [int b = 2, int? c]). Positional like the
// plain ones, but a missing argument falls back to the default (else null).
OptGroup    = "[" OptParam { "," OptParam } [ "," ] "]" ;
OptParam    = [ ParamMods ] OptParamCore ;
OptParamCore = OptThisParam | OptSuperParam | OptTypedParam | OptPlainParam ;
OptThisParam  <~~ push(makeOptParam(true, takeAll())) ~~>
            = "this" KwEnd "." Id <~~ push({mname: up.in}) ~~> [ "=" AssignExpr ] ;
OptSuperParam <~~ push(makeSuperParam(false, takeAll())) ~~>
            = "super" KwEnd "." Id <~~ push({mname: up.in}) ~~> [ "=" AssignExpr ] ;
OptTypedParam <~~ push(makeOptParam(false, takeAll())) ~~>
            = Type Id <~~ push({mname: up.in}) ~~> [ "=" AssignExpr ] ;
OptPlainParam <~~ push(makeOptParam(false, takeAll())) ~~>
            = Id <~~ push({mname: up.in}) ~~> [ "=" AssignExpr ] ;

// A type: name with optional generics <...> (skipped), dotted names and a nullable ? marker,
// all parsed and erased.
// A type: a name with optional generics <...> and dotted qualification, a record type
// ( (int, String) , ({int w, int h}) ) matched as a balanced paren run, and the
// Function(...) form that may follow either. Everything is parsed and erased.
Type        = TypePrim { TypeFn } ;
TypePrim    = TypeRecord | TypeFn | TypeNamed ;
TypeRecord  = SkipParen [ "?" ] ;
TypeNamed   = Id [ TypeArgs ] { "." Id [ TypeArgs ] } [ "?" ] ;
// A type-ARGUMENT list is parsed as real types, not as a balanced <...> run. The balanced
// run would happily span `i < 2; ... =>` to reach the ">" of a "=>" ten lines later and
// then find the "(" a generic call needs - which is exactly what it did.
TypeArgs    = "<" TypeArg { "," TypeArg } ">" ;
TypeArg     = Type ;
TypeFn      = KwFunction [ SkipAngle ] SkipParen [ "?" ] ;

// Local variable declarations. Separate complete alternatives avoid the optional-type trap.
// `late` only delays the initialisation check, which this front end does not make, so a
// late declaration is an ordinary one (uninitialised means null).
VarDecl     = VarLate | VarKwDecl | VarFinalTyped | VarFinal | VarConstTyped | VarConst | VarTyped ;
VarLate     = KwLate ( KwFinal Type | KwFinal | KwVar | Type ) DeclTail ;
VarKwDecl     = KwVar         DeclTail ;
VarFinalTyped = KwFinal Type  DeclTail ;
VarFinal      = KwFinal       DeclTail ;
VarConstTyped = KwConst Type  DeclTail ;
VarConst      = KwConst       DeclTail ;
VarTyped      = Type          DeclTail ;
DeclTail    <~~ push(makeSeq(takeAll())) ~~>
            = Declarator { "," Declarator } ";" ;
Declarator  <~~ push(makeDecl(takeAll())) ~~>
            = Id <~~ push(up.in) ~~> [ "=" AssignExpr ] ;

If          <~~ push(makeIf(takeAll())) ~~>
            = KwIf "(" Expression ")" Statement [ KwElse Statement ] ;

While       <~~ push(makeWhile(pop(), pop())) ~~>
            = KwWhile "(" Expression ")" Statement ;

// for (x in coll) is tried before the C-style for; both start with 'for ('.
For         = ForInTyped | ForInBare | ForCStyle ;
ForInTyped  <~~ push(makeForIn(takeAll())) ~~>
            = KwFor "(" ForInLead Id <~~ push(up.in) ~~> KwIn Expression ")" Statement ;
ForInBare   <~~ push(makeForIn(takeAll())) ~~>
            = KwFor "(" Id <~~ push(up.in) ~~> KwIn Expression ")" Statement ;
ForInLead   = KwVar | KwFinal | Type ;
ForCStyle   <~~ push(makeFor(takeAll())) ~~>
            = KwFor "(" [ ForInit ] ";" [ ForCond ] ";" [ ForPost ] ")" Statement ;
ForInit     <~~ push({k:"init", t:pop()}) ~~> = ForVar | ForExpr ;
ForVar      <~~ push(makeSeq(takeAll())) ~~> = ForVarHead Declarator { "," Declarator } ;
ForVarHead  = KwVar | KwFinal Type | KwFinal | Type ;
ForExpr     <~~ push(exprToStmt(pop())) ~~> = Expression ;
ForCond     <~~ push({k:"cond", t:pop()}) ~~> = Expression ;
ForPost     <~~ push({k:"post", t: makeSeq(takeAll())}) ~~> = ForPostOne { "," ForPostOne } ;
ForPostOne  <~~ push(exprToStmt(pop())) ~~> = Expression ;

Return      <~~ push(makeReturn(takeAll())) ~~>
            = KwReturn [ Expression ] ";" ;
// break / continue accept an optional target label: it names an enclosing labeled
// statement (see LabeledStmt), and the jump goes to that entry's exit / continue block.
Break       <~~ push(makeBreakL(takeAll(), up.pos)) ~~>    = KwBreak [ LoopLabel ] ";" ;
Continue    <~~ push(makeContinueL(takeAll(), up.pos)) ~~> = KwContinue [ LoopLabel ] ";" ;
LoopLabel   <~~ push({label: up.in}) ~~> = Id ;
Empty       <~~ push(function(b) { return b }) ~~>  = ";" ;

// switch: accepted, not implemented (its body is matched with the balanced SkipBlock so
// the whole construct parses).
Switch      <~~ push(notImplStmt("switch statement", up.pos)) ~~>
            = KwSwitch SkipParen SkipBlock ;
DoWhile     <~~ push(makeDoWhile(takeAll())) ~~>
            = KwDo Statement KwWhile "(" Expression ")" ";" ;

// try/catch/finally and throw are implemented: throw calls js_throw (a Go panic the
// runtime unwinds), each try/catch/finally body compiles to its own closure handed to
// js_try (see makeTry). The leftmost catch clause wins (exception types are parsed but
// not discriminated); a return/break/continue leaving a try or catch body becomes a
// control signal that excDispatch re-issues in the enclosing frame (compile-core). Each
// part is marked so makeTry can tell them apart.
TryStmt     <~~ push(makeTry(takeAll())) ~~>
            = KwTry TryBody { CatchClause } [ FinallyClause ] ;
TryBody     <~~ push({trybody: pop()}) ~~>
            = Block ;
FinallyClause <~~ push({finbody: pop()}) ~~>
            = KwFinally Block ;
// Dart catch forms: `on Type catch (e)`, `on Type catch (e, st)`, `on Type { }` (no
// binding), `catch (e)`, `catch (e, st)`. The `on Type` type is parsed and discarded; the
// first binder is the caught value's name (pushed), the optional second binder (the stack
// trace) is parsed and dropped. makeCatch reads [name?, blockThunk].
CatchClause <~~ push(makeCatchClause(takeAll())) ~~>
            = ( KwOn CatchType [ KwCatch "(" CatchName [ "," Id ] ")" ]
              | KwCatch "(" CatchName [ "," Id ] ")" ) Block ;
CatchType   <~~ push({catchtype: up.in}) ~~> = Type ;
CatchName   <~~ push({catchname: up.in}) ~~> = Id ;
// rethrow re-raises the value the enclosing catch clause bound.
Rethrow     <~~ push(makeRethrow()) ~~>
            = KwRethrow ";" ;
// assert(cond[, message]) : the condition is evaluated and, when false, the program
// aborts with the message (js_throw). Dart only runs asserts in debug mode; running them
// always is the stricter of the two readings and matches the interpreter.
Assert      <~~ push(makeAssert(takeAll())) ~~>
            = KwAssert "(" Expression [ "," Expression ] [ "," ] ")" ";" ;
// A labeled statement (label: stmt). The label names a loopStack entry, so a
// `break label` / `continue label` inside it reaches this statement (makeLabeled).
LabeledStmt <~~ push(makeLabeled(takeAll())) ~~>
            = StmtLabel ":" Statement ;
StmtLabel   <~~ push({slabel: up.in}) ~~> = Id ;

// Top-level getters and setters: int get x => e; set x(v) { ... }
TopGetter   <~~ push(makeTopAccessor(true, takeAll())) ~~>
            = KwGet FName FnBody | Type KwGet FName FnBody ;
TopSetter   <~~ push(makeTopAccessor(false, takeAll())) ~~>
            = KwSet FName ParamList FnBody | Type KwSet FName ParamList FnBody ;

// `throw e;` needs its own statement alternative BEFORE VarDecl: `throw t;` otherwise
// parses as a declaration of a variable t whose (identifier-shaped) type is `throw`.
ThrowStmt   <~~ push(exprToStmt(pop())) ~~>
            = ThrowExpr ";" ;

ExprStmt    <~~ push(exprToStmt(pop())) ~~>
            = Expression ";" ;

// Every expression production pushes exactly one thunk: function(block) -> {b, v}.
Expression  = AssignExpr ;
AssignExpr  = ThrowExpr | Assignment | Cascade ;
// throw is an expression in Dart (=> throw e, cond ? a : throw e). Accepted, not
// implemented; the operand is still evaluated so its calls stay visible.
ThrowExpr   <~~ push(makeThrow(pop(), up.pos)) ~~>
            = KwThrow AssignExpr ;
Assignment  <~~ push(makeAssign(takeAll(), up.pos)) ~~>
            = Target ( "+=" | "-=" | "*=" | "~/=" | "/=" | "%=" | "??=" | "&=" | "|=" | "^=" | "<<=" | ">>=" | "=" ) <~~ push(up.in) ~~> AssignExpr ;

// Cascade: target..m(args)..field = v . Every section acts on the one target and the
// whole expression evaluates to that target. With no sections it is just the CondExpr,
// so ordinary expressions stay unaffected.
Cascade     <~~ push(makeCascade(takeAll())) ~~>
            = CondExpr { CascadeSection } ;
CascadeSection = CascadeCall | CascadeSet ;
CascadeCall <~~ push({kind: "ccall", name: popName(), args: takeAll()}) ~~>
            = ".." Id <~~ push({mname: up.in}) ~~> "(" [ Arg { "," Arg } [ "," ] ] ")" ;
CascadeSet  <~~ var cv = pop(); var cn = pop(); push({kind: "cset", name: cn.mname, val: cv}) ~~>
            = ".." Id <~~ push({mname: up.in}) ~~> "=" CondExpr ;
Target      <~~ push(makeTargetRef(takeAll())) ~~>
            = Id <~~ push(up.in) ~~> { DotTarget | IndexTarget } ;
DotTarget   = "." Id <~~ push({key: up.in}) ~~> ;
IndexTarget <~~ push({idx: pop()}) ~~> = "[" Expression "]" ;

CondExpr    <~~ push(makeCond(takeAll())) ~~>
            = IfNullExpr [ "?" AssignExpr ":" AssignExpr ] ;
// a ?? b : if-null. Accepted, not implemented; both operands are evaluated (calls
// stay visible) and the first is returned. With no "??" it passes the operand through.
IfNullExpr  <~~ push(makeIfNull(takeAll())) ~~>
            = OrExpr { "??" <~~ push({ifnull: true, pos: up.pos}) ~~> OrExpr } ;
OrExpr      <~~ push(makeOrAnd(takeAll(), true)) ~~>
            = AndExpr { "||" AndExpr } ;
AndExpr     <~~ push(makeOrAnd(takeAll(), false)) ~~>
            = EqExpr { "&&" EqExpr } ;
EqExpr      <~~ push(foldBinary(takeAll())) ~~>
            = RelExpr { ( "==" | "!=" ) <~~ push(up.in) ~~> RelExpr } ;
RelExpr     <~~ push(foldBinary(takeAll())) ~~>
            = TypeTestExpr { ( "<=" | ">=" | "<" | ">" ) <~~ push(up.in) ~~> TypeTestExpr } ;
// is / is! / as type tests, at relational precedence. 'as' is compiled as an identity
// cast (operand evaluated, type erased); 'is' / 'is!' are accepted and not implemented.
TypeTestExpr <~~ push(makeTypeTest(takeAll())) ~~>
            = BitOrExpr [ TypeTestOp TestType ] ;
TestType    <~~ push({tname: up.in}) ~~> = Type ;
TypeTestOp  = IsOp | AsOp ;
IsOp        <~~ push({tt: up.in, pos: up.pos}) ~~> = KwIs [ "!" ] ;
AsOp        <~~ push({tt: "as", pos: up.pos}) ~~> = KwAs ;
// Bitwise and shift levels sit between the relational and additive levels, as in Dart.
// A lone "|" that begins "||" fails its right operand and the iteration rolls back
// (likewise "&" below "&&"), so the logical levels above keep working.
BitOrExpr   <~~ push(foldBinary(takeAll())) ~~>
            = BitXorExpr { "|" <~~ push("|") ~~> BitXorExpr } ;
BitXorExpr  <~~ push(foldBinary(takeAll())) ~~>
            = BitAndExpr { "^" <~~ push("^") ~~> BitAndExpr } ;
BitAndExpr  <~~ push(foldBinary(takeAll())) ~~>
            = ShiftExpr { "&" <~~ push("&") ~~> ShiftExpr } ;
ShiftExpr   <~~ push(foldBinary(takeAll())) ~~>
            = AddExpr { ( "<<" | ">>>" | ">>" ) <~~ push(up.in) ~~> AddExpr } ;
AddExpr     <~~ push(foldBinary(takeAll())) ~~>
            = MulExpr { ( "+" | "-" ) <~~ push(up.in) ~~> MulExpr } ;
MulExpr     <~~ push(foldBinary(takeAll())) ~~>
            = UnaryExpr { ( "*" | "~/" | "/" | "%" ) <~~ push(up.in) ~~> UnaryExpr } ;

UnaryExpr   = Await | Neg | Not | BitNot | PostfixExpr ;
Await       <~~ notImpl("await", up.pos) ~~> = "await" KwEnd UnaryExpr ;
Neg         <~~ push(makeNeg(pop())) ~~> = "-" UnaryExpr ;
Not         <~~ push(makeNot(pop())) ~~> = "!" UnaryExpr ;
BitNot      <~~ push(makeBitNot(pop())) ~~> = "~" UnaryExpr ;

PostfixExpr = IncDec | ConstMember | CallMember ;
// A const expression: `const Kn.fix(2, 3)`. Const instances are canonicalized, so two
// const creations with equal arguments are identical().
ConstMember <~~ push(constify(pop())) ~~> = KwConst CallMember ;
IncDec      <~~ push(makeIncDec(takeAll())) ~~>
            = Target ( "++" | "--" ) <~~ push(up.in) ~~> ;

// A primary followed by any mix of method calls, field reads, index reads and the (not
// implemented) postfix null-assertion ! . The !"=" lookahead keeps a != b intact.
CallMember  <~~ push(foldCallMember(takeAll())) ~~>
            = Primary { MethodSfx | FieldSfx | IndexSfx | NullMethodSfx | NullFieldSfx | NullIndexSfx | BangSfx } ;
BangSfx     <~~ push({kind:"bang"}) ~~> = "!" !"=" ;
// Null-aware access (?., ?.(), ?[]): a null receiver short-circuits the whole remaining
// suffix chain to null, exactly like Dart.
NullMethodSfx <~~ push({kind:"nmcall", name: popName(), args: takeAll()}) ~~>
            = "?." Id <~~ push({mname: up.in}) ~~> "(" [ Arg { "," Arg } [ "," ] ] ")" ;
NullFieldSfx = "?." Id <~~ push({kind:"nfield", name: up.in}) ~~> ;
// "?[" is one fused token on purpose: with a space allowed between the two characters
// the ternary `b ? [9] : null` would parse as a null-aware index and then die on the ":".
NullIndexSfx <~~ push({kind:"nindex", idx: pop()}) ~~>
            = "?[" Expression "]" ;
MethodSfx   <~~ push({kind:"mcall", name: popName(), args: takeAll()}) ~~>
            = "." Id <~~ push({mname: up.in}) ~~> [ TypeArgs ] "(" [ Arg { "," Arg } [ "," ] ] ")" ;
FieldSfx    = "." FieldName ;
// A field name is an identifier or a record's positional field ($1, $2, ...).
FieldName   <~~ push({kind:"field", name: up.in}) ~~> = RecPosName | Id ;
RecPosName  = "$" :whitespace() "0"..."9" { "0"..."9" } :whitespace(Whitespace) ;
IndexSfx    <~~ push({kind:"index", idx: pop()}) ~~>
            = "[" Expression "]" ;

Primary     = ArrowFn | SuperExpr | "(" Expression ")" | TypedColl | ListLit | MapLit | SetLit | StrLit | NumLit
            | True | False | Null | NewExpr | QualCall | QualRef | Call | VarRef ;

// A generic type used as a receiver: List<int>.filled(10, null), Future<Object?>.value().
// Without these two the type arguments are read as a comparison and the parse dies on the
// following ".", which is the single biggest failure cluster of the Dart corpus.
QualCall    <~~ push(makeQualCall(takeAll())) ~~>
            = Id <~~ push({qbase: up.in}) ~~> TypeArgs "." QRName "(" [ Arg { "," Arg } [ "," ] ] ")" ;
QualRef     <~~ push(makeQualRef(takeAll())) ~~>
            = Id <~~ push({qbase: up.in}) ~~> TypeArgs "." QRName ;
QRName      <~~ push({qname: up.in}) ~~> = Id ;

// super.m(args) / super.field: the lookup starts at the superclass descriptor of the
// class whose body the call stands in.
SuperExpr   = SuperMcall | SuperFieldExpr ;
SuperMcall  <~~ push(makeSuperMcall(takeAll())) ~~>
            = KwSuper "." SMName "(" [ Arg { "," Arg } [ "," ] ] ")" ;
SuperFieldExpr <~~ push(makeSuperFieldExpr(takeAll())) ~~> = KwSuper "." SMName ;
SMName      <~~ push({smname: up.in}) ~~> = Id ;

// Dart number literals: hex (0x..), then the fractional/exponent form, then the plain
// integer. All three accept '_' digit separators (Dart 3.6). The longest/prefixed forms
// come first because this is a PEG.
NumLit      = NumHex | NumDec | NumInt ;

// A collection literal with an explicit type argument: <int>[...], <K,V>{...}. The type
// argument is erased and the list/map/set is built as usual.
TypedColl   = SkipAngle ( ListLit | MapLit | SetLit ) ;

// A set literal { e, e, ... }: a brace literal whose elements are not key:value pairs.
// MapLit is tried first, so a bare {} and every {k: v, ...} is a map and only the rest
// reaches here.
SetLit      <~~ push(makeSet(takeAll())) ~~>
            = "{" CollElem { "," CollElem } [ "," ] "}" ;

// A closure: (params) => expr or (params) { statements }.
ArrowFn     <~~ push(makeArrow(takeAll())) ~~>
            = ParamList [ AsyncMod ] ArrowTail ;
ArrowTail   = ArrowExpr | ArrowBlock ;
ArrowExpr   <~~ push({ebody: pop()}) ~~> = "=>" AssignExpr ;
ArrowBlock  <~~ push({body: pop()}) ~~>  = Block ;

// new Type(args) - equivalent to Type(args); both construct. The operand is a whole
// member chain, so `new C.foo()` reaches the named constructor foo through the ordinary
// method-call suffix (which is exactly how an unprefixed C.foo() resolves too).
NewExpr     = KwNew CallMember ;

// f(args): a top level function, a builtin, or (when the name is a class) a constructor.
Call        <~~ push(makeCall(takeAll())) ~~>
            = Id <~~ push(up.in) ~~> [ TypeArgs ] "(" [ Arg { "," Arg } [ "," ] ] ")" ;

// A call argument is positional (a bare expression, pushed as a thunk) or named
// (name: expr, pushed as a {named, val} marker collected into a trailing options dict).
Arg         = NamedArg | AssignExpr ;
NamedArg    <~~ var av = pop(); var an = pop(); push({named: an.aname, val: av}) ~~>
            = Id <~~ push({aname: up.in}) ~~> ":" AssignExpr ;

ListLit     <~~ push(makeList(takeAll())) ~~>
            = "[" [ CollElem { "," CollElem } [ "," ] ] "]" ;
// A collection element is a plain expression, a spread (...e splicing e's elements, ...?e
// contributing nothing when e is null), a collection-if or a collection-for. The same
// three control forms exist for map entries, one level down (MapElem).
CollElem    = SpreadElem | IfElem | ForElem | ExprElem ;
SpreadElem  <~~ push(makeSpread(takeAll())) ~~> = "..." [ "?" <~~ push({nullaware: true}) ~~> ] AssignExpr ;
IfElem      <~~ push(makeIfElem(takeAll())) ~~>
            = KwIf "(" Expression ")" CollElem [ KwElse CollElem ] ;
ForElem     <~~ push(makeForElem(takeAll())) ~~>
            = KwFor "(" ForElemHead ")" CollElem ;
ExprElem    <~~ push({ekind: "val", t: pop()}) ~~> = AssignExpr ;
// The head of a collection-for is either `x in e` or the C-style triple; both reuse the
// statement-level pieces, so the markers arrive in the same shape.
ForElemHead = ForElemIn | ForElemC ;
ForElemIn   = [ ForInLead ] Id <~~ push({feName: up.in}) ~~> KwIn ForElemIter ;
ForElemIter <~~ push({feIter: pop()}) ~~> = Expression ;
ForElemC    = [ ForInit ] ";" [ ForCond ] ";" [ ForPost ] ;

MapLit      <~~ push(makeMap(takeAll())) ~~>
            = "{" [ MapElem { "," MapElem } [ "," ] ] "}" ;
MapElem     = SpreadElem | IfMapElem | ForMapElem | MapEntry ;
IfMapElem   <~~ push(makeIfElem(takeAll())) ~~>
            = KwIf "(" Expression ")" MapElem [ KwElse MapElem ] ;
ForMapElem  <~~ push(makeForElem(takeAll())) ~~>
            = KwFor "(" ForElemHead ")" MapElem ;
MapEntry    <~~ var v = pop(); push({ekind: "entry", mk: pop(), mv: v}) ~~>
            = AssignExpr ":" AssignExpr ;

VarRef      <~~ push(makeVarRef(up.in)) ~~> = Id ;
Null        <~~ push(makeConst(null)) ~~>   = "null" KwEnd ;

// Dart string literals. Adjacent literals concatenate ('a' 'b' == "ab"), so a StrLit is
// one or more pieces. A piece is raw (r'...', no escapes and no interpolation), triple
// quoted (''' / """, spanning lines) or plain; all non-raw forms interpolate $name and
// ${expr}. The prefixed and longer forms come first (PEG ordered choice).
StrLit      <~~ push(makeStrCat(takeAll())) ~~>
            = StrPiece { StrPiece } ;
StrPiece    = RawTqSq | RawTqDq | RawSq | RawDq | TqSqTpl | TqDqTpl | SqTpl | DqTpl ;
SqTpl       <~~ push(makeTemplate(takeAll())) ~~>
            = "'" :whitespace() { TplExpr | TplVar | TplDollar | SqChunk } "'" :whitespace(Whitespace) ;
DqTpl       <~~ push(makeTemplate(takeAll())) ~~>
            = '"' :whitespace() { TplExpr | TplVar | TplDollar | DqChunk } '"' :whitespace(Whitespace) ;
// Triple-quoted: the closing delimiter is three quotes, so a single quote inside the body
// is ordinary text. The !"''" / !'""' lookaheads (literal lookahead is the only kind this
// dialect has) keep a lone quote in the chunk and stop at the real terminator.
TqSqTpl     <~~ push(makeTemplate(takeAll())) ~~>
            = "'''" :whitespace() { TplExpr | TplVar | TplDollar | TqSqChunk } "'''" :whitespace(Whitespace) ;
TqDqTpl     <~~ push(makeTemplate(takeAll())) ~~>
            = '"""' :whitespace() { TplExpr | TplVar | TplDollar | TqDqChunk } '"""' :whitespace(Whitespace) ;
TqSqChunk   <~~ push({s: unescapeDart(up.in)}) ~~> = TqSqCh { TqSqCh } ;
TqDqChunk   <~~ push({s: unescapeDart(up.in)}) ~~> = TqDqCh { TqDqCh } ;
TqSqCh      = TplEsc | TqSqQuote | SqPlain ;
TqDqCh      = TplEsc | TqDqQuote | DqPlain ;
TqSqQuote   = "'" !"''" ;
TqDqQuote   = '"' !'""' ;
// Raw strings: every character is literal, including backslashes and $.
RawTqSq     = "r" :whitespace() "'''" RawTqSqBody "'''" :whitespace(Whitespace) ;
RawTqDq     = "r" :whitespace() '"""' RawTqDqBody '"""' :whitespace(Whitespace) ;
RawSq       = "r" :whitespace() "'" RawSqBody "'" :whitespace(Whitespace) ;
RawDq       = "r" :whitespace() '"' RawDqBody '"' :whitespace(Whitespace) ;
RawTqSqBody <~~ push(makeConst(up.in)) ~~> = { TqSqQuote | RawSqPlain } ;
RawTqDqBody <~~ push(makeConst(up.in)) ~~> = { TqDqQuote | RawDqPlain } ;
RawSqBody   <~~ push(makeConst(up.in)) ~~> = { RawSqPlain } ;
RawDqBody   <~~ push(makeConst(up.in)) ~~> = { RawDqPlain } ;
RawSqPlain  = "\x00"..."\x26" | "\x28"..."\U0010ffff" ;
RawDqPlain  = "\x00"..."\x21" | "\x23"..."\U0010ffff" ;
TplExpr     <~~ push({e: pop()}) ~~>
            = "${" :whitespace(Whitespace) Expression "}" ;
TplVar      = "$" TplName <~~ push({e: makeVarRef(up.in)}) ~~> ;
TplName     = ( "a"..."z" | "A"..."Z" | "_" ) { "a"..."z" | "A"..."Z" | "0"..."9" | "_" } ;
TplDollar   <~~ push({s: "$"}) ~~> = "$" ;
SqChunk     <~~ push({s: unescapeDart(up.in)}) ~~> = SqTChar { SqTChar } ;
DqChunk     <~~ push({s: unescapeDart(up.in)}) ~~> = DqTChar { DqTChar } ;
SqTChar     = TplEsc | SqPlain ;
DqTChar     = TplEsc | DqPlain ;
TplEsc      = "\\" "\x00"..."\U0010ffff" ;
SqPlain     = "\x00"..."\x23" | "\x25"..."\x26" | "\x28"..."\x5b" | "\x5d"..."\U0010ffff" ;
DqPlain     = "\x00"..."\x21" | "\x23" | "\x25"..."\x5b" | "\x5d"..."\U0010ffff" ;

// A balanced < ... > run (generic parameters / arguments), parsed and ignored.
SkipAngle   = "<" { SkipAngle | SkipAngleItem } ">" ;
SkipAngleItem = "\x00"..."\x3b" | "\x3d" | "\x3f"..."\U0010ffff" ;

// A balanced { ... } run (switch / try / enum / member bodies) accepted without being
// understood. Dart string literals (single and double quoted, with $name / ${expr}
// interpolation) are matched first so braces inside them are never miscounted.
SkipBlock   = "{" { SkipItem } "}" ;
SkipItem    = SkipSqStr | SkipDqStr | SkipBlock | SkipBOther ;
SkipSqStr   = "'" :whitespace() { SkipTpl | SkipSqCh } "'" :whitespace(Whitespace) ;
SkipDqStr   = '"' :whitespace() { SkipTpl | SkipDqCh } '"' :whitespace(Whitespace) ;
SkipTpl     = "${" :whitespace(Whitespace) { SkipItem } "}" ;
SkipSqCh    = TplEsc | "$" | SqPlain ;
SkipDqCh    = TplEsc | "$" | DqPlain ;
SkipBOther  = "\x00"..."\x21" | "\x23"..."\x26" | "\x28"..."\x7a" | "\x7c" | "\x7e"..."\U0010ffff" ;

// A balanced ( ... ) run (switch / annotation / try headers), parsed and ignored.
SkipParen   = "(" { SkipSqStr | SkipDqStr | SkipParen | SkipPOther } ")" ;
SkipPOther  = "\x00"..."\x21" | "\x23"..."\x26" | "\x2a"..."\U0010ffff" ;

// Keywords end with a negative lookahead so 'ify' or 'classy' stay identifiers.
KwClass     = "class" KwEnd ;
KwNew       = "new" KwEnd ;
KwVar       = "var" KwEnd ;
KwFinal     = "final" KwEnd ;
KwConst     = "const" KwEnd ;
KwIf        = "if" KwEnd ;
KwElse      = "else" KwEnd ;
KwWhile     = "while" KwEnd ;
KwFor       = "for" KwEnd ;
KwIn        = "in" KwEnd ;
KwReturn    = "return" KwEnd ;
KwBreak     = "break" KwEnd ;
KwContinue  = "continue" KwEnd ;
KwExtends   = "extends" KwEnd ;
KwWith      = "with" KwEnd ;
KwImplements = "implements" KwEnd ;
KwLate      = "late" KwEnd ;
KwIs        = "is" KwEnd ;
KwAs        = "as" KwEnd ;
KwThrow     = "throw" KwEnd ;
KwSwitch    = "switch" KwEnd ;
KwDo        = "do" KwEnd ;
KwTry       = "try" KwEnd ;
KwCatch     = "catch" KwEnd ;
KwFinally   = "finally" KwEnd ;
KwOn        = "on" KwEnd ;
KwRethrow   = "rethrow" KwEnd ;
KwAssert    = "assert" KwEnd ;
KwImport    = "import" KwEnd ;
KwExport    = "export" KwEnd ;
KwPart      = "part" KwEnd ;
KwLibrary   = "library" KwEnd ;
KwOf        = "of" KwEnd ;
KwShow      = "show" KwEnd ;
KwHide      = "hide" KwEnd ;
KwEnum      = "enum" KwEnd ;
KwMixin     = "mixin" KwEnd ;
KwExtension = "extension" KwEnd ;
KwType      = "type" KwEnd ;
KwTypedef   = "typedef" KwEnd ;
KwFunction  = "Function" KwEnd ;
KwGet       = "get" KwEnd ;
KwSet       = "set" KwEnd ;
KwOperator  = "operator" KwEnd ;
KwFactory   = "factory" KwEnd ;
KwSuper     = "super" KwEnd ;

// ---


:startScript(~~

    // Shared emitter machinery (module, handle constants, externs, loopStack protocol,
    // expression/statement builders); Dart-specific behaviour is configured on `core` and
    // defined below.
    include("lib/compile-core.js")

    // takeAll empties the local stack and returns the items in push order.
    // unescapeJs resolves the JS/Dart string escapes.

    // A clean compile-time abort (used by the shared notImpl helper in compile-core.js).
    function fail(msg) { println("dart compiler error: " + msg); exit(1) }

    // ----- Project-file imports (import 'lib.dart';) -----
    // dart: libraries are builtins the runtime already provides, so importing one is a
    // no-op (resolveImport short-circuits on these prefixes, whole path or prefix).
    core.stdlibImports = ["dart:core", "dart:math", "dart:async", "dart:collection", "dart:convert"]

    // The URI text of an import directive, with any whitespace and the surrounding quotes
    // stripped: 'geomlib.dart' -> geomlib.dart (39 = ', 34 = ").
    function uriPath(raw) {
        var s = stripWs(raw)
        if (s.length >= 2) {
            var q = s.charCodeAt(0)
            if (q == 39 || q == 34) { s = s.substring(1, s.length - 1) }
        }
        return s
    }

    // A non-dart: import names a project file: strip a leading './', ensure the .dart
    // extension, then search the program's directory and the -i roots (c.findImport). The
    // file is parsed with this grammar; its top-level declaration thunks are stashed by
    // buildMain (importDepth > 0) and prepended to dartmain, so its classes and functions
    // register before the main file's own top level. A file is imported once; repeats and
    // cycles are no-ops.
    var importedFiles = {}
    var importDepth = 0
    // imported files top-level items: stashImported / emitImported (compile-core)
    core.importFile = function(path, pos) {
        var p = path
        if (p.length >= 2 && p.substring(0, 2) == "./") { p = p.substring(2) }
        if (!(p.length >= 5 && p.substring(p.length - 5) == ".dart")) { p = p + ".dart" }
        var file = c.findImport(p)
        if (file == "") { return false }
        if (importedFiles["$" + file] == true) { return true }
        importedFiles["$" + file] = true
        var text = c.readFile(file)
        var asg = c.parse(c.agrammar, text, null, file)
        c.pushSource(file, text)
        importDepth = importDepth + 1
        c.compile(asg)
        importDepth = importDepth - 1
        c.popSource()
        return true
    }

    var curClassName = ""
    var classNames = {}      // Known class names (bare-name construction).
    var factoryClasses = {}  // Classes whose UNNAMED constructor is a factory.

    // ----- Dart escapes -----
    // Dart's escape set is JS's plus \u{...} (a variable-length code point, surrogate
    // encoded so '\u{1F600}'.length is 2 like a real Dart string).
    function unescapeDart(s) {
        if (s.indexOf("\\u{") < 0) { return unescapeJs(s) }
        var out = ""
        var i = 0
        while (i < s.length) {
            var c0 = s.charCodeAt(i)
            if (c0 != 92) { out = out + s.charAt(i); i = i + 1; continue }
            if (s.charCodeAt(i + 1) == 117 && s.charCodeAt(i + 2) == 123) {
                var j = i + 3
                var cp = 0
                while (j < s.length && s.charCodeAt(j) != 125) { cp = cp * 16 + hexAt(s, j, 1); j = j + 1 }
                if (cp > 0xFFFF) {
                    var u = cp - 0x10000
                    out = out + String.fromCharCode(0xD800 + ((u / 1024) | 0)) + String.fromCharCode(0xDC00 + (u % 1024))
                } else { out = out + String.fromCharCode(cp) }
                i = j + 1
                continue
            }
            out = out + unescapeJs(s.substring(i, i + 2))
            // \x.. and \u.... are longer than two characters; re-measure.
            var e = s.charCodeAt(i + 1)
            if (e == 120) { out = out.substring(0, out.length - 1) + String.fromCharCode(hexAt(s, i + 2, 2)); i = i + 4 }
            else if (e == 117) { out = out.substring(0, out.length - 1) + String.fromCharCode(hexAt(s, i + 2, 4)); i = i + 6 }
            else { i = i + 2 }
        }
        return out
    }

    // Adjacent string literals concatenate: 'a' 'b' is one string. Every piece is already
    // a string-valued thunk, so js_jadd chains them.
    function makeStrCat(items) {
        if (items.length == 1) { return items[0] }
        return function(b) {
            var r = items[0](b)
            b = r.b
            var v = r.v
            for (var i = 1; i < items.length; i++) {
                var rr = items[i](b)
                b = rr.b
                v = callExt(b, "js_jadd", [v, rr.v])
            }
            return {b: b, v: v}
        }
    }

    // Dart has ONE numeric tower with real doubles, and only ~/ (and the bitwise
    // operators) truncate:
    //   ~/  integer division: js_div wrapped to 32 bits (also the ~/= form).
    //   /   ALWAYS a double result (7 / 2 == 3.5), so it must NOT be wrapped - the
    //       shared compile-core defaults wrap it, which is the JS-like behaviour.
    //   %   euclidean: the result lies in [0, r.abs()), so -7 % 3 == 2 (js_mod, like
    //       JS %, gives -1, which is what (-7).remainder(3) returns in Dart).
    binExt["~/"] = "js_div"
    wraps["~/"] = 1
    binExt["~/="] = "js_div"
    wraps["~/="] = 1
    wraps["/"] = 0
    wraps["/="] = 0
    wraps["%"] = 0
    wraps["%="] = 0

    // % : m = l % r ; if (m < 0) m += r.abs(). Emitted branch free with two selects, so
    // emitBin keeps its (b, op, l, r) -> value shape and every caller (foldBinary,
    // makeAssign's compound forms) picks the Dart semantics up for free.
    var baseEmitBin = emitBin
    emitBin = function(b, op, l, r) {
        if (op == "%" || op == "%=") {
            var zero = emitNum(b, 0)
            var m = callExt(b, "js_mod", [l, r])
            var absr = b.NewSelect(truthy(b, callExt(b, "js_lt", [r, zero])),
                                   callExt(b, "js_neg", [r]), r)
            return b.NewSelect(truthy(b, callExt(b, "js_lt", [m, zero])),
                               callExt(b, "js_jadd", [m, absr]), m)
        }
        return baseEmitBin(b, op, l, r)
    }

    // Bitwise and shift operators reuse the ToInt32/ToUint32 externals (js.go); the
    // results are already 32-bit, so no extra wrap is needed.
    binExt["|"] = "js_bor"
    binExt["^"] = "js_bxor"
    binExt["&"] = "js_band"
    binExt["<<"] = "js_shl"
    binExt[">>"] = "js_shr"
    binExt[">>>"] = "js_ushr"

    // ~v is v ^ -1 on the ToInt32 value (reuses the xor external), like MetaJS.
    function makeBitNot(t) {
        return function(b) {
            var r = t(b)
            b = r.b
            return {b: b, v: callExt(b, "js_bxor", [r.v, callExt(b, "js_num_i", [handle(-1)])])}
        }
    }

    // A type test: items = [operand] or [operand, {tt, pos}, {tname}]. 'as' erases to an
    // identity cast; 'is' / 'is!' become a js_is_type probe (which answers false for every
    // value it does not recognize, so it is safe on any operand). The type ARGUMENTS are
    // erased, so `<Object>[1] is List<int>` answers on the outer type only.
    function makeTypeTest(items) {
        if (items.length == 1) { return items[0] }
        var operand = items[0]
        var mk = items[1]
        if (mk.tt == "as") { return operand }
        var tn = baseName(items[2].tname)
        var neg = stripWs(mk.tt) != "is"
        return function(b) {
            var r = operand(b)
            b = r.b
            var v = callExt(b, "js_is_type", [r.v, emitStr(b, tn)])
            if (neg) { v = callExt(b, "js_not", [v]) }
            return {b: b, v: v}
        }
    }

    // throw e : evaluate e and raise it with js_throw (a Go panic the runtime unwinds).
    // throw is an expression in Dart, so the thunk returns {b, v}; js_throw never returns,
    // so the placeholder value (hUndef) and the still-open block are dead at runtime.
    function makeThrow(t, pos) {
        return function(b) {
            var r = t(b)
            callExt(r.b, "js_throw", [r.v])
            return {b: r.b, v: hUndef}
        }
    }
    // rethrow: re-raise the value the enclosing catch clause bound. The catch bodies are
    // emitted inside makeTry, which pushes the binder name here, so a rethrow reads that
    // variable back out of the scope chain and throws it again.
    var rethrowNames = []
    function makeRethrow() {
        return function(b) {
            var v = hUndef
            if (rethrowNames.length > 0) {
                v = callExt(b, "js_kget", [curScopeV, emitStr(b, rethrowNames[rethrowNames.length - 1])])
            }
            callExt(b, "js_throw", [v])
            return b
        }
    }
    // One catch clause: {catchtype?, catchname?, catchbody}. `on T catch (e)` carries
    // both, `on T { }` only the type, `catch (e)` only the name.
    function makeCatchClause(items) {
        var d = {catchtype: null, catchname: undefined, catchbody: null}
        for (var i = 0; i < items.length; i++) {
            var it = items[i]
            if (typeof it == "function") { d.catchbody = it }
            else if (it.catchtype != undefined) { d.catchtype = it.catchtype }
            else if (it.catchname != undefined) { d.catchname = it.catchname }
        }
        return d
    }
    // makeCatch is shared - see lib/compile-core.js.
    // try/catch/finally: each body becomes its own IR closure over the current scope; js_try
    // (jsrt.go) runs the try under a Go recover, routes a thrown value to the catch closure
    // (a one-parameter function bound to the catch name) and always runs finally. The
    // leftmost catch clause wins. The try and catch bodies are ctl closures (isCtl), so a
    // return/break/continue leaving them becomes a control signal that excDispatch re-issues.
    function makeTry(items) {
        var tryT = anytype, finallyT = anytype
        var clauses = []
        for (var i = 0; i < items.length; i++) {
            if (items[i].trybody != undefined) { tryT = items[i].trybody }
            else if (items[i].catchbody != undefined) { clauses.push(items[i]) }
            else if (items[i].finbody != undefined) { finallyT = items[i].finbody }
        }
        // The single catch closure js_try calls dispatches over the clauses in source
        // order: `on T catch (e)` runs only when js_is_type(e, "T") holds, an untyped
        // `catch (e)` matches everything, and a value no clause claims is re-thrown so
        // it keeps unwinding to the enclosing try. The whole dispatch body is one thunk
        // so it can be handed to the ordinary emitFunc (as a ctl body).
        function catchDispatchStmt(bindName) {
            return function(b) {
                // Every clause body leaves through doneB; the CondBr chain (b) carries the
                // still-unmatched value on to the next test and, past the last one, to the
                // re-throw. A matched body must never fall into the following test.
                var doneB = curF.NewBlock("")
                var open = true
                for (var k = 0; k < clauses.length; k++) {
                    var cl = clauses[k]
                    var bodyB = curF.NewBlock("")
                    var nextB = null
                    if (cl.catchtype != null) {
                        nextB = curF.NewBlock("")
                        var ev = callExt(b, "js_kget", [curScopeV, emitStr(b, bindName)])
                        b.NewCondBr(truthy(b, callExt(b, "js_is_type", [ev, emitStr(b, cl.catchtype)])), bodyB, nextB)
                    } else { b.NewBr(bodyB) }
                    // A clause with its own binder name aliases it to the closure's
                    // parameter, so `on T catch (e)` sees the caught value as `e`.
                    var bb = bodyB
                    var localName = (cl.catchname != undefined) ? cl.catchname : bindName
                    if (localName != bindName) {
                        callExt(bb, "js_scope_decl", [curScopeV, emitStr(bb, localName),
                                                     callExt(bb, "js_kget", [curScopeV, emitStr(bb, bindName)])])
                    }
                    rethrowNames.push(localName)
                    bb = cl.catchbody(bb)
                    rethrowNames.pop()
                    bb.NewBr(doneB)
                    if (nextB == null) { open = false; break } // catch-all: nothing below it runs
                    b = nextB
                }
                // No clause matched: keep unwinding with the original value.
                if (open) {
                    callExt(b, "js_throw", [callExt(b, "js_kget", [curScopeV, emitStr(b, bindName)])])
                    b.NewBr(doneB)
                }
                return doneB
            }
        }
        return function(b) {
            var tryClo = callExt(b, "js_closure", [handle(emitFunc([], tryT, false, true)), curScopeV])
            var catchClo = hUndef
            if (clauses.length > 0) {
                var cn = "0caught"
                // emitFunc binds param DESCRIPTORS (Dart params carry .pname), so wrap the
                // catch-var name; js_try calls this closure with the thrown value.
                catchClo = callExt(b, "js_closure",
                                   [handle(emitFunc([{pname: cn}], catchDispatchStmt(cn), false, true)), curScopeV])
            }
            var finClo = hUndef
            if (finallyT != undefined) {
                finClo = callExt(b, "js_closure", [handle(emitFunc([], finallyT, false, true)), curScopeV])
            }
            var ctl = callExt(b, "js_try", [tryClo, catchClo, finClo])
            return excDispatch(b, ctl)
        }
    }
    // isNullish: true for Dart's null. An uninitialised slot reads back as undefined in
    // this runtime, so both are tested - Dart has only the one absent value.
    function emitIsNull(b, v) {
        return callExt(b, "js_bor", [callExt(b, "js_seq", [v, hNull]),
                                     callExt(b, "js_seq", [v, hUndef])])
    }
    // a ?? b ?? c : the first non-null operand, and the later ones are NOT evaluated.
    function makeIfNull(items) {
        if (items.length == 1) { return items[0] }
        var ops = []
        for (var i = 0; i < items.length; i += 2) { ops.push(items[i]) }
        return function(b) {
            var r = ops[0](b)
            b = r.b
            var v = r.v
            for (var j = 1; j < ops.length; j++) {
                var rightB = curF.NewBlock("")
                var mergeB = curF.NewBlock("")
                b.NewCondBr(truthy(b, emitIsNull(b, v)), rightB, mergeB)
                var r2 = ops[j](rightB)
                r2.b.NewBr(mergeB)
                var phi = mergeB.NewPhi([llvm.ir.NewIncoming(v, b), llvm.ir.NewIncoming(r2.v, r2.b)])
                b = mergeB
                v = phi
            }
            return {b: b, v: v}
        }
    }
    function pnames(params) {
        var out = []
        for (var i = 0; i < params.length; i++) { out.push(params[i].pname) }
        return out
    }

    // ----- parameters (positional + named-with-defaults) and argument bundling -----
    // A named-param descriptor from a curly group is {pname|thisf, named:true, def:thunk|null}.
    function makeNamedParam(isThis, items) {
        var nm = ""
        var def = null
        for (var i = 0; i < items.length; i++) {
            if (items[i] != undefined && items[i].mname != undefined) { nm = items[i].mname }
            else { def = items[i] }
        }
        if (isThis) { return {thisf: nm, named: true, def: def} }
        return {pname: nm, named: true, def: def}
    }
    function namedKey(np) { return (np.thisf != undefined) ? np.thisf : np.pname }
    // Copy every property of a class descriptor onto another one (the flattening step of
    // the class linearisation). js_keys skips the __-prefixed slots, so __ctor / __super /
    // __name stay the target's own. A descriptor is an OBJECT, not a dict, so this walks
    // it with js_get / js_set - js_pyset aborts with "item assignment on a object".
    function emitCopyProps(b, dstObj, srcObj) {
        var saved = curScopeV
        curScopeV = callExt(b, "js_scope_new", [curScopeV])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "0pks"), callExt(b, "js_keys", [srcObj])])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "0psrc"), srcObj])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "0pdst"), dstObj])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "0pi"), callExt(b, "js_num_i", [handle(0)])])
        var headB = curF.NewBlock("")
        var bodyB = curF.NewBlock("")
        var exitB = curF.NewBlock("")
        b.NewBr(headB)
        var iC = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, "0pi")])
        var ksC = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, "0pks")])
        headB.NewCondBr(truthy(headB, callExt(headB, "js_lt", [iC, callExt(headB, "js_pylen", [ksC])])), bodyB, exitB)
        var iB = callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, "0pi")])
        var ksB = callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, "0pks")])
        var srcB = callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, "0psrc")])
        var dstB = callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, "0pdst")])
        var kB = callExt(bodyB, "js_pyget", [ksB, iB])
        callExt(bodyB, "js_set", [dstB, kB, callExt(bodyB, "js_get", [srcB, kB])])
        callExt(bodyB, "js_scope_set", [curScopeV, emitStr(bodyB, "0pi"),
                                        callExt(bodyB, "js_add", [iB, callExt(bodyB, "js_num_i", [handle(1)])])])
        bodyB.NewBr(headB)
        curScopeV = saved
        return exitB
    }
    // Copy every key of srcDict into dstDict with a runtime counter loop.
    function emitCopyKeys(b, dstDict, srcDict) {
        var saved = curScopeV
        curScopeV = callExt(b, "js_scope_new", [curScopeV])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "0ks"), callExt(b, "js_keys", [srcDict])])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "0src"), srcDict])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "0dst"), dstDict])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "0ki"), callExt(b, "js_num_i", [handle(0)])])
        var headB = curF.NewBlock("")
        var bodyB = curF.NewBlock("")
        var exitB = curF.NewBlock("")
        b.NewBr(headB)
        var iC = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, "0ki")])
        var ksC = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, "0ks")])
        headB.NewCondBr(truthy(headB, callExt(headB, "js_lt", [iC, callExt(headB, "js_pylen", [ksC])])), bodyB, exitB)
        var iB = callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, "0ki")])
        var ksB = callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, "0ks")])
        var srcB = callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, "0src")])
        var dstB = callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, "0dst")])
        var kB = callExt(bodyB, "js_pyget", [ksB, iB])
        callExt(bodyB, "js_pyset", [dstB, kB, callExt(bodyB, "js_pyget", [srcB, kB])])
        callExt(bodyB, "js_scope_set", [curScopeV, emitStr(bodyB, "0ki"),
                                        callExt(bodyB, "js_add", [iB, callExt(bodyB, "js_num_i", [handle(1)])])])
        bodyB.NewBr(headB)
        curScopeV = saved
        return exitB
    }
    // Bind named params: build a dict seeded with the defaults, override it with whatever
    // the caller passed in its trailing options dict (if any), then declare each param.
    function emitNamedBind(b, named, optsIdx, thisV) {
        var r = callExt(b, "js_dict_new", [])
        var i
        for (i = 0; i < named.length; i++) {
            var dv = hNull
            if (named[i].def != null) { var dr = named[i].def(b); b = dr.b; dv = dr.v }
            callExt(b, "js_pyset", [r, emitStr(b, namedKey(named[i])), dv])
        }
        var rawOpts = callExt(b, "js_arg", [curF.Params[1], handle(optsIdx)])
        var haveB = curF.NewBlock("")
        var afterB = curF.NewBlock("")
        b.NewCondBr(b.NewICmp(llvm.enum.IPredNE, rawOpts, handle(0)), haveB, afterB)
        emitCopyKeys(haveB, r, rawOpts).NewBr(afterB)
        b = afterB
        for (i = 0; i < named.length; i++) {
            var val = callExt(b, "js_pyget", [r, emitStr(b, namedKey(named[i]))])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, namedKey(named[i])), val])
            if (named[i].thisf != undefined && thisV != null) { callExt(b, "js_set", [thisV, emitStr(b, named[i].thisf), val]) }
        }
        return b
    }
    // Push a call's positional args, then (if any) one trailing options dict for the named
    // args, into argsV. Positional args are thunks; named args are {named, val} markers.
    function emitCallArgsInto(b, argsV, args) {
        var named = []
        for (var i = 0; i < args.length; i++) {
            var a = anytype
            a = args[i]
            if (typeof a == "function") {
                var r = a(b)
                b = r.b
                callExt(b, "js_arr_push", [argsV, r.v])
            } else { named.push(a) }
        }
        if (named.length > 0) {
            var d = callExt(b, "js_dict_new", [])
            for (var j = 0; j < named.length; j++) {
                var rv = named[j].val(b)
                b = rv.b
                callExt(b, "js_pyset", [d, emitStr(b, named[j].named), rv.v])
            }
            callExt(b, "js_arr_push", [argsV, d])
        }
        return b
    }

    // ----- functions, closures, methods -----
    function bodyToStmt(bd) {
        if (bd.body != undefined) { return bd.body }
        if (bd.ebody != undefined) {
            var et = bd.ebody
            return function(b) { var r = et(b); r.b.NewRet(r.v); return deadBlock() }
        }
        // No body (abstract / external / ;-only member): an empty body.
        return function(b) { return b }
    }
    // isCtl marks a try/catch body closure: a return/break/continue leaving it emits a
    // control signal instead of a ret/br (see compile-core inCtlBody / excDispatch).
    function emitFunc(params, bodyStmt, isInstance, isCtl) {
        funcCount++
        var idx = funcCount
        var f = m.NewFunc("jsf_" + idx, i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var savedF = curF
        var savedScope = curScopeV
        var savedLoops = loopStack
        var savedTag = curFTag
        curF = f
        curFTag = idx
        loopStack = []
        if (isCtl) { ctlEnter(idx) }
        var b = f.NewBlock("entry")
        curScopeV = callExt(b, "js_scope_new", [f.Params[0]])
        var off = 0
        if (isInstance) {
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "this"), callExt(b, "js_arg", [f.Params[1], handle(0)])])
            off = 1
        }
        b = emitParamBinds(b, params, off, isInstance ? callExt(b, "js_arg", [f.Params[1], handle(0)]) : null, false)
        var endB = bodyStmt(b)
        endB.NewRet(hUndef)
        if (isCtl) { ctlLeave() }
        curF = savedF
        curScopeV = savedScope
        loopStack = savedLoops
        curFTag = savedTag
        return idx
    }
    function makeArrow(items) {
        var params = items[0].params
        var bodyStmt = bodyToStmt(items[1])
        return function(b) {
            var idx = emitFunc(params, bodyStmt, false)
            return {b: b, v: callExt(b, "js_closure", [handle(idx), curScopeV])}
        }
    }
    function makeFuncDecl(items) {
        var name = items[0].fname
        var params = items[1].params
        var bodyStmt = bodyToStmt(items[2])
        return function(b) {
            var idx = emitFunc(params, bodyStmt, false)
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, name),
                                         callExt(b, "js_closure", [handle(idx), curScopeV])])
            return b
        }
    }

    // ----- calls and construction -----
    function makeCall(items) {
        var name = items[0]
        var args = items.slice(1)
        return function(b) {
            // identical(a, b) is reference equality, which is exactly js_seq.
            if (name == "identical" && args.length == 2) {
                var i1 = args[0](b)
                var i2 = args[1](i1.b)
                return {b: i2.b, v: callExt(i2.b, "js_seq", [i1.v, i2.v])}
            }
            // A bare call to an instance method of the class whose body this call stands
            // in: `go()` inside a method is `this.go()`.
            if (curMethodNames != null && curMethodNames["$" + name] == 1) {
                var thisV = callExt(b, "js_kget", [curScopeV, emitStr(b, "this")])
                var mArgs = callExt(b, "js_arr_new", [])
                b = emitCallArgsInto(b, mArgs, args)
                return {b: b, v: callExt(b, "js_mcall", [thisV, emitStr(b, name), mArgs])}
            }
            // A static method of the class whose body this call stands in.
            if (staticHit(name)) {
                var scV = clsRef(b, curStaticsCls)
                var sfV = callExt(b, "js_get", [scV, emitStr(b, name)])
                var sArgs = callExt(b, "js_arr_new", [])
                b = emitCallArgsInto(b, sArgs, args)
                return {b: b, v: callExt(b, "js_call", [sfV, hUndef, sArgs])}
            }
            if (classNames[name] == 1) {
                var clsV = callExt(b, "js_kget", [curScopeV, emitStr(b, name)])
                var objV = callExt(b, "js_obj_new", [])
                callExt(b, "js_set", [objV, emitStr(b, "__class"), clsV])
                var argsV = callExt(b, "js_arr_new", [])
                callExt(b, "js_arr_push", [argsV, objV])
                b = emitCallArgsInto(b, argsV, args)
                // An unnamed factory constructor RETURNS the instance instead of
                // initialising the fresh one, so its result is the value of the creation.
                if (factoryClasses[name] == 1) {
                    var facV = callExt(b, "js_get", [clsV, emitStr(b, "__factory")])
                    return {b: b, v: callExt(b, "js_call", [facV, hUndef, argsV])}
                }
                var ctorV = callExt(b, "js_get", [clsV, emitStr(b, "__ctor")])
                callExt(b, "js_call", [ctorV, hUndef, argsV])
                return {b: b, v: objV}
            }
            var fV = callExt(b, "js_kget", [curScopeV, emitStr(b, name)])
            var argsV2 = callExt(b, "js_arr_new", [])
            b = emitCallArgsInto(b, argsV2, args)
            return {b: b, v: callExt(b, "js_call", [fV, hUndef, argsV2])}
        }
    }

    // Dart's String.length is the UTF-16 CODE UNIT count, like JS, so '\u{1F600}'.length
    // is 2 - but js_pylen counts CODE POINTS (it is Python's len) and answers 1. A .length
    // read therefore branches on the receiver: js_get("length") for a string, js_pylen for
    // a List / Map / Set.
    function emitLength(b, v) {
        var strB = curF.NewBlock("")
        var othB = curF.NewBlock("")
        var mrgB = curF.NewBlock("")
        b.NewCondBr(truthy(b, callExt(b, "js_is_type", [v, emitStr(b, "String")])), strB, othB)
        var sv = callExt(strB, "js_get", [v, emitStr(strB, "length")])
        strB.NewBr(mrgB)
        var ov = callExt(othB, "js_pylen", [v])
        othB.NewBr(mrgB)
        return {b: mrgB, v: mrgB.NewPhi([llvm.ir.NewIncoming(sv, strB), llvm.ir.NewIncoming(ov, othB)])}
    }

    // ----- member chains: .method(args), .field, [index] -----
    core.indexExt = "js_pyget"
    foldCallMember = function(items) {
        if (items.length == 1) { return items[0] }
        var primary = items[0]
        var suffixes = items.slice(1)
        return function(b) {
            var r = primary(b)
            b = r.b
            var cur = r.v
            // Blocks where a ?. / ?[ receiver was null: the WHOLE remaining chain is
            // skipped and the expression is null, so they all flow into one final phi.
            var nullBs = []
            for (var i = 0; i < suffixes.length; i++) {
                var s = suffixes[i]
                if (s.kind == "nmcall" || s.kind == "nfield" || s.kind == "nindex") {
                    var contB = curF.NewBlock("")
                    var skipB = curF.NewBlock("")
                    b.NewCondBr(truthy(b, emitIsNull(b, cur)), skipB, contB)
                    nullBs.push(skipB)
                    b = contB
                    s = {kind: s.kind.substring(1), name: s.name, args: s.args, idx: s.idx}
                }
                if (s.kind == "mcall") {
                    // contains / containsKey are membership tests on a Set, List, String
                    // or Map's keys, which is exactly js_pyin (with the operands swapped).
                    if (s.name == "containsKey" || s.name == "contains") {
                        var ar = s.args[0](b)
                        b = ar.b
                        // js_pyin knows lists, strings and dict keys but not SETS, so a
                        // non-string receiver is normalized with js_pyiter first (which
                        // yields a set's elements, a dict's keys and a list itself). A
                        // string is passed through: 'abc'.contains('bc') is a SUBSTRING
                        // test, not a membership test over its characters.
                        var isStr = truthy(b, callExt(b, "js_is_type", [cur, emitStr(b, "String")]))
                        cur = callExt(b, "js_pyin", [ar.v, b.NewSelect(isStr, cur, callExt(b, "js_pyiter", [cur]))])
                    } else {
                        var margs = callExt(b, "js_arr_new", [])
                        b = emitCallArgsInto(b, margs, s.args)
                        cur = callExt(b, "js_mcall", [cur, emitStr(b, s.name), margs])
                    }
                } else if (s.kind == "field") {
                    if (s.name == "length") { var lr = emitLength(b, cur); b = lr.b; cur = lr.v }
                    else if (s.name == "isEmpty") { var er = emitLength(b, cur); b = er.b; cur = callExt(b, "js_seq", [er.v, emitNum(b, 0)]) }
                    else if (s.name == "isNotEmpty") { var nr = emitLength(b, cur); b = nr.b; cur = callExt(b, "js_gt", [nr.v, emitNum(b, 0)]) }
                    else if (s.name == "keys") { cur = callExt(b, "js_mcall", [cur, emitStr(b, "keys"), callExt(b, "js_arr_new", [])]) }
                    else if (s.name == "values") { cur = callExt(b, "js_mcall", [cur, emitStr(b, "values"), callExt(b, "js_arr_new", [])]) }
                    else { var gr = emitGetterRead(b, cur, s.name); b = gr.b; cur = gr.v }
                } else if (s.kind == "bang") {
                    cur = cur // the postfix ! is a no-op (accepted, not implemented)
                } else {
                    var ir = s.idx(b)
                    b = ir.b
                    cur = callExt(b, "js_pyget", [cur, ir.v])
                }
            }
            if (nullBs.length > 0) {
                var endB = curF.NewBlock("")
                var inc = [llvm.ir.NewIncoming(cur, b)]
                b.NewBr(endB)
                for (var k = 0; k < nullBs.length; k++) {
                    nullBs[k].NewBr(endB)
                    inc.push(llvm.ir.NewIncoming(hNull, nullBs[k]))
                }
                return {b: endB, v: endB.NewPhi(inc)}
