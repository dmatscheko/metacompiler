        return function(b) {
            if (operatorNames["$-"] == undefined) { return inner(b) }
            var r = t(b)
            b = r.b
            var ov = r.v
            return emitOpDispatch(b, "-", ov, [],
                                  function(bb) { return {b: bb, v: intWrap(bb, callExt(bb, "js_neg", [ov]))} })
        }
    }
    // ----- patterns (Dart 3) -----
    // The grammar builds one descriptor tree per pattern; a bare name arrives as
    // {p:"idref"} because only the use site knows whether it declares, assigns or names a
    // constant. resolvePat rewrites the tree for the context ("decl" / "assign" / "match")
    // once, at build time - exactly as in the interpreter, and the two share the shapes.
    function makeOrPat(items) {
        if (items.length == 1) { return items[0] }
        return {p: "or", alts: items}
    }
    function makeAndPat(items) {
        if (items.length == 1) { return items[0] }
        return {p: "and", alts: items}
    }
    function makeRelPat(items) { return {p: "rel", op: stripWs(items[0].relop), t: items[1]} }
    function makePostPat(items) {
        var pt = items[0]
        for (var i = 1; i < items.length; i++) {
            if (items[i].post == "?") { pt = {p: "nullcheck", inner: pt} }
            else if (items[i].post == "!") { pt = {p: "nullassert", inner: pt} }
            else { pt = {p: "cast", inner: pt, ty: items[i].ty} }
        }
        return pt
    }
    function makeListPat(items) {
        var elems = []
        var restAt = -1
        var restPat = null
        for (var i = 0; i < items.length; i++) {
            if (items[i].prest === true) { restAt = elems.length; restPat = items[i].rpat }
            else { elems.push(items[i].pelem) }
        }
        return {p: "list", elems: elems, restAt: restAt, restPat: restPat}
    }
    function makeRestPat(items) { return {prest: true, rpat: items.length > 0 ? items[0] : null} }
    function makeMapPat(items) { return {p: "map", entries: items} }
    function makeRecPat(items) { return {p: "rec", fields: items} }
    function makeVarPat(items) { return {p: "bind", name: stripWs(items[items.length - 1].pvname)} }
    function makeObjPat(items) { return {p: "obj", ty: items[0].otype, fields: items.slice(1)} }
    // :var side  ==  side: var side  (the getter name comes from the bound variable).
    function makeShortField(pat) {
        var nm = ""
        if (pat.p == "bind") { nm = pat.name }
        else if (pat.p == "idref") { nm = pat.name }
        else { fail("an object-pattern shorthand needs a variable pattern") }
        return {pfname: nm, pfpat: pat}
    }
    function resolvePat(pat, mode) {
        if (pat.p == "idref") {
            if (pat.name == "_") { return {p: "wild"} }
            if (mode == "decl") { return {p: "bind", name: pat.name} }
            if (mode == "assign") { return {p: "setvar", name: pat.name} }
            if (pat.name == "null") { return {p: "const", t: makeConst(null)} }
            if (pat.name == "true") { return {p: "const", t: makeConst(true)} }
            if (pat.name == "false") { return {p: "const", t: makeConst(false)} }
            return {p: "const", t: makeVarRef(pat.name)}
        }
        if (pat.p == "bind" && pat.name == "_") { return {p: "wild"} }
        if (pat.p == "or" || pat.p == "and") {
            var alts = []
            for (var i = 0; i < pat.alts.length; i++) { alts.push(resolvePat(pat.alts[i], mode)) }
            return {p: pat.p, alts: alts}
        }
        if (pat.p == "nullcheck" || pat.p == "nullassert") { return {p: pat.p, inner: resolvePat(pat.inner, mode)} }
        if (pat.p == "cast") { return {p: "cast", inner: resolvePat(pat.inner, mode), ty: pat.ty} }
        if (pat.p == "list") {
            var elems = []
            for (var j = 0; j < pat.elems.length; j++) { elems.push(resolvePat(pat.elems[j], mode)) }
            var rp = (pat.restPat != null) ? resolvePat(pat.restPat, mode) : null
            return {p: "list", elems: elems, restAt: pat.restAt, restPat: rp}
        }
        if (pat.p == "map") {
            var ents = []
            for (var k = 0; k < pat.entries.length; k++) {
                ents.push({mkey: pat.entries[k].mkey, mpat: resolvePat(pat.entries[k].mpat, mode)})
            }
            return {p: "map", entries: ents}
        }
        if (pat.p == "rec" || pat.p == "obj") {
            var fs = []
            for (var m = 0; m < pat.fields.length; m++) {
                fs.push({pfname: pat.fields[m].pfname, pfpat: resolvePat(pat.fields[m].pfpat, mode)})
            }
            if (pat.p == "obj") { return {p: "obj", ty: pat.ty, fields: fs} }
            return {p: "rec", fields: fs}
        }
        return pat
    }

    // Emit the match of `v` against `pat`, in block b. Every way of NOT matching branches
    // to failB; the block returned is the one the match succeeded in. Bindings are plain
    // js_scope_decl on the way through, so an alternative that failed halfway may have
    // declared some of its names - which is what the interpreter does too, and Dart's
    // scoping makes them unreachable either way.
    function emitPat(b, pat, v, failB) {
        var k = pat.p
        if (k == "wild") { return b }
        if (k == "bind") { callExt(b, "js_scope_decl", [curScopeV, emitStr(b, pat.name), v]); return b }
        if (k == "setvar") { callExt(b, "js_kset", [curScopeV, emitStr(b, pat.name), v]); return b }
        if (k == "const") {
            var cr = pat.t(b)
            b = cr.b
            var ce = emitEq(b, "==", cr.v, v)
            b = ce.b
            var okC = curF.NewBlock("")
            b.NewCondBr(truthy(b, ce.v), okC, failB)
            return okC
        }
        if (k == "rel") {
            var rr = pat.t(b)
            b = rr.b
            var cv = hFalse
            if (pat.op == "==" || pat.op == "!=") {
                var re = emitEq(b, pat.op, v, rr.v)
                b = re.b
                cv = re.v
            } else { cv = emitBin(b, pat.op, v, rr.v) }
            var okR = curF.NewBlock("")
            b.NewCondBr(truthy(b, cv), okR, failB)
            return okR
        }
        if (k == "or") {
            var okO = curF.NewBlock("")
            for (var i = 0; i < pat.alts.length; i++) {
                var lastAlt = (i == pat.alts.length - 1)
                var nextA = lastAlt ? failB : curF.NewBlock("")
                emitPat(b, pat.alts[i], v, nextA).NewBr(okO)
                b = nextA
            }
            return okO
        }
        if (k == "and") {
            for (var j = 0; j < pat.alts.length; j++) { b = emitPat(b, pat.alts[j], v, failB) }
            return b
        }
        if (k == "nullcheck") {
            var okN = curF.NewBlock("")
            b.NewCondBr(truthy(b, emitIsNull(b, v)), failB, okN)
            return emitPat(okN, pat.inner, v, failB)
        }
        if (k == "nullassert") {
            var okA = curF.NewBlock("")
            var badA = curF.NewBlock("")
            b.NewCondBr(truthy(b, emitIsNull(b, v)), badA, okA)
            callExt(badA, "js_throw", [emitStr(badA, "null check pattern matched a null value")])
            badA.NewBr(okA)
            return emitPat(okA, pat.inner, v, failB)
        }
        if (k == "cast") { return emitPat(b, pat.inner, v, failB) }
        if (k == "rec") {
            var okE = curF.NewBlock("")
            b.NewCondBr(truthy(b, callExt(b, "js_is_type", [v, emitStr(b, "Record")])), okE, failB)
            b = okE
            var pos = 0
            for (var f = 0; f < pat.fields.length; f++) {
                var nm = pat.fields[f].pfname
                if (nm == "") { pos = pos + 1; nm = "$" + pos }
                b = emitPat(b, pat.fields[f].pfpat, callExt(b, "js_get", [v, emitStr(b, nm)]), failB)
            }
            return b
        }
        if (k == "list") {
            var okL = curF.NewBlock("")
            b.NewCondBr(truthy(b, callExt(b, "js_is_type", [v, emitStr(b, "List")])), okL, failB)
            b = okL
            var need = pat.elems.length
            var lenV = callExt(b, "js_pylen", [v])
            var okL2 = curF.NewBlock("")
            if (pat.restAt < 0) {
                b.NewCondBr(truthy(b, callExt(b, "js_seq", [lenV, emitNum(b, need)])), okL2, failB)
                b = okL2
                for (var e = 0; e < need; e++) {
                    b = emitPat(b, pat.elems[e], callExt(b, "js_pyget", [v, emitNum(b, e)]), failB)
                }
                return b
            }
            // [a, ..., b] / [a, ...rest]: the elements before the rest count from the
            // front, the ones after it from the back, and the rest takes what is left.
            b.NewCondBr(truthy(b, callExt(b, "js_ge", [lenV, emitNum(b, need)])), okL2, failB)
            b = okL2
            var extra = callExt(b, "js_sub", [lenV, emitNum(b, need)])
            for (var a = 0; a < pat.restAt; a++) {
                b = emitPat(b, pat.elems[a], callExt(b, "js_pyget", [v, emitNum(b, a)]), failB)
            }
            if (pat.restPat != null) {
                var slV = callExt(b, "js_pyslice", [v, emitNum(b, pat.restAt),
                                                    callExt(b, "js_jadd", [emitNum(b, pat.restAt), extra])])
                b = emitPat(b, pat.restPat, slV, failB)
            }
            for (var c2 = pat.restAt; c2 < need; c2++) {
                b = emitPat(b, pat.elems[c2],
                            callExt(b, "js_pyget", [v, callExt(b, "js_jadd", [emitNum(b, c2), extra])]), failB)
            }
            return b
        }
        if (k == "map") {
            // js_is_type does not know a dict, so the key membership test IS the type
            // test: js_pyin answers false for a key a list or a string does not hold.
            for (var g = 0; g < pat.entries.length; g++) {
                var kr = pat.entries[g].mkey(b)
                b = kr.b
                var okM = curF.NewBlock("")
                b.NewCondBr(truthy(b, callExt(b, "js_pyin", [kr.v, v])), okM, failB)
                b = okM
                b = emitPat(b, pat.entries[g].mpat, callExt(b, "js_pyget", [v, kr.v]), failB)
            }
            return b
        }
        if (k == "obj") {
            var okB2 = curF.NewBlock("")
            b.NewCondBr(truthy(b, callExt(b, "js_is_type", [v, emitStr(b, baseName(pat.ty))])), okB2, failB)
            b = okB2
            for (var o = 0; o < pat.fields.length; o++) {
                var mr = emitGetterRead(b, v, pat.fields[o].pfname)
                b = mr.b
                b = emitPat(b, pat.fields[o].pfpat, mr.v, failB)
            }
            return b
        }
        fail("unknown pattern kind " + k)
    }
    // A pattern that MUST match (a declaration, an assignment, a for-in element): the
    // failure block raises, and both paths meet in a fresh block so the emitted IR is
    // well formed however few blocks emitPat itself created.
    function emitPatOrDie(b, pat, v, msg) {
        var failB = curF.NewBlock("")
        var okB = emitPat(b, pat, v, failB)
        var contB = curF.NewBlock("")
        okB.NewBr(contB)
        callExt(failB, "js_throw", [emitStr(failB, msg)])
        failB.NewBr(contB)
        return contB
    }

    // ----- pattern statements: declaration, assignment, for-in, if-case -----
    function makePatDecl(items) {
        var pat = resolvePat(items[0], "decl")
        var init = items[1]
        return function(b) {
            var r = init(b)
            return emitPatOrDie(r.b, pat, r.v, "pattern did not match the initialiser")
        }
    }
    function makePatAssign(items) {
        var pat = resolvePat(items[0], "assign")
        var rhs = items[1]
        return function(b) {
            var r = rhs(b)
            return emitPatOrDie(r.b, pat, r.v, "pattern assignment did not match")
        }
    }
    // for (var (a, b) in pairs): the same loop makeForIn emits, with the element bound
    // through a pattern instead of a single name.
    function makeForInPat(items) {
        var pat = resolvePat(items[0], "decl")
        var iterT = items[1]
        var bodyT = items[2]
        return function(b) {
            var lbl = takeLabel()
            var saved = curScopeV
            curScopeV = callExt(b, "js_scope_new", [saved])
            var ir = iterT(b)
            b = ir.b
            var itV = callExt(b, "js_pyiter", [ir.v])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "0pit"), itV])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "0plen"), callExt(b, "js_pylen", [itV])])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "0pi"), callExt(b, "js_num_i", [handle(0)])])
            var headB = curF.NewBlock("")
            var bodyB = curF.NewBlock("")
            var postB = curF.NewBlock("")
            var exitB = curF.NewBlock("")
            b.NewBr(headB)
            var iC = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, "0pi")])
            var lC = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, "0plen")])
            headB.NewCondBr(truthy(headB, callExt(headB, "js_lt", [iC, lC])), bodyB, exitB)
            var iB = callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, "0pi")])
            var itB = callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, "0pit")])
            var elemV = callExt(bodyB, "js_pyget", [itB, iB])
            var mB = emitPatOrDie(bodyB, pat, elemV, "for-in pattern did not match an element")
            loopStack.push({cont: postB, brk: exitB, label: lbl})
            bodyT(mB).NewBr(postB)
            loopStack.pop()
            var iP = callExt(postB, "js_scope_get", [curScopeV, emitStr(postB, "0pi")])
            callExt(postB, "js_scope_set", [curScopeV, emitStr(postB, "0pi"),
                                            callExt(postB, "js_add", [iP, callExt(postB, "js_num_i", [handle(1)])])])
            postB.NewBr(headB)
            curScopeV = saved
            return exitB
        }
    }
    // items = [subject, pattern, guard?, then, else?]
    function makeIfCase(items) {
        var subj = items[0]
        var pat = resolvePat(items[1], "decl")
        var idx = 2
        var guard = null
        if (items[idx] != undefined && items[idx].guard != undefined) { guard = items[idx].guard; idx = idx + 1 }
        var thenT = items[idx]
        var elseT = (idx + 1 < items.length) ? items[idx + 1] : null
        return function(b) {
            var r = subj(b)
            b = r.b
            var elseB = curF.NewBlock("")
            var endB = curF.NewBlock("")
            var hitB = emitPat(b, pat, r.v, elseB)
            if (guard != null) {
                var gr = guard(hitB)
                var gB = curF.NewBlock("")
                gr.b.NewCondBr(truthy(gr.b, gr.v), gB, elseB)
                hitB = gB
            }
            thenT(hitB).NewBr(endB)
            var eb = (elseT != null) ? elseT(elseB) : elseB
            eb.NewBr(endB)
            return endB
        }
    }

    // ----- switch statement and switch expression -----
    function makeSwBody(items) { return {swbody: makeSeq(items), swempty: items.length == 0} }
    function makeSwCase(items) {
        var c = {pat: resolvePat(items[0], "decl"), guard: null, body: null, empty: true, isdef: false}
        for (var i = 1; i < items.length; i++) {
            if (items[i].guard != undefined) { c.guard = items[i].guard }
            else { c.body = items[i].swbody; c.empty = items[i].swempty }
        }
        return c
    }
    function makeSwDefault(items) {
        var c = {pat: null, guard: null, body: null, empty: true, isdef: true}
        for (var i = 0; i < items.length; i++) { c.body = items[i].swbody; c.empty = items[i].swempty }
        return c
    }
    // There is no fallthrough in Dart: a non-empty case body ends the switch, an EMPTY one
    // shares the next case's body - which here means that body is EMITTED again on this
    // case's path. break inside a case leaves the switch, so the switch pushes a loopStack
    // entry whose brk is the exit block (and whose cont is the enclosing loop's, so a
    // `continue` inside a switch inside a loop still reaches the loop).
    function makeSwitch(items) {
        var subj = items[0]
        var cases = items.slice(1)
        return function(b) {
            var r = subj(b)
            b = r.b
            var v = r.v
            var endB = curF.NewBlock("")
            var outerCont = loopStack.length > 0 ? loopStack[loopStack.length - 1].cont : null
            loopStack.push({cont: outerCont, brk: endB, label: ""})
            for (var i = 0; i < cases.length; i++) {
                var c = cases[i]
                var nextB = curF.NewBlock("")
                var hitB = b
                if (!c.isdef) { hitB = emitPat(b, c.pat, v, nextB) }
                if (c.guard != null) {
                    var gr = c.guard(hitB)
                    var gB = curF.NewBlock("")
                    gr.b.NewCondBr(truthy(gr.b, gr.v), gB, nextB)
                    hitB = gB
                }
                var j = i
                while (j < cases.length && cases[j].empty) { j = j + 1 }
                var bodyEnd = (j < cases.length) ? cases[j].body(hitB) : hitB
                bodyEnd.NewBr(endB)
                if (c.isdef) { nextB.NewBr(endB) }
                b = nextB
            }
            loopStack.pop()
            b.NewBr(endB)
            return endB
        }
    }
    function makeSwExprCase(items) {
        var c = {pat: resolvePat(items[0], "decl"), guard: null, val: null}
        for (var i = 1; i < items.length; i++) {
            if (items[i].guard != undefined) { c.guard = items[i].guard }
            else { c.val = items[i] }
        }
        return c
    }
    function makeSwitchExpr(items) {
        var subj = items[0]
        var cases = items.slice(1)
        return function(b) {
            var r = subj(b)
            b = r.b
            var v = r.v
            var endB = curF.NewBlock("")
            var inc = []
            for (var i = 0; i < cases.length; i++) {
                var nextB = curF.NewBlock("")
                var hitB = emitPat(b, cases[i].pat, v, nextB)
                if (cases[i].guard != null) {
                    var gr = cases[i].guard(hitB)
                    var gB = curF.NewBlock("")
                    gr.b.NewCondBr(truthy(gr.b, gr.v), gB, nextB)
                    hitB = gB
                }
                var vr = cases[i].val(hitB)
                vr.b.NewBr(endB)
                inc.push(llvm.ir.NewIncoming(vr.v, vr.b))
                b = nextB
            }
            callExt(b, "js_throw", [emitStr(b, "no case of the switch expression matched")])
            b.NewBr(endB)
            inc.push(llvm.ir.NewIncoming(hNull, b))
            return {b: endB, v: endB.NewPhi(inc)}
        }
    }

    // ----- reified collection element types -----
    // Dart's generics are reified: <Object>[1] is not a List<int>. The type argument
    // cannot be stored ON the list (the runtime's arrays take no properties), so a pair of
    // append-only side arrays in the ROOT scope records it, newest entry wins, capped so a
    // literal inside a long loop cannot grow them without bound (the test then simply
    // falls back to the unreified answer). Declared and consulted ONLY by a program that
    // writes a typed collection literal.
    var anyTypedColl = false
    function emitETSet(b, v, ty) {
        var ksV = callExt(b, "js_kget", [curScopeV, emitStr(b, "0etk")])
        var vsV = callExt(b, "js_kget", [curScopeV, emitStr(b, "0etv")])
        var roomB = curF.NewBlock("")
        var contB = curF.NewBlock("")
        b.NewCondBr(truthy(b, callExt(b, "js_lt", [callExt(b, "js_pylen", [ksV]), emitNum(b, 256)])), roomB, contB)
        callExt(roomB, "js_arr_push", [ksV, v])
        callExt(roomB, "js_arr_push", [vsV, emitStr(roomB, ty)])
        roomB.NewBr(contB)
        return contB
    }
    function emitETGet(b, v) {
        var ksV = callExt(b, "js_kget", [curScopeV, emitStr(b, "0etk")])
        var vsV = callExt(b, "js_kget", [curScopeV, emitStr(b, "0etv")])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "0eti"), callExt(b, "js_pylen", [ksV])])
        var headB = curF.NewBlock("")
        var stepB = curF.NewBlock("")
        var hitB = curF.NewBlock("")
        var missB = curF.NewBlock("")
        var endB = curF.NewBlock("")
        b.NewBr(headB)
        var iH = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, "0eti")])
        headB.NewCondBr(truthy(headB, callExt(headB, "js_gt", [iH, emitNum(headB, 0)])), stepB, missB)
        var iS = callExt(stepB, "js_sub", [callExt(stepB, "js_scope_get", [curScopeV, emitStr(stepB, "0eti")]),
                                           emitNum(stepB, 1)])
        callExt(stepB, "js_scope_set", [curScopeV, emitStr(stepB, "0eti"), iS])
        stepB.NewCondBr(truthy(stepB, callExt(stepB, "js_seq", [callExt(stepB, "js_pyget", [ksV, iS]), v])),
                        hitB, headB)
        var hv = callExt(hitB, "js_pyget", [vsV, callExt(hitB, "js_scope_get", [curScopeV, emitStr(hitB, "0eti")])])
        hitB.NewBr(endB)
        var mv = emitStr(missB, "")
        missB.NewBr(endB)
        return {b: endB, v: endB.NewPhi([llvm.ir.NewIncoming(hv, hitB), llvm.ir.NewIncoming(mv, missB)])}
    }
    // The first type argument of List<int> / Map<K,V>, as written.
    function typeArgOf(t) {
        var s3 = stripWs(t)
        var i = s3.indexOf("<")
        if (i < 0) { return "" }
        var out = ""
        for (var j = i + 1; j < s3.length; j++) {
            var ch = s3.charAt(j)
            if (ch == ">" || ch == ",") { break }
            out = out + ch
        }
        return out
    }
    function makeTypedColl(items) {
        anyTypedColl = true
        var ty = stripWs(items[0].ctargs)
        ty = ty.substring(1, ty.length - 1)
        var t = items[1]
        return function(b) {
            var r = t(b)
            return {b: emitETSet(r.b, r.v, ty), v: r.v}
        }
    }
    function makeTemplate(items) {
        return function(b) {
            var v = emitStr(b, "")
            for (var i = 0; i < items.length; i++) {
                var pv = anytype
                if (items[i].s != undefined) { pv = emitStr(b, items[i].s) }
                else { var r = items[i].e(b); b = r.b; pv = r.v }
                v = callExt(b, "js_jadd", [v, pv])
            }
            return {b: b, v: v}
        }
    }

    // ----- ternary, return -----
    function makeCond(items) {
        if (items.length == 1) { return items[0] }
        return function(b) {
            var r = items[0](b)
            var thenB = curF.NewBlock("")
            var elseB = curF.NewBlock("")
            var mergeB = curF.NewBlock("")
            r.b.NewCondBr(truthy(r.b, r.v), thenB, elseB)
            var rt = items[1](thenB)
            rt.b.NewBr(mergeB)
            var re = items[2](elseB)
            re.b.NewBr(mergeB)
            var phi = mergeB.NewPhi([llvm.ir.NewIncoming(rt.v, rt.b), llvm.ir.NewIncoming(re.v, re.b)])
            return {b: mergeB, v: phi}
        }
    }
    function makeReturn(items) {
        var t = items.length > 0 ? items[0] : null
        return function(b) {
            var v = hNull
            if (t != null) { var r = t(b); b = r.b; v = r.v }
            return retStmt(b, v) // plain ret, or a control signal when leaving a try body
        }
    }

    // ----- declarations, assignment, ++/-- -----
    function makeDecl(items) {
        var name = items[0]
        return function(b) {
            var v = hNull
            if (items.length > 1) { var r = items[1](b); b = r.b; v = r.v }
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, name), v])
            return b
        }
    }
    // items[0] is either the plain name string or a {seed} wrapper around a call thunk.
    function makeDartTarget(items) {
        if (items[0] != undefined && items[0].seed != undefined) {
            return {name: "", seed: items[0].seed, path: items.slice(1)}
        }
        return {name: items[0], path: items.slice(1)}
    }
    function emitRefPath(b, ref) {
        var o = anytype
        if (ref.seed != undefined) { var sr0 = ref.seed(b); b = sr0.b; o = sr0.v }
        else { o = callExt(b, "js_kget", [curScopeV, emitStr(b, ref.name)]) }
        for (var i = 0; i < ref.path.length - 1; i++) {
            var s = ref.path[i]
            if (s.key != undefined) { o = callExt(b, "js_get", [o, emitStr(b, s.key)]) }
            else { var ri = s.idx(b); var rg = emitIndexGet(ri.b, o, ri.v); b = rg.b; o = rg.v }
        }
        var last = ref.path[ref.path.length - 1]
        if (last.key != undefined) { return {b: b, obj: o, key: emitStr(b, last.key), field: true} }
        var kr = last.idx(b)
        return {b: kr.b, obj: o, key: kr.v, field: false}
    }
    // A read of an assignment TARGET as an expression (used to lower ??=).
    function makeRefRead(ref) {
        return function(b) {
            if (ref.path.length == 0) {
                if (ref.seed != undefined) { return ref.seed(b) }
                return {b: b, v: callExt(b, "js_kget", [curScopeV, emitStr(b, ref.name)])}
            }
            var p = emitRefPath(b, ref)
            b = p.b
            if (p.field) { return {b: b, v: callExt(b, "js_get", [p.obj, p.key])} }
            return emitIndexGet(b, p.obj, p.key)
        }
    }
    function makeAssign(items, pos) {
        var ref = items[0]
        var op = items[1]
        var valT = items[2]
        // a ??= b assigns only when a is null, and does not evaluate b otherwise; it is
        // lowered as `a = a ?? b` over the same reference (makeIfNull short-circuits).
        if (op == "??=") { valT = makeIfNull([makeRefRead(ref), null, valT]); op = "=" }
        return function(b) {
            var r = valT(b)
            b = r.b
            var v = r.v
            if (ref.path.length == 0 && ref.seed != undefined) { return ref.seed(b) }
            if (ref.path.length == 0) {
                var nameV = emitStr(b, ref.name)
                // A static of the enclosing class, or a top-level setter, rather than a
                // plain scope slot.
                if (staticHit(ref.name)) {
                    var scV2 = clsRef(b, curStaticsCls)
                    if (op != "=") { v = emitBin(b, op, callExt(b, "js_get", [scV2, nameV]), v) }
                    callExt(b, "js_set", [scV2, nameV, v])
                    return {b: b, v: v}
                }
                if (topSetters["$" + ref.name] == 1) {
                    if (op != "=") {
                        var og = callExt(b, "js_kget", [curScopeV, emitStr(b, "get$" + ref.name)])
                        var oa = callExt(b, "js_arr_new", [])
                        v = emitBin(b, op, callExt(b, "js_call", [og, hUndef, oa]), v)
                    }
                    var stV = callExt(b, "js_kget", [curScopeV, emitStr(b, "set$" + ref.name)])
                    var sa = callExt(b, "js_arr_new", [])
                    callExt(b, "js_arr_push", [sa, v])
                    callExt(b, "js_call", [stV, hUndef, sa])
                    return {b: b, v: v}
                }
                if (op != "=") {
                    var oldl = callExt(b, "js_kget", [curScopeV, nameV])
                    v = emitBin(b, op, oldl, v)
                }
                callExt(b, "js_kset", [curScopeV, nameV, v])
            } else {
                var p = emitRefPath(b, ref)
                b = p.b
                if (p.field) {
                    if (op != "=") { var oldf = callExt(b, "js_get", [p.obj, p.key]); v = emitBin(b, op, oldf, v) }
                    b = emitSetterWrite(b, p.obj, ref.path[ref.path.length - 1].key, v)
                    return {b: b, v: v}
                } else {
                    if (op != "=") {
                        var og2 = emitIndexGet(b, p.obj, p.key)
                        b = og2.b
                        v = emitBin(b, op, og2.v, v)
                    }
                    b = emitIndexSet(b, p.obj, p.key, v)
                }
            }
            return {b: b, v: v}
        }
    }
    // Prefix ++x / --x: the same update as the postfix form, but the value of the
    // expression is the NEW one.
    function makePreIncDec(items) {
        var extName = (items[0] == "++") ? "js_add" : "js_sub"
        var ref = items[1]
        return function(b) {
            var nameV = emitStr(b, ref.name)
            var oldV = callExt(b, "js_tonum", [callExt(b, "js_kget", [curScopeV, nameV])])
            var newV = intWrap(b, callExt(b, extName, [oldV, callExt(b, "js_num_i", [handle(1)])]))
            callExt(b, "js_kset", [curScopeV, nameV, newV])
            return {b: b, v: newV}
        }
    }
    function makeIncDec(items) {
        var ref = items[0]
        var extName = (items[1] == "++") ? "js_add" : "js_sub"
        return function(b) {
            var nameV = emitStr(b, ref.name)
            var oldV = callExt(b, "js_tonum", [callExt(b, "js_kget", [curScopeV, nameV])])
            var newV = intWrap(b, callExt(b, extName, [oldV, callExt(b, "js_num_i", [handle(1)])]))
            callExt(b, "js_kset", [curScopeV, nameV, newV])
            return {b: b, v: oldV}
        }
    }

    // ----- for and for-in -----
    // ----- labels, labeled break/continue, do-while, assert -----
    // A labeled statement offers its name through pendingLabel right before the inner
    // statement is emitted, so the DIRECTLY labeled loop consumes it into its loopStack
    // entry (an inner loop sees null). The wrapper also pushes an entry of its own with
    // an exit block, which makes a labeled BLOCK breakable; its cont falls back to the
    // enclosing loop.
    var pendingLabel = null
    function takeLabel() { var l = pendingLabel; pendingLabel = null; return l }
    function makeLabeled(items) {
        var name = items[0].slabel
        var innerT = items[1]
        return function(b) {
            var exitB = curF.NewBlock("")
            var outerCont = loopStack.length > 0 ? loopStack[loopStack.length - 1].cont : null
            loopStack.push({cont: outerCont, brk: exitB, label: name})
            pendingLabel = name
            var endB = innerT(b)
            pendingLabel = null
            loopStack.pop()
            endB.NewBr(exitB)
            return exitB
        }
    }
    function findLabeled(lbl) {
        for (var i = loopStack.length - 1; i >= 0; i--) {
            if (loopStack[i].label == lbl) { return loopStack[i] }
        }
        return null
    }
    // A label inside a try/catch closure cannot see the outer loop (the closure resets
    // loopStack), so that case stays reported as not implemented.
    function makeBreakL(items, pos) {
        if (items.length == 0) { return makeBreak() }
        var lbl = items[0].label
        return function(b) {
            var e = findLabeled(lbl)
            if (e == null) { notImpl("break across a try boundary or to an unknown label", pos); return b }
            b.NewBr(e.brk)
            return deadBlock()
        }
    }
    function makeContinueL(items, pos) {
        if (items.length == 0) { return makeContinue() }
        var lbl = items[0].label
        return function(b) {
            var e = findLabeled(lbl)
            if (e == null || e.cont == null) { notImpl("continue across a try boundary or to an unknown label", pos); return b }
            b.NewBr(e.cont)
            return deadBlock()
        }
    }
    // The shared makeWhile knows nothing about labels; reassign it (never redeclare - a
    // second top-level `function makeWhile` would silently rebind the tag).
    makeWhile = function(bodyT, condT) {
        return function(b) {
            var lbl = takeLabel()
            var headB = curF.NewBlock("")
            var bodyB = curF.NewBlock("")
            var exitB = curF.NewBlock("")
            b.NewBr(headB)
            var r = condT(headB)
            r.b.NewCondBr(truthy(r.b, r.v), bodyB, exitB)
            loopStack.push({cont: headB, brk: exitB, label: lbl})
            bodyT(bodyB).NewBr(headB)
            loopStack.pop()
            return exitB
        }
    }
    // do body while (cond): the body runs before the first test, so the entry branches
    // straight into it and the condition sits at the bottom (which is also the continue
    // target, as in Dart).
    function makeDoWhile(items) {
        var bodyT = items[0]
        var condT = items[1]
        return function(b) {
            var lbl = takeLabel()
            var bodyB = curF.NewBlock("")
            var condB = curF.NewBlock("")
            var exitB = curF.NewBlock("")
            b.NewBr(bodyB)
            loopStack.push({cont: condB, brk: exitB, label: lbl})
            bodyT(bodyB).NewBr(condB)
            loopStack.pop()
            var r = condT(condB)
            r.b.NewCondBr(truthy(r.b, r.v), bodyB, exitB)
            return exitB
        }
    }
    // assert(cond[, msg]) : a false condition throws (js_throw), like a failed Dart
    // assertion in debug mode. The message operand is only evaluated when it is needed.
    function makeAssert(items) {
        var condT = items[0]
        var msgT = items.length > 1 ? items[1] : null
        return function(b) {
            var r = condT(b)
            var failB = curF.NewBlock("")
            var okB = curF.NewBlock("")
            r.b.NewCondBr(truthy(r.b, r.v), okB, failB)
            var fb = failB
            var msgV = emitStr(fb, "Assertion failed")
            if (msgT != null) { var mr = msgT(fb); fb = mr.b; msgV = mr.v }
            callExt(fb, "js_throw", [msgV])
            fb.NewBr(okB)
            return okB
        }
    }

    function makeFor(items) {
        var bodyT = items.pop()
        var init = null, cond = null, post = null
        for (var i = 0; i < items.length; i++) {
            if (items[i].k == "init") { init = items[i].t }
            if (items[i].k == "cond") { cond = items[i].t }
            if (items[i].k == "post") { post = items[i].t }
        }
        return function(b) {
            var lbl = takeLabel()
            var saved = curScopeV
            curScopeV = callExt(b, "js_scope_new", [curScopeV])
            if (init != null) { b = init(b) }
            var headB = curF.NewBlock("")
            var bodyB = curF.NewBlock("")
            var postB = curF.NewBlock("")
            var exitB = curF.NewBlock("")
            b.NewBr(headB)
            if (cond != null) {
                var r = cond(headB)
                r.b.NewCondBr(truthy(r.b, r.v), bodyB, exitB)
            } else { headB.NewBr(bodyB) }
            loopStack.push({cont: postB, brk: exitB, label: lbl})
            bodyT(bodyB).NewBr(postB)
            loopStack.pop()
            var pb = postB
            if (post != null) { pb = post(postB) }
            pb.NewBr(headB)
            curScopeV = saved
            return exitB
        }
    }
    function makeForIn(items) {
        var name = items[0]
        var iterT = items[1]
        var bodyT = items[2]
        return function(b) {
            var lbl = takeLabel()
            var saved = curScopeV
            curScopeV = callExt(b, "js_scope_new", [saved])
            var ir = iterT(b)
            b = ir.b
            // js_pyiter normalizes the iterable: a map yields its keys (js_keys order),
            // a string its chars, a list itself - so for (x in coll) walks all three.
            var itV = callExt(b, "js_pyiter", [ir.v])
            var lenV = callExt(b, "js_pylen", [itV])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "0it"), itV])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "0len"), lenV])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "0i"), callExt(b, "js_num_i", [handle(0)])])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, name), hNull])
            var headB = curF.NewBlock("")
            var bodyB = curF.NewBlock("")
            var postB = curF.NewBlock("")
            var exitB = curF.NewBlock("")
            b.NewBr(headB)
            var iC = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, "0i")])
            var lC = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, "0len")])
            headB.NewCondBr(truthy(headB, callExt(headB, "js_lt", [iC, lC])), bodyB, exitB)
            var iB = callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, "0i")])
            var itB = callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, "0it")])
            callExt(bodyB, "js_scope_set", [curScopeV, emitStr(bodyB, name), callExt(bodyB, "js_pyget", [itB, iB])])
            loopStack.push({cont: postB, brk: exitB, label: lbl})
            bodyT(bodyB).NewBr(postB)
            loopStack.pop()
            var iP = callExt(postB, "js_scope_get", [curScopeV, emitStr(postB, "0i")])
            var nextV = callExt(postB, "js_add", [iP, callExt(postB, "js_num_i", [handle(1)])])
            callExt(postB, "js_scope_set", [curScopeV, emitStr(postB, "0i"), nextV])
            postB.NewBr(headB)
            curScopeV = saved
            return exitB
        }
    }

    // The top level statements become dartmain(env, args): declare the top level (functions,
    // classes, top level vars), then call int main(). Its return value is the exit code.
    function buildMain(items) {
        // The walk of an imported file ends here too: stash its top-level declaration
        // thunks for the real dartmain instead of emitting a second one.
        if (importDepth > 0) {
            stashImported(items) // stashed with its file; emitted later (compile-core)
            return
        }
        var f = m.NewFunc("dartmain", i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        curF = f
        var b = f.NewBlock("entry")
        curScopeV = callExt(b, "js_scope_new", [f.Params[0]])
        // Dart print writes its argument followed by a newline (like println).
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "print"),
                                     callExt(b, "js_scope_get", [curScopeV, emitStr(b, "println")])])
        if (anyTypedColl) {
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "0etk"), callExt(b, "js_arr_new", [])])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "0etv"), callExt(b, "js_arr_new", [])])
        }
        // Imported declarations first, then the main file's own top level.
        b = emitImported(b)
        b = makeSeq(items)(b)
        // The entry point defaults to main() but -main (c.mainName) can name another.
        var entry = c.mainName
        if (entry == undefined || entry == "") { entry = "main" }
        if (mainIsSnippet(entry)) {
            b = emitMainSnippet(b, entry, "Statement")
            b.NewRet(emitNum(b, 0))
        } else {
            var mainV = callExt(b, "js_kget", [curScopeV, emitStr(b, entry)])
            var argsV = callExt(b, "js_arr_new", [])
            b.NewRet(callExt(b, "js_call", [mainV, hUndef, argsV]))
        }
    }

    // ----- Core library config (see lib/compile-core.js) -----
    core.scopeGetExt = "js_kget" // Scope read with fallback to properties of this.

    c.compile(c.asg)

    println(m)

    var res = llvm.RunJS(m, "dartmain")
    var entryName = c.mainName
    if (entryName == undefined || entryName == "") { entryName = "main" }
    if (mainIsSnippet(entryName)) {
        println("dart compiler: -main snippet returned " + res.Ret)
    } else {
        println("dart compiler: " + entryName + "() returned " + res.Ret)
    }
    exit(res.Ret)

~~) ;
