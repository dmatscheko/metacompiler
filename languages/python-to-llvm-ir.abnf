        var skipB = curF.NewBlock("")
        var mergeB = curF.NewBlock("")
        b.NewCondBr(truthy(b, isFn), callB, skipB)
        var mainV = callExt(callB, "js_scope_get", [curScopeV, emitStr(callB, entry)])
        var retV = callExt(callB, "js_call", [mainV, hUndef, callExt(callB, "js_arr_new", [])])
        callB.NewBr(mergeB)
        skipB.NewBr(mergeB)
        mergeB.NewRet(mergeB.NewPhi([llvm.ir.NewIncoming(retV, callB),
                                     llvm.ir.NewIncoming(hUndef, skipB)]))
    }

    // ----- Core library config (see lib/compile-core.js) -----
    core.truthyExt = "js_pytruthy" // Python truthiness: empty containers are false.
    // A variable READ goes through py_getvar, not straight through js_scope_get:
    // `del x` leaves a sentinel in the slot and a later read has to raise
    // UnboundLocalError, which abnf/jsrt.go does inside scopeGet and the C floor's
    // scope_get knows nothing about. core.scopeGetExt names an EXTERN and py_getvar
    // is an emitted IR function, so makeVarRef (lib/compile-core.js) is overridden
    // here instead - the same move swift and dart made for js_kget.
    makeVarRef = function(name) {
        return function(b) {
            return {b: b, v: pyGetVar(b, curScopeV, emitStr(b, name))}
        }
    }
    // Python stdlib modules the runtime provides (prefix match, so os.path
    // resolves against "os").
    core.stdlibImports = ["sys", "os", "math", "collections", "itertools", "functools", "re", "json", "typing", "random", "string", "time", "dataclasses", "abc"]
    // Project-file imports: 'import mypkg.helper' / 'from mypkg.helper import x'
    // look for mypkg/helper.py, then mypkg.py under the program's directory and
    // the -i roots (c.findImport). The file is parsed with this grammar and
    // walked with the same tags: its statements are stashed by buildMain
    // (importDepth > 0) and prepended to jsmain, so the module top level runs
    // before the main file's code. A file is imported once; repeats and cycles
    // are no-ops. Deviation from real Python: the module's top-level names bind
    // directly (flat, no module object), so use the from-import style.
    var importedFiles = {}
    var importDepth = 0
    // imported files top-level items: stashImported / emitImported (compile-core)
    core.importFile = function(path, pos) {
        var rel = path.split(".").join("/")
        var cands = [rel + ".py"]
        var cut = -1
        for (var k = 0; k < rel.length; k++) { if (rel.charAt(k) == "/") { cut = k } }
        if (cut > 0) { cands.push(rel.substring(0, cut) + ".py") }
        for (var i = 0; i < cands.length; i++) {
            var file = c.findImport(cands[i])
            if (file == "") { continue }
            if (importedFiles["$" + file] == true) { return true }
            importedFiles["$" + file] = true
            var text = c.readFile(file)
            var asg = c.parse(c.agrammar, text, null, file)
            c.pushSource(file, text)
            importDepth = importDepth + 1
            c.compile(asg)
            importDepth = importDepth - 1
            c.popSource()
            return true
        }
        return false
    }

    c.compile(c.asg)

    // ----- the native build (docs/runtime-next-plan.md part 3) -----
    // jsdispatch(idx, env, args) is the function table a LINKED binary needs: js_closure
    // stores a raw function index, and under llvm.Run the Go runtime turns that index
    // back into a callee by looking "jsf_<idx>" up in the module. A binary has no such
    // reflection, so the module carries the mapping itself. The MISS arm calls
    // jsdispatch_ext, the same table emitted by the layer-2 runtime library
    // (lib/python-rt.ll, built by metajs-to-llvm-ir.abnf -rt-lib): its own function
    // indices are offset by a million, so the two chains cannot overlap and one js_call
    // reaches either module. Emitted ONLY for -exe, so every other run keeps the module
    // it had. This is lua-to-llvm-ir.abnf's emitDispatch, unchanged - the mechanism is
    // the reusable part of phase 4 and nothing here is Python's.
    function emitDispatch() {
        var idxs = []
        var fns = []
        var i = 0
        while (i < m.Funcs.length) {
            var f = m.Funcs[i]
            var nm = f.Name()
            if (nm.length > 4 && nm.substring(0, 4) == "jsf_") {
                idxs.push(parseInt(nm.substring(4, nm.length)))
                fns.push(f)
            }
            i = i + 1
        }
        var ext = m.NewFunc("jsdispatch_ext", i64,
            [llvm.ir.NewParam("idx", i64), llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var d = m.NewFunc("jsdispatch", i64,
            [llvm.ir.NewParam("idx", i64), llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var b = d.NewBlock("entry")
        var extB = d.NewBlock("ext")
        var ownB = d.NewBlock("own")
        b.NewCondBr(b.NewICmp(llvm.enum.IPredSGE, d.Params[0], llvm.constant.NewInt(i64, 1000000)), extB, ownB)
        extB.NewRet(extB.NewCall(ext, [d.Params[0], d.Params[1], d.Params[2]]))
        b = ownB
        i = 0
        while (i < fns.length) {
            var hit = d.NewBlock("hit" + idxs[i])
            var nxt = d.NewBlock("miss" + idxs[i])
            b.NewCondBr(b.NewICmp(llvm.enum.IPredEQ, d.Params[0], llvm.constant.NewInt(i64, idxs[i])), hit, nxt)
            hit.NewRet(hit.NewCall(fns[i], [d.Params[1], d.Params[2]]))
            b = nxt
            i = i + 1
        }
        b.NewRet(b.NewCall(ext, [d.Params[0], d.Params[1], d.Params[2]]))
    }

    // The two runtime inputs live next to THIS grammar, so the build does not depend on
    // the working directory: lib/runtime.ll is the C floor and lib/python-rt.ll is
    // Python's own layer 2. An explicit -rt REPLACES both.
    function libPath(name) {
        var mn = moduleName()
        var cut = -1
        var i = 0
        while (i < mn.length) {
            var ch = mn.charAt(i)
            if (ch == "/" || ch == "\\") { cut = i }
            i = i + 1
        }
        return mn.substring(0, cut + 1) + "lib/" + name
    }

    // Python's entry point is already called jsmain (buildMain above), which is the
    // name the C floor's own main() calls, so no alias function is needed here.
    if (c.exePath != undefined && c.exePath != "") {
        emitDispatch()
        var rts = c.runtime
        if (rts == undefined || rts.length == 0) { rts = [libPath("runtime.ll"), libPath("python-rt.ll")] }
        var buildErr = llvm.BuildExecutable(m, c.exePath, rts)
        if (buildErr != "") {
            println(buildErr)
            exit(1)
        }
        println("python compiler: wrote executable " + c.exePath)
        exit(0)
    }

    println(m)

    var res = llvm.RunJS(m, "jsmain")
    println("python compiler: program ran to completion")
    exit(res.Ret)

~~) ;
