                var ev = callExt(bb, "js_scope_get", [curScopeV, emitStr(bb, eName)])
                var mv = callExt(bb, "js_scope_get", [curScopeV, emitStr(bb, wName)])
                var handled = emitExit(bb, mv, ev)
