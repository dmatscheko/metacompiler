    // bytes are modelled as a LIST of byte numbers, so b"AB"[0] is 65, b"a" + b"b"
    // concatenates and len counts bytes - all through the ordinary list machinery.
    function makeBytes(v) {
        var elems = []
        for (var i = 0; i < v.length; i++) { elems.push(makeConst(v.charCodeAt(i) & 255)) }
        return makeList(elems)
    }
