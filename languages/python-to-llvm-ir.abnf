    // ----- String, bytes and f-string literals -----
    // Decode a Python string body. `raw` keeps every backslash; otherwise the escapes
    // are Python's: the single-character ones, the three digit octal form, the two
    // digit hex form, the four and eight digit Unicode forms, the named character
    // form (a small table of the names a program is likely to spell out) and a
    // backslash before a newline, which joins the lines.
    // The table is keyed with a "$" prefix: a bare name like "constructor" would
    // otherwise resolve to an inherited Object.prototype member under a host JS
    // engine and answer for a name the table does not hold.
    var pyUniNames = {}
    pyUniNames["$BULLET"] = 8226
    pyUniNames["$DEGREE SIGN"] = 176
    pyUniNames["$EURO SIGN"] = 8364
    pyUniNames["$GREEK SMALL LETTER ALPHA"] = 945
    pyUniNames["$GREEK SMALL LETTER PI"] = 960
    pyUniNames["$EM DASH"] = 8212
    pyUniNames["$SNOWMAN"] = 9731
    pyUniNames["$NO-BREAK SPACE"] = 160
    function pyUnescape(text, raw) {
        if (raw) { return text }
        var out = ""
        var i = 0
        while (i < text.length) {
            var c1 = text.charAt(i)
            if (c1 != "\\") { out += c1; i++; continue }
            var e = text.charAt(i + 1)
            if (e == "n") { out += "\n"; i += 2; continue }
            if (e == "t") { out += "\t"; i += 2; continue }
            if (e == "r") { out += "\r"; i += 2; continue }
            if (e == "a") { out += String.fromCharCode(7); i += 2; continue }
            if (e == "b") { out += String.fromCharCode(8); i += 2; continue }
            if (e == "f") { out += String.fromCharCode(12); i += 2; continue }
            if (e == "v") { out += String.fromCharCode(11); i += 2; continue }
            if (e == "\n") { i += 2; continue }
            if (e == "\\") { out += "\\"; i += 2; continue }
            if (e == "'") { out += "'"; i += 2; continue }
            if (e == '"') { out += '"'; i += 2; continue }
            if (e == "x") { out += String.fromCharCode(hexAt(text, i + 2, 2)); i += 4; continue }
            if (e == "u") { out += String.fromCharCode(hexAt(text, i + 2, 4)); i += 6; continue }
            if (e == "U") { out += codePoint(hexAt(text, i + 2, 8)); i += 10; continue }
            if (e == "N" && text.charAt(i + 2) == "{") {
                var close = text.indexOf("}", i + 3)
                if (close > 0) {
                    var nm = pyUniNames["$" + text.substring(i + 3, close)]
                    out += (nm != undefined) ? codePoint(nm) : ""
                    i = close + 1
                    continue
                }
            }
            if (e >= "0" && e <= "7") {
                var oct = ""
                var k = i + 1
                while (k < text.length && oct.length < 3 && text.charAt(k) >= "0" && text.charAt(k) <= "7") {
                    oct += text.charAt(k)
                    k++
                }
                out += String.fromCharCode(parseInt(oct, 8))
                i = k
                continue
            }
            out += "\\"
            i++
        }
        return out
