    // Default values are evaluated once, where the def statement (or lambda
    // expression) runs - real Python semantics. They live as "dflt*NAME" in a
    // hidden scope the closure captures as env; the '*' keeps them out of any
    // identifier's way.
    function emitDefaultsEnv(b, plist) {
        var has = false
        for (var i = 0; i < plist.dflts.length; i++) {
            if (plist.dflts[i] != null) { has = true }
        }
        if (!has) { return {b: b, env: curScopeV} }
        var env = callExt(b, "js_scope_new", [curScopeV])
        for (var i = 0; i < plist.dflts.length; i++) {
            if (plist.dflts[i] == null) { continue }
            var r = plist.dflts[i](b)
            b = r.b
            callExt(b, "js_scope_decl", [env, emitStr(b, "dflt*" + plist.params[i]), r.v])
        }
        return {b: b, env: env}
    }
