        sawYield = false
        var endB = bodyT(fb)
        endB.NewRet(hUndef)
        genClosure = sawYield
        sawYield = savedYield
        pyBindSink = savedSink
        pyAnnotHere = savedAnnot
        pyInnerNames = savedInner
        if (isCtl) { ctlLeave() }
