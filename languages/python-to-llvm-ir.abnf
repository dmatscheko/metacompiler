        var raw = false
        var isb = false
        while (i < text.length) {
            var c1 = text.charAt(i)
            if (c1 == "r" || c1 == "R") { raw = true; i++ }
            else if (c1 == "b" || c1 == "B") { isb = true; i++ }
            else if (c1 == "u" || c1 == "U") { i++ }
