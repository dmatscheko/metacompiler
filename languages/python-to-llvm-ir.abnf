            var upV = callExt(notN, "js_scope_get", [envP, emitStr(notN, "pyup*")])
            var above = callExt(notN, "js_scope_typeof", [upV, nmP])
            var isHere = callExt(notN, "js_sne", [here, emitStr(notN, "undefined")])
            var notAbove = callExt(notN, "js_seq", [above, emitStr(notN, "undefined")])
