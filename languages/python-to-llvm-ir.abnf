    // js_pyfnname remembers it on the closure so f.__name__ can answer.
    function makeDef(bodyT, plist, name, pos) {
        return {dname: name, dstmt: function(b) {
            var idx = emitClosure(plist, bodyT, false)
            var er = emitDefaultsEnv(b, plist)
            b = er.b
            var isGen = genClosure
            var clo = callExt(b, "js_closure", [handle(idx), er.env])
            // A body with a yield in it is a generator FUNCTION: calling it makes a
