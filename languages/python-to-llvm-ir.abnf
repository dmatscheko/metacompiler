    function makeWith(items, pos) {
        var body = null
        var mgrs = []
        for (var i = 0; i < items.length; i++) {
            if (items[i].withbody != undefined) { body = items[i].withbody }
            else if (items[i].ctxitem != undefined) { mgrs.push(items[i]) }
        }
        if (body == null) { body = function(b) { return b } }
        return withLevel(mgrs, 0, body)
    }
    function emitExit(b, mgrV, excV) {
        return callExt(b, "js_pyexit", [mgrV, excV])
    }
    function withLevel(mgrs, i, body) {
        if (i >= mgrs.length) { return body }
        var inner = withLevel(mgrs, i + 1, body)
        var mgr = mgrs[i]
        return function(b) {
            hidCount++
            var wName = "$wm" + hidCount
            var eName = "$we" + hidCount
            var r = mgr.ctxitem(b)
            b = r.b
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, wName), r.v])
            var entV = callExt(b, "js_pyenter", [r.v])
            if (mgr.target != null) { b = emitRefWrite(b, mgr.target, entV) }
            var bodyT = function(bb) {
                bb = inner(bb)
                var mv = callExt(bb, "js_scope_get", [curScopeV, emitStr(bb, wName)])
                emitExit(bb, mv, hUndef)
                return bb
            }
            var catchT = function(bb) {
                var ev = callExt(bb, "js_scope_get", [curScopeV, emitStr(bb, eName)])
                var mv = callExt(bb, "js_scope_get", [curScopeV, emitStr(bb, wName)])
                var handled = emitExit(bb, mv, ev)
                var swB = curF.NewBlock("")
                var reB = curF.NewBlock("")
                bb.NewCondBr(truthy(bb, handled), swB, reB)
                callExt(reB, "js_throw", [ev])
                reB.NewRet(hUndef) // Never reached: js_throw unwinds on the host side.
                return swB
            }
            var tryClo = callExt(b, "js_closure", [handle(emitClosure([], bodyT, true)), curScopeV])
            var catchClo = callExt(b, "js_closure", [handle(emitClosure([eName], catchT, true)), curScopeV])
            var ctl = callExt(b, "js_try", [tryClo, catchClo, hUndef])
            return excDispatch(b, ctl)
        }
    }
    // A parameter list. names/dflts keep the declared order (the keyword-only ones
    // last, which is where Python puts them anyway); nkwonly says how many of the
    // trailing names came after the '*' or '*args' and can therefore only be given
    // by keyword. ext marks the extended prologue layout (see pySig in jsrt.go):
    // a def with keyword-only or **kwargs parameters cannot recover them from a
    // flat positional array, so its *args list and **kwargs dict are handed over
    // as two extra argument slots instead.
    function makeParamList(items) {
        var names = []
        var dflts = []
        var rest = null
        var kwargs = null
        var nkwonly = 0
        var afterStar = false
        for (var i = 0; i < items.length; i++) {
            var it = items[i]
            if (it.pslash == true) { continue }        // '/' only forbids a spelling.
            if (it.pstar == true) { afterStar = true }
            else if (it.pkw == true) { kwargs = it.pname }
            else if (it.prest == true) { rest = it.pname; afterStar = true }
            else if (it.pname != undefined) {
                names.push(it.pname)
                dflts.push(it.pdflt != undefined ? it.pdflt : null)
                if (afterStar) { nkwonly = nkwonly + 1 }
            }
        }
        var ext = false
        if (nkwonly > 0) { ext = true }
        if (kwargs != null) { ext = true }
        return {params: names, dflts: dflts, rest: rest, kwargs: kwargs,
                nkwonly: nkwonly, ext: ext, complex: false}
    }
    function makeNamedParam(items) {
        if (items.length > 1) { return {pname: items[0], pdflt: items[1].pdefault} }
        return {pname: items[0]}
    }
    // '*' alone: no rest list, but everything after it is keyword-only.
    function makeRestParam(items) {
        if (items.length == 0) { return {pstar: true} }
        return {pname: items[0], prest: true}
    }
    // '**kws' (or a bare '**', which names nothing and only ends the list).
    function makeKwParam(items) {
        if (items.length == 0) { return {pslash: true} }
        return {pname: items[0], pkw: true}
    }
    // Register a def's parameter shape on its closure, so a keyword call can be
    // bound to it (js_pysig; the runtime side is pyBindCall).
    function emitSig(b, clo, plist) {
        var namesV = callExt(b, "js_arr_new", [])
        for (var i = 0; i < plist.params.length; i++) {
            callExt(b, "js_arr_push", [namesV, emitStr(b, plist.params[i])])
        }
        var nk = plist.nkwonly != undefined ? plist.nkwonly : 0
        var ex = hFalse
        if (plist.ext == true) { ex = hTrue }
        return callExt(b, "js_pysig", [clo, namesV, emitNum(b, nk), ex])
    }

    // def: an own IR function; the body shares one function scope (no block scopes).
    // Emits an own IR function jsf_N(env, args) binding the parameters, running
    // bodyT; returns its index. Accepts a plain name array (the try/catch closures)
    // or a makeParamList result: a defaulted parameter falls back to the def-time
    // value stored as "dflt*NAME" in the closure's env (see emitDefaultsEnv), a
    // *args rest parameter binds the remaining arguments via js_pyrest. isCtl marks
    // a try/catch body closure (a return/break/continue leaving it emits a control
    // signal - see compile-core inCtlBody / excDispatch).
    function emitClosure(plist, bodyT, isCtl) {
        var params = plist.params != undefined ? plist.params : plist
        var dflts = plist.dflts != undefined ? plist.dflts : []
        var rest = plist.rest != undefined ? plist.rest : null
        funcCount++
        var idx = funcCount
        var f = m.NewFunc("jsf_" + idx, i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var savedF = curF
        var savedScope = curScopeV
        var savedLoops = loopStack
        var savedTag = curFTag
        curF = f
        curFTag = idx
        loopStack = []
        if (isCtl) { ctlEnter(idx) }
        var fb = f.NewBlock("entry")
        curScopeV = callExt(fb, "js_scope_new", [f.Params[0]])
        // A def or lambda body is a Python BINDING BOUNDARY: an assignment in it
        // makes a local, even when an enclosing function binds the same name. A
        // try/except/with body closure (isCtl) is NOT one - its assignments belong
        // to the function around it - so only the real functions are marked.
        if (!isCtl) { callExt(fb, "js_pyfnscope", [curScopeV]) }
        for (var i = 0; i < params.length; i++) {
            var argV = callExt(fb, "js_arg", [f.Params[1], handle(i)])
            if (i < dflts.length && dflts[i] != null) {
                var dfltV = callExt(fb, "js_scope_get", [curScopeV, emitStr(fb, "dflt*" + params[i])])
                argV = fb.NewSelect(truthy(fb, callExt(fb, "js_seq", [argV, hUndef])), dfltV, argV)
            }
            callExt(fb, "js_scope_decl", [curScopeV, emitStr(fb, params[i]), argV])
        }
        var kwargs = plist.kwargs != undefined ? plist.kwargs : null
        if (plist.ext == true) {
            // The extended layout: [params..., *args list, **kwargs dict].
            if (rest != null) {
                callExt(fb, "js_scope_decl", [curScopeV, emitStr(fb, rest),
                                              callExt(fb, "js_arg", [f.Params[1], handle(params.length)])])
            }
            if (kwargs != null) {
                callExt(fb, "js_scope_decl", [curScopeV, emitStr(fb, kwargs),
                                              callExt(fb, "js_arg", [f.Params[1], handle(params.length + 1)])])
            }
        } else if (rest != null) {
            callExt(fb, "js_scope_decl", [curScopeV, emitStr(fb, rest),
                                          callExt(fb, "js_pyrest", [f.Params[1], handle(params.length)])])
        }
        var savedYield = sawYield
        sawYield = false
        var endB = bodyT(fb)
        endB.NewRet(hUndef)
        genClosure = sawYield
        sawYield = savedYield
        if (isCtl) { ctlLeave() }
        curF = savedF
        curScopeV = savedScope
        loopStack = savedLoops
        curFTag = savedTag
        return idx
    }
    // Default values are evaluated once, where the def statement (or lambda
    // expression) runs - real Python semantics. They live as "dflt*NAME" in a
    // hidden scope the closure captures as env; the '*' keeps them out of any
    // identifier's way.
    function emitDefaultsEnv(b, plist) {
        var has = false
        for (var i = 0; i < plist.dflts.length; i++) {
            if (plist.dflts[i] != null) { has = true }
        }
        if (!has) { return {b: b, env: curScopeV} }
        var env = callExt(b, "js_scope_new", [curScopeV])
        for (var i = 0; i < plist.dflts.length; i++) {
            if (plist.dflts[i] == null) { continue }
            var r = plist.dflts[i](b)
            b = r.b
            callExt(b, "js_scope_decl", [env, emitStr(b, "dflt*" + plist.params[i]), r.v])
        }
        return {b: b, env: env}
    }
    // A def pushes {dname, dstmt}: the name is what a decorator chain rebinds.
    // js_pyfnname remembers it on the closure so f.__name__ can answer.
    function makeDef(bodyT, plist, name, pos) {
        return {dname: name, dstmt: function(b) {
            var idx = emitClosure(plist, bodyT, false)
            var er = emitDefaultsEnv(b, plist)
            b = er.b
            var isGen = genClosure
            var clo = callExt(b, "js_closure", [handle(idx), er.env])
            // A body with a yield in it is a generator FUNCTION: calling it makes a
            // generator instead of running the body.
            if (isGen) { clo = callExt(b, "js_genfn", [clo]) }
            clo = emitSig(b, clo, plist)
            clo = callExt(b, "js_pyfnname", [clo, emitStr(b, name)])
            callExt(b, "js_pyset_var", [curScopeV, emitStr(b, name), clo])
            return b
        }}
    }
    // class NAME(bases): the bases are evaluated, the class object is built (its
    // MRO with them), the body runs in a scope of its own and js_pyclass_fill
    // turns everything that scope bound into a class member.
    function makeClass(items, pos) {
        var name = anytype
        var bases = []
        var bodyT = anytype
        for (var i = 0; i < items.length; i++) {
            if (items[i].cname != undefined) { name = items[i].cname }
            else if (items[i].cbase != undefined) { bases.push(items[i].cbase) }
            else { bodyT = items[i] }
        }
        return {dname: name, dstmt: function(b) {
            var basesV = callExt(b, "js_arr_new", [])
            for (var j = 0; j < bases.length; j++) {
                var rb = bases[j](b)
                b = rb.b
                callExt(b, "js_arr_push", [basesV, rb.v])
            }
            var cls = callExt(b, "js_pyclass_new", [emitStr(b, name), basesV])
            var saved = curScopeV
            curScopeV = callExt(b, "js_scope_new", [saved])
            // A class body is a namespace of its own: what it binds becomes a
            // class member and never leaks into the scope around it.
            callExt(b, "js_pyfnscope", [curScopeV])
            var bodyScope = curScopeV
            b = bodyT(b)
            callExt(b, "js_pyclass_fill", [cls, bodyScope])
            curScopeV = saved
            callExt(b, "js_pyset_var", [curScopeV, emitStr(b, name), cls])
            return b
        }}
    }
    // @deco1 @deco2 def f(): the definition runs, then the decorators are applied
    // bottom-up (the one nearest the def first) and the result rebinds the name.
    function makeDecorated(items) {
        var decos = []
        var target = anytype
        for (var i = 0; i < items.length; i++) {
            if (items[i].deco != undefined) { decos.push(items[i].deco) }
            else { target = items[i] }
        }
        return function(b) {
            b = target.dstmt(b)
            for (var j = decos.length - 1; j >= 0; j--) {
                var rd = decos[j](b)
                b = rd.b
                var cur = callExt(b, "js_scope_get", [curScopeV, emitStr(b, target.dname)])
                var av = callExt(b, "js_arr_new", [])
                callExt(b, "js_arr_push", [av, cur])
                callExt(b, "js_pyset_var", [curScopeV, emitStr(b, target.dname),
                                            callExt(b, "js_pycall", [rd.v, av, hUndef])])
            }
            return b
        }
    }

    // global NAME: js_pyglobal binds NAME in the root scope if missing, so a
    // later js_pyset_var lands there. nonlocal NAME: js_pynonlocal requires an
    // enclosing non-root binding (a runtime error otherwise).
    function makeGlobal(names, pos) {
        return function(b) {
            for (var i = 0; i < names.length; i++) {
                callExt(b, "js_pyglobal", [curScopeV, emitStr(b, names[i])])
            }
            return b
        }
    }
    function makeNonlocal(names, pos) {
        return function(b) {
            for (var i = 0; i < names.length; i++) {
                callExt(b, "js_pynonlocal", [curScopeV, emitStr(b, names[i])])
            }
            return b
        }
    }

    // lambda: an own IR function like def, but the body is a single expression
    // whose value is returned; the lambda expression's value is the closure.
    function makeLambda(exprT, plist, pos) {
        return function(b) {
            var idx = emitClosure(plist, function(fb) {
                var r = exprT(fb)
                return retStmt(r.b, r.v)
            }, false)
            var er = emitDefaultsEnv(b, plist)
            var lb = er.b
            var clo = callExt(lb, "js_closure", [handle(idx), er.env])
            return {b: lb, v: emitSig(lb, clo, plist)}
        }
    }

    // A one- or two-argument builtin that is exactly one extern: bind NAME to a
    // small IR function forwarding its arguments to EXT.
    function declBuiltin(b, name, ext, argc) {
        funcCount++
        var idx = funcCount
        var f = m.NewFunc("jsf_" + idx, i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var fb = f.NewBlock("entry")
        if (argc == 0) { // The whole argument array (max/min take any number).
            fb.NewRet(fb.NewCall(getExtern(ext, 1), [f.Params[1]]))
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, name),
                                         callExt(b, "js_closure", [handle(idx), curScopeV])])
            return b
        }
        var a0 = fb.NewCall(getExtern("js_arg", 2), [f.Params[1], handle(0)])
        if (argc == 1) { fb.NewRet(fb.NewCall(getExtern(ext, 1), [a0])) }
        else {
            var a1 = fb.NewCall(getExtern("js_arg", 2), [f.Params[1], handle(1)])
            fb.NewRet(fb.NewCall(getExtern(ext, 2), [a0, a1]))
        }
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, name),
                                     callExt(b, "js_closure", [handle(idx), curScopeV])])
        return b
    }

    // jsmain: declare the builtins, then run the file top to bottom.
    function buildMain(items) {
        // The walk of an imported file ends here too: stash its statements for
        // the real jsmain instead of emitting a second one.
        if (importDepth > 0) {
            stashImported(items) // stashed with its file; emitted later (compile-core)
            return
        }
        var f = m.NewFunc("jsmain", i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        curF = f
        var b = f.NewBlock("entry")
        curScopeV = callExt(b, "js_scope_new", [f.Params[0]])
        // The module top level is a binding boundary too, so a global name never
        // reaches past it into the host runtime's own scope.
        callExt(b, "js_pyfnscope", [curScopeV])
        // print(...): hand the argument array to the Python renderer.
        funcCount++
        var prIdx = funcCount
        var pf = m.NewFunc("jsf_" + prIdx, i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var pb = pf.NewBlock("entry")
        pb.NewCall(getExtern("js_pyprint", 1), [pf.Params[1]])
        pb.NewRet(hUndef)
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "print"), callExt(b, "js_closure", [handle(prIdx), curScopeV])])
        // len(x): strings, lists and dicts via js_pylen.
        funcCount++
        var lenIdx = funcCount
        var lf = m.NewFunc("jsf_" + lenIdx, i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var lb = lf.NewBlock("entry")
        var lArg = lb.NewCall(getExtern("js_arg", 2), [lf.Params[1], handle(0)])
        lb.NewRet(lb.NewCall(getExtern("js_pylen", 1), [lArg]))
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "len"), callExt(b, "js_closure", [handle(lenIdx), curScopeV])])
        // list(x): a fresh list from any iterable, via js_pylist.
        funcCount++
        var listIdx = funcCount
        var tf = m.NewFunc("jsf_" + listIdx, i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var tb = tf.NewBlock("entry")
        var tArg = tb.NewCall(getExtern("js_arg", 2), [tf.Params[1], handle(0)])
        tb.NewRet(tb.NewCall(getExtern("js_pylist", 1), [tArg]))
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "list"), callExt(b, "js_closure", [handle(listIdx), curScopeV])])
        // range(a[, b])
        funcCount++
        var rgIdx = funcCount
        var rf = m.NewFunc("jsf_" + rgIdx, i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var rb = rf.NewBlock("entry")
        var rA = rb.NewCall(getExtern("js_arg", 2), [rf.Params[1], handle(0)])
        var rB = rb.NewCall(getExtern("js_arg", 2), [rf.Params[1], handle(1)])
        rb.NewRet(rb.NewCall(getExtern("js_pyrange", 2), [rA, rB]))
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "range"), callExt(b, "js_closure", [handle(rgIdx), curScopeV])])
        // abs from Math.
        var mathV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, "Math")])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "abs"), callExt(b, "js_get", [mathV, emitStr(b, "abs")])])
        // type(v), str(v), int(v) and isinstance(v, C).
        b = declBuiltin(b, "type", "js_pytype", 1)
        // The `re` module. `import re` binds no module object in this flat import
        // model, so the module is an ordinary global holding the flag constants:
        // js_pygetattr reads re.I / re.DOTALL straight out of it, and js_pyrxmcall
        // dispatches re.search(...) on it (abnf/jsrtregexpy.go).
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "re"), callExt(b, "js_pyre_module", [])])
        b = declBuiltin(b, "str", "js_pyrxstr", 1)
        b = declBuiltin(b, "int", "js_pyint", 1)
        b = declBuiltin(b, "isinstance", "js_pyisinst", 2)
        b = declBuiltin(b, "dict", "js_pydict", 1)
        b = declBuiltin(b, "max", "js_pymax", 0)
        b = declBuiltin(b, "min", "js_pymin", 0)
        // The builtin exception hierarchy, as REAL Python classes: Exception with
        // an __init__ that stores its arguments in .args, and the concrete types
        // deriving from it - so `class AppError(Exception)` and
        // `isinstance(e, AppError)` are the ordinary class machinery, not a
        // special case. (js_pyexc, the older {__class, args} shortcut, is still
        // what the interpreter grammar uses.)
        funcCount++
        var eiIdx = funcCount
        var ef = m.NewFunc("jsf_" + eiIdx, i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var eb = ef.NewBlock("entry")
        var eSelf = eb.NewCall(getExtern("js_arg", 2), [ef.Params[1], handle(0)])
        var eRest = eb.NewCall(getExtern("js_pyrest", 2), [ef.Params[1], handle(1)])
        eb.NewCall(getExtern("js_set", 3), [eSelf, emitStr(eb, "args"), eRest])
        eb.NewRet(hUndef)
        var excBase = callExt(b, "js_pyclass_new", [emitStr(b, "Exception"), callExt(b, "js_arr_new", [])])
        callExt(b, "js_set", [excBase, emitStr(b, "__init__"),
                              callExt(b, "js_closure", [handle(eiIdx), curScopeV])])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "Exception"), excBase])
        var excNames = ["ValueError", "TypeError", "KeyError", "IndexError", "RuntimeError",
                        "ZeroDivisionError", "AttributeError", "NameError", "UnboundLocalError",
                        "StopIteration", "ArithmeticError", "LookupError", "OSError", "ExceptionGroup"]
        for (var e0 = 0; e0 < excNames.length; e0++) {
            var eBases = callExt(b, "js_arr_new", [])
            callExt(b, "js_arr_push", [eBases, excBase])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, excNames[e0]),
                                         callExt(b, "js_pyclass_new", [emitStr(b, excNames[e0]), eBases])])
        }
        b = emitImported(b)
        b = makeSeq(items)(b)

        // A module that defines a top-level main() (every ratchet file does) is run for
        // its definitions and then ENTERED through it, and its return value becomes the
        // exit status. Without this the module top level - which only defines functions -
        // would run to completion and exit 0 while executing none of the checks.
        //
        // Whether main() exists is a runtime question here (the top level may bind it
        // any way it likes), so the test is emitted: js_scope_typeof answers "undefined"
        // for a name that is not bound anywhere instead of raising, which is exactly what
        // makes it safe to ask about a name that may not exist. A script without a main()
        // has already done its work top to bottom and simply returns.
        var entry = c.mainName
        if (entry == undefined || entry == "") { entry = "main" }
        var tv = callExt(b, "js_scope_typeof", [curScopeV, emitStr(b, entry)])
        var isFn = emitBin(b, "==", tv, emitStr(b, "function"))
        var callB = curF.NewBlock("")
        var skipB = curF.NewBlock("")
        var mergeB = curF.NewBlock("")
        b.NewCondBr(truthy(b, isFn), callB, skipB)
        var mainV = callExt(callB, "js_scope_get", [curScopeV, emitStr(callB, entry)])
        var retV = callExt(callB, "js_call", [mainV, hUndef, callExt(callB, "js_arr_new", [])])
        callB.NewBr(mergeB)
        skipB.NewBr(mergeB)
        mergeB.NewRet(mergeB.NewPhi([llvm.ir.NewIncoming(retV, callB),
                                     llvm.ir.NewIncoming(hUndef, skipB)]))
    }

    // ----- Core library config (see lib/compile-core.js) -----
    core.truthyExt = "js_pytruthy" // Python truthiness: empty containers are false.
    // Python stdlib modules the runtime provides (prefix match, so os.path
    // resolves against "os").
    core.stdlibImports = ["sys", "os", "math", "collections", "itertools", "functools", "re", "json", "typing", "random", "string", "time", "dataclasses", "abc"]
    // Project-file imports: 'import mypkg.helper' / 'from mypkg.helper import x'
    // look for mypkg/helper.py, then mypkg.py under the program's directory and
    // the -i roots (c.findImport). The file is parsed with this grammar and
    // walked with the same tags: its statements are stashed by buildMain
    // (importDepth > 0) and prepended to jsmain, so the module top level runs
    // before the main file's code. A file is imported once; repeats and cycles
    // are no-ops. Deviation from real Python: the module's top-level names bind
    // directly (flat, no module object), so use the from-import style.
    var importedFiles = {}
    var importDepth = 0
    // imported files top-level items: stashImported / emitImported (compile-core)
    core.importFile = function(path, pos) {
        var rel = path.split(".").join("/")
        var cands = [rel + ".py"]
        var cut = -1
        for (var k = 0; k < rel.length; k++) { if (rel.charAt(k) == "/") { cut = k } }
        if (cut > 0) { cands.push(rel.substring(0, cut) + ".py") }
        for (var i = 0; i < cands.length; i++) {
            var file = c.findImport(cands[i])
            if (file == "") { continue }
            if (importedFiles["$" + file] == true) { return true }
            importedFiles["$" + file] = true
            var text = c.readFile(file)
            var asg = c.parse(c.agrammar, text, null, file)
            c.pushSource(file, text)
            importDepth = importDepth + 1
            c.compile(asg)
            importDepth = importDepth - 1
            c.popSource()
            return true
        }
        return false
    }

    c.compile(c.asg)

    println(m)

    var res = llvm.RunJS(m, "jsmain")
    println("python compiler: program ran to completion")
    exit(res.Ret)

~~) ;
