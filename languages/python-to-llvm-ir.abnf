                                              callExt(fb, "js_arg", [f.Params[1], handle(params.length + 1)])])
            }
        } else if (rest != null) {
            callExt(fb, "js_scope_decl", [curScopeV, emitStr(fb, rest),
                                          callExt(fb, "js_pyrest", [f.Params[1], handle(params.length)])])
        }
