    pyUniNames["$DEGREE SIGN"] = 176
    pyUniNames["$EURO SIGN"] = 8364
    pyUniNames["$GREEK SMALL LETTER ALPHA"] = 945
    pyUniNames["$GREEK CAPITAL LETTER DELTA"] = 916
    pyUniNames["$AMPERSAND"] = 38
    pyUniNames["$LEFT CURLY BRACKET"] = 123
    pyUniNames["$RIGHT CURLY BRACKET"] = 125
    pyUniNames["$EXCLAMATION MARK"] = 33
    pyUniNames["$LATIN SMALL LETTER A WITH DIAERESIS"] = 228
    pyUniNames["$GREEK SMALL LETTER PI"] = 960
