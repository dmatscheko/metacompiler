    // builds the value the complex arithmetic in js_pybin and the .real / .imag
    // reads understand.
    function makeImagLit(t) {
        var txt = numText(t)
        var im = parseFloat(txt.substring(0, txt.length - 1))
        return function(b) {
            return {b: b, v: callExt(b, "js_pycomplex", [emitNum(b, 0), emitNum(b, im)])}
        }
    }

    // Python truthiness for branches.
    // ----- Expression thunks: function(block) -> {b, v} -----

    makeNeg = function(t) {
        return function(b) {
            var r = t(b)
            return {b: r.b, v: callExt(r.b, "js_pyunary", [emitStr(r.b, "-"), r.v])}
        }
