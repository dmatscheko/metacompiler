    // emitted exactly once and its value reused as the left side of the next link.
    // The chain short-circuits: as soon as a link is false the result is that false
    // value and the remaining operands are never evaluated - which is why every link
    // after the first needs its own block and the whole thing ends in a phi.
    function makeCompare(items) {
        if (items.length == 1) { return items[0] }
        return function(b) {
            var r = items[0](b)
