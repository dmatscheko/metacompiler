            var gB = pySetVarF.NewBlock("global")
            var notG = pySetVarF.NewBlock("notglobal")
            var nB = pySetVarF.NewBlock("nonlocal")
            var notN = pySetVarF.NewBlock("notnonlocal")
            var innerB = pySetVarF.NewBlock("inner")
            var declB = pySetVarF.NewBlock("declare")
