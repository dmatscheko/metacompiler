    // conversion function in Python, it is the class - so `type(1) == int` and
    // `isinstance("a", str)` are True, and both were FALSE under this compiler
    // while the interpreter said True (six for six), because declBuiltin bound the
    // name to the conversion CLOSURE and the class object was reachable only
    // through type(). Now the name holds js_pybuiltincls's stable class object -
    // the very object type() answers with - and the conversion closure rides on it
    // as __conv, which js_pycall calls when a class object carrying one is called.
    // That way CALLING the name still runs the same IR function it always did and
    // nothing about the call path changes shape; only the value the NAME holds
    // does. rt.pyIsInstance already accepted a builtin class object as its target.
    var pyTypeBuiltin = {}
    pyTypeBuiltin["$str"] = true
    pyTypeBuiltin["$int"] = true
    pyTypeBuiltin["$float"] = true
    pyTypeBuiltin["$bool"] = true
    pyTypeBuiltin["$list"] = true
    pyTypeBuiltin["$dict"] = true
    pyTypeBuiltin["$set"] = true
    pyTypeBuiltin["$tuple"] = true
