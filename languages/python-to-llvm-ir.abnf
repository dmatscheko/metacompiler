    // run folds to one constant at compile time; a run holding an f-string becomes a
    // chain of js_jadd.
    function makeStrConcat(items) {
        if (items.length == 1 && items[0].bytes != undefined) { return makeBytes(items[0].bytes) }
        var allConst = true
        for (var i = 0; i < items.length; i++) { if (items[i].str == undefined) { allConst = false } }
        if (allConst) {
            var lit = ""
            for (var k = 0; k < items.length; k++) { lit += items[k].str }
            return makeConst(lit)
        }
        return function(b) {
            var v = emitStr(b, "")
            for (var j = 0; j < items.length; j++) {
                var it = items[j]
                if (it.str != undefined) { v = callExt(b, "js_jadd", [v, emitStr(b, it.str)]) }
                else if (it.bytes != undefined) {
                    var rb = makeBytes(it.bytes)(b)
                    b = rb.b
                    v = callExt(b, "js_jadd", [v, callExt(b, "js_pyrxstr", [rb.v])])
                } else {
                    var r = it(b)
                    b = r.b
                    v = callExt(b, "js_jadd", [v, r.v])
                }
            }
            return {b: b, v: v}
        }
    }
    // items = [{chunk: text} | field thunk, ...] -> the f-string value, built by
    // concatenating the literal chunks and the rendered replacement fields.
    function makeFString(items) {
        return function(b) {
            var v = emitStr(b, "")
            for (var i = 0; i < items.length; i++) {
                var it = items[i]
                if (typeof it == "function") {
                    var r = it(b)
                    b = r.b
                    v = callExt(b, "js_jadd", [v, r.v])
                } else {
                    v = callExt(b, "js_jadd", [v, emitStr(b, fixBraces(it.chunk))])
                }
            }
            return {b: b, v: v}
        }
    }
    function fixBraces(t) { return t.split("{{").join("{").split("}}").join("}") }
    // One replacement field: {expr[=][!conv][:spec]}. The `=` debug form prepends the
    // SOURCE TEXT of the expression (which is why the rule hands its whole span over)
    // and switches the default conversion to repr. A format spec is rendered by
    // js_pyformat, which implements the format mini-language on the runtime side
    // (the value is only known there).
    function makeFField(items, srcText) {
        var exprT = null
        var spec = null
        var conv = null
        var debug = false
        for (var i = 0; i < items.length; i++) {
            var it = items[i]
            if (typeof it == "function") { if (exprT == null) { exprT = it } }
            else if (it.fdebug != undefined) { debug = true }
            else if (it.fconv != undefined) {
                conv = stripWs(it.fconv)
                if (conv.charAt(0) == "!") { conv = conv.substring(1) }
            }
            else if (it.fspec != undefined) { spec = it.fspec }
        }
        // The debug prefix: everything between `{` and the `=`, then the `=` and the
        // whitespace that followed it - Python reproduces the spacing exactly.
        var prefix = ""
        if (debug) {
            var eq = srcText.indexOf("=")
            if (eq > 0) {
                prefix = srcText.substring(1, eq) + "="
                var j = eq + 1
                while (j < srcText.length && (srcText.charAt(j) == " " || srcText.charAt(j) == "\t")) {
