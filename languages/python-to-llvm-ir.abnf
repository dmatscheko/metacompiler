    // len counts code points again, so len of a single astral character is 1.
    function codePoint(n) {
        if (n <= 65535) { return String.fromCharCode(n) }
        var v = n - 65536
        return String.fromCharCode(55296 + (v >> 10)) + String.fromCharCode(56320 + (v & 1023))
    }
