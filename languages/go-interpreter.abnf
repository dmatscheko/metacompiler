Call        <~~ var ci = goAppendC(takeAll(), up.in); push(makeCall(goCallBoxC(ci), goSplitArgs(ci.slice(1)).atys)) ~~>
            = Id <~~ push(up.in) ~~> "(" [ ArgExpr { "," ArgExpr } [ Spread ] [ "," ] ] ")" ;
// A call argument reports its static type after it, for goSplitArgs.
ArgExpr     <~~ var ae = pop(); push(goRuneDefC(ae, up.pos)); push({aty: stAt(up.pos), kr: goKRec(up.start, up.pos)}) ~~> = Expression ;
// A returned value, which takes a rune constant at the RESULT's type (makeReturn).
RetExpr     <~~ var re = pop(); push(re); push({aty: stAt(up.pos), rn: goIsRuneC(up.pos), kr: goKRec(up.start, up.pos)}) ~~> = Expression ;

// KeyAhead answers "is this composite-literal element keyed?" - is there a ':' before
// the element's ',' or the closing '}' at bracket depth 0. Like InitAhead it decides
// before anything is pushed, so an unkeyed element leaks nothing.
KeyAhead = :script(~~
    (function () {
        var i = 0
        var depth = 0
        var cc = 0
        while (i < 8192) {
            cc = c.peek(i)
            if (cc < 0) { break }
            if (cc === 34 || cc === 39 || cc === 96) {
                var q = cc
                i++
                while (i < 8192) {
                    var d = c.peek(i)
                    if (d < 0 || d === q) { break }
                    if (d === 92 && q !== 96) { i++ }
                    i++
                }
                i++
                continue
            }
            if (cc === 47 && c.peek(i + 1) === 47) {
                while (i < 8192 && c.peek(i) >= 0 && c.peek(i) !== 10) { i++ }
                continue
            }
            if (cc === 40 || cc === 91 || cc === 123) { depth++ }
            if (cc === 41 || cc === 93 || cc === 125) {
                if (depth === 0) { break }
                depth--
            }
            if (depth === 0 && cc === 44) { break }
            if (depth === 0 && cc === 58) { return undefined }
            i++
        }
        return abnf.newToken("\x01unkeyed-element", 0)
    })()
~~) ;

VarRef      <~~ push(goNameC(up.in, up.pos)) ~~>
            = Id ;

// The composite literal gate: while an if/for header is being parsed (CondOn pushed
// a marker on the parser stack), StructGate fails, so 'if ok {' never starts a literal.
CondOn = :script(~~
    push("$nostruct")
    undefined
~~) ;
CondOff = :script(~~
    (function() {
        // Pop down to THIS header's own marker, so a parenthesised group that failed
        // half way (see ParenGroup) cannot leave the gate stack out of step.
        var t = pop()
        while (t != null && t != "$nostruct") { t = pop() }
        return undefined
