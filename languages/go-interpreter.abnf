MethodSfx   <~~ push(makeMethodSfx(popName(), takeAll(), up.start)) ~~>
            = "." Id <~~ push({mname: up.in}) ~~> "(" [ ArgExpr { "," ArgExpr } [ Spread ] [ "," ] ] ")" ;
FieldSfx    <~~ push({kind: "field", name: pop().fname, at: up.start, rc: null, dt: null, dtk: false, me: "", pkg: curPkgName}) ~~>
            = "." Id <~~ push({fname: up.in}) ~~> ;
SliceSfx    <~~ push(makeSliceSfx(takeAll(), up.start)) ~~>
            = "[" [ Expression <~~ push({lo: pop(), sk: goKRec(up.start, up.pos)}) ~~> ] ":"
              [ Expression <~~ push({hi: pop(), sk: goKRec(up.start, up.pos)}) ~~> ]
