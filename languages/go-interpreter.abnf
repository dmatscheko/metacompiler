// 017: the LEGACY octal form, which has no base letter - 017 is 15, not 17. Tried
// after the 0x/0o/0b forms and before the decimal ones, and it needs at least one
// octal digit after the 0 so that a plain "0" stays an integer literal.
LegOctLit   <~~ push(makeConst(parseLegOct(up.in))) ~~>
            = "0" :whitespace() OctSep { OctSep } :whitespace(Whitespace) ;
// A named production on purpose: a :command() directly followed by a (group) parses
// as a Times repetition in this dialect - the Times trap.
OctSep      = "0"..."7" | "_" ;
FloatLit    <~~ push(makeConst(gFlo(parseFloat(up.in)))) ~~>
            = ( "0" | "1"..."9" ) :whitespace() { "0"..."9" }
              ( "." { "0"..."9" } [ ( "e" | "E" ) [ "+" | "-" ] "0"..."9" { "0"..."9" } ]
              | ( "e" | "E" ) [ "+" | "-" ] "0"..."9" { "0"..."9" } ) :whitespace(Whitespace) ;
HexLit      <~~ push(makeConst(parseRadix(up.in))) ~~>
            = "0" ( "x" | "X" ) :whitespace() HexDigits :whitespace(Whitespace) ;
// Go allows the digit separator right after the base prefix, too: 0x_FF_f.
HexDigits   = { "_" } HexDigit { HexDigit | "_" } ;
HexDigit    = "0"..."9" | "a"..."f" | "A"..."F" ;
OctLit      <~~ push(makeConst(parseRadix(up.in))) ~~>
            = "0" ( "o" | "O" ) :whitespace() "0"..."7" { "0"..."7" | "_" } :whitespace(Whitespace) ;
BinLit      <~~ push(makeConst(parseRadix(up.in))) ~~>
            = "0" ( "b" | "B" ) :whitespace() BinDigits :whitespace(Whitespace) ;
BinDigits   = BinDigit { BinDigit | "_" } ;
BinDigit    = "0" | "1" ;
DecULit     <~~ push(makeConst(parseRadix(up.in))) ~~>
            = ( "0" | "1"..."9" ) :whitespace() { "0"..."9" } "_" { "0"..."9" | "_" } :whitespace(Whitespace) ;
RawString   = "`" :whitespace() { "\x00"..."\x5f" | "\x61"..."\U0010ffff" } <~~ push(makeConst(up.in)) ~~> "`" :whitespace(Whitespace) ;
RuneLit     = "'" :whitespace() { StrEsc | SqPlain } <~~ push(makeConst(runeVal(up.in))) ~~> "'" :whitespace(Whitespace) ;

// func(x int) int { ... }: a function literal; a real closure over its scope.
FuncLit     <~~ push(makeFuncLit(takeAll())) ~~>
            = "func" KwEnd ParamList [ RetTypes ] Block ;

MapTypeZ    = "map" KwEnd "[" Type "]" ZType ;
ZType       <~~ push({mzero: up.in}) ~~>
            = Type ;

// new(T): a zero value of T (a pointer to it in Go; our structs are references).
NewCall     <~~ push(makeNew(pop().nty)) ~~>
            = "new" KwEnd "(" NewType ")" ;
// The type has to be captured on its own: up.in of the whole production is
// "new(int)", whose leading word is not a type name.
NewType     <~~ push({nty: firstType(up.in)}) ~~>
            = Type ;

// f(a, b): a function, a builtin or an identifier-named conversion (int(x)). A
// trailing '...' spreads a slice into the variadic parameter.
Call        <~~ push(makeCall(takeAll())) ~~>
            = Id <~~ push(up.in) ~~> "(" [ Expression { "," Expression } [ Spread ] ] ")" ;

// KeyAhead answers "is this composite-literal element keyed?" - is there a ':' before
// the element's ',' or the closing '}' at bracket depth 0. Like InitAhead it decides
// before anything is pushed, so an unkeyed element leaks nothing.
KeyAhead = :script(~~
    (function () {
        var i = 0
        var depth = 0
        var cc = 0
        while (i < 8192) {
            cc = c.peek(i)
            if (cc < 0) { break }
            if (cc === 34 || cc === 39 || cc === 96) {
                var q = cc
                i++
                while (i < 8192) {
                    var d = c.peek(i)
                    if (d < 0 || d === q) { break }
                    if (d === 92 && q !== 96) { i++ }
                    i++
                }
                i++
                continue
            }
            if (cc === 47 && c.peek(i + 1) === 47) {
                while (i < 8192 && c.peek(i) >= 0 && c.peek(i) !== 10) { i++ }
                continue
            }
            if (cc === 40 || cc === 91 || cc === 123) { depth++ }
            if (cc === 41 || cc === 93 || cc === 125) {
                if (depth === 0) { break }
                depth--
            }
            if (depth === 0 && cc === 44) { break }
            if (depth === 0 && cc === 58) { return undefined }
            i++
        }
        return abnf.newToken("\x01unkeyed-element", 0)
    })()
~~) ;

VarRef      <~~ push(makeVarRef(up.in)) ~~>
            = Id ;

// The composite literal gate: while an if/for header is being parsed (CondOn pushed
// a marker on the parser stack), StructGate fails, so 'if ok {' never starts a literal.
CondOn = :script(~~
    push("$nostruct")
    undefined
~~) ;
CondOff = :script(~~
    pop()
    undefined
~~) ;
// InitAhead answers "does this if/switch header carry an init statement?" - i.e. is
// there a ';' before the body's '{' at bracket depth 0. Without it the optional init
// would be ATTEMPTED on a plain header, and its half-parsed pushes are not rolled
// back (see the CondOn note above). TypeSwAhead is the same shape for '.(type)'.
// Both are pure functions of (source, position): they only ever read with c.peek.
InitAhead = :script(~~
    (function () {
        var i = 0
        var depth = 0
        var cc = 0
        while (i < 8192) {
            cc = c.peek(i)
            if (cc < 0) { break }
            if (cc === 34 || cc === 39 || cc === 96) {       // " ' `
                var q = cc
                i++
                while (i < 8192) {
                    var d = c.peek(i)
                    if (d < 0 || d === q) { break }
                    if (d === 92 && q !== 96) { i++ }
                    i++
                }
                i++
                continue
            }
            if (cc === 47 && c.peek(i + 1) === 47) {          // // comment
                while (i < 8192 && c.peek(i) >= 0 && c.peek(i) !== 10) { i++ }
                continue
            }
            if (cc === 47 && c.peek(i + 1) === 42) {          // /* comment
                i += 2
                while (i < 8192 && c.peek(i) >= 0 && !(c.peek(i) === 42 && c.peek(i + 1) === 47)) { i++ }
