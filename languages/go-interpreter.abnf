        // ending where the main file's `7 / 2` operand ends, that division answered 3.5.
        // The named-constant scope goes with them - an import is a different package, and
        // its constants reach this file as pkg.Name, which is a selector and never folds.
        var savedConsts = constByPos
        var savedConvs = convByPos
        var savedScopes = cScopes
        var savedPend = cPend
        var savedSwMarks = cSwMarks
        constByPos = {}
        convByPos = {}
        cScopes = [{n: [], v: []}]
        cPend = []
        cSwMarks = []
        // THE PACKAGE'S OWN GLOBAL NAMESPACE, chained under globalScope. A top-level
        // declaration in this file lands in pkgScope (the interpreter's top level runs
        // as it walks, so setting `scopes` around c.compile is what redirects declVar),
        // and every function declared here closes over [globalScope, pkgScope] through
        // pkgEnv. One scope PER PACKAGE, not per file, so two files of the same package
        // still see each other. docs/todo.md 2.7.
        var pkgScope = pkgScopes["$" + pname]
        if (pkgScope == undefined) { pkgScope = {}; pkgScopes["$" + pname] = pkgScope }
        var savedPkgScope = curPkgScope
        var savedRun = scopes
        curPkgScope = pkgScope
        scopes = [globalScope, pkgScope]
        c.compile(asg)
        scopes = savedRun
        curPkgScope = savedPkgScope
        constByPos = savedConsts
        convByPos = savedConvs
        cScopes = savedScopes
        cPend = savedPend
        cSwMarks = savedSwMarks
        c.popSource()
        curPkgName = savedPkg
        // THE PACKAGE SCOPE IS THE PACKAGE OBJECT. Copying the exported names onto a
        // separate object was what left `mconst.S` at <nil>: only the FUNCTIONS were
        // ever copied (pkgExports collects nothing else), so an exported const or var
        // was unreachable through the qualifier. Binding the scope itself makes every
        // top-level name of the package reachable as pkg.Name, it is LIVE rather than a
        // snapshot (a write to the package's own variable is seen through the
        // qualifier, which is what Go says), and two files of one package share it
        // because pkgScopes is keyed by package rather than by file. The one thing it
        // gives up is that an UNEXPORTED name is reachable through the qualifier too -
        // real Go rejects `mconst.abs` at compile time and this half accepts it, which
        // is an over-acceptance, never a wrong answer. An exported TYPE lives in
        // globalScope (types are one flat table), so those names are copied in.
        var tns = pkgTypes["$" + pname]
        if (tns != undefined) {
            for (var t = 0; t < tns.length; t++) {
                if (hasOwn(globalScope, tns[t])) { scopePut(pkgScope, tns[t], globalScope[tns[t]]) }
            }
        }
        scopePut(pkgScope, "__pkg", true)
        globalScope[pname] = pkgScope
        return true
    }

    c.compile(c.asg)

    // Attach the collected methods to their struct descriptors. The receiver type is
    // found by name: func (p Point) dist() -- recvName pushed [name, type].
    for (var mi = 0; mi < methodTodo.length; mi++) {
        var mm = methodTodo[mi]
        var recvVar = mm.recvName[0]
        var byPtr = mm.recvName.length > 2
        var recvType = mm.recvName[mm.recvName.length - 1]
        var cls = hasOwn(structs, recvType) ? structs[recvType] : undefined
        if (cls == undefined) fail("method receiver type not found: " + recvType)
        cls["__ptr$" + mm.name] = byPtr
        cls[mm.name] = makeMethodClosure({recvName: recvVar, name: mm.name, params: mm.params,
                                          body: mm.body, rets: mm.rets, rtys: mm.rtys, variadic: mm.variadic, byPtr: byPtr,
                                          ptypes: mm.ptypes, env: mm.env})
    }

    function runEntry(f) {
        try {
            return f()
        } catch (e) {
            if (e != undefined && e != null && e.__gopanic == true) {
                // A RUNTIME panic already carries the engine wording (goRTPanic),
                // and the compiler half reports one of those straight from rt.fail
                // with no "uncaught exception" wrapper around it - so wrapping here
                // would put the prefix on twice and diverge. A panic(v) the program
                // wrote gets the wrapper, which is what both halves do for a throw.
                var pv = gstr(e.v)
                if (typeof e.v == "string" && e.v.indexOf("js runtime error: ") == 0) { println(pv) }
                else { println("js runtime error: uncaught exception: " + pv) }
                exit(1)
            }
            throw e
        }
    }
    // The entry point defaults to main(), but the -main flag (c.mainName) can override it:
    // a bare identifier names a top-level function to call, anything with a '(' is a Go
    // snippet parsed and run in the program's scope (see runMainSnippet).
    var entry = c.mainName
    if (entry == undefined || entry == "") { entry = "main" }
    var ret = anytype
    if (mainIsSnippet(entry)) {
        ret = runMainSnippet(entry, "Statement")
        println("go interpreter: -main snippet returned " + (ret === undefined ? 0 : ret))
    } else {
        if (typeof globalScope[entry] != "function") {
            fail("Go programs need a func " + entry + "().")
        }
        // AN UNRECOVERED PANIC IS A PROGRAM RESULT, not a host error. Without this
        // it escaped as the raw {__gopanic} marker and the engine printed
        // `[object Object]` - which was already true of `panic("boom")` and became
        // reachable from ordinary code once an out of range index started panicking
        // (docs/todo.md 1.9). The wording is the compiler half's, which is
        // languages/lib/runtime.c's and abnf/jsrt.go's for every uncaught throw, so
        // ./test.sh --cross (which compares stderr too) sees one line in both.
        ret = runEntry(globalScope[entry])
        println("go interpreter: " + entry + "() returned " + (ret === undefined ? 0 : ret))
    }
    exit(ret === undefined ? 0 : ret | 0)

~~) ;
