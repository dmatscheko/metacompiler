OctSep      = "0"..."7" | "_" ;
FloatLit    <~~ push(goFloLitC(up.in, up.pos)) ~~>
            = ( "0" | "1"..."9" ) :whitespace() { "0"..."9" }
              ( "." { "0"..."9" } [ ( "e" | "E" ) [ "+" | "-" ] "0"..."9" { "0"..."9" } ]
