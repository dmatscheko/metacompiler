StrLitT     <~~ regSt(up.pos, "string") ~~> = DqString | RawString ;
BoolLitT    <~~ regSt(up.pos, "bool") ~~> = True | False ;

Primary     = ParenConv | ParenGroup | ImagLit | DotFloatLit | HexFloatLit | FloatLit | HexLit | OctLit
