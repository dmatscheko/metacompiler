            else { for (var k = 0; k < rl.length; k++) { setVar(rl[k], res.v[k]) } }
        }
        runDefers(frame)
        if (panicking) {
            panicking = false
            var pv = panicVal
            panicVal = null
            scopes = saved
            throw {__gopanic: true, v: pv}
        }
        if (rl.length > 0) {
            if (rl.length == 1) { out = getVar(rl[0]) }
            else {
                var vs = []
                for (var m = 0; m < rl.length; m++) { vs.push(getVar(rl[m])) }
                out = vs
            }
        }
        scopes = saved
        return out
    }

    // ----- Core library config (see lib/interp-core.js) -----
    core.lang = "go"
    core.blank = "_"
    // Go stdlib packages the runtime provides (resolveImport lives in lib/interp-core.js;
    // exact-match paths, so sub-packages like "encoding/json" are listed in full).
    core.stdlibImports = ["fmt", "os", "strings", "strconv", "math", "sort", "errors", "bufio", "io", "time", "sync", "bytes", "unicode", "regexp", "path", "encoding/json", "context", "flag", "log", "reflect"]
    core.nullWord = "nil"
    core.getIndex = function(o, i) { return goIndex(o, i) }
    core.framePush = function() { deferFrames.push([]) }
    core.framePop = function() { runDefers(deferFrames.pop()) }

    // ----- Project-file imports: import "mathbox" -> mathbox.go -----
    // A non-stdlib import maps to a single .go file (a slash path like "a/b" -> a/b.go),
    // searched under the program's directory and the -i roots. The file is parsed with this
    // grammar and walked with the same tags, so its funcs, structs and package-level vars
    // register in globalScope exactly like the main file's - which is what lets the package
    // call its OWN names unqualified, and cross-file value.Method() dispatch work (methods
    // attach to their struct after the whole compile, via methodTodo). On top of that the
    // file's exported (capitalized) functions are gathered onto a package object bound under
    // the import's base name, so the main file reaches them as mathbox.Add(...) through the
    // same member-call path fmt.Println takes. A file is imported once; repeats and cycles
    // are no-ops.
    // The import base name is the conventional package qualifier ("a/b" -> "b").
    function pkgBaseName(path) {
        var cut = -1
        for (var k = 0; k < path.length; k++) { if (path.charAt(k) == "/") { cut = k } }
        return cut >= 0 ? path.substring(cut + 1) : path
    }
    // Go visibility: an identifier is exported exactly when it starts with an upper-case
    // letter.
    function isExported(name) {
        if (name.length == 0) { return false }
        var c0 = name.charCodeAt(0)
        return c0 >= 65 && c0 <= 90
    }
    core.importFile = function(path, pos) {
        var file = c.findImport(path + ".go")
        if (file == "") { return false }
        if (importedFiles["$" + file] == true) { return true }
        importedFiles["$" + file] = true
        var pname = pkgBaseName(path)
        if (pkgExports["$" + pname] == undefined) { pkgExports["$" + pname] = [] }
        var text = c.readFile(file)
        var asg = c.parse(c.agrammar, text, null, file)
        var savedPkg = curPkgName
        curPkgName = pname
        c.pushSource(file, text)
        c.compile(asg)
        c.popSource()
        curPkgName = savedPkg
        // Assemble (or extend) the package object from the exported functions just added
        // to globalScope, and bind it under the package name (like a stdlib object).
        var names = pkgExports["$" + pname]
        var existing = globalScope[pname]
        var obj = (existing != undefined && existing != null && existing.__pkg == true) ? existing : {__pkg: true}
        for (var i = 0; i < names.length; i++) { obj[names[i]] = globalScope[names[i]] }
        globalScope[pname] = obj
        return true
    }

    c.compile(c.asg)

    // Attach the collected methods to their struct descriptors. The receiver type is
    // found by name: func (p Point) dist() -- recvName pushed [name, type].
    for (var mi = 0; mi < methodTodo.length; mi++) {
        var mm = methodTodo[mi]
        var recvVar = mm.recvName[0]
        var byPtr = mm.recvName.length > 2
        var recvType = mm.recvName[mm.recvName.length - 1]
        var cls = hasOwn(structs, recvType) ? structs[recvType] : undefined
        if (cls == undefined) fail("method receiver type not found: " + recvType)
        cls["__ptr$" + mm.name] = byPtr
        cls[mm.name] = makeMethodClosure({recvName: recvVar, name: mm.name, params: mm.params,
                                          body: mm.body, rets: mm.rets, variadic: mm.variadic, byPtr: byPtr})
    }

    // The entry point defaults to main(), but the -main flag (c.mainName) can override it:
    // a bare identifier names a top-level function to call, anything with a '(' is a Go
    // snippet parsed and run in the program's scope (see runMainSnippet).
    var entry = c.mainName
    if (entry == undefined || entry == "") { entry = "main" }
    var ret = anytype
    if (mainIsSnippet(entry)) {
        ret = runMainSnippet(entry, "Statement")
        println("go interpreter: -main snippet returned " + (ret === undefined ? 0 : ret))
    } else {
        if (typeof globalScope[entry] != "function") {
            fail("Go programs need a func " + entry + "().")
        }
        ret = globalScope[entry]()
        println("go interpreter: " + entry + "() returned " + (ret === undefined ? 0 : ret))
    }
    exit(ret === undefined ? 0 : ret | 0)

~~) ;
