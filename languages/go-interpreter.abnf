// Only the BARE-NAME form is ambiguous with an if/for/switch body, so only it is
// gated ('for _, v := range []any{...} {' is legal Go and must keep working).
CompType    = CompSlice | CompArray | CompMapT | CompStructT | GatedNamed ;
GatedNamed  = StructGate CompNamed ;
CompSlice   <~~ push({ckind: "slice", cet: pop().cet}) ~~>
            = "[" "]" CompElemT ;
CompArray   <~~ push(makeArrDesc(takeAll())) ~~>
            = "[" ( "..." | Expression ) "]" CompElemT ;
CompMapT    <~~ push({ckind: "map", czero: pop().mzero}) ~~>
            = MapTypeZ ;
CompNamed   <~~ push({ckind: "struct", cname: typeBaseName(up.in)}) ~~>
            = NamedType ;
CompElemT   <~~ push({cet: firstType(up.in)}) ~~>
            = Type ;
// An anonymous struct type carries its own field list.
CompStructT <~~ push({ckind: "anon", cfields: takeAll()}) ~~>
            = "struct" KwEnd "{" { AnonField } "}" ;
AnonField   = Id <~~ push(up.in) ~~> { "," Id <~~ push(up.in) ~~> } Type [ FieldTag ] [ ";" ] ;

CompBody    <~~ push({celems: takeAll()}) ~~>
            = "{" [ CompElem { "," CompElem } [ "," ] ] "}" ;
CompElem    <~~ push(makeCompElem(takeAll())) ~~>
            = [ KeyAhead CompKey ] CompValue ;
CompKey     <~~ push({ckey: pop(), ktext: firstWord(up.in)}) ~~>
            = Expression ":" ;
CompValue   = CompNested | Expression ;
CompNested  <~~ push({cnested: pop()}) ~~>
            = CompBody ;

// make(T) / make(T, n) / make(T, n, cap): a map, a slice or a channel.
MakeCall    <~~ push(makeMakeCall(takeAll())) ~~>
            = "make" KwEnd "(" MakeType [ "," Expression ] [ "," Expression ] ")" ;
MakeType    = MakeMapT | MakeSliceT | MakeChanT ;
MakeMapT    <~~ push({mkind: "map", czero: pop().mzero}) ~~> = MapTypeZ ;
MakeSliceT  <~~ push({mkind: "slice", cet: pop().cet}) ~~> = "[" "]" CompElemT ;
// The ELEMENT type comes along: a receive from a closed, drained channel yields it
// zero-valued (`v, open := <-ch` with open false).
MakeChanT   <~~ push({mkind: "chan", czero: pop().cet}) ~~>
            = ( "chan" KwEnd [ "<-" ] | "<-" "chan" KwEnd ) CompElemT ;

// A conversion whose target type is written out: []byte(s), []rune(s), map[K]V(x)
// and the PREDECLARED scalar spellings int(x), float64(n), uint8(b), ... The scalar
// forms would also work as ordinary calls (the names are bound in hostGlobals), but
// matching them here makes the target type known at BUILD time, which is what gives
// float64(i)/2 a float division and ^uint8(x) an eight bit complement. A conversion
// to a user-defined type still goes through Call. Longest spelling first: this is a
// PEG, so "uint" matching the front of "uint16" would never be retried.
ConvExpr    <~~ push(makeConv(takeAll(), up.pos)) ~~>
            = ConvType "(" Expression [ "," ] ")" ;
ConvType    <~~ push({conv: firstType(up.in)}) ~~>
            = "[" "]" Type | ScalarType KwEnd ;
ScalarType  = "uintptr" | "float32" | "float64" | "uint16" | "uint32" | "uint64"
            | "int16" | "int32" | "int64" | "uint8" | "int8" | "byte" | "rune"
            | "uint" | "int" ;

// iota: the index of the current spec inside a const group (0 outside one).
Iota        <~~ push(makeIota()) ~~> = "iota" KwEnd ;

// nil is the null value (structs, slices, maps and pointers share one). Tried before
// VarRef so it is not read as an undefined identifier.
Nil         <~~ push(makeConst(null)) ~~> = "nil" KwEnd ;

// Go literal forms the shared token library does not carry. A float needs a fraction
// or an exponent (a plain integer keeps going through IntLit); hex/octal/binary literals
// and digit-group underscores parse to their integer value; a raw string keeps its bytes
// verbatim; a rune literal is its first code point (an int).
// 2i / 2.5i / 1e3i: an IMAGINARY literal, so the value is complex. Tried before every
// other numeric form - all of them match its digits and would leave the 'i' behind as
// an identifier. The KwEnd keeps it off the front of a name (2int is not 2i).
ImagLit     <~~ push(makeConst(newCx(0, parseImag(up.in)))) ~~>
            = ( "0" | "1"..."9" ) :whitespace() { "0"..."9" | "_" }
              [ "." { "0"..."9" } ] [ ImagExp ] "i" KwEnd :whitespace(Whitespace) ;
ImagExp     = ( "e" | "E" ) [ "+" | "-" ] "0"..."9" { "0"..."9" } ;
DotFloatLit <~~ push(makeConst(gFlo(parseFloat("0" + up.in)))) ~~>
            = "." :whitespace() "0"..."9" { "0"..."9" }
              [ ( "e" | "E" ) [ "+" | "-" ] "0"..."9" { "0"..."9" } ] :whitespace(Whitespace) ;
// 0x1p4 / 0x1.8p1: a HEX float. The 'p' exponent is decimal and scales by a power of
// TWO, and it is mandatory - without it the same text is the hex integer above.
HexFloatLit <~~ push(makeConst(gFlo(parseHexFloat(up.in)))) ~~>
