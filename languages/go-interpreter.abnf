IndexSfx    <~~ var ikm = pop(); push({kind:"index", idx: pop(), ksty: ikm.ksty, kk: ikm.kr, at: up.start, rc: null}) ~~>
            = "[" IdxE "]" ;
CallSfx     <~~ push(makeCallSfx(takeAll())) ~~>
