:startScript(~~

    // Shared interpreter machinery (scopes, BRK/CONT protocol, expression and
    // statement builders); language-specific behavior is configured on `core` below.
    include("lib/interp-core.js")

    // ----- Project-file import state (see core.importFile near the core config) -----
    var importedFiles = {}  // "$" + absolute file path -> already imported (once only)
    var pkgExports = {}     // "$" + package base name -> its exported function names
    var curPkgName = null   // the package being imported right now (null at top level)
    // AN IMPORTED PACKAGE GETS ITS OWN GLOBAL NAMESPACE. Every file used to declare
    // into the one globalScope, so a main file `var V = 1` / `func Helper()` OVERWROTE
    // the imported package's own V and Helper - and since a package function resolves
    // its unqualified names through that same scope at CALL time, mconst.Sum() then ran
    // on the main file's values (measured: 1001 where go says 108). 08e8d3f fixed the
    // CONSTANT half of this by giving each file its own fold scope; this is the runtime
    // half. pkgScopes["$" + name] is the package's own object and it is CHAINED UNDER
    // globalScope, so the package still reaches fmt, os, len and the type descriptors,
    // while its own names shadow the main file's. Type declarations deliberately stay
    // in globalScope: `structs` is one flat table keyed by type name and splitting it
    // is a separate change. docs/todo.md 2.7.
    var pkgTypes = {}       // "$" + package base name -> its exported TYPE names
    // An exported type declared inside an import, recorded so importFile can put it on
    // the package object. Types stay in globalScope (see pkgScopes), so this is a list
