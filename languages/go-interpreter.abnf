~~) ;
// InitAhead answers "does this if/switch header carry an init statement?" - i.e. is
// there a ';' before the body's '{' at bracket depth 0. Without it the optional init
// would be ATTEMPTED on a plain header, and its half-parsed pushes are not rolled
// back (see the CondOn note above). TypeSwAhead is the same shape for '.(type)'.
// Both are pure functions of (source, position): they only ever read with c.peek.
InitAhead = :script(~~
    (function () {
        var i = 0
        var depth = 0
        var cc = 0
        while (i < 8192) {
            cc = c.peek(i)
            if (cc < 0) { break }
            if (cc === 34 || cc === 39 || cc === 96) {       // " ' `
                var q = cc
                i++
                while (i < 8192) {
                    var d = c.peek(i)
                    if (d < 0 || d === q) { break }
                    if (d === 92 && q !== 96) { i++ }
                    i++
                }
                i++
                continue
            }
            if (cc === 47 && c.peek(i + 1) === 47) {          // // comment
                while (i < 8192 && c.peek(i) >= 0 && c.peek(i) !== 10) { i++ }
                continue
            }
            if (cc === 47 && c.peek(i + 1) === 42) {          // /* comment
                i += 2
                while (i < 8192 && c.peek(i) >= 0 && !(c.peek(i) === 42 && c.peek(i + 1) === 47)) { i++ }
                i += 2
                continue
            }
            if (cc === 40 || cc === 91) { depth++ }
            if (cc === 41 || cc === 93) { depth-- }
            if (depth === 0 && cc === 59) { return undefined }
            if (depth === 0 && (cc === 123 || cc === 125)) { break }
            i++
        }
        return abnf.newToken("\x01no-header-init", 0)
    })()
~~) ;
TypeSwAhead = :script(~~
    (function () {
        var i = 0
        var depth = 0
        var cc = 0
        while (i < 8192) {
            cc = c.peek(i)
            if (cc < 0) { break }
            if (cc === 34 || cc === 39 || cc === 96) {
                var q = cc
                i++
                while (i < 8192) {
                    var d = c.peek(i)
                    if (d < 0 || d === q) { break }
                    if (d === 92 && q !== 96) { i++ }
                    i++
                }
                i++
                continue
            }
            if (cc === 47 && c.peek(i + 1) === 47) {
                while (i < 8192 && c.peek(i) >= 0 && c.peek(i) !== 10) { i++ }
                continue
            }
            if (cc === 47 && c.peek(i + 1) === 42) {
                i += 2
                while (i < 8192 && c.peek(i) >= 0 && !(c.peek(i) === 42 && c.peek(i + 1) === 47)) { i++ }
                i += 2
                continue
            }
            if (cc === 46 && c.peek(i + 1) === 40 && c.peek(i + 2) === 116 && c.peek(i + 3) === 121
                && c.peek(i + 4) === 112 && c.peek(i + 5) === 101 && c.peek(i + 6) === 41) {
                return undefined
            }
            if (cc === 40 || cc === 91) { depth++ }
            if (cc === 41 || cc === 93) { depth-- }
            if (depth === 0 && (cc === 123 || cc === 125)) { break }
            i++
        }
        return abnf.newToken("\x01not-a-type-switch", 0)
    })()
~~) ;

// SameLine stands in for Go's automatic semicolon insertion where it actually
// bites: inside a grouped const/var block, 'green04 NEWLINE blue04' must not read
// the second name as the first one's TYPE. It fails when a line break (or a line
// comment) comes before the next token.
SameLine = :script(~~
    (function () {
        var i = 0
        var cc = 0
        while (i < 8192) {
            cc = c.peek(i)
            if (cc === 32 || cc === 9 || cc === 13) { i++; continue }
            if (cc === 10) { return abnf.newToken("\x01line-break", 0) }
            if (cc === 47 && c.peek(i + 1) === 47) { return abnf.newToken("\x01line-break", 0) }
            if (cc === 47 && c.peek(i + 1) === 42) {
                i += 2
                while (i < 8192 && c.peek(i) >= 0 && !(c.peek(i) === 42 && c.peek(i + 1) === 47)) {
                    if (c.peek(i) === 10) { return abnf.newToken("\x01line-break", 0) }
                    i++
                }
                i += 2
                continue
            }
            break
        }
        return undefined
    })()
