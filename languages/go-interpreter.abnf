    // ----- Core library config (see lib/interp-core.js) -----
    core.lang = "go"
    core.blank = "_"
    // Go stdlib packages the runtime provides (resolveImport lives in lib/interp-core.js;
    // exact-match paths, so sub-packages like "encoding/json" are listed in full).
    core.stdlibImports = ["fmt", "os", "errors", "bufio", "io", "time", "regexp", "path", "encoding/json", "context", "flag", "log", "reflect"]
    core.nullWord = "nil"
    // `p.In.X = 1` with a nil p.In walks resolveRef's path; in Go it is a recoverable
    // panic. The hook is additive in lib/interp-core.js - every language that leaves
    // core.nilPath null keeps resolveRef's `fail`.
    core.nilPath = function(name) { goNilDeref() }
    core.getIndex = function(o, i) { return goIndex(o, i) }
    core.framePush = function() { deferFrames.push([]) }
    core.framePop = function() { runDefers(deferFrames.pop()) }

    // ----- Project-file imports: import "mathbox" -> mathbox.go -----
    // A non-stdlib import maps to a single .go file (a slash path like "a/b" -> a/b.go),
    // searched under the program's directory and the -i roots. The file is parsed with this
    // grammar and walked with the same tags, so its funcs, structs and package-level vars
    // register in the package's own scope (see pkgScopes) - which is what lets the
    // package call its OWN names unqualified - and cross-file value.Method() dispatch
    // works (methods attach to their struct after the whole compile, via methodTodo).
    // The package scope is bound under the import's base name, so the main file reaches
    // mathbox.Add(...) through the same member-call path fmt.Println takes. A file is
    // imported once; repeats and cycles are no-ops.
    // The import base name is the conventional package qualifier ("a/b" -> "b").
    function pkgBaseName(path) {
        var cut = -1
        for (var k = 0; k < path.length; k++) { if (path.charAt(k) == "/") { cut = k } }
        return cut >= 0 ? path.substring(cut + 1) : path
    }
    // import alias "path" / import _ "path": resolve the path exactly as a plain import
    // does, then aim the alias at whatever the package's own base name got bound to -
    // globalScope for a project file (core.importFile), hostGlobals for a stdlib package
    // like fmt. '_' names nothing on purpose (side-effect-only import).
    // items = [alias, path].
    function importAs(items, pos) {
        var alias = items[0]
        var path = items[1]
        resolveImport(path, pos)
        if (alias == "_") { return }
        var base = pkgBaseName(stripWs(path))
        if (alias == base) { return }
        if (hasOwn(globalScope, base)) { globalScope[alias] = globalScope[base]; return }
        if (hasOwn(hostGlobals, base)) { globalScope[alias] = hostGlobals[base] }
    }
    // Go visibility: an identifier is exported exactly when it starts with an upper-case
    // letter.
    function isExported(name) {
        if (name.length == 0) { return false }
        var c0 = name.charCodeAt(0)
        return c0 >= 65 && c0 <= 90
    }
    core.importFile = function(path, pos) {
        var file = c.findImport(path + ".go")
        var lib = file == "" ? goLibFile(path) : ""
        if (file == "" && lib == "") { return false }
        if (lib != "") { file = lib }
        if (importedFiles["$" + file] == true) { return true }
        importedFiles["$" + file] = true
        var pname = pkgBaseName(path)
        if (pkgExports["$" + pname] == undefined) { pkgExports["$" + pname] = [] }
        var text = lib != "" ? load(lib) : c.readFile(file)
        var asg = c.parse(c.agrammar, text, null, file)
        var savedPkg = curPkgName
        var savedWalk = goWalkPkg
        curPkgName = pname
        goWalkPkg = pname
        c.pushSource(file, text)
        goPrescanPkg(text, pname)
        // constByPos and convByPos are keyed by a source OFFSET, and an imported file is
        // parsed with its own offsets starting at zero - so a literal in the import would
        // otherwise be read back as the constant (or conversion) of whatever the MAIN
        // file has ending at the same offset. One table per file; the import's entries
        // are dropped with the import. The named-constant scope goes with them - an
        // import is a different package, and its constants reach this file as pkg.Name,
        // which is a selector and never folds.
        var savedConsts = constByPos
        var savedCFns = cFnByPos
        var savedConvs = convByPos
        var savedScopes = cScopes
        var savedPend = cPend
        var savedPendT = cPendT
        var savedSts = stByPos
        var savedSwMarks = cSwMarks
        constByPos = {}
        cFnByPos = {}
        convByPos = {}
        stByPos = {}
        cScopes = [cFrame()]
        cPend = []
        cPendT = []
        cSwMarks = []
        // THE PACKAGE'S OWN GLOBAL NAMESPACE, chained under globalScope. A top-level
        // declaration in this file lands in pkgScope (the interpreter's top level runs
        // as it walks, so setting `scopes` around c.compile is what redirects declVar),
        // and every function declared here closes over [globalScope, pkgScope] through
        // pkgEnv. One scope PER PACKAGE, not per file, so two files of the same package
        // still see each other.
        var pkgScope = pkgScopes["$" + pname]
        if (pkgScope == undefined) { pkgScope = {}; pkgScopes["$" + pname] = pkgScope }
        var savedPkgScope = curPkgScope
        var savedRun = scopes
        curPkgScope = pkgScope
        scopes = [globalScope, pkgScope]
        var savedTop = goTopPend
        goTopPend = []
        c.compile(asg)
        cNotePkgConsts(pname, lib != "")
        goRunTopVars()
        goTopPend = savedTop
        scopes = savedRun
        curPkgScope = savedPkgScope
        constByPos = savedConsts
        cFnByPos = savedCFns
        convByPos = savedConvs
        cScopes = savedScopes
        cPend = savedPend
        cPendT = savedPendT
        stByPos = savedSts
        cSwMarks = savedSwMarks
        c.popSource()
        curPkgName = savedPkg
        goWalkPkg = savedWalk
        // THE PACKAGE SCOPE IS THE PACKAGE OBJECT, so every top-level name of the
        // package - exported const and var included - is reachable as pkg.Name, LIVE
        // rather than a snapshot (a write to the package's own variable is seen through
        // the qualifier, as Go says), and two files of one package share it because
        // pkgScopes is keyed by package rather than by file. The one thing it gives up
        // is that an UNEXPORTED name is reachable through the qualifier too - real Go
        // rejects `mconst.abs` at compile time - which is an over-acceptance, never a
        // wrong answer. An exported TYPE lives in globalScope (types are one flat
        // table), so those names are copied in.
        var tns = pkgTypes["$" + pname]
        if (tns != undefined) {
            for (var t = 0; t < tns.length; t++) {
                if (hasOwn(globalScope, tns[t])) { scopePut(pkgScope, tns[t], globalScope[tns[t]]) }
            }
        }
        scopePut(pkgScope, "__pkg", true)
        globalScope[pname] = pkgScope
        return true
    }

    goPrescan(c.srcSlice(0, 1073741824))
    c.compile(c.asg)

    // Attach the collected methods to their struct descriptors. The receiver type is
    // found by name: func (p Point) dist() -- recvName pushed [name, type].
    for (var mi = 0; mi < methodTodo.length; mi++) {
        var mm = methodTodo[mi]
        var recvVar = mm.recvName[0]
        var byPtr = mm.recvName.length > 2
        var recvType = mm.recvName[mm.recvName.length - 1]
        var cls = structAt(mm.pkg, recvType)
        var mfn = makeMethodClosure({recvName: recvVar, name: mm.name, params: mm.params,
                                     body: mm.body, rets: mm.rets, rtys: mm.rtys, variadic: mm.variadic, byPtr: byPtr,
                                     ptypes: mm.ptypes, env: mm.env})
        if (cls == undefined && goIsDefTy(recvType)) {
            goDtFns[goDtKey(mm.pkg, recvType + "." + mm.name)] = mfn
            continue
        }
        if (cls == undefined) fail("method receiver type not found: " + recvType)
        cls["__ptr$" + mm.name] = byPtr
        cls[mm.name] = mfn
    }
    goRunTopVars()

    function runEntry(f) {
        try {
            return f()
        } catch (e) {
            if (e != undefined && e != null && e.__gopanic == true) {
                // AN UNRECOVERED PANIC IS REPORTED THE WAY GO REPORTS IT, on stderr
                // with exit status 2:
                //
                //     panic: abort probe
                //     panic: runtime error: index out of range [5] with length 0
                //
                // plus a blank line and a "goroutine 1 [running]:" trace, which no
                // engine here can produce. "panic: " prefixes BOTH kinds; a
                // runtime panic's value already reads "runtime error: <msg>" (see
                // goRTPanic). The twins are js_gotop in languages/lib/go-rt.metajs
                // and in abnf/jsrtgolang.go.
                var pl = goPanicReport(e)
                for (var li = 0; li < pl.length; li++) { eprintln(pl[li]) }
                exit(2)
            }
            throw e
        }
    }
    // The entry point defaults to main(), but the -main flag (c.mainName) can override it:
    // a bare identifier names a top-level function to call, anything with a '(' is a Go
    // snippet parsed and run in the program's scope (see runMainSnippet).
    var entry = c.mainName
    if (entry == undefined || entry == "") { entry = "main" }
    var ret = anytype
    if (mainIsSnippet(entry)) {
        ret = runMainSnippet(entry, "Statement")
        println("go interpreter: -main snippet returned " + (ret === undefined ? 0 : ret))
    } else {
        if (typeof globalScope[entry] != "function") {
            fail("Go programs need a func " + entry + "().")
        }
        // AN UNRECOVERED PANIC IS A PROGRAM RESULT, not a host error: the raw
        // {__gopanic} marker must not escape to the engine. The wording is the
        // compiler half's, which is languages/lib/runtime.c's and abnf/jsrt.go's for
        // every uncaught throw, so ./test.sh --cross (which compares stderr too) sees
        // one line in both.
        ret = runEntry(globalScope[entry])
        println("go interpreter: " + entry + "() returned " + (ret === undefined ? 0 : ret))
    }
    exit(ret === undefined ? 0 : ret | 0)

~~) ;
