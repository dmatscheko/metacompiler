PanicOperand <~~ push(foldCallMember(goBoxArgsC(goRecvsC(takeAll(), up.start)))) ~~>
            = ( ImagLit | DotFloatLit | HexFloatLit | FloatLit | HexLit | OctLit | BinLit | LegOctLit | DecULit
              | DqString | RawString | RuneLit | GoDecLit | True | False | Nil | VarRef ) { FieldSfx | IndexSfx } ;
PanicFresh  <~~ push(makeCall(["$panicf", pop()])) ~~> = Expression ;


// ----- Composite literals -----
// One production covers every form: []T{...}, [N]T{...}, [...]T{...}, map[K]V{...},
// Name{...} (positional or keyed by field) and struct{...}{...}. An element may be a
// bare brace group ([][]int{{1}, {2, 3}}), which is built against the element type.
// Gated off inside if/for/switch headers, where '{' opens the body instead.
CompositeLit <~~ var ci = takeAll(); var lty = compLitTy(ci[0], ci[1].celems)
