    binOps["<<"] = function(l, r) { return szArith("<<", l, szNum(r)) }
    binOps[">>"] = function(l, r) { return szArith(">>", l, szNum(r)) }
    binOps["&"]  = function(l, r) { return szArith("&", l, r) }
    binOps["|"]  = function(l, r) { return szArith("|", l, r) }
    binOps["^"]  = function(l, r) { return szArith("^", l, r) }
    binOps["&^"] = function(l, r) { return szArith("&^", l, r) }
