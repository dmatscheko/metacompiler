LegOctLit   <~~ push(goLegOctLitC(up.in, up.pos)) ~~>
            = "0" :whitespace() OctSep { OctSep } :whitespace(Whitespace) ;
// A named production on purpose: a :command() directly followed by a (group) parses
// as a Times repetition in this dialect - the Times trap.
OctSep      = "0"..."7" | "_" ;
FloatLit    <~~ push(goFloLitC(up.in, up.pos)) ~~>
            = ( "0" | "1"..."9" ) :whitespace() { "0"..."9" }
              ( "." { "0"..."9" } [ ( "e" | "E" ) [ "+" | "-" ] "0"..."9" { "0"..."9" } ]
              | ( "e" | "E" ) [ "+" | "-" ] "0"..."9" { "0"..."9" } ) :whitespace(Whitespace) ;
HexLit      <~~ push(goRadixLitC(up.in, up.pos)) ~~>
            = "0" :whitespace() HexX HexDigits :whitespace(Whitespace) ;
// Go allows the digit separator right after the base prefix, too: 0x_FF_f.
HexDigits   = { "_" } HexDigit { HexDigit | "_" } ;
HexDigit    = "0"..."9" | "a"..."f" | "A"..."F" ;
// The radix letter is glued to its "0", so `a := 0` NEWLINE `x1, b := f()` is not
// the hex literal 0x1. A named rule, not a group: see the Times trap in
// docs/abnf-dialect-gotchas.md.
HexX        = "x" | "X" ;
OctO        = "o" | "O" ;
BinB        = "b" | "B" ;
OctLit      <~~ push(goRadixLitC(up.in, up.pos)) ~~>
            = "0" :whitespace() OctO "0"..."7" { "0"..."7" | "_" } :whitespace(Whitespace) ;
BinLit      <~~ push(goRadixLitC(up.in, up.pos)) ~~>
            = "0" :whitespace() BinB BinDigits :whitespace(Whitespace) ;
BinDigits   = BinDigit { BinDigit | "_" } ;
BinDigit    = "0" | "1" ;
DecULit     <~~ push(goRadixLitC(up.in, up.pos)) ~~>
            = ( "0" | "1"..."9" ) :whitespace() { "0"..."9" } "_" { "0"..."9" | "_" } :whitespace(Whitespace) ;
