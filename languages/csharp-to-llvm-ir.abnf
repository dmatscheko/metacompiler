            var ty = csIrType(m.asty)
            return function(b) {
                var r = t(b)
                b = r.b
                var okB = curF.NewBlock("")
                var noB = curF.NewBlock("")
                var mergeB = curF.NewBlock("")
                b.NewCondBr(truthy(b, callExt(b, "js_is_type", [r.v, emitStr(b, ty)])), okB, noB)
                okB.NewBr(mergeB)
                noB.NewBr(mergeB)
