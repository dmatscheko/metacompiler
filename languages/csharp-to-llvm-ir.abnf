    // Extended numeric literal text (whitespace and '_' removed) to a number: hex (0x),
    // binary (0b), then real (parseFloat) or integer (parseInt); type suffixes are ignored
    // by parseInt/parseFloat, which stop at the first non-digit.
    function csNum(s) {
        s = stripWs(s)
        var t = ""
        for (var i = 0; i < s.length; i++) { if (s.charAt(i) != "_") { t = t + s.charAt(i) } }
        var hex = t.length >= 2 && t.charAt(0) == "0" && (t.charAt(1) == "x" || t.charAt(1) == "X")
        var bin = t.length >= 2 && t.charAt(0) == "0" && (t.charAt(1) == "b" || t.charAt(1) == "B")
        // A real literal is a DOUBLE: a '.' fraction, an exponent, or one of the
        // f/F/d/D/m/M suffixes (ECMA-334 6.4.5.3). It emits the js_csflo box. A
        // hex/binary literal is never real, so its e/d/f DIGITS must not be
        // mistaken for one.
        var lastc = t.charAt(t.length - 1)
        if (!hex && !bin) {
            var isReal = t.indexOf(".") >= 0 || t.indexOf("e") >= 0 || t.indexOf("E") >= 0
                         || lastc == "f" || lastc == "F" || lastc == "d" || lastc == "D"
                         || lastc == "m" || lastc == "M"
            if (isReal) { return {__flo: parseFloat(t)} }
        }
        // An INTEGER literal travels as its DIGITS, because emitNum would already
        // have rounded 9223372036854775807 to 9223372036854776000 on the way into
        // the module - and the two script engines even rounded it differently. Its
        // TYPE follows its suffix and its value (ECMA-334 6.4.5.3); js_cslit picks.
        var hasU = false
        var hasL = false
