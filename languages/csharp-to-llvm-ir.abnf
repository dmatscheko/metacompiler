    // cursor below has exactly one kind of source to drive. The wrapper body reads the
    // array out of a scope built for it at the call site.
    var arrGenIdx = -1
    function csArrGenBody() {
        return function(b) {
            var srcV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, "$src")])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "$ai"), emitNum(b, 0)])
            var headB = curF.NewBlock("")
            var bodyB = curF.NewBlock("")
            var exitB = curF.NewBlock("")
            b.NewBr(headB)
            var iV = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, "$ai")])
            headB.NewCondBr(truthy(headB, callExt(headB, "js_lt", [iV, callExt(headB, "js_pylen", [srcV])])), bodyB, exitB)
            var i2 = callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, "$ai")])
            callExt(bodyB, "js_yield", [callExt(bodyB, "js_pyget", [srcV, i2])])
            callExt(bodyB, "js_scope_set", [curScopeV, emitStr(bodyB, "$ai"),
                                            callExt(bodyB, "js_jadd", [i2, emitNum(bodyB, 1)])])
            bodyB.NewBr(headB)
            return exitB
        }
    }
    function emitArrayGen(b, arrV) {
        if (arrGenIdx < 0) {
            var savedSaw = sawYield
            arrGenIdx = emitFunc([], csArrGenBody(), false, null, undefined, false, null)
            sawYield = savedSaw
        }
        var scV = callExt(b, "js_scope_new", [curScopeV])
        callExt(b, "js_scope_decl", [scV, emitStr(b, "$src"), arrV])
        var gfV = callExt(b, "js_genfn", [callExt(b, "js_closure", [handle(arrGenIdx), scV])])
        return callExt(b, "js_call", [gfV, hUndef, callExt(b, "js_arr_new", [])])
    }
    // 'seq.GetEnumerator()' answers a cursor over a generator: the sequence itself when it
    // already is one, a generator over the elements when it is an array. Any other receiver
    // keeps its own GetEnumerator, so a user type that implements IEnumerator still works.
    function emitGetEnum(b, cur, argsV) {
        var listB = curF.NewBlock("")
        var notListB = curF.NewBlock("")
        var genB = curF.NewBlock("")
        var objB = curF.NewBlock("")
        var wrapB = curF.NewBlock("")
        var mergeB = curF.NewBlock("")
        b.NewCondBr(truthy(b, callExt(b, "js_is_type", [cur, emitStr(b, "List")])), listB, notListB)
        var agV = emitArrayGen(listB, cur)
        listB.NewBr(wrapB)
        notListB.NewCondBr(truthy(notListB, csIsGenV(notListB, cur)), genB, objB)
        genB.NewBr(wrapB)
        var srcV = wrapB.NewPhi([llvm.ir.NewIncoming(agV, listB), llvm.ir.NewIncoming(cur, genB)])
        var eV = callExt(wrapB, "js_obj_new", [])
        callExt(wrapB, "js_set", [eV, emitStr(wrapB, "__csenum"), hTrue])
        callExt(wrapB, "js_set", [eV, emitStr(wrapB, "g"), srcV])
        callExt(wrapB, "js_set", [eV, emitStr(wrapB, "cur"), hUndef])
        wrapB.NewBr(mergeB)
        var oV = callExt(objB, "js_mcall", [cur, emitStr(objB, "GetEnumerator"), argsV])
        objB.NewBr(mergeB)
        return {b: mergeB, v: mergeB.NewPhi([llvm.ir.NewIncoming(eV, wrapB), llvm.ir.NewIncoming(oV, objB)])}
    }
    function csIsEnumV(b, cur) {
        return callExt(b, "js_not", [callExt(b, "js_eq",
            [callExt(b, "js_get", [cur, emitStr(b, "__csenum")]), hNull])])
    }
    // 'it.MoveNext()': one step of the cursor's generator. The yielded value is parked on
    // the cursor, which is what '.Current' reads.
    function emitMoveNext(b, cur, argsV) {
        var ourB = curF.NewBlock("")
        var objB = curF.NewBlock("")
        var mergeB = curF.NewBlock("")
        b.NewCondBr(truthy(b, csIsEnumV(b, cur)), ourB, objB)
        var gV = callExt(ourB, "js_get", [cur, emitStr(ourB, "g")])
        var stV = callExt(ourB, "js_call", [callExt(ourB, "js_get", [gV, emitStr(ourB, "next")]),
                                            hUndef, callExt(ourB, "js_arr_new", [])])
        callExt(ourB, "js_set", [cur, emitStr(ourB, "cur"), callExt(ourB, "js_get", [stV, emitStr(ourB, "value")])])
        var okV = callExt(ourB, "js_not", [callExt(ourB, "js_get", [stV, emitStr(ourB, "done")])])
        ourB.NewBr(mergeB)
        var oV = callExt(objB, "js_mcall", [cur, emitStr(objB, "MoveNext"), argsV])
        objB.NewBr(mergeB)
        return {b: mergeB, v: mergeB.NewPhi([llvm.ir.NewIncoming(okV, ourB), llvm.ir.NewIncoming(oV, objB)])}
    }
    function emitCurrent(b, cur) {
        var ourB = curF.NewBlock("")
        var objB = curF.NewBlock("")
        var mergeB = curF.NewBlock("")
        b.NewCondBr(truthy(b, csIsEnumV(b, cur)), ourB, objB)
        var cV = callExt(ourB, "js_get", [cur, emitStr(ourB, "cur")])
        ourB.NewBr(mergeB)
        var oV = callExt(objB, "js_get", [cur, emitStr(objB, "Current")])
        objB.NewBr(mergeB)
        return {b: mergeB, v: mergeB.NewPhi([llvm.ir.NewIncoming(cV, ourB), llvm.ir.NewIncoming(oV, objB)])}
    }

    // ----- delegates -----
    // A delegate value IS the closure it names; a MULTICAST delegate ('f += g') is an
    // ARRAY of closures, invoked in order with the last result winning. A list that falls
    // back to one entry becomes that entry again, so a plain delegate is never an array -
    // which is why only a program that declares a delegate type pays for any of this.
    // 'f -= g' removes the LAST run of g's own invocation list that occurs contiguously in
    // f's, which is exactly what Delegate.Remove does - so removing a delegate that was
    // added twice leaves one behind, and 'f -= (g + h)' removes the pair rather than the
    // two entries wherever they sit.
    var csHasDeleg = false
    function csNoteDeleg() { csHasDeleg = true }
    var delegCount = 0
    // An invocation list of 0 / 1 / n entries is null / that entry / the list itself.
    function emitDelegNorm(b, arrV) {
        var lenV = callExt(b, "js_pylen", [arrV])
        var emptyB = curF.NewBlock("")
        var restB = curF.NewBlock("")
        var oneB = curF.NewBlock("")
        var manyB = curF.NewBlock("")
        var mergeB = curF.NewBlock("")
        b.NewCondBr(truthy(b, callExt(b, "js_seq", [lenV, emitNum(b, 0)])), emptyB, restB)
        emptyB.NewBr(mergeB)
        restB.NewCondBr(truthy(restB, callExt(restB, "js_seq", [lenV, emitNum(restB, 1)])), oneB, manyB)
        var oneV = callExt(oneB, "js_pyget", [arrV, emitNum(oneB, 0)])
        oneB.NewBr(mergeB)
        manyB.NewBr(mergeB)
        return {b: mergeB, v: mergeB.NewPhi([llvm.ir.NewIncoming(hNull, emptyB),
                                             llvm.ir.NewIncoming(oneV, oneB),
                                             llvm.ir.NewIncoming(arrV, manyB)])}
    }
    // The invocation list of a value, flattened onto arrV: js_gospread splices an array,
    // keeps a single closure and drops null - exactly the three cases here.
    function emitDelegParts(b, arrV, v) {
        callExt(b, "js_arr_push", [arrV, v])
        callExt(b, "js_gospread", [arrV])
    }
    function emitDelegAdd(b, l, r) {
        var arrV = callExt(b, "js_arr_new", [])
        emitDelegParts(b, arrV, l)
        emitDelegParts(b, arrV, r)
        return emitDelegNorm(b, arrV)
    }
    function emitDelegSub(b, l, r) {
        delegCount++
        var iN = "$di" + delegCount
        var jN = "$dk" + delegCount
        var atN = "$da" + delegCount
        var okN = "$do" + delegCount
        var srcV = callExt(b, "js_arr_new", [])
        emitDelegParts(b, srcV, l)
        var remV = callExt(b, "js_arr_new", [])
        emitDelegParts(b, remV, r)
        var nV = callExt(b, "js_pylen", [srcV])
        var mV = callExt(b, "js_pylen", [remV])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, iN), emitNum(b, 0)])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, jN), emitNum(b, 0)])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, atN), emitNum(b, -1)])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, okN), hTrue])
        var headB = curF.NewBlock("")
        var tryB = curF.NewBlock("")
        var ihB = curF.NewBlock("")
        var ibB = curF.NewBlock("")
        var ifB = curF.NewBlock("")
        var isB = curF.NewBlock("")
        var idB = curF.NewBlock("")
        var setB = curF.NewBlock("")
        var stepB = curF.NewBlock("")
        var doneB = curF.NewBlock("")
        // The search: for every start position, does rem occur there? The LAST one wins.
        b.NewBr(headB)
        var iV = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, iN)])
        headB.NewCondBr(truthy(headB, callExt(headB, "js_le",
            [callExt(headB, "js_jadd", [iV, mV]), nV])), tryB, doneB)
        callExt(tryB, "js_scope_set", [curScopeV, emitStr(tryB, okN), hTrue])
        callExt(tryB, "js_scope_set", [curScopeV, emitStr(tryB, jN), emitNum(tryB, 0)])
        tryB.NewBr(ihB)
        var jV = callExt(ihB, "js_scope_get", [curScopeV, emitStr(ihB, jN)])
        ihB.NewCondBr(truthy(ihB, callExt(ihB, "js_lt", [jV, mV])), ibB, idB)
        var sameV = callExt(ibB, "js_seq",
            [callExt(ibB, "js_pyget", [srcV, callExt(ibB, "js_jadd", [iV, jV])]),
             callExt(ibB, "js_pyget", [remV, jV])])
        ibB.NewCondBr(truthy(ibB, sameV), isB, ifB)
        callExt(ifB, "js_scope_set", [curScopeV, emitStr(ifB, okN), hFalse])
        ifB.NewBr(idB)
        callExt(isB, "js_scope_set", [curScopeV, emitStr(isB, jN),
                                      callExt(isB, "js_jadd", [jV, emitNum(isB, 1)])])
        isB.NewBr(ihB)
        idB.NewCondBr(truthy(idB, callExt(idB, "js_scope_get", [curScopeV, emitStr(idB, okN)])), setB, stepB)
        callExt(setB, "js_scope_set", [curScopeV, emitStr(setB, atN), iV])
        setB.NewBr(stepB)
        callExt(stepB, "js_scope_set", [curScopeV, emitStr(stepB, iN),
                                        callExt(stepB, "js_jadd", [iV, emitNum(stepB, 1)])])
        stepB.NewBr(headB)
        // The result: src without the run at 'at', or src itself when there was no match.
        var cutB = curF.NewBlock("")
        var keepB = curF.NewBlock("")
        var mergeB = curF.NewBlock("")
        var atV = callExt(doneB, "js_scope_get", [curScopeV, emitStr(doneB, atN)])
        doneB.NewCondBr(truthy(doneB, callExt(doneB, "js_ge", [atV, emitNum(doneB, 0)])), cutB, keepB)
        var outV = callExt(cutB, "js_arr_new", [])
        callExt(cutB, "js_arr_push", [outV, callExt(cutB, "js_goslice", [srcV, emitNum(cutB, 0), atV])])
        callExt(cutB, "js_gospread", [outV])
        callExt(cutB, "js_arr_push", [outV, callExt(cutB, "js_goslice",
            [srcV, callExt(cutB, "js_jadd", [atV, mV]), nV])])
        callExt(cutB, "js_gospread", [outV])
        cutB.NewBr(mergeB)
        keepB.NewBr(mergeB)
        var resV = mergeB.NewPhi([llvm.ir.NewIncoming(outV, cutB), llvm.ir.NewIncoming(srcV, keepB)])
        return emitDelegNorm(mergeB, resV)
    }
    // A compound assignment. '+=' / '-=' on a delegate combine / remove instead of adding;
    // the decision is a run-time one (the right operand being a closure), and the whole
    // branch only exists in a program that declares a delegate type.
    // A compound assignment carries an IMPLICIT CAST back to the LEFT operand's
    // type (ECMA-334 12.21.4: `x op= y` is `x = (T)(x op y)`), so `byte b = 250;
    // b += 10` is (byte)260 == 4 and `int i = 5; i += 1.5` is (int)6.5 == 6.
    // js_csnarrowlike reads the type off the old value and applies it; a string or
    // a delegate left operand passes through untouched.
    function emitNarrowLike(b, oldV, v) { return callExt(b, "js_csnarrowlike", [oldV, v]) }
    function emitCompound(b, op, oldV, v) {
        if (!csHasDeleg || (op != "+=" && op != "-=")) { return {b: b, v: emitNarrowLike(b, oldV, emitBin(b, op, oldV, v))} }
        var dB = curF.NewBlock("")
        var stdB = curF.NewBlock("")
        var mergeB = curF.NewBlock("")
        // A delegate right operand is a closure, or an invocation list whose first entry
        // is one ('f -= (g + h)'). Anything else keeps the arithmetic meaning.
        var c1 = curF.NewBlock("")
        var c2 = curF.NewBlock("")
        var c3 = curF.NewBlock("")
        b.NewCondBr(truthy(b, callExt(b, "js_seq", [callExt(b, "js_typeof", [v]), emitStr(b, "function")])), dB, c1)
        c1.NewCondBr(truthy(c1, callExt(c1, "js_is_type", [v, emitStr(c1, "List")])), c2, stdB)
        c2.NewCondBr(truthy(c2, callExt(c2, "js_lt", [emitNum(c2, 0), callExt(c2, "js_pylen", [v])])), c3, stdB)
        c3.NewCondBr(truthy(c3, callExt(c3, "js_seq",
            [callExt(c3, "js_typeof", [callExt(c3, "js_pyget", [v, emitNum(c3, 0)])]),
             emitStr(c3, "function")])), dB, stdB)
        var dr = anytype
        if (op == "+=") { dr = emitDelegAdd(dB, oldV, v) } else { dr = emitDelegSub(dB, oldV, v) }
        dr.b.NewBr(mergeB)
        var sv = emitBin(stdB, op, oldV, v)
        stdB.NewBr(mergeB)
        var mv = mergeB.NewPhi([llvm.ir.NewIncoming(dr.v, dr.b), llvm.ir.NewIncoming(sv, stdB)])
        // The delegate result is not numeric, so js_csnarrowlike hands it back
        // unchanged; only the arithmetic branch is converted.
        return {b: mergeB, v: emitNarrowLike(mergeB, oldV, mv)}
    }
    // Calling a delegate value: a multicast one is an array, so every entry runs and the
    // last result wins. Without a delegate type in the program this is one js_call.
    function emitDelegCall(b, fV, argsV) {
        if (!csHasDeleg) { return {b: b, v: callExt(b, "js_call", [fV, hUndef, argsV])} }
        delegCount++
        var kn = "$dc" + delegCount
        var rn = "$dv" + delegCount
        var listB = curF.NewBlock("")
        var oneB = curF.NewBlock("")
        var headB = curF.NewBlock("")
        var bodyB = curF.NewBlock("")
        var exitB = curF.NewBlock("")
        var mergeB = curF.NewBlock("")
        b.NewCondBr(truthy(b, callExt(b, "js_is_type", [fV, emitStr(b, "List")])), listB, oneB)
        callExt(listB, "js_scope_decl", [curScopeV, emitStr(listB, kn), emitNum(listB, 0)])
        callExt(listB, "js_scope_decl", [curScopeV, emitStr(listB, rn), hUndef])
        listB.NewBr(headB)
        var iV = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, kn)])
        headB.NewCondBr(truthy(headB, callExt(headB, "js_lt", [iV, callExt(headB, "js_pylen", [fV])])), bodyB, exitB)
        var i2 = callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, kn)])
        callExt(bodyB, "js_scope_set", [curScopeV, emitStr(bodyB, rn),
            callExt(bodyB, "js_call", [callExt(bodyB, "js_pyget", [fV, i2]), hUndef, argsV])])
        callExt(bodyB, "js_scope_set", [curScopeV, emitStr(bodyB, kn),
                                        callExt(bodyB, "js_jadd", [i2, emitNum(bodyB, 1)])])
        bodyB.NewBr(headB)
        var lastV = callExt(exitB, "js_scope_get", [curScopeV, emitStr(exitB, rn)])
        exitB.NewBr(mergeB)
        var oneV = callExt(oneB, "js_call", [fV, hUndef, argsV])
        oneB.NewBr(mergeB)
        return {b: mergeB, v: mergeB.NewPhi([llvm.ir.NewIncoming(lastV, exitB), llvm.ir.NewIncoming(oneV, oneB)])}
    }

    // ----- records, tuples and value equality -----
    // C# compares records and tuples BY VALUE, and does so member by member, so a record
    // whose field is itself a record or a tuple has to compare by value too. That is one
    // RECURSIVE test, so it is emitted once as an IR function bound to '$valeq' in the
    // module scope and called from every '==' / '!=' - but only in a program that actually
    // declares a record or builds a tuple (csHasValEq); every other program keeps the
    // plain js_jchareq it emitted before.
    var csHasValEq = false
    function csNoteValEq() { csHasValEq = true }
    function csValEqBody() {
        return function(b) {
            var aV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, "a")])
            var bV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, "b")])
            var selfV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, "$valeq")])
            var noB = curF.NewBlock("")     // the one 'not equal' exit
            var yesB = curF.NewBlock("")    // the one 'equal' exit
            // Identical values (and every primitive, char included) are settled outright.
            var s1 = curF.NewBlock("")
            b.NewCondBr(truthy(b, callExt(b, "js_jchareq", [aV, bV])), yesB, s1)
            // Only two non-null objects can compare structurally.
            var s2 = curF.NewBlock("")
            var s3 = curF.NewBlock("")
            var s4 = curF.NewBlock("")
            s1.NewCondBr(truthy(s1, callExt(s1, "js_seq", [callExt(s1, "js_typeof", [aV]), emitStr(s1, "object")])), s2, noB)
            s2.NewCondBr(truthy(s2, callExt(s2, "js_seq", [callExt(s2, "js_typeof", [bV]), emitStr(s2, "object")])), s3, noB)
            s3.NewCondBr(truthy(s3, callExt(s3, "js_eq", [aV, hNull])), noB, s4)
            var s5 = curF.NewBlock("")
            s4.NewCondBr(truthy(s4, callExt(s4, "js_eq", [bV, hNull])), noB, s5)
            // A tuple: same arity, then Item1..ItemN pairwise.
            var naV = callExt(s5, "js_get", [aV, emitStr(s5, "__tuple")])
            var nbV = callExt(s5, "js_get", [bV, emitStr(s5, "__tuple")])
            var tupB = curF.NewBlock("")
            var recB = curF.NewBlock("")
            s5.NewCondBr(truthy(s5, callExt(s5, "js_eq", [naV, hNull])), recB, tupB)
            var tup2B = curF.NewBlock("")
            tupB.NewCondBr(truthy(tupB, callExt(tupB, "js_seq", [naV, nbV])), tup2B, noB)
            callExt(tup2B, "js_scope_decl", [curScopeV, emitStr(tup2B, "$vi"), emitNum(tup2B, 0)])
            var thB = curF.NewBlock("")
            var tbB = curF.NewBlock("")
            var tsB = curF.NewBlock("")
            tup2B.NewBr(thB)
            var tiV = callExt(thB, "js_scope_get", [curScopeV, emitStr(thB, "$vi")])
            thB.NewCondBr(truthy(thB, callExt(thB, "js_lt", [tiV, naV])), tbB, yesB)
            var ti2 = callExt(tbB, "js_scope_get", [curScopeV, emitStr(tbB, "$vi")])
            var keyV = callExt(tbB, "js_jadd", [emitStr(tbB, "Item"),
                                                callExt(tbB, "js_jadd", [ti2, emitNum(tbB, 1)])])
            var targs = callExt(tbB, "js_arr_new", [])
            callExt(tbB, "js_arr_push", [targs, callExt(tbB, "js_get", [aV, keyV])])
            callExt(tbB, "js_arr_push", [targs, callExt(tbB, "js_get", [bV, keyV])])
            tbB.NewCondBr(truthy(tbB, callExt(tbB, "js_call", [selfV, hUndef, targs])), tsB, noB)
            callExt(tsB, "js_scope_set", [curScopeV, emitStr(tsB, "$vi"),
                                          callExt(tsB, "js_jadd", [ti2, emitNum(tsB, 1)])])
            tsB.NewBr(thB)
            // A record: the same class, then every user-visible member pairwise (js_keys
            // answers exactly those - it skips every '__' key).
            var caV = callExt(recB, "js_get", [aV, emitStr(recB, "__class")])
            var cbV = callExt(recB, "js_get", [bV, emitStr(recB, "__class")])
            var r1B = curF.NewBlock("")
            var r2B = curF.NewBlock("")
            var r3B = curF.NewBlock("")
            recB.NewCondBr(truthy(recB, callExt(recB, "js_eq", [caV, hNull])), noB, r1B)
            r1B.NewCondBr(truthy(r1B, callExt(r1B, "js_seq", [caV, cbV])), r2B, noB)
            r2B.NewCondBr(truthy(r2B, callExt(r2B, "js_seq",
                [callExt(r2B, "js_get", [caV, emitStr(r2B, "__isrecord")]), hTrue])), r3B, noB)
            var ksV = callExt(r3B, "js_keys", [aV])
            callExt(r3B, "js_scope_decl", [curScopeV, emitStr(r3B, "$vj"), emitNum(r3B, 0)])
            var rhB = curF.NewBlock("")
            var rbB = curF.NewBlock("")
            var rsB = curF.NewBlock("")
            r3B.NewBr(rhB)
            var rjV = callExt(rhB, "js_scope_get", [curScopeV, emitStr(rhB, "$vj")])
            rhB.NewCondBr(truthy(rhB, callExt(rhB, "js_lt", [rjV, callExt(rhB, "js_pylen", [ksV])])), rbB, yesB)
            var rj2 = callExt(rbB, "js_scope_get", [curScopeV, emitStr(rbB, "$vj")])
            var kV = callExt(rbB, "js_pyget", [ksV, rj2])
            var rargs = callExt(rbB, "js_arr_new", [])
            callExt(rbB, "js_arr_push", [rargs, callExt(rbB, "js_get", [aV, kV])])
            callExt(rbB, "js_arr_push", [rargs, callExt(rbB, "js_get", [bV, kV])])
            rbB.NewCondBr(truthy(rbB, callExt(rbB, "js_call", [selfV, hUndef, rargs])), rsB, noB)
            callExt(rsB, "js_scope_set", [curScopeV, emitStr(rsB, "$vj"),
                                          callExt(rsB, "js_jadd", [rj2, emitNum(rsB, 1)])])
            rsB.NewBr(rhB)
            // Both exits ret; the dead block the first one leaves behind still needs a
            // terminator, so it is chained into the second one's.
            var deadNo = retStmt(noB, hFalse)
            var deadYes = retStmt(yesB, hTrue)
