        var body = null
        for (var i = 1; i < items.length; i++) {
            var it = items[i]
            if (it.cty != undefined) { cty = it.cty; continue }
            if (it.params != undefined) { pinfo = it; continue }
            if (typeof it == "function") { body = it }
        }
        var key = "__conv_" + csSimpleName(cty)
        csNoteOp(key, curClassName)
        return {kind: "op", name: key, statik: true, pinfo: pinfo, body: body}
    }
    // The call of an operator member of class `cls` with the given arguments.
    function emitOpCall(b, cls, key, args) {
        var argsV = callExt(b, "js_arr_new", [])
        for (var i = 0; i < args.length; i++) { callExt(b, "js_arr_push", [argsV, args[i]]) }
        var clsV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, cls)])
        return callExt(b, "js_call", [callExt(b, "js_get", [clsV, emitStr(b, key)]), hUndef, argsV])
    }
    // A binary step that may hit an overloaded operator: each declaring class is probed on
    // both operands (C# resolves by argument type; there is no type model here), and the
    // built-in meaning is the fallback.
    function emitBinDyn(b, op, lv, rv) {
        var key = "__op2_" + op
        var cls = csOpDecls[key]
        if (cls == undefined) { return {b: b, v: emitBin(b, op, lv, rv)} }
        var mergeB = curF.NewBlock("")
        var incs = []
        for (var i = 0; i < cls.length; i++) {
            var callB = curF.NewBlock("")
            var chkRB = curF.NewBlock("")
            var nextB = curF.NewBlock("")
            b.NewCondBr(truthy(b, callExt(b, "js_is_type", [lv, emitStr(b, cls[i])])), callB, chkRB)
            chkRB.NewCondBr(truthy(chkRB, callExt(chkRB, "js_is_type", [rv, emitStr(chkRB, cls[i])])), callB, nextB)
            var uv = emitOpCall(callB, cls[i], key, [lv, rv])
            callB.NewBr(mergeB)
            incs.push(llvm.ir.NewIncoming(uv, callB))
            b = nextB
        }
        var sv = emitBin(b, op, lv, rv)
        b.NewBr(mergeB)
        incs.push(llvm.ir.NewIncoming(sv, b))
        return {b: mergeB, v: mergeB.NewPhi(incs)}
    }
    // The unary twin ('operator -', 'operator !').
    function emitUnDyn(b, sym, v, stdV) {
        var key = "__op1_" + sym
        var cls = csOpDecls[key]
        if (cls == undefined) { return {b: b, v: stdV(b)} }
        var mergeB = curF.NewBlock("")
        var incs = []
        for (var i = 0; i < cls.length; i++) {
            var callB = curF.NewBlock("")
            var nextB = curF.NewBlock("")
            b.NewCondBr(truthy(b, callExt(b, "js_is_type", [v, emitStr(b, cls[i])])), callB, nextB)
            var uv = emitOpCall(callB, cls[i], key, [v])
            callB.NewBr(mergeB)
            incs.push(llvm.ir.NewIncoming(uv, callB))
            b = nextB
        }
        var sv = stdV(b)
        b.NewBr(mergeB)
        incs.push(llvm.ir.NewIncoming(sv, b))
        return {b: mergeB, v: mergeB.NewPhi(incs)}
    }
    // A user conversion TO the named type, declared on the operand's own class: used by an
    // explicit cast ('(int)v') and by a typed declaration ('S12Vec d = 5;').
    function emitConvTo(b, tname, v, stdV) {
        var key = "__conv_" + tname
        var cls = csOpDecls[key]
        if (cls == undefined) { return {b: b, v: stdV(b, v)} }
        var mergeB = curF.NewBlock("")
        var incs = []
        for (var i = 0; i < cls.length; i++) {
            var callB = curF.NewBlock("")
            var nextB = curF.NewBlock("")
            b.NewCondBr(truthy(b, callExt(b, "js_is_type", [v, emitStr(b, cls[i])])), callB, nextB)
            var uv = emitOpCall(callB, cls[i], key, [v])
            callB.NewBr(mergeB)
            incs.push(llvm.ir.NewIncoming(uv, callB))
            b = nextB
        }
        var sv = stdV(b, v)
        b.NewBr(mergeB)
        incs.push(llvm.ir.NewIncoming(sv, b))
        return {b: mergeB, v: mergeB.NewPhi(incs)}
    }

    // The implicit conversion at a typed declaration is the mirror image of the explicit
    // one: the value is converted when it is NOT already of the declared type.
    function emitImplicitConv(b, ty, v) {
        var key = "__conv_" + ty
        var cls = csOpDecls[key]
        if (cls == undefined) { return {b: b, v: v} }
        // Only a conversion the TARGET type declares itself ('struct V { implicit operator
        // V(int) }') applies at a typed declaration. 'explicit operator int' is declared by
        // the SOURCE type and belongs to a cast - reading it here made 'int b = 3;' call
        // V.__conv_int(3) and store null.
        var own = false
        for (var oi = 0; oi < cls.length; oi++) { if (cls[oi] == ty) { own = true } }
        if (!own) { return {b: b, v: v} }
        var convB = curF.NewBlock("")
        var skipB = curF.NewBlock("")
        var mergeB = curF.NewBlock("")
        b.NewCondBr(truthy(b, callExt(b, "js_is_type", [v, emitStr(b, ty)])), skipB, convB)
        var uv = emitOpCall(convB, ty, key, [v])
        convB.NewBr(mergeB)
        skipB.NewBr(mergeB)
        return {b: mergeB, v: mergeB.NewPhi([llvm.ir.NewIncoming(uv, convB), llvm.ir.NewIncoming(v, skipB)])}
    }

    // ----- properties and indexers -----
    // One accessor of a property or indexer: its body thunk, or null for the automatic
    // form ('get;'), which has no body at all.
    function makeAccessor(kind, items) {
        var body = null
        for (var i = 0; i < items.length; i++) { if (typeof items[i] == "function") { body = items[i] } }
        return {acc: kind, body: body}
    }
    // The parameter lists the synthesized accessor functions are emitted with.
    var csGetPI = {params: [], dflts: [], ext: false, variadic: -1}
    var csSetPI = {params: ["value"], dflts: [null], ext: false, variadic: -1}
    // Every property that has an accessor BODY, name -> "static" | "instance". A field read
    // or write of such a name emits the accessor call instead of js_get / js_set; every
    // other name keeps the plain member access, so existing IR is unchanged.
    var csPropAcc = {}
    // Every EVENT that manages its own subscription list, name -> "static" | "instance".
    // 'E += h' / 'E -= h' on such a name emit the accessor call with the handler itself
    // instead of a delegate combination.
    var csEvtAcc = {}
    // True as soon as the program declares an indexer, so an index step of a program that
    // declares none emits exactly the IR it did before.
    var csHasIndexer = false
    function makeProperty(items) {
        var mods = items[0].mods
        var ty = stripWs(items[1].ty)
        var name = ""
        var getT = null
        var setT = null
        var addT = null
        var remT = null
        var auto = true
        var init = null
        for (var i = 2; i < items.length; i++) {
            var it = items[i]
            if (it.pname != undefined) { name = it.pname; continue }
            if (it.pinit != undefined) { init = it.pinit; continue }
            if (it.parrow != undefined) { getT = it.parrow; auto = false; continue }
            if (it.accs != undefined) {
                var accs = it.accs
                for (var j = 0; j < accs.length; j++) {
                    if (accs[j].body == null) { continue }
                    auto = false
                    if (accs[j].acc == "get") { getT = accs[j].body; continue }
                    if (accs[j].acc == "add") { addT = accs[j].body; continue }
                    if (accs[j].acc == "remove") { remT = accs[j].body; continue }
                    setT = accs[j].body
                }
            }
        }
        var isStatic = false
        for (var k = 0; k < mods.length; k++) { if (mods[k] == "static") { isStatic = true } }
        if (auto) { return csAutoField(name, isStatic, init, ty) }
        if (getT != null || setT != null) { csPropAcc[name] = isStatic ? "static" : "instance" }
        if (addT != null || remT != null) { csEvtAcc[name] = isStatic ? "static" : "instance" }
        return {kind: "prop", name: name, statik: isStatic, getT: getT, setT: setT,
                addT: addT, remT: remT}
    }
    // An automatic property IS a field: same record, so every field path (the instance
    // initializers, the static slot, the member table) applies to it unchanged.
    function csAutoField(name, isStatic, init, ty) {
        var isNum = (ty == "int" || ty == "uint" || ty == "long" || ty == "ulong" || ty == "short"
                  || ty == "ushort" || ty == "byte" || ty == "sbyte" || ty == "double"
                  || ty == "float" || ty == "decimal")
        var isInt = isNum && ty.indexOf("[") < 0
        var dfltH = 1
        if (ty == "bool") { dfltH = 2 }
        if (isInt) { dfltH = 0 }
        return {kind: "field", name: name, statik: isStatic, init: init, dfltH: dfltH, isInt: isInt}
    }
    function makeIndexer(items) {
        var getT = null
        var setT = null
        var pinfo = null
        for (var i = 0; i < items.length; i++) {
            var it = items[i]
            if (it.params != undefined) { pinfo = it; continue }
            if (it.parrow != undefined) { getT = it.parrow; continue }   // '=> e' body
            if (it.accs != undefined) {
                var accs = it.accs
                for (var j = 0; j < accs.length; j++) {
                    if (accs[j].body == null) { continue }
                    if (accs[j].acc == "get") { getT = accs[j].body } else { setT = accs[j].body }
                }
            }
        }
        csHasIndexer = true
        return {kind: "indexer", getT: getT, setT: setT, pinfo: pinfo}
    }
    // The set accessor of an indexer takes the index parameters plus 'value'.
    function csIdxSetPI(pinfo) {
        var names = []
        var dflts = []
        for (var i = 0; i < pinfo.params.length; i++) { names.push(pinfo.params[i]); dflts.push(null) }
        names.push("value")
        dflts.push(null)
        return {params: names, dflts: dflts, ext: false, variadic: -1}
    }
    // Reading a property that has a get accessor body. An instance one is a method call
    // (js_mcall hands the receiver in as its first argument, like every other method); a
    // static one is a plain call of the member on the class descriptor.
    function emitPropGet(b, cur, name) {
        if (csPropAcc[name] == "static") {
            return callExt(b, "js_call", [callExt(b, "js_get", [cur, emitStr(b, "__get_" + name)]),
                                          hUndef, callExt(b, "js_arr_new", [])])
        }
        return callExt(b, "js_mcall", [cur, emitStr(b, "__get_" + name), callExt(b, "js_arr_new", [])])
    }
    // Indexing. A program that declares no indexer emits exactly the built-in container
    // step it did before; one that does gets a runtime branch, because only an instance of
    // a class (which is what carries a '__class') can have a user indexer.
    function emitIndexGet(b, cur, iv) {
        if (!csHasIndexer) { return {b: b, v: callExt(b, core.indexExt, [cur, iv])} }
        var userB = curF.NewBlock("")
        var stdB = curF.NewBlock("")
        var mergeB = curF.NewBlock("")
        b.NewCondBr(truthy(b, callExt(b, "js_has", [cur, emitStr(b, "__class")])), userB, stdB)
        var uargs = callExt(userB, "js_arr_new", [])
        callExt(userB, "js_arr_push", [uargs, iv])
        var uv = callExt(userB, "js_mcall", [cur, emitStr(userB, "__index"), uargs])
        userB.NewBr(mergeB)
        var sv = callExt(stdB, core.indexExt, [cur, iv])
        stdB.NewBr(mergeB)
        return {b: mergeB, v: mergeB.NewPhi([llvm.ir.NewIncoming(uv, userB), llvm.ir.NewIncoming(sv, stdB)])}
    }
    function emitIndexSet(b, cur, iv, val) {
        if (!csHasIndexer) { callExt(b, "js_pyset", [cur, iv, val]); return b }
        var userB = curF.NewBlock("")
        var stdB = curF.NewBlock("")
        var mergeB = curF.NewBlock("")
        b.NewCondBr(truthy(b, callExt(b, "js_has", [cur, emitStr(b, "__class")])), userB, stdB)
        var uargs = callExt(userB, "js_arr_new", [])
        callExt(userB, "js_arr_push", [uargs, iv])
        callExt(userB, "js_arr_push", [uargs, val])
        callExt(userB, "js_mcall", [cur, emitStr(userB, "__setindex"), uargs])
        userB.NewBr(mergeB)
        callExt(stdB, "js_pyset", [cur, iv, val])
        stdB.NewBr(mergeB)
        return mergeB
    }
    function emitEvtCall(b, cur, name, op, v) {
        var key = (op == "+=") ? "__add_" : "__remove_"
        var argsV = callExt(b, "js_arr_new", [])
        callExt(b, "js_arr_push", [argsV, v])
        if (csEvtAcc[name] == "static") {
            callExt(b, "js_call", [callExt(b, "js_get", [cur, emitStr(b, key + name)]), hUndef, argsV])
            return b
        }
        callExt(b, "js_mcall", [cur, emitStr(b, key + name), argsV])
        return b
    }
    function emitPropSet(b, cur, name, v) {
        var argsV = callExt(b, "js_arr_new", [])
        callExt(b, "js_arr_push", [argsV, v])
        if (csPropAcc[name] == "static") {
            callExt(b, "js_call", [callExt(b, "js_get", [cur, emitStr(b, "__set_" + name)]), hUndef, argsV])
            return b
        }
        callExt(b, "js_mcall", [cur, emitStr(b, "__set_" + name), argsV])
        return b
    }

    function makeMethod(items) {
        var mods = items[0].mods
        var name = items[1]
        var params = items[2].params
        var body = items[3]
        var isStatic = false
        var hides = false
        for (var i = 0; i < mods.length; i++) {
            if (mods[i] == "static") { isStatic = true }
            if (mods[i] == "new") { hides = true }
        }
        if (hides) { csHiddenNames[name] = true }
        // 'static T M(this X x, ...)' is also reachable as x.M(...): remember which class
        // carries it, so a call site can emit the static call directly.
        if (isStatic && items[2].ext == true) { csExt[name] = curClassName }
        csRegParams(name, items[2])
        return {kind: "method", name: name, statik: isStatic, params: params, body: body, pinfo: items[2]}
    }
    // A member declared without a body (abstract, or an interface method with no default):
    // it contributes no callable member, but its NAME is a member of the class, so an
    // unqualified call to it inside a default implementation resolves to this.M(...).
    function makeAbstract(items) {
        var mods = items[0].mods
        var isStatic = false
        for (var i = 0; i < mods.length; i++) { if (mods[i] == "static") { isStatic = true } }
        return {kind: "abstract", name: items[1], statik: isStatic}
    }
    function makeCtor(items) {
        csRegParams(items[0], items[1])
        return {kind: "ctor", name: items[0], params: items[1].params, pinfo: items[1], body: items[2]}
    }
    // 'public int X, Y;': one modifier/type prefix, several declarators. The group is
    // flattened into ordinary field records by csFlatten before a class body is read.
    function makeFieldGroup(items) {
        var mods = items[0]
        var ty = items[1]
        var out = []
        for (var i = 2; i < items.length; i++) {
            var d = items[i].fdecl
            var one = []
            one.push(mods)
            one.push(ty)
            for (var j = 0; j < d.length; j++) { one.push(d[j]) }
            out.push(makeField(one))
        }
        if (out.length == 1) { return out[0] }
        return {fgroup: out}
    }
    function csFlatten(members) {
        var any = false
        var i
        for (i = 0; i < members.length; i++) { if (members[i] != undefined && members[i].fgroup != undefined) { any = true } }
        if (!any) { return members }
        var out = []
        for (i = 0; i < members.length; i++) {
            var m = members[i]
            if (m != undefined && m.fgroup != undefined) {
                var g = m.fgroup
                for (var j = 0; j < g.length; j++) { out.push(g[j]) }
                continue
            }
            out.push(m)
        }
        return out
    }
    function makeField(items) {
        var mods = items[0].mods
        var ty = stripWs(items[1].ty)
        var name = items[2]
        var init = items.length > 3 ? items[3] : null
        var isStatic = false
        for (var i = 0; i < mods.length; i++) if (mods[i] == "static") isStatic = true
        var isNum = (ty == "int" || ty == "uint" || ty == "long" || ty == "ulong" || ty == "short"
                  || ty == "ushort" || ty == "byte" || ty == "sbyte" || ty == "double"
                  || ty == "float" || ty == "decimal")
        var isInt = isNum && ty.indexOf("[") < 0
        var dfltH = 1 // The handle constants: 2 false, 1 null.
        if (ty == "bool") dfltH = 2
        if (isInt) dfltH = 0
        return {kind: "field", name: name, statik: isStatic, init: init, dfltH: dfltH, isInt: isInt}
    }
    function fieldDefault(b, f) {
        if (f.isInt) return emitNum(b, 0)
        return handle(f.dfltH)
    }

    // The class whose body is currently being built (for base calls), and the stack that
    // restores the outer name when a nested class ends.
    var curClassName = ""
    var classStack = []
    // The class makeClassStmt built last: a nested declaration has already been walked
    // when its marker reaches the enclosing class body, so its name is the one just built.
    var lastBuiltClass = ""
    function makeNested(t) { return {nestedName: lastBuiltClass, nestedThunk: t} }

    // Emits one method/ctor as jsf_N(env, args). For instance functions args[0] is this.
    // fields != null marks a constructor: the field initializers run before the body.
    // isCtl marks a try/catch body closure: a return/break/continue leaving it emits a
    // control signal instead of a ret/br (see compile-core inCtlBody / excDispatch).
    // Binds one parameter. A parameter with a default value takes it when the call passed
    // fewer arguments; a 'params' tail collects everything from its position on into an
    // array. Both are decided at run time from the argument count (js_pylen).
    var restCount = 0
    function emitParam(b, argsP, pinfo, i, off) {
        var name = pinfo.params[i]
        var lenV = callExt(b, "js_pylen", [argsP])
        if (pinfo.variadic == i) {
            restCount++
            var rn = "$rest" + restCount
            var kn = "$ri" + restCount
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, rn), callExt(b, "js_arr_new", [])])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, kn), emitNum(b, i + off)])
            var headB = curF.NewBlock("")
            var bodyB = curF.NewBlock("")
            var exitB = curF.NewBlock("")
            b.NewBr(headB)
            var kV = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, kn)])
            headB.NewCondBr(truthy(headB, callExt(headB, "js_lt", [kV, callExt(headB, "js_pylen", [argsP])])), bodyB, exitB)
            var kV2 = callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, kn)])
            callExt(bodyB, "js_arr_push", [callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, rn)]),
                                           callExt(bodyB, "js_pyget", [argsP, kV2])])
            callExt(bodyB, "js_scope_set", [curScopeV, emitStr(bodyB, kn),
                                            callExt(bodyB, "js_jadd", [kV2, emitNum(bodyB, 1)])])
            bodyB.NewBr(headB)
            callExt(exitB, "js_scope_decl", [curScopeV, emitStr(exitB, name),
                                             callExt(exitB, "js_scope_get", [curScopeV, emitStr(exitB, rn)])])
            return exitB
        }
        var dflt = (pinfo.dflts != undefined) ? pinfo.dflts[i] : null
        if (dflt == null || dflt == undefined) {
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, name), callExt(b, "js_arg", [argsP, handle(i + off)])])
            return b
        }
        var inRangeB = curF.NewBlock("")
        var haveB = curF.NewBlock("")
        var defB = curF.NewBlock("")
        var mergeB = curF.NewBlock("")
        b.NewCondBr(truthy(b, callExt(b, "js_lt", [emitNum(b, i + off), lenV])), inRangeB, defB)
        // A named argument list leaves the slots it skipped holding the undefined handle
        // (csPutSlot), which is 'omitted' too - so the default applies to those as well.
        var haveV = callExt(inRangeB, "js_arg", [argsP, handle(i + off)])
        inRangeB.NewCondBr(inRangeB.NewICmp(llvm.enum.IPredNE, haveV, handle(0)), haveB, defB)
        haveB.NewBr(mergeB)
        var dr = dflt(defB)
        dr.b.NewBr(mergeB)
        var pv = mergeB.NewPhi([llvm.ir.NewIncoming(haveV, haveB), llvm.ir.NewIncoming(dr.v, dr.b)])
        callExt(mergeB, "js_scope_decl", [curScopeV, emitStr(mergeB, name), pv])
        return mergeB
    }

    function emitFunc(params, body, isInstance, fields, superName, isCtl, pinfo) {
        funcCount++
        var idx = funcCount
        var f = m.NewFunc("jsf_" + idx, i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var savedF = curF
        var savedScope = curScopeV
        var savedLoops = loopStack
        var savedTag = curFTag
        curF = f
        curFTag = idx
        loopStack = []
        if (isCtl) { ctlEnter(idx) }
        var b = f.NewBlock("entry")
        curScopeV = callExt(b, "js_scope_new", [f.Params[0]])
        var off = 0
        if (isInstance) {
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "this"), callExt(b, "js_arg", [f.Params[1], handle(0)])])
            off = 1
        }
        for (var i = 0; i < params.length; i++) {
            if (pinfo != undefined && pinfo != null) {
                b = emitParam(b, f.Params[1], pinfo, i, off)
            } else {
                callExt(b, "js_scope_decl", [curScopeV, emitStr(b, params[i]),
                                             callExt(b, "js_arg", [f.Params[1], handle(i + off)])])
            }
        }
        if (superName != undefined && superName != null) {
            // The implicit base(): run the whole parent constructor without arguments.
            var supClsV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, superName)])
            var supCtorV = callExt(b, "js_get", [supClsV, emitStr(b, "__ctor")])
            var sargsV = callExt(b, "js_arr_new", [])
            callExt(b, "js_arr_push", [sargsV, callExt(b, "js_scope_get", [curScopeV, emitStr(b, "this")])])
            callExt(b, "js_call", [supCtorV, hUndef, sargsV])
        }
        if (fields != null) {
            var thisV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, "this")])
            for (var k = 0; k < fields.length; k++) {
                var fv
                if (fields[k].init != null && fields[k].init != undefined) {
                    var r = fields[k].init(b)
                    b = r.b
                    fv = r.v
                } else {
                    fv = fieldDefault(b, fields[k])
                }
                callExt(b, "js_set", [thisV, emitStr(b, fields[k].name), fv])
            }
        }
        var savedYield = sawYield
        sawYield = false
        var endB = body != null ? body(b) : b
        endB.NewRet(hUndef)
        genClosure = sawYield
        sawYield = savedYield
        if (isCtl) { ctlLeave() }
        curF = savedF
        curScopeV = savedScope
        loopStack = savedLoops
        curFTag = savedTag
        return idx
    }

    // The classes whose descriptors have already been emitted, so a base name that names
    // no class (an interface) can be told apart from a real base class.
    var csKnownClasses = {}
    // The structs seen so far: name -> its instance field records. A declaration whose
    // declared type names a struct copies its initializer (C# value semantics) and a
    // struct without an initializer starts out zeroed.
    var csStructs = {}
    // The body of a synthesized primary constructor: every parameter becomes a member of
    // the instance, so the class body can name it unqualified (see makeVarRef).
    function primaryBody(pnames) {
        return function(b) {
            var thisV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, "this")])
            for (var i = 0; i < pnames.length; i++) {
                callExt(b, "js_set", [thisV, emitStr(b, pnames[i]),
                                      callExt(b, "js_scope_get", [curScopeV, emitStr(b, pnames[i])])])
            }
            return b
        }
    }
    function buildClassStmt(name, members, kind, primary, isRecord) {
        return function(b) {
            csKnownClasses[name] = true
            var clsV = callExt(b, "js_obj_new", [])
            callExt(b, "js_set", [clsV, emitStr(b, "__isclass"), hTrue])
            if (kind == "struct" || kind == "recordstruct") { callExt(b, "js_set", [clsV, emitStr(b, "__isstruct"), hTrue]) }
            if (isRecord) { callExt(b, "js_set", [clsV, emitStr(b, "__isrecord"), hTrue]) }
            callExt(b, "js_set", [clsV, emitStr(b, "__name"), emitStr(b, name)])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, name), clsV])
            var fields = []
            var ctorInfo = null
            var superName = null
            var i
            // A nested type is a class of its own: its declaration runs here, in the same
            // scope, and the outer descriptor only carries a reference to it.
            for (i = 0; i < members.length; i++) {
                if (members[i].nestedName != undefined) {
                    b = members[i].nestedThunk(b)
                    callExt(b, "js_set", [clsV, emitStr(b, members[i].nestedName),
                                          callExt(b, "js_scope_get", [curScopeV, emitStr(b, members[i].nestedName)])])
                }
            }
            // A base that is not a known class (an interface) is ignored: it contributes
            // no members here, and js_scope_get would abort on the undefined name.
            for (i = 0; i < members.length; i++) {
                if (members[i].ext != undefined && csKnownClasses[members[i].ext] == true) {
                    superName = members[i].ext
                    callExt(b, "js_set", [clsV, emitStr(b, "__super"),
                                          callExt(b, "js_scope_get", [curScopeV, emitStr(b, superName)])])
                }
            }
            for (i = 0; i < members.length; i++) {
                var mm = members[i]
                if (mm.kind == "field") {
                    if (mm.statik) {
                        var sv
                        if (mm.init != null && mm.init != undefined) {
                            var r = mm.init(b)
                            b = r.b
                            sv = r.v
                        } else {
                            sv = fieldDefault(b, mm)
                        }
                        callExt(b, "js_set", [clsV, emitStr(b, mm.name), sv])
                    } else {
                        fields.push(mm)
                    }
                }
                if (mm.kind == "ctor") ctorInfo = mm
            }
            var ctorIdx
            if (ctorInfo != null) {
                ctorIdx = emitFunc(ctorInfo.params, ctorInfo.body, true, fields, superName, false, ctorInfo.pinfo)
            } else if (primary != null && primary != undefined) {
                // A primary constructor: its parameters are bound like any other, and the
                // synthesized body copies them onto the instance as members.
                ctorIdx = emitFunc(primary.params, primaryBody(primary.params), true, fields, superName, false, primary)
            } else {
                ctorIdx = emitFunc([], null, true, fields, superName)
            }
            callExt(b, "js_set", [clsV, emitStr(b, "__ctor"), callExt(b, "js_closure", [handle(ctorIdx), curScopeV])])
            for (i = 0; i < members.length; i++) {
                var m2 = members[i]
                if (m2.kind == "method") {
                    var idx = emitFunc(m2.params, m2.body, !m2.statik, null, undefined, false, m2.pinfo)
                    callExt(b, "js_set", [clsV, emitStr(b, m2.name),
                                          csGenWrap(b, callExt(b, "js_closure", [handle(idx), curScopeV]))])
                    // A custom Deconstruct also gets a '__deconstruct' member: the same body,
                    // wrapped so that it returns its out parameters as a tuple.
                    if (m2.name == "Deconstruct") {
                        var di = emitFunc([], csDeconWrap(m2.params, m2.body), true, null, undefined, false, null)
                        callExt(b, "js_set", [clsV, emitStr(b, "__deconstruct"), callExt(b, "js_closure", [handle(di), curScopeV])])
                    }
                }
                // A property with accessor bodies: '__get_X' / '__set_X' members, called
                // like methods (emitPropGet / emitPropSet).
                if (m2.kind == "prop") {
                    if (m2.addT != null) {
                        var ai = emitFunc(["value"], m2.addT, !m2.statik, null, undefined, false, csSetPI)
                        callExt(b, "js_set", [clsV, emitStr(b, "__add_" + m2.name), callExt(b, "js_closure", [handle(ai), curScopeV])])
                    }
                    if (m2.remT != null) {
                        var ri = emitFunc(["value"], m2.remT, !m2.statik, null, undefined, false, csSetPI)
                        callExt(b, "js_set", [clsV, emitStr(b, "__remove_" + m2.name), callExt(b, "js_closure", [handle(ri), curScopeV])])
                    }
                    if (m2.getT != null) {
                        var gi = emitFunc([], m2.getT, !m2.statik, null, undefined, false, csGetPI)
                        callExt(b, "js_set", [clsV, emitStr(b, "__get_" + m2.name),
                                              csGenWrap(b, callExt(b, "js_closure", [handle(gi), curScopeV]))])
                    }
                    if (m2.setT != null) {
                        var si = emitFunc(["value"], m2.setT, !m2.statik, null, undefined, false, csSetPI)
                        callExt(b, "js_set", [clsV, emitStr(b, "__set_" + m2.name), callExt(b, "js_closure", [handle(si), curScopeV])])
                    }
                }
                // An indexer: '__index' / '__setindex' members (see makeIndexSfx).
                if (m2.kind == "indexer") {
                    if (m2.getT != null) {
                        var xi = emitFunc(m2.pinfo.params, m2.getT, true, null, undefined, false, m2.pinfo)
                        callExt(b, "js_set", [clsV, emitStr(b, "__index"), callExt(b, "js_closure", [handle(xi), curScopeV])])
                    }
                    if (m2.setT != null) {
                        var spi = csIdxSetPI(m2.pinfo)
                        var xs = emitFunc(spi.params, m2.setT, true, null, undefined, false, spi)
                        callExt(b, "js_set", [clsV, emitStr(b, "__setindex"), callExt(b, "js_closure", [handle(xs), curScopeV])])
                    }
                }
                // An overloaded operator or a user conversion: a plain static member.
                if (m2.kind == "op") {
                    var oi = emitFunc(m2.pinfo.params, m2.body, false, null, undefined, false, m2.pinfo)
                    callExt(b, "js_set", [clsV, emitStr(b, m2.name), callExt(b, "js_closure", [handle(oi), curScopeV])])
                }
            }
            // A record deconstructs into its positional parameters, unless it wrote a
            // Deconstruct of its own. Its VALUE equality needs no member here: '$valeq'
            // recognizes a record by the '__isrecord' flag on this descriptor.
            if (isRecord) {
                var hasDecon = false
                for (i = 0; i < members.length; i++) {
                    if (members[i].kind == "method" && members[i].name == "Deconstruct") { hasDecon = true }
                }
                if (!hasDecon && primary != null && primary != undefined) {
                    var rdI = emitFunc([], csRecDeconBody(primary.params), true, null, undefined, false, null)
                    callExt(b, "js_set", [clsV, emitStr(b, "__deconstruct"), callExt(b, "js_closure", [handle(rdI), curScopeV])])
                }
            }
            return b
        }
    }
    // ----- enums -----
    function makeEnumMem(items) {
        return {ename: items[0], einit: items.length > 1 ? items[1].einit : null}
    }
    function buildEnumStmt(name, mems) {
        return function(b) {
            var objV = callExt(b, "js_obj_new", [])
            callExt(b, "js_set", [objV, emitStr(b, "__isclass"), hTrue])
            callExt(b, "js_set", [objV, emitStr(b, "__isenum"), hTrue])
            callExt(b, "js_set", [objV, emitStr(b, "__name"), emitStr(b, name)])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, name), objV])
            var saved = curScopeV
            curScopeV = callExt(b, "js_scope_new", [curScopeV])
            var prev = null
            for (var i = 0; i < mems.length; i++) {
                var vv = anytype
                if (mems[i].einit != null) {
                    var r = mems[i].einit(b)
                    b = r.b
                    vv = r.v
                } else if (prev == null) {
                    vv = emitNum(b, 0)
                } else {
                    vv = intWrap(b, callExt(b, "js_jadd", [prev, emitNum(b, 1)]))
                }
                callExt(b, "js_set", [objV, emitStr(b, mems[i].ename), vv])
                callExt(b, "js_scope_decl", [curScopeV, emitStr(b, mems[i].ename), vv])
                prev = vv
            }
            curScopeV = saved
            return b
        }
    }
    function makeEnumStmt(items) {
        var t = buildEnumStmt(items[0], items.slice(1))
        lastBuiltClass = items[0]
        return t
    }

    // The members already seen for a 'partial' type, so every later part is built on top
    // of them (C# merges the parts into one type). Every part still emits a descriptor and
    // re-declares the name, so the LAST one - which carries all the members - wins.
    var csPartials = {}
    function makeClassStmt(items) {
        var cmods = ""
        var kind = ""
        var name = ""
        var primary = null
        var tparams = []
        var members = []
        for (var n = 0; n < items.length; n++) {
            var it = items[n]
            if (typeof it == "string") { name = it; continue }
            if (it.cmods != undefined) { cmods = it.cmods; continue }
            if (it.ckind != undefined) { kind = it.ckind; continue }
            if (it.tparams != undefined) { tparams = it.tparams; continue }
            if (it.primary != undefined) { primary = it.primary; continue }
            members.push(it)
        }
        members = csFlatten(members)
        if (tparams.length > 0) { csClassTParams[name] = tparams }
        var isPartial = cmods.indexOf("partial") >= 0
        if (isPartial) {
            var prev = csPartials[name]
            var all = []
            if (prev != undefined) { for (var p = 0; p < prev.length; p++) { all.push(prev[p]) } }
            for (var q = 0; q < members.length; q++) { all.push(members[q]) }
            members = all
            csPartials[name] = all
        }
        // A struct is built exactly like a class; only the value-copy rules differ, and
        // those are decided by the declared type name (csStructs).
        if (kind == "struct" || kind == "recordstruct") {
            var fnames = []
            for (var i = 0; i < members.length; i++) {
                if (members[i].kind == "field" && !members[i].statik) { fnames.push(members[i]) }
            }
            csStructs[name] = fnames
        }
        // The member table an unqualified 'M(args)' call consults (see makeSelfCall).
        var tbl = {}
        var bodies = {}
        for (var k = 0; k < members.length; k++) {
            var mm = members[k]
            if (mm.kind == "method" || mm.kind == "abstract" || mm.kind == "field" || mm.kind == "prop") {
                tbl[mm.name] = mm.statik ? "static" : "instance"
            }
            if (mm.kind == "method") { bodies[mm.name] = true }
            if (mm.ext != undefined) { csSupers[name] = mm.ext }
        }
        csBodyMembers[name] = bodies
        if (primary != null) {
            for (var pp = 0; pp < primary.params.length; pp++) { tbl[primary.params[pp]] = "instance" }
        }
        csClassMembers[name] = tbl
        // A record is built exactly like the class / struct it names; what it adds is value
        // equality (registered as its 'operator ==' / '!=', so the ordinary operator
        // dispatch reaches it) and deconstruction.
        var isRecord = (kind == "record" || kind == "recordclass" || kind == "recordstruct")
        if (isRecord) { csNoteValEq() }
        var t = buildClassStmt(name, members, kind, primary, isRecord)
        lastBuiltClass = name
        curClassName = classStack.pop()
        return t
    }
    // namespace X.Y { ... }: run the inner declaration thunks in order (drop the name).
    function makeNamespace(items) {
        var stmts = []
        for (var i = 0; i < items.length; i++) { if (typeof items[i] == "function") stmts.push(items[i]) }
        return makeSeq(stmts)
    }

    // The program: jsmain(env, args) builds Console, the classes, then calls Program.Main.
    function buildMain(items) {
        // The walk of an imported file ends here too: stash its top-level declarations
        // for the real jsmain instead of emitting a second one.
        if (importDepth > 0) {
            stashImported(items) // stashed with its file; emitted later (compile-core)
            return
        }
        var f = m.NewFunc("jsmain", i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        curF = f
        var b = f.NewBlock("entry")
        curScopeV = callExt(b, "js_scope_new", [f.Params[0]])
        // Console.WriteLine / Console.Write. NOT the shared println / print host
        // globals: those hand the raw runtime value to Go's %v, which printed
        // <nil> for null, [1 2 3] for an array and a map dump (with a Go POINTER
        // address in it) for a class instance. js_csconsole builds the object with
        // C#'s own value rendering - the twin of csStr in csharp-interpreter.abnf.
        // See abnf/jsrtcsharp.go.
        var consoleV = callExt(b, "js_csconsole", [])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "Console"), consoleV])
        // The integral type NAMES as expression primaries, so `int.MaxValue` and
        // `ulong.MaxValue` resolve. ulong.MaxValue is 18446744073709551615, which
        // no double holds, so they arrive as runtime objects (js_cstype in
        // abnf/jsrtcsharp.go) rather than as emitted literals.
        var csTypeIdents = ["sbyte", "SByte", "byte", "Byte", "short", "Int16",
                            "ushort", "UInt16", "int", "Int32", "uint", "UInt32",
                            "long", "Int64", "ulong", "UInt64", "char", "Char"]
        for (var cti = 0; cti < csTypeIdents.length; cti++) {
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, csTypeIdents[cti]),
                                         callExt(b, "js_cstype", [emitStr(b, csTypeIdents[cti])])])
        }
        b = emitValEqDecl(b)
        b = emitImported(b)
        b = makeSeq(items)(b)
        // The entry defaults to Program.Main but -main (c.mainName) can name another
        // static method of Program.
        var entry = c.mainName
        if (entry == undefined || entry == "") { entry = "Main" }
        if (mainIsSnippet(entry)) {
            b = emitMainSnippet(b, entry, "Statement")
            b.NewRet(emitNum(b, 0))
        } else {
            var progCls = callExt(b, "js_scope_get", [curScopeV, emitStr(b, "Program")])
            var mainV = callExt(b, "js_get", [progCls, emitStr(b, entry)])
            var argsV = callExt(b, "js_arr_new", [])
            b.NewRet(callExt(b, "js_call", [mainV, hUndef, argsV]))
        }
    }

    c.compile(c.asg)

    println(m)

    var res = llvm.RunJS(m, "jsmain")
    var entryName = c.mainName
    if (entryName == undefined || entryName == "") { entryName = "Main" }
    if (mainIsSnippet(entryName)) {
        println("csharp compiler: -main snippet returned " + res.Ret)
    } else {
        println("csharp compiler: " + entryName + "() returned " + res.Ret)
    }
    exit(res.Ret)

~~) ;
