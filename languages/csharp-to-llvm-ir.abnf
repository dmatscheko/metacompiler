        while (body.length > 0) {
            var c = body.charAt(body.length - 1)
            if (c == "u" || c == "U") { hasU = true; body = body.substring(0, body.length - 1) }
            else if (c == "l" || c == "L") { hasL = true; body = body.substring(0, body.length - 1) }
            else { break }
        }
        if (hex) { return {__int: body.substring(2), __radix: 16, __u: hasU, __l: hasL} }
        if (bin) { return {__int: body.substring(2), __radix: 2, __u: hasU, __l: hasL} }
        return {__int: body, __radix: 10, __u: hasU, __l: hasL}
