            var r = exprT(b)
            b = r.b
            return stmtT(b)
        }
    }
    // 'using (init) s': the resources are created in a fresh scope, the body runs, and then
    // Dispose() is called on every resource in reverse order. A return or an exception
    // leaving the body skips disposal (there is no unwind path to hang it on).
    function makeUseDecl(t) { return {useDecl: t, names: lastDeclNames} }
    function makeUsing(bodyT, init) {
        return function(b) {
            var saved = curScopeV
            curScopeV = callExt(b, "js_scope_new", [curScopeV])
            var res = []
            if (init.useExpr != undefined) {
                var r = init.useExpr(b)
                b = r.b
                res.push(r.v)
            } else {
                b = init.useDecl(b)
                for (var i = 0; i < init.names.length; i++) {
                    res.push(callExt(b, "js_scope_get", [curScopeV, emitStr(b, init.names[i])]))
                }
