        // the value of the first one that matches reaches the merge phi. An unmatched
        // scrutinee yields null (C# throws; there is no observable difference here for a
        // program whose arms are exhaustive).
        if (m.swarms != undefined) {
            var arms = m.swarms
            return function(b) {
                var r = t(b)
                var cur = r.b
                var mergeB = curF.NewBlock("")
                var incs = []
                for (var i = 0; i < arms.length; i++) {
                    var pr = emitPat(cur, arms[i].pat, r.v)
                    cur = pr.b
                    var hitB = curF.NewBlock("")
                    var nextB = curF.NewBlock("")
                    cur.NewCondBr(truthy(cur, pr.v), hitB, nextB)
                    var hb = hitB
                    if (arms[i].guard != null) {
                        var gr = arms[i].guard(hitB)
                        var gB = curF.NewBlock("")
                        gr.b.NewCondBr(truthy(gr.b, gr.v), gB, nextB)
