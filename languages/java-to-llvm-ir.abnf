        endB.NewRet(hUndef)
        if (isCtl) { ctlLeave() }
        curF = savedF
        curScopeV = savedScope
        loopStack = savedLoops
        curFTag = savedTag
        return idx
    }
    // A record accessor: return this.f
    function emitAccessor(fname) {
        funcCount++
        var idx = funcCount
        var f = m.NewFunc("jsf_" + idx, i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var b = f.NewBlock("entry")
        var thisV = b.NewCall(getExtern("js_arg", 2), [f.Params[1], handle(0)])
        b.NewRet(b.NewCall(getExtern("js_get", 2), [thisV, emitStr(b, fname)]))
        return idx
    }

    // Every class / record / interface / enum this compile declares, by name. It
    // decides whether a superclass name can be resolved to an emitted descriptor
    // (so an explicit super(args) may target its "__ctor#<n>" slot) and whether a
    // supertype is an interface (which has no constructor to chain to).
    var classNames = {}
    var interfaceNames = {}

    // The constructor dispatcher of an OVERLOADED class: __ctor(args) picks the
    // "__ctor#<n>" slot matching the argument count (args[0] is the instance, so n
    // is length - 1). Java resolves overloads by static types; the subset has none,
    // so arity is the discriminator - which is what every overload in practice
    // differs by here.
    function emitCtorDispatch(clsName, arities) {
        funcCount++
        var idx = funcCount
        var f = m.NewFunc("jsf_" + idx, i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var savedF = curF
        var savedScope = curScopeV
        var savedLoops = loopStack
        var savedTag = curFTag
        curF = f
        curFTag = idx
        loopStack = []
        var b = f.NewBlock("entry")
        curScopeV = callExt(b, "js_scope_new", [f.Params[0]])
        var clsV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, clsName)])
        var nV = callExt(b, "js_get", [f.Params[1], emitStr(b, "length")])
        for (var i = 0; i < arities.length; i++) {
            var hitB = curF.NewBlock("")
            var nextB = curF.NewBlock("")
            b.NewCondBr(truthy(b, callExt(b, "js_seq", [nV, emitNum(b, arities[i] + 1)])), hitB, nextB)
            var cV = callExt(hitB, "js_get", [clsV, emitStr(hitB, "__ctor#" + arities[i])])
            hitB.NewRet(callExt(hitB, "js_call", [cV, hUndef, f.Params[1]]))
            b = nextB
        }
        b.NewRet(hUndef)
        curF = savedF
        curScopeV = savedScope
        loopStack = savedLoops
        curFTag = savedTag
        return idx
    }
    // A record's value equality: same class descriptor and every component ===.
    function emitRecordEquals(clsName, comps) {
        var body = function(b) {
            var thisV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, "this")])
            var otherV = callExt(b, "js_arg", [curF.Params[1], handle(1)])
            var okV = callExt(b, "js_seq", [callExt(b, "js_get", [thisV, emitStr(b, "__class")]),
                                            callExt(b, "js_get", [otherV, emitStr(b, "__class")])])
            for (var i = 0; i < comps.length; i++) {
                var kV = emitStr(b, comps[i])
                var eqV = callExt(b, "js_seq", [callExt(b, "js_get", [thisV, kV]),
                                                callExt(b, "js_get", [otherV, kV])])
                okV = callExt(b, "js_jband", [okV, eqV])
            }
            b.NewRet(okV)
            return deadBlock()
        }
        return emitFunc([], body, true, null, undefined, null)
    }

    // The name of the type declaration whose walk just finished (see makeNestedMember).
    var lastTypeName = ""

    function buildClassStmt(name, members, recordParams) {
        classNames["$" + name] = true
        userDeclared["$" + name] = true
        lastTypeName = name
        for (var u = 0; u < members.length; u++) {
            if (members[u].ext != undefined) {
                noteTypeUse(baseTypeName(members[u].ext))
                classSuper["$" + name] = baseTypeName(members[u].ext)
            }
            if (members[u].impls != undefined && classSuper["$" + name] == undefined
