    }
    function makeClassStmt(items) {
        return buildClassStmt(items[0], items.slice(1), undefined)
    }
    function makeRecordStmt(items) {
        recordComponents["$" + items[0]] = items[1].rparams
        return buildClassStmt(items[0], items.slice(2), items[1].rparams)
    }

    // ----- The java.lang throwable hierarchy -----
    // The standard exception classes are not declared by the program, so the compile
    // provides them: a descriptor with the usual __super chain, a constructor taking
    // an optional message and getMessage(). Only the ones a program actually names
    // (as a superclass or a `new` target), plus their ancestors, are emitted.
    var builtinExcOrder = ["Throwable", "Exception", "Error", "RuntimeException",
                           "IllegalArgumentException", "IllegalStateException",
                           "NullPointerException", "ArithmeticException",
                           "IndexOutOfBoundsException", "ArrayIndexOutOfBoundsException",
                           "ClassCastException", "UnsupportedOperationException",
                           "NumberFormatException", "InterruptedException", "IOException"]
    var builtinExcParent = {"$Throwable": "", "$Exception": "Throwable", "$Error": "Throwable",
                            "$RuntimeException": "Exception",
                            "$IllegalArgumentException": "RuntimeException",
                            "$IllegalStateException": "RuntimeException",
                            "$NullPointerException": "RuntimeException",
                            "$ArithmeticException": "RuntimeException",
                            "$IndexOutOfBoundsException": "RuntimeException",
                            "$ArrayIndexOutOfBoundsException": "IndexOutOfBoundsException",
                            "$ClassCastException": "RuntimeException",
                            "$UnsupportedOperationException": "IllegalArgumentException",
                            "$NumberFormatException": "IllegalArgumentException",
                            "$InterruptedException": "Exception", "$IOException": "Exception"}
    var neededExc = {}
    var userDeclared = {}
    for (var bx = 0; bx < builtinExcOrder.length; bx++) { classNames["$" + builtinExcOrder[bx]] = true }
    // Records that `name` is used as a type, so its builtin descriptor (and every
    // ancestor's) has to be emitted.
    function noteTypeUse(name) {
        var n = name
        while (n != undefined && n != "" && builtinExcParent["$" + n] != undefined) {
            neededExc["$" + n] = true
            n = builtinExcParent["$" + n]
        }
    }
    function emitBuiltinExc(b) {
        var ctor1 = emitFunc([], function(bb) {
            var tV = callExt(bb, "js_arg", [curF.Params[1], handle(0)])
            callExt(bb, "js_set", [tV, emitStr(bb, "__msg"), callExt(bb, "js_arg", [curF.Params[1], handle(1)])])
            bb.NewRet(hUndef)
            return deadBlock()
        }, false, null)
        var ctor0 = emitFunc([], function(bb) {
            var tV = callExt(bb, "js_arg", [curF.Params[1], handle(0)])
            callExt(bb, "js_set", [tV, emitStr(bb, "__msg"), hNull])
            bb.NewRet(hUndef)
            return deadBlock()
        }, false, null)
        var getMsg = emitFunc([], function(bb) {
            var tV = callExt(bb, "js_arg", [curF.Params[1], handle(0)])
            bb.NewRet(callExt(bb, "js_get", [tV, emitStr(bb, "__msg")]))
            return deadBlock()
        }, false, null)
        for (var i = 0; i < builtinExcOrder.length; i++) {
            var name = builtinExcOrder[i]
            if (neededExc["$" + name] != true) { continue }
            if (userDeclared["$" + name] == true) { continue }
            var clsV = callExt(b, "js_obj_new", [])
            callExt(b, "js_set", [clsV, emitStr(b, "__isclass"), hTrue])
            callExt(b, "js_set", [clsV, emitStr(b, "__name"), emitStr(b, name)])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, name), clsV])
            var par = builtinExcParent["$" + name]
            if (par != "" && neededExc["$" + par] == true && userDeclared["$" + par] != true) {
                callExt(b, "js_set", [clsV, emitStr(b, "__super"),
                                      callExt(b, "js_scope_get", [curScopeV, emitStr(b, par)])])
            }
            callExt(b, "js_set", [clsV, emitStr(b, "__ctor#0"), callExt(b, "js_closure", [handle(ctor0), curScopeV])])
            callExt(b, "js_set", [clsV, emitStr(b, "__ctor#1"), callExt(b, "js_closure", [handle(ctor1), curScopeV])])
            callExt(b, "js_set", [clsV, emitStr(b, "__ctor"),
                                  callExt(b, "js_closure", [handle(emitCtorDispatch(name, [0, 1])), curScopeV])])
            callExt(b, "js_set", [clsV, emitStr(b, "getMessage"), callExt(b, "js_closure", [handle(getMsg), curScopeV])])
        }
        return b
    }

    // ----- Interfaces -----
    // Per interface: the names of its concrete (default / static / private) methods,
    // so an implementor can copy them in, and the names of its abstract methods, so a
    // one-method interface can be recognized as functional (SAM conversion).
    var interfaceMethodNames = {}
    var interfaceAbstracts = {}
    function makeInterfaceStmt(items) {
        var name = items[0]
        var members = []
        var supers = []
        var meths = []
        var abstracts = []
        for (var i = 1; i < items.length; i++) {
            var it = items[i]
            if (typeof it == "string") { supers.push(baseTypeName(it)); continue }
            if (it.kind == "abstract") { abstracts.push({name: it.name, n: it.params.length}); continue }
            if (it.kind == "method") { meths.push(it.name) }
            // An interface field is implicitly public static final.
            if (it.kind == "field") { it.statik = true }
            members.push(it)
        }
        interfaceNames["$" + name] = true
        classNames["$" + name] = true
        // Inherited defaults count as this interface's own for an implementor.
        for (var s = 0; s < supers.length; s++) {
            var inh = interfaceMethodNames["$" + supers[s]]
            if (inh == undefined) { continue }
            for (var k = 0; k < inh.length; k++) { meths.push(inh[k]) }
        }
        interfaceMethodNames["$" + name] = meths
        interfaceAbstracts["$" + name] = abstracts
        if (supers.length > 0) { members = [{ext: supers[0]}].concat(members) }
        return buildInterfaceStmt(name, members)
    }
    // The descriptor of an interface: like a class, minus the constructor.
    function buildInterfaceStmt(name, members) {
        var inner = buildClassStmt(name, members, undefined)
        return inner
    }

    // A nested / inner type member: the walk of the inner declaration has just left
    // its statement thunk on the stack, and lastTypeName holds its name (the walk is
    // a single ordered pass, so it is the one that just finished).
    function makeNestedMember(stmt) {
        return {kind: "nested", stmt: stmt, name: lastTypeName}
    }

    // @interface M { ... }: an empty descriptor under the annotation's name.
    function makeAnnotationTypeStmt(items) {
        var name = items[0]
        interfaceNames["$" + name] = true
        interfaceMethodNames["$" + name] = []
        interfaceAbstracts["$" + name] = []
        return buildClassStmt(name, [], undefined)
    }

    // ----- Enums -----
    // Which enum owns a bare constant name, so an unqualified `case S ->` in a switch
    // over that enum resolves (Java lets the label drop the type name). Decided when
    // the label is EMITTED, which is after every declaration has been walked.
    var enumConstOwner = {}
    function makeEnumConst(items) {
        var name = items[0]
        var args = []
        var body = null
        for (var i = 1; i < items.length; i++) {
            if (items[i].ebody != undefined) { body = items[i].ebody } else { args.push(items[i]) }
        }
        return {econst: true, name: name, args: args, body: body}
    }
    // One helper method on the enum descriptor. `name`/`ordinal` are instance methods
    // (the receiver arrives as argument 0); `values`/`valueOf` are static and read the
    // descriptor back out of the captured scope.
    function emitEnumHelper(kind, ename) {
        var body = function(b) {
            var a0 = callExt(b, "js_arg", [curF.Params[1], handle(0)])
            var clsV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, ename)])
            if (kind == "name") { b.NewRet(callExt(b, "js_get", [a0, emitStr(b, "__ename")])) }
            else if (kind == "ordinal") { b.NewRet(callExt(b, "js_get", [a0, emitStr(b, "__eord")])) }
            else if (kind == "values") { b.NewRet(callExt(b, "js_get", [clsV, emitStr(b, "__values")])) }
            else { b.NewRet(callExt(b, "js_get", [clsV, a0])) }
            return deadBlock()
        }
        return emitFunc([], body, false, null)
    }
    function makeEnumStmt(items) {
        var name = items[0]
        var consts = []
        var members = []
        for (var i = 1; i < items.length; i++) {
            if (items[i].econst != undefined) { consts.push(items[i]) } else { members.push(items[i]) }
        }
        for (var k = 0; k < consts.length; k++) { enumConstOwner["$" + consts[k].name] = name }
        // A constant BODY is an anonymous subclass of the enum; build it up front so
        // the walk-time registration (class names) happens here too.
        var subs = []
        for (var s = 0; s < consts.length; s++) {
            if (consts[s].body == null) { subs.push(null); continue }
            subs.push(buildClassStmt(name + "$" + consts[s].name, [{ext: name}].concat(consts[s].body), undefined))
        }
        var clsStmt = buildClassStmt(name, members, undefined)
        lastTypeName = name
        return function(b) {
            b = clsStmt(b)
            var clsV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, name)])
            var kinds = ["name", "ordinal", "values", "valueOf"]
            for (var h = 0; h < kinds.length; h++) {
                callExt(b, "js_set", [clsV, emitStr(b, kinds[h]),
                                      callExt(b, "js_closure", [handle(emitEnumHelper(kinds[h], name)), curScopeV])])
            }
            var valsV = callExt(b, "js_arr_new", [])
            callExt(b, "js_set", [clsV, emitStr(b, "__values"), valsV])
            var ctorV = callExt(b, "js_get", [clsV, emitStr(b, "__ctor")])
            for (var q = 0; q < consts.length; q++) {
                var descV = clsV
                if (subs[q] != null) {
                    b = subs[q](b)
                    descV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, name + "$" + consts[q].name)])
                }
                var objV = callExt(b, "js_obj_new", [])
                callExt(b, "js_set", [objV, emitStr(b, "__class"), descV])
                callExt(b, "js_set", [objV, emitStr(b, "__ename"), emitStr(b, consts[q].name)])
                callExt(b, "js_set", [objV, emitStr(b, "__eord"), emitNum(b, q)])
                var argsV = callExt(b, "js_arr_new", [])
                callExt(b, "js_arr_push", [argsV, objV])
                for (var a = 0; a < consts[q].args.length; a++) {
                    var r = consts[q].args[a](b)
                    b = r.b
                    callExt(b, "js_arr_push", [argsV, r.v])
                }
                callExt(b, "js_call", [ctorV, hUndef, argsV])
                callExt(b, "js_set", [clsV, emitStr(b, consts[q].name), objV])
                callExt(b, "js_arr_push", [valsV, objV])
            }
            return b
        }
    }
    // ----- Patterns (pattern switch and the instanceof record form) -----
    // The component names of every record, so a deconstruction pattern knows which
    // members its sub-patterns describe.
    var recordComponents = {}
    // A pattern is {ty, bind, subs}: subs != null makes it a record deconstruction.
    // `var` and the primitive type names carry no run-time test - inside a record
    // pattern the component's type is already fixed by the record declaration.
    function patNeedsTest(ty) {
        if (ty == "var" || ty == "int" || ty == "long" || ty == "short" || ty == "byte"
            || ty == "double" || ty == "float" || ty == "char" || ty == "boolean") { return false }
        return true
    }
    function patParts(items) {
        var ty = ""
        var bind = null
        var subs = []
        for (var i = 0; i < items.length; i++) {
            if (items[i].pty != undefined) { ty = baseTypeName(items[i].pty); continue }
            if (items[i].pbind != undefined) { bind = items[i].pbind; continue }
            subs.push(items[i])
        }
        return {ty: ty, bind: bind, subs: subs}
    }
    function makeTypePattern(items) {
        var p = patParts(items)
        return {ty: p.ty, bind: p.bind, subs: null}
    }
    function makeRecPattern(items) {
        var p = patParts(items)
        return {ty: p.ty, bind: p.bind, subs: p.subs}
    }
    function makePatLabel(items) {
        var pat = null
        var guard = null
        for (var i = 0; i < items.length; i++) {
            if (items[i].pwhen != undefined) { guard = items[i].pwhen } else { pat = items[i] }
        }
        return patternTest(pat, guard)
    }
    // Emits the test for one pattern against `val`, branching to failB as soon as a
    // component does not match; bindings are declared as they are reached (looser than
    // Java's flow scoping, like the plain instanceof binding above).
    function emitPattern(b, val, pat, failB) {
        if (patNeedsTest(pat.ty)) {
            var okB = curF.NewBlock("")
            b.NewCondBr(truthy(b, callExt(b, "js_is_type", [val, emitStr(b, pat.ty)])), okB, failB)
            b = okB
        }
        if (pat.bind != null) {
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, pat.bind), val])
        }
        if (pat.subs != null) {
            var comps = recordComponents["$" + pat.ty]
            if (comps == undefined) { comps = [] }
            for (var i = 0; i < pat.subs.length && i < comps.length; i++) {
                b = emitPattern(b, callExt(b, "js_get", [val, emitStr(b, comps[i])]), pat.subs[i], failB)
            }
        }
        return b
    }
    // The whole label as a predicate on the scrutinee: the pattern, then the optional
    // `when` guard. The outcome travels in a hidden scope variable, so the two paths
    // meet without a phi over the whole component chain.
    var patCount = 0
    function patternTest(pat, guard) {
        return function(b, val) {
            patCount++
            var rName = "$pm" + patCount
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, rName), hFalse])
            var failB = curF.NewBlock("")
            var doneB = curF.NewBlock("")
            var okB = emitPattern(b, val, pat, failB)
            if (guard != null) {
                var g = guard(okB)
                var gB = curF.NewBlock("")
                g.b.NewCondBr(truthy(g.b, g.v), gB, failB)
                okB = gB
            }
            callExt(okB, "js_scope_set", [curScopeV, emitStr(okB, rName), hTrue])
            okB.NewBr(doneB)
            failB.NewBr(doneB)
            return {b: doneB, v: callExt(doneB, "js_scope_get", [curScopeV, emitStr(doneB, rName)])}
        }
    }
    // An arrow label is either a value to compare with or a pattern to test.
    function makeArrowLabel(x, text) {
        if (x != undefined && x.plab != undefined) { return {test: x.plab} }
        return {v: enumLabel(x, text)}
    }

    // A bare-name switch label: the three keyword literals are themselves, everything
    // else is a name (an enum constant, resolved by enumLabel, or a variable).
    function makeLabelName(name) {
        if (name == "null") { return makeConst(null) }
        if (name == "true") { return makeConst(true) }
        if (name == "false") { return makeConst(false) }
        return makeVarRef(name)
    }
    // A switch label that is a bare identifier naming a constant of some enum reads
    // that constant; every other label keeps its own expression.
    function enumLabel(t, text) {
        return function(b) {
            var owner = enumConstOwner["$" + text]
            if (owner == undefined) { return t(b) }
            var clsV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, owner)])
            return {b: b, v: callExt(b, "js_get", [clsV, emitStr(b, text)])}
        }
    }

    // ----- Anonymous classes -----
    var anonCount = 0
    function makeNewAnon(items, pos) {
        var baseName = items[0]
        var args = []
        var members = []
        for (var i = 1; i < items.length; i++) {
            if (typeof items[i] == "function") { args.push(items[i]) } else { members.push(items[i]) }
        }
        anonCount++
        var aname = "Anon$" + anonCount
        var mem = [{ext: baseName}]
        if (args.length > 0) {
            // Forward the arguments to the base constructor: the anonymous class's own
            // constructor takes them positionally and delegates with super(...).
            var ps = []
            var dargs = []
            for (var k = 0; k < args.length; k++) {
                ps.push("$a" + k)
                dargs.push(makeVarRef("$a" + k))
            }
            mem.push({kind: "ctor", name: aname, params: ps, body: null,
                      deleg: {deleg: "super", dargs: dargs}})
        }
        for (var j = 0; j < members.length; j++) { mem.push(members[j]) }
        var clsStmt = buildClassStmt(aname, mem, undefined)
        var newT = makeNew([aname].concat(args))
        return function(b) {
            b = clsStmt(b)
            return newT(b)
        }
    }
    // Iface.super.m(args): call that interface's default method with this as receiver.
    function makeQSuperCall(items) {
        var iname = items[0]
        var mname = ""
        var args = []
        for (var i = 1; i < items.length; i++) {
            if (items[i].mname != undefined) { mname = items[i].mname } else { args.push(items[i]) }
        }
        return function(b) {
            var ifV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, iname)])
            var fnV = callExt(b, "js_get", [ifV, emitStr(b, mname)])
            var argsV = callExt(b, "js_arr_new", [])
            callExt(b, "js_arr_push", [argsV, callExt(b, "js_scope_get", [curScopeV, emitStr(b, "this")])])
            for (var i = 0; i < args.length; i++) {
                var r = args[i](b)
                b = r.b
                callExt(b, "js_arr_push", [argsV, r.v])
            }
            return {b: b, v: callExt(b, "js_call", [fnV, hUndef, argsV])}
        }
    }

    // The program: jsmain(env, args) builds System, the classes, then calls Main.main.
    function buildMain(items) {
        // The walk of an imported file ends here too: stash its class
        // statements for the real jsmain instead of emitting a second one.
        if (importDepth > 0) {
            stashImported(items) // stashed with its file; emitted later (compile-core)
            return
        }
        var f = m.NewFunc("jsmain", i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        curF = f
        var b = f.NewBlock("entry")
        curScopeV = callExt(b, "js_scope_new", [f.Params[0]])
        // System.out.println / System.out.print / System.exit from the host globals.
        var sysV = callExt(b, "js_obj_new", [])
        var outV = callExt(b, "js_obj_new", [])
        callExt(b, "js_set", [outV, emitStr(b, "println"), callExt(b, "js_scope_get", [curScopeV, emitStr(b, "println")])])
        callExt(b, "js_set", [outV, emitStr(b, "print"), callExt(b, "js_scope_get", [curScopeV, emitStr(b, "print")])])
        callExt(b, "js_set", [sysV, emitStr(b, "out"), outV])
        callExt(b, "js_set", [sysV, emitStr(b, "exit"), callExt(b, "js_scope_get", [curScopeV, emitStr(b, "exit")])])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "System"), sysV])
        b = emitBuiltinExc(b)
        b = emitImported(b)
        b = makeSeq(items)(b)
        // The entry defaults to Main.main but -main (c.mainName) can name another static
        // method of Main.
        var entry = c.mainName
        if (entry == undefined || entry == "") { entry = "main" }
        if (mainIsSnippet(entry)) {
            b = emitMainSnippet(b, entry, "Statement")
            b.NewRet(emitNum(b, 0))
        } else {
            var mainCls = callExt(b, "js_scope_get", [curScopeV, emitStr(b, "Main")])
            var mainV = callExt(b, "js_get", [mainCls, emitStr(b, entry)])
            var argsV = callExt(b, "js_arr_new", [])
            callExt(b, "js_arr_push", [argsV, callExt(b, "js_arr_new", [])])
            b.NewRet(callExt(b, "js_call", [mainV, hUndef, argsV]))
        }
    }

    c.compile(c.asg)

    println(m)

    var res = llvm.RunJS(m, "jsmain")
    var entryName = c.mainName
    if (entryName == undefined || entryName == "") { entryName = "main" }
    if (mainIsSnippet(entryName)) {
        println("java compiler: -main snippet returned " + res.Ret)
    } else {
        println("java compiler: " + entryName + "() returned " + res.Ret)
    }
    exit(res.Ret)

~~) ;
