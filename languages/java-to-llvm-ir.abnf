            var savedHasThis = curHasThis
            var clsV = callExt(b, "js_obj_new", [])
            callExt(b, "js_set", [clsV, emitStr(b, "__isclass"), hTrue])
            callExt(b, "js_set", [clsV, emitStr(b, "__name"), emitStr(b, name)])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, name), clsV])
            var fields = []
            var ctors = []
            var superName = null
            var impls = []
            var i
            for (i = 0; i < members.length; i++) {
                if (members[i].ext != undefined) { superName = baseTypeName(members[i].ext) }
                if (members[i].impls != undefined) {
                    for (var q = 0; q < members[i].impls.length; q++) {
                        var iname = baseTypeName(members[i].impls[q])
                        if (interfaceNames["$" + iname] == true) { impls.push(iname) }
                    }
                }
            }
