Null        <~~ push(makeConst(null)) ~~>  = "null" KwEnd ;

// `int[].class` / `String[].class` - a class literal over an ARRAY type. The plain
// `Foo.class` needs nothing (it reads as a field), but this one is no member chain:
// `String[` starts an index that has no subscript. Class objects are not modelled,
// so the value is null. It has to beat VarRef.
ArrClassLit <~~ push(makeConst(null)) ~~>
            = ( PrimName KwEnd | Id { "." Id } ) [ SkipAngle ] "[" "]" { "[" "]" } "." "class" KwEnd ;

// `int.class`, `void.class` - a class literal over a PRIMITIVE type. It is no
// member chain (there is no variable named `int` to read a field from), so it
// needs its own Primary. Class objects are not modelled: the value is null,
// exactly as for the array form above.
PrimClassLit <~~ push(makeConst(null)) ~~>
            = ( PrimName KwEnd | "void" KwEnd ) "." "class" KwEnd ;

// `Outer.this`: the enclosing instance of an inner-class instance, stored as
// __outer when it is created. Tried before VarRef, which would otherwise read
// `Outer` as a plain name and `.this` as a member.
OuterThis   <~~ push(makeOuterThis()) ~~>
            = Id "." KwThis ;

// An UNQUALIFIED method call - `check(x)` rather than `this.check(x)` or
// `Main.check(x)`. Java's own rule decides the receiver: a method the enclosing class
// (or an ancestor) declares static is called on the class descriptor, everything else
// on the enclosing instance - and in a static context there is none, so the class
// descriptor is used there too. Tried before VarRef, which would read the name alone.
BareCall    <~~ push(makeBareCall(takeAll())) ~~>
            = BareName "(" [ Expression { "," Expression } ] ")" ;
// A reserved word is not a method name (`case 0 -> if (true);` used to parse as
// a call to a method named `if`) - but `this(...)` and `super(...)` reach this
// rule whenever they are NOT the first thing in a constructor body, which JEP
// 447 flexible constructors rely on.
BareName    <~~ push(stripWs(up.in)) ~~>
