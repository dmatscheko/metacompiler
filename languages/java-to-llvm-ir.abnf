        if (items.length > 1) { tail.bind = items[1].bind }
        return tail
    }
    function makeInstOf(items, pos) {
        if (items.length == 1) return items[0]
        var operand = items[0]
        var tail = items[1]
        return function(b) {
            var r = operand(b)
            b = r.b
            if (tail.bind != undefined) {
                callExt(b, "js_scope_decl", [curScopeV, emitStr(b, tail.bind), r.v])
