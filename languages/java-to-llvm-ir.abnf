            if (pAt < 0) { return parseInt(s.substring(2), 16) }
            var mant = parseInt(s.substring(2, pAt), 16)
            var et = s.substring(pAt + 1)
            if (et.charAt(0) == "+") { et = et.substring(1) }
            var exp = parseInt(et, 10)
            var k = exp < 0 ? 0 - exp : exp
            var scale = 1
            while (k > 0) { scale = scale * 2; k = k - 1 }
            return exp < 0 ? mant / scale : mant * scale
        }
        if (base == 2) { return parseInt(s.substring(2), 2) }
        if (base == 8) { return parseInt(s.substring(1), 8) }
