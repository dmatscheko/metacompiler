    // content), so switching on Strings works. The bodies fall through into each other;
    // break jumps to the exit, continue still targets the enclosing loop.
    function makeSwitch(items) {
        var scrut = items[0]
        var cases = items.slice(1)
        return function(b) {
            var r = scrut(b)
            b = r.b
            var exitB = curF.NewBlock("")
            var bodyBs = []
            var dfltB = exitB
            for (var i = 0; i < cases.length; i++) {
                bodyBs.push(curF.NewBlock(""))
                if (cases[i].isDefault) { dfltB = bodyBs[i] }
            }
            for (var i = 0; i < cases.length; i++) {
                if (cases[i].isDefault) { continue }
                var nextB = curF.NewBlock("")
                if (cases[i].lab.test != undefined) {
                    var rp = cases[i].lab.test(b, r.v)
                    b = rp.b
                    b.NewCondBr(truthy(b, rp.v), bodyBs[i], nextB)
                } else {
                    var rc = cases[i].lab.v(b)
                    b = rc.b
                    b.NewCondBr(truthy(b, callExt(b, "js_jchareq", [r.v, rc.v])), bodyBs[i], nextB)
                }
                b = nextB
            }
            b.NewBr(dfltB)
            var outerCont = loopStack.length > 0 ? loopStack[loopStack.length - 1].cont : null
            loopStack.push({cont: outerCont, brk: exitB})
            for (var i = 0; i < cases.length; i++) {
                var bb = bodyBs[i]
                var body = cases[i].body
                for (var j = 0; j < body.length; j++) { bb = body[j](bb) }
