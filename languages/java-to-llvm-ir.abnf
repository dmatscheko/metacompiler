// A bare array initializer as an expression - `int[] a = {1, 2}`, and nested for the
// jagged form. Only reachable where an expression is expected, so it cannot be
// confused with a block (Statement tries Block long before ExprStmt).
ArrLit      <~~ push(makeArray(takeAll())) ~~>
            = "{" [ Expression { "," Expression } ] [ "," ] "}" ;

Primary     = ArrClassLit | PrimClassLit | ArrLit | NewExpr | SwitchExpr | Lambda | MethodRef | "(" Expression ")" | TextBlock | JavaStr | CharLit
            | JNum | True | False | Null
            | OuterThis | BareCall | VarRef ;
// Every numeric literal in the language goes through NumOk first, so a literal
// javac's scanner refuses never reaches the parser.
JNum        = NumOk ( HexLit | BinLit | OctLit | FloatLit | UscoreInt | SuffInt | IntLit ) ;

// Lambdas and method references are real closures on the handle runtime. A lambda
// captures the defining scope (js_closure); a functional-interface call site (any
// method call on the value, whatever the single abstract method is named) invokes
// it (js_call). The body is an expression (its value is the result) or a block (a
// return supplies the result).
Lambda      <~~ push(makeLambdaExpr(takeAll(), up.pos)) ~~>
