EnumConst   <~~ push(makeEnumConst(takeAll())) ~~>
            = { Annotation } Id <~~ push(up.in) ~~>
              [ "(" [ Expression { "," Expression } ] ")" ] [ EnumBody ] ;
EnumBody    <~~ push({ebody: takeAll()}) ~~> = "{" { Member } "}" ;

// A type declared inside a class body (nested or inner). It is lowered exactly like
// a top-level one and HOISTED: its descriptor is declared under its simple name in
// the scope the enclosing class is built in, and also stored on the enclosing class
// descriptor, so both `new Inner(...)` and `new Outer.Nested()` resolve. An INNER
// (non-static) instance additionally carries __outer - the enclosing instance that
// `o.new Inner(...)` supplies and `Outer.this` reads.
NestedType  <~~ push(makeNestedMember(pop())) ~~>
            = TypeDecl ;
TypeDecl    = ClassDecl | RecordDecl | AnnotationDecl | Interface | EnumDecl ;

KwClass     = "class" KwEnd ;
KwRecord    = "record" KwEnd ;
KwImplements = "implements" KwEnd ;
KwInterface = "interface" KwEnd ;
KwEnum      = "enum" KwEnd ;
KwThrows    = "throws" KwEnd ;
KwTry       = "try" KwEnd ;
KwCatch     = "catch" KwEnd ;
KwFinally   = "finally" KwEnd ;
KwThrow     = "throw" KwEnd ;
KwPackage   = "package" KwEnd ;
KwImport    = "import" KwEnd ;
KwIf        = "if" KwEnd ;
KwElse      = "else" KwEnd ;
KwWhile     = "while" KwEnd ;
KwDo        = "do" KwEnd ;
KwFor       = "for" KwEnd ;
KwReturn    = "return" KwEnd ;
KwBreak     = "break" KwEnd ;
KwContinue  = "continue" KwEnd ;
KwNew       = "new" KwEnd ;
KwExtends   = "extends" KwEnd ;
KwSuper     = "super" KwEnd ;
KwSwitch    = "switch" KwEnd ;
KwCase      = "case" KwEnd ;
KwDefault   = "default" KwEnd ;
KwInstanceof = "instanceof" KwEnd ;
KwAssert    = "assert" KwEnd ;
KwSync      = "synchronized" KwEnd ;
KwThis      = "this" KwEnd ;
KwYield     = "yield" KwEnd ;

// ----- Post-shape parser checks (what javac's parser refuses AFTER the shape
// matched), MIRRORED VERBATIM from java-interpreter.abnf so the two halves
// refuse the same programs. Every rule below REFUSES something; each is
// anchored as narrowly as the diagnostic it mirrors, because a refusal that is
// one step too wide costs must-parse files. Each is a pure function of
// (source, position), like NotSwitchKw / NotIfaceKw above.

// A RESERVED word is never an identifier (JLS 3.9). Id in this grammar matches
// keywords, so `int assert;`, `Object this;`, `return null;` as a class member
// and `case 0 -> if (true);` (an `if` read as a method call) all parsed. The
// list is the 50 reserved words plus the three literals; the CONTEXTUAL ones
// (var, record, sealed, permits, yield, module, ...) are deliberately absent.
// Screened on first byte AND length before any comparison - this guard sits on
// Type and on every declarator, so it runs constantly.
NotResvKw   = :script(~~
    (function() {
        var s = 0 // Whitespace is not skipped before a :script, so scan past it first.
        while (c.peek(s) === 32 || c.peek(s) === 9 || c.peek(s) === 10 || c.peek(s) === 13) { s++ }
        var f0 = c.peek(s)
        if (f0 < 97 || f0 > 122) { return undefined } // every reserved word is lower-case
        var n = 0
        var more = true
