    // parseFloat. One number type - a suffix only selects the parse.
    function numLit(text, base) {
        var s = stripWs(text).split("_").join("")
        var last = s.charAt(s.length - 1)
        // Only L marks a long on hex/binary/octal (f/F/d/D are hex digits or
        // invalid there); decimal also takes the float suffixes.
        var isSfx = last == "L" || last == "l"
        if (base == 10 && (last == "F" || last == "f" || last == "D" || last == "d")) { isSfx = true }
        if (isSfx) {
            s = s.substring(0, s.length - 1)
        }
        if (base == 16) {
            var pAt = -1
            for (var i = 2; i < s.length; i++) {
