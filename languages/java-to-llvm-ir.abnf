    // the |0 wrap (JS >>> yields unsigned). The compound forms reuse the same
    // externs (makeAssign hands the raw operator to emitBin).
    var coreEmitBin = emitBin
    emitBin = function(b, op, l, r) {
        if (op == "&" || op == "&=") return callExt(b, "js_jband", [l, r])
        if (op == "|" || op == "|=") return callExt(b, "js_jbor", [l, r])
        if (op == "^" || op == "^=") return callExt(b, "js_jbxor", [l, r])
        if (op == "<<" || op == "<<=") return callExt(b, "js_shl", [l, r])
        if (op == ">>" || op == ">>=") return callExt(b, "js_shr", [l, r])
        if (op == ">>>" || op == ">>>=") return intWrap(b, callExt(b, "js_ushr", [l, r]))
