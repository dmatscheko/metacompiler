// itself and once again for CallMember, and deeply nested calls would cost 2^depth.
// It precedes FieldSfx, which would otherwise read `.new` as a field named `new`.
QNewSfx     <~~ push(makeQNewSfx(takeAll())) ~~>
            = "." KwNew [ SkipAngle ] { Annotation } Id <~~ push({qname: up.in}) ~~> [ SkipAngle ]
              "(" [ Expression { "," Expression } ] ")" [ "{" { Member } "}" ] ;
MethodSfx   <~~ push({kind:"mcall", name: popName(), args: takeAll()}) ~~>
            = "." [ SkipAngle ] Id <~~ push({mname: up.in}) ~~> "(" [ Expression { "," Expression } ] ")" ;
FieldSfx    = "." Id <~~ push({kind:"field", name: up.in}) ~~> ;
IndexSfx    <~~ push({kind:"index", idx: pop()}) ~~>
            = "[" Expression "]" ;

// A switch EXPRESSION: the same case forms as the statement, but every arm supplies
// a value - an arrow arm's expression is its value, a block arm (and a colon arm)
// says so with `yield`. It lowers to a hidden result variable plus the ordinary
// switch statement, so no phi has to survive the fallthrough chain.
SwitchExpr  <~~ push(makeSwitchExpr(takeAll())) ~~>
            = KwSwitch "(" Expression ")" "{" { SwCase } "}" ;
SwCase      = SwArrowCase | SwArrowDefault | Case | Default ;
SwArrowCase <~~ pushArrowCase(takeAll()) ~~>
            = KwCase NotDfltKw ALabel { "," ALabel } "->" SwArrowBody ;
SwArrowDefault <~~ pushArrowDefault(takeAll()) ~~>
            = KwDefault "->" SwArrowBody ;
// An arrow arm's expression IS the yield; a block or throw arm behaves as usual.
SwArrowBody = SwYield | Block | Throw ;
SwYield     <~~ push(makeYield(pop())) ~~>
