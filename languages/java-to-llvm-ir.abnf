    })()
~~) ;
LambdaBody  = LamBlock | LamExpr ;
LamBlock    <~~ push({lblock: pop()}) ~~> = Block ;
LamExpr     <~~ push({lexpr: pop()}) ~~> = Expression ;
// A method reference Recv::m becomes a closure that forwards its arguments to
// Recv.m(...). This form is the one whose receiver is a NAME - a class, a
// variable, or a dotted path - resolved from the captured scope inside the
// closure. Type arguments on either side (Foo<String>::new, r::<T>generic) are
// parsed and erased like every other generic, and an ARRAY target (String[]::new,
// int[]::clone) is recognised too; makeMethodRef strips both back off the text.
// The receiver that is an arbitrary EXPRESSION - check()::m, new Foo()::m,
// ((C) t)::m - is MRefSfx down in the member chain instead.
MethodRef   <~~ push(makeMethodRef(stripWs(up.in), up.pos)) ~~>
            = ( PrimName KwEnd | Id { "." Id } ) [ SkipAngle ] { "[" "]" }
