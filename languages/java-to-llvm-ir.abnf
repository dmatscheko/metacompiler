    }
    function makeField(items) {
        var mods = items[0].mods
        var ty = items[1].ty
        var name = items[2]
        var init = items.length > 3 ? items[3] : null
        var isStatic = false
        for (var i = 0; i < mods.length; i++) if (mods[i] == "static") isStatic = true
        var dflt = 0
        if (ty == "boolean") dflt = 2 // The handle constants: 2 false, 1 null.
        if (ty != "int" && ty != "boolean") dflt = 1
        if (ty.indexOf("[") >= 0) dflt = 1
        return {kind: "field", name: name, statik: isStatic, init: init, dfltH: dflt, isInt: ty == "int"}
    }
    function fieldDefault(b, f) {
        if (f.isInt) return emitNum(b, 0)
        return handle(f.dfltH)
    }

    // A parameter list: the names in order, with a varargs parameter kept as
    // {rest: name} so emitFunc can tell it apart.
    function makeParams(items) {
        var out = []
        var rest = false
        for (var i = 0; i < items.length; i++) {
            if (items[i] != undefined && items[i].vararg != undefined) { rest = true; continue }
            if (rest) { out.push({rest: items[i]}); rest = false } else { out.push(items[i]) }
        }
        return {params: out}
    }
    // `int... xs`: the arguments from startIdx on, as an array. A single argument
    // that already IS an array is passed straight through, which is how Java lets an
    // array feed a varargs parameter.
    var vaCount = 0
    function emitVarargs(b, name, startIdx) {
        var argsP = curF.Params[1]
        var nameV = emitStr(b, name)
        var lenV = callExt(b, "js_get", [argsP, emitStr(b, "length")])
        callExt(b, "js_scope_decl", [curScopeV, nameV, callExt(b, "js_arr_new", [])])
        var chkB = curF.NewBlock("")
        var passB = curF.NewBlock("")
        var collB = curF.NewBlock("")
        var doneB = curF.NewBlock("")
        b.NewCondBr(truthy(b, callExt(b, "js_seq", [lenV, emitNum(b, startIdx + 1)])), chkB, collB)
        var soleV = callExt(chkB, "js_arg", [argsP, handle(startIdx)])
        chkB.NewCondBr(truthy(chkB, callExt(chkB, "js_is_type", [soleV, emitStr(chkB, "Array")])), passB, collB)
        callExt(passB, "js_scope_set", [curScopeV, emitStr(passB, name),
                                        callExt(passB, "js_arg", [argsP, handle(startIdx)])])
        passB.NewBr(doneB)
        vaCount++
        var iName = "$va" + vaCount
        callExt(collB, "js_scope_decl", [curScopeV, emitStr(collB, iName), emitNum(collB, startIdx)])
        var headB = curF.NewBlock("")
        var bodyB = curF.NewBlock("")
        collB.NewBr(headB)
        var iV = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, iName)])
        headB.NewCondBr(truthy(headB, callExt(headB, "js_lt", [iV, lenV])), bodyB, doneB)
        var i2V = callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, iName)])
        var arrV = callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, name)])
        callExt(bodyB, "js_arr_push", [arrV, callExt(bodyB, "js_get", [argsP, i2V])])
        callExt(bodyB, "js_scope_set", [curScopeV, emitStr(bodyB, iName),
                                        callExt(bodyB, "js_jadd", [i2V, emitNum(bodyB, 1)])])
        bodyB.NewBr(headB)
