// SingleCharacter (`'\u0010'` is one after the pre-pass); CR and LF are not
// (illegal.line.end.in.char.lit).
CharPlain   = "\x00"..."\x09" | "\x0b"..."\x0c" | "\x0e"..."\x26" | "\x28"..."\x5b" | "\x5d"..."\U0010ffff" ;

// Java's string literal. Same shape as lib/dq-strings.abnf, but the escape set
// is Java's own (JLS 3.10.7), not lib/dq-strings' "backslash plus any
// printable": `"\!"` is illegal.esc.char, and StrEsc accepted it. jUnescape
// decodes it - it knows Java's octal escapes ("A\102") and \s, which the shared
// unescapeJs does not, so the two halves now agree on the VALUE as well.
JStrPlain   = "\x00"..."\x09" | "\x0b"..."\x0c" | "\x0e"..."\x21" | "\x23"..."\x5b" | "\x5d"..."\U0010ffff" ;
JavaStr     = '"' :whitespace() { JStrEsc | JStrPlain } <~~ push(makeConst(jUnescape(up.in))) ~~> '"' :whitespace(Whitespace) ;
JStrEsc     = "\\" ( CharEsc | JOct | "u" ) | UniBS "\\" "\x20"..."\x7e" ;
// JLS 3.10.5: a StringCharacter is any InputCharacter but `"` and `\` - which
// includes the raw CONTROL characters, and lib/dq-strings' DqPlain starts at
// \x20. They are not typed directly; the unicode-escape pre-pass produces them
// (`"foo\u0000bar"` is a real NUL in the literal), and javac accepts that -
// verified with -XDshould-stop.ifNoError=PARSE, which exits 0. Only the two
// line terminators are excluded (illegal.line.end.in.string).

