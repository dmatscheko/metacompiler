            // the __super chain: copied in, so a class implementing two interfaces
            // answers both their defaults. A method the class declares itself wins.
            for (i = 0; i < impls.length; i++) {
                if (impls[i] == chained) { continue }
                var inames = interfaceMethodNames["$" + impls[i]]
                if (inames == undefined) { continue }
                var ifV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, impls[i])])
                for (var w = 0; w < inames.length; w++) {
                    if (declared["$" + inames[w]] == true) { continue }
                    callExt(b, "js_set", [clsV, emitStr(b, inames[w]),
                                          callExt(b, "js_get", [ifV, emitStr(b, inames[w])])])
                }
            }
            // Record accessors and value equality, unless the body declares its own.
            if (recordParams != undefined) {
                for (i = 0; i < recordParams.length; i++) {
                    if (declared["$" + recordParams[i]] == true) { continue }
                    var aidx = emitAccessor(recordParams[i])
                    callExt(b, "js_set", [clsV, emitStr(b, recordParams[i]), callExt(b, "js_closure", [handle(aidx), curScopeV])])
                }
                if (declared["$equals"] != true) {
                    var eqidx = emitRecordEquals(name, recordParams)
                    callExt(b, "js_set", [clsV, emitStr(b, "equals"), callExt(b, "js_closure", [handle(eqidx), curScopeV])])
                }
            }
