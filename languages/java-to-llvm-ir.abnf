// __super when it has no superclass (so its default methods and `instanceof`
// work), and every further one has its default methods copied in.
ImplementsSkip <~~ push({impls: takeAll()}) ~~> = KwImplements IType { "," IType } ;
IType       <~~ push(stripWs(up.in)) ~~> = Type ;
Throws      = KwThrows Type { "," Type } ;
CatchType   = { Annotation } Type { "|" { Annotation } Type } ;

// Type declarations accepted structurally, then reported as not implemented (so a
// whole Java file parses; -warn-unsupported lets the rest compile). Bodies are skipped.
UnsupType   = AnnotationDecl | Interface | EnumDecl ;
// An annotation type declaration (@interface M { int id(); ... }). Annotations
// themselves are parsed and dropped everywhere they may appear, and this subset has
// no reflection, so the declaration only has to introduce the NAME: it lowers to an
// empty descriptor, like a marker interface with no members.
AnnotationDecl <~~ push(makeAnnotationTypeStmt(takeAll())) ~~>
            = LeadMods "@" KwInterface Id <~~ push(up.in) ~~> [ SkipAngle ] [ KwExtends Type { "," Type } ] SkipBlock ;
