// read as a repetition. JLS 3.10.2 requires the p-exponent on the fractional
// form, and demanding it is what keeps the '.' out of an ordinary `0xFF`.
HexBody     = HexFrac HexPTail | HexDig { HexDig | "_" } [ HexPTail ] ;
HexFrac     = HexDig { HexDig | "_" } "." { HexDig | "_" } | "." HexDig { HexDig | "_" } ;
HexPTail    = ( "p" | "P" ) [ "+" | "-" ] Dig { Dig | "_" } ;
BinLit      <~~ push(makeNumConst(numLit(up.in, 2))) ~~>
            = ( "0b" | "0B" ) :whitespace() BinDig { BinDig | "_" } [ NumSfx ] :whitespace(Whitespace) ;
