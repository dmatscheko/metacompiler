            if (members[u].kind == "method") {
                methodKind["$" + name + "#" + members[u].name] = members[u].statik ? "static" : "instance"
            }
            if (members[u].kind == "abstract") {
                methodKind["$" + name + "#" + members[u].name] = "instance"
            }
        }
