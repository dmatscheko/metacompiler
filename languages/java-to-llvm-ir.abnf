        if (pat.subs != null) {
            var comps = recordComponents["$" + pat.ty]
            if (comps == undefined) { comps = [] }
            for (var i = 0; i < pat.subs.length && i < comps.length; i++) {
                b = emitPattern(b, callExt(b, "js_get", [val, emitStr(b, comps[i])]), pat.subs[i], failB)
            }
        }
        return b
    }
    // The whole label as a predicate on the scrutinee: the pattern, then the optional
    // `when` guard. The outcome travels in a hidden scope variable, so the two paths
    // meet without a phi over the whole component chain.
    var patCount = 0
    function patternTest(pat, guard) {
        return function(b, val) {
            patCount++
            var rName = "$pm" + patCount
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, rName), hFalse])
            var failB = curF.NewBlock("")
            var doneB = curF.NewBlock("")
            var okB = emitPattern(b, val, pat, failB)
            if (guard != null) {
                var g = guard(okB)
                var gB = curF.NewBlock("")
                g.b.NewCondBr(truthy(g.b, g.v), gB, failB)
                okB = gB
            }
            callExt(okB, "js_scope_set", [curScopeV, emitStr(okB, rName), hTrue])
            okB.NewBr(doneB)
            failB.NewBr(doneB)
            return {b: doneB, v: callExt(doneB, "js_scope_get", [curScopeV, emitStr(doneB, rName)])}
        }
    }
    // An arrow label is either a value to compare with or a pattern to test.
    function makeArrowLabel(x, text) {
        if (x != undefined && x.plab != undefined) { return {test: x.plab} }
        return {v: enumLabel(x, text)}
    }

    // A bare-name switch label: the three keyword literals are themselves, everything
    // else is a name (an enum constant, resolved by enumLabel, or a variable).
    function makeLabelName(name) {
        if (name == "null") { return makeConst(null) }
        if (name == "true") { return makeConst(true) }
        if (name == "false") { return makeConst(false) }
        return makeVarRef(name)
    }
    // A switch label that is a bare identifier naming a constant of some enum reads
    // that constant; every other label keeps its own expression.
    function enumLabel(t, text) {
        return function(b) {
            var owner = enumConstOwner["$" + text]
            if (owner == undefined) { return t(b) }
            var clsV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, owner)])
            return {b: b, v: callExt(b, "js_get", [clsV, emitStr(b, text)])}
        }
    }

    // ----- Anonymous classes -----
    var anonCount = 0
    function makeNewAnon(items, pos) {
        // A qualified base (new java.beans.Listener() {...}) pushes each segment;
        // the LAST one names the descriptor, as in makeNew.
        var baseName = ""
        var args = []
        var members = []
        for (var i = 0; i < items.length; i++) {
            if (typeof items[i] == "string") { baseName = items[i] }
            else if (typeof items[i] == "function") { args.push(items[i]) }
            else { members.push(items[i]) }
        }
        anonCount++
        var aname = "Anon$" + anonCount
        var mem = [{ext: baseName}]
        if (args.length > 0) {
            // Forward the arguments to the base constructor: the anonymous class's own
            // constructor takes them positionally and delegates with super(...).
            var ps = []
            var dargs = []
            for (var k = 0; k < args.length; k++) {
                ps.push("$a" + k)
                dargs.push(makeVarRef("$a" + k))
            }
            mem.push({kind: "ctor", name: aname, params: ps, body: null,
                      deleg: {deleg: "super", dargs: dargs}})
        }
        for (var j = 0; j < members.length; j++) { mem.push(members[j]) }
        var clsStmt = buildClassStmt(aname, mem, undefined)
        var newT = makeNew([aname].concat(args))
        return function(b) {
            b = clsStmt(b)
            return newT(b)
        }
    }
    // Iface.super.m(args): call that interface's default method with this as receiver.
    function makeQSuperCall(items) {
        var iname = items[0]
        var mname = ""
        var args = []
        for (var i = 1; i < items.length; i++) {
            if (items[i].mname != undefined) { mname = items[i].mname } else { args.push(items[i]) }
        }
        return function(b) {
            var ifV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, iname)])
            var fnV = callExt(b, "js_get", [ifV, emitStr(b, mname)])
            var argsV = callExt(b, "js_arr_new", [])
            callExt(b, "js_arr_push", [argsV, callExt(b, "js_scope_get", [curScopeV, emitStr(b, "this")])])
            for (var i = 0; i < args.length; i++) {
                var r = args[i](b)
                b = r.b
                callExt(b, "js_arr_push", [argsV, r.v])
            }
            return {b: b, v: callExt(b, "js_call", [fnV, hUndef, argsV])}
        }
    }

    // The program: jsmain(env, args) builds System, the classes, then calls Main.main.
    function buildMain(items) {
        // The walk of an imported file ends here too: stash its class
        // statements for the real jsmain instead of emitting a second one.
        if (importDepth > 0) {
            stashImported(items) // stashed with its file; emitted later (compile-core)
            return
        }
        var f = m.NewFunc("jsmain", i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        curF = f
        var b = f.NewBlock("entry")
        curScopeV = callExt(b, "js_scope_new", [f.Params[0]])
        // System.out.println / System.out.print / System.exit from the host globals.
        var sysV = callExt(b, "js_obj_new", [])
        var outV = callExt(b, "js_obj_new", [])
        // println/print are NOT the shared host functions: those hand the raw
        // runtime value to Go's %v, which prints <nil> for null, [1 2 3] for an
        // array and a pointer-bearing map dump for an instance (and overflows the
        // stack on an enum constant, whose descriptor points back at it). Each is a
        // one-line closure over js_jvprint / js_jvwrite, which render the way java
        // does - see abnf/jsrtjava.go. The whole ARGUMENT ARRAY is passed, so the
        // no-argument println() stays distinguishable from println(null).
        var jvPrintlnF = emitFunc([], function(bb) {
            callExt(bb, "js_jvprint", [curF.Params[1]])
            bb.NewRet(hUndef)
            return deadBlock()
        }, false, null)
        var jvPrintF = emitFunc([], function(bb) {
            callExt(bb, "js_jvwrite", [curF.Params[1]])
            bb.NewRet(hUndef)
            return deadBlock()
        }, false, null)
        callExt(b, "js_set", [outV, emitStr(b, "println"), callExt(b, "js_closure", [handle(jvPrintlnF), curScopeV])])
        callExt(b, "js_set", [outV, emitStr(b, "print"), callExt(b, "js_closure", [handle(jvPrintF), curScopeV])])
        callExt(b, "js_set", [sysV, emitStr(b, "out"), outV])
        callExt(b, "js_set", [sysV, emitStr(b, "exit"), callExt(b, "js_scope_get", [curScopeV, emitStr(b, "exit")])])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "System"), sysV])
        // Java's Math (abs/max/min, double-aware) instead of the runtime's
        // JavaScript one, whose abs/max/min always answer a plain number - so
        // Math.abs(-2.0) is 2.0 here, exactly like in java-interpreter.abnf.
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "Math"),
                                     callExt(b, "js_scope_get", [curScopeV, emitStr(b, "__jmath")])])
        // java.lang's boxed primitive types, for their MIN_VALUE / MAX_VALUE and
        // the few static methods a program reaches for. Long.MAX_VALUE cannot be
        // written as a plain number at all, which is why they arrive as runtime
        // objects (js_jvboxtype in abnf/jsrtjava.go) rather than emitted literals.
        var jvBoxTypes = ["Integer", "Long", "Byte", "Short", "Character"]
        for (var jb = 0; jb < jvBoxTypes.length; jb++) {
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, jvBoxTypes[jb]),
                                         callExt(b, "js_jvboxtype", [emitStr(b, jvBoxTypes[jb])])])
        }
        b = emitBuiltinExc(b)
        b = emitImported(b)
        b = makeSeq(items)(b)
        // The entry defaults to Main.main but -main (c.mainName) can name another static
        // method of Main.
        var entry = c.mainName
        if (entry == undefined || entry == "") { entry = "main" }
        if (mainIsSnippet(entry)) {
            b = emitMainSnippet(b, entry, "Statement")
            b.NewRet(emitNum(b, 0))
        } else {
            var mainCls = callExt(b, "js_scope_get", [curScopeV, emitStr(b, "Main")])
            var mainV = callExt(b, "js_get", [mainCls, emitStr(b, entry)])
            var argsV = callExt(b, "js_arr_new", [])
            // JEP 512: the entry may be an INSTANCE method (`void main()` in an
            // implicitly declared class). An instance method sits on the class
            // descriptor like a static one, so the static-ness is read from
            // methodKind, never from the property; the receiver is a fresh
            // instance built with the no-argument constructor, exactly as
            // java's own launcher does it.
            if (lookupMethodKind("Main", entry) == "instance") {
                var selfV = callExt(b, "js_obj_new", [])
                callExt(b, "js_set", [selfV, emitStr(b, "__class"), mainCls])
                var ctorArgs = callExt(b, "js_arr_new", [])
                callExt(b, "js_arr_push", [ctorArgs, selfV])
                var ctorV = callExt(b, "js_get", [mainCls, emitStr(b, "__ctor")])
                callExt(b, "js_call", [ctorV, hUndef, ctorArgs])
                callExt(b, "js_arr_push", [argsV, selfV])
            }
            callExt(b, "js_arr_push", [argsV, callExt(b, "js_arr_new", [])])
            b.NewRet(callExt(b, "js_call", [mainV, hUndef, argsV]))
        }
    }

    c.compile(c.asg)

    println(m)

    var res = llvm.RunJS(m, "jsmain")
    var entryName = c.mainName
    if (entryName == undefined || entryName == "") { entryName = "main" }
    if (mainIsSnippet(entryName)) {
        println("java compiler: -main snippet returned " + res.Ret)
    } else {
        println("java compiler: " + entryName + "() returned " + res.Ret)
    }
    exit(res.Ret)

~~) ;
