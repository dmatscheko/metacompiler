        var supKnown = superName != null && superName != undefined && classNames["$" + superName] == true
        if (!isThis && !supKnown) { slot = "__ctor" }
        return function(b) {
            var thisV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, "this")])
            var argsV = callExt(b, "js_arr_new", [])
            callExt(b, "js_arr_push", [argsV, thisV])
            for (var i = 0; i < args.length; i++) {
                var r = args[i](b)
                b = r.b
                callExt(b, "js_arr_push", [argsV, r.v])
            }
            var ownV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, clsName)])
            var tgtObj = ownV
            if (!isThis) { tgtObj = callExt(b, "js_get", [ownV, emitStr(b, "__super")]) }
            var ctorV = callExt(b, "js_get", [tgtObj, emitStr(b, slot)])
            callExt(b, "js_call", [ctorV, hUndef, argsV])
            return b
        }
    }
    function makeField(items) {
        var mods = items[0].mods
        var ty = items[1].ty
        var name = items[2]
        var init = items.length > 3 ? items[3] : null
        var isStatic = false
        for (var i = 0; i < mods.length; i++) if (mods[i] == "static") isStatic = true
        var dflt = 0
        if (ty == "boolean") dflt = 2 // The handle constants: 2 false, 1 null.
        if (ty != "int" && ty != "boolean") dflt = 1
        if (ty.indexOf("[") >= 0) dflt = 1
        return {kind: "field", name: name, statik: isStatic, init: init, dfltH: dflt, isInt: ty == "int"}
    }
    function fieldDefault(b, f) {
        if (f.isInt) return emitNum(b, 0)
        return handle(f.dfltH)
    }

    // Emits one method/ctor as jsf_N(env, args). For instance functions args[0] is this.
    // fields != null marks a constructor: the field initializers run before the body.
    // The class whose body is currently being built (for super calls).
    var curClassName = ""

    // isCtl marks a try/catch body closure: a return/break/continue leaving it emits a
    // control signal instead of a ret/br (see compile-core inCtlBody / excDispatch).
    function emitFunc(params, body, isInstance, fields, recordParams, superName, isCtl, preBody) {
        funcCount++
        var idx = funcCount
        var f = m.NewFunc("jsf_" + idx, i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var savedF = curF
        var savedScope = curScopeV
        var savedLoops = loopStack
        var savedTag = curFTag
        curF = f
        curFTag = idx
        loopStack = []
        if (isCtl) { ctlEnter(idx) }
        var b = f.NewBlock("entry")
        curScopeV = callExt(b, "js_scope_new", [f.Params[0]])
        var off = 0
        if (isInstance) {
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "this"), callExt(b, "js_arg", [f.Params[1], handle(0)])])
            off = 1
        }
        for (var i = 0; i < params.length; i++) {
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, params[i]),
                                         callExt(b, "js_arg", [f.Params[1], handle(i + off)])])
        }
        if (superName != undefined && superName != null) {
            // The implicit super(): run the whole parent constructor without arguments.
            var supClsV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, superName)])
            var supCtorV = callExt(b, "js_get", [supClsV, emitStr(b, "__ctor")])
            var sargsV = callExt(b, "js_arr_new", [])
            callExt(b, "js_arr_push", [sargsV, callExt(b, "js_scope_get", [curScopeV, emitStr(b, "this")])])
            callExt(b, "js_call", [supCtorV, hUndef, sargsV])
        }
        // An explicit super(args) / this(args) runs BEFORE the field initializers,
        // exactly where Java puts it (and instead of the implicit super above).
        if (preBody != undefined && preBody != null) { b = preBody(b) }
        if (fields != null) {
            var thisV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, "this")])
            for (var k = 0; k < fields.length; k++) {
                if (fields[k].initblock != undefined) {
                    b = fields[k].initblock(b)
                    thisV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, "this")])
                }
                var fv
                if (fields[k].initblock != undefined) {
                    fv = hUndef
                } else if (fields[k].init != null && fields[k].init != undefined) {
                    var r = fields[k].init(b)
                    b = r.b
                    fv = r.v
                } else {
                    fv = fieldDefault(b, fields[k])
                }
                if (fields[k].initblock == undefined) {
                    callExt(b, "js_set", [thisV, emitStr(b, fields[k].name), fv])
                }
            }
            if (recordParams != undefined) {
                for (var k2 = 0; k2 < recordParams.length; k2++) {
                    callExt(b, "js_set", [thisV, emitStr(b, recordParams[k2]),
                                          callExt(b, "js_arg", [f.Params[1], handle(k2 + 1)])])
                }
            }
        }
        var endB = body != null ? body(b) : b
        endB.NewRet(hUndef)
        if (isCtl) { ctlLeave() }
        curF = savedF
        curScopeV = savedScope
        loopStack = savedLoops
        curFTag = savedTag
        return idx
    }
    // A record accessor: return this.f
    function emitAccessor(fname) {
        funcCount++
        var idx = funcCount
        var f = m.NewFunc("jsf_" + idx, i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var b = f.NewBlock("entry")
        var thisV = b.NewCall(getExtern("js_arg", 2), [f.Params[1], handle(0)])
        b.NewRet(b.NewCall(getExtern("js_get", 2), [thisV, emitStr(b, fname)]))
        return idx
    }

    // Every class / record / interface / enum this compile declares, by name. It
    // decides whether a superclass name can be resolved to an emitted descriptor
    // (so an explicit super(args) may target its "__ctor#<n>" slot) and whether a
    // supertype is an interface (which has no constructor to chain to).
    var classNames = {}
    var interfaceNames = {}

    // The constructor dispatcher of an OVERLOADED class: __ctor(args) picks the
    // "__ctor#<n>" slot matching the argument count (args[0] is the instance, so n
    // is length - 1). Java resolves overloads by static types; the subset has none,
    // so arity is the discriminator - which is what every overload in practice
    // differs by here.
    function emitCtorDispatch(clsName, arities) {
        funcCount++
        var idx = funcCount
        var f = m.NewFunc("jsf_" + idx, i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var savedF = curF
        var savedScope = curScopeV
        var savedLoops = loopStack
        var savedTag = curFTag
        curF = f
        curFTag = idx
        loopStack = []
        var b = f.NewBlock("entry")
        curScopeV = callExt(b, "js_scope_new", [f.Params[0]])
        var clsV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, clsName)])
        var nV = callExt(b, "js_get", [f.Params[1], emitStr(b, "length")])
        for (var i = 0; i < arities.length; i++) {
            var hitB = curF.NewBlock("")
            var nextB = curF.NewBlock("")
            b.NewCondBr(truthy(b, callExt(b, "js_seq", [nV, emitNum(b, arities[i] + 1)])), hitB, nextB)
            var cV = callExt(hitB, "js_get", [clsV, emitStr(hitB, "__ctor#" + arities[i])])
            hitB.NewRet(callExt(hitB, "js_call", [cV, hUndef, f.Params[1]]))
            b = nextB
        }
        b.NewRet(hUndef)
        curF = savedF
        curScopeV = savedScope
        loopStack = savedLoops
        curFTag = savedTag
        return idx
    }
    // A record's value equality: same class descriptor and every component ===.
    function emitRecordEquals(clsName, comps) {
        var body = function(b) {
            var thisV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, "this")])
            var otherV = callExt(b, "js_arg", [curF.Params[1], handle(1)])
            var okV = callExt(b, "js_seq", [callExt(b, "js_get", [thisV, emitStr(b, "__class")]),
                                            callExt(b, "js_get", [otherV, emitStr(b, "__class")])])
            for (var i = 0; i < comps.length; i++) {
                var kV = emitStr(b, comps[i])
                var eqV = callExt(b, "js_seq", [callExt(b, "js_get", [thisV, kV]),
                                                callExt(b, "js_get", [otherV, kV])])
                okV = callExt(b, "js_jband", [okV, eqV])
            }
            b.NewRet(okV)
            return deadBlock()
        }
        return emitFunc([], body, true, null, undefined, null)
    }

    function buildClassStmt(name, members, recordParams) {
        classNames["$" + name] = true
        return function(b) {
            var clsV = callExt(b, "js_obj_new", [])
            callExt(b, "js_set", [clsV, emitStr(b, "__isclass"), hTrue])
            callExt(b, "js_set", [clsV, emitStr(b, "__name"), emitStr(b, name)])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, name), clsV])
            var fields = []
            var ctors = []
            var superName = null
            var impls = []
            var i
            for (i = 0; i < members.length; i++) {
                if (members[i].ext != undefined) { superName = baseTypeName(members[i].ext) }
                if (members[i].impls != undefined) {
                    for (var q = 0; q < members[i].impls.length; q++) {
                        var iname = baseTypeName(members[i].impls[q])
                        if (interfaceNames["$" + iname] == true) { impls.push(iname) }
                    }
                }
            }
            // With no superclass the FIRST implemented interface takes the __super
            // slot, so its defaults are reachable and `instanceof I` holds; the
            // others have their default methods copied in below.
            var chained = superName
            if (chained == null && impls.length > 0) { chained = impls[0] }
            if (chained != null) {
                callExt(b, "js_set", [clsV, emitStr(b, "__super"),
                                      callExt(b, "js_scope_get", [curScopeV, emitStr(b, chained)])])
            }
            for (i = 0; i < members.length; i++) {
                var mm = members[i]
                if (mm.kind == "field") {
                    if (mm.statik) {
                        var sv
                        if (mm.init != null && mm.init != undefined) {
                            var r = mm.init(b)
                            b = r.b
                            sv = r.v
                        } else {
                            sv = fieldDefault(b, mm)
                        }
                        callExt(b, "js_set", [clsV, emitStr(b, mm.name), sv])
                    } else {
                        fields.push(mm)
                    }
                }
                if (mm.kind == "staticinit") { b = mm.body(b) }
                if (mm.kind == "initblock") { fields.push({initblock: mm.body}) }
                if (mm.kind == "ctor") { ctors.push(mm) }
            }
            // A record's canonical constructor takes the components as parameters,
            // runs the compact body (which may reassign them) and then copies them
            // onto the instance - the exact order the JLS gives a compact
            // constructor. A record without one gets the same shape with no body.
            var canon = null
            if (recordParams != undefined) {
                for (i = 0; i < ctors.length; i++) {
                    if (ctors[i].compact) { canon = ctors[i]; ctors[i].params = recordParams }
                }
                if (canon == null) {
                    canon = {kind: "ctor", compact: true, name: name, params: recordParams, body: null, deleg: null}
                    ctors.push(canon)
                }
                var comps = recordParams
                var canonBody = canon.body
                canon.body = function(bb) {
                    if (canonBody != null) { bb = canonBody(bb) }
                    var tV = callExt(bb, "js_scope_get", [curScopeV, emitStr(bb, "this")])
                    for (var q = 0; q < comps.length; q++) {
                        callExt(bb, "js_set", [tV, emitStr(bb, comps[q]),
                                               callExt(bb, "js_scope_get", [curScopeV, emitStr(bb, comps[q])])])
                    }
                    return bb
                }
            }
            if (ctors.length == 0) {
                ctors.push({kind: "ctor", name: name, params: [], body: null, deleg: null})
            }
            // Every constructor gets its own "__ctor#<arity>" slot; __ctor is that
            // one closure when there is a single constructor and the arity
            // dispatcher when the class is overloaded.
            var arities = []
            var ctorClos = []
            for (i = 0; i < ctors.length; i++) {
                var ci = ctors[i]
                var pre = undefined
                var sup = superName
                var flds = fields
                if (ci.deleg != null && ci.deleg != undefined) {
                    pre = emitDelegCall(ci.deleg, name, superName)
                    sup = null
                    if (ci.deleg.deleg == "this") { flds = null }
                }
                if (sup != null && interfaceNames["$" + sup] == true) { sup = null }
                var cidx = emitFunc(ci.params, ci.body, true, flds, undefined, sup, false, pre)
                var cclo = callExt(b, "js_closure", [handle(cidx), curScopeV])
                callExt(b, "js_set", [clsV, emitStr(b, "__ctor#" + ci.params.length), cclo])
                arities.push(ci.params.length)
                ctorClos.push(cclo)
            }
            if (ctors.length == 1) {
                callExt(b, "js_set", [clsV, emitStr(b, "__ctor"), ctorClos[0]])
            } else {
                var didx = emitCtorDispatch(name, arities)
                callExt(b, "js_set", [clsV, emitStr(b, "__ctor"),
                                      callExt(b, "js_closure", [handle(didx), curScopeV])])
            }
            var declared = {}
            for (i = 0; i < members.length; i++) {
                var m2 = members[i]
                if (m2.kind == "method") {
                    declared["$" + m2.name] = true
                    var idx = emitFunc(m2.params, m2.body, !m2.statik, null, undefined)
                    callExt(b, "js_set", [clsV, emitStr(b, m2.name), callExt(b, "js_closure", [handle(idx), curScopeV])])
                }
            }
            // Default methods of every implemented interface that is NOT the one on
            // the __super chain: copied in, so a class implementing two interfaces
            // answers both their defaults. A method the class declares itself wins.
            for (i = 0; i < impls.length; i++) {
                if (impls[i] == chained) { continue }
                var inames = interfaceMethodNames["$" + impls[i]]
                if (inames == undefined) { continue }
                var ifV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, impls[i])])
                for (var w = 0; w < inames.length; w++) {
                    if (declared["$" + inames[w]] == true) { continue }
                    callExt(b, "js_set", [clsV, emitStr(b, inames[w]),
                                          callExt(b, "js_get", [ifV, emitStr(b, inames[w])])])
                }
            }
            // Record accessors and value equality, unless the body declares its own.
            if (recordParams != undefined) {
                for (i = 0; i < recordParams.length; i++) {
                    if (declared["$" + recordParams[i]] == true) { continue }
                    var aidx = emitAccessor(recordParams[i])
                    callExt(b, "js_set", [clsV, emitStr(b, recordParams[i]), callExt(b, "js_closure", [handle(aidx), curScopeV])])
                }
                if (declared["$equals"] != true) {
                    var eqidx = emitRecordEquals(name, recordParams)
                    callExt(b, "js_set", [clsV, emitStr(b, "equals"), callExt(b, "js_closure", [handle(eqidx), curScopeV])])
                }
            }
            return b
        }
    }
    function makeClassStmt(items) {
        return buildClassStmt(items[0], items.slice(1), undefined)
    }
    function makeRecordStmt(items) {
        return buildClassStmt(items[0], items.slice(2), items[1].rparams)
    }

    // ----- Interfaces -----
    // Per interface: the names of its concrete (default / static / private) methods,
    // so an implementor can copy them in, and the names of its abstract methods, so a
    // one-method interface can be recognized as functional (SAM conversion).
    var interfaceMethodNames = {}
    var interfaceAbstracts = {}
    function makeInterfaceStmt(items) {
        var name = items[0]
        var members = []
        var supers = []
        var meths = []
        var abstracts = []
        for (var i = 1; i < items.length; i++) {
            var it = items[i]
            if (typeof it == "string") { supers.push(baseTypeName(it)); continue }
            if (it.kind == "abstract") { abstracts.push({name: it.name, n: it.params.length}); continue }
            if (it.kind == "method") { meths.push(it.name) }
            // An interface field is implicitly public static final.
            if (it.kind == "field") { it.statik = true }
            members.push(it)
        }
        interfaceNames["$" + name] = true
        classNames["$" + name] = true
        // Inherited defaults count as this interface's own for an implementor.
        for (var s = 0; s < supers.length; s++) {
            var inh = interfaceMethodNames["$" + supers[s]]
            if (inh == undefined) { continue }
            for (var k = 0; k < inh.length; k++) { meths.push(inh[k]) }
        }
        interfaceMethodNames["$" + name] = meths
        interfaceAbstracts["$" + name] = abstracts
        if (supers.length > 0) { members = [{ext: supers[0]}].concat(members) }
        return buildInterfaceStmt(name, members)
    }
    // The descriptor of an interface: like a class, minus the constructor.
    function buildInterfaceStmt(name, members) {
        var inner = buildClassStmt(name, members, undefined)
        return inner
    }

    // ----- Anonymous classes -----
    var anonCount = 0
    function makeNewAnon(items, pos) {
        var baseName = items[0]
        var args = []
        var members = []
        for (var i = 1; i < items.length; i++) {
            if (typeof items[i] == "function") { args.push(items[i]) } else { members.push(items[i]) }
        }
        anonCount++
        var aname = "Anon$" + anonCount
        var mem = [{ext: baseName}]
        if (args.length > 0) {
            // Forward the arguments to the base constructor: the anonymous class's own
            // constructor takes them positionally and delegates with super(...).
            var ps = []
            var dargs = []
            for (var k = 0; k < args.length; k++) {
                ps.push("$a" + k)
                dargs.push(makeVarRef("$a" + k))
            }
            mem.push({kind: "ctor", name: aname, params: ps, body: null,
                      deleg: {deleg: "super", dargs: dargs}})
        }
        for (var j = 0; j < members.length; j++) { mem.push(members[j]) }
        var clsStmt = buildClassStmt(aname, mem, undefined)
        var newT = makeNew([aname].concat(args))
        return function(b) {
            b = clsStmt(b)
            return newT(b)
        }
    }
    // Iface.super.m(args): call that interface's default method with this as receiver.
    function makeQSuperCall(items) {
        var iname = items[0]
        var mname = ""
        var args = []
        for (var i = 1; i < items.length; i++) {
            if (items[i].mname != undefined) { mname = items[i].mname } else { args.push(items[i]) }
        }
        return function(b) {
            var ifV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, iname)])
            var fnV = callExt(b, "js_get", [ifV, emitStr(b, mname)])
            var argsV = callExt(b, "js_arr_new", [])
            callExt(b, "js_arr_push", [argsV, callExt(b, "js_scope_get", [curScopeV, emitStr(b, "this")])])
            for (var i = 0; i < args.length; i++) {
                var r = args[i](b)
                b = r.b
                callExt(b, "js_arr_push", [argsV, r.v])
            }
            return {b: b, v: callExt(b, "js_call", [fnV, hUndef, argsV])}
        }
    }

    // The program: jsmain(env, args) builds System, the classes, then calls Main.main.
    function buildMain(items) {
        // The walk of an imported file ends here too: stash its class
        // statements for the real jsmain instead of emitting a second one.
        if (importDepth > 0) {
            stashImported(items) // stashed with its file; emitted later (compile-core)
            return
        }
        var f = m.NewFunc("jsmain", i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        curF = f
        var b = f.NewBlock("entry")
        curScopeV = callExt(b, "js_scope_new", [f.Params[0]])
        // System.out.println / System.out.print / System.exit from the host globals.
        var sysV = callExt(b, "js_obj_new", [])
        var outV = callExt(b, "js_obj_new", [])
        callExt(b, "js_set", [outV, emitStr(b, "println"), callExt(b, "js_scope_get", [curScopeV, emitStr(b, "println")])])
        callExt(b, "js_set", [outV, emitStr(b, "print"), callExt(b, "js_scope_get", [curScopeV, emitStr(b, "print")])])
        callExt(b, "js_set", [sysV, emitStr(b, "out"), outV])
        callExt(b, "js_set", [sysV, emitStr(b, "exit"), callExt(b, "js_scope_get", [curScopeV, emitStr(b, "exit")])])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "System"), sysV])
        b = emitImported(b)
        b = makeSeq(items)(b)
        // The entry defaults to Main.main but -main (c.mainName) can name another static
        // method of Main.
        var entry = c.mainName
        if (entry == undefined || entry == "") { entry = "main" }
        if (mainIsSnippet(entry)) {
            b = emitMainSnippet(b, entry, "Statement")
            b.NewRet(emitNum(b, 0))
        } else {
            var mainCls = callExt(b, "js_scope_get", [curScopeV, emitStr(b, "Main")])
            var mainV = callExt(b, "js_get", [mainCls, emitStr(b, entry)])
            var argsV = callExt(b, "js_arr_new", [])
            callExt(b, "js_arr_push", [argsV, callExt(b, "js_arr_new", [])])
            b.NewRet(callExt(b, "js_call", [mainV, hUndef, argsV]))
        }
    }

    c.compile(c.asg)

    println(m)

    var res = llvm.RunJS(m, "jsmain")
    var entryName = c.mainName
    if (entryName == undefined || entryName == "") { entryName = "main" }
    if (mainIsSnippet(entryName)) {
        println("java compiler: -main snippet returned " + res.Ret)
    } else {
        println("java compiler: " + entryName + "() returned " + res.Ret)
    }
    exit(res.Ret)

~~) ;
