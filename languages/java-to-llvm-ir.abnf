// that file. The scan stops at the line start, which no string literal crosses.
UniBS       = :script(~~
    (function() {
        var i = -1
        var seen = false
        var n = 0
        while (n < 4000) {
            var ch = c.peek(i)
            if (ch < 0 || ch === 10 || ch === 13) { n = 4000 }
            else {
                if (ch === 92 && c.peek(i + 1) === 117 && c.peek(i + 2) === 48 && c.peek(i + 3) === 48
                    && c.peek(i + 4) === 53 && (c.peek(i + 5) === 99 || c.peek(i + 5) === 67)) { seen = true }
                i--
                n++
            }
        }
        return seen ? undefined : abnf.newToken("\x01no-unicode-backslash", 0)
    })()
~~) ;

// A text block """ ... """ ; the !'"""' lookahead lets single and double quotes appear
// inside without ending the block. Whitespace is disabled inside so newlines are content.
TextBlock   <~~ push(makeConst(textBlock(up.in))) ~~>
            = '"""' TBOpen :whitespace() { !'"""' TBItem } '"""' :whitespace(Whitespace) ;
TBItem      = "\\" "\x00"..."\U0010ffff" | "\x00"..."\U0010ffff" ;
// Hex / binary: the 0x / 0b prefix is distinctive, so these never shadow a decimal int.
// A hex literal may carry a p-exponent (0x1p4 == 16.0, a hexadecimal double).
HexLit      <~~ push(makeNumConst(numLit(up.in, 16))) ~~>
