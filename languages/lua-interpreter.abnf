            var i = anytype // The control value, an integer or a float.
            i = luaFirst(startT())
            var limit = luaFirst(limitT())
            var step = anytype // The increment, 1 when the loop did not spell one out.
            step = stepT != null ? luaFirst(stepT()) : 1
            var stp = numOf(step)
            scopes.push({})
            var res = undefined
            // luaCmp, not a comparison of the double readings: an integer loop that runs
            // near math.maxinteger has to stop on the exact value, not on the rounded one.
            while (stp > 0 ? luaCmp("<=", i, limit) : luaCmp(">=", i, limit)) {
                scopes[scopes.length - 1][name] = i
                var r = block()
                if (r != undefined) {
                    if (r === BRK) { break }
                    if (r !== CONT) { res = r; break }
                }
                // The step WRAPS at 64 bits now that an integer really is one, so a loop
                // whose limit is math.maxinteger would step from it to math.mininteger
                // and run forever. Real Lua cannot: it precomputes the iteration count.
                // The same stop, expressed on the values themselves - a step that does
                // not move the control variable in the step's own direction has
                // overflowed, and the loop is over.
                var nxt = anytype // The next control value, before the overflow test.
                nxt = luaArith("+", i, step)
                if (stp > 0 ? luaCmp("<=", nxt, i) : luaCmp(">=", nxt, i)) { break }
                i = nxt
            }
            scopes.pop()
            return res
        }
    }
    // repeat body until cond: the body runs, then cond is tested in the body's own scope;
    // it loops while cond is falsy, so the body always runs at least once.
    function makeRepeat(block, cond) {
        return function() {
            var res = undefined
            var running = true
            while (running) {
                var depth = scopes.length
                scopes.push({})
                seqTrim = false // The until condition still needs the body's locals.
                var r = block()
                var brk = false
                if (r != undefined && r === BRK) { brk = true }
                if (r != undefined && r !== BRK && r !== CONT) { res = r; brk = true }
                if (brk) { running = false }
                else if (luatruthy(cond())) { running = false }
                while (scopes.length > depth) { scopes.pop() }
            }
            return res
        }
    }
    // Generic for, in its full Lua form: the expression list yields the iterator TRIPLE
    // (function, state, initial control value), and each pass calls f(state, control).
    // The loop ends when the first returned value is nil; otherwise that value becomes
    // the next control value and the returned values are bound to the loop names. ipairs
    // and pairs are ordinary global functions returning such a triple, so a hand-written
    // iterator - stateless or a closure - drives the loop exactly the same way.
    // items = [{gname}..., iterExprThunk..., blockThunk]; the block is always last.
    function makeGenFor(items) {
        var names = []
        var exprs = []
        var block = items[items.length - 1]
        for (var i = 0; i < items.length - 1; i++) {
            if (typeof items[i] == "function") { exprs.push(items[i]) }
            else { names.push(items[i].gname) }
        }
        return function() {
            var vs = evalList(exprs)
            var f = anytype // The iterator function.
            var st = anytype // The invariant state.
            var ctl = anytype // The control value, updated every pass.
            f = vs.length > 0 ? vs[0] : undefined
            st = vs.length > 1 ? vs[1] : undefined
            ctl = vs.length > 2 ? vs[2] : undefined
            if (typeof f != "function") { fail("attempt to call a " + luaType(f) + " value") }
            scopes.push({})
            var frame = scopes[scopes.length - 1]
            var res = undefined
            var running = true
            while (running) {
                var all = luaAll(f(st, ctl))
                var head = anytype // The first returned value: nil ends the loop.
                head = all.length > 0 ? all[0] : undefined
                if (head === undefined || head === null) { running = false }
                else {
                    ctl = head
                    for (var n = 0; n < names.length; n++) { frame[names[n]] = n < all.length ? all[n] : undefined }
                    var r = block()
                    if (r != undefined) {
                        if (r === BRK) { running = false }
                        else if (r !== CONT) { res = r; running = false }
                    }
                }
            }
            scopes.pop()
            return res
        }
    }
    function makeDoBlock(block) {
        return function() {
            scopes.push({})
            var r = block()
            scopes.pop()
            return r
        }
    }
    // return e1, e2, ...: all the values travel back, the last expression expanding, so
    // 'return f()' propagates everything f returned (Lua's tail-call value rule).
    function makeReturn(items) {
        return function() { return {isRet: true, v: mkMulti(evalList(items))} }
    }

    // buildChunk runs the whole program (one seq thunk). The test calls exit(fails)
    // itself; if it does not, the run falls through to the exit(0) below.
    function buildChunk(items) { items[0]() }

    // ----- Core library config (see lib/interp-core.js) -----
    core.lang = "lua"
    core.test = luatruthy
    // A bare assignment to a name that is nowhere in scope creates a global.
    core.setMiss = function(name, value) { globalScope[name] = value; return true }
    // Reading a name that is nowhere in scope is not an error in Lua: an unset global
    // simply reads as nil.
    core.varMiss = function(name) { return {v: undefined} }

    // The host names a program can see.
    globalScope["print"] = function() {
        var out = ""
        for (var i = 0; i < arguments.length; i++) {
            if (i > 0) { out += "\t" }
            out += luaToStr(arguments[i])
        }
        // The byte string is decoded back to host text here, at the one place it leaves
        // the program (see the byte-string note above luaUtf8).
        println(luaOut(out))
    }
    globalScope["exit"] = function(code) { exit(numOf(code) | 0) }

    // next(t [, k]): the table iterator, walking the table's own keys in insertion order
    // (the hidden __keys list) and skipping the ones whose value is nil. It returns the
    // key AND its value, and nil once the table is exhausted - which is exactly what the
    // generic for expects, so pairs(t) is next plus the table.
    function luaNext(t, k) {
        if (!isTbl(t)) {
            fail("bad argument to 'next' (table expected, got " + luaType(t) + ")")
        }
        var keys = hasOwn(t, "__keys") ? t.__keys : []
        var i = 0
        if (k !== undefined && k !== null) {
            var kk = luaKey(k)
            while (i < keys.length && keys[i] !== kk) { i = i + 1 }
            i = i + 1
        }
        while (i < keys.length) {
            var v = anytype // The value at the candidate key.
            v = luaIndex(t, keys[i])
            if (v !== undefined && v !== null) { return mkMulti([luaKeyBack(keys[i]), v]) }
            i = i + 1
        }
        return undefined
    }
    // The keys are stored in their string form (that is how the map addresses them), so
    // an iteration hands a numeric key back as the number it was written as - t[1] is
    // reached by the integer 1, not by "1".
    function luaKeyBack(kk) {
        var n = anytype // The key read back as a number, when it spells one.
        n = luaNumVal(kk)
        if (n !== undefined && luaKey(n) === kk) { return n }
        return kk
    }
    globalScope["next"] = luaNext
    globalScope["pairs"] = function(t) { return mkMulti([luaNext, t, undefined]) }
    // ipairs(t): the 1-based array walk, as the same kind of triple - its iterator counts
    // the control value up and stops at the first nil element.
    function luaINext(t, i) {
        var nk = numOf(i) + 1
        var v = anytype // The element at the next index.
        v = luaIndex(t, nk)
        if (v === undefined || v === null) { return undefined }
        return mkMulti([nk, v])
    }
    globalScope["ipairs"] = function(t) { return mkMulti([luaINext, t, 0]) }

    // math.*: a small numeric library backed by JS Math (floor/abs/max/min, plus ceil
    // derived from floor so no host Math.ceil is required in frozen mode).
    // floor/ceil answer an integer (Lua does too); abs/max/min keep their argument's
    // number subtype, so math.abs(-1.0) stays a float.
    // math.type / math.tointeger / math.maxinteger / math.mininteger are the four names
    // through which Lua 5.3+ makes the integer subtype visible to a program, so they
    // belong with it: math.type(3) is "integer", math.type(3.0) is "float" and
    // math.type("3") is nil (a string is not a number at all).
    globalScope["math"] = {
        // floor/ceil answer an INTEGER. An operand that already is one is handed back
        // untouched - Math.floor of math.maxinteger would round it.
        floor: function(x) { if (isInt(x)) { return x } return Math.floor(numOf(x)) },
        ceil: function(x) { if (isInt(x)) { return x } return 0 - Math.floor(0 - numOf(x)) },
        abs: function(x) { return numOf(x) < 0 ? luaArith("-", 0, x) : x },
        // max/min keep the WINNING argument, so the subtype survives - and the tie
        // goes to the FIRST one, which is real Lua's rule (its loop replaces the
        // running best only on a strict '<'), so math.max(1, 1.0) is the integer 1.
        max: function(a, b) { return luaCmp("<", a, b) ? b : a },
        min: function(a, b) { return luaCmp("<", b, a) ? b : a },
        type: function(x) {
            if (isInt(x)) { return "integer" }
            if (isNum(x)) { return "float" }
            return undefined
        },
        // math.tointeger(x): the integer x names, or nil when it names none - a
        // non-integral float, a float outside the 64 bit range, and any value that is
        // not a number at all. A STRING that spells a number does convert
        // (math.tointeger("8") is 8, verified against lua 5.5), because it goes through
        // the same coercion the arithmetic operators use.
        tointeger: function(x) {
            var a = anytype // The argument after Lua's string coercion.
            a = toNumV(x)
            if (a === undefined) { return undefined }
            if (isInt(a)) { return a }
            var n = numOf(a)
            if (n - n !== 0 || Math.floor(n) !== n) { return undefined }
            return luaI64(n)
        },
        // math.fmod keeps C's fmod: the remainder takes the sign of the DIVIDEND, which
        // is where it differs from the '%' operator.
        fmod: function(a, b) {
            if (isInt(a) && isInt(b)) {
                if (szEq(b, 0)) { fail("bad argument #2 to 'fmod' (zero)") }
                return szArith("%", a, b)
            }
            return mkFlt(numOf(a) % numOf(b))
        },
        maxinteger: luaMaxInt(),
        mininteger: luaMinInt()
    }

    // One end of a Lua string range, normalised to an inclusive 1-based index.
    // i < 0 counts from the end (-1 = last), i == 0 means "before the first". The
    // start clamps up to 1 and the end clamps down to len; a start past the end then
    // yields the empty string, which is what Lua returns rather than an error.
    function luaSubStart(len, i) {
        var a = i
        if (a < 0) { a = len + a + 1 }
        if (a < 1) { a = 1 }
        return a
    }
    function luaSubEnd(len, j) {
        var e = j
        if (e < 0) { e = len + e + 1 }
        if (e > len) { e = len }
        return e
    }

    // string.*: 1-based, matching Lua. rep(s, n) concatenates n copies.
    //
    // sub(s, i, j) is NOT JS slice(i-1, j). Lua's negative index counts from the end
    // INCLUSIVELY and 1-based - -1 is the last character, so it normalises to len+i+1,
    // not to len+i - and both ends are then clamped into 1..len rather than reinterpreted.
    // Passing i-1 straight to slice got every negative case wrong by one in both
    // directions: ("hello"):sub(-3) answered "ello" where Lua answers "llo", and
    // ("hello"):sub(2, -2) answered "e" where Lua answers "ell". luaSubRange is the
    // normalisation on its own so the compiler half's lua_subi / lua_subj helpers can
    // implement exactly the same three steps.
    globalScope["string"] = {
        len: function(s) { return s.length },
        // ASCII only: real Lua case-maps with the C library in the C locale, which leaves
        // every byte above 127 alone. The host toUpperCase would have mapped the BYTES of
        // a multi-byte character (the 0xE6 that starts a CJK character is 'ae' to a host
        // string, and uppercases to 0xC6), corrupting the encoding.
        upper: function(s) { return asciiCase(s, true) },
        lower: function(s) { return asciiCase(s, false) },
        sub: function(s, i, j) {
            var str = "" + s
            var len = str.length
            var a = luaSubStart(len, numOf(i))
            var e = luaSubEnd(len, j === undefined ? -1 : numOf(j))
            if (a > e) { return "" }
            return str.slice(a - 1, e)
        },
        rep: function(s, n) {
            var out = ""
            var k = 0
            var cnt = numOf(n)
            while (k < cnt) { out = out + s; k = k + 1 }
            return out
        }
    }

    // table.*: insert appends at the sequence border (#t + 1); remove drops and returns
    // the last element (setting its slot to nil so #t shrinks).
    globalScope["table"] = {
        insert: function(t, v) {
            var n = luaLen(t)
            luaRawSet(t, "" + (n + 1), v)
        },
        remove: function(t) {
            var n = luaLen(t)
            if (n === 0) { return undefined }
            var val = anytype // The removed element.
            val = luaIndex(t, n)
            luaRawSet(t, "" + n, undefined)
            return val
        }
    }

    // ----- Project-file imports (see the Require rule) -----
    function luaImport(items, pos) {
        resolveImport(items[items.length - 1], pos)
        return function() { return undefined }
    }
    // Lua stdlib libraries the runtime already provides; require of one is a no-op.
    core.stdlibImports = ["string", "table", "math", "io", "os", "coroutine"]
    // Load the file and compile it; the imported chunk runs itself (buildChunk), registering
    // its functions in the shared global scope before the main chunk runs. Required once; a
    // leading './' is dropped and a missing '.lua' extension appended before the -i search.
    var importedFiles = {}
    core.importFile = function(path, pos) {
        var rel = path
        if (rel.length >= 2 && rel.charAt(0) == "." && rel.charAt(1) == "/") { rel = rel.substring(2) }
        if (!(rel.length >= 4 && rel.substring(rel.length - 4) == ".lua")) { rel = rel + ".lua" }
        var file = c.findImport(rel)
        if (file == "") { return false }
        if (importedFiles["$" + file] == true) { return true }
        importedFiles["$" + file] = true
        var text = c.readFile(file)
        var asg = c.parse(c.agrammar, text, null, file)
        c.pushSource(file, text)
        c.compile(asg)
        c.popSource()
        return true
    }

    c.compile(c.asg)

    println("lua interpreter: program ran to completion")
    exit(0)

~~) ;
