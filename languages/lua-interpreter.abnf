:title("Lua interpreter") ;
:description("Parses Lua and executes it directly, tree walking, without generating code.

The language: local variables (local x, local a, b = 1, 2, with the 5.4 attributes
const and close accepted) and auto-global assignment (a bare 'x = e' assigns an existing
variable up the scope chain, else creates a global; an unset global reads as nil), the
full literal syntax (decimal, hexadecimal and hexadecimal-float numbers, single and
double quoted strings with all of Lua's escapes, long brackets of any level for strings
and for comments), Lua 5.3's two number subtypes - integers and floats are distinct, so
1 renders as 1 and 1.0 as 1.0, a division is always a float and 7 // 2 stays an integer,
string concatenation with .. , arithmetic + - * / (true division) // (floor division)
% (floor modulo) ^ (float power) with the automatic string coercion, the bitwise
operators and or xor not and the two shifts on 64-bit integers, comparisons == ~= < >
<= >= , and / or / not with Lua truthiness (only false and nil are falsy; 0 and the
empty string are true) and operand values, if cond then ... elseif ... else ... end,
while cond do ... end, numeric for i = a, b [, step] do ... end, the generic for over
the full iterator protocol (a triple of function, state and control value, which is what
ipairs, pairs and any hand-written iterator return), repeat ... until cond, goto and
::labels::, functions (function f(a, b) ... end, function tbl.field and the method sugar
function tbl:m() with an implicit self, local function, function expressions, closures
over their defining scope) with return, break, varargs and multiple return values (a
call and ... expand in a list position and truncate to one value elsewhere), method
calls obj:m(args) (the receiver is passed as self), the parenthesis-free call forms
f 'str' and f {tbl}, tables as arrays and maps ({} , {1, 2, 3} , {x = 1} , t.x , t[k] ,
1 based array indexing), the length operator #t (the sequence border of a table), and
print.

Errors are Lua's: error(v [, level]) with the chunk:line position of its level,
pcall and xpcall, and every runtime error catchable the same way, positioned at the
statement that raised it.

Not in the subset: metatables, coroutines, and the standard library beyond the
base library built below (print, exit and the rest without the metatable, loading
and collector functions), the table library, and the string and math tables
(string.pack/unpack and math.random excepted).

There is no main(): the file simply runs top to bottom. Self checking programs count
their failures and end with exit(fails). The same language with the same semantics is
compiled to LLVM IR by lua-to-llvm-ir.abnf.") ;


// --- main rules

// Shared token productions (languages/lib).
:include("lib/ident.abnf") ;
:include("lib/dq-strings.abnf") ;
:include("lib/numbers.abnf") ;
:include("lib/bools.abnf") ;

:startRule(Chunk) ;
:whitespace(Whitespace) ;

// The whole file is one block; buildChunk runs it (interpreter) or wraps it into
// jsmain (compiler). Block collects the statement thunks of exactly its own subtree.
Chunk       <~~ buildChunk(takeAll()) ~~>
            = [ ShebangLine ] Block ;
// Lua drops a FIRST line that starts with '#', so a chunk can carry a '#!/usr/bin/lua'
// line (lua-tests/all.lua) or a plain '# comment' one (lua-tests/main.lua). Anywhere else
// '#' is the length operator, so AtFileStart pins this to offset 0: c.peek answers -1 out
// of range, and only at offset 0 is there no byte before us.
ShebangLine = AtFileStart "#" :whitespace() { NotNewline } :whitespace(Whitespace) ;
AtFileStart = :script(~~
    (function() {
        if (c.peek(-1) >= 0) { return abnf.newToken("\x01not-file-start", 0) }
    })()
~~) ;
Block       <~~ push(makeSeq(takeAll())) ~~>
            = { NotEnders Statement } ;

// NotEnders stops a block at the keywords that terminate it (end / else / elseif /
// until), which the plain identifier statements would otherwise swallow. It consumes
// nothing and only fails (via the impossible-token trick) when one of those words - as
// a whole word, not merely a prefix like 'ending' - is next.
NotEnders = :script(~~
    (function() {
        // Skip the blanks and BOTH comment forms. A long comment --[==[ ... ]==] runs
        // to a closing bracket of its own level and may span lines and hold ']]', so it
        // cannot be treated as a '--' line comment.
        var off = 0
        var scanning = true
        while (scanning) {
            var wc = c.peek(off)
            if (wc === 32 || wc === 9 || wc === 13 || wc === 10) { off = off + 1 }
            else if (wc === 45 && c.peek(off + 1) === 45) {
                var clv = 0
                var e = off + 3
                var isLong = false
                if (c.peek(off + 2) === 91) {
                    while (c.peek(e) === 61) { clv = clv + 1; e = e + 1 }
                    if (c.peek(e) === 91) { isLong = true }
                }
                if (isLong) {
                    var p = e + 1
                    var closing = true
                    while (closing) {
                        var c2 = c.peek(p)
                        if (c2 < 0) { off = p; closing = false }
                        else if (c2 === 93) {
                            var k2 = 0
                            while (c.peek(p + 1 + k2) === 61) { k2 = k2 + 1 }
                            if (k2 === clv && c.peek(p + 1 + k2) === 93) { off = p + k2 + 2; closing = false }
                            else { p = p + 1 }
                        } else { p = p + 1 }
                    }
                } else {
                    off = off + 2
                    while (c.peek(off) !== 10 && c.peek(off) >= 0) { off = off + 1 }
                }
            }
            else { scanning = false }
        }
        var p0 = c.peek(off)
        var after = -1
        var hit = false
        if (p0 === 101) {
            var p1 = c.peek(off + 1)
            var p2 = c.peek(off + 2)
            var p3 = c.peek(off + 3)
            if (p1 === 110 && p2 === 100) {
                after = c.peek(off + 3)
                hit = true
            } else if (p1 === 108 && p2 === 115 && p3 === 101) {
                after = c.peek(off + 4)
                if (after === 105 && c.peek(off + 5) === 102) { after = c.peek(off + 6) }
                hit = true
            }
        } else if (p0 === 117) {
            if (c.peek(off + 1) === 110 && c.peek(off + 2) === 116 && c.peek(off + 3) === 105 && c.peek(off + 4) === 108) {
                after = c.peek(off + 5)
                hit = true
            }
        } else {
            return undefined
        }
        if (!hit) { return undefined }
        if ((after >= 48 && after <= 57) || (after >= 65 && after <= 90) || after === 95 || (after >= 97 && after <= 122)) {
            return undefined
        }
        return abnf.newToken("\x01block-terminator", 0)
    })()
~~) ;

// Every statement production pushes exactly one thunk. The keyword led statements come
// first (they commit on their unique keyword); an assignment is tried before a bare
// call statement, because its targets look like the start of a call until the '='.
Statement   <~~ push(stmtPos(pop())) ~~>
            = If | While | Repeat | NumFor | GenFor | DoBlock | LocalFunc | Local | Func
            | Return | Break | Goto | Label | EmptyStat | Require | AssignStat | CallStat ;

// require "mod" / require("mod"): loads mod.lua (resolveImport -> core.importFile) and runs
// its top level, so its functions register in the shared global scope. A bareword require
// with a string-literal argument; anything else (require as a value, require(expr)) rolls
// back to a normal call. A flat module model (the module's return value is not bound).
Require     <~~ push(luaImport(takeAll(), up.pos)) ~~>
            = "require" KwEnd ( "(" ReqPath ")" | ReqPath ) NoReqSuffix ;
// `require "mod"` is a statement, but `require"tracegc".start()` (lua-tests/all.lua) is an
// ordinary call expression whose RESULT is indexed and called. This guard declines
// the statement form whenever a suffix follows on the same line, so the whole thing falls
// through to CallStat and parses as the call chain it is. It scans only spaces and tabs -
// stopping at a newline is what keeps the next statement's own `::label::` from looking
// like a `:method` suffix of this one.
NoReqSuffix = :script(~~
    (function() {
        var i = 0
        while (i < 4096) {
            var ch = c.peek(i)
            if (ch === 32 || ch === 9) { i++; continue }
            break
        }
        var nx = c.peek(i)
        if (nx === 46 || nx === 91 || nx === 58 || nx === 40) {
            return abnf.newToken("\x01require-has-suffix", 0)
        }
    })()
~~) ;
ReqPath     = ModDq | ModSq ;
ModDq       = '"' :whitespace() { StrEsc | DqPlain } <~~ push(unescapeJs(up.in)) ~~> '"' :whitespace(Whitespace) ;
ModSq       = "'" :whitespace() { StrEsc | SqPlain } <~~ push(unescapeJs(up.in)) ~~> "'" :whitespace(Whitespace) ;

If          <~~ push(makeIf(takeAll())) ~~>
            = KwIf Cond KwThen Block { ElseIf } [ Else ] KwEndKw ;
ElseIf      <~~ push(makeElseIf(pop(), pop())) ~~>
            = KwElseif Cond KwThen Block ;
Else        <~~ push(makeElse(pop())) ~~>
            = KwElse Block ;

While       <~~ push(makeWhile(pop(), pop())) ~~>
            = KwWhile Cond KwDo Block KwEndKw ;
// A condition reads ONE value: a call's first result (luaTrunc).
Cond        <~~ push(luaTrunc(pop(), luaOpnd(up.in))) ~~>
            = Expression ;

// repeat ... until cond: the body runs at least once and repeats while cond is false;
// unlike while, the condition sees the locals declared in the body (same scope).
Repeat      <~~ var cond = pop(); var block = pop(); push(makeRepeat(block, cond)) ~~>
            = KwRepeat Block KwUntil Cond ;

// for i = start, limit [, step] do ... end. The loop variable is local to the loop.
NumFor      <~~ push(makeNumFor(takeAll())) ~~>
            = KwFor ForName "=" Expression "," Expression [ "," Expression ] KwDo Block KwEndKw ;
ForName     <~~ push({fname: up.in}) ~~>
            = Id ;

// for k, v in <explist> do ... end - the full generic for. The expression list yields
// the iterator triple (function, state, control value) and every pass calls it; ipairs
// and pairs are ordinary global functions returning such a triple, so a hand-written
// iterator drives the loop the same way (see makeGenFor).
GenFor      <~~ push(makeGenFor(takeAll())) ~~>
            = KwFor GenName { "," GenName } KwIn ExprList KwDo Block KwEndKw ;
GenName     <~~ push({gname: up.in}) ~~>
            = Id ;

DoBlock     <~~ push(makeDoBlock(pop())) ~~>
            = KwDo Block KwEndKw ;

LocalFunc   <~~ push(makeLocalFunc(pop(), pop(), pop())) ~~>
            = KwLocal KwFunction Id <~~ push(up.in) ~~> ParamList Block KwEndKw ;

Local       <~~ push(makeLocal(takeAll())) ~~>
            = KwLocal LocalName [ Attrib ] { "," LocalName [ Attrib ] } [ "=" LocalVals ] ;
// The initializers keep their text: lua folds a <const> local whose initializer is
// a constant, and an error then names no variable (luaFolded).
LocalVals   = Expression <~~ push({ltext: up.in}) ~~> { "," Expression <~~ push({ltext: up.in}) ~~> } ;
LocalName   <~~ push({lname: up.in}) ~~>
            = Id ;
// Lua 5.4 local attribute: local x <const> = 1 / local h <close> = r. Accepted and
// ignored (the subset enforces neither const-ness nor to-be-closed semantics).
Attrib      <~~ push({lattr: up.in}) ~~> = "<" Id ">" ;

// function name(...) end, function tbl.field(...) end, and the method-definition sugar
// function tbl:method(...) end (which binds an implicit first parameter 'self').
Func        <~~ push(makeFunc(pop(), pop(), pop())) ~~>
            = KwFunction FuncName ParamList Block KwEndKw ;
FuncName    <~~ push(makeFuncName(takeAll())) ~~>
            = Id <~~ push({fnbase: up.in}) ~~> { "." Id <~~ push({fnstep: up.in}) ~~> } [ ":" Id <~~ push({fnstep: up.in, fnself: true}) ~~> ] ;

ParamList   <~~ push({params: takeAll()}) ~~>
            = "(" [ ( Id <~~ push(up.in) ~~> { "," Id <~~ push(up.in) ~~> } [ "," VarargPar ] | VarargPar ) ] ")" ;
// A trailing '...' makes the function variadic: it is kept in the parameter list under
// that very name, and makeClosure turns it into the frame's extra-argument array.
VarargPar   <~~ push("...") ~~>
            = "..." ;

// `return` takes an OPTIONAL expression list, and the guard in front of it is what makes
// the option optional in practice: `end`, `else`, `elseif` and `until` are ordinary
// identifiers to the Id rule, so without it a bare `return` followed by `end` would parse
// as `return end` - returning a variable named `end` - and the block would eat the NEXT
// `end`. NotEnders consumes nothing and only fails on those four whole words.
Return      <~~ push(makeReturn(takeAll(), up.in)) ~~>
            = KwReturn [ NotEnders ExprList ] ;
Break       <~~ push(makeBreak()) ~~>
            = KwBreak ;

// goto Name jumps to a matching ::Name:: label (Lua 5.2+), backward as well as forward
// and outward through any number of enclosing blocks - see makeGoto / makeSeq.
Goto        <~~ push(makeGoto(pop())) ~~>
            = KwGoto Id <~~ push(up.in) ~~> ;
Label       <~~ push(makeLabel(pop())) ~~>
            = "::" Id <~~ push(up.in) ~~> "::" ;
// A lone ';' or one terminating the previous statement (Lua allows ';' between and
// after statements): a no-op.
EmptyStat   <~~ push(makeEmpty()) ~~>
            = ";" ;

// varlist '=' exprlist. The targets and the values sit interleaved on the stack;
// makeAssign tells them apart (a target is an object, a value thunk a function).
AssignStat  <~~ push(makeAssign(takeAll())) ~~>
            = Target { "," Target } "=" ExprList ;
// A target is Lua's `var`, and Lua's `var` is `prefixexp '.' Name | prefixexp '[' exp ']'`
// - so everything a prefixexp may contain sits in front of the final field or index,
// CALLS included: `getmetatable(t).__index = f`, `a[1], f(a)[2], b = ...` and `o:m().x = 1`
// are all ordinary Lua. The chain is therefore the SAME one an
// expression parses; assignTarget walks all but the last step and writes into the slot the
// last step names. (A trailing call - `f(a) = 1` - is not valid Lua and simply fails at
// run time, which is where an assignment to a non-slot belongs anyway.)
Target      <~~ push(makeTargetRef(takeAll())) ~~>
            = Id <~~ push(up.in) ~~> { CallSfx | MethodSfx | StrCallSfx | TblCallSfx | DotSfx | IndexSfx } ;

CallStat    <~~ push(exprToStmt(pop())) ~~>
            = SuffixedExpr ;

ExprList    = Expression { "," Expression } ;

// Every expression production pushes exactly one thunk: function() -> value.
Expression  = OrExpr ;

OrExpr      <~~ push(luaOrAnd(takeAll(), true)) ~~>
            = AndExpr <~~ push(luaOpnd(up.in)) ~~> { KwOr AndExpr <~~ push(luaOpnd(up.in)) ~~> } ;
AndExpr     <~~ push(luaOrAnd(takeAll(), false)) ~~>
            = CmpExpr <~~ push(luaOpnd(up.in)) ~~> { KwAnd CmpExpr <~~ push(luaOpnd(up.in)) ~~> } ;

CmpExpr     <~~ push(foldBinary(luaPosCmp(takeAll(), up.pos))) ~~>
            = BOrExpr <~~ push(luaOpnd(up.in)) ~~> { ( "==" | "~=" | "<=" | ">=" | "<" | ">" ) <~~ push(luaOpTok(up.in, up.pos)) ~~> BOrExpr <~~ push(luaOpnd(up.in)) ~~> } ;

// The bitwise operators of Lua 5.3+, each on its own precedence level: | binds loosest,
// then binary ~ (exclusive or), then &, then the shifts - all below the comparisons and
// above concatenation. They work on 64-bit two's complement integers (luaBitOp), so a
// float operand with an integral value converts and everything else is an error. Binary
// '~' carries a !"=" lookahead so that a '~=' comparison is left to CmpExpr above.
BOrExpr     <~~ push(foldBinary(luaPosOps(takeAll()))) ~~>
            = BXorExpr <~~ push(luaOpnd(up.in)) ~~> { "|" <~~ push(luaOpTok(up.in, up.pos)) ~~> BXorExpr <~~ push(luaOpnd(up.in)) ~~> } ;
BXorExpr    <~~ push(foldBinary(luaPosOps(takeAll()))) ~~>
            = BAndExpr <~~ push(luaOpnd(up.in)) ~~> { ( "~" !"=" ) <~~ push(luaOpTok(up.in, up.pos)) ~~> BAndExpr <~~ push(luaOpnd(up.in)) ~~> } ;
BAndExpr    <~~ push(foldBinary(luaPosOps(takeAll()))) ~~>
            = ShiftExpr <~~ push(luaOpnd(up.in)) ~~> { "&" <~~ push(luaOpTok(up.in, up.pos)) ~~> ShiftExpr <~~ push(luaOpnd(up.in)) ~~> } ;
ShiftExpr   <~~ push(foldBinary(luaPosOps(takeAll()))) ~~>
            = ConcatExpr <~~ push(luaOpnd(up.in)) ~~> { ( "<<" | ">>" ) <~~ push(luaOpTok(up.in, up.pos)) ~~> ConcatExpr <~~ push(luaOpnd(up.in)) ~~> } ;

// Concatenation is right associative, so it recurses on its own right hand side.
ConcatExpr  <~~ push(makeConcat(luaPosPair(takeAll()))) ~~>
            = AddExpr <~~ push(luaOpnd(up.in)) ~~> [ ".." <~~ push(luaOpPos(up.pos)) ~~> ConcatExpr <~~ push(luaOpnd(up.in)) ~~> ] ;

AddExpr     <~~ push(foldBinary(luaPosOps(takeAll()))) ~~>
            = MulExpr <~~ push(luaOpnd(up.in)) ~~> { ( "+" | "-" ) <~~ push(luaOpTok(up.in, up.pos)) ~~> MulExpr <~~ push(luaOpnd(up.in)) ~~> } ;
// The floor division // must be tried before the true division /.
MulExpr     <~~ push(foldBinary(luaPosOps(takeAll()))) ~~>
            = UnaryExpr <~~ push(luaOpnd(up.in)) ~~> { ( "*" | "//" | "/" | "%" ) <~~ push(luaOpTok(up.in, up.pos)) ~~> UnaryExpr <~~ push(luaOpnd(up.in)) ~~> } ;

UnaryExpr   = NotExpr | LenExpr | NegExpr | BNotExpr | PowExpr ;
NotExpr     <~~ var o = pop(); push(makeNot(luaTrunc(pop(), o))) ~~>
            = KwNot UnaryExpr <~~ push(luaOpnd(up.in)) ~~> ;
LenExpr     <~~ var o = pop(); var t = pop(); push(makeLen(luaPosArg(luaTrunc(t, o), pop(), [luaOpndDesc(o.t), false]))) ~~>
            = "#" <~~ push(luaOpPos(up.pos)) ~~> UnaryExpr <~~ push(luaOpnd(up.in)) ~~> ;
NegExpr     <~~ var o = pop(); var t = pop(); push(makeNeg(luaPosArg(luaTrunc(t, o), pop(), [luaOpndDesc(o.t), false]))) ~~>
            = "-" <~~ push(luaOpPos(up.pos)) ~~> UnaryExpr <~~ push(luaOpnd(up.in)) ~~> ;
// Unary bitwise not ~x (Lua 5.3+), guarded against '~=': the 64-bit complement.
BNotExpr    <~~ var o = pop(); var t = pop(); push(makeBNot(luaPosArg(luaTrunc(t, o), pop(), [luaOpndDesc(o.t), false]))) ~~>
            = ( "~" !"=" ) <~~ push(luaOpPos(up.pos)) ~~> UnaryExpr <~~ push(luaOpnd(up.in)) ~~> ;
// Exponentiation a ^ b: right associative (its right operand is a UnaryExpr, which
// descends into PowExpr again) and binding tighter than the unary operators, so -2^2
// is -(2^2) and 2^-1 is legal. The result is always a float, like in Lua.
PowExpr     <~~ push(makePow(luaPosPair(takeAll()))) ~~>
            = SuffixedExpr <~~ push(luaOpnd(up.in)) ~~> [ "^" <~~ push(luaOpPos(up.pos)) ~~> UnaryExpr <~~ push(luaOpnd(up.in)) ~~> ] ;

// f(a), t.x, t[k], t:m(a) in any mix.
SuffixedExpr <~~ push(foldCallMember(takeAll(), up.in)) ~~>
            = Primary { CallSfx | MethodSfx | StrCallSfx | TblCallSfx | DotSfx | IndexSfx } ;
// A call runs at the line its arguments open on (lua's funcargs): `at`, the
// position the empty token ahead of them records (luaOpPos).
CallSfx     <~~ var it = takeAll(); push({kind:"call", at: it[0], args: it.slice(1)}) ~~>
            = "" <~~ push(luaOpPos(up.pos)) ~~> "(" [ ExprList ] ")" ;
// f "s" / f [[s]] / f {t}: a call whose single argument is a string literal or a table
// constructor may be written without the parentheses.
StrCallSfx  <~~ var it = takeAll(); push({kind:"call", at: it[0], args: it.slice(1)}) ~~>
            = "" <~~ push(luaOpPos(up.pos)) ~~> ( LuaDq | LuaSq | LongString ) ;
TblCallSfx  <~~ var it = takeAll(); push({kind:"call", at: it[0], args: it.slice(1)}) ~~>
            = "" <~~ push(luaOpPos(up.pos)) ~~> TableLit ;
// obj:m(args): sugar for obj.m(obj, args) - the receiver is passed as the first arg.
// The same parenthesis-free argument forms apply (obj:m "s", obj:m {t}).
MethodSfx   <~~ var it = takeAll(); push({kind:"method", name: it[0].mname, at: it[1], args: it.slice(2)}) ~~>
            = ":" MethodName "" <~~ push(luaOpPos(up.pos)) ~~> ( "(" [ ExprList ] ")" | LuaDq | LuaSq | LongString | TableLit ) ;
MethodName  <~~ push({mname: up.in}) ~~>
            = Id ;
DotSfx      = "." Id <~~ push({kind:"field", name: up.in}) ~~> ;
IndexSfx    <~~ push({kind:"index", idx: pop(), src: up.in}) ~~>
            = "[" Expression "]" ;

Primary     = ParenExpr | FuncExpr | TableLit | LongString | VarargExpr
            | LuaDq | LuaSq | Number | True | False | Nil | VarRef ;

// ( e ). Parentheses are not only grouping in Lua: they also TRUNCATE a multi-value
// expression (a call or ...) to its first value, which is why this is a production of
// its own rather than an inline group.
ParenExpr   <~~ push(luaParen(pop())) ~~>
            = "(" Expression ")" ;

// Long-bracket string literals [[ ... ]], [=[ ... ]=], [==[ ... ]==] - with ANY number
// of '=' signs between the brackets. The closing bracket has to repeat the opening
// level, which no fixed token can express, so one :script scans the whole literal and
// hands the parser back a token for exactly those bytes. The body is verbatim (no
// escape processing) and a single leading newline is dropped, matching Lua.
LongString  <~~ push(makeConst(luaLong(luaLongBody(up.in)))) ~~>
            = LongBracket :whitespace(Whitespace) ;
LongBracket = :script(~~
    (function() {
        var no = abnf.newToken("\x01not-a-long-bracket", 0)
        // A :script sees the raw input, so what sits in front of the literal has to be
        // stepped over here; the token returned starts AT the bracket, which is where
        // the parser looks once it has skipped the same run itself. The skip is
        // NotEnders' (blanks and both comment forms); see the comment there.
        var off = 0
        var scanning = true
        while (scanning) {
            var wc = c.peek(off)
            if (wc === 32 || wc === 9 || wc === 13 || wc === 10) { off = off + 1 }
            else if (wc === 45 && c.peek(off + 1) === 45) {
                var clv = 0
                var e = off + 3
                var isLong = false
                if (c.peek(off + 2) === 91) {
                    while (c.peek(e) === 61) { clv = clv + 1; e = e + 1 }
                    if (c.peek(e) === 91) { isLong = true }
                }
                if (isLong) {
                    var p = e + 1
                    var closing = true
                    while (closing) {
                        var c2 = c.peek(p)
                        if (c2 < 0) { off = p; closing = false }
                        else if (c2 === 93) {
                            var k2 = 0
                            while (c.peek(p + 1 + k2) === 61) { k2 = k2 + 1 }
                            if (k2 === clv && c.peek(p + 1 + k2) === 93) { off = p + k2 + 2; closing = false }
                            else { p = p + 1 }
                        } else { p = p + 1 }
                    }
                } else {
                    off = off + 2
                    while (c.peek(off) !== 10 && c.peek(off) >= 0) { off = off + 1 }
                }
            }
            else { scanning = false }
        }
        if (c.peek(off) !== 91) { return no }
        var lvl = 0
        while (c.peek(off + 1 + lvl) === 61) { lvl = lvl + 1 }
        if (c.peek(off + 1 + lvl) !== 91) { return no }
        var i = off + lvl + 2
        var open = true
        while (open) {
            var ch = c.peek(i)
            if (ch < 0) { return no }
            if (ch === 93) {
                var k = 0
                while (c.peek(i + 1 + k) === 61) { k = k + 1 }
                if (k === lvl && c.peek(i + 1 + k) === 93) { i = i + k + 2; open = false }
                else { i = i + 1 }
            } else { i = i + 1 }
        }
        var s = ""
        // c.peek returns BYTES, and a returned token must match the input LITERALLY -
        // so a byte above 127 cannot be appended as its own code point (it would be
        // re-encoded as two bytes on the way into Go and the token would no longer
        // match). Decode UTF-8 by hand instead.
        var j = off
        while (j < i) {
            var b0 = c.peek(j)
            if (b0 < 128) { s = s + String.fromCharCode(b0); j = j + 1; continue }
            var need = 0
            var cp = 0
            if (b0 >= 240) { need = 3; cp = b0 - 240 }
            else if (b0 >= 224) { need = 2; cp = b0 - 224 }
            else if (b0 >= 192) { need = 1; cp = b0 - 192 }
