            if (k > e) { return mkMulti(out) }
            // lua's stack limit (LUAI_MAXSTACK) is what refuses a huge range.
            if (e - k >= 1000000) { fail("too many results to unpack") }
            while (k <= e) {
                out.push(luaIndex(t, k))
                k = k + 1
            }
            return mkMulti(out)
        },
        pack: function() {
            var t = {}
            for (var i = 0; i < arguments.length; i++) { luaSeti(t, i + 1, arguments[i]) }
            luaRawSet(t, "n", arguments.length)
            return t
        },
        sort: function(t, cmp) {
            var nargs = arguments.length
            luaCheckTab("table.sort", 1, t, nargs)
            var n = luaLen(t)
            if (n > 1) {
                if (n >= 2147483647) { luaArgErr("table.sort", 1, "array too big") }
                if (cmp !== undefined && cmp !== null && typeof cmp != "function") { luaArgTypeErr("table.sort", 2, "function", cmp, nargs) }
                luaAuxSort(t, cmp, 1, n)
            }
            return undefined
        },
        move: function(a1, f0, e0, t0, a2) {
            var nargs = arguments.length
            var f = luaCheckInt("table.move", 2, f0, nargs)
            var e = luaCheckInt("table.move", 3, e0, nargs)
            var d = luaCheckInt("table.move", 4, t0, nargs)
            var dst = anytype // The destination table.
            dst = a1
            var other = a2 !== undefined && a2 !== null
            if (other) { dst = a2 }
            luaCheckTab("table.move", 1, a1, nargs)
            luaCheckTab("table.move", other ? 5 : 1, dst, nargs)
            if (e >= f) {
                var n = e - f + 1
                if (d > e || d <= f || (other && a1 !== dst)) {
                    for (var i = 0; i < n; i++) { luaSeti(dst, d + i, luaIndex(a1, f + i)) }
                } else {
                    for (var k = n - 1; k >= 0; k--) { luaSeti(dst, d + k, luaIndex(a1, f + k)) }
                }
            }
            return dst
        }
    }

    // ----- Project-file imports (see the Require rule) -----
    function luaImport(items, pos) {
        resolveImport(items[items.length - 1], pos)
        return function() { return undefined }
    }
    // Lua stdlib libraries the runtime already provides; require of one is a no-op.
    core.stdlibImports = ["string", "table", "math", "io", "os", "coroutine"]
    // Load the file and compile it; the imported chunk runs itself (buildChunk), registering
    // its functions in the shared global scope before the main chunk runs. Required once; a
    // leading './' is dropped and a missing '.lua' extension appended before the -i search.
    var importedFiles = {}
    core.importFile = function(path, pos) {
        var rel = path
        if (rel.length >= 2 && rel.charAt(0) == "." && rel.charAt(1) == "/") { rel = rel.substring(2) }
        if (!(rel.length >= 4 && rel.substring(rel.length - 4) == ".lua")) { rel = rel + ".lua" }
        var file = c.findImport(rel)
        if (file == "") { return false }
        if (importedFiles["$" + file] == true) { return true }
        importedFiles["$" + file] = true
        var text = c.readFile(file)
        var asg = c.parse(c.agrammar, text, null, file)
        c.pushSource(file, text)
        c.compile(asg)
        c.popSource()
        return true
    }

    c.compile(c.asg)

    println("lua interpreter: program ran to completion")
    exit(0)

~~) ;
