        }
        if (ct.k != "struct") fail("a scalar takes no brace initializer")
        var st = structOf(ct.s)
        var idx = 0
        for (var j = 0; j < list.length; j++) {
            var iu = list[j]
            if (iu.fld != undefined) {
                var found = -1
                for (var k = 0; k < st.order.length; k++) { if (st.order[k] == iu.fld) found = k }
                if (found < 0) fail(tagName(ct.s) + " has no field " + iu.fld)
                idx = found
            }
            if (idx >= st.order.length) fail("too many initializers for " + tagName(ct.s))
            var f = fieldOf(ct.s, st.order[idx])
            runInit(f.ct, iu.v, base + f.off)
            idx = idx + 1
        }
    }

    // All user defined functions by name: {params: [{name, ptr}...], body: thunk}.
    var funcs = {}

    // A function POINTER is the function's identifier: a small positive integer that
    // indexes funcNameById. 0 is no function, so a null function pointer is 0 like
    // every other null pointer.
    var funcIdOf = {}
    var funcNameById = [""]
    function funcId(name) {
        if (hasOwn(funcIdOf, name)) return funcIdOf[name]
        var id = funcNameById.length
        funcNameById.push(name)
        funcIdOf[name] = id
        return id
    }
    function funcNameOf(v) {
        if (v <= 0 || v >= funcNameById.length) fail("not a function pointer: " + v)
        return funcNameById[v]
    }

    function callFunction(name, argValues) {
        if (name == "putchar") {
            printf("%c", argValues[0].v & 255)
            return argValues[0]
        }
        if (name == "getchar") {
            return val(-1, ctInt) // No stdin in the interpreter run (matches llvm.Run without input).
        }
        var f = hasOwn(funcs, name) ? funcs[name] : undefined
        if (f == undefined) {
            // Not a function name: a VARIABLE holding a function pointer, called
            // through its own name ('fp(4)').
            var lv = lookupVar(name)
            if (lv != undefined) return callFunction(funcNameOf(load(lv.addr)), argValues)
            fail("function not defined: " + name)
        }
        var callerScopes = scopes
        scopes = [globalScope, {}]
        for (var i = 0; i < f.params.length; i++) {
            var pct = f.params[i].ct
            var av = (i < argValues.length) ? argValues[i].v : 0
            if (isAggCt(pct)) {
                // A struct parameter is passed BY VALUE: the argument is the address of
                // the caller's object, and the callee gets its own copy.
                var pa = alloc(ctSize(pct))
                copyCt(pct, pa, av)
                declVar(f.params[i].name, pa, false, pct)
                continue
            }
            var a = alloc(1)
            mem[a] = convert(pct, av)   // The argument converts to the parameter's type.
            declVar(f.params[i].name, a, false, pct)
        }
        var r = f.body()
        scopes = callerScopes
        return (r != undefined && r.isRet) ? r.v : val(0, ctInt)
    }

    // ----- goto and labels -----
    // A labelled statement is pushed as {lbl, t} instead of a bare thunk, so the
    // enclosing statement SEQUENCE can index its labels. A goto returns a signal that
    // every enclosing construct passes upward (exactly like a return) until a sequence
    // that knows the label catches it and resumes there - which covers forward jumps,
    // backward jumps and jumps out of nested loops alike.
    function makeLabel(items) { return {lbl: items[0], t: items[1]} }
    function makeGoto(name) { return function() { return {isGoto: true, label: name} } }
    makeSeq = function (items) {
        var stmts = []
        var labels = {}
        for (var i = 0; i < items.length; i++) {
            var it = items[i]
            if (it != undefined && typeof it != "function" && it.lbl != undefined) {
                labels[it.lbl] = stmts.length
                stmts.push(it.t)
            } else {
                stmts.push(it)
            }
        }
        return function() {
            var k = 0
            while (k < stmts.length) {
                var r = stmts[k]()
                if (r != undefined) {
                    if (r.isGoto == true && hasOwn(labels, r.label)) { k = labels[r.label]; continue }
                    return r
                }
                k = k + 1
            }
            return undefined
        }
    }

    // ----- Expression thunks: function() -> 32 bit int. Lvalue thunks -> address. -----

    function makeNum(n, ct) { var v = convert(ct, n); return function() { return val(v, ct) } }
    function makeInt(n) { return makeNum(n, ctInt) }
    // An integer constant carries the type its suffix names: u/U unsigned, l/L long.
    function makeNumLit(n, text) { return makeNum(n, intCtOf(text)) }
    function intCtOf(text) {
        var nl = 0
        var u = false
        for (var i = 0; i < text.length; i++) {
            var cc = text.charCodeAt(i)
            if (cc == 108 || cc == 76) nl = nl + 1
            else if (cc == 117 || cc == 85) u = true
            else if (!((cc >= 48 && cc <= 57) || (cc >= 97 && cc <= 102) || (cc >= 65 && cc <= 70) || cc == 120 || cc == 88)) break
        }
        return ctI(nl > 0 ? 8 : 4, u)
    }
    // A floating constant: f/F makes it a float, l/L a long double (modelled as a
    // double, like every long double here).
    function makeFltLit(text) {
        var t = text
        var end = t.length
        while (end > 0) {
            var cc = t.charCodeAt(end - 1)
            if (cc == 32 || cc == 9 || cc == 10 || cc == 13) { end = end - 1; continue }
            break
        }
        t = t.slice(0, end)
        var ct = ctDbl
        var last = t.charCodeAt(t.length - 1)
        if (last == 102 || last == 70) { ct = ctF(4); t = t.slice(0, t.length - 1) }
        else if (last == 108 || last == 76) { t = t.slice(0, t.length - 1) }
        return makeNum(parseCFloat(t), ct)
    }
    makeVarRef = function(name) {
        return function() {
            // An array name decays to the address of its first element, and a struct
            // (or union) VALUE is likewise handed on as the address of its storage.
            var v = lookupVar(name)
            if (v != undefined) {
                var ct = v.ct != undefined ? v.ct : ctInt
                if (ct.k == "arr") return val(v.addr, {k: "ptr", p: ct.e})
                if (ct.k == "struct") return val(v.addr, ct)
                return val(load(v.addr), ct)
            }
            if (hasOwn(enumConsts, name)) return val(enumConsts[name] | 0, ctInt)
            // A bare function name is its address: the function pointer value.
            if (hasOwn(funcs, name)) return val(funcId(name), ctFn)
            fail("variable not defined: " + name)
        }
    }
    // An aggregate is passed around by the ADDRESS of its storage: an array decays to
    // it in C, and a struct value uses it because this flat memory is never reused, so
    // whoever receives the value copies the words out while the source is still live.
    function isAggCt(ct) { return ct != undefined && (ct.k == "arr" || ct.k == "struct") }
    // Copy a whole aggregate (or one word for a scalar) from src to dst.
    function copyCt(ct, dst, src) {
        var n = ctSize(ct)
        for (var i = 0; i < n; i++) mem[dst + i] = mem[src + i]
    }
    // A place path: the variable, then indexing and member steps. The walk keeps the
    // address of the current place and its C type: a[i] steps by whole elements (the
    // array in place, a pointer through its loaded base), .f adds the field offset,
    // ->f loads the pointer and adds the field offset. The result is the final address.
    // Step a place path from a starting {a, ct}: '[i]' peels one array or pointer
    // level (and steps by whole elements), '.f' adds the field offset, '->f' loads
    // the pointer first. The C type travels with the address, so nothing needs a
    // separate 'is this an array' flag.
    function walkPath(start, path, name) {
        var addr = start.a
        var ct = start.ct != undefined ? start.ct : ctInt
        var bf = undefined   // Set when the LAST step selected a bit field.
        for (var i = 0; i < path.length; i++) {
            var s = path[i]
            bf = undefined
            if (s.idx != undefined) {
                var idx = s.idx().v
                if (ct.k == "arr") { ct = ct.e; addr = addr + idx * ctSize(ct) }
                else if (ct.k == "ptr") { ct = ct.p; addr = load(addr) + idx * ctSize(ct) }
                else fail("indexing needs an array or a pointer: " + name)
            } else if (s.fld != undefined) {
                if (ct.k != "struct") fail("'.' needs a struct value: ." + s.fld)
                var f = fieldOf(ct.s, s.fld)
                addr = addr + f.off
                ct = f.ct
                bf = f.bf
            } else {
                if (ct.k != "ptr" || ct.p.k != "struct") fail("'->' needs a struct pointer: ->" + s.arw)
                var f2 = fieldOf(ct.p.s, s.arw)
                addr = load(addr) + f2.off
                ct = f2.ct
                bf = f2.bf
            }
        }
        return {a: addr, ct: ct, bf: bf}
    }
    function makeVarPlace(items) {
        var name = items[0]
        var path = items.slice(1)
        return function() {
            var v = findVar(name)
            var ct = v.ct != undefined ? v.ct : ctInt
            if (path.length == 0) return {a: v.addr, ct: ct}
            return walkPath({a: v.addr, ct: ct}, path, name)
        }
    }
    // A string literal is an unnamed array object with static storage duration: it is
    // allocated once, on first use, and every evaluation yields that same address.
    function makeStrPlace(text) {
        var d = cStrBytes(text)
        var ct = ctArr(d.str.length, d.wide ? ctInt : ctChar)
        var bytes = d.str
        var addr = -1
        return function() {
            if (addr < 0) { addr = strLitAddr(bytes) }
            return {a: addr, ct: ct}
        }
    }
    function makeStrInit(text) { return cStrBytes(text) }
    // '(Type){ ... }': an unnamed object with automatic storage, initialized like a
    // declared one. The place thunk allocates it and hands back its address, so a
    // suffix chain, '&' and a decay to a pointer all work on it like on a variable.
    function makeCompDesc(items) {
        var d = {bs: items[0].bs, ptr: 0, dims: undefined}
        for (var i = 1; i < items.length; i++) {
            if (items[i].ptr != undefined) { d.ptr = items[i].ptr }
            if (items[i].dims != undefined) { d.dims = items[i].dims }
        }
        return d
    }
    function compLitCt(d, init) {
        var base = d.bs
        if (d.ptr > 0) { base = ptrTo(d.ptr, base) }
        if (d.dims != undefined) return arrCt(d.dims, base, initCount(init))
        return base
    }
    function makeCompLit(items) {
        var ct = compLitCt(items[0].clt, items[1])
        var init = items[1]
        return function() {
            var a = alloc(ctSize(ct))
            runInit(ct, init, a)
            return {a: a, ct: ct}
        }
    }
    // '(place)[i]' / '(place).f': the parenthesized place, then its suffix chain.
    function makeSfxChain(items) {
        var placeT = items[0]
        var path = items.slice(1)
        return function() { return walkPath(placeT(), path, "parenthesized place") }
    }
    // '*place': the pointer's VALUE is the address of the place, and the place's C
    // type is the pointee. An ARRAY does not load at all - '*a' is 'a[0]'.
    function makeDerefP(placeT) {
        return function() {
            var p = placeT()
            var ct = p.ct != undefined ? p.ct : ctInt
            if (ct.k == "arr") return {a: p.a, ct: ct.e}
            // '*fp' on a function pointer is the function designator, which decays
            // straight back to the same pointer (C11 6.5.3.2p4).
            if (ct.k == "fnp") return {a: p.a, ct: ct}
            if (ct.k != "ptr") fail("'*' needs a pointer")
            return {a: load(p.a), ct: ct.p}
        }
    }
    // Every lvalue thunk answers {a: address, ct: C type, bf: bit field or undefined}.
    function makeDerefPlace(t) {
        return function() {
            var r = t()
            var ct = (r.t != undefined && r.t.k == "ptr") ? r.t.p : ctInt
            return {a: r.v, ct: ct}
        }
    }
    function makeAddrOf(placeT) {
        return function() {
            var p = placeT()
            return val(p.a, {k: "ptr", p: p.ct != undefined ? p.ct : ctInt})
        }
    }
    // Reading a place loads its cell - except an ARRAY place, which decays to the
    // address of its first element ('m[0]' used as an int*).
    function makeLoad(placeT) {
        return function() {
            var p = placeT()
            var ct = p.ct != undefined ? p.ct : ctInt
            if (ct.k == "arr") return val(p.a, {k: "ptr", p: ct.e})
            if (ct.k == "struct") return val(p.a, ct)
            return val(load(p.a), ct)
        }
    }
    makeNot = function(t) { return function() { return val(t().v == 0 ? 1 : 0, ctInt) } }
    makeNeg = function(t) {
        return function() {
            var r = t()
            var ct = promote(r.t)
            return val(convert(ct, 0 - r.v), ct)
        }
    }
    function makeBitNot(t) {
        return function() {
            var r = t()
            var ct = promote(r.t)
            return val(convert(ct, ~r.v), ct)
        }
    }

    // The element a pointer (or a decayed array) steps by.
    function pointeeOf(ct) { return ct.k == "ptr" ? ct.p : (ct.k == "arr" ? ct.e : undefined) }
    // One binary operator on two typed values. Pointer arithmetic steps whole
    // elements; everything else is evaluated in the usual arithmetic conversions'
    // common type, which is what makes an unsigned divide, remainder, shift and
    // comparison differ from the signed one and a float operand pull the whole
    // operation into floating point.
    binOp = function(op, l, r) {
        var lp = pointeeOf(l.t)
        var rp = pointeeOf(r.t)
        if (lp != undefined || rp != undefined) {
            if (op == "-" && lp != undefined && rp != undefined) {
                return val(trunc0((l.v - r.v) / ctSize(lp)), ctInt)
            }
            if (op == "+" || op == "-") {
                var base = (lp != undefined) ? l : r
                var off = (lp != undefined) ? r.v : l.v
                var el = (lp != undefined) ? lp : rp
                if (op == "-") off = 0 - off
                return val(base.v + off * ctSize(el), base.t.k == "arr" ? {k: "ptr", p: el} : base.t)
            }
        }
        var ct = arithCt(l.t, r.t)
        var a = convert(ct, l.v)
        var b = convert(ct, r.v)
        if (op == "==") return val(a == b ? 1 : 0, ctInt)
        if (op == "!=") return val(a != b ? 1 : 0, ctInt)
        if (op == "<")  return val(a < b ? 1 : 0, ctInt)
        if (op == ">")  return val(a > b ? 1 : 0, ctInt)
        if (op == "<=") return val(a <= b ? 1 : 0, ctInt)
        if (op == ">=") return val(a >= b ? 1 : 0, ctInt)
        if (op == "+") return val(convert(ct, a + b), ct)
        if (op == "-") return val(convert(ct, a - b), ct)
        if (op == "*") return val(convert(ct, a * b), ct)
        if (op == "/") return val(convert(ct, isFlt(ct) ? (a / b) : trunc0(a / b)), ct)
        if (op == "%") return val(convert(ct, a % b), ct)
        // The bitwise operators take integers only; the shift count keeps the LEFT
        // operand's type (C11 6.5.7p3), so it is not part of the common type.
        if (op == "|")  return val(convert(ct, a | b), ct)
        if (op == "^")  return val(convert(ct, a ^ b), ct)
        if (op == "&")  return val(convert(ct, a & b), ct)
        var sct = promote(l.t)
        var sv = convert(sct, l.v)
        if (op == "<<") return val(convert(sct, sv * Math.pow(2, r.v & 31)), sct)
        if (op == ">>") return val(convert(sct, sct.u ? (sv >>> (r.v & 31)) : (sv >> (r.v & 31))), sct)
    }
    // Real C short circuit: the right side only runs if it can still change the result.
    makeOrAnd = function(items, op) {
        if (items.length == 1) return items[0]
        return function() {
            var v = items[0]().v != 0
            for (var i = 1; i < items.length; i++) {
                if (op == "||") { if (v) return val(1, ctInt); v = items[i]().v != 0 }
                else            { if (!v) return val(0, ctInt); v = items[i]().v != 0 }
            }
            return val(v ? 1 : 0, ctInt)
        }
    }
    // The conditional operator's two arms are balanced by the usual arithmetic
    // conversions, so '1 ? 2 : 2.5' has type double and yields 2.0 (C11 6.5.15p5).
    function makeCond(items) {
        if (items.length == 1) return items[0]
        return function() {
            var r = items[0]().v != 0 ? items[1]() : items[2]()
            return r
        }
    }
    // A compound assignment is the plain operator on the current value, converted
    // back to the target's type (C11 6.5.16.2p3).
    applyOp = function(op, a, b) { return binOp(op.slice(0, op.length - 1), a, b) }
    // items = [placeThunk, opString, valueThunk]. Value of the assignment: the stored value.
    function makeAssign(items) {
        var placeT = items[0]
        var op = items[1]
        var valT = items[2]
        return function() {
            var p = placeT()
            if (p.ct != undefined && p.ct.k == "arr") fail("an array is not assignable")
            var r = valT()
            // Assigning a whole struct or union copies its words (C11 6.5.16.1).
            if (op == "=" && isAggCt(p.ct)) { copyCt(p.ct, p.a, r.v); return val(p.a, p.ct) }
            var nv = r
            if (op != "=") nv = applyOp(op, val(load(p.a), p.ct), r)
            return val(store(p.ct, p.a, bfNorm(p.bf, convert(p.ct, nv.v))), p.ct)
        }
    }
    // ++ and -- step a POINTER by a whole element and anything else by one.
    function incStep(ct) { return ct.k == "ptr" ? ctSize(ct.p) : 1 }
    function makePreIncDec(placeT, op) {
        var d = (op == "++") ? 1 : -1
        return function() {
            var p = placeT()
            return val(store(p.ct, p.a, bfNorm(p.bf, convert(p.ct, load(p.a) + d * incStep(p.ct)))), p.ct)
        }
    }
    function makePostIncDec(op, placeT) {
        var d = (op == "++") ? 1 : -1
        return function() {
            var p = placeT()
            var old = load(p.a)
            store(p.ct, p.a, bfNorm(p.bf, convert(p.ct, old + d * incStep(p.ct))))
            return val(old, p.ct)
        }
    }
    function evalArgs(args) {
        var vals = []
        for (var i = 0; i < args.length; i++) vals.push(args[i]())
        return vals
    }
    // items = [seed, {args}...]. The seed is either {fname} (a bare name, resolved as
    // a function or as a variable holding a function pointer) or an expression thunk
    // yielding a function identifier. Every further argument list calls what the
    // previous one returned.
    function makeCallExpr(items) {
        var seed = items[0]
        var lists = items.slice(1)
        return function() {
            var v = val(0, ctInt)
            var start = 0
            if (typeof seed != "function") {
                v = callFunction(seed.fname, evalArgs(lists[0].args))
                start = 1
            } else {
                v = seed()
            }
            for (var i = start; i < lists.length; i++) {
                v = callFunction(funcNameOf(v.v), evalArgs(lists[i].args))
            }
            return v
        }
    }

    // ----- Statement thunks -----

    // One brace-initializer item: an optional '[i] =' / '.field =' designator plus
    // its value.
    function makeDItem(items) {
        if (items.length > 1) {
            if (items[0].fld != undefined) return {fld: items[0].fld, v: items[1]}
            return {at: items[0].at, v: items[1]}
        }
        return {v: items[0]}
    }
    // ----- Declarators -----
    // One declarator, whatever its shape, collapses into a DESCRIPTOR; the enclosing
    // declaration owns the base type and combines the two. That is what lets 'char',
    // 'unsigned' and a typedef name all reach a declarator that only knows about its
    // own stars, dimensions and initializer.
    function makeDeclr(items, kind) {
        var d = {name: "", ptr: 0, dims: undefined, init: undefined, gv: undefined, kind: kind}
        for (var i = 0; i < items.length; i++) {
            var it = items[i]
            if (it == undefined) continue
            if (typeof it == "string") { d.name = it; continue }
            if (typeof it == "function") { d.init = it; continue }
            if (it.ptr != undefined) { d.ptr = it.ptr; continue }
            if (it.dims != undefined) { d.dims = it.dims; continue }
            if (it.gv != undefined) { d.gv = it.gv; continue }
            d.init = it            // {list: ...} or {str: ...}
        }
        return d
    }
    // How many elements an initializer covers, for an inferred array size.
    function initCount(init) {
        if (init == undefined || typeof init == "function") return 0
        if (init.list != undefined) return initLen(init.list)
        if (init.str != undefined) return init.str.length
        return 0
    }
    // The C type that a base type plus one declarator name.
    function declCt(base, d) {
        if (d.kind == "fnptr") {
            if (d.dims != undefined) return arrCt(d.dims, ctFn, initCount(d.init))
            return ctFn
        }
        // 'int (*pa)[3]' is a POINTER TO an array, so the dimensions sit INSIDE.
        if (d.kind == "ptrarr") return ptrTo(d.ptr, arrCt(d.dims, base, 0))
        var b = (d.ptr > 0) ? ptrTo(d.ptr, base) : base
        if (d.dims != undefined) return arrCt(d.dims, b, initCount(d.init))
        return b
    }
    // items = [{bty}, {dcl}...] -> one declaration statement.
    function makeDeclSeq(items, isStatic) {
        var base = items[0].bty
        var thunks = []
        for (var i = 1; i < items.length; i++) {
            var d = items[i].dcl
            var t = makeDeclOf(d.name, declCt(base, d), d.init)
            thunks.push(isStatic ? makeStaticOf(d.name, t) : t)
        }
        return makeSeq(thunks)
    }
    // One declared object: fresh (zeroed) storage plus, if there is one, its
    // initializer written into it.
    function makeDeclOf(name, ct, opt) {
        return function() {
            var a = alloc(ctSize(ct))
            if (opt != undefined) initInto(ct, opt, a)
            declVar(name, a, ct.k == "arr", ct)
        }
    }
    // Write an initializer into a fresh object: a brace list, a string literal, or
    // one expression - which is COPIED when the object is an aggregate.
    function initInto(ct, opt, a) {
        if (typeof opt != "function") {
            if (opt.str != undefined) { strInitInto(ct, opt, a); return }
            runInit(ct, opt, a)
            return
        }
        var r = opt()
        if (isAggCt(ct)) { copyCt(ct, a, r.v); return }
        mem[a] = convert(ct, r.v)
    }
    // A string literal initializing a char ARRAY fills it element by element and
    // leaves the rest at the zero the fresh memory holds (C11 6.7.9p14); anywhere
    // else it is the literal object itself, and what is stored is its address.
    function strInitInto(ct, opt, a) {
        if (ct.k == "arr") {
            var n = opt.str.length < ct.n ? opt.str.length : ct.n
            for (var i = 0; i < n; i++) mem[a + i] = convert(ct.e, opt.str[i])
            return
        }
        mem[a] = convert(ct, strLitAddr(opt.str))
    }
    function strLitAddr(bytes) {
        var base = alloc(bytes.length)
        for (var i = 0; i < bytes.length; i++) mem[base + i] = bytes[i]
        return base
    }
    // A static local: the storage is allocated ONCE and survives across calls; every
    // later execution only re-binds that same cell into the fresh scope.
    function makeStaticOf(name, inner) {
        var cell = undefined
        return function() {
            if (cell == undefined) {
                inner()
                cell = lookupVar(name)
            } else {
