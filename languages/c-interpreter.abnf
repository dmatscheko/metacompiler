        if (a.k == "flt") return a.w == b.w
        if (a.k == "ptr") return ctEq(a.p, b.p)
        if (a.k == "arr") return a.n == b.n && ctEq(a.e, b.e)
        if (a.k == "struct") return a.s == b.s
        return true
    }
