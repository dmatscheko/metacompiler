    // Lay a run of member GROUPS - ordinary declarator lines and anonymous struct/union
    // members - into st, starting at word offset `base`, and return the words and bytes
    // they occupy. In a union every group starts at `base` and the size is the MAXIMUM;
    // in a struct they follow each other and the size is the sum. An anonymous member
    // recurses with its OWN kind, which is what puts its members into the enclosing
    // tag's namespace at its own offset.
    function layoutGroups(st, groups, base, isUnion, name) {
        var size = 0
        var bytes = 0
        for (var i = 0; i < groups.length; i++) {
            var g = groups[i]
            var off = isUnion ? base : base + size
            var w = 0
            var by = 0
            if (g.anonFields != undefined) {
                var r = layoutGroups(st, g.anonFields, off, g.isUnion, name)
                w = r.size
                by = r.bytes
            } else {
                var fl = g.fields
                for (var j = 0; j < fl.length; j++) {
                    var f = fl[j]
                    var ct = fieldCt(f)
                    var fo = isUnion ? off : off + w
                    if (f.pad != true) {
                        if (hasOwn(st.fields, f.name)) fail("duplicate field " + f.name + " in " + tagName(name))
                        var bf = undefined
                        if (f.bits != undefined) { bf = {w: f.bits | 0, sign: f.uns != true} }
                        st.fields[f.name] = {off: fo, ct: ct, bf: bf}
                        st.order.push(f.name)
