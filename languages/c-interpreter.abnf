    // A ct descriptor is {k:"int"} | {k:"ptr", p:ct} | {k:"struct", s:name}; the
    // pointee of a pointer is a ct in turn, so int** is ptr(ptr(int)) and nests freely.
    // structs[name] = {size: words, fields: {fname: {off, ct}}}; fields lie back to
    // back, ints and pointers take one word each (matching the compiled layout).
    // {k:"int", w: bytes, u: unsigned}  char / short / int / long, signed or not
    // {k:"flt", w: bytes}                float / double / long double
    // {k:"void"}                         only ever reached through a pointer
    // {k:"ptr", p} | {k:"arr", n, e} | {k:"struct", s} | {k:"fnp"}
    function ctI(w, u) { return {k: "int", w: w, u: u} }
    function ctF(w) { return {k: "flt", w: w} }
    var ctInt  = ctI(4, false)
    var ctUInt = ctI(4, true)
    var ctChar = ctI(1, false)
    var ctDbl  = ctF(8)
    var ctVoid = {k: "void"}
    // A FUNCTION POINTER cell. It holds the callee's identifier (see funcId below),
    // which is one word like every other value, so it needs no pointee type.
    var ctFn = {k: "fnp"}
    var structs = {}
    function ctSize(ct) {
        if (ct.k == "struct") return structOf(ct.s).size
        if (ct.k == "arr") return ct.n * ctSize(ct.e)
        return 1
    }
    function ctStruct(sname) { return {k: "struct", s: sname} }
    function isFlt(ct) { return ct.k == "flt" }
    function isNum(ct) { return ct.k == "int" || ct.k == "flt" }
    function isPtrLike(ct) { return ct.k == "ptr" || ct.k == "arr" }

    // ----- Values -----
