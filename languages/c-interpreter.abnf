    // cc on a 64-bit host (ul=8 l=8 ll=8 ptr=8 int=4). A long double is modelled as
    // a double, and a plain char is signed like it is on this reference platform.
    function makeScalarName(items) {
        var nlong = 0
        var uns = false
        var isVoid = false
        var isFloat = false
        var isDouble = false
        var isChar = false
        var isShort = false
        var isBool = false
        for (var i = 0; i < items.length; i++) {
            var t = items[i]
            if (t == "long") nlong = nlong + 1
            else if (t == "unsigned") uns = true
            else if (t == "void") isVoid = true
            else if (t == "float") isFloat = true
            else if (t == "double") isDouble = true
            else if (t == "char") isChar = true
            else if (t == "short") isShort = true
            else if (t == "_Bool") isBool = true
