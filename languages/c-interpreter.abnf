            var d = items[i].dcl
            typedefs[d.name] = declCt(base, d)
        }
    }
    // items = [{tname}, {dcl}...] -> one declaration statement.
    function makeTdDecl(items) {
        var all = [{bty: typedefOf(items[0].tname)}]
        for (var i = 1; i < items.length; i++) all.push(items[i])
        return makeDeclSeq(all, false)
    }
    // items = [{tname}, name, [params...], bodyThunk]: a function whose return type
    // is a typedef name. The value returned is one word like every other, so only the
    // declarator syntax differs from an ordinary definition.
    function defineTdFunc(items) { funcs[items[1]] = {params: items[2], body: items[3]} }

    // ----- Core library config (see lib/interp-core.js) -----
    core.lang = "c"
    core.test = function(v) { return v.v != 0 } // C conditions: any nonzero value.
    // System headers the runtime already provides; #include of anything else is an
    // external library we cannot resolve (see resolveImport in lib/interp-core.js).
    core.stdlibImports = ["stdio.h", "stdlib.h", "string.h", "math.h", "ctype.h", "stdbool.h", "stdint.h", "stddef.h", "limits.h", "assert.h", "stdarg.h"]

    // Project-file includes: #include "geomlib.h" loads geomlib.h (searched under the
    // program's directory and the -i roots) and compiles it, so its functions register
    // like the main file's (header-only in this subset). System <...> headers in
