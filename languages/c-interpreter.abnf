    // up.in hands over the matched TOKENS with their separators removed - 'long
    // double' arrives as 'longdouble' - so the run is scanned for the type keywords
    // themselves instead of being split on whitespace. Everything else (an enum tag,
    // a storage class, an __attribute__ body) contributes nothing and leaves int.
    var baseKws = ["unsigned", "signed", "double", "float", "short", "_Bool",
                   "char", "void", "long", "int"]
    function baseCtOf(text) {
        var toks = []
        var i = 0
        while (i < text.length) {
            var hit = -1
            for (var k = 0; k < baseKws.length; k++) {
                if (hit < 0 && text.slice(i, i + baseKws[k].length) == baseKws[k]) { hit = k }
