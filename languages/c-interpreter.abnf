        if (op == "-") return (l - r) | 0
        if (op == "*") return Math.imul(l, r)
        if (op == "/") return (l / r) | 0
        if (op == "%") return (l % r) | 0
        if (op == "==") return (l == r) ? 1 : 0
        if (op == "!=") return (l != r) ? 1 : 0
        if (op == "<")  return (l < r) ? 1 : 0
        if (op == ">")  return (l > r) ? 1 : 0
        if (op == "<=") return (l <= r) ? 1 : 0
        if (op == ">=") return (l >= r) ? 1 : 0
        if (op == "|")  return l | r
        if (op == "^")  return l ^ r
        if (op == "&")  return l & r
        if (op == "<<") return l << r
        if (op == ">>") return l >> r
    }
