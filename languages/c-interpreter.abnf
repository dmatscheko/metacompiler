:title("C (subset) interpreter") ;
:description("Parses a C subset and executes it directly, without generating code.

The language is a real C subset, richer than TinyC: the types int, int* and int[N]
(globals and locals, globals with constant initializers), structs (struct definitions
with int, pointer and nested struct value fields - including pointers to the struct
itself for linked lists -, struct locals, globals and arrays of structs, struct
pointers with initializers, . and -> member access along whole paths like
nodes[i].next->value, &s and struct pointer parameters), address-of (&x, &a[i]),
dereferencing (*p, also as assignment target), pointer arithmetic (p + i steps whole
ints), pre and post ++/--, assignment as an expression with = += -= *= /= %=, the
ternary operator, || and && with real C short circuit evaluation, the bitwise operators
| ^ & << >> and unary - ! ~, char literals ('A', '\n'), comparisons, function calls and
recursion, switch with real C fallthrough (stacked case labels, default, break), and
putchar()/getchar(). int is 32 bit, / and % truncate towards zero.
unions (every member at offset 0, sizeof the widest one), bit fields and anonymous
struct/union members, brace initializers for structs and unions with .field designators,
and tag definitions that also declare objects (struct S { int x; } s;).
Arrays of any rank (int m[2][3]) with nested brace initializers and [i] designators,
pointers to arrays (int (*pa)[3]) and arrays of pointers; struct VALUES - copied on
initialization and assignment, passed to and returned from functions - and struct
members of array type; function pointers (declared, stored in arrays, passed, returned
and called, including through an expression like tab[0](3) and pick(1)(5)); typedef,
including array, struct and function-pointer typedefs; and compound literals
((int[]){ 1, 2, 3 }, and the address of one).

A real TYPE MODEL carries every expression: char, short, int and long with their own
widths, signed and unsigned as distinct types, float and double, pointers, arrays,
structs and function pointers. Every value is the number plus the C type it has, so
the usual arithmetic conversions pick the common type of a binary operator, an
unsigned divide, remainder, shift and comparison differ from the signed one, 0u - 1u
wraps to 4294967295 where 0 - 1 is -1, a cast really converts, sizeof answers the size
of what it is applied to (including a whole array or struct), string literals are char
arrays that can be indexed and measured, and _Generic selects on the type.
Not in the subset: aggregate initializers on globals, and variable-length arrays.

The interpreter uses one flat, word addressed memory array: every variable lives at an
address, scopes map names to addresses, and pointers are plain indexes; every int,
pointer and struct field takes one word. That makes the semantics exactly match the
compiled version (c-to-llvm-ir.abnf), where the same programs run as LLVM IR.

Every tag composes a small JS closure (a 'thunk') out of the thunks of its children.
Lvalue thunks return an address, expression thunks return the value, statement thunks
return undefined or a signal (return/break/continue) that the enclosing statements route.

The exit code of the metacompiler run is the value that main() returns, so C test
programs are self checking: they return 0 on success.") ;


// --- main rules

// Shared token productions (languages/lib).
:include("lib/cstyle-comments.abnf") ;
:include("lib/ident.abnf") ;

:startRule(Program) ;
:whitespace(Whitespace) ;

Program     = { Include | PPLine | StaticAssert | EnumDef | UnionDef | UnionGDecl | UnionSkip
              | TypedefDecl
              | StructDef | GStructDefDecl | GUnionDefDecl | StructGDecl
              | FnPtrFuncDef | TdFuncDef | SProto | SFuncDef | FuncDef | Proto | GAggDecl | GlobalDecl } ;

// Preprocessor directives other than #include are accepted and skipped (object-like
// #define, the #if/#ifdef/#ifndef/#else/#elif/#endif family, #undef, #pragma, #error,
// #line). The line (with backslash continuations) is consumed as text and ignored;
// macro bodies are NOT expanded, so a name #define'd to a value stays unresolved if
// used later. Include is tried first, so #include keeps its header resolution.
PPLine      = "#" :whitespace() { PPCont | PPChar } :whitespace(Whitespace) ;
PPCont      = "\\" [ "\r" ] "\n" ;
PPChar      = "\x00"..."\x09" | "\x0b"..."\U0010ffff" ;

// enum Color { RED, GREEN = 5, BLUE }; -- genuinely lowered to named int constants
// (sequential from 0, or from an explicit value). The optional tag is ignored; the
// constants live in a global table and resolve wherever a bare name is read.
EnumDef     <~~ defineEnum(takeAll()) ~~>
            = KwEnum [ Id <~~ push({tag: up.in}) ~~> ]
              "{" [ Enumerator { "," Enumerator } [ "," ] ] "}" ";" ;
Enumerator  <~~ push(makeEnumerator(takeAll())) ~~>
            = Id <~~ push(up.in) ~~> [ "=" EnumInit ] ;
EnumInit    <~~ push({val: makeEnumVal(takeAll())}) ~~>
            = [ "-" <~~ push("-") ~~> ] Number ;

// union U { int i; unsigned u; }; -- a union is laid out exactly like a struct whose
// fields ALL sit at offset 0, with the size (and the byte size behind sizeof) the
// maximum over the members. Tags live in the same table as the struct tags but under
// a 'u:' prefixed key, so 'struct X' and 'union X' stay distinct C tag namespaces.
UnionDef    <~~ defineUnion(takeAll()) ~~>
            = KwUnion Id <~~ push(uKey(up.in)) ~~> "{" { FieldLine } "}" ";" ;
// Global union variables, pointers and arrays (zero initialized like all globals).
UnionGDecl  <~~ defineStructGlobals(takeAll()) ~~>
            = KwUnion Id <~~ push(uKey(up.in)) ~~> SGDecl { "," SGDecl } ";" ;
// An ANONYMOUS union at file scope (union { ... };) introduces no tag and no object,
// so there is nothing to lay out; it is accepted and reported as not implemented.
UnionSkip   <~~ notImpl("anonymous union", up.pos) ~~>
            = KwUnion SkipBlock ";" ;

// typedef: the introduced name becomes a real type name, usable wherever a
// declaration base type may stand. Because a PEG guard cannot consult a symbol
// table, the USE site is recognized by SHAPE - an identifier that is not a C
// keyword, directly followed by a declarator - and the tag resolves the name in
// the typedef table it filled here. That covers the ordinary forms:
//   typedef int Int;  typedef Int Num;  typedef int Tri[3];
//   typedef struct { int v; } Box;  typedef int (*Fn)(int);
TypedefDecl <~~ defineTypedef(takeAll()) ~~>
            = KwTypedef TdBase TdDeclr { "," TdDeclr } ";" ;
// The tag-DEFINING forms come first: only what follows the tag tells
// 'typedef struct S { ... } T;' from 'typedef struct S T;' apart.
TdBase      = TdStructDef | TdUnionDef | TdEnumDef
            | TypeInt <~~ push({tb: baseCtOf(up.in)}) ~~>
            | KwStruct Id <~~ push({tb: ctStruct(up.in)}) ~~>
            | KwUnion Id <~~ push({tb: ctStruct(uKey(up.in))}) ~~>
            | EnumRef <~~ push({tb: ctInt}) ~~>
            | TdRef ;
TdRef       <~~ push({tref: up.in}) ~~> = NotCKw Id ;
TdStructDef <~~ push({tb: tdTagDef(takeAll(), false)}) ~~>
            = KwStruct [ Id <~~ push({tag: up.in}) ~~> ] "{" { FieldLine } "}" ;
TdUnionDef  <~~ push({tb: tdTagDef(takeAll(), true)}) ~~>
            = KwUnion [ Id <~~ push({tag: up.in}) ~~> ] "{" { FieldLine } "}" ;
TdEnumDef   <~~ defineEnum(takeAll()); push({tb: ctInt}) ~~>
            = KwEnum [ Id <~~ push({tag: up.in}) ~~> ]
              "{" [ Enumerator { "," Enumerator } [ "," ] ] "}" ;
TdDeclr     = TdFnPtr | TdPlain ;
TdFnPtr     <~~ push({dcl: makeDeclr(takeAll(), "fnptr")}) ~~>
            = "(" Stars Id <~~ push(up.in) ~~> [ ArrDims ] ")" FnParams ;
TdPlain     <~~ push({dcl: makeDeclr(takeAll(), "plain")}) ~~>
            = [ Stars ] Id <~~ push(up.in) ~~> [ ArrDims ] ;

// A declaration (or a function definition) whose base type is a typedef name.
TdDecl      <~~ push(makeTdDecl(takeAll())) ~~>
            = TdName TdItem { "," TdItem } ";" ;
TdFuncDef   <~~ defineTdFunc(takeAll()) ~~>
            = TdName Id <~~ push(up.in) ~~> ParamList { Attr } Block ;
TdName      <~~ push({tname: up.in}) ~~> = NotCKw Id ;
TdItem      <~~ push({dcl: makeDeclr(takeAll(), "plain")}) ~~>
            = [ Stars ] Id <~~ push(up.in) ~~> [ ArrDims ] [ "=" DInit ] ;
// An identifier that is not one of C's own keywords. A typedef USE is recognized
// by shape alone, so without this guard 'return x;' would read as a declaration.
NotCKw = :script(~~
    (function() {
        var s = 0 // Whitespace is not skipped before a :script, so scan past it first.
        while (c.peek(s) === 32 || c.peek(s) === 9 || c.peek(s) === 10 || c.peek(s) === 13) { s++ }
        var kws = ["auto", "break", "case", "char", "const", "continue", "default", "do",
                   "double", "else", "enum", "extern", "float", "for", "goto", "if",
                   "inline", "int", "long", "register", "restrict", "return", "short",
                   "signed", "sizeof", "static", "struct", "switch", "typedef", "union",
                   "unsigned", "void", "volatile", "while", "_Alignas", "_Alignof",
                   "_Atomic", "_Bool", "_Complex", "_Generic", "_Noreturn",
                   "_Static_assert", "_Thread_local"]
        var hit = false
        for (var k = 0; k < kws.length; k++) {
            var w = kws[k]
            var ok = true
            for (var i = 0; i < w.length; i++) { if (c.peek(s + i) !== w.charCodeAt(i)) { ok = false } }
            if (ok) {
                var cc = c.peek(s + w.length)
                if (!((cc >= 48 && cc <= 57) || (cc >= 65 && cc <= 90) || cc === 95 || (cc >= 97 && cc <= 122))) { hit = true }
            }
        }
        return hit ? abnf.newToken("\x01c-keyword", 0) : undefined
    })()
~~) ;


// A balanced { ... } body consumed without interpreting it (string and char literals
// are matched first so braces inside them are never miscounted). Copied from the
// shared widening pattern (see the Kotlin/Java grammars).
SkipBlock   = "{" { SkipItem } "}" ;
SkipItem    = SkipStr | SkipChar | SkipBlock | SkipOther ;
SkipStr     = '"' :whitespace() { SkipStrEsc | SkipStrChar } '"' :whitespace(Whitespace) ;
SkipStrEsc  = "\\" "\x00"..."\U0010ffff" ;
SkipStrChar = "\x00"..."\x21" | "\x23"..."\x5b" | "\x5d"..."\U0010ffff" ;
SkipChar    = "'" :whitespace() { SkipChEsc | SkipChChar } "'" :whitespace(Whitespace) ;
SkipChEsc   = "\\" "\x00"..."\U0010ffff" ;
SkipChChar  = "\x00"..."\x26" | "\x28"..."\x5b" | "\x5d"..."\U0010ffff" ;
SkipOther   = "\x00"..."\x21" | "\x23"..."\x26" | "\x28"..."\x7a" | "\x7c" | "\x7e"..."\U0010ffff" ;

// A balanced ( ... ) run, parsed and ignored (used to skip __attribute__ argument
// lists). Same shape as SkipBlock but for parentheses; strings and char literals are
// matched first so parens inside them are never miscounted.
SkipParen   = "(" { SkipStr | SkipChar | SkipParen | SkipPOther } ")" ;
SkipPOther  = "\x00"..."\x21" | "\x23"..."\x26" | "\x2a"..."\U0010ffff" ;

// __attribute__((...)) GCC attribute specifiers are accepted and ignored wherever a
// type specifier or a prototype tail may appear; the balanced (( )) body is skipped.
Attr        = ( "__attribute__" | "__attribute" ) SkipParen ;

// #include <stdio.h> or #include "local.h": the header is routed through the
// shared resolveImport (lib/interp-core.js). System <...> headers listed in
// core.stdlibImports resolve; a quoted "local.h" or an unknown header aborts,
// or warns under -warn-imports. The production-level tag's up.in is the whole
// <...>/"..." token including its delimiters, so slice them off to get the bare
// header name. Nothing is pushed, so an include yields no top-level statement.
Include     = "#" "include" ( SysHeader | LocHeader ) ;
SysHeader   <~~ resolveImport(up.in.slice(1, up.in.length - 1), up.pos) ~~>
            = "<" :whitespace() { HdrChar } ">" :whitespace(Whitespace) ;
LocHeader   <~~ resolveImport(up.in.slice(1, up.in.length - 1), up.pos) ~~>
            = '"' :whitespace() { HdrChar } '"' :whitespace(Whitespace) ;
HdrChar     = "\x20"..."\x21" | "\x23"..."\x3b" | "\x3d" | "\x3f"..."\x7e" ;

// struct Point { int x; int y; }; -- the fields: int, int* and, of already defined
// structs, nested struct values and struct pointers (also of the struct itself:
// that is how linked lists work).
StructDef   <~~ defineStruct(takeAll()) ~~>
            = KwStruct Id <~~ push(up.in) ~~> "{" { FieldLine } "}" ";" ;
// A member line is either an ANONYMOUS struct/union member (C11 6.7.2.1p13: its
// members are addressed as members of the enclosing tag) or an ordinary declarator
// list, whose declarators may carry a ':width' bit-field size.
FieldLine   = AnonMember | PlainField ;
PlainField  <~~ push(makeFieldLine(takeAll())) ~~>
            = FieldType ( AnonBits | FDecl { "," FDecl } ) ";" ;
AnonMember  <~~ push(makeAnonMember(takeAll())) ~~>
            = AnonKind "{" { FieldLine } "}" ";" ;
AnonKind    = KwUnion <~~ push({anon: true, u: true}) ~~>
            | KwStruct <~~ push({anon: true, u: false}) ~~> ;
// The base type text is kept so that an UNSIGNED bit field can wrap where a signed
// one sign-extends; everything else about the width still collapses to the int model.
FieldType   = TypeInt <~~ push({bty: "int", raw: up.in}) ~~>
            | EnumRef <~~ push({bty: "int"}) ~~>
            | KwStruct Id <~~ push({bty: up.in}) ~~>
            | KwUnion Id <~~ push({bty: uKey(up.in)}) ~~> ;
FDecl       = [ Stars ] Id <~~ push(up.in) ~~> [ ArrDims ] [ BitWidth ] ;
// 'unsigned a : 3' - the declared width in bits.
BitWidth    <~~ push({bits: pop()}) ~~> = ":" Number ;
// An UNNAMED bit field ('int : 3;', 'int : 0;') is pure padding: it is parsed, and
// reserves a slot of its own so the named members around it keep their order.
AnonBits    <~~ push({padBits: pop()}) ~~> = ":" Number ;

// A function prototype (int putchar(int c);) is accepted and ignored: the callees
// are resolved by name anyway. It keeps the test programs valid for a real C compiler.
Proto       <~~ pop(); pop() /* Drop the collected name and parameters. */ ~~>
            = TypeInt [ PStars ] Id <~~ push(up.in) ~~> ParamList { Attr } ";" ;

// The merged pushes: [name, [params...], bodyThunk]. A parameter is {name, ptr, sname?}.
FuncDef     <~~ defineFunction() ~~>
            = TypeInt Id <~~ push(up.in) ~~> ParamList { Attr } Block ;

// A function whose RETURN type is a struct or union (by value, or a pointer to one).
// A struct value is an address into the flat memory, and the memory of a call frame
// is never reused, so returning one is returning that address; whoever receives it
// (a declaration, an assignment) copies the words out.
SFuncDef    <~~ defineSFunction(takeAll()) ~~>
            = SRetType Id <~~ push(up.in) ~~> ParamList { Attr } Block ;
SProto      <~~ takeAll() /* A prototype needs no lowering. */ ~~>
            = SRetType Id ParamList { Attr } ";" ;
SRetType    <~~ push({ret: makeRetCt(takeAll())}) ~~>
            = ( KwStruct Id <~~ push(up.in) ~~> | KwUnion Id <~~ push(uKey(up.in)) ~~> ) [ Stars ] ;

// 'int (*pick(int w))(int) { ... }' - a function RETURNING a function pointer. The
// returned value is the callee's identifier, so the return type is an ordinary int
// cell; only the declarator syntax is unusual.
FnPtrFuncDef <~~ defineFnPtrFunc(takeAll()) ~~>
            = TypeInt "(" Stars Id <~~ push(up.in) ~~> ParamList ")" FnParams { Attr } Block ;
// The parameter list of a function TYPE ('(int)', '(void)', '(int, char *)'): only
// the arity of the call matters here, so the balanced run is parsed and ignored.
FnParams    = SkipParen ;

// Param is tried before the empty (void): 'void' as a base type only makes a
// parameter with '*' (void *p); a bare '(void)' has no declarator, so Param fails
// on the missing name and the '(void)' fallback matches. A trailing '...' (a
// variadic function) is accepted and ignored: only its named parameters are tracked.
// VoidOnly comes FIRST and declines a following '*', so a bare '(void)' is the empty
// parameter list while '(void *p)' falls through to a real parameter. (A PEG never
// retries a committed alternative, so the two forms cannot be told apart by order
// alone - the negative lookahead is what decides.) A parameter may be UNNAMED, which
// is the normal shape of a prototype: int printf(const char *, ...);
ParamList   <~~ push(takeAll()) ~~>
            = "(" [ ( VoidOnly | ParamItem { "," ParamItem } [ "," "..." ] | "..." ) ] ")" ;
VoidOnly    = "void" KwEnd !"*" ;
ParamItem   = FnPtrParam | Param | ParamAbs ;
// 'int (*f)(int)' as a parameter: one cell holding a function identifier.
FnPtrParam  <~~ push(makeFnPtrParam(takeAll())) ~~>
            = ParamType "(" Stars Id <~~ push(up.in) ~~> ")" FnParams ;
Param       <~~ push(makeParam(takeAll())) ~~>
            = ParamType [ Stars ] Id <~~ push(up.in) ~~> ;
// An abstract (unnamed) parameter: only its type matters, and nothing can read it.
ParamAbs    <~~ push(makeParam(takeAll())) ~~>
            = ParamType [ Stars ] ;
ParamType   = BaseTy | KwStruct Id <~~ push({sname: up.in}) ~~>
            | KwUnion Id <~~ push({sname: uKey(up.in)}) ~~> ;

// Globals are declared like locals but registered at build time.
GlobalDecl  <~~ defineGlobals(takeAll()) ~~>
            = BaseTy GDeclarator { "," GDeclarator } ";" ;
GDeclarator <~~ push({dcl: makeDeclr(takeAll(), "plain")}) ~~>
            = [ Stars ] Id <~~ push(up.in) ~~> [ ArrDims | GInit ] ;
GInit       <~~ push({gv: pop()}) ~~> = "=" Number ;
// The declaration BASE type, kept as a real C type so that a char is one byte wide
// and an unsigned int divides and compares unsigned. Pushes {bty: ct}.
BaseTy      <~~ push({bty: baseCtOf(up.in)}) ~~> = TypeInt | EnumRef ;
ArraySize   <~~ push({size: pop()}) ~~>
            = "[" Number "]" ;

// Global struct variables, pointers and arrays (zero initialized like all globals).
StructGDecl <~~ defineStructGlobals(takeAll()) ~~>
            = KwStruct Id <~~ push(up.in) ~~> SGDecl { "," SGDecl } ";" ;
SGDecl      <~~ push(makeSDecl(takeAll())) ~~>
            = [ Stars ] Id <~~ push(up.in) ~~> [ ArraySize ] ;

// Aggregate '= { ... }' initializers on GLOBALS are accepted and reported as not
// implemented (a global is registered at build time, where no initializer can run).
// AggForm matches only the unsupported shapes, so a plain 'int a[3];' still falls
// through to the genuine declarators. The declarator, dimensions and '{ ... }' body
// are all skipped; takeAll() drops whatever the dimension sizes pushed.
GAggDecl    <~~ takeAll(); notImpl("aggregate initializer", up.pos) ~~>
            = AggBase { PStars } Id AggForm ";" ;
AggBase     = BaseInt | KwStruct Id | KwUnion Id ;
AggForm     = EmptyArr [ "=" SkipBlock ]
            | ArraySize ArraySize { ArraySize } [ "=" SkipBlock ]
            | ArraySize "=" SkipBlock
            | "=" SkipBlock ;
EmptyArr    = "[" "]" ;

// A '*' run in a position that pushes nothing (prototypes, casts, sizeof names).
PStars      = "*" { PtrQual | "*" } ;

// A run of one or more '*' in a declarator, with the pointer qualifiers that may sit
// between them. Every level is one word holding an address, so int** nests freely.
Stars       <~~ push(makeStars(up.in, up.pos)) ~~> = "*" { PtrQual | "*" } ;
// const/volatile/restrict/_Atomic may follow a '*' (int *const p, int *restrict q).
PtrQual     = "const" KwEnd | "volatile" KwEnd | "restrict" KwEnd | "_Atomic" KwEnd ;

// Every statement production pushes exactly one thunk: function() -> undefined | signal.
// StructDecl / UnionDecl come BEFORE AggDecl: a 'struct P p = { ... }' brace
// initializer is genuinely lowered now, and only the shapes those two decline (two or
// more array dimensions, a braced scalar) still fall through to the AggDecl notImpl.
Statement   = Block | If | While | Do | For | Switch | Return | Break | Continue
            | AssertStmt | BoolDecl | LStructDef | LUnionDef | StructDefDecl | UnionDefDecl
            | StaticDecl | StructDecl | UnionDecl | AggDecl | Decl
            | Goto | PPStmt | Label | TdDecl | Empty | ExprStmt ;

// A struct definition inside a function body. The layout is registered exactly like a
// top-level one (the tag runs at build time), and the statement itself does nothing.
LStructDef  <~~ defineStruct(takeAll()); push(function() {}) ~~>
            = KwStruct Id <~~ push(up.in) ~~> "{" { FieldLine } "}" ";" ;
// A tag definition that also declares locals, and its union twin.
StructDefDecl <~~ push(makeStructDecl(tagDefDecl(takeAll(), false))) ~~> = StructDefBody ;
UnionDefDecl  <~~ push(makeStructDecl(tagDefDecl(takeAll(), true))) ~~>  = UnionDefBody ;
// The same for a union definition inside a function body.
LUnionDef   <~~ defineUnion(takeAll()); push(function() {}) ~~>
            = KwUnion Id <~~ push(uKey(up.in)) ~~> "{" { FieldLine } "}" ";" ;

// A static local: the storage is allocated ONCE and survives across calls, unlike an
// ordinary local. At the top level 'static' is just a linkage word on a global and is
// parsed by TypeInt, so this form only ever claims a statement.
StaticDecl  <~~ push(makeDeclSeq(takeAll(), true)) ~~>
            = KwStatic BaseTy SInitDecl { "," SInitDecl } ";" ;
SInitDecl   <~~ push({dcl: makeDeclr(takeAll(), "plain")}) ~~>
            = [ Stars ] Id <~~ push(up.in) ~~> [ ArrDims | InferArr ] [ "=" DInit ] ;

// Local aggregate / multi-dimensional / brace-initialized declarations: the statement
// form of GAggDecl (see there). Placed before StructDecl and Decl so it claims only
// the unsupported shapes and leaves genuine 'int a[3];' / 'struct P p;' to them.
AggDecl     <~~ takeAll(); push(notImplStmt("aggregate initializer", up.pos)) ~~>
            = AggBase { PStars } Id LAggForm ";" ;
// The LOCAL shape still unsupported: a brace initializer on a SCALAR ('int x = { 1 };').
// Arrays of any rank and structs are genuine declarators now.
LAggForm    = EmptyArr
            | "=" SkipBlock ;

// goto jumps to a label of an enclosing statement SEQUENCE: the goto yields a signal
// (interpreter) resp. branches to the label's basic block (compiler), which covers
// forward jumps, backward jumps and jumps out of nested loops.
Goto        <~~ push(makeGoto(pop())) ~~>
            = KwGoto Id <~~ push(up.in) ~~> ";" ;
// A label must not be 'case' or 'default': those are switch labels and must be left
// for the enclosing switch (a case body is a { Statement } run, so without this guard
// a label would swallow the following 'default:' clause).
Label       <~~ push(makeLabel(takeAll())) ~~>
            = NotSwitchKw Id <~~ push(up.in) ~~> ":" Statement ;
NotSwitchKw = :script(~~
    (function() {
        var s = 0 // Whitespace is not skipped before a :script, so scan past it first.
        while (c.peek(s) === 32 || c.peek(s) === 9 || c.peek(s) === 10 || c.peek(s) === 13) { s++ }
        var kws = ["case", "default"]
        var hit = false
        for (var k = 0; k < kws.length; k++) {
            var w = kws[k]
            var ok = true
            for (var i = 0; i < w.length; i++) { if (c.peek(s + i) !== w.charCodeAt(i)) { ok = false } }
            if (ok) {
                var cc = c.peek(s + w.length)
                if (!((cc >= 48 && cc <= 57) || (cc >= 65 && cc <= 90) || cc === 95 || (cc >= 97 && cc <= 122))) { hit = true }
            }
        }
        return hit ? abnf.newToken("\x01switch-label", 0) : undefined
    })()
~~) ;

// A preprocessor line inside a function body is skipped (no-op statement).
PPStmt      <~~ push(function() {}) ~~>
            = PPLine ;

// Local struct variables, struct pointers (with optional initializer) and struct arrays.
// A struct value may carry a brace initializer, with '.field =' designators.
StructDecl  <~~ push(makeStructDecl(takeAll())) ~~>
            = KwStruct Id <~~ push(up.in) ~~> SDeclarator { "," SDeclarator } ";" ;
// The same shapes for a union: 'union U u;', 'union U *p = q;', 'union U u = { .f = v };'.
UnionDecl   <~~ push(makeStructDecl(takeAll())) ~~>
            = KwUnion Id <~~ push(uKey(up.in)) ~~> SDeclarator { "," SDeclarator } ";" ;
SDeclarator <~~ push(makeSDecl(takeAll())) ~~>
            = [ Stars ] Id <~~ push(up.in) ~~>
              [ ArraySize | "=" DInit ] ;

Block       <~~ push(makeBlockStmt(takeAll())) ~~>
            = "{" { Statement } "}" ;

If          <~~ push(makeIf(takeAll())) ~~>
            = KwIf "(" Expression ")" Statement [ KwElse Statement ] ;

While       <~~ push(makeWhile(pop(), pop())) ~~>
            = KwWhile "(" Expression ")" Statement ;

Do          <~~ push(makeDo(pop(), pop())) ~~>
            = KwDo Statement KwWhile "(" Expression ")" ";" ;

For         <~~ push(makeFor(takeAll())) ~~>
            = KwFor "(" [ ForInit ] ";" [ ForCond ] ";" [ ForPost ] ")" Statement ;
ForInit     <~~ push({k:"init", t:pop()}) ~~> = ForVar | ForExpr ;
ForVar      = DeclCore ;
ForExpr     <~~ push(exprToStmt(pop())) ~~> = Expression ;
ForCond     <~~ push({k:"cond", t:pop()}) ~~> = Expression ;
ForPost     <~~ push({k:"post", t:exprToStmt(pop())}) ~~> = Expression ;

Return      <~~ push(makeReturn(takeAll())) ~~>
            = KwReturn [ Expression ] ";" ;

Break       <~~ push(makeBreak()) ~~>   = KwBreak ";" ;
Continue    <~~ push(makeContinue()) ~~> = KwContinue ";" ;

// C switch with fallthrough: execution starts at the first matching case (or default)
// and runs until a break or the end of the switch. Labels may stack (case 1: case 2:).
Switch      <~~ push(makeSwitch(takeAll())) ~~>
            = KwSwitch "(" Expression ")" "{" { SwitchCase } "}" ;
SwitchCase  = Case | Default ;
Case        <~~ push(makeCase(takeAll())) ~~>
            = KwCase CondExpr ":" { Statement } ;
Default     <~~ push(makeDefault(takeAll())) ~~>
            = KwDefault ":" { Statement } ;

Decl        = DeclCore ";" ;
DeclCore    <~~ push(makeDeclSeq(takeAll(), false)) ~~>
            = BaseTy DeclItem { "," DeclItem } ;
// A parenthesized declarator: 'int (*pa)[3]' is a POINTER TO an array of 3 ints,
// which is a different type from the 'int *pa[3]' array of pointers that InitDecl
// reads. It has to be tried first - InitDecl cannot start with a '('.
// FnPtrDecl comes first: both start '( * name', and only what follows the ')' tells
// a function pointer ('(int)') from a pointer to an array ('[3]') apart.
DeclItem    = FnPtrDecl | PtrArrDecl | InitDecl ;
// 'int (*fp)(int)' - a pointer to a function - and 'int (*tab[2])(int)', an array
// of them. A function pointer is one cell holding the callee's identifier.
FnPtrDecl   <~~ push({dcl: makeDeclr(takeAll(), "fnptr")}) ~~>
            = "(" Stars Id <~~ push(up.in) ~~> [ ArrDims ] ")" FnParams [ "=" DInit ] ;
PtrArrDecl  <~~ push({dcl: makeDeclr(takeAll(), "ptrarr")}) ~~>
            = "(" Stars Id <~~ push(up.in) ~~> ")" ArrDims [ "=" DInit ] ;
InitDecl    <~~ push({dcl: makeDeclr(takeAll(), "plain")}) ~~>
            = [ Stars ] Id <~~ push(up.in) ~~>
              [ ArrDims | InferArr ] [ "=" DInit ] ;
// A declarator's array dimensions, outermost first: 'int m[2][3]' is an array of 2
// arrays of 3 ints, and every dimension is one level of the {k:"arr"} C type.
ArrDims     <~~ push({dims: takeAll()}) ~~> = ArrDim { ArrDim } ;
ArrDim      = "[" Number "]" ;
// 'int a[] = { ... }': the size comes from the initializer (-1 asks for that).
InferArr    <~~ push({dims: [-1]}) ~~> = "[" "]" ;
// A declaration initializer: a brace list, a string literal (which initializes a
// char array element by element, C11 6.7.9p14), or one ordinary expression.
DInit       = BraceInit | StrInit | AssignExpr ;
StrInit     <~~ push(makeStrInit(up.in)) ~~> = StrTok { StrTok } ;
// A brace initializer collects its items; a trailing comma is allowed.
BraceInit   <~~ push({list: takeAll()}) ~~>
            = "{" [ DItem { "," DItem } [ "," ] ] "}" ;
DItem       <~~ push(makeDItem(takeAll())) ~~> = [ ArrDesig | FldDesig ] DInit ;
// The array designator '[2] = value' and the struct/union form '.field = value'.
ArrDesig    <~~ push({at: pop()}) ~~> = "[" Number "]" "=" ;
FldDesig    = "." Id <~~ push({fld: up.in}) ~~> "=" ;

Empty       <~~ push(function() {}) ~~>
            = ";" ;

ExprStmt    <~~ push(exprToStmt(pop())) ~~>
            = Expression ";" ;

// Every expression production pushes exactly one thunk: function() -> 32 bit value.
// The comma operator evaluates each side in order and yields the last (real C).
Expression  <~~ push(makeComma(takeAll())) ~~>
            = AssignExpr { "," AssignExpr } ;

// Assignment is an expression: the target is an lvalue (a variable, *expr or a[i]).
AssignExpr  = Assignment | CondExpr ;
Assignment  <~~ push(makeAssign(takeAll())) ~~>
            = Lvalue ( "<<=" | ">>=" | "+=" | "-=" | "*=" | "/=" | "%=" | "&=" | "^=" | "|=" | "=" ) <~~ push(up.in) ~~> AssignExpr ;

// An lvalue thunk evaluates to an address. A place is a variable followed by any
// mix of indexing and struct member steps: a[i], p.x, r.min.y, head->next->value.
// A parenthesized lvalue may itself carry a suffix chain, so '(*pa)[1]' and '(*p).f'
// are places like 'pa[1]' and 'p->f'.
// DerefP ('*' of a PLACE) comes before the general Deref ('*' of any expression):
// only the place form knows the C type of what it dereferences, which is what makes
// '(*pa)[1]' step by whole rows of 'int (*pa)[3]'.
Lvalue      = StrPlaceP | CompLitP | DerefP | Deref | ParenSfx | ParenPlace | VarPlace ;
// A STRING LITERAL is an array object of static storage duration, so it is a place:
// "abc"[1] indexes it, sizeof "abc" is its byte size, and reading it decays to a
// pointer to its first character. Adjacent literals concatenate (C11 6.4.5p5); an
// L / u / U / u8 prefix makes the elements wide.
StrPlaceP   <~~ push(makeSfxChain(takeAll())) ~~>
            = StrPlace { PlaceSfx } ;
StrPlace    <~~ push(makeStrPlace(up.in)) ~~>
            = StrTok { StrTok } ;
StrTok      = [ StrPfx ] SkipStr ;
StrPfx      = "u8" | "L" | "u" | "U" ;
// A COMPOUND LITERAL '(Type){ ... }' (C11 6.5.2.5) is an unnamed object with
// automatic storage - an lvalue - so it takes a suffix chain like any other place,
// and '&' may be applied to it.
CompLitP    <~~ push(makeSfxChain(takeAll())) ~~>
            = CompLit { PlaceSfx } ;
CompLit     <~~ push(makeCompLit(takeAll())) ~~>
            = "(" CompType ")" BraceInit ;
CompType    <~~ push({clt: makeCompDesc(takeAll())}) ~~>
            = CompBase [ Stars ] [ ArrDims | InferArr ] ;
CompBase    = TypeInt <~~ push({bs: baseCtOf(up.in)}) ~~>
            | EnumRef <~~ push({bs: ctInt}) ~~>
            | KwStruct Id <~~ push({bs: ctStruct(up.in)}) ~~>
            | KwUnion Id <~~ push({bs: ctStruct(uKey(up.in))}) ~~> ;
ParenSfx    <~~ push(makeSfxChain(takeAll())) ~~>
            = "(" Lvalue ")" PlaceSfx { PlaceSfx } ;
ParenPlace  = "(" Lvalue ")" ;
DerefP      <~~ push(makeDerefP(pop())) ~~>
            = "*" Lvalue ;
Deref       <~~ push(makeDerefPlace(pop())) ~~>
            = "*" UnaryExpr ;
VarPlace    <~~ push(makeVarPlace(takeAll())) ~~>
            = Id <~~ push(up.in) ~~> { PlaceSfx } ;
PlaceSfx    = Index | Arrow | Member ;
Index       <~~ push({idx: pop()}) ~~>
            = "[" Expression "]" ;
Arrow       = "->" Id <~~ push({arw: up.in}) ~~> ;
Member      = "." Id <~~ push({fld: up.in}) ~~> ;

CondExpr    <~~ push(makeCond(takeAll())) ~~>
            = OrExpr [ "?" AssignExpr ":" AssignExpr ] ;

OrExpr      <~~ push(makeOrAnd(takeAll(), "||")) ~~>
            = AndExpr { "||" AndExpr } ;

AndExpr     <~~ push(makeOrAnd(takeAll(), "&&")) ~~>
            = BitOrExpr { "&&" BitOrExpr } ;

BitOrExpr   <~~ push(foldBinary(takeAll())) ~~>
            = BitXorExpr { "|" <~~ push("|") ~~> BitXorExpr } ;
BitXorExpr  <~~ push(foldBinary(takeAll())) ~~>
            = BitAndExpr { "^" <~~ push("^") ~~> BitAndExpr } ;
// The & operator must not match the start of &&: && with an addressable right side
// (0 && bump()) would otherwise parse as 0 & (&bump) and poison the parse.
BitAndExpr  <~~ push(foldBinary(takeAll())) ~~>
            = EqExpr { "&" <~~ push("&") ~~> NotAmp EqExpr } ;
NotAmp = :script(~~
    (function() {
        return (c.peek(0) === 38) ? abnf.newToken("\x01single-amp-only", 0) : undefined
    })()
~~) ;

EqExpr      <~~ push(foldBinary(takeAll())) ~~>
            = RelExpr { ( "==" | "!=" ) <~~ push(up.in) ~~> RelExpr } ;

RelExpr     <~~ push(foldBinary(takeAll())) ~~>
            = ShiftExpr { ( "<=" | ">=" | "<" | ">" ) <~~ push(up.in) ~~> ShiftExpr } ;

ShiftExpr   <~~ push(foldBinary(takeAll())) ~~>
            = AddExpr { ( "<<" | ">>" ) <~~ push(up.in) ~~> AddExpr } ;

AddExpr     <~~ push(foldBinary(takeAll())) ~~>
            = MulExpr { ( "+" | "-" ) <~~ push(up.in) ~~> MulExpr } ;

MulExpr     <~~ push(foldBinary(takeAll())) ~~>
            = UnaryExpr { ( "*" | "/" | "%" ) <~~ push(up.in) ~~> UnaryExpr } ;

// Prefix operators. ++/-- work on lvalues; & takes the address of an lvalue;
// * dereferences (as an expression it loads the pointed to value).
// AlignOf comes before PostfixExpr: '_Alignof(int)' looks exactly like a call of a
// function named _Alignof, and the general call seed would claim it first.
UnaryExpr   = PreIncDec | AddrOf | DerefLoad | Neg | Not | BitNot | Sizeof | AlignOf | Generic | Cast | PostfixExpr ;

// A cast '(Type)expr' converts the value to the named type: an integer wraps to that
// type's width and signedness, a float truncates towards zero on the way to an
// integer, and a pointer cast only re-labels the address. TypeName requires a real
// type keyword, so '(expr)' still parses as a parenthesized expression.
Cast        <~~ push(makeCast(takeAll())) ~~>
            = "(" TypeName ")" UnaryExpr ;

// sizeof: the byte size the type model pins - char 1, short 2, int 4, any long and
// any double 8, any pointer 8, a struct the packed sum, a union the maximum over its
// members, an array its element count times the element size. Over an EXPRESSION the
// answer is the size of that expression's type, which is what makes 'sizeof a' on a
// char array answer its length. SizeofPlace comes before SizeofExpr so that the
// common 'sizeof name' shape needs no evaluation of anything but an address.
Sizeof      = KwSizeof ( SizeofType | SizeofPlace | SizeofExpr ) ;
SizeofType  <~~ push(makeSizeof(pop())) ~~>
            = "(" TypeName ")" ;
SizeofPlace <~~ push(makeSizeofPlace(pop())) ~~>
            = Lvalue ;
SizeofExpr  <~~ push(makeSizeofExpr(pop())) ~~>
            = UnaryExpr ;
// _Alignof(type): for the scalar types this machine models, the alignment equals the
// size, and a pointer aligns to 8 like it is sized.
AlignOf     <~~ push(makeSizeof(pop())) ~~>
            = KwAlignof "(" TypeName ")" ;
// A TYPE NAME: a scalar/struct/union/enum base plus a run of pointer stars.
TypeName    <~~ push(makeTypeName(takeAll())) ~~>
            = SizeBase { "*" <~~ push("*") ~~> [ PtrQual ] } ;
SizeBase    = ScalarName
            | EnumRef <~~ push(ctInt) ~~>
            | KwStruct Id <~~ push(ctStruct(up.in)) ~~>
            | KwUnion Id <~~ push(ctStruct(uKey(up.in))) ~~> ;
// A scalar type name, kept keyword by keyword so the width and the signedness both
// survive.
ScalarName  <~~ push(makeScalarName(takeAll())) ~~>
            = ScalarTok { ScalarTok } ;

// _Generic(controlling, type: value, ..., default: value) - C11 6.5.1.1. The
// association whose type name is the controlling expression's own type is the one
// the whole construct yields; the others are never evaluated.
Generic     <~~ push(makeGeneric(takeAll())) ~~>
            = KwGeneric "(" AssignExpr "," GenAssoc { "," GenAssoc } ")" ;
GenAssoc    <~~ push(makeGenAssoc(takeAll())) ~~>
            = ( TypeName | KwDefault <~~ push("default") ~~> ) ":" AssignExpr ;
KwGeneric   = "_Generic" KwEnd ;
ScalarTok   <~~ push(up.in) ~~> = ScalarKw ;
ScalarKw    = "char" KwEnd | "short" KwEnd | "int" KwEnd | "long" KwEnd
            | "unsigned" KwEnd | "signed" KwEnd | "void" KwEnd
            | "float" KwEnd | "double" KwEnd | "_Bool" KwEnd
            | "const" KwEnd | "volatile" KwEnd ;
PreIncDec   <~~ push(makePreIncDec(pop(), pop())) ~~>
            = ( "++" | "--" ) <~~ push(up.in) ~~> Lvalue ;
AddrOf      <~~ push(makeAddrOf(pop())) ~~>
            = "&" Lvalue ;
DerefLoad   <~~ push(makeLoad(makeDerefPlace(pop()))) ~~>
            = "*" UnaryExpr ;
Neg         <~~ push(makeNeg(pop())) ~~>
            = "-" UnaryExpr ;
Not         <~~ push(makeNot(pop())) ~~>
            = "!" UnaryExpr ;
BitNot      <~~ push(makeBitNot(pop())) ~~>
            = "~" UnaryExpr ;

PostfixExpr = PostIncDec | CallExpr | Primary ;
PostIncDec  <~~ push(makePostIncDec(pop(), pop())) ~~>
            = Lvalue ( "++" | "--" ) <~~ push(up.in) ~~> ;

// A call whose callee is an EXPRESSION: a bare name (the ordinary direct call, and
// also a variable holding a function pointer), a parenthesized place ('(*fp)(4)'),
// or a place path ('tab[0](3)'). Several argument lists chain, so 'pick(1)(5)' calls
// what pick returned.
CallExpr    <~~ push(makeCallExpr(takeAll())) ~~>
            = CallSeed ArgList { ArgList } ;
CallSeed    = ParenSfxRef | ParenPlaceRef | PlaceRef | NameSeed ;
ParenPlaceRef <~~ push(makeLoad(pop())) ~~> = "(" Lvalue ")" ;
NameSeed    <~~ push({fname: up.in}) ~~> = Id ;
ArgList     <~~ push({args: takeAll()}) ~~>
            = "(" [ AssignExpr { "," AssignExpr } ] ")" ;

// A plain variable reference loads the value; an array name yields its address.
// A place path as an expression (a[i], p.x, head->next) loads the resolved cell.
// A string literal (with adjacent-literal concatenation) has no char* backing on the
// flat integer memory, so it is accepted and reported as not implemented.
// ParenSfxRef comes first: '(*pa)[1]' starts like a parenthesized expression, and the
// general form would consume '(*pa)' and leave the '[1]' behind.
// FloatLit comes before NumberLit: the integer form matches the '1' of '1e3' and a
// PEG never goes back for the longer read.
Primary     = CompLitRef | ParenSfxRef | "(" Expression ")" | StrRef | FloatLit | NumberLit | CharLit | PlaceRef | VarRef ;
ParenSfxRef <~~ push(makeLoad(pop())) ~~> = ParenSfx ;
CompLitRef  <~~ push(makeLoad(pop())) ~~> = CompLitP ;
StrRef      <~~ push(makeLoad(pop())) ~~> = StrPlaceP ;
// A floating constant: decimal or hexadecimal, with an optional exponent and an
// optional f/F (float) or l/L (long double) suffix. The hexadecimal form REQUIRES
// its binary exponent, so 0x1F stays an integer.
FloatLit    <~~ push(makeFltLit(up.in)) ~~> = FloatNum ;
FloatNum    = ( "0x" | "0X" ) :whitespace() HexDig { HexDig } [ "." { HexDig } ] BinExp [ FltSfx ] :whitespace(Whitespace)
            | ( "0x" | "0X" ) :whitespace() "." HexDig { HexDig } BinExp [ FltSfx ] :whitespace(Whitespace)
            | "0"..."9" :whitespace() { "0"..."9" } ( "." { "0"..."9" } [ DecExp ] | DecExp ) [ FltSfx ] :whitespace(Whitespace)
            | "." :whitespace() "0"..."9" { "0"..."9" } [ DecExp ] [ FltSfx ] :whitespace(Whitespace) ;
DecExp      = ( "e" | "E" ) [ "+" | "-" ] "0"..."9" { "0"..."9" } ;
BinExp      = ( "p" | "P" ) [ "+" | "-" ] "0"..."9" { "0"..."9" } ;
FltSfx      = "f" | "F" | "l" | "L" ;
PlaceRef    <~~ push(makeLoad(makeVarPlace(takeAll()))) ~~>
            = Id <~~ push(up.in) ~~> PlaceSfx { PlaceSfx } ;
NumberLit   <~~ push(makeNumLit(pop(), up.in)) ~~>
            = Number ;
// A character constant has type int (C11 6.4.4.4p10); a wide one (L, u, U) has the
// width of its wide type, which this model pins at 4 like int.
CharLit     = [ CharPfx ] "'" :whitespace() CChar <~~ push(makeNum(cCharCode(up.in), ctInt)) ~~> "'" :whitespace(Whitespace) ;
CharPfx     = "L" | "u8" | "u" | "U" ;
// One character constant body: a hex escape (backslash x plus hex digits), an octal
// escape (backslash plus one to three octal digits), a simple escape, or a plain
// character. The hex and octal forms come first so their digits are not cut short.
CChar       = "\\" "x" HexDig { HexDig } | "\\" OctDig [ OctDig [ OctDig ] ]
            | "\\" "\x20"..b"\x7e" | "\x20"..."\x26" | "\x28"..."\x5b" | "\x5d"..."\x7e" ;
VarRef      <~~ push(makeVarRef(up.in)) ~~>
            = Id ;

// A hexadecimal (0x...) or decimal integer literal with optional C integer suffixes
// (u/U/l/L in any combination). parseInt reads the 0x prefix and stops at the suffix
// letters, so hex and suffixed literals both yield the right 32-bit value.
Number      <~~ push(parseCInt(up.in)) ~~>
            = ( "0x" | "0X" ) :whitespace() HexDig { HexDig } { IntSfx } :whitespace(Whitespace)
            | ( "0b" | "0B" ) :whitespace() BinDig { BinDig } { IntSfx } :whitespace(Whitespace)
            | "0" :whitespace() OctDig { OctDig } { IntSfx } :whitespace(Whitespace)
            | ( "0" | "1"..."9" ) :whitespace() { "0"..."9" } { IntSfx } :whitespace(Whitespace) ;
HexDig      = "0"..."9" | "a"..."f" | "A"..."F" ;
OctDig      = "0"..."7" ;
BinDig      = "0" | "1" ;
IntSfx      = "u" | "U" | "l" | "L" ;

// The scalar integer type: any run of int-family keywords and qualifiers, all of
// which collapse to the one 32-bit int model (unsigned/signed/short/long widths and
// const/volatile qualifiers are parsed and ignored; char is a full int-sized word;
// void is accepted here so that void and void* parse). Storage-class and function
// specifiers (static/extern/register/auto/inline/_Noreturn/_Thread_local) and the
// _Atomic/restrict qualifiers are likewise parsed and ignored; _Bool and _Complex
// collapse to int; __attribute__((...)) specifiers are skipped. Pushes nothing.
TypeInt     = TypeElem { TypeElem } ;
TypeElem    = TypeTok | Attr | AlignAs ;
// _Alignas(8) / _Alignas(int): parsed and ignored (the layout is fixed).
AlignAs     = "_Alignas" KwEnd SkipParen ;
TypeTok     = "int" KwEnd | "char" KwEnd | "short" KwEnd | "long" KwEnd
            | "float" KwEnd | "double" KwEnd
            | "unsigned" KwEnd | "signed" KwEnd | "void" KwEnd
            | "const" KwEnd | "volatile" KwEnd
            | "static" KwEnd | "extern" KwEnd | "register" KwEnd | "auto" KwEnd
            | "inline" KwEnd | "restrict" KwEnd | "_Bool" KwEnd | "_Complex" KwEnd
            | "_Noreturn" KwEnd | "_Atomic" KwEnd | "_Thread_local" KwEnd ;
// A declaration base type: a scalar, or an enum tag used as an int. Pushes nothing.
BaseInt     = TypeInt | EnumRef ;
EnumRef     = KwEnum Id ;


// 'struct S { int x; } s, *p;' / 'union { int i; } u;' - a tag DEFINITION that also
// declares objects. The tag may be omitted, in which case the layout gets a synthetic
// name that no other declaration can spell. The shared *Body productions carry the
// syntax; the four wrappers differ only in whether the objects become locals or
// globals, and whether the tag is a struct or a union.
StructDefBody = KwStruct [ Id <~~ push({tag: up.in}) ~~> ] "{" { FieldLine } "}"
                SDeclarator { "," SDeclarator } ";" ;
UnionDefBody  = KwUnion [ Id <~~ push({tag: up.in}) ~~> ] "{" { FieldLine } "}"
                SDeclarator { "," SDeclarator } ";" ;
GStructDefDecl <~~ defineStructGlobals(tagDefDecl(takeAll(), false)) ~~> = StructDefBody ;
GUnionDefDecl  <~~ defineStructGlobals(tagDefDecl(takeAll(), true)) ~~>  = UnionDefBody ;

KwStruct    = "struct" KwEnd ;
KwStatic    = "static" KwEnd ;
KwEnum      = "enum" KwEnd ;
KwUnion     = "union" KwEnd ;
KwTypedef   = "typedef" KwEnd ;
KwGoto      = "goto" KwEnd ;
// _Static_assert(constant-expression, "message"); - accepted and skipped at both the
// top level and inside a function body. The condition is not evaluated: it is a
// compile-time diagnostic, and this front end reports no diagnostics of its own.
StaticAssert = KwStaticAs SkipParen ";" ;
AssertStmt  <~~ push(function() {}) ~~> = StaticAssert ;

// _Bool declarations get their own form so an initializer is normalized to 0 or 1,
// which is what makes '_Bool two = 2;' hold 1 (TypeInt alone collapses _Bool to int).
BoolDecl    <~~ push(makeSeq(takeAll())) ~~>
            = KwBool BInitDecl { "," BInitDecl } ";" ;
BInitDecl   <~~ push(makeBoolDecl(takeAll())) ~~>
            = Id <~~ push(up.in) ~~> [ "=" AssignExpr ] ;

KwSizeof    = "sizeof" KwEnd ;
KwAlignof   = "_Alignof" KwEnd ;
KwStaticAs  = "_Static_assert" KwEnd ;
KwBool      = "_Bool" KwEnd ;
KwIf        = "if" KwEnd ;
KwElse      = "else" KwEnd ;
KwWhile     = "while" KwEnd ;
KwDo        = "do" KwEnd ;
KwFor       = "for" KwEnd ;
KwReturn    = "return" KwEnd ;
KwBreak     = "break" KwEnd ;
KwContinue  = "continue" KwEnd ;
KwSwitch    = "switch" KwEnd ;
KwCase      = "case" KwEnd ;
KwDefault   = "default" KwEnd ;

// ---


:startScript(~~

    // Shared interpreter machinery (scopes, BRK/CONT protocol, expression and
    // statement builders); language-specific behavior is configured on `core` below.
    include("lib/interp-core.js")

    // The digit value of one character in base 16 (also covers bases 2, 8 and 10).
    function digVal(cc) {
        if (cc >= 48 && cc <= 57) return cc - 48
        if (cc >= 97 && cc <= 102) return cc - 87
        if (cc >= 65 && cc <= 70) return cc - 55
        return -1
    }
    // A C integer constant: 0x/0X hex, 0b/0B binary, a leading 0 octal, or decimal,
    // with any run of u/U/l/L suffix letters. Read as a 32-bit two's complement value.
    function parseCInt(s) {
        var base = 10
        var i = 0
        if (s.length > 1 && s.charCodeAt(0) == 48) {
            var c1 = s.charCodeAt(1)
            if (c1 == 120 || c1 == 88) { base = 16; i = 2 }
            else if (c1 == 98 || c1 == 66) { base = 2; i = 2 }
            else { base = 8; i = 1 }
        }
        var v = 0
        for (; i < s.length; i++) {
            var d = digVal(s.charCodeAt(i))
            if (d < 0 || d >= base) break   // The u/U/l/L suffix run ends the digits.
            v = v * base + d
        }
        return v | 0
    }
    // The value of one character-constant body, including the C escape sequences:
    // backslash x with hex digits, backslash with up to three octal digits, and the
    // simple escapes n t r v f a b 0, backslash, quote and double quote.
    // A C floating constant: hexadecimal (mantissa times a power of two) or decimal.
    function pow2(n) {
        var r = 1
        var k = n < 0 ? 0 - n : n
        for (var i = 0; i < k; i++) r = r * 2
        return n < 0 ? 1 / r : r
    }
    function parseCFloat(t) {
        if (t.length > 1 && t.charCodeAt(0) == 48 && (t.charCodeAt(1) == 120 || t.charCodeAt(1) == 88)) {
            var i = 2
            var mant = 0
            while (i < t.length && digVal(t.charCodeAt(i)) >= 0) { mant = mant * 16 + digVal(t.charCodeAt(i)); i = i + 1 }
            if (i < t.length && t.charCodeAt(i) == 46) {
                i = i + 1
                var scale = 1
                while (i < t.length && digVal(t.charCodeAt(i)) >= 0) {
                    scale = scale / 16
                    mant = mant + digVal(t.charCodeAt(i)) * scale
                    i = i + 1
                }
            }
            var ex = 0
            var neg = false
            if (i < t.length && (t.charCodeAt(i) == 112 || t.charCodeAt(i) == 80)) {
                i = i + 1
                if (t.charCodeAt(i) == 43) { i = i + 1 }
                else if (t.charCodeAt(i) == 45) { neg = true; i = i + 1 }
                while (i < t.length && t.charCodeAt(i) >= 48 && t.charCodeAt(i) <= 57) {
                    ex = ex * 10 + (t.charCodeAt(i) - 48)
                    i = i + 1
                }
            }
            if (neg) { ex = 0 - ex }
            return mant * pow2(ex)
        }
        return parseFloat(t)
    }
    // The bytes of a string-literal RUN (adjacent literals concatenate, C11 6.4.5p5),
    // with the C escape sequences decoded and the terminating null appended. An
    // L / u / U prefix makes the elements wide.
    function cStrBytes(text) {
        var bytes = []
        var wide = false
        var i = 0
        while (i < text.length) {
            var cc = text.charCodeAt(i)
            if (cc == 117 && i + 1 < text.length && text.charCodeAt(i + 1) == 56) { i = i + 2; continue }
            if (cc == 76 || cc == 117 || cc == 85) { wide = true; i = i + 1; continue }
            if (cc != 34) { i = i + 1; continue }
            i = i + 1
            while (i < text.length && text.charCodeAt(i) != 34) {
                if (text.charCodeAt(i) != 92) { bytes.push(text.charCodeAt(i)); i = i + 1; continue }
                var j = i + 1
                var e = text.charCodeAt(j)
                if (e == 120 || e == 88) {
                    j = j + 1
                    while (j < text.length && digVal(text.charCodeAt(j)) >= 0) j = j + 1
                } else if (e >= 48 && e <= 55) {
                    j = j + 1
                    var n = 1
                    while (j < text.length && n < 3 && text.charCodeAt(j) >= 48 && text.charCodeAt(j) <= 55) { j = j + 1; n = n + 1 }
                } else {
                    j = j + 1
                }
                bytes.push(cCharCode(text.slice(i, j)))
                i = j
            }
            i = i + 1
        }
        bytes.push(0)
        return {str: bytes, wide: wide}
    }
    function cCharCode(s) {
        if (s.charCodeAt(0) != 92) return s.charCodeAt(0)
        var e = s.charCodeAt(1)
        if (e == 120 || e == 88) {
            var hv = 0
            for (var i = 2; i < s.length; i++) hv = hv * 16 + digVal(s.charCodeAt(i))
            return hv & 255
        }
        if (e >= 48 && e <= 55) {
            var ov = 0
            for (var j = 1; j < s.length; j++) ov = ov * 8 + digVal(s.charCodeAt(j))
            return ov & 255
        }
        if (e == 110) return 10
        if (e == 116) return 9
        if (e == 114) return 13
        if (e == 118) return 11
        if (e == 102) return 12
        if (e == 97) return 7
        if (e == 98) return 8
        if (e == 101) return 27
        return e   // backslash, single quote, double quote, question mark: itself.
    }

    // ----- The machine: one flat, word addressed memory -----
    // Address 0 stays unused so that 0 can act as a null pointer.
    var mem = [0]
    function alloc(words) {
        var base = mem.length
        for (var i = 0; i < words; i++) mem.push(0)
