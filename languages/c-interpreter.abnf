    // into a constant thunk (pointer 8, scalar/enum 4) or a notImpl for a struct value.
    // sizeof yields size_t, which is unsigned long here. A struct tag's size is read
    // lazily, so a sizeof may name a tag defined further down the file.
    var ctSizeT = {k: "int", w: 8, u: true}
    function makeSizeof(ct) { return function() { return val(ctBytes(ct), ctSizeT) } }
    // sizeof over a PLACE needs its address, not its value - an array or a struct
    // answers its whole size, which is what 'sizeof a' on a char array reports.
    function makeSizeofPlace(placeT) {
        return function() {
            var p = placeT()
            return val(ctBytes(p.ct != undefined ? p.ct : ctInt), ctSizeT)
        }
    }
    // sizeof over any other expression: the size of the type that expression has.
    function makeSizeofExpr(t) {
        return function() { return val(ctBytes(t().t), ctSizeT) }
