    // sizeof yields size_t, which is unsigned long here. A struct tag's size is read
    // lazily, so a sizeof may name a tag defined further down the file.
    var ctSizeT = {k: "int", w: 8, u: true}
    function makeSizeof(ct) { return function() { return val(ctBytes(ct), ctSizeT) } }
