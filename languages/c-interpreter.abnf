    // has. The type is what makes 0u - 1u wrap to 4294967295 where 0 - 1 is -1, what
    // makes p + 1 step a whole element, and what _Generic and sizeof select on.
    function val(v, t) { return {v: v, t: t} }
    // Truncation towards zero, which is what C's integer conversions and its
    // float-to-integer conversion both do.
    function trunc0(x) { return Math.trunc(x) }
    // Give a value the representation its C type pins: an integer wraps to its
    // declared width and signedness (C11 6.3.1.3), a float keeps its value.
    function convert(ct, x) {
        if (ct.k == "flt") return szIs(x) ? szNum(x) : x
        if (ct.k == "int") {
            // A 64-bit type goes through the sized-integer box (szConv wraps to the
            // width and answers a plain number whenever a signed 64-bit value fits a
            // double exactly), so long / long long / unsigned long keep every bit.
            if (ct.w >= 8) return szConv(szIs(x) ? x : trunc0(x), 64, ct.u == true)
            // A narrower type truncates in the box domain first when the source is a
            // box: masking a rounded double would take the wrong low bits.
            var n = szIs(x) ? szNum(szConv(x, ct.w * 8, ct.u == true)) : trunc0(x)
            if (szIs(x)) return n
            if (ct.w == 1) return ct.u ? (n & 255) : ((n << 24) >> 24)
            if (ct.w == 2) return ct.u ? (n & 65535) : ((n << 16) >> 16)
            return ct.u ? (n >>> 0) : (n | 0)
