    var unnamedSeq = 0
    // Param items = [{sname}?, "*"?, name]: int, int*, or a struct pointer.
    function makeParam(items) {
        var i = 0
        var sname
        var base = ctInt
        if (items[i] != undefined && items[i].sname != undefined) { sname = items[i].sname; i++ }
        else if (items[i] != undefined && items[i].bty != undefined) { base = items[i].bty; i++ }
        var ptr = starsOf(items[i])
        if (ptr > 0) i++
        var ct = ptrTo(ptr, sname != undefined ? ctStruct(sname) : base)
