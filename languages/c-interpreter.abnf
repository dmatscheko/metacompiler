    function makeBoolDecl(items) {
        var name = items[0]
        var opt = items[1]
        return function() {
            var a = alloc(1)
            if (opt != undefined) mem[a] = nzv(opt().v) ? 1 : 0
            declVar(name, a, false, ctI(1, true))
