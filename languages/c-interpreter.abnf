    makeSeq = function (items) {
        var stmts = []
        var labels = {}
        for (var i = 0; i < items.length; i++) {
            var it = items[i]
            if (it != undefined && typeof it != "function" && it.lbl != undefined) {
                labels[it.lbl] = stmts.length
                stmts.push(it.t)
            } else {
                stmts.push(it)
            }
