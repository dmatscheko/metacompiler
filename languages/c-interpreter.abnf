    // list does not reach keeps the zero the fresh memory already holds. Nesting is
    // simply recursion, which is what makes 'int m[2][3] = { { 1, 2, 3 }, ... }' and
    // a struct holding an array work.
    function runInit(ct, init, base) {
        if (typeof init == "function") {
            if (ct.k == "arr" || ct.k == "struct") fail("an aggregate needs a brace initializer")
            mem[base] = convert(ct, init().v)
