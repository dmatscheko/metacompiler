        var ct = ctArr(d.str.length, d.wide ? ctInt : ctChar)
        var bytes = d.str
        var addr = -1
        return function() {
            if (addr < 0) { addr = strLitAddr(bytes, ct.e) }
            return {a: addr, ct: ct}
        }
    }
