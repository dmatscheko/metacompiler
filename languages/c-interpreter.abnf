        return function() {
            var k = 0
            while (k < stmts.length) {
                var r = stmts[k]()
                if (r != undefined) {
                    if (r.isGoto == true && hasOwn(labels, r.label)) { k = labels[r.label]; continue }
                    return r
                }
                k = k + 1
            }
            return undefined
        }
    }

    // ----- Expression thunks: function() -> 32 bit int. Lvalue thunks -> address. -----

    function makeNum(n, ct) { var v = convert(ct, n); return function() { return val(v, ct) } }
    function makeInt(n) { return makeNum(n, ctInt) }
    // An integer constant carries the type its suffix names: u/U unsigned, l/L long.
    function makeNumLit(n, text) { return makeNum(n, intCtOf(text, n)) }
    // The type of an integer constant (C11 6.4.4.1p5): the suffix names the smallest
    // rank and the signedness, and the type is then the FIRST one in the list for that
    // rank/base that can hold the value. A decimal constant only ever picks a signed
    // type; a hexadecimal, octal or binary one may pick the unsigned one of the same
    // rank - which is what makes sizeof(0xFFFFFFFF) 4 and sizeof(5000000000) 8.
    function intCtOf(text, n) {
        var nl = 0
        var u = false
        var isDec = true
        if (text.length > 1 && text.charCodeAt(0) == 48) { isDec = false }
        for (var i = 0; i < text.length; i++) {
            var cc = text.charCodeAt(i)
            if (cc == 108 || cc == 76) nl = nl + 1
            else if (cc == 117 || cc == 85) u = true
            else if (!((cc >= 48 && cc <= 57) || (cc >= 97 && cc <= 102) || (cc >= 65 && cc <= 70) || cc == 120 || cc == 88)) break
        }
        if (nl > 0) return ctI(8, u)
        // Does the value still read back the same at 32 bits? szEq compares by value,
        // so a constant that survives the round trip keeps the narrow type.
        if (u) { if (szEq(szConv(n, 32, true), n)) return ctI(4, true); return ctI(8, true) }
        if (szEq(szConv(n, 32, false), n)) return ctI(4, false)
        if (!isDec && szEq(szConv(n, 32, true), n)) return ctI(4, true)
        // parseCInt accumulates at 64 bits, so a value that has wrapped NEGATIVE is
        // one that did not fit a signed 64-bit type: the unsigned one holds it.
        if (szCmp(n, 0) < 0) return ctI(8, true)
