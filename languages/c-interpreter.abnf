    makeOrAnd = function(items, op) {
        if (items.length == 1) return items[0]
        return function() {
            var v = items[0]() != 0
            for (var i = 1; i < items.length; i++) {
                if (op == "||") { if (v) return 1; v = items[i]() != 0 }
                else            { if (!v) return 0; v = items[i]() != 0 }
            }
            return v ? 1 : 0
        }
    }
    function makeCond(items) {
        if (items.length == 1) return items[0]
        return function() { return items[0]() != 0 ? items[1]() : items[2]() }
    }
    applyOp = function(op, a, b) {
        if (op == "+=") return (a + b) | 0
        if (op == "-=") return (a - b) | 0
        if (op == "*=") return Math.imul(a, b)
        if (op == "/=") return (a / b) | 0
        if (op == "%=") return (a % b) | 0
        if (op == "&=") return a & b
        if (op == "^=") return a ^ b
        if (op == "|=") return a | b
        if (op == "<<=") return a << b
        if (op == ">>=") return a >> b
    }
    // items = [placeThunk, opString, valueThunk]. Value of the assignment: the stored value.
    function makeAssign(items) {
        var placeT = items[0]
        var op = items[1]
        var valT = items[2]
        return function() {
            var addr = placeT()
            var v = valT()
            if (op != "=") v = applyOp(op, load(addr), v)
            return store(addr, v)
        }
    }
    function makePreIncDec(placeT, op) {
        var d = (op == "++") ? 1 : -1
        return function() {
            var addr = placeT()
            return store(addr, load(addr) + d)
        }
    }
    function makePostIncDec(op, placeT) {
        var d = (op == "++") ? 1 : -1
        return function() {
            var addr = placeT()
            var old = load(addr)
            store(addr, old + d)
            return old
        }
    }
    // items = [name, argThunk...].
    function makeCall(items) {
        var name = items[0]
        var args = items.slice(1)
        return function() {
            var argValues = []
            for (var i = 0; i < args.length; i++) argValues.push(args[i]())
            return callFunction(name, argValues)
        }
    }

    // ----- Statement thunks -----

    // One brace-initializer item: an optional '[i] =' / '.field =' designator plus
    // its value.
    function makeDItem(items) {
        if (items.length > 1) {
            if (items[0].fld != undefined) return {fld: items[0].fld, v: items[1]}
            return {at: items[0].at, v: items[1]}
        }
        return {v: items[0]}
    }
    // A brace list -> a dense array of value thunks, honouring '[i] =' designators.
    // A hole (a skipped index, or a shorter list than the array) stays undefined and
    // is left at the zero the fresh memory already holds.
    function spreadInit(list, pos) {
        var out = []
        var at = 0
        for (var i = 0; i < list.length; i++) {
            var it = list[i]
            if (it.at != undefined) at = it.at | 0
            while (out.length < at) out.push(undefined)
            var v = it.v
            if (typeof v != "function") { notImpl("nested aggregate initializer", pos); v = undefined }
            if (out.length == at) out.push(v)
            else out[at] = v
            at = at + 1
        }
        return out
    }
    // items = [{ptr}?, name, {size}?, init?] -> declaration thunk. init is either an
    // expression thunk or {list} for a brace initializer; {size} marks an array, with
    // -1 asking for the size to be taken from the initializer.
    function makeDecl(items) {
        var i = 0
        var nstar = starsOf(items[i]) // A pointer is a one word cell holding an address.
        if (nstar > 0) i++
        var name = items[i]
        i++
        var dim = -2                  // -2: not an array at all.
        if (items[i] != undefined && items[i].size != undefined) { dim = items[i].size | 0; i++ }
        var opt = items[i]
        var ct = ptrTo(nstar, ctInt)
        if (dim > -2) {
            var list = (opt != undefined && opt.list != undefined) ? opt.list : undefined
            if (list == undefined && opt != undefined) fail("an array needs a brace initializer: " + name)
            return function() {
                var vals = (list != undefined) ? spreadInit(list, 0) : []
                var n = dim >= 0 ? dim : vals.length
                if (n < vals.length) n = vals.length
                var base = alloc(n)   // Fresh memory is zeroed, so holes stay 0.
                for (var k = 0; k < vals.length; k++) {
                    if (vals[k] != undefined) mem[base + k] = vals[k]() | 0
                }
                declVar(name, base, true, ct)
            }
        }
        return function() {
            var a = alloc(1)
            if (opt != undefined) mem[a] = opt() | 0
            declVar(name, a, false, ct)
        }
    }
    // A static local: makeDecl's thunk runs ONCE (allocating and initializing the cell);
    // every later execution only re-binds that same cell into the fresh scope.
    function makeStaticDecl(items) {
        var inner = makeDecl(items)
        var i = 0
        if (starsOf(items[i]) > 0) i++
        var name = items[i]
        var cell = undefined
        return function() {
            if (cell == undefined) {
                inner()
                cell = lookupVar(name)
            } else {
                declVar(name, cell.addr, cell.arr, cell.ct)
            }
        }
    }
    // SDeclarator/SGDecl items = ["*"?] name [{size}|initThunk] -> a plain descriptor.
    function makeSDecl(items) {
        var i = 0
        var star = starsOf(items[i])
        if (star > 0) i++
        var name = items[i]
        var opt = items[i + 1]
        if (opt != undefined && opt.size != undefined) return {name: name, star: star, size: opt.size}
        return {name: name, star: star, init: opt}
    }
    // One declared struct entity: struct S v / struct S *p (= expr) / struct S a[N].
    function declStructVar(sname, d) {
        if (d.star > 0) {
            var a = alloc(1)
            if (d.init != undefined) mem[a] = d.init() | 0
            declVar(d.name, a, false, ptrTo(d.star, ctStruct(sname)))
        } else if (d.size != undefined) {
            declVar(d.name, alloc(d.size * structOf(sname).size), true, ctStruct(sname))
        } else {
            var base = alloc(structOf(sname).size)   // Fresh memory is zeroed.
            if (d.init != undefined) {
                if (d.init.list == undefined) fail("a struct or union needs a brace initializer: " + d.name)
                var plan = structInitPlan(sname, d.init.list, 0)
                for (var i = 0; i < plan.length; i++) mem[base + plan[i].f.off] = plan[i].t() | 0
            }
            declVar(d.name, base, false, ctStruct(sname))
        }
    }
    // StructDecl items = [structName, descriptor...] -> declaration thunk.
    function makeStructDecl(items) {
        var sname = items[0]
        var decls = items.slice(1)
        return function() {
            for (var i = 0; i < decls.length; i++) declStructVar(sname, decls[i])
        }
    }
    // StructGDecl: like makeStructDecl, but registered at build time (initializers
    // would run before main, so they are not allowed on globals).
    function defineStructGlobals(items) {
        var sname = items[0]
        for (var i = 1; i < items.length; i++) {
            if (items[i].init != undefined) fail("global struct pointers take no initializer: " + items[i].name)
            declStructVar(sname, items[i])
        }
    }
    function makeDo(condT, bodyT) {
        return function() {
            do {
                var r = bodyT()
                if (r != undefined) {
                    if (r === BRK) break
                    if (r !== CONT) return r
                }
            } while (condT() != 0)
        }
    }
    function makeFor(items) {
        var bodyT = items.pop()
        var init = null, cond = null, post = null
        for (var i = 0; i < items.length; i++) {
            if (items[i].k == "init") init = items[i].t
            if (items[i].k == "cond") cond = items[i].t
            if (items[i].k == "post") post = items[i].t
        }
        return function() {
            scopes.push({})
            var res = undefined
            if (init != null) init()
            while (cond == null || cond() != 0) {
                var r = bodyT()
                if (r != undefined) {
                    if (r === BRK) break
                    if (r !== CONT) { res = r; break }
                }
                if (post != null) post()
            }
            scopes.pop()
            return res
        }
    }
    // items = [valueThunk, stmtThunk...] resp. [stmtThunk...] -> one case descriptor.
    function makeCase(items) { return {isDefault: false, v: items[0], body: items.slice(1)} }
    function makeDefault(items) { return {isDefault: true, body: items} }
    // items = [scrutineeThunk, caseDescriptor...]: C switch with fallthrough.
    function makeSwitch(items) {
        var scrut = items[0]
        var cases = items.slice(1)
        return function() {
            var v = scrut()
            var start = -1
            var dflt = -1
            for (var i = 0; i < cases.length; i++) {
                if (cases[i].isDefault) { dflt = i; continue }
                if (start < 0 && cases[i].v() == v) { start = i }
            }
            if (start < 0) { start = dflt }
            if (start < 0) { return undefined }
            for (var i = start; i < cases.length; i++) {
                var body = cases[i].body
                for (var j = 0; j < body.length; j++) {
                    var r = body[j]()
                    if (r === BRK) { return undefined }        // break leaves the switch
                    if (r != undefined) { return r }           // return/continue propagate
                }
            }
            return undefined
        }
    }
    function makeReturn(items) {
        var t = items.length > 0 ? items[0] : makeInt(0)
        return function() { return {isRet: true, v: t()} }
    }
    // ----- Top level -----

    // Param items = [{sname}?, "*"?, name]: int, int*, or a struct pointer.
    function makeParam(items) {
        var i = 0
        var sname
        if (items[i] != undefined && items[i].sname != undefined) { sname = items[i].sname; i++ }
        var ptr = starsOf(items[i])
        if (ptr > 0) i++
        if (sname != undefined && ptr == 0) fail("struct parameters must be pointers (struct " + sname + " *)")
        var ct = ptrTo(ptr, sname != undefined ? ctStruct(sname) : ctInt)
        return {name: items[i], ptr: ptr > 0, ct: ct}
    }
    // Global declarator: ["*"?] name [{size}|{init: n}] -> registered immediately.
    function makeGDecl(items) {
        var i = 0
        var nstar = starsOf(items[i])
        if (nstar > 0) i++
        var name = items[i]
        var opt = items[i + 1]
        var ct = ptrTo(nstar, ctInt)
        if (opt != undefined && opt.size != undefined) {
            declVar(name, alloc(opt.size), true, ct)
        } else {
            var a = alloc(1)
            if (opt != undefined) mem[a] = opt.init | 0
            declVar(name, a, false, ct)
        }
    }
    function defineGlobals(items) {} // makeGDecl already registered them.

    function defineFunction() {
        var bodyT = pop()
        var params = pop()
        var name = pop()
        funcs[name] = {params: params, body: bodyT}
    }

    // ----- Core library config (see lib/interp-core.js) -----
    core.lang = "c"
    core.test = function(v) { return v != 0 } // C conditions: any nonzero int.
    // System headers the runtime already provides; #include of anything else is an
    // external library we cannot resolve (see resolveImport in lib/interp-core.js).
    core.stdlibImports = ["stdio.h", "stdlib.h", "string.h", "math.h", "ctype.h", "stdbool.h", "stdint.h", "stddef.h", "limits.h", "assert.h", "stdarg.h"]

    // Project-file includes: #include "geomlib.h" loads geomlib.h (searched under the
    // program's directory and the -i roots) and compiles it, so its functions register
    // like the main file's (header-only in this subset). System <...> headers in
    // core.stdlibImports stay no-ops. A file is included once; repeats and cycles no-op.
    var importedFiles = {}
    core.importFile = function(path, pos) {
        var rel = path
        if (rel.slice(0, 2) == "./") { rel = rel.slice(2) }
        var file = c.findImport(rel)
        if (file == "") { return false }
        if (importedFiles["$" + file] == true) { return true }
        importedFiles["$" + file] = true
        var text = c.readFile(file)
        var asg = c.parse(c.agrammar, text, null, file)
        c.pushSource(file, text)
        c.compile(asg)
        c.popSource()
        return true
    }

    c.compile(c.asg)

    // The entry point defaults to main(), but the -main flag (c.mainName) can override it:
    // a bare identifier names a defined function to call, anything with a '(' is a C
    // snippet (e.g. greet(3, 4);) parsed and run in a fresh frame with the file's functions.
    var entry = c.mainName
    if (entry == undefined || entry == "") { entry = "main" }
    if (mainIsSnippet(entry)) {
        var callerScopes = scopes
        scopes = [globalScope, {}]
        var r = runMainSnippet(entry, "Statement")
        scopes = callerScopes
        var sret = (r != undefined && r.isRet) ? r.v : 0
        println("c interpreter: -main snippet returned " + sret)
        exit(sret)
    }
    if (funcs[entry] == undefined) {
        println("Error: C programs need a " + entry + "() function.")
        exit(1)
    }
    var ret = callFunction(entry, [])
    println("c interpreter: " + entry + "() returned " + ret)
    exit(ret)

~~) ;
