    // zero IS a box, so a bare '!= 0' would call it true).
    function nzv(v) { return szIs(v) ? !szEq(v, 0) : (v != 0) }
    // The integer promotions: anything narrower than int is evaluated as an int.
    function promote(ct) { return (ct.k == "int" && ct.w < 4) ? ctInt : ct }
    // The usual arithmetic conversions (C11 6.3.1.8): the common type of a binary
    // operator's two operands.
    function arithCt(a, b) {
        if (isFlt(a) || isFlt(b)) return ctF((isFlt(a) ? a.w : 0) > (isFlt(b) ? b.w : 0)
