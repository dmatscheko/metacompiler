                var base = (f.bty == "int") ? ctInt : ctStruct(f.bty)
                if (f.star > 0) { ct = ptrTo(f.star, base) }         // May point at any (even later) struct.
                else { if (f.bty != "int") structOf(f.bty); ct = base }
                if (hasOwn(st.fields, f.name)) fail("duplicate field " + f.name + " in " + tagName(name))
                var w = ctSize(ct)
                var by = ctBytes(ct)
