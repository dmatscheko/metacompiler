    // that type's width and signedness, a float truncates towards zero on the way to
    // an integer, and a pointer cast only re-labels the address.
    function makeCast(items) {
        var ct = items[0]
        var t = items[1]
        return function() {
            var r = t()
            if (ct.k == "void") return val(0, ctVoid)
            return val(convert(ct, r.v), ct)
        }
    }
