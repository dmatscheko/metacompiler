    // with the C escape sequences decoded and the terminating null appended. An
    // L / u / U prefix makes the elements wide.
    function cStrBytes(text) {
        var bytes = []
        var wide = false
        var i = 0
        while (i < text.length) {
            var cc = text.charCodeAt(i)
            if (cc == 117 && i + 1 < text.length && text.charCodeAt(i + 1) == 56) { i = i + 2; continue }
            if (cc == 76 || cc == 117 || cc == 85) { wide = true; i = i + 1; continue }
            if (cc != 34) { i = i + 1; continue }
            i = i + 1
            while (i < text.length && text.charCodeAt(i) != 34) {
                if (text.charCodeAt(i) != 92) { bytes.push(text.charCodeAt(i)); i = i + 1; continue }
                var j = i + 1
                var e = text.charCodeAt(j)
                if (e == 120 || e == 88) {
                    j = j + 1
                    while (j < text.length && digVal(text.charCodeAt(j)) >= 0) j = j + 1
                } else if (e >= 48 && e <= 55) {
                    j = j + 1
                    var n = 1
                    while (j < text.length && n < 3 && text.charCodeAt(j) >= 48 && text.charCodeAt(j) <= 55) { j = j + 1; n = n + 1 }
                } else {
                    j = j + 1
                }
                bytes.push(cCharCode(text.slice(i, j)))
                i = j
            }
            i = i + 1
        }
        bytes.push(0)
        return {str: bytes, wide: wide}
    }
    function cCharCode(s) {
        if (s.charCodeAt(0) != 92) return s.charCodeAt(0)
        var e = s.charCodeAt(1)
        if (e == 120 || e == 88) {
            var hv = 0
            for (var i = 2; i < s.length; i++) hv = hv * 16 + digVal(s.charCodeAt(i))
            return hv & 255
        }
        if (e >= 48 && e <= 55) {
            var ov = 0
            for (var j = 1; j < s.length; j++) ov = ov * 8 + digVal(s.charCodeAt(j))
            return ov & 255
        }
        if (e == 110) return 10
        if (e == 116) return 9
        if (e == 114) return 13
        if (e == 118) return 11
        if (e == 102) return 12
        if (e == 97) return 7
        if (e == 98) return 8
        if (e == 101) return 27
        return e   // backslash, single quote, double quote, question mark: itself.
    }

    // ----- The machine: one flat, word addressed memory -----
    // Address 0 stays unused so that 0 can act as a null pointer.
    var mem = [0]
    function alloc(words) {
        var base = mem.length
        for (var i = 0; i < words; i++) mem.push(0)
        return base
    }
    function load(addr) {
        if (addr <= 0 || addr >= mem.length) fail("invalid load at address " + addr)
        return mem[addr]
    }
    // Storing converts to the destination's C type first, so a cell only ever holds
    // a value its own type can represent.
    function store(ct, addr, v) {
        if (addr <= 0 || addr >= mem.length) fail("invalid store at address " + addr)
        mem[addr] = convert(ct, v)
        return mem[addr]
    }

    // ----- Scopes map names to {addr, arr, ct} (arr marks array names: they yield
    // their address; for arrays ct is the ELEMENT type) -----
    declVar = function(name, addr, arr, ct) {
        scopes[scopes.length - 1][name] = {addr: addr, arr: arr, ct: ct}
    }
    function lookupVar(name) {
        for (var i = scopes.length - 1; i >= 0; i--) {
            // Own-property test: a bare [name] read resolved inherited Object.prototype
            // members (toString, valueOf, ...) under a host JS engine.
            if (hasOwn(scopes[i], name)) return scopes[i][name]
        }
        return undefined
    }
    function findVar(name) {
        var v = lookupVar(name)
        if (v == undefined) fail("variable not defined: " + name)
        return v
    }

    // enum constants: name -> integer value, filled by defineEnum, read in makeVarRef.
    var enumConsts = {}
    // A '*' run in a declarator: {ptr: levels}. Every level is one word holding an
    // address, so int** is an ordinary cell whose value is the address of an int cell.
    function makeStars(s, pos) {
        var n = 0
        for (var i = 0; i < s.length; i++) { if (s.charCodeAt(i) == 42) n++ }
        return {ptr: n}
    }
    // The declarator's leading '*' run, if any: 0 when the item is already the name.
    function starsOf(item) {
        return (item != undefined && item.ptr != undefined) ? item.ptr : 0
    }
    // enum: sequential values from 0, or continuing after an explicit '= n'.
    // The counter lives here rather than in defineEnum because a constant has to be
    // READABLE by the enumerators after it ('A = 4, B = A + 1'), which means it must be
    // in the table when the NEXT enumerator's initializer folds, not one rule later.
    var enumNext = 0
    function enumStart() { enumNext = 0 }
    function enumConstOf(name) {
        if (!hasOwn(enumConsts, name)) fail("enum initializer names an unknown constant: " + name)
        return enumConsts[name] | 0
    }
    function makeEnumerator(items) {
        var v = enumNext
        if (items.length > 1) { v = items[1].val | 0 }
        enumConsts[items[0]] = v
        enumNext = v + 1
        return items.length > 1 ? {name: items[0], explicit: v} : {name: items[0]}
    }
    function defineEnum(items) {
        var next = 0
        for (var i = 0; i < items.length; i++) {
            if (items[i].tag != undefined) continue // The enum tag is not tracked.
            if (items[i].explicit != undefined) next = items[i].explicit | 0
            enumConsts[items[i].name] = next
            next = next + 1
        }
    }
    // The comma operator: evaluate each side left to right, yield the last value.
    function makeComma(items) {
        if (items.length == 1) return items[0]
        return function() {
            var v = val(0, ctInt)
            for (var i = 0; i < items.length; i++) v = items[i]()
            return v
        }
    }
    // A scalar type name, keyword by keyword -> the C type it names. LP64: long AND
    // long long are 8 bytes, matching the 8-byte pointers this model already pins and
    // cc on a 64-bit host (ul=8 l=8 ll=8 ptr=8 int=4). A long double is modelled as
    // a double, and a plain char is signed like it is on this reference platform.
    function makeScalarName(items) {
        var nlong = 0
        var uns = false
        var isVoid = false
        var isFloat = false
        var isDouble = false
        var isChar = false
        var isShort = false
        var isBool = false
        for (var i = 0; i < items.length; i++) {
            var t = items[i]
            if (t == "long") nlong = nlong + 1
            else if (t == "unsigned") uns = true
            else if (t == "void") isVoid = true
            else if (t == "float") isFloat = true
            else if (t == "double") isDouble = true
            else if (t == "char") isChar = true
            else if (t == "short") isShort = true
            else if (t == "_Bool") isBool = true
        }
        if (isVoid) return ctVoid
        if (isDouble) return ctF(8)
        if (isFloat) return ctF(4)
        if (isBool) return ctI(1, true)
        if (isChar) return ctI(1, uns)
        if (isShort) return ctI(2, uns)
        if (nlong > 0) return ctI(8, uns)
        return ctI(4, uns)
    }
