        var x = promote(a)
        var y = promote(b)
        if (x.k != "int") return x
        if (y.k != "int") return y
        if (x.w == y.w) return ctI(x.w, x.u || y.u)
        return (x.w > y.w) ? x : y
    }
    // Structural type identity, which is what _Generic and a cast comparison need.
    function ctEq(a, b) {
        if (a.k != b.k) return false
        if (a.k == "int") return a.w == b.w && (a.u == true) == (b.u == true)
        if (a.k == "flt") return a.w == b.w
        if (a.k == "ptr") return ctEq(a.p, b.p)
        if (a.k == "arr") return a.n == b.n && ctEq(a.e, b.e)
        if (a.k == "struct") return a.s == b.s
        return true
    }
    // An ARRAY C type: n elements of e. Arrays nest, so 'int m[2][3]' is
    // arr(2, arr(3, int)) and every index step peels one level off.
    function ctArr(n, e) { return {k: "arr", n: n, e: e} }
    // The declared dimensions of a declarator, outermost first, wrapped around the
    // base type. A -1 dimension ('int a[] = { ... }') takes its size from the
    // initializer list.
    function arrCt(dims, base, count) {
        var ct = base
        for (var k = dims.length - 1; k >= 0; k--) {
            var n = dims[k] | 0
            if (n < 0) { n = count | 0 }
            ct = ctArr(n, ct)
        }
        return ct
    }
    // How many elements a brace list covers, honouring '[i] =' designators.
    function initLen(list) {
        var n = 0
        var at = 0
        for (var i = 0; i < list.length; i++) {
            if (list[i].at != undefined) { at = list[i].at | 0 }
            at = at + 1
            if (at > n) { n = at }
        }
        return n
    }
    // A union tag lives in the same table as the struct tags, under a 'u:' prefixed
    // key - C keeps 'struct X' and 'union X' in one tag namespace but as distinct types,
    // and no C identifier can contain a ':', so the two can never collide.
    function uKey(name) { return "u:" + name }
    function tagName(key) {
        return (key.length > 2 && key.charCodeAt(0) == 117 && key.charCodeAt(1) == 58)
            ? "union " + key.slice(2) : "struct " + key
    }
    // The BYTE size behind sizeof: an int is 4, any pointer 8, an aggregate its own
    // packed size (the flat memory itself is word addressed - see ctSize).
    function ctBytes(ct) {
        if (ct.k == "ptr" || ct.k == "fnp") return 8
        if (ct.k == "struct") return structOf(ct.s).bytes
        if (ct.k == "arr") return ct.n * ctBytes(ct.e)
        if (ct.k == "void") return 1    // GCC's sizeof(void), which cc also answers
        return ct.w
    }
    // n levels of pointer around a base ct (0 levels yields the base itself).
    function ptrTo(n, base) {
        var ct = base
        for (var i = 0; i < n; i++) ct = {k: "ptr", p: ct}
        return ct
    }
    function structOf(sname) {
        var st = hasOwn(structs, sname) ? structs[sname] : undefined
        if (st == undefined) fail(tagName(sname) + " not defined")
        return st
    }
    function fieldOf(sname, fname) {
        var fs = structOf(sname).fields
        var f = hasOwn(fs, fname) ? fs[fname] : undefined
        if (f == undefined) fail(tagName(sname) + " has no field " + fname)
        return f
    }
    // A type-specifier run that contains 'unsigned': its bit fields WRAP where a signed
    // one sign-extends. (Plain 'int x : n' is signed here, like the reference compiler.)
    function isUnsignedTy(raw) { return raw != undefined && raw.indexOf("unsigned") >= 0 }
    // PlainField items = [{bty, raw}, {ptr}?, name, {bits}?, ...] -> {fields: [{name,
    // bty, star, bits?, uns}...]} where star is the pointer level (0 for a plain field)
    // and bits the declared bit-field width. An unnamed ':n' member is pure padding: it
    // is laid out (so the members around it keep their order) but never named.
    function makeFieldLine(items) {
        var bty = items[0].bty
        var uns = isUnsignedTy(items[0].raw)
        var fields = []
        var star = 0
        for (var i = 1; i < items.length; i++) {
            var it = items[i]
            if (it != undefined && it.padBits != undefined) {
                fields.push({name: "", bty: bty, star: 0, bits: it.padBits | 0, uns: uns, pad: true})
                continue
            }
            if (it != undefined && it.ptr != undefined) { star = it.ptr; continue }
            if (it != undefined && it.bits != undefined) {
                fields[fields.length - 1].bits = it.bits | 0
                continue
            }
            if (it != undefined && it.dims != undefined) {
                fields[fields.length - 1].dims = it.dims
                continue
            }
            // A function-pointer member brings its own base type with it.
            if (it != undefined && it.fnp != undefined) {
                fields.push({name: it.fnp.name, bty: ctFn, star: 0, dims: it.fnp.dims, uns: false})
                star = 0
                continue
            }
            fields.push({name: it, bty: bty, star: star, uns: uns})
            star = 0
        }
        return {fields: fields}
    }
    // 'struct { ... } name;' as a member: the tag is defined here and the declarators
    // that follow become members of that type, like any other member line.
    function makeTagField(items) {
        var isUnion = items[0].u
        var key = anonTagName()
        var groups = []
        var decls = []
        for (var i = 1; i < items.length; i++) {
            var it = items[i]
            if (it != undefined && it.tag != undefined) { key = isUnion ? uKey(it.tag) : it.tag; continue }
            if (it != undefined && (it.fields != undefined || it.anonFields != undefined)) { groups.push(it); continue }
            decls.push(it)
        }
        var all = [key]
        for (var j = 0; j < groups.length; j++) all.push(groups[j])
        defineTag(all, isUnion)
        var line = [{bty: ctStruct(key)}]
        for (var q = 0; q < decls.length; q++) line.push(decls[q])
        return makeFieldLine(line)
    }
    // An anonymous struct/union member: its own member groups, spliced into the
    // enclosing tag at the offset the member itself occupies.
    function makeAnonMember(items) { return {anonFields: items.slice(1), isUnion: items[0].u} }
    // StructDef items = [name, {fields}...]. Nested struct/union values need a complete
    // (already defined) tag; pointer fields may point at the struct itself.
    // A UNION lays every member at offset 0 and takes the MAXIMUM size instead of the
    // sum - that one difference is the whole of the union layout. `order` keeps the
    // declaration order, which is what a positional brace initializer walks.
    function defineTag(items, isUnion) {
