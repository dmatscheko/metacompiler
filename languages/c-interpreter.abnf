// 'int (* (*p)(int, int))(int, int)' - a pointer to a function RETURNING a function
// pointer, the declarator FnPtrFuncDef defines ('int (*f1(int, int))(int, int)') read
// as a variable. It has to come before FnPtrDecl: both open '( *', and only the second
// '(' tells them apart. A function pointer is one cell holding a callee identifier
// whatever its signature, so the two levels need no separate type - the calls
// '(*(*p)(0, 2))(2, 2)' resolve one at a time.
FnPtrRetDecl <~~ push({dcl: makeDeclr(takeAll(), "fnptr")}) ~~>
            = [ PStars ] "(" Stars "(" Stars Id <~~ push(up.in) ~~> [ ArrDims ] ")" FnParams ")" FnParams [ "=" DInit ] ;
PtrArrDecl  <~~ push({dcl: makeDeclr(takeAll(), "ptrarr")}) ~~>
            = "(" Stars Id <~~ push(up.in) ~~> ")" ArrDims [ "=" DInit ] ;
InitDecl    <~~ push({dcl: makeDeclr(takeAll(), "plain")}) ~~>
            = [ Stars ] Id <~~ push(up.in) ~~>
              [ ArrDims ] [ "=" DInit ] ;
// A declarator's array dimensions, outermost first: 'int m[2][3]' is an array of 2
// arrays of 3 ints, and every dimension is one level of the {k:"arr"} C type. Only
// the OUTERMOST may be left empty ('int a[] = { ... }', 'int m[][3][5] = ...'), where
// -1 asks for the size to come from the initializer. A dimension may carry the
// qualifiers a parameter is allowed to write there (int x[const 5]).
ArrDims     <~~ push({dims: takeAll()}) ~~> = ( ArrDim | StarDim | InferDim ) { ArrDim | StarDim } ;
// 'int x[const *]' - a VLA of UNSPECIFIED size, which C11 6.7.6.2 allows only in a
// prototype, where nothing may read the bound anyway. Treated exactly like '[]'.
StarDim     <~~ push(-1) ~~> = "[" { ArrQual } "*" "]" ;
ArrDim      = "[" { ArrQual } ConstDim "]" ;
// An array dimension is a constant EXPRESSION, not just a literal: 'char buf[5*32]' is
// ordinary C, and so is 'int a[N]' once the preprocessor has turned N into '0x1E+1'. The
// arithmetic is folded here, at parse time, because a dimension must already be a number
// when the declarator is built - the interpreter has no frame yet and the compiler emits
// no code for it.
//
// NoDimId is what keeps this honest: it refuses any identifier inside the brackets, so a
// real variable-length array ('char test[argc]') is still REJECTED outright rather than
// accepted and then failing at walk time. Accepting a VLA here would score a corpus win
// while being strictly worse than the rejection it replaced.
ConstDim    = NoDimId DimShift ;
DimShift    <~~ push(foldDimBin(takeAll())) ~~> = DimAdd { DimShOp DimAdd } ;
DimShOp     <~~ push({op: up.in}) ~~> = "<<" | ">>" ;
DimAdd      <~~ push(foldDimBin(takeAll())) ~~> = DimMul { DimAddOp DimMul } ;
DimAddOp    <~~ push({op: up.in}) ~~> = "+" | "-" ;
DimMul      <~~ push(foldDimBin(takeAll())) ~~> = DimUn { DimMulOp DimUn } ;
DimMulOp    <~~ push({op: up.in}) ~~> = "*" | "/" | "%" ;
DimUn       = Number | DimParen | DimNeg | DimPos | DimNot ;
DimParen    = "(" DimShift ")" ;
DimNeg      <~~ push(0 - pop()) ~~> = "-" DimUn ;
DimPos      = "+" DimUn ;
DimNot      <~~ push(0 - pop() - 1) ~~> = "~" DimUn ;
// Refuse a dimension that names anything. Scans the raw input to the closing ']':
// a numeric literal swallows its own letters (0x1E, 5L, 1e3), so any letter or '_' left
// over starts an identifier - a VLA, or a constant this pass cannot know.
NoDimId = :script(~~
    (function() {
        var s = 0 // Neither whitespace NOR COMMENTS are skipped before a :script.
        while (true) {
            var ch = c.peek(s)
            if (ch === 32 || ch === 9 || ch === 10 || ch === 13 || ch === 12) { s++; continue }
            break
        }
        while (true) {
            var b = c.peek(s)
            if (b < 0)   { return abnf.newToken("\x01dim-unterminated", 0) }
            if (b === 93) { return undefined }                              // ']'
            if (b === 91) { return abnf.newToken("\x01dim-bracket", 0) }    // '['
            if (b >= 48 && b <= 57) {                                       // a number
                s++
                while (true) {
                    var d = c.peek(s)
                    if ((d >= 48 && d <= 57) || (d >= 65 && d <= 90) ||
                        (d >= 97 && d <= 122) || d === 46) { s++ } else { break }
                }
                continue
            }
            if ((b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b === 95) {
                return abnf.newToken("\x01dim-not-constant", 0)
            }
            s++
        }
    })()
~~) ;
InferDim    <~~ push(-1) ~~> = "[" "]" ;
ArrQual     = PtrQual | "static" KwEnd ;
// A declaration initializer: a brace list, a string literal (which initializes a
// char array element by element, C11 6.7.9p14), or one ordinary expression.
DInit       = BraceInit | StrInit | AssignExpr ;
StrInit     <~~ push(makeStrInit(up.in)) ~~> = StrTok { StrTok } ;
// A brace initializer collects its items; a trailing comma is allowed.
BraceInit   <~~ push({list: takeAll()}) ~~>
            = "{" [ DItem { "," DItem } [ "," ] ] "}" ;
DItem       <~~ push(makeDItem(takeAll())) ~~> = [ ArrDesig | FldDesig ] DInit ;
// The array designator '[2] = value' and the struct/union form '.field = value'.
ArrDesig    <~~ push({at: pop()}) ~~> = "[" Number "]" "=" ;
FldDesig    = "." Id <~~ push({fld: up.in}) ~~> "=" ;

Empty       <~~ push(function() {}) ~~>
            = ";" ;

ExprStmt    <~~ push(exprToStmt(pop())) ~~>
            = Expression ";" ;

// Every expression production pushes exactly one thunk: function() -> 32 bit value.
// The comma operator evaluates each side in order and yields the last (real C).
Expression  <~~ push(makeComma(takeAll())) ~~>
            = AssignExpr { "," AssignExpr } ;

// Assignment is an expression: the target is an lvalue (a variable, *expr or a[i]).
AssignExpr  = Assignment | CondExpr ;
Assignment  <~~ push(makeAssign(takeAll())) ~~>
            = Lvalue ( "<<=" | ">>=" | "+=" | "-=" | "*=" | "/=" | "%=" | "&=" | "^=" | "|=" | "=" ) <~~ push(up.in) ~~> AssignExpr ;

// An lvalue thunk evaluates to an address. A place is a variable followed by any
// mix of indexing and struct member steps: a[i], p.x, r.min.y, head->next->value.
// A parenthesized lvalue may itself carry a suffix chain, so '(*pa)[1]' and '(*p).f'
// are places like 'pa[1]' and 'p->f'.
// DerefP ('*' of a PLACE) comes before the general Deref ('*' of any expression):
// only the place form knows the C type of what it dereferences, which is what makes
// '(*pa)[1]' step by whole rows of 'int (*pa)[3]'.
Lvalue      = StrPlaceP | CompLitP | DerefP | Deref | ParenSfx | ParenPlace | VarPlace ;
// A STRING LITERAL is an array object of static storage duration, so it is a place:
// "abc"[1] indexes it, sizeof "abc" is its byte size, and reading it decays to a
// pointer to its first character. Adjacent literals concatenate (C11 6.4.5p5); an
// L / u / U / u8 prefix makes the elements wide.
StrPlaceP   <~~ push(makeSfxChain(takeAll())) ~~>
            = StrPlace { PlaceSfx } ;
StrPlace    <~~ push(makeStrPlace(up.in)) ~~>
            = StrTok { StrTok } ;
StrTok      = [ StrPfx ] SkipStr ;
StrPfx      = "u8" | "L" | "u" | "U" ;
// A COMPOUND LITERAL '(Type){ ... }' (C11 6.5.2.5) is an unnamed object with
// automatic storage - an lvalue - so it takes a suffix chain like any other place,
// and '&' may be applied to it.
CompLitP    <~~ push(makeSfxChain(takeAll())) ~~>
            = CompLit { PlaceSfx } ;
CompLit     <~~ push(makeCompLit(takeAll())) ~~>
            = "(" CompType ")" BraceInit ;
CompType    <~~ push({clt: makeCompDesc(takeAll())}) ~~>
            = CompBase [ Stars ] [ ArrDims ] ;
CompBase    = TypeInt <~~ push({bs: baseCtOf(up.in)}) ~~>
            | EnumRef <~~ push({bs: ctInt}) ~~>
            | KwStruct Id <~~ push({bs: ctStruct(up.in)}) ~~>
            | KwUnion Id <~~ push({bs: ctStruct(uKey(up.in))}) ~~>
            | TdCompTy ;
// '(Name){ ... }' with a typedef type name. The '{' that has to follow makes this
// unambiguous, unlike a cast, where '(x) - 1' could be either reading.
TdCompTy    <~~ push({bs: typedefOf(up.in)}) ~~> = NotCKw Id ;
ParenSfx    <~~ push(makeSfxChain(takeAll())) ~~>
            = "(" Lvalue ")" PlaceSfx { PlaceSfx } ;
ParenPlace  = "(" Lvalue ")" ;
DerefP      <~~ push(makeDerefP(pop())) ~~>
            = "*" Lvalue NotIncDec ;
// A place followed by '++' or '--' is '*(p++)', not '(*p)++', so the typed place
// form has to decline it and leave the general '*' of an expression its turn.
NotIncDec = :script(~~
    (function() {
        var s = 0 // Neither whitespace NOR COMMENTS are skipped before a :script.
        while (true) {
            var ch = c.peek(s)
            if (ch === 32 || ch === 9 || ch === 10 || ch === 13 || ch === 12) { s++; continue }
            if (ch === 47 && c.peek(s + 1) === 47) {
                s += 2
                while (c.peek(s) >= 0 && c.peek(s) !== 10) { s++ }
                continue
            }
            if (ch === 47 && c.peek(s + 1) === 42) {
                s += 2
                while (c.peek(s) >= 0 && !(c.peek(s) === 42 && c.peek(s + 1) === 47)) { s++ }
                s += 2
                continue
            }
            break
        }
        var cc = c.peek(s)
        return ((cc === 43 && c.peek(s + 1) === 43) || (cc === 45 && c.peek(s + 1) === 45))
            ? abnf.newToken("\x01postfix-follows", 0) : undefined
    })()
~~) ;
Deref       <~~ push(makeDerefPlace(pop())) ~~>
            = "*" UnaryExpr ;
VarPlace    <~~ push(makeVarPlace(takeAll())) ~~>
            = Id <~~ push(up.in) ~~> { PlaceSfx } ;
PlaceSfx    = Index | Arrow | Member ;
Index       <~~ push({idx: pop()}) ~~>
            = "[" Expression "]" ;
Arrow       = "->" Id <~~ push({arw: up.in}) ~~> ;
Member      = "." Id <~~ push({fld: up.in}) ~~> ;

CondExpr    <~~ push(makeCond(takeAll())) ~~>
            = OrExpr [ "?" AssignExpr ":" AssignExpr ] ;

OrExpr      <~~ push(makeOrAnd(takeAll(), "||")) ~~>
            = AndExpr { "||" AndExpr } ;

AndExpr     <~~ push(makeOrAnd(takeAll(), "&&")) ~~>
            = BitOrExpr { "&&" BitOrExpr } ;

BitOrExpr   <~~ push(foldBinary(takeAll())) ~~>
            = BitXorExpr { "|" <~~ push("|") ~~> BitXorExpr } ;
BitXorExpr  <~~ push(foldBinary(takeAll())) ~~>
            = BitAndExpr { "^" <~~ push("^") ~~> BitAndExpr } ;
// The & operator must not match the start of &&: && with an addressable right side
// (0 && bump()) would otherwise parse as 0 & (&bump) and poison the parse.
BitAndExpr  <~~ push(foldBinary(takeAll())) ~~>
            = EqExpr { "&" <~~ push("&") ~~> NotAmp EqExpr } ;
NotAmp = :script(~~
    (function() {
        return (c.peek(0) === 38) ? abnf.newToken("\x01single-amp-only", 0) : undefined
    })()
~~) ;

EqExpr      <~~ push(foldBinary(takeAll())) ~~>
            = RelExpr { ( "==" | "!=" ) <~~ push(up.in) ~~> RelExpr } ;

RelExpr     <~~ push(foldBinary(takeAll())) ~~>
            = ShiftExpr { ( "<=" | ">=" | "<" | ">" ) <~~ push(up.in) ~~> ShiftExpr } ;

ShiftExpr   <~~ push(foldBinary(takeAll())) ~~>
            = AddExpr { ( "<<" | ">>" ) <~~ push(up.in) ~~> AddExpr } ;

AddExpr     <~~ push(foldBinary(takeAll())) ~~>
            = MulExpr { ( "+" | "-" ) <~~ push(up.in) ~~> MulExpr } ;

MulExpr     <~~ push(foldBinary(takeAll())) ~~>
            = UnaryExpr { ( "*" | "/" | "%" ) <~~ push(up.in) ~~> UnaryExpr } ;

// Prefix operators. ++/-- work on lvalues; & takes the address of an lvalue;
// * dereferences (as an expression it loads the pointed to value).
// AlignOf comes before PostfixExpr: '_Alignof(int)' looks exactly like a call of a
// function named _Alignof, and the general call seed would claim it first.
UnaryExpr   = PreIncDec | AddrOf | DerefLoad | Neg | Pos | Not | BitNot | Sizeof | AlignOf | GenericCall | Generic | Cast | PostfixExpr ;

// A cast '(Type)expr' converts the value to the named type: an integer wraps to that
// type's width and signedness, a float truncates towards zero on the way to an
// integer, and a pointer cast only re-labels the address. TypeName requires a real
// type keyword, so '(expr)' still parses as a parenthesized expression.
Cast        <~~ push(makeCast(takeAll())) ~~>
            = "(" TypeName ")" UnaryExpr ;

// sizeof: the byte size the type model pins - char 1, short 2, int 4, any long and
// any double 8, any pointer 8, a struct the packed sum, a union the maximum over its
// members, an array its element count times the element size. Over an EXPRESSION the
// answer is the size of that expression's type, which is what makes 'sizeof a' on a
// char array answer its length. SizeofPlace comes before SizeofExpr so that the
// common 'sizeof name' shape needs no evaluation of anything but an address.
Sizeof      = KwSizeof ( SizeofType | SizeofPlace | SizeofExpr ) ;
SizeofType  <~~ push(makeSizeof(pop())) ~~>
            = "(" TypeName ")" ;
SizeofPlace <~~ push(makeSizeofPlace(pop())) ~~>
            = Lvalue ;
SizeofExpr  <~~ push(makeSizeofExpr(pop())) ~~>
            = UnaryExpr ;
// _Alignof(type): for the scalar types this machine models, the alignment equals the
// size, and a pointer aligns to 8 like it is sized.
AlignOf     <~~ push(makeSizeof(pop())) ~~>
            = KwAlignof "(" TypeName ")" ;
// A TYPE NAME: a scalar/struct/union/enum base plus a run of pointer stars.
// An ABSTRACT function-pointer declarator may follow, so a cast can name a function
// pointer type: '(void (*)(void))0' and '(int (*)(int, int))f'. All this model needs
// from it is that the result IS a function pointer, so the parameter list is skipped
// whole and every one of them is the same ctFn. GCC attributes are allowed where a
// declarator may carry them ('int (__attribute__((noinline)) *)(void)').
TypeName    <~~ push(makeTypeName(takeAll())) ~~>
            = SizeBase { "*" <~~ push("*") ~~> [ PtrQual ] } [ AbsFnPtr | ArrDims ] ;
AbsFnPtr    <~~ push({fnabs: true}) ~~> = "(" { Attr } Stars { Attr } ")" FnParams ;
SizeBase    = ScalarName
            | EnumRef <~~ push(ctInt) ~~>
            | KwStruct Id <~~ push(ctStruct(up.in)) ~~>
            | KwUnion Id <~~ push(ctStruct(uKey(up.in))) ~~> ;
// A scalar type name, kept keyword by keyword so the width and the signedness both
// survive.
ScalarName  <~~ push(makeScalarName(takeAll())) ~~>
            = ScalarTok { ScalarTok } ;

// _Generic(controlling, type: value, ..., default: value) - C11 6.5.1.1. The
// association whose type name is the controlling expression's own type is the one
// the whole construct yields; the others are never evaluated.
Generic     <~~ push(makeGeneric(takeAll())) ~~>
            = KwGeneric "(" AssignExpr "," GenAssoc { "," GenAssoc } ")" ;
// '_Generic(a, int: a_f, const int: b_f)()' - the selection yields a function pointer
// and the call follows. It needs its OWN production because UnaryExpr reaches Generic
// before PostfixExpr, so the bare form would win and leave the '(' behind; requiring at
// least one suffix here keeps the bare form falling through to Generic unchanged.
GenericCall <~~ push(makeCallExpr(takeAll())) ~~>
            = Generic ( ArgList | PlaceSfx ) { ArgList | PlaceSfx } ;
// A TYPEDEF NAME may name the association's type ('_Generic(foo, fptr: 3, int: 4)').
// This is the one place a bare identifier can be read as a type without the ambiguity
// that makes it impossible in a CAST: the ':' has to follow, and no expression may
// stand there, so nothing else could have been meant. KwDefault comes first - 'default'
// is a keyword, not a typedef name.
GenAssoc    <~~ push(makeGenAssoc(takeAll())) ~~>
            = ( TypeName | KwDefault <~~ push("default") ~~> | TdGenTy ) ":" AssignExpr ;
TdGenTy     <~~ push(typedefOf(up.in)) ~~> = NotCKw Id ;
KwGeneric   = "_Generic" KwEnd ;
ScalarTok   <~~ push(up.in) ~~> = ScalarKw ;
ScalarKw    = "char" KwEnd | "short" KwEnd | "int" KwEnd | "long" KwEnd
            | "unsigned" KwEnd | "signed" KwEnd | "void" KwEnd
            | "float" KwEnd | "double" KwEnd | "_Bool" KwEnd
            | "const" KwEnd | "volatile" KwEnd ;
PreIncDec   <~~ push(makePreIncDec(pop(), pop())) ~~>
            = ( "++" | "--" ) <~~ push(up.in) ~~> Lvalue ;
AddrOf      <~~ push(makeAddrOf(pop())) ~~>
            = "&" Lvalue ;
DerefLoad   <~~ push(makeLoad(makeDerefPlace(pop()))) ~~>
            = "*" UnaryExpr ;
Neg         <~~ push(makeNeg(pop())) ~~>
            = "-" UnaryExpr ;
// Unary '+' is the identity on its promoted operand (C11 6.5.3.3p2), so this production
// carries no tag at all: the operand's own thunk is already the answer.
Pos         = "+" UnaryExpr ;
Not         <~~ push(makeNot(pop())) ~~>
            = "!" UnaryExpr ;
BitNot      <~~ push(makeBitNot(pop())) ~~>
            = "~" UnaryExpr ;

PostfixExpr = PostIncDec | CallExpr | Primary ;
PostIncDec  <~~ push(makePostIncDec(pop(), pop())) ~~>
            = Lvalue ( "++" | "--" ) <~~ push(up.in) ~~> ;

// A call whose callee is an EXPRESSION: a bare name (the ordinary direct call, and
// also a variable holding a function pointer), a parenthesized place ('(*fp)(4)'),
// or a place path ('tab[0](3)'). Several argument lists chain, so 'pick(1)(5)' calls
// what pick returned.
//
// A call result is a VALUE, not a place, but C still lets a suffix step off it:
// 'mk().a' selects a field of a returned struct, 'getp()[1]' indexes a returned
// pointer, and 'go()()->zerofunc()' does both and then calls what it found. So the
// chain after the first argument list mixes the two - each PlaceSfx steps the value
// (makeValStep) and each ArgList calls it. Only the FIRST step of such a chain is
// value-based; everything after it is an ordinary address walk again.
CallExpr    <~~ push(makeCallExpr(takeAll())) ~~>
            = CallSeed ArgList { ArgList | PlaceSfx } ;
// ParenCastRef is what lets a CAST be the callee: '((void (*)(void))0)()' calls the
// address the cast names. It is deliberately a Cast and not a general parenthesized
// expression - Cast fails on its first token unless a type keyword is there, so an
// ordinary '(a + b)' pays nothing for it, whereas re-parsing every parenthesized
// expression would double the work on the deeply nested casts the corpus is full of.
// ParenDerefCall is '(*(*p)(0, 2))(2, 2)': the callee is what a call returned, with a
// '*' in front of it. Dereferencing a FUNCTION POINTER yields the function designator,
// which decays straight back to the same pointer (C11 6.5.3.2p4), so the '*' is the
// identity here - unlike '(*fp)(4)', where fp is a VARIABLE and the cell must be read,
// which is why this alternative sits before the place form but insists on a CALL inside.
CallSeed    = ParenSfxRef | ParenDerefCall | ParenPlaceRef | PlaceRef | NameSeed | ParenCastRef ;
ParenDerefCall = "(" "*" CallExpr ")" ;
ParenCastRef = "(" Cast ")" ;
ParenPlaceRef <~~ push(makeLoad(pop())) ~~> = "(" Lvalue ")" ;
NameSeed    <~~ push({fname: up.in}) ~~> = Id ;
ArgList     <~~ push({args: takeAll()}) ~~>
            = "(" [ AssignExpr { "," AssignExpr } ] ")" ;

// A plain variable reference loads the value; an array name yields its address.
// A place path as an expression (a[i], p.x, head->next) loads the resolved cell.
// A string literal (with adjacent-literal concatenation) has no char* backing on the
// flat integer memory, so it is accepted and reported as not implemented.
// ParenSfxRef comes first: '(*pa)[1]' starts like a parenthesized expression, and the
// general form would consume '(*pa)' and leave the '[1]' behind.
// FloatLit comes before NumberLit: the integer form matches the '1' of '1e3' and a
// PEG never goes back for the longer read.
// StmtExpr comes first: '({ ... })' starts like a parenthesized expression, and the
// general form would consume the '(' and then choke on the '{'.
Primary     = StmtExpr | CompLitRef | ParenSfxRef | "(" Expression ")" | StrRef | FloatLit | NumberLit | CharLit | PlaceRef | VarRef ;
// A GCC STATEMENT EXPRESSION '({ stmt; stmt; expr; })': an ordinary block, in its own
// scope, whose value is the value of its LAST expression statement (and 0 when it has
// none). Rather than single that statement out in the syntax - which needs a lookahead
// for 'is the next token after this ";" the closing "}"' - every expression statement
// records its value, so the last one to record simply wins. That is the same order in
// both halves: the interpreter records while it RUNS the block, the compiler while it
// EMITS it, and in either case the block's own statements are the last to act.
StmtExpr    <~~ push(makeStmtExpr(takeAll())) ~~>
            = "(" "{" { Statement } "}" ")" ;
ParenSfxRef <~~ push(makeLoad(pop())) ~~> = ParenSfx ;
CompLitRef  <~~ push(makeLoad(pop())) ~~> = CompLitP ;
StrRef      <~~ push(makeLoad(pop())) ~~> = StrPlaceP ;
// A floating constant: decimal or hexadecimal, with an optional exponent and an
// optional f/F (float) or l/L (long double) suffix. The hexadecimal form REQUIRES
// its binary exponent, so 0x1F stays an integer.
FloatLit    <~~ push(makeFltLit(up.in)) ~~> = FloatNum ;
FloatNum    = ( "0x" | "0X" ) :whitespace() HexDig { HexDig } [ "." { HexDig } ] BinExp [ FltSfx ] :whitespace(Whitespace)
            | ( "0x" | "0X" ) :whitespace() "." HexDig { HexDig } BinExp [ FltSfx ] :whitespace(Whitespace)
            | "0"..."9" :whitespace() { "0"..."9" } ( "." { "0"..."9" } [ DecExp ] | DecExp ) [ FltSfx ] :whitespace(Whitespace)
            | "." :whitespace() "0"..."9" { "0"..."9" } [ DecExp ] [ FltSfx ] :whitespace(Whitespace) ;
DecExp      = ( "e" | "E" ) [ "+" | "-" ] "0"..."9" { "0"..."9" } ;
BinExp      = ( "p" | "P" ) [ "+" | "-" ] "0"..."9" { "0"..."9" } ;
FltSfx      = "f" | "F" | "l" | "L" ;
PlaceRef    <~~ push(makeLoad(makeVarPlace(takeAll()))) ~~>
            = Id <~~ push(up.in) ~~> PlaceSfx { PlaceSfx } ;
NumberLit   <~~ push(makeNumLit(pop(), up.in)) ~~>
            = Number ;
// A character constant has type int (C11 6.4.4.4p10); a wide one (L, u, U) has the
// width of its wide type, which this model pins at 4 like int.
CharLit     = [ CharPfx ] "'" :whitespace() CChar <~~ push(makeNum(cCharCode(up.in), ctInt)) ~~> "'" :whitespace(Whitespace) ;
CharPfx     = "L" | "u8" | "u" | "U" ;
// One character constant body: a hex escape (backslash x plus hex digits), an octal
// escape (backslash plus one to three octal digits), a simple escape, or a plain
// character. The hex and octal forms come first so their digits are not cut short.
CChar       = "\\" "x" HexDig { HexDig } | "\\" OctDig [ OctDig [ OctDig ] ]
            | "\\" "\x20"..b"\x7e" | "\x20"..."\x26" | "\x28"..."\x5b" | "\x5d"..."\x7e" ;
VarRef      <~~ push(makeVarRef(up.in)) ~~>
            = Id ;

// A hexadecimal (0x...) or decimal integer literal with optional C integer suffixes
// (u/U/l/L in any combination). parseInt reads the 0x prefix and stops at the suffix
// letters, so hex and suffixed literals both yield the right 32-bit value.
Number      <~~ push(parseCInt(up.in)) ~~>
            = ( "0x" | "0X" ) :whitespace() HexDig { HexDig } { IntSfx } :whitespace(Whitespace)
            | ( "0b" | "0B" ) :whitespace() BinDig { BinDig } { IntSfx } :whitespace(Whitespace)
            | "0" :whitespace() OctDig { OctDig } { IntSfx } :whitespace(Whitespace)
            | ( "0" | "1"..."9" ) :whitespace() { "0"..."9" } { IntSfx } :whitespace(Whitespace) ;
HexDig      = "0"..."9" | "a"..."f" | "A"..."F" ;
OctDig      = "0"..."7" ;
BinDig      = "0" | "1" ;
IntSfx      = "u" | "U" | "l" | "L" ;

// The scalar integer type: any run of int-family keywords and qualifiers, all of
// which collapse to the one 32-bit int model (unsigned/signed/short/long widths and
// const/volatile qualifiers are parsed and ignored; char is a full int-sized word;
// void is accepted here so that void and void* parse). Storage-class and function
// specifiers (static/extern/register/auto/inline/_Noreturn/_Thread_local) and the
// _Atomic/restrict qualifiers are likewise parsed and ignored; _Bool and _Complex
// collapse to int; __attribute__((...)) specifiers are skipped. Pushes nothing.
TypeInt     = TypeElem { TypeElem } ;
TypeElem    = TypeTok | Attr | AlignAs ;
// _Alignas(8) / _Alignas(int): parsed and ignored (the layout is fixed).
AlignAs     = "_Alignas" KwEnd SkipParen ;
TypeTok     = "int" KwEnd | "char" KwEnd | "short" KwEnd | "long" KwEnd
            | "float" KwEnd | "double" KwEnd
            | "unsigned" KwEnd | "signed" KwEnd | "void" KwEnd
            | "const" KwEnd | "volatile" KwEnd
            | "static" KwEnd | "extern" KwEnd | "register" KwEnd | "auto" KwEnd
            | "inline" KwEnd | "restrict" KwEnd | "_Bool" KwEnd | "_Complex" KwEnd
            | "_Noreturn" KwEnd | "_Atomic" KwEnd | "_Thread_local" KwEnd ;
EnumRef     = KwEnum Id ;


// 'struct S { int x; } s, *p;' / 'union { int i; } u;' - a tag DEFINITION that also
// declares objects. The tag may be omitted, in which case the layout gets a synthetic
// name that no other declaration can spell. The shared *Body productions carry the
// syntax; the four wrappers differ only in whether the objects become locals or
// globals, and whether the tag is a struct or a union.
StructDefBody = KwStruct [ Id <~~ push({tag: up.in}) ~~> ] "{" { FieldLine } "}"
                DeclItem { "," DeclItem } ";" ;
UnionDefBody  = KwUnion [ Id <~~ push({tag: up.in}) ~~> ] "{" { FieldLine } "}"
                DeclItem { "," DeclItem } ";" ;
GStructDefDecl <~~ defineGlobals(tagDefDecl(takeAll(), false)) ~~> = StructDefBody ;
GUnionDefDecl  <~~ defineGlobals(tagDefDecl(takeAll(), true)) ~~>  = UnionDefBody ;

KwStruct    = "struct" KwEnd ;
KwStatic    = "static" KwEnd ;
KwEnum      = "enum" KwEnd ;
KwUnion     = "union" KwEnd ;
KwTypedef   = "typedef" KwEnd ;
KwGoto      = "goto" KwEnd ;
// _Static_assert(constant-expression, "message"); - accepted and skipped at both the
// top level and inside a function body. The condition is not evaluated: it is a
// compile-time diagnostic, and this front end reports no diagnostics of its own.
StaticAssert = KwStaticAs SkipParen ";" ;
AssertStmt  <~~ push(function() {}) ~~> = StaticAssert ;

// _Bool declarations get their own form so an initializer is normalized to 0 or 1,
// which is what makes '_Bool two = 2;' hold 1 (TypeInt alone collapses _Bool to int).
BoolDecl    <~~ push(makeSeq(takeAll())) ~~>
            = KwBool BInitDecl { "," BInitDecl } ";" ;
BInitDecl   <~~ push(makeBoolDecl(takeAll())) ~~>
            = Id <~~ push(up.in) ~~> [ "=" AssignExpr ] ;

KwSizeof    = "sizeof" KwEnd ;
KwAlignof   = "_Alignof" KwEnd ;
KwStaticAs  = "_Static_assert" KwEnd ;
KwBool      = "_Bool" KwEnd ;
KwIf        = "if" KwEnd ;
KwElse      = "else" KwEnd ;
KwWhile     = "while" KwEnd ;
KwDo        = "do" KwEnd ;
KwFor       = "for" KwEnd ;
KwReturn    = "return" KwEnd ;
KwBreak     = "break" KwEnd ;
KwContinue  = "continue" KwEnd ;
KwSwitch    = "switch" KwEnd ;
KwCase      = "case" KwEnd ;
KwDefault   = "default" KwEnd ;

// ---


:startScript(~~

    // Shared interpreter machinery (scopes, BRK/CONT protocol, expression and
    // statement builders); language-specific behavior is configured on `core` below.
    include("lib/interp-core.js")

    // The digit value of one character in base 16 (also covers bases 2, 8 and 10).
    function digVal(cc) {
        if (cc >= 48 && cc <= 57) return cc - 48
        if (cc >= 97 && cc <= 102) return cc - 87
        if (cc >= 65 && cc <= 70) return cc - 55
        return -1
    }
    // A C integer constant: 0x/0X hex, 0b/0B binary, a leading 0 octal, or decimal,
    // with any run of u/U/l/L suffix letters. Read EXACTLY at 64 bits: the digits are
    // accumulated through szArith, so 18446744073709551615 keeps every bit instead of
    // rounding to the nearest double. The result is a plain number while it fits a
    // signed 64-bit double and the sized-integer box beyond that.
    // items = [v0, {op}, v1, {op}, v2, ...] - ONE precedence level of a constant array
    // dimension, folded left to right at parse time. See the ArrDim rule for why a
    // dimension is a number here rather than an expression tree.
    function foldDimBin(items) {
        var v = anytype
        v = items[0]
        var i = 1
        while (i + 1 < items.length) {
            var op = items[i].op
            var r = items[i + 1]
            if (op == "+") { v = v + r }
            else if (op == "-") { v = v - r }
            else if (op == "*") { v = v * r }
            else if (op == "/") { v = r == 0 ? 0 : truncDiv(v, r) }
            else if (op == "%") { v = r == 0 ? 0 : v - truncDiv(v, r) * r }
            else if (op == "<<") { v = v * Math.pow(2, r) }
            else if (op == ">>") { v = truncDiv(v, Math.pow(2, r)) }
            i = i + 2
        }
        return v
    }
    // C integer division truncates toward zero, which Math.floor does not do for a
    // negative quotient.
    function truncDiv(a, b) {
        var q = a / b
        return q < 0 ? Math.ceil(q) : Math.floor(q)
    }
    function parseCInt(s) {
        var base = 10
        var i = 0
        if (s.length > 1 && s.charCodeAt(0) == 48) {
            var c1 = s.charCodeAt(1)
            if (c1 == 120 || c1 == 88) { base = 16; i = 2 }
            else if (c1 == 98 || c1 == 66) { base = 2; i = 2 }
            else { base = 8; i = 1 }
        }
        var v = anytype
        v = 0
        for (; i < s.length; i++) {
            var d = digVal(s.charCodeAt(i))
            if (d < 0 || d >= base) break   // The u/U/l/L suffix run ends the digits.
            v = szArith("+", szArith("*", v, base), d)
        }
        return v
    }
    // The value of one character-constant body, including the C escape sequences:
    // backslash x with hex digits, backslash with up to three octal digits, and the
    // simple escapes n t r v f a b 0, backslash, quote and double quote.
    // A C floating constant: hexadecimal (mantissa times a power of two) or decimal.
    function pow2(n) {
        var r = 1
        var k = n < 0 ? 0 - n : n
        for (var i = 0; i < k; i++) r = r * 2
        return n < 0 ? 1 / r : r
    }
    function parseCFloat(t) {
        if (t.length > 1 && t.charCodeAt(0) == 48 && (t.charCodeAt(1) == 120 || t.charCodeAt(1) == 88)) {
            var i = 2
            var mant = 0
            while (i < t.length && digVal(t.charCodeAt(i)) >= 0) { mant = mant * 16 + digVal(t.charCodeAt(i)); i = i + 1 }
            if (i < t.length && t.charCodeAt(i) == 46) {
                i = i + 1
                var scale = 1
                while (i < t.length && digVal(t.charCodeAt(i)) >= 0) {
                    scale = scale / 16
                    mant = mant + digVal(t.charCodeAt(i)) * scale
                    i = i + 1
                }
            }
            var ex = 0
            var neg = false
            if (i < t.length && (t.charCodeAt(i) == 112 || t.charCodeAt(i) == 80)) {
                i = i + 1
                if (t.charCodeAt(i) == 43) { i = i + 1 }
                else if (t.charCodeAt(i) == 45) { neg = true; i = i + 1 }
                while (i < t.length && t.charCodeAt(i) >= 48 && t.charCodeAt(i) <= 57) {
                    ex = ex * 10 + (t.charCodeAt(i) - 48)
                    i = i + 1
