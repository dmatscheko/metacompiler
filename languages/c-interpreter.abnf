        var name = items[0]
        var path = items.slice(1)
        return function() {
            var v = findVar(name)
            var ct = v.ct != undefined ? v.ct : ctInt
            if (path.length == 0) return {a: v.addr, ct: ct}
            return walkPath({a: v.addr, ct: ct}, path, name)
