        for (var i = 0; i < items.length; i++) {
            if (items[i].tag != undefined) { key = isUnion ? uKey(items[i].tag) : items[i].tag }
            else { tagItems.push(items[i]) }
        }
        var all = [key]
        for (var j = 0; j < tagItems.length; j++) all.push(tagItems[j])
        defineTag(all, isUnion)
