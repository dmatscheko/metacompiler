    // wins, otherwise the 'default' one. The controlling expression is evaluated to
    // learn its type - C says it is not evaluated, which only differs for an operand
    // with side effects.
    function makeGenAssoc(items) { return {gt: items[0], t: items[1]} }
    function makeGeneric(items) {
        var ctrl = items[0]
        var assocs = items.slice(1)
        return function() {
            var t = ctrl().t
            if (t.k == "arr") t = {k: "ptr", p: t.e}
            var dflt = undefined
            for (var i = 0; i < assocs.length; i++) {
                var a = assocs[i]
                if (a.gt == "default") { dflt = a.t; continue }
                if (ctEq(a.gt, t)) return a.t()
