    // value the corresponding next(v) sent in and carries on; the one being produced now
    // throws out to genNext. 'yield* xs' delegates - every element of xs is a yield of
    // its own, and they replay individually.
    // One step of a `yield* it` delegate. Inside an ASYNC generator body it is
    // AWAITED, which is both what the specification's async delegation does and what
    // makes 'yield* someAsyncGen()' terminate at all: an async generator's next()
    // answers a PROMISE, whose `done` is undefined, so an unawaited drive spins.
    function jpStepDelegate(run, dnx, v, args) {
        var r = anytype
        r = callWithThis(dnx, v, args)
        if (run.ag) { return jpDoAwait(r) }
        return r
    }
