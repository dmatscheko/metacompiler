    // The get/set accessor for a key, or undefined. An object literal keeps its accessors
    // in its own hidden table; an INSTANCE has none of its own and inherits them from its
    // class descriptor chain, which is why the walk continues along __super.
    function findAccessor(o, kind, k) {
        var name = kind + ":" + k
        if (hasOwn(o, "__acc") && hasOwn(o["__acc"], name)) { return o["__acc"][name] }
        for (var cl = o.__class; cl != undefined && cl != null; cl = cl.__super) {
            if (hasOwn(cl, "__acc") && hasOwn(cl["__acc"], name)) { return cl["__acc"][name] }
        }
        return undefined
    }
    // Records one accessor in an object's (or class descriptor's) hidden table, creating
    // the table on first use. The two kinds share one table under a prefixed key, so a
    // property may have a getter and a setter without them colliding.
    function addAccessor(o, kind, k, fn) {
        if (!hasOwn(o, "__acc")) { scopePut(o, "__acc", {}) }
        scopePut(o["__acc"], kind + ":" + k, fn)
    }
    // The own enumerable key names of a value, as strings and in insertion order: an
    // array and a string answer with their indices, a tracked object with its __keys.
    function ownKeys(v) {
        if (v == undefined || v == null) { return [] }
        if (typeof v == "string") {
            var r = []
            for (var i = 0; i < v.length; i++) { r.push("" + i) }
            return r
        }
        if (Array.isArray(v)) {
