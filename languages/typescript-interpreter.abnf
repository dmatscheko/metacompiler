            var v = anytype // An argument may be of any type.
            v = args[i]
            if (v === undefined && p.dflt != null) { v = p.dflt() }
            if (p.pat != null) { bindPattern(p.pat, v) } else { scopePut(sc, p.pname, v) }
        }
