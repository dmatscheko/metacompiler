// general StringLit, which builds a makeConst value thunk. The inner tokens are shared
// with the string lib (StrEsc / DqPlain / SqPlain).
ModPath     = ModDq | ModSq ;
ModDq       = '"' :whitespace() { StrEsc | DqPlain } <~~ push(unescapeJs(up.in)) ~~> '"' :whitespace(Whitespace) ;
ModSq       = "'" :whitespace() { StrEsc | SqPlain } <~~ push(unescapeJs(up.in)) ~~> "'" :whitespace(Whitespace) ;

// In TypeScript 'export' in front of a real DECLARATION is a transparent prefix: the
// keyword is dropped and the class / function / variable / enum / namespace / type
// underneath is interpreted genuinely, its thunk landing directly on the enclosing frame
// (ExportStmt adds no frame of its own). That is what makes an 'export const' usable in
// the same file, and what makes an exported namespace member reach its namespace object.
// The value-LESS forms name no declaration and are accepted but not lowered.
ExportStmt  = KwExport ( ExportNs | ExportAll | ExportNamed | ExportAssign | KwDefault ExportDefault | ExportBody ) ;
// 'export as namespace Foo;' - the UMD global export, which says the module is also
// reachable as a global of that name. It declares nothing this model can bind, so it is
// erased. Tried FIRST: 'as' would otherwise be read as the start of ExportBody.
ExportNs    <~~ takeAll(); push(function() { return undefined }) ~~>
            = KwAs KwNamespace Id [ ";" ] ;
// A declaration: the 'export' vanishes and the declaration's own thunk is what the
// statement contributes.
ExportBody  = Statement ;
// 'export default <decl>' still declares; 'export default <expr>' has no name to bind and
// is accepted but not lowered.
ExportDefault = ClassDecl | ClassDeclWidened | AsyncFuncDecl | GenFuncDecl | FuncDecl | FuncOverload | InterfaceDecl | ExportDefaultExpr ;
// 'export default <expression>' and 'export = <expression>' bind nothing (there is no
// default-import binding in this module model), but the expression is EVALUATED, so its
// side effects happen. The specifier forms only name things that are already declared -
// an import runs the referenced file into the shared global scope - so they are no-ops.
ExportDefaultExpr <~~ push(makeExportDefault(pop())) ~~>
            = AssignExpr [ ";" ] ;
ExportAll   <~~ takeAll(); push(function() { return undefined }) ~~>
            = "*" [ KwAs SpecName ] KwFrom ModPath [ ImportAttrs ] [ ";" ] ;
ExportNamed <~~ takeAll(); push(function() { return undefined }) ~~>
            = [ KwType ] "{" [ ExportSpec { "," ExportSpec } [ "," ] ] "}" [ KwFrom ModPath [ ImportAttrs ] ] [ ";" ] ;
ExportAssign <~~ push(makeExportDefault(pop())) ~~>
            = "=" AssignExpr [ ";" ] ;
// The LOCAL name of an export specifier is a reference to a binding, so it is guarded
// like every other reference position: 'export { if }' and 'export { default }' name no
// binding and are syntax errors. The exported name after 'as' is a pure label and stays
// unguarded, which is what makes 'export { a as default }' legal.
// Unlike a reference, the LOCAL name of an export specifier is not guarded: 'export
// { default } from "m"' re-exports the default binding and is perfectly legal.
ExportSpec  = SpecName [ SpecTail ] ;

// 'with' introduces an object as a scope, which the scope model has no room for:
// accepted, not lowered.
With        <~~ takeAll(); push(notImplStmt("with statement", up.pos)) ~~>
            = KwWith "(" Expression ")" NestedStatement ;
Debugger    <~~ push(function() {}) ~~>
            = KwDebugger [ ";" ] ;
// The async and generator function DECLARATIONS. Both bind a function value under their
// name; the markers decide whether calling it runs the body (async, answering a Promise)
// or returns a generator object (generator and async generator).
AsyncFuncDecl <~~ push(makeAsyncFuncDecl(takeAll(), up.start)) ~~>
            = KwAsync KwFunction [ GenMark ] NotBindName Id <~~ push(idName(up.in)) ~~> [ TypeParams ] ParamList [ TypeAnnot ] [ UseStrictMark ] FuncBody ;
GenFuncDecl <~~ push(makeGenOrFuncDecl(takeAll(), up.start)) ~~>
            = KwFunction GenMark NotBindName Id <~~ push(idName(up.in)) ~~> [ TypeParams ] ParamList [ TypeAnnot ] [ UseStrictMark ] FuncBody ;

// ----- TypeScript type expressions: parsed exactly, and fully erased. -----
// NOT ONE of these productions pushes onto the stack, so every value production that
// embeds a type sees exactly the stack it would without it. That is the whole reason the
// type layer costs the interpreter nothing: it is a pure recognizer.
//
// The grammar is scannerless, but the global whitespace rule skips spaces after every
// terminal, so '<' '>' ':' '|' '&' behave as expected - and because '>' is matched one
// character at a time, the nested closer of 'Array<Array<number>>' needs no special case.
// A type is bounded by the syntax around it ('=', ';', ')', ']', ',', '=>', a body '{'),
// so no terminator token of its own is needed.

// A return position may hold a TYPE PREDICATE instead of a type: 'p is Fish', 'asserts x',
// 'asserts this is T'. It is tried first, because it is a type followed by 'is'.
TypeAnnot   = ":" ( PredicateType | Type ) ;
PredicateType = [ KwAsserts ] PredicateName KwIs Type | KwAsserts PredicateName ;
PredicateName = KwThis | Id ;
TypeList    = Type { "," Type } ;

// The top of the type grammar. The function and constructor forms have to be tried before
// the union, because both begin where a parenthesized type does.
Type        = CtorType | FnType | ConditionalType ;
// The fast-fail guard in front of the FUNCTION type is what keeps the type grammar
// linear. A function type and a PARENTHESIZED type begin with the same '(', and both
// descend into a whole nested type before the '=>' can settle which of them it was - so
// on '((((((string))))))' that is two independent recursive descents per nesting level,
// i.e. exponential (the conformance suite's 40-deep parenthesizedTypes.ts did not finish
// at all). FnTypeAhead skips the parenthesized group by counting brackets and only lets
// FnType start when a '=>' genuinely follows it, so an attempt that was going to fail is
// never made.
// The return position of a function type may hold a type PREDICATE too:
// '(v: T) => v is U'.
FnType      = FnTypeAhead [ TypeParams ] "(" [ FnTypeParams ] ")" "=>" RetType ;
CtorType    = [ KwAbstract ] KwNew [ TypeParams ] "(" [ FnTypeParams ] ")" "=>" RetType ;
RetType     = PredicateType | Type ;
FnTypeParams = FnTypeParam { "," FnTypeParam } [ "," ] ;
// A parameter of a function type is either NAMED ('cb: (a: number) => void') or bare
// ('(number, string) => void' is not legal TypeScript, but a rest '...args: T[]' and a
// pattern parameter are). The named form is tried first and is recognized by its ':'.
// A leading 'this' may stand without an annotation in a JavaScript-typed signature.
FnTypeParam = [ "..." ] ( FnTypeNamedParam | KwThis | Type ) ;
FnTypeNamedParam = ( KwThis | Id | DPattern ) [ "?" ] TypeAnnot ;

// 'A extends B ? X : Y'. The '?' cannot be confused with anything else at type level.
// The constraint may itself be a function or constructor type ('T extends () => 0 ? ...'),
// which is why it is not merely a UnionType.
ConditionalType = UnionType [ KwExtends ExtendsType "?" Type ":" Type ] ;
ExtendsType = CtorType | FnType | UnionType ;
UnionType   = [ "|" ] IsectType { "|" IsectType } ;
IsectType   = [ "&" ] PrefixType { "&" PrefixType } ;
// The type-level prefix operators. 'infer E' introduces a type variable inside the
// 'extends' clause of a conditional type; the others are ordinary type operators.
PrefixType  = KwKeyof PrefixType | KwReadonly PrefixType | KwUnique PrefixType | InferType | PostfixType ;
// 'infer U' may carry its own constraint ('T extends [infer U extends string] ? ...').
InferType   = KwInfer Id [ KwExtends PrefixType ] ;
// The postfix suffixes: the array marker 'T[]' and the INDEXED ACCESS 'T[K]'. They differ
// only by whether the brackets are empty, so one production covers both.
PostfixType = AtomType { "[" [ Type ] "]" } ;

AtomType    = ParenType | ObjType | TupleType | TypeQuery | ImportType | TplType | LitType | ThisType | NamedType ;
ParenType   = "(" Type ")" ;
// An object type body - members, call and construct signatures, index signatures, mapped
// types with their 'as' key remapping - is entirely type syntax, so it is consumed as a
// BALANCED brace span. Strings and template literals inside it are matched whole, which
// is what keeps a brace in a string from being miscounted.
ObjType     = SkipBlock ;
// A tuple element may be spread ('...number[]'), LABELED ('[x: number, y?: string]') and
// optional. The label is tried first and rolls back when no ':' follows, which is what
// tells '[x: number]' from the plain '[number]'.
TupleType   = "[" [ TupleElem { "," TupleElem } [ "," ] ] "]" ;
TupleElem   = [ "..." ] [ TupleLabel ] Type [ "?" ] ;
TupleLabel  = Id [ "?" ] ":" ;
// 'typeof x' / 'typeof x.y' / 'typeof import("m")' as a TYPE - the type of a value, not
// the runtime operator.
TypeQuery   = KwTypeof ( ImportType | EntityName [ TypeArgs ] ) ;
// The argument of an import TYPE is itself a type, which is what makes the nested form
// 'import(import("./a").LookAt).Value' work.
ImportType  = KwImport "(" Type ")" { "." Id } [ TypeArgs ] ;
ThisType    = KwThis ;
NamedType   = EntityName [ TypeArgs ] ;
EntityName  = Id { "." Id } ;
TypeArgs    = "<" Type { "," Type } [ "," ] ">" ;
// A generic parameter declaration list: <T>, <K, V>, <T extends U>, <T = string>, and the
// variance / const modifiers <in T>, <out T>, <const T>.
TypeParams  = "<" TypeParamDecl { "," TypeParamDecl } [ "," ] ">" ;
TypeParamDecl = { TypeParamMod } Id [ KwExtends Type ] [ "=" Type ] ;
TypeParamMod = ( "in" | "out" | "const" ) KwEnd ModFollow ;

// A TEMPLATE LITERAL type: `/api/${string}`. The characters are the value template's
// (TplChar / TplDollar), the substitutions hold TYPES rather than expressions.
TplType     = "`" :whitespace() { TplTypeSub | TplTypeChars | TplTypeDollar } "`" :whitespace(Whitespace) ;
TplTypeSub  = "${" :whitespace(Whitespace) Type "}" ;
TplTypeChars = TplChar { TplChar } ;
TplTypeDollar = "$" ;

// The literal types. They are spelled out rather than reusing StringLit / NumberLit,
// because those push a value thunk and a type must push nothing.
LitType     = TypeStrLit | TypeNumLit | "true" KwEnd | "false" KwEnd | "null" KwEnd | "undefined" KwEnd ;
TypeStrLit  = '"' :whitespace() { JsStrEsc | JsDqPlain } '"' :whitespace(Whitespace)
            | "'" :whitespace() { JsStrEsc | JsSqPlain } "'" :whitespace(Whitespace) ;
TypeNumLit  = [ "-" | "+" ] ( "0x" | "0X" ) :whitespace() HexDigit { HexDigit } KwEnd :whitespace(Whitespace)
            | [ "-" | "+" ] Digit :whitespace() { Digit | "_" } [ "." { Digit } ] [ DecExp ] [ "n" ] KwEnd :whitespace(Whitespace) ;

Null        <~~ push(makeConst(null)) ~~>      = "null" KwEnd ;
Undefined   <~~ push(makeConst(undefined)) ~~> = "undefined" KwEnd ;

VarRef      <~~ push(makeVarRef(jsbRef(idName(up.in)))) ~~>
            = NotReserved Id ;

// See the twin of this comment in js-interpreter.abnf.
StringLit   = JsDqString | JsSqString ;
JsDqString  = '"' :whitespace() { JsStrEsc | JsDqPlain } <~~ push(makeConst(jsUnescape(up.in))) ~~> '"' :whitespace(Whitespace) ;
JsSqString  = "'" :whitespace() { JsStrEsc | JsSqPlain } <~~ push(makeConst(jsUnescape(up.in))) ~~> "'" :whitespace(Whitespace) ;
// The plain characters of a string are everything EXCEPT the closing quote, the backslash
// and a line terminator. The shared DqPlain/SqPlain start at \x20, which would reject the
// raw control characters JavaScript allows (a literal NUL in a string is legal), so the
// JS strings bring their own body characters the same way they bring their own escapes.
JsDqPlain   = "\x00"..."\x09" | "\x0b"..."\x0c" | "\x0e"..."\x21" | "\x23"..."\x5b" | "\x5d"..."\u2027" | "\u202a"..."\U0010ffff" ;
JsSqPlain   = "\x00"..."\x09" | "\x0b"..."\x0c" | "\x0e"..."\x26" | "\x28"..."\x5b" | "\x5d"..."\u2027" | "\u202a"..."\U0010ffff" ;

// See the twin of this comment in js-interpreter.abnf.
JsStrEsc    = "\\" ( JsHexEsc | JsUniEsc | JsLineCont | JsEscChar ) ;
JsLineCont  = "\r\n" | "\n" | "\r" | "\u2028" | "\u2029" ;
JsEscChar   = !"x" !"u" !"8" !"9" "\x20"..b"\x7e" ;

// See the twin of this comment in js-interpreter.abnf.
JsHexEsc    = "x" HexDigit HexDigit ;
JsUniEsc    = "u" ( "{" JsCodePoint "}" | HexDigit HexDigit HexDigit HexDigit ) ;
JsCodePoint = JsCpZeros | JsCpPlane16 | JsCpUpTo5 ;
JsCpZeros   = "0" { "0" } [ JsCpPlane16 | JsCpUpTo5 ] ;
JsCpPlane16 = "1" "0" HexDigit HexDigit HexDigit HexDigit ;
JsCpUpTo5   = HexNonZero [ HexDigit ] [ HexDigit ] [ HexDigit ] [ HexDigit ] ;
HexNonZero  = "1"..."9" | "a"..."f" | "A"..."F" ;

// See the twin of this comment in js-interpreter.abnf.
NumberLit   = HexLit | BinLit | OctLit | LegacyOctLit | BigIntLit | SepNumLit | JsDecLit | DotDecLit ;

// Hex must be tried before decimal, otherwise '0x1A' would stop after the '0'.
HexLit      <~~ push(makeConst(radixVal(up.in, 2, 16))) ~~>
            = ( "0x" | "0X" ) :whitespace() HexDigit { HexDigit | "_" } KwEnd :whitespace(Whitespace) ;
HexDigit    = "0"..."9" | "a"..."f" | "A"..."F" ;
BinLit      <~~ push(makeConst(radixVal(up.in, 2, 2))) ~~>
            = ( "0b" | "0B" ) :whitespace() BinDigit { BinDigit | "_" } KwEnd :whitespace(Whitespace) ;
BinDigit    = "0"..."1" ;
OctLit      <~~ push(makeConst(radixVal(up.in, 2, 8))) ~~>
            = ( "0o" | "0O" ) :whitespace() OctDigit { OctDigit | "_" } KwEnd :whitespace(Whitespace) ;
OctDigit    = "0"..."7" ;
// The Annex B legacy octal literal: a leading '0' directly followed by octal digits, as
// in '01' or '0777'. It needs at least two digits, so a bare '0' and '0.5' still reach
// JsDecLit, and it is tried before that one, which would otherwise stop after the '0'.
LegacyOctLit <~~ push(makeConst(radixVal(up.in, 1, 8))) ~~>
            = "0" :whitespace() OctDigit { OctDigit } KwEnd :whitespace(Whitespace) ;
// See the twin of this comment in js-interpreter.abnf.
BigIntLit   <~~ push(makeBigInt(up.in)) ~~>
            = ( BigHexPrefix HexDigit { HexDigit | "_" }
              | BigBinPrefix BinDigit { BinDigit | "_" }
              | BigOctPrefix OctDigit { OctDigit | "_" }
              | Digit :whitespace() { Digit | "_" } )
              "n" KwEnd :whitespace(Whitespace) ;
BigHexPrefix = ( "0x" | "0X" ) :whitespace() ;
BigBinPrefix = ( "0b" | "0B" ) :whitespace() ;
BigOctPrefix = ( "0o" | "0O" ) :whitespace() ;
// A decimal with numeric separators (1_000, 3.141_59, 1.1_00_01). Since stripSeps makes
// the separator-free text the ordinary decimal, this form is deliberately a SUPERSET of
// JsDecLit rather than requiring a '_': one production then covers both, and the plain
// decimal below is only still there for the shapes this one does not reach.
SepNumLit   <~~ push(makeConst(parseFloat(stripSeps(up.in)))) ~~>
            = Digit :whitespace() { Digit | "_" } [ "." { Digit | "_" } ] [ SepDecExp ] KwEnd :whitespace(Whitespace) ;
// The exponent takes separators too ('1e1_0'), which the plain DecExp below must not.
SepDecExp   = ( "e" | "E" ) [ "+" | "-" ] Digit { Digit | "_" } ;
// See the twin of this comment in js-interpreter.abnf.
JsDecLit    <~~ push(makeConst(parseFloat(up.in))) ~~>
            = Digit :whitespace() { Digit } [ "." { Digit } ] [ DecExp ] KwEnd :whitespace(Whitespace) ;
// The leading-dot decimal ('.5', '.5e3'). It has no integer part at all, so it cannot be
// folded into JsDecLit, whose first token is a Digit. parseFloat(".5") is 0.5 in both
// engines, so the text goes through unchanged.
DotDecLit   <~~ push(makeConst(parseFloat(up.in))) ~~>
            = "." :whitespace() Digit { Digit } [ DecExp ] KwEnd :whitespace(Whitespace) ;
DecExp      = ( "e" | "E" ) [ "+" | "-" ] Digit { Digit } ;
Digit       = "0"..."9" ;

// See the twin of this comment in js-interpreter.abnf.
RegexLit    <~~ push(makeRegex(up.in)) ~~>
            = "/" :whitespace() ReStrictU RegexFirst { RegexPart } "/" { RegexFlag } :whitespace(Whitespace) ;
RegexFirst  = RegexEsc | RegexClass | RegexFirstChar ;
RegexPart   = RegexEsc | RegexClass | RegexBodyChar ;
RegexClass  = "[" { RegexEsc | RegexClassChar } "]" ;
RegexEsc    = "\\" ( "\x00"..."\x09" | "\x0b"..."\U0010ffff" ) ;
RegexFirstChar = "\x00"..."\x09" | "\x0b"..."\x29" | "\x2b"..."\x2e" | "\x30"..."\x5a" | "\x5d"..."\U0010ffff" ;
RegexBodyChar  = "\x00"..."\x09" | "\x0b"..."\x2e" | "\x30"..."\x5a" | "\x5d"..."\U0010ffff" ;
RegexClassChar = "\x00"..."\x09" | "\x0b"..."\x5b" | "\x5e"..."\U0010ffff" ;
RegexFlag   = IdPart ;

// See the twin of this comment in js-interpreter.abnf.
ReStrictU   = :script(~~
    (function () {
        var isHex = function (x) {
            return (x >= 48 && x <= 57) || (x >= 97 && x <= 102) || (x >= 65 && x <= 70)
        }
        // The length of the escape starting at p (p points at the backslash), or -1 when
        // 'u' mode does not allow it. A decimal backreference is NOT handled here - the
        // caller has to count the groups first.
        var escLen = function (p, inClass) {
            var e = c.peek(p + 1)
            if (e < 0) { return -1 }
            // CharacterClassEscape and ControlEscape.
            if (e == 100 || e == 68 || e == 115 || e == 83 || e == 119 || e == 87) { return 2 }
            if (e == 102 || e == 110 || e == 114 || e == 116 || e == 118) { return 2 }
            if (e == 98) { return 2 }                        // \b: assertion, or backspace in a class
            if (e == 66) { if (inClass) { return -1 } return 2 }
            if (e == 99) {                                   // \cX
                var x = c.peek(p + 2)
                if ((x >= 97 && x <= 122) || (x >= 65 && x <= 90)) { return 3 }
                return -1
            }
            if (e == 120) {                                  // \xHH
                if (isHex(c.peek(p + 2)) && isHex(c.peek(p + 3))) { return 4 }
                return -1
            }
            if (e == 117) {                                  // \uHHHH and \u{H...}
                if (c.peek(p + 2) == 123) {
                    var q = p + 3
                    var n = 0
                    while (isHex(c.peek(q))) { q = q + 1; n = n + 1 }
                    if (n > 0 && c.peek(q) == 125) { return q + 1 - p }
                    return -1
                }
                if (isHex(c.peek(p + 2)) && isHex(c.peek(p + 3)) && isHex(c.peek(p + 4)) && isHex(c.peek(p + 5))) { return 6 }
                return -1
            }
            if (e == 112 || e == 80) {                       // \p{...} / \P{...}
                if (c.peek(p + 2) != 123) { return -1 }
                var q2 = p + 3
                while (q2 < p + 128 && c.peek(q2) != 125 && c.peek(q2) >= 0) { q2 = q2 + 1 }
                if (c.peek(q2) != 125) { return -1 }
                return q2 + 1 - p
            }
            if (e == 107) {                                  // \k<name>
                if (inClass) { return -1 }
                if (c.peek(p + 2) != 60) { return -1 }
                var q3 = p + 3
                while (q3 < p + 256 && c.peek(q3) != 62 && c.peek(q3) >= 0) { q3 = q3 + 1 }
                if (c.peek(q3) != 62) { return -1 }
                return q3 + 1 - p
            }
            if (e == 48) {                                   // \0, but not a legacy octal
                var d0 = c.peek(p + 2)
                if (d0 >= 48 && d0 <= 57) { return -1 }
                return 2
            }
            if (e >= 49 && e <= 57) { return -1 }            // the caller handles \1..\9
            // SyntaxCharacter and '/' are the only identity escapes 'u' keeps; a class
            // adds '-'.
            if (e == 94 || e == 36 || e == 92 || e == 46 || e == 42 || e == 43 || e == 63
                || e == 40 || e == 41 || e == 91 || e == 93 || e == 123 || e == 125
                || e == 124 || e == 47) { return 2 }
            if (inClass && e == 45) { return 2 }
            return -1
        }

        // ----- 1. where does the literal end, and does it carry 'u'? -----
        var i = 0
        var inCls = false
        var end = -1
        while (i < 65536) {
            var ch = c.peek(i)
            if (ch < 0 || ch == 10 || ch == 13) { return undefined }   // not a literal; the rules report it
            if (ch == 92) { i = i + 2; continue }
            if (inCls) { if (ch == 93) { inCls = false } }
            else if (ch == 91) { inCls = true }
            else if (ch == 47) { end = i; break }
            i = i + 1
        }
        if (end < 0) { return undefined }
        var strict = false
        var k = end + 1
        while (k < end + 32) {
            var f = c.peek(k)
            if (!((f >= 97 && f <= 122) || (f >= 65 && f <= 90) || (f >= 48 && f <= 57))) { break }
            if (f == 117) { strict = true }
            k = k + 1
        }
        if (!strict) { return undefined }

        // ----- 2. how many capturing groups are there? -----
        var ng = 0
        var j = 0
        inCls = false
        while (j < end) {
            var a = c.peek(j)
            if (a == 92) { j = j + 2; continue }
            if (inCls) { if (a == 93) { inCls = false } j = j + 1; continue }
            if (a == 91) { inCls = true; j = j + 1; continue }
            if (a == 40) {
                if (c.peek(j + 1) != 63) { ng = ng + 1 }
                else if (c.peek(j + 2) == 60 && c.peek(j + 3) != 61 && c.peek(j + 3) != 33) { ng = ng + 1 }
            }
            j = j + 1
        }

        // ----- 3. the strict walk -----
        // prev classifies what a quantifier would attach to: 0 nothing, 1 a quantifiable
        // atom, 2 an assertion (never quantifiable under 'u'), 3 an atom that already
        // carries a quantifier (only a lazy '?' may follow), 4 a lazy quantifier.
        var bad = false
        var prev = 0
        var gk = []
        j = 0
        inCls = false
        while (j < end && !bad) {
            var ch2 = c.peek(j)
            if (inCls) {
                if (ch2 == 93) { inCls = false; prev = 1; j = j + 1; continue }
                if (ch2 == 92) {
                    var L2 = escLen(j, true)
                    if (L2 < 0) { bad = true; continue }
                    j = j + L2
                    continue
                }
                j = j + 1
                continue
            }
            if (ch2 == 92) {
                var e1 = c.peek(j + 1)
                if (e1 >= 49 && e1 <= 57) {                  // \1..\9: a backreference
                    var q6 = j + 1
                    var val = 0
                    while (c.peek(q6) >= 48 && c.peek(q6) <= 57) { val = val * 10 + (c.peek(q6) - 48); q6 = q6 + 1 }
                    if (val > ng) { bad = true; continue }
                    prev = 1
                    j = q6
                    continue
                }
                var L = escLen(j, false)
                if (L < 0) { bad = true; continue }
                prev = (e1 == 98 || e1 == 66) ? 2 : 1
                j = j + L
                continue
            }
            if (ch2 == 91) { inCls = true; j = j + 1; continue }
            if (ch2 == 93) { bad = true; continue }          // a lone ']' is a literal only in Annex B
            if (ch2 == 40) {
                var n1 = c.peek(j + 1)
                if (n1 != 63) { gk.push(1); prev = 0; j = j + 1; continue }
                var n2 = c.peek(j + 2)
                if (n2 == 58) { gk.push(1); prev = 0; j = j + 3; continue }            // (?:
                if (n2 == 61 || n2 == 33) { gk.push(2); prev = 0; j = j + 3; continue } // (?= (?!
                if (n2 == 60) {
                    var n3 = c.peek(j + 3)
                    if (n3 == 61 || n3 == 33) { gk.push(2); prev = 0; j = j + 4; continue } // (?<= (?<!
                    var q7 = j + 3
