    // Drops the numeric separators of '1_000_000' / '3.141_59' so parseFloat sees the
    // plain decimal it understands.
    function stripSeps(s) {
        var out = ""
        for (var i = 0; i < s.length; i++) { if (s.charCodeAt(i) != 95) { out = out + s.charAt(i) } }
        return out
    }
    // ----- BigInt: a real arbitrary precision integer -----
    // A BigInt is a value type of its own, not a boxed double: 2n ** 64n is exact,
    // 1n + 1 is a TypeError, and typeof answers "bigint". The representation is
    //     {__bigint: true, s: -1|0|1, d: [limb, ...]}
    // with the magnitude little endian in base 2^24 and no leading zero limb, so
    // s is 0 exactly when d is empty. 24 bits is the widest limb whose SQUARE
    // (2^48) plus carries still lands exactly in a double, which is what makes the
    // schoolbook multiply below correct with no 64-bit help.
    //
    // Everything here is written in the -frozen subset (no host BigInt, no for..in,
    // no splice, no split/join) and was validated digit for digit against node 24:
    // every operator over 144 signed pairs spanning 1 to 39 decimal digits, the
    // radix 2/8/10/16 round trips, and 11 exponentiations. abnf/jsrt.go's jsBigInt
    // (Go big.Int) is the compiler half's twin; ./test.sh --full diffs the two.
    var BI_BASE = 16777216
    var BI_MASK = 16777215
    var BI_DIGITS = "0123456789abcdefghijklmnopqrstuvwxyz"
    function isBigInt(v) { return v != undefined && v != null && typeof v == "object" && v.__bigint == true }
    // ----- magnitude helpers: plain little endian limb arrays -----
    function biTrim(d) {
        while (d.length > 0 && d[d.length - 1] === 0) { d.pop() }
        return d
    }
    function biCopy(d) { var o = []; for (var i = 0; i < d.length; i++) { o.push(d[i]) } return o }
    function biMake(s, d) {
        var dd = biTrim(d)
        if (dd.length === 0) { return {__bigint: true, s: 0, d: dd} }
        return {__bigint: true, s: s, d: dd}
    }
    function biZero() { return biMake(0, []) }
    function biIsZero(v) { return v.s === 0 }
    function biNeg(v) { return biMake(-v.s, biCopy(v.d)) }
    function biCmpD(a, b) {
        if (a.length !== b.length) { return a.length < b.length ? -1 : 1 }
        for (var i = a.length - 1; i >= 0; i--) {
            if (a[i] !== b[i]) { return a[i] < b[i] ? -1 : 1 }
        }
        return 0
    }
    function biAddD(a, b) {
        var out = []
        var carry = 0
        var n = a.length > b.length ? a.length : b.length
        for (var i = 0; i < n; i++) {
            var s = carry
            if (i < a.length) { s = s + a[i] }
            if (i < b.length) { s = s + b[i] }
            if (s >= BI_BASE) { out.push(s - BI_BASE); carry = 1 } else { out.push(s); carry = 0 }
        }
        if (carry > 0) { out.push(carry) }
        return out
    }
    // Requires |a| >= |b|; the signed layer above picks the operands so it holds.
    function biSubD(a, b) {
        var out = []
        var borrow = 0
        for (var i = 0; i < a.length; i++) {
            var s = a[i] - borrow
            if (i < b.length) { s = s - b[i] }
            if (s < 0) { s = s + BI_BASE; borrow = 1 } else { borrow = 0 }
            out.push(s)
        }
        return biTrim(out)
    }
    // Schoolbook multiply. The carry is folded INSIDE the inner loop, so the widest
    // intermediate is (B-1)^2 + 2(B-1) < 2^48 and stays exact in a double; a version
    // that accumulated a column first would not.
    function biMulD(a, b) {
        if (a.length === 0 || b.length === 0) { return [] }
        var out = []
        for (var i = 0; i < a.length + b.length; i++) { out.push(0) }
        for (var i = 0; i < a.length; i++) {
            var carry = 0
            var ai = a[i]
            for (var j = 0; j < b.length; j++) {
                var t = out[i + j] + ai * b[j] + carry
                carry = Math.floor(t / BI_BASE)
                out[i + j] = t - carry * BI_BASE
            }
            var k = i + b.length
            while (carry > 0) {
                var t2 = out[k] + carry
                carry = Math.floor(t2 / BI_BASE)
                out[k] = t2 - carry * BI_BASE
                k = k + 1
            }
        }
        return biTrim(out)
    }
    function biMulSmallD(a, m) {
        var out = []
        var carry = 0
        for (var i = 0; i < a.length; i++) {
            var t = a[i] * m + carry
            carry = Math.floor(t / BI_BASE)
            out.push(t - carry * BI_BASE)
        }
        while (carry > 0) {
            var c2 = Math.floor(carry / BI_BASE)
            out.push(carry - c2 * BI_BASE)
            carry = c2
        }
        return biTrim(out)
    }
    // m must be <= 2^24 so rem * BI_BASE + limb stays below 2^48.
    function biDivModSmallD(a, m) {
        var q = []
        for (var i = 0; i < a.length; i++) { q.push(0) }
        var rem = 0
        for (var i = a.length - 1; i >= 0; i--) {
            var cur = rem * BI_BASE + a[i]
            var dv = Math.floor(cur / m)
            q[i] = dv
            rem = cur - dv * m
        }
        return {q: biTrim(q), r: rem}
    }
    function biTopBits(x) {
        var n = 0
        var v = x
        while (v > 0) { n = n + 1; v = Math.floor(v / 2) }
        return n
    }
    function biBitsD(d) {
        if (d.length === 0) { return 0 }
        return (d.length - 1) * 24 + biTopBits(d[d.length - 1])
    }
    function biBitD(a, k) {
        var i = Math.floor(k / 24)
        if (i >= a.length) { return 0 }
        return (a[i] >> (k - i * 24)) & 1
    }
    function biShl1D(a) {
        var out = []
        var carry = 0
        for (var i = 0; i < a.length; i++) {
            var t = a[i] * 2 + carry
            if (t >= BI_BASE) { out.push(t - BI_BASE); carry = 1 } else { out.push(t); carry = 0 }
        }
        if (carry > 0) { out.push(carry) }
        return out
    }
    // Division of magnitudes. A single limb divisor takes the O(n) path; anything
    // wider goes through plain binary long division, which is O(bits x limbs) and
    // needs none of Knuth D's quotient-digit estimation - the sizes a BigInt program
    // actually reaches here make the simpler algorithm the right trade.
    function biDivModD(a, b) {
        if (biCmpD(a, b) < 0) { return {q: [], r: biCopy(a)} }
        if (b.length === 1) {
            var s = biDivModSmallD(a, b[0])
            return {q: s.q, r: s.r === 0 ? [] : [s.r]}
        }
        var nbits = biBitsD(a)
        var q = []
        for (var i = 0; i < a.length; i++) { q.push(0) }
        var r = []
        for (var k = nbits - 1; k >= 0; k--) {
            r = biShl1D(r)
            if (biBitD(a, k) === 1) {
                if (r.length === 0) { r.push(1) } else { r[0] = r[0] + 1 }
            }
            if (biCmpD(r, b) >= 0) {
