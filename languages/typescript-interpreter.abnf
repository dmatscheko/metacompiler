            for (var k = 0; k < v.length; k++) { out.push(v[k]) }
        }
        return out
    }

    // ----- Expression thunks: function() -> value -----

    // '!' is ToBoolean-then-negate, so !0n is true.
    makeNot = function(t) { return function() { return !jsTruthy(t()) } }
    makeNeg = function(t) {
        return function() {
            var v = anytype // A number or a BigInt.
            v = t()
            if (isBigInt(v)) { return biNeg(v) }
            return -v
        }
    }
    // Unary plus is numeric coercion, nothing else: '- 0' does exactly that without
    // being a second spelling of addition (which '0 + v' would be for a string operand).
    // It is the ONE unary operator a BigInt refuses, since there is no number to
    // coerce it to without losing precision.
    function makePos(t) {
