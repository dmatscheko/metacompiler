            return v - 0
        }
    }
    function makeBitNot(t) {
        return function() {
            var v = anytype
            v = t()
            if (isBigInt(v)) { return biNot(v) }
            return ~v
        }
    }
    // 'void x' evaluates its operand for the side effects and yields undefined.
    function makeVoid(t) { return function() { t(); return undefined } }
    // typeof reports "bigint" for a boxed BigInt (see makeBigInt) and otherwise the
    // host's own answer, which already covers number/string/boolean/object/function
    // /undefined the way JavaScript does.
    function makeTypeof(t) {
        return function() {
            var v = anytype // typeof accepts every type, that is the point of it.
            v = t()
            if (isBigInt(v)) { return "bigint" }
            return typeof v
        }
    }
    // 'typeof <bare name>' is the ONE expression in JavaScript that may name an
    // undeclared variable without a ReferenceError, so it cannot go through getVar
    // (which fails). It walks the same chain by hand and answers "undefined" instead.
    function makeTypeofName(name) {
        return function() {
            for (var i = scopes.length - 1; i >= 0; i--) {
                if (hasOwn(scopes[i], name)) {
                    var v = anytype // The variable may hold any type.
                    v = scopes[i][name]
                    if (isBigInt(v)) { return "bigint" }
                    return typeof v
