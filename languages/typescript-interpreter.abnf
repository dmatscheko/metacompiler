    // Binds one call's arguments to the parameter list. A parameter is either a plain
    // name (the overwhelmingly common case, kept as a bare string) or a descriptor:
    //   {pname, dflt}  a default value, evaluated ONLY when the argument is missing -
    //                  and in the half-built scope, so it may read earlier parameters
    //   {rest, pname}  the rest parameter: an array of every argument left over
    //   {pat}          a destructuring pattern, bound through bindPattern
    function bindParams(sc, params, args) {
        for (var i = 0; i < params.length; i++) {
            var p = params[i]
            if (typeof p == "string") { scopePut(sc, p, args[i]); continue }
            if (p.rest == true) {
                var rest = []
                for (var j = i; j < args.length; j++) { rest.push(args[j]) }
                if (p.pat != null) { bindPattern(p.pat, rest) } else { scopePut(sc, p.pname, rest) }
                continue
