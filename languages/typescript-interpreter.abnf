        return null
    }

    // println(a, b) joins its arguments with a space, print(a, b) with nothing, and
    // each argument is stringified on its own - which is what the host functions do
    // for a run of strings.
    function jsPrintln() {
        var out = ""
        for (var i = 0; i < arguments.length; i++) {
            if (i > 0) { out = out + " " }
            out = out + jsStr(arguments[i])
        }
        println(out)
        return undefined
    }
    function jsPrint() {
        var out = ""
        for (var i = 0; i < arguments.length; i++) { out = out + jsStr(arguments[i]) }
        print(out)
        return undefined
    }

    // String(v) is JavaScript's ToString, which for an object means its own toString
    // method. The host String is goja's constructor under goja and a bare OBJECT
    // carrying fromCharCode under -frozen, so a String(v) call was engine-dependent.
    // String.fromCharCode is answered by jsBuiltin (getMember finds no such member on
    // a function value), the way js_jsmcall answers it in the compiler half.
    function jsStringFn(v) {
        if (arguments.length == 0) { return "" }
        return jsStr(v)
    }
    function jsBigIntFn(v) {
        if (arguments.length == 0) { fail("TypeError: Cannot convert undefined to a BigInt") }
        return biOf(v)
    }
    function jsNumberFn(v) {
        if (arguments.length == 0) { return 0 }
        if (isBigInt(v)) { return biToNum(v) }
        if (typeof v == "string") { return v === "" ? 0 : parseFloat(v) }
        if (typeof v == "boolean") { return v ? 1 : 0 }
        if (v === null) { return 0 }
        return v - 0
    }

    var hostGlobals = {
        // println / print render every argument with JAVASCRIPT's ToString first. The
        // shared host functions print Go's %v, so println(null) said "", println([1,2])
        // said "1 2" and println({a:1}) dumped "map[__keys:[a] a:1]" - node says "null",
        // "1,2" and "[object Object]". js_jsprintfn is the compiler twin.
        "println": jsPrintln, "print": jsPrint, "printf": printf, "sprintf": sprintf,
        "parseInt": parseInt, "parseFloat": parseFloat, "Math": Math, "String": jsStringFn,
        // BigInt(v) is ToBigInt and Number(v) is ToNumber; the latter is the only way
        // back out of a BigInt, since unary '+' refuses it.
        "BigInt": jsBigIntFn, "Number": jsNumberFn,
        // Object is OURS, not the host's: the host's leaked the hidden __keys slot out
        // of Object.keys / entries under goja and had no keys at all under -frozen.
        "Object": jsObjectGlobal, "Array": Array,
        // The Promise global: a function value, so `new Promise(exec)` constructs one
        // and `typeof Promise` is "function". The statics resolve through jsBuiltin.
        "Promise": jsPromiseFn,
        // NaN and Infinity are global BINDINGS in JavaScript; the compiler half has
        // always had them and this one raised "variable not defined".
        "NaN": 0 / 0, "Infinity": 1 / 0, "undefined": undefined,
        "exit": exit
    }

    // Plain, unpinned scope entries: a variable holds its value directly and may
    // change type freely. No declare-before-use discipline.
    getVar = function(name) {
        for (var i = scopes.length - 1; i >= 0; i--) {
            if (hasOwn(scopes[i], name)) return scopes[i][name]
        }
        if (hasOwn(hostGlobals, name)) return hostGlobals[name]
        fail("variable not defined: " + name)
    }
    declVar = function(name, value) {
        scopePut(scopes[scopes.length - 1], name, value)
    }
    // Assignment walks the chain; a name that is nowhere declared becomes an
    // implicit global (real, non strict JavaScript), never an error.
    setVar = function(name, value) {
        for (var i = scopes.length - 1; i >= 0; i--) {
            if (hasOwn(scopes[i], name)) { scopePut(scopes[i], name, value); return }
        }
        scopePut(globalScope, name, value)
    }

    // ----- Statement signals -----
    // Statement thunks return undefined (fall through), BRK, CONT, or {isRet:true, v:...}.

    // ----- Functions -----
    // A MetaJS function value is a real (goja) JS function, so typeof, passing it around,
    // and calling it work natively. It closes over the scope chain of its creation.
    // ----- The receiver channel ('this') -----
    // The tag dialect has no 'this' of its own, and a closure built here is an ordinary
    // host function, so the host's own receiver never reaches the body. The call SITE
    // therefore hands the receiver over in a one-shot slot that the callee reads and
    // clears as its very first act - before it evaluates anything that could call again.
    // A plain call leaves the slot empty, which is exactly a 'this' of undefined.
    // pendingNewTarget rides along the same way: 'new f()' sets it, a plain call does not,
    // and that difference is all 'new.target' reports.
    var pendingThis = anytype     // The receiver may be any value at all,
    var pendingNewTarget = anytype // and new.target holds a function or undefined.

    function makeClosure(params, bodyT, defScopes) {
        var env = defScopes.slice()
        return function() {
            var self = pendingThis
            var nt = pendingNewTarget
            pendingThis = undefined
            pendingNewTarget = undefined
            var args = []
            for (var i = 0; i < arguments.length; i++) args.push(arguments[i])
            var saved = scopes
            scopes = env.slice()
            var sc = {}
            sc["this"] = self
            sc["new.target"] = nt
            sc["arguments"] = args
            // The parameter scope has to be ACTIVE while the parameters bind: a default
            // value may read an earlier parameter ('function f(a, b = a + 1)').
            scopes.push(sc)
            bindParams(sc, params, args)
            var r = bodyT()
            scopes = saved
            return (r != undefined && r.isRet) ? r.v : undefined
        }
    }

    // An ARROW function is the one callable that does not bind its own 'this': the body
    // sees whatever the enclosing function bound, which is why the scope it pushes has no
    // "this" (nor "arguments" or "new.target") entry at all and the lookup walks out to
    // the definition site. It still has to drain the receiver slot, or the receiver of
    // the call that reached the arrow would leak into the next closure that runs.
    function makeArrowClosure(params, bodyT, defScopes) {
        var env = defScopes.slice()
        return function() {
            pendingThis = undefined
            pendingNewTarget = undefined
            var args = []
            for (var i = 0; i < arguments.length; i++) args.push(arguments[i])
            var saved = scopes
            scopes = env.slice()
            var sc = {}
            scopes.push(sc)
            bindParams(sc, params, args)
            var r = bodyT()
            scopes = saved
            return (r != undefined && r.isRet) ? r.v : undefined
        }
