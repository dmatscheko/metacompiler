                // ... - which is what an array-LIKE object (a tagged template's chunk
                // list) is built out of.
                if (typeof k == "number" && hasOwn(o, "" + k)) { return o["" + k] }
                return undefined
            }
        }
        return o[k]
    }
    // Writing a member goes through the SETTER when there is one, which is what makes
    // 'o.v = 2' run the accessor instead of shadowing it with a plain slot.
    function setMember(o, k, v) {
        if (o != undefined && o != null && typeof o == "object" && !Array.isArray(o)) {
            var s = findAccessor(o, "set", k)
            if (s != undefined) { callWithThis(s, o, [v]); return }
        }
        scopePut(o, k, v)
        trackKey(o, k) // Keep the object's for-in key list up to date.
    }
    // The two Function.prototype shims getMember hands out (see there). Each of them is a
    // fresh closure over the target function, so 'f.call === f.call' is false - which no
    // program in this subset can observe, and which keeps the shim free of any table.
    function fnCallShim(fn) {
        return function() {
            var self = anytype // The explicit receiver may be any value.
            self = (arguments.length > 0) ? arguments[0] : undefined
            var a = []
            for (var i = 1; i < arguments.length; i++) { a.push(arguments[i]) }
            return callWithThis(fn, self, a)
        }
    }
    function fnApplyShim(fn) {
        return function() {
            var self = anytype // The explicit receiver may be any value.
            self = (arguments.length > 0) ? arguments[0] : undefined
            var a = (arguments.length > 1 && arguments[1] != undefined) ? arguments[1] : []
            return callWithThis(fn, self, a)
