    }

    // The argument list of a tagged template call: the array of the literal chunks
    // BETWEEN the substitutions - carrying the unprocessed source text in its 'raw'
    // property, which is why TplChars keeps both spellings - followed by the value of
    // each substitution. There is always one more chunk than there are substitutions,
    // even when a chunk is empty ('tag`${x}`' passes ["", ""]).
