    }
    // items = [{decs}, {mods}, {acc}, keyDesc, params, bodyThunk].
    function makeClassAccessor(items) {
        var key = items[3]
        return {kind: "accessor", acc: items[2].acc, name: key.mk, keyT: key.mkT,
