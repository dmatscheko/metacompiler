    // One step: replay the body up to yield number st.count, and report what happened.
    function genNext(st, params, bodyT, env, self, args, sendv) {
        if (st.done) { return {value: undefined, done: true, __keys: ["value", "done"]} }
        st.sent.push(sendv)
