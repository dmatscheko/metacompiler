    // ({spread, t}). A spread contributes every element of its iterable - an array's
    // elements, a string's characters - in place, so what the callee sees is one flat
    // list. A plain entry is the value thunk itself, which keeps the common case free of
    // any per-argument test beyond the typeof.
    function evalArgs(items) {
        var out = []
        for (var i = 0; i < items.length; i++) {
            var it = items[i]
            if (typeof it == "function") { out.push(it()); continue }
            var v = anytype // The spread operand is an array or a string.
            v = it.t()
            if (v == undefined || v == null) fail("spread of " + v)
            if (typeof v == "string") {
                for (var j = 0; j < v.length; j++) { out.push(v.charAt(j)) }
                continue
