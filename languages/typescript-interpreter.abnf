        // then/catch/finally READ AS A VALUE. Promise method dispatch is table-based
        // (jsBuiltin -> jpMethod), so a promise has no own slot of that name and
        // `const t = p.then` answered undefined where node answers a function. Same
        // arm in abnf/jsrtjsprint.go's js_jsmget and languages/lib/js-rt.metajs's.
        if (k == "then" || k == "catch" || k == "finally") {
            if (jpIs(o)) { return jpBound(o, k) }
        }
        // 'f.call(self, ...)' / 'f.apply(self, args)' on a FUNCTION value. The host's own
        // call/apply would hand the receiver over through the host's 'this', which the
        // closures built here never read - they take it from the one-shot pendingThis slot
        // - so the two are re-implemented on top of callWithThis. A decorator that wraps a
        // method ('return original.call(this, n) * 2') needs exactly this.
        if (typeof o == "function") {
            if (k == "call") { return fnCallShim(o) }
            if (k == "apply") { return fnApplyShim(o) }
        }
        // Plain objects (instances, literals) read own properties only: a bare o[k]
        // resolved inherited Object.prototype members (toString, valueOf, ...) under a
        // host JS engine, while the frozen engine's objects have no prototype chain.
        if (typeof o == "object" && !Array.isArray(o)) {
            var g = findAccessor(o, "get", k)
            if (g != undefined) { return callWithThis(g, o, []) }
            if (!hasOwn(o, k)) {
