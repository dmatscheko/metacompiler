    // ----- Literals -----

    // The digits of a radix literal ('0b1010', '0o17', the decimal part of '10n'),
    // skipping the '_' separators and stopping at the first character that is not a
    // digit of the base (the trailing 'n' of a BigInt, or whatever KwEnd left behind).
    function radixVal(s, start, radix) {
        var v = 0
        for (var i = start; i < s.length; i++) {
            var cc = s.charCodeAt(i)
            if (cc == 95) { continue }
            var d = 99
            if (cc >= 48 && cc <= 57) { d = cc - 48 }
            else if (cc >= 97 && cc <= 102) { d = cc - 87 }
            else if (cc >= 65 && cc <= 70) { d = cc - 55 }
            if (d >= radix) { break }
            v = v * radix + d
