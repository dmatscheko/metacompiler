// The inner expression's own end position, so a folded constant inside the group can
// be re-registered against the group (see goParenC).
PGInner     <~~ push({at: up.pos, as: up.start}) ~~> = Expression ;
LitOn = :script(~~
    push("$struct")
    undefined
~~) ;
LitOff = :script(~~
    pop()
    undefined
~~) ;
ParenConvT  <~~ push({conv: firstType(up.in)}) ~~>
            = PtrTypeT | "[" "]" Type | ArrayTypeT | MapTypeT | FuncTypeT | ChanTypeT | IfaceTypeT
            | StructTypeT ;
