    // -v on a value that may or may not be complex: component-wise for a complex,
    // js_gineg (which keeps a float64 a float64 and negates an integer at its own
    // width) for everything else.
    //
    // THE COMPONENTS NEGATE WITH js_neg AND NOT WITH `0 - x`: `0 - 0.0` is +0.0, so
    // subtracting from zero LOSES the sign of a negative zero, which go keeps -
    // `-(0+0i)` over variables prints `(-0-0i)`. js_neg is `mk_num(d_neg(...))` in
    // the floor, and d_neg writes the SIGN BIT; js_gineg is not usable on a
    // component because it would wrap a fractional part to an integer width.
    function declCxNeg(b) {
        return declFn(b, "$cxneg", 1, function(fb, as, f) {
