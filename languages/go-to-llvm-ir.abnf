        callExt(b, "js_set", [h, emitStr(b, "__class"), b.NewLoad(i64, slClassG())])
        callExt(b, "js_set", [h, emitStr(b, "a"), a])
        callExt(b, "js_set", [h, emitStr(b, "o"), o])
        callExt(b, "js_set", [h, emitStr(b, "n"), n])
        callExt(b, "js_set", [h, emitStr(b, "c"), c])
