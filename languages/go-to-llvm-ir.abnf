                                       return {b: eb, v: v}
                                   })
                return r.b
            }
            if (ref.name != "_") {
                callExt(b, "js_scope_set", [curScopeV, emitStr(b, ref.name), emitHelper(b, "$acopy", [v])])
            }
            return b
        }
        var o = callExt(b, "js_scope_get", [curScopeV, emitStr(b, ref.name)])
        for (var i = 0; i < ref.path.length - 1; i++) {
            var s = ref.path[i]
            if (s.key != undefined) {
                o = callExt(b, "js_gofield", [o, emitStr(b, s.key)])
            } else {
                var r = s.idx(b)
                b = r.b
                o = emitHelper(b, "$sidx", [o, r.v])
            }
        }
        var last = ref.path[ref.path.length - 1]
