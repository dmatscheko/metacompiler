            b = ea.b
            var pairV = callExt(b, "js_arr_new", [])
            callExt(b, "js_arr_push", [pairV, fV])
            callExt(b, "js_arr_push", [pairV, ea.v])
            callExt(b, "js_arr_push", [callExt(b, "js_scope_get", [curScopeV, emitStr(b, "$defers")]), pairV])
            return b
        }
    }

    // Point{a, b}: the field names are known at compile time.
    // items = [name, ({fkey}? valueThunk)...]: a positional or keyed struct literal.
    // Every field the literal leaves out is ZERO-filled from its declared type, the way
    // Go does - so Point{} and Point{x: 0} are the same value and compare equal.
    function makeStructLit(items) {
        var tyName = items[0]
        var args = items.slice(1)
        return function(b) {
            var clsV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, tyName)])
            return emitStructVal(b, clsV, structFields[tyName], structFTypes[tyName], args)
        }
    }
    // struct{ a, b int }{10, 20}: items = [fieldName..., {fty}, ..., body elements].
    // The descriptor is built fresh at the literal site (there is no name to look up);
    // js_goeq compares two anonymous structs by name and field list, not by identity.
    function makeAnonStructLit(items) {
        var fields = []
        var ftypes = []
        var pending = []
        var args = []
        var inBody = false
        for (var i = 0; i < items.length; i++) {
            var it = items[i]
            if (!inBody && typeof it == "string") { pending.push(it); continue }
            if (!inBody && typeof it == "object" && it != null && it.fty != undefined) {
                for (var k = 0; k < pending.length; k++) { fields.push(pending[k]); ftypes.push(it.fty) }
                pending = []
                continue
            }
            inBody = true
            args.push(it)
        }
        return function(b) {
            var clsV = callExt(b, "js_obj_new", [])
            callExt(b, "js_set", [clsV, emitStr(b, "__isclass"), hTrue])
            callExt(b, "js_set", [clsV, emitStr(b, "__name"), emitStr(b, "struct")])
            emitNameList(b, clsV, "__fields", fields)
            emitNameList(b, clsV, "__ftypes", ftypes)
            return emitStructVal(b, clsV, fields, ftypes, args)
        }
    }
    // The shared body of both literal forms: zero-fill, then apply the elements in
    // order (a keyed one names its field, a positional one takes the next field).
    function emitStructVal(b, clsV, fields, ftypes, args) {
        var objV = callExt(b, "js_obj_new", [])
        callExt(b, "js_set", [objV, emitStr(b, "__class"), clsV])
        for (var z = 0; z < fields.length; z++) {
            callExt(b, "js_set", [objV, emitStr(b, fields[z]), emitZeroOf(b, ftypes[z])])
        }
        var pos = 0
        var key = null
        for (var i = 0; i < args.length; i++) {
            if (typeof args[i] != "function") { key = args[i].fkey; continue }
            var r = args[i](b)
            b = r.b
            var name = key
            if (name == null) { name = fields[pos]; pos++ }
            key = null
            callExt(b, "js_set", [objV, emitStr(b, name), r.v])
        }
        return {b: b, v: objV}
    }
    // The zero value of a type, from its type TEXT: 0 for every numeric kind, "" for a
    // string, false for a bool and nil for everything else (slice, map, pointer, struct).
    function emitZeroOf(b, t) {
        if (t == undefined || t == null) { return hNull }
        if (t.indexOf("int") == 0 || t.indexOf("uint") == 0 || t.indexOf("byte") == 0
            || t.indexOf("rune") == 0 || t.indexOf("float") == 0) { return emitNum(b, 0) }
        if (t.indexOf("string") == 0) { return emitStr(b, "") }
        if (t.indexOf("bool") == 0) { return hFalse }
        return hNull
    }
    // A runtime array of strings, set as one property of a struct descriptor.
    function emitNameList(b, clsV, prop, names) {
        var arrV = callExt(b, "js_arr_new", [])
        for (var i = 0; i < names.length; i++) {
            callExt(b, "js_arr_push", [arrV, emitStr(b, names[i])])
        }
        callExt(b, "js_set", [clsV, emitStr(b, prop), arrV])
    }

    // ----- Complex numbers -----
    // complex128 is a "$cx" class instance {re, im}: the class shape is what makes
    // js_is_type a safe probe (it answers false for a number instead of aborting) and
    // what makes js_goeq compare the two parts, so complex(3, 4) == 3+4i holds without
    // a helper of its own. Only '+ - * /' need one, and only a program that actually
    // mentions a complex value gets it - usesComplex is set while the tags WALK, which
    // is finished long before buildMain runs the emit thunks, so a program without
    // complex numbers emits exactly the IR it did before.
    var usesComplex = false
    function emitCxClass(b) { return callExt(b, "js_scope_get", [curScopeV, emitStr(b, "$cxclass")]) }
    function emitNewCx(b, re, im) {
        var o = callExt(b, "js_obj_new", [])
        callExt(b, "js_set", [o, emitStr(b, "__class"), emitCxClass(b)])
        callExt(b, "js_set", [o, emitStr(b, "re"), re])
        callExt(b, "js_set", [o, emitStr(b, "im"), im])
        return o
    }
    function makeImag(v) {
        usesComplex = true
        var iv = v
        return function(b) { return {b: b, v: emitNewCx(b, emitNum(b, 0), emitNum(b, iv))} }
    }
    // {b, re, im}: the two parts of a value that may or may not be complex. A plain
    // number is its own real part with a zero imaginary one.
    function emitCxParts(b, v) {
        var rr = emitSelect(b, callExt(b, "js_is_type", [v, emitStr(b, "$cx")]),
                            function(tb) { return {b: tb, v: callExt(tb, "js_get", [v, emitStr(tb, "re")])} },
                            function(eb) { return {b: eb, v: v} })
        var ri = emitSelect(rr.b, callExt(rr.b, "js_is_type", [v, emitStr(rr.b, "$cx")]),
                            function(tb) { return {b: tb, v: callExt(tb, "js_get", [v, emitStr(tb, "im")])} },
                            function(eb) { return {b: eb, v: emitNum(eb, 0)} })
        return {b: ri.b, re: rr.v, im: ri.v}
    }
    // The complex form of one operator, emitted into its own block. The parts are
    // plain numbers, so the arithmetic goes to the externs DIRECTLY: emitBin would
    // truncate '- * /' to an integer and 0.5 is a legal real part.
    function emitCxOp(b, op, l, r) {
        var lp = emitCxParts(b, l)
        b = lp.b
        var rp = emitCxParts(b, r)
        b = rp.b
        if (op == "+") { return {b: b, v: emitNewCx(b, callExt(b, "js_jadd", [lp.re, rp.re]),
                                                      callExt(b, "js_jadd", [lp.im, rp.im]))} }
        if (op == "-") { return {b: b, v: emitNewCx(b, callExt(b, "js_sub", [lp.re, rp.re]),
                                                      callExt(b, "js_sub", [lp.im, rp.im]))} }
        if (op == "*") {
            var ac = callExt(b, "js_mul", [lp.re, rp.re])
            var bd = callExt(b, "js_mul", [lp.im, rp.im])
            var ad = callExt(b, "js_mul", [lp.re, rp.im])
            var bc = callExt(b, "js_mul", [lp.im, rp.re])
            return {b: b, v: emitNewCx(b, callExt(b, "js_sub", [ac, bd]), callExt(b, "js_jadd", [ad, bc]))}
        }
        var den = callExt(b, "js_jadd", [callExt(b, "js_mul", [rp.re, rp.re]),
                                         callExt(b, "js_mul", [rp.im, rp.im])])
        var nr = callExt(b, "js_jadd", [callExt(b, "js_mul", [lp.re, rp.re]),
                                        callExt(b, "js_mul", [lp.im, rp.im])])
        var ni = callExt(b, "js_sub", [callExt(b, "js_mul", [lp.im, rp.re]),
                                       callExt(b, "js_mul", [lp.re, rp.im])])
        return {b: b, v: emitNewCx(b, callExt(b, "js_div", [nr, den]), callExt(b, "js_div", [ni, den]))}
    }
    // '+ - * /' with a complex operand on either side. The dispatch lives in a
    // GENERATED function rather than at the operator site: emitBin returns a value and
    // cannot move the caller's basic block, so the branch has to happen behind a
    // js_call. The plain form is emitted inside the ELSE block on purpose - the
    // externs would have to cope with a complex operand if it ran eagerly.
    var cxFns = {"+": "$cxadd", "-": "$cxsub", "*": "$cxmul", "/": "$cxdiv",
                 "+=": "$cxadd", "-=": "$cxsub", "*=": "$cxmul", "/=": "$cxdiv"}
    function declCxOp(b, name, op) {
        funcCount++
        var idx = funcCount
        var f = m.NewFunc("jsf_" + idx, i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var savedF = curF
        var savedScope = curScopeV
        curF = f
        var fb = f.NewBlock("entry")
        curScopeV = callExt(fb, "js_scope_new", [f.Params[0]])
        var l = callExt(fb, "js_arg", [f.Params[1], handle(0)])
        var r = callExt(fb, "js_arg", [f.Params[1], handle(1)])
        var isl = callExt(fb, "js_is_type", [l, emitStr(fb, "$cx")])
        var isr = callExt(fb, "js_is_type", [r, emitStr(fb, "$cx")])
        var cxPath = function(cb) { return emitCxOp(cb, op, l, r) }
        var res = emitSelect(fb, isl, cxPath, function(eb) {
            return emitSelect(eb, isr, cxPath, function(e2) { return {b: e2, v: coreEmitBin(e2, op, l, r)} })
        })
        res.b.NewRet(res.v)
        curF = savedF
        curScopeV = savedScope
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, name), callExt(b, "js_closure", [handle(idx), curScopeV])])
        return b
    }
    // real(v) / imag(v) / complex(re, im), each a generated function of its own for
    // the same reason: the complex probe needs blocks.
    function declCxPart(b, name, prop, dflt) {
        funcCount++
        var idx = funcCount
        var f = m.NewFunc("jsf_" + idx, i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var savedF = curF
        var savedScope = curScopeV
        curF = f
        var fb = f.NewBlock("entry")
        curScopeV = callExt(fb, "js_scope_new", [f.Params[0]])
        var v = callExt(fb, "js_arg", [f.Params[1], handle(0)])
        var pr = prop
        var dv = dflt
        var res = emitSelect(fb, callExt(fb, "js_is_type", [v, emitStr(fb, "$cx")]),
                             function(tb) { return {b: tb, v: callExt(tb, "js_get", [v, emitStr(tb, pr)])} },
                             function(eb) { return {b: eb, v: (dv == 0 ? emitNum(eb, 0) : v)} })
        res.b.NewRet(res.v)
        curF = savedF
        curScopeV = savedScope
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, name), callExt(b, "js_closure", [handle(idx), curScopeV])])
        return b
    }
    function declCxMake(b) {
        funcCount++
        var idx = funcCount
        var f = m.NewFunc("jsf_" + idx, i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var savedF = curF
        var savedScope = curScopeV
        curF = f
        var fb = f.NewBlock("entry")
        curScopeV = callExt(fb, "js_scope_new", [f.Params[0]])
        var re = callExt(fb, "js_arg", [f.Params[1], handle(0)])
        var im = callExt(fb, "js_arg", [f.Params[1], handle(1)])
        fb.NewRet(emitNewCx(fb, re, im))
        curF = savedF
        curScopeV = savedScope
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "complex"), callExt(b, "js_closure", [handle(idx), curScopeV])])
        return b
    }
    // The whole complex runtime, declared in jsmain only when the program needs it.
    function declComplex(b) {
        var cls = callExt(b, "js_obj_new", [])
        callExt(b, "js_set", [cls, emitStr(b, "__name"), emitStr(b, "$cx")])
        var flds = callExt(b, "js_arr_new", [])
        callExt(b, "js_arr_push", [flds, emitStr(b, "re")])
        callExt(b, "js_arr_push", [flds, emitStr(b, "im")])
        callExt(b, "js_set", [cls, emitStr(b, "__fields"), flds])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "$cxclass"), cls])
        b = declCxOp(b, "$cxadd", "+")
        b = declCxOp(b, "$cxsub", "-")
        b = declCxOp(b, "$cxmul", "*")
        b = declCxOp(b, "$cxdiv", "/")
        b = declCxPart(b, "real", "re", 1)
        b = declCxPart(b, "imag", "im", 0)
        b = declCxMake(b)
        return b
    }
    function emitCxCall(b, op, l, r) {
        var fV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, cxFns[op])])
        var av = callExt(b, "js_arr_new", [])
        callExt(b, "js_arr_push", [av, l])
        callExt(b, "js_arr_push", [av, r])
        return callExt(b, "js_call", [fV, hUndef, av])
    }

    // ----- Slices and arrays -----
    // Mirrors go-interpreter.abnf: a Go SLICE is a header "$sl" class instance
    // {a, o, n, c} over a backing array (offset, length, capacity) and a Go ARRAY is a
    // plain js array. That is what gives s[1:3] shared storage, cap() an answer of its
    // own and s[:2:3] a meaning; and it needs no marker on the array, which the handle
    // runtime would refuse anyway ("invalid array index").
    //
    // The handle runtime's js_golen / js_goslice / js_goappend externs only know plain
    // arrays, so every slice operation goes through a GENERATED function instead (the
    // externs stay underneath for the array and string cases). declFn builds one; the
    // bodies below are the compiler's twin of the interpreter's slice helpers.
    function declFn(b, name, arity, bodyFn) {
        funcCount++
        var idx = funcCount
        var f = m.NewFunc("jsf_" + idx, i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var savedF = curF
        var savedScope = curScopeV
        curF = f
        var fb = f.NewBlock("entry")
        curScopeV = callExt(fb, "js_scope_new", [f.Params[0]])
        var as = []
        for (var i = 0; i < arity; i++) { as.push(callExt(fb, "js_arg", [f.Params[1], handle(i)])) }
        var res = bodyFn(fb, as, f)
        res.b.NewRet(res.v)
        curF = savedF
        curScopeV = savedScope
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, name), callExt(b, "js_closure", [handle(idx), curScopeV])])
        return b
    }
    // A call of one of those generated functions. Their names live in the jsmain scope,
    // so a nested function reaches them through its scope chain.
    function emitHelper(b, name, argVs) {
        var fV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, name)])
        var av = callExt(b, "js_arr_new", [])
        for (var i = 0; i < argVs.length; i++) { callExt(b, "js_arr_push", [av, argVs[i]]) }
        return callExt(b, "js_call", [fV, hUndef, av])
    }
    // for (i = 0; i < n; i++) with the counter in a scope slot rather than a phi - the
    // same shape makeForClassic emits, and it keeps the loop free of phi placement.
    function emitCountLoop(b, nV, bodyFn) {
        var sc = curScopeV
        var nm = "$i" + loopTmp
        loopTmp++
        callExt(b, "js_scope_decl", [sc, emitStr(b, nm), emitNum(b, 0)])
        var headB = curF.NewBlock("")
        var bodyB = curF.NewBlock("")
        var exitB = curF.NewBlock("")
        b.NewBr(headB)
        var iV = callExt(headB, "js_scope_get", [sc, emitStr(headB, nm)])
        headB.NewCondBr(truthy(headB, callExt(headB, "js_lt", [iV, nV])), bodyB, exitB)
        var iB = callExt(bodyB, "js_scope_get", [sc, emitStr(bodyB, nm)])
        var endB = bodyFn(bodyB, iB)
        var iE = callExt(endB, "js_scope_get", [sc, emitStr(endB, nm)])
        callExt(endB, "js_scope_set", [sc, emitStr(endB, nm), callExt(endB, "js_jadd", [iE, emitNum(endB, 1)])])
        endB.NewBr(headB)
        return exitB
    }
    var loopTmp = 0
    function emitIsSl(b, v) { return callExt(b, "js_is_type", [v, emitStr(b, "$sl")]) }
    function emitSlHdr(b, a, o, n, c) {
        var h = callExt(b, "js_obj_new", [])
        callExt(b, "js_set", [h, emitStr(b, "__class"), callExt(b, "js_scope_get", [curScopeV, emitStr(b, "$slclass")])])
        callExt(b, "js_set", [h, emitStr(b, "a"), a])
        callExt(b, "js_set", [h, emitStr(b, "o"), o])
        callExt(b, "js_set", [h, emitStr(b, "n"), n])
        callExt(b, "js_set", [h, emitStr(b, "c"), c])
        return h
    }
    function slF(b, h, k) { return callExt(b, "js_get", [h, emitStr(b, k)]) }
    // A fresh backing array wrapped as a slice over the whole of it.
    function emitSlOf(b, arr) {
        var n = callExt(b, "js_golen", [arr])
        return emitSlHdr(b, arr, emitNum(b, 0), n, n)
    }
    // The whole slice runtime, declared in jsmain before the program runs.
    function declSlices(b) {
        var cls = callExt(b, "js_obj_new", [])
        callExt(b, "js_set", [cls, emitStr(b, "__name"), emitStr(b, "$sl")])
        var sflds = callExt(b, "js_arr_new", [])
        callExt(b, "js_arr_push", [sflds, emitStr(b, "a")])
        callExt(b, "js_arr_push", [sflds, emitStr(b, "o")])
        callExt(b, "js_arr_push", [sflds, emitStr(b, "n")])
        callExt(b, "js_arr_push", [sflds, emitStr(b, "c")])
        callExt(b, "js_set", [cls, emitStr(b, "__fields"), sflds])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "$slclass"), cls])

        // len(x) / cap(x): a header answers from its own fields, everything else - an
        // array, a string, a map, nil - goes to js_golen.
        b = declFn(b, "len", 1, function(fb, a) {
            var x = a[0]
            return emitSelect(fb, emitIsSl(fb, x),
                              function(tb) { return {b: tb, v: slF(tb, x, "n")} },
                              function(eb) { return {b: eb, v: callExt(eb, "js_golen", [x])} })
        })
        b = declFn(b, "cap", 1, function(fb, a) {
            var x = a[0]
            return emitSelect(fb, emitIsSl(fb, x),
                              function(tb) { return {b: tb, v: slF(tb, x, "c")} },
                              function(eb) { return {b: eb, v: callExt(eb, "js_golen", [x])} })
        })
        // x[i] and x[i] = v, both of which have to reach through a header's offset.
        b = declFn(b, "$sidx", 2, function(fb, a) {
            var x = a[0]
            var i = a[1]
            return emitSelect(fb, emitIsSl(fb, x),
                              function(tb) {
                                  return {b: tb, v: callExt(tb, "js_map_get",
                                          [slF(tb, x, "a"), callExt(tb, "js_jadd", [slF(tb, x, "o"), i])])}
                              },
                              function(eb) { return {b: eb, v: callExt(eb, "js_map_get", [x, i])} })
        })
        b = declFn(b, "$sset", 3, function(fb, a) {
            var x = a[0]
            var i = a[1]
            var v = a[2]
            return emitSelect(fb, emitIsSl(fb, x),
                              function(tb) {
                                  callExt(tb, "js_pyset", [slF(tb, x, "a"),
                                          callExt(tb, "js_jadd", [slF(tb, x, "o"), i]), v])
                                  return {b: tb, v: v}
                              },
                              function(eb) { callExt(eb, "js_pyset", [x, i, v]); return {b: eb, v: v} })
        })
        // The elements of a slice as a PLAIN array - what range, the ... spread,
        // string(bs) and printing want. Anything else passes through untouched.
        b = declFn(b, "$sels", 1, function(fb, a) {
            var x = a[0]
            return emitSelect(fb, emitIsSl(fb, x), function(tb) {
                var out = callExt(tb, "js_arr_new", [])
                var base = slF(tb, x, "a")
                var off = slF(tb, x, "o")
                var eb2 = emitCountLoop(tb, slF(tb, x, "n"), function(lb, iV) {
                    callExt(lb, "js_arr_push", [out, callExt(lb, "js_map_get",
                            [base, callExt(lb, "js_jadd", [off, iV])])])
                    return lb
                })
                return {b: eb2, v: out}
            }, function(eb) { return {b: eb, v: x} })
        })
        // x[lo:hi:mx] - a new header into the SAME backing array. A string slices with
        // the extern (it is a byte range and copies, exactly as in the interpreter).
        b = declFn(b, "$sslice", 4, function(fb, a) {
            var x = a[0]
            var lo = a[1]
            var hi = a[2]
            var mx = a[3]
            return emitSelect(fb, callExt(fb, "js_seq", [callExt(fb, "js_typeof", [x]), emitStr(fb, "string")]),
                function(sb) { return {b: sb, v: callExt(sb, "js_goslice", [x, lo, hi])} },
                function(ab) {
                    var isSlV = emitIsSl(ab, x)
                    var pa = emitSelect(ab, isSlV, function(tb) { return {b: tb, v: slF(tb, x, "a")} },
                                                   function(eb) { return {b: eb, v: x} })
                    var po = emitSelect(pa.b, isSlV, function(tb) { return {b: tb, v: slF(tb, x, "o")} },
                                                     function(eb) { return {b: eb, v: emitNum(eb, 0)} })
                    var pn = emitSelect(po.b, isSlV, function(tb) { return {b: tb, v: slF(tb, x, "n")} },
                                                     function(eb) { return {b: eb, v: callExt(eb, "js_golen", [x])} })
                    var pc = emitSelect(pn.b, isSlV, function(tb) { return {b: tb, v: slF(tb, x, "c")} },
                                                     function(eb) { return {b: eb, v: callExt(eb, "js_golen", [x])} })
                    var b2 = pc.b
                    var rlo = emitSelect(b2, callExt(b2, "js_seq", [lo, hUndef]),
                                         function(tb) { return {b: tb, v: emitNum(tb, 0)} },
                                         function(eb) { return {b: eb, v: lo} })
                    var rhi = emitSelect(rlo.b, callExt(rlo.b, "js_seq", [hi, hUndef]),
                                         function(tb) { return {b: tb, v: pn.v} },
                                         function(eb) { return {b: eb, v: hi} })
                    var rmx = emitSelect(rhi.b, callExt(rhi.b, "js_seq", [mx, hUndef]),
                                         function(tb) { return {b: tb, v: pc.v} },
                                         function(eb) { return {b: eb, v: mx} })
                    var b3 = rmx.b
                    return {b: b3, v: emitSlHdr(b3, pa.v,
                                                callExt(b3, "js_jadd", [po.v, rlo.v]),
                                                callExt(b3, "js_sub", [rhi.v, rlo.v]),
                                                callExt(b3, "js_sub", [rmx.v, rlo.v]))}
                })
        })
        // make([]T, n, cap): cap zero values of the element type, length n over them.
        b = declFn(b, "$smake", 3, function(fb, a) {
            var n = a[0]
            var cp = a[1]
            var zero = a[2]
            var arr = callExt(fb, "js_arr_new", [])
            var eb = emitCountLoop(fb, cp, function(lb, iV) {
                callExt(lb, "js_arr_push", [arr, zero])
                return lb
