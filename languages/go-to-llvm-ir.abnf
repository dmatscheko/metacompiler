    // fresh one slot scope, so that *q += 3 has somewhere to write. The type is known
    // here, so the choice is made at emit time.
    function isScalarTy(t) {
        return t.indexOf("int") == 0 || t.indexOf("uint") == 0 || t.indexOf("float") == 0
            || t.indexOf("byte") == 0 || t.indexOf("rune") == 0
            || t.indexOf("string") == 0 || t.indexOf("bool") == 0
