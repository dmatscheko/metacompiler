    // externs stay underneath for the array and string cases). declFn builds one; the
    // bodies below are the compiler's twin of the interpreter's slice helpers.
    function declFn(b, name, arity, bodyFn) {
        funcCount++
        var idx = funcCount
        var f = m.NewFunc("jsf_" + idx, i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var savedF = curF
        var savedScope = curScopeV
        curF = f
