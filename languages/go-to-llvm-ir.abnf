// Call covers only the 'Id(args)' form, so without this suffix a call on any other
// expression does not parse at all.
CallSfx     <~~ push(makeCallSfx(takeAll())) ~~>
            = "(" [ ArgExpr { "," ArgExpr } [ Spread ] [ "," ] ] ")" ;
MethodSfx   <~~ push(makeMethodSfx(popName(), takeAll(), up.start)) ~~>
            = "." Id <~~ push({mname: up.in}) ~~> "(" [ ArgExpr { "," ArgExpr } [ Spread ] [ "," ] ] ")" ;
FieldSfx    <~~ push({kind: "field", name: pop().fname, at: up.start, rc: null}) ~~>
            = "." Id <~~ push({fname: up.in}) ~~> ;
IndexSfx    <~~ var ikm = pop(); push({kind:"index", idx: pop(), ksty: ikm.ksty, kk: ikm.kr, at: up.start, rc: null}) ~~>
            = "[" IdxE "]" ;
