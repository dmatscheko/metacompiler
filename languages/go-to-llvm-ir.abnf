            // "[]T" is a SLICE and starts empty; arrLen answers 0 for it (no digits
            // between the brackets), which is why the length has to be told apart
            // from the kind here rather than from arrLen's count alone.
            if (t.charCodeAt(1) == 93) { return emitSlT(b, emitSlOf(b, callExt(b, "js_arr_new", [])), el) }
            var n = arrLen(t)
            if (n < 0) { return emitSlT(b, emitSlOf(b, callExt(b, "js_arr_new", [])), el) }
            var arr = callExt(b, "js_arr_new", [])
            for (var i = 0; i < n; i++) { callExt(b, "js_arr_push", [arr, emitZeroTy(b, el)]) }
            return arr
