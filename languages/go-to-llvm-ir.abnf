// `type G [][]int; G{{1, 2}}`, and `Config{{1, 2}}` for a struct whose first field is
// a composite. It cannot be confused with the other two: no Go expression starts
// with '{', so this only takes work away from CompLitNI.
LitElem     = KeyedElem | SeqNest | LitExpr ;
// A KEYED element's key is an EXPRESSION, not just an Id - which is what a literal of
// a DEFINED MAP TYPE needs: `type M map[string]int; M{"a": 1}` goes through StructLit
// (the type is a bare name). Both readings are kept on the record: `fkey` is the
// field NAME for a struct target, `fkeyT` the key thunk for a map one - the
// {ckey, ktext} pair go-interpreter.abnf's CompKey pushes. The KeyAhead guard decides
// before anything is pushed, so an unkeyed element leaks nothing onto the value stack.
KeyedElem   = KeyAhead LitKey ":" LitVal ;
// A KEY may also be a bare BRACE GROUP, which is what a struct-keyed literal of a
// DEFINED map type is written with: `type Named map[Pair]string; Named{{1, 2}: "p"}`.
// (MapKey is the same feature on the literal-type path, `map[Pair]string{{1, 2}: "p"}`;
// this rule is the named-type one, which goes through StructLit because the type is a
// bare name.) No Go expression starts with '{', so the group is disjoint from
// Expression and the ordered choice cannot strand a later alternative.
LitKey      <~~ push({fkey: firstWord(up.in), fkeyT: pop(), ksty: goLitKeySty(stAt(up.pos))})
                if (up.in.charAt(0) != "{") { goLitEl(up.start, up.pos, true, firstWord(up.in)) } ~~> = SeqNest | Expression ;
LitVal      = SeqNest | LitExpr ;
// An element expression reports its static type in a {lesty} marker after it, which
// a field of interface type boxes it by (litSplit, emitStructVal).
LitExpr     <~~ var le = pop(); push(le); push({lesty: goLitEsty(up.pos), pu: goPure(up.start, up.pos)}); goLitEl(up.start, up.pos, false, "") ~~> = Expression ;

// f(a, b): a function or a builtin. A trailing '...' spreads a slice into the
// variadic parameter.
Call        <~~ var ci = goAppendC(takeAll(), up.in); push(makeCall(goCallBoxC(ci), goSplitArgs(ci.slice(1)).atys)); goLenConstC(ci, up.start, up.pos) ~~>
            = Id <~~ push(up.in) ~~> "(" [ ArgExpr { "," ArgExpr } [ Spread ] [ "," ] ] ")" ;
// A call argument reports its static type after it, for goSplitArgs.
ArgExpr     <~~ var ae = pop(); push(goRuneDefC(ae, up.pos)); push({aty: stAt(up.pos), kr: goKRec(up.start, up.pos), pu: goPure(up.start, up.pos)}) ~~> = Expression ;
// A returned value, which takes a rune constant at the RESULT's type (makeReturn).
RetExpr     <~~ var re = pop(); push(re); push({aty: stAt(up.pos), rn: goIsRuneC(up.pos), kr: goKRec(up.start, up.pos), pu: goPure(up.start, up.pos)}) ~~> = Expression ;

VarRef      <~~ push(goNameC(up.in, up.pos)) ~~>
            = Id ;

// The composite literal gate: while an if/for header is being parsed (CondOn pushed
// a marker on the parser stack), StructGate fails, so 'if ok {' never starts a literal.
CondOn = :script(~~
    push("$nostruct")
    undefined
~~) ;
CondOff = :script(~~
    (function() {
        // Pop down to THIS header's own marker, so a parenthesised group that failed
        // half way (see ParenGroup) cannot leave the gate stack out of step.
        var t = pop()
        while (t != null && t != "$nostruct") { t = pop() }
        return undefined
    })()
~~) ;
// InitAhead answers "does this if/switch header carry an init statement?" - i.e. is
// there a ';' before the body's '{' at bracket depth 0. Without it the optional init
// would be ATTEMPTED on a plain header, and its half-parsed pushes are not rolled
// back (see the CondOn note above). TypeSwAhead is the same shape for '.(type)'.
// Both are pure functions of (source, position): they only ever read with c.peek.
InitAhead = :script(~~
    (function () {
        var i = 0
        var depth = 0
        var cc = 0
        while (i < 8192) {
            cc = c.peek(i)
            if (cc < 0) { break }
            if (cc === 34 || cc === 39 || cc === 96) {       // " ' `
                var q = cc
                i++
                while (i < 8192) {
                    var d = c.peek(i)
                    if (d < 0 || d === q) { break }
                    if (d === 92 && q !== 96) { i++ }
                    i++
                }
                i++
                continue
            }
            if (cc === 47 && c.peek(i + 1) === 47) {          // // comment
                while (i < 8192 && c.peek(i) >= 0 && c.peek(i) !== 10) { i++ }
                continue
            }
            if (cc === 47 && c.peek(i + 1) === 42) {          // /* comment
                i += 2
                while (i < 8192 && c.peek(i) >= 0 && !(c.peek(i) === 42 && c.peek(i + 1) === 47)) { i++ }
                i += 2
                continue
            }
            if (cc === 40 || cc === 91) { depth++ }
            if (cc === 41 || cc === 93) { depth-- }
            if (depth === 0 && cc === 59) { return undefined }
            if (depth === 0 && (cc === 123 || cc === 125)) { break }
            i++
        }
        return abnf.newToken("\x01no-header-init", 0)
    })()
~~) ;
// TypeSwAhead answers "is this switch a TYPE switch?" - i.e. does a '.(type)' come
// before the body's '{' at bracket depth 0. Without it the type-switch alternative
// would be ATTEMPTED on every switch, and its half-parsed pushes are not rolled back
// (see the CondOn note above). It is a pure function of (source, position): it only
// ever reads with c.peek.
TypeSwAhead = :script(~~
    (function () {
        var i = 0
        var depth = 0
        var cc = 0
        while (i < 8192) {
            cc = c.peek(i)
            if (cc < 0) { break }
            if (cc === 34 || cc === 39 || cc === 96) {       // " ' `
                var q = cc
                i++
                while (i < 8192) {
                    var d = c.peek(i)
                    if (d < 0 || d === q) { break }
                    if (d === 92 && q !== 96) { i++ }
                    i++
                }
                i++
                continue
            }
            if (cc === 47 && c.peek(i + 1) === 47) {          // // comment
                while (i < 8192 && c.peek(i) >= 0 && c.peek(i) !== 10) { i++ }
                continue
            }
            if (cc === 47 && c.peek(i + 1) === 42) {          // /* comment
                i += 2
                while (i < 8192 && c.peek(i) >= 0 && !(c.peek(i) === 42 && c.peek(i + 1) === 47)) { i++ }
                i += 2
                continue
            }
            if (cc === 46 && c.peek(i + 1) === 40 && c.peek(i + 2) === 116 && c.peek(i + 3) === 121
                && c.peek(i + 4) === 112 && c.peek(i + 5) === 101 && c.peek(i + 6) === 41) {
                return undefined
            }
            if (cc === 40 || cc === 91) { depth++ }
            if (cc === 41 || cc === 93) { depth-- }
            if (depth === 0 && (cc === 123 || cc === 125)) { break }
            i++
        }
