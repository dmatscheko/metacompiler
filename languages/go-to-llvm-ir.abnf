        var nm = "$i" + loopTmp
        loopTmp++
        callExt(b, "js_scope_decl", [sc, emitStr(b, nm), emitNum(b, 0)])
        var headB = curF.NewBlock("")
        var bodyB = curF.NewBlock("")
        var exitB = curF.NewBlock("")
