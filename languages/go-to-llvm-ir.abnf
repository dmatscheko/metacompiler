// after the 0x/0o/0b forms and before the decimal ones, and it needs at least one
// octal digit after the 0 so that a plain "0" stays an integer literal.
LegOctLit   <~~ push(goIntLitLegOct(up.in)) ~~>
            = "0" :whitespace() OctSep { OctSep } :whitespace(Whitespace) ;
// A named production on purpose: a :command() directly followed by a (group) parses
// as a Times repetition in this dialect - the Times trap.
OctSep      = "0"..."7" | "_" ;
FloatLit    <~~ push(makeFloConst(parseFloat(up.in))) ~~>
            = ( "0" | "1"..."9" ) :whitespace() { "0"..."9" }
              ( "." { "0"..."9" } [ ( "e" | "E" ) [ "+" | "-" ] "0"..."9" { "0"..."9" } ]
              | ( "e" | "E" ) [ "+" | "-" ] "0"..."9" { "0"..."9" } ) :whitespace(Whitespace) ;
HexLit      <~~ push(goIntLit(up.in)) ~~>
            = "0" ( "x" | "X" ) :whitespace() HexDigits :whitespace(Whitespace) ;
// Go allows the digit separator right after the base prefix, too: 0x_FF_f.
HexDigits   = { "_" } HexDigit { HexDigit | "_" } ;
HexDigit    = "0"..."9" | "a"..."f" | "A"..."F" ;
OctLit      <~~ push(goIntLit(up.in)) ~~>
            = "0" ( "o" | "O" ) :whitespace() "0"..."7" { "0"..."7" | "_" } :whitespace(Whitespace) ;
BinLit      <~~ push(goIntLit(up.in)) ~~>
            = "0" ( "b" | "B" ) :whitespace() BinDigits :whitespace(Whitespace) ;
BinDigits   = BinDigit { BinDigit | "_" } ;
BinDigit    = "0" | "1" ;
DecULit     <~~ push(goIntLit(up.in)) ~~>
            = ( "0" | "1"..."9" ) :whitespace() { "0"..."9" } "_" { "0"..."9" | "_" } :whitespace(Whitespace) ;
