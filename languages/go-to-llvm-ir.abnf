    // each is a generated function that maps its arguments through $sels first.
    function declPrint(b, fmtV, name, base) {
        funcCount++
        var idx = funcCount
        var f = m.NewFunc("jsf_" + idx, i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var savedF = curF
        var savedScope = curScopeV
        curF = f
        var fb = f.NewBlock("entry")
        curScopeV = callExt(fb, "js_scope_new", [f.Params[0]])
        var argsV = f.Params[1]
        var eb = emitCountLoop(fb, callExt(fb, "js_golen", [argsV]), function(lb, iV) {
