    var cxOps = {"+": 1, "-": 1, "*": 1, "/": 1, "+=": 1, "-=": 1, "*=": 1, "/=": 1}
    // ^x is 'x XOR -1'. On an unsigned operand of known width Go complements WITHIN
    // that width, so ^uint8(0xF0) is 0x0F and not -241.
    // items = [operandThunk, {at}].
    function makeCompl(items) {
