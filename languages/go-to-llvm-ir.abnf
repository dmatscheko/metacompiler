    // items = [{params}, bodyT] (an ignored RetTypes leaves no stack entry). The
    // literal becomes an own IR function closed over the current scope (js_closure).
    // items = [{params}, {rets}?, bodyT]: an unnamed RetTypes leaves no stack entry.
    function makeFuncLit(items) {
        var params = items[0]
        var i = 1
        var rets = []
        if (items[i] != undefined && items[i].rets != undefined) { rets = items[i].rets; i++ }
        var bodyT = items[i]
        return function(b) {
            var idx = emitFunc(params, bodyT, null, rets)
            return {b: b, v: callExt(b, "js_closure", [handle(idx), curScopeV])}
