    // A call of one of those generated functions. Their names live in the jsmain scope,
    // so a nested function reaches them through its scope chain.
    function emitHelper(b, name, argVs) {
        var fV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, name)])
        var av = callExt(b, "js_arr_new", [])
        for (var i = 0; i < argVs.length; i++) { callExt(b, "js_arr_push", [av, argVs[i]]) }
        return callExt(b, "js_call", [fV, hUndef, av])
