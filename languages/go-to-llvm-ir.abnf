// type. Go reads '(*X)(y)' as a conversion too, so this does not take anything away from
// a call through a parenthesized expression; '(*p).f' still falls through, because the
// '(' this rule needs after the type is a '.' there.
PtrTypeT    = "*" Type ;
// IfaceTypeT is here so that the UNPARENTHESIZED `interface{}(x)` is read as the
// conversion it is; otherwise CompLitNI's CompName matches the bare identifier
// `interface` and its SkipBlock eats the `{}`.
ConvType    <~~ push({conv: firstType(up.in)}) ~~>
            = "[" "]" Type | ArrayTypeT | MapTypeT | ChanTypeT | IfaceTypeT | "any" KwEnd | "error" KwEnd | ScalarType KwEnd ;
ScalarType  = "uintptr" | "float32" | "float64" | "uint16" | "uint32" | "uint64"
            | "int16" | "int32" | "int64" | "uint8" | "int8" | "byte" | "rune"
            | "uint" | "int" ;

// nil is the null value (structs, slices, maps and pointers share one). Tried before
// VarRef so it is not read as an undefined identifier.
Nil         <~~ push(makeConst(null)) ~~> = "nil" KwEnd ;

// Go literal forms the shared token library does not carry. A float literal needs a
// fraction or an exponent (a plain integer keeps going through IntLit); hex/octal/binary
// literals and digit-group underscores parse to their integer value; a raw string keeps
// its bytes verbatim; a rune literal is its first code point (an int).
// 2i / 2.5i / 1e3i: an IMAGINARY literal, so the value is complex. Tried before every
// other numeric form - all of them match its digits and would leave the 'i' behind as
// an identifier. The KwEnd keeps it off the front of a name (2int is not 2i).
ImagLit     <~~ push(goImagLitC(up.in, up.pos)) ~~>
