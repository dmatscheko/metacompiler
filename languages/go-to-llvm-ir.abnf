    function declSlices(b) {
        var cls = callExt(b, "js_obj_new", [])
        callExt(b, "js_set", [cls, emitStr(b, "__name"), emitStr(b, "$sl")])
        var sflds = callExt(b, "js_arr_new", [])
        callExt(b, "js_arr_push", [sflds, emitStr(b, "a")])
        callExt(b, "js_arr_push", [sflds, emitStr(b, "o")])
        callExt(b, "js_arr_push", [sflds, emitStr(b, "n")])
        callExt(b, "js_arr_push", [sflds, emitStr(b, "c")])
        callExt(b, "js_set", [cls, emitStr(b, "__fields"), sflds])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "$slclass"), cls])

        // len(x) / cap(x): a header answers from its own fields, everything else - an
        // array, a string, a map, nil - goes to js_golen.
        // A POINTER TO AN ARRAY measures, indexes, slices and ranges as the array
        // itself - len(p), p[0], p[:], `for range p` are all legal Go on a *[N]T. The
        // six shared bodies below are the whole funnel for those operations, so one
        // deref at the top of each is the whole feature; a cell is the only thing
        // emitDerefV reaches through, so slices, maps and structs are untouched. Keep
        // in step with goIndex/goSetAt/goLen/goCap in go-interpreter.abnf.
        b = declFn(b, "len", 1, function(fb, a) {
            var rd = emitDerefV(fb, a[0])
            fb = rd.b
            var x = rd.v
            return emitSelect(fb, emitIsSl(fb, x),
                              function(tb) { return {b: tb, v: slF(tb, x, "n")} },
                              function(eb) { return {b: eb, v: callExt(eb, "js_golen", [x])} })
        })
        b = declFn(b, "cap", 1, function(fb, a) {
            var rd = emitDerefV(fb, a[0])
            fb = rd.b
            var x = rd.v
            return emitSelect(fb, emitIsSl(fb, x),
                              function(tb) { return {b: tb, v: slF(tb, x, "c")} },
                              function(eb) { return {b: eb, v: callExt(eb, "js_golen", [x])} })
        })
        // x[i] and x[i] = v, both of which have to reach through a header's offset.
        b = declFn(b, "$sidx", 2, function(fb, a) {
            var rd = emitDerefV(fb, a[0])
            fb = rd.b
            var x = rd.v
            var i = a[1]
            return emitSelect(fb, emitIsSl(fb, x),
                              function(tb) {
                                  return {b: tb, v: callExt(tb, "js_map_get",
                                          [slF(tb, x, "a"), callExt(tb, "js_jadd", [slF(tb, x, "o"), i])])}
                              },
                              function(eb) { return {b: eb, v: callExt(eb, "js_map_get", [x, i])} })
        })
        b = declFn(b, "$sset", 3, function(fb, a) {
            var rd = emitDerefV(fb, a[0])
            fb = rd.b
            var x = rd.v
            var i = a[1]
            var v = a[2]
            return emitSelect(fb, emitIsSl(fb, x),
                              function(tb) {
                                  // One extern: js_gisetsl does the offset, the
                                  // width and the store (see abnf/jsrtgolang.go).
                                  callExt(tb, "js_gisetsl", [x, i, v])
                                  return {b: tb, v: v}
                              },
                              function(eb) { callExt(eb, "js_gisetat", [x, i, v]); return {b: eb, v: v} })
        })
        // The elements of a slice as a PLAIN array - what range, the ... spread,
        // string(bs) and printing want. Anything else passes through untouched.
        b = declFn(b, "$sels", 1, function(fb, a) {
            var rd = emitDerefV(fb, a[0])
            fb = rd.b
            var x = rd.v
            return emitSelect(fb, emitIsSl(fb, x), function(tb) {
                var out = callExt(tb, "js_arr_new", [])
                var base = slF(tb, x, "a")
                var off = slF(tb, x, "o")
                var eb2 = emitCountLoop(tb, slF(tb, x, "n"), function(lb, iV) {
                    callExt(lb, "js_arr_push", [out, callExt(lb, "js_map_get",
                            [base, callExt(lb, "js_jadd", [off, iV])])])
                    return lb
                })
                return {b: eb2, v: out}
            }, function(eb) { return {b: eb, v: x} })
        })
        // x[lo:hi:mx] - a new header into the SAME backing array. A string slices with
        // the extern (it is a byte range and copies, exactly as in the interpreter).
        b = declFn(b, "$sslice", 4, function(fb, a) {
            var rd = emitDerefV(fb, a[0])
            fb = rd.b
            var x = rd.v
            var lo = a[1]
            var hi = a[2]
            var mx = a[3]
            return emitSelect(fb, callExt(fb, "js_seq", [callExt(fb, "js_typeof", [x]), emitStr(fb, "string")]),
                function(sb) { return {b: sb, v: callExt(sb, "js_goslice", [x, lo, hi])} },
                function(ab) {
                    var isSlV = emitIsSl(ab, x)
                    var pa = emitSelect(ab, isSlV, function(tb) { return {b: tb, v: slF(tb, x, "a")} },
                                                   function(eb) { return {b: eb, v: x} })
                    var po = emitSelect(pa.b, isSlV, function(tb) { return {b: tb, v: slF(tb, x, "o")} },
                                                     function(eb) { return {b: eb, v: emitNum(eb, 0)} })
                    var pn = emitSelect(po.b, isSlV, function(tb) { return {b: tb, v: slF(tb, x, "n")} },
                                                     function(eb) { return {b: eb, v: callExt(eb, "js_golen", [x])} })
                    var pc = emitSelect(pn.b, isSlV, function(tb) { return {b: tb, v: slF(tb, x, "c")} },
                                                     function(eb) { return {b: eb, v: callExt(eb, "js_golen", [x])} })
                    var b2 = pc.b
                    var rlo = emitSelect(b2, callExt(b2, "js_seq", [lo, hUndef]),
                                         function(tb) { return {b: tb, v: emitNum(tb, 0)} },
                                         function(eb) { return {b: eb, v: lo} })
                    var rhi = emitSelect(rlo.b, callExt(rlo.b, "js_seq", [hi, hUndef]),
                                         function(tb) { return {b: tb, v: pn.v} },
                                         function(eb) { return {b: eb, v: hi} })
                    var rmx = emitSelect(rhi.b, callExt(rhi.b, "js_seq", [mx, hUndef]),
                                         function(tb) { return {b: tb, v: pc.v} },
                                         function(eb) { return {b: eb, v: mx} })
                    var b3 = rmx.b
                    var outH = emitSlHdr(b3, pa.v,
                                         callExt(b3, "js_jadd", [po.v, rlo.v]),
                                         callExt(b3, "js_sub", [rhi.v, rlo.v]),
                                         callExt(b3, "js_sub", [rmx.v, rlo.v]))
                    callExt(b3, "js_set", [outH, emitStr(b3, "et"), callExt(b3, "js_get", [x, emitStr(b3, "et")])])
                    return {b: b3, v: outH}
                })
        })
        // make([]T, n, cap): cap zero values of the element type, length n over them.
        b = declFn(b, "$smake", 4, function(fb, a) {
            var n = a[0]
            var cp = a[1]
            var zero = a[2]
            var et = a[3]
            var arr = callExt(fb, "js_arr_new", [])
            var eb = emitCountLoop(fb, cp, function(lb, iV) {
                callExt(lb, "js_arr_push", [arr, zero])
                return lb
            })
            var outH = emitSlHdr(eb, arr, emitNum(eb, 0), n, cp)
            callExt(eb, "js_set", [outH, emitStr(eb, "et"), et])
            return {b: eb, v: outH}
        })
        // append(s, v...): writes into the backing array when the capacity allows (so
        // another slice over it sees the new element, like Go) and reallocates when not.
        b = declFn(b, "append", 0, function(fb, a, f) {
            var argsV = f.Params[1]
            var s0 = callExt(fb, "js_arg", [argsV, handle(0)])
            var add = callExt(fb, "js_sub", [callExt(fb, "js_golen", [argsV]), emitNum(fb, 1)])
            var isSlV = emitIsSl(fb, s0)
            // A nil slice starts a new backing array; a plain array is its own backing.
            var baseR = emitSelect(fb, callExt(fb, "js_not", [s0]),
                                   function(tb) { return {b: tb, v: callExt(tb, "js_arr_new", [])} },
                                   function(eb) { return {b: eb, v: s0} })
            var b2 = baseR.b
            var ha = emitSelect(b2, isSlV, function(tb) { return {b: tb, v: slF(tb, s0, "a")} },
                                           function(eb) { return {b: eb, v: baseR.v} })
            var ho = emitSelect(ha.b, isSlV, function(tb) { return {b: tb, v: slF(tb, s0, "o")} },
                                             function(eb) { return {b: eb, v: emitNum(eb, 0)} })
            var hn = emitSelect(ho.b, isSlV, function(tb) { return {b: tb, v: slF(tb, s0, "n")} },
                                             function(eb) { return {b: eb, v: callExt(eb, "js_golen", [baseR.v])} })
            var hc = emitSelect(hn.b, isSlV, function(tb) { return {b: tb, v: slF(tb, s0, "c")} },
                                             function(eb) { return {b: eb, v: callExt(eb, "js_golen", [baseR.v])} })
            var b3 = hc.b
            var need = callExt(b3, "js_jadd", [hn.v, add])
            // {a, o, c} of the array the result writes into, as a three element array.
            var grown = emitSelect(b3, callExt(b3, "js_gt", [need, hc.v]), function(tb) {
                var na = callExt(tb, "js_arr_new", [])
                var eb2 = emitCountLoop(tb, hn.v, function(lb, iV) {
                    callExt(lb, "js_arr_push", [na, callExt(lb, "js_map_get",
                            [ha.v, callExt(lb, "js_jadd", [ho.v, iV])])])
                    return lb
                })
                var etZ = emitSelect(eb2, isSlV, function(tb) { return {b: tb, v: slF(tb, s0, "et")} },
                                                 function(eb) { return {b: eb, v: hUndef} })
                var eb3 = emitCountLoop(etZ.b, add, function(lb, iV) {
                    callExt(lb, "js_arr_push", [na, callExt(lb, "js_giadopt", [etZ.v, emitNum(lb, 0)])])
                    return lb
                })
                var trip = callExt(eb3, "js_arr_new", [])
                callExt(eb3, "js_arr_push", [trip, na])
                callExt(eb3, "js_arr_push", [trip, emitNum(eb3, 0)])
                callExt(eb3, "js_arr_push", [trip, need])
                return {b: eb3, v: trip}
            }, function(eb) {
                var trip = callExt(eb, "js_arr_new", [])
                callExt(eb, "js_arr_push", [trip, ha.v])
                callExt(eb, "js_arr_push", [trip, ho.v])
                callExt(eb, "js_arr_push", [trip, hc.v])
                return {b: eb, v: trip}
            })
            var b4 = grown.b
            var ra = callExt(b4, "js_map_get", [grown.v, emitNum(b4, 0)])
            var ro = callExt(b4, "js_map_get", [grown.v, emitNum(b4, 1)])
            var rc = callExt(b4, "js_map_get", [grown.v, emitNum(b4, 2)])
            // The element type is not written at an append site, so it comes off the
            // header: `var bs []uint8` is EMPTY, and an empty slice has no element to
            // take a width from. js_giadopt is the identity when there is no "et".
            var etV = emitSelect(b4, isSlV, function(tb) { return {b: tb, v: slF(tb, s0, "et")} },
                                            function(eb) { return {b: eb, v: hUndef} })
            var b4b = etV.b
            var b5 = emitCountLoop(b4b, add, function(lb, iV) {
                callExt(lb, "js_gisetat", [ra, callExt(lb, "js_jadd", [callExt(lb, "js_jadd", [ro, hn.v]), iV]),
                                         callExt(lb, "js_giadopt", [etV.v,
                                             callExt(lb, "js_map_get", [argsV, callExt(lb, "js_jadd", [iV, emitNum(lb, 1)])])])])
                return lb
            })
            var outH = emitSlHdr(b5, ra, ro, need, rc)
            callExt(b5, "js_set", [outH, emitStr(b5, "et"), etV.v])
            return {b: b5, v: outH}
        })
        // copy(dst, src): as many elements as the shorter one holds.
        b = declFn(b, "copy", 2, function(fb, a) {
            var d = a[0]
            var sc2 = a[1]
            var dn = emitHelper(fb, "len", [d])
            var sn = emitHelper(fb, "len", [sc2])
            var nr = emitSelect(fb, callExt(fb, "js_lt", [dn, sn]),
                                function(tb) { return {b: tb, v: dn} },
                                function(eb) { return {b: eb, v: sn} })
            var eb3 = emitCountLoop(nr.b, nr.v, function(lb, iV) {
                emitHelper(lb, "$sset", [d, iV, emitHelper(lb, "$sidx", [sc2, iV])])
                return lb
            })
            return {b: eb3, v: nr.v}
        })
        // clear(m) empties a map; clear(s) zeroes a slice's elements in place.
        b = declFn(b, "clear", 0, function(fb, a, f) {
            var argsV = f.Params[1]
            var x = callExt(fb, "js_arg", [argsV, handle(0)])
            return emitSelect(fb, emitIsSl(fb, x), function(tb) {
                var eb2 = emitCountLoop(tb, slF(tb, x, "n"), function(lb, iV) {
                    emitHelper(lb, "$sset", [x, iV, emitNum(lb, 0)])
                    return lb
                })
                return {b: eb2, v: hUndef}
            }, function(eb) { callExt(eb, "js_goclear", [argsV]); return {b: eb, v: hUndef} })
        })
        // A Go ARRAY is a value: assigning it copies, and the copy is deep because an
        // element that is itself an array is a value too. A header, map or struct
        // passes through.
        b = declFn(b, "$acopy", 1, function(fb, a) {
            var x = a[0]
            return emitSelect(fb, callExt(fb, "js_gotypeis", [x, emitStr(fb, "slice")]), function(pb) {
                var out = callExt(pb, "js_arr_new", [])
                var eb2 = emitCountLoop(pb, callExt(pb, "js_golen", [x]), function(lb, iV) {
                    callExt(lb, "js_arr_push", [out, emitHelper(lb, "$acopy",
                            [callExt(lb, "js_map_get", [x, iV])])])
                    return lb
                })
                return {b: eb2, v: out}
            }, function(eb) { return {b: eb, v: x} })
        })
        // The dynamic type of a slice is the type of its BACKING array, so a type
        // switch and a type assertion keep seeing "slice" (and "any") through a header.
        b = declFn(b, "$istype", 2, function(fb, a) {
            var x = a[0]
            var t = a[1]
            var r = emitSelect(fb, emitIsSl(fb, x),
                               function(tb) { return {b: tb, v: slF(tb, x, "a")} },
                               function(eb) { return {b: eb, v: x} })
            return {b: r.b, v: callExt(r.b, "js_gotypeis", [r.v, t])}
        })
        return b
    }

    // fmt.Println / Print / Sprint / Printf / Sprintf and the two BUILTINS
    // println / print. Each is a one-line generated function that hands the
    // callee's whole argument array to one of the three Go rendering externs in
    // abnf/jsrtgolang.go, together with the mode that selects Go's spacing rule:
    //
    //     0 fmt.Println      space between every pair,      newline
    //     1 fmt.Print/Sprint space between two non-strings, no newline
    //     2 builtin println  space between every pair,      newline
    //     3 builtin print    no space at all,               no newline
    //     4 Printf/Sprintf   args[0] is the format,         no newline
    //
    // Binding them to the shared `println` host function instead - which is what
    // this did before - reached Go's own %v with the RAW runtime value, so a map
    // printed as map[__dict:true keys:[a] ...] and a struct as its class
    // descriptor. The extern is the twin of the interpreter's gstr; see
    // "recurring shape 1" in docs/abnf-dialect-gotchas.md.
    //
    // `target` is the object the name is set on (the fmt package object), or null
    // for a builtin, which is DECLARED in the jsmain scope and so shadows the host
    // function of the same name for the compiled program only.
    function declPrint(b, target, name, ext, mode) {
        funcCount++
        var idx = funcCount
        var f = m.NewFunc("jsf_" + idx, i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var fb = f.NewBlock("entry")
        fb.NewRet(callExt(fb, ext, [f.Params[1], emitNum(fb, mode)]))
        var cl = callExt(b, "js_closure", [handle(idx), curScopeV])
        if (target == null) { callExt(b, "js_scope_decl", [curScopeV, emitStr(b, name), cl]) }
        else { callExt(b, "js_set", [target, emitStr(b, name), cl]) }
        return b
    }

    // ----- Pointers -----
    // A pointer to a variable is a CELL: a tiny class instance named "$ptr" carrying
    // the scope that holds the variable (o) and its name (k). The class shape is what
    // makes the two probes work - js_is_type answers "$ptr" without aborting on a
    // number, and js_goeq compares the declared fields, so two cells built for the same
    // variable (p == &n) compare equal. new(int) gets a fresh one slot scope instead.
    // This mirrors the interpreter's makePtr/isPtr exactly; keep the two in step.
    function emitPtrClass(b) { return callExt(b, "js_scope_get", [curScopeV, emitStr(b, "$ptrclass")]) }
    function emitPtrCell(b, scopeV, nameV) {
        var o = callExt(b, "js_obj_new", [])
        callExt(b, "js_set", [o, emitStr(b, "__class"), emitPtrClass(b)])
        callExt(b, "js_set", [o, emitStr(b, "o"), scopeV])
        callExt(b, "js_set", [o, emitStr(b, "k"), nameV])
        return o
    }
    function emitIsPtr(b, v) { return callExt(b, "js_is_type", [v, emitStr(b, "$ptr")]) }
    // A value-level if/else: both arms are emitted into their own blocks and joined
    // with a phi, the same shape makeOrAnd uses for the short-circuit operators.
    function emitSelect(b, condV, thenFn, elseFn) {
        var thenB = curF.NewBlock("")
        var elseB = curF.NewBlock("")
        var mergeB = curF.NewBlock("")
        b.NewCondBr(truthy(b, condV), thenB, elseB)
        var tr = thenFn(thenB)
        tr.b.NewBr(mergeB)
        var er = elseFn(elseB)
        er.b.NewBr(mergeB)
        var phi = mergeB.NewPhi([llvm.ir.NewIncoming(tr.v, tr.b), llvm.ir.NewIncoming(er.v, er.b)])
        return {b: mergeB, v: phi}
    }
    // js_gounctl, LOWERED INTO THE EMITTER (docs/runtime-next-plan.md part 3, item 1).
    // The completion value of a body closure: a return signal carries the returned
    // value, a body that ran off its end yields undefined. A control signal is the
    // FLOOR's private tag-10 cell and there is no host builtin that opens one, so
    // layer 2 could not write this extern at all - exactly the position a scope probe
    // is in, and with the same answer: js_ctl_kind and js_ctl_value ARE floor externs
    // and an EMITTER may call them. js_ctl_kind answers a RAW INTEGER (mk_ctl's fa
    // field; 0 for anything that is not a signal), so the test is an icmp against 1
    // and not truthy(), which would also take kinds 2 and 3.
    function emitUnctl(b, v) {
        var kind = callExt(b, "js_ctl_kind", [v])
        var thenB = curF.NewBlock("")
        var elseB = curF.NewBlock("")
        var mergeB = curF.NewBlock("")
        b.NewCondBr(b.NewICmp(llvm.enum.IPredEQ, kind, llvm.constant.NewInt(i64, 1)), thenB, elseB)
        var tv = callExt(thenB, "js_ctl_value", [v])
        thenB.NewBr(mergeB)
        elseB.NewBr(mergeB)
        var phi = mergeB.NewPhi([llvm.ir.NewIncoming(tv, thenB), llvm.ir.NewIncoming(hUndef, elseB)])
        return {b: mergeB, v: phi}
    }
    function emitCellGet(b, p) {
        return callExt(b, "js_scope_get", [callExt(b, "js_get", [p, emitStr(b, "o")]),
                                           callExt(b, "js_get", [p, emitStr(b, "k")])])
    }
    function emitCellSet(b, p, v) {
        callExt(b, "js_scope_set", [callExt(b, "js_get", [p, emitStr(b, "o")]),
                                    callExt(b, "js_get", [p, emitStr(b, "k")]), v])
        return b
    }
    // *v: read through a cell, and stay the identity on anything else (a struct
    // pointer is the struct).
    function emitDerefV(b, v) {
        return emitSelect(b, emitIsPtr(b, v),
                          function(tb) { return {b: tb, v: emitCellGet(tb, v)} },
                          function(eb) { return {b: eb, v: v} })
    }
    function makeDeref(t) {
        return function(b) {
            var r = t(b)
            return emitDerefV(r.b, r.v)
        }
    }
    // &name. A value that is ALREADY a reference (a struct, a slice, a map) is its own
    // pointer, so only a scalar - and a pointer variable, for &p - gets a cell.
    function makeAddrVar(name) {
        return function(b) {
            var cur = callExt(b, "js_scope_get", [curScopeV, emitStr(b, name)])
            var scopeV = curScopeV
            var mkCell = function(cb) { return {b: cb, v: emitPtrCell(cb, scopeV, emitStr(cb, name))} }
            return emitSelect(b, emitIsPtr(b, cur), mkCell, function(eb) {
                // An ARRAY is a VALUE in Go and every assignment of one copies it, so
                // &arr cannot be the array: `h := &arr` would hand h a copy and
                // `h[0] = 5` would be lost. It gets a real cell, like a scalar. (A
                // slice header, a map and a struct are references already.) js_is_type
                // "Array" is true for a plain array handle and false for the $sl
                // header. Mirrors makeAddrVar in go-interpreter.abnf.
                var isArr = callExt(eb, "js_is_type", [cur, emitStr(eb, "Array")])
                return emitSelect(eb, isArr, mkCell, function(nb) {
                    var isObj = callExt(nb, "js_seq", [callExt(nb, "js_typeof", [cur]), emitStr(nb, "object")])
                    return emitSelect(nb, isObj, function(tb) { return {b: tb, v: cur} }, mkCell)
                })
            })
        }
    }
    // new(T): a slice or struct type is its own reference; a SCALAR needs a cell over a
    // fresh one slot scope, so that *q += 3 has somewhere to write. The type is known
    // here, so the choice is made at emit time.
    function isScalarTy(t) {
        return t.indexOf("int") == 0 || t.indexOf("uint") == 0 || t.indexOf("float") == 0
            || t.indexOf("byte") == 0 || t.indexOf("rune") == 0
            || t.indexOf("string") == 0 || t.indexOf("bool") == 0
    }
    function makeNew(ty) {
        var d = ty
        return function(b) {
            if (d.length > 0 && d.charCodeAt(0) == 91) { return {b: b, v: callExt(b, "js_arr_new", [])} }
            if (!isScalarTy(d)) { return {b: b, v: callExt(b, "js_obj_new", [])} }
            var box = callExt(b, "js_scope_new", [hUndef])
            callExt(b, "js_scope_decl", [box, emitStr(b, "v"), emitZero(b, d)])
            return {b: b, v: emitPtrCell(b, box, emitStr(b, "v"))}
        }
    }
    // A target's leading stars are pushed before the name, so the name is the first
    // string item. Overridden by ASSIGNMENT so both engines agree which one is live.
    makeTargetRef = function(items) {
        var i = 0
        while (i < items.length && typeof items[i] != "string") { i++ }
        return {name: items[i], path: items.slice(i + 1), stars: i}
    }
    // The value of a starred target's base: the variable, dereferenced stars - 1 times.
    function emitStarBase(b, ref) {
        var v = callExt(b, "js_scope_get", [curScopeV, emitStr(b, ref.name)])
        for (var i = 1; i < ref.stars; i++) {
            var r = emitDerefV(b, v)
            b = r.b
            v = r.v
        }
        return {b: b, v: v}
    }
    function emitRefRead(b, ref) {
        if (ref.path.length == 0 && ref.stars > 0) {
            var sb = emitStarBase(b, ref)
            return emitDerefV(sb.b, sb.v)
        }
        var o = callExt(b, "js_scope_get", [curScopeV, emitStr(b, ref.name)])
        for (var i = 0; i < ref.path.length; i++) {
            var s = ref.path[i]
            if (s.key != undefined) {
