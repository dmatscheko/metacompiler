// the element's ',' or the closing '}' at bracket depth 0. It decides before anything
// is pushed, so an unkeyed element leaks nothing.
KeyAhead = :script(~~
    (function () {
        var i = 0
        var depth = 0
        var cc = 0
        while (i < 8192) {
            cc = c.peek(i)
            if (cc < 0) { break }
            if (cc === 34 || cc === 39 || cc === 96) {
