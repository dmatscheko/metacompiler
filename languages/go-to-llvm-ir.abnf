    // ch <- v
    function makeChanSend(items, pos) {
        var chT = items[0]
        var valT = items[1]
        return function(b) {
            var r1 = chT(b)
            var r2 = valT(r1.b)
            callExt(r2.b, "js_gochan_send", [r1.v, r2.v])
            return r2.b
        }
    }
    // <-ch as a value (the single-result form; RecvOk covers `v, ok := <-ch`).
    function makeRecv(chT, pos) {
        return function(b) {
            var r = chT(b)
            return {b: r.b, v: callExt(r.b, "js_gochan_recv", [r.v])}
