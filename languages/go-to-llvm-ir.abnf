    function makeVarDecl(items) {
        var names = []
        var i = 0
        for (; i < items.length; i++) {
            if (typeof items[i] != "string") { break }
            names.push(items[i])
        }
        var ty = ""
        if (i < items.length && items[i] != undefined && items[i].ty != undefined) { ty = items[i].ty; i++ }
        var inits = items.slice(i)
        return function(b) {
            var vals = []
            if (inits.length == 0) {
                for (var z = 0; z < names.length; z++) { vals.push(emitZeroDecl(b, ty)) }
            } else {
                for (var k = 0; k < inits.length; k++) {
                    var r = inits[k](b)
                    b = r.b
                    vals.push(r.v)
                }
                if (names.length > 1 && inits.length == 1) {
                    var multi = vals[0]
                    vals = []
                    for (var u = 0; u < names.length; u++) {
                        vals.push(callExt(b, "js_map_get", [multi, emitNum(b, u)]))
