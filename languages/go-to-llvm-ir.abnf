        var d = ty
        return function(b) {
            if (d.length > 0 && d.charCodeAt(0) == 91) { return {b: b, v: callExt(b, "js_arr_new", [])} }
            if (!isScalarTy(d)) { return {b: b, v: callExt(b, "js_obj_new", [])} }
            var box = callExt(b, "js_scope_new", [hUndef])
            callExt(b, "js_scope_decl", [box, emitStr(b, "v"), emitZero(b, d)])
            return {b: b, v: emitPtrCell(b, box, emitStr(b, "v"))}
