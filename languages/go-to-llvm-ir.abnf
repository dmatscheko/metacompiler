// []int{1, 2, 3} and [][]int{{1}, {2, 3}} - a slice literal, whose elements may be
// bare brace groups built against the element type.
SliceLit    <~~ var li = takeAll(); goLitClaim("[]" + li[0].cet, up.start, up.pos); push(goLitC(makeSliceLit(li), "[]" + li[0].cet, up.pos)) ~~>
            = "[" "]" ElemT SeqBody ;
// [3]int{1, 2, 3}, [...]string{"x", "y"} (length inferred), [5]int{0: 1, 4: 9}
// (indexed elements) and [2][2]int{{1, 2}, {3, 4}}. An ARRAY, not a slice: it is a
// value, so assigning it copies.
ArrayLit    <~~ var ai = takeAll()
                var alty = goArrLitTy(goWalkQual(goArrConstLen("[" + ai[0].altext + "]" + ai[1].cet)), ai[1].cet,
                                      ai[2].selems.length, goLitKeyed(ai[2].selems))
