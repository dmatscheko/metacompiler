ArrDots     <~~ push({alen: null}) ~~> = "..." ;
ArrLen      <~~ push({alen: pop()}) ~~> = Expression ;
ElemT       <~~ push({cet: firstType(up.in)}) ~~> = Type ;
SeqBody     <~~ push({selems: takeAll()}) ~~>
