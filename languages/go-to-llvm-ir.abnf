        var gf = m.NewFunc("jsf_" + gidx, i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var closV = callExt(b, "js_closure", [handle(gidx), curScopeV])
        var savedF = curF
