// p.manhattan(), fmt.Println(...), p.x, s[i], and slice expressions s[lo:hi:max].
PostfixExpr = CallMember ;
// Go inserts a semicolon at a line break that follows ')', ']', '}', a name or a literal,
// so a '(' or '[' suffix can never START a new line: after
//     p := &pt29{7, 8}
//     (*p).x = 9
// the '(' opens a new STATEMENT, not a call of the composite literal. SameLine is that
// rule. It does not restrict a call whose ARGUMENTS span lines, because the '(' itself is
// still on the name's line.
CallMember  <~~ push(goChainC(foldCallMember(goBoxArgsC(goRecvsC(takeAll(), up.start))), up.in, up.pos)) ~~>
            = Primary { MethodSfx | FieldSfx | SameLine SliceSfx | SameLine TypeArgsSfx
                      | SameLine IndexSfx | SameLine CallSfx | TypeAssertSfx } ;
// f[int16, float32, string], NewMap[int, struct{}], shift[[62]byte]: a generic
// INSTANTIATION whose bracket list is not an index expression. Generics are erased, so
// an instantiation is the identity on the value it indexes, and this suffix pushes
// nothing at all. It has to be tried BEFORE IndexSfx - `struct{}` would otherwise be
// read as a composite literal of a type called "struct" - so both shapes are written to
// be impossible as an index: two or more arguments (Go has no comma index), or a single
// argument that is a type no expression can start with. An ARRAY type is in that set
// and `m[[2]int{1, 2}]` is a legal index, but there the '{' makes this rule fail and
// IndexSfx is retried, which is exactly the PEG behaviour wanted.
TypeArgsSfx  = TypeArgsMany | TypeArgsKw ;
TypeArgsMany = "[" Type "," Type { "," Type } "]" ;
TypeArgsKw   = "[" NonExprT "]" ;
NonExprT     = "[" "]" Type | ArrayTypeT | MapTypeT | FuncTypeT | ChanTypeT | IfaceTypeT | StructTypeT ;
