    }
    // &name. A value that is ALREADY a reference (a struct, a slice, a map) is its own
    // pointer, so only a scalar - and a pointer variable, for &p - gets a cell.
    function makeAddrVar(name) {
        return function(b) {
            var cur = callExt(b, "js_scope_get", [curScopeV, emitStr(b, name)])
            var scopeV = curScopeV
            var mkCell = function(cb) { return {b: cb, v: emitPtrCell(cb, scopeV, emitStr(cb, name))} }
            return emitSelect(b, emitIsPtr(b, cur), mkCell, function(eb) {
