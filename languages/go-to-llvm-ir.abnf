        var iV = callExt(headB, "js_scope_get", [sc, emitStr(headB, nm)])
        headB.NewCondBr(truthy(headB, callExt(headB, "js_lt", [iV, nV])), bodyB, exitB)
        var iB = callExt(bodyB, "js_scope_get", [sc, emitStr(bodyB, nm)])
        var endB = bodyFn(bodyB, iB)
        var iE = callExt(endB, "js_scope_get", [sc, emitStr(endB, nm)])
        callExt(endB, "js_scope_set", [sc, emitStr(endB, nm), callExt(endB, "js_jadd", [iE, emitNum(endB, 1)])])
        endB.NewBr(headB)
