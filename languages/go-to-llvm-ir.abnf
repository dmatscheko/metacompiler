    // pointer is the struct).
    function emitDerefV(b, v) {
        return emitSelect(b, emitIsPtr(b, v),
                          function(tb) { return {b: tb, v: emitCellGet(tb, v)} },
                          function(eb) { return {b: eb, v: v} })
    }
