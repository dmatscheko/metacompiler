                push(goLitC(makeArrayLit(ai), alty, up.pos)) ~~>
            = "[" ( ArrDots | ArrLen ) "]" ElemT SeqBody ;
ArrDots     <~~ push({alen: null, altext: "..."}) ~~> = "..." ;
ArrLen      <~~ push({alen: pop(), altext: up.in}) ~~> = Expression ;
ElemT       <~~ push({cet: goWalkQual(firstType(up.in))}) ~~> = Type ;
SeqBody     <~~ push({selems: goOrderEls(takeAll())}) ~~>
            = "{" [ SeqElem { "," SeqElem } [ "," ] ] "}" ;
SeqElem     <~~ push(makeSeqElem(takeAll())) ~~>
