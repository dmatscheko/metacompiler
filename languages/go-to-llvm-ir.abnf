    // string item. Overridden by ASSIGNMENT so both engines agree which one is live.
    makeTargetRef = function(items) {
        var i = 0
        while (i < items.length && typeof items[i] != "string") { i++ }
        return {name: items[i], path: items.slice(i + 1), stars: i}
    }
    // The value of a starred target's base: the variable, dereferenced stars - 1 times.
    function emitStarBase(b, ref) {
        var v = callExt(b, "js_scope_get", [curScopeV, emitStr(b, ref.name)])
        for (var i = 1; i < ref.stars; i++) {
            var r = emitDerefV(b, v)
            b = r.b
            v = r.v
        }
        return {b: b, v: v}
    }
    function emitRefRead(b, ref) {
        if (ref.path.length == 0 && ref.stars > 0) {
            var sb = emitStarBase(b, ref)
            return emitDerefV(sb.b, sb.v)
        }
        var o = callExt(b, "js_scope_get", [curScopeV, emitStr(b, ref.name)])
        for (var i = 0; i < ref.path.length; i++) {
            var s = ref.path[i]
            if (s.key != undefined) {
                o = callExt(b, "js_gofield", [o, emitStr(b, s.key)])
            } else {
                var r = s.idx(b)
                b = r.b
                o = emitHelper(b, "$sidx", [o, r.v])
            }
