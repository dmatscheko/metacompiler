// that does not hold the target type panics the way Go does: js_goifas by method set
// for an interface, js_goassert by dynamic type for a predeclared scalar or a
// declared struct (assertTyWant). Any other target is the identity. The twin is
// TypeAssertSfx in go-interpreter.abnf.
TypeAssertSfx = "." "(" AssertSfxTy ")" ;
AssertSfxTy <~~ push({kind: "assert", at: goWalkQual(firstType(up.in))}) ~~> = Type ;

// A string or bool literal reports its type, so a store binds it typed (`s := "a"`
// makes &s a *string); the shared literal rules know nothing of static types.
StrLitT     <~~ regSt(up.pos, "string") ~~> = DqString | RawString ;
BoolLitT    <~~ regSt(up.pos, "bool") ~~> = True | False ;

Primary     = ParenConv | ParenGroup | ImagLit | DotFloatLit | HexFloatLit | FloatLit | HexLit | OctLit
            | BinLit | LegOctLit | DecULit | StrLitT | RuneLit
            | GoDecLit | BoolLitT | Nil | FuncLit | SliceLit
            | MapLit | MakeMap | MakeSlice | MakeChan | NewCall | AnonStructLit
            | QualStructLit | StructLit
            | ArrayLit | ConvExpr | CompLitNI | PanicCall | Call | VarRef ;

// panic(v). Go reports a panic raised again with the value it aborted only once
// ("[recovered, repanicked]"), and "the value" is the interface value: re-raising
// what recover() answered, or a constant, is the same value, while a value computed
// here (fmt.Sprint(r), a conversion, an operator) is a new one even when it is
// equal. So a computed argument calls $panicf, which marks the panic fresh.
PanicCall   = "panic" KwEnd "(" ( PanicPlain ")" | PanicFresh [ "," ] ")" ) ;
PanicPlain  <~~ push(makeCall(["panic", pop()])) ~~> = PanicOperand [ "," ] ;
PanicOperand <~~ push(foldCallMember(goBoxArgsC(goRecvsC(takeAll(), up.start)))) ~~>
            = ( ImagLit | DotFloatLit | HexFloatLit | FloatLit | HexLit | OctLit | BinLit | LegOctLit | DecULit
              | DqString | RawString | RuneLit | GoDecLit | True | False | Nil | VarRef ) { FieldSfx | IndexSfx } ;
PanicFresh  <~~ push(makeCall(["$panicf", pop()])) ~~> = Expression ;


// A conversion whose target type is written out: []byte(s), []rune(s) and the
// PREDECLARED scalar spellings int(x), float64(n), uint8(b), ... The scalar forms
// would also work as ordinary calls (declConv binds every name in jsmain), but
// matching them here makes the target type known at EMIT time, which is what gives
// float64(i)/2 a float division and ^uint8(x) an eight bit complement. A conversion
// to a user-defined type still goes through Call. Longest spelling first: this is a
// PEG, so "uint" matching the front of "uint16" would never be retried.
ConvExpr    <~~ push(makeConv(goConvC(takeAll(), up.pos), up.pos)) ~~>
            = ConvType "(" ConvArg [ "," ] ")" ;
// The converted value, followed by its source range (goConvC).
ConvArg     <~~ var cv = pop(); push(cv); push({cks: up.start, cke: up.pos}) ~~> = Expression ;
