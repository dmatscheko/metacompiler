    // Every field the literal leaves out is ZERO-filled from its declared type, the way
    // Go does - so Point{} and Point{x: 0} are the same value and compare equal.
    function makeStructLit(items) {
        var tyName = items[0]
        var args = items.slice(1)
        return function(b) {
            var clsV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, tyName)])
            return emitStructVal(b, clsV, structFields[tyName], structFTypes[tyName], args)
        }
