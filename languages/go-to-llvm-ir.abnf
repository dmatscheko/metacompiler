    // 0x1.8p1: hex mantissa with an optional hex fraction, times two to the DECIMAL
    // exponent after 'p'.
    function parseHexFloat(s) {
        var v = 0
        var scale = 1
        var seenDot = false
        var i = 2
        while (i < s.length) {
            var cc = s.charCodeAt(i)
            i++
            if (cc == 95) { continue }
            if (cc == 46) { seenDot = true; continue }
            if (cc == 112 || cc == 80) { break }
            var d = 0
            if (cc >= 48 && cc <= 57) { d = cc - 48 }
            else if (cc >= 97 && cc <= 102) { d = cc - 87 }
            else if (cc >= 65 && cc <= 70) { d = cc - 55 }
            if (seenDot) { scale = scale / 16; v = v + d * scale } else { v = v * 16 + d }
        }
        var esign = 1
        if (i < s.length && s.charCodeAt(i) == 43) { i++ }
        else if (i < s.length && s.charCodeAt(i) == 45) { esign = 0 - 1; i++ }
        var exp = 0
        while (i < s.length) {
            var c2 = s.charCodeAt(i)
            i++
            if (c2 < 48 || c2 > 57) { continue }
            exp = exp * 10 + (c2 - 48)
        }
        exp = exp * esign
        var m = 1
        var k = 0
        if (exp >= 0) {
            for (k = 0; k < exp; k++) { m = m * 2 }
        } else {
            for (k = 0; k < 0 - exp; k++) { m = m / 2 }
        }
        return v * m
    }
    function parseRadix(s) {
        var radix = 10
        var start = 0
        if (s.length >= 2 && s.charAt(0) == "0") {
            var p = s.charAt(1)
            if (p == "x" || p == "X") { radix = 16; start = 2 }
            else if (p == "o" || p == "O") { radix = 8; start = 2 }
            else if (p == "b" || p == "B") { radix = 2; start = 2 }
        }
        var v = 0
        for (var i = start; i < s.length; i++) {
            var cc = s.charCodeAt(i)
            if (cc == 95) { continue }
            var d = 0
            if (cc >= 48 && cc <= 57) { d = cc - 48 }
            else if (cc >= 97 && cc <= 102) { d = cc - 87 }
            else if (cc >= 65 && cc <= 70) { d = cc - 55 }
            v = v * radix + d
        }
        return v
    }
    // type Name struct {...} lowers to a descriptor; type Name interface {...} is
    // accepted (marked with {iface}) and reported not implemented.
    // Every type NAME the program declares, so `type A = B` can tell a user type (which
    // the alias re-binds to) from a builtin like int (which it converts to).
    var declaredTypes = {}
    function makeTypeDecl(items, pos) {
        var last = items[items.length - 1]
        // `type A = B`: AliasEq pushed its marker straight after the name. When B is a
        // type this file already declared, A becomes a SECOND NAME for the same binding
        // (struct descriptor included); otherwise (type Int = int) it falls through to
        // the defined-type conversion below.
        if (items.length > 2 && typeof items[1] == "object" && items[1] != null && items[1].alias == true) {
            var aName = items[0]
            var aTgt = (typeof last == "object" && last != null && last.under != undefined) ? last.under : ""
            declaredTypes[aName] = true
            if (aTgt != "" && declaredTypes[aTgt] == true) {
                if (structFields[aTgt] != undefined) {
                    structFields[aName] = structFields[aTgt]
                    structFTypes[aName] = structFTypes[aTgt]
                }
                return function(b) {
                    callExt(b, "js_scope_decl", [curScopeV, emitStr(b, aName),
                                                 callExt(b, "js_scope_get", [curScopeV, emitStr(b, aTgt)])])
                    return b
                }
            }
            var alias = [items[0]]
            for (var ai = 2; ai < items.length; ai++) { alias.push(items[ai]) }
            items = alias
            last = items[items.length - 1]
        }
        declaredTypes[items[0]] = true
        // An interface declaration binds no runtime value: the value model is dynamic,
        // so satisfaction is implicit and a method call on an interface value is the
        // ordinary method call on whatever struct is in it. A constraint interface
        // (a type set, as in Go 1.18 generics) is erased for the same reason.
        if (typeof last == "object" && last != null && last.iface == true) {
            return function(b) { return b }
        }
        // type Celsius float64 / type myInt int: the value model has no distinct type
        // for a defined type, so its NAME becomes the conversion to the underlying type -
        // which is exactly how a defined type is used in an expression.
        if (typeof last == "object" && last != null && last.under != undefined) {
            var dName = items[0]
            var dUnder = last.under
            // Keep the SPELLING as well as the conversion. `type L []int` kept only
            // the conversion, so `L{1, 2, 3}` reached makeStructLit, looked up an
            // undefined structFields["L"] and crashed inside emitStructVal. The table
            // is read from inside the emit closures, which run long after every
            // TypeDecl has been walked - so a type used before it is declared is fine.
            definedUnder[dName] = dUnder
            return function(b) { return declConv(b, dName, dUnder) }
        }
        return makeStructStmt(items)
    }

    // ----- Functions, methods and structs -----

    function emitFunc(plist, body, recvName, rets) {
        var params = plist.params
        var variadic = plist.variadic == true
        var ptypes = plist.ptypes
        funcCount++
        var idx = funcCount
        var f = m.NewFunc("jsf_" + idx, i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var savedF = curF
        var savedScope = curScopeV
        var savedLoops = loopStack
        curF = f
        loopStack = []
        var b = f.NewBlock("entry")
        curScopeV = callExt(b, "js_scope_new", [f.Params[0]])
        var off = 0
        if (recvName != null) {
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, recvName), callExt(b, "js_arg", [f.Params[1], handle(0)])])
            off = 1
        }
        for (var i = 0; i < params.length; i++) {
            // A parameter is a slot with a DECLARED type, so it adopts it exactly as a
            // var declaration does: `func f(b uint8)` makes the b inside f a uint8.
            var pt = (ptypes == undefined || ptypes == null || i >= ptypes.length) ? "" : ptypes[i]
            if (variadic && i == params.length - 1) {
                callExt(b, "js_scope_decl", [curScopeV, emitStr(b, params[i]),
                                             emitSlT(b, emitSlOf(b, callExt(b, "js_gorest", [f.Params[1], handle(i + off)])), pt)])
            } else {
                // An array argument is a VALUE: the parameter gets a copy ($acopy is
                // the identity on everything else).
                callExt(b, "js_scope_decl", [curScopeV, emitStr(b, params[i]),
                                             emitAdoptTy(b, pt,
                                                 emitHelper(b, "$acopy",
                                                        [callExt(b, "js_arg", [f.Params[1], handle(i + off)])]))])
            }
        }
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "$defers"), callExt(b, "js_arr_new", [])])
        // Named results are zero-valued locals of the function; a bare return yields
        // them, and a deferred function still sees (and may change) them.
        var savedRets = curRets
        curRets = (rets == undefined || rets == null) ? [] : rets
        for (var nr = 0; nr < curRets.length; nr++) {
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, curRets[nr]), emitNum(b, 0)])
        }
        // The BODY is emitted as a closure of its own and called through js_gotry, which
        // is what makes Go's panic/defer/recover work: a panic unwinding through this
        // frame is caught there, the frame's deferred functions still run, a recover()
        // in one of them takes the panic value, and js_gorepanic re-raises whatever was
        // not recovered. The body closure reuses THIS frame's scope (its env is the
        // scope, not a parent of it), so declarations, named results and $defers behave
        // exactly as they did when the body was emitted inline.
        funcCount++
        var bidx = funcCount
        var bf = m.NewFunc("jsf_" + bidx, i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var ctlV = callExt(b, "js_gotry", [callExt(b, "js_closure", [handle(bidx), curScopeV])])
        callExt(b, "js_rundefers", [callExt(b, "js_scope_get", [curScopeV, emitStr(b, "$defers")])])
        callExt(b, "js_gorepanic", [])
        // Named results are read back AFTER the defers ran, so a deferred function that
        // assigns one is seen; without them the body's return signal carries the value.
        if (curRets.length > 0) { b.NewRet(readRets(b)) }
        else { var ur = emitUnctl(b, ctlV); ur.b.NewRet(ur.v) }
        // Now the body itself, inside the closure. A return in it LEAVES the closure, so
        // it goes out as a control signal (retStmt) that js_gounctl unwraps again.
        var savedFTag = curFTag
        curF = bf
        var bb = bf.NewBlock("entry")
        curScopeV = bf.Params[0]
        curFTag = bidx
        ctlEnter(bidx)
        body(bb).NewRet(hUndef)
        ctlLeave()
        curFTag = savedFTag
        curRets = savedRets
        curF = savedF
        curScopeV = savedScope
        loopStack = savedLoops
        return idx
    }
    // items = [name, fieldName..., {fty}, fieldName..., {fty}, ...]: the names of one
    // group share the {fty} that follows them, which gives every field its zero value.
    // The lists are ALSO emitted onto the descriptor, where js_goeq (struct value
    // equality) and js_gofield (promotion through an embedded field) read them.
    function makeStructStmt(items) {
        var name = items[0]
        var fields = []
        var ftypes = []
        var pending = []
        for (var i = 1; i < items.length; i++) {
            if (typeof items[i] == "string") { pending.push(items[i]); continue }
            for (var k = 0; k < pending.length; k++) { fields.push(pending[k]); ftypes.push(items[i].fty) }
            pending = []
        }
        for (var p = 0; p < pending.length; p++) { fields.push(pending[p]); ftypes.push("") }
        structFields[name] = fields
        structFTypes[name] = ftypes
        return function(b) {
            var clsV = callExt(b, "js_obj_new", [])
            callExt(b, "js_set", [clsV, emitStr(b, "__isclass"), hTrue])
            callExt(b, "js_set", [clsV, emitStr(b, "__name"), emitStr(b, name)])
            emitNameList(b, clsV, "__fields", fields)
            emitNameList(b, clsV, "__ftypes", ftypes)
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, name), clsV])
            return b
        }
    }
    // An unnamed receiver (func (T) M()) arrives as [{byptr}?, type, {anon:true}] because
    // a tag runs after its children; give it the empty name the named form would have put
    // first, so recv stays [name, {byptr}?, type] everywhere downstream.
    function normRecv(items) {
        var last = items[items.length - 1]
        if (typeof last == "object" && last != null && last.anon == true) {
            var out = [""]
            for (var i = 0; i < items.length - 1; i++) { out.push(items[i]) }
            return out
        }
        return items
    }
    // import "path" is a pure compile-time act (resolveImport pulls a project file in, or
    // recognises a stdlib package the prologue already declared), so it lowers to nothing.
    function makeImport(path, pos) {
        resolveImport(path, pos)
        return function(b) { return b }
    }
    // import alias "path" / import _ "path": resolve exactly as above, then declare the
    // alias as a second name for the package object. This thunk runs from buildMain's
    // makeSeq, i.e. after buildPackages and the fmt/os prologue, so the base name is bound.
    // items = [alias, path].
    function makeImportAs(items, pos) {
        var alias = items[0]
        var path = items[1]
        resolveImport(path, pos)
        var base = pkgBaseName(stripWs(path))
        if (alias == "_" || alias == base) { return function(b) { return b } }
        return function(b) {
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, alias),
                                         callExt(b, "js_scope_get", [curScopeV, emitStr(b, base)])])
            return b
        }
    }
    // items = [{recv: [var, type]}?, name, {params}, body]
    function makeFuncStmt(items) {
        var i = 0
        var recv = null
        if (items[i] != undefined && items[i].recv != undefined) { recv = items[i].recv; i++ }
        var name = items[i]
        var params = items[i + 1]
        i = i + 2
        var rets = []
        if (items[i] != undefined && items[i].rets != undefined) { rets = items[i].rets; i++ }
        var body = items[i]
        if (recv != null) {
            // recv = [name, {byptr}?, typeName]
            var byPtr = recv.length > 2
            var rName = recv[0]
            var rType = recv[recv.length - 1]
            return function(b) {
                var idx = emitFunc(params, body, rName, rets)
                var clsV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, rType)])
                callExt(b, "js_set", [clsV, emitStr(b, name), callExt(b, "js_closure", [handle(idx), curScopeV])])
                if (byPtr) { callExt(b, "js_set", [clsV, emitStr(b, "__ptr$" + name), hTrue]) }
                return b
            }
        }
        // In an imported package, an exported (capitalized) function is ALSO reached through
        // the package object (pkg.Fn); record it for buildPackages (see core.importFile).
        if (curPkgName != null && isExported(name)) { pkgExports["$" + curPkgName].push(name) }
        return function(b) {
            var idx = emitFunc(params, body, null, rets)
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, name),
                                         callExt(b, "js_closure", [handle(idx), curScopeV])])
            return b
        }
    }

    // Binds `name` to the one-argument CONVERSION to type text `ty` (js_goconv, the
    // runtime mirror of the interpreter's goConvert). Used both for the predeclared
    // spellings - int(x), string(r), ... - and for a defined type (type Celsius float64),
    // whose name is exactly the conversion to its underlying type in an expression.
    function declConv(b, name, ty) {
        var t = ty
        var isSliceTy = t.length > 1 && t.charCodeAt(0) == 91 && t.charCodeAt(1) == 93
        var itc = goIntTy(t)
        return declFn(b, name, 1, function(fb, a) {
            // A sized integer type converts through js_giconv, which wraps to the
            // target width and leaves that width ON the value - js_goconv answers
            // a plain number and could not carry it.
            if (itc != null) { return {b: fb, v: emitGiConv(fb, a[0], itc)} }
            // js_goconv only knows plain arrays, so a slice argument hands over its
            // ELEMENTS (string(bs)) and a slice result is wrapped back into a header;
            // js_gival unwraps a sized integer to its plain number and passes
            // everything else through, so string(rune(65)) still answers "A".
            var v = callExt(fb, "js_goconv", [emitStr(fb, t),
                            callExt(fb, "js_gival", [emitHelper(fb, "$sels", [a[0]])])])
            // []byte(s) / []rune(s): the header records the element type, so a later
            // bs[0] += 200 wraps at 8 bits the way Go's byte does.
            if (isSliceTy) { v = emitSlT(fb, emitSlOf(fb, v), elemTy(t)) }
            return {b: fb, v: v}
        })
    }
    // A builtin whose extern takes the callee's ARGUMENT ARRAY (plus an optional
    // constant flag), bound in the jsmain scope under `name`.
    function declBuiltin(b, name, ext, flag) {
        funcCount++
        var idx = funcCount
        var f = m.NewFunc("jsf_" + idx, i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var fb = f.NewBlock("entry")
        var args = [f.Params[1]]
        if (flag != null) { args.push(emitNum(fb, flag)) }
        fb.NewRet(fb.NewCall(getExtern(ext, args.length), args))
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, name), callExt(b, "js_closure", [handle(idx), curScopeV])])
        return b
    }
    // jsmain: declare fmt/os/len/append, run the top level, call main(). An imported
    // file's Program also lands here (importDepth > 0): its top-level declaration thunks
    // are stashed for the real jsmain instead of emitting a second one.
    function buildMain(items) {
        if (importDepth > 0) {
            stashImported(items) // emitted later under this file's own source (see compile-core)
            return
        }
        var f = m.NewFunc("jsmain", i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        curF = f
        var b = f.NewBlock("entry")
        curScopeV = callExt(b, "js_scope_new", [f.Params[0]])
        var fmtV = callExt(b, "js_obj_new", [])
        b = declPrint(b, fmtV, "Println", "js_goprint", 0)
        b = declPrint(b, fmtV, "Print", "js_gowrite", 1)
        b = declPrint(b, fmtV, "Sprint", "js_gostr", 1)
        b = declPrint(b, fmtV, "Printf", "js_goprint", 4)
        b = declPrint(b, fmtV, "Sprintf", "js_gostr", 4)
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "fmt"), fmtV])
        // Go's two BUILTINS. They are not fmt: println separates every pair and ends
        // with a newline, print separates nothing and ends with none. Real Go writes
        // both to STDERR and prints a pointer or a slice as an ADDRESS; this runtime
        // writes to stdout and renders the value, which is the reproducible answer
        // (and what this half already did before, through the host println).
        b = declPrint(b, null, "println", "js_goprint", 2)
        b = declPrint(b, null, "print", "js_gowrite", 3)
        var osV = callExt(b, "js_obj_new", [])
        callExt(b, "js_set", [osV, emitStr(b, "Exit"), callExt(b, "js_scope_get", [curScopeV, emitStr(b, "exit")])])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "os"), osV])
        // len/cap/copy/append/clear come from declSlices (they have to reach through a
        // slice header); delete(m, k) is still a one-liner.
        funcCount++
        var delIdx = funcCount
        var df = m.NewFunc("jsf_" + delIdx, i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var db = df.NewBlock("entry")
        db.NewCall(getExtern("js_map_del", 2), [db.NewCall(getExtern("js_arg", 2), [df.Params[1], handle(0)]),
                                                db.NewCall(getExtern("js_arg", 2), [df.Params[1], handle(1)])])
        db.NewRet(hUndef)
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "delete"), callExt(b, "js_closure", [handle(delIdx), curScopeV])])
        // append(s, v...), min(...), max(...), clear(x): the variadic builtins get the
        // callee's whole argument array, so one extern covers every arity - and append
        // starts a new slice when its first argument is a nil one (append(m[k], v)).
        b = declBuiltin(b, "min", "js_gominmax", 0)
        b = declBuiltin(b, "max", "js_gominmax", 1)
        // panic(v) raises; recover() answers the pending panic of the frame whose
        // deferred functions are running (nil outside one) and stops the unwinding.
        b = declBuiltin(b, "panic", "js_gopanic", null)
        b = declBuiltin(b, "recover", "js_gorecover", null)
        b = declBuiltin(b, "close", "js_gochan_close", null)
        // The identifier-spelled conversions - string(r), int(x), byte(x), ... - are
        // ordinary calls, so each gets a one-line function that hands its name and
        // argument to js_goconv (the runtime mirror of the interpreter's goConvert).
        var convNames = ["int", "int8", "int16", "int32", "int64", "uint", "uint8", "uint16",
                         "uint32", "uint64", "uintptr", "byte", "rune", "float32", "float64",
                         "string", "bool"]
        for (var cni = 0; cni < convNames.length; cni++) {
            declConv(b, convNames[cni], convNames[cni])
        }
        // Imported top-level declarations run first (flat in the jsmain scope), so an
        // imported package resolves its OWN names unqualified; then the package objects are
        // assembled from the exported functions (pkg.Fn, like fmt/os); then the main file's
        // own declarations run.
        b = declSlices(b)
        if (usesComplex) { b = declComplex(b) }
        // The descriptor every pointer cell shares (see emitPtrCell). Declared before
        // the program runs, so a nested function reaches it through its scope chain.
        var pcls = callExt(b, "js_obj_new", [])
        callExt(b, "js_set", [pcls, emitStr(b, "__name"), emitStr(b, "$ptr")])
        var pf = callExt(b, "js_arr_new", [])
        callExt(b, "js_arr_push", [pf, emitStr(b, "o")])
        callExt(b, "js_arr_push", [pf, emitStr(b, "k")])
        callExt(b, "js_set", [pcls, emitStr(b, "__fields"), pf])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "$ptrclass"), pcls])
        b = emitImported(b)   // imported files' declarations, each under its own source
        b = buildPackages(b)
        b = makeSeq(items)(b)
        // The entry defaults to main(); -main (c.mainName) can name another function or,
        // with a '(', a Go snippet parsed and emitted into jsmain (see emitMainSnippet).
        var entry = c.mainName
        if (entry == undefined || entry == "") { entry = "main" }
        if (mainIsSnippet(entry)) {
            b = emitMainSnippet(b, entry, "Statement")
            b.NewRet(emitNum(b, 0))
        } else {
            var mainV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, entry)])
            var argsV = callExt(b, "js_arr_new", [])
            b.NewRet(callExt(b, "js_call", [mainV, hUndef, argsV]))
        }
    }
    // Assemble each imported package object from its exported functions (now declared flat
    // in the jsmain scope) and bind it under the package name, mirroring the fmt/os objects.
    function buildPackages(b) {
        for (var i = 0; i < pkgOrder.length; i++) {
            var pname = pkgOrder[i]
            var names = pkgExports["$" + pname]
            var pkgV = callExt(b, "js_obj_new", [])
            for (var j = 0; j < names.length; j++) {
                callExt(b, "js_set", [pkgV, emitStr(b, names[j]),
                                      callExt(b, "js_scope_get", [curScopeV, emitStr(b, names[j])])])
            }
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, pname), pkgV])
        }
        return b
    }
    // The import base name is the conventional package qualifier ("a/b" -> "b").
    function pkgBaseName(path) {
        var cut = -1
        for (var k = 0; k < path.length; k++) { if (path.charAt(k) == "/") { cut = k } }
        return cut >= 0 ? path.substring(cut + 1) : path
    }
    // Go visibility: an identifier is exported exactly when it starts with an upper-case
    // letter.
    function isExported(name) {
        if (name.length == 0) { return false }
        var c0 = name.charCodeAt(0)
        return c0 >= 65 && c0 <= 90
    }

    // ----- Core library config (see lib/compile-core.js) -----
    core.indexExt = "js_map_get" // Polymorphic reads: slice element or map (zero value when missing).

    // Go stdlib packages the runtime provides (resolveImport lives in lib/compile-core.js;
    // exact-match paths, so sub-packages like "encoding/json" are listed in full).
    core.stdlibImports = ["fmt", "os", "strings", "strconv", "math", "sort", "errors", "bufio", "io", "time", "sync", "bytes", "unicode", "regexp", "path", "encoding/json", "context", "flag", "log", "reflect"]
    function fail(msg) { println("go compiler error: " + msg); exit(1) }

    // Project-file imports: import "mathbox" -> mathbox.go (a slash path like "a/b" ->
    // a/b.go), searched under the program's directory and the -i roots. The file is parsed
    // with this grammar; its top-level declaration thunks are stashed by buildMain
    // (importDepth > 0) and run at the start of jsmain, so the imported package's funcs,
    // structs and package vars are declared flat in the jsmain scope - which lets the
    // package use its own names unqualified and cross-file value.Method() dispatch work.
    // buildPackages then gathers the exported (capitalized) functions onto a package object
    // (pkg.Fn, like fmt/os). A file is imported once; repeats and cycles are no-ops.
    core.importFile = function(path, pos) {
        var file = c.findImport(path + ".go")
        if (file == "") { return false }
        if (importedFiles["$" + file] == true) { return true }
        importedFiles["$" + file] = true
        var pname = pkgBaseName(path)
        if (pkgExports["$" + pname] == undefined) { pkgExports["$" + pname] = []; pkgOrder.push(pname) }
        var savedPkg = curPkgName
        curPkgName = pname
        var text = c.readFile(file)
        var asg = c.parse(c.agrammar, text, null, file)
        c.pushSource(file, text)
        importDepth = importDepth + 1
        c.compile(asg)
        importDepth = importDepth - 1
        c.popSource()
        curPkgName = savedPkg
        return true
    }

    c.compile(c.asg)

    // ----- the native build (docs/runtime-next-plan.md part 3) -----
    // jsdispatch(idx, env, args) is the function table a LINKED binary needs: js_closure
    // stores a raw function index, and under llvm.Run the Go runtime turns that index
    // back into a callee by looking "jsf_<idx>" up in the module. A binary has no such
    // reflection, so the module carries the mapping itself. The MISS arm calls
    // jsdispatch_ext, the same table emitted by the layer-2 runtime library
    // (lib/go-rt.ll, built by metajs-to-llvm-ir.abnf -rt-lib): its own function indices
    // are offset by a million, so the two chains cannot overlap and one js_call reaches
    // either module. Emitted ONLY for -exe, so every other run keeps the module it had.
    // This is lua-to-llvm-ir.abnf's emitDispatch, unchanged - the mechanism is the
    // reusable part of phase 4 and nothing here is Go's.
    function emitDispatch() {
        var idxs = []
        var fns = []
        var i = 0
        while (i < m.Funcs.length) {
            var f = m.Funcs[i]
            var nm = f.Name()
            if (nm.length > 4 && nm.substring(0, 4) == "jsf_") {
                idxs.push(parseInt(nm.substring(4, nm.length)))
                fns.push(f)
            }
            i = i + 1
        }
        var ext = m.NewFunc("jsdispatch_ext", i64,
            [llvm.ir.NewParam("idx", i64), llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var d = m.NewFunc("jsdispatch", i64,
            [llvm.ir.NewParam("idx", i64), llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var b = d.NewBlock("entry")
        var extB = d.NewBlock("ext")
        var ownB = d.NewBlock("own")
        b.NewCondBr(b.NewICmp(llvm.enum.IPredSGE, d.Params[0], llvm.constant.NewInt(i64, 1000000)), extB, ownB)
        extB.NewRet(extB.NewCall(ext, [d.Params[0], d.Params[1], d.Params[2]]))
        b = ownB
        i = 0
        while (i < fns.length) {
            var hit = d.NewBlock("hit" + idxs[i])
            var nxt = d.NewBlock("miss" + idxs[i])
            b.NewCondBr(b.NewICmp(llvm.enum.IPredEQ, d.Params[0], llvm.constant.NewInt(i64, idxs[i])), hit, nxt)
            hit.NewRet(hit.NewCall(fns[i], [d.Params[1], d.Params[2]]))
            b = nxt
            i = i + 1
        }
        b.NewRet(b.NewCall(ext, [d.Params[0], d.Params[1], d.Params[2]]))
    }

    // The two runtime inputs live next to THIS grammar, so the build does not depend on
    // the working directory: lib/runtime.ll is the C floor and lib/go-rt.ll is Go's own
    // layer 2. An explicit -rt REPLACES both. This grammar's entry point is ALREADY
    // named jsmain, which is what the C floor's main() calls, so - unlike every other
    // language in part 3 - no one-call alias has to be emitted.
    function libPath(name) {
        var mn = moduleName()
        var cut = -1
        var i = 0
        while (i < mn.length) {
            var ch = mn.charAt(i)
            if (ch == "/" || ch == "\\") { cut = i }
            i = i + 1
        }
        return mn.substring(0, cut + 1) + "lib/" + name
    }

    if (c.exePath != undefined && c.exePath != "") {
        emitDispatch()
        var rts = c.runtime
        if (rts == undefined || rts.length == 0) { rts = [libPath("runtime.ll"), libPath("go-rt.ll")] }
        var buildErr = llvm.BuildExecutable(m, c.exePath, rts)
        if (buildErr != "") {
            println(buildErr)
            exit(1)
        }
        println("go compiler: wrote executable " + c.exePath)
        exit(0)
    }

    println(m)

    var res = llvm.RunJS(m, "jsmain")
    var entryName = c.mainName
    if (entryName == undefined || entryName == "") { entryName = "main" }
    if (mainIsSnippet(entryName)) {
        println("go compiler: -main snippet returned " + res.Ret)
    } else {
        println("go compiler: " + entryName + "() returned " + res.Ret)
    }
    exit(res.Ret)

~~) ;
