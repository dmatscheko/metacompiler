        for (var i = 0; i < args.length; i++) {
            if (typeof args[i] == "function") { elems.push({ekey: null, eval: args[i], enest: null}); continue }
            if (args[i].enest != undefined) { elems.push({ekey: null, eval: null, enest: args[i].enest}); continue }
