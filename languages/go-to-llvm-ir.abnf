        return function(b) { return {b: b, v: callExt(b, "js_gochan_new", [emitStr(b, ty)])} }
    }
    function makeMakeMap(mz) {
        var zero = mz.mzero
        return function(b) {
            var mV = callExt(b, "js_dict_new", [])
            callExt(b, "js_set", [mV, emitStr(b, "zero"), emitZero(b, zero)])
            return {b: b, v: mV}
