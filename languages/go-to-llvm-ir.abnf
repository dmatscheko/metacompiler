    // the same reason: the complex probe needs blocks.
    function declCxPart(b, name, prop, dflt) {
        funcCount++
        var idx = funcCount
        var f = m.NewFunc("jsf_" + idx, i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var savedF = curF
        var savedScope = curScopeV
        curF = f
        var fb = f.NewBlock("entry")
        curScopeV = callExt(fb, "js_scope_new", [f.Params[0]])
        var v = callExt(fb, "js_arg", [f.Params[1], handle(0)])
        var pr = prop
        var dv = dflt
        // real(z) and imag(z) are float64 VALUES in Go, so the answer BOXES:
