    // defines foldCallMember, and a second declaration would leave the two engines
    // disagreeing about which one is live.
    foldCallMember = function(items) {
        if (items.length == 1) { return items[0] }
        var primary = items[0]
        var suffixes = items.slice(1)
        return function(b) {
            var r = primary(b)
            b = r.b
            var cur = r.v
            for (var i = 0; i < suffixes.length; i++) {
                var s = suffixes[i]
                if (s.kind == "mcall") {
                    var ea = emitArgs2(b, s.args, s.spread)
                    b = ea.b
                    cur = callExt(b, "js_gomcall", [cur, emitStr(b, s.name), ea.v])
                } else if (s.kind == "field") {
                    cur = callExt(b, "js_gofield", [cur, emitStr(b, s.name)])
                } else if (s.kind == "slice") {
                    var lov = hUndef, hiv = hUndef
                    if (s.lo != null) { var rl = s.lo(b); b = rl.b; lov = rl.v }
                    if (s.hi != null) { var rh = s.hi(b); b = rh.b; hiv = rh.v }
                    if (s.mx != null) { var rm = s.mx(b); b = rm.b }
                    cur = callExt(b, "js_goslice", [cur, lov, hiv])
                } else if (s.kind == "call") {
                    var ec = emitArgs2(b, s.args, s.spread)
                    b = ec.b
                    cur = callExt(b, "js_call", [cur, hUndef, ec.v])
                } else {
                    var ir2 = s.idx(b)
                    b = ir2.b
                    cur = callExt(b, core.indexExt, [cur, ir2.v])
                }
            }
            return {b: b, v: cur}
        }
    }
    function makeCall(items) {
        var name = items[0]
        var args = items.slice(1)
        var spread = takeSpread(args)
        return function(b) {
            var fV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, name)])
            var ea = emitArgs2(b, args, spread)
            b = ea.b
            return {b: b, v: callExt(b, "js_call", [fV, hUndef, ea.v])}
        }
