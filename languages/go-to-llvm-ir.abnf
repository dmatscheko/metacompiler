    // The shared body of both literal forms: zero-fill, then apply the elements in
    // order (a keyed one names its field, a positional one takes the next field).
    function emitStructVal(b, clsV, fields, ftypes, args) {
        var objV = callExt(b, "js_obj_new", [])
        callExt(b, "js_set", [objV, emitStr(b, "__class"), clsV])
        for (var z = 0; z < fields.length; z++) {
            callExt(b, "js_set", [objV, emitStr(b, fields[z]), emitZeroOf(b, ftypes[z])])
        }
        var pos = 0
        var key = null
        for (var i = 0; i < args.length; i++) {
            if (typeof args[i] != "function") { key = args[i].fkey; continue }
            var r = args[i](b)
            b = r.b
            var name = key
            if (name == null) { name = fields[pos]; pos++ }
