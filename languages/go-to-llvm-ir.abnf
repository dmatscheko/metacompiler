// reached (an index would fail there and the whole chain with it). Each bound is
// tagged, so an omitted one is told apart from a following one.
SliceSfx    <~~ push(makeSliceSfx(takeAll(), up.start)) ~~>
            = "[" [ Expression <~~ push({lo: pop(), sk: goKRec(up.start, up.pos)}) ~~> ] ":"
              [ Expression <~~ push({hi: pop(), sk: goKRec(up.start, up.pos)}) ~~> ]
              [ ":" Expression <~~ push({mx: pop(), sk: goKRec(up.start, up.pos)}) ~~> ] "]" ;
