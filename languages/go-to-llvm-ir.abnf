    // map-value variant: it never sees a slice type.)
    function emitZeroDecl(b, ty) {
        if (ty.length > 0 && ty.charCodeAt(0) == 91) { return callExt(b, "js_arr_new", []) }
        return emitZero(b, ty)
    }
    function makeForClassic(items) {
        var bodyT = items.pop()
        var init = null, cond = null, post = null
        var lbl = null
        var loopVars = []
        for (var i = 0; i < items.length; i++) {
            if (items[i].lbl != undefined) { lbl = items[i].lbl }
            if (items[i].k == "init") { init = items[i].t; loopVars = items[i].names }
            if (items[i].k == "cond") cond = items[i].t
            if (items[i].k == "post") post = items[i].t
        }
        if (loopVars == undefined) { loopVars = [] }
        return function(b) {
            var saved = curScopeV
            curScopeV = callExt(b, "js_scope_new", [curScopeV])
            var outerScopeV = curScopeV
            if (init != null) b = init(b)
            var headB = curF.NewBlock("")
            var bodyB = curF.NewBlock("")
            var postB = curF.NewBlock("")
            var exitB = curF.NewBlock("")
            b.NewBr(headB)
            if (cond != null) {
                var r = cond(headB)
                r.b.NewCondBr(truthy(r.b, r.v), bodyB, exitB)
            } else {
                headB.NewBr(bodyB)
            }
            loopStack.push({cont: postB, brk: exitB, lbl: lbl})
            // Per-iteration variables (Go 1.22): the body runs in a FRESH scope holding
            // copies of the loop variables, so a closure made inside keeps this turn's
            // values; the copies are written back before the post statement runs.
            var bodyScopeV = null
            if (loopVars.length > 0) {
                bodyScopeV = callExt(bodyB, "js_scope_new", [outerScopeV])
                for (var lv = 0; lv < loopVars.length; lv++) {
                    callExt(bodyB, "js_scope_decl", [bodyScopeV, emitStr(bodyB, loopVars[lv]),
                                                     callExt(bodyB, "js_scope_get", [outerScopeV, emitStr(bodyB, loopVars[lv])])])
                }
                curScopeV = bodyScopeV
            }
            var endB = bodyT(bodyB)
            if (loopVars.length > 0) {
                for (var lw = 0; lw < loopVars.length; lw++) {
                    callExt(endB, "js_scope_set", [outerScopeV, emitStr(endB, loopVars[lw]),
                                                   callExt(endB, "js_scope_get", [bodyScopeV, emitStr(endB, loopVars[lw])])])
                }
                curScopeV = outerScopeV
            }
            endB.NewBr(postB)
            loopStack.pop()
            var pb = postB
            if (post != null) pb = post(postB)
            pb.NewBr(headB)
            curScopeV = saved
            return exitB
        }
    }
    // ----- Labels, goto, and labelled break/continue -----
    // The label of the statement being PARSED right now, claimed by the loop header
    // that follows it (so a nested loop cannot steal the outer loop's label).
    var pendingLabel = null
    function takeLabel() {
        var l = pendingLabel
        pendingLabel = null
        return l
    }
    // The labelled statements currently being EMITTED, innermost last: two parallel
    // arrays rather than an object, so no name can collide with Object.prototype.
    var labelNames = []
    var labelBlocks = []
    function makeLabeled(stmtT, name) {
        return function(b) {
            var lb = curF.NewBlock("")
            b.NewBr(lb)
            labelNames.push(name)
            labelBlocks.push(lb)
            var out = stmtT(lb)
            labelNames.pop()
            labelBlocks.pop()
            return out
        }
    }
    function makeGoto(items, pos) {
        var name = items[0]
        return function(b) {
            var target = null
            for (var i = labelNames.length - 1; i >= 0; i--) {
                if (labelNames[i] == name) { target = labelBlocks[i]; break }
            }
            if (target == null) {
                println("go compiler error: goto " + name + " has no enclosing label (" + c.lineOf(pos) + ")")
                exit(1)
            }
            b.NewBr(target)
            return deadBlock()
        }
    }
    // The innermost loop carrying `lbl` (the innermost loop of all when lbl is null).
    function loopFor(lbl) {
        if (loopStack.length == 0) { return null }
