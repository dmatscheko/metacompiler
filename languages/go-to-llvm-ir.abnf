        if (isFloatTy(wd)) { return callExt(b, "js_gflo", [emitNum(b, 0)]) }
        if (wd == "string") { return emitStr(b, "") }
        if (wd == "bool") { return hFalse }
        if (wd == "map" || wd == "chan" || wd == "func" || wd == "interface" || wd == "struct") { return hNull }
        var flds = structFields[wd]
