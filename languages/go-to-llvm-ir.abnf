MakeSlice   <~~ push(makeMakeSlice(takeAll())); regSt(up.pos, goMakeTy(up.in)) ~~>
            = "make" KwEnd "(" "[" "]" ElemT "," Expression [ "," Expression ] ")" ;

// map[string]int{"a": 1} and make(map[string]int). The value type decides the
// zero value that a read of a missing key yields.
MapLit      <~~ var mi = takeAll(); goLitClaim("map[" + mi[0].mkey + "]" + mi[1].mzero, up.start, up.pos)
