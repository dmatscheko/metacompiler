        return {b: b, v: o}
    }
    function emitRefWrite(b, ref, v) {
        if (ref.path.length == 0) {
            if (ref.stars > 0) {
                var sb = emitStarBase(b, ref)
                var nm = ref.name
                var r = emitSelect(sb.b, emitIsPtr(sb.b, sb.v),
                                   function(tb) { return {b: emitCellSet(tb, sb.v, v), v: v} },
                                   function(eb) {
