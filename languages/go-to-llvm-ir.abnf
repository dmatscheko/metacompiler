    // Point{a, b}: the field names are known at compile time.
    // items = [name, ({fkey}? valueThunk)...]: a positional or keyed struct literal.
    // Every field the literal leaves out is ZERO-filled from its declared type, the way
    // Go does - so Point{} and Point{x: 0} are the same value and compare equal.
    function makeStructLit(items) {
        var tyName = items[0]
        var args = items.slice(1)
        return function(b) {
            // A DEFINED type: `type L []int; L{1, 2, 3}` is the []int literal and
            // `type Q Point; Q{1, 2}` is the Point literal. Resolved HERE, at emit
            // time, so a literal that precedes its own `type` declaration still sees
            // the table (every tag has walked by the time an emit closure runs).
            var name = resolveDefined(tyName)
            if (name != tyName && isCompositeText(name)) { return emitDefinedSeq(b, name, args) }
            var flds = structFields[name]
