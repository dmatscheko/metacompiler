SkipGOther  = "\x00"..."\x21" | "\x23"..."\x26" | "\x2a"..."\x5f" | "\x61"..."\x7a" | "\x7c" | "\x7e"..."\U0010ffff" ;

// ---


:startScript(~~

    // Shared emitter machinery (module, handle constants, externs, loopStack
    // protocol, expression/statement builders); see the `core` knobs below.
    include("lib/compile-core.js")

    // ----- Operators Go has and the shared core does not -----
    // The bitwise and shift externals already exist in the handle runtime; wiring them
    // into binExt puts them on the ordinary emitBin path. js_shl/js_shr are 32 bit,
    // which is what Go's shift results are used for here.
    // These five used to be the handle runtime's 32 BIT operators (js_goshl masks
    // its count to 5 bits, js_band works on int32), so 1 << 62 was 0 and
    // 1000000007 * 1000000007 was -371520512. Every integer operator now goes
    // through the sized-integer box instead - js_giarith in abnf/jsrtint.go, which
    // evaluates at the result type's width and wraps to it. See the invariant
    // there; go-interpreter.abnf implements the identical rules with szArith.
    binExt["<<"] = "js_goshl"
    binExt[">>"] = "js_goshr"
    binExt["&"] = "js_band"
    binExt["|"] = "js_bor"
    binExt["^"] = "js_bxor"

    // Go's == on a struct or an array is VALUE equality, not identity (both are value
    // types), and nil equals an unset slice/map/pointer.
    binExt["=="] = "js_goeq"
    binExt["!="] = "js_gone"

    binExt["<<="] = "js_goshl"
    binExt[">>="] = "js_goshr"
    binExt["&="] = "js_band"
    binExt["|="] = "js_bor"
    binExt["^="] = "js_bxor"

    // Go's AND NOT used to be expanded here as 'a & (b XOR -1)' over the handle
    // runtime's js_band / js_bxor, which are 32 BIT. That silently truncated every
    // &^ on a value wider than an int32: `int64(1<<40) &^ 7` answered 0 where go
    // answers 1099511627776, and `^uint64(0) &^ 1` answered 0 where go answers
    // 18446744073709551614. Measured against real `go run` (go is installed), 4 of
    // 7 probe lines were wrong in the compiler half; the interpreter half was
    // already right because it routes &^ through szArith. js_giarith HAS a '&^'
    // arm in all three halves (abnf/jsrtint.go case "&^", runtime.c si_apply code
    // 8, and the shared si_arith the layer 2 calls), so the expansion is gone and
    // &^ / &^= go through giBase like every other bitwise operator.
    var coreEmitBin = emitBin
    emitBin = function(b, op, l, r) {
        // Only a program that mentions a complex value pays for the probe (see
        // usesComplex); every other one emits the same single extern call as before.
        if (usesComplex && cxOps[op] == 1) { return emitCxCall(b, op, l, r) }
        return emitBinNum(b, op, l, r)
    }
    // ----- Sized integers: the emitted operator set -----
    // Every arithmetic, bitwise, shift and ordered-comparison operator goes to the
    // sized-integer externs of abnf/jsrtint.go. Before, they went to the handle
    // runtime's 32-bit ones (js_band, js_goshl) or to js_jf*/intWrap, which
    // truncated to int32 - so 1 << 62 was 0, 1000000007 * 1000000007 was
    // -371520512, int64max printed 9.223372036854776e+18 and nothing on a value
    // said it was a uint8. js_giarith evaluates at the RESULT TYPE's width and
    // wraps to it, and hands a float64 operand straight on to the float path, so
    // the js_gflo box keeps working exactly as it did.
    //
    // giBase maps a compound assignment to its operator; '+' has its own extern
    // because Go's '+' also concatenates strings.
    var giBase = {"+": "+", "-": "-", "*": "*", "/": "/", "%": "%",
                  "&": "&", "|": "|", "^": "^", "&^": "&^", "<<": "<<", ">>": ">>",
                  "+=": "+", "-=": "-", "*=": "*", "/=": "/", "%=": "%",
                  "&=": "&", "|=": "|", "^=": "^", "&^=": "&^", "<<=": "<<", ">>=": ">>"}
    var giRel = {"<": "js_gilt", "<=": "js_gile", ">": "js_gigt", ">=": "js_gige"}
    // The primitive (non-complex) binary step. Used by emitBin AND by the complex
    // dispatch's fallback arm, which must not fall back to the truncating core path.
    // A SHIFT takes its result type from the LEFT operand alone - "the shift count
    // must be an unsigned integer... the result type of a shift is the type of the
    // left operand" (Go spec, Arithmetic operators). js_giarith reads the result
    // width and signedness off WHICHEVER operand is a box (giWidthOf in
    // abnf/jsrtint.go, si_width_of/si_uns_of in the floor), so a plain `int`
    // shifted by a `uint8` count came out at 8 bits UNSIGNED: `x >> s` with
    // x = -8, s = uint8(1) answered 124 where go answers -4. js_gival unboxes a
    // sized integer to its plain number and passes everything else through, so
    // putting it in front of the COUNT leaves exactly the left operand to decide
    // the type. Measured against real `go run`: 4 of 7 probe lines were wrong in
    // BOTH halves. The twin fix is in go-interpreter.abnf, which wraps the count
    // in szNum for the same reason; keep the two in step.
    var giShift = {"<<": 1, ">>": 1, "<<=": 1, ">>=": 1}
    function emitBinNum(b, op, l, r) {
        var base = giBase[op]
        if (typeof base == "string") {
            if (base == "+") { return callExt(b, "js_giadd", [l, r]) }
            if (giShift[op] == 1) { r = callExt(b, "js_gival", [r]) }
            return callExt(b, "js_giarith", [emitStr(b, base), l, r])
