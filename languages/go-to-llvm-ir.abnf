    // string, false for a bool and nil for everything else (slice, map, pointer, struct).
    function emitZeroOf(b, t) {
        if (t == undefined || t == null) { return hNull }
        if (t.indexOf("int") == 0 || t.indexOf("uint") == 0 || t.indexOf("byte") == 0
            || t.indexOf("rune") == 0 || t.indexOf("float") == 0) { return emitNum(b, 0) }
        if (t.indexOf("string") == 0) { return emitStr(b, "") }
        if (t.indexOf("bool") == 0) { return hFalse }
