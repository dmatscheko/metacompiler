    // The names the LAST short declaration bound, for the for-header's FInit tag:
    // Go 1.22 gives 'for i := 0; ...' a FRESH i per iteration, so the loop needs to
    // know which names to copy (see makeForClassic).
    var lastDeclNames = []
    function takeDeclNames() {
        var n = lastDeclNames
        lastDeclNames = []
        return n
    }
    // items = [vName, okName, baseThunk, {at}]: v gets the value (the assertion is the
    // identity on it, as for the single-result form), ok gets the dynamic type test.
    function makeTypeOk(items) {
        var vName = items[0]
        var okName = items[1]
        var baseT = items[2]
        var ty = items[3].at
        return function(b) {
            var r = baseT(b)
            b = r.b
            var okV = emitHelper(b, "$istype", [r.v, emitStr(b, ty)])
            if (vName != "_") { callExt(b, "js_scope_decl", [curScopeV, emitStr(b, vName), r.v]) }
            if (okName != "_") { callExt(b, "js_scope_decl", [curScopeV, emitStr(b, okName), okV]) }
            return b
        }
    }
    function makeShortDecl(items) {
        var names = []
        var i = 0
        for (; i < items.length; i++) {
            if (typeof items[i] != "string") break
            names.push(items[i])
        }
        lastDeclNames = names
        var exprs = items.slice(i)
        return function(b) {
            var vals = []
            for (var k = 0; k < exprs.length; k++) {
                var r = exprs[k](b)
                b = r.b
                vals.push(r.v)
            }
            if (names.length > 1 && exprs.length == 1) {
                for (var n = 0; n < names.length; n++) {
                    if (names[n] != "_") {
                        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, names[n]),
                                                     callExt(b, "js_get", [vals[0], emitNum(b, n)])])
