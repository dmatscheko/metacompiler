        if (under.indexOf("map[") == 0) {
            // The VALUE type: everything after the ']' that closes the key. Scanned by
            // hand rather than with lastIndexOf, which -frozen does not have.
            var d = -1
            for (var q = 0; q < under.length; q++) { if (under.charCodeAt(q) == 93) { d = q } }
            var zero = under.substring(d + 1)
            var mV = callExt(b, "js_dict_new", [])
            callExt(b, "js_set", [mV, emitStr(b, "zero"), emitZero(b, zero)])
