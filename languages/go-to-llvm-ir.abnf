        // runtime's complex128div is - not the textbook formula (see the division note
        // in go-interpreter.abnf). It goes to an extern rather than into emitted
        // IR because it is five branches deep; js_gocxdiv answers a plain
        // {re, im} object and the $cx is built here, so the class descriptor
        // stays in the emitter where it lives.
        var q = callExt(b, "js_gocxdiv", [lp.re, lp.im, rp.re, rp.im])
        return {b: b, v: emitNewCx(b, callExt(b, "js_get", [q, emitStr(b, "re")]),
