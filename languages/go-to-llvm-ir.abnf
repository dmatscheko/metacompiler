    // Go visibility: an identifier is exported exactly when it starts with an upper-case
    // letter.
    function isExported(name) {
        if (name.length == 0) { return false }
        var c0 = name.charCodeAt(0)
        return c0 >= 65 && c0 <= 90
    }

    // ----- Core library config (see lib/compile-core.js) -----
    core.indexExt = "js_map_get" // Polymorphic reads: slice element or map (zero value when missing).

    // Go stdlib packages the runtime provides (resolveImport lives in lib/compile-core.js;
    // exact-match paths, so sub-packages like "encoding/json" are listed in full).
    core.stdlibImports = ["fmt", "os", "errors", "bufio", "io", "time", "regexp", "path", "encoding/json", "context", "flag", "log", "reflect"]
    function fail(msg) { println("go compiler error: " + msg); exit(1) }

    // Project-file imports: import "mathbox" -> mathbox.go (a slash path like "a/b" ->
    // a/b.go), searched under the program's directory and the -i roots. The file is parsed
    // with this grammar; its top-level declaration thunks are stashed by buildMain
    // (importDepth > 0) and run at the start of jsmain in the package's own child scope
    // (goEmitImportedPkgs), which lets the package use its own names unqualified and
    // cross-file value.Method() dispatch work. buildPackages then gathers the exported
    // top-level names onto a package object (pkg.Name, like fmt/os). A file is imported
    // once; repeats and cycles are no-ops.
    core.importFile = function(path, pos) {
        var file = c.findImport(path + ".go")
        var lib = file == "" ? goLibFile(path) : ""
        if (file == "" && lib == "") { return false }
        if (lib != "") { file = lib }
        if (importedFiles["$" + file] == true) { return true }
        importedFiles["$" + file] = true
        var pname = pkgBaseName(path)
        if (pkgExports["$" + pname] == undefined) { pkgExports["$" + pname] = []; pkgOrder.push(pname) }
        importPkgOfFile["$" + file] = pname
        var savedPkg = curPkgName
        var savedWalk = goWalkPkg
        curPkgName = pname
        goWalkPkg = pname
        var text = lib != "" ? load(lib) : c.readFile(file)
        var asg = c.parse(c.agrammar, text, null, file)
        c.pushSource(file, text)
        goPrescanPkg(text, pname)
        importDepth = importDepth + 1
        // constByPos and convByPos are keyed by a source OFFSET, and an imported file is
        // parsed with its own offsets starting at zero, so each file gets its own tables
        // and its own named-constant scope. Twin of importFile in go-interpreter.abnf; see
        // there.
        var savedConsts = constByPos
        var savedCFns = cFnByPos
        var savedConvs = convByPos
        var savedScopes = cScopes
        var savedPend = cPend
        var savedPendT = cPendT
        var savedSts = stByPos
        var savedSwMarks = cSwMarks
        constByPos = {}
        cFnByPos = {}
        convByPos = {}
        stByPos = {}
        cScopes = [cFrame()]
        cPend = []
        cPendT = []
        cSwMarks = []
        c.compile(asg)
        cNotePkgConsts(pname, lib != "")
        constByPos = savedConsts
        cFnByPos = savedCFns
        convByPos = savedConvs
        cScopes = savedScopes
        cPend = savedPend
        cPendT = savedPendT
        stByPos = savedSts
        cSwMarks = savedSwMarks
        importDepth = importDepth - 1
        c.popSource()
        curPkgName = savedPkg
        goWalkPkg = savedWalk
        return true
    }

    goPrescan(c.srcSlice(0, 1073741824))
    c.compile(c.asg)

    // ----- the native build -----
    // jsdispatch(idx, env, args) is the function table a LINKED binary needs: js_closure
    // stores a raw function index, and under llvm.Run the Go runtime turns that index
    // back into a callee by looking "jsf_<idx>" up in the module. A binary has no such
    // reflection, so the module carries the mapping itself. The MISS arm calls
    // jsdispatch_ext, the same table emitted by the layer-2 runtime library
    // (lib/go-rt.ll, built by metajs-to-llvm-ir.abnf -rt-lib): its own function indices
    // are offset by a million, so the two chains cannot overlap and one js_call reaches
    // either module. Emitted ONLY for -exe, so every other run keeps the module it had.
    // This is lua-to-llvm-ir.abnf's emitDispatch, unchanged - nothing here is Go's.
    function emitDispatch() {
        var idxs = []
        var fns = []
        var i = 0
        while (i < m.Funcs.length) {
            var f = m.Funcs[i]
            var nm = f.Name()
            if (nm.length > 4 && nm.substring(0, 4) == "jsf_") {
                idxs.push(parseInt(nm.substring(4, nm.length)))
                fns.push(f)
            }
            i = i + 1
        }
        var ext = m.NewFunc("jsdispatch_ext", i64,
            [llvm.ir.NewParam("idx", i64), llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var d = m.NewFunc("jsdispatch", i64,
            [llvm.ir.NewParam("idx", i64), llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var b = d.NewBlock("entry")
        var extB = d.NewBlock("ext")
        var ownB = d.NewBlock("own")
        b.NewCondBr(b.NewICmp(llvm.enum.IPredSGE, d.Params[0], llvm.constant.NewInt(i64, 1000000)), extB, ownB)
        extB.NewRet(extB.NewCall(ext, [d.Params[0], d.Params[1], d.Params[2]]))
        b = ownB
        i = 0
        while (i < fns.length) {
            var hit = d.NewBlock("hit" + idxs[i])
            var nxt = d.NewBlock("miss" + idxs[i])
            b.NewCondBr(b.NewICmp(llvm.enum.IPredEQ, d.Params[0], llvm.constant.NewInt(i64, idxs[i])), hit, nxt)
            hit.NewRet(hit.NewCall(fns[i], [d.Params[1], d.Params[2]]))
            b = nxt
            i = i + 1
        }
        b.NewRet(b.NewCall(ext, [d.Params[0], d.Params[1], d.Params[2]]))
    }

    // The two runtime inputs live next to THIS grammar, so the build does not depend on
    // the working directory: lib/runtime.ll is the C floor and lib/go-rt.ll is Go's own
    // layer 2. An explicit -rt REPLACES both. This grammar's entry point is ALREADY
    // named jsmain, which is what the C floor's main() calls, so - unlike most other
    // languages - no one-call alias has to be emitted.
    function libPath(name) {
        var mn = moduleName()
        var cut = -1
        var i = 0
        while (i < mn.length) {
            var ch = mn.charAt(i)
            if (ch == "/" || ch == "\\") { cut = i }
            i = i + 1
        }
        return mn.substring(0, cut + 1) + "lib/" + name
    }

    if (c.exePath != undefined && c.exePath != "") {
        emitDispatch()
        var rts = c.runtime
        if (rts == undefined || rts.length == 0) { rts = [libPath("runtime.ll"), libPath("go-rt.ll")] }
        var buildErr = llvm.BuildExecutable(m, c.exePath, rts)
        if (buildErr != "") {
            println(buildErr)
            exit(1)
        }
        println("go compiler: wrote executable " + c.exePath)
        exit(0)
    }

    println(m)

    var res = llvm.RunJS(m, "jsmain")
    var entryName = c.mainName
    if (entryName == undefined || entryName == "") { entryName = "main" }
    if (mainIsSnippet(entryName)) {
        println("go compiler: -main snippet returned " + res.Ret)
    } else {
        println("go compiler: " + entryName + "() returned " + res.Ret)
    }
    exit(res.Ret)

~~) ;
