    // node's end offset), and the arithmetic levels tag every operand with its own end
    // position, so an operand that IS a conversion is recognized by an exact position
    // match. This mirrors go-interpreter.abnf exactly; keep the two in step.
    var convByPos = {}
    function regConv(pos, ty) {
        if (pos == undefined || pos == null) { return }
        if (!isFloatTy(ty) && uintBits(ty) == 0) { return }
        convByPos["p" + pos] = ty
    }
    // The key is always "p" + a number, so it can never name an Object.prototype
    // member and a bare read is safe (there is no hasOwn in compile-core).
    function tyAt(pos) {
