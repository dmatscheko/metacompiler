                var im = callExt(cb, "js_get", [x, emitStr(cb, "im")])
                var neg = callExt(cb, "js_lt", [im, emitNum(cb, 0)])
                var sg = emitSelect(cb, neg, function(tb) { return {b: tb, v: emitStr(tb, "-")} },
                                             function(eb) { return {b: eb, v: emitStr(eb, "+")} })
                var ab = emitSelect(sg.b, neg,
                                    function(tb) { return {b: tb, v: callExt(tb, "js_sub", [emitNum(tb, 0), im])} },
                                    function(eb) { return {b: eb, v: im} })
                var b2 = ab.b
                var out = callExt(b2, "js_add", [emitStr(b2, "("), re])
                out = callExt(b2, "js_add", [out, sg.v])
                out = callExt(b2, "js_add", [out, ab.v])
                out = callExt(b2, "js_add", [out, emitStr(b2, "i)")])
                return {b: b2, v: out}
