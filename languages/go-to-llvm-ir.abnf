    //   - a SIZED type zeroes to a BOX of that width, so the slot carries the width
    //     from the moment it exists and a later a[0]++ / s.b++ steps at 8 bits;
    //   - a NAMED STRUCT type zeroes to a zero INSTANCE. `var s S` used to answer
    //     nil, so the very next `s.b = 1` was a member assignment on null - the
    //     crash was not in the assignment, it was the missing zero value.
    function emitZeroTy(b, t) {
        if (t == undefined || t == null || t.length == 0) { return hNull }
        var c0 = t.charCodeAt(0)
        if (c0 == 42) { return hNull }  // *T: a nil pointer
        if (c0 == 91) {                 // []T (empty slice) or [N]T (N zero elements)
