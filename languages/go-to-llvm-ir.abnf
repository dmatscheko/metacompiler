MapValE     <~~ push({mvt: pop(), esty: stAt(up.pos)}); goLitEl(up.start, up.pos, false, "") ~~> = Expression ;
MakeMap     <~~ push(makeMakeMap(takeAll())); regSt(up.pos, goMakeTy(up.in)) ~~>
            = "make" KwEnd "(" MapTypeZ [ "," Expression ] ")" ;

// new(T): a zero value of T - a POINTER to it for a scalar type (a fresh one slot
