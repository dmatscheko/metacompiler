    function emitIsSl(b, v) { return callExt(b, "js_is_type", [v, emitStr(b, "$sl")]) }
    function emitSlHdr(b, a, o, n, c) {
        var h = callExt(b, "js_obj_new", [])
        callExt(b, "js_set", [h, emitStr(b, "__class"), callExt(b, "js_scope_get", [curScopeV, emitStr(b, "$slclass")])])
        callExt(b, "js_set", [h, emitStr(b, "a"), a])
        callExt(b, "js_set", [h, emitStr(b, "o"), o])
        callExt(b, "js_set", [h, emitStr(b, "n"), n])
        callExt(b, "js_set", [h, emitStr(b, "c"), c])
        return h
    }
