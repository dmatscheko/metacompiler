            var rr = emitRefRead(b, ref)
            b = rr.b
            return emitRefWrite(b, ref, intWrap(b, callExt(b, extName, [rr.v, emitNum(b, 1)])))
        }
    }

    // ----- Statement thunks -----

    // items = [name..., {ty}?, initThunk...]: 'var a, b = 1, 2', 'var i int' and
    // 'var q, r int' all go through here. With more names than initializers the single
    // initializer is a multi-value call and gets unpacked, like a multi assignment.
    // One spec of a grouped const: kept as a RECORD (not a thunk) so the group can
    // re-emit a spec's expression list for the specs that leave theirs out.
    function makeConstSpec(items) {
        var names = []
        var i = 0
        for (; i < items.length; i++) {
            if (typeof items[i] != "string") { break }
            names.push(items[i])
        }
        var ty = ""
        if (i < items.length && items[i] != undefined && items[i].ty != undefined) { ty = items[i].ty; i++ }
        return {names: names, ty: ty, inits: items.slice(i)}
    }
    // const ( a = iota; b; c ): iota counts the specs, and a spec with no '=' repeats
    // the previous expression list - re-emitted, so it reads the NEW iota.
    function makeConstGroup(specs) {
        return function(b) {
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "iota"), emitNum(b, 0)])
            var lastInits = []
            var lastTy = ""
            for (var i = 0; i < specs.length; i++) {
