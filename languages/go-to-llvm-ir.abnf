                                         function(tb) { return {b: tb, v: emitNum(tb, 0)} },
                                         function(eb) { return {b: eb, v: lo} })
                    var rhi = emitSelect(rlo.b, callExt(rlo.b, "js_seq", [hi, hUndef]),
                                         function(tb) { return {b: tb, v: pn.v} },
                                         function(eb) { return {b: eb, v: hi} })
                    var rmx = emitSelect(rhi.b, callExt(rhi.b, "js_seq", [mx, hUndef]),
                                         function(tb) { return {b: tb, v: pc.v} },
                                         function(eb) { return {b: eb, v: mx} })
                    var b3 = rmx.b
                    // 0 <= lo <= hi <= mx <= cap, which is Go's rule for a slice
                    // EXPRESSION - and it panics, recoverably. One extern call
                    // rather than eight compares; the raw mx (undefined in the
                    // two-index form) and isSlV choose go's panic wording.
                    callExt(b3, "js_gislbounds", [rlo.v, rhi.v, mx, pc.v, isSlV])
                    var outH = emitSlHdr(b3, pa.v,
                                         callExt(b3, "js_jadd", [po.v, rlo.v]),
                                         callExt(b3, "js_sub", [rhi.v, rlo.v]),
                                         callExt(b3, "js_sub", [rmx.v, rlo.v]))
                    callExt(b3, "js_set", [outH, emitStr(b3, "et"), callExt(b3, "js_get", [x, emitStr(b3, "et")])])
                    // SLICING A NIL SLICE KEEPS ITS NILNESS - see goSlice in
                    // languages/go-interpreter.abnf for why this is the one slice
                    // expression that propagates the mark. Copied unconditionally
                    // (js_get of an absent property is undefined, which neither
                    // goIsNilZero nor giIsNilZero reads as the mark) rather than
                    // behind a branch, so a slice expression costs one get and one
                    // set more and no basic block.
                    callExt(b3, "js_set", [outH, emitStr(b3, "__nil"), callExt(b3, "js_get", [x, emitStr(b3, "__nil")])])
                    return {b: b3, v: outH}
                })
        })
        // make([]T, n, cap): cap zero values of the element type, length n over them.
        b = declFn(b, "$smake", 4, function(fb, a) {
            var n = a[0]
            var cp = a[1]
            var zero = a[2]
            var et = a[3]
            var arr = callExt(fb, "js_arr_new", [])
            var eb = emitCountLoop(fb, cp, function(lb, iV) {
                callExt(lb, "js_arr_push", [arr, zero])
                return lb
            })
            var outH = emitSlHdr(eb, arr, emitNum(eb, 0), n, cp)
            callExt(eb, "js_set", [outH, emitStr(eb, "et"), et])
            return {b: eb, v: outH}
        })
        // append(s, v...): writes into the backing array when the capacity allows (so
        // another slice over it sees the new element, like Go) and reallocates when not.
        b = declFn(b, "append", 0, function(fb, a, f) {
            var argsV = f.Params[1]
            var s0 = callExt(fb, "js_arg", [argsV, handle(0)])
            var add = callExt(fb, "js_sub", [callExt(fb, "js_golen", [argsV]), emitNum(fb, 1)])
            var isSlV = emitIsSl(fb, s0)
            // A nil slice starts a new backing array; a plain array is its own backing.
            var baseR = emitSelect(fb, callExt(fb, "js_not", [s0]),
                                   function(tb) { return {b: tb, v: callExt(tb, "js_arr_new", [])} },
                                   function(eb) { return {b: eb, v: s0} })
            var b2 = baseR.b
            var ha = emitSelect(b2, isSlV, function(tb) { return {b: tb, v: slF(tb, s0, "a")} },
                                           function(eb) { return {b: eb, v: baseR.v} })
            var ho = emitSelect(ha.b, isSlV, function(tb) { return {b: tb, v: slF(tb, s0, "o")} },
                                             function(eb) { return {b: eb, v: emitNum(eb, 0)} })
            var hn = emitSelect(ho.b, isSlV, function(tb) { return {b: tb, v: slF(tb, s0, "n")} },
                                             function(eb) { return {b: eb, v: callExt(eb, "js_golen", [baseR.v])} })
            var hc = emitSelect(hn.b, isSlV, function(tb) { return {b: tb, v: slF(tb, s0, "c")} },
                                             function(eb) { return {b: eb, v: callExt(eb, "js_golen", [baseR.v])} })
            var b3 = hc.b
            var need = callExt(b3, "js_jadd", [hn.v, add])
            // {a, o, c} of the array the result writes into, as a three element array.
            var grown = emitSelect(b3, callExt(b3, "js_gt", [need, hc.v]), function(tb) {
                var na = callExt(tb, "js_arr_new", [])
                var eb2 = emitCountLoop(tb, hn.v, function(lb, iV) {
                    callExt(lb, "js_arr_push", [na, callExt(lb, "js_map_get",
                            [ha.v, callExt(lb, "js_jadd", [ho.v, iV])])])
                    return lb
                })
                var etZ = emitSelect(eb2, isSlV, function(tb) { return {b: tb, v: slF(tb, s0, "et")} },
                                                 function(eb) { return {b: eb, v: hUndef} })
                // A GROWING append OVER-ALLOCATES: the new capacity is
                // max(2 * old cap, need, 4), the rule hostGlobals["append"] in
                // languages/go-interpreter.abnf uses. Growing to exactly the new
                // length would make cap(s) == len(s) after every append, so two
                // appends onto one base would never share a backing array as they
                // do in Go, and an append loop would copy on every element.
                var dbl = callExt(etZ.b, "js_jadd", [hc.v, hc.v])
                var c1 = emitSelect(etZ.b, callExt(etZ.b, "js_lt", [dbl, need]),
                                    function(tb) { return {b: tb, v: need} },
                                    function(fb2) { return {b: fb2, v: dbl} })
                var c2 = emitSelect(c1.b, callExt(c1.b, "js_lt", [c1.v, emitNum(c1.b, 4)]),
                                    function(tb) { return {b: tb, v: emitNum(tb, 4)} },
                                    function(fb2) { return {b: fb2, v: c1.v} })
                var fill = callExt(c2.b, "js_sub", [c2.v, hn.v])
                var eb3 = emitCountLoop(c2.b, fill, function(lb, iV) {
                    callExt(lb, "js_arr_push", [na, callExt(lb, "js_giadopt", [etZ.v, emitNum(lb, 0)])])
                    return lb
                })
                var trip = callExt(eb3, "js_arr_new", [])
                callExt(eb3, "js_arr_push", [trip, na])
                callExt(eb3, "js_arr_push", [trip, emitNum(eb3, 0)])
                callExt(eb3, "js_arr_push", [trip, c2.v])
                return {b: eb3, v: trip}
            }, function(eb) {
                var trip = callExt(eb, "js_arr_new", [])
                callExt(eb, "js_arr_push", [trip, ha.v])
                callExt(eb, "js_arr_push", [trip, ho.v])
                callExt(eb, "js_arr_push", [trip, hc.v])
                return {b: eb, v: trip}
            })
            var b4 = grown.b
            var ra = callExt(b4, "js_map_get", [grown.v, emitNum(b4, 0)])
            var ro = callExt(b4, "js_map_get", [grown.v, emitNum(b4, 1)])
            var rc = callExt(b4, "js_map_get", [grown.v, emitNum(b4, 2)])
            // The element type is not written at an append site, so it comes off the
            // header: `var bs []uint8` is EMPTY, and an empty slice has no element to
            // take a width from. js_giadopt is the identity when there is no "et".
            var etV = emitSelect(b4, isSlV, function(tb) { return {b: tb, v: slF(tb, s0, "et")} },
                                            function(eb) { return {b: eb, v: hUndef} })
            var b4b = etV.b
            var b5 = emitCountLoop(b4b, add, function(lb, iV) {
                callExt(lb, "js_gisetat", [ra, callExt(lb, "js_jadd", [callExt(lb, "js_jadd", [ro, hn.v]), iV]),
                                         callExt(lb, "js_giadopt", [etV.v,
                                             callExt(lb, "js_map_get", [argsV, callExt(lb, "js_jadd", [iV, emitNum(lb, 1)])])])])
                return lb
            })
            var outH = emitSlHdr(b5, ra, ro, need, rc)
            callExt(b5, "js_set", [outH, emitStr(b5, "et"), etV.v])
            // append(s) WITH NOTHING TO ADD IS s ITSELF in Go - same pointer, length
            // and capacity - so `var a []int; append(a) == nil` is true, and a fresh
            // header would lose the __nil mark. Guarded on add == 0 rather than copied
            // unconditionally: a nil slice that HAS grown is not nil any more.
            // The twin is hostGlobals["append"] in languages/go-interpreter.abnf.
            var nilR = emitSelect(b5, callExt(b5, "js_seq", [add, emitNum(b5, 0)]),
                                  function(tb) { return {b: tb, v: callExt(tb, "js_get", [s0, emitStr(tb, "__nil")])} },
                                  function(eb) { return {b: eb, v: hUndef} })
            callExt(nilR.b, "js_set", [outH, emitStr(nilR.b, "__nil"), nilR.v])
            return {b: nilR.b, v: outH}
        })
        // copy(dst, src): as many elements as the shorter one holds. It is a
        // memmove: when dst starts later in the same backing array than src, the
        // elements are copied from the last one down. Twin of hostGlobals["copy"]
        // in go-interpreter.abnf.
        b = declFn(b, "copy", 2, function(fb, a) {
            var d = a[0]
            var sc2 = a[1]
            var dn = emitHelper(fb, "len", [d])
            var sn = emitHelper(fb, "len", [sc2])
            var nr = emitSelect(fb, callExt(fb, "js_lt", [dn, sn]),
                                function(tb) { return {b: tb, v: dn} },
                                function(eb) { return {b: eb, v: sn} })
            var both = emitSelect(nr.b, emitIsSl(nr.b, d),
                                  function(tb) { return {b: tb, v: emitIsSl(tb, sc2)} },
                                  function(eb) { return {b: eb, v: hFalse} })
            var back = emitSelect(both.b, both.v,
                                  function(tb) {
                                      var same = emitSelect(tb, callExt(tb, "js_seq", [slF(tb, d, "a"), slF(tb, sc2, "a")]),
                                                            function(t2) { return {b: t2, v: callExt(t2, "js_gt", [slF(t2, d, "o"), slF(t2, sc2, "o")])} },
                                                            function(e2) { return {b: e2, v: hFalse} })
                                      return same
                                  },
                                  function(eb) { return {b: eb, v: hFalse} })
            var last = callExt(back.b, "js_sub", [nr.v, emitNum(back.b, 1)])
            var done = emitSelect(back.b, back.v,
                                  function(tb) {
                                      return {b: emitCountLoop(tb, nr.v, function(lb, iV) {
                                          var jV = callExt(lb, "js_sub", [last, iV])
                                          emitHelper(lb, "$sset", [d, jV, emitHelper(lb, "$sidx", [sc2, jV])])
                                          return lb
                                      }), v: hUndef}
                                  },
                                  function(eb) {
                                      return {b: emitCountLoop(eb, nr.v, function(lb, iV) {
                                          emitHelper(lb, "$sset", [d, iV, emitHelper(lb, "$sidx", [sc2, iV])])
                                          return lb
                                      }), v: hUndef}
                                  })
            return {b: done.b, v: nr.v}
        })
        // clear(m) empties a map; clear(s) zeroes a slice's elements in place.
        b = declFn(b, "clear", 0, function(fb, a, f) {
            var argsV = f.Params[1]
            var x = callExt(fb, "js_arg", [argsV, handle(0)])
            return emitSelect(fb, emitIsSl(fb, x), function(tb) {
                var eb2 = emitCountLoop(tb, slF(tb, x, "n"), function(lb, iV) {
                    emitHelper(lb, "$sset", [x, iV, emitNum(lb, 0)])
                    return lb
                })
                return {b: eb2, v: hUndef}
            }, function(eb) { callExt(eb, "js_goclear", [argsV]); return {b: eb, v: hUndef} })
        })
        // A Go ARRAY is a value: assigning it copies, and the copy is deep because an
        // element that is itself an array is a value too. A header, map or struct
        // passes through.
        b = declFn(b, "$acopy", 1, function(fb, a) {
            var x = a[0]
            return emitSelect(fb, callExt(fb, "js_gotypeis", [x, emitStr(fb, "slice")]), function(pb) {
                var out = callExt(pb, "js_arr_new", [])
                var eb2 = emitCountLoop(pb, callExt(pb, "js_golen", [x]), function(lb, iV) {
                    callExt(lb, "js_arr_push", [out, emitHelper(lb, "$acopy",
                            [callExt(lb, "js_map_get", [x, iV])])])
                    return lb
                })
                return {b: eb2, v: out}
            }, function(eb) { return {b: eb, v: x} })
        })
        // The dynamic type of a slice is the type of its BACKING array, so a type
        // switch and a type assertion keep seeing "slice" (and "any") through a header.
        b = declFn(b, "$istype", 2, function(fb, a) {
            var x = a[0]
            var t = a[1]
            var r = emitSelect(fb, emitIsSl(fb, x),
                               function(tb) { return {b: tb, v: slF(tb, x, "a")} },
                               function(eb) { return {b: eb, v: x} })
            return {b: r.b, v: callExt(r.b, "js_gotypeis", [r.v, t])}
        })
        return b
    }

    // fmt.Println / Print / Sprint / Printf / Sprintf and the two BUILTINS
    // println / print. Each is a one-line generated function that hands the
    // callee's whole argument array to one of the three Go rendering externs in
    // abnf/jsrtgolang.go, together with the mode that selects Go's spacing rule:
    //
    //     0 fmt.Println      space between every pair,      newline
    //     1 fmt.Print/Sprint space between two non-strings, no newline
    //     2 builtin println  space between every pair,      newline
    //     3 builtin print    no space at all,               no newline
    //     4 Printf/Sprintf   args[0] is the format,         no newline
    //
    // Binding them to the shared `println` host function instead would reach Go's
    // own %v with the RAW runtime value (a map would print its __dict record, a
    // struct its class descriptor). The extern is the twin of the interpreter's
    // gstr; see "recurring shape 1" in docs/abnf-dialect-gotchas.md.
    //
    // `target` is the object the name is set on (the fmt package object), or null
    // for a builtin, which is DECLARED in the jsmain scope and so shadows the host
    // function of the same name for the compiled program only.
    function declPrint(b, target, name, ext, mode) {
        funcCount++
        var idx = funcCount
        var f = m.NewFunc("jsf_" + idx, i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var fb = f.NewBlock("entry")
        fb.NewRet(callExt(fb, ext, [f.Params[1], emitNum(fb, mode)]))
        var cl = callExt(b, "js_closure", [handle(idx), curScopeV])
        if (target == null) { callExt(b, "js_scope_decl", [curScopeV, emitStr(b, name), cl]) }
        else { callExt(b, "js_set", [target, emitStr(b, name), cl]) }
        return b
    }

    // fmt.Fprint / Fprintln / Fprintf(w, ...): the text Sprint / Sprintln / Sprintf
    // make of the other arguments, handed to w.Write as a []byte - Go's io.Writer
    // contract - and the answer is Write's. Twin of the Fprint arms of
    // hostGlobals["fmt"] in go-interpreter.abnf.
    function declFprint(b, target, name, mode) {
        funcCount++
        var idx = funcCount
        var f = m.NewFunc("jsf_" + idx, i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var fb = f.NewBlock("entry")
        var argsV = f.Params[1]
        var s = callExt(fb, "js_gostr", [callExt(fb, "js_goslice", [argsV, emitNum(fb, 1), hUndef]), emitNum(fb, mode)])
        var bs = emitSlT(fb, emitSlOf(fb, callExt(fb, "js_goconv", [emitStr(fb, "[]byte"), s])), "byte")
        var wa = callExt(fb, "js_arr_new", [])
        callExt(fb, "js_arr_push", [wa, bs])
        fb.NewRet(callExt(fb, "js_gomcall", [callExt(fb, "js_arg", [argsV, handle(0)]), emitStr(fb, "Write"), wa]))
        callExt(b, "js_set", [target, emitStr(b, name), callExt(b, "js_closure", [handle(idx), curScopeV])])
        return b
    }
    // os.Stdout / os.Stderr: writers whose Write and WriteString print through
    // js_gofdwrite and answer (bytes written, nil). Twin of goOsFile in
    // go-interpreter.abnf.
    function declOsFile(b, osV, name, fd) {
        var fo = callExt(b, "js_obj_new", [])
        var wn = "$" + name + ".Write"
        var sn = "$" + name + ".WriteString"
        b = declFn(b, wn, 1, function(fb, a) {
            var s = callExt(fb, "js_goconv", [emitStr(fb, "string"), emitHelper(fb, "$sels", [a[0]])])
            callExt(fb, "js_gofdwrite", [emitNum(fb, fd), s])
            return {b: fb, v: emitWrote(fb, emitHelper(fb, "len", [a[0]]))}
        })
        b = declFn(b, sn, 1, function(fb, a) {
            callExt(fb, "js_gofdwrite", [emitNum(fb, fd), a[0]])
            return {b: fb, v: emitWrote(fb, callExt(fb, "js_golen", [a[0]]))}
        })
        callExt(b, "js_set", [fo, emitStr(b, "Write"), callExt(b, "js_scope_get", [curScopeV, emitStr(b, wn)])])
        callExt(b, "js_set", [fo, emitStr(b, "WriteString"), callExt(b, "js_scope_get", [curScopeV, emitStr(b, sn)])])
        callExt(b, "js_set", [osV, emitStr(b, name), fo])
        return b
    }
    // (n, nil): a two-result answer, marked the way every multi-value result is.
    function emitWrote(b, n) {
        var arr = callExt(b, "js_arr_new", [])
        callExt(b, "js_arr_push", [arr, n])
        callExt(b, "js_arr_push", [arr, hNull])
        return usesMultiRet ? emitMvWrap(b, arr) : arr
    }

    // ----- Pointers -----
    // A pointer to a variable is a CELL: a tiny class instance named "$ptr" carrying
    // the scope that holds the variable (o) and its name (k). The class shape is what
    // makes the two probes work - js_goiscls answers false on a number instead of
    // aborting, and js_goeq compares the declared fields, so two cells built for the same
    // variable (p == &n) compare equal. new(int) gets a fresh one slot scope instead.
    // This mirrors the interpreter's makePtr/isPtr exactly; keep the two in step.
    function emitPtrClass(b) { return b.NewLoad(i64, ptrClassG()) }
    // A pointer to a fresh variable holding t's value (go-constfold.js, goAddrC), the
    // cell new(T) makes. Twin of goCellThunk in go-interpreter.abnf.
    function goCellThunk(t) {
        return function(b) {
            var r = t(b)
            var box = callExt(r.b, "js_scope_new", [hUndef])
            callExt(r.b, "js_scope_decl", [box, emitStr(r.b, "v"), r.v])
            return {b: r.b, v: emitPtrCell(r.b, box, emitStr(r.b, "v"))}
        }
    }
    function emitPtrCell(b, scopeV, nameV) {
        var o = callExt(b, "js_obj_new", [])
        callExt(b, "js_set", [o, emitStr(b, "__class"), emitPtrClass(b)])
        callExt(b, "js_set", [o, emitStr(b, "o"), scopeV])
        callExt(b, "js_set", [o, emitStr(b, "k"), nameV])
        return o
    }
    function emitIsPtr(b, v) { return callExt(b, "js_goiscls", [v, emitPtrClass(b)]) }
    // A value-level if/else: both arms are emitted into their own blocks and joined
    // with a phi, the same shape makeOrAnd uses for the short-circuit operators.
    function emitSelect(b, condV, thenFn, elseFn) {
        var thenB = curF.NewBlock("")
        var elseB = curF.NewBlock("")
        var mergeB = curF.NewBlock("")
        b.NewCondBr(truthy(b, condV), thenB, elseB)
        var tr = thenFn(thenB)
        tr.b.NewBr(mergeB)
        var er = elseFn(elseB)
        er.b.NewBr(mergeB)
        var phi = mergeB.NewPhi([llvm.ir.NewIncoming(tr.v, tr.b), llvm.ir.NewIncoming(er.v, er.b)])
        return {b: mergeB, v: phi}
    }
    // js_gounctl, LOWERED INTO THE EMITTER.
    // The completion value of a body closure: a return signal carries the returned
    // value, a body that ran off its end yields undefined. A control signal is the
    // FLOOR's private tag-10 cell and there is no host builtin that opens one, so
    // layer 2 could not write this extern at all - exactly the position a scope probe
    // is in, and with the same answer: js_ctl_kind and js_ctl_value ARE floor externs
    // and an EMITTER may call them. js_ctl_kind answers a RAW INTEGER (mk_ctl's fa
    // field; 0 for anything that is not a signal), so the test is an icmp against 1
    // and not truthy(), which would also take kinds 2 and 3.
    function emitUnctl(b, v) { return emitUnctlRets(b, v, []) }
    // The NO-SIGNAL arm answers the zero values of the declared result types, and
    // that arm is reachable exactly one way in a function that declares results: its
    // panic was RECOVERED, so the body never produced a return signal. Go says such a
    // call answers the zero values. rtl empty keeps hUndef, which is what a function
    // with no results wants.
    //
    // The zeros are built INSIDE the else block, not before the branch: emitZeroTy
    // emits instructions, and a value materialised before the phi's own block would
    // put an instruction ahead of the phi - which llvm.Run accepts and clang rejects
    // with "PHI nodes not grouped at top of basic block" (manual chapter 4).
    function emitUnctlRets(b, v, rtl) {
        var kind = callExt(b, "js_ctl_kind", [v])
        var thenB = curF.NewBlock("")
        var elseB = curF.NewBlock("")
        var mergeB = curF.NewBlock("")
        b.NewCondBr(b.NewICmp(llvm.enum.IPredEQ, kind, llvm.constant.NewInt(i64, 1)), thenB, elseB)
        var tv = callExt(thenB, "js_ctl_value", [v])
        // An UNNAMED result adopts its declared type when it is nil, exactly as a
        // named one does in readRets (`func f() map[string]int { return nil }`
        // prints `map[]`). Static: emitRetNil is the identity for every type but a
        // map or a slice.
        if (rtl.length == 1) {
            var r1 = emitRetNil(thenB, rtl[0], tv)
            thenB = r1.b
            tv = r1.v
        } else if (rtl.length > 1) {
            // `return f()` FORWARDS a multi-value result, so what arrives here is
            // already marked; emitMvArr normalises it back to the plain array the
            // element adoption and the re-wrap both want (see emitMvWrap).
            tv = emitMvArr(thenB, tv)
            for (var q = 0; q < rtl.length; q++) {
                if (goNilAdoptTy(rtl[q]) == "") { continue }
                var rq = emitRetNil(thenB, rtl[q], callExt(thenB, "js_get", [tv, emitNum(thenB, q)]))
                thenB = rq.b
                callExt(thenB, "js_pyset", [tv, emitNum(thenB, q), rq.v])
            }
            tv = emitMvWrap(thenB, tv)
        }
        thenB.NewBr(mergeB)
        var ev = hUndef
        if (rtl.length == 1) { ev = emitZeroTy(elseB, rtl[0]) }
        else if (rtl.length > 1) {
            ev = callExt(elseB, "js_arr_new", [])
            for (var z = 0; z < rtl.length; z++) {
                callExt(elseB, "js_arr_push", [ev, emitZeroTy(elseB, rtl[z])])
            }
            ev = emitMvWrap(elseB, ev)
        }
        elseB.NewBr(mergeB)
        var phi = mergeB.NewPhi([llvm.ir.NewIncoming(tv, thenB), llvm.ir.NewIncoming(ev, elseB)])
        return {b: mergeB, v: phi}
    }
