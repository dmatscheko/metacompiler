        var i = 0
        var depth = 0
        var cc = 0
        while (i < 8192) {
            cc = c.peek(i)
            if (cc < 0) { break }
            if (cc === 34 || cc === 39 || cc === 96) {
                var q = cc
                i++
                while (i < 8192) {
                    var d = c.peek(i)
                    if (d < 0 || d === q) { break }
                    if (d === 92 && q !== 96) { i++ }
                    i++
