                                                      callExt(b, "js_sub", [lp.im, rp.im]))} }
        if (op == "*") {
            var ac = callExt(b, "js_mul", [lp.re, rp.re])
            var bd = callExt(b, "js_mul", [lp.im, rp.im])
            var ad = callExt(b, "js_mul", [lp.re, rp.im])
            var bc = callExt(b, "js_mul", [lp.im, rp.re])
            return {b: b, v: emitNewCx(b, callExt(b, "js_sub", [ac, bd]), callExt(b, "js_jadd", [ad, bc]))}
        }
        var den = callExt(b, "js_jadd", [callExt(b, "js_mul", [rp.re, rp.re]),
                                         callExt(b, "js_mul", [rp.im, rp.im])])
        var nr = callExt(b, "js_jadd", [callExt(b, "js_mul", [lp.re, rp.re]),
                                        callExt(b, "js_mul", [lp.im, rp.im])])
        var ni = callExt(b, "js_sub", [callExt(b, "js_mul", [lp.im, rp.re]),
                                       callExt(b, "js_mul", [lp.re, rp.im])])
