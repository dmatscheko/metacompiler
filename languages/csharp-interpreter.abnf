        // 'f += g' on delegates combines their invocation lists.
        if (csHasDeleg && csIsDelegVal(r)) { return csDelegAdd(l, r) }
        if (csIsFlo(l) || csIsFlo(r)) { return csFlo(csNumD(l) + csNumD(r)) }
        var a = anytype
        var b = anytype
        a = csNumV(l)
        b = csNumV(r)
        if ((a | 0) == a && (b | 0) == b) { return (a + b) | 0 }
        return a + b
