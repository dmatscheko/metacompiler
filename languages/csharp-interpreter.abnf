        if (p.k == "const") { return csEq(p.t(), v) }
        if (p.k == "rel") { return binOp(p.op, v, p.t()) }
        if (p.k == "type") {
            if (p.ty != "" && !csIsType(v, p.ty)) { return false }
            if (p.bind != "") { declVar(p.bind, v) }
            return true
        }
        if (p.k == "prop") {
