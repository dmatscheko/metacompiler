    // trailing layout, so cut between the first and the last quote rather than stripWs -
    // a literal space or tab char would not survive that).
    function makeCharLit(text) {
        var a = 0
        while (a < text.length && text.charAt(a) != "'") { a++ }
        var z = text.length - 1
        while (z > a && text.charAt(z) != "'") { z-- }
        var dec = unescapeJs(text.substring(a + 1, z))
        return makeConst(csChar(dec.length > 0 ? dec.charCodeAt(0) : 0))
    }

