    // shortest round-tripping digits, NO trailing ".0" for an integral value, and the
    // NumberFormatInfo.InvariantInfo symbols "Infinity" / "-Infinity" / "NaN".
    // Scientific notation starts outside [1e-5, 1e15).
    function csFloStr(d) {
        if (d !== d) return "NaN"
        if (d === csInf) return "Infinity"
        if (d === csNegF(csInf)) return "-Infinity"
        if (d === 0) return (1 / d < 0) ? "-0" : "0"
        var neg = d < 0
        var a = neg ? csNegF(d) : d
        var s = (a >= 0.00001 && a < 1000000000000000) ? csFloPlain(a) : csFloSci(a)
        return neg ? "-" + s : s
    }
    function csFloPlain(a) {
        var s = "" + a
        // The host switches to exponent form at 1e21; inside this range it does not.
        return s
    }
    function csFloSci(a) {
        var s = "" + a
        var mant = s
        var exp = 0
        var ei = 0 - 1
        for (var i = 0; i < s.length; i++) { if (s.charAt(i) == "e" || s.charAt(i) == "E") { ei = i } }
        if (ei >= 0) {
            mant = s.substring(0, ei)
            var et = s.substring(ei + 1)
            if (et.charAt(0) == "+") { et = et.substring(1) }
            exp = parseInt(et, 10)
        }
        var digits = ""
        var pt = 0 - 1
        for (var j = 0; j < mant.length; j++) {
            var ch = mant.charAt(j)
            if (ch == ".") { pt = digits.length } else { digits = digits + ch }
        }
        if (pt < 0) { pt = digits.length }
        var lead = 0
        while (lead < digits.length - 1 && digits.charAt(lead) == "0") { lead++ }
        digits = digits.substring(lead)
        pt = pt - lead
        var endz = digits.length
        while (endz > 1 && digits.charAt(endz - 1) == "0") { endz-- }
        digits = digits.substring(0, endz)
        var frac = digits.substring(1)
        var e10 = pt + exp - 1
        var es = e10 < 0 ? (0 - e10) : e10
        var etx = "" + es
        if (es < 10) { etx = "0" + etx }
