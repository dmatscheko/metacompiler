    function csMatchPat(p, v) {
        var i
        if (p.k == "or") {
            var po = p.ps
            for (i = 0; i < po.length; i++) { if (csMatchPat(po[i], v)) { return true } }
            return false
        }
        if (p.k == "and") {
            var pa = p.ps
            for (i = 0; i < pa.length; i++) { if (!csMatchPat(pa[i], v)) { return false } }
            return true
        }
