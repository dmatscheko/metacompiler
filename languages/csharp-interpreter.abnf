    // promotion).
    function csFloOp(op, l, r) {
        var a = csNumD(l)
        var b = csNumD(r)
        if (op == "+")  return csFlo(a + b)
        if (op == "-")  return csFlo(a - b)
        if (op == "*")  return csFlo(a * b)
        if (op == "/")  return csFlo(a / b)
        if (op == "%")  return csFlo(a % b)
        if (op == "==") return a == b
        if (op == "!=") return a != b
        if (op == "<")  return a < b
        if (op == ">")  return a > b
        if (op == "<=") return a <= b
        if (op == ">=") return a >= b
