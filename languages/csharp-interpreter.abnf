        if (ty == "bool") { dflt = false }
        else if (isNum && ty.indexOf("[") < 0) { dflt = 0 }
        return {kind: "field", name: name, statik: isStatic, init: init, dflt: dflt}
    }
    function makeIndexer(items) {
