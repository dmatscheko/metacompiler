    }
    function csIsRecObj(v) {
        return v !== null && v !== undefined && typeof v == "object"
            && v.__class != undefined && v.__class.__isrecord === true
    }
    function csRecEq(l, r) {
        if (l.__class !== r.__class) { return false }
        var ks = l.__class.__fieldNames
        for (var i = 0; i < ks.length; i++) { if (!csEq(l[ks[i]], r[ks[i]])) { return false } }
        return true
    }
    function csTupEq(l, r) {
        var n = l.__tuple
        if (n !== r.__tuple) { return false }
        for (var i = 0; i < n; i++) {
            if (!csEq(l["Item" + (i + 1)], r["Item" + (i + 1)])) { return false }
        }
        return true
    }
