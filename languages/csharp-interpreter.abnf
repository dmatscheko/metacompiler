    // 1.0 and 1 would both be the JS number 1: 1.0 / 3.0 divided as integers (0
    // instead of 0.3333333333333333) and there was no Infinity, no NaN and no -0.0.
    // Boxing every floating-point value keeps them apart, exactly like csChar keeps a
    // char apart from its code and like the compiled half's js_csflo box (see
    // abnf/jsrtjvm.go). Invariant: a PLAIN number is an integral type, a {__flo} box
    // is a double/float/decimal.
    var csNegOne = 0 - 1
    var csZeroF = 0
    var csInf = 1 / csZeroF
    function csFlo(f) { return {__flo: f} }
    function csIsFlo(v) { return v !== null && v !== undefined && typeof v == "object" && v.__flo !== undefined }
    function csNumD(v) {
        if (v === null || v === undefined) return v
        if (typeof v == "object") {
            if (v.__flo !== undefined) return v.__flo
            if (v.__char !== undefined) return v.__char
        }
        return v
    }
    function csNegF(f) { return f * csNegOne }
