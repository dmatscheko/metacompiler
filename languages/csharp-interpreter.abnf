        for (i = 0; i < elems.length; i++) { if (elems[i].k == "slice") { si = i } }
        if (si < 0) {
            if (n != elems.length) { return false }
            for (i = 0; i < n; i++) { if (!csMatchPat(elems[i], v[i])) { return false } }
            if (p.bind != "") { declVar(p.bind, v) }
            return true
        }
        var head = si
        var tail = elems.length - si - 1
        if (n < head + tail) { return false }
        for (i = 0; i < head; i++) { if (!csMatchPat(elems[i], v[i])) { return false } }
        for (i = 0; i < tail; i++) { if (!csMatchPat(elems[si + 1 + i], v[n - tail + i])) { return false } }
