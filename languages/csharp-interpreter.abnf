    // declared in the enclosing scope the moment it matches, as C# does ('o is string s'
    // makes s usable in the rest of the expression and after it).
    function csPatOr(items) { return items.length == 1 ? items[0] : {k: "or", ps: items} }
    function csPatAnd(items) { return items.length == 1 ? items[0] : {k: "and", ps: items} }
    function csPatNot(p) { return {k: "not", p: p} }
    function csPatNull() { return {k: "null"} }
    function csPatDiscard() { return {k: "discard"} }
    function csPatRel(items) { return {k: "rel", op: items[0], t: items[1]} }
    function csPatConst(t) { return {k: "const", t: t} }
