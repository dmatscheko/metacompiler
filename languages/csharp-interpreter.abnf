        return p
    }
    function csPatProp(items) {
        var p = {k: "prop", ty: "", bind: "", subs: []}
        var subs = []
        for (var i = 0; i < items.length; i++) {
            var it = items[i]
            if (it.patty != undefined) { p.ty = it.patty; continue }
            if (it.patbind != undefined) { p.bind = it.patbind; continue }
            subs.push(it)
        }
        p.subs = subs
        return p
    }
    function csPatPos(items) {
        var p = {k: "pos", ty: "", bind: "", subs: []}
        var subs = []
        for (var i = 0; i < items.length; i++) {
            var it = items[i]
            if (it.patty != undefined) { p.ty = it.patty; continue }
            if (it.patbind != undefined) { p.bind = it.patbind; continue }
            subs.push(it)
        }
        p.subs = subs
        return p
    }
    function csPatList(items) {
        var p = {k: "list", bind: "", elems: []}
        var el = []
        for (var i = 0; i < items.length; i++) {
