    // True as soon as the program declares an indexer, so the index read of a program that
    // declares none costs one boolean rather than a class-chain walk.
    var csHasIndexer = false
    // An accessor member ('__get_X', '__index', ...) looked up along the class chain. A
    // class descriptor answers its own static members, an instance its class' ones.
    function csEvtKey(op) { return (op == "+=") ? "__add_" : "__remove_" }
    function csFindAcc(o, key) {
        if (o === undefined || o === null || typeof o != "object") { return undefined }
        if (o.__isclass === true) { return hasOwn(o, key) ? o[key] : undefined }
        for (var c = o.__class; c != undefined; c = c.__super) { if (hasOwn(c, key)) { return c[key] } }
