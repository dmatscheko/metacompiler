// The parameter list may be omitted entirely ('delegate { ... }'), which in C# means
// 'whatever this delegate type takes, ignored' - here an empty parameter list.
AnonMethod  = AnonParams | AnonBare ;
AnonParams  <~~ push(makeLambda(takeAll())) ~~>
            = KwDelegate ParamList LamBlock ;
AnonBare    <~~ push(makeBareAnon(takeAll())) ~~>
            = KwDelegate LamBlock ;
LambdaBody  = LamBlock | LamExpr ;
LamBlock    <~~ push({body: pop()}) ~~> = Block ;
LamExpr     <~~ push({ebody: pop()}) ~~> = Expression ;
// A LINQ query expression: accepted, reported as not implemented.
LinqQuery   <~~ push(makeLinq(up.pos)) ~~>
            = KwFrom Id KwIn DiscardExpr LinqTail ;
LinqTail    = { LinqClause } KwSelect DiscardExpr ;
LinqClause  = KwWhere DiscardExpr | KwOrderby DiscardExpr | KwLet Id "=" DiscardExpr ;
DiscardExpr <~~ pop() ~~>
            = Expression ;

Null        <~~ push(makeConst(null)) ~~>  = "null" KwEnd ;


// $"...{expr}..." interpolated string; a plain "..." (DqString) does not interpolate.
// A hole may carry an alignment ('{x,4}' pads to width 4, a negative width pads on the
// right) and a format specifier ('{x:D3}' is the decimal form zero-padded to 3 digits).
// '{{' and '}}' are the escaped braces. IsBrace comes first so '{{' is never read as the
// start of a hole.
InterpStr   <~~ push(makeTemplate(takeAll())) ~~>
            = "$" '"' :whitespace() { IsBrace | IsExpr | IsChunk } '"' :whitespace(Whitespace) ;
IsBrace     <~~ push({s: up.in.substring(0, 1)}) ~~>
            = "{" "{" | "}" "}" ;
IsExpr      <~~ push(makeIsExpr(takeAll())) ~~>
            = "{" :whitespace(Whitespace) Expression [ IsAlign ] [ IsFmt ] :whitespace() "}" ;
IsAlign     <~~ push({align: parseInt(stripWs(up.in).substring(1))}) ~~>
            = "," :whitespace() IsAlignN :whitespace(Whitespace) ;
IsAlignN    = "-" IsDigit { IsDigit } | IsDigit { IsDigit } ;
IsDigit     = "0"..."9" ;
IsFmt       <~~ push({fmt: up.in.substring(1)}) ~~>
            = ":" :whitespace() IsFmtCh { IsFmtCh } :whitespace(Whitespace) ;
IsFmtCh     = "\x20"..."\x7a" | "\x7c" | "\x7e"..."\U0010ffff" ;
IsChunk     <~~ push({s: unescapeJs(up.in)}) ~~>
            = IsChar { IsChar } ;
IsChar      = IsEsc | IsPlain ;
IsEsc       = "\\" "\x20"..b"\x7e" ;
IsPlain     = "\x20"..."\x21" | "\x23"..."\x5b" | "\x5d"..."\x7a" | "\x7c" | "\x7e"..."\U0010ffff" | @"\t" ;

// ----- Widened surface: generics, casts, unsupported declarations (see :description) -----

// Balanced skips let a construct be ACCEPTED without being understood. String and char
// literals are matched first so braces/brackets inside them are never miscounted.
SkipBlock   = "{" { SkipItem } "}" ;
SkipItem    = SkipStr | SkipChar | SkipBlock | SkipOther ;
SkipStr     = '"' :whitespace() { SkipStrEsc | SkipStrChar } '"' :whitespace(Whitespace) ;
SkipStrEsc  = "\\" "\x00"..."\U0010ffff" ;
SkipStrChar = "\x00"..."\x21" | "\x23"..."\x5b" | "\x5d"..."\U0010ffff" ;
SkipChar    = "'" :whitespace() { SkipChEsc | SkipChChar } "'" :whitespace(Whitespace) ;
SkipChEsc   = "\\" "\x00"..."\U0010ffff" ;
SkipChChar  = "\x00"..."\x26" | "\x28"..."\x5b" | "\x5d"..."\U0010ffff" ;
SkipOther   = "\x00"..."\x21" | "\x23"..."\x26" | "\x28"..."\x7a" | "\x7c" | "\x7e"..."\U0010ffff" ;

// A balanced < ... > run (generic parameters / arguments), parsed and ignored.
SkipAngle   = "<" { SkipAngle | SkipAngleItem } ">" ;
SkipAngleItem = "\x00"..."\x3b" | "\x3d" | "\x3f"..."\U0010ffff" ;

// A balanced ( ... ) run (constructor init arguments), parsed and ignored.
SkipParen   = "(" { SkipStr | SkipChar | SkipParen | SkipPOther } ")" ;
SkipPOther  = "\x00"..."\x21" | "\x23"..."\x26" | "\x2a"..."\U0010ffff" ;

// A balanced [ ... ] run: an attribute section (also '[assembly: ...]'), parsed and
// ignored. Strings and chars are matched first so brackets inside them are not miscounted.
AttrSection = "[" { SkipStr | SkipChar | AttrSection | AttrOther } "]" ;
AttrOther   = "\x00"..."\x21" | "\x23"..."\x26" | "\x28"..."\x5a" | "\x5c" | "\x5e"..."\U0010ffff" ;

// A generic constraint clause ('where T : class, IFoo, new()'): accepted and ignored.
WhereClause = "where" KwEnd Id ":" WhereCon { "," WhereCon } ;
WhereCon    = "new" KwEnd "(" ")" | Type ;

KwIs        = "is" KwEnd ;
KwAs        = "as" KwEnd ;

// 'new' is the method-hiding modifier ('public new string Tag()'). It only reaches here
// in member position, so the 'new' of an object creation is never taken for a modifier.
ModKw       = ( "public" | "private" | "protected" | "internal" | "static" | "abstract"
              | "sealed" | "virtual" | "override" | "readonly" | "const" | "partial"
              | "unsafe" | "async" | "extern" | "volatile" | "new" | "required" | "event"
              | "file" | "fixed" ) KwEnd ;
LeadMods    = { ModKw | AttrSection } ;

// Type declarations accepted structurally, then reported as not implemented (so a whole
// C# file parses; -warn-unsupported lets the rest run). Bodies are skipped.
UnsupType   = DelegateDecl ;
// An enum: a descriptor object of int constants. A member without a value continues
// from the previous one (starting at 0), and a member's initializer may name the members
// before it ('AB = A | B'), so the constants are bound in a scope of their own while the
// initializers run.
EnumDecl    <~~ buildEnum(takeAll()) ~~>
            = LeadMods KwEnum EnumName [ ":" Type ] "{" [ EnumMem { "," EnumMem } ] [ "," ] "}" ;
EnumName    <~~ push(up.in) ~~>
            = Id ;
EnumMem     <~~ push(makeEnumMem(takeAll())) ~~>
            = { AttrSection } Id <~~ push(up.in) ~~> [ EnumInit ] ;
EnumInit    <~~ push({einit: pop()}) ~~>
            = "=" Expression ;
// A delegate type declaration ('delegate int Op(int x);'). A delegate value is just the
// closure it names here, so the declaration itself carries no runtime meaning - it is
// accepted and dropped. It does switch multicast combination on (csHasDeleg), so a
// program that declares no delegate type keeps the plain arithmetic meaning of '+=' / '-='.
DelegateDecl <~~ csNoteDeleg() ~~>
            = LeadMods KwDelegate Type Id [ SkipAngle ] SkipParen ";" ;

// A delegate declaration is legal at file scope AND in a class body; it is listed in
// Member as well, so a nested one does not fall through to Method (which would then
// demand a body).
// A non-class type declared inside a class body: accepted, reported as not implemented.
NestedUnsup <~~ notImpl("nested type", up.pos) ~~>
            = LeadMods NestedKw Id [ SkipAngle ] [ ":" Type { "," Type } ] SkipBlock ;
NestedKw    = ( "record" ) KwEnd ;

KwUsing     = "using" KwEnd ;
KwNamespace = "namespace" KwEnd ;
KwEnum      = "enum" KwEnd ;
KwDelegate  = "delegate" KwEnd ;
KwTry       = "try" KwEnd ;
KwCatch     = "catch" KwEnd ;
KwFinally   = "finally" KwEnd ;
KwWhen      = "when" KwEnd ;
KwThrow     = "throw" KwEnd ;
KwIf        = "if" KwEnd ;
KwElse      = "else" KwEnd ;
KwWhile     = "while" KwEnd ;
KwDo        = "do" KwEnd ;
KwFor       = "for" KwEnd ;
KwForeach   = "foreach" KwEnd ;
KwIn        = "in" KwEnd ;
KwReturn    = "return" KwEnd ;
KwBreak     = "break" KwEnd ;
KwContinue  = "continue" KwEnd ;
KwNew       = "new" KwEnd ;
KwBase      = "base" KwEnd ;
KwThis      = "this" KwEnd ;
KwSwitch    = "switch" KwEnd ;
KwCase      = "case" KwEnd ;
KwDefault   = "default" KwEnd ;
KwGoto      = "goto" KwEnd ;
KwFrom      = "from" KwEnd ;
KwSelect    = "select" KwEnd ;
KwWhere     = "where" KwEnd ;
KwOrderby   = "orderby" KwEnd ;
KwLet       = "let" KwEnd ;

// ---


:startScript(~~

    // Shared interpreter machinery (scopes, BRK/CONT protocol, expression and
    // statement builders); C#-specific behavior is configured on `core` below.
    include("lib/interp-core.js")

    // The host names a program can see. Console is built here.
    hostGlobals["Console"] = {
        WriteLine: function(x) { println(x === undefined ? "" : csStr(x)) },
        Write: function(x) { print(x === undefined ? "" : csStr(x)) }
    }

    // The class whose body is currently being built (for base calls), and the stack that
    // restores the outer name when a nested class ends.
    var curClassName = ""
    var classStack = []
    // The class buildClassFrom registered last: a nested declaration has already run when
    // its marker reaches the enclosing class body, so its name is the one just built.
    var lastBuiltClass = ""
    function makeNested() { return {nestedName: lastBuiltClass} }

    // ----- char: a boxed {__char: code} value -----
    // C#'s char is an integral type that RENDERS as a glyph, so it can be neither a plain
    // number (then "" + c would print 98) nor a one-character string (then 'a' + 1 would
    // concatenate). Every operator unboxes it through csNumV; csStr renders the glyph.
    function csChar(code) { return {__char: code} }
    function csIsChar(v) { return v !== null && v !== undefined && typeof v == "object" && v.__char !== undefined }
    function csNumV(v) { return csIsChar(v) ? v.__char : (csIsFlo(v) ? v.__flo : v) }

    // ----- double / float / decimal: a boxed {__flo: value} -----
