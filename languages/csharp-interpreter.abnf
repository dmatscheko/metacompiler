        for (var k = 0; k < mods.length; k++) { if (mods[k] == "static") { isStatic = true } }
        if (auto) { return csAutoField(name, isStatic, init, ty) }
        return {kind: "prop", name: name, statik: isStatic, getT: getT, setT: setT,
                addT: addT, remT: remT}
    }
    // An automatic property IS a field: same record, so every field path (the instance
    // initializers, the static slot, the member table) applies to it unchanged.
    function csAutoField(name, isStatic, init, ty) {
        var isNum = (ty == "int" || ty == "uint" || ty == "long" || ty == "ulong" || ty == "short"
                  || ty == "ushort" || ty == "byte" || ty == "sbyte" || ty == "double"
                  || ty == "float" || ty == "decimal")
