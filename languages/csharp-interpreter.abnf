    function csStr(v) {
        if (v === undefined || v === null) return ""
        if (v === true) return "true"
        if (v === false) return "false"
        if (typeof v == "string") return v
        if (csIsChar(v)) return String.fromCharCode(v.__char)
        if (csIsFlo(v)) return csFloStr(v.__flo)
        return "" + v
    }
    function csStr2(v) {
        if (typeof v == "string") return v
        return csStr(v)
    }
