        if (csIsChar(r) && typeof l == "string") { return l.length == 1 && l.charCodeAt(0) === r.__char }
        if (csIsChar(l) && csIsChar(r)) { return l.__char === r.__char }
        if (csIsFlo(l) || csIsFlo(r)) { return csNumD(l) === csNumD(r) }
