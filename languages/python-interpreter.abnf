// all genuine (see kevalArgs). A generator expression may also be the sole argument.
CallArg     = CallKw | CallDblStar | CallStar | CallPos ;
CallKw      <~~ var v = pop(); push({ckwname: pop(), ckwval: v}) ~~>
            = Id <~~ push(up.in) ~~> "=" NotEqSign Expression ;
CallDblStar <~~ push({cdblstar: pop()}) ~~>
            = "**" Expression ;
CallStar    <~~ push({splat: pop()}) ~~>
            = "*" Expression ;
CallPos     = GenExpArg | Expression ;
