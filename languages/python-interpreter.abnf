        // so a name it does not know keeps whatever behaviour it had.
        if (typeof target == "string") {
            if (pySIsStrMethod(name)) { return pyStrMethod(target, name, args, kw) }
        }
        // The re module, a compiled Pattern and a Match all dispatch here. Arrays
        // are excluded first: the frozen runtime refuses a non-index property read
        // on one (docs/abnf-dialect-gotchas.md).
        if (target !== null && target !== undefined && typeof target == "object" && !Array.isArray(target)) {
            if (target.__pymod == "re") { return pyReModCall(name, args) }
            if (target.__pyre === true) { return pyReMethod(target, name, args) }
            if (target.__pymatch === true) { return pyMatchMethod(target, name, args) }
        }
        if (isGen(target)) {
            if (name == "send") { return genSend(target, args.length > 0 ? args[0] : undefined) }
            if (name == "__next__") { return genSend(target, undefined) }
            if (name == "close") { return genClose(target) }
            fail("unknown generator method: " + name)
        }
        if (Array.isArray(target)) {
            // THE WHOLE LIST METHOD SURFACE - docs/todo.md 1.3. Only append, pop
            // and count were here; sort/insert/remove/extend/index/reverse/clear/
            // copy aborted with "unknown list method" in every engine, and pop
            // IGNORED its index argument in all three ([3,1,2].pop(0) answered 2
            // where CPython answers 3). The twins are pyListMethod in
            // abnf/jsrt.go and pyListMethod in languages/lib/python-rt.metajs.
            if (pyIsListMethod(name)) { return pyListMethod(target, name, args, kw) }
            if (pyForeignMethod(target, name)) { pyAttrErr(target, name) }
            fail("unknown list method: " + name)
        }
        if (isDict(target)) {
