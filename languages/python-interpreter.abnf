            // filter/zip/enumerate) is materialized rather than refused -
            // `", ".join(map(str, xs))` is ordinary Python. Keep in step with the
            // join arm in abnf/pystrmethod.go and languages/lib/python-rt.metajs.
            var jseq = pySSeqOf(seq)
            if (jseq !== null) { seq = jseq }
            if (!pySIsArr(seq)) { pySFail("TypeError: can only join an iterable") }
