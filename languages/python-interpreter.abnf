    }
    function pyMatchMethod(md, name, a) {
        if (name == "group") {
            if (a.length == 0) { return pyMGroup(md, 0) }
            if (a.length == 1) { return pyMGroup(md, a[0]) }
            var out = []
            for (var i = 0; i < a.length; i++) { out.push(pyMGroup(md, a[i])) }
            return out
        }
        if (name == "groups") { return pyMGroups(md) }
        if (name == "groupdict") { return pyMGroupDict(md) }
        if (name == "start") { return pyMSpan(md, a.length > 0 ? a[0] : 0, 0) }
        if (name == "end") { return pyMSpan(md, a.length > 0 ? a[0] : 0, 1) }
        if (name == "span") {
            var k = a.length > 0 ? a[0] : 0
            return [pyMSpan(md, k, 0), pyMSpan(md, k, 1)]
        }
        if (name == "expand") { return rxExpand(md.prog, md.string, md.m, pyReTemplate("" + a[0])) }
