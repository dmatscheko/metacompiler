        if (name == "rjust") { return pySJust(s, pySOptInt(args, 0, 0), pySFillArg(args, 1), true) }
        if (name == "zfill") { return pySZfill(s, pySOptInt(args, 0, 0)) }
        if (name == "expandtabs") { return pySExpandTabs(s, pySOptInt(args, 0, 8)) }
