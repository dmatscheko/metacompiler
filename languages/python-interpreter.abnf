            out = out + pySStrArg(seq[i])
            i = i + 1
        }
        return out
    }

    // The names this table answers. The caller checks it FIRST so that a name it does
    // not know keeps whatever behaviour it had (the Go twin's Java-style .length /
    // .charAt / .substring / .indexOf / .equals / .isEmpty, which are not Python and
    // are left reachable rather than removed).
    function pySIsStrMethod(name) {
        if (name == "upper" || name == "lower" || name == "casefold") { return true }
        if (name == "title" || name == "capitalize" || name == "swapcase") { return true }
        if (name == "strip" || name == "lstrip" || name == "rstrip") { return true }
        if (name == "split" || name == "rsplit" || name == "splitlines") { return true }
        if (name == "join" || name == "replace") { return true }
        if (name == "find" || name == "rfind" || name == "index" || name == "rindex") { return true }
        if (name == "count" || name == "startswith" || name == "endswith") { return true }
        if (name == "isdigit" || name == "isdecimal" || name == "isnumeric") { return true }
        if (name == "isalpha" || name == "isalnum" || name == "isspace") { return true }
        if (name == "islower" || name == "isupper" || name == "istitle" || name == "isascii") { return true }
        if (name == "center" || name == "ljust" || name == "rjust" || name == "zfill") { return true }
        if (name == "expandtabs" || name == "encode") { return true }
        if (name == "partition" || name == "rpartition") { return true }
        if (name == "removeprefix" || name == "removesuffix") { return true }
        if (name == "format" || name == "format_map") { return true }
