    // rather than by `0 - v`, for the same reason the signed zeros are - see
    // floNegate. float("-nan") is nan in CPython, so the sign is dropped there.
    function pyStrToF(s) {
        var t = s.trim()
        var sign = 1
        if (t.length > 0 && (t.charAt(0) == "+" || t.charAt(0) == "-")) {
            if (t.charAt(0) == "-") { sign = 0 - 1 }
            t = t.slice(1)
        }
        var low = t.toLowerCase()
        if (low == "inf" || low == "infinity") {
            var inf = Math.pow(2, 1024)
            if (sign < 0) { return inf / (0 - 1) }
            return inf
        }
        if (low == "nan") { return parseFloat("nan") }
        return parseFloat(s)
    }
    // Calling a builtin type object is a CONVERSION - str(x), int(x), list(x) - which
    // pyCall routes here rather than instantiating a class.
    function pyConvert(name, args) {
        var v = args.length > 0 ? args[0] : undefined
        if (name == "str") { return args.length == 0 ? "" : pstr(v) }
        if (name == "int") { return pyToInt(v) }
        if (name == "float") { return pyFlo(typeof v == "string" ? pyStrToF(v) : floVal(v)) }
        if (name == "bool") { return pytruthy(v) }
        if (name == "list") { return args.length == 0 ? [] : iterToList(v).slice(0) }
        if (name == "tuple") { return args.length == 0 ? [] : iterToList(v).slice(0) }
        if (name == "set") {
            var out = newSet()
            if (args.length > 0) { var a = iterToList(v); for (var i = 0; i < a.length; i++) { setAdd(out, a[i]) } }
            return out
        }
        if (name == "dict") { return args.length == 0 ? newDict() : v }
        if (name == "type") { return pyTypeOf(v) }
        fail("TypeError: cannot construct " + name)
    }
    // int(x): a string is parsed, an arbitrary precision integer stays itself and
    // every other number TRUNCATES towards zero (int(-2.9) is -2).
    function pyToInt(v) {
        if (typeof v == "string") { return parseInt(v) }
        if (bigIsBig(v)) { return v }
        var f = floVal(v)
        if (f < 0) { return 0 - Math.floor(0 - f) }
        return Math.floor(f)
    }
    function pyMinMax(args, sign) {
        var vals = []
        var i
        if (args.length == 1) { vals = iterToList(args[0]) }
        else { for (i = 0; i < args.length; i++) { vals.push(args[i]) } }
        if (vals.length == 0) { fail("ValueError: max() arg is an empty sequence") }
        var best = anytype
        best = vals[0]
