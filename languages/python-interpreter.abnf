                if (c == 13 && i + 1 < s.length && s.charCodeAt(i + 1) == 10) { w = 2 }
                if (keepends) { out.push(s.substring(start, i + w)) }
                else { out.push(s.substring(start, i)) }
                i = i + w
                start = i
            } else {
                i = i + 1
            }
        }
        if (start < s.length) { out.push(s.substring(start, s.length)) }
        return out
    }

    // ---- rewriting ----

    function pySReplace(s, old, nw, cnt) {
        var out = ""
        var reps = 0
        if (old.length == 0) {
            // An empty pattern inserts between every character and at both ends.
            if (cnt != 0) {
                out = nw
                reps = 1
            }
            var i = 0
            while (i < s.length) {
                var w = pySCPW(s, i)
                out = out + s.substring(i, i + w)
                i = i + w
                if (cnt < 0 || reps < cnt) {
                    out = out + nw
                    reps = reps + 1
                }
            }
            return out
        }
        var start = 0
        while (cnt < 0 || reps < cnt) {
            var at = pySFind(s, old, start, s.length)
            if (at < 0) { break }
            out = out + s.substring(start, at) + nw
            start = at + old.length
            reps = reps + 1
        }
        return out + s.substring(start, s.length)
    }

    // do_title (CPython Objects/unicodeobject.c): a character opens a word unless the
    // PREVIOUS one was cased, which is why "they're" titles to "They'Re".
    function pySTitle(s) {
        var cs = pySChars(s)
        var low = unicodeCase(s, 6)
        var at = 0
        var out = ""
        var prev = false
        var i = 0
        while (i < cs.length) {
            var ch = cs[i]
            if (prev) { out = out + pySLowAt(low, at, ch) }
            else { out = out + unicodeCase(ch, 10) }
            at = at + unicodeCase(ch, 2).length
            prev = pySIsCased(ch)
            i = i + 1
        }
        return out
    }

    function pySIsTitle(s) {
        var cs = pySChars(s)
        var prev = false
        var any = false
        var i = 0
        while (i < cs.length) {
            var ch = cs[i]
            if (pySIsUpCh(ch) || pySCaseOnly(ch) == 3) {
                if (prev) { return false }
                prev = true
                any = true
            } else if (pySIsLoCh(ch)) {
                if (!prev) { return false }
                prev = true
                any = true
            } else {
                prev = false
            }
            i = i + 1
        }
        return any
    }

    function pySCapitalize(s) {
        if (s.length == 0) { return s }
        var c0 = s.substring(0, pySCPW(s, 0))
        var low = unicodeCase(s, 6)
        return unicodeCase(c0, 10) + low.substring(unicodeCase(c0, 2).length, low.length)
    }

    function pySSwapCase(s) {
        var cs = pySChars(s)
        var low = unicodeCase(s, 6)
        var at = 0
        var out = ""
        var i = 0
        while (i < cs.length) {
            var ch = cs[i]
            if (pySIsUpCh(ch)) { out = out + pySLowAt(low, at, ch) }
            else if (pySIsLoCh(ch)) { out = out + unicodeCase(ch, 3) }
            else { out = out + ch }
            at = at + unicodeCase(ch, 2).length
            i = i + 1
        }
        return out
    }

    function pySExpandTabs(s, tab) {
        var out = ""
        var col = 0
        var i = 0
        while (i < s.length) {
            var c = s.charCodeAt(i)
            if (c == 9) {
                if (tab > 0) {
                    var pad = tab - (col - Math.floor(col / tab) * tab)
                    out = out + pySRepeat(" ", pad)
                    col = col + pad
                }
            } else if (c == 10 || c == 13) {
                out = out + s.charAt(i)
                col = 0
            } else {
                var w = pySCPW(s, i)
                out = out + s.substring(i, i + w)
                col = col + 1
                i = i + w - 1
            }
            i = i + 1
        }
        return out
    }

    // ---- padding ----

    function pySCenter(s, width, fill) {
        var n = pySLen(s)
        var marg = width - n
        if (marg <= 0) { return s }
        // CPython: left = marg / 2 + (marg & width & 1).
        var left = Math.floor(marg / 2)
        if (marg % 2 == 1 && width % 2 == 1) { left = left + 1 }
        return pySRepeat(fill, left) + s + pySRepeat(fill, marg - left)
    }

    function pySJust(s, width, fill, right) {
        var n = pySLen(s)
        if (width <= n) { return s }
        if (right) { return pySRepeat(fill, width - n) + s }
        return s + pySRepeat(fill, width - n)
    }

    function pySZfill(s, width) {
        var n = pySLen(s)
        if (width <= n) { return s }
        var sign = ""
        var rest = s
        if (s.length > 0) {
            var c = s.charCodeAt(0)
            if (c == 43 || c == 45) {
                sign = s.substring(0, 1)
                rest = s.substring(1, s.length)
            }
        }
        return sign + pySRepeat("0", width - n) + rest
    }

    // ---- str.format ----
    //
    // The replacement-field grammar: {{ and }} are literals, and a field is
    // {name[.attr|[key]]*[!conv][:spec]}. The spec goes to the engine's own
    // pyFormat, so `.format()` and an f-string share one mini-language (and one set
    // of documented gaps - see the format chapter of this file).

    function pySAllDigits(t) {
        if (t.length == 0) { return false }
        var i = 0
        while (i < t.length) {
            var c = t.charCodeAt(i)
            if (c < 48 || c > 57) { return false }
            i = i + 1
        }
        return true
    }

    // do_conversion's refusal of a conversion other than r, s and a: a printable
    // ASCII character is named as itself, anything else as \x and its hex code.
    function pySBadConv(conv) {
        var cp = conv.charCodeAt(0)
        if (conv.length == 2) { cp = (cp - 55296) * 1024 + conv.charCodeAt(1) - 56320 + 65536 }
        var name = conv
        if (cp <= 32 || cp >= 127) {
            name = ""
            while (cp > 0 || name == "") {
                var q = Math.floor(cp / 16)
                name = "0123456789abcdef".charAt(cp - q * 16) + name
                cp = q
            }
            name = "\\x" + name
        }
        pySRaise("ValueError", "Unknown conversion specifier " + name)
    }

    // One parsed replacement field: its name, conversion ("" for none) and spec.
    // `auto` is the automatic field counter, threaded through so that a nested width
    // field ({:{}}) takes the next argument the way CPython's does. The field is
    // looked up before the conversion is checked, and the spec is expanded after.
    function pySFmtOne(nm, conv, spec, args, kw, auto, depth) {
        var at = auto
        // The head: empty (automatic), all digits (positional) or a keyword. `auto`
        // is also CPython's numbering state: -1 once a field was numbered by hand,
        // and the two styles may not be mixed in one format string.
        var head = ""
        var p = 0
        while (p < nm.length && nm.charAt(p) != "." && nm.charAt(p) != "[") {
            head = head + nm.charAt(p)
            p = p + 1
        }
        var v = anytype
        if (head == "") {
            if (at < 0) { pySRaise("ValueError", "cannot switch from manual field specification to automatic field numbering") }
            if (at >= args.length) { pySRaise("IndexError", "Replacement index " + at + " out of range for positional args tuple") }
            v = args[at]
            at = at + 1
        } else if (pySAllDigits(head)) {
            if (at > 0) { pySRaise("ValueError", "cannot switch from automatic field numbering to manual field specification") }
            at = 0 - 1
            var ix = parseInt(head, 10)
            if (ix >= args.length) { pySRaise("IndexError", "Replacement index " + ix + " out of range for positional args tuple") }
            v = args[ix]
        } else {
            v = pySKwGet(kw, head)
        }
        // .attr and [key] accessors, each looked up as soon as it is read.
        while (p < nm.length) {
            var c2 = nm.charAt(p)
            var key = ""
            p = p + 1
            if (c2 == ".") {
                while (p < nm.length && nm.charAt(p) != "." && nm.charAt(p) != "[") {
                    key = key + nm.charAt(p)
                    p = p + 1
                }
            } else if (c2 == "[") {
                while (p < nm.length && nm.charAt(p) != "]") {
                    key = key + nm.charAt(p)
                    p = p + 1
                }
                p = p + 1
            } else {
                pySRaise("ValueError", "Only '.' or '[' may follow ']' in format field specifier")
            }
            if (key == "") { pySRaise("ValueError", "Empty attribute in format string") }
            if (c2 == ".") { v = pySGetAttr(v, key) }
            else if (pySAllDigits(key)) { v = pySGetItem(v, parseInt(key, 10)) }
            else { v = pySGetItem(v, key) }
        }
        if (conv != "" && conv != "r" && conv != "s" && conv != "a") { pySBadConv(conv) }
        // A spec may itself carry replacement fields ("{:{w}}").
        if (spec.indexOf("{") >= 0) {
            var inner = pySFormatGo(spec, args, kw, at, depth - 1)
            spec = inner["text"]
            at = inner["auto"]
        }
        var res = {}
        res["text"] = pySFormat1(v, spec, conv)
        res["auto"] = at
        return res
    }

    // CPython's MarkupIterator_next and parse_field. A field is scanned over the
    // rest of the string, not up to a balanced brace: the character after '!' is
    // the conversion whatever it is, and a spec ends at the '}' that balances it.
    // `depth` is build_string's recursion budget (2 at the top, so a spec's own
    // spec may not nest further).
    function pySFormatGo(s, args, kw, auto, depth) {
        if (depth <= 0) { pySRaise("ValueError", "Max string recursion exceeded") }
        var out = ""
        var i = 0
        var at = auto
        while (i < s.length) {
            var ch = s.charAt(i)
            if (ch == "}") {
                if (i + 1 < s.length && s.charAt(i + 1) == "}") {
                    out = out + "}"
                    i = i + 2
                    continue
                }
                pySRaise("ValueError", "Single '}' encountered in format string")
            }
            if (ch != "{") {
                out = out + ch
                i = i + 1
                continue
            }
            if (i + 1 >= s.length) { pySRaise("ValueError", "Single '{' encountered in format string") }
            if (s.charAt(i + 1) == "{") {
                out = out + "{"
                i = i + 2
                continue
            }
            // The field name runs to '}', ':' or '!'; a [key] may hold any of them.
            var j = i + 1
            var c = ""
            while (j < s.length) {
                c = s.charAt(j)
                j = j + 1
                if (c == "{") { pySRaise("ValueError", "unexpected '{' in field name") }
                if (c == "[") {
                    while (j < s.length && s.charAt(j) != "]") { j = j + 1 }
                    continue
                }
                if (c == "}" || c == ":" || c == "!") { break }
            }
            var nm = s.substring(i + 1, j - 1)
            var conv = ""
            var spec = ""
            if (c == "!" || c == ":") {
                var closed = false
                if (c == "!") {
                    if (j >= s.length) { pySRaise("ValueError", "end of string while looking for conversion specifier") }
                    var w = pySCPW(s, j)
                    conv = s.substring(j, j + w)
                    j = j + w
                    if (j < s.length) {
                        var c3 = s.charAt(j)
                        j = j + 1
                        if (c3 == "}") { closed = true }
                        else if (c3 != ":") { pySRaise("ValueError", "expected ':' after conversion specifier") }
                    }
                }
                if (!closed) {
                    var from = j
                    var d = 1
                    while (j < s.length && d > 0) {
                        var c4 = s.charAt(j)
                        j = j + 1
                        if (c4 == "{") { d = d + 1 }
                        else if (c4 == "}") { d = d - 1 }
                    }
                    if (d > 0) { pySRaise("ValueError", "unmatched '{' in format spec") }
                    spec = s.substring(from, j - 1)
                }
            } else if (c != "}") {
                pySRaise("ValueError", "expected '}' before end of string")
            }
            var r = pySFmtOne(nm, conv, spec, args, kw, at, depth)
            out = out + r["text"]
            at = r["auto"]
            i = j
