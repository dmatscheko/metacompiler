            var e = text.charAt(i + 1)
            if (e == "n") { out += "\n"; i += 2; continue }
            if (e == "t") { out += "\t"; i += 2; continue }
            if (e == "r") { out += "\r"; i += 2; continue }
            if (e == "a") { out += String.fromCharCode(7); i += 2; continue }
            if (e == "b") { out += String.fromCharCode(8); i += 2; continue }
            if (e == "f") { out += String.fromCharCode(12); i += 2; continue }
            if (e == "v") { out += String.fromCharCode(11); i += 2; continue }
            if (e == "\n") { i += 2; continue }
            if (e == "\\") { out += "\\"; i += 2; continue }
            if (e == "'") { out += "'"; i += 2; continue }
            if (e == '"') { out += '"'; i += 2; continue }
            if (e == "x") { out += String.fromCharCode(hexAt(text, i + 2, 2)); i += 4; continue }
            if (e == "u") { out += String.fromCharCode(hexAt(text, i + 2, 4)); i += 6; continue }
