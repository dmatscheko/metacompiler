            | "." :whitespace() PyDig PyDigRest PyExpOpt PyJCh :whitespace(Whitespace) ;
PyRealLit   <~~ push(makeConst(pyReal(pyDigits(up.in)))) ~~>
            = PyDig :whitespace() PyDigRest PyMagOpt :whitespace(Whitespace)
            | "." :whitespace() PyDig PyDigRest PyExpOpt :whitespace(Whitespace) ;
PyXCh       = "x" | "X" ;
PyBCh       = "b" | "B" ;
PyOCh       = "o" | "O" ;
PyJCh       = "j" | "J" ;
PyECh       = "e" | "E" ;
PyUndRun    = { "_" } ;
PyDig       = "0"..."9" ;
PyHexDig    = "0"..."9" | "a"..."f" | "A"..."F" ;
PyBinDig    = "0" | "1" ;
PyOctDig    = "0"..."7" ;
PyDigRest   = { PyDig | "_" } ;
PyHexRest   = { PyHexDig | "_" } ;
PyBinRest   = { PyBinDig | "_" } ;
PyOctRest   = { PyOctDig | "_" } ;
