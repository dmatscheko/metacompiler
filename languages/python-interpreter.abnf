            else { out = out + pySLoCh(cs[i]) }
            i = i + 1
        }
        return out
    }

    function pySSwapCase(s) {
        var cs = pySChars(s)
        var out = ""
        var i = 0
        while (i < cs.length) {
            var ch = cs[i]
            if (pySIsUpCh(ch)) { out = out + pySLoCh(ch) }
            else if (pySIsLoCh(ch)) { out = out + pySUpCh(ch) }
            else { out = out + ch }
            i = i + 1
        }
        return out
    }

    function pySMapCase(s, up) {
        var cs = pySChars(s)
        var out = ""
        var i = 0
        while (i < cs.length) {
            if (up) { out = out + pySUpCh(cs[i]) }
            else { out = out + pySLoCh(cs[i]) }
            i = i + 1
        }
        return out
    }

    function pySExpandTabs(s, tab) {
        var out = ""
        var col = 0
        var i = 0
        while (i < s.length) {
            var c = s.charCodeAt(i)
            if (c == 9) {
                if (tab > 0) {
                    var pad = tab - (col - Math.floor(col / tab) * tab)
                    out = out + pySRepeat(" ", pad)
                    col = col + pad
                }
            } else if (c == 10 || c == 13) {
                out = out + s.charAt(i)
                col = 0
            } else {
                var w = pySCPW(s, i)
                out = out + s.substring(i, i + w)
                col = col + 1
                i = i + w - 1
            }
            i = i + 1
        }
        return out
    }

    // ---- padding ----

    function pySCenter(s, width, fill) {
        var n = pySLen(s)
        var marg = width - n
        if (marg <= 0) { return s }
        // CPython: left = marg / 2 + (marg & width & 1).
        var left = Math.floor(marg / 2)
        if (marg % 2 == 1 && width % 2 == 1) { left = left + 1 }
        return pySRepeat(fill, left) + s + pySRepeat(fill, marg - left)
    }

    function pySJust(s, width, fill, right) {
        var n = pySLen(s)
        if (width <= n) { return s }
        if (right) { return pySRepeat(fill, width - n) + s }
        return s + pySRepeat(fill, width - n)
    }

    function pySZfill(s, width) {
        var n = pySLen(s)
        if (width <= n) { return s }
        var sign = ""
        var rest = s
        if (s.length > 0) {
            var c = s.charCodeAt(0)
            if (c == 43 || c == 45) {
                sign = s.substring(0, 1)
                rest = s.substring(1, s.length)
            }
