FExpr       <~~ push(makeFField(takeAll(), up.in)) ~~>
            = "{" :whitespace(WhitespaceNL) ExprList [ FDebug ] [ FConv ] [ FSpec ] "}" :whitespace() ;
// The `=` debug form. Skipped whitespace never reaches up.in, so the spaces around
// the `=` are matched as ORDINARY TOKENS (whitespace skipping off for this
// production only) - that is what makes f"{x = }" echo "x = 5" and not "x=5".
FDebug      <~~ push({fdebug: true}) ~~>
            = :whitespace() FDbgSp "=" NotEqSign FDbgSp ;
FDbgSp      = [ @+" \t" ] ;
FConv       = "!" ( "r" | "s" | "a" ) <~~ push({fconv: up.in}) ~~> ;
FSpec       <~~ push({fspec: takeAll()}) ~~>
            = ":" :whitespace() { FSpecField | FSpecChunk } ;
// A NESTED field inside a format spec may carry its own conversion and its own
// (non-nesting) spec: f'{v:{width!r}.{prec}}' and f'{v:{width:0}.{prec:1}}' are both
// real, and test_fstring checks them. Both only affect how the WIDTH is rendered, which
// this model reads as a plain number, so they are parsed and DROPPED - neither production
// carries a tag, so the field still contributes exactly the one thunk FSpec expects.
// The `=` debug form may appear in a NESTED field too: `f"{2:{y=}}"` renders the spec
// as `y=20`, which is fill `y`, align `=`, width 20 (test_fstring line 1640). It is
// parsed and DROPPED - FSpecDbg carries no tag, so the nested field still contributes
// exactly the one thunk its parent pops.
FSpecDbg    = :whitespace() FDbgSp "=" NotEqSign FDbgSp ;
FSpecField  = "{" :whitespace(Whitespace) Expression [ FSpecDbg ] [ FSpecConv ] [ FSpecSub ] "}" :whitespace() ;
FSpecConv   = "!" ( "r" | "s" | "a" ) ;
// The nested spec NESTS again: f'{value:{width:{0}}.{precision:1}}' is three levels deep,
// and PEP 701 puts no limit on it. FSpecSubField is FSpecField with a dropping tag - the
// whole sub-spec is discarded, so it must stay item-neutral, and popping the one thunk its
// Expression pushes is what keeps FSpec's takeAll() seeing exactly the fields it renders.
// FSpecSubChunk, not FSpecChunk: FSpecChunk carries a `push({chunk})` tag, so reusing it
// here made the DROPPED sub-spec push its text into the enclosing FSpec's takeAll() - the
// "tagging a sub-rule changes how many items its PARENT pops" trap. It did not fail: the
// leaked `0` of `{width:0}` was appended to the width and the field rendered 100 columns
// wide instead of 10.
FSpecSub    = ":" :whitespace() { FSpecSubField | FSpecSubChunk } :whitespace(Whitespace) ;
FSpecSubChunk = FSpecChar { FSpecChar } ;
FSpecSubField <~~ pop() ~~>
            = "{" :whitespace(Whitespace) Expression [ FSpecDbg ] [ FSpecConv ] [ FSpecSub ] "}" :whitespace() ;
FSpecChunk  <~~ push({chunk: up.in}) ~~>
            = FSpecChar { FSpecChar } ;
FSpecChar   = "\x20"..."\x7a" | "\x7c" | "\x7e"..."\U0010ffff" ;
FChunkD     <~~ push({chunk: pyUnescape(up.in, false)}) ~~> = FCharD { FCharD } ;
// StrEsc2, not the shared StrEsc: lib/dq-strings.abnf's StrEsc allows only a printable
// ASCII byte after the backslash, so an f-string opening `f"""\` + newline (a line
// continuation, and how CPython's test_tokenize writes its expected-token blocks) did not
// match. The compiler's copy already used the wide form; this is the interpreter catching up.
FCharD      = FBrace | FNamedEsc | FStrEsc | FBksl | FPlainD ;
FChunkS     <~~ push({chunk: pyUnescape(up.in, false)}) ~~> = FCharS { FCharS } ;
FCharS      = FBrace | FNamedEsc | FStrEsc | FBksl | FPlainS ;
FChunk3D    <~~ push({chunk: pyUnescape(up.in, false)}) ~~> = FChar3D { FChar3D } ;
FChar3D     = FBrace | FNamedEsc | FStrEsc | FBksl | FPlain3D ;
FChunk3S    <~~ push({chunk: pyUnescape(up.in, false)}) ~~> = FChar3S { FChar3S } ;
FChar3S     = FBrace | FNamedEsc | FStrEsc | FBksl | FPlain3S ;
// {{ and }} are the escaped braces.
FBrace      = "{{" | "}}" ;
// The named-unicode escape INSIDE an f-string. A `{` normally opens a replacement
// field, but the one after a backslash-N belongs to the escape: without this rule
// StrEsc2 matched only the `\N` and left the `{` to open a field, so
// `f'\N{GREEK CAPITAL LETTER DELTA}'` (test_fstring line 990) did not parse at all.
// It has to be tried BEFORE StrEsc2, which would otherwise take the `\N` and commit.
// The name characters are exactly the ones a Unicode character name may hold -
// upper-case letters, digits, spaces and hyphens - which keeps the rule from running
// past a missing `}` and eating the closing quote; an unterminated `\N{` therefore
// falls back to StrEsc2 and behaves as it did before. The NAME TABLE is a small
// subset (pyUniNames); a name outside it parses and renders as the empty string.
FNamedEsc   = "\\N{" FNameCh { FNameCh } "}" ;
// A backslash escape inside an f-string never consumes a BRACE. CPython's f-string
// lexer treats `{` and `}` as structural first: `f'\{6*7}'` is a (warned about, still
// legal) invalid escape - a literal backslash - followed by a REPLACEMENT FIELD, and it
// evaluates to '\\42'; `f'\}'` is the error "single '}' is not allowed". Using the plain
// StrEsc2 here swallowed the `{`, so the field never opened and test_fstring line 1016
// (`fr'\{6*7}'`) died on the closing brace instead. FBksl is the lone backslash that is
// left over, which pyUnescape keeps verbatim - and, because FPlain* already excludes the
// backslash, nothing else can match it by accident.
FStrEsc     = "\\" FEscCh ;
FEscCh      = "\x00"..."\x7a" | "\x7c" | "\x7e"..."\U0010ffff" ;
FBksl       = "\\" ;
FNameCh     = "0"..."9" | "A"..."Z" | " " | "-" ;
FPlainD     = "\x20"..."\x21" | "\x23"..."\x5b" | "\x5d"..."\x7a" | "\x7c" | "\x7e" | @"\t" | "\x7f"..."\U0010ffff" ;
FPlainS     = "\x20"..."\x26" | "\x28"..."\x5b" | "\x5d"..."\x7a" | "\x7c" | "\x7e" | @"\t" | "\x7f"..."\U0010ffff" ;
FPlain3D    = "\x00"..."\x21" | "\x23"..."\x5b" | "\x5d"..."\x7a" | "\x7c" | "\x7e"..."\U0010ffff" ;
FPlain3S    = "\x00"..."\x26" | "\x28"..."\x5b" | "\x5d"..."\x7a" | "\x7c" | "\x7e"..."\U0010ffff" ;

ListLit     <~~ push(makeList(takeAll())) ~~>
            = "[" :whitespace(WhitespaceNL) [ StarExpr { "," StarExpr } [ "," ] ] "]" :whitespace(Whitespace) ;
// An element of a display that may be splatted in: *iterable.
StarExpr    = StarItem | Expression ;
StarItem    <~~ push({splat: pop()}) ~~>
            = "*" Expression ;

// Triple-quoted strings (docstrings, multi-line text) are genuinely evaluated as
// ordinary string constants; they are tried before the single-quoted forms so
// """...""" is not misread as an empty "" string. The body may span newlines and
// contain lone or doubled quotes; only three quotes in a row close it.
// A string literal is a run of ADJACENT pieces - Python concatenates them implicitly
// ("ab" "cd", f"a{1}" "b") - each with its own prefix and quote style. A piece with an
// `f` prefix is an f-string (its {expressions} are parsed); every other piece is a
// constant whose PREFIX decides how it is decoded: `r` keeps the backslashes, `b`
// makes it a bytes value (a list of byte numbers), `u` is accepted and ignored.
StringLit   <~~ push(makeStrConcat(takeAll())) ~~>
            = StrPiece { StrPiece } ;
StrPiece    = FString | TextPiece ;
TextPiece   <~~ push(makeStrPiece(up.in)) ~~>
            = [ StrPrefix ] ( TripleDqStr | TripleSqStr | DqStr2 | SqStr2 ) ;
// The prefix letters, longest first (rb before r), glued to the quote.
StrPrefix   = ( "rb" | "rB" | "Rb" | "RB" | "br" | "bR" | "Br" | "BR"
              | "r" | "R" | "b" | "B" | "u" | "U" ) :whitespace() ;
TripleDqStr = '"""' :whitespace() { TStrEsc | TdqChar | TdqQ1 | TdqQ2 } '"""' :whitespace(Whitespace) ;
TripleSqStr = "'''" :whitespace() { TStrEsc | TsqChar | TsqQ1 | TsqQ2 } "'''" :whitespace(Whitespace) ;
// A single-quoted piece. The shared DqString/SqString productions push a cooked value,
// which the prefix-aware decoder does not want, so these are spelled out.
DqStr2      = '"' :whitespace() { StrEsc2 | DqChar2 } '"' :whitespace(Whitespace) ;
SqStr2      = "'" :whitespace() { StrEsc2 | SqChar2 } "'" :whitespace(Whitespace) ;
StrEsc2     = "\\" "\x00"..."\U0010ffff" ;
DqChar2     = "\x00"..."\x21" | "\x23"..."\x5b" | "\x5d"..."\U0010ffff" ;
SqChar2     = "\x00"..."\x26" | "\x28"..."\x5b" | "\x5d"..."\U0010ffff" ;
// ANY character may follow the backslash, a NEWLINE included: inside a triple-quoted
// string `\` at end of line is Python's line continuation, and `\` before a non-ASCII
// character is simply kept. Restricting this to printable ASCII did not fail the string -
// it made TripleDqStr fail, so the piece was re-read as a run of ADJACENT short strings
// that happened to pair up, and the parse died at the first quote inside the body that
// broke the accidental pairing. Four corpus files open with `"""\` (test_exceptions,
// test_generators, test_syntax, test_tokenize) and all four turned on this one range.
TStrEsc     = "\\" "\x00"..."\U0010ffff" ;
// A non-quote, non-backslash char (newlines and spaces included: the body is raw).
TdqChar     = "\x00"..."\x21" | "\x23"..."\x5b" | "\x5d"..."\U0010ffff" ;
TdqQ1       = '"' ( TStrEsc | TdqChar ) ;
TdqQ2       = '""' ( TStrEsc | TdqChar ) ;
TsqChar     = "\x00"..."\x26" | "\x28"..."\x5b" | "\x5d"..."\U0010ffff" ;
TsqQ1       = "'" ( TStrEsc | TsqChar ) ;
TsqQ2       = "''" ( TStrEsc | TsqChar ) ;
True        <~~ push(makeConst(true)) ~~>      = "True" KwEnd ;
False       <~~ push(makeConst(false)) ~~>     = "False" KwEnd ;
None        <~~ push(makeConst(undefined)) ~~> = "None" KwEnd ;
// The Ellipsis literal. It is a singleton object, so `x is ...` compares by identity.
Ellipsis    <~~ push(makeConst(pyEllipsis)) ~~> = "..." ;

// ----- Numeric literals -----
