    // An unknown name RAISES NameError (catchable) instead of aborting, so the
    // UnboundLocalError a `del` leaves behind can be caught like in Python. Returning
    // null lets getVar go on to the host builtins.
    // Python binds by SCOPE, not by search: a plain assignment inside a function
    // (or a class body) writes a LOCAL, even when an outer scope - typically the
    // module - already has that name. The shared setVar walks the whole chain and
    // would hit the outer binding, so every binding site in this grammar goes
    // through pySet instead: it walks outward only until the innermost function
    // boundary (the __pyfn frame that callScopes builds), which lets the block
    // scopes of if/for/while/except stay transparent the way Python needs, and
    // stops there. `global x` / `nonlocal x` record themselves on that frame as
    // "g:x;" / "n:x;" and are the only way past it.
    function pySet(name, value) {
        if (name == core.blank) { return }
        var sc = scopes
        var ho = objHasOwn
        // `nonlocal x` names a binding in SOME enclosing function, not necessarily
        // the next one out (makeNonlocal already checked that one exists), so it
        // lifts every function boundary on the way, not just the first.
        var lifted = false
        for (var i = sc.length - 1; i >= 0; i--) {
            if (ho.call(sc[i], name)) { scopePut(sc[i], name, value); return }
            // A plain property read, not hasOwn: this runs on every assignment that
            // is not answered by the innermost scope, and no scope object inherits
            // __pyfn from anywhere.
            if (sc[i].__pyfn === true) {
                if (lifted) { continue }
                var d = sc[i].__pyd
                if (d != undefined && d != "") {
                    if (d.indexOf("g:" + name + ";") >= 0) { scopePut(globalScope, name, value); return }
                    if (d.indexOf("n:" + name + ";") >= 0) { lifted = true; continue }
                }
                break
            }
        }
        core.setMiss(name, value)
    }
    // The innermost function (or class body) frame, or null at module level.
    function pyFnScope() {
        for (var i = scopes.length - 1; i >= 1; i--) {
            if (scopes[i].__pyfn === true) { return scopes[i] }
        }
        return null
    }
    function pyDeclare(kind, name) {
        var fs = pyFnScope()
        if (fs != null) { fs.__pyd = fs.__pyd + kind + ":" + name + ";" }
    }

    core.varMiss = function(name) {
        if (hasOwn(hostGlobals, name)) { return null }
        pyRaise(pyMakeExc("NameError", ["name '" + name + "' is not defined"]))
    }
    core.setMiss = function(name, value) {
        var sc = scopes[scopes.length - 1]
        if (hasOwn(sc, "__nskeys")) { sc.__nskeys.push(name) }
        scopePut(sc, name, value)
        return true
    }
    // Python stdlib modules the runtime provides (resolveImport lives in
    // lib/interp-core.js; prefix match, so os.path resolves against "os").
    core.stdlibImports = ["sys", "os", "math", "collections", "itertools", "functools", "re", "json", "typing", "random", "string", "time", "dataclasses", "abc"]
    // Project-file imports: 'import mypkg.helper' / 'from mypkg.helper import x'
    // look for mypkg/helper.py, then mypkg.py under the program's directory and
    // the -i roots (c.findImport). The file is parsed with this grammar and
    // walked with the same tags: its top level runs right there
    // (real Python import-time execution) and its defs land in the global scope. A file is imported once; repeats and cycles
    // are no-ops. Deviation from real Python: the module's top-level names bind
    // directly (flat, no module object), so use the from-import style.
    var importedFiles = {}
    core.importFile = function(path, pos) {
        var rel = path.split(".").join("/")
        var cands = [rel + ".py"]
        var cut = -1
        for (var k = 0; k < rel.length; k++) { if (rel.charAt(k) == "/") { cut = k } }
        if (cut > 0) { cands.push(rel.substring(0, cut) + ".py") }
        for (var i = 0; i < cands.length; i++) {
            var file = c.findImport(cands[i])
            if (file == "") { continue }
            if (importedFiles["$" + file] == true) { return true }
            importedFiles["$" + file] = true
            var text = c.readFile(file)
            var asg = c.parse(c.agrammar, text, null, file)
            c.pushSource(file, text)
            c.compile(asg)
            c.popSource()
            return true
        }
        return false
    }

    c.compile(c.asg)

    // A module that defines a top-level main() (the ratchet files do) is run for its
    // definitions and then entered through it; its return value is the exit status.
    // A script without one has already done its work top to bottom.
    var entry = c.mainName
    if (entry == undefined || entry == "") { entry = "main" }
    if (hasOwn(globalScope, entry) && typeof globalScope[entry] == "function") {
        var ret = anytype
        try {
            ret = globalScope[entry]()
        } catch (e) {
            if (excIsUser(e)) { fail("uncaught exception: " + pstr(excValue(e))) }
            throw e
        }
        exit(ret === undefined || ret === null ? 0 : ret | 0)
    }
    println("python interpreter: program ran to completion")
    exit(0)

