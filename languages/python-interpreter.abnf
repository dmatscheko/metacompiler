        if (c >= 9 && c <= 13) { return true }
        if (c >= 28 && c <= 31) { return true }
        if (c == 133 || c == 160 || c == 5760) { return true }
        if (c >= 8192 && c <= 8202) { return true }
        if (c == 8232 || c == 8233 || c == 8239 || c == 8287 || c == 12288) { return true }
