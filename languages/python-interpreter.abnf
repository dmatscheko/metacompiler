    // docs/todo.md 1.3 - Python's list methods, the NAME SET first so that
    // hasattr()/getattr() can ask exactly what the dispatcher answers. Keep in
    // step with pyIsListMethod in abnf/jsrt.go and in
    // languages/lib/python-rt.metajs.
    function pyIsListMethod(name) {
        if (name == "append" || name == "pop" || name == "clear") { return true }
        if (name == "copy" || name == "count" || name == "sort") { return true }
        if (name == "insert" || name == "remove" || name == "extend") { return true }
        if (name == "index" || name == "reverse") { return true }
        return false
    }
    // Every error below is a CATCHABLE Python exception with CPython 3.14's
    // exact text, not fail(): `try: xs.remove(9) / except ValueError` has to
    // behave the same in all three engines, which is the only thing that makes
    // any of this assertable in one ratchet file.
    function pyListMethod(xs, name, args, kw) {
        var n = xs.length
        if (name == "append") { xs.push(pyArgAt(args, 0)); return undefined }
        if (name == "clear") { listTruncate(xs, 0); return undefined }
        if (name == "copy") { return xs.slice(0) }
        if (name == "reverse") {
            var lo = 0
            var hi = n - 1
            while (lo < hi) {
                var tmp = anytype
                tmp = xs[lo]
                xs[lo] = xs[hi]
                xs[hi] = tmp
                lo = lo + 1
                hi = hi - 1
            }
            return undefined
        }
        if (name == "count") {
            // By ==, not by identity: [1.0, 2].count(1) is 1.
            if (args.length != 1) { pyListErr("TypeError", "list.count() takes exactly one argument") }
            var cn = 0
            for (var ci = 0; ci < n; ci++) {
