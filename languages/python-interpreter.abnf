        if (pySLen(f) != 1) { pySFail("TypeError: The fill character must be exactly one character long") }
        return f
    }

    // isdigit / isalpha / isalnum / isspace / isascii, which share "empty is False
    // and every character must qualify".
    function pySAllCh(s, kind) {
        var cs = pySChars(s)
        if (cs.length == 0) { return false }
        var i = 0
        while (i < cs.length) {
            var ch = cs[i]
            var ok = false
            if (kind == 1) { ok = pySIsDigitCh(ch) }
            else if (kind == 2) { ok = pySIsAlphaCh(ch) }
            else if (kind == 3) { ok = pySIsAlphaCh(ch) || pySIsDigitCh(ch) }
            else { ok = pySIsSpaceCh(ch) }
            if (!ok) { return false }
            i = i + 1
        }
        return true
    }

    // islower / isupper: at least one cased character, and no cased character of the
    // other case. An uncased character is ignored, which is why "ab1".islower() is True.
    function pySCaseAll(s, up) {
