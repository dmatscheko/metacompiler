    // re.escape, CPython 3.7+: exactly the characters in _special_chars_map.
    function pyReEscape(s) {
        var special = "()[]{}?*+-|^$\\.&~# \t\n\r\v\f"
        var out = ""
        for (var i = 0; i < s.length; i++) {
            var ch = s.charAt(i)
            if (special.indexOf(ch) >= 0) { out += "\\" }
            out += ch
        }
        return out
    }
    function pyReArg(v, fl) {
        if (isPyRe(v)) { return v }
        return pyReCompile("" + v, fl)
    }
    // The module surface. Every re.f(pattern, ...) is the compiled pattern's own
    // method with the pattern dropped, so the two entry points share one body; the
    // only difference is where the optional flags argument sits.
    function pyReModCall(name, args) {
        if (name == "escape") { return pyReEscape("" + args[0]) }
        if (name == "purge") { return undefined }
        if (name == "compile") { return pyReArg(args[0], args.length > 1 ? args[1] : 0) }
        var flpos = -1
        if (name == "search" || name == "match" || name == "fullmatch"
            || name == "findall" || name == "finditer") { flpos = 2 }
        if (name == "sub" || name == "subn") { flpos = 4 }
        if (name == "split") { flpos = 3 }
        if (flpos < 0) { fail("unknown re function: " + name) }
        var fl = args.length > flpos ? args[flpos] : 0
        var rv = pyReArg(args[0], fl)
        var rest = []
        for (var i = 1; i < args.length && i < flpos; i++) { rest.push(args[i]) }
        return pyReMethod(rv, name, rest)
    }
    function pyReMethod(rv, name, a) {
        if (name == "search") {
            return pyReSearch(rv, "" + a[0], a.length > 1 ? a[1] | 0 : 0)
        }
        if (name == "match" || name == "fullmatch") {
            return pyReAnchoredMatch(rv, "" + a[0], a.length > 1 ? a[1] | 0 : 0, name == "fullmatch")
        }
        if (name == "findall") { return pyReFindAll(rv, "" + a[0], false) }
        if (name == "finditer") { return pyReFindAll(rv, "" + a[0], true) }
        if (name == "sub" || name == "subn") {
            var r = pyReSub(rv, a[0], "" + a[1], a.length > 2 ? a[2] | 0 : 0)
            return name == "sub" ? r.text : [r.text, r.n]
        }
        if (name == "split") { return pyReSplit(rv, "" + a[0], a.length > 1 ? a[1] | 0 : 0) }
