        var hi = 0
        var style = 0
        if (name == "format") { return }
        if (name == "join" || name == "zfill" || name == "partition" || name == "rpartition" ||
            name == "removeprefix" || name == "removesuffix" || name == "format_map") { lo = 1; hi = 1; style = 1 }
        else if (name == "strip" || name == "lstrip" || name == "rstrip") { hi = 1; style = 2 }
        else if (name == "find" || name == "rfind" || name == "index" || name == "rindex" ||
                 name == "count" || name == "startswith" || name == "endswith") { lo = 1; hi = 3; style = 2 }
        else if (name == "center" || name == "ljust" || name == "rjust") { lo = 1; hi = 2; style = 2 }
        else if (name == "split" || name == "rsplit" || name == "encode") { hi = 2; style = 3 }
        else if (name == "splitlines" || name == "expandtabs") { hi = 1; style = 3 }
        else if (name == "replace") { lo = 2; hi = 3; style = 3 }
        if (n >= lo && n <= hi) { return }
        var msg = ""
        if (style == 0) { msg = "str." + name + "() takes no arguments (" + n + " given)" }
        else if (style == 1) { msg = "str." + name + "() takes exactly one argument (" + n + " given)" }
        else if (style == 2) {
            if (n < lo) { msg = name + " expected at least " + lo + " argument" + (lo == 1 ? "" : "s") + ", got " + n }
            else { msg = name + " expected at most " + hi + " argument" + (hi == 1 ? "" : "s") + ", got " + n }
        } else {
            if (n < lo) { msg = name + "() takes at least " + lo + " positional arguments (" + n + " given)" }
            else { msg = name + "() takes at most " + hi + " argument" + (hi == 1 ? "" : "s") + " (" + n + " given)" }
        }
