            if (pi < 0 || pi >= n) { pyListErr("IndexError", "pop index out of range") }
            var pv = anytype
            pv = xs[pi]
            listRemoveAt(xs, pi)
            return pv
        }
        if (name == "insert") {
            // CPython CLAMPS rather than raising: insert(-5, x) on a 2-list
