        return args
    }
    // str.encode(encoding="utf-8", errors="strict"): the bytes - a list of byte
    // values in this value model - in UTF-8, ASCII or Latin-1. A run of characters
    // the codec cannot encode raises CPython's UnicodeEncodeError under "strict";
    // "ignore", "replace", "backslashreplace" and "xmlcharrefreplace" substitute.
    // Twin of pysEncode in abnf/pystrmethod.go and pyStrEncode in
    // lib/python-rt.metajs.
    function pyStrEncode(s, encV, errV) {
        var enc = "utf-8"
        if (encV !== undefined && encV !== null) { enc = pstr(encV) }
        var errs = "strict"
        if (errV !== undefined && errV !== null) { errs = pstr(errV) }
        var e = ""
        for (var ei = 0; ei < enc.length; ei++) { e = e + (enc.charAt(ei) == "_" ? "-" : enc.charAt(ei).toLowerCase()) }
        var limit = 0
        var codec = "utf-8"
        if (e == "latin-1" || e == "latin1" || e == "iso-8859-1" || e == "iso8859-1") { limit = 256; codec = "latin-1" }
        else if (e == "ascii" || e == "us-ascii") { limit = 128; codec = "ascii" }
        else if (e != "utf-8" && e != "utf8") { pyListErr("LookupError", "unknown encoding: " + enc) }
        var cps = []
        var i = 0
        while (i < s.length) {
            var c = s.charCodeAt(i)
            if (c >= 55296 && c <= 56319 && i + 1 < s.length) {
                var t = s.charCodeAt(i + 1)
                if (t >= 56320 && t <= 57343) {
                    c = (c - 55296) * 1024 + (t - 56320) + 65536
                    i = i + 1
                }
            }
            cps.push(c)
            i = i + 1
        }
        var out = []
        var k = 0
        while (k < cps.length) {
            if (!pyEncBad(cps[k], limit)) {
                pyEncPush(out, cps[k], limit)
                k = k + 1
                continue
            }
            var j = k
            while (j < cps.length && pyEncBad(cps[j], limit)) { j = j + 1 }
            if (errs == "strict") {
                var where = "character '" + pyEncEsc(cps[k]) + "' in position " + k
                if (j - k > 1) { where = "characters in position " + k + "-" + (j - 1) }
                var why = limit == 0 ? "surrogates not allowed" : "ordinal not in range(" + limit + ")"
                pyListErr("UnicodeEncodeError", "'" + codec + "' codec can't encode " + where + ": " + why)
            }
            for (var q = k; q < j; q++) {
                if (errs == "replace") { out.push(63) }
                else if (errs == "backslashreplace") { pyEncAscii(out, pyEncEsc(cps[q])) }
                else if (errs == "xmlcharrefreplace") { pyEncAscii(out, "&#" + cps[q] + ";") }
                else if (errs != "ignore") { pyListErr("LookupError", "unknown error handler name '" + errs + "'") }
            }
            k = j
