DictItem    = DictSplat | DictEntry ;
DictSplat   <~~ push({dsplat: pop()}) ~~>
            = "**" Expression ;
DictEntry   <~~ var dv = pop(); push({dk: pop(), dv: dv}) ~~>
            = Expression ":" Expression ;

// f-string: literal chunks and {expression} parts; every expression renders like str().
// An f-string piece. All four quote styles, and the `rf`/`fr` prefix orders; the
// replacement fields carry the full 3.12 surface - a nested f-string, a conversion
// (!r / !s / !a), a format spec that may itself contain a {nested} field, and the
// `=` debug form that echoes the source text of the expression.
FString     <~~ push(makeFString(takeAll())) ~~>
            = FPrefix ( FTripleDq | FTripleSq | FDq | FSq ) ;
FPrefix     = ( "rf" | "rF" | "Rf" | "RF" | "fr" | "fR" | "Fr" | "FR" | "f" | "F" ) :whitespace() ;
FTripleDq   = '"""' :whitespace() { FExpr | FChunk3D } '"""' :whitespace(Whitespace) ;
FTripleSq   = "'''" :whitespace() { FExpr | FChunk3S } "'''" :whitespace(Whitespace) ;
FDq         = '"' :whitespace() { FExpr | FChunkD } '"' :whitespace(Whitespace) ;
FSq         = "'" :whitespace() { FExpr | FChunkS } "'" :whitespace(Whitespace) ;
// up.in is the whole `{...}` field, which is what the `=` debug form needs: it echoes
// the SOURCE TEXT of the expression, whitespace included (f"{x = }" -> "x = 5").
// The replacement field switches to WhitespaceNL, not Whitespace: since PEP 701 the
// expression inside {} may span LINES and carry `#` comments, which is exactly what
//     f'''{ # the following operation
//     3
//     * 2}'''
// is. With the newline-less Whitespace the comment ran to the end of its line and the
// parse stopped there - and in the shorter cases it did not fail at all, it silently
// ended the field early and printed the rest of the expression as literal text.
FExpr       <~~ push(makeFField(takeAll(), up.in)) ~~>
            = "{" :whitespace(WhitespaceNL) ExprList [ FDebug ] [ FConv ] [ FSpec ] "}" :whitespace() ;
// The `=` debug form. Skipped whitespace never reaches up.in, so the spaces around
// the `=` are matched as ORDINARY TOKENS (whitespace skipping off for this
// production only) - that is what makes f"{x = }" echo "x = 5" and not "x=5".
FDebug      <~~ push({fdebug: true}) ~~>
            = :whitespace() FDbgSp "=" NotEqSign FDbgSp ;
FDbgSp      = [ @+" \t" ] ;
FConv       = "!" ( "r" | "s" | "a" ) <~~ push({fconv: up.in}) ~~> ;
FSpec       <~~ push({fspec: takeAll()}) ~~>
            = ":" :whitespace() { FSpecField | FSpecChunk } ;
// A NESTED field inside a format spec may carry its own conversion and its own
// (non-nesting) spec: f'{v:{width!r}.{prec}}' and f'{v:{width:0}.{prec:1}}' are both
// real, and test_fstring checks them. Both only affect how the WIDTH is rendered, which
// this model reads as a plain number, so they are parsed and DROPPED - neither production
// carries a tag, so the field still contributes exactly the one thunk FSpec expects.
// The `=` debug form may appear in a NESTED field too: `f"{2:{y=}}"` renders the spec
// as `y=20`, which is fill `y`, align `=`, width 20 (test_fstring line 1640). It is
// parsed and DROPPED - FSpecDbg carries no tag, so the nested field still contributes
// exactly the one thunk its parent pops.
FSpecDbg    = :whitespace() FDbgSp "=" NotEqSign FDbgSp ;
FSpecField  = "{" :whitespace(Whitespace) Expression [ FSpecDbg ] [ FSpecConv ] [ FSpecSub ] "}" :whitespace() ;
FSpecConv   = "!" ( "r" | "s" | "a" ) ;
// The nested spec NESTS again: f'{value:{width:{0}}.{precision:1}}' is three levels deep,
// and PEP 701 puts no limit on it. FSpecSubField is FSpecField with a dropping tag - the
// whole sub-spec is discarded, so it must stay item-neutral, and popping the one thunk its
// Expression pushes is what keeps FSpec's takeAll() seeing exactly the fields it renders.
// FSpecSubChunk, not FSpecChunk: FSpecChunk carries a `push({chunk})` tag, so reusing it
// here made the DROPPED sub-spec push its text into the enclosing FSpec's takeAll() - the
// "tagging a sub-rule changes how many items its PARENT pops" trap. It did not fail: the
// leaked `0` of `{width:0}` was appended to the width and the field rendered 100 columns
// wide instead of 10.
FSpecSub    = ":" :whitespace() { FSpecSubField | FSpecSubChunk } :whitespace(Whitespace) ;
FSpecSubChunk = FSpecChar { FSpecChar } ;
FSpecSubField <~~ pop() ~~>
            = "{" :whitespace(Whitespace) Expression [ FSpecDbg ] [ FSpecConv ] [ FSpecSub ] "}" :whitespace() ;
FSpecChunk  <~~ push({chunk: up.in}) ~~>
            = FSpecChar { FSpecChar } ;
FSpecChar   = "\x20"..."\x7a" | "\x7c" | "\x7e"..."\U0010ffff" ;
