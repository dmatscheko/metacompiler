            }
            if (pyIsDictMethod(name)) { return pyDictMethod(target, name, args, kw) }
            if (pyIsSetOnly(name)) { pyAttrErr(target, name) }
            if (pyForeignMethod(target, name)) { pyAttrErr(target, name) }
            fail("unknown dict method: " + name)
        }
