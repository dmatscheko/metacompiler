    // answer -1 while "abc".find("", 3) answers 3.
    function pySAdjStart(v, n) {
        var i = v
        if (i < 0) {
            i = i + n
            if (i < 0) { i = 0 }
        }
        return i
    }

    function pySAdjEnd(v, n) {
        var i = v
        if (i < 0) {
            i = i + n
            if (i < 0) { i = 0 }
        }
        if (i > n) { i = n }
        return i
