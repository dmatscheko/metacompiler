// Unary plus. It is the identity on every numeric type this model has, so the
// operand thunk is simply passed through.
Pos         = "+" Factor ;
// ~x bitwise-not: accepted, reported as not implemented.
Invert      <~~ push(makeInvert(pop())) ~~>
