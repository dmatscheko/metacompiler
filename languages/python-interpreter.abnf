// greedy and never gives a match back. A `!"in"` lookahead would be wrong twice over: it
// skips whitespace, and it would also reject a name that merely STARTS with a keyword
// (`information`), so the guard reads the whole word and compares it. Soft keywords
// (`match`, `case`, `type`, `_`) are real names in Python and are deliberately absent.
NotPyKw     = :script(~~
    (function() {
        var kws = ["False", "None", "True", "and", "as", "assert", "async", "await",
                   "break", "class", "continue", "def", "del", "elif", "else", "except",
                   "finally", "for", "from", "global", "if", "import", "in", "is",
                   "lambda", "nonlocal", "not", "or", "pass", "raise", "return", "try",
                   "while", "with", "yield"]
