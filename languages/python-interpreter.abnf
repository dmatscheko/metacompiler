            spec = inner["text"]
            at = inner["auto"]
        }
        var res = {}
        res["text"] = pySFormat1(v, spec, conv)
        res["auto"] = at
        return res
    }

    function pySFormatGo(s, args, kw, auto) {
        var out = ""
        var i = 0
        var at = auto
        while (i < s.length) {
            var ch = s.charAt(i)
            if (ch == "{") {
                if (i + 1 < s.length && s.charAt(i + 1) == "{") {
                    out = out + "{"
                    i = i + 2
                    continue
                }
                var depth = 1
                var j = i + 1
                while (j < s.length) {
                    var c2 = s.charAt(j)
                    if (c2 == "{") { depth = depth + 1 }
                    else if (c2 == "}") {
                        depth = depth - 1
                        if (depth == 0) { break }
                    }
                    j = j + 1
                }
                if (depth != 0) { pySFail("ValueError: Single '{' encountered in format string") }
                var r = pySFmtOne(s.substring(i + 1, j), args, kw, at)
                out = out + r["text"]
                at = r["auto"]
                i = j + 1
                continue
            }
            if (ch == "}") {
                if (i + 1 < s.length && s.charAt(i + 1) == "}") {
                    out = out + "}"
                    i = i + 2
                    continue
                }
                pySFail("ValueError: Single '}' encountered in format string")
            }
            out = out + ch
            i = i + 1
        }
        var res = {}
        res["text"] = out
        res["auto"] = at
        return res
    }

    // ---- the dispatch table ----

    function pySOptInt(args, i, dflt) {
        if (i >= args.length) { return dflt }
        var v = args[i]
        if (v === undefined || v === null) { return dflt }
        return v | 0
    }

    function pySStrArg(v) {
        if (typeof v == "string") { return v }
        pySFail("TypeError: a str argument is required")
        return ""
    }

    function pySFillArg(args, i) {
        if (i >= args.length) { return " " }
        var v = args[i]
        if (v === undefined || v === null) { return " " }
