TupSliceAhead = :script(~~
    (function() {
        var i = 0
        // The `[` of a suffix is matched AFTER whitespace skipping, so step over it.
        while (i < 4096) {
            var w = c.peek(i)
            if (w === 32 || w === 9 || w === 10 || w === 13 || w === 12) { i++; continue }
            break
