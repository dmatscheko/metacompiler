                var w = 1
                if (c == 13 && i + 1 < s.length && s.charCodeAt(i + 1) == 10) { w = 2 }
                if (keepends) { out.push(s.substring(start, i + w)) }
                else { out.push(s.substring(start, i)) }
                i = i + w
                start = i
            } else {
                i = i + 1
