    // N) to its attribute N, raising CPython's ImportError when there is none. A
    // runtime module (pyRtMod) binds the same way, except that a name it does not
    // provide stays unbound instead of failing the import: its surface is a subset
    // of CPython's, and `from typing import List` for an annotation must not
    // abort. `import os.path` binds os, and `import os.path as A` binds A only
    // when the module has the attribute. A project file has no module object; its
    // names are bound flat already, so only an `as` alias needs a binding. Each
    // binding is Python source compiled by this grammar, so it follows the
    // assignment and scoping rules of any other.
    // Twin of the same functions in python-to-llvm-ir.abnf.
    var pyImportKind = ""
    function pyImportStmt(src, rule) {
        return c.compile(c.parseFrom(c.agrammar, src, rule)).stack[0]
    }
    // The runtime module a stdlib import path names (its first component), or "".
    function pyRtMod(path) {
        if (pyImportKind != "") { return "" }
        var top = path.split(".")[0]
        for (var i = 0; i < core.stdlibImports.length; i++) {
            if (core.stdlibImports[i] == top) { return top }
        }
        return ""
    }
    function pyImportMod(items, pos) {
        pyImportKind = ""
        resolveImport(items[0], pos)
        var rtm = pyRtMod(items[0])
        if (rtm != "" && items.length > 1 && items[0] != rtm) {
            return pyImportStmt("try: " + items[1] + " = _mec_mod_" + items[0] + "\n" +
                                "except AttributeError: pass\n", "TryStmt")
        }
        if (rtm != "") {
            return pyImportStmt((items.length > 1 ? items[1] : rtm) + " = _mec_mod_" + rtm + "\n", "SmallLine")
        }
        var top = items[0].split(".")[0]
        // `import P.S` of a runtime submodule of a library module binds P.
        if (pyImportKind == "" && items.length == 1 && top != items[0] && pyLibMods.indexOf(top) >= 0) {
            core.importFile(top, pos)
        }
        if (pyImportKind != "lib") { return null }
        if (items.length > 1) { return pyImportStmt(items[1] + " = _mec_mod_" + items[0] + "\n", "SmallLine") }
        return pyImportStmt(top + " = _mec_mod_" + top + "\n", "SmallLine")
    }
    function pyFromImport(items, pos) {
        pyImportKind = ""
        resolveImport(items[0], pos)
        var mod = items[0]
        var rtm = pyRtMod(mod)
        // `from M import *` binds the names pyStarNames lists, a project file's
        // having been bound flat already.
        if (items.length == 2 && items[1][0] == "*") {
            if (pyImportKind == "file") { return null }
            var star = pyStarNames(mod, pyImportKind == "lib" ? load("lib/python-" + mod.split(".")[0] + ".py") : "")
            if (star.length == 0) { return null }
            var vals = []
            for (var si = 0; si < star.length; si++) { vals.push("_mec_mod_" + mod + "." + star[si]) }
            return pyImportStmt(star.join(", ") + " = " + vals.join(", ") + "\n", "SmallLine")
        }
        var binds = []
        for (var i = 1; i < items.length; i++) {
            var name = items[i][0]
            var bound = items[i].length > 1 ? items[i][1] : name
            if (rtm != "") {
                binds.push(pyImportStmt("try: " + bound + " = _mec_mod_" + mod + "." + name + "\n" +
                    "except AttributeError: pass\n", "TryStmt"))
            } else if (pyImportKind == "lib") {
                binds.push(pyImportStmt("try: " + bound + " = _mec_mod_" + mod + "." + name + "\n" +
                    "except AttributeError: raise ImportError(\"cannot import name '" + name + "' from '" + mod +
                    "' (unknown location)\") from None\n", "TryStmt"))
            } else if (pyImportKind == "file" && bound != name) {
                binds.push(pyImportStmt(bound + " = " + name + "\n", "SmallLine"))
            }
        }
        return binds.length == 0 ? null : makeSeq(binds)
    }

    c.compile(c.asg)

    // A module that defines a top-level main() (the ratchet files do) is run for its
    // definitions and then entered through it; its return value is the exit status.
    // A script without one has already done its work top to bottom.
    var entry = c.mainName
    if (entry == undefined || entry == "") { entry = "main" }
    if (hasOwn(globalScope, entry) && typeof globalScope[entry] == "function") {
        var ret = anytype
        try {
            ret = globalScope[entry]()
        } catch (e) {
            if (excIsUser(e)) {
                pyExitIfSystemExit(excValue(e))
                fail("uncaught exception: " + pyUncaughtText(excValue(e)))
            }
            throw e
        }
        exit(ret === undefined || ret === null ? 0 : ret | 0)
    }
    println("python interpreter: program ran to completion")
    exit(0)

~~) ;
