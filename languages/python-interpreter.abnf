CompIf      <~~ push({cif: pop()}) ~~>
            = "if" KwEnd OrExpr ;
// A comprehension is a CHAIN of clauses: one or more `for` clauses, each of which
// may be followed by any number of `if` clauses ([x for a in xs for x in a if x]).
CompClause  = CompFor | CompIf ;
CompFor     <~~ var it = pop(); var ct = pop(); push({cfor: ct, citer: it}) ~~>
