        var any = false
        var i = 0
        while (i < cs.length) {
            var ch = cs[i]
            if (pySIsUpCh(ch)) {
                if (prev) { return false }
                prev = true
                any = true
            } else if (pySIsLoCh(ch)) {
                if (!prev) { return false }
                prev = true
                any = true
            } else {
                prev = false
            }
            i = i + 1
        }
        return any
    }

    function pySCapitalize(s) {
