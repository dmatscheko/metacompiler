        if (name == "find" || name == "index" || name == "rfind" || name == "rindex") {
            var sub = pySStrArg(args[0])
            var st = pySAdjStart(pySOptInt(args, 1, 0), n)
            var en = pySAdjEnd(pySOptInt(args, 2, n), n)
            var at = -1
            if (name == "find" || name == "index") { at = pySFind(s, sub, st, en) }
            else { at = pySRFind(s, sub, st, en) }
            if (at < 0) {
