    function pySCount(s, sub, start, end) {
        if (start > end) { return 0 }
        if (sub.length == 0) { return pySLen(s.substring(start, end)) + 1 }
        var n = 0
        var i = start
        while (i + sub.length <= end) {
            if (s.substring(i, i + sub.length) == sub) {
                n = n + 1
                i = i + sub.length
