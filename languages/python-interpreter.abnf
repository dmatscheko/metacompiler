    // ---- the dispatch table ----

    // An integer argument (an int, a bool, or an int subclass's value), dflt when
    // it is absent. A slice window (find's start and end) also takes None for its
    // default; anywhere else None is refused like any other non-integer, each with
    // CPython's own TypeError.
    function pySIntArg(args, i, dflt, slice) {
        if (i >= args.length) { return dflt }
        var v = anytype
        v = pySUnwrap(args[i])
        if (v === undefined || v === null) {
            if (slice) { return dflt }
        } else {
            var tn = pySTypeName(v)
            if (tn == "int" || tn == "bool") { return v | 0 }
