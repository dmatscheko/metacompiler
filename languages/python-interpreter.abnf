            = "(" :whitespace(WhitespaceNL) Expression CompFor { CompClause } ")" :whitespace(Whitespace) ;
// list(v * v for v in range(4)): a generator expression as the sole call argument.
// The value model has no lazy iterator, so it is built eagerly as a list - which
// behaves the same for every use in this subset (iterate it, or hand it to list()).
GenExpArg   <~~ push(makeListComp(takeAll())) ~~>
            = Expression CompFor { CompClause } ;
SetComp     <~~ push(makeSetComp(takeAll())) ~~>
            = "{" :whitespace(WhitespaceNL) Expression CompFor { CompClause } "}" :whitespace(Whitespace) ;
SetLit      <~~ push(makeSet(takeAll())) ~~>
            = "{" :whitespace(WhitespaceNL) StarExpr { "," StarExpr } [ "," ] "}" :whitespace(Whitespace) ;

// [expr for x in iterable if cond] builds a list; the variable is comprehension local.
ListComp    <~~ push(makeListComp(takeAll())) ~~>
