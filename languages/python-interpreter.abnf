        // rather than as an object: max(1, 2.5) is 2.5.
        for (i = 1; i < vals.length; i++) {
            if (pytruthy(binOp(sign > 0 ? ">" : "<", vals[i], best))) { best = vals[i] }
        }
        return best
    }
    hostGlobals["isinstance"] = function(v, cls) { return pyIsInstance(v, cls) }
    // issubclass(C, B): B may be a TUPLE of classes, exactly as isinstance's
    // second argument may - which this half did not accept, so
    // issubclass(bool, (str, int)) was False where CPython says True. (A tuple
    // is a list in this value model; see docs/working-on-this-project.md 7.9.)
