    // re.findall: no group -> the whole matches, one group -> that group, more ->
    // the capture tuple of each match (a tuple is a list in this value model).
    function pyReFindAll(rv, s, asMatch) {
        var out = []
        var at = 0
        while (at <= s.length) {
            var m = rxSearch(rv.prog, s, at)
            if (m == null) { break }
            if (asMatch) { out.push(pyMkMatch(rv, rv.prog, s, m)) }
            else if (rv.prog.ngroups == 0) { out.push(rxGroup(rv.prog, s, m, 0)) }
            else if (rv.prog.ngroups == 1) { out.push(pyReNone(rxGroup(rv.prog, s, m, 1))) }
            else {
                var t = []
                for (var g = 1; g <= rv.prog.ngroups; g++) { t.push(pyReNone(rxGroup(rv.prog, s, m, g))) }
