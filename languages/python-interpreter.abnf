    // re.split. Unlike the engine's neutral rxSplit, Python SPLICES the capture
    // groups of each separator into the result, so this walks the matches itself.
    function pyReSplit(rv, s, maxsplit) {
        var parts = []
        var at = 0
        var last = 0
        var n = 0
        while (at <= s.length) {
            if (maxsplit > 0 && n >= maxsplit) { break }
            var m = rxSearch(rv.prog, s, at)
            if (m == null) { break }
            if (m.end == m.begin) {
                // A zero-width separator: Python 3.7+ splits there too, but never
                // twice at the same place and never at the very end.
                if (m.begin >= s.length) { break }
                parts.push(s.substring(last, m.begin))
                for (var g2 = 1; g2 <= rv.prog.ngroups; g2++) { parts.push(pyReNone(rxGroup(rv.prog, s, m, g2))) }
                last = m.begin
                at = m.begin + 1
                n = n + 1
                continue
            }
            parts.push(s.substring(last, m.begin))
            for (var g = 1; g <= rv.prog.ngroups; g++) { parts.push(pyReNone(rxGroup(rv.prog, s, m, g))) }
            last = m.end
            at = m.end
            n = n + 1
