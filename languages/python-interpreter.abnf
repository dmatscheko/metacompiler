PyBCh       = "b" | "B" ;
PyOCh       = "o" | "O" ;
PyJCh       = "j" | "J" ;
PyECh       = "e" | "E" ;
PyUndRun    = { "_" } ;
PyDig       = "0"..."9" ;
PyHexDig    = "0"..."9" | "a"..."f" | "A"..."F" ;
