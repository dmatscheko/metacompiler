// StringLit comes BEFORE FString: a StringLit is a run of adjacent pieces and an
// f-string is one of them, so trying FString first would match only the first piece
// and leave `f"a{1}" "b"` half-parsed (PEG has no backtracking into a taken match).
Primary     = EmptyTuple | GenExpParen | Grouped | StringLit | Ellipsis | PyNumLit | True | False | None
            | ListComp | ListLit | DictComp | DictLit | SetComp | SetLit | VarRef ;

// () is the empty tuple; ( a ) is plain grouping; ( a, b ) / ( a, ) is a TUPLE.
EmptyTuple  <~~ push(makeConst(pyTup([]))) ~~>
            = "(" :whitespace(WhitespaceNL) ")" :whitespace(Whitespace) ;
Grouped     <~~ push(makeParen(takeAll())) ~~>
