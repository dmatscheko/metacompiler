    // do_title (CPython Objects/unicodeobject.c): a character opens a word unless the
    // PREVIOUS one was cased, which is why "they're" titles to "They'Re".
    function pySTitle(s) {
        var cs = pySChars(s)
        var out = ""
        var prev = false
        var i = 0
        while (i < cs.length) {
            var ch = cs[i]
            if (prev) { out = out + pySLoCh(ch) }
            else { out = out + pySUpCh(ch) }
            prev = pySIsCased(ch)
            i = i + 1
        }
        return out
    }

    function pySIsTitle(s) {
