PyNumLit    = PyHexLit | PyBinLit | PyOctLit | PyImagLit | PyRealLit ;
PyHexLit    <~~ push(makeConst(pyRadixLit(pyDigits(up.in), 16))) ~~>
            = "0" :whitespace() PyXCh PyUndRun PyHexDig PyHexRest :whitespace(Whitespace) ;
PyBinLit    <~~ push(makeConst(pyRadixLit(pyDigits(up.in), 2))) ~~>
            = "0" :whitespace() PyBCh PyUndRun PyBinDig PyBinRest :whitespace(Whitespace) ;
PyOctLit    <~~ push(makeConst(pyRadixLit(pyDigits(up.in), 8))) ~~>
            = "0" :whitespace() PyOCh PyUndRun PyOctDig PyOctRest :whitespace(Whitespace) ;
PyImagLit   <~~ push(makeConst(pyImag(pyDigits(up.in)))) ~~>
