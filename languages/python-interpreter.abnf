// A logical line break: one or more newlines (blank and comment lines collapse,
// because the whitespace skip eats spaces and # comments), or the end of the file.
NL          = RealNL | AtEOF ;
RealNL      = "\n" { "\n" } ;

AtEOF = :script(~~
    (function() {
        return (c.peek(0) === -1) ? undefined : abnf.newToken("\x01not-at-eof", 0)
    })()
~~) ;

// The indentation machinery. The persistent parser stack holds the indentation
// levels; the scripts scan the spaces of the current line with c.peek().
// Indent: the line is deeper than the current level - push the new level.
Indent = :script(~~
    (function() {
        var n = 0
        while (c.peek(n) === 32) n++
        if (c.peek(n) === -1) n = -1
        var top = pop()
        if (top == null) top = 0
        push(top)
        if (n > top) { push(n); return undefined }
        return abnf.newToken("\x01expected-an-indented-block", 0)
    })()
~~) ;
// Dedent: the line (or the end of file) is shallower - pop one level.
Dedent = :script(~~
    (function() {
        var n = 0
        while (c.peek(n) === 32) n++
        if (c.peek(n) === -1) n = -1
        var top = pop()
        if (top == null) top = 0
        if (n < top) { return undefined }
        push(top)
        return abnf.newToken("\x01expected-a-dedent", 0)
    })()
~~) ;
// SameLevel: the line starts exactly at the current level.
SameLevel = :script(~~
    (function() {
        var n = 0
        while (c.peek(n) === 32) n++
        if (c.peek(n) === -1) n = -1
        var top = pop()
        if (top == null) top = 0
        push(top)
        return (n == top) ? undefined : abnf.newToken("\x01wrong-indentation-level", 0)
    })()
~~) ;

// Whitespace never includes newlines: they are structure, not noise.
// A backslash before a newline joins the lines - Python allows that anywhere, not
// only inside brackets, so it belongs in the ordinary whitespace too.
Whitespace  = { @+" \t" | Comment | LineJoin } ;
// Inside (), [] and {} a newline is NOT structure - Python joins those lines
// implicitly - so the bracketed productions switch to this whitespace and switch back
// on the closing bracket. A backslash at the end of a line joins the next one too.
WhitespaceNL = { @+" \t\r\n" | Comment | LineJoin } ;
LineJoin    = "\\" "\n" ;
Comment     = "#" :whitespace() { NotNewline } :whitespace(Whitespace) ;
NotNewline  = "\x00"..."\x09" | "\x0b"..."\U0010ffff" ;

// ---


:startScript(~~

    // Shared interpreter machinery (scopes, BRK/CONT protocol, expression and
    // statement builders); language-specific behavior is configured on `core` below.
    include("lib/interp-core.js")

    // The shared regular-expression engine (rxCompile / rxSearch / rxGroup / ...),
    // language-neutral: it takes a pattern string plus a flag string, and Python's
    // re.I / re.S / re.M / re.X bitmask is mapped onto its four letters by
    // pyReFlagStr below. rxFail is a KNOB, overridden by ASSIGNMENT (not by
    // declaration - see docs/abnf-dialect-gotchas.md).
    include("lib/regex.js")
    rxFail = function (msg) { fail(msg) }

    // The host names a program can see.
    // The builtin exception types: callables producing an instance that carries
    // the constructor arguments as .args (enough for raise/except as/e.args[N]).
    // The __class shape matches rtIsType, so type tests can discriminate later.
    function pyExcType(n) {
        return function() {
            var inst = {__class: {__name: n}, args: []}
            for (var i = 0; i < arguments.length; i++) inst.args.push(arguments[i])
            return inst
        }
    }
    hostGlobals["Exception"] = pyExcType("Exception")
    hostGlobals["ValueError"] = pyExcType("ValueError")
    hostGlobals["TypeError"] = pyExcType("TypeError")
    hostGlobals["KeyError"] = pyExcType("KeyError")
    hostGlobals["IndexError"] = pyExcType("IndexError")
    hostGlobals["RuntimeError"] = pyExcType("RuntimeError")
    hostGlobals["ZeroDivisionError"] = pyExcType("ZeroDivisionError")

    hostGlobals["print"] = function() {
        var out = ""
        for (var i = 0; i < arguments.length; i++) {
            if (i > 0) out += " "
            out += pstr(arguments[i])
        }
        println(out)
    }
    hostGlobals["len"] = function(x) {
        if (typeof x == "string") return pyLen(x)
        if (isDict(x)) return x.keys.length
        if (pyUser(x)) {
            var f = clsFind(x.__class, "__len__")
            if (f != null) { return f(x) }
        }
        return x.length
    }
    // list(x): a fresh list from any iterable (lists copy, dicts give their keys).
    hostGlobals["list"] = function(x) { return iterToList(x).slice(0) }
    hostGlobals["range"] = function(a, b) {
        var from = 0
        var to = a
        if (b !== undefined) { from = a; to = b }
        var out = []
        for (var i = from; i < to; i++) out.push(i)
        return out
    }
    // The builtin TYPE objects. They are class descriptors like any other, so
    // isinstance(x, str), type(x) is Dog and the class patterns of `match` all go
    // through the same machinery.
    var pyTypeNames = ["object", "type", "str", "int", "float", "bool", "list", "tuple",
                       "dict", "set", "bytes", "function", "NoneType", "complex"]
    for (var pti = 0; pti < pyTypeNames.length; pti++) {
        hostGlobals[pyTypeNames[pti]] = {__isclass: true, __name: pyTypeNames[pti], __bases: [], __builtin: true}
    }
    // type(v): the class of a user instance, else the builtin type object.
    function pyTypeOf(v) {
        if (pyUser(v)) { return v.__class }
        if (v === undefined || v === null) { return hostGlobals["NoneType"] }
        if (typeof v == "string") { return hostGlobals["str"] }
        if (typeof v == "boolean") { return hostGlobals["bool"] }
        // A plain number is an int and a boxed one is a float: the two are
        // different Python types and 2.0 and 2 are the same double, so nothing
        // about the VALUE can tell them apart.
        if (typeof v == "number") { return hostGlobals["int"] }
        if (isFlo(v)) { return hostGlobals["float"] }
        if (bigIsBig(v)) { return hostGlobals["int"] }
        if (isCplx(v)) { return hostGlobals["complex"] }
        if (Array.isArray(v)) { return hostGlobals["list"] }
        if (isSet(v)) { return hostGlobals["set"] }
        if (isDict(v)) { return hostGlobals["dict"] }
        if (typeof v == "function") { return hostGlobals["function"] }
        if (v.__isclass == true) { return hostGlobals["type"] }
        return hostGlobals["object"] 
    }
    // float("inf") - CPython's float_from_string accepts the three non-finite
    // SPELLINGS, case-insensitively and with an optional sign, after stripping
    // whitespace: "inf", "infinity" and "nan". JavaScript's parseFloat accepts
