// The walrus operator, name := value: it assigns and yields the value.
Walrus      <~~ var v = pop(); push(makeWalrus(pop(), v)) ~~>
            = Id <~~ push(up.in) ~~> ":=" Expression ;
// A condition position where a walrus is allowed unparenthesized.
NamedTest   = Expression ;
Ternary     <~~ push(makeTernary(takeAll())) ~~>
