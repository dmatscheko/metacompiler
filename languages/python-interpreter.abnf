SubItem     = SubSlice | SubIndex ;
SubSlice    <~~ push({sslice: makeSliceSfx(takeAll())}) ~~>
            = [ SliceLo ] ":" [ SliceHi ] [ ":" [ SliceStep ] ] ;
SubIndex    <~~ push({sitem: pop()}) ~~> = Expression ;
IndexSfx    <~~ push({kind:"index", idx: pop()}) ~~>
