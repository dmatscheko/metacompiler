    function pyMGroupDict(md) {
        var d = newDict()
        for (var i = 1; i <= md.prog.ngroups; i++) {
            var nm = rxNameAt(md.prog, i)
            if (nm != "") { dictSet(d, nm, pyReNone(rxGroup(md.prog, md.string, md.m, i))) }
        }
        return d
    }
    // Python's replacement template is \1 / \g<1> / \g<name>; lib/regex.js expands
    // \1 and \k<name>, so only the \g<...> form needs rewriting.
    function pyReTemplate(repl) {
        var out = ""
        var i = 0
        while (i < repl.length) {
            if (repl.charAt(i) == "\\" && repl.substring(i, i + 3) == "\\g<") {
                var j = i + 3
                while (j < repl.length && repl.charAt(j) != ">") { j = j + 1 }
                var nm = repl.substring(i + 3, j)
                var alldig = nm.length > 0
                for (var q = 0; q < nm.length; q++) {
                    var cc = nm.charCodeAt(q)
                    if (cc < 48 || cc > 57) { alldig = false }
                }
                if (alldig) { out += "\\" + nm } else { out += "\\k<" + nm + ">" }
                i = j + 1
                continue
            }
            if (repl.charAt(i) == "\\") { out += repl.substring(i, i + 2); i = i + 2; continue }
            out += repl.charAt(i)
            i = i + 1
        }
        return out
    }
    // re.sub / re.subn. `repl` may be a callable, which is the interpreter's job
    // (the template form goes through the engine's own expander).
    function pyReSub(rv, repl, s, count) {
        var out = ""
        var at = 0
        var last = 0
        var n = 0
        var isFn = typeof repl == "function"
        var tpl = isFn ? "" : pyReTemplate("" + repl)
        while (at <= s.length) {
            if (count > 0 && n >= count) { break }
            var m = rxSearch(rv.prog, s, at)
            if (m == null) { break }
            var md = pyMkMatch(rv, rv.prog, s, m)
            out += s.substring(last, m.begin)
            out += isFn ? "" + repl(md) : rxExpand(rv.prog, s, m, tpl)
            n = n + 1
            last = m.end
            at = m.end
            if (m.end == m.begin) {
                if (m.end < s.length) { out += s.charAt(m.end) }
                last = m.end + 1
                at = m.end + 1
