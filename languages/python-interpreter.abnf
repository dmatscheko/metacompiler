        if (name == "pop") {
            if (n == 0) { pyListErr("IndexError", "pop from empty list") }
            var pi = n - 1
            if (args.length > 0 && args[0] !== undefined && args[0] !== null) {
                pi = pyNumOf(args[0])
                if (pi < 0) { pi = pi + n }
