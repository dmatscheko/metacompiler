    // ----- super as a PROPERTY -----
    // The three property forms (a read, a store, a destructuring target) all need the
    // same pair: the class the lookup starts AT - the __super of the defining class,
    // which is resolved by name at run time exactly as super() and super.m() resolve it -
    // and the receiver, which travels separately so a getter/setter sees the right 'this'.
    function emitSuperBase(b, defName) {
        var clsV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, defName)])
        return {sup: callExt(b, memGetExt(), [clsV, emitStr(b, "__super")]),
                self: callExt(b, "js_scope_get", [curScopeV, emitStr(b, "this")])}
    }
    function emitSuperStore(b, defName, keyT, valueH) {
        var kr = keyT(b)
        var sb = emitSuperBase(kr.b, defName)
        callExt(kr.b, "js_supset", [sb.sup, sb.self, kr.v, valueH])
        return kr.b
    }
    // 'super.x' / 'super[i]' as a value.
    function makeSuperProp(item) {
        var keyT = item.skey
        var defName = curClassName
        return function(b) {
            var kr = keyT(b)
            var sb = emitSuperBase(kr.b, defName)
            return {b: kr.b, v: callExt(kr.b, "js_supget", [sb.sup, sb.self, kr.v])}
        }
    }
    // items = [{skey}, ...targetSuffixes, opString, valueThunk]. With suffixes the store is
    // an ordinary member store on a base that happens to be a super read, so the normal
    // assignment builder does all of it. Without them the store itself goes through super.
    function makeSuperAssign(items, pos) {
        var n = items.length
        var valT = items[n - 1]
        var op = items[n - 2]
        var path = items.slice(1, n - 2)
        var keyT = items[0].skey
        var defName = curClassName
        if (path.length > 0) {
            // 'super.a() = 1' is an early error in the spec; the grammar's suffix list
            // cannot refuse it, so it is refused here rather than emitted as a wrong store.
            if (path[path.length - 1].kind != "member") {
                return notImplExpr("assignment to a super call result", pos)
            }
            return makeAnyAssign([{base: makeSuperProp(items[0]), path: path}, op, valT])
        }
        if (op == "&&=" || op == "||=" || op == "??=") {
            return notImplExpr("logical assignment to a super property", pos)
        }
        return function(b) {
            var r = valT(b)
            b = r.b
            var v = r.v
            var kr = keyT(b)
            b = kr.b
            var sb = emitSuperBase(b, defName)
            if (op != "=") {
                v = emitBinOp(b, op, callExt(b, "js_supget", [sb.sup, sb.self, kr.v]), v)
            }
            callExt(b, "js_supset", [sb.sup, sb.self, kr.v, v])
