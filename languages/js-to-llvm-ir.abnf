        }
    }

    // ----- Labeled statements -----
    // labelStack holds one entry per enclosing label: {name, brk, cont}. 'break L'
    // branches to brk (the block right after the labeled statement) and 'continue L' to
    // cont (the post block of the labeled LOOP; a labeled non-loop has none, and
    // 'continue' on it is the syntax error it is in JavaScript). pendingLabel carries the
    // name from the LabeledLoop production down into the loop builder: every loop thunk
    // takes it at entry (takeLabel, which also CLEARS it, so an unlabeled loop nested in a
    // labeled block cannot steal the label) and registers its own continue target.
    var labelStack = []
    var pendingLabel = ""
    // CLOSING AN ITERATOR ON AN EARLY EXIT (docs/todo.md 1.8). forOfIters holds the
    // iterable HANDLE of every lazy for-of loop of the CURRENT IR function that
    // encloses the statement being emitted, innermost last. A for-of's entry block
    // dominates its whole body, so those SSA values are in scope at any `return` or
    // labeled break inside it - and closing them BY VALUE rather than by counting a
    // runtime stack is what makes this correct in the presence of coroutines.
    //
    // A RUNTIME STACK WAS TRIED FIRST AND IS WRONG, which is worth recording because
    // it is the route docs/todo.md 1.8 proposes. `for await` suspends INSIDE its own
    // for-of, so a suspended body leaves an entry on a global stack while unrelated
    // frames run, and any depth-based unwind then closes the wrong loop. Measured:
    // with a stack, SECTION 16's `try { await Promise.reject(r) } catch` closed
    // SECTION 38's suspended `for await` iterator and its loop answered one element
    // instead of three. Nothing here keeps runtime state, so that cannot arise.
    //
    // The list is saved and cleared with loopStack: a nested function's jumps leave
    // none of the outer loops, and its SSA values would not dominate them anyway.
    var forOfIters = []
    // Close the iterators of the for-of loops this jump LEAVES, innermost first,
    // which is the order node closes them in. `to` is the nesting depth at the
    // destination; a label bound in an ENCLOSING function reads as a deeper
    // destination than the current function's zero, so the bound is clamped rather
    // than trusted.
    function emitIterUnwind(b, to) {
        var from = to
        if (from < 0) { from = 0 }
        for (var ui = forOfIters.length - 1; ui >= from; ui--) {
            callExt(b, "js_jsiterclose", [forOfIters[ui]])
        }
    }
    function takeLabel() { var l = pendingLabel; pendingLabel = ""; return l }
    function bindLabelCont(name, contB) {
        for (var i = labelStack.length - 1; i >= 0; i--) {
            // fon is re-read INSIDE the loop that owns the label: 'continue L' and a
            // 'break L' that bindLabelBrk re-points at the loop's own closing block
            // both stay within it, so neither may unwind it a second time.
            if (labelStack[i].name == name) { labelStack[i].cont = contB; labelStack[i].fon = forOfIters.length; return }
        }
    }
    // bindLabelBrk re-points 'break L' at a block INSIDE the labeled loop instead of
    // at the block after it. Only for-of uses it, so that 'L: for (x of g) break L'
    // closes the iterator on its way out, exactly as an unlabeled break does; the
    // block it names branches on to the loop's own exit, which the labeled statement
    // then branches past, so the control flow is otherwise unchanged.
    function bindLabelBrk(name, brkB) {
        for (var i = labelStack.length - 1; i >= 0; i--) {
            if (labelStack[i].name == name) { labelStack[i].brk = brkB; labelStack[i].fon = forOfIters.length; return }
        }
    }
    function findLabel(name) {
        for (var i = labelStack.length - 1; i >= 0; i--) {
            if (labelStack[i].name == name) { return labelStack[i] }
        }
        println("js compiler error: undefined label '" + name + "'")
        exit(1)
    }
    function makeLabeledStmt(t, name) {
        return function(b) {
            var exitB = curF.NewBlock("")
            labelStack.push({name: name, brk: exitB, cont: null, fon: forOfIters.length})
            var eb = t(b)
            labelStack.pop()
            eb.NewBr(exitB)
            return exitB
        }
    }
    function makeLabeledLoop(t, name) {
        var inner = makeLabeledStmt(t, name)
        return function(b) {
            pendingLabel = name
            return inner(b)
        }
    }
    // items = [] (a plain break/continue) or [labelName].
    function makeBreakStmt(items) {
        if (items.length == 0) return makeBreak()
        var name = items[0]
        return function(b) {
            var l = findLabel(name)
            emitIterUnwind(b, l.fon) // A break to an OUTER statement abandons iterators.
            b.NewBr(l.brk)
            return deadBlock()
        }
    }
    function makeContinueStmt(items) {
        if (items.length == 0) return makeContinue()
        var name = items[0]
        return function(b) {
            var l = findLabel(name)
            if (l.cont == null) {
                println("js compiler error: 'continue " + name + "' does not label a loop")
                exit(1)
