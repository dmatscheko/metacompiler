    function makeNewFrom(calleeT, argThunks) {
        return function(b) {
            var cr = calleeT(b)
            b = cr.b
            var clsV = cr.v
            var argsV = callExt(b, "js_arr_new", [])
            b = pushArgs(b, argsV, argThunks)
            var isFn = truthy(b, callExt(b, "js_seq", [callExt(b, "js_typeof", [clsV]), emitStr(b, "function")]))
            var fnB = curF.NewBlock("")
            var clsB = curF.NewBlock("")
            var mergeB = curF.NewBlock("")
            b.NewCondBr(isFn, fnB, clsB)
            // The function form: 'this' is the new object, the arguments are unchanged.
            // js_jsctordesc files the synthetic class descriptor the instance needs to
            // answer 'new F() instanceof F' with (the interpreter half's ctorDescriptor
            // is the same table), and js_jsnewres implements [[Construct]]'s last step:
            // an OBJECT the constructor returns wins over the fresh receiver.
            var oF0 = callExt(fnB, "js_obj_new", [])
            callExt(fnB, memSetExt(), [oF0, emitStr(fnB, "__class"), callExt(fnB, "js_jsctordesc", [clsV])])
            var retF = callExt(fnB, "js_call_new", [clsV, oF0, argsV])
            var oF = callExt(fnB, "js_jsnewres", [retF, oF0])
            fnB.NewBr(mergeB)
            // The class form: the constructor convention prepends the instance.
            var oC = callExt(clsB, "js_obj_new", [])
            callExt(clsB, memSetExt(), [oC, emitStr(clsB, "__class"), clsV])
            var cargs = callExt(clsB, "js_arr_new", [])
            callExt(clsB, "js_arr_push", [cargs, oC])
            var cb = emitSpreadInto(clsB, cargs, function(bb) { return {b: bb, v: argsV} })
            var ctorV = callExt(cb, memGetExt(), [clsV, emitStr(cb, "__ctor")])
            jsCall(cb, ctorV, hUndef, cargs)
            cb.NewBr(mergeB)
            return {b: mergeB, v: mergeB.NewPhi([llvm.ir.NewIncoming(oF, fnB), llvm.ir.NewIncoming(oC, cb)])}
