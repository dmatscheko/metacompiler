                    v = emitBinOp(b, op, old, v)
                    setExt = "js_scope_set"
                }
                callExt(b, setExt, [curScopeV, nameV, v])
            } else {
                var p = emitRefPath(b, ref)
                b = p.b
                if (op != "=") {
                    var oldM = callExt(b, memGetExt(), [p.obj, p.key])
                    v = emitBinOp(b, op, oldM, v)
                }
                callExt(b, memSetExt(), [p.obj, p.key, v])
            }
            return {b: b, v: v}
        }
    }
    // items = [ref, "&&="|"||="|"??=", valueThunk]. A logical assignment SHORT CIRCUITS:
    // the target is read once, and only if the old value asks for it (falsy for ||=,
    // truthy for &&=, null/undefined for ??=) is the right side evaluated and stored. The
    // member path of a target is evaluated exactly once, before the branch, so
    // 'a[i()] ||= b' calls i() once whichever way the branch goes. The expression value is
    // the old value or the newly stored one, merged by a phi.
    function makeLogicalAssign(items) {
        var ref = items[0]
        var op = items[1]
        var valT = items[2]
        return function(b) {
            var nameV = null, objV = null, keyV = null, oldV = null
            if (ref.path.length == 0) {
                nameV = emitStr(b, ref.name)
                oldV = callExt(b, "js_scope_get", [curScopeV, nameV])
            } else {
                var p = emitRefPath(b, ref)
                b = p.b
                objV = p.obj
                keyV = p.key
                oldV = callExt(b, memGetExt(), [objV, keyV])
            }
            var assignB = curF.NewBlock("")
            var mergeB = curF.NewBlock("")
            var condI = anytype
            if (op == "??=") { condI = truthy(b, callExt(b, "js_eq", [oldV, hNull])) }
            else if (op == "||=") { condI = b.NewICmp(llvm.enum.IPredEQ, callExt(b, core.truthyExt, [oldV]), handle(0)) }
            else { condI = truthy(b, oldV) }
            var fromB = b
            b.NewCondBr(condI, assignB, mergeB)
            var r = valT(assignB)
            var ab = r.b
            if (nameV != null) { callExt(ab, "js_scope_set", [curScopeV, emitStr(ab, ref.name), r.v]) }
            else { callExt(ab, memSetExt(), [objV, keyV, r.v]) }
            ab.NewBr(mergeB)
            var phi = mergeB.NewPhi([llvm.ir.NewIncoming(r.v, ab), llvm.ir.NewIncoming(oldV, fromB)])
            return {b: mergeB, v: phi}
        }
    }

    // items = [ref, "++"|"--"]. Post increment: the expression value is the old (coerced) one.
    // ++/-- are ToNumeric-then-step, not ToNumber-then-add: a BigInt stays a BigInt
    // and steps by 1n (js_jstonumeric / js_jsstep, abnf/jsrtjsbig.go), everything else
    // becomes a number and steps by 1 exactly as js_tonum / js_add did.
    function makeIncDec(items) {
        var ref = items[0]
        var delta = (items[1] == "++") ? 1 : -1
        return function(b) {
            var oneV = callExt(b, "js_num_i", [handle(delta)])
            if (ref.path.length == 0) {
                var nameV = emitStr(b, ref.name)
                var oldV = callExt(b, "js_jstonumeric", [callExt(b, "js_scope_get", [curScopeV, nameV])])
                callExt(b, "js_scope_set", [curScopeV, nameV, callExt(b, "js_jsstep", [oldV, oneV])])
                return {b: b, v: oldV}
            }
            var p = emitRefPath(b, ref)
            b = p.b
            var oldM = callExt(b, "js_jstonumeric", [callExt(b, memGetExt(), [p.obj, p.key])])
            callExt(b, memSetExt(), [p.obj, p.key, callExt(b, "js_jsstep", [oldM, oneV])])
            return {b: b, v: oldM}
        }
    }
    // Prefix ++/--: like makeIncDec, but the expression value is the new one.
    function makePreIncDec(ref, op) {
        var delta = (op == "++") ? 1 : -1
        return function(b) {
            var oneV = callExt(b, "js_num_i", [handle(delta)])
            if (ref.path.length == 0) {
                var nameV = emitStr(b, ref.name)
                var oldV = callExt(b, "js_jstonumeric", [callExt(b, "js_scope_get", [curScopeV, nameV])])
                var newV = callExt(b, "js_jsstep", [oldV, oneV])
                callExt(b, "js_scope_set", [curScopeV, nameV, newV])
                return {b: b, v: newV}
            }
            var p = emitRefPath(b, ref)
            b = p.b
            var oldM = callExt(b, "js_jstonumeric", [callExt(b, memGetExt(), [p.obj, p.key])])
            var newM = callExt(b, "js_jsstep", [oldM, oneV])
            callExt(b, memSetExt(), [p.obj, p.key, newM])
            return {b: b, v: newM}
        }
    }

    // ----- Parameter binding -----
    // A parameter list entry is either a bare name string (the plain form) or a
    // descriptor: {pname, def} for a default and {pname, rest: true} for a rest
    // parameter. The parameters are bound in source order into the freshly opened
    // function scope, so a later default may refer to an earlier parameter
    // ('function f(a, b = a + 1)'), exactly as the spec's parameter environment does.
    // off is the index the parameters start at in the argument array (1 for an instance
    // method, whose args[0] is the receiver).
    function makeDefaultParam(items) { return {pname: items[0], def: items[1]} }
    function bindParams(b, params, argsV, off) {
        for (var i = 0; i < params.length; i++) {
            var p = params[i]
            if (typeof p == "string") {
                callExt(b, "js_scope_decl", [curScopeV, emitStr(b, p),
                                        callExt(b, "js_arg", [argsV, handle(i + off)])])
            } else if (p.ppat != undefined) {
                // A destructuring parameter: match the argument (or, for '...[a, b]', the
                // collected rest array) against the pattern.
                if (p.rest == true) {
                    b = emitArrRest(b, p.ppat, argsV, i + off, "js_scope_decl")
                } else {
                    b = bindPattern(b, p.ppat, callExt(b, "js_arg", [argsV, handle(i + off)]), "js_scope_decl")
                }
            } else if (p.rest == true) {
                b = emitRestBind(b, p.pname, argsV, i + off)
            } else {
                // A default fires for a MISSING argument and for an explicit undefined
                // ('f(undefined)' takes the default), which is exactly 'arg === undefined'.
                var av = callExt(b, "js_arg", [argsV, handle(i + off)])
                var defB = curF.NewBlock("")
                var mergeB = curF.NewBlock("")
                var fromB = b
                b.NewCondBr(truthy(b, callExt(b, "js_seq", [av, hUndef])), defB, mergeB)
                var r = p.def(defB)
                r.b.NewBr(mergeB)
                var phi = mergeB.NewPhi([llvm.ir.NewIncoming(r.v, r.b), llvm.ir.NewIncoming(av, fromB)])
                callExt(mergeB, "js_scope_decl", [curScopeV, emitStr(mergeB, p.pname), phi])
                b = mergeB
            }
        }
        return b
    }
    // '...rest': a fresh array filled with the arguments from index `start` on. The index
    // lives in a hidden 0-prefixed scope slot (no JS identifier can collide with it), the
    // same trick the for-of lowering uses.
    function emitRestBind(b, name, argsV, start) {
        var arrV = callExt(b, "js_arr_new", [])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, name), arrV])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "0rest"), callExt(b, "js_num_i", [handle(start)])])
        var headB = curF.NewBlock("")
        var bodyB = curF.NewBlock("")
        var exitB = curF.NewBlock("")
        b.NewBr(headB)
        var iV = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, "0rest")])
        var lenV = callExt(headB, memGetExt(), [argsV, emitStr(headB, "length")])
        headB.NewCondBr(truthy(headB, callExt(headB, "js_lt", [iV, lenV])), bodyB, exitB)
        var iB = callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, "0rest")])
        callExt(bodyB, "js_arr_push", [arrV, callExt(bodyB, memGetExt(), [argsV, iB])])
        callExt(bodyB, "js_scope_set", [curScopeV, emitStr(bodyB, "0rest"),
                                   callExt(bodyB, "js_add", [iB, callExt(bodyB, "js_num_i", [handle(1)])])])
        bodyB.NewBr(headB)
        return exitB
    }

    // A function body: an own IR function jsf_N(env, args) whose entry opens a scope on
    // the passed environment, binds the parameters and 'arguments', and runs the body.
    // isCtl marks a try/catch body closure: a return/break/continue leaving it emits a
    // control signal instead of a ret/br (see compile-core inCtlBody / excDispatch).
    // lexThis marks a body with a LEXICAL 'this' - an arrow function and the try/catch/
    // finally closures, which are an implementation device and not JS functions at all.
    // Those do not bind 'this' at all, so a reference to it resolves up the scope chain to
    // the enclosing function's binding, which is exactly what the spec prescribes for an
    // arrow. Every other function binds the DYNAMIC this of its call (js_this, fed by the
    // receiver that the call site handed to js_call).
    function emitFunction(paramNames, bodyT, isCtl, lexThis) {
        funcCount++
        var idx = funcCount
        var f = m.NewFunc("jsf_" + idx, i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])

        var savedF = curF
        var savedScope = curScopeV
        var savedLoops = loopStack
        var savedForOf = forOfIters
        var savedTag = curFTag
        // A try/catch/finally BODY is an IR closure too (isCtl), but it is not a
        // function of the program: an `await` inside a try inside an async body is
        // still that body's await, so the flag is carried in rather than cleared.
        // Clearing it made `try { await p } catch` answer the throw-in MARKER as a
        // value instead of raising - measured, three assertions.
        var savedAsync = inAsyncFn
        var savedAsyncGen = inAsyncGen
        if (!isCtl) { inAsyncFn = pendingAsyncFn; inAsyncGen = pendingAsyncGen }
        pendingAsyncFn = false
        pendingAsyncGen = false
        curF = f
        curFTag = idx
        loopStack = []
        forOfIters = []
        if (isCtl) { ctlEnter(idx) }

        var b = f.NewBlock("entry")
        curScopeV = callExt(b, "js_scope_new", [f.Params[0]])
        if (!isCtl && lexThis != true) {
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "this"), callExt(b, "js_this", [])])
        }
        b = bindParams(b, paramNames, f.Params[1], 0)
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "arguments"), f.Params[1]])
        var endB = bodyT(b)
        endB.NewRet(hUndef) // A function without return returns undefined.

        if (isCtl) { ctlLeave() }
        curF = savedF
        curScopeV = savedScope
        loopStack = savedLoops
        forOfIters = savedForOf
        curFTag = savedTag
        inAsyncFn = savedAsync
        inAsyncGen = savedAsyncGen
        return idx
    }
    function makeFunctionExpr(bodyT, paramNames) {
        return function(b) {
            var idx = emitFunction(paramNames, bodyT)
            return {b: b, v: callExt(b, "js_closure", [handle(idx), curScopeV])}
        }
    }

    // Arrow function: items = [{aparams:[names]}, {body: stmtThunk} | {ebody: exprThunk}].
    // A block body is a statement thunk; an expression body becomes 'return <expr>'.
    // The body thunk of an arrow: a block body is a statement thunk, an expression
    // body becomes 'return <expr>'. Shared with makeAsyncArrow.
    function arrowBody(bm) {
        if (bm.body != undefined) { return bm.body }
        var et = bm.ebody
        return function(b) { var r = et(b); r.b.NewRet(r.v); return deadBlock() }
    }
    function makeArrow(items) {
        var params = items[0].aparams
        var bodyT = arrowBody(items[1])
        return function(b) {
            var idx = emitFunction(params, bodyT, false, true)
            return {b: b, v: callExt(b, "js_closure", [handle(idx), curScopeV])}
        }
    }

    // Template literal: items = [{str:"chunk"} | {expr: thunk}...].
    //
    // Every interpolated PART goes through js_jsstr - JavaScript's ToString, which is
    // ToPrimitive with hint STRING, so an object's own `toString` runs and a BigInt
    // spells its digits. The parts are strings by the time they meet, so the join is
    // the floor's plain js_add in BOTH engines.
    //
    // Seeding with "" and letting js_add coerce (what this used to do) is wrong twice
    // over, and both were measured against node: the floor's js_add stringifies an
    // object as "[object Object]" whatever `toString` it carries, and routing the ADD
    // through js_jsadd instead - the other candidate - renders `${boxedNumber}` as `5`,
    // because a template does ToString and not ToPrimitive-with-hint-default.
    function makeTemplate(items) {
        return function(b) {
            var v = emitStr(b, "")
            for (var i = 0; i < items.length; i++) {
                var pv = anytype // The chunk handle: a literal string or an expression value.
                if (items[i].str != undefined) { pv = emitStr(b, items[i].str) }
                else {
                    var r = items[i].expr(b)
                    b = r.b
                    pv = callExt(b, "js_jsstr", [r.v])
                }
                v = callExt(b, "js_add", [v, pv])
            }
            return {b: b, v: v}
        }
    }

    // A tagged template call: tag(strings, ...values). The string parts are the text
    // BETWEEN the interpolations, so there is always one more of them than there are
    // values ('x${1}y${2}' has the parts "x", "y" and the trailing ""). The parts object
    // carries them under the index keys plus 'length' and the raw (unescaped) texts under
    // 'raw' - a plain object rather than a js_arr_new array, because the runtime's arrays
    // are pure element sequences and cannot carry the 'raw' property the tag protocol
    // needs. Index reads (strings[0]) work either way: a member read stringifies its key.
    function emitTagCall(b, fnV, thisV, parts) {
        var cooked = []
        var raws = []
        var exprs = []
        var curStr = ""
        var curRaw = ""
        for (var i = 0; i < parts.length; i++) {
            if (parts[i].expr != undefined) {
                cooked.push(curStr)
                raws.push(curRaw)
                curStr = ""
                curRaw = ""
                exprs.push(parts[i].expr)
            } else {
                curStr = curStr + parts[i].str
                curRaw = curRaw + parts[i].raw
            }
        }
        cooked.push(curStr)
        raws.push(curRaw)
        var stringsV = callExt(b, "js_obj_new", [])
        var rawV = callExt(b, "js_obj_new", [])
        for (var j = 0; j < cooked.length; j++) {
            callExt(b, memSetExt(), [stringsV, emitStr(b, "" + j), emitStr(b, cooked[j])])
            callExt(b, memSetExt(), [rawV, emitStr(b, "" + j), emitStr(b, raws[j])])
        }
        callExt(b, memSetExt(), [stringsV, emitStr(b, "length"), callExt(b, "js_num_i", [handle(cooked.length)])])
        callExt(b, memSetExt(), [rawV, emitStr(b, "length"), callExt(b, "js_num_i", [handle(raws.length)])])
        callExt(b, memSetExt(), [stringsV, emitStr(b, "raw"), rawV])
        var argsV = callExt(b, "js_arr_new", [])
        callExt(b, "js_arr_push", [argsV, stringsV])
        for (var k = 0; k < exprs.length; k++) {
            var r = exprs[k](b)
            b = r.b
            callExt(b, "js_arr_push", [argsV, r.v])
        }
        return {b: b, v: jsCall(b, fnV, thisV, argsV)}
    }

    // for-of / for-in. items = [name, "of"|"in", iterThunk, bodyThunk].
    // for-of has TWO arms, chosen at run time by one structural probe:
    //   * an ITERATOR - a generator, or any object whose `next` member is callable - is
    //     driven LAZILY, one next() per iteration through the {value, done} record;
    //   * everything else (an array, a string, an object) iterates BY INDEX: the loop
    //     opens its own scope holding the iterable, the length and the index (hidden
    //     0-prefixed names that no JS identifier can collide with) and runs
    //     name = iter[i] while i < length.
    // for-in iterates the object's own keys: js_keys yields them (insertion order,
    // deterministic, __-prefixed slots skipped), and the same index loop walks that key
    // array, binding name to each key string.
    function makeForOf(items, pos) {
        // 'for await (x of xs)' pushes a {fawait} marker from its header; strip it so
        // every index below is the one the plain form has.
        var isAwait = false
        var kept = []
        for (var fi = 0; fi < items.length; fi++) {
            if (items[fi] != undefined && typeof items[fi] == "object" && items[fi].fawait != undefined) { isAwait = true }
            else { kept.push(items[fi]) }
        }
        items = kept
        var name = anytype // A name string, or a pattern node.
        name = items[0]
        var iterT = items[2]
        var bodyT = items[3]
        var isIn = items[1] == "in"
        // The target is either a plain name (a string) or a destructuring pattern node.
        var isPat = typeof name != "string"
        // An ASSIGNMENT pattern ('for ([o.a] of xs)', 'for (a.b of xs)') writes its leaves
        // instead of declaring them, which is also the only mode a member leaf works in.
        var patExt = "js_scope_decl"
        if (isPat && name.apat != undefined) { patExt = "js_scope_set_or_create"; name = name.apat }
        return function(b) {
            var lbl = takeLabel()
            var saved = curScopeV
            curScopeV = callExt(b, "js_scope_new", [saved])
            var ir = iterT(b)
            b = ir.b
            var seqV = ir.v
            // for-in materializes: js_iterable is the identity on arrays, strings and
            // objects and drains a generator, and js_keys wants the whole sequence.
            if (isIn) { seqV = callExt(b, "js_keys", [callExt(b, "js_iterable", [seqV])]) }
            // for-of does NOT, because js_iterable's drain is what made
            // 'for (const x of endless()) { ...; break }' hang and what put every one of
            // the producer's side effects before the first of the consumer's. The probe
            // for "drive this lazily" is STRUCTURAL - a callable `next` member. There are
            // no symbols in this subset, so Symbol.iterator cannot be consulted; and an
            // array, a string and a plain object answer no `next`, so they keep the index
            // arm below, unchanged.
            //
            // A BREAK out of the lazy arm CLOSES the iterator, as node does: the loop's
            // brk target is closeB below, which calls the iterator's `return()` when it
            // has a callable one. The floor's tag-15 cell answers `return` since
            // runtime.c's gen_close, and both it and abnf/jsrt.go's closeBody run the
            // body's `finally` clauses, so the two engines agree - which is exactly what
            // this used to be unable to buy. A LABELED break to THIS loop closes it too
            // (bindLabelBrk re-points the label at closeB). What is still NOT closed: a
            // `return` or a `throw` leaving the loop body, and a labeled break to an
            // OUTER statement - none of the three reaches a block this emitter owns, one
            // rets the frame, one longjmps and one branches to the outer label's exit.
            // node closes the iterator in all three; the interpreter half deliberately
            // does not either, so the two halves agree (js-interpreter.abnf makeForOf).
            var lazy = !isIn
            var isItV = anytype // A handle: the probe's result, or the constant false.
            var nxV = anytype   // A handle: the `next` member, or undefined.
            isItV = hFalse
            nxV = hUndef
            if (lazy) {
                nxV = callExt(b, memGetExt(), [seqV, emitStr(b, "next")])
                isItV = callExt(b, "js_seq", [callExt(b, "js_typeof", [nxV]), emitStr(b, "function")])
            }
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "0it"), seqV])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "0len"), hUndef])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "0i"), callExt(b, "js_num_i", [handle(0)])])
            if (!isPat) { callExt(b, "js_scope_decl", [curScopeV, emitStr(b, name), hUndef]) }
            var headB = curF.NewBlock("")
            var stepB = headB               // the lazy arm: one next() call, when there is one
            if (lazy) { stepB = curF.NewBlock("") }
            var idxB = curF.NewBlock("")    // the index arm: i < length
            var elemB = curF.NewBlock("")   // the index arm's element read
            var lenB = curF.NewBlock("")    // the index arm's one-time length read
            var bodyB = curF.NewBlock("")
            var postB = curF.NewBlock("")
            var exitB = curF.NewBlock("")
            // The length is read on the INDEX arm only: a generator has no 'length'
            // member, and the two runtimes need not agree on what asking for one means.
            // The probe is truthy-tested ONCE, in the entry block that dominates the
            // whole loop, so the arm test in the head costs a branch and not a call -
            // an index loop over an array makes exactly the externs it made before.
            var isItC = anytype // The i1 the two arm tests branch on.
            isItC = handle(0)
            if (lazy) {
                isItC = truthy(b, isItV)
                b.NewCondBr(isItC, headB, lenB)
            } else { b.NewBr(lenB) }
            callExt(lenB, "js_scope_set", [curScopeV, emitStr(lenB, "0len"),
                    callExt(lenB, "js_tonum", [callExt(lenB, memGetExt(), [seqV, emitStr(lenB, "length")])])])
            lenB.NewBr(headB)
            if (lazy) { headB.NewCondBr(isItC, stepB, idxB) }
            else      { headB.NewBr(idxB) }
            // The lazy arm. js_call is given the iterator as its receiver, so a
            // hand-written 'next()' that reads `this` works; a generator's own next is a
            // bound method and ignores it.
            var stepElemV = anytype // A handle: the yielded value.
            stepElemV = hUndef
            if (lazy) {
                var stV = callExt(jsThisSet(stepB, seqV), "js_call",
                                  [nxV, seqV, callExt(stepB, "js_arr_new", [])])
                // 'for await' over an ITERATOR awaits the next() RESULT: an async
                // iterator answers a promise for the {value, done} record, and a plain
                // one answers the record, which awaiting passes through.
                if (isAwait) { stV = emitAwait(stepB, stV) }
                stepElemV = callExt(stepB, memGetExt(), [stV, emitStr(stepB, "value")])
                stepB.NewCondBr(truthy(stepB, callExt(stepB, memGetExt(), [stV, emitStr(stepB, "done")])),
                                exitB, bodyB)
            }
            // The index arm.
            var iC = callExt(idxB, "js_scope_get", [curScopeV, emitStr(idxB, "0i")])
            var lC = callExt(idxB, "js_scope_get", [curScopeV, emitStr(idxB, "0len")])
            idxB.NewCondBr(truthy(idxB, callExt(idxB, "js_lt", [iC, lC])), elemB, exitB)
            var iB = callExt(elemB, "js_scope_get", [curScopeV, emitStr(elemB, "0i")])
            var itB = callExt(elemB, "js_scope_get", [curScopeV, emitStr(elemB, "0it")])
            var idxElemV = callExt(elemB, memGetExt(), [itB, iB])
            // 'for await' over an ARRAY or a string awaits each ELEMENT, which is what
            // the specification's async-from-sync iterator does and what makes
            // 'for await (x of [p1, p2])' see the resolved values.
            if (isAwait) { idxElemV = emitAwait(elemB, idxElemV) }
            elemB.NewBr(bodyB)
            var elemIn = [llvm.ir.NewIncoming(idxElemV, elemB)]
            if (lazy) { elemIn.push(llvm.ir.NewIncoming(stepElemV, stepB)) }
            var elemV = bodyB.NewPhi(elemIn)
            // A pattern target is re-bound per iteration (its leaves are fresh
            // declarations in the loop scope); a plain name reuses its single slot.
            if (isPat) { bodyB = bindPattern(bodyB, name, elemV, patExt) }
            else { callExt(bodyB, "js_scope_set", [curScopeV, emitStr(bodyB, name), elemV]) }
            var brkB = exitB   // where `break` goes: exitB, or the closing block below.
            if (lazy) {
                var closeB = curF.NewBlock("")
                var doCloseB = curF.NewBlock("")
                brkB = closeB
                var retV = callExt(closeB, memGetExt(), [seqV, emitStr(closeB, "return")])
                closeB.NewCondBr(truthy(closeB, callExt(closeB, "js_seq",
                                        [callExt(closeB, "js_typeof", [retV]), emitStr(closeB, "function")])),
                                 doCloseB, exitB)
                callExt(jsThisSet(doCloseB, seqV), "js_call",
                        [retV, seqV, callExt(doCloseB, "js_arr_new", [])])
                doCloseB.NewBr(exitB)
            }
            // docs/todo.md 1.8: while the BODY is emitted, this loop's iterable is one
            // of the handles a `return` or a labeled break to an outer statement has to
            // close on its way out. seqV is defined in the entry block, which dominates
            // the body, so it is a legal operand at every such site.
            if (lazy) { forOfIters.push(seqV) }
            loopStack.push({cont: postB, brk: brkB})
            if (lbl != "") { bindLabelCont(lbl, postB) }
            if (lbl != "" && lazy) { bindLabelBrk(lbl, brkB) }
            bodyT(bodyB).NewBr(postB)
            loopStack.pop()
            if (lazy) { forOfIters.pop() }
            var iP = callExt(postB, "js_scope_get", [curScopeV, emitStr(postB, "0i")])
            var nextV = callExt(postB, "js_add", [iP, callExt(postB, "js_num_i", [handle(1)])])
            callExt(postB, "js_scope_set", [curScopeV, emitStr(postB, "0i"), nextV])
            postB.NewBr(headB)
            curScopeV = saved
            return exitB
        }
    }

    // ----- Destructuring patterns -----
    // A pattern is a tree of nodes built by the D* productions:
    //   {dtype:"id",   name, def?}        a leaf name, with an optional default
    //   {dtype:"hole"}                    an array position that binds nothing
    //   {dtype:"arr",  elems[], def?}     positional, elems may hold a "rest" node
    //   {dtype:"obj",  fields[], def?}    by key, fields may hold an "orest" node
    //   {dtype:"rest", pat}               '...' inside an array pattern
    //   {dtype:"orest",name}              '...' inside an object pattern
    // An object field is {dkey|dkeyT, pat}: a static key name, or a value thunk for a
    // computed/literal key.
    // bindPattern walks the tree against a value handle and emits ONE binding external per
    // leaf. Which external that is decides what the pattern means: js_scope_decl for a
    // 'var/let/const' binding and a parameter, js_scope_set_or_create for a destructuring
    // ASSIGNMENT ('[a, b] = [b, a]'), which writes to existing variables.

    // Attach an optional default to a freshly parsed pattern node: items is [node] or
    // [node, defaultThunk].
    function withDefault(items) {
        var node = items[0]
        if (items.length > 1) { node.def = items[1] }
        return node
    }
    function makeDFieldKeyed(items) {
        var k = items[0]
        return {dkey: k.dkey, dkeyT: k.dkeyT, pat: items[1]}
    }
    // '{x}' and '{x = 1}': the key and the bound name are the same identifier.
    function makeDFieldShort(items) {
        var node = {dtype: "id", name: items[0]}
        if (items.length > 1) { node.def = items[1] }
        return {dkey: items[0], pat: node}
    }

    // Apply a node's default: the value is replaced by the default exactly when it is
    // undefined (a present-but-undefined property takes the default too, which is what
    // 'var {r = 5} = {}' relies on). Returns {b, v}.
    function applyDefault(b, node, valueH) {
        if (node.def == undefined) { return {b: b, v: valueH} }
        var defB = curF.NewBlock("")
        var mergeB = curF.NewBlock("")
        var fromB = b
        b.NewCondBr(truthy(b, callExt(b, "js_seq", [valueH, hUndef])), defB, mergeB)
        var r = node.def(defB)
        r.b.NewBr(mergeB)
        return {b: mergeB, v: mergeB.NewPhi([llvm.ir.NewIncoming(r.v, r.b), llvm.ir.NewIncoming(valueH, fromB)])}
    }
    // Store a value through a target reference: a scope write for a bare name, a member
    // write for a path. Shared by the plain assignment and by a destructuring ASSIGNMENT,
    // whose leaves may be member targets ('[a.b] = c').
    function assignRef(b, ref, valueH) {
        if (ref.path.length == 0 && ref.base == undefined) {
            callExt(b, "js_scope_set_or_create", [curScopeV, emitStr(b, ref.name), valueH])
            return b
        }
        var p = emitRefPath(b, ref)
        callExt(p.b, memSetExt(), [p.obj, p.key, valueH])
        return p.b
    }
    function bindPattern(b, pat, valueH, declExt) {
        if (pat.dtype == "hole") { return b }
        // A super-property leaf ('[super.d] = e'): the store goes through js_supset, which
        // is a place only an ASSIGNMENT pattern has - 'var [super.d] = e' is a syntax error
        // in the spec and the declExt test below says the same thing for the member leaf.
        if (pat.dtype == "supertarget") {
            if (declExt != "js_scope_set_or_create") {
                notImpl("destructuring binding with a super target", 0)
                return b
            }
            var st = applyDefault(b, pat, valueH)
            return emitSuperStore(st.b, pat.sdef, pat.skey, st.v)
        }
        if (pat.dtype == "target") {
            // A member target is only a target in an ASSIGNMENT pattern; in a binding one
            // ('var [a.b] = c', 'function f([a.b])') there is nothing to declare.
            if (declExt != "js_scope_set_or_create") {
                notImpl("destructuring binding with a member target", 0)
                return b
            }
            var dt = applyDefault(b, pat, valueH)
            return assignRef(dt.b, pat.ref, dt.v)
        }
        var d = applyDefault(b, pat, valueH)
        b = d.b
        valueH = d.v
        if (pat.dtype == "id") {
            callExt(b, declExt, [curScopeV, emitStr(b, pat.name), valueH])
            return b
        }
        if (pat.dtype == "arr") {
            for (var i = 0; i < pat.elems.length; i++) {
                var e = pat.elems[i]
                if (e.dtype == "rest") { return emitArrRest(b, e.pat, valueH, i, declExt) }
                b = bindPattern(b, e, callExt(b, memGetExt(), [valueH, callExt(b, "js_num_i", [handle(i)])]), declExt)
            }
            return b
        }
        // An object pattern. taken collects the static keys the pattern consumed, so a
        // '...rest' field knows which properties it must leave out.
        var taken = []
        for (var j = 0; j < pat.fields.length; j++) {
            var f = pat.fields[j]
            if (f.dtype == "orest") {
                b = emitObjRest(b, f.name, valueH, taken, declExt)
                continue
            }
            var keyV = anytype
            if (f.dkeyT != undefined) {
                var kr = f.dkeyT(b)
                b = kr.b
                keyV = kr.v
            } else {
                keyV = emitStr(b, f.dkey)
                taken.push(f.dkey)
            }
            b = bindPattern(b, f.pat, callExt(b, memGetExt(), [valueH, keyV]), declExt)
        }
        return b
    }
    // '[a, ...rest]': collect the elements from index `start` on into a fresh array and
    // match the sub-pattern against it. The loop counter lives in a throw-away scope, so
    // several rest patterns in one function cannot overwrite each other's slot.
    function emitArrRest(b, subPat, valueH, start, declExt) {
        var arrV = callExt(b, "js_arr_new", [])
        var saved = curScopeV
        curScopeV = callExt(b, "js_scope_new", [saved])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "0rsrc"), valueH])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "0ri"), callExt(b, "js_num_i", [handle(start)])])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "0rlen"),
                                callExt(b, "js_tonum", [callExt(b, memGetExt(), [valueH, emitStr(b, "length")])])])
        var headB = curF.NewBlock("")
        var bodyB = curF.NewBlock("")
        var exitB = curF.NewBlock("")
        b.NewBr(headB)
        var iH = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, "0ri")])
        var lH = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, "0rlen")])
        headB.NewCondBr(truthy(headB, callExt(headB, "js_lt", [iH, lH])), bodyB, exitB)
        var iB = callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, "0ri")])
        var sB = callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, "0rsrc")])
        callExt(bodyB, "js_arr_push", [arrV, callExt(bodyB, memGetExt(), [sB, iB])])
        callExt(bodyB, "js_scope_set", [curScopeV, emitStr(bodyB, "0ri"),
                                   callExt(bodyB, "js_add", [iB, callExt(bodyB, "js_num_i", [handle(1)])])])
        bodyB.NewBr(headB)
        curScopeV = saved
        return bindPattern(exitB, subPat, arrV, declExt)
    }
    // '{a, ...rest}': a fresh object with every own key of the source that the pattern did
    // not name. js_keys yields the keys in insertion order; the loop body skips a key when
    // it equals one of the statically taken ones (a compile-time chain of comparisons).
    function emitObjRest(b, name, valueH, taken, declExt) {
        var restV = callExt(b, "js_obj_new", [])
        var saved = curScopeV
        curScopeV = callExt(b, "js_scope_new", [saved])
        var keysV = callExt(b, "js_keys", [valueH])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "0ork"), keysV])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "0orsrc"), valueH])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "0ori"), callExt(b, "js_num_i", [handle(0)])])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "0orlen"),
                                callExt(b, "js_tonum", [callExt(b, memGetExt(), [keysV, emitStr(b, "length")])])])
        var headB = curF.NewBlock("")
        var bodyB = curF.NewBlock("")
        var setB = curF.NewBlock("")
        var contB = curF.NewBlock("")
        var exitB = curF.NewBlock("")
        b.NewBr(headB)
        var iH = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, "0ori")])
        var lH = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, "0orlen")])
        headB.NewCondBr(truthy(headB, callExt(headB, "js_lt", [iH, lH])), bodyB, exitB)
        var ksB = callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, "0ork")])
        var iB = callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, "0ori")])
        var srcB = callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, "0orsrc")])
        var keyB = callExt(bodyB, memGetExt(), [ksB, iB])
        var cb = bodyB
        for (var t = 0; t < taken.length; t++) {
            var nextB = curF.NewBlock("")
            cb.NewCondBr(truthy(cb, callExt(cb, "js_seq", [keyB, emitStr(cb, taken[t])])), contB, nextB)
            cb = nextB
        }
        cb.NewBr(setB)
        callExt(setB, memSetExt(), [restV, keyB, callExt(setB, memGetExt(), [srcB, keyB])])
        setB.NewBr(contB)
        var iC = callExt(contB, "js_scope_get", [curScopeV, emitStr(contB, "0ori")])
        callExt(contB, "js_scope_set", [curScopeV, emitStr(contB, "0ori"),
                                   callExt(contB, "js_add", [iC, callExt(contB, "js_num_i", [handle(1)])])])
        contB.NewBr(headB)
        curScopeV = saved
        callExt(exitB, declExt, [curScopeV, emitStr(exitB, name), restV])
        return exitB
    }
    // items = [patternNode, initThunk]. Evaluate the initializer once, then bind.
    function makeDestructure(items, pos) {
        var pat = items[0]
        var init = items[1]
        return function(b) {
            var r = init(b)
            return bindPattern(r.b, pat, r.v, "js_scope_decl")
        }
    }
    // A destructuring ASSIGNMENT ('[a, b] = [b, a]', '({x} = o)'): the very same pattern,
    // but the leaves are ASSIGNED rather than declared. The expression value is the right
    // hand side, as for every assignment.
    // The destructuring-target form of a super property (see ATargetSuper). A bare
    // 'super.d' is its own leaf kind, which bindPattern stores through js_supset; with
    // further suffixes ('[super.d[0]] = e') only the base is a super read and the rest is
    // an ordinary member path, so it degrades to the leaf every other member target uses.
    function makeSuperTarget(items) {
        var path = items.slice(1)
        if (path.length > 0) {
            return {dtype: "target", ref: {base: makeSuperProp(items[0]), path: path}}
        }
        return {dtype: "supertarget", skey: items[0].skey, sdef: curClassName}
    }
    function makeDestructAssign(items) {
        var pat = items[0]
        var valT = items[1]
        return function(b) {
            var r = valT(b)
            return {b: bindPattern(r.b, pat, r.v, "js_scope_set_or_create"), v: r.v}
        }
    }

    // makeCatch is shared - see lib/compile-core.js.
    // try/catch/finally: each body compiles to its own IR closure handed to js_try; the
    // try and catch bodies are ctl closures, so a return/break/continue leaving them
    // becomes a control signal that excDispatch re-issues here.
    function makeTry(items) {
        var tryT = anytype, catchT = anytype, catchName = anytype, finallyT = anytype
        for (var i = 0; i < items.length; i++) {
            if (items[i].trybody != undefined) { tryT = items[i].trybody }
            else if (items[i].catchbody != undefined) { catchT = items[i].catchbody; catchName = items[i].catchname }
            else if (items[i].finbody != undefined) { finallyT = items[i].finbody }
        }
        return function(b) {
            var tryClo = callExt(b, "js_closure", [handle(emitFunction([], tryT, true)), curScopeV])
            var catchClo = hUndef
            if (catchT != undefined) {
                var cn = (catchName != undefined) ? catchName : "__caught"
                catchClo = callExt(b, "js_closure", [handle(emitFunction([cn], catchT, true)), curScopeV])
            }
            var finClo = hUndef
            if (finallyT != undefined) {
                finClo = callExt(b, "js_closure", [handle(emitFunction([], finallyT, true)), curScopeV])
            }
            var ctl = callExt(b, "js_try", [tryClo, catchClo, finClo])
            // A RETURN out of the try body leaves the for-of loops AROUND the try as
            // well, and it arrives here as a control signal that the shared
            // excDispatch re-issues with no idea they exist - so the close is emitted
            // here, where the loops' iterable handles are still in scope. node closes
            // them after the finally body, which is where this sits. js_ctl_kind
            // answers a RAW 0/1/2/3, so the test is == 1
            // (docs/working-on-this-project.md 7.1): truthy() would take break too.
            if (forOfIters.length > 0) {
                var kindV = callExt(b, "js_ctl_kind", [ctl])
                var unwB = curF.NewBlock("")
                var afterUnwB = curF.NewBlock("")
                b.NewCondBr(b.NewICmp(llvm.enum.IPredEQ, kindV, handle(1)), unwB, afterUnwB)
                emitIterUnwind(unwB, 0)
                unwB.NewBr(afterUnwB)
                b = afterUnwB
            }
            return excDispatch(b, ctl)
        }
    }

    // ----- Classes (the __class machinery) -----
    // An instance is a js_obj_new object carrying a __class descriptor; the descriptor
    // holds the methods (js_closure over the class-defining scope) and the __ctor. A
    // method call dispatches through js_mcall (which prepends the instance as the
    // receiver and follows __super for inheritance); super.m() goes through js_supercall.

    // The class whose body is being built, captured by super() / super.m() at build time,
    // and the counter that names an anonymous class expression.
    var curClassName = ""
    var classSeq = 0
    var heritageSeq = 0

    // A private name '#x' is stored under the mangled key '__#x'. The '__' prefix is the
    // runtime's marker for an internal slot, which js_keys skips - so a private field stays
    // out of for-in, Object.keys and object spread, as a real private name does.
    function privName(name) { return "__#" + name }

    // ----- Class members -----
    // Every member production pushes ONE descriptor:
    //   {kind:"ctor",     params, body}
    //   {kind:"method",   name|nameT, statik, params, body}
    //   {kind:"field",    name|nameT, statik, init}
    //   {kind:"accessor", name|nameT, statik, acc:"get"|"set", params, body}
    //   {kind:"sblock",   body}
    //   {skip:true}                     a ';' or a member that could not be lowered
    // A name is either a plain string or, for a computed/literal key, a value thunk
    // (nameT) that emitClass evaluates once at class definition time.
    function isStaticMods(mods) {
        for (var i = 0; i < mods.length; i++) { if (mods[i] == "static") { return true } }
        return false
    }
    // A key descriptor as a {b, v} pair in the class-definition block.
    function emitMemberKey(b, m) {
        if (m.nameT != undefined) { return m.nameT(b) }
        return {b: b, v: emitStr(b, m.name)}
    }
    function makeMethod(items) {
        return {kind: "method", name: items[1].mname, statik: isStaticMods(items[0].mods),
                params: items[2], body: items[3]}
    }
    function makeCtor(items) {
        return {kind: "ctor", params: items[0], body: items[1]}
    }
    function makeField(items) {
        return {kind: "field", name: items[1].fname, statik: isStaticMods(items[0].mods),
                init: items.length > 2 ? items[2] : null}
    }
    // items = [mods, "get"|"set", key, param..., bodyThunk]: the kind is always second and
    // the body always last, so the parameters are whatever lies between (none for a getter,
    // exactly one for a setter).
    function makeClassAccessor(items) {
        return {kind: "accessor", acc: items[1], statik: isStaticMods(items[0].mods),
                name: (typeof items[2] == "string") ? items[2] : undefined,
                nameT: (typeof items[2] == "string") ? undefined : items[2],
                params: items.slice(3, items.length - 1), body: items[items.length - 1]}
    }
    // items = [mods, {amod}?, {gmod}?, key, params, bodyThunk]. An async method compiles as
    // an ordinary method; a generator method goes through the generator lowering.
    function makeClassSpecial(items) {
        var mods = items[0].mods
        var isGen = false
        var isAsync = false
        var rest = []
        for (var i = 1; i < items.length; i++) {
            if (items[i] != undefined && items[i].gmod == true) { isGen = true }
            else if (items[i] != undefined && items[i].amod == true) { isAsync = true }
            else { rest.push(items[i]) }
        }
        return {kind: "method", statik: isStaticMods(mods), gen: isGen, async: isAsync,
                name: (typeof rest[0] == "string") ? rest[0] : undefined,
                nameT: (typeof rest[0] == "string") ? undefined : rest[0],
                params: rest[1], body: rest[2]}
    }
    // items = [mods, mangledName, params, bodyThunk] for a private METHOD and
    // [mods, mangledName] / [mods, mangledName, initThunk] for a private FIELD - a method
    // is the only form that carries both a parameter list and a body, hence the length.
    function makeClassPrivate(items) {
        var statik = isStaticMods(items[0].mods)
        if (items.length > 3) {
            return {kind: "method", name: items[1], statik: statik, params: items[2], body: items[3]}
        }
        return {kind: "field", name: items[1], statik: statik,
                init: items.length > 2 ? items[2] : null}
    }
    // The same shapes with a computed or literal KEY, which arrives as a value thunk.
    function makeClassComputed(items) {
        var statik = isStaticMods(items[0].mods)
        if (items.length > 3) {
            return {kind: "method", nameT: items[1], statik: statik, params: items[2], body: items[3]}
        }
        return {kind: "field", nameT: items[1], statik: statik,
                init: items.length > 2 ? items[2] : null}
    }

    // Emits one method/constructor as jsf_N(env, args). For an instance function args[0]
    // is 'this'. A constructor (initFields != null) sets the field defaults/initializers
    // at entry; a default constructor of a subclass (implicitSuper set) first runs the
    // parent constructor with no arguments.
    function emitClassFunc(params, body, isInstance, initFields, implicitSuper) {
        funcCount++
        var idx = funcCount
        var f = m.NewFunc("jsf_" + idx, i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var savedF = curF
        var savedScope = curScopeV
        var savedLoops = loopStack
        var savedForOf = forOfIters
        // A CLASS method body is emitted here rather than through emitFunction, and it
        // used to consume neither pending flag - so `await` inside `async m() {}` was
        // the identity in this half while the interpreter half awaited, and the method
        // answered the unresolved promise. Found by probe; the object-literal form
        // always worked because it goes through makeAsyncFn.
        var savedAsync = inAsyncFn
        var savedAsyncGen = inAsyncGen
        inAsyncFn = pendingAsyncFn
        inAsyncGen = pendingAsyncGen
        pendingAsyncFn = false
        pendingAsyncGen = false
        curF = f
        loopStack = []
        forOfIters = []
        var b = f.NewBlock("entry")
        curScopeV = callExt(b, "js_scope_new", [f.Params[0]])
        var off = 0
        if (isInstance) {
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "this"), callExt(b, "js_arg", [f.Params[1], handle(0)])])
            off = 1
        }
        b = bindParams(b, params, f.Params[1], off)
        if (implicitSuper != undefined && implicitSuper != null) {
            var supCls = callExt(b, "js_scope_get", [curScopeV, emitStr(b, implicitSuper)])
            var supCtor = callExt(b, memGetExt(), [supCls, emitStr(b, "__ctor")])
            var sargsV = callExt(b, "js_arr_new", [])
            callExt(b, "js_arr_push", [sargsV, callExt(b, "js_scope_get", [curScopeV, emitStr(b, "this")])])
            jsCall(b, supCtor, hUndef, sargsV)
        }
        if (initFields != null) {
            var thisV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, "this")])
            for (var k = 0; k < initFields.length; k++) {
                var fv = hUndef
                if (initFields[k].init != null && initFields[k].init != undefined) {
                    var r = initFields[k].init(b)
                    b = r.b
                    fv = r.v
                }
                callExt(b, memSetExt(), [thisV, emitStr(b, initFields[k].name), fv])
            }
        }
        var endB = body != null ? body(b) : b
        endB.NewRet(hUndef)
        curF = savedF
        curScopeV = savedScope
        loopStack = savedLoops
        forOfIters = savedForOf
        return idx
    }

    // ----- The class descriptor -----
    // Sort the parsed members and remember the name and the parent. Shared by the
    // declaration and the expression form.
    function makeClassInfo(items) {
        var info = {name: "", superName: null, extT: null, fields: [], statics: [], methods: [],
                    accessors: [], sblocks: [], ctor: null}
        for (var i = 0; i < items.length; i++) {
            var m = items[i]
            if (m == undefined || m.skip != undefined) { continue }
            if (m.cname != undefined) { info.name = m.cname; continue }
            if (m.ext != undefined) { info.superName = m.ext; continue }
            // A heritage EXPRESSION. The value is bound to a synthetic scope name here, at
            // BUILD time, so that emitClass and emitClassFunc keep resolving the parent by
            // name exactly as they do for 'extends Name'. The '0' prefix is the same trick
            // ClassAnonName uses: no source identifier can collide with it.
            if (m.extT != undefined) {
                heritageSeq = heritageSeq + 1
                info.extT = m.extT
                info.superName = "0heritage" + heritageSeq
                continue
            }
            if (m.kind == "ctor") { info.ctor = m }
            else if (m.kind == "sblock") { info.sblocks.push(m) }
            else if (m.kind == "accessor") { info.accessors.push(m) }
            else if (m.kind == "method") { info.methods.push(m) }
            else if (m.statik) { info.statics.push(m) }
            else { info.fields.push(m) }
        }
        return info
    }
    // Build the descriptor object, bind it under the class name, then attach the static
    // fields, the constructor, the methods and the accessors, and finally run the static
    // blocks (with 'this' bound to the class, which is what a static block's this is).
    function emitClass(b, info) {
        // A heritage expression is evaluated FIRST, before anything of the class exists,
        // and bound to the synthetic name makeClassInfo reserved for it.
        if (info.extT != null) {
            var hr = info.extT(b)
            b = hr.b
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, info.superName), hr.v])
        }
        var clsV = callExt(b, "js_obj_new", [])
        callExt(b, memSetExt(), [clsV, emitStr(b, "__isclass"), hTrue])
        callExt(b, memSetExt(), [clsV, emitStr(b, "__name"), emitStr(b, info.name)])
        if (info.superName != null) {
            callExt(b, memSetExt(), [clsV, emitStr(b, "__super"),
                                  callExt(b, "js_scope_get", [curScopeV, emitStr(b, info.superName)])])
        }
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, info.name), clsV])
        for (var s = 0; s < info.statics.length; s++) {
            var kr = emitMemberKey(b, info.statics[s])
            b = kr.b
            var sv = hUndef
            if (info.statics[s].init != null && info.statics[s].init != undefined) {
                var rs = info.statics[s].init(b)
                b = rs.b
                sv = rs.v
            }
            callExt(b, memSetExt(), [clsV, kr.v, sv])
        }
        var ctorIdx = anytype
        if (info.ctor != null) {
            ctorIdx = emitClassFunc(info.ctor.params, info.ctor.body, true, info.fields, null)
        } else {
            ctorIdx = emitClassFunc([], null, true, info.fields, info.superName)
        }
        callExt(b, memSetExt(), [clsV, emitStr(b, "__ctor"), callExt(b, "js_closure", [handle(ctorIdx), curScopeV])])
        for (var mi = 0; mi < info.methods.length; mi++) {
            var mm = info.methods[mi]
            var mk = emitMemberKey(b, mm)
            b = mk.b
            var idx = anytype
            if (mm.gen == true && mm.async == true) {
                // An async generator method (docs/todo.md 1.7).
                pendingAsyncGen = true
                idx = emitClassFunc(mm.params, mm.body, !mm.statik, null, null)
                callExt(b, memSetExt(), [clsV, mk.v, callExt(b, "js_jsasyncgen",
                    [callExt(b, "js_genfn", [callExt(b, "js_closure", [handle(idx), curScopeV])])])])
                continue
            }
            if (mm.gen == true) {
                // A generator method: the same body, wrapped so that calling it produces a
                // generator object instead of running it.
                idx = emitClassFunc(mm.params, mm.body, !mm.statik, null, null)
                callExt(b, memSetExt(), [clsV, mk.v,
                    callExt(b, "js_genfn", [callExt(b, "js_closure", [handle(idx), curScopeV])])])
                continue
            }
            if (mm.async == true) {
                // An async method: the same body, driven from the microtask queue and
                // answering a promise (see makeAsyncFn).
                pendingAsyncFn = true
                idx = emitClassFunc(mm.params, mm.body, !mm.statik, null, null)
                callExt(b, memSetExt(), [clsV, mk.v, callExt(b, "js_jsasyncfn",
                    [callExt(b, "js_genfn", [callExt(b, "js_closure", [handle(idx), curScopeV])])])])
                continue
            }
            idx = emitClassFunc(mm.params, mm.body, !mm.statik, null, null)
            callExt(b, memSetExt(), [clsV, mk.v, callExt(b, "js_closure", [handle(idx), curScopeV])])
        }
        for (var ai = 0; ai < info.accessors.length; ai++) {
            var aa = info.accessors[ai]
            var ak = emitMemberKey(b, aa)
            b = ak.b
            // An accessor is invoked with the object as the RECEIVER (js_get/js_set hand it
            // to the getter/setter as `this`), not with it prepended to the arguments the
            // way a method call does, so it is emitted as an ordinary function: `this`
            // comes from js_this and the setter's value is args[0].
            var aidx = emitFunction(aa.params, aa.body, false, false)
            var aclo = callExt(b, "js_closure", [handle(aidx), curScopeV])
            var gV = (aa.acc == "get") ? aclo : hUndef
            var sV = (aa.acc == "set") ? aclo : hUndef
            callExt(b, "js_defprop", [clsV, ak.v, gV, sV])
        }
