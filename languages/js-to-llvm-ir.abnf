        return {b: b, v: clsV}
    }
    function makeClassStmt(items) {
        var info = makeClassInfo(items)
        return function(b) { return emitClass(b, info).b }
    }
    function makeClassExpr(items) {
        var info = makeClassInfo(items)
        return function(b) { return emitClass(b, info) }
    }
    // 'new.target'.
    function makeNewTarget() {
        return function(b) { return {b: b, v: callExt(b, "js_newtarget", [])} }
    }

    // 'new C(args)'. C is either a CLASS descriptor - build the instance, attach __class
    // and run __ctor(instance, args...) - or an ordinary FUNCTION used as a constructor
    // ('function Ctor(n) { this.n = n }'), where the fresh object is simply the receiver
    // of a normal call. Which one it is can only be decided at run time, so both are
    // emitted and a typeof test picks: a class descriptor is an object, a function is not.
    function makeNew(items) {
        var clsName = items[0].cls
        var argThunks = items.slice(1)
        // new RegExp(src, flags) needs its own form: the function arm below hands back the
        // FRESH object it made, not what the constructor returned, so a host constructor
        // that answers a value of its own could not use it.
        if (clsName == "RegExp") {
            return function(b) {
                var rargs = callExt(b, "js_arr_new", [])
                b = pushArgs(b, rargs, argThunks)
                return {b: b, v: callExt(b, "js_jsxregexp", [rargs])}
            }
        }
        return makeNewFrom(function(b) {
            return {b: b, v: callExt(b, "js_scope_get", [curScopeV, emitStr(b, clsName)])}
        }, argThunks)
    }
