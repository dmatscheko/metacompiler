        funcCount++
        var bidx = funcCount
        srcAt(bidx, srcOfIdx(idx))
        var f = m.NewFunc("jsf_" + bidx, i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var savedF = curF
        var savedScope = curScopeV
        curF = f
        var wb = f.NewBlock("entry")
        curScopeV = callExt(wb, "js_scope_new", [f.Params[0]])
        var thisV = callExt(wb, "js_this", [])
        if (!strict) {
