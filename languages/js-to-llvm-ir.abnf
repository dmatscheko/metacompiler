        return callExt(b, "js_jsawaitv", [callExt(b, "js_yield", [v])])
    }
    // items = [name?, params, bodyThunk] - the optional name of a function EXPRESSION is
    // recorded and bound only inside its body, so the last two items are what matters.
    function makeAsyncFuncExpr(itemsIn, txt) {
        var st = itemsStrict(itemsIn)
        var items = itemsNoStrict(itemsIn)
        var enm = itemsFnName(items)
        return fnSelf(makeAsyncFn(items[items.length - 2], items[items.length - 1], false, st, enm, txt), enm)
    }
