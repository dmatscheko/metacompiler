        b = r.b
        var saved = curScopeV
        curScopeV = callExt(b, "js_scope_new", [saved])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "0sp"), r.v])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "0spi"), callExt(b, "js_num_i", [handle(0)])])
        var lenV = callExt(b, "js_tonum", [callExt(b, memGetExt(), [r.v, emitStr(b, "length")])])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "0splen"), lenV])
        var headB = curF.NewBlock("")
        var bodyB = curF.NewBlock("")
        var exitB = curF.NewBlock("")
        b.NewBr(headB)
        var iH = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, "0spi")])
        var lH = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, "0splen")])
        headB.NewCondBr(truthy(headB, callExt(headB, "js_lt", [iH, lH])), bodyB, exitB)
        var iB = callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, "0spi")])
        var srcB = callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, "0sp")])
        callExt(bodyB, "js_arr_push", [arrV, callExt(bodyB, memGetExt(), [srcB, iB])])
        callExt(bodyB, "js_scope_set", [curScopeV, emitStr(bodyB, "0spi"),
                                   callExt(bodyB, "js_add", [iB, callExt(bodyB, "js_num_i", [handle(1)])])])
        bodyB.NewBr(headB)
        curScopeV = saved
        return exitB
    }
    // '{...src}': copy src's own keys into the literal under construction. js_keys yields
    // them in insertion order (and skips the __-prefixed internal slots), so the copy walks
    // that key array by index.
    function emitObjSpread(b, objV, t) {
        var r = t(b)
        b = r.b
        var saved = curScopeV
        curScopeV = callExt(b, "js_scope_new", [saved])
        var keysV = callExt(b, "js_keys", [r.v])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "0osk"), keysV])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "0osrc"), r.v])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "0osi"), callExt(b, "js_num_i", [handle(0)])])
        var lenV = callExt(b, "js_tonum", [callExt(b, memGetExt(), [keysV, emitStr(b, "length")])])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "0oslen"), lenV])
        var headB = curF.NewBlock("")
        var bodyB = curF.NewBlock("")
        var exitB = curF.NewBlock("")
        b.NewBr(headB)
        var iH = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, "0osi")])
        var lH = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, "0oslen")])
        headB.NewCondBr(truthy(headB, callExt(headB, "js_lt", [iH, lH])), bodyB, exitB)
        var iB = callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, "0osi")])
        var ksB = callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, "0osk")])
        var srcB = callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, "0osrc")])
        var keyB = callExt(bodyB, memGetExt(), [ksB, iB])
        callExt(bodyB, memSetExt(), [objV, keyB, callExt(bodyB, memGetExt(), [srcB, keyB])])
        callExt(bodyB, "js_scope_set", [curScopeV, emitStr(bodyB, "0osi"),
                                   callExt(bodyB, "js_add", [iB, callExt(bodyB, "js_num_i", [handle(1)])])])
        bodyB.NewBr(headB)
        curScopeV = saved
        return exitB
    }

    // A regex literal /source/flags -> a RegExp value built by js_jsxnew, which is the
    // JavaScript surface of the shared engine (abnf/jsrtregexjs.go on top of
    // abnf/jsrtregex.go; languages/lib/regex.js is the interpreter's copy). The matched
    // text still carries the trailing whitespace the production re-enabled, so it is
    // trimmed first; the LAST '/' separates the source from the flags (an inner '/' is
    // always escaped or inside a character class, both of which the RegexPart rules keep
    // out of the way). The body is handed over RAW - the engine is what reads the
    // backslashes. Every EVALUATION builds a fresh object, because lastIndex is
    // per-object state.
    //
    // A pattern the engine refuses is not reported here: it deliberately implements one
    // permissive dialect for four languages and so rejects a handful of patterns
    // JavaScript accepts (lookbehind, [[:alpha:]]). Turning those into a compile error
    // would refuse valid JavaScript, so the failure is raised when the pattern is
    // MATCHED. The parse-time half of the check is the ReStrictU guard above, which is
    // exact for 'u' mode.
    function makeRegex(src) {
        var s = src
        while (s.length > 0) {
            var lc = s.charCodeAt(s.length - 1)
            if (lc != 32 && lc != 9 && lc != 10 && lc != 13) { break }
            s = s.substring(0, s.length - 1)
        }
        var cut = s.length
        while (cut > 0 && s.charAt(cut - 1) != "/") { cut = cut - 1 }
        var body = s.substring(1, cut - 1)
        var flags = s.substring(cut)
        return function(b) {
            return {b: b, v: callExt(b, "js_jsxnew", [emitStr(b, body), emitStr(b, flags)])}
        }
    }

    // ----- Binary operator levels that are a pass-through with a single operand -----
    // The one-operand fast path returns the operand's own thunk, so an ordinary expression
    // emits exactly the IR it would without these levels in the grammar at all.
    // items = [thunk, "in"|"instanceof", thunk, ...], folded left. 'in' takes its operands
    // the other way round than the external does ('key in obj' is js_has(obj, key)).
    function makeInInstanceof(items, pos) {
        if (items.length == 1) return items[0]
        return function(b) {
            var r = items[0](b)
            b = r.b
            var v = r.v
            for (var i = 1; i < items.length; i = i + 2) {
                var rr = items[i + 1](b)
                b = rr.b
                if (items[i] == "in") { v = callExt(b, "js_has", [rr.v, v]) }
                // js_jsinstanceof also answers a plain constructor FUNCTION on the
                // right ('function F() {}; new F() instanceof F'), which the shared
                // extern reported false for because it only knows class descriptors,
                // and the Object / Array globals. It delegates for everything else.
                else { v = callExt(b, "js_jsinstanceof", [v, rr.v]) }
            }
            return {b: b, v: v}
        }
    }
    // 'delete o.k' / 'delete o[k]': evaluate the path once and drop the property.
    // A bare variable is not deletable, so the expression is simply false.
    function makeDelete(ref) {
        if (ref.path.length == 0) { return makeConst(false) }
        return function(b) {
            var p = emitRefPath(b, ref)
            // js_jsdel adds the ARRAY case: the shared js_del only knows objects, so
            // 'delete a[1]' was a silent no-op and a[1] still read 2. The slot is
            // blanked and the length left alone, which is what the interpreter half
            // has always done.
            return {b: p.b, v: callExt(p.b, "js_jsdel", [p.obj, p.key])}
        }
    }
    // 'void e': evaluate and discard.
    function makeVoid(t) {
        return function(b) { return {b: t(b).b, v: hUndef} }
    }
    // 'typeof name' for a possibly undeclared name.
    function makeTypeofName(name) {
        return function(b) {
            return {b: b, v: callExt(b, "js_scope_typeof", [curScopeV, emitStr(b, name)])}
        }
    }

    // ----- Exponentiation -----
    // js_jspow IS Math.pow (math.Pow over ToNumber) for two numbers and exact
    // arbitrary precision for two BigInts, which Math.pow cannot be: 2n ** 64n has no
    // double. It used to lower to a js_mcall on the Math host global.
    function emitPow(b, l, r) {
        return callExt(b, "js_jspow", [l, r])
    }
    // One binary operator, by its source spelling (the compound '<op>=' forms map to the
    // same operator). Everything but '**' is a single external out of binExt.
    function emitBinOp(b, op, l, r) {
        if (op == "**" || op == "**=") { return emitPow(b, l, r) }
        return callExt(b, binExt[op], [l, r])
    }
    // '**' is the one RIGHT associative binary operator of JavaScript: 2 ** 3 ** 2 is
    // 2 ** (3 ** 2) == 512. The operands are still evaluated left to right (that is
    // observable through side effects), so they are emitted in order first and only the
    // pow applications are folded from the right.
    function makeExp(items, pos) {
        if (items.length == 1) return items[0]
        return function(b) {
            var vals = []
            for (var i = 0; i < items.length; i++) {
                var r = items[i](b)
                b = r.b
                vals.push(r.v)
            }
            var v = vals[vals.length - 1]
            for (var j = vals.length - 2; j >= 0; j--) { v = emitPow(b, vals[j], v) }
            return {b: b, v: v}
        }
    }

    // ----- Nullish coalescing and the comma operator -----
    // 'a ?? b' keeps a unless a is null or undefined. The nullish test is the loose
    // equality with null, which in JavaScript is true for exactly those two values, so it
    // is one js_eq rather than two comparisons. Like || and && it short circuits, so the
    // right side gets its own block and a phi merges the two results.
    function makeNullish(items, pos) {
        if (items.length == 1) return items[0]
        return function(b) {
            var r = items[0](b)
            b = r.b
            var v = r.v
            for (var i = 1; i < items.length; i++) {
                var rightB = curF.NewBlock("")
                var mergeB = curF.NewBlock("")
                b.NewCondBr(truthy(b, callExt(b, "js_eq", [v, hNull])), rightB, mergeB)
                var r2 = items[i](rightB)
                r2.b.NewBr(mergeB)
                var phi = mergeB.NewPhi([llvm.ir.NewIncoming(r2.v, r2.b), llvm.ir.NewIncoming(v, b)])
                b = mergeB
                v = phi
            }
            return {b: b, v: v}
        }
    }
    // The comma (sequence) operator: evaluate every operand left to right, the value is
    // the last one.
    function makeSequence(items, pos) {
        if (items.length == 1) return items[0]
        return function(b) {
            var v = hUndef
            for (var i = 0; i < items.length; i++) {
                var r = items[i](b)
                b = r.b
                v = r.v
            }
            return {b: b, v: v}
        }
    }

    // js_jseq / js_jsne / js_jslt / js_jsgt / js_jsle / js_jsge are the shared
    // operators plus the ToPrimitive step the abstract equality and relational
    // comparisons need (abnf/jsrtjsprint.go). Without it an OBJECT operand never
    // reached its primitive form, so `[1] == 1`, `[2] > 1` and `({}) == "[object
    // Object]"` were all false in the compiler and true in node. Every one of them
    // delegates to the shared extern for two primitive operands, which is every
    // comparison a program that compares no objects makes.
    // Every arithmetic and bitwise operator goes through the js_js* twin rather than
    // the shared external, because a BigInt operand needs arbitrary precision and the
    // spec's mixed-operand TypeError (abnf/jsrtjsbig.go). Each twin delegates to the
    // shared one the moment neither operand is a BigInt, which is every program that
    // writes no BigInt literal.
    binExt = {"+": "js_jsadd", "-": "js_jssub", "*": "js_jsmul", "/": "js_jsdiv", "%": "js_jsmod",
                  "==": "js_jseq", "!=": "js_jsne", "===": seqExt(), "!==": sneExt(),
                  "<": "js_jslt", ">": "js_jsgt", "<=": "js_jsle", ">=": "js_jsge",
                  "|": "js_jsbor", "^": "js_jsbxor", "&": "js_jsband",
                  "<<": "js_jsshl", ">>": "js_jsshr", ">>>": "js_jsushr",
                  "+=": "js_jsadd", "-=": "js_jssub", "*=": "js_jsmul", "/=": "js_jsdiv", "%=": "js_jsmod",
                  "&=": "js_jsband", "^=": "js_jsbxor", "|=": "js_jsbor",
                  "<<=": "js_jsshl", ">>=": "js_jsshr", ">>>=": "js_jsushr"}
    wraps = {} // MetaJS numbers are not wrapped to 32 bit.

    // items = [thunk, op, thunk, op, thunk, ...] -> one left folded thunk.
    // || and && evaluate lazily and keep the deciding operand, exactly like in JS.
    // Each step branches: on a decided value the right side is skipped, a phi merges.
    // items = [thunk] or [condThunk, thenThunk, elseThunk].
    function makeCond(items) {
        if (items.length == 1) return items[0]
        return function(b) {
            var r = items[0](b)
            var thenB = curF.NewBlock("")
            var elseB = curF.NewBlock("")
            var mergeB = curF.NewBlock("")
            r.b.NewCondBr(truthy(r.b, r.v), thenB, elseB)
            var rt = items[1](thenB)
            rt.b.NewBr(mergeB)
            var re = items[2](elseB)
            re.b.NewBr(mergeB)
            var phi = mergeB.NewPhi([llvm.ir.NewIncoming(rt.v, rt.b), llvm.ir.NewIncoming(re.v, re.b)])
            return {b: mergeB, v: phi}
        }
    }

    // The elements of an array literal, with the elisions resolved: a hole contributes
    // undefined at its index, and ONE trailing hole is the trailing comma and contributes
    // nothing ('[1,2,3,]' has three elements, '[1,2,3,,]' four).
    function makeArray(items) {
        var elems = items
        if (elems.length > 0 && elems[elems.length - 1].hole == true) {
            elems = elems.slice(0, elems.length - 1)
        }
        return function(b) {
            var arr = callExt(b, "js_arr_new", [])
            b = pushArgs(b, arr, elems)
            return {b: b, v: arr}
        }
    }
    // PropDef pops [valueThunk, key]; the key is an Id string or a constant string thunk.
    function makeProp(valT, key) {
        return {kt: (typeof key == "string") ? makeConst(key) : key, t: valT}
    }
    function makeObject(props) {
        return function(b) {
            var obj = callExt(b, "js_obj_new", [])
            for (var i = 0; i < props.length; i++) {
                if (props[i].spreadT != undefined) {
                    b = emitObjSpread(b, obj, props[i].spreadT)
                    continue
                }
                var kr = props[i].kt(b)
                b = kr.b
                if (props[i].acc != undefined) {
                    // An accessor: the function becomes a closure over the literal's own
                    // scope and is registered as the get or the set half of the property.
                    // Two halves of one key merge inside js_defprop.
                    var idx = emitFunction(props[i].params, props[i].body)
                    var clo = callExt(b, "js_closure", [handle(idx), curScopeV])
                    var gV = (props[i].acc == "get") ? clo : hUndef
                    var sV = (props[i].acc == "set") ? clo : hUndef
                    callExt(b, "js_defprop", [obj, kr.v, gV, sV])
                    continue
                }
                var vr = props[i].t(b)
                b = vr.b
                callExt(b, memSetExt(), [obj, kr.v, vr.v])
            }
            return {b: b, v: obj}
        }
    }
    // ----- Generators -----
    // A generator body is an ORDINARY IR function; what makes it a generator is that the
    // closure is handed to js_genfn, so calling the result creates a generator object over
    // it instead of running it. The body then runs on its own goroutine on the host side,
    // and 'yield' is a handshake with the pending next() (see abnf/jsrt.go). The upshot for
    // the compiler is that a generator needs no code transformation at all: 'yield' is one
    // more external call, and every statement form works inside a generator unchanged.
    function makeGenFn(params, bodyT) {
        return function(b) {
            var idx = emitFunction(params, bodyT)
            return {b: b, v: callExt(b, "js_genfn", [callExt(b, "js_closure", [handle(idx), curScopeV])])}
        }
    }
    // makeAwait's lexical test: is the body currently being emitted an async function's?
    // makeAsyncFn arms pendingAsyncFn immediately before its emitFunction call and
    // emitFunction consumes it, saving and clearing inAsyncFn for every nested function -
    // so an ordinary function or an arrow inside an async body does not inherit it.
    var inAsyncFn = false
    var pendingAsyncFn = false
    // The same pair for an async GENERATOR body, which is a THIRD mode and not the
    // conjunction of the other two: inside one, `yield e` is a plain js_yield and
    // `await e` is a js_yield of a MARKED operand, and js_jsasyncgen's driver tells
    // the two apart by that marker. That is the whole of "one suspension channel"
    // (docs/todo.md 1.7) - the generator model needed nothing added to it.
    var inAsyncGen = false
    var pendingAsyncGen = false
    // ----- Async functions -----
    // An async body is compiled EXACTLY like a generator body - an ordinary IR function
    // whose awaits are yields - and js_jsasyncfn wraps the closure into a function that,
    // when called, creates the generator, drives it from the microtask queue and answers
    // a promise. So an async function needs no code transformation either, and every
    // statement form works inside one for the same reason it works inside a generator.
    function makeAsyncFn(params, bodyT, isArrow) {
        return function(b) {
            pendingAsyncFn = true // Consumed by the emitFunction call below.
            var idx = emitFunction(params, bodyT, false, isArrow)
            return {b: b, v: callExt(b, "js_jsasyncfn",
                [callExt(b, "js_genfn", [callExt(b, "js_closure", [handle(idx), curScopeV])])])}
        }
    }
    // ----- Async generators -----
    // An async generator body is compiled EXACTLY like a generator body - the awaits
    // are yields of a marked operand - and js_jsasyncgen wraps the generator FUNCTION
    // into one that answers an async-generator object: next/return/throw each answer a
    // promise, and a request queue serialises them. So an async generator needs no
    // code transformation either, and every statement form works inside one.
    function makeAsyncGenFn(params, bodyT) {
        return function(b) {
            pendingAsyncGen = true // Consumed by the emitFunction call below.
            var idx = emitFunction(params, bodyT)
            return {b: b, v: callExt(b, "js_jsasyncgen",
                [callExt(b, "js_genfn", [callExt(b, "js_closure", [handle(idx), curScopeV])])])}
        }
    }
    // items = [name?, params, bodyThunk]: the optional name of an EXPRESSION is not bound.
    function makeAsyncGenExpr(items) {
        return makeAsyncGenFn(items[items.length - 2], items[items.length - 1])
    }
    // items = [name, params, bodyThunk]: bind the async generator under its name.
    function makeAsyncGenDecl(items) {
        var fnT = makeAsyncGenFn(items[1], items[2])
        var name = items[0]
        return function(b) {
            var r = fnT(b)
            b = r.b
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, name), r.v])
            return b
        }
    }
    // 'await e': yield the operand out to the driver and unpack what it sends back.
    // OUTSIDE an async function body there is nothing to suspend - `await` there is not
    // valid JavaScript at all, and both grammars accept it as a widening - so it stays
    // the identity it was rather than aborting with "yield outside of a generator".
    // inAsyncFn is the lexical test: emitFunction clears it for every nested function,
    // so an ordinary function or an arrow inside an async body does not inherit it.
    function makeAwait(t) {
        return function(b) {
            var r = t(b)
            return {b: r.b, v: emitAwait(r.b, r.v)}
        }
    }
    // The value of `await v` at block b. Inside an async GENERATOR the operand is
    // MARKED first: the one suspension channel carries the body's yields and its
    // awaits, and js_jsasyncgen's driver tells them apart by that marker.
    function emitAwait(b, v) {
        if (inAsyncGen) {
            return callExt(b, "js_jsawaitv",
                           [callExt(b, "js_yield", [callExt(b, "js_jsawaitmark", [v])])])
        }
        if (!inAsyncFn) { return v }
        return callExt(b, "js_jsawaitv", [callExt(b, "js_yield", [v])])
    }
    // items = [name?, params, bodyThunk] - the optional name of a function EXPRESSION is
    // accepted but not bound, so the last two items are what matters.
    function makeAsyncFuncExpr(items) {
        return makeAsyncFn(items[items.length - 2], items[items.length - 1], false)
    }
    // An async arrow: the same items as makeArrow, wrapped by js_jsasyncfn. The body
    // is built through arrowBody so that an expression body is still an implicit
    // 'return <expr>' - `async x => x + 1` has to answer a promise for x + 1.
    function makeAsyncArrow(items) {
        return makeAsyncFn(items[0].aparams, arrowBody(items[1]), true)
    }
    // items = [name, params, bodyThunk]: bind the async function under its name.
    function makeAsyncFuncDecl(items) {
        var fnT = makeAsyncFn(items[1], items[2], false)
        var name = items[0]
        return function(b) {
            var r = fnT(b)
            b = r.b
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, name), r.v])
            return b
        }
    }
    // items = [name?, params, bodyThunk] - the optional name of a function EXPRESSION is
    // accepted but not bound, so the last two items are what matters.
    function makeGenFuncExpr(items) {
        return makeGenFn(items[items.length - 2], items[items.length - 1])
    }
    // items = [name, params, bodyThunk]: bind the generator function under its name.
    function makeGenFuncDecl(items) {
        var fnT = makeGenFn(items[1], items[2])
        var name = items[0]
        return function(b) {
            var r = fnT(b)
            b = r.b
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, name), r.v])
            return b
        }
    }
    // The items form of makeFuncDecl (which takes its three parts as separate pops).
    function makeFuncDeclItems(items) { return makeFuncDecl(items[2], items[1], items[0]) }
    // items = [] ('yield') or [valueThunk] ('yield e').
    function makeYield(items) {
        var t = items.length > 0 ? items[0] : null
        return function(b) {
            var v = hUndef
            if (t != null) {
                var r = t(b)
                b = r.b
                v = r.v
            }
            return {b: b, v: emitYieldSent(b, callExt(b, "js_yield", [v]))}
        }
    }
    // The value one `yield` answers - what the driver sent back in. Inside an async
    // GENERATOR the driver may resume the body with a THROW-IN record ({__athrow, v})
    // instead of a sent value: that is how ag.throw(e) raises AT the suspended yield,
    // and it is the same record an `await`'s resumption carries, so js_jsawaitv unpacks
    // both. It is emitted ONLY inside an async generator: a plain generator's next(v)
    // hands its argument through untouched, and its g.throw(v) is RAISED by the floor at
    // the yield itself, so there is no record for a plain yield to unpack.
    function emitYieldSent(b, v) {
        if (!inAsyncGen) { return v }
        return callExt(b, "js_jsawaitv", [v])
    }
    // 'yield* e': yield every element of e in turn. The value of the expression is the
    // delegate's RETURN value - the `value` of the record whose `done` ended the loop -
    // and undefined for an array or a string, which have no return value to give.
    //
    // Inside an async generator each step of the delegate is AWAITED (emitAwait below),
    // which is what makes 'yield* otherAsyncGen()' terminate: an async generator's next()
    // answers a PROMISE, whose `done` is undefined, so driving it unawaited spins forever.
    //
    // THE RESUME DISPOSITION, and why it is not a stack. The loop keeps what the driver
    // last sent in - RAW, in the scope slot 0ysent - and branches on its SHAPE at the top
    // of every turn. A normal resume drives the delegate's next() WITH the sent value
    // (the specification's `received.value`, which is how `g.next(v)` reaches a delegated
    // generator at all). A {__athrow, v} record - the one ag.throw(e) puts on the resume
    // channel, and the one emitYieldStarCatch rebuilds from the value a plain g.throw(v)
    // RAISES at this yield - drives the delegate's THROW() instead, so a delegate that
    // would catch the throw does, and the yield* carries on with what it yields next. A
    // delegate with no throw method is CLOSED through its return() and the yield* raises
    // a TypeError, which is what node does for `yield* [1,2]`.
    //
    // Both arms are driven IN FRAME. The await of a delegate step is a SUSPENSION of this
    // generator, so it cannot move into a helper function - that is the whole shape of
    // this loop.
    //
    // The state is that one slot, and the slot lives in the scope js_scope_new makes when
    // this expression is evaluated: one per yield* per generator INSTANCE, on that
    // coroutine's own frame, nothing kept in any program-wide structure across a
    // suspension. That is the constraint docs/todo.md 2.1's per-loop DEPTH STACK failed -
    // it was per-program, and `for await` suspends inside its own for-of.
    // The TRY body of the yield* barrier: hand out slot 0yout, and clear 0yopen once the
    // driver has resumed us. Reaching the clear is exactly "this yield answered
    // normally", so the finally below can tell a resume from a close with no second
    // signal. It is a ctl closure like every other js_try body (emitFunction's isCtl):
    // that carries inAsyncGen through and leaves `this` lexical, which an implementation
    // closure must - it is not a JavaScript function.
    function emitYieldStarYield() {
        return emitFunction([], function(bb) {
            var yv = callExt(bb, "js_scope_get", [curScopeV, emitStr(bb, "0yout")])
            var sv = callExt(bb, "js_yield", [yv])
            callExt(bb, "js_scope_set", [curScopeV, emitStr(bb, "0yopen"), hFalse])
            bb.NewRet(sv)
            return deadBlock()
        }, true)
    }
    // The CATCH body of the yield* barrier. g.throw(v) RAISES v at the yield the body is
    // parked at (runtime.c's gen_throw, abnf/jsrt.go's throwInto) - but at a yield*, node
    // FORWARDS the value to the delegate's throw() instead of raising it in the outer
    // body, so a delegate that would catch it does. This catch therefore turns the raised
    // value straight back into the {__athrow, v} record the loop head already dispatches
    // on for an async generator's ag.throw(), and the two paths then share every block
    // after it. 0yopen is cleared first so the FINALLY below does not also close the
    // delegate - a forward is not an abandonment. A close is unaffected: GEN_EXIT is
    // never offered to a catch clause in either engine (runtime.c's js_try).
    function emitYieldStarCatch() {
        return emitFunction(["0ythr"], function(bb) {
            callExt(bb, "js_scope_set", [curScopeV, emitStr(bb, "0yopen"), hFalse])
            var ev = callExt(bb, "js_scope_get", [curScopeV, emitStr(bb, "0ythr")])
            var recV = callExt(bb, "js_obj_new", [])
            callExt(bb, memSetExt(), [recV, emitStr(bb, "__athrow"), hTrue])
            callExt(bb, memSetExt(), [recV, emitStr(bb, "v"), ev])
            bb.NewRet(recV)
            return deadBlock()
        }, true)
    }
    // The FINALLY body: if the body left the yield abnormally - which for a generator
    // means gen_close threw GEN_EXIT in - run IteratorClose on the delegate, the same two
    // steps makeForOf's closeB emits (a callable `return` member, called on the delegate
    // as receiver). An array or a string delegate has none, and node closes neither.
    // 0yopen is cleared first so a delegate whose own return() unwinds cannot re-enter.
    function emitYieldStarClose() {
        return emitFunction([], function(bb) {
            var opV = callExt(bb, "js_scope_get", [curScopeV, emitStr(bb, "0yopen")])
            var cB = curF.NewBlock("")
            var callB = curF.NewBlock("")
            var skB = curF.NewBlock("")
            bb.NewCondBr(truthy(bb, opV), cB, skB)
            callExt(cB, "js_scope_set", [curScopeV, emitStr(cB, "0yopen"), hFalse])
            var srcV = callExt(cB, "js_scope_get", [curScopeV, emitStr(cB, "0ysrc")])
            var rfV = callExt(cB, memGetExt(), [srcV, emitStr(cB, "return")])
            cB.NewCondBr(truthy(cB, callExt(cB, "js_seq",
                                 [callExt(cB, "js_typeof", [rfV]), emitStr(cB, "function")])), callB, skB)
            callExt(jsThisSet(callB, srcV), "js_call", [rfV, srcV, callExt(callB, "js_arr_new", [])])
            callB.NewBr(skB)
            return skB
        }, true)
    }
    function makeYieldStar(t) {
        return function(b) {
            var r = t(b)
            b = r.b
            var saved = curScopeV
            curScopeV = callExt(b, "js_scope_new", [saved])
            // The delegate is driven exactly the way for-of drives one (makeForOf): an
            // ITERATOR one next() at a time, so 'yield* endless()' is a legal generator
            // rather than a hang inside js_iterable's drain, and anything else - an array,
            // a string - by index.
            var seqV = r.v
            var ynxV = callExt(b, memGetExt(), [seqV, emitStr(b, "next")])
            var yisItV = callExt(b, "js_seq", [callExt(b, "js_typeof", [ynxV]), emitStr(b, "function")])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "0ysrc"), seqV])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "0yi"), callExt(b, "js_num_i", [handle(0)])])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "0ylen"), hUndef])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "0ysent"), hUndef])
            // The two slots the CLOSE region below runs on: the value this turn hands
            // out, and whether the body is currently parked at that yield.
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "0yout"), hUndef])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "0yopen"), hFalse])
            // The two barrier closures are built ONCE, here, over the yield*'s own
            // scope: this block dominates the loop, so hoisting them out of it saves two
            // js_closure allocations per delegated element.
            var yYieldCloV = callExt(b, "js_closure", [handle(emitYieldStarYield()), curScopeV])
            var yCloseCloV = callExt(b, "js_closure", [handle(emitYieldStarClose()), curScopeV])
            var yCatchCloV = callExt(b, "js_closure", [handle(emitYieldStarCatch()), curScopeV])
            var headB = curF.NewBlock("")
            var ystepB = curF.NewBlock("")
            var yidxB = curF.NewBlock("")
            var ylenB = curF.NewBlock("")
            var joinB = curF.NewBlock("")
            var bodyB = curF.NewBlock("")
            var exitB = curF.NewBlock("")
            // The throw-in dispatch used to exist only inside an async generator, which
            // was the only driver that could send a throw-in at all. g.throw(v) gives a
            // PLAIN generator one too - emitYieldStarCatch turns the value it raises at
            // the yield into the same {__athrow, v} record - so both drivers now share
            // this block and everything after it. splitB is where the iterator/index
            // decision is made, behind the dispatch.
            var splitB = curF.NewBlock("")
            var yisItC = truthy(b, yisItV)
            b.NewCondBr(yisItC, headB, ylenB)
            callExt(ylenB, "js_scope_set", [curScopeV, emitStr(ylenB, "0ylen"),
                    callExt(ylenB, "js_tonum", [callExt(ylenB, memGetExt(), [seqV, emitStr(ylenB, "length")])])])
            ylenB.NewBr(headB)
            var ythrStV = hUndef // The record a forwarded throw() answered, for joinB's phi.
            var ythrCallB = joinB
            var hsentV = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, "0ysent")])
            var hchkB = curF.NewBlock("")
            var ythrB = curF.NewBlock("")
            ythrCallB = curF.NewBlock("")
            var ythrNoB = curF.NewBlock("")
            var yretB = curF.NewBlock("")
            var ythrowB = curF.NewBlock("")
            // The same shape test js_jsawaitv makes, in the emitter: a throw-in is
            // the only object the resume channel ever carries with __athrow set. The
            // typeof gate in front of it is not decoration - a member read of a
            // non-object aborts ("member '__athrow' of undefined"), and the very
            // first turn of this loop reads a sent value of undefined.
            headB.NewCondBr(truthy(headB, callExt(headB, "js_seq",
                                [callExt(headB, "js_typeof", [hsentV]), emitStr(headB, "object")])),
                            hchkB, splitB)
            hchkB.NewCondBr(truthy(hchkB, callExt(hchkB, memGetExt(), [hsentV, emitStr(hchkB, "__athrow")])),
                            ythrB, splitB)
            var ytfV = callExt(ythrB, memGetExt(), [seqV, emitStr(ythrB, "throw")])
            ythrB.NewCondBr(truthy(ythrB, callExt(ythrB, "js_seq",
                                [callExt(ythrB, "js_typeof", [ytfV]), emitStr(ythrB, "function")])),
                            ythrCallB, ythrNoB)
            var ythrArgsV = callExt(ythrCallB, "js_arr_new", [])
            callExt(ythrCallB, "js_arr_push",
                    [ythrArgsV, callExt(ythrCallB, memGetExt(), [hsentV, emitStr(ythrCallB, "v")])])
            ythrStV = emitAwait(ythrCallB, callExt(jsThisSet(ythrCallB, seqV), "js_call",
                                                   [ytfV, seqV, ythrArgsV]))
            ythrCallB.NewBr(joinB)
            // No throw method: close the delegate through return(), then raise the
            // TypeError node raises, spelled as the string its message renders to.
            var yrfV = callExt(ythrNoB, memGetExt(), [seqV, emitStr(ythrNoB, "return")])
            ythrNoB.NewCondBr(truthy(ythrNoB, callExt(ythrNoB, "js_seq",
                                  [callExt(ythrNoB, "js_typeof", [yrfV]), emitStr(ythrNoB, "function")])),
                              yretB, ythrowB)
            callExt(jsThisSet(yretB, seqV), "js_call", [yrfV, seqV, callExt(yretB, "js_arr_new", [])])
            yretB.NewBr(ythrowB)
            callExt(ythrowB, "js_throw",
                    [emitStr(ythrowB, "TypeError: The iterator does not provide a 'throw' method.")])
            ythrowB.NewRet(hUndef) // Never reached: js_throw does not return.
            splitB.NewCondBr(yisItC, ystepB, yidxB)
            // next(received.value): the sent value is forwarded, which is what makes
            // `g.next(v)` reach the delegate of a yield*.
            var ynxArgsV = callExt(ystepB, "js_arr_new", [])
            callExt(ystepB, "js_arr_push",
                    [ynxArgsV, callExt(ystepB, "js_scope_get", [curScopeV, emitStr(ystepB, "0ysent")])])
            var ystRawV = callExt(jsThisSet(ystepB, seqV), "js_call", [ynxV, seqV, ynxArgsV])
            // emitAwait is the identity outside an async body, so this is the same call
            // it always was for a plain generator - and one suspension per step inside an
            // async generator, exactly as the specification's async delegation does.
            var ystV = emitAwait(ystepB, ystRawV)
            ystepB.NewBr(joinB)
            // One {value, done} record, from next() or from a forwarded throw().
            var yincs = [llvm.ir.NewIncoming(ystV, ystepB)]
            yincs.push(llvm.ir.NewIncoming(ythrStV, ythrCallB))
            var yrecV = joinB.NewPhi(yincs)
            var ystepElemV = callExt(joinB, memGetExt(), [yrecV, emitStr(joinB, "value")])
            joinB.NewCondBr(truthy(joinB, callExt(joinB, memGetExt(), [yrecV, emitStr(joinB, "done")])),
                            exitB, bodyB)
            var iH = callExt(yidxB, "js_scope_get", [curScopeV, emitStr(yidxB, "0yi")])
            var lH = callExt(yidxB, "js_scope_get", [curScopeV, emitStr(yidxB, "0ylen")])
            var yelemB = curF.NewBlock("")
            yidxB.NewCondBr(truthy(yidxB, callExt(yidxB, "js_lt", [iH, lH])), yelemB, exitB)
            var iB = callExt(yelemB, "js_scope_get", [curScopeV, emitStr(yelemB, "0yi")])
            var sB = callExt(yelemB, "js_scope_get", [curScopeV, emitStr(yelemB, "0ysrc")])
            var yidxElemV = callExt(yelemB, memGetExt(), [sB, iB])
            callExt(yelemB, "js_scope_set", [curScopeV, emitStr(yelemB, "0yi"),
                                       callExt(yelemB, "js_add", [iB, callExt(yelemB, "js_num_i", [handle(1)])])])
            yelemB.NewBr(bodyB)
