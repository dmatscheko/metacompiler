    // 'return <expr>' - `async x => x + 1` has to answer a promise for x + 1.
    function makeAsyncArrow(items, txt) {
        return makeAsyncFn(items[0].aparams, arrowBody(items[1]), true, items[1].bstrict === true, "", txt)
    }
    // items = [name, params, bodyThunk]: bind the async function under its name.
    function makeAsyncFuncDecl(itemsIn, pos) {
        var st = itemsStrict(itemsIn)
        var items = itemsNoStrict(itemsIn)
        var name = items[0]
        return fnDeclAt(name, makeAsyncFn(items[1], items[2], false, st, name), pos, false)
    }
    // items = [name?, params, bodyThunk] - the optional name of a function EXPRESSION is
    // recorded and bound only inside its body, so the last two items are what matters.
    function makeGenFuncExpr(itemsIn, txt) {
        var st = itemsStrict(itemsIn)
        var items = itemsNoStrict(itemsIn)
        var enm = itemsFnName(items)
        return fnSelf(makeGenFn(items[items.length - 2], items[items.length - 1], st, enm, txt), enm)
    }
    // items = [name, params, bodyThunk]: bind the generator function under its name.
    function makeGenFuncDecl(itemsIn, pos) {
        var st = itemsStrict(itemsIn)
        var items = itemsNoStrict(itemsIn)
