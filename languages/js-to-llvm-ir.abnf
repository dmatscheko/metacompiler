    // A key that is either a name string (from the Id form) or a value thunk (a string /
    // number literal, or a computed [expr]), as a thunk in both cases.
    function keyThunk(k) { return (typeof k == "string") ? makeConst(k) : k }
    // items = ["get"|"set", key, param..., bodyThunk]. The kind is always first and the
    // body always last, so the parameters are whatever lies between - none for a getter,
    // exactly one for a setter.
    function makeAccessorProp(itemsIn) {
        var st = itemsStrict(itemsIn)
        var items = itemsNoStrict(itemsIn)
        // node names an accessor function "get k" / "set k"; nothing in this subset can
        // read one as a value, so the name is recorded for the four engines to agree
        // rather than for a program to see.
        return {kt: keyThunk(items[1]), acc: items[0], ustrict: st, sp: fsTake(),
                accName: (typeof items[1] == "string") ? (items[0] + " " + items[1]) : "",
                params: items.slice(2, items.length - 1), body: items[items.length - 1]}
    }
    // items = [{amod}?, {gmod}?, key, params, bodyThunk]. A shorthand method is an ordinary
    // property whose value is a function expression; an async method's body goes through
    // makeAsyncFn and a generator method through makeGenFn.
    function makeMethodProp(itemsIn) {
        var st = itemsStrict(itemsIn)
        var items = itemsNoStrict(itemsIn)
        var isGen = false
        var isAsync = false
        var rest = []
        for (var i = 0; i < items.length; i++) {
            if (items[i] != undefined && items[i].gmod == true) { isGen = true }
            else if (items[i] != undefined && items[i].amod == true) { isAsync = true }
            else { rest.push(items[i]) }
        }
        // A method's own name is its KEY - node says `n` for `{ n(){} }`. A COMPUTED key
        // is only known at run time, so those stay anonymous.
        var mnm = (typeof rest[0] == "string") ? rest[0] : ""
        var fnT = anytype // The function-value thunk of the method's kind.
        if (isGen && isAsync) { fnT = makeAsyncGenFn(rest[1], rest[2], st, mnm) }
        else if (isGen) { fnT = makeGenFn(rest[1], rest[2], st, mnm) }
        else if (isAsync) { fnT = makeAsyncFn(rest[1], rest[2], false, st, mnm) }
        else { fnT = makeFunctionExpr(rest[2], rest[1], st, mnm) }
        return {kt: keyThunk(rest[0]), t: fnT}
    }
    // items = [keyThunk, valueThunk] for '{[k]: v}' or [keyThunk, params, bodyThunk] for
    // the computed shorthand method '{[k](x) {}}'.
    function makeComputedProp(items) {
        if (items.length == 2) {
            fsTake()
            return {kt: items[0], t: items[1]}
        }
        return {kt: items[0], t: makeFunctionExpr(items[2], items[1])}
    }

    // items = [primaryThunk, {kind:"call"|"member", ...}...]. A member access remembers
    // its object handle, so that a directly following call uses it as 'this'.
    // A member access immediately followed by a call is a method call: look the property
    // up (js_get); if it is a function value it is called directly (js_call, this = the
    // object) - that keeps every native string/array method and object-literal method
    // working; otherwise it is a __class instance method, dispatched
    // through js_mcall (which prepends the receiver and follows __super). A call not
    // preceded by a member is a plain function call.
    // An optional link (?. ?.[ ?.( ) short circuits the WHOLE chain, not just its own
    // step: 'a?.b.c' is undefined when a is nullish, and c is never looked up. That is
    // why the guard blocks collect into shortIn and every one of them feeds undefined
    // into a single phi at the END of the chain, instead of merging step by step.
    // The nullish test is the loose equality with null, which is true for exactly null
    // and undefined.
    // ===== THE CALLEE TEXT OF A CALL SITE =======================================
    //
    // node's message for calling a non-function is the callee's SOURCE TEXT:
    //
    //   xs[1]()     TypeError: xs[1] is not a function
    //   o.nope()    TypeError: o.nope is not a function
    //   new n()     TypeError: n is not a constructor
    //
    // V8 recovers it by re-printing the AST of the call site (CallPrinter), so it is
    // NOT derivable from any runtime value: `xs[1]` and `xs[i]` reach the runtime as
    // one and the same key. It IS derivable at PARSE time, and that is what these
    // three functions do. The grammar hands the primary's own matched input over
    // (`up.in` after Primary / NewSeed) and every member suffix carries either its
    // identifier (`name`) or its bracketed source text (`txt`); siteTexts renders one
    // callee text per suffix position ONCE, while the closure is built. Nothing here
    // runs at call time - the message is a constant string chosen at parse time - so
    // the hot path is untouched: every message this emits is a COMPILE-TIME CONSTANT
    // string, emitted into the cold block that raises it, so nothing is built, looked
    // up or interned at call time. The interpreter half's siteTexts is the twin and
    // the two must render identically, or the halves disagree on the message.
    //
    // WHAT MATCHES NODE AND WHAT DOES NOT. Matching, verified against node v24: a bare
    // name, a dot chain, `this.x`, an index by identifier or by number literal, a
    // string-literal index (node prints o["k"] as o.k, so this does too), a call
    // earlier in the chain (node prints f()() as `f(...)`), and any primary that is
    // not a name (node's own "(intermediate value)"). An operation inside parentheses or an
    // index is RE-PRINTED the way V8 prints its AST - `(o.a + 1)`, `xs[(i + 1)]`, `xs[2]`
    // for xs[1+1] - by lib/js-callee.js, from the source as written (cpTxt), so a word
    // operator keeps its spacing: `(typeof o.a)`. A lone number literal prints as its
    // value, `2e3.x` reads `2000.x` (cpLiteral).
    function siteIdentOk(t) {
        // ident ( "." ident )*, which is also how `this.q` and `undefined` pass.
        if (t.length == 0) { return false }
        var atStart = true
        for (var i = 0; i < t.length; i++) {
            var c = t.charCodeAt(i)
            var alpha = (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 || c == 36
            if (atStart) {
                if (!alpha) { return false }
                atStart = false
            } else if (c == 46) {
                atStart = true
            } else if (!alpha && !(c >= 48 && c <= 57)) {
                return false
            }
        }
        return !atStart
    }
    function sitePrimaryText(t) {
        // V8 prints the callee's own source range for everything that is not a
        // COMPUTED result, literals included - `[1,2].nope`, `"abc".nope`, `1.nope`,
        // `true.nope` - and "(intermediate value)" for what a call, a `new` or a
        // function expression produced. A "(" is exactly the line between the two,
        // and it also marks a PARENTHESISED primary, whose parentheses V8 does not
        // print: `(o.g)()` reads `o.g is not a function`. So one layer is stripped
        // and the test repeated. A grammar's Primary that starts at "(" is the
        // parenthesized-expression form and is balanced by construction, so there is
        // no `(a)(b)` to mis-strip - that is a primary plus a call SUFFIX.
        if (t.length == 0) { return "(intermediate value)" }
        if (t.indexOf("(") < 0) { return cpLiteral(t) }
        if (t.charCodeAt(0) == 40 && t.charCodeAt(t.length - 1) == 41) {
            var inner = t.substring(1, t.length - 1)
            // V8 re-prints the operation inside the parentheses (lib/js-callee.js).
            var pr = cpPrint(inner)
            if (pr !== null) { return pr }
            if (inner.indexOf("(") < 0) { return inner }
        }
        return "(intermediate value)"
    }
    function siteIndexText(base, txt) {
        // txt is the suffix's own matched input, brackets and all: up.in, which has
        // its whitespace elided ("[ i + 1 ]" arrives as "[i+1]"), or the source as
        // written when that spacing matters (cpTxt). The
        // optional form's rule also matched its "?." in one grammar and not in the
        // other, so the opening bracket is SEARCHED for rather than assumed at 0.
        var open = txt.indexOf("[")
        if (open < 0) { return base + "[?]" }
        var inner = txt.substring(open + 1, txt.length - 1)
        var ix = cpIndex(inner)
        if (ix !== null) { return base + ix }
        if (inner.length >= 2) {
            var q = inner.charCodeAt(0)
            if ((q == 34 || q == 39) && inner.charCodeAt(inner.length - 1) == q) {
                var body = inner.substring(1, inner.length - 1)
                if (siteIdentOk(body)) { return base + "." + body }
            }
        }
        return base + "[" + inner + "]"
    }
    // One entry per suffix: the callee text a call AT that position would name. The
    // entry for a call that follows a member is therefore the text INCLUDING that
    // member, which is what makes `o.nope()` read `o.nope` and not `o`.
    function siteTexts(ptxt, suffixes) {
        var out = []
        var base = sitePrimaryText(ptxt)
        for (var i = 0; i < suffixes.length; i++) {
            out.push(base)
            var s = suffixes[i]
            if (s.kind == "member" || s.kind == "optmember") {
                if (s.name != undefined) { base = base + "." + s.name }
                else if (s.txt != undefined) { base = siteIndexText(base, s.txt) }
                else { base = "(intermediate value)" }
            } else if (s.kind == "call" || s.kind == "optcall" || s.kind == "tagcall") {
                base = base + "(...)"
            }
        }
        return out
    }
    // ----- the call side of the parenref rule (see ParenExpr in the grammar) ----------
    //
    // chainItems is every member chain foldCallMember has folded, in completion order,
    // and chainLastText is the matched source text of the most recent one. A chain is
    // handed out by INDEX and never by value: a record pushed onto the tag stack is
    // DEEP-COPIED, and the copy would not be the array the closures were built from.
    var chainItems = []
    var chainLastIx = 0 - 1
    var chainLastText = ""
    // The tag of '"(" Expression ")"' in a call position. The parenthesized expression has
    // already been parsed exactly once, and t is its value thunk; the only question left
    // is whether the parentheses held ONE member chain and nothing else. The last chain to
    // complete inside them is the outermost one, so comparing its text with the text
    // between the parentheses answers it - and answers NO for '(0, o.m)', '(a ? b.c : d)',
    // '(o.m || o.n)' and '(o.m = f)', where the last chain covers only part of the inside.
    function parenPrimary(t, txt) {
        // MetaJS is typed and this answers either the value thunk or a marker record, so
        // the result is declared anytype rather than returned from two arms.
        var r = anytype
        r = t
        if (txt.length < 2) { return r }
        if (chainLastIx < 0) { return r }
        if (chainLastText != txt.substring(1, txt.length - 1)) { return r }
        r = {parenchainIx: chainLastIx}
        return r
    }
    // A parenthesized member chain arrives as [{parenchainIx}, {ptxt}, outerSuffixes...];
    // the parentheses mean nothing at run time, so the inner chain's items REPLACE the
    // marker and the outer suffixes are appended to them. '(o.m)()' therefore folds to
    // precisely the item list of 'o.m()' and keeps its receiver. Nesting needs no
    // recursion here - a chain is recorded already flattened - and the inner {ptxt}
    // survives at index 1, which is what makes siteTexts name '(o.nope)()' 'o.nope', as
    // V8 does.
    function flattenParen(items) {
        var head = items[0]
        if (head == undefined || head.parenchainIx == undefined) { return items }
        return chainItems[head.parenchainIx].concat(items.slice(2))
    }
    // A method call objV[keyV](args): name is the key's spelling when it is a dotted
    // name, site the callee's text for the TypeError. Shared by an ordinary call chain
    // and a call inside an assignment target ('o.get(1).a = 2').
    function emitMethodCall(b, objV, keyV, name, args, site) {
        // js_jsmget is js_get with the String/Array method names
        // HIDDEN, so the call falls into the js_jsmcall arm below
        // rather than into the shared boundMethod path, whose
        // semantics differ (indexOf ignores its from-index, map's
        // callback gets no index, ...). Everything else delegates. A
        // member spelled `.return` reads through js_jsretmget, which
        // answers a generator's return() under node's yield* rule
        // (abnf/jsrtjsprint.go's genReturn) and delegates the rest.
        var fV = callExt(b, (name === "return") ? "js_jsretmget" : "js_jsmget", [objV, keyV])
        var argsV = callExt(b, "js_arr_new", [])
        b = pushArgs(b, argsV, args)
        var isFn = truthy(b, callExt(b, "js_seq", [callExt(b, "js_typeof", [fV]), emitStr(b, "function")]))
        var thenB = curF.NewBlock("")
        var elseB = curF.NewBlock("")
        var mergeB = curF.NewBlock("")
        b.NewCondBr(isFn, thenB, elseB)
        // js_jsxcall / js_jsxmcall are js_call / js_mcall plus the regular
        // expression surface (abnf/jsrtregexjs.go). Both delegate to the
        // extern they wrap for every receiver that is not a RegExp and
        // every string call whose argument is not a pattern.
        var tv = callExt(jsThisSet(thenB, objV), "js_jsxcall", [fV, objV, argsV])
        thenB.NewBr(mergeB)
        // js_jsmcall is js_jsxmcall plus JavaScript's String / Array /
        // Number / Object method surface (abnf/jsrtjsprint.go).
        var ev = callExt(jsThisSet(elseB, objV), "js_jsmcall", [objV, keyV, argsV])
        // ...and when nothing at all claimed the call, js_jsmcall
        // ANSWERS THE MISS SENTINEL rather than aborting, so `o.nope()`
        // raises node's catchable TypeError. The sentinel travels
        // as an ordinary handle and is compared RAW, so the taken path
        // pays one load, one icmp and a never-taken branch, and the
        // message in the cold block is a compile-time constant.
        var mOkB = curF.NewBlock("")
        var mBadB = curF.NewBlock("")
        elseB.NewCondBr(elseB.NewICmp(llvm.enum.IPredEQ, ev, elseB.NewLoad(i64, mcallMissGlob())),
                        mBadB, mOkB)
        emitSiteThrow(mBadB, site + " is not a function")
        mOkB.NewBr(mergeB)
        return {b: mergeB, v: mergeB.NewPhi([llvm.ir.NewIncoming(tv, thenB), llvm.ir.NewIncoming(ev, mOkB)])}
    }
    foldCallMember = function(items, txt) {
        items = flattenParen(items)
        // Recorded for parenPrimary. A caller with no text (NewCallee) records no chain:
        // the index goes negative rather than the text going to some impossible spelling.
        if (txt == undefined) { chainLastIx = 0 - 1 } else { chainLastIx = chainItems.length; chainLastText = txt }
        chainItems.push(items)
        if (items.length == 2) return items[0]
        var primary = items[0]
        var suffixes = items.slice(2)
        var sTexts = siteTexts(items[1].ptxt, suffixes)
        var hasOpt = false
        for (var oi = 0; oi < suffixes.length; oi++) {
            if (suffixes[oi].kind == "optmember" || suffixes[oi].kind == "optcall") { hasOpt = true }
        }
        // A super property is a Reference whose thisValue is the current 'this' - see
        // CallHead. Seeded before the loop, so a member suffix that follows overwrites it
        // exactly as it would any other receiver ('super.a.b()' calls b on super.a).
        var supThis = (items[1].supthis == true)
        // A bare name called inside a with body: the object that answered it is `this`.
        var withThis = withDepth > 0 && isIdentText(items[1].ptxt)
        return function(b) {
            var r = primary(b)
            b = r.b
            var cur = r.v
            var curThis = hUndef
            if (supThis) { curThis = callExt(b, core.scopeGetExt, [curScopeV, emitStr(b, "this")]) }
            if (withThis) { curThis = callExt(b, "js_jswithrecv", []) }
            var shortIn = []
            var i = 0
            while (i < suffixes.length) {
                var s = suffixes[i]
                if (s.kind == "optmember" || s.kind == "optcall") {
                    var contB = curF.NewBlock("")
                    var skipB = curF.NewBlock("")
                    b.NewCondBr(truthy(b, callExt(b, "js_eq", [cur, hNull])), skipB, contB)
                    shortIn.push(skipB)
                    b = contB
                }
                if (s.kind == "member" || s.kind == "optmember") {
                    var kr = s.key(b)
                    b = kr.b
                    if (i + 1 < suffixes.length && suffixes[i + 1].kind == "call") {
                        var mc = emitMethodCall(b, cur, kr.v, s.name, suffixes[i + 1].args, sTexts[i + 1])
                        b = mc.b
                        cur = mc.v
                        curThis = hUndef
                        i = i + 2
                    } else {
                        // A member read that is NOT followed by a call. js_jsvget is
                        // memGetExt() plus the two things a plain read has to answer
                        // and the call site must not: a __class method (so `typeof p.m`
                        // is "function", not "undefined") and a String/Array builtin
                        // (so `typeof [].push` stops depending on which engine runs).
                        // See languages/lib/js-rt.metajs.
                        curThis = cur
                        cur = callExt(b, (s.name === "return") ? "js_jsretvget" : "js_jsvget", [cur, kr.v])
                        i = i + 1
                    }
                } else if (s.kind == "tag") {
                    var tr = emitTagCall(b, cur, curThis, s.parts, sTexts[i])
                    b = tr.b
                    cur = tr.v
                    curThis = hUndef
                    i = i + 1
                } else {
                    var argsV2 = callExt(b, "js_arr_new", [])
                    b = pushArgs(b, argsV2, s.args)
                    var pcr = jsCallChecked(b, cur, curThis, argsV2, sTexts[i])
                    b = pcr.b
                    cur = pcr.v
                    curThis = hUndef
                    i = i + 1
                }
            }
            if (!hasOpt) { return {b: b, v: cur} }
            var mergeB = curF.NewBlock("")
            b.NewBr(mergeB)
            var inc = [llvm.ir.NewIncoming(cur, b)]
            for (var k = 0; k < shortIn.length; k++) {
                shortIn[k].NewBr(mergeB)
                inc.push(llvm.ir.NewIncoming(hUndef, shortIn[k]))
            }
            return {b: mergeB, v: mergeB.NewPhi(inc)}
        }
    }

    // Target items = [nameString, suffix marker...] -> reference descriptor.
    // Walks a target path (members and calls) up to the last element, which must
    // be a member. Returns {b, obj, key} with the object and the last key evaluated.
    // A target reference is {name, path} for the ordinary 'a.b[i]' form and {base, path}
    // when the path hangs off an arbitrary expression instead of a name ('[1].a = 2',
    // '(a ** b).c = 1'). retarget re-roots a parenthesized target and appends whatever
    // suffixes follow the ')', so '(a).b' is the very same reference as 'a.b'.
    function makeTargetBase(items) { return {base: items[0], ptxt: items[1].ptxt, path: items.slice(2)} }
    function retarget(items) {
        var inner = items[0]
        return {name: inner.name, base: inner.base, ptxt: inner.ptxt, path: inner.path.concat(items.slice(1)),
                w: inner.w, tdz: inner.tdz}
    }
    // The primary text of an assignment TARGET's reference. compile-core's shared
    // makeTargetRef answers {name, path} and is not this grammar's to change, so a
    // named target falls back to its own name - which is exactly what node prints for
    // `f().x = 1`.
    function refSiteText(ref) {
        if (ref.ptxt != undefined) { return ref.ptxt }
        if (ref.name != undefined) { return ref.name }
        return "(intermediate value)"
    }
    function emitRefPath(b, ref) {
        var cur = anytype
        if (ref.base != undefined) {
            var br = ref.base(b)
            b = br.b
            cur = br.v
        } else {
            cur = refNameGet(b, ref)
        }
        var curThis = hUndef
        var sTexts = siteTexts(refSiteText(ref), ref.path)
        var n = ref.path.length - 1
        var i = 0
        while (i < n) {
            var s = ref.path[i]
            if (s.kind == "member") {
                var kr = s.key(b)
                b = kr.b
                if (i + 1 < n && ref.path[i + 1].kind == "call") {
                    // 'o.get(1).a = 2' is the ordinary method call, receiver and all.
                    var mc = emitMethodCall(b, cur, kr.v, s.name, ref.path[i + 1].args, sTexts[i + 1])
                    b = mc.b
                    cur = mc.v
                    curThis = hUndef
                    i = i + 2
                } else {
                    curThis = cur
                    // The value read, as for 'o.m' anywhere else: `F.prototype.m = ...`
                    // and `k.m.x = 1` on a class method need what only it answers.
                    cur = callExt(b, "js_jsvget", [cur, kr.v])
                    i = i + 1
                }
            } else if (s.kind == "tag") {
                var tr = emitTagCall(b, cur, curThis, s.parts, sTexts[i])
                b = tr.b
                cur = tr.v
                curThis = hUndef
                i = i + 1
            } else {
                var argsV = callExt(b, "js_arr_new", [])
                b = pushArgs(b, argsV, s.args)
                // A call in the MIDDLE of an assignment target ('f().x = 1'): the same
                // check the ordinary call site makes.
                var rcr = jsCallChecked(b, cur, curThis, argsV, sTexts[i])
                b = rcr.b
                cur = rcr.v
                curThis = hUndef
                i = i + 1
            }
        }
        var last = ref.path[ref.path.length - 1].key(b)
        return {b: last.b, obj: cur, key: last.v}
    }
    // items = [ref, opString, valueThunk]. The logical operators short circuit and so need
    // their own lowering; every other operator goes through makeAssign.
    function makeAnyAssign(items, txt) {
        var op = items[1]
        // NamedEvaluation, the assignment form: `f = function(){}` names it "f", and only
        // for a plain '=' to a bare NAME.
        if (op == "=" && items[0].path != undefined && items[0].path.length == 0) {
            fnAnonName(items[0].name, "=", txt)
        }
        if (op == "&&=" || op == "||=" || op == "??=") { return makeLogicalAssign(items) }
        return makeAssign(items)
    }
    // items = [ref, opString, valueThunk]. The value of an assignment is the assigned value.
    function makeAssign(items) {
        var ref = items[0]
        var op = items[1]
        var valT = items[2]
        // The target's object and key are evaluated BEFORE the right-hand side, and a
        // compound assignment reads the old value before it too (ECMA-262 13.15.2).
        // Twin: makeAssign in js-interpreter.abnf.
        return function(b) {
            var oldV = anytype // A handle: the old value, for a compound assignment.
            var setExt = "js_scope_set_or_create"
            var p = anytype    // The target's {b, obj, key}, for a member target.
            if (ref.path.length == 0) {
                // Plain `=` to an undeclared name becomes an implicit global
                // (js_scope_set_or_create). A compound assignment first reads the
                // old value, so it still requires a prior declaration.
                if (op != "=") {
                    oldV = refNameGet(b, ref)
                    setExt = "js_scope_set"
                }
            } else {
                p = emitRefPath(b, ref)
                b = p.b
                if (op != "=") {
                    var og = emitOldGet(b, p.obj, p.key)
                    b = og.b
                    oldV = og.v
                }
            }
            var r = valT(b)
            b = r.b
            var v = r.v
            if (op != "=") { v = emitBinOp(b, op, oldV, v) }
            if (ref.path.length == 0) { refNameSet(b, ref, setExt, v) }
            else { b = refMemberSet(b, ref, p.obj, p.key, v) }
            return {b: b, v: v}
        }
    }
    // items = [ref, "&&="|"||="|"??=", valueThunk]. A logical assignment SHORT CIRCUITS:
    // the target is read once, and only if the old value asks for it (falsy for ||=,
    // truthy for &&=, null/undefined for ??=) is the right side evaluated and stored. The
    // member path of a target is evaluated exactly once, before the branch, so
    // 'a[i()] ||= b' calls i() once whichever way the branch goes. The expression value is
    // the old value or the newly stored one, merged by a phi.
    function makeLogicalAssign(items) {
        var ref = items[0]
        var op = items[1]
        var valT = items[2]
        return function(b) {
            var nameV = null, objV = null, keyV = null, oldV = null
            if (ref.path.length == 0) {
                nameV = emitStr(b, ref.name)
                oldV = refNameGet(b, ref)
            } else {
                var p = emitRefPath(b, ref)
                b = p.b
                objV = p.obj
                keyV = p.key
                var og = emitOldGet(b, objV, keyV)
                b = og.b
                oldV = og.v
            }
            var assignB = curF.NewBlock("")
            var mergeB = curF.NewBlock("")
            var condI = anytype
            if (op == "??=") { condI = truthy(b, callExt(b, "js_eq", [oldV, hNull])) }
            else if (op == "||=") { condI = b.NewICmp(llvm.enum.IPredEQ, callExt(b, core.truthyExt, [oldV]), handle(0)) }
            else { condI = truthy(b, oldV) }
            var fromB = b
            b.NewCondBr(condI, assignB, mergeB)
            var r = valT(assignB)
            var ab = r.b
            if (nameV != null) { refNameSet(ab, ref, "js_scope_set", r.v) }
            else { ab = refMemberSet(ab, ref, objV, keyV, r.v) }
            ab.NewBr(mergeB)
            var phi = mergeB.NewPhi([llvm.ir.NewIncoming(r.v, ab), llvm.ir.NewIncoming(oldV, fromB)])
            return {b: mergeB, v: phi}
        }
    }

    // items = [ref, "++"|"--"]. Post increment: the expression value is the old (coerced) one.
    // ++/-- are ToNumeric-then-step, not ToNumber-then-add: a BigInt stays a BigInt
    // and steps by 1n (js_jstonumeric / js_jsstep, abnf/jsrtjsbig.go), everything else
    // becomes a number and steps by 1.
    function makeIncDec(items) {
        var ref = items[0]
        var delta = (items[1] == "++") ? 1 : -1
        return function(b) {
            var oneV = callExt(b, "js_num_i", [handle(delta)])
            if (ref.path.length == 0) {
                var oldV = callExt(b, "js_jstonumeric", [refNameGet(b, ref)])
                refNameSet(b, ref, "js_scope_set", callExt(b, "js_jsstep", [oldV, oneV]))
                return {b: b, v: oldV}
            }
            var p = emitRefPath(b, ref)
            var og = emitOldGet(p.b, p.obj, p.key)
            b = og.b
            var oldM = callExt(b, "js_jstonumeric", [og.v])
            b = refMemberSet(b, ref, p.obj, p.key, callExt(b, "js_jsstep", [oldM, oneV]))
            return {b: b, v: oldM}
        }
    }
    // Prefix ++/--: like makeIncDec, but the expression value is the new one.
    function makePreIncDec(ref, op) {
        var delta = (op == "++") ? 1 : -1
        return function(b) {
            var oneV = callExt(b, "js_num_i", [handle(delta)])
            if (ref.path.length == 0) {
                var oldV = callExt(b, "js_jstonumeric", [refNameGet(b, ref)])
                var newV = callExt(b, "js_jsstep", [oldV, oneV])
                refNameSet(b, ref, "js_scope_set", newV)
                return {b: b, v: newV}
            }
            var p = emitRefPath(b, ref)
            var og = emitOldGet(p.b, p.obj, p.key)
            b = og.b
            var oldM = callExt(b, "js_jstonumeric", [og.v])
            var newM = callExt(b, "js_jsstep", [oldM, oneV])
            b = refMemberSet(b, ref, p.obj, p.key, newM)
            return {b: b, v: newM}
        }
    }

    // ----- Parameter binding -----
    // A parameter list entry is either a bare name string (the plain form) or a
    // descriptor: {pname, def} for a default and {pname, rest: true} for a rest
    // parameter. The parameters are bound in source order into the freshly opened
    // function scope, so a later default may refer to an earlier parameter
    // ('function f(a, b = a + 1)'), exactly as the spec's parameter environment does.
    // off is the index the parameters start at in the argument array (1 for an instance
    // method, whose args[0] is the receiver).
    function makeDefaultParam(items) { return {pname: items[0], def: items[1]} }
    function bindParams(b, params, argsV, off) {
        for (var i = 0; i < params.length; i++) {
            var p = params[i]
            if (typeof p == "string") {
                callExt(b, "js_scope_decl", [curScopeV, emitStr(b, p),
                                        callExt(b, "js_arg", [argsV, handle(i + off)])])
            } else if (p.ppat != undefined) {
                // A destructuring parameter: match the argument (or, for '...[a, b]', the
                // collected rest array) against the pattern.
                if (p.rest == true) {
                    b = emitArrRest(b, p.ppat, argsV, i + off, "js_scope_decl")
                } else {
                    b = bindPattern(b, p.ppat, callExt(b, "js_arg", [argsV, handle(i + off)]), "js_scope_decl")
                }
            } else if (p.rest == true) {
                b = emitRestBind(b, p.pname, argsV, i + off)
            } else {
                // A default fires for a MISSING argument and for an explicit undefined
                // ('f(undefined)' takes the default), which is exactly 'arg === undefined'.
                var av = callExt(b, "js_arg", [argsV, handle(i + off)])
                var defB = curF.NewBlock("")
                var mergeB = curF.NewBlock("")
                var fromB = b
                b.NewCondBr(truthy(b, callExt(b, "js_seq", [av, hUndef])), defB, mergeB)
                var r = p.def(defB)
                r.b.NewBr(mergeB)
                var phi = mergeB.NewPhi([llvm.ir.NewIncoming(r.v, r.b), llvm.ir.NewIncoming(av, fromB)])
                callExt(mergeB, "js_scope_decl", [curScopeV, emitStr(mergeB, p.pname), phi])
                b = mergeB
            }
        }
        return b
    }
    // '...rest': a fresh array filled with the arguments from index `start` on. The index
    // lives in a hidden 0-prefixed scope slot (no JS identifier can collide with it), the
    // same trick the for-of lowering uses.
    function emitRestBind(b, name, argsV, start) {
        var arrV = callExt(b, "js_arr_new", [])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, name), arrV])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "0rest"), callExt(b, "js_num_i", [handle(start)])])
        var headB = curF.NewBlock("")
        var bodyB = curF.NewBlock("")
        var exitB = curF.NewBlock("")
        b.NewBr(headB)
        var iV = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, "0rest")])
        var lenV = callExt(headB, memGetExt(), [argsV, emitStr(headB, "length")])
        headB.NewCondBr(truthy(headB, callExt(headB, "js_lt", [iV, lenV])), bodyB, exitB)
        var iB = callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, "0rest")])
        callExt(bodyB, "js_arr_push", [arrV, callExt(bodyB, memGetExt(), [argsV, iB])])
        callExt(bodyB, "js_scope_set", [curScopeV, emitStr(bodyB, "0rest"),
                                   callExt(bodyB, "js_add", [iB, callExt(bodyB, "js_num_i", [handle(1)])])])
        bodyB.NewBr(headB)
        return exitB
    }

    // A function body: an own IR function jsf_N(env, args) whose entry opens a scope on
    // the passed environment, binds the parameters and 'arguments', and runs the body.
    // isCtl marks a try/catch body closure: a return/break/continue leaving it emits a
    // control signal instead of a ret/br (see compile-core inCtlBody / excDispatch).
    // lexThis marks a body with a LEXICAL 'this' - an arrow function and the try/catch/
    // finally closures, which are an implementation device and not JS functions at all.
    // Those do not bind 'this' at all, so a reference to it resolves up the scope chain to
    // the enclosing function's binding, which is exactly what the spec prescribes for an
    // arrow. Every other function binds the DYNAMIC this of its call (js_this, fed by the
    // receiver that the call site handed to js_call).
    function emitFunction(paramNames, bodyT, isCtl, lexThis, ownStrict, isArrow) {
        var savedParams = emitParams
        if (!isCtl) { emitParams = paramNames }
        funcCount++
        var idx = funcCount
        if (!isCtl) {
            srcAt(idx, pendingSrc)
            pendingSrc = 0 - 1
        }
        var f = m.NewFunc("jsf_" + idx, i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])

        var savedF = curF
        var savedScope = curScopeV
        var savedLoops = loopStack
        var savedForOf = forOfIters
        var savedTag = curFTag
