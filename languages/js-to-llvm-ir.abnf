    // Every arithmetic and bitwise operator goes through the js_js* twin rather than
    // the shared external, because a BigInt operand needs arbitrary precision and the
    // spec's mixed-operand TypeError (abnf/jsrtjsbig.go). Each twin delegates to the
    // shared one the moment neither operand is a BigInt, which is every program that
    // writes no BigInt literal.
    binExt = {"+": "js_jsadd", "-": "js_jssub", "*": "js_jsmul", "/": "js_jsdiv", "%": "js_jsmod",
                  "==": "js_jseq", "!=": "js_jsne", "===": seqExt(), "!==": sneExt(),
                  "<": "js_jslt", ">": "js_jsgt", "<=": "js_jsle", ">=": "js_jsge",
                  "|": "js_jsbor", "^": "js_jsbxor", "&": "js_jsband",
                  "<<": "js_jsshl", ">>": "js_jsshr", ">>>": "js_jsushr",
                  "+=": "js_jsadd", "-=": "js_jssub", "*=": "js_jsmul", "/=": "js_jsdiv", "%=": "js_jsmod",
                  "&=": "js_jsband", "^=": "js_jsbxor", "|=": "js_jsbor",
                  "<<=": "js_jsshl", ">>=": "js_jsshr", ">>>=": "js_jsushr"}
