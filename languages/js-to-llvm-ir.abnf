            var yrNoB = curF.NewBlock("")
            yrpB.NewCondBr(truthy(yrpB, callExt(yrpB, "js_seq",
                               [callExt(yrpB, "js_typeof", [yrrfV]), emitStr(yrpB, "function")])),
