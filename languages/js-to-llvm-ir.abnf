            // that headB forwards it to the delegate (docs/todo.md 1.4).
            callExt(bodyB, "js_scope_set", [curScopeV, emitStr(bodyB, "0yout"), youtV])
            callExt(bodyB, "js_scope_set", [curScopeV, emitStr(bodyB, "0yopen"), hTrue])
