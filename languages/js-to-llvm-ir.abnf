    // then branches past, so the control flow is otherwise unchanged.
    function bindLabelBrk(name, brkB) {
        for (var i = labelStack.length - 1; i >= 0; i--) {
            if (labelStack[i].name == name) { labelStack[i].brk = brkB; labelStack[i].fon = forOfIters.length; return }
        }
    }
    function findLabel(name) {
        for (var i = labelStack.length - 1; i >= 0; i--) {
            if (labelStack[i].name == name) { return labelStack[i] }
        }
        println("js compiler error: undefined label '" + name + "'")
        exit(1)
    }
    function makeLabeledStmt(t, name) {
        return function(b) {
            var exitB = curF.NewBlock("")
            labelStack.push({name: name, brk: exitB, cont: null, fon: forOfIters.length, tag: curFTag, brkN: -1, contN: -1})
            var eb = t(b)
            labelStack.pop()
            eb.NewBr(exitB)
            return exitB
        }
    }
    // A labeled break or continue inside a try body - its own IR closure - cannot
    // branch to the label's block in the enclosing function. It travels as
    // compile-core's goto control signal instead (emitGoto), which excDispatch after
    // each enclosing js_try forwards outwards until the function that holds the block
    // branches to it. The block is registered once, under that function's tag.
    // excDispatch branches a goto signal (a labeled break or continue out of the try
    // body, see labelGotoN) straight to the label's block, which would leave this
    // function's for-of loops between the label and the try open. For the dispatch,
    // each such label's block is swapped for a pad that closes them first. A label in
    // an ENCLOSING function (this is itself a try body) is left by every for-of loop
    // here, so its pad closes all of them and forwards the signal outwards, which
    // excDispatch would otherwise do with the loops still open.
    function excDispatchLabels(b, ctl) {
        var swaps = []
        for (var i = 0; i < labelStack.length; i++) {
            var l = labelStack[i]
            if (l.tag == curFTag && forOfIters.length > l.fon) {
                labelPad(l.brkN, l.fon, swaps, null)
                labelPad(l.contN, l.fon, swaps, null)
            }
            if (l.tag != curFTag && forOfIters.length > 0 && inCtlBody()) {
                labelPad(l.brkN, 0, swaps, ctl)
                labelPad(l.contN, 0, swaps, ctl)
            }
        }
        var r = excDispatch(b, ctl)
        for (var j = 0; j < swaps.length; j++) {
            ctlLabels[swaps[j].n].blk = swaps[j].blk
            ctlLabels[swaps[j].n].tag = swaps[j].tag
        }
        return r
    }
    // fwd is the signal to return when the label lies outside this function, else null.
    function labelPad(n, fon, swaps, fwd) {
        if (n < 0) { return }
        var pad = curF.NewBlock("")
        emitIterUnwind(pad, fon)
        if (fwd == null) { pad.NewBr(ctlLabels[n].blk) } else { pad.NewRet(fwd) }
        swaps.push({n: n, blk: ctlLabels[n].blk, tag: ctlLabels[n].tag})
        ctlLabels[n].blk = pad
        ctlLabels[n].tag = curFTag
    }
    function labelGotoN(tag, blk) {
        ctlLabels.push({tag: tag, blk: blk})
        return ctlLabels.length - 1
    }
    function makeLabeledLoop(t, name) {
        var inner = makeLabeledStmt(t, name)
        return function(b) {
            pendingLabel = name
            return inner(b)
        }
    }
    // items = [] (a plain break/continue) or [labelName].
    function makeBreakStmt(items) {
        if (items.length == 0) return makeBreak()
        var name = items[0]
        return function(b) {
            var l = findLabel(name)
            // A break to an OUTER statement abandons iterators: all of this function's
            // when the label lies in an enclosing one.
            emitIterUnwind(b, (l.tag == curFTag) ? l.fon : 0)
            if (l.tag == curFTag) { b.NewBr(l.brk) }
            else {
                if (l.brkN < 0) { l.brkN = labelGotoN(l.tag, l.brk) }
                emitGoto(b, l.brkN)
            }
            return deadBlock()
        }
    }
    function makeContinueStmt(items) {
        if (items.length == 0) return makeContinue()
        var name = items[0]
        return function(b) {
            var l = findLabel(name)
            if (l.cont == null) {
                println("js compiler error: 'continue " + name + "' does not label a loop")
                exit(1)
            }
            emitIterUnwind(b, (l.tag == curFTag) ? l.fon : 0) // A continue to an OUTER loop, too.
            if (l.tag == curFTag) { b.NewBr(l.cont) }
            else {
                if (l.contN < 0) { l.contN = labelGotoN(l.tag, l.cont) }
                emitGoto(b, l.contN)
            }
            return deadBlock()
        }
    }

    // ----- Statement thunks: function(block) -> block to continue in -----

    // The shared makeWhile with the label hook (see labelStack above); otherwise
    // byte-identical to lib/compile-core.js.
    makeWhile = function(bodyT, condT) {
        return function(b) {
            var lbl = takeLabel()
            var headB = curF.NewBlock("")
            var bodyB = curF.NewBlock("")
            var exitB = curF.NewBlock("")
            b.NewBr(headB)
            var r = condT(headB)
            r.b.NewCondBr(truthy(r.b, r.v), bodyB, exitB)
            loopStack.push({cont: headB, brk: exitB})
            if (lbl != "") { bindLabelCont(lbl, headB) }
            bodyT(bodyB).NewBr(headB)
            loopStack.pop()
            return exitB
        }
    }

    // An expression in statement position: evaluate the value and record it as the
    // program completion value (what a goja Run() would return; js_getret reads it).
    exprToStmt = function(t) {
        return function(b) {
            var r = t(b)
            callExt(r.b, "js_setret", [r.v])
            return r.b
        }
    }
    // For loop init/post clauses: evaluate and drop (they are no statements, so
    // they must not touch the completion value).
    function exprToClause(t) {
        return function(b) { return t(b).b }
    }
    // items = [name] or [name, initThunk]. A var assigns the binding its function body
    // hoisted, and without an initializer emits nothing at all. The write is js_scope_set:
    // the hoisted name always exists, and an extern that binds nothing lets the
    // enclosing block go without a scope of its own (compile-core's declCount).
    function makeDecl(items, txt, pos) {
        var name = items[0]
        // NamedEvaluation: `const h = x => x` names the arrow "h".
        if (items.length > 1) { fnAnonName(name, "=", txt) }
        if (declIsVar()) {
            varRecs.push({name: name, at: pos, file: c.curFile()})
            return function(b) {
                if (items.length == 1) { return b }
                var vr = items[1](b)
                callExt(vr.b, "js_scope_set", [curScopeV, emitStr(vr.b, name), vr.v])
                emitArgSync(vr.b, name, vr.v)
                return vr.b
            }
        }
        var cst = declIsConst()
        hoistNoteLex(name, pos, cst)
        if (cst) { constNote([name]) }
        return function(b) {
            var v = hUndef
            if (items.length > 1) {
                var r = items[1](b)
                b = r.b
                v = r.v
            }
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, name), v])
            if (cst) { constMark(b, curScopeV, [name]) }
            return b
        }
    }
    // Note: the childs lie on the stack in source order, so pop() delivers them reversed.
    function makeDo(condT, bodyT) {
        return function(b) {
            var lbl = takeLabel()
            var bodyB = curF.NewBlock("")
            var condB = curF.NewBlock("")
            var exitB = curF.NewBlock("")
            b.NewBr(bodyB)
            loopStack.push({cont: condB, brk: exitB})
            if (lbl != "") { bindLabelCont(lbl, condB) }
            bodyT(bodyB).NewBr(condB)
            loopStack.pop()
            var r = condT(condB)
            r.b.NewCondBr(truthy(r.b, r.v), bodyB, exitB)
            return exitB
        }
    }
    // items = [{k:"init"|"cond"|"post", t:thunk}..., bodyThunk]; lexNames are the
    // let/const names the head declares. Each iteration runs in a COPY of the head
    // scope (CreatePerIterationEnvironment, ECMA-262 14.7.4.4), made after the
    // initializer (in initB) and before each increment (in postB), so a closure keeps
    // the binding of the iteration that made it. Only a closure can tell the copy from
    // the original, so the copies are made only when the loop emitted a function:
    // the scope the head and the increment run against is a phi whose incoming
    // values are written once the loop is emitted, the way makeBlockStmt decides
    // its own scope in lib/compile-core.js. Twin: makeFor in js-interpreter.abnf.
    function makeFor(items, lexNames, constNames, tdz) {
        var bodyT = items.pop()
        var init = null, cond = null, post = null
        for (var i = 0; i < items.length; i++) {
            if (items[i].k == "init") init = items[i].t
            if (items[i].k == "cond") cond = items[i].t
            if (items[i].k == "post") post = items[i].t
        }
        return function(b) {
            var lbl = takeLabel()
            var saved = curScopeV
            var fnBefore = funcCount
            curScopeV = callExt(b, "js_scope_new", [curScopeV]) // The for header is its own scope.
            var headS = curScopeV
            b = tdzDecl(b, tdz)
            if (init != null) b = init(b)
            var initB = curF.NewBlock("")
            b.NewBr(initB)
            var headB = curF.NewBlock("")
            var bodyB = curF.NewBlock("")
            var postB = curF.NewBlock("")
            var runB = curF.NewBlock("")
            var exitB = curF.NewBlock("")
            var headPh = headB.NewPhi([llvm.ir.NewIncoming(headS, initB)])
            curScopeV = headPh
            if (cond != null) {
                var r = cond(headB)
                r.b.NewCondBr(truthy(r.b, r.v), bodyB, exitB)
            } else {
                headB.NewBr(bodyB)
            }
            loopStack.push({cont: postB, brk: exitB})
            if (lbl != "") { bindLabelCont(lbl, postB) }
            bodyT(bodyB).NewBr(postB)
            loopStack.pop()
            var runPh = runB.NewPhi([llvm.ir.NewIncoming(headPh, postB)])
            curScopeV = runPh
            var pb = runB
            if (post != null) pb = post(runB)
            pb.NewBr(headB)
            var firstS = headS
            if (lexNames.length > 0 && funcCount != fnBefore) {
                firstS = forIterScope(initB, saved, headS, lexNames, constNames)
                runPh.Incs = [llvm.ir.NewIncoming(forIterScope(postB, saved, headPh, lexNames, constNames), postB)]
            }
            headPh.Incs = [llvm.ir.NewIncoming(firstS, initB), llvm.ir.NewIncoming(runPh, pb)]
            initB.NewBr(headB)
            postB.NewBr(runB)
            curScopeV = saved
            return exitB
        }
    }
    // A new scope under parent holding the current values of names in old.
    function forIterScope(b, parent, old, names, constNames) {
        var ns = callExt(b, "js_scope_new", [parent])
        for (var i = 0; i < names.length; i++) {
            callExt(b, "js_scope_decl", [ns, emitStr(b, names[i]), callExt(b, "js_scope_get", [old, emitStr(b, names[i])])])
        }
        constMark(b, ns, constNames)
        return ns
    }
    // items = [] or [exprThunk].
    function makeReturn(items) {
        var t = items.length > 0 ? items[0] : null
        return function(b) {
            var v = hUndef
            if (t != null) {
                var r = t(b)
                b = r.b
                v = r.v
            }
            // A derived constructor answers `this` unless it returns an object.
            if (curF === derivedCtorF) {
                v = callExt(b, "js_jsnewres", [v, callExt(b, "js_scope_get", [curScopeV, emitStr(b, "this")])])
            }
            emitIterUnwind(b, 0) // A return out of a for-of body closes its iterator.
            return retStmt(b, v) // plain ret, or a control signal when leaving a try body
        }
    }
    function makeThrow(t) {
        return function(b) {
            var r = t(b)
            callExt(r.b, "js_throw", [r.v])
            r.b.NewRet(hUndef) // Never reached: js_throw aborts on the host side.
            return deadBlock()
        }
    }
    // items = [subjThunk, ({casev}|{isdflt}|stmtThunk)...]. The flat label/statement
    // list is grouped at build time. The dispatch chain compares with js_seq (===);
    // the case bodies fall through into each other, break jumps to the exit, and
    // continue still targets the enclosing loop.
    function makeSwitch(items) {
        var subj = items[0]
        var cases = []
        var cur = null
        for (var i = 1; i < items.length; i++) {
            var p = items[i]
            if (p != undefined && (p.casev != undefined || p.isdflt != undefined)) {
                cur = {isDefault: p.isdflt != undefined, v: p.casev, body: []}
                cases.push(cur)
            } else {
                if (cur == null) {
                    println("js compiler error: switch: a statement before the first case label")
                    exit(1)
                }
                cur.body.push(p)
            }
        }
        return function(b) {
            var r = subj(b)
            b = r.b
            var exitB = curF.NewBlock("")
            var bodyBs = []
            var dfltB = exitB
            for (var i = 0; i < cases.length; i++) {
                bodyBs.push(curF.NewBlock(""))
                if (cases[i].isDefault && dfltB === exitB) { dfltB = bodyBs[i] }
            }
            for (var i = 0; i < cases.length; i++) {
                if (cases[i].isDefault) { continue }
                var rc = cases[i].v(b)
                b = rc.b
                var nextB = curF.NewBlock("")
                b.NewCondBr(truthy(b, callExt(b, seqExt(), [r.v, rc.v])), bodyBs[i], nextB)
                b = nextB
            }
            b.NewBr(dfltB)
            var outerCont = loopStack.length > 0 ? loopStack[loopStack.length - 1].cont : null
            loopStack.push({cont: outerCont, brk: exitB})
            for (var i = 0; i < cases.length; i++) {
                var bb = bodyBs[i]
                var body = cases[i].body
                for (var j = 0; j < body.length; j++) { bb = body[j](bb) }
                bb.NewBr(i + 1 < cases.length ? bodyBs[i + 1] : exitB)
            }
            loopStack.pop()
            return exitB
        }
    }
    // Local stack = [name, [paramNames...], bodyThunk] -- the enclosing scope
    // instantiates the closure on entry.
    function makeFuncDecl(bodyT, paramNames, name, ownStrict, pos) {
        var fnT = fnDef(function(b) {
            var idx = emitFunction(paramNames, bodyT, false, false, ownStrict)
            return {b: b, v: callExt(b, "js_closure", [handle(idx), curScopeV])}
        }, name, paramNames)
        return fnDeclAt(name, fnT, pos, true)
    }

    // The top level statements become jsrun(scope, args): the caller provides the scope
    // that the top level declarations land in (the frozen tag executor passes the shared
    // scope of the compile run, so scripts see each others globals). The return value is
    // the completion value: what the last executed expression statement produced.
    // jsmain(env, args) is the standalone entry on top of it: it makes a fresh scope,
    // runs the program, and then calls main() - the self checking test convention.
    // ----- the Error hierarchy ---------------------------------------------
    //
    // The model is python-to-llvm-ir.abnf's builtin-exception block, and it is
    // deliberately ORDINARY class machinery rather than a special case: each
    // class is the same {__isclass, __name, __super, __ctor} descriptor
    // emitClass builds, so js_jsinstanceof's chain walk already answers
    // `e instanceof Error` for a TypeError, makeNewFrom's class arm already
    // constructs one, and `class E extends Error {}` already works.
    //
    // ONE constructor serves all five: the name is not baked into the closure
    // but recovered inside js_jserrinit by walking the instance's own __class
    // chain for __errname, which is what makes a user subclass answer its
    // NEAREST BUILTIN ANCESTOR's name - node's `class E extends TypeError {}`
    // answers "TypeError" and `class E extends Error {}` answers "Error",
    // exactly because name lives on the prototype and E.prototype does not
    // shadow it. That also keeps the emitted cost at two function bodies and
    // five small objects rather than one body per class.
    //
    // js_jserrcls also REGISTERS each class with the runtime, so the errors the
    // RUNTIME itself raises (the BigInt family) carry the very same class
    // object - two class objects of one name would make instanceof false.
    // Twins: abnf/jsrtjsprint.go and languages/lib/js-rt.metajs.
    // Only the five the exception hierarchy needs: EvalError and URIError were left
    // out on purpose, because every boot class adds to the live set the collector
    // marks at each collection and seven classes measurably slowed a GC-heavy bench.
    var jsErrClassNames = ["Error", "TypeError", "RangeError", "ReferenceError",
                           "SyntaxError"]
    function emitErrorClasses(b) {
        // The shared constructor: js_jserrinit(this, args[1]).
        funcCount++
        var ciIdx = funcCount
        var cf = m.NewFunc("jsf_" + ciIdx, i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var cb = cf.NewBlock("entry")
        cb.NewCall(getExtern("js_jserrinit", 2),
                   [cb.NewCall(getExtern("js_arg", 2), [cf.Params[1], handle(0)]),
                    cb.NewCall(getExtern("js_arg", 2), [cf.Params[1], handle(1)])])
        cb.NewRet(hUndef)
        // Error.prototype.toString. A class method is dispatched with the
        // receiver PREPENDED, so args[0] is the error.
        funcCount++
        var tsIdx = funcCount
        var tf = m.NewFunc("jsf_" + tsIdx, i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var tb = tf.NewBlock("entry")
        tb.NewRet(tb.NewCall(getExtern("js_jserrstr", 1),
                             [tb.NewCall(getExtern("js_arg", 2), [tf.Params[1], handle(0)])]))
        // Every builtin Error constructor has length 1.
        var ctorV = callExt(b, "js_jsfnmeta", [callExt(b, "js_closure", [handle(ciIdx), curScopeV]), emitStr(b, ""), emitNum(b, 1)])
        var tsV = callExt(b, "js_closure", [handle(tsIdx), curScopeV])
        // The descriptors are built by js_jserrcls rather than by six memSets
        // each, because the memSet form put a large fixed amount of IR into every
        // js module. js_scope_decl is the one step that cannot move into the
        // extern: it is a FLOOR primitive and a layer-2 file cannot call it, so
        // the binding stays here, in the PROGRAM's own scope like RegExp and
        // Object above, where no other language's compiler can see the name.
        for (var ei = 0; ei < jsErrClassNames.length; ei++) {
            callExt(b, "js_scope_decl",
                    [curScopeV, emitStr(b, jsErrClassNames[ei]),
                     callExt(b, "js_jserrcls", [emitStr(b, jsErrClassNames[ei]), ctorV, tsV])])
        }
        return b
    }

    // ----- the three recoverable-error hooks ------------------------------------
    //
    // `zzz` with no binding, `null.x` and `null.x = 1` throw a ReferenceError and a
    // TypeError in node that a plain try/catch recovers. All three sites - scope_get,
    // get_member and set_member - are shared by all sixteen languages, and turning the
    // abort into a throw for everyone is wrong: a statically typed language means
    // "this program is broken" by it, and the three SHOULD-ABORT matrix rows are how
    // the floor's abort path is reached by a test at all. So the floor and
    // abnf/jsrt.go take a per-language HOOK (js_rt_missvar / js_rt_missmem), the
    // language registers one here, and a language that registers nothing is
    // bit-for-bit unchanged.
    //
    // The hook ANSWERS the value to throw rather than throwing it: the runtime
    // clears the slot while the hook runs, so a hook that itself trips the same
    // site falls back to the original abort instead of recursing, and the
    // clear/restore has to bracket a call that RETURNS. It costs nothing on the
    // hot path - the test is on the miss path, after the whole chain walk has
    // already failed.
    //
    // The message texts are node's, verified against node v24:
    //   ReferenceError: zzz is not defined
    //   TypeError: Cannot read properties of null (reading 'x')
    //   TypeError: Cannot set properties of null (setting 'x')
    // js_jserrmk turns either text into the very class object emitErrorClasses
    // registered above, so `e instanceof ReferenceError` and e.message answer.
    function emitMissHooks(b) {
        funcCount++
        var vIdx = funcCount
        var vf = m.NewFunc("jsf_" + vIdx, i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var vb = vf.NewBlock("entry")
        var nmV = vb.NewCall(getExtern("js_arg", 2), [vf.Params[1], handle(0)])
        var vTxt = callExt(vb, "js_add", [callExt(vb, "js_add", [emitStr(vb, "ReferenceError: "), nmV]),
                                          emitStr(vb, " is not defined")])
        vb.NewRet(callExt(vb, "js_jserrmk", [vTxt]))

        funcCount++
        var mIdx = funcCount
        var mf = m.NewFunc("jsf_" + mIdx, i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var mb = mf.NewBlock("entry")
        var keyV = mb.NewCall(getExtern("js_arg", 2), [mf.Params[1], handle(0)])
        var objV = mb.NewCall(getExtern("js_arg", 2), [mf.Params[1], handle(1)])
        var mTxt = callExt(mb, "js_add",
                           [callExt(mb, "js_add",
                                    [callExt(mb, "js_add",
                                             [callExt(mb, "js_add",
                                                      [emitStr(mb, "TypeError: Cannot read properties of "),
                                                       callExt(mb, "js_jsstr", [objV])]),
                                              emitStr(mb, " (reading '")]),
                                     callExt(mb, "js_jsstr", [keyV])]),
                            emitStr(mb, "')")])
        mb.NewRet(callExt(mb, "js_jserrmk", [mTxt]))

        // The WRITE sibling: node spells `null.x = 1` as
        // "Cannot set properties of null (setting 'x')".
        funcCount++
        var sIdx = funcCount
        var sf = m.NewFunc("jsf_" + sIdx, i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var sb = sf.NewBlock("entry")
        var sKeyV = sb.NewCall(getExtern("js_arg", 2), [sf.Params[1], handle(0)])
        var sObjV = sb.NewCall(getExtern("js_arg", 2), [sf.Params[1], handle(1)])
        var sTxt = callExt(sb, "js_add",
                           [callExt(sb, "js_add",
                                    [callExt(sb, "js_add",
                                             [callExt(sb, "js_add",
                                                      [emitStr(sb, "TypeError: Cannot set properties of "),
                                                       callExt(sb, "js_jsstr", [sObjV])]),
                                              emitStr(sb, " (setting '")]),
                                     callExt(sb, "js_jsstr", [sKeyV])]),
                            emitStr(sb, "')")])
        sb.NewRet(callExt(sb, "js_jserrmk", [sTxt]))

        callExt(b, "js_rt_missvar", [callExt(b, "js_closure", [handle(vIdx), curScopeV])])
        callExt(b, "js_rt_missmem", [callExt(b, "js_closure", [handle(mIdx), curScopeV])])
        callExt(b, "js_rt_missset", [callExt(b, "js_closure", [handle(sIdx), curScopeV])])

        // A generator resumed while its own body runs (it stepped itself) raises
        // node's catchable "TypeError: Generator is already running" through the
        // floor's RT_GEN_BUSY and the twin's genBusy hook, instead of aborting.
        funcCount++
        var gIdx = funcCount
        var gf = m.NewFunc("jsf_" + gIdx, i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var gb = gf.NewBlock("entry")
        gb.NewRet(callExt(gb, "js_jserrmk", [emitStr(gb, "TypeError: Generator is already running")]))
        callExt(b, "js_rt_genbusy", [callExt(b, "js_closure", [handle(gIdx), curScopeV])])
        // A call nested past the limit raises node's RangeError through the
        // floor's and the twin's js_rt_deep hook (the interpreter's coreDeepHook).
        funcCount++
        var rdIdx = funcCount
        var rdf = m.NewFunc("jsf_" + rdIdx, i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var rdb = rdf.NewBlock("entry")
        rdb.NewRet(callExt(rdb, "js_jserrmk", [emitStr(rdb, "RangeError: Maximum call stack size exceeded")]))
        callExt(b, "js_rt_deep", [emitNum(b, 10000), callExt(b, "js_closure", [handle(rdIdx), curScopeV]), emitNum(b, 0)])

        // The fourth of the family, and the one the call site needs: js_rt_misscall
        // hands both engines the MISS SENTINEL, after which a method call nothing
        // claimed ANSWERS it instead of aborting, and the call site raises node's
        // TypeError. A language that never calls this extern keeps the abort, which
        // is what leaves the other fifteen bit-for-bit unchanged. It is pinned
        // because a module global is invisible to the collector.
        var missV = callExt(b, "js_gc_pin", [callExt(b, "js_obj_new", [])])
        b.NewStore(missV, mcallMissGlob())
        callExt(b, "js_rt_misscall", [missV])
        return b
    }

    function buildMain(itemsIn) {
        if (importDepth == 0) { jsbLoad() }
        // The file's own directive prologue decides the strictness every top-level
        // function inherits. The mark is stripped before the statements are emitted.
        // An IMPORTED file's own file-level directive is dropped rather than carried:
        // its statements are stashed here and emitted later, inside the importing
        // file's buildMain, which sets the flag last. Every FUNCTION in it still
        // carries its own UseStrictMark, so only a bare file-level "use strict" in an
        // imported file is affected.
        var items = []
        for (var bi = 0; bi < itemsIn.length; bi++) {
            if (itemsIn[bi] != undefined && itemsIn[bi].ustrict == true) { fileStrict = true; continue }
            items.push(itemsIn[bi])
        }
        emitStrict = fileStrict
        // Every var and function no function body claimed is the program's own, hoisted
        // in front of its statements.
        var topFns = hoistClaimFns(0, 2147483647)
        var topTdz = hoistLexKill(0, 2147483647, topFns).tdz
        var topVars = claimVars(0, 2147483647)
        var topAnnex = hoistClaimAnnex(0, 2147483647)
        if (topVars.length > 0 || topAnnex.length > 0 || topFns.length > 0 || topTdz.length > 0) {
            var hoisted = [function(hb) {
                hb = tdzDecl(emitHoist(hb, curScopeV, curScopeV, topVars), topTdz)
                if (topAnnex.length > 0) { hb = emitAnnexHoist(hb, topAnnex, topVars, []) }
                return emitFnInit(hb, topFns, curScopeV)
            }]
            for (var hi = 0; hi < items.length; hi++) { hoisted.push(items[hi]) }
            items = hoisted
        }
        // The walk of an imported file ends here too (importDepth > 0): stash its
        // top-level statement thunks for the real jsrun instead of emitting a second one.
        if (importDepth > 0) {
            stashImported(items) // stashed with its file; emitted later (compile-core)
            return
        }
        var f = m.NewFunc("jsrun", i64, [llvm.ir.NewParam("scope", i64), llvm.ir.NewParam("args", i64)])
        curF = f
        var b = f.NewBlock("entry")
        curScopeV = f.Params[0]
        callExt(b, "js_setret", [hUndef]) // A program without expression statements completes with undefined.
        // The functions' source text (js_jssrc), filled in by emitSrcTable once every
        // function of the program has been emitted.
        var srcInit = m.NewFunc("jsfnsrc.init", i64, [])
        b.NewCall(srcInit, [])
        // THE GLOBAL OBJECT, and with it the top level 'this'. This grammar implements
        // the SCRIPT goal symbol (see the :description), whose top level 'this' IS the
        // global object: node's `vm.runInThisContext` answers `object` for
        // `typeof this` and true for `this === globalThis`.
        //
        // It is a PLAIN object, not a live view of the scope chain: `globalThis.x = 1`
        // does not create a global variable. Both names are the SAME handle, which is
        // what makes `this === globalThis` true.
        var globalObjV = callExt(b, "js_obj_new", [])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "this"), globalObjV])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "globalThis"), globalObjV])
        // The RegExp global, so a bare RegExp(src, flags) call (and 'typeof RegExp') work
        // the way 'new RegExp' does. It is declared in the PROGRAM's own scope, not in the
        // runtime's root, so no other language's compiler can see the name.
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "RegExp"), callExt(b, "js_jsxctor", [])])
        // The Object global. The runtime root binds a bare object carrying only
        // 'prototype'; js_jsobject answers a MARKED object that js_jsmcall recognizes
        // (abnf/jsrtjsprint.go) for Object.keys / values / entries / assign /
        // fromEntries, declared in the program's own scope like RegExp above so no
        // other language's compiler sees it.
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "Object"), callExt(b, "js_jsobject", [])])
        // println / print with JAVASCRIPT's ToString (the runtime root binds the SHARED
        // host functions, which print Go's %v). Declaring them as program-scope
        // bindings (rather than rewriting the call site) keeps shadowing honest: a
        // program with a println of its own overwrites this.
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "println"), callExt(b, "js_jsprintfn", [emitStr(b, "println")])])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "print"), callExt(b, "js_jsprintfn", [emitStr(b, "print")])])
        // The String global. The runtime root binds an OBJECT carrying fromCharCode;
        // this is a real function, and String.fromCharCode still resolves through
        // js_jsmcall.
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "String"), callExt(b, "js_jsstringfn", [])])
        // The Array global: a real function (Array(n), new Array(n)); Array.isArray
        // resolves through js_jsmcall, and lib/js-builtins.js adds Array.from / of.
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "Array"), callExt(b, "js_jsarrayfn", [])])
        // BigInt(v) is ToBigInt and Number(v) is ToNumber; the latter is the only way
        // back out of a BigInt, since unary '+' refuses it.
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "BigInt"), callExt(b, "js_jsbigintfn", [])])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "Number"), callExt(b, "js_jsnumberfn", [])])
        // Boolean(v) is ToBoolean and `new Boolean(v)` a wrapper; Function is there for
        // instanceof and Function.prototype.
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "Boolean"), callExt(b, "js_jsbooleanfn", [])])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "Function"), callExt(b, "js_jsfunctionfn", [])])
        // parseFloat and parseInt are JavaScript's (lib/js-num.js), not the runtime root's.
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "parseFloat"), callExt(b, "js_jsparsefloatfn", [])])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "parseInt"), callExt(b, "js_jsparseintfn", [])])
        // The Math global: the shared one with an ECMAScript pow (js_jsmath).
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "Math"),
                callExt(b, "js_jsmath", [callExt(b, "js_scope_get", [curScopeV, emitStr(b, "Math")])])])
        // The JSON global (js_jsjson; lib/json.js in layer 2).
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "JSON"), callExt(b, "js_jsjson", [])])
        // The Promise global: a function value, so `new Promise(exec)` constructs one and
        // `typeof Promise` is "function"; Promise.resolve / reject / all / allSettled /
        // race / any resolve through js_jsmcall, like String.fromCharCode above.
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "Promise"), callExt(b, "js_jspromfn", [])])
        // The Symbol global: Symbol(desc), Symbol.iterator, Symbol.for (js_jssymbolfn).
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "Symbol"), callExt(b, "js_jssymbolfn", [])])
        b = emitErrorClasses(b)
        b = emitMissHooks(b)   // after the classes: the hooks raise instances of them.
        if (normWant) { callExt(b, "js_jsnormdata", [emitStr(b, load("lib/unicode-norm.txt"))]) }
        if (hoistTdzCount > 0) { b.NewStore(callExt(b, "js_gc_pin", [callExt(b, "js_obj_new", [])]), tdzGlob()) }
        b = emitImported(b)
        b = makeSeq(items)(b)
        b.NewRet(callExt(b, "js_getret", []))

        var fm = m.NewFunc("jsmain", i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        curF = fm
        var bm = fm.NewBlock("entry")
        var sc = callExt(bm, "js_scope_new", [fm.Params[0]])
        bm.NewCall(f, [sc, fm.Params[1]])
        // The entry defaults to main(); -main (c.mainName) can name another function or,
        // with a '(', a JS snippet parsed and emitted into jsmain (see emitMainSnippet).
        var entry = c.mainName
        if (entry == undefined || entry == "") { entry = "main" }
        if (mainIsSnippet(entry)) {
            curScopeV = sc // The snippet resolves names in the populated program scope.
            bm = emitMainSnippet(bm, entry, "Statement")
            callExt(bm, "js_jsdrain", [])
            bm.NewRet(emitNum(bm, 0))
        } else {
            var mainV = callExt(bm, "js_scope_get", [sc, emitStr(bm, entry)])
            var argsV = callExt(bm, "js_arr_new", [])
            var mainR = jsCall(bm, mainV, hUndef, argsV)
            // The microtask queue is drained ONCE, after the whole script has run: this
            // runtime has no timers and no I/O, so that is the only event-loop turn a
            // program will ever get, and it is where every .then reaction and every
            // resumption of an async body happens. Draining it before the program's
            // value is returned matches node, which runs the script and then the jobs.
            callExt(bm, "js_jsdrain", [])
            bm.NewRet(mainR)
        }
        emitSrcTable(srcInit)
    }

    // ===== goja driver =====
    // Everything below this marker is the driver for the normal (goja) run of this
    // grammar. The freezer (-freeze) cuts the start script here: only the library above
    // goes into the bootstrap snapshot; in frozen mode the Go core replaces the driver.

    // Build the module out of the parsed program.
    c.compile(c.asg)

    // ----- the native build -----
    // jsdispatch(idx, env, args) is the function table a LINKED binary needs: js_closure
    // stores a raw function index, and under llvm.Run the Go runtime turns that index
    // back into a callee by looking "jsf_<idx>" up in the module. A binary has no such
    // reflection, so the module carries the mapping itself. The MISS arm calls
    // jsdispatch_ext, the same table emitted by the layer-2 runtime library
    // (lib/js-rt.ll, built by metajs-to-llvm-ir.abnf -rt-lib): its own function indices
    // are offset by a million, so the two chains cannot overlap and one js_call reaches
    // either module. Emitted ONLY for -exe, so every other run keeps the module it had.
    // This is lua-to-llvm-ir.abnf's emitDispatch, unchanged.
    function emitDispatch() {
        var idxs = []
        var fns = []
        var i = 0
        while (i < m.Funcs.length) {
            var f = m.Funcs[i]
            var nm = f.Name()
            if (nm.length > 4 && nm.substring(0, 4) == "jsf_") {
                idxs.push(parseInt(nm.substring(4, nm.length)))
                fns.push(f)
            }
            i = i + 1
        }
        var ext = m.NewFunc("jsdispatch_ext", i64,
            [llvm.ir.NewParam("idx", i64), llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var d = m.NewFunc("jsdispatch", i64,
            [llvm.ir.NewParam("idx", i64), llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var b = d.NewBlock("entry")
        var extB = d.NewBlock("ext")
        var ownB = d.NewBlock("own")
        b.NewCondBr(b.NewICmp(llvm.enum.IPredSGE, d.Params[0], llvm.constant.NewInt(i64, 1000000)), extB, ownB)
        extB.NewRet(extB.NewCall(ext, [d.Params[0], d.Params[1], d.Params[2]]))
        b = ownB
        i = 0
        while (i < fns.length) {
            var hit = d.NewBlock("hit" + idxs[i])
            var nxt = d.NewBlock("miss" + idxs[i])
            b.NewCondBr(b.NewICmp(llvm.enum.IPredEQ, d.Params[0], llvm.constant.NewInt(i64, idxs[i])), hit, nxt)
            hit.NewRet(hit.NewCall(fns[i], [d.Params[1], d.Params[2]]))
            b = nxt
            i = i + 1
        }
        b.NewRet(b.NewCall(ext, [d.Params[0], d.Params[1], d.Params[2]]))
    }

    // The two runtime inputs live next to THIS grammar, so the build does not depend on
    // the working directory: lib/runtime.ll is the C floor and lib/js-rt.ll is layer 2 -
    // JavaScript's own semantics, shared VERBATIM with typescript-to-llvm-ir.abnf. An
    // explicit -rt REPLACES both. This grammar's entry point is ALREADY named jsmain,
    // which is what the C floor's main() calls, so no one-call alias has to be emitted.
    function libPath(name) {
        var mn = moduleName()
        var cut = -1
        var i = 0
        while (i < mn.length) {
            var ch = mn.charAt(i)
            if (ch == "/" || ch == "\\") { cut = i }
            i = i + 1
        }
        return mn.substring(0, cut + 1) + "lib/" + name
    }

    if (c.exePath != undefined && c.exePath != "") {
        emitDispatch()
        var rts = c.runtime
        if (rts == undefined || rts.length == 0) { rts = [libPath("runtime.ll"), libPath("js-rt.ll")] }
        var buildErr = llvm.BuildExecutable(m, c.exePath, rts)
        if (buildErr != "") {
            println(buildErr)
            exit(1)
        }
        println("js compiler: wrote executable " + c.exePath)
        exit(0)
    }

    // Show the compiler output (the LLVM IR module).
    println(m)

    // Run jsmain() with the built-in IR interpreter and the MetaJS handle runtime.
    // The exit code of this metacompiler run is what main() returned, so test
    // programs are self checking.
    var res = llvm.RunJS(m, "jsmain")
    var entryName = c.mainName
    if (entryName == undefined || entryName == "") { entryName = "main" }
    if (mainIsSnippet(entryName)) {
        println("js compiler: -main snippet returned " + res.Ret)
    } else {
        println("js compiler: " + entryName + "() returned " + res.Ret)
    }
    exit(res.Ret)

~~) ;
