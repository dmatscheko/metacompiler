                              yrDoneB, joinB)
            callExt(yrDoneB, memSetExt(), [yrmV, emitStr(yrDoneB, "v"), callExt(yrDoneB, memGetExt(), [yrrV, emitStr(yrDoneB, "value")])])
            callExt(yrDoneB, "js_throw", [yrmV])
            yrDoneB.NewRet(hUndef) // Never reached: js_throw does not return.
            var ytfV = callExt(ythrB, "js_jsvget", [seqV, emitStr(ythrB, "throw")])
            ythrB.NewCondBr(truthy(ythrB, callExt(ythrB, "js_seq",
                                [callExt(ythrB, "js_typeof", [ytfV]), emitStr(ythrB, "function")])),
                            ythrCallB, ythrNoB)
