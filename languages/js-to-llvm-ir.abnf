    // makeAsyncFn arms pendingAsyncFn immediately before its emitFunction call and
    // emitFunction consumes it, saving and clearing inAsyncFn for every nested function -
    // so an ordinary function or an arrow inside an async body does not inherit it.
    var inAsyncFn = false
    var pendingAsyncFn = false
    // The same pair for an async GENERATOR body, which is a THIRD mode and not the
    // conjunction of the other two: inside one, `yield e` is a plain js_yield and
    // `await e` is a js_yield of a MARKED operand, and js_jsasyncgen's driver tells
    // the two apart by that marker. That is the whole of "one suspension channel" -
    // the generator model needed nothing added to it.
    var inAsyncGen = false
    var pendingAsyncGen = false
    // ----- Strict mode, per FUNCTION -----
    // Strictness is lexical, and emission IS lexical: emitFunction saves emitStrict,
    // ORs in the function's own "use strict" directive (the UseStrictMark guard's
    // answer, handed in as ownStrict) and restores it afterwards, so a nested function
    // inherits exactly what the spec says it inherits. Only `this` makes it visible.
    var emitStrict = false
    var fileStrict = false // The Script's own directive prologue; set by buildMain.
    // The UseStrictMark of a function production, and the same item list without it. The
    // mark is optional and sits directly in front of the body thunk, which the builders
    // below index either from the front or from the END - so it has to come out before
    // any of that indexing happens.
    function itemsStrict(items) {
        for (var i = 0; i < items.length; i++) {
            if (items[i] != undefined && items[i].ustrict == true) { return true }
        }
        return false
    }
