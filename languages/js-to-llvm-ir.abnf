            // scope: this block dominates the loop, so hoisting them out of it saves two
            // js_closure allocations per delegated element.
            var yYieldCloV = callExt(b, "js_closure", [handle(emitYieldStarYield()), curScopeV])
            var yCloseCloV = callExt(b, "js_closure", [handle(emitYieldStarClose()), curScopeV])
            var yCatchCloV = callExt(b, "js_closure", [handle(emitYieldStarCatch()), curScopeV])
            var headB = curF.NewBlock("")
            var ystepB = curF.NewBlock("")
            var yidxB = curF.NewBlock("")
            var ylenB = curF.NewBlock("")
            var joinB = curF.NewBlock("")
            var bodyB = curF.NewBlock("")
            var exitB = curF.NewBlock("")
