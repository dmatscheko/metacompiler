        var inner = items[0]
        return {name: inner.name, base: inner.base, path: inner.path.concat(items.slice(1))}
    }
    function emitRefPath(b, ref) {
        var cur = anytype
        if (ref.base != undefined) {
            var br = ref.base(b)
            b = br.b
            cur = br.v
        } else {
            cur = callExt(b, "js_scope_get", [curScopeV, emitStr(b, ref.name)])
        }
        var curThis = hUndef
        for (var i = 0; i < ref.path.length - 1; i++) {
