            var opV = callExt(bb, "js_scope_get", [curScopeV, emitStr(bb, "0yopen")])
            var cB = curF.NewBlock("")
            var skB = curF.NewBlock("")
            bb.NewCondBr(truthy(bb, opV), cB, skB)
