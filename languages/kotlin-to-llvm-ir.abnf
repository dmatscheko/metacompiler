            } else {
                slotV = callExt(b, "js_closure", [handle(emitNestedFactory(nested[nc].name,
                                                                          nested[nc].inner,
                                                                          alsoV != null)), ownScopeV])
            }
            curScopeV = savedScopeV
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, nested[nc].name), declV])
            callExt(b, "js_set", [holderV, emitStr(b, nested[nc].name), slotV])
            if (alsoV != null) { callExt(b, "js_set", [alsoV, emitStr(b, nested[nc].name), slotV]) }
            // THREE LEVELS OF NESTING. The slot above holds a CONSTRUCTION FACTORY for a
            // nested class, which is what makes `Outer.Mid()` a call - but then the plain
            // READ `Outer.Mid` would answer that function and `Outer.Mid.Deep(7)` would
            // call 'Deep' on a function (the interpreter half's attachNested stores the
            // DESCRIPTOR). A second, `__`-prefixed slot carries the descriptor: js_ktfget
            // prefers it for a member READ, the plain slot still answers a member CALL,
            // and the two spellings stop fighting over one name. keysOf hides `__` slots,
            // so no data-class rendering or `for (k in o)` picks it up. An `asvalue`
            // nested type (enum, interface, object) already stores its descriptor in the
