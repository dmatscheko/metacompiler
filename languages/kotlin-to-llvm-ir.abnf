        var from = 0
        if (dropRecv) { from = 1 }
        if (inner) {
            callExt(b, "js_set", [objV, emitStr(b, "__outer"), callExt(b, "js_arg", [f.Params[1], handle(0)])])
            from = 1
        }
        b = emitTailArgs(b, ctorArgsV, f.Params[1], from)
        callExt(b, "js_call", [callExt(b, "js_get", [clsV, emitStr(b, "__ctor")]), hUndef, ctorArgsV])
        b.NewRet(objV)
        curF = savedF
        curScopeV = savedScope
        loopStack = savedLoops
        curFTag = savedTag
        return idx
    }
