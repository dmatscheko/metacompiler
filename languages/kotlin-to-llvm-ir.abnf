        // function (which hands the raw runtime value to Go's %v). js_ktprint /
        // js_ktwrite each RETURN the host function, so ::println and
        // list.forEach(::println) keep working and no other language's println
        // changes. See abnf/jsrtkotlin.go.
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "println"), callExt(b, "js_ktprint", [])])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "print"), callExt(b, "js_ktwrite", [])])
        // Kotlin's number types as VALUES, for their companion constants: Long.MAX_VALUE
