    // installMembers does in kotlin-interpreter.abnf.
    // items = [{apname}, {dsrc}] -> the accprop record splitMembers and emitAccessorPair
    // consume, marked isDeleg.
    function makeDelegProp(items, pos) {
        var rec = {name: null, init: null, getter: null, setter: null, setParam: "value",
                   isDeleg: true, dsrc: null, dwhere: c.file + ":" + c.lineOf(pos)}
        for (var i = 0; i < items.length; i++) {
            if (items[i] == undefined || items[i] == null) { continue }
            if (items[i].apname != undefined) { rec.name = items[i].apname }
            else if (items[i].dsrc != undefined) { rec.dsrc = items[i].dsrc }
        }
        return rec
    }
    // The hidden field a member delegate is stored in.
    function delegField(name) { return name + "$delegate" }
    // The initializer thunk for that field: evaluate the `by` expression and check it
    // really is a delegate. js_ktdcheck warns (or fails) exactly as notImpl does.
    function delegInitThunk(rec) {
        var src = rec.dsrc
        var where = rec.dwhere
        return function(b) {
            var r = src(b)
            var bb = r.b
            return {b: bb, v: callExt(bb, "js_ktdcheck",
                                      [r.v, emitStr(bb, where), c.warnUnsupported ? hTrue : hFalse,
                                       bb.NewCall(rtDThis(), [curScopeV]), emitStr(bb, rec.name)])}
        }
    }
    // The js_defprop pair of a delegated member property.
    function emitDelegPair(b, clsV, rec) {
        var fld = delegField(rec.name)
        var nm = rec.name
        var getIdx = emitFunc([], function(bb) {
            var thisV = callExt(bb, "js_scope_get", [curScopeV, emitStr(bb, "this")])
            bb.NewRet(callExt(bb, "js_ktdget", [callExt(bb, "js_get", [thisV, emitStr(bb, fld)]),
                                                thisV, emitStr(bb, nm)]))
            return deadBlock()
        }, false, false, undefined, true)
        var setIdx = emitFunc(["value"], function(bb) {
            var thisV = callExt(bb, "js_scope_get", [curScopeV, emitStr(bb, "this")])
            callExt(bb, "js_ktdset", [callExt(bb, "js_get", [thisV, emitStr(bb, fld)]), thisV,
                                      emitStr(bb, nm),
                                      callExt(bb, "js_scope_get", [curScopeV, emitStr(bb, "value")])])
            bb.NewRet(hUndef)
            return deadBlock()
        }, false, false, undefined, true)
        callExt(b, "js_defprop", [clsV, emitStr(b, nm),
                                  callExt(b, "js_closure", [handle(getIdx), curScopeV]),
                                  callExt(b, "js_closure", [handle(setIdx), curScopeV])])
        return b
    }
    // A LOCAL or top-level `val/var x by d`: bind the box. items = [name, {dsrc}, ...].
    function makeDelegDecl(items, pos) {
        var name = items[0]
        var src = null
        for (var i = 1; i < items.length; i++) {
            if (items[i] != undefined && items[i] != null && items[i].dsrc != undefined) { src = items[i].dsrc }
        }
        var where = c.file + ":" + c.lineOf(pos)
        return function(b) {
            var r = src(b)
            b = r.b
            var dV = callExt(b, "js_ktdcheck", [r.v, emitStr(b, where),
                                                c.warnUnsupported ? hTrue : hFalse,
                                                hNull, emitStr(b, name)])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, name),
                                         callExt(b, "js_ktdbox", [dV, emitStr(b, name)])])
            return b
        }
    }
    // items = [{sparam}?, bodyThunk]. Kotlin's implicit setter parameter is `value`.
    function makeSetAcc(items) {
        if (items.length > 1) { return {setter: items[1], setname: items[0].sparam} }
        return {setter: items[0], setname: "value"}
    }
    // The name of the backing field of property `name`. Not `name` itself: the runtime
    // consults a descriptor accessor only when the instance has no OWN property of that
    // name, so an own `name` slot would shadow the accessor permanently.
    function backingName(name) { return name + "$f" }
    // The backing field the accessor bodies currently being emitted belong to, so a
    // `field` reference inside them resolves to this.<name>$f (see the makeVarRef and
    // makeAssign overrides). null outside an accessor body, where `field` is a plain name.
    var emitBackingField = null
    // Emit the accessor pair of one property onto the descriptor clsV.
    function emitAccessorPair(b, clsV, rec) {
        if (rec.isDeleg == true) { return emitDelegPair(b, clsV, rec) }
        var savedField = emitBackingField
        emitBackingField = backingName(rec.name)
        var getV = hUndef
        var setV = hUndef
        if (rec.getter != null) {
            getV = callExt(b, "js_closure", [handle(emitFunc([], rec.getter, false, false, undefined, true)), curScopeV])
        }
        if (rec.setter != null) {
            setV = callExt(b, "js_closure", [handle(emitFunc([rec.setParam], rec.setter, false, false, undefined, true)), curScopeV])
        }
        emitBackingField = savedField
        callExt(b, "js_defprop", [clsV, emitStr(b, rec.name), getV, setV])
        return b
