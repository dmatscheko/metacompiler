        if (list == undefined) { return b }
        for (var i = 0; i < list.length; i++) {
            callExt(b, "js_set", [clsV, emitStr(b, "ext$" + list[i].name),
                                  callExt(b, "js_closure", [handle(emitMemberExtFunc(list[i])), curScopeV])])
