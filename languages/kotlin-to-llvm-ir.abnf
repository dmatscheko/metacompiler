    // than a select: js_ktsmcall would abort on null.
    function emitHashCodeFunc(name, props) {
        return emitFunc([], function(bb) {
            var thisV = callExt(bb, "js_scope_get", [curScopeV, emitStr(bb, "this")])
            var acc = anytype
