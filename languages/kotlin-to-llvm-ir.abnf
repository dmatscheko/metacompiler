    // `super.x = v` and its compound forms. items = [{squal}?, {sfname}, op, rhs].
    function makeSuperAssign(items, pos) {
        var qual = null
        var at = 0
        if (items[at] != undefined && items[at] != null && items[at].squal != undefined) {
            qual = items[at].squal
            at++
        }
        var fname = items[at].sfname
        var op = items[at + 1]
        var valT = items[at + 2]
        return function(b) {
            var target = superTargetName(qual)
            if (target == null) {
                // The RHS still runs; the store has nowhere to go.
                if (superExternal(qual)) { var xr = valT(b); return {b: xr.b, v: xr.v} }
                notImpl("super reference (" + superFailWhat(qual) + ")", pos)
                return {b: b, v: hUndef}
            }
            var r = valT(b)
            b = r.b
            var v = r.v
            var supV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, target)])
            var thisV = b.NewCall(rtKtGet(), [curScopeV, emitStr(b, "this")])
            var nameV = emitStr(b, fname)
            if (op != "=") {
                var ro = emitOpBin(b, op, callExt(b, "js_ktsupget", [supV, thisV, nameV]), v)
                b = ro.b
                v = ro.v
            }
            callExt(b, "js_ktsupset", [supV, thisV, nameV, v])
            return {b: b, v: v}
        }
    }

    // The program: jsmain(env, args) declares the builtins, the top level, then calls main().
    function buildMain(items) {
        // The walk of an imported file ends here too: stash its top-level
        // statements for the real jsmain instead of emitting a second one.
        if (importDepth > 0) {
            stashImported(items) // emitted later under this file's own source (see compile-core)
            return
        }
        var f = m.NewFunc("jsmain", i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        curF = f
        var b = f.NewBlock("entry")
        curScopeV = callExt(b, "js_scope_new", [f.Params[0]])
        // listOf/mutableListOf: an IR function that simply returns its argument array.
        funcCount++
        var loIdx = funcCount
        var lo = m.NewFunc("jsf_" + loIdx, i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var lob = lo.NewBlock("entry")
        lob.NewRet(lo.Params[1])
        var loV = callExt(b, "js_closure", [handle(loIdx), curScopeV])
        // The ARRAY constructors collapse onto listOf: this value model cannot tell an
        // Array from a List (both are a plain host array), which is a deliberate and
        // documented simplification. emptyList() with no arguments yields the empty
        // list, since jsf just returns its arg array. The SET constructors do NOT
        // collapse any more - a Set is its own shape (ktMakeSet in
        // abnf/jsrtkotlin.go), so they are js_ktglobal builders like mapOf.
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "listOf"), loV])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "mutableListOf"), loV])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "arrayListOf"), loV])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "arrayOf"), loV])
        // The typed array constructors are the same "return the argument array"
        // function: intArrayOf(1, 2) is a list of those elements in this value model.
        // The value model cannot tell one element WIDTH from another either (a Byte and
        // an Int are the same host number), so `byteArrayOf(200)` - a Kotlin COMPILE
        // error, whose legal spelling is `byteArrayOf((-56).toByte())` - is accepted
        // here, exactly as in the interpreter half. The unsigned builders are Kotlin's
        // @ExperimentalUnsignedTypes ones; the whole family is declared so a program
        // using any of them resolves the name in both halves.
        var arrayBuilders = ["intArrayOf", "longArrayOf", "doubleArrayOf", "floatArrayOf",
                             "booleanArrayOf", "charArrayOf", "byteArrayOf", "shortArrayOf",
                             "ubyteArrayOf", "ushortArrayOf", "uintArrayOf", "ulongArrayOf",
                             "emptyArray", "emptyList"]
        for (var ab = 0; ab < arrayBuilders.length; ab++) {
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, arrayBuilders[ab]), loV])
        }
        // A Sequence is EAGER in this subset (see kotlin-interpreter.abnf), so
        // sequenceOf IS listOf and every operator on it is the list operator.
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "sequenceOf"), loV])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "emptySequence"), loV])
        // The remaining global BUILDERS. Each is a runtime VALUE from js_ktglobal
        // (abnf/jsrtkotlin.go), the compiler-half twin of hostGlobals[...] in
        // kotlin-interpreter.abnf. What they build - the {__dict, keys, vals} map
        // handle, the {first, second[, third]} Pair, the {__sb} StringBuilder box -
        // are shapes whose whole member surface already lives in jsrtkotlin.go, so
        // the declaration is the entire port.
        var ktBuilders = ["mapOf", "mutableMapOf", "hashMapOf", "linkedMapOf", "sortedMapOf",
                          "emptyMap", "buildMap", "buildList", "buildString", "Pair", "Triple",
                          "with", "run", "repeat", "StringBuilder", "generateSequence",
                          // The stdlib top-level functions added with the missing-builtin
                          // sweep; their twins are the hostGlobals block in
                          // kotlin-interpreter.abnf. listOfNotNull is here rather than on
                          // the listOf alias above because it must DROP the nulls, which
                          // the "return the argument array" function did not.
                          "compareBy", "compareByDescending", "Comparator", "compareValues",
                          // kotlin.properties.Delegates - observable / vetoable / notNull.
                          "Delegates",
                          "maxOf", "minOf", "require", "check", "requireNotNull",
                          "checkNotNull", "error", "TODO", "runCatching", "lazy",
                          "List", "MutableList", "Array", "arrayOfNulls", "IntArray",
                          "LongArray", "ShortArray", "ByteArray", "DoubleArray",
                          "FloatArray", "BooleanArray", "CharArray", "UByteArray",
                          "UShortArray", "UIntArray", "ULongArray",
                          "listOfNotNull", "setOfNotNull",
                          // The SET constructors: their own shape since sets stopped
                          // being lists (ktMakeSet / ktSetMethod in jsrtkotlin.go).
                          "setOf", "mutableSetOf", "hashSetOf", "linkedSetOf",
                          "sortedSetOf", "emptySet",
                          // kotlinx.coroutines, as a SYNCHRONOUS subset: the block
                          // runs immediately and to completion, so the RESULTS are
                          // right and the ORDERING is not (see the :description note
                          // and ktGlobalFn in abnf/jsrtkotlin.go).
                          "runBlocking", "coroutineScope", "supervisorScope",
                          "withContext", "async", "launch", "delay", "yield",
                          "Job", "CoroutineScope", "awaitAll", "Dispatchers"]
        for (var kb = 0; kb < ktBuilders.length; kb++) {
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, ktBuilders[kb]),
                                         callExt(b, "js_ktglobal", [emitStr(b, ktBuilders[kb])])])
        }
        // kotlin.math's abs/max/min, and exitProcess from exit. NOT JavaScript's Math:
        // that one answers a plain number, so `max(1.5, 2.0)` printed `2` here and
        // `2.0` in the interpreter half, which is Kotlin's answer for a Double.
        var ktMath = ["abs", "max", "min"]
        for (var km = 0; km < ktMath.length; km++) {
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, ktMath[km]),
                                         callExt(b, "js_ktglobal", [emitStr(b, ktMath[km])])])
        }
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "exitProcess"),
                                     callExt(b, "js_scope_get", [curScopeV, emitStr(b, "exit")])])
        // println / print: Kotlin's OWN rendering, not the shared println host
        // function (which hands the raw runtime value to Go's %v and printed <nil>
        // for null, [1 2] for a list and a map of pointer addresses - or a stack
        // overflow - for an instance). js_ktprint / js_ktwrite each RETURN the host
        // function, so ::println and list.forEach(::println) keep working and no
        // other language's println changes. See abnf/jsrtkotlin.go.
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "println"), callExt(b, "js_ktprint", [])])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "print"), callExt(b, "js_ktwrite", [])])
        // Kotlin's number types as VALUES, for their companion constants. Int.MAX_VALUE
        // and friends existed in neither half before ("unknown name: Int"), and
        // Long.MAX_VALUE cannot be written as a plain number at all - which is the
        // whole reason a sized integer had to exist. The twin is hostGlobals["Int"] etc
        // in kotlin-interpreter.abnf; the objects come from js_kttype
        // (abnf/jsrtkotlin.go).
        var ktNumTypes = ["Int", "Long", "Byte", "Short", "UInt", "ULong", "UByte", "UShort",
                          "Char", "Double", "Float"]
        for (var kt = 0; kt < ktNumTypes.length; kt++) {
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, ktNumTypes[kt]),
                                         callExt(b, "js_kttype", [emitStr(b, ktNumTypes[kt])])])
        }
        b = emitImported(b)   // imported files' items, each under its own source (call-graph file attribution)
        b = makeSeq(topoClassItems(items))(b)
        // The entry point defaults to main(), but the -main flag (c.mainName) can override
        // it. A bare identifier (no '(') names a top-level function to call; anything else
        // is a snippet of Kotlin - a single statement such as greet("a", 2) - parsed with
        // the same grammar (from its Statement rule) and emitted into jsmain's scope, so it
        // can call the file's functions with real arguments.
        var mainName = c.mainName
        if (mainName == undefined || mainName == "") { mainName = "main" }
        if (mainIsSnippet(mainName)) {
            b = emitMainSnippet(b, mainName, "Statement")
            b.NewRet(emitNum(b, 0))
        } else {
            var mainV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, mainName)])
            var argsV = callExt(b, "js_arr_new", [])
            b.NewRet(callExt(b, "js_call", [mainV, hUndef, argsV]))
        }
    }

    // ----- Core library config (see lib/compile-core.js) -----
    // core.scopeGetExt stays the FLOOR's own js_scope_get: the this-aware read is the
    // emitted kt_ktget helper above (makeVarRef is overridden to call it), because
    // js_ktget took a SCOPE HANDLE and layer 2 cannot open one. This field names an
    // EXTERN, and js_ktget is no longer one.
    core.scopeGetExt = "js_scope_get"

    c.compile(c.asg)

    // ----- the native build (docs/runtime-next-plan.md part 3) -----
    // jsdispatch(idx, env, args) is the function table a LINKED binary needs: js_closure
    // stores a raw function index, and under llvm.Run the Go runtime turns that index
    // back into a callee by looking "jsf_<idx>" up in the module. A binary has no such
    // reflection, so the module carries the mapping itself. The MISS arm calls
    // jsdispatch_ext, the same table emitted by the layer-2 runtime library
    // (lib/kotlin-rt.ll, built by metajs-to-llvm-ir.abnf -rt-lib): its own function
    // indices are offset by a million, so the two chains cannot overlap and one js_call
    // reaches either module. Emitted ONLY for -exe, so every other run keeps the module
    // it had. This is lua-to-llvm-ir.abnf's emitDispatch, unchanged - the mechanism is
    // the reusable part of phase 4 and nothing here is Kotlin's.
    function emitDispatch() {
        var idxs = []
        var fns = []
        var i = 0
        while (i < m.Funcs.length) {
            var f = m.Funcs[i]
            var nm = f.Name()
            if (nm.length > 4 && nm.substring(0, 4) == "jsf_") {
                idxs.push(parseInt(nm.substring(4, nm.length)))
                fns.push(f)
            }
            i = i + 1
        }
        var ext = m.NewFunc("jsdispatch_ext", i64,
            [llvm.ir.NewParam("idx", i64), llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var d = m.NewFunc("jsdispatch", i64,
            [llvm.ir.NewParam("idx", i64), llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var b = d.NewBlock("entry")
        var extB = d.NewBlock("ext")
        var ownB = d.NewBlock("own")
        b.NewCondBr(b.NewICmp(llvm.enum.IPredSGE, d.Params[0], llvm.constant.NewInt(i64, 1000000)), extB, ownB)
        extB.NewRet(extB.NewCall(ext, [d.Params[0], d.Params[1], d.Params[2]]))
        b = ownB
        i = 0
        while (i < fns.length) {
            var hit = d.NewBlock("hit" + idxs[i])
            var nxt = d.NewBlock("miss" + idxs[i])
            b.NewCondBr(b.NewICmp(llvm.enum.IPredEQ, d.Params[0], llvm.constant.NewInt(i64, idxs[i])), hit, nxt)
            hit.NewRet(hit.NewCall(fns[i], [d.Params[1], d.Params[2]]))
            b = nxt
            i = i + 1
        }
        b.NewRet(b.NewCall(ext, [d.Params[0], d.Params[1], d.Params[2]]))
    }

    // The two runtime inputs live next to THIS grammar, so the build does not depend on
    // the working directory: lib/runtime.ll is the C floor and lib/kotlin-rt.ll is
    // Kotlin's own layer 2. An explicit -rt REPLACES both. This grammar's entry point is
    // ALREADY named jsmain, which is what the C floor's main() calls, so - like go and
    // unlike most of part 3 - no one-call alias has to be emitted.
    function libPath(name) {
        var mn = moduleName()
        var cut = -1
        var i = 0
        while (i < mn.length) {
            var ch = mn.charAt(i)
            if (ch == "/" || ch == "\\") { cut = i }
            i = i + 1
        }
        return mn.substring(0, cut + 1) + "lib/" + name
    }

    if (c.exePath != undefined && c.exePath != "") {
        emitDispatch()
        var rts = c.runtime
        if (rts == undefined || rts.length == 0) { rts = [libPath("runtime.ll"), libPath("kotlin-rt.ll")] }
        var buildErr = llvm.BuildExecutable(m, c.exePath, rts)
        if (buildErr != "") {
            println(buildErr)
            exit(1)
        }
        println("kotlin compiler: wrote executable " + c.exePath)
        exit(0)
    }

    println(m)

    var res = llvm.RunJS(m, "jsmain")
    var entryName = c.mainName
    if (entryName == undefined || entryName == "") { entryName = "main" }
    if (mainIsSnippet(entryName)) {
        println("kotlin compiler: -main snippet returned " + res.Ret)
    } else {
        println("kotlin compiler: " + entryName + "() returned " + res.Ret)
    }
    exit(res.Ret)

~~) ;
