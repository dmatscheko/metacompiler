            // String)` inside `class Outer(val tag: String)` reads the inner `tag`).
            if (emitOuterProps != null && emitOuterProps["$" + name] == true
                && !(emitClassTop() != null && classOwnProps["$" + emitClassTop()] != undefined
                     && classOwnProps["$" + emitClassTop()]["$" + name] == true)) {
                var itV = b.NewCall(rtKtGet(), [curScopeV, emitStr(b, "this")])
                return {b: b, v: callExt(b, "js_get", [callExt(b, "js_get", [itV, emitStr(b, "__outer")]),
                                                       emitStr(b, name)])}
            }
            if (name == "field" && emitBackingField != null) {
                var thisV = b.NewCall(rtKtGet(), [curScopeV, emitStr(b, "this")])
                return {b: b, v: callExt(b, "js_get", [thisV, emitStr(b, emitBackingField)])}
            }
            return {b: b, v: b.NewCall(rtKtGet(), [curScopeV, emitStr(b, name)])}
