    // instance slot (isInstance binds args[0] to `this`), declared as "ext$name".
    // The name registers at walk time, so every mcall suffix emitted later (all
    // emission happens inside buildMain) sees the complete extension table.
    function makeExtFunStmt(f) {
        extFunNames["$" + f.name] = true
        return function(b) {
            var idx = emitFunc(f.params, f.body, true, false, f.sig)
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "ext$" + f.name),
                                         callExt(b, "js_closure", [handle(idx), curScopeV])])
