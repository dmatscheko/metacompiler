    // the shared core makeWhile is reassigned to do the same.
    makeWhile = function(bodyT, condT) {
        return function(b) {
            var lbl = takeLabel()
            var headB = curF.NewBlock("")
            var bodyB = curF.NewBlock("")
            var exitB = curF.NewBlock("")
            b.NewBr(headB)
            var r = condT(headB)
            r.b.NewCondBr(truthy(r.b, r.v), bodyB, exitB)
            loopStack.push({cont: headB, brk: exitB, label: lbl})
            bodyT(bodyB).NewBr(headB)
            loopStack.pop()
            return exitB
        }
    }

    function makeDo(condT, bodyT) {
        return function(b) {
            var lbl = takeLabel()
            var bodyB = curF.NewBlock("")
            var condB = curF.NewBlock("")
            var exitB = curF.NewBlock("")
            b.NewBr(bodyB)
            loopStack.push({cont: condB, brk: exitB, label: lbl})
            bodyT(bodyB).NewBr(condB)
            loopStack.pop()
            var r = condT(condB)
            r.b.NewCondBr(truthy(r.b, r.v), bodyB, exitB)
            return exitB
        }
    }
    // items = [name, fromT, {rop}, toT, {step}?, bodyT]. The bounds and the step are
    // evaluated once (until subtracts one from the bound up front); downTo flips the
    // condition to >= and steps backwards. A hidden NUMERIC counter drives the loop and
    // the loop variable is re-boxed from it each iteration with js_char_like, so
    // `for (ch in 'a'..'c')` yields Chars and `for (i in 1..3)` yields Ints out of the
    // same emitted loop (js_char_like is the identity when the bound is not a Char).
    function makeForRange(items) {
        var name = items[0]
        var fromT = items[1]
        var rop = items[2].rop
        var toT = items[3]
        var stepT = items.length > 5 ? items[4].step : null
        var bodyT = items[items.length - 1]
        return function(b) {
            var lbl = takeLabel()
            hidCount++
            var tName = "$to" + hidCount
            var sName = "$st" + hidCount
            var saved = curScopeV
            curScopeV = callExt(b, "js_scope_new", [curScopeV])
            var cName = "$ct" + hidCount
            var mName = "$md" + hidCount
            var rf = fromT(b)
            b = rf.b
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, mName), rf.v])          // the element-type model
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, cName),
                                         callExt(b, "js_char_code", [rf.v])])          // the numeric counter
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, name), rf.v])
            var rt = toT(b)
            b = rt.b
            var boundV = callExt(b, "js_char_code", [rt.v])
