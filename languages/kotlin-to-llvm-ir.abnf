            var thisV = callExt(bb, "js_scope_get", [curScopeV, emitStr(bb, "this")])
            var clsV2 = callExt(bb, "js_scope_get", [curScopeV, emitStr(bb, clsName)])
            var objV = callExt(bb, "js_obj_new", [])
