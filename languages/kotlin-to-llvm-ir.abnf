    }
    // A range value in operand position, materialized as a list. items alternates
    // operands and {rop} markers: from, {rop}, to [, {rop:"step"}, step].
    function makeRange(items, pos) {
        if (items.length == 1) { return items[0] }
        var fromT = items[0]
        var rop = items[1].rop
        var toT = items[2]
        var stepT = (items.length > 4) ? items[4] : null
