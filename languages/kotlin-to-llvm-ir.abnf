    // object (js_get fails on nil and answers an index on an array). swift's
    // sw_safeget and dart's dt_safeget, transferred verbatim - the third and fourth
    // language to use exactly this guard.
    //
    // Duplicated on purpose with swift and dart: a grammar-level `:include` merges
    // PRODUCTIONS only (an included file's own :startScript is never run, silently), and
    // these helpers are startScript closures over m / curF / callExt / emitStr, so no
    // shared .abnf module can hold them. A shared script-level lib/*.js would be the
    // first family-only one, and unprefixed helper names in a shared core silently
    // replace a grammar's own (docs/working-on-this-project.md 7.12). The bodies also
    // differ per language (rtKGet/rtKSet, rtFunc) and every one carries the emitted
    // `sw_`/`dt_`/`kt_` prefix.
    function rtSafeGet() {
        return rtFunc("kt_safeget", 2, function(b, ps) {
            var v = ps[0]
            var noB = curF.NewBlock("")
            var c1 = curF.NewBlock("")
            var c2 = curF.NewBlock("")
            var okB = curF.NewBlock("")
            b.NewCondBr(truthy(b, callExt(b, "js_seq", [v, hNull])), noB, c1)
            c1.NewCondBr(truthy(c1, callExt(c1, "js_seq", [v, hUndef])), noB, c2)
            c2.NewCondBr(truthy(c2, callExt(c2, "js_seq", [callExt(c2, "js_typeof", [v]), emitStr(c2, "object")])), okB, noB)
            okB.NewRet(callExt(okB, "js_get", [v, ps[1]]))
            noB.NewRet(hUndef)
        })
