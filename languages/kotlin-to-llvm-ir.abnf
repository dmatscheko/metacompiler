        // record that travelled through the tag stack hands back a FRESH array on every
        // property read, so pushing into `sig.params` in place would be lost - the new
        // arrays have to be assembled locally and stored in a new signature record.
        if (reified != null && reified.length > 0) {
            reifiedFuns["$" + items[0]] = reified
            var defs = sig.defs
            for (var r = 0; r < reified.length; r++) {
                params.push(reifiedSlot(reified[r]))
                defs.push(null)
            }
            sig = {params: params, defs: defs, varargAt: sig.varargAt}
        }
        funParams["$" + items[0]] = params
        var body = items[2]
        // A non-local return somewhere inside marked this function's return-target entry;
        // its body then needs the catch wrapper that delivers the marker as a return.
        if (retEntry != null && retEntry.nl == true) { body = wrapNonLocal(body) }
        return {name: items[0], params: params, sig: sig, body: body}
    }
    function makeFunStmt(f) {
        funNames["$" + f.name] = true
        return function(b) {
            var idx = emitFunc(f.params, f.body, false, false, f.sig)
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, f.name),
                                         callExt(b, "js_closure", [handle(idx), curScopeV])])
