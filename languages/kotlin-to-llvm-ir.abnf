    // Emit the synthesized members onto clsV. isData also gets componentN and copy;
    // a value class gets only the equality/rendering pair, like Kotlin.
    function emitDataMembers(b, clsV, name, cparams, isData, own) {
        var props = dataProps(cparams)
        if (props.length == 0) { return b }
        if (own["$equals"] != true) {
            callExt(b, "js_set", [clsV, emitStr(b, "equals"),
                                  callExt(b, "js_closure", [handle(emitEqualsFunc(name, props)), curScopeV])])
        }
        if (own["$toString"] != true) {
            callExt(b, "js_set", [clsV, emitStr(b, "toString"),
                                  callExt(b, "js_closure", [handle(emitToStringFunc(name, props)), curScopeV])])
        }
        if (own["$hashCode"] != true) {
            callExt(b, "js_set", [clsV, emitStr(b, "hashCode"),
                                  callExt(b, "js_closure", [handle(emitHashCodeFunc(name, props)), curScopeV])])
        }
        if (!isData) { return b }
        for (var k = 0; k < props.length; k++) {
            callExt(b, "js_set", [clsV, emitStr(b, "component" + (k + 1)),
                                  callExt(b, "js_closure", [handle(emitComponentFunc(props[k])), curScopeV])])
        }
        if (own["$copy"] != true) {
            callExt(b, "js_set", [clsV, emitStr(b, "copy"),
                                  callExt(b, "js_closure", [handle(emitCopyFunc(name, props)), curScopeV])])
        }
        return b
    }

    // The BINARY name of a declared type - "Outer$Inner", "Outer$Inner$Deep" - which
    // is what java.lang.Class#getName answers and therefore what Throwable#toString
    // and the launcher's uncaught line spell for a NESTED throwable. Twin of kBinName in
    // kotlin-interpreter.abnf (see there); java carries the same bookkeeping in
    // languages/java-to-llvm-ir.abnf, as jBinStack / jBinOf.
    //
    // This half has no walk-time class stack, so the prefix is threaded at EMIT time
    // by emitNestedList, the same way emitOuterProps already is: emission is one
    // sequential pass, so a saved-and-restored script variable is exactly a stack.
    // Only a NESTED type gets a __bname; a top-level one falls back to __name in
    // ktClassBin and the string would be identical, so emitting it would grow every
    // module for nothing.
    var curBinPrefix = ""
    function emitBinName(b, clsV, name) {
        if (curBinPrefix == "") { return }
        callExt(b, "js_set", [clsV, emitStr(b, "__bname"), emitStr(b, curBinPrefix + "$" + name)])
    }

    // ----- nested and inner classes -----
    // makeClassStmt records the name it just declared so the enclosing NestedClass tag,
    // which runs immediately afterwards, can name its factory.
    var lastDeclaredClass = null

    // ----- Top-level class declarations are emitted in TOPOLOGICAL order -----
    // Kotlin does not require a class to be declared before the one that extends it:
    //     class Inh : Base() { fun q() = v }
    //     open class Base { val v = 5 }
    // is legal, and a class statement resolves its supertype with a scope read at the
    // moment it runs - so in SOURCE order `Inh` would read `Base` before it is
    // declared (the interpreter half's class declarations all register during the walk
    // and resolve their parents lazily). An INTERFACE supertype is the same read:
    //     class Impl : Iface { override fun f() = 1 }
    //     interface Iface { fun f(): Int; fun g(): Int = f() + 10 }
    // (interfaceMethods is complete in time: makeClassStmt's tag body runs during the
    // walk but the thunk it returns runs in buildMain, after the whole file has been
    // walked - only the scope READ is early.)
    //
    // Only the class items among the top-level items are permuted; every other
    // statement keeps its slot, so a top-level property initializer still runs where it
    // was written. markTopClass records which item index is a class, and the supertype
    // names makeClassStmt just captured.
    var topItemIndex = 0
    var topClassItems = []
    var topClassPending = null
    // Every TYPE declaration - class, interface, object, enum - records its name and
    // its supertype names here, and bumps a tick. A NESTED declaration's builder runs
    // before the enclosing one's, so the mark a top-level item leaves behind is always
    // the outermost declaration. The tick is what tells a type declaration apart from
    // the UnsupType forms that declare nothing at run time (a typealias, an annotation
    // class, an interface shape that fell to notImplStmt): those leave the tick alone,
    // so the previous item's mark is not read a second time.
    var declTick = 0
    var declMark = null
    var prevTick = 0
    function noteDecl(name, supers) {
        var ns = []
        for (var i = 0; i < supers.length; i++) { ns.push(supers[i].name) }
        declTick++
        declMark = {name: name, supers: ns}
    }
    function markTopType(t) {
        if (declTick > prevTick) { topClassPending = declMark }
        return t
    }
    function noteTopItem(t) {
        prevTick = declTick
        if (topClassPending != null) {
            topClassItems.push({idx: topItemIndex, name: topClassPending.name,
                                supers: topClassPending.supers})
            topClassPending = null
        }
        topItemIndex++
        return t
    }
    // Permute the class items so every class follows its supertypes. The common case -
    // a file already in dependency order - is one linear scan and no permutation at all,
    // which keeps the emitted module unchanged for such a program.
    function topoClassItems(items) {
        var n = topClassItems.length
        if (n < 2) { return items }
        var byName = {}
        for (var i = 0; i < n; i++) { byName["$" + topClassItems[i].name] = i }
        var needs = []
        var already = true
        for (var i = 0; i < n; i++) {
            var deps = []
            var sups = topClassItems[i].supers
            for (var s = 0; s < sups.length; s++) {
                var d = byName["$" + sups[s]]
                if (d != undefined && d != i) {
                    deps.push(d)
                    if (d > i) { already = false }
                }
            }
            needs.push(deps)
        }
        if (already) { return items }
        var done = []
        for (var i = 0; i < n; i++) { done.push(false) }
        var order = []
        for (var pass = 0; pass < n && order.length < n; pass++) {
            for (var i = 0; i < n; i++) {
                if (done[i]) { continue }
                var ok = true
                for (var k = 0; k < needs[i].length; k++) { if (!done[needs[i][k]]) { ok = false } }
                if (ok) { order.push(i); done[i] = true }
            }
        }
        // A CYCLE (`class A : B`, `class B : A`) is not legal Kotlin; whatever is left
        // keeps its source order rather than being dropped.
        for (var i = 0; i < n; i++) { if (!done[i]) { order.push(i) } }
        var out = []
        for (var k = 0; k < items.length; k++) { out.push(items[k]) }
        for (var k = 0; k < n; k++) { out[topClassItems[k].idx] = items[topClassItems[order[k]].idx] }
        return out
    }

    // items = [{isinner}?, classStatementThunk]
    function makeNested(items) {
        var inner = false
        var at = 0
        if (items[at] != undefined && items[at].isinner != undefined) { inner = true; at++ }
        return {name: lastDeclaredClass, inner: inner, asvalue: false, stmt: items[at]}
    }
    // The same, for a nested type that is NOT a class: an enum, an interface or an
    // object declaration. makeEnumStmt / makeInterfaceStmt / makeObjectStmt record the
    // name they just declared here, and only those three builders are reachable from
    // NestedEnum / NestedIface / NestedObj, so the name is always the right one.
    // asvalue means the enclosing descriptor gets the DESCRIPTOR itself rather than a
    // construction factory - an enum, an interface and an object are never `new`ed.
    var lastDeclaredType = null
    function makeNestedValue(stmt) {
        return {name: lastDeclaredType, inner: false, asvalue: true, stmt: stmt}
    }
    // The factory the enclosing descriptor exposes under the nested class's name. It is
    // an ordinary callable property, so `Outer.Nested(a)` (memberCall on a descriptor
    // calls the property directly) and `outer.Inner(a)` (memberCall on an INSTANCE
    // prepends the receiver) both reach it. For an inner class the prepended receiver is
    // the enclosing instance and is stored as __outer; a plain nested class has no
    // receiver in front, so its arguments start at slot 0.
    // Attach the nested declarations of a body to the value that holds its statics -
    // the descriptor of a class / enum / interface, the singleton of an object. Each
    // nested declaration runs FIRST (that is what binds it under its simple name), and
    // the holder then gets either a construction factory (a nested or inner class) or
    // the declared value itself (an enum, an interface, an object). The Go twin is
    // attachNested in kotlin-interpreter.abnf, which is called from the class, object,
    // enum and interface builders alike - so this helper is too.
    // alsoV is a SECOND holder or null. An object declaration needs both: the runtime
    // looks a method CALL up the __class chain (so a construction factory must sit on
    // the descriptor) while js_get on an instance does NOT walk that chain (so a plain
    // read of Outer.Kind must find it on the singleton itself).
    // PER-OWNER SCOPING. Each nested declaration runs in its OWN child scope, so
    // `class A { class Inner }` and `class B { class Inner }` do not share one slot: the
    // descriptor a factory (and any method of the nested class) resolves is the one
    // declared right beside it. The simple name is still MIRRORED into the enclosing
    // scope afterwards, because a bare `Inner(1)` written inside the owner's own body
    // resolves through the ordinary scope chain.
    function emitNestedList(b, holderV, alsoV, nested, ownerName) {
        for (var nc = 0; nc < nested.length; nc++) {
            var savedOuter = emitOuterProps
            if (nested[nc].inner) { emitOuterProps = classOwnProps["$" + ownerName] }
            var savedScopeV = curScopeV
            curScopeV = callExt(b, "js_scope_new", [savedScopeV])
            var ownScopeV = curScopeV
            // The enclosing type's binary name, for the __bname of everything the
            // nested declaration itself declares. See emitBinName.
            var savedBin = curBinPrefix
            curBinPrefix = (savedBin == "") ? ownerName : savedBin + "$" + ownerName
            b = nested[nc].stmt(b)
            curBinPrefix = savedBin
            emitOuterProps = savedOuter
            if (nested[nc].name == null) { curScopeV = savedScopeV; continue }
            var declV = callExt(b, "js_scope_get", [ownScopeV, emitStr(b, nested[nc].name)])
            var slotV = anytype
            if (nested[nc].asvalue) {
