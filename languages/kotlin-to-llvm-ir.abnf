        var noneB = curF.NewBlock("")
        var oneB = curF.NewBlock("")
        b.NewCondBr(truthy(b, callExt(b, "js_seq", [callExt(b, "js_get", [argsH, emitStr(b, "length")]), emitNum(b, 0)])), noneB, oneB)
        noneB.NewRet(hUndef)
        callExt(oneB, "js_yield", [callExt(oneB, "js_arg", [argsH, handle(0)])])
