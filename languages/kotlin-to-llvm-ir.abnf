        // type name arrives in the hidden parameter, so the probe reads it from there.
        var reifiedName = isReifiedHere(m.tname) ? reifiedSlot(m.tname) : null
        return function(b) {
            var r = operand(b)
            var tV = (reifiedName != null)
                ? callExt(r.b, "js_scope_get", [curScopeV, emitStr(r.b, reifiedName)])
                : emitStr(r.b, m.tname)
            var v = callExt(r.b, "js_ktis", [r.v, tV])
            if (m.neg) { v = callExt(r.b, "js_not", [v]) }
            return {b: r.b, v: v}
        }
    }
    // A curated stdlib infix call, folded left to right: a to b builds a Pair object
    // with first/second fields; and/or/xor go through js_ktarith (boolean logical on
    // two booleans, sized-integer bitwise otherwise) and shl/shr/ushr through
    // js_ktshift, which is width-aware. In Kotlin these seven are infix FUNCTIONS
    // rather than operators, which is why they lower here and not in emitBin.
    // items alternates operand thunks and {iop} markers.
    function makeInfix(items) {
        if (items.length == 1) { return items[0] }
        return function(b) {
            var r = items[0](b)
            b = r.b
            var v = r.v
            for (var i = 1; i < items.length; i += 2) {
                var op = items[i].iop
                var r2 = items[i + 1](b)
                b = r2.b
                if (items[i].user == true) {
                    // A user infix function: a.op(b) through the ordinary method path.
                    var iargsV = callExt(b, "js_arr_new", [])
                    callExt(b, "js_arr_push", [iargsV, r2.v])
                    v = callExt(b, "js_ktsmcall", [v, emitStr(b, op), iargsV])
                } else if (op == "to") {
                    v = emitPair(b, v, r2.v)
                } else if (op == "and") { v = callExt(b, "js_ktarith", [emitStr(b, "&"), v, r2.v]) }
                else if (op == "or") { v = callExt(b, "js_ktarith", [emitStr(b, "|"), v, r2.v]) }
                else if (op == "xor") { v = callExt(b, "js_ktarith", [emitStr(b, "^"), v, r2.v]) }
                // The shift COUNT is MASKED - & 31 for an Int, & 63 for a Long - and
                // the result type is the LEFT operand's alone, which is why
                // `1 shl 32` is 1 here and `1L shl 40` is 1099511627776 rather than
                // the 256 the 32 bit js_shl used to answer.
                else { v = callExt(b, "js_ktshift", [emitStr(b, op), v, r2.v]) }
            }
