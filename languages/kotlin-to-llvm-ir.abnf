                valB.NewBr(mrgB)
                var ph = mrgB.NewPhi([llvm.ir.NewIncoming(zeroV, nullB), llvm.ir.NewIncoming(hv, valB)])
                var sum = callExt(mrgB, "js_jadd", [callExt(mrgB, "js_mul", [acc, emitNum(mrgB, 31)]), ph])
                acc = callExt(mrgB, "js_ktadopt", [sum, emitNum(mrgB, 32), hFalse])
