    // not find (a typealias, a dotted path, an interface listed first). Those are bugs
    // here and stay hard failures that NAME the supertype. An external one is not a gap
    // in this grammar and never will be: there is no such class anywhere, so a `super`
    // into it degrades to Unit and the override's own body still runs.
    //
    // No second warning is printed at the super site, deliberately. The import already
    // warned and named the type, the degradation is only reachable because the user
    // passed -warn-imports, and a per-site warning cannot be made byte-identical between
    // a static emitter (which would warn about code that never runs) and a walker (which
    // would warn once per execution) - and the two halves must print the same bytes.
    var importedNames = {}
    function noteImportName(n) {
        if (n == "" || n == "*") { return }
        importedNames["$" + n] = true
    }
    function ktImport(items, pos) {
        var path = ""
        var alias = ""
        for (var i = 0; i < items.length; i++) {
            if (items[i] == undefined || items[i] == null) { continue }
            if (items[i].ialias != undefined) { alias = stripWs(items[i].ialias) }
            else { path = stripWs(items[i]) }
        }
        var seg = path
        var dot = -1
        for (var j = 0; j < path.length; j++) { if (path.charAt(j) == ".") { dot = j } }
        if (dot >= 0) { seg = path.substring(dot + 1, path.length) }
        var jcs = ktJavaClassImport(path)
        for (var ji = 0; ji < jcs.length; ji++) { ktImportBinds.push([alias != "" ? alias : jcs[ji][0], jcs[ji][1]]) }
        if (jcs.length == 0) { resolveImport(path, pos) }
        noteImportName(seg)
        noteImportName(alias)
    }
    // [name, runtime global] for each import of a java class the runtime provides
    // (ktJavaClassImport), declared after the builtins so the import's binding wins.
    var ktImportBinds = []
    function externalType(name) { return importedNames["$" + name] == true }

    // ----- Type aliases -----
    // `typealias Alias = Real` is still ERASED - no descriptor, no code - but the
    // mapping is kept so that a type REFERENCE written through the alias can be reduced
    // to the name the real descriptor is bound under. The flat table (no scoping) is
    // exactly what the interpreter half keeps, so both halves resolve the same way.
    // items = [aliasName, targetTypeText]; the return value is the erased statement.
    var typeAliases = {}
    function registerTypeAlias(items) {
        typeAliases["$" + stripWs(items[0])] = stripWs(items[1])
        return makeErased()
    }

    // ----- Supertypes -----
    // The bare name of a (possibly generic, possibly dotted) supertype: Box<T> -> Box,
    // a.b.C -> C. The untyped handle world erases type arguments, and the descriptor
    // that carries __name is bound under the simple name.
    function baseTypeName(t) {
        var cut = t.length
        for (var i = 0; i < t.length; i++) { if (t.charAt(i) == "<" || t.charAt(i) == "?") { cut = i; break } }
        t = t.substring(0, cut)
        var dot = -1
        for (var j = 0; j < t.length; j++) { if (t.charAt(j) == ".") { dot = j } }
        return (dot >= 0) ? t.substring(dot + 1, t.length) : t
    }
    // items = [{sname}, ({sarg}... {iscall}) | {sdeleg}] -> one supertype record.
    function makeSuper(items) {
        var rec = {name: items[0].sname, iscall: false, args: [], deleg: null}
        for (var i = 1; i < items.length; i++) {
            if (items[i].sarg != undefined) { rec.args.push(items[i].sarg) }
            else if (items[i].iscall != undefined) { rec.iscall = true }
            else if (items[i].sdeleg != undefined) { rec.deleg = items[i].sdeleg }
        }
        return rec
    }
    // An abstract (bodiless) member function: only its name and arity matter.
    function makeAbstract(items) { noteParams(items[0], items[1].params); return {name: items[0], params: items[1].params} }
    // The builtin throwables that can also be CONSTRUCTED directly - `throw
    // IllegalStateException("x")` - and whose constructor argument a subclass observes
    // (`class E(m: String) : Exception(m)` makes e.message readable; emitSuperCtor reads
    // this set). It matches ktExcHierarchy in abnf/jsrtkotlin.go and installThrowables in
    // kotlin-interpreter.abnf.
    var excBuiltins = {"$Throwable": true, "$Exception": true, "$Error": true,
                       "$RuntimeException": true, "$IllegalStateException": true,
                       "$IllegalArgumentException": true, "$IndexOutOfBoundsException": true,
                       "$NullPointerException": true, "$NumberFormatException": true,
                       "$UnsupportedOperationException": true, "$ArithmeticException": true,
                       "$NoSuchElementException": true, "$ConcurrentModificationException": true,
                       "$ClassCastException": true, "$IllegalAccessException": true,
                       "$NegativeArraySizeException": true,
                       "$StackOverflowError": true, "$OutOfMemoryError": true,
                       "$StringIndexOutOfBoundsException": true,
                       // Both of these are constructible in the interpreter half too
                       // (`throw NotImplementedError("m")`).
                       "$NotImplementedError": true,
                       "$UninitializedPropertyAccessException": true}

    // Import prefixes the runtime already satisfies: their symbols are provided
    // as builtins (abs/max/min, listOf, exitProcess, ...), so importing them is a
    // no-op. Anything else is an external library we cannot resolve.
    core.stdlibImports = ["kotlin", "kotlin.math", "kotlin.collections", "kotlin.system", "kotlin.text", "kotlin.ranges", "kotlin.sequences", "kotlinx.coroutines"]

    // Project-file imports: 'import a.b.C' looks for a/b/C.kt, then a/b.kt
    // under the program's directory and the -i roots (c.findImport). The file
    // is parsed with this grammar and walked with the same tags: its functions
    // register like the main file's, and its top-level statements are stashed
    // by buildMain (importDepth > 0) and prepended to jsmain. A file is
    // imported once; repeats and cycles are no-ops.
    var importedFiles = {}
    var importDepth = 0
    core.importFile = function(path, pos) {
        if (path.length > 2 && path.substring(path.length - 2) == ".*") { return false }
        var rel = path.split(".").join("/")
        var cands = [rel + ".kt"]
        var cut = -1
        for (var k = 0; k < rel.length; k++) { if (rel.charAt(k) == "/") { cut = k } }
        if (cut > 0) { cands.push(rel.substring(0, cut) + ".kt") }
        for (var i = 0; i < cands.length; i++) {
            var file = c.findImport(cands[i])
            if (file == "") { continue }
            if (importedFiles["$" + file] == true) { return true }
            importedFiles["$" + file] = true
            var text = c.readFile(file)
            var asg = c.parse(c.agrammar, text, null, file)
            c.pushSource(file, text)
            importDepth = importDepth + 1
            c.compile(asg)
            importDepth = importDepth - 1
            c.popSource()
            return true
        }
        return false
    }

    // stripWs, importResolvable, resolveImport and the notImpl / notImplStmt /
    // notImplExpr family live in lib/compile-core.js (shared by all compiler grammars).

    // try/catch/finally: each body becomes its own IR closure over the current scope;
    // js_try (jsrt.go) runs the try under a Go recover, routes a thrown value to the
    // catch closure and always runs finally; emitCatchClosure picks the clause.
    // Wrap a VALUE block (function(b) -> {b, v}) as a body closure that RETURNS its
    // value, which is how the try-EXPRESSION gets its value out of js_try.
    function valueBody(vb) {
        return function(b) {
            var r = vb(b)
            r.b.NewRet(r.v)
            return deadBlock()
        }
    }
    // A catch clause, with the DECLARED type CatchTy records. Overridden by assignment
    // (never re-declared): makeCatch lives in lib/compile-core.js and is shared, and
    // this grammar's CatchClause pushes one item more than it expects.
    makeCatch = function (items) {
        var body = anytype
        var nm = anytype
        var ty = anytype
        body = null
        nm = undefined
        ty = null
        for (var i = 0; i < items.length; i++) {
            var it = items[i]
            if (typeof it == "function") { body = it }
            else if (it != null && it != undefined && it.ctype != undefined) { ty = it.ctype }
            else { nm = it }
        }
        return {catchbody: body, catchname: nm, catchtype: ty}
    }
    // The parts of a try, whichever form it came in. EVERY catch clause is kept - the
    // dispatch that picks the matching one is emitCatchClosure's.
    function tryParts(items) {
        var tryT = anytype, finallyT = anytype
        var catches = []
        for (var i = 0; i < items.length; i++) {
            if (items[i].trybody != undefined) { tryT = items[i].trybody }
            else if (items[i].catchbody != undefined) { catches.push(items[i]) }
            else if (items[i].finbody != undefined) { finallyT = items[i].finbody }
        }
        return {tryT: tryT, catches: catches, finallyT: finallyT}
    }
    // ONE catch closure for all the clauses of a try. js_try can only be handed a
    // single catch function, so the clause SELECTION is emitted inside it: the thrown
    // value arrives as `__caught`, each typed clause is guarded by js_ktexcmatch
    // (abnf/jsrtkotlin.go, the twin of kExcMatches in the interpreter half), an
    // untyped clause takes everything from there on, and a value no clause matches is
    // rethrown - which is Kotlin's rule and what makes an outer try see it.
    function emitCatchClosure(cls) {
        return emitFunc(["__caught"], function(bb) {
            var b2 = anytype
            b2 = bb
            for (var i = 0; i < cls.length; i++) {
                var cn = (cls[i].catchname != undefined) ? cls[i].catchname : "__caught"
                var ty = cls[i].catchtype
                var caughtV = callExt(b2, "js_scope_get", [curScopeV, emitStr(b2, "__caught")])
                if (ty == null || ty == undefined) {
                    callExt(b2, "js_scope_decl", [curScopeV, emitStr(b2, cn), caughtV])
                    return cls[i].catchbody(b2)
                }
                var hitB = curF.NewBlock("")
                var nextB = curF.NewBlock("")
                b2.NewCondBr(truthy(b2, callExt(b2, "js_ktexcmatch", [caughtV, emitStr(b2, ty)])), hitB, nextB)
                callExt(hitB, "js_scope_decl", [curScopeV, emitStr(hitB, cn), caughtV])
                cls[i].catchbody(hitB).NewRet(hUndef)
                b2 = nextB
            }
            callExt(b2, "js_throw", [callExt(b2, "js_scope_get", [curScopeV, emitStr(b2, "__caught")])])
            b2.NewRet(hUndef)
            return deadBlock()
        }, false, true)
    }
    // Emit the js_try call and the control-signal dispatch. Returns {b, v}: v is the
    // value of whichever clause completed (undefined for statement bodies), valid on the
    // returned block, where no signal is pending any more.
    function emitTry(b, p) {
        // The try and catch bodies are ctl closures (isCtl), so a return/break/
        // continue leaving them becomes a control signal that excDispatch re-issues.
        var tryClo = callExt(b, "js_closure", [handle(emitFunc([], p.tryT, false, true)), curScopeV])
        var catchClo = hUndef
        if (p.catches.length > 0) {
            catchClo = callExt(b, "js_closure", [handle(emitCatchClosure(p.catches)), curScopeV])
        }
        var finClo = hUndef
        if (p.finallyT != undefined) {
            finClo = callExt(b, "js_closure", [handle(emitFunc([], p.finallyT, false, true)), curScopeV])
        }
        var ctl = callExt(b, "js_try", [tryClo, catchClo, finClo])
        return {b: excDispatch(b, ctl), v: ctl}
    }
    function makeTry(items) {
        var p = tryParts(items)
        return function(b) { return emitTry(b, p).b }
    }
    function makeTryValue(items) {
        var p = tryParts(items)
        return function(b) { return emitTry(b, p) }
    }
    // throw e: evaluate e and raise it with js_throw (a Go panic the runtime unwinds).
    function makeThrow(e) {
        return function(b) {
            var r = e(b)
            callExt(r.b, "js_throw", [r.v])
            r.b.NewRet(hUndef) // Never reached: js_throw unwinds on the host side.
            return deadBlock()
        }
    }
    // `throw e` used as an expression (Nothing): the same js_throw, wrapped so it yields
    // a {b, v} pair. The block it hands back is dead (js_throw never returns), so the
    // placeholder value is unreachable - a phi merging it is valid but never taken.
    function makeThrowExpr(e) {
        var t = makeThrow(e)
        return function(b) { return {b: t(b), v: hUndef} }
    }
    // `return` / `break` / `continue` used as EXPRESSIONS (see ReturnExpr above). Each
    // reuses the statement emitter unchanged and only adapts its shape: a statement thunk
    // takes a block and hands back a block, an expression thunk takes a block and hands
    // back {b, v}. The block returned is dead in every case - the ret has been emitted,
    // or the branch to the loop's exit/head has - so hUndef is never read.
    function makeReturnExpr(items, nonLocal) {
        var t = makeReturn(items, nonLocal)
        return function(b) { return {b: t(b), v: hUndef} }
    }
    function makeBreakExpr() {
        var t = makeBreak()
        return function(b) { return {b: t(b), v: hUndef} }
    }
    function makeContinueExpr() {
        var t = makeContinue()
        return function(b) { return {b: t(b), v: hUndef} }
    }
    // The generic adapter behind the labelled expression forms: a STATEMENT thunk takes a
    // block and hands back a block; an EXPRESSION thunk takes a block and hands back
    // {b, v}. The block is dead in every case (the ret or the branch has been emitted),
    // so hUndef is never read.
    function exprOfStmt(t) {
        return function(b) { return {b: t(b), v: hUndef} }
    }
    // Decodes a character literal's source text ('A', '\n', '￿') to its code.
    function kCharCode(t) {
        if (t.charAt(1) == "\\") {
            var e = t.charAt(2)
            if (e == "n") { return 10 }
            if (e == "t") { return 9 }
            if (e == "r") { return 13 }
            if (e == "b") { return 8 }
            if (e == "0") { return 0 }
            if (e == "u") { return parseInt(t.substring(3, 7), 16) }
            return e.charCodeAt(0)
        }
        return t.charCodeAt(1)
    }
    // [1, 2, 3] in an annotation argument / parameter default: a plain list value.
    function makeCollLit(items) {
        return function(b) {
            var arrV = callExt(b, "js_arr_new", [])
            for (var i = 0; i < items.length; i++) {
                var r = items[i](b)
                b = r.b
                callExt(b, "js_arr_push", [arrV, r.v])
            }
            return {b: b, v: arrV}
        }
    }
    // A char literal as a value: js_char boxes the code into Kotlin's Char.
    function makeCharConst(code) {
        return function(b) { return {b: b, v: callExt(b, "js_char", [handle(code)])} }
    }
    // x is T / x !is T: js_ktis is the shared dynamic type test plus the one thing it
    // cannot know - a SIZED INTEGER box carries its real type, so `5L is Long` holds
    // and `5L is Int` does not, where the shared probe answers "integral number" for
    // Int, Long, Short and Byte alike. Every other value falls straight through it.
    function makeIsCheck(operand, m) {
        // `x is T` where T is a REIFIED type parameter of the enclosing function: the
        // type name arrives in the hidden parameter, so the probe reads it from there.
        var reifiedName = isReifiedHere(m.tname) ? reifiedSlot(m.tname) : null
        return function(b) {
            var r = operand(b)
            var tV = (reifiedName != null)
                ? callExt(r.b, "js_scope_get", [curScopeV, emitStr(r.b, reifiedName)])
                : emitStr(r.b, m.tname)
            var v = callExt(r.b, "js_ktis", [r.v, tV])
            if (m.neg) { v = callExt(r.b, "js_not", [v]) }
            return {b: r.b, v: v}
        }
    }
    // A curated stdlib infix call, folded left to right: a to b builds a Pair object
    // with first/second fields; and/or/xor go through js_ktarith (boolean logical on
    // two booleans, sized-integer bitwise otherwise) and shl/shr/ushr through
    // js_ktshift, which is width-aware. In Kotlin these seven are infix FUNCTIONS
    // rather than operators, which is why they lower here and not in emitBin.
    // items alternates operand thunks and {iop} markers.
    function makeInfix(items) {
        if (items.length == 1) { return items[0] }
        return function(b) {
            var r = items[0](b)
            b = r.b
            var v = r.v
            for (var i = 1; i < items.length; i += 2) {
                var op = items[i].iop
                var r2 = items[i + 1](b)
                b = r2.b
                if (items[i].user == true) {
                    // A user infix function: `a dot b` is the call a.dot(b), so an
                    // `infix fun Int.pctOf(m: Money)` EXTENSION goes through the same
                    // extension chain as the method-suffix form, and the member
                    // surface is js_ktsmcall. The chain is chosen at EMIT time, so an
                    // extension declared further down the file counts.
                    var iarg = r2.v
                    var irecv = v
                    var imember = function(fb) {
                        var iargsV = callExt(fb, "js_arr_new", [])
                        callExt(fb, "js_arr_push", [iargsV, iarg])
                        return {b: fb, v: callExt(fb, "js_ktsmcall", [irecv, emitStr(fb, op), iargsV])}
                    }
                    var ir = imember
                    if (extFunNames["$" + op] == true) {
                        ir = function(fb) {
                            return emitExtChain(fb, irecv, {kind: "mcall", name: op,
                                                            args: [{at: function(ab) { return {b: ab, v: iarg} }}]}, imember)
                        }
                    }
                    var irr = ir(b)
                    b = irr.b
                    v = irr.v
                } else if (op == "to") {
                    v = emitPair(b, v, r2.v)
                } else if (op == "and") { v = callExt(b, "js_ktarith", [emitStr(b, "&"), v, r2.v]) }
                else if (op == "or") { v = callExt(b, "js_ktarith", [emitStr(b, "|"), v, r2.v]) }
                else if (op == "xor") { v = callExt(b, "js_ktarith", [emitStr(b, "^"), v, r2.v]) }
                // The shift COUNT is MASKED - & 31 for an Int, & 63 for a Long - and
                // the result type is the LEFT operand's alone, which is why
                // `1 shl 32` is 1 here and `1L shl 40` is 1099511627776.
                else { v = callExt(b, "js_ktshift", [emitStr(b, op), v, r2.v]) }
            }
            return {b: b, v: v}
        }
    }
    // `a to b` builds a Pair. Beyond .first / .second, Kotlin's Pair also answers
    // component1() / component2(), which is what for ((k, v) in pairs) and
    // val (k, v) = pair destructure through, and it answers `is Pair`. So the object
    // gets a descriptor carrying those two readers; the two IR functions behind them
    // are emitted once for the whole module and shared by every Pair.
    var pairC1 = 0
    var pairC2 = 0
    function emitPair(b, firstV, secondV) {
        if (pairC1 == 0) {
            pairC1 = emitComponentFunc("first")
            pairC2 = emitComponentFunc("second")
        }
        var clsV = callExt(b, "js_obj_new", [])
        callExt(b, "js_set", [clsV, emitStr(b, "__isclass"), hTrue])
        callExt(b, "js_set", [clsV, emitStr(b, "__name"), emitStr(b, "Pair")])
        callExt(b, "js_set", [clsV, emitStr(b, "component1"), callExt(b, "js_closure", [handle(pairC1), curScopeV])])
        callExt(b, "js_set", [clsV, emitStr(b, "component2"), callExt(b, "js_closure", [handle(pairC2), curScopeV])])
        var pV = callExt(b, "js_obj_new", [])
        callExt(b, "js_set", [pV, emitStr(b, "__class"), clsV])
        callExt(b, "js_set", [pV, emitStr(b, "first"), firstV])
        callExt(b, "js_set", [pV, emitStr(b, "second"), secondV])
        return pV
    }
    // A range value in operand position. items alternates operands and {rop}
    // markers: from, {rop}, to [, {rop:"step"}, step].
    //
    // A progression is the first-class {__range, from, to, st, down, ch, fl} value the
    // interpreter half has: Kotlin answers `(5..1).first` (5) and toString ("5..1")
    // from the DECLARED bounds, which a materialized element list cannot recover.
    // js_ktrange builds it and js_ktiter materializes the elements at the one place a
    // `for` needs them. The `for` loop's OWN range form is lowered separately below, so
    // no counting loop pays for this.
    // The fold is LEFT TO RIGHT, exactly as makeRange is in the interpreter half,
    // so `0..6 step 2` builds the 0..6 range and then re-steps it - and so does a
    // range that arrives in a variable, `r step 2`.
    function makeRange(items, pos) {
        if (items.length == 1) { return items[0] }
        // `1..2..3` is not a Kotlin program, and it is rejected HERE rather than
        // left to fail at run time with "range bound is not a number" - the
        // interpreter half's fold answers 1..2..NaN for it, so a compile-time
        // refusal is the only answer the two can share.
        var nops = 0
        for (var g = 1; g < items.length; g += 2) {
            if (items[g].rop != "step") { nops = nops + 1 }
        }
        if (nops > 1) { notImpl("chained range expression", pos) }
        return function(b) {
            var r0 = items[0](b)
            b = r0.b
            var v = r0.v
            for (var i = 1; i < items.length; i += 2) {
                var rop = items[i].rop
                var rr = items[i + 1](b)
                b = rr.b
                if (rop == "step") {
                    v = callExt(b, "js_ktrestep", [v, rr.v])
                } else {
                    var boundV = rr.v
                    // `..<` and until are the half-open forms: the INCLUSIVE bound
                    // the range value carries is one less, computed here.
                    if (rop == "until" || rop == "..<") {
                        boundV = callExt(b, "js_sub",
                            [callExt(b, "js_char_code", [boundV]), emitNum(b, 1)])
                    }
                    var downV = emitNum(b, (rop == "downTo") ? 1 : 0)
                    v = callExt(b, "js_ktrange", [v, boundV, emitNum(b, 1), downV])
                }
            }
            return {b: b, v: v}
        }
    }
    // x in coll / x !in coll -> coll.contains(x) via js_mcall (the same call the
    // interpreter makes), so the engines agree; !in negates. items alternates
    // operand thunks and {inop} markers.
    function makeInExpr(items, end) {
        if (items.length == 1) { return items[0] }
        // `3 in xs` with xs a collection of Longs: the literal takes the element type
        // (a map's key type).
        if (items.length == 3) { items[0] = ktAdoptThunk(items[0], ktInElemTy(items[1].at, end)) }
        return function(b) {
            var r = items[0](b)
            b = r.b
            var v = r.v
            for (var i = 1; i < items.length; i += 2) {
                var rc = items[i + 1](b)
                b = rc.b
                var argsV = callExt(b, "js_arr_new", [])
                callExt(b, "js_arr_push", [argsV, v])
                var hit = callExt(b, "js_ktsmcall", [rc.v, emitStr(b, "contains"), argsV])
                if (items[i].inop == "!in") { hit = callExt(b, "js_not", [hit]) }
                v = hit
            }
            return {b: b, v: v}
        }
    }
    // TypeOp collects the operand thunk and (if present) an is/as marker at
    // production level (a sibling inline tag cannot pop the operand). as = identity.
    function applyTypeOp(items) {
        if (items.length == 1) { return items[0] }
        // AsExpr may collect a chain (x as A as B); fold it left to right. TypeOp
        // carries at most one `is` marker, so the loop runs once there.
        var operand = items[0]
        for (var k = 1; k < items.length; k++) { operand = applyTypeOp1(operand, items[k]) }
        return operand
    }
    function applyTypeOp1(operand, m) {
        if (m.asType) {
            if (!m.safe) { return operand } // x as T: identity (untyped values)
            return function(b) { // x as? T: the value when it matches, else null
                var r = operand(b)
                var isV = callExt(r.b, "js_ktis", [r.v, emitStr(r.b, m.tname)])
                return {b: r.b, v: r.b.NewSelect(truthy(r.b, isV), r.v, hNull)}
            }
        }
        return makeIsCheck(operand, m)
    }

    // ----- Expression thunks: function(block) -> {b, v} -----

    // Implicit property access: locals first, then the properties of this.
    // Pops reversed: else, then, cond.
    function makeIfExpr(elseT, thenT, condT) {
        return function(b) {
            var r = condT(b)
            var thenB = curF.NewBlock("")
            var elseB = curF.NewBlock("")
            var mergeB = curF.NewBlock("")
            r.b.NewCondBr(truthy(r.b, r.v), thenB, elseB)
            var rt = thenT(thenB)
            rt.b.NewBr(mergeB)
            var re = elseT(elseB)
            re.b.NewBr(mergeB)
            var phi = mergeB.NewPhi([llvm.ir.NewIncoming(rt.v, rt.b), llvm.ir.NewIncoming(re.v, re.b)])
            return {b: mergeB, v: phi}
        }
    }
    function makeWhenArm(items) {
        var body = items.pop()
        return {conds: items, body: body}
    }
    // A when compiles to a test chain; the result travels in a hidden scope variable.
    // items = [thunk, thunk, ...]: a ?: b yields a unless it is null. Each step only
    // runs the right side in its own block when the left value was null (phi merge).
    function makeElvis(items, txt) {
        if (items.length == 1) return items[0]
        // `n ?: 0` with n a Long?: the literal takes the left operand's type.
        var ety = ktLitTy(ktLeadType(txt, "?:"))
        if (ety != "") {
            for (var ei = 1; ei < items.length; ei++) { items[ei] = ktAdoptThunk(items[ei], ety) }
        }
        return function(b) {
            var r = items[0](b)
            b = r.b
            var v = r.v
            for (var i = 1; i < items.length; i++) {
                var rightB = curF.NewBlock("")
                var mergeB = curF.NewBlock("")
                var isNull = callExt(b, "js_seq", [v, hNull])
                b.NewCondBr(truthy(b, isNull), rightB, mergeB)
                var r2 = items[i](rightB)
                r2.b.NewBr(mergeB)
                var phi = mergeB.NewPhi([llvm.ir.NewIncoming(v, b), llvm.ir.NewIncoming(r2.v, r2.b)])
                b = mergeB
                v = phi
            }
            return {b: b, v: v}
        }
    }
    function makeWhen(items) {
        var subj = null
        var subjName = null
        var els = null
        var arms = []
        for (var i = 0; i < items.length; i++) {
            if (items[i].subj != undefined) {
                subj = items[i].subj
                if (items[i].subjName != undefined) subjName = items[i].subjName
            }
            else if (items[i].els != undefined) els = items[i].els
            else arms.push(items[i])
        }
        return function(b) {
            hidCount++
            var wName = "$w" + hidCount
            var rName = "$wr" + hidCount
            var saved = curScopeV
            curScopeV = callExt(b, "js_scope_new", [curScopeV])
            if (subj != null) {
                var rs = subj(b)
                b = rs.b
                callExt(b, "js_scope_decl", [curScopeV, emitStr(b, wName), rs.v])
                // when (val x = e): x is visible to every arm body.
                if (subjName != null) callExt(b, "js_scope_decl", [curScopeV, emitStr(b, subjName), rs.v])
            }
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, rName), hUndef])
            var endB = curF.NewBlock("")
            for (var a = 0; a < arms.length; a++) {
                var matchB = curF.NewBlock("")
                for (var v2 = 0; v2 < arms[a].conds.length; v2++) {
                    var cond = arms[a].conds[v2]
                    var nextB = curF.NewBlock("")
                    if (cond.isType) {
                        var subjV0 = callExt(b, "js_scope_get", [curScopeV, emitStr(b, wName)])
                        var isV = callExt(b, "js_ktis", [subjV0, emitStr(b, cond.tname)])
                        if (cond.neg) { isV = callExt(b, "js_not", [isV]) }
                        b.NewCondBr(truthy(b, isV), matchB, nextB)
                    } else if (cond.v != undefined) {
                        var rv = cond.v(b)
                        b = rv.b
                        var condV
                        if (subj != null) {
                            var subjV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, wName)])
                            condV = callExt(b, "js_seq", [subjV, rv.v])
                        } else {
                            condV = rv.v
                        }
                        b.NewCondBr(truthy(b, condV), matchB, nextB)
                    } else {
                        // in lo..hi (or !in): both bounds are evaluated, like in Kotlin.
                        var rl = cond.lo(b)
                        b = rl.b
                        var rh = cond.hi(b)
                        b = rh.b
                        var subjV2 = callExt(b, "js_scope_get", [curScopeV, emitStr(b, wName)])
                        var inRange = b.NewAnd(truthy(b, callExt(b, "js_ge", [subjV2, rl.v])),
                                               truthy(b, callExt(b, "js_le", [subjV2, rh.v])))
                        if (cond.neg) { b.NewCondBr(inRange, nextB, matchB) }
                        else          { b.NewCondBr(inRange, matchB, nextB) }
                    }
                    b = nextB
                }
                var rb = arms[a].body(matchB)
                callExt(rb.b, "js_scope_set", [curScopeV, emitStr(rb.b, rName), rb.v])
                rb.b.NewBr(endB)
            }
            if (els != null) {
                var re = els(b)
                b = re.b
                callExt(b, "js_scope_set", [curScopeV, emitStr(b, rName), re.v])
            }
            b.NewBr(endB)
            var out = callExt(endB, "js_scope_get", [curScopeV, emitStr(endB, rName)])
            curScopeV = saved
            return {b: endB, v: out}
        }
    }

    foldCallMember = function(items, txt) {
        if (items.length == 1) return items[0]
        var primary = items[0]
        var suffixes = items.slice(1)
        if (suffixes[0].kind == "mcall") {
            suffixes[0] = ktAdoptMArgs(suffixes[0], ktLeadType(txt, suffixes[0].safe == true ? "?." : "."))
        } else if (suffixes[0].kind == "index") {
            ktAdoptIdxSfx(suffixes[0], ktLeadType(txt, "["))
        }
        // A call or an index after a run of member reads - `b.xs.add(3)`, `b.m[1]` -
        // takes the last member's declared type, read at emit time (a class may be
        // declared after its use).
        var lazyAt = ktChainSites(suffixes)
        var lead = ktLeadName(txt)
        var leadAt = ktAt
        function emitSuffixT(b, cur, s) {
            var sr = emitSuffix(b, cur, s)
            if (s.ktRes == undefined) { return sr }
            return {b: sr.b, v: emitAdoptV(sr.b, sr.v, ktWidthOfType(s.ktRes))}
        }
        function emitSuffix(b, cur, s) {
            if (s.kind == "mcall") {
                // An extension function wins only when no builtin or class method
                // uses the name: call ext$name directly, receiver prepended (it may
                // be null for a nullable-receiver extension; ?. still skips first).
                // A MEMBER extension of the enclosing class wins over a top-level
                // one (it is the more specific declaration, and it is only in scope
                // here at all). The lookup is a runtime one - which class instance is
                // the enclosing receiver is not known at emit time - and falls back to
                // the ordinary method dispatch when nothing declares it.
                if (memberExtNames["$" + s.name] == true && builtinMethodNames["$" + s.name] != true) {
                    var mxa = emitArgs(b, orderArgs(s.args, undefined))
                    return {b: mxa.b, v: mxa.b.NewCall(rtMextCall(),
                                                 [curScopeV, cur, emitStr(mxa.b, s.name), mxa.v])}
                }
                if (extFunNames["$" + s.name] == true && s.noExt != true) {
                    return emitExtChain(b, cur, s, function(fb) {
                        s.noExt = true
                        var fr = emitSuffix(fb, cur, s)
                        s.noExt = false
                        return fr
                    })
                }
                // v.toString(): Kotlin's rendering of the value, which is what
                // println writes. js_ktstr looks a user or synthesized toString up on
                // the __class chain and calls it first, so an override still wins;
                // going through js_mcall instead would abort on a list and on an
                // instance without one.
                if (s.name == "toString" && s.args.length == 0) {
                    return {b: b, v: callExt(b, "js_ktstr", [cur])}
                }
                // Int.inv(): the runtime has no method table for numbers, so the bitwise
                // complement is emitted inline (unless a class declares its own `inv`).
                if (s.name == "inv" && s.args.length == 0 && classMethodNames["$inv"] != true) {
                    return {b: b, v: callExt(b, "js_ktinv", [cur])}
                }
                // recv.name(args) where `name` holds a lambda WITH RECEIVER: call the
                // closure with the receiver in front. When a class ALSO declares a method
                // of that name, a runtime probe picks the method for its instances.
                if (recvLambdaNames["$" + s.name] == true) {
                    var lamRecv = cur
                    var lea = emitArgs(b, orderArgs(s.args, undefined))
                    var lb = lea.b
                    var callArgsV = callExt(lb, "js_arr_new", [])
                    callExt(lb, "js_arr_push", [callArgsV, lamRecv])
                    b = emitConcatArgs(lb, callArgsV, lea.v)
                    var mcls = methodClasses["$" + s.name]
                    if (mcls == undefined) {
                        var lamV0 = b.NewCall(rtKtGet(), [curScopeV, emitStr(b, s.name)])
                        return {b: b, v: callExt(b, "js_call", [lamV0, hUndef, callArgsV])}
                    }
                    var margsV = lea.v
                    var objB2 = curF.NewBlock("")
                    var lamB = curF.NewBlock("")
                    var mrg = curF.NewBlock("")
                    b.NewCondBr(emitClassProbe(b, lamRecv, mcls), objB2, lamB)
                    var mv = callExt(objB2, "js_ktsmcall", [lamRecv, emitStr(objB2, s.name), margsV])
                    objB2.NewBr(mrg)
                    // The scope read for the lambda belongs INSIDE the lambda arm: emitted
                    // before the branch, a program that merely DECLARED a
                    // receiver-function-typed parameter named `f` anywhere would make every
                    // `x.f()` in the file - including an ordinary method call on a user
                    // class - abort with "unknown name: f", because js_ktget would run (and
                    // throw) before the probe could pick the method.
                    var lamV = lamB.NewCall(rtKtGet(), [curScopeV, emitStr(lamB, s.name)])
                    var lv2 = callExt(lamB, "js_call", [lamV, hUndef, callArgsV])
                    lamB.NewBr(mrg)
                    return {b: mrg, v: mrg.NewPhi([llvm.ir.NewIncoming(mv, objB2), llvm.ir.NewIncoming(lv2, lamB)])}
                }
                var ea = emitArgs(b, orderArgs(s.args, paramsFor(s.name, s.args)))
                // An explicit type argument the method actually uses -
                // xs.filterIsInstance<String>() - rides along as a trailing string.
                var tnV = mcallTArg(s)
                if (tnV != null) { callExt(ea.b, "js_arr_push", [ea.v, emitStr(ea.b, tnV)]) }
                // f.invoke(x) on a function VALUE is a plain call; on an instance of a
                // class declaring the invoke convention it is that method.
                if (s.name == "invoke" && classMethodNames["$invoke"] != true) {
                    return {b: ea.b, v: callExt(ea.b, "js_call", [cur, hUndef, ea.v])}
                }
                if (s.name == "invoke") {
                    var invRecv = cur
                    var invArgs = ea.v
                    return emitOpDispatchArr(ea.b, invRecv, "invoke", invArgs, function(bb) {
                        return callExt(bb, "js_call", [invRecv, hUndef, invArgs])
                    })
                }
                // js_rxktmcall is js_mcall plus the Regex / MatchResult surface (and
                // the String members that take a pattern); it hands every other
                // receiver straight to js_mcall, so this is behaviour-preserving for
                // a program that uses no regexps. See abnf/jsrtregexkt.go.
                return {b: ea.b, v: callExt(ea.b, "js_ktsmcall", [cur, emitStr(ea.b, s.name), ea.v])}
            }
            if (s.kind == "dotanon") { return s.t(b) }
            // `X()::class`, `foo()::bar` - a reference whose RECEIVER is an arbitrary
            // expression, so it is always a BOUND one.
            if (s.kind == "refsfx") {
                if (s.name == "class") { return {b: b, v: callExt(b, "js_ktclasslit", [cur])} }
                return {b: b, v: emitRefValue(b, cur, s.name)}
            }
            if (s.kind == "invoke") {
                // The value in hand IS the callee. Same three cases the named `invoke`
                // method suffix above handles: a plain function value is called, and a
                // class that declares an `invoke` operator gets the runtime probe.
                var ia = emitArgs(b, orderArgs(s.args, undefined))
                if (classMethodNames["$invoke"] != true) {
                    return {b: ia.b, v: callExt(ia.b, "js_call", [cur, hUndef, ia.v])}
                }
                var pRecv = cur
                var pArgs = ia.v
                return emitOpDispatchArr(ia.b, pRecv, "invoke", pArgs, function(bb) {
                    return callExt(bb, "js_call", [pRecv, hUndef, pArgs])
                })
            }
            if (s.kind == "field") {
                // A MEMBER extension property of the enclosing class wins over both a
                // top-level extension property and the plain field read: it is the more
                // specific declaration and it is only in scope here at all. The lookup
                // is a RUNTIME one (which class instance is enclosing is not an
                // emit-time question) and falls back to the ordinary field read when
                // nothing declares it, exactly as js_ktmextcall does for a call.
                if (memberExtPropResolves(s.name)) {
                    return {b: b, v: b.NewCall(rtMextGet(), [curScopeV, cur, emitStr(b, s.name)])}
                }
                // An extension property wins only when no builtin and no class property
                // uses the name: call its getter with the receiver as `this`.
                if (extPropResolves(s.name)) {
                    var gV = b.NewCall(rtKtGet(), [curScopeV, emitStr(b, "extp$" + s.name)])
                    var gargsV = callExt(b, "js_arr_new", [])
                    callExt(b, "js_arr_push", [gargsV, cur])
                    return {b: b, v: callExt(b, "js_call", [gV, hUndef, gargsV])}
                }
                // `.size` is NOT rewritten to `.length` here: a user class may declare
                // its own `size` property. js_ktfget falls back to `length` only when
                // the receiver has no `size` of its own.
                var fname = s.name
                // js_ktfget is the StringBuilder box's properties, plus a Map MISS as
                // null (kotlin.Map.get answers null where the shared js_get answers
                // undefined), then js_rxktget - js_get plus Regex.pattern and the
                // MatchResult properties (value / range / groupValues / groups /
                // destructured). Every other receiver falls through to js_get.
                return {b: b, v: callExt(b, "js_ktfget", [cur, emitStr(b, fname)])}
            }
            // a[i]: the `get` convention when some class declares it, else the plain
            // read. js_kindex, not js_get, so a STRING yields the Char at that index
            // (Kotlin's CharSequence.get) while a list still yields its element.
            var ir2 = s.idx(b)
            var keyV = ir2.v
            // js_ktindex is a Map MISS as null (kotlin.Map.get answers null where the
            // shared read answers undefined), then js_rxktindex - js_kindex plus
            // m.groups[i] / m.groups["name"].
            return emitOpDispatch(ir2.b, cur, "get", [keyV], function(bb) {
                return callExt(bb, "js_ktindex", [cur, keyV])
            })
        }
        return function(b) {
            for (var li = 0; li < lazyAt.length; li++) { ktAdoptChainSfx(lead, leadAt, suffixes, lazyAt[li]) }
            lazyAt = []
            var r = primary(b)
            b = r.b
            var cur = r.v
            for (var i = 0; i < suffixes.length; i++) {
                var s = suffixes[i]
                if (s.safe) {
                    // ?. : the suffix (and the arguments of a skipped call) only runs
                    // in its own block when the receiver is not null; a phi merges.
                    var doB = curF.NewBlock("")
                    var mergeB = curF.NewBlock("")
                    var isNull = callExt(b, "js_eq", [cur, hNull])
                    b.NewCondBr(truthy(b, isNull), mergeB, doB)
                    var rs = emitSuffixT(doB, cur, s)
                    rs.b.NewBr(mergeB)
                    var phi = mergeB.NewPhi([llvm.ir.NewIncoming(hNull, b), llvm.ir.NewIncoming(rs.v, rs.b)])
                    b = mergeB
                    cur = phi
                } else {
                    var r2 = emitSuffixT(b, cur, s)
                    b = r2.b
                    cur = r2.v
                }
            }
            return {b: b, v: cur}
        }
    }

    // Lambda items = [{lparams}?, {stmt}|{expr}...]. A lambda becomes an own IR
    // function closed over the current scope (js_closure); the body is a sequence of
    // statements and its value is the last expression (a trailing non-expression
    // yields Unit). Without a parameter list the single argument is bound to 'it'.
    function makeLambda(items) {
        var params = ["it"]
        var start = 0
        // The label this lambda ANSWERS TO, so a `return@lbl` aimed at it - from any
        // depth, not only from its own body - is absorbed here and nowhere else. An
        // explicit label (lab@{ ... }) pushed its entry when it was seen and the body
        // has now been walked, so it is popped again here; without one, the implicit
        // label is the callee's name, the "lam" entry the enclosing Call / MethodSfx
        // pushed, which is still on top. The twin of makeLambda in the other half.
        var myLbl = null
        var myEntry = retLblTop()
        // A labelled lambda: drop the marker and release its return-target entry.
        if (items.length > 0 && items[0] != undefined && items[0].lamlbl != undefined) {
            myLbl = items[0].lamlbl
            retLblPop()
            items = items.slice(1)
        } else if (myEntry != null && myEntry.kind == "lam") {
            myLbl = myEntry.lbl
        } else {
            myEntry = null
        }
        if (items.length > 0 && items[0] != undefined && items[0].lparams != undefined) {
            params = items[0].lparams
            start = 1
        }
        // A destructuring parameter ({ (a, b) -> ... }) is genuine: its argument slot
        // gets a hidden name and the component names are bound from that value's
        // componentN() calls, exactly like a val (a, b) = e declaration.
        // argNames holds one name per argument slot.
        var argNames = []
        var destructs = []
        for (var pi = 0; pi < params.length; pi++) {
            var p = params[pi]
            if (typeof p == "string") {
                argNames.push(p)
            } else {
                var slot = "$d" + pi
                argNames.push(slot)
                var dnames = []
                var dprops = []
                for (var dd = 0; dd < p.destruct.length; dd++) { dnames.push(p.destruct[dd].dn); dprops.push(p.destruct[dd].dprop) }
                destructs.push({slot: slot, names: dnames, props: dprops})
            }
        }
        var body = items.slice(start)
        var bodyStmt = function(b) {
            for (var di = 0; di < destructs.length; di++) {
                b = emitComponents(b, callExt(b, "js_scope_get", [curScopeV, emitStr(b, destructs[di].slot)]),
                                   destructs[di].names, destructs[di].props)
            }
            var v = hUndef
            for (var k = 0; k < body.length; k++) {
                if (body[k].expr != undefined) {
                    var r = body[k].expr(b)
                    b = r.b
                    v = r.v
                } else {
                    b = body[k].stmt(b)
                    v = hUndef
                }
            }
            b.NewRet(v)
            return deadBlock()
        }
        // A lambda whose declared type has a receiver (val f: Int.(Int) -> Int = { ... })
        // takes its `this` from the first argument slot, so it is emitted as an INSTANCE
        // function: f(recv, a) and recv.f(a) then mean the same call, as in Kotlin.
        var withRecv = pendingRecvLambda
        pendingRecvLambda = false
        // Only a lambda some `return@<its label>` actually names needs the absorbing
        // wrapper, so a program without one emits byte-identical IR.
        var lamBody = bodyStmt
        if (myLbl != null && myEntry != null && myEntry.lamret == true) {
            lamBody = wrapLamRet(bodyStmt, myLbl)
        }
        return function(b) {
            var idx = emitFunc(argNames, lamBody, withRecv)
            return {b: b, v: callExt(b, "js_closure", [handle(idx), curScopeV])}
        }
    }
    // A { ... } block in value position (an if / when arm): emit its statements inline in a
    // fresh scope; the value is the last expression (Unit if it ends in a statement).
    function makeValueBlock(items) {
        return function(b) {
            var saved = curScopeV
            curScopeV = callExt(b, "js_scope_new", [curScopeV])
            var v = hUndef
            for (var k = 0; k < items.length; k++) {
                if (items[k].expr != undefined) {
                    var r = items[k].expr(b)
                    b = r.b
                    v = r.v
                } else {
                    b = items[k].stmt(b)
                    v = hUndef
                }
            }
            curScopeV = saved
            return {b: b, v: v}
        }
    }
    // val (a, b) = e: bind each name to the corresponding componentN() of the
    // initializer. `_` discards its component and does not call componentN, as in Kotlin.
    // Shared by the declaration, the for-loop form and destructuring lambda parameters.
    // One component read. Kotlin resolves componentN three ways and so does this:
    //   * a List / Array answers componentN as the element at that index (the stdlib
    //     declares component1()..component5() as extensions on List)
    //   * an object answers with its own componentN() method (a data class synthesizes
    //     it, a class can declare it with `operator fun component1()`)
    //   * anything else has no componentN. Real Kotlin rejects that at compile time;
    //     with no types available here the component simply yields undefined, so a
    //     nonsensical destructuring degrades instead of crashing the program.
    function emitComponent(b, srcV, k) {
        var listB = curF.NewBlock("")
        var notListB = curF.NewBlock("")
        var objB = curF.NewBlock("")
        var elseB = curF.NewBlock("")
        var mergeB = curF.NewBlock("")
        b.NewCondBr(truthy(b, callExt(b, "js_is_type", [srcV, emitStr(b, "List")])), listB, notListB)
        var lv = callExt(listB, "js_get", [srcV, emitNum(listB, k)])
        listB.NewBr(mergeB)
        var isObj = notListB.NewAnd(truthy(notListB, callExt(notListB, "js_seq",
                                        [callExt(notListB, "js_typeof", [srcV]), emitStr(notListB, "object")])),
                                    truthy(notListB, callExt(notListB, "js_sne", [srcV, hNull])))
        notListB.NewCondBr(isObj, objB, elseB)
        var ov = callExt(objB, "js_ktsmcall", [srcV, emitStr(objB, "component" + (k + 1)),
                                           callExt(objB, "js_arr_new", [])])
        objB.NewBr(mergeB)
        elseB.NewBr(mergeB)
        var phi = mergeB.NewPhi([llvm.ir.NewIncoming(lv, listB), llvm.ir.NewIncoming(ov, objB),
                                 llvm.ir.NewIncoming(hUndef, elseB)])
        return {b: mergeB, v: phi}
    }
    // The entries of one destructuring pattern. `props[k]` is "" for a POSITION based
    // entry - that one reads componentN - and the property name for a
    // NAME based entry, which reads that property off the value instead. A name of `_`
    // discards its entry and its componentN() is not called, as in Kotlin.
    function emitComponents(b, srcV, names, props) {
        for (var k = 0; k < names.length; k++) {
            if (names[k] == "_") { continue }
            if (props[k] != "") {
                var pv = callExt(b, "js_get", [srcV, emitStr(b, props[k])])
                callExt(b, "js_scope_decl", [curScopeV, emitStr(b, names[k]), pv])
                continue
            }
            var r = emitComponent(b, srcV, k)
            b = r.b
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, names[k]), r.v])
        }
