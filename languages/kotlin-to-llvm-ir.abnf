    // everywhere else `field` is an ordinary name (it is only a soft keyword in Kotlin).
    // Every name the program reads as a value, so buildMain declares a builtin only
    // for a program that uses it.
    var ktVarSeen = {}
    makeVarRef = function(name) {
        ktVarSeen["$" + name] = true
        return function(b) {
            // `RegexOption` (its entries are their own names) and `Regex` used as a
            // value, which is only ever its companion - Regex.escape(s) and friends.
            if ((name == "RegexOption" || name == "Regex") && classNames[name] == undefined
                && funNames["$" + name] != true) {
