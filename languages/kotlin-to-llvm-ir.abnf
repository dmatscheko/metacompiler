:startScript(~~

    // Shared emitter machinery (module, handle constants, externs, loopStack
    // protocol, expression/statement builders); see the `core` knobs below.
    include("lib/compile-core.js")
    // The static types an integer literal adopts (ktAdoptThunk applies them).
    include("lib/kotlin-decltypes.js")

    // ===== THE SCOPE PROBES, LOWERED HERE RATHER THAN LEFT AS EXTERNS =====
    //
    // A scope is the C floor's PRIVATE storage, so languages/lib/kotlin-rt.metajs
    // (layer 2) cannot open one with a handle; Kotlin has ten externs that read a scope.
    // An EMITTER may call js_scope_typeof / js_scope_get / js_scope_set, but it cannot
    // walk PAST the innermost binding: the floor seeds no scope-parent extern, so a
    // helper sees the innermost `name`, the innermost `this` and the innermost
    // `__dispatch` and no more. So the hot innermost arms are lowered here and the chain
    // walks are layer 2's (kotlin-rt.metajs SECTION 6, which uses the MetaJS scope host
    // builtins). Every place that costs exactness is written out at the helper concerned.
    var rtFuncs = {}
    function rtFunc(name, nparams, bodyFn) {
        if (rtFuncs["$" + name] != undefined) { return rtFuncs["$" + name] }
        var ps = []
        for (var i = 0; i < nparams; i++) { ps.push(llvm.ir.NewParam("p" + i, i64)) }
        var f = m.NewFunc(name, i64, ps)
        rtFuncs["$" + name] = f
        var savedF = curF
        var savedScope = curScopeV
        var savedLoops = loopStack
        var savedTag = curFTag
        curF = f
        loopStack = []
        var b = f.NewBlock("entry")
        bodyFn(b, f.Params)
        curF = savedF
        curScopeV = savedScope
        loopStack = savedLoops
        curFTag = savedTag
        return f
    }
