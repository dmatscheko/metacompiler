            }
            if (s.kind == "dotanon") { return s.t(b) }
            // `X()::class`, `foo()::bar` - a reference whose RECEIVER is an arbitrary
            // expression, so it is always a BOUND one.
            if (s.kind == "refsfx") {
                if (s.name == "class") { return {b: b, v: callExt(b, "js_ktclasslit", [cur])} }
                return {b: b, v: emitRefValue(b, cur, s.name)}
            }
            if (s.kind == "invoke") {
                // The value in hand IS the callee. Same three cases the named `invoke`
                // method suffix above handles: a plain function value is called, and a
                // class that declares an `invoke` operator gets the runtime probe.
                var ia = emitArgs(b, orderArgs(s.args, undefined))
                if (classMethodNames["$invoke"] != true) {
                    return {b: ia.b, v: callExt(ia.b, "js_call", [cur, hUndef, ia.v])}
                }
                var pRecv = cur
                var pArgs = ia.v
                return emitOpDispatchArr(ia.b, pRecv, "invoke", pArgs, function(bb) {
                    return callExt(bb, "js_call", [pRecv, hUndef, pArgs])
                })
            }
            if (s.kind == "field") {
                // A MEMBER extension property of the enclosing class wins over both a
                // top-level extension property and the plain field read: it is the more
                // specific declaration and it is only in scope here at all. The lookup
                // is a RUNTIME one (which class instance is enclosing is not an
                // emit-time question) and falls back to the ordinary field read when
                // nothing declares it, exactly as js_ktmextcall does for a call.
                if (memberExtPropResolves(s.name)) {
                    return {b: b, v: b.NewCall(rtMextGet(), [curScopeV, cur, emitStr(b, s.name)])}
                }
                // An extension property wins only when no builtin and no class property
                // uses the name: call its getter with the receiver as `this`.
                if (extPropResolves(s.name)) {
                    var gV = b.NewCall(rtKtGet(), [curScopeV, emitStr(b, "extp$" + s.name)])
                    var gargsV = callExt(b, "js_arr_new", [])
                    callExt(b, "js_arr_push", [gargsV, cur])
                    return {b: b, v: callExt(b, "js_call", [gV, hUndef, gargsV])}
                }
                // `.size` is NOT rewritten to `.length` here any more. The rewrite was
                // unconditional, so a user class declaring its own `size` property read
                // undefined and printed "kotlin.Unit" while the interpreter half
                // answered the property - and a `var size` was written under one name
                // and read under the other. js_ktfget now falls back to `length` only
                // when the receiver has no `size` of its own.
                var fname = s.name
                // js_ktfget is the StringBuilder box's properties, plus a Map MISS as
                // null (kotlin.Map.get answers null where the shared js_get answers
                // undefined), then js_rxktget - js_get plus Regex.pattern and the
                // MatchResult properties (value / range / groupValues / groups /
                // destructured). Every other receiver falls through to js_get.
                return {b: b, v: callExt(b, "js_ktfget", [cur, emitStr(b, fname)])}
            }
            // a[i]: the `get` convention when some class declares it, else the plain
            // read. js_kindex, not js_get, so a STRING yields the Char at that index
            // (Kotlin's CharSequence.get) while a list still yields its element.
            var ir2 = s.idx(b)
            var keyV = ir2.v
            // js_ktindex is a Map MISS as null (kotlin.Map.get answers null where the
            // shared read answers undefined), then js_rxktindex - js_kindex plus
            // m.groups[i] / m.groups["name"].
            return emitOpDispatch(ir2.b, cur, "get", [keyV], function(bb) {
                return callExt(bb, "js_ktindex", [cur, keyV])
            })
        }
        return function(b) {
            var r = primary(b)
            b = r.b
            var cur = r.v
            for (var i = 0; i < suffixes.length; i++) {
                var s = suffixes[i]
                if (s.safe) {
                    // ?. : the suffix (and the arguments of a skipped call) only runs
                    // in its own block when the receiver is not null; a phi merges.
                    var doB = curF.NewBlock("")
                    var mergeB = curF.NewBlock("")
                    var isNull = callExt(b, "js_eq", [cur, hNull])
                    b.NewCondBr(truthy(b, isNull), mergeB, doB)
                    var rs = emitSuffix(doB, cur, s)
                    rs.b.NewBr(mergeB)
                    var phi = mergeB.NewPhi([llvm.ir.NewIncoming(hNull, b), llvm.ir.NewIncoming(rs.v, rs.b)])
                    b = mergeB
                    cur = phi
                } else {
                    var r2 = emitSuffix(b, cur, s)
                    b = r2.b
                    cur = r2.v
                }
            }
            return {b: b, v: cur}
        }
    }

    // Lambda items = [{lparams}?, {stmt}|{expr}...]. A lambda becomes an own IR
    // function closed over the current scope (js_closure); the body is a sequence of
    // statements and its value is the last expression (a trailing non-expression
    // yields Unit). Without a parameter list the single argument is bound to 'it'.
    function makeLambda(items) {
        var params = ["it"]
        var start = 0
        // The label this lambda ANSWERS TO, so a `return@lbl` aimed at it - from any
        // depth, not only from its own body - is absorbed here and nowhere else. An
        // explicit label (lab@{ ... }) pushed its entry when it was seen and the body
        // has now been walked, so it is popped again here; without one, the implicit
        // label is the callee's name, the "lam" entry the enclosing Call / MethodSfx
        // pushed, which is still on top. The twin of makeLambda in the other half.
        var myLbl = null
        var myEntry = retLblTop()
        // A labelled lambda: drop the marker and release its return-target entry.
        if (items.length > 0 && items[0] != undefined && items[0].lamlbl != undefined) {
            myLbl = items[0].lamlbl
            retLblPop()
            items = items.slice(1)
        } else if (myEntry != null && myEntry.kind == "lam") {
            myLbl = myEntry.lbl
        } else {
            myEntry = null
        }
        if (items.length > 0 && items[0] != undefined && items[0].lparams != undefined) {
            params = items[0].lparams
            start = 1
        }
        // A destructuring parameter ({ (a, b) -> ... }) is genuine: its argument slot
        // gets a hidden name and the component names are bound from that value's
        // componentN() calls, exactly like a val (a, b) = e declaration.
        // argNames holds one name per argument slot.
        var argNames = []
        var destructs = []
        for (var pi = 0; pi < params.length; pi++) {
            var p = params[pi]
            if (typeof p == "string") {
                argNames.push(p)
            } else {
                var slot = "$d" + pi
                argNames.push(slot)
                var dnames = []
                var dprops = []
                for (var dd = 0; dd < p.destruct.length; dd++) { dnames.push(p.destruct[dd].dn); dprops.push(p.destruct[dd].dprop) }
                destructs.push({slot: slot, names: dnames, props: dprops})
            }
        }
        var body = items.slice(start)
        var bodyStmt = function(b) {
            for (var di = 0; di < destructs.length; di++) {
                b = emitComponents(b, callExt(b, "js_scope_get", [curScopeV, emitStr(b, destructs[di].slot)]),
                                   destructs[di].names, destructs[di].props)
            }
            var v = hUndef
            for (var k = 0; k < body.length; k++) {
                if (body[k].expr != undefined) {
                    var r = body[k].expr(b)
                    b = r.b
                    v = r.v
                } else {
                    b = body[k].stmt(b)
                    v = hUndef
                }
            }
            b.NewRet(v)
            return deadBlock()
        }
        // A lambda whose declared type has a receiver (val f: Int.(Int) -> Int = { ... })
        // takes its `this` from the first argument slot, so it is emitted as an INSTANCE
        // function: f(recv, a) and recv.f(a) then mean the same call, as in Kotlin.
        var withRecv = pendingRecvLambda
        pendingRecvLambda = false
        // Only a lambda some `return@<its label>` actually names needs the absorbing
        // wrapper, so a program without one emits byte-identical IR.
        var lamBody = bodyStmt
        if (myLbl != null && myEntry != null && myEntry.lamret == true) {
            lamBody = wrapLamRet(bodyStmt, myLbl)
        }
        return function(b) {
            var idx = emitFunc(argNames, lamBody, withRecv)
            return {b: b, v: callExt(b, "js_closure", [handle(idx), curScopeV])}
        }
    }
    // A { ... } block in value position (an if / when arm): emit its statements inline in a
    // fresh scope; the value is the last expression (Unit if it ends in a statement).
    function makeValueBlock(items) {
        return function(b) {
            var saved = curScopeV
            curScopeV = callExt(b, "js_scope_new", [curScopeV])
            var v = hUndef
            for (var k = 0; k < items.length; k++) {
                if (items[k].expr != undefined) {
                    var r = items[k].expr(b)
                    b = r.b
                    v = r.v
                } else {
                    b = items[k].stmt(b)
                    v = hUndef
                }
            }
            curScopeV = saved
            return {b: b, v: v}
        }
    }
    // val (a, b) = e: bind each name to the corresponding componentN() of the
    // initializer. `_` discards its component and does not call componentN, as in Kotlin.
    // Shared by the declaration, the for-loop form and destructuring lambda parameters.
    // One component read. Kotlin resolves componentN three ways and so does this:
    //   * a List / Array answers componentN as the element at that index (the stdlib
    //     declares component1()..component5() as extensions on List)
    //   * an object answers with its own componentN() method (a data class synthesizes
    //     it, a class can declare it with `operator fun component1()`)
    //   * anything else has no componentN. Real Kotlin rejects that at compile time;
    //     with no types available here the component simply yields undefined, so a
    //     nonsensical destructuring degrades instead of crashing the program.
    function emitComponent(b, srcV, k) {
        var listB = curF.NewBlock("")
        var notListB = curF.NewBlock("")
        var objB = curF.NewBlock("")
        var elseB = curF.NewBlock("")
        var mergeB = curF.NewBlock("")
        b.NewCondBr(truthy(b, callExt(b, "js_is_type", [srcV, emitStr(b, "List")])), listB, notListB)
        var lv = callExt(listB, "js_get", [srcV, emitNum(listB, k)])
        listB.NewBr(mergeB)
        var isObj = notListB.NewAnd(truthy(notListB, callExt(notListB, "js_seq",
                                        [callExt(notListB, "js_typeof", [srcV]), emitStr(notListB, "object")])),
                                    truthy(notListB, callExt(notListB, "js_sne", [srcV, hNull])))
        notListB.NewCondBr(isObj, objB, elseB)
        var ov = callExt(objB, "js_ktsmcall", [srcV, emitStr(objB, "component" + (k + 1)),
                                           callExt(objB, "js_arr_new", [])])
        objB.NewBr(mergeB)
        elseB.NewBr(mergeB)
        var phi = mergeB.NewPhi([llvm.ir.NewIncoming(lv, listB), llvm.ir.NewIncoming(ov, objB),
                                 llvm.ir.NewIncoming(hUndef, elseB)])
        return {b: mergeB, v: phi}
    }
    // The entries of one destructuring pattern. `props[k]` is "" for a POSITION based
    // entry - that one reads componentN, exactly as before - and the property name for a
    // NAME based entry, which reads that property off the value instead. A name of `_`
    // discards its entry and its componentN() is not called, as in Kotlin.
    function emitComponents(b, srcV, names, props) {
        for (var k = 0; k < names.length; k++) {
            if (names[k] == "_") { continue }
            if (props[k] != "") {
                var pv = callExt(b, "js_get", [srcV, emitStr(b, props[k])])
                callExt(b, "js_scope_decl", [curScopeV, emitStr(b, names[k]), pv])
                continue
            }
            var r = emitComponent(b, srcV, k)
            b = r.b
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, names[k]), r.v])
        }
        return b
    }
    // One destructuring entry, built from what its rule pushed: an optional val/var
    // marker, the bound NAME and an optional `= property`. Parenthesized patterns are
    // name based as soon as an entry declares itself (val/var) or renames (= prop);
    // a bracketed pattern and the classic `val (a, b)` stay position based.
    function makeDEntry(items, named) {
        var nm = ""
        var pr = ""
        var kw = false
        for (var i = 0; i < items.length; i++) {
            var it = items[i]
            if (it.dk == "kw") { kw = true }
            else if (it.dk == "name") { nm = it.ds }
            else { pr = it.ds }
        }
        if (!named) { return {dn: nm, dprop: ""} }
        if (pr != "") { return {dn: nm, dprop: pr} }
        if (kw) { return {dn: nm, dprop: nm} }
        return {dn: nm, dprop: ""}
    }
    function makeDestructure(items, pos) {
        var names = []
        var props = []
        for (var i = 0; i < items.length - 1; i++) { names.push(items[i].dn); props.push(items[i].dprop) }
        var init = items[items.length - 1]
        return function(b) {
            var r = init(b)
            return emitComponents(r.b, r.v, names, props)
        }
    }
    // An anonymous function expression: the same lowering as a named local function
    // (own IR function + js_closure over the current scope), without the binding.
    function makeAnonFun(items) {
        var sig = items[0]
        var body = items[1]
        return function(b) {
            var idx = emitFunc(sig.params, body, false, false, sig)
            return {b: b, v: callExt(b, "js_closure", [handle(idx), curScopeV])}
        }
    }

    // `by lazy { init }`: the init thunk emits the lambda closure and calls it once
    // (no args), yielding the initializer's value. Used as a plain property/decl
    // initializer, so the lazy value is computed eagerly at the declaration.
    function makeLazyInit(lambdaThunk) {
        return function(b) {
            var r = lambdaThunk(b)
            b = r.b
            var argsV = callExt(b, "js_arr_new", [])
            return {b: b, v: callExt(b, "js_call", [r.v, hUndef, argsV])}
        }
    }

    // items = members ({prop} | {method}): an anonymous class instance built where
    // the expression evaluates - a fresh descriptor holding the method closures
    // (closed over the CURRENT scope, so members can capture enclosing locals like
    // a lambda), a fresh instance, then the property initializers in a child scope
    // holding the instance as `this`. Method names register in classMethodNames at
    // walk time (an extension function never shadows a member).
    // Split walked members (from `start`) into property initializers ({prop,init}),
    // methods (the method object of a {method}) and the companion member list (a
    // {companion}, only classes carry one). Written once so every class/object/
    // companion emitter partitions its members the same way.
    function splitMembers(items, start) {
        var props = []
        var methods = []
        var accprops = []
        var nested = []
        var sctors = []
        var abstracts = []
        var memberExts = []
        var memberExtProps = []
        var memberExtDelegs = []
        var inits = []          // Property initializers AND init blocks, in DECLARATION order.
        var companion = null
        var compName = null
        for (var i = start; i < items.length; i++) {
            if (items[i].companion != undefined) {
                companion = items[i].companion
                for (var ci = 0; ci < companion.length; ci++) {
                    if (companion[ci].cname != undefined) { compName = companion[ci].cname }
                }
            }
            else if (items[i].nested != undefined) { nested.push(items[i].nested) }
            else if (items[i].sctor != undefined) { sctors.push(items[i].sctor) }
            else if (items[i].accprop != undefined) {
                accprops.push(items[i].accprop)
                // A delegated property's "initializer" fills the hidden delegate field.
                if (items[i].accprop.isDeleg == true) {
                    inits.push({prop: delegField(items[i].accprop.name),
                                init: delegInitThunk(items[i].accprop)})
                }
                // Only a property WITH an initializer has a backing field to fill.
                else if (items[i].accprop.init != null) {
                    inits.push({prop: backingName(items[i].accprop.name), init: items[i].accprop.init})
                }
            }
            else if (items[i].initblk != undefined) { inits.push(items[i]) }
            else if (items[i].memberExt != undefined) {
                memberExts.push(items[i].memberExt)
                memberExtNames["$" + items[i].memberExt.name] = true
            }
            else if (items[i].memberExtProp != undefined) {
                memberExtProps.push(items[i].memberExtProp)
                memberExtPropNames["$" + items[i].memberExtProp.name] = true
            }
            else if (items[i].memberExtDeleg != undefined) {
                memberExtDelegs.push(items[i].memberExtDeleg)
                memberExtPropNames["$" + items[i].memberExtDeleg.name] = true
            }
            else if (items[i].absmethod != undefined) { abstracts.push(items[i].absmethod) }
            else if (items[i].prop != undefined && items[i].init != undefined) { props.push(items[i]); inits.push(items[i]) }
            else if (items[i].method != undefined) { methods.push(items[i].method) }
        }
        return {props: props, methods: methods, accprops: accprops, abstracts: abstracts,
                memberExts: memberExts, memberExtProps: memberExtProps,
                memberExtDelegs: memberExtDelegs,
                nested: nested, sctors: sctors, inits: inits, companion: companion, compName: compName}
    }
    // The leading non-member entries of a walked type declaration: the supertype list
    // ({supers}) and, for a class, the primary constructor parameters ({cparams}).
    // Returns {i, cparams, supers, sup} - i is the index the members start at, sup the
    // FIRST supertype (the __super link) or null.
    function takeHeader(items, start) {
        var i = start
        var cparams = []
        var supers = []
        if (items.length > i && items[i] != undefined && items[i].cparams != undefined) { cparams = items[i].cparams; i++ }
        if (items.length > i && items[i] != undefined && items[i].supers != undefined) { supers = items[i].supers; i++ }
        return {i: i, cparams: cparams, supers: supers, sup: (supers.length > 0 ? supers[0] : null)}
    }
    // The name a type REFERENCE ends up bound under at run time, or null when this
    // compile emits no descriptor for it. Three reductions, all reachable from ordinary
    // Kotlin and all of which used to make knownType answer false:
    //   * generics and a dotted path      Box<T> -> Box, Outer.In -> In  (baseTypeName;
    //     every descriptor is bound under its SIMPLE name, nested ones included)
    //   * a typealias                     typealias Alias = Real -> Real, followed
    //     transitively (the 8-step cap is the same one resolveAlias uses in the other
    //     half, and stops a cyclic alias dead)
    // The answer is the name to READ OUT OF THE SCOPE, so every caller that emits a
    // js_scope_get for a supertype must use it rather than the written text.
    // This runs from EMIT thunks only, never during the walk, so classNames /
    // interfaceNames / typeAliases are all complete by the time it is asked.
    function resolvedTypeName(name) {
        var t = baseTypeName(stripWs(name))
        for (var s = 0; s < 8; s++) {
            if (classNames[t] == 1 || interfaceNames["$" + t] == true) { return t }
            if (typeAliases["$" + t] == undefined) { return null }
            t = baseTypeName(typeAliases["$" + t])
        }
        return null
    }
    // True when `name` names a type this compile emits a descriptor for, so its
    // descriptor value can be read out of the scope at run time.
    function knownType(name) { return resolvedTypeName(name) != null }
    // WHICH supertype is the superclass. Kotlin does not require the superclass to come
    // first: `class C : I3, Base2()` lists the interface first and is ordinary code, and
    // taking supers[0] handed the __super slot to I3, dropped Base2's constructor call
    // and left `super.g()` walking an interface. The superclass is the supertype written
    // with a CONSTRUCTOR CALL (`Base2()` has parentheses, `I3` does not); a class that
    // declares only secondary constructors writes no parentheses anywhere, so the
    // fallback is the first supertype that resolves to a class rather than an interface,
    // and only then position. `I by d` is a delegated INTERFACE and never a superclass.
    // Returns an index into supers, or -1.
    function pickSuperIndex(supers) {
        for (var i = 0; i < supers.length; i++) {
            if (supers[i].iscall == true && supers[i].deleg == null) { return i }
        }
        for (var j = 0; j < supers.length; j++) {
            if (supers[j].deleg != null) { continue }
            var r = resolvedTypeName(supers[j].name)
            if (r != null && classNames[r] == 1) { return j }
        }
        return supers.length > 0 ? 0 : -1
    }
    function pickSuper(supers) {
        var k = pickSuperIndex(supers)
        return k < 0 ? null : supers[k]
    }
    // The two halves of the emitSuperName / emitSuperRaw pair: the name the superclass
    // descriptor is BOUND under (null when it cannot be resolved) and the name that was
    // WRITTEN for it (kept even when resolution failed, for the diagnostic).
    function pickSuperName(supers) {
        var p = pickSuper(supers)
        return p == null ? null : resolvedTypeName(p.name)
    }
    function pickSuperRaw(supers) {
        var p = pickSuper(supers)
        return p == null ? null : p.name
    }
    // Link clsV to its supertypes: the SUPERCLASS becomes __super (the chain the runtime
    // walks); every other one is an extra interface whose default methods are copied
    // in (own is not on the chain, so `is` does not see it - see the Supers comment).
    function emitSuperLinks(b, clsV, supers, ownMethods) {
        var pk = pickSuperIndex(supers)
        var pn = pk >= 0 ? resolvedTypeName(supers[pk].name) : null
        if (pn != null) {
            callExt(b, "js_set", [clsV, emitStr(b, "__super"),
                                  callExt(b, "js_scope_get", [curScopeV, emitStr(b, pn)])])
        }
        for (var k = 0; k < supers.length; k++) {
            if (k == pk) { continue }
            // The alias-and-path-reduced name: an interface reached through a typealias
            // or written as a dotted path is still bound under its simple name.
            var kn = resolvedTypeName(supers[k].name)
            if (kn == null) { kn = supers[k].name }
            var sig = interfaceMethods["$" + kn]
            if (sig == undefined) { continue }
            var ifV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, kn)])
            for (var j = 0; j < sig.length; j++) {
                if (ownMethods["$" + sig[j].name] == true) { continue }
                // The member is read off the interface that DECLARES it: an interface
                // that merely EXTENDS another (`interface D : X`) does not own X's
                // methods as properties, so reading them from D answered undefined and
                // the class was left without them.
                var declV = ifV
                if (sig[j].from != undefined && sig[j].from != kn && knownType(sig[j].from)) {
                    declV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, resolvedTypeName(sig[j].from))])
                }
                callExt(b, "js_set", [clsV, emitStr(b, sig[j].name),
                                      callExt(b, "js_get", [declV, emitStr(b, sig[j].name)])])
            }
        }
        return b
    }
    // Interface DELEGATION: `class C(b: I) : I by b` must answer every method of I that
    // C does not define by forwarding to the stored delegate. One forwarder IR function
    // per such method - it reads this.__delegN and re-dispatches through js_mcall, so
    // the delegate's own overrides win, exactly like Kotlin's generated bridges.
    // MEASURED GAP (2026-07-28, found while sweeping the super surface): only METHODS
    // are forwarded. An interface that declares an abstract PROPERTY -
    //     interface I { val h: Int } ; class Impl : I { override val h = 7 }
    //     class C(d: I) : I by d          C(Impl()).h
    // - answers kotlin.Unit here where the interpreter half answers 7. The cause is not
    // this loop: an interface's abstract property is dropped by splitMembers (no
    // initializer, no accessor), so there is no interface-PROPERTY signature table to
    // forward from at all - interfaceMethods holds methods only. Closing it means adding
    // that table, which is a feature rather than a fix, so it is left measured rather
    // than half-done. Unrelated to `super`: it reproduces with no `super` in the program.
    function emitDelegates(b, clsV, supers, ownMethods) {
        for (var k = 0; k < supers.length; k++) {
            if (supers[k].deleg == null) { continue }
            var sig = interfaceMethods["$" + supers[k].name]
            if (sig == undefined) { continue }
            var slot = "__deleg" + k
            for (var j = 0; j < sig.length; j++) {
                if (ownMethods["$" + sig[j].name] == true) { continue }
                var idx = emitForwarder(slot, sig[j].name, sig[j].params)
                callExt(b, "js_set", [clsV, emitStr(b, sig[j].name),
