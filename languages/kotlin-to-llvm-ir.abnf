    // (*arr) pushes each ELEMENT of the array instead of the array itself, which is
    // done with an emitted index loop because the argument array is built at run time.
    emitArgs = function(b, args) {
        var argsV = callExt(b, "js_arr_new", [])
        for (var j = 0; j < args.length; j++) {
            var ar = args[j].at(b)
            b = ar.b
            if (args[j].spread != true) { callExt(b, "js_arr_push", [argsV, ar.v]); continue }
            b = emitSpread(b, argsV, ar.v)
