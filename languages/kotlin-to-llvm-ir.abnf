        return function(b) {
            var rf = fromT(b)
            b = rf.b
            var rt = toT(b)
            b = rt.b
            var modelV = rf.v
            var boundV = callExt(b, "js_char_code", [rt.v])
            if (rop == "until" || rop == "..<") { boundV = callExt(b, "js_sub", [boundV, emitNum(b, 1)]) }
            var stepV = emitNum(b, 1)
            if (stepT != null) {
