    // ----- Parameters, defaults, vararg and named arguments -----
    // A parameter: {name, def, vararg}. The default is an expression thunk emitted
    // INSIDE the callee (so it can read the earlier parameters and `this`), exactly
    // where Kotlin evaluates it.
    function makeParam(items) {
        var rec = {name: null, def: null, vararg: false}
        for (var i = 0; i < items.length; i++) {
            if (items[i].pname != undefined) { rec.name = items[i].pname }
            else if (items[i].pdef != undefined) { rec.def = items[i].pdef }
            else if (items[i].isvararg != undefined) { rec.vararg = true }
        }
        return rec
    }
    // {params: [names], defs: [thunk|null], varargAt: index|-1}. `params` keeps the
    // plain name array every emitter already binds positionally.
    function makeParamList(items) {
        var names = []
        var defs = []
        var varargAt = -1
        for (var i = 0; i < items.length; i++) {
            names.push(items[i].name)
            defs.push(items[i].def)
            if (items[i].vararg) { varargAt = i }
        }
        return {params: names, defs: defs, varargAt: varargAt}
    }
    // Place named arguments into the callee's positional slots. Unnamed arguments fill
    // from the left in order; a named one lands at its parameter's index; a slot no
    // argument reaches stays undefined, which is exactly the signal emitParamSig turns
    // into the declared default. Without a named argument (or without a known callee)
    // the list is returned unchanged, so ordinary calls emit byte-identically.
    function orderArgs(args, names) {
        var named = false
        for (var i = 0; i < args.length; i++) { if (args[i].aname != undefined) { named = true } }
        if (!named) { return args }
        if (names == undefined) { return args }
        var out = []
        var pos = 0
        for (var j = 0; j < args.length; j++) {
            if (args[j].aname == undefined) { out[pos] = args[j]; pos++; continue }
            var slot = -1
            for (var k = 0; k < names.length; k++) { if (names[k] == args[j].aname) { slot = k } }
            if (slot < 0) { out[pos] = args[j]; pos++; continue }
            out[slot] = args[j]
        }
        var n = names.length
        if (out.length > n) { n = out.length }
