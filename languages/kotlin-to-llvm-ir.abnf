    // Append every element of the array srcV to dstV (an emitted counted loop).
    function emitConcatArgs(b, dstV, srcV) { return emitSpread(b, dstV, srcV) }
    // *arr: append every element of arr to the argument array (a counted loop over
    // arr.length, since neither the length nor the elements are known at compile time).
    function emitSpread(b, argsV, arrV) {
        hidCount++
        var iName = "$sp" + hidCount
        var saved = curScopeV
        curScopeV = callExt(b, "js_scope_new", [curScopeV])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, iName), emitNum(b, 0)])
        var headB = curF.NewBlock("")
        var bodyB = curF.NewBlock("")
        var exitB = curF.NewBlock("")
        b.NewBr(headB)
        var iV = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, iName)])
        var lenV = callExt(headB, "js_get", [arrV, emitStr(headB, "length")])
        headB.NewCondBr(truthy(headB, callExt(headB, "js_lt", [iV, lenV])), bodyB, exitB)
        var iV2 = callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, iName)])
        callExt(bodyB, "js_arr_push", [argsV, callExt(bodyB, "js_get", [arrV, iV2])])
        callExt(bodyB, "js_scope_set", [curScopeV, emitStr(bodyB, iName),
                                        callExt(bodyB, "js_jadd", [iV2, emitNum(bodyB, 1)])])
        bodyB.NewBr(headB)
        curScopeV = saved
        return exitB
    }
    // After the declared parameters are bound: collect a vararg parameter's extra
    // arguments into a list, then re-bind every defaulted parameter the caller left
    // out. A slot the call did not reach holds undefined - the one value Kotlin source
    // cannot pass - so testing for it is a sound "argument absent" test.
    function emitParamSig(b, sig, argsV, off) {
        if (sig == undefined || sig == null) { return b }
        if (sig.varargAt >= 0) {
            callExt(b, "js_scope_set", [curScopeV, emitStr(b, sig.params[sig.varargAt]),
