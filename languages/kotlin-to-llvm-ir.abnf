                                  callExt(b, "js_closure", [handle(gi), curScopeV])])
            var si = emitFunc(["__dispatch", "this", "value"], function(bb) {
                callExt(bb, "js_ktdset", [callExt(bb, "js_ktdmemo", [bb.NewCall(rtKtGet(), [curScopeV, emitStr(bb, slot)])]),
                                          bb.NewCall(rtKtGet(), [curScopeV, emitStr(bb, "this")]),
                                          emitStr(bb, nm),
                                          bb.NewCall(rtKtGet(), [curScopeV, emitStr(bb, "value")])])
                bb.NewRet(hUndef)
                return deadBlock()
            }, false, false, undefined, true)
            callExt(b, "js_set", [clsV, emitStr(b, "extset$" + nm),
                                  callExt(b, "js_closure", [handle(si), curScopeV])])
