            b.NewCondBr(isObj, objB, reB)
            objB.NewCondBr(truthy(objB, callExt(objB, "js_seq",
                                                [callExt(objB, "js_get", [mV, emitStr(objB, "__lamret")]),
                                                 emitStr(objB, lbl)])), hitB, reB)
