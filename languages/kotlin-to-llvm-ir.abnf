    function makeCollLit(items) {
        return function(b) {
            var arrV = callExt(b, "js_arr_new", [])
            for (var i = 0; i < items.length; i++) {
                var r = items[i](b)
                b = r.b
                callExt(b, "js_arr_push", [arrV, r.v])
