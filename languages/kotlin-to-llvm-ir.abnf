    // Kotlin generates componentN, equals, toString and copy for a `data class` (and
    // equals/toString for a `value class`). They are emitted as ordinary methods on the
    // descriptor, so p.component2(), p == q, p.toString() and p.copy(y = 9) all travel
    // the normal js_mcall and named-argument paths. Only the PRIMARY CONSTRUCTOR
    // properties take part, exactly as in Kotlin.
    function dataProps(cparams) {
        var props = []
        for (var i = 0; i < cparams.length; i++) { if (cparams[i].prop) { props.push(cparams[i].name) } }
        return props
    }
    // componentN(): read one property of `this`. A factory, so each emitted function
    // captures its OWN property name (a plain loop variable is shared under `var`).
    // System.currentTimeMillis (kind 0) / nanoTime (kind 1) as a function value. A
    // native build reads the wall clock's microseconds with libc's gettimeofday here
    // (the struct's tv_usec is a 32 bit field on Darwin, so only its low half is
    // read); llvm.Run cannot call libc, so it passes undefined and the Go twin reads
    // its own clock. js_ktclock turns the microseconds into the Long.
    var ktGtod = null
    function emitClockFunc(kind) {
        return emitFunc([], function(bb) {
            var usV = hUndef
            if (ktNativeBuild) {
                var tvTy = llvm.types.NewArray(2, i64)
                if (ktGtod == null) {
                    ktGtod = m.NewFunc("gettimeofday", llvm.types.I32,
                                       [llvm.ir.NewParam("", llvm.types.NewPointer(tvTy)),
                                        llvm.ir.NewParam("", llvm.types.I8Ptr)])
