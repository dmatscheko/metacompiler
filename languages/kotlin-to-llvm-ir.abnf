    // A `field` reference inside an accessor body is the backing field of that property;
    // everywhere else `field` is an ordinary name (it is only a soft keyword in Kotlin).
    makeVarRef = function(name) {
        return function(b) {
            // `RegexOption` (its entries are their own names) and `Regex` used as a
            // value, which is only ever its companion - Regex.escape(s) and friends.
            if ((name == "RegexOption" || name == "Regex") && classNames[name] == undefined
                && funNames["$" + name] != true) {
                return {b: b, v: callExt(b, "js_rxktglobal", [emitStr(b, name)])}
            }
            // A property of the ENCLOSING class, read unqualified inside an inner class.
            // The INNER class wins when it declares the same name - Kotlin's shadowing
            // rule, and what recvLookup does in the other half: `inner class In(val tag:
            // String)` inside `class Outer(val tag: String)` read the OUTER `tag` here,
            // which aborted with "member 'tag' of undefined" whenever the inner instance
            // had no __outer (constructed bare inside the outer's own method).
            if (emitOuterProps != null && emitOuterProps["$" + name] == true
                && !(emitClassTop() != null && classOwnProps["$" + emitClassTop()] != undefined
                     && classOwnProps["$" + emitClassTop()]["$" + name] == true)) {
                var itV = b.NewCall(rtKtGet(), [curScopeV, emitStr(b, "this")])
                return {b: b, v: callExt(b, "js_get", [callExt(b, "js_get", [itV, emitStr(b, "__outer")]),
                                                       emitStr(b, name)])}
            }
            if (name == "field" && emitBackingField != null) {
                var thisV = b.NewCall(rtKtGet(), [curScopeV, emitStr(b, "this")])
                return {b: b, v: callExt(b, "js_get", [thisV, emitStr(b, emitBackingField)])}
            }
            return {b: b, v: b.NewCall(rtKtGet(), [curScopeV, emitStr(b, name)])}
        }
    }
    // An EXTENSION property: the getter becomes an IR function with the receiver in the
    // instance slot, bound as "extp$name". Only the getter is modelled (an extension
    // property with a setter would need an lvalue path the subset does not have).
    // Variables holding a lambda WITH RECEIVER (declared type Recv.(A) -> R). Their
    // lambda binds its first argument as `this`, so `40.dot(2)` and `dot(40, 2)` are the
    // same call - Kotlin's rule for a receiver function type.
    var recvLambdaNames = {}
    // Set while such a val/var is walked; the lambda that is its initializer consumes it
    // (the declared type is walked immediately before the initializer).
    var pendingRecvLambda = false
    // Which classes declare a method of a given name, so a name that is BOTH a member
    // method and a receiver-lambda variable can be told apart at run time.
    var methodClasses = {}
    function noteMethodClass(mname, clsName) {
        var l = methodClasses["$" + mname]
        if (l == undefined) { l = []; methodClasses["$" + mname] = l }
        for (var i = 0; i < l.length; i++) { if (l[i] == clsName) { return } }
        l.push(clsName)
    }
    // A function TYPE with a receiver carries `.(` - Recv.(A) -> R, Recv.() -> R - which
    // no other type shape does (a dotted name is followed by an identifier, never `(`).
    function isRecvFnType(t) {
        for (var i = 0; i + 1 < t.length; i++) {
            if (t.charAt(i) == "." && t.charAt(i + 1) == "(") { return true }
        }
        return false
    }
    var extPropNames = {}
    var classPropNames = {}   // Property names some class declares - they win over an extension.
    // Per class, the set of its own property names. An INNER class's members resolve an
    // unqualified name that names a property of the ENCLOSING class against the stored
    // outer receiver, which is how `tag` works inside `inner class Inner` of
    // `class Outer(val tag: String)`. emitOuterProps holds that set while such a class's
    // members are emitted. Limitation: a LOCAL of the same name inside an inner method
    // would also be redirected (locals are not tracked at compile time).
    var classOwnProps = {}
    var emitOuterProps = null
    // The names a top-level extension property declares a SETTER for (a computed
    // `set(v) {...}` or a delegated property's synthesized setValue forwarder).
    var extPropSetNames = {}
    function extPropResolves(name) {
        if (extPropNames["$" + name] != true) { return false }
        if (builtinMethodNames["$" + name] == true) { return false }
        if (classPropNames["$" + name] == true) { return false }
        return true
    }
    function extPropSetResolves(name) {
        return extPropSetNames["$" + name] == true && extPropResolves(name)
    }
    function makeExtProp(items) {
        var rec = makeAccessorProp(items)
        extPropNames["$" + rec.name] = true
        if (rec.setter != null) { extPropSetNames["$" + rec.name] = true }
        return function(b) {
            if (rec.getter != null) {
                var idx = emitFunc([], rec.getter, true)
                callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "extp$" + rec.name),
                                             callExt(b, "js_closure", [handle(idx), curScopeV])])
            }
            // The SETTER was never emitted before, and nothing consulted it: a write
            // through a top-level `var Box.doubled` fell to the plain js_ktset and put
            // an own field on the receiver, so the setter body never ran while the
            // interpreter half ran it. See extPropSetResolves and the field-assign
            // emitter. (dispatchless: args[0] is the receiver, args[1] the value.)
            if (rec.setter != null) {
                var si = emitFunc([rec.setParam], rec.setter, true)
                callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "extps$" + rec.name),
                                             callExt(b, "js_closure", [handle(si), curScopeV])])
            }
            return b
        }
    }
    // An extension DELEGATED property (see ExtDelegProp). One delegate per DECLARATION
    // site: the `by` expression is lowered here, checked with js_ktdcheck exactly as
    // every other delegate is, and parked in the scope under `extd$name`. The accessors
    // are the ordinary extension pair, so nothing downstream needs to know they are
    // delegated. thisRef for provideDelegate is null - the declaration has no receiver.
    function makeExtDelegProp(items, pos) {
        var name = null
        var src = null
        for (var i = 0; i < items.length; i++) {
            if (items[i] == undefined || items[i] == null) { continue }
            if (items[i].apname != undefined) { name = items[i].apname }
            else if (items[i].dsrc != undefined) { src = items[i].dsrc }
        }
        extPropNames["$" + name] = true
        extPropSetNames["$" + name] = true
        var where = c.file + ":" + c.lineOf(pos)
        var slot = "extd$" + name
        return function(b) {
            if (src == null) { return b }
            var r = src(b)
            b = r.b
            var dV = callExt(b, "js_ktdcheck", [r.v, emitStr(b, where),
                                                c.warnUnsupported ? hTrue : hFalse,
                                                hNull, emitStr(b, name)])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, slot), dV])
            var gi = emitFunc([], function(bb) {
                bb.NewRet(callExt(bb, "js_ktdget", [bb.NewCall(rtKtGet(), [curScopeV, emitStr(bb, slot)]),
                                                    bb.NewCall(rtKtGet(), [curScopeV, emitStr(bb, "this")]),
                                                    emitStr(bb, name)]))
                return deadBlock()
            }, true)
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "extp$" + name),
                                         callExt(b, "js_closure", [handle(gi), curScopeV])])
            var si = emitFunc(["value"], function(bb) {
                callExt(bb, "js_ktdset", [bb.NewCall(rtKtGet(), [curScopeV, emitStr(bb, slot)]),
                                          bb.NewCall(rtKtGet(), [curScopeV, emitStr(bb, "this")]),
                                          emitStr(bb, name),
                                          bb.NewCall(rtKtGet(), [curScopeV, emitStr(bb, "value")])])
                bb.NewRet(hUndef)
                return deadBlock()
            }, true)
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "extps$" + name),
                                         callExt(b, "js_closure", [handle(si), curScopeV])])
            return b
        }
    }
    // A top-level computed property: the getter runs once, at the declaration.
    function makeTopAccProp(items) {
        var rec = makeAccessorProp(items)
        return function(b) {
            if (rec.getter == null) {
                callExt(b, "js_scope_decl", [curScopeV, emitStr(b, rec.name), hUndef])
                return b
            }
            var cl = callExt(b, "js_closure", [handle(emitFunc([], rec.getter, false)), curScopeV])
            var v = callExt(b, "js_call", [cl, hUndef, callExt(b, "js_arr_new", [])])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, rec.name), v])
            return b
        }
    }

    // ----- data / value class: the synthesized members -----
    // Kotlin generates componentN, equals, toString and copy for a `data class` (and
    // equals/toString for a `value class`). They are emitted as ordinary methods on the
    // descriptor, so p.component2(), p == q, p.toString() and p.copy(y = 9) all travel
    // the normal js_mcall and named-argument paths. Only the PRIMARY CONSTRUCTOR
    // properties take part, exactly as in Kotlin.
    function dataProps(cparams) {
        var props = []
        for (var i = 0; i < cparams.length; i++) { if (cparams[i].prop) { props.push(cparams[i].name) } }
        return props
    }
    // componentN(): read one property of `this`. A factory, so each emitted function
    // captures its OWN property name (a plain loop variable is shared under `var`).
    function emitComponentFunc(prop) {
        return emitFunc([], function(bb) {
            var thisV = callExt(bb, "js_scope_get", [curScopeV, emitStr(bb, "this")])
            bb.NewRet(callExt(bb, "js_get", [thisV, emitStr(bb, prop)]))
            return deadBlock()
        }, true)
    }
    // equals(other): the same class (js_is_type walks the __super chain) and every
    // property structurally equal (js_kteq, folded with the boolean js_jband).
    // js_kteq and not js_seq: a property holding a LIST or a MAP compares
    // element-wise, and a property holding another data instance goes through that
    // class's own equals - `data class D(val a: Int, val b: List<Int>)` compared
    // FALSE against an equal copy while the interpreter half said true.
    function emitEqualsFunc(name, props) {
        return emitFunc(["other"], function(bb) {
            var thisV = callExt(bb, "js_scope_get", [curScopeV, emitStr(bb, "this")])
            var otherV = callExt(bb, "js_scope_get", [curScopeV, emitStr(bb, "other")])
            var cmpB = curF.NewBlock("")
            var noB = curF.NewBlock("")
            bb.NewCondBr(truthy(bb, callExt(bb, "js_is_type", [otherV, emitStr(bb, name)])), cmpB, noB)
            var acc = anytype
            for (var k = 0; k < props.length; k++) {
                var eq = callExt(cmpB, "js_kteq", [callExt(cmpB, "js_get", [thisV, emitStr(cmpB, props[k])]),
                                                  callExt(cmpB, "js_get", [otherV, emitStr(cmpB, props[k])])])
                acc = (k == 0) ? eq : callExt(cmpB, "js_jband", [acc, eq])
            }
            cmpB.NewRet(acc)
            noB.NewRet(hFalse)
            return deadBlock()
        }, true)
    }
    // toString(): Kotlin's data-class rendering, Name(p1=v1, p2=v2).
    function emitToStringFunc(name, props) {
        return emitFunc([], function(bb) {
            var thisV = callExt(bb, "js_scope_get", [curScopeV, emitStr(bb, "this")])
            var v = emitStr(bb, name + "(")
            for (var k = 0; k < props.length; k++) {
                var lead = (k == 0) ? (props[k] + "=") : (", " + props[k] + "=")
                v = callExt(bb, "js_jadd", [v, emitStr(bb, lead)])
                // js_ktstr, not the concat's own ToString: a property holding a list
                // renders "[1, 2]" here, exactly as the interpreter's dataToString
                // (which folds with kstr2) renders it.
                v = callExt(bb, "js_jadd", [v, callExt(bb, "js_ktstr",
                                                       [callExt(bb, "js_get", [thisV, emitStr(bb, props[k])])])])
            }
            bb.NewRet(callExt(bb, "js_jadd", [v, emitStr(bb, ")")]))
            return deadBlock()
        }, true)
    }
    // copy(p1 = ..., p2 = ...): a fresh instance of the same class. Each parameter
    // defaults to the current property of `this` - a slot the call did not reach arrives
    // as undefined, so the select picks this.p there. Named arguments get it to the
    // right slot (methodParams registers the property names for "copy").
    function emitCopyFunc(clsName, props) {
        return emitFunc(props, function(bb) {
            var thisV = callExt(bb, "js_scope_get", [curScopeV, emitStr(bb, "this")])
            var clsV2 = callExt(bb, "js_scope_get", [curScopeV, emitStr(bb, clsName)])
            var objV = callExt(bb, "js_obj_new", [])
            callExt(bb, "js_set", [objV, emitStr(bb, "__class"), clsV2])
            var argsV = callExt(bb, "js_arr_new", [])
            callExt(bb, "js_arr_push", [argsV, objV])
            for (var k = 0; k < props.length; k++) {
                var pv = callExt(bb, "js_scope_get", [curScopeV, emitStr(bb, props[k])])
                var absent = truthy(bb, callExt(bb, "js_seq", [pv, hUndef]))
                var own = callExt(bb, "js_get", [thisV, emitStr(bb, props[k])])
                callExt(bb, "js_arr_push", [argsV, bb.NewSelect(absent, own, pv)])
            }
            callExt(bb, "js_call", [callExt(bb, "js_get", [clsV2, emitStr(bb, "__ctor")]), hUndef, argsV])
            bb.NewRet(objV)
            return deadBlock()
        }, true)
