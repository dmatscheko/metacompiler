    function makeTryValue(items) {
        var p = tryParts(items)
        return function(b) { return emitTry(b, p) }
    }
    // throw e: evaluate e and raise it with js_throw (a Go panic the runtime unwinds).
    function makeThrow(e) {
        return function(b) {
            var r = e(b)
