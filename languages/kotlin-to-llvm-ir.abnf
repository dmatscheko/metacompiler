        var name = items[0]
        var hdr = takeHeader(items, 1)
        var parts = splitMembers(items, hdr.i)
        var props = parts.props
        var methods = parts.methods
        classNames[name] = 2   // A singleton: named like a class, but never constructed.
        lastDeclaredType = name
        noteDecl(name, hdr.supers)
            // noteParams as well as the name, so orderArgs has the parameter list for
            // a NAMED argument to an object's method (`R.f(c = 9)`). The
            // declOpIfConvention call is the class emitter's, for the same reason: an
            // operator convention declared on an object counts.
        for (var om = 0; om < methods.length; om++) {
            classMethodNames["$" + methods[om].name] = true
            noteParams(methods[om].name, methods[om].params)
            declOpIfConvention(methods[om].name, name)
        }
        return function(b) {
            var r = emitObjectInstance(b, name, methods, props, hdr.supers, parts.accprops, parts.memberExts, parts.memberExtProps, parts.memberExtDelegs)
            b = r.b
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, name), r.v])
            // A nested type of an object hangs on the object's DESCRIPTOR, not on the
            // singleton instance: the runtime's memberCall looks a call up the __class
            // chain (which is how Outer.Nested(1) reaches the factory), and js_get on
            // an instance falls through to the same chain for a plain read.
            b = emitNestedList(b, r.cls, r.v, parts.nested, name)
            return b
        }
    }
    // interface I [: Supers] { defaults }: a descriptor with the default-method closures
    // and no __ctor. Its signature list feeds interface delegation.
    function makeInterfaceStmt(items) {
        var at = 0
        var samfun = false
        if (items[at] != undefined && items[at].samfun != undefined) { samfun = true; at++ }
        var name = items[at]
        var hdr = takeHeader(items, at + 1)
        var parts = splitMembers(items, hdr.i)
        var methods = parts.methods
        interfaceNames["$" + name] = true
        lastDeclaredType = name
        noteDecl(name, hdr.supers)
        var sig = []
        // `from` is the interface that DECLARES the member, which is not always the one
        // a class names as its supertype (see the inheritance loop below): the copy in
        // emitSuperLinks has to read the method off the declaring descriptor.
        for (var i = 0; i < methods.length; i++) {
            sig.push({name: methods[i].name, params: methods[i].params, from: name})
            classMethodNames["$" + methods[i].name] = true
        }
        for (var a = 0; a < parts.abstracts.length; a++) {
            sig.push({name: parts.abstracts[a].name, params: parts.abstracts[a].params, from: name})
            classMethodNames["$" + parts.abstracts[a].name] = true
        }
        // An interface INHERITS its own supertypes' members, and emitSuperLinks copies
        // a signature list into the implementing class - so `interface D : X` with an
        // empty body must still give `class C : A, D` X's defaults. Only the FIRST
        // supertype gets the __super link a lookup can follow, which is why the second
        // one has to carry the full list. The walk is a static pass in file order, so a
        // supertype declared LATER in the file contributes nothing here - the same
        // limitation knownType() has.
        for (var si = 0; si < hdr.supers.length; si++) {
            var psig = interfaceMethods["$" + hdr.supers[si].name]
            if (psig == undefined) { continue }
            for (var pj = 0; pj < psig.length; pj++) {
                var dup = false
                for (var dj = 0; dj < sig.length; dj++) {
                    if (sig[dj].name == psig[pj].name) { dup = true }
                }
                if (!dup) { sig.push({name: psig[pj].name, params: psig[pj].params,
                                      from: psig[pj].from != undefined ? psig[pj].from : hdr.supers[si].name}) }
            }
        }
        interfaceMethods["$" + name] = sig
        // The SAM is installed only for a `fun interface` whose body declares exactly
        // one abstract member - the same test buildInterface makes in the other half.
        if (samfun && parts.abstracts.length == 1) { samNames["$" + name] = parts.abstracts[0].name }
        var own = {}
        for (var o = 0; o < methods.length; o++) { own["$" + methods[o].name] = true }
        return function(b) {
            var clsV = callExt(b, "js_obj_new", [])
            callExt(b, "js_set", [clsV, emitStr(b, "__isclass"), hTrue])
            callExt(b, "js_set", [clsV, emitStr(b, "__name"), emitStr(b, name)])
            emitBinName(b, clsV, name)
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, name), clsV])
            b = emitSuperLinks(b, clsV, hdr.supers, own)
            var savedSuper = emitSuperName
            var savedSuperRaw = emitSuperRaw
            emitClassNames.push(name)
            emitSuperName = pickSuperName(hdr.supers)
            emitSuperRaw = pickSuperRaw(hdr.supers)
            for (var k = 0; k < methods.length; k++) {
                var idx = emitFunc(methods[k].params, methods[k].body, true, false, methods[k].sig)
                callExt(b, "js_set", [clsV, emitStr(b, methods[k].name), callExt(b, "js_closure", [handle(idx), curScopeV])])
            }
            for (var ap = 0; ap < parts.accprops.length; ap++) { b = emitAccessorPair(b, clsV, parts.accprops[ap]) }
            b = emitMemberExts(b, clsV, parts.memberExts)
            b = emitMemberExtProps(b, clsV, parts.memberExtProps)
            b = emitMemberExtDelegs(b, clsV, parts.memberExtDelegs)
            emitClassNames.pop()
            emitSuperName = savedSuper
            emitSuperRaw = savedSuperRaw
            b = emitNestedList(b, clsV, null, parts.nested, name)
            return b
        }
    }
    // super.m(args): js_supercall walks the __super chain from the DEFINING class's
    // superclass descriptor (emitSuperName, valid while that class's methods emit).
    // `super<I>` - the token run of SkipAngle1 without its angle brackets, reduced to
    // the base type name (`<Map<K, V>>` names Map).
    function superQualName(raw) {
        var t = stripWs(raw)
        if (t.length > 1 && t.charAt(0) == "<") { t = t.substring(1, t.length - 1) }
        return baseTypeName(t)
    }
    // Which descriptor a `super` reference walks from: the qualifier when one is
    // written and names a type this compile emits, otherwise the defining class's
    // superclass (emitSuperName). Both go through resolvedTypeName, so a supertype
    // named through a typealias or a dotted path answers the name its descriptor is
    // actually bound under. null when neither is available.
    function superTargetName(qual) {
        if (qual != null) {
            var q = resolvedTypeName(qual)
            if (q != null) { return q }
        }
        return emitSuperName
    }
    // What a failed `super` reference could not resolve: the class HAS a superclass
    // that the compiler could not find, so the message names the supertype.
    // True when the supertype a `super` names came from an import this run could not
    // resolve. See the imports section: that is a different class of failure from a
    // supertype this compiler simply failed to resolve, and only this one degrades.
    function superExternal(qual) {
        var raw = (qual != null) ? qual : emitSuperRaw
        if (raw == null) { return false }
        return externalType(baseTypeName(stripWs(raw)))
    }
    function superFailWhat(qual) {
        if (qual != null) { return "unresolved supertype '" + qual + "'" }
        if (emitSuperRaw != null) { return "unresolved supertype '" + emitSuperRaw + "'" }
        return "no superclass declared"
    }
    function makeSuperCall(items, pos) {
        var qual = null
        var at = 0
        if (items[at] != undefined && items[at] != null && items[at].squal != undefined) {
            qual = items[at].squal
            at++
        }
        var mname = items[at].smname
        var args = items.slice(at + 1)
        return function(b) {
            var target = superTargetName(qual)
            if (target == null) {
                // A supertype that came from an import this run could not resolve is not
                // a gap in this compiler - there is no such class anywhere - so the call
                // degrades to Unit and the override's own body still runs. Arguments are
                // still evaluated, for their side effects.
                if (superExternal(qual)) { var xa = emitArgs(b, args); return {b: xa.b, v: hUndef} }
                notImpl("super call (" + superFailWhat(qual) + ")", pos)
                return {b: b, v: hUndef}
            }
            var supV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, target)])
            var thisV = b.NewCall(rtKtGet(), [curScopeV, emitStr(b, "this")])
            var ea = emitArgs(b, args)
            b = ea.b
            return {b: b, v: callExt(b, "js_supercall", [supV, thisV, emitStr(b, mname), ea.v])}
