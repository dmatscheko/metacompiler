    // site: the `by` expression is lowered here, checked with js_ktdcheck exactly as
    // every other delegate is, and parked in the scope under `extd$name`. The accessors
    // are the ordinary extension pair, so nothing downstream needs to know they are
    // delegated. thisRef for provideDelegate is null - the declaration has no receiver.
    function makeExtDelegProp(items, pos) {
        var name = null
        var src = null
        for (var i = 0; i < items.length; i++) {
            if (items[i] == undefined || items[i] == null) { continue }
            if (items[i].apname != undefined) { name = items[i].apname }
            else if (items[i].dsrc != undefined) { src = items[i].dsrc }
        }
        extPropNames["$" + name] = true
        extPropSetNames["$" + name] = true
        var where = c.file + ":" + c.lineOf(pos)
        var slot = "extd$" + name
        return function(b) {
            if (src == null) { return b }
            var r = src(b)
            b = r.b
            var dV = callExt(b, "js_ktdcheck", [r.v, emitStr(b, where),
                                                c.warnUnsupported ? hTrue : hFalse,
                                                hNull, emitStr(b, name)])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, slot), dV])
            var gi = emitFunc([], function(bb) {
                bb.NewRet(callExt(bb, "js_ktdget", [bb.NewCall(rtKtGet(), [curScopeV, emitStr(bb, slot)]),
                                                    bb.NewCall(rtKtGet(), [curScopeV, emitStr(bb, "this")]),
                                                    emitStr(bb, name)]))
                return deadBlock()
            }, true)
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "extp$" + name),
                                         callExt(b, "js_closure", [handle(gi), curScopeV])])
            var si = emitFunc(["value"], function(bb) {
                callExt(bb, "js_ktdset", [bb.NewCall(rtKtGet(), [curScopeV, emitStr(bb, slot)]),
                                          bb.NewCall(rtKtGet(), [curScopeV, emitStr(bb, "this")]),
                                          emitStr(bb, name),
                                          bb.NewCall(rtKtGet(), [curScopeV, emitStr(bb, "value")])])
                bb.NewRet(hUndef)
                return deadBlock()
            }, true)
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "extps$" + name),
