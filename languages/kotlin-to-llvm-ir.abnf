    function emitDelegPair(b, clsV, rec) {
        var fld = delegField(rec.name)
        var nm = rec.name
        var getIdx = emitFunc([], function(bb) {
            var thisV = callExt(bb, "js_scope_get", [curScopeV, emitStr(bb, "this")])
            bb.NewRet(callExt(bb, "js_ktdget", [callExt(bb, "js_get", [thisV, emitStr(bb, fld)]),
                                                thisV, emitStr(bb, nm)]))
            return deadBlock()
        }, false, false, undefined, true)
        var setIdx = emitFunc(["value"], function(bb) {
            var thisV = callExt(bb, "js_scope_get", [curScopeV, emitStr(bb, "this")])
            callExt(bb, "js_ktdset", [callExt(bb, "js_get", [thisV, emitStr(bb, fld)]), thisV,
                                      emitStr(bb, nm),
                                      callExt(bb, "js_scope_get", [curScopeV, emitStr(bb, "value")])])
            bb.NewRet(hUndef)
            return deadBlock()
        }, false, false, undefined, true)
        callExt(b, "js_defprop", [clsV, emitStr(b, nm),
                                  callExt(b, "js_closure", [handle(getIdx), curScopeV]),
                                  callExt(b, "js_closure", [handle(setIdx), curScopeV])])
        return b
    }
    // A LOCAL or top-level `val/var x by d`: bind the box. items = [name, {dsrc}, ...].
    function makeDelegDecl(items, pos) {
        var name = items[0]
        var src = null
        for (var i = 1; i < items.length; i++) {
            if (items[i] != undefined && items[i] != null && items[i].dsrc != undefined) { src = items[i].dsrc }
        }
        var where = c.file + ":" + c.lineOf(pos)
        return function(b) {
            var r = src(b)
            b = r.b
            var dV = callExt(b, "js_ktdcheck", [r.v, emitStr(b, where),
                                                c.warnUnsupported ? hTrue : hFalse,
                                                hNull, emitStr(b, name)])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, name),
                                         callExt(b, "js_ktdbox", [dV, emitStr(b, name)])])
