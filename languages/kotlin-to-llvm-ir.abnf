            var hitB = curF.NewBlock("")
            var stepB = curF.NewBlock("")
            bodyB.NewCondBr(truthy(bodyB, callExt(bodyB, "js_sne", [mV, hUndef])), hitB, stepB)
            hitB.NewRet(mV)
            callExt(stepB, "js_scope_set", [sc, emitStr(stepB, "c"),
                stepB.NewCall(rtSafeGet(), [cV, emitStr(stepB, "__super")])])
            stepB.NewBr(headB)
            missB.NewRet(hUndef)
        })
    }
    // kt_mextcall / kt_mextget / kt_mextset are Kotlin's MEMBER EXTENSIONS: a
    // function or property declared inside a class whose `this` is the EXTENSION
    // receiver while the enclosing instance rides along as the DISPATCH receiver.
    // Which instance is enclosing is a RUN-TIME question - the emitter only knows
    // that some class declares the name - so resolving it means walking the frame's
    // `this` and `__dispatch` bindings and their __class / __outer graphs.
    //
    // THAT WALK IS THE EXTERN'S: emitted IR could reach only the INNERMOST `this`
    // and the INNERMOST `__dispatch`, because it has no scope-parent extern.
    // languages/lib/kotlin-rt.metajs's k6MextFind walks EVERY frame with
    // scopeHas/scopeParent and then the implicit-receiver stack, so
    // `with(Other(9)) { 2.tripled() }` inside a member of A resolves natively; under
    // llvm.Run the Go twin's ktMemberExtFind decides. See k6MextFind's header for the
    // one engine still short.
    function rtMextCall() {
        return rtFunc("kt_mextcall", 4, function(b, ps) {
            b.NewRet(callExt(b, "js_ktmextcall", [ps[0], ps[1], ps[2], ps[3]]))
        })
    }
    function rtMextGet() {
        return rtFunc("kt_mextget", 3, function(b, ps) {
            b.NewRet(callExt(b, "js_ktmextget", [ps[0], ps[1], ps[2]]))
        })
    }
    function rtMextSet() {
        return rtFunc("kt_mextset", 4, function(b, ps) {
            b.NewRet(callExt(b, "js_ktmextset", [ps[0], ps[1], ps[2], ps[3]]))
        })
    }
    // ktTypeNames, copied from abnf/jsrtkotlin.go (whose list is shared with kTypeNames
    // in kotlin-interpreter.abnf; the copies must stay in step - this one is here
    // because the emitter makes the decision statically). A `::` in front of one of
    // these is an UNBOUND reference, and that arm runs BEFORE the scope walk, so a
    // same-named builder in scope must not win.
    var ktTypeNameSet = {}
    var ktTypeNameList = ["String", "CharSequence", "Int", "Long", "Short", "Byte",
        "UInt", "ULong", "UShort", "UByte", "Double", "Float", "Boolean", "Char",
        "Any", "Unit", "Number", "Nothing", "List", "MutableList", "Set",
        "MutableSet", "Map", "MutableMap", "Array", "Collection", "Iterable",
        "Comparable", "IntRange", "CharRange", "LongRange", "Regex", "StringBuilder"]
    for (var ktTNI = 0; ktTNI < ktTypeNameList.length; ktTNI++) { ktTypeNameSet["$" + ktTypeNameList[ktTNI]] = true }
    // ----- the four scope-taking helpers that are PURE EXTERN CALLS -----
    //
    // kt_refbase, kt_outer, kt_bareref and kt_dthis need the whole scope chain, which
    // only languages/lib/kotlin-rt.metajs SECTION 6 can walk (the scopeHas /
    // scopeParent / scopeGet host builtins are reachable from a MetaJS SOURCE FILE, and
    // the extern set an emitter may call - js_scope_{new,get,set,set_or_create,decl,has,
    // typeof} - has no js_scope_parent). So the exact answer is one extern call away in
    // the native build, and the Go twin decides under llvm.Run.
    //
    // kt_refbase(env, name) is js_ktrefbase MINUS its ktTypeNames arm, which the
    // emitter still decides statically at the call site (the base name is a literal
    // there, and the extern's type arm runs BEFORE its scope walk, so it cannot be
    // lowered under one). makeQualRef is that decision.
    function rtRefBase() {
        return rtFunc("kt_refbase", 2, function(b, ps) {
            b.NewRet(callExt(b, "js_ktrefbase", [ps[0], ps[1], hFalse]))
        })
    }
    // kt_outer(env, name) is js_ktouter: `this@Outer`. The extern walks the scope chain
    // for a `this` whose own __class / __super chain declares the name, which is the
    // test Kotlin actually asks (the innermost instance's __outer chain gives the same
    // answer only when the qualified receiver is an enclosing INSTANCE).
    function rtOuter() {
        return rtFunc("kt_outer", 2, function(b, ps) {
            b.NewRet(callExt(b, "js_ktouter", [ps[0], ps[1]]))
        })
    }
    // kt_bareref(env, name) is js_ktbareref: a bare `::name`.
    function rtBareRef() {
        return rtFunc("kt_bareref", 2, function(b, ps) {
            b.NewRet(callExt(b, "js_ktbareref", [ps[0], ps[1]]))
        })
    }
    // kt_dthis(env) is js_ktdthis: the thisRef a delegated property is declared
    // against, the FIRST `this` up the chain.
    function rtDThis() {
        return rtFunc("kt_dthis", 1, function(b, ps) {
            b.NewRet(callExt(b, "js_ktdthis", [ps[0]]))
        })
    }
    // kt_kset(env, name, v) is abnf/jsrt.go's js_kset. ONLY THE INNERMOST BINDING
    // STAYS LOWERED, and that split is deliberate: a write to a local is the hot arm
    // and js_scope_typeof reaches it from emitted IR at two extern calls, while
    // everything past it - the `this` chain, the accessor pairs on the descriptor,
    // the implicit-receiver stack - is a chain walk that only layer 2 can do. In
    // MetaJS a call is a scope frame (docs/working-on-this-project.md 5.1), so the
    // arm that runs every iteration of a loop is the one worth keeping here.
    //
    // A slot HOLDING undefined reads "undefined" to js_scope_typeof, takes the miss
    // arm, and js_kset's scopeHas walk finds the binding it really is.
    function rtKSet() {
        return rtFunc("kt_kset", 3, function(b, ps) {
            var localB = curF.NewBlock("")
            var missB = curF.NewBlock("")
            var t = callExt(b, "js_scope_typeof", [ps[0], ps[1]])
            b.NewCondBr(truthy(b, callExt(b, "js_seq", [t, emitStr(b, "undefined")])), missB, localB)
            callExt(localB, "js_scope_set", [ps[0], ps[1], ps[2]])
            localB.NewRet(handle(0))
            missB.NewRet(callExt(missB, "js_kset", [ps[0], ps[1], ps[2]]))
        })
    }
    // kt_varset(env, name, v) is js_ktvarset: kt_kset made DELEGATE-aware. A binding
    // holding a delegate box is WRITTEN through its setValue (js_ktdset), which is an
    // ordinary extern over an ordinary object, so the hot local arm keeps both the
    // plain write and the delegate write. The `this`, accessor, __dispatch and
    // receiver-stack arms are the extern's.
    function rtVarSet() {
        return rtFunc("kt_varset", 3, function(b, ps) {
            var boxB = curF.NewBlock("")
            var plainB = curF.NewBlock("")
            var missB = curF.NewBlock("")
            var localB = curF.NewBlock("")
            var t = callExt(b, "js_scope_typeof", [ps[0], ps[1]])
            b.NewCondBr(truthy(b, callExt(b, "js_seq", [t, emitStr(b, "undefined")])), missB, localB)
            var curV = callExt(localB, "js_scope_get", [ps[0], ps[1]])
            var mark = localB.NewCall(rtSafeGet(), [curV, emitStr(localB, "__pdeleg")])
            localB.NewCondBr(truthy(localB, mark), boxB, plainB)
            callExt(boxB, "js_ktdset", [callExt(boxB, "js_get", [curV, emitStr(boxB, "d")]),
                callExt(boxB, "js_get", [curV, emitStr(boxB, "owner")]),
                callExt(boxB, "js_get", [curV, emitStr(boxB, "pname")]), ps[2]])
            boxB.NewRet(handle(0))
            callExt(plainB, "js_scope_set", [ps[0], ps[1], ps[2]])
            plainB.NewRet(handle(0))
            missB.NewRet(callExt(missB, "js_ktvarset", [ps[0], ps[1], ps[2]]))
        })
    }

    // Is this a NATIVE build? The one thing layer 2 cannot recover for itself is an
    // argument COUNT, so the emitter supplies it - see the println() branch in
    // makeCall. Under llvm.Run the Go twin gets a real []interface{} and needs no
    // help, and gating on -exe keeps the non-native module byte-identical.
    var ktNativeBuild = (c.exePath != undefined && c.exePath != "")
    var hidCount = 0     // Names hidden loop counters.
    var classNames = {}  // Known class names (constructor calls).
    var interfaceNames = {}   // Known interface names ("$" prefixed): descriptors without a __ctor.
    // `fun interface` name -> its single abstract member's name. Filled while the
    // interface is walked; read at EMISSION time by makeCall, so an interface declared
    // after the conversion site is still seen.
    var samNames = {}
    // Every interface's method signature list [{name, params}], collected while the
    // interface is walked. Interface DELEGATION (`class C(b: I) : I by b`) synthesizes
    // one forwarder per entry the class does not override, so the arity has to be known.
    var interfaceMethods = {}
    // Names bound to a FUNCTION value (top-level and local fun declarations, extension
    // functions). A bare call whose name is not one of these but IS a member method name
    // is an implicit this.m() - Kotlin's ordinary way of calling an own or inherited
    // method - and is dispatched through js_mcall on `this` (see makeCall).
    var funNames = {}
    // Parameter NAME lists by callee name, so a call site can place its named
    // arguments: functions (and lambdas' owners) in funParams, member methods in
    // methodParams. A method name declared by two classes keeps the LAST list here;
    // every list is also kept in methodParamAlts, and paramsFor picks the one that
    // carries the call site's named arguments (see the note there).
    var funParams = {}
    var methodParams = {}
    var ctorParamNames = {}   // Primary-constructor parameter names, for named arguments.
    // The superclass name of the class whose METHOD BODIES are currently being emitted.
    // super.m() reads it (emission of a class's methods happens inside makeClassStmt's
    // thunk, so a dynamic variable is exactly the right scope); null outside a class.
    var emitSuperName = null
    // What was WRITTEN for that superclass, resolved or not, so a super reference that
    // cannot be resolved can NAME the supertype it failed on instead of claiming there
    // is no subclass. Saved and restored in lockstep with emitSuperName.
    var emitSuperRaw = null

    // ----- Extension functions: the receiver becomes `this` -----
    // Method names the runtime implements on strings/lists/dicts (the interpreter
    // grammar uses the same list): an extension never shadows them on a builtin
    // receiver, so both engines make the same dispatch decision for every
    // (receiver, name).
    var extFunNames = {}
    // Every receiver type an extension name is declared for (ktExtRecvTy), one entry
    // per type, latest last.
    var extRecvTys = {}
    var classMethodNames = {}
    var builtinMethodNames = {}
    var bmn = ["length", "charAt", "equals", "substring", "indexOf", "isEmpty",
               "keys", "values", "get", "add", "append", "pop", "removeLast", "size",
               "contains", "map", "filter", "sumOf", "forEach", "count", "any"]
    for (var bi = 0; bi < bmn.length; bi++) { builtinMethodNames["$" + bmn[bi]] = true }
    function extResolves(name) {
        if (extFunNames["$" + name] != true) { return false }
        if (builtinMethodNames["$" + name] == true) { return false }
        if (classMethodNames["$" + name] == true) { return false }
        return true
    }
    // The scope name an extension is declared under besides ext$name: one per tested
    // receiver type, and one shared by every untested one (ktExtTested).
    function extKey(name, ty) { return "ext$" + name + "$" + (ktExtTested(ty) ? ty : "*") }
    // recv.name(args) as a call of the extension declared under `key`, the receiver
    // prepended (it may be null for a nullable-receiver extension).
    function emitExtCall(b, cur, s, key) {
        var efV = b.NewCall(rtKtGet(), [curScopeV, emitStr(b, key)])
        var eargsV = callExt(b, "js_arr_new", [])
        callExt(b, "js_arr_push", [eargsV, cur])
        var eargs = orderArgs(s.args, funParams["$" + s.name])
        for (var ej = 0; ej < eargs.length; ej++) {
            var er = eargs[ej].at(b)
            b = er.b
            if (eargs[ej].spread != true) { callExt(b, "js_arr_push", [eargsV, er.v]); continue }
            b = emitSpread(b, eargsV, er.v)
        }
        // A REIFIED type parameter of an extension called in method position
        // - `inline fun <reified T> Any.isA() = this is T`, then
        // `"x".isA<String>()`. makeCall appends the type names for the plain
        // call form; this is the same convention for the method-suffix form:
        // one trailing string per reified parameter, in declaration order.
        var exr = reifiedExtra(s.name, s.targ)
        for (var xi = 0; xi < exr.length; xi++) {
            callExt(b, "js_arr_push", [eargsV, emitStr(b, exr[xi])])
        }
        return {b: b, v: callExt(b, "js_call", [efV, hUndef, eargsV])}
    }
    // The extension chain of recv.name(...): each TESTED receiver type (ktExtTested),
    // latest declaration first, taken when the receiver has that type and no member of
    // the name (js_ktextok - a member always wins), then the latest untested
    // extension when the name resolves to one (extResolves), else the member surface,
    // which fallback(b) emits. Twin of extFor in kotlin-interpreter.abnf.
    function emitExtChain(b, cur, s, fallback) {
        var xl = extRecvTys["$" + s.name]
        var xany = false
        var xtested = 0
        for (var xu = 0; xu < xl.length; xu++) {
            if (ktExtTested(xl[xu])) { xtested++ } else { xany = true }
        }
        var untested = xany && extResolves(s.name)
        if (xtested == 0) { return untested ? emitExtCall(b, cur, s, extKey(s.name, "")) : fallback(b) }
        var bi = builtinMethodNames["$" + s.name] == true ? hTrue : hFalse
        var xm = curF.NewBlock("")
        var xin = []
        for (var xt = xl.length - 1; xt >= 0; xt--) {
            if (!ktExtTested(xl[xt])) { continue }
            var xyB = curF.NewBlock("")
            var xnB = curF.NewBlock("")
            b.NewCondBr(truthy(b, callExt(b, "js_ktextok", [cur, emitStr(b, xl[xt]), emitStr(b, s.name), bi])), xyB, xnB)
            var xr = emitExtCall(xyB, cur, s, extKey(s.name, xl[xt]))
            xr.b.NewBr(xm)
            xin.push(llvm.ir.NewIncoming(xr.v, xr.b))
            b = xnB
        }
        var xf = untested ? emitExtCall(b, cur, s, extKey(s.name, "")) : fallback(b)
        xf.b.NewBr(xm)
        xin.push(llvm.ir.NewIncoming(xf.v, xf.b))
        return {b: xm, v: xm.NewPhi(xin)}
    }

    // ----- explicit TYPE ARGUMENTS on a method call -----
    // The methods whose type argument is part of the call's MEANING. For these the type
    // name is appended as a trailing string argument; for every other method the
    // captured list is dropped.
    var mcallTArgMethods = {"$filterIsInstance": true}
    // MethodSfx's item list holds the method name, the (optional) type-argument text and
    // the arguments. The shared popName lifts only the name, and a `{mtargs}` item left
    // among the arguments would be read as one - so this is popName with the type-
    // argument case added, local to Kotlin.
    function popMCall() {
        var items = takeAll()
        var name = ""
        var targ = ""
        for (var i = 0; i < items.length; i++) {
            if (items[i] != undefined && items[i] != null && items[i].mname != undefined) { name = items[i].mname }
            else if (items[i] != undefined && items[i] != null && items[i].mtargs != undefined) { targ = items[i].mtargs }
            else { push(items[i]) }
        }
        return {name: name, targ: targ}
    }
    // "<String>" / "< String , Int >" -> "String": the FIRST type argument, whitespace
    // stripped. Only the first is used; no builtin here takes two.
    function tArgName(t) {
        var s = stripWs(t)
        if (s.length < 3) { return "" }
        s = s.substring(1, s.length - 1)
        var cut = s.indexOf(",")
        if (cut >= 0) { s = s.substring(0, cut) }
        return s
    }
    // The trailing string arguments a callee's REIFIED type parameters want, in
    // declaration order. A callee with none contributes nothing, so the emitted IR of a
    // program that declares no reified function is unchanged.
    function reifiedExtra(name, targText) {
        var reified = reifiedFuns["$" + name]
        if (reified == undefined) { return [] }
        var targs = (targText == undefined || targText == null || targText == "") ? [] : typeArgNames(targText)
        var out = []
        for (var ri = 0; ri < reified.length; ri++) { out.push(targs.length > ri ? targs[ri] : "Any") }
        return out
    }
    // The trailing string argument a method call's type arguments contribute, or null.
    function mcallTArg(s) {
        if (s.targ == undefined || s.targ == null || s.targ == "") { return null }
        if (mcallTArgMethods["$" + s.name] != true) { return null }
        var n = tArgName(s.targ)
        return n == "" ? null : n
    }
    // ----- Imports & errors -----
    function fail(msg) { println("kotlin compiler error: " + msg); exit(1) }

    // ----- reified type parameters -----
    // The reified type-parameter names of the function whose body is being walked. A
    // stack, because a local fun can sit inside another function's body.
    var reifiedStack = []
    var pendingReified = []
    var reifiedFuns = {}
    function reifiedPush() { reifiedStack.push(pendingReified); pendingReified = [] }
    function reifiedPop() { reifiedStack.pop() }
    function reifiedTop() { return reifiedStack.length > 0 ? reifiedStack[reifiedStack.length - 1] : [] }
    // "<reifiedT,U>" (whitespace already stripped) -> ["T"]. A parameter is reified when
    // its entry starts with the `reified` modifier; everything else is erased.
    function reifiedNamesOf(t) {
        var out = []
        if (t.length < 2) { return out }
        var inner = t.substring(1, t.length - 1)
        var parts = inner.split(",")
        for (var i = 0; i < parts.length; i++) {
            if (parts[i].substring(0, 7) == "reified") { out.push(parts[i].substring(7, parts[i].length)) }
        }
        return out
    }
    function isReifiedHere(name) {
        var r = reifiedTop()
        for (var i = 0; i < r.length; i++) { if (r[i] == name) { return true } }
        return false
    }
    // The type-argument names of "<String,Int>" -> ["String", "Int"].
    function typeArgNames(t) {
        if (t == undefined || t.length < 2) { return [] }
        return t.substring(1, t.length - 1).split(",")
    }
    // The hidden parameter carrying a reified type parameter's name.
    function reifiedSlot(name) { return name + "$rt" }

    // ----- Kotlin's operator conventions -----
    // a + b is a.plus(b), -a is a.unaryMinus(), a[i] is a.get(i), a() is a.invoke(),
    // x in c is c.contains(x), and a == b is a.equals(b) for a data/value class. The
    // untyped handle world does not know an operand's type at compile time, so a
    // convention is lowered only when SOME class in the program declares it: opClasses
    // maps the convention method to those classes, and the emitted code probes with
    // js_is_type (which walks the __super chain, so subclasses are covered) and falls
    // back to the primitive operator. A program declaring no convention method emits
    // no probe.
    var opClasses = {}
    var opConventions = {"$plus": true, "$minus": true, "$times": true, "$div": true,
                         "$rem": true, "$mod": true, "$unaryMinus": true, "$unaryPlus": true,
                         "$get": true, "$set": true, "$invoke": true, "$contains": true,
                         "$compareTo": true, "$equals": true, "$rangeTo": true,
                         "$inc": true, "$dec": true, "$plusAssign": true, "$minusAssign": true,
                         "$timesAssign": true, "$divAssign": true, "$remAssign": true}
    function declOp(mname, clsName) {
        var l = opClasses["$" + mname]
        if (l == undefined) { l = []; opClasses["$" + mname] = l }
        for (var i = 0; i < l.length; i++) { if (l[i] == clsName) { return } }
        l.push(clsName)
    }
    function declOpIfConvention(mname, clsName) {
        if (opConventions["$" + mname] == true) { declOp(mname, clsName) }
    }
    // The convention method behind an operator token. A compound assignment reuses the
    // plain operator's method when the value has no plusAssign (emitCompound).
    var opMethodOf = {"+": "plus", "-": "minus", "*": "times", "/": "div", "%": "rem",
                      "+=": "plus", "-=": "minus", "*=": "times", "/=": "div", "%=": "rem",
                      "==": "equals", "!=": "equals", "==.": "equals", "!=.": "equals"}
    // A zero-width "is one of these classes" probe, folded with or.
    function emitClassProbe(b, v, cls) {
        var hit = truthy(b, callExt(b, "js_is_type", [v, emitStr(b, cls[0])]))
        for (var i = 1; i < cls.length; i++) {
            hit = b.NewOr(hit, truthy(b, callExt(b, "js_is_type", [v, emitStr(b, cls[i])])))
        }
        return hit
    }
    // The PRIMITIVE binary operator. Everything but `+` is emitted straight; `+` is
    // string concatenation when the left operand is a String (String.plus(Any?), the
    // only concatenating plus), and then both operands are
    // rendered by js_ktstr first (the runtime's own ToString would spell a list "1,2" and
    // an instance "[object Object]" where Kotlin spells them "[1, 2]" and through
    // toString()). A right String with any other left operand is js_ktadd's: an
    // element added to a collection (`names + "x"`), or a null String? rendered
    // "null". The test has to be a RUNTIME
    // probe because this front end does not type its expressions; it costs one
    // js_is_type call and a branch, and only on a `+` written in the source (a loop
    // increment emits js_jadd directly). Twin of kadd in kotlin-interpreter.abnf.
    function emitPrimBin(b, op, l, r) {
        if (op != "+" && op != "+=") { return {b: b, v: emitBin(b, op, l, r)} }
        var strB = curF.NewBlock("")
        var numB = curF.NewBlock("")
        var mrgB = curF.NewBlock("")
        b.NewCondBr(truthy(b, callExt(b, "js_is_type", [l, emitStr(b, "String")])), strB, numB)
        var sv = callExt(strB, "js_jadd", [callExt(strB, "js_ktstr", [l]), callExt(strB, "js_ktstr", [r])])
        strB.NewBr(mrgB)
        var nv = emitBin(numB, op, l, r)
        numB.NewBr(mrgB)
        return {b: mrgB, v: mrgB.NewPhi([llvm.ir.NewIncoming(sv, strB), llvm.ir.NewIncoming(nv, numB)])}
    }
    // Emit `l op r`: the convention method when the left operand is an instance of a
    // class that declares it, the primitive operator otherwise.
    function emitOpBin(b, op, l, r) {
        var mth = opMethodOf[op]
        var cls = (mth != undefined) ? opClasses["$" + mth] : undefined
        if (cls == undefined) { return emitPrimBin(b, op, l, r) }
        var objB = curF.NewBlock("")
        var primB = curF.NewBlock("")
        var mergeB = curF.NewBlock("")
        b.NewCondBr(emitClassProbe(b, l, cls), objB, primB)
        var argsV = callExt(objB, "js_arr_new", [])
        callExt(objB, "js_arr_push", [argsV, r])
        var ov = callExt(objB, "js_ktsmcall", [l, emitStr(objB, mth), argsV])
        if (op == "!=" || op == "!=.") { ov = callExt(objB, "js_not", [ov]) }
        objB.NewBr(mergeB)
        var pr = emitPrimBin(primB, op, l, r)
        pr.b.NewBr(mergeB)
        return {b: mergeB, v: mergeB.NewPhi([llvm.ir.NewIncoming(ov, objB), llvm.ir.NewIncoming(pr.v, pr.b)])}
    }
    // The value `l op= r` writes back, op a compound operator: l itself after its
    // class's plusAssign / minusAssign /... when it declares one (Kotlin takes it;
    // declaring plus as well is an ambiguity on a var), and on a val target the
    // js_ktfill of l, which updates a mutable collection IN PLACE so every alias sees
    // it; otherwise l op r. Twin of kCompoundOp in kotlin-interpreter.abnf.
    var opAssignOf = {"+=": "plusAssign", "-=": "minusAssign", "*=": "timesAssign", "/=": "divAssign", "%=": "remAssign"}
    function emitCompound(b, op, l, r, isVal) {
        var cls = opClasses["$" + opAssignOf[op]]
        if (cls == undefined) { return emitCompoundOp(b, op, l, r, isVal) }
        var objB = curF.NewBlock("")
        var primB = curF.NewBlock("")
        var mergeB = curF.NewBlock("")
        b.NewCondBr(emitClassProbe(b, l, cls), objB, primB)
        var argsV = callExt(objB, "js_arr_new", [])
        callExt(objB, "js_arr_push", [argsV, r])
        callExt(objB, "js_ktsmcall", [l, emitStr(objB, opAssignOf[op]), argsV])
