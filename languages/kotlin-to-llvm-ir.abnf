    function declOpIfConvention(mname, clsName) {
        if (opConventions["$" + mname] == true) { declOp(mname, clsName) }
    }
    // The convention method behind an operator token. A compound assignment reuses the
    // plain operator's method (Kotlin falls back to plus when plusAssign is absent, and
    // the subset has no plusAssign).
    var opMethodOf = {"+": "plus", "-": "minus", "*": "times", "/": "div", "%": "rem",
                      "+=": "plus", "-=": "minus", "*=": "times", "/=": "div", "%=": "rem",
                      "==": "equals", "!=": "equals"}
    // A zero-width "is one of these classes" probe, folded with or.
    function emitClassProbe(b, v, cls) {
        var hit = truthy(b, callExt(b, "js_is_type", [v, emitStr(b, cls[0])]))
        for (var i = 1; i < cls.length; i++) {
            hit = b.NewOr(hit, truthy(b, callExt(b, "js_is_type", [v, emitStr(b, cls[i])])))
        }
        return hit
    }
    // The PRIMITIVE binary operator. Everything but `+` is emitted straight; `+` is
    // string concatenation as soon as one operand is a String (Kotlin's rule, and
    // exactly what kotlin-interpreter.abnf's kadd tests), and then both operands are
    // rendered by js_ktstr first. Without that, the concat falls back on the runtime's
    // own ToString, which spells a list "1,2" and an instance "[object Object]" where
    // Kotlin spells them "[1, 2]" and through toString(). The test has to be a RUNTIME
    // probe because this front end does not type its expressions; it costs two
    // js_is_type calls and a branch, and only on a `+` written in the source (a loop
    // increment emits js_jadd directly).
    function emitPrimBin(b, op, l, r) {
        if (op != "+" && op != "+=") { return {b: b, v: emitBin(b, op, l, r)} }
        var strB = curF.NewBlock("")
        var numB = curF.NewBlock("")
        var mrgB = curF.NewBlock("")
        var isStr = b.NewOr(truthy(b, callExt(b, "js_is_type", [l, emitStr(b, "String")])),
                            truthy(b, callExt(b, "js_is_type", [r, emitStr(b, "String")])))
        b.NewCondBr(isStr, strB, numB)
        var sv = callExt(strB, "js_jadd", [callExt(strB, "js_ktstr", [l]), callExt(strB, "js_ktstr", [r])])
        strB.NewBr(mrgB)
        var nv = emitBin(numB, op, l, r)
        numB.NewBr(mrgB)
        return {b: mrgB, v: mrgB.NewPhi([llvm.ir.NewIncoming(sv, strB), llvm.ir.NewIncoming(nv, numB)])}
    }
    // Emit `l op r`: the convention method when the left operand is an instance of a
    // class that declares it, the primitive operator otherwise.
    function emitOpBin(b, op, l, r) {
        var mth = opMethodOf[op]
        var cls = (mth != undefined) ? opClasses["$" + mth] : undefined
        if (cls == undefined) { return emitPrimBin(b, op, l, r) }
        var objB = curF.NewBlock("")
        var primB = curF.NewBlock("")
        var mergeB = curF.NewBlock("")
        b.NewCondBr(emitClassProbe(b, l, cls), objB, primB)
        var argsV = callExt(objB, "js_arr_new", [])
        callExt(objB, "js_arr_push", [argsV, r])
        var ov = callExt(objB, "js_ktsmcall", [l, emitStr(objB, mth), argsV])
        if (op == "!=") { ov = callExt(objB, "js_not", [ov]) }
        objB.NewBr(mergeB)
        var pr = emitPrimBin(primB, op, l, r)
        pr.b.NewBr(mergeB)
        return {b: mergeB, v: mergeB.NewPhi([llvm.ir.NewIncoming(ov, objB), llvm.ir.NewIncoming(pr.v, pr.b)])}
    }
    // Every binary operator of the subset goes through the convention check.
    foldBinary = function(items) {
        if (items.length == 1) { return items[0] }
        return function(b) {
            var r = items[0](b)
            b = r.b
            var v = r.v
            for (var i = 1; i < items.length; i += 2) {
                var rr = items[i + 1](b)
                b = rr.b
                var ro = emitOpBin(b, items[i], v, rr.v)
                b = ro.b
                v = ro.v
            }
            return {b: b, v: v}
        }
    }
    // ----- Double / Float: a boxed js_jflo value (see abnf/jsrtjvm.go) -----
    // Kotlin's Double is a DIFFERENT type from Int, and the handle runtime models
    // every number as one JS double, so 1.0 / 3.0 and 1 / 3 arrived here as the same
    // two operands. Every arithmetic operator used to be followed by the shared
    // intWrap, which made the float half of the language silently integer
    // arithmetic: 2.5 * 1.5 was 3, 1.0 / 3.0 was 0, println(1.0) printed "1" and
    // Infinity / NaN / -0.0 did not exist. A floating-point literal now emits the
    // js_jflo box and the js_jf* operators answer a Double whenever one operand is
    // one, which is what kotlin-interpreter.abnf's {__flo} box does.
    //
    // AN f/F SUFFIX IS A `Float`, i.e. a BINARY32, and not a Double spelled
    // differently: 1.0f/3.0f is 0.33333334 where the double is
    // 0.3333333333333333. The width rides on the tag 14 box's style byte
    // (floJavaF = 3 in abnf/jsrtjvm.go) and js_ktflo32 is what rounds; the
    // specification and the reason the floor is NOT the place for it are in the
    // float WIDTH block of languages/lib/kotlin-rt.metajs.
    //
    // (The decimal is read into a double first and rounded to a float second,
    // where kotlinc rounds once. A decimal that lands exactly on a float midpoint
    // AFTER a double rounding would differ; no value in the corpus or the probe
    // does.)
    function makeFloConst(f, isF32) {
        var ext = isF32 == true ? "js_ktflo32" : "js_jflo"
        return function(b) { return {b: b, v: callExt(b, ext, [emitNum(b, f)])} }
    }
    // The literal TEXT ends in f or F. The suffix is the only thing that makes a
    // Kotlin floating-point literal a Float - there is no Float-typed unsuffixed
    // literal - so this is the whole test. The twin is kIsF32Lit in
    // kotlin-interpreter.abnf.
    function ktIsF32Lit(raw) {
        if (raw.length == 0) { return false }
        var c = raw.charAt(raw.length - 1)
        return c == "f" || c == "F"
    }
    // ----- An integer literal's TEXT -----
    // Kotlin types an integer literal by its suffix AND its value: unsuffixed it is an
    // Int when it fits in one and a Long otherwise (so 0xFFFFFFFF is the Long
    // 4294967295 here, where Java's constant conversion makes the same text int -1);
    // `u` gives a UInt when it fits and a ULong otherwise; `L` a Long and `uL` a ULong.
    // The suffix code is the one js_ktlit reads: 0 none, 1 L, 2 u, 3 uL.
    function ktLitParts(raw) {
        var s = ""
        for (var i = 0; i < raw.length; i++) { if (raw.charAt(i) != "_") { s = s + raw.charAt(i) } }
        var sfx = 0
        var end = s.length
        var lastc = s.charAt(end - 1)
        if (lastc == "L" || lastc == "l") { sfx = 1; end = end - 1 }
        var c2 = s.charAt(end - 1)
        if (c2 == "u" || c2 == "U") { sfx = (sfx == 1) ? 3 : 2; end = end - 1 }
        var body = s.substring(0, end)
        var radix = 10
        if (body.length > 2 && body.charAt(0) == "0") {
            var k = body.charAt(1)
            if (k == "x" || k == "X") { radix = 16; body = body.substring(2) }
            else if (k == "b" || k == "B") { radix = 2; body = body.substring(2) }
        }
        return {t: body, r: radix, s: sfx}
    }
    // The literal's constant thunk. An unsuffixed literal that fits in an Int stays a
    // PLAIN NUMBER emitted as before - which is the overwhelming majority of literals
    // in any program, so the IR does not grow and nothing gets slower. Only a literal
    // that carries a type (a suffix, or a value past Int) pays for js_ktlit, whose
    // DIGITS travel as text because emitNum would already have rounded
    // 9223372036854775807 to 9223372036854776000 on the way into the module - and
    // rounded it DIFFERENTLY under goja and -frozen, which the matrix demands agree.
    function makeIntConst(raw) {
        var p = ktLitParts(raw)
        if (p.s == 0) {
            var n = parseInt(p.t, p.r)
            if (n <= 2147483647) { return makeConst(n) }
        }
        var txt = p.t
        var rdx = p.r
        var sfc = p.s
        return function(b) {
            return {b: b, v: callExt(b, "js_ktlit", [emitStr(b, txt), emitNum(b, rdx), emitNum(b, sfc)])}
        }
    }
    // ----- Int / Long / Byte / Short and the four unsigned types -----
    // Every arithmetic and ordered-comparison operator goes through the sized-integer
    // externs of abnf/jsrtkotlin.go, which apply the width rules (Byte + Byte is an
    // Int, Int + Long is a Long, UInt + UInt is a UInt), wrap silently on overflow and
    // throw ArithmeticException on a divide by zero. A Double operand still pulls the
    // whole operation into floating point, so mixed Int/Double arithmetic is unchanged.
    // The twins are jArith / jCmp / kadd in kotlin-interpreter.abnf.
    var coreEmitBinK = emitBin
    var ktArithOp = {"$-": "-", "$-=": "-", "$*": "*", "$*=": "*",
                     "$/": "/", "$/=": "/", "$%": "%", "$%=": "%"}
    var ktCmpOp = {"$<": "<", "$>": ">", "$<=": "<=", "$>=": ">="}
    emitBin = function(b, op, l, r) {
        var ao = ktArithOp["$" + op]
        if (ao != undefined) { return callExt(b, "js_ktarith", [emitStr(b, ao), l, r]) }
        var co = ktCmpOp["$" + op]
        if (co != undefined) { return callExt(b, "js_ktcmp", [emitStr(b, co), l, r]) }
        // The numeric half of `+` (emitPrimBin has already split the String case off).
        if (op == "+" || op == "+=") { return callExt(b, "js_ktadd", [l, r]) }
        // == / != compare two integers by VALUE across the box; every other pair keeps
        // the equality the runtime had, so a data class still uses its own equals.
        if (op == "==") { return callExt(b, "js_kteq", [l, r]) }
        if (op == "!=") { return callExt(b, "js_ktne", [l, r]) }
        return coreEmitBinK(b, op, l, r)
    }
    // Kotlin folds a unary minus into an integer LITERAL when typing it: `2147483648`
    // on its own is out of Int range and is a Long, while `-2147483648` is Int.MIN_VALUE
    // and stays 32 bit. Only the exact boundary TEXT is folded; up.in is the
    // production's matched tokens with the separators removed, so a `_` grouping and
    // stray whitespace are stripped before the comparison. Anything else - including an
    // explicit `L` suffix - keeps the ordinary negation. The twin of kNegFold in
    // kotlin-interpreter.abnf.
    function kNegFold(t, raw) {
        var txt = ""
        for (var i = 0; i < raw.length; i++) {
            var ch = raw.charAt(i)
            if (ch != "_" && ch != " " && ch != "\t" && ch != "\n" && ch != "\r") { txt = txt + ch }
        }
        if (txt == "-2147483648") { return makeConst(-2147483648) }
        return makeNeg(t)
    }
    // -x: the unaryMinus convention, else the primitive negation.
    makeNeg = function(t) {
        return function(b) {
            var r = t(b)
            b = r.b
            var cls = opClasses["$unaryMinus"]
            if (cls == undefined) { return {b: b, v: callExt(b, "js_ktneg", [r.v])} }
            var objB = curF.NewBlock("")
            var primB = curF.NewBlock("")
            var mergeB = curF.NewBlock("")
            b.NewCondBr(emitClassProbe(b, r.v, cls), objB, primB)
            var ov = callExt(objB, "js_ktsmcall", [r.v, emitStr(objB, "unaryMinus"), callExt(objB, "js_arr_new", [])])
            objB.NewBr(mergeB)
            var pv = callExt(primB, "js_ktneg", [r.v])
            primB.NewBr(mergeB)
            return {b: mergeB, v: mergeB.NewPhi([llvm.ir.NewIncoming(ov, objB), llvm.ir.NewIncoming(pv, primB)])}
        }
    }
    // Like emitOpDispatch, but the arguments already sit in an emitted array.
    function emitOpDispatchArr(b, recvV, mth, argsV, fallback) {
        var cls = opClasses["$" + mth]
        if (cls == undefined) { return {b: b, v: fallback(b)} }
        var objB = curF.NewBlock("")
        var primB = curF.NewBlock("")
        var mergeB = curF.NewBlock("")
        b.NewCondBr(emitClassProbe(b, recvV, cls), objB, primB)
        var ov = callExt(objB, "js_ktsmcall", [recvV, emitStr(objB, mth), argsV])
        objB.NewBr(mergeB)
        var pv = fallback(primB)
        primB.NewBr(mergeB)
        return {b: mergeB, v: mergeB.NewPhi([llvm.ir.NewIncoming(ov, objB), llvm.ir.NewIncoming(pv, primB)])}
    }
    // A general "convention method or fallback" emitter for the postfix forms: the
    // indexed read a[i] (get) and the call form a(args) (invoke).
    function emitOpDispatch(b, recvV, mth, argVs, fallback) {
        var cls = opClasses["$" + mth]
        if (cls == undefined) { return {b: b, v: fallback(b)} }
        var objB = curF.NewBlock("")
        var primB = curF.NewBlock("")
        var mergeB = curF.NewBlock("")
        b.NewCondBr(emitClassProbe(b, recvV, cls), objB, primB)
        var argsV = callExt(objB, "js_arr_new", [])
        for (var i = 0; i < argVs.length; i++) { callExt(objB, "js_arr_push", [argsV, argVs[i]]) }
        var ov = callExt(objB, "js_ktsmcall", [recvV, emitStr(objB, mth), argsV])
        objB.NewBr(mergeB)
        var pv = fallback(primB)
        primB.NewBr(mergeB)
        return {b: mergeB, v: mergeB.NewPhi([llvm.ir.NewIncoming(ov, objB), llvm.ir.NewIncoming(pv, primB)])}
    }

    // ----- Parameters, defaults, vararg and named arguments -----
    // A parameter: {name, def, vararg}. The default is an expression thunk emitted
    // INSIDE the callee (so it can read the earlier parameters and `this`), exactly
    // where Kotlin evaluates it.
    function makeParam(items) {
        var rec = {name: null, def: null, vararg: false, ty: ""}
        for (var i = 0; i < items.length; i++) {
            if (items[i].pname != undefined) { rec.name = items[i].pname }
            else if (items[i].pdef != undefined) { rec.def = items[i].pdef }
            else if (items[i].isvararg != undefined) { rec.vararg = true }
            else if (items[i].pty != undefined) { rec.ty = items[i].pty }
        }
        // A PARAMETER whose declared type is a receiver function type - the DSL builder
        // shape, `fun doc(body: Node.() -> Unit)` - binds its receiver as `this`
        // exactly as a local `val f: T.() -> R` does, so `t.body()` inside the callee
        // must reach the closure with the receiver in front rather than look for a
        // METHOD named body. Registering the name here is what the call-site branch on
        // recvLambdaNames already needs; without it every DSL builder aborted with
        // "unknown method 'body' on an instance".
        if (rec.name != null && rec.ty != "" && isRecvFnType(rec.ty)) {
            recvLambdaNames["$" + rec.name] = true
        }
        return rec
    }
    // {params: [names], defs: [thunk|null], varargAt: index|-1}. `params` keeps the
    // plain name array every emitter already binds positionally.
    function makeParamList(items) {
        var names = []
        var defs = []
        var tys = []
        var varargAt = -1
        for (var i = 0; i < items.length; i++) {
            names.push(items[i].name)
            defs.push(items[i].def)
            tys.push(items[i].ty == undefined ? "" : items[i].ty)
            if (items[i].vararg) { varargAt = i }
        }
        noteVararg(names, varargAt)
        return {params: names, defs: defs, tys: tys, varargAt: varargAt}
    }
    // Which parameter of a parameter LIST is the vararg. A vararg slot filled by NAME is
    // Kotlin's "only one named argument for a vararg parameter is allowed, and it must be
    // an array": the value IS the argument list, so orderArgs SPREADS it rather than
    // placing it. Without this, `add("b", roles = arrayOf("dev"))` wrapped the array in
    // another array here and answered [[dev]], while the interpreter half answered the
    // EMPTY list (its vararg only collected the positional tail). Kotlin's answer is
    // [dev], which both halves now give.
    //
    // The table is keyed by the parameter-name LIST rather than by the parameter name
    // alone: keying by name made a data class's synthesized `copy(tags = ...)` spread
    // its argument, because an unrelated function elsewhere in the file declared a
    // `vararg tags`. orderArgs holds the callee's name list and nothing else, which is
    // exactly what this key is.
    var varargOfList = {}
    function paramListKey(names) {
        var k = ""
        for (var i = 0; i < names.length; i++) { k = k + "\x01" + names[i] }
        return k
    }
    function noteVararg(names, at) {
        if (at < 0) { return }
        varargOfList["$" + paramListKey(names)] = names[at]
    }
    // Place named arguments into the callee's positional slots. Unnamed arguments fill
    // from the left in order; a named one lands at its parameter's index; a slot no
    // argument reaches stays undefined, which is exactly the signal emitParamSig turns
    // into the declared default. Without a named argument (or without a known callee)
    // the list is returned unchanged, so ordinary calls emit byte-identically.
    // Named arguments are ordered against the parameter names of the method being
    // called, and methodParams is keyed by the method NAME alone - so a second class
    // declaring a method of the same name overwrote the first one's slots. That is not
    // hypothetical for a data class: `copy`'s slots are the component names, so
    // `data class Pt(val x: Int, val y: Int)` followed by ANY other data class made
    // `p.copy(y = 9)` write into slot 0 and answer Pt(x=9, y=2). The interpreter half,
    // which binds named arguments by name at call time, was right.
    // Every declared vector is kept here; the one that carries every named argument of
    // this call site wins, latest declaration first (which is the tie-break the single
    // slot used to give unconditionally).
    var methodParamAlts = {}
    function noteParams(name, params) {
        methodParams["$" + name] = params
        var alts = methodParamAlts["$" + name]
        if (alts == undefined) { alts = [] }
        alts.push(params)
        methodParamAlts["$" + name] = alts
    }
    function paramsFor(name, args) {
        var alts = methodParamAlts["$" + name]
        if (alts == undefined) { return methodParams["$" + name] }
        for (var i = alts.length - 1; i >= 0; i--) {
            var ok = true
            for (var j = 0; j < args.length; j++) {
                if (args[j].aname == undefined) { continue }
                var found = false
                for (var k = 0; k < alts[i].length; k++) { if (alts[i][k] == args[j].aname) { found = true } }
                if (!found) { ok = false }
            }
            if (ok) { return alts[i] }
        }
        return methodParams["$" + name]
    }
    function orderArgs(args, names) {
        var named = false
        for (var i = 0; i < args.length; i++) { if (args[i].aname != undefined) { named = true } }
        if (!named) { return args }
        if (names == undefined) { return args }
        var out = []
        var pos = 0
        for (var j = 0; j < args.length; j++) {
            if (args[j].aname == undefined) { out[pos] = args[j]; pos++; continue }
            var slot = -1
            for (var k = 0; k < names.length; k++) { if (names[k] == args[j].aname) { slot = k } }
            if (slot < 0) { out[pos] = args[j]; pos++; continue }
            if (varargOfList["$" + paramListKey(names)] == args[j].aname && args[j].spread != true) {
                out[slot] = {at: args[j].at, aname: args[j].aname, spread: true}
            } else {
                out[slot] = args[j]
            }
        }
        var n = names.length
        if (out.length > n) { n = out.length }
        var filled = []
        for (var q = 0; q < n; q++) {
            filled.push(out[q] != undefined ? out[q] : {at: makeConst(undefined)})
        }
        return filled
    }
    // Emit an argument list. Every entry is {at, aname?, spread?}: a spread argument
    // (*arr) pushes each ELEMENT of the array instead of the array itself, which is
    // done with an emitted index loop because the argument array is built at run time.
    emitArgs = function(b, args) {
        var argsV = callExt(b, "js_arr_new", [])
        for (var j = 0; j < args.length; j++) {
            var ar = args[j].at(b)
            b = ar.b
            if (args[j].spread != true) { callExt(b, "js_arr_push", [argsV, ar.v]); continue }
            b = emitSpread(b, argsV, ar.v)
        }
        return {b: b, v: argsV}
    }
    // Append every element of the array srcV to dstV (an emitted counted loop).
    function emitConcatArgs(b, dstV, srcV) { return emitSpread(b, dstV, srcV) }
    // *arr: append every element of arr to the argument array (a counted loop over
    // arr.length, since neither the length nor the elements are known at compile time).
    function emitSpread(b, argsV, arrV) {
        hidCount++
        var iName = "$sp" + hidCount
        var saved = curScopeV
        curScopeV = callExt(b, "js_scope_new", [curScopeV])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, iName), emitNum(b, 0)])
        var headB = curF.NewBlock("")
        var bodyB = curF.NewBlock("")
        var exitB = curF.NewBlock("")
        b.NewBr(headB)
        var iV = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, iName)])
        var lenV = callExt(headB, "js_get", [arrV, emitStr(headB, "length")])
        headB.NewCondBr(truthy(headB, callExt(headB, "js_lt", [iV, lenV])), bodyB, exitB)
        var iV2 = callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, iName)])
        callExt(bodyB, "js_arr_push", [argsV, callExt(bodyB, "js_get", [arrV, iV2])])
        callExt(bodyB, "js_scope_set", [curScopeV, emitStr(bodyB, iName),
                                        callExt(bodyB, "js_jadd", [iV2, emitNum(bodyB, 1)])])
        bodyB.NewBr(headB)
        curScopeV = saved
        return exitB
    }
    // After the declared parameters are bound: collect a vararg parameter's extra
    // arguments into a list, then re-bind every defaulted parameter the caller left
    // out. A slot the call did not reach holds undefined - the one value Kotlin source
    // cannot pass - so testing for it is a sound "argument absent" test.
    function emitParamSig(b, sig, argsV, off) {
        if (sig == undefined || sig == null) { return b }
        if (sig.varargAt >= 0) {
            callExt(b, "js_scope_set", [curScopeV, emitStr(b, sig.params[sig.varargAt]),
                                        callExt(b, "js_pyrest", [argsV, handle(sig.varargAt + off)])])
        }
        for (var i = 0; i < sig.defs.length; i++) {
            if (sig.defs[i] == null) { continue }
            var nameV = emitStr(b, sig.params[i])
            var curV = callExt(b, "js_scope_get", [curScopeV, nameV])
            var defB = curF.NewBlock("")
            var mergeB = curF.NewBlock("")
            b.NewCondBr(truthy(b, callExt(b, "js_seq", [curV, hUndef])), defB, mergeB)
            var r = sig.defs[i](defB)
            callExt(r.b, "js_scope_set", [curScopeV, nameV, r.v])
            r.b.NewBr(mergeB)
            b = mergeB
        }
        // A DECLARED parameter type carries its width, exactly as a declared local type
        // does: `fun f(v: Long = 1)` binds a 64 bit 1 whether the caller passed it or the
        // default supplied it, so this runs AFTER the defaults above. Verified against
        // java 24: `dflt41() * 1000000 * 1000000` is 1000000000000, not -727379968.
        if (sig.tys != undefined) {
            for (var t = 0; t < sig.tys.length; t++) {
                b = emitAdoptSlot(b, sig.params[t], sig.tys[t])
                // A parameter declared with a RECEIVER function type (the DSL builder
                // shape, `body: Node.() -> Unit`) is re-bound to a wrapper that runs
                // the closure with its first argument as `this`. The lambda the CALLER
                // wrote is an ordinary one - the callee is the only place that knows
                // the type - so the binding, not the literal, is what carries the
                // receiver. js_ktrecvlam is the same rule ktWithRecv gives `with`.
                if (sig.tys[t] != "" && isRecvFnType(sig.tys[t])) {
                    var rlV = emitStr(b, sig.params[t])
                    callExt(b, "js_scope_set", [curScopeV, rlV,
                                                callExt(b, "js_ktrecvlam",
                                                        [callExt(b, "js_scope_get", [curScopeV, rlV])])])
                }
            }
        }
        return b
    }
    // Re-bind a scope slot to its declared type's width. A no-op for a type that is not
    // integral / Double / Float, so nothing is emitted for the ordinary case.
    function emitAdoptSlot(b, name, ty) {
        if (ty == undefined || ty == "") { return b }
        var dw = ktWidthOfType(ty)
        if (dw.w == 0 && dw.flo != true) { return b }
        var nameV = emitStr(b, name)
        var curV = callExt(b, "js_scope_get", [curScopeV, nameV])
        callExt(b, "js_scope_set", [curScopeV, nameV, emitAdoptV(b, curV, dw)])
        return b
    }
    // One value, retyped by a declared type's width record.
    function emitAdoptV(b, v, dw) {
        if (dw.w > 0) { return callExt(b, "js_ktadopt", [v, emitNum(b, dw.w), dw.u ? hTrue : hFalse]) }
        if (dw.f32 == true) { return callExt(b, "js_ktadoptf32", [v]) }
        if (dw.flo == true) { return callExt(b, "js_ktadoptf", [v]) }
        return v
    }

    // A declaration that is fully ERASED: it parses, contributes nothing to the module,
    // and is NOT a gap (annotation classes and typealiases are metadata / type sugar).
    function makeErased() { return function(b) { return b } }

    // ----- Imports that name a type this program does not contain -----
    // The SIMPLE name each import brings in, and its `as` alias. An import that RESOLVED
    // puts its types into the program, so a name recorded here that is STILL not a
    // program type came from an import this run could not resolve - which only happens
    // under -warn-imports, i.e. after the user has already chosen to continue past the
    // missing import. `class MyApp : Application()` over an unresolvable
    // `import android.app.Application` is exactly that shape, and it is the commonest
    // `super` in a real Android tree.
    //
    // This is a DIFFERENT class of failure from a supertype the resolver merely could
    // not find (a typealias, a dotted path, an interface listed first). Those are bugs
    // here and stay hard failures that NAME the supertype. An external one is not a gap
    // in this grammar and never will be: there is no such class anywhere, so a `super`
    // into it degrades to Unit and the override's own body still runs.
    //
    // No second warning is printed at the super site, deliberately. The import already
    // warned and named the type, the degradation is only reachable because the user
    // passed -warn-imports, and a per-site warning cannot be made byte-identical between
    // a static emitter (which would warn about code that never runs) and a walker (which
    // would warn once per execution) - and the two halves must print the same bytes.
    var importedNames = {}
    function noteImportName(n) {
        if (n == "" || n == "*") { return }
        importedNames["$" + n] = true
    }
    function ktImport(items, pos) {
        var path = ""
        var alias = ""
        for (var i = 0; i < items.length; i++) {
            if (items[i] == undefined || items[i] == null) { continue }
            if (items[i].ialias != undefined) { alias = stripWs(items[i].ialias) }
            else { path = stripWs(items[i]) }
        }
        resolveImport(path, pos)
        var seg = path
        var dot = -1
        for (var j = 0; j < path.length; j++) { if (path.charAt(j) == ".") { dot = j } }
        if (dot >= 0) { seg = path.substring(dot + 1, path.length) }
        noteImportName(seg)
        noteImportName(alias)
    }
    function externalType(name) { return importedNames["$" + name] == true }

    // ----- Type aliases -----
    // `typealias Alias = Real` is still ERASED - no descriptor, no code - but the
    // mapping is kept so that a type REFERENCE written through the alias can be reduced
    // to the name the real descriptor is bound under. The flat table (no scoping) is
    // exactly what the interpreter half keeps, so both halves resolve the same way.
    // items = [aliasName, targetTypeText]; the return value is the erased statement.
    var typeAliases = {}
    function registerTypeAlias(items) {
        typeAliases["$" + stripWs(items[0])] = stripWs(items[1])
        return makeErased()
    }

    // ----- Supertypes -----
    // The bare name of a (possibly generic, possibly dotted) supertype: Box<T> -> Box,
    // a.b.C -> C. The untyped handle world erases type arguments, and the descriptor
    // that carries __name is bound under the simple name.
    function baseTypeName(t) {
        var cut = t.length
        for (var i = 0; i < t.length; i++) { if (t.charAt(i) == "<" || t.charAt(i) == "?") { cut = i; break } }
        t = t.substring(0, cut)
        var dot = -1
        for (var j = 0; j < t.length; j++) { if (t.charAt(j) == ".") { dot = j } }
        return (dot >= 0) ? t.substring(dot + 1, t.length) : t
    }
    // items = [{sname}, ({sarg}... {iscall}) | {sdeleg}] -> one supertype record.
    function makeSuper(items) {
        var rec = {name: items[0].sname, iscall: false, args: [], deleg: null}
        for (var i = 1; i < items.length; i++) {
            if (items[i].sarg != undefined) { rec.args.push(items[i].sarg) }
            else if (items[i].iscall != undefined) { rec.iscall = true }
            else if (items[i].sdeleg != undefined) { rec.deleg = items[i].sdeleg }
        }
        return rec
    }
    // An abstract (bodiless) member function: only its name and arity matter.
    function makeAbstract(items) { noteParams(items[0], items[1].params); return {name: items[0], params: items[1].params} }
    // Base types the runtime does not model as user classes but whose constructor
    // argument programs DO observe: `class E(m: String) : Exception(m)` must make
    // e.message readable, so the synthesized "super constructor" stores it.
    var excBases = {"$Exception": true, "$RuntimeException": true, "$Throwable": true,
                    "$Error": true, "$IllegalStateException": true, "$IllegalArgumentException": true,
                    "$IllegalAccessException": true, "$ArithmeticException": true}
    // The builtin throwables that can also be CONSTRUCTED directly - `throw
    // IllegalStateException("x")`. The set matches ktExcHierarchy in abnf/jsrtkotlin.go
    // and installThrowables in kotlin-interpreter.abnf.
    var excBuiltins = {"$Throwable": true, "$Exception": true, "$Error": true,
                       "$RuntimeException": true, "$IllegalStateException": true,
                       "$IllegalArgumentException": true, "$IndexOutOfBoundsException": true,
                       "$NullPointerException": true, "$NumberFormatException": true,
                       "$UnsupportedOperationException": true, "$ArithmeticException": true,
                       "$NoSuchElementException": true, "$ConcurrentModificationException": true,
                       "$ClassCastException": true, "$IllegalAccessException": true,
                       "$StackOverflowError": true, "$OutOfMemoryError": true}

    // Import prefixes the runtime already satisfies: their symbols are provided
    // as builtins (abs/max/min, listOf, exitProcess, ...), so importing them is a
    // no-op. Anything else is an external library we cannot resolve.
    core.stdlibImports = ["kotlin", "kotlin.math", "kotlin.collections", "kotlin.system", "kotlin.text", "kotlin.ranges", "kotlin.sequences", "kotlinx.coroutines"]

    // Project-file imports: 'import a.b.C' looks for a/b/C.kt, then a/b.kt
    // under the program's directory and the -i roots (c.findImport). The file
    // is parsed with this grammar and walked with the same tags: its functions
    // register like the main file's, and its top-level statements are stashed
    // by buildMain (importDepth > 0) and prepended to jsmain. A file is
    // imported once; repeats and cycles are no-ops.
    var importedFiles = {}
    var importDepth = 0
    core.importFile = function(path, pos) {
        if (path.length > 2 && path.substring(path.length - 2) == ".*") { return false }
        var rel = path.split(".").join("/")
        var cands = [rel + ".kt"]
        var cut = -1
        for (var k = 0; k < rel.length; k++) { if (rel.charAt(k) == "/") { cut = k } }
        if (cut > 0) { cands.push(rel.substring(0, cut) + ".kt") }
        for (var i = 0; i < cands.length; i++) {
            var file = c.findImport(cands[i])
            if (file == "") { continue }
            if (importedFiles["$" + file] == true) { return true }
            importedFiles["$" + file] = true
            var text = c.readFile(file)
            var asg = c.parse(c.agrammar, text, null, file)
            c.pushSource(file, text)
            importDepth = importDepth + 1
            c.compile(asg)
            importDepth = importDepth - 1
            c.popSource()
            return true
        }
        return false
    }

    // stripWs, importResolvable, resolveImport and the notImpl / notImplStmt /
    // notImplExpr family now live in lib/compile-core.js (shared by all compiler
    // grammars). This grammar sets core.stdlibImports (above) and keeps the
    // Kotlin-specific builders below (they call notImpl from the lib).

    // try/catch/finally: each body becomes its own IR closure over the current scope;
    // js_try (jsrt.go) runs the try under a Go recover, routes a thrown value to the
    // catch closure (a one-parameter function bound to the catch name) and always runs
    // finally. The first catch clause wins. See the TryStmt LIMITATION note above.
    // makeCatch is shared - see lib/compile-core.js.
    // Wrap a VALUE block (function(b) -> {b, v}) as a body closure that RETURNS its
    // value, which is how the try-EXPRESSION gets its value out of js_try.
    function valueBody(vb) {
        return function(b) {
            var r = vb(b)
            r.b.NewRet(r.v)
            return deadBlock()
        }
    }
    // A catch clause, with the DECLARED type CatchTy now records. Overridden by
    // assignment (never re-declared): makeCatch lives in lib/compile-core.js and is
    // shared, and this grammar's CatchClause pushes one item more than it expects.
    makeCatch = function (items) {
        var body = anytype
        var nm = anytype
        var ty = anytype
        body = null
        nm = undefined
        ty = null
        for (var i = 0; i < items.length; i++) {
            var it = items[i]
            if (typeof it == "function") { body = it }
            else if (it != null && it != undefined && it.ctype != undefined) { ty = it.ctype }
            else { nm = it }
        }
        return {catchbody: body, catchname: nm, catchtype: ty}
    }
    // The parts of a try, whichever form it came in. EVERY catch clause is kept - the
    // dispatch that picks the matching one is emitCatchClosure's.
    function tryParts(items) {
        var tryT = anytype, finallyT = anytype
        var catches = []
        for (var i = 0; i < items.length; i++) {
            if (items[i].trybody != undefined) { tryT = items[i].trybody }
            else if (items[i].catchbody != undefined) { catches.push(items[i]) }
            else if (items[i].finbody != undefined) { finallyT = items[i].finbody }
        }
        return {tryT: tryT, catches: catches, finallyT: finallyT}
    }
    // ONE catch closure for all the clauses of a try. js_try can only be handed a
    // single catch function, so the clause SELECTION is emitted inside it: the thrown
    // value arrives as `__caught`, each typed clause is guarded by js_ktexcmatch
    // (abnf/jsrtkotlin.go, the twin of kExcMatches in the interpreter half), an
    // untyped clause takes everything from there on, and a value no clause matches is
    // rethrown - which is Kotlin's rule and what makes an outer try see it.
    // Before this the compiler ran the FIRST clause whatever its type.
    function emitCatchClosure(cls) {
        return emitFunc(["__caught"], function(bb) {
            var b2 = anytype
            b2 = bb
            for (var i = 0; i < cls.length; i++) {
                var cn = (cls[i].catchname != undefined) ? cls[i].catchname : "__caught"
                var ty = cls[i].catchtype
                var caughtV = callExt(b2, "js_scope_get", [curScopeV, emitStr(b2, "__caught")])
                if (ty == null || ty == undefined) {
                    callExt(b2, "js_scope_decl", [curScopeV, emitStr(b2, cn), caughtV])
                    return cls[i].catchbody(b2)
                }
                var hitB = curF.NewBlock("")
                var nextB = curF.NewBlock("")
                b2.NewCondBr(truthy(b2, callExt(b2, "js_ktexcmatch", [caughtV, emitStr(b2, ty)])), hitB, nextB)
                callExt(hitB, "js_scope_decl", [curScopeV, emitStr(hitB, cn), caughtV])
                cls[i].catchbody(hitB).NewRet(hUndef)
                b2 = nextB
            }
            callExt(b2, "js_throw", [callExt(b2, "js_scope_get", [curScopeV, emitStr(b2, "__caught")])])
            b2.NewRet(hUndef)
            return deadBlock()
        }, false, true)
    }
    // Emit the js_try call and the control-signal dispatch. Returns {b, v}: v is the
    // value of whichever clause completed (undefined for statement bodies), valid on the
    // returned block, where no signal is pending any more.
    function emitTry(b, p) {
        // The try and catch bodies are ctl closures (isCtl), so a return/break/
        // continue leaving them becomes a control signal that excDispatch re-issues.
        var tryClo = callExt(b, "js_closure", [handle(emitFunc([], p.tryT, false, true)), curScopeV])
        var catchClo = hUndef
        if (p.catches.length > 0) {
            catchClo = callExt(b, "js_closure", [handle(emitCatchClosure(p.catches)), curScopeV])
        }
        var finClo = hUndef
        if (p.finallyT != undefined) {
            finClo = callExt(b, "js_closure", [handle(emitFunc([], p.finallyT, false, true)), curScopeV])
        }
        var ctl = callExt(b, "js_try", [tryClo, catchClo, finClo])
        return {b: excDispatch(b, ctl), v: ctl}
    }
    function makeTry(items) {
        var p = tryParts(items)
        return function(b) { return emitTry(b, p).b }
    }
    function makeTryValue(items) {
        var p = tryParts(items)
        return function(b) { return emitTry(b, p) }
    }
    // throw e: evaluate e and raise it with js_throw (a Go panic the runtime unwinds).
    function makeThrow(e) {
        return function(b) {
            var r = e(b)
            callExt(r.b, "js_throw", [r.v])
            r.b.NewRet(hUndef) // Never reached: js_throw unwinds on the host side.
            return deadBlock()
        }
    }
    // `throw e` used as an expression (Nothing): the same js_throw, wrapped so it yields
    // a {b, v} pair. The block it hands back is dead (js_throw never returns), so the
    // placeholder value is unreachable - a phi merging it is valid but never taken.
    function makeThrowExpr(e) {
        var t = makeThrow(e)
        return function(b) { return {b: t(b), v: hUndef} }
    }
    // `return` / `break` / `continue` used as EXPRESSIONS (see ReturnExpr above). Each
    // reuses the statement emitter unchanged and only adapts its shape: a statement thunk
    // takes a block and hands back a block, an expression thunk takes a block and hands
    // back {b, v}. The block returned is dead in every case - the ret has been emitted,
    // or the branch to the loop's exit/head has - so hUndef is never read.
    function makeReturnExpr(items, nonLocal) {
