                bb.NewCall(ktGtod, [tv, llvm.constant.NewNull(llvm.types.I8Ptr)])
                var i32z = llvm.constant.NewInt(llvm.types.I32, 0)
                var secV = bb.NewLoad(i64, bb.NewGetElementPtr(tvTy, tv, [i32z, i32z]))
                var usecW = bb.NewLoad(i64, bb.NewGetElementPtr(tvTy, tv, [i32z, llvm.constant.NewInt(llvm.types.I32, 1)]))
                var usecV = bb.NewSExt(bb.NewTrunc(usecW, llvm.types.I32), i64)
                usV = callExt(bb, "js_num_i", [bb.NewAdd(bb.NewMul(secV, handle(1000000)), usecV)])
            }
