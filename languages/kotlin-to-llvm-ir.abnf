                // member reads, and an unguarded concatenation there would cost every
                // field read of every program a string build; with the flag, only a
                // receiver that actually owns a nested class pays anything at all.
                callExt(b, "js_set", [holderV, emitStr(b, "__hasncls"), hTrue])
                callExt(b, "js_set", [holderV, emitStr(b, "__ncls_" + nested[nc].name), declV])
                if (alsoV != null) {
                    callExt(b, "js_set", [alsoV, emitStr(b, "__hasncls"), hTrue])
                    callExt(b, "js_set", [alsoV, emitStr(b, "__ncls_" + nested[nc].name), declV])
                }
            }
        }
        return b
    }
    // A runtime function emitted into the module: its own IR function over a fresh
    // scope, a body built by bodyEmit(entryBlock, argsHandle) -> {b, v}, and a return.
    // The declaration site wraps the index with js_closure.
    function emitKtLib(bodyEmit) {
        funcCount++
        var idx = funcCount
        var f = m.NewFunc("jsf_" + idx, i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var savedF = curF, savedScope = curScopeV, savedLoops = loopStack, savedTag = curFTag
        curF = f
        curFTag = idx
        loopStack = []
        var b = f.NewBlock("entry")
        curScopeV = callExt(b, "js_scope_new", [f.Params[0]])
        var r = bodyEmit(b, f.Params[1])
        r.b.NewRet(r.v)
        curF = savedF
        curScopeV = savedScope
        loopStack = savedLoops
        curFTag = savedTag
        return idx
    }
    // ----- sequence { ... }: kotlin.sequences' SequenceBuilder -----
    // `sequence` answers {__ktseq, gf}: gf is a generator FUNCTION (js_genfn) over the
    // block, so each run of the sequence - a cursor, js_ktiter in abnf/jsrtkotlin.go -
    // runs the block on a generator of its own, and `yield` (js_yield) parks it at any
    // depth of calls until the next pull. With no argument `yield` is
    // kotlinx.coroutines' yield(), which suspends nothing here. Twin of
    // hostGlobals["sequence"] in kotlin-interpreter.abnf.
    function libSeqBuild(b, argsH) {
        var sc = callExt(b, "js_scope_new", [curScopeV])
        callExt(b, "js_scope_decl", [sc, emitStr(b, "0blk"), callExt(b, "js_arg", [argsH, handle(0)])])
        var gf = callExt(b, "js_genfn", [callExt(b, "js_closure", [handle(emitKtLib(libSeqBody)), sc])])
        var seq = callExt(b, "js_obj_new", [])
        callExt(b, "js_set", [seq, emitStr(b, "__ktseq"), hTrue])
        callExt(b, "js_set", [seq, emitStr(b, "gf"), gf])
        return {b: b, v: seq}
    }
