        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "exitProcess"),
                                     callExt(b, "js_scope_get", [curScopeV, emitStr(b, "exit")])])
        // java.lang.Math, declared only for a program that names Math and does not
        // declare it (js_ktglobal's ktJavaMath in abnf/jsrtktmath.go); without it the
        // name would reach the host's own Math.
        // The java.util collection constructors (ktJavaCollection) the same way.
        var ktOnDemand = ["Math", "ArrayList", "HashSet", "LinkedHashSet", "HashMap", "LinkedHashMap"]
        for (var kd = 0; kd < ktOnDemand.length; kd++) {
