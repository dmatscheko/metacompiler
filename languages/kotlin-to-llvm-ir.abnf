        return function(b) {
            if (rec.getter == null) {
                callExt(b, "js_scope_decl", [curScopeV, emitStr(b, rec.name), hUndef])
                return b
            }
            var cl = callExt(b, "js_closure", [handle(emitFunc([], rec.getter, false)), curScopeV])
            var v = callExt(b, "js_call", [cl, hUndef, callExt(b, "js_arr_new", [])])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, rec.name), v])
