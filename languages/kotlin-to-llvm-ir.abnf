    // ----- Parameters, defaults, vararg and named arguments -----
    // A parameter: {name, def, vararg}. The default is an expression thunk emitted
    // INSIDE the callee (so it can read the earlier parameters and `this`), exactly
    // where Kotlin evaluates it.
    function makeParam(items) {
        var rec = {name: null, def: null, vararg: false, ty: ""}
        for (var i = 0; i < items.length; i++) {
            if (items[i].pname != undefined) { rec.name = items[i].pname }
            else if (items[i].pdef != undefined) { rec.def = items[i].pdef }
            else if (items[i].isvararg != undefined) { rec.vararg = true }
            else if (items[i].pty != undefined) { rec.ty = items[i].pty }
