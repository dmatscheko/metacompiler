            // rather than put an own field on the receiver. See extPropSetResolves and
            // the field-assign emitter. (dispatchless: args[0] is the receiver, args[1]
            // the value.)
            if (rec.setter != null) {
                var si = emitFunc([rec.setParam], rec.setter, true)
                callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "extps$" + rec.name),
                                             callExt(b, "js_closure", [handle(si), curScopeV])])
            }
