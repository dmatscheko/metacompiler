    // bare js_ktfget cannot be, because three of its receiver shapes abort rather
    // than miss (jsrtkotlin.go's js_ktfget and its layer-2 twin, in the same order):
    //
    //   * null / undefined - the shared js_get FAILS on nil rather than answering
    //     undefined, which is the whole reason kt_safeget exists;
    //   * a CLASS LITERAL ({__kclass}) - `fail("member .X of a class literal")` for
    //     anything outside simpleName/qualifiedName/name/java/javaClass/
    //     javaObjectType, so `with(C::class) { anythingElse }` would abort where the
    //     dispatch / implicit-receiver-stack arms below still have the answer;
    //   * a PACKAGE object ({__pkg}) - ktPkgMember resolves a sub-package or a
    //     global and has no miss either.
    //
    // An UNBOUND callable reference is the fourth and is deliberately NOT guarded:
    // it is a host FUNCTION, no property distinguishes it from an ordinary closure
    // from inside emitted IR, and it reaches the bare js_ktfget on the non-object arm.
    function rtKtFProbe() {
        return rtFunc("kt_fprobe", 2, function(b, ps) {
            var v = ps[0]
            var noB = curF.NewBlock("")
            var c1 = curF.NewBlock("")
            var c2 = curF.NewBlock("")
            var c3 = curF.NewBlock("")
            var okB = curF.NewBlock("")
            b.NewCondBr(truthy(b, callExt(b, "js_seq", [v, hNull])), noB, c1)
            c1.NewCondBr(truthy(c1, callExt(c1, "js_seq", [v, hUndef])), noB, c2)
