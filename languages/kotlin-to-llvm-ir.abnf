            if (e == "n") { return 10 }
            if (e == "t") { return 9 }
            if (e == "r") { return 13 }
            if (e == "b") { return 8 }
            if (e == "0") { return 0 }
            if (e == "u") { return parseInt(t.substring(3, 7), 16) }
            return e.charCodeAt(0)
