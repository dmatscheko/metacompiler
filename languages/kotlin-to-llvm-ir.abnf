    function makeReturn(items, nonLocal) {
        var t = items.length > 0 ? items[0] : null
        return function(b) {
            var v = hUndef
            if (t != null) {
                var r = t(b)
                b = r.b
                v = r.v
            }
            if (nonLocal == true) { return retNonLocal(b, v) }
            return retStmt(b, v) // plain ret, or a control signal when leaving a try body
        }
    }
    // ----- non-local return: the marker protocol -----
    // A `return` inside a lambda cannot ret the enclosing frame (the lambda is its own IR
    // function, and the higher-order callee in between is the runtime's). It raises a
    // marker object instead, and the enclosing function's body - wrapped by wrapNonLocal
    // - catches it and returns its value. This is the untyped stand-in for the inlining
    // real Kotlin performs; a user catch(e: Exception) between the two would see the
    // marker, which is the one visible difference.
    function retNonLocal(b, v) {
        var mV = callExt(b, "js_obj_new", [])
        callExt(b, "js_set", [mV, emitStr(b, "__nlret"), hTrue])
        callExt(b, "js_set", [mV, emitStr(b, "__nlvalue"), v])
        callExt(b, "js_throw", [mV])
        b.NewRet(hUndef) // Never reached: js_throw unwinds on the host side.
        return deadBlock()
    }
    // The catch body of the wrapper: a marker becomes this function's return value,
    // anything else is re-raised unchanged. The object test comes first, so a thrown
    // string or number is never probed for a property.
    function nlCatchBody(b) {
        var mV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, "__nl")])
        var objB = curF.NewBlock("")
        var reB = curF.NewBlock("")
        var hitB = curF.NewBlock("")
        var isObj = b.NewAnd(truthy(b, callExt(b, "js_seq", [callExt(b, "js_typeof", [mV]), emitStr(b, "object")])),
                             truthy(b, callExt(b, "js_sne", [mV, hNull])))
        b.NewCondBr(isObj, objB, reB)
        objB.NewCondBr(truthy(objB, callExt(objB, "js_get", [mV, emitStr(objB, "__nlret")])), hitB, reB)
        hitB.NewRet(callExt(hitB, "js_get", [mV, emitStr(hitB, "__nlvalue")]))
        callExt(reB, "js_throw", [mV])
        reB.NewRet(hUndef)
        return deadBlock()
    }
    // Wrap a function body so a non-local return inside it lands here. The body becomes a
    // ctl closure (so an ORDINARY return leaving it still travels as a control signal that
    // excDispatch re-issues), and js_try routes the marker to nlCatchBody.
    function wrapNonLocal(bodyT) {
        return function(b) {
            var tryClo = callExt(b, "js_closure", [handle(emitFunc([], bodyT, false, true)), curScopeV])
            var catchClo = callExt(b, "js_closure", [handle(emitFunc(["__nl"], nlCatchBody, false, false)), curScopeV])
            var ctl = callExt(b, "js_try", [tryClo, catchClo, hUndef])
            var nb = excDispatch(b, ctl)
            nb.NewRet(ctl)
            return deadBlock()
        }
