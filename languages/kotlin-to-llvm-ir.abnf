    function libSeqYieldAll(b, argsH) {
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "$a"), callExt(b, "js_ktiter", [callExt(b, "js_arg", [argsH, handle(0)])])])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "$i"), emitNum(b, 0)])
        var headB = curF.NewBlock("")
        var bodyB = curF.NewBlock("")
        var exitB = curF.NewBlock("")
        b.NewBr(headB)
        var iV = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, "$i")])
        var aV = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, "$a")])
        emitForMore(headB, iV, aV, callExt(headB, "js_get", [aV, emitStr(headB, "length")]), bodyB, exitB)
        var iV2 = callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, "$i")])
        var aV2 = callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, "$a")])
