    // java.lang.String.hashCode over the class NAME, computed at compile time. It is what
    // the interpreter half's kHash answers for an instance of a class WITHOUT structural
    // equality (`return strHash(cls.__name)`), so the two halves agree by construction.
    function ktNameHash(sv) {
        var h = 0
        for (var i = 0; i < sv.length; i++) { h = (Math.imul(31, h) + sv.charCodeAt(i)) | 0 }
        return h
    }
    // hashCode() for a class with no structural equality: the constant above. Kotlin's
    // own default is an identity hash, which this value model cannot expose; the class
    // name is the only stable thing it has, and the interpreter half made the same
    // choice. Emitting it on EVERY class descriptor is also what makes hashCode() work
    // for a NESTED instance: the structural fold below reaches it through js_ktsmcall.
    function emitNameHashFunc(name) {
        var hv = ktNameHash(name)
        return emitFunc([], function(bb) {
            bb.NewRet(emitNum(bb, hv))
            return deadBlock()
        }, true)
    }
    // hashCode() for a data / value class: Kotlin's structural fold, 31 * acc + the
    // property's own hash, truncated to a 32 bit signed Int at every step - the same
    // recurrence the interpreter's kHash runs over __dataProps. A null (or absent)
    // property contributes 0, which is why each element needs its own branch rather
    // than a select: js_ktsmcall would abort on null.
    function emitHashCodeFunc(name, props) {
        return emitFunc([], function(bb) {
            var thisV = callExt(bb, "js_scope_get", [curScopeV, emitStr(bb, "this")])
            var acc = anytype
            acc = emitNum(bb, 0)
            var b2 = anytype
            b2 = bb
            for (var k = 0; k < props.length; k++) {
                var pv = callExt(b2, "js_get", [thisV, emitStr(b2, props[k])])
                var nullB = curF.NewBlock("")
                var valB = curF.NewBlock("")
                var mrgB = curF.NewBlock("")
                b2.NewCondBr(truthy(b2, callExt(b2, "js_eq", [pv, hNull])), nullB, valB)
                var zeroV = emitNum(nullB, 0)
                nullB.NewBr(mrgB)
                var hv = callExt(valB, "js_ktsmcall", [pv, emitStr(valB, "hashCode"),
                                                      callExt(valB, "js_arr_new", [])])
                valB.NewBr(mrgB)
                var ph = mrgB.NewPhi([llvm.ir.NewIncoming(zeroV, nullB), llvm.ir.NewIncoming(hv, valB)])
                var sum = callExt(mrgB, "js_jadd", [callExt(mrgB, "js_mul", [acc, emitNum(mrgB, 31)]), ph])
                acc = callExt(mrgB, "js_ktadopt", [sum, emitNum(mrgB, 32), hFalse])
                b2 = mrgB
            }
            b2.NewRet(acc)
            return deadBlock()
        }, true)
    }
    // Emit the synthesized members onto clsV. isData also gets componentN and copy;
    // a value class gets only the equality/rendering pair, like Kotlin.
    function emitDataMembers(b, clsV, name, cparams, isData, own) {
        var props = dataProps(cparams)
        if (props.length == 0) { return b }
        if (own["$equals"] != true) {
            callExt(b, "js_set", [clsV, emitStr(b, "equals"),
                                  callExt(b, "js_closure", [handle(emitEqualsFunc(name, props)), curScopeV])])
        }
        if (own["$toString"] != true) {
            callExt(b, "js_set", [clsV, emitStr(b, "toString"),
                                  callExt(b, "js_closure", [handle(emitToStringFunc(name, props)), curScopeV])])
        }
        if (own["$hashCode"] != true) {
            callExt(b, "js_set", [clsV, emitStr(b, "hashCode"),
                                  callExt(b, "js_closure", [handle(emitHashCodeFunc(name, props)), curScopeV])])
        }
        if (!isData) { return b }
        for (var k = 0; k < props.length; k++) {
            callExt(b, "js_set", [clsV, emitStr(b, "component" + (k + 1)),
                                  callExt(b, "js_closure", [handle(emitComponentFunc(props[k])), curScopeV])])
        }
        if (own["$copy"] != true) {
            callExt(b, "js_set", [clsV, emitStr(b, "copy"),
                                  callExt(b, "js_closure", [handle(emitCopyFunc(name, props)), curScopeV])])
        }
        return b
    }

    // ----- nested and inner classes -----
    // makeClassStmt records the name it just declared so the enclosing NestedClass tag,
    // which runs immediately afterwards, can name its factory.
    var lastDeclaredClass = null

    // ----- Top-level class declarations are emitted in TOPOLOGICAL order -----
    // Kotlin does not require a class to be declared before the one that extends it:
    //     class Inh : Base() { fun q() = v }
    //     open class Base { val v = 5 }
    // is legal, and forward-referenced FUNCTIONS already worked in both halves. This
    // half emitted the top level in SOURCE order, and a class statement resolves its
    // supertype with a scope read at the moment it runs - so the program aborted with
    // "js runtime error: variable not defined: Base" while the interpreter half, whose
    // class declarations all register during the walk and whose parents resolve lazily,
    // answered 5. The same read is what an INTERFACE supertype does, so
    //     class Impl : Iface { override fun f() = 1 }
    //     interface Iface { fun f(): Int; fun g(): Int = f() + 10 }
    // failed identically; one fix covers both. (interfaceMethods itself is NOT the
    // problem it was thought to be: makeClassStmt's tag body runs during the walk but
    // the thunk it returns runs in buildMain, after the whole file has been walked, so
    // the signature table is complete by then - only the scope READ was early.)
    //
    // Only the class items among the top-level items are permuted; every other
    // statement keeps its slot, so a top-level property initializer still runs where it
