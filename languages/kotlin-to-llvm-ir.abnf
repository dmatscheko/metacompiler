                var nullB = curF.NewBlock("")
                var valB = curF.NewBlock("")
                var mrgB = curF.NewBlock("")
                b2.NewCondBr(truthy(b2, callExt(b2, "js_eq", [pv, hNull])), nullB, valB)
                var zeroV = emitNum(nullB, 0)
