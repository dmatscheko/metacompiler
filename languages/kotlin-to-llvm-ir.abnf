            var argsV = callExt(bb, "js_arr_new", [])
            callExt(bb, "js_arr_push", [argsV, objV])
            for (var k = 0; k < props.length; k++) {
                var pv = callExt(bb, "js_scope_get", [curScopeV, emitStr(bb, props[k])])
                var absent = truthy(bb, callExt(bb, "js_seq", [pv, hUndef]))
                var own = callExt(bb, "js_get", [thisV, emitStr(bb, props[k])])
                callExt(bb, "js_arr_push", [argsV, bb.NewSelect(absent, own, pv)])
