    // ----- secondary constructors -----
    // items = [{params...}, {cdeleg}?, bodyThunk?]
    function makeSecondaryCtor(items) {
        var sig = items[0]
        var deleg = null
        var body = null
        for (var i = 1; i < items.length; i++) {
            if (items[i] != undefined && items[i].cdeleg != undefined) { deleg = items[i].cdeleg }
            else { body = items[i] }
        }
        var kind = null
        var args = []
        if (deleg != null) {
            for (var d = 0; d < deleg.length; d++) {
                if (deleg[d].dkind != undefined) { kind = deleg[d].dkind }
                else { args.push(deleg[d]) }
            }
        }
        return {sig: sig, kind: kind, args: args, body: body}
    }
    // One secondary constructor: run the delegation on the same instance, then the body.
    // clsName is this class's own name, which the `: this(...)` arm needs: an explicit
    // `this` delegation goes through the class's __ctor DISPATCHER so that it reaches
    // the secondary constructor of matching arity (`class A { val v: Int;
    // constructor(n: Int) { v = n * 2 }; constructor() : this(5) {} }` gives A().v ==
    // 10). An IMPLICIT delegation (kind == null) goes straight to the primary -
    // dispatching that by arity would send a bodiless `constructor(n: Int)` to the
    // zero-argument secondary that delegates back to it.
    function emitSecondaryCtor(sec, primaryIdx, supName, clsName) {
        var bodyT = function(b) {
            var thisV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, "this")])
            var argsV = callExt(b, "js_arr_new", [])
            callExt(b, "js_arr_push", [argsV, thisV])
            var dargs = orderArgs(sec.args, undefined)
            for (var i = 0; i < dargs.length; i++) {
                var r = dargs[i].at(b)
                b = r.b
                callExt(b, "js_arr_push", [argsV, r.v])
            }
            if (sec.kind == "super" && supName != null) {
                var supV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, supName)])
                callExt(b, "js_call", [callExt(b, "js_get", [supV, emitStr(b, "__ctor")]), hUndef, argsV])
                // This class's own property initializers and init blocks still have to
                // run: with no primary constructor they belong to whichever secondary
                // constructor executes. The primary is emitted for such a class anyway
                // (empty parameter list, no supertype arguments - those live in the
                // `: super(...)` just run), so calling it with the instance alone
                // contributes exactly the initializer pass, so a `val` or an `init`
                // block beside a `: super(...)` constructor is assigned.
                var ownV = callExt(b, "js_arr_new", [])
                callExt(b, "js_arr_push", [ownV, thisV])
                callExt(b, "js_call", [callExt(b, "js_closure", [handle(primaryIdx), curScopeV]), hUndef, ownV])
            } else if (sec.kind == "this" && clsName != null) {
                var selfClsV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, clsName)])
                callExt(b, "js_call", [callExt(b, "js_get", [selfClsV, emitStr(b, "__ctor")]), hUndef, argsV])
            } else {
                callExt(b, "js_call", [callExt(b, "js_closure", [handle(primaryIdx), curScopeV]), hUndef, argsV])
            }
