    // ----- delegated properties (the getValue/setValue protocol) -----
    // A MEMBER `val/var x by d` is an accessor property whose pair is synthesized: the
    // delegate lands in the instance field `x$delegate` (one more entry in the
    // initializer list, so it is evaluated in declaration order like every other
    // property initializer) and the descriptor gets a js_defprop pair that routes reads
    // and writes through it. Both accessors are installed for a `val` too, exactly as
    // installMembers does in kotlin-interpreter.abnf.
    // items = [{apname}, {dsrc}] -> the accprop record splitMembers and emitAccessorPair
    // consume, marked isDeleg.
    function makeDelegProp(items, pos) {
        var rec = {name: null, init: null, getter: null, setter: null, setParam: "value",
                   isDeleg: true, dsrc: null, dwhere: c.file + ":" + c.lineOf(pos)}
        for (var i = 0; i < items.length; i++) {
            if (items[i] == undefined || items[i] == null) { continue }
            if (items[i].apname != undefined) { rec.name = items[i].apname }
            else if (items[i].dsrc != undefined) { rec.dsrc = items[i].dsrc }
        }
        return rec
    }
    // The hidden field a member delegate is stored in.
    function delegField(name) { return name + "$delegate" }
    // The initializer thunk for that field: evaluate the `by` expression and check it
    // really is a delegate. js_ktdcheck warns (or fails) exactly as notImpl does.
    function delegInitThunk(rec) {
        var src = rec.dsrc
        var where = rec.dwhere
        return function(b) {
            var r = src(b)
            var bb = r.b
            return {b: bb, v: callExt(bb, "js_ktdcheck",
                                      [r.v, emitStr(bb, where), c.warnUnsupported ? hTrue : hFalse,
                                       bb.NewCall(rtDThis(), [curScopeV]), emitStr(bb, rec.name)])}
        }
    }
