        }
        return emitFunc(sec.sig.params, bodyT, true, false, sec.sig)
    }
    // The __ctor the call sites see when a class has secondary constructors: a dispatcher
    // that picks by argument count (the instance occupies slot 0, hence the +1).
    function emitCtorDispatch(primaryIdx, primaryArity, secs) {
        funcCount++
        var idx = funcCount
        var f = m.NewFunc("jsf_" + idx, i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var savedF = curF, savedScope = curScopeV, savedLoops = loopStack, savedTag = curFTag
        curF = f
        curFTag = idx
        loopStack = []
        var b = f.NewBlock("entry")
        curScopeV = callExt(b, "js_scope_new", [f.Params[0]])
        var argsV = f.Params[1]
