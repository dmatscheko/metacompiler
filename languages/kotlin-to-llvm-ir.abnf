    // lambda's value, rethrow everything else (another label, a real exception, the
    // non-local-return marker).
    function lamCatchBody(lbl) {
        return function(b) {
            var mV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, "__lr")])
            var objB = curF.NewBlock("")
            var reB = curF.NewBlock("")
            var hitB = curF.NewBlock("")
            var isObj = b.NewAnd(truthy(b, callExt(b, "js_seq", [callExt(b, "js_typeof", [mV]), emitStr(b, "object")])),
