    function emitAccessorPair(b, clsV, rec) {
        if (rec.isDeleg == true) { return emitDelegPair(b, clsV, rec) }
        var savedField = emitBackingField
        emitBackingField = backingName(rec.name)
        var getV = hUndef
        var setV = hUndef
        if (rec.getter != null) {
            getV = callExt(b, "js_closure", [handle(emitFunc([], rec.getter, false, false, undefined, true)), curScopeV])
        }
        if (rec.setter != null) {
            setV = callExt(b, "js_closure", [handle(emitFunc([rec.setParam], rec.setter, false, false, undefined, true)), curScopeV])
        }
        emitBackingField = savedField
