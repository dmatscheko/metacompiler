            bodyT(bodyB).NewBr(postB)
            loopStack.pop()
            var iV2 = callExt(postB, "js_scope_get", [curScopeV, emitStr(postB, cName)])
            var sV2 = callExt(postB, "js_scope_get", [curScopeV, emitStr(postB, sName)])
            var stepExt = (rop == "downTo") ? "js_sub" : "js_jadd"
            callExt(postB, "js_scope_set", [curScopeV, emitStr(postB, cName), callExt(postB, stepExt, [iV2, sV2])])
