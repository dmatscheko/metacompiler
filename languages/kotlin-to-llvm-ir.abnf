        curF = savedF
        curScopeV = savedScope
        loopStack = savedLoops
        curFTag = savedTag
        return idx
    }

    // ----- property accessors -----
    // items = [{apname}, {apinit}?, ({getter}|{setter})...] -> the record splitMembers
    // and the class emitters consume.
    function makeAccessorProp(items) {
        var rec = {name: null, init: null, getter: null, setter: null, setParam: "value"}
        for (var i = 0; i < items.length; i++) {
            if (items[i].apname != undefined) { rec.name = items[i].apname }
            else if (items[i].apinit != undefined) { rec.init = items[i].apinit }
            else if (items[i].getter != undefined) { rec.getter = items[i].getter }
            else if (items[i].setter != undefined) { rec.setter = items[i].setter; rec.setParam = items[i].setname }
