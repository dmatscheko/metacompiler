    // the constructor arguments start one slot later - but there is no enclosing
    // instance to record, because a nested class of an object is never `inner`.
    function emitNestedFactory(clsName, inner, dropRecv) {
        funcCount++
        var idx = funcCount
        var f = m.NewFunc("jsf_" + idx, i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var savedF = curF, savedScope = curScopeV, savedLoops = loopStack, savedTag = curFTag
        curF = f
        curFTag = idx
        loopStack = []
        var b = f.NewBlock("entry")
        curScopeV = callExt(b, "js_scope_new", [f.Params[0]])
        var clsV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, clsName)])
        var objV = callExt(b, "js_obj_new", [])
        callExt(b, "js_set", [objV, emitStr(b, "__class"), clsV])
