            return {b: b, v: thisV}
        }
    }
    function makeIsInit(name) {
        return function(b) {
            var thisV = callExt(b, "js_kget", [curScopeV, emitStr(b, "this")])
            return {b: b, v: callExt(b, "js_sne", [callExt(b, "js_get", [thisV, emitStr(b, name)]), hNull])}
        }
    }

    // items = [name, {cparams}?, {supers}?, ({prop}|{method}|{initblk}|{absmethod})...]
    function makeClassStmt(items) {
        var at = 0
        var dmod = null
        if (items[at] != undefined && items[at].dmod != undefined) { dmod = items[at].dmod; at++ }
        var name = items[at]
        var hdr = takeHeader(items, at + 1)
        var parts = splitMembers(items, hdr.i)
        var methods = parts.methods
        var comp = parts.companion
        classNames[name] = 1
        lastDeclaredClass = name
        ctorParamNames["$" + name] = ctorSig(hdr.cparams).params
        var own = {}
        var ownProps = {}
        for (var cp = 0; cp < hdr.cparams.length; cp++) {
            if (hdr.cparams[cp].prop) { notePropName(hdr.cparams[cp].name); ownProps["$" + hdr.cparams[cp].name] = true }
        }
        for (var pp = 0; pp < parts.props.length; pp++) { ownProps["$" + parts.props[pp].prop] = true }
        for (var ac = 0; ac < parts.accprops.length; ac++) {
            notePropName(parts.accprops[ac].name)
            ownProps["$" + parts.accprops[ac].name] = true
        }
        classOwnProps["$" + name] = ownProps
        for (var cm = 0; cm < methods.length; cm++) {
            classMethodNames["$" + methods[cm].name] = true
            methodParams["$" + methods[cm].name] = methods[cm].params
            own["$" + methods[cm].name] = true
            noteMethodClass(methods[cm].name, name)
            declOpIfConvention(methods[cm].name, name)
        }
        // A data / value class declares the equality convention (and, for data, copy's
        // named-argument slots and the componentN destructuring convention) implicitly.
        if (dmod != null) {
            var dprops = dataProps(hdr.cparams)
            if (dprops.length > 0) {
                declOp("equals", name)
                classMethodNames["$equals"] = true
                classMethodNames["$toString"] = true
                if (dmod == "data") {
                    methodParams["$copy"] = dprops
                    classMethodNames["$copy"] = true
                    for (var dc = 0; dc < dprops.length; dc++) { classMethodNames["$component" + (dc + 1)] = true }
                }
            }
        }
        if (comp != null) {
            for (var cc = 0; cc < comp.length; cc++) {
                if (comp[cc].method != undefined) { classMethodNames["$" + comp[cc].method.name] = true }
            }
        }
        return function(b) {
            var clsV = callExt(b, "js_obj_new", [])
            callExt(b, "js_set", [clsV, emitStr(b, "__isclass"), hTrue])
            callExt(b, "js_set", [clsV, emitStr(b, "__name"), emitStr(b, name)])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, name), clsV])
            b = emitSuperLinks(b, clsV, hdr.supers, own)
            b = emitDelegates(b, clsV, hdr.supers, own)
            var savedSuper = emitSuperName
            emitSuperName = (hdr.sup != null && knownType(hdr.sup.name)) ? hdr.sup.name : null
            emitClassNames.push(name)
            var ctorIdx = emitCtor(hdr.cparams, parts.inits, hdr.supers)
            var entryIdx = ctorIdx
            if (parts.sctors.length > 0) {
                var secs = []
                for (var sc = 0; sc < parts.sctors.length; sc++) {
                    secs.push({idx: emitSecondaryCtor(parts.sctors[sc], ctorIdx, emitSuperName),
                               arity: parts.sctors[sc].sig.params.length})
                }
                entryIdx = emitCtorDispatch(ctorIdx, hdr.cparams.length, secs)
            }
            callExt(b, "js_set", [clsV, emitStr(b, "__ctor"), callExt(b, "js_closure", [handle(entryIdx), curScopeV])])
            for (var k = 0; k < methods.length; k++) {
                var idx = emitFunc(methods[k].params, methods[k].body, true, false, methods[k].sig)
                callExt(b, "js_set", [clsV, emitStr(b, methods[k].name), callExt(b, "js_closure", [handle(idx), curScopeV])])
            }
            for (var ap = 0; ap < parts.accprops.length; ap++) { b = emitAccessorPair(b, clsV, parts.accprops[ap]) }
            emitClassNames.pop()
            b = emitNestedList(b, clsV, null, parts.nested, name)
            emitSuperName = savedSuper
            if (dmod != null) { b = emitDataMembers(b, clsV, name, hdr.cparams, dmod == "data", own) }
            if (comp != null) { b = emitCompanion(b, clsV, comp, parts.compName) }
            return b
        }
    }

    // ----- enum classes -----
    // items = [{ename}, argRecords...] -> one entry: its name and constructor arguments.
    function makeEnumEntry(items) {
        return {ename: items[0].ename, args: items.slice(1)}
    }
    // items = [name, {cparams}?, {supers}?, entries..., members...]
    function makeEnumStmt(items) {
        var name = items[0]
        var hdr = takeHeader(items, 1)
        var entries = []
        var i = hdr.i
        while (i < items.length && items[i] != undefined && items[i].ename != undefined) { entries.push(items[i]); i++ }
        var parts = splitMembers(items, i)
        var methods = parts.methods
        classNames[name] = 1
        lastDeclaredType = name
        ctorParamNames["$" + name] = ctorSig(hdr.cparams).params
        var own = {}
        for (var cm = 0; cm < methods.length; cm++) {
            classMethodNames["$" + methods[cm].name] = true
            methodParams["$" + methods[cm].name] = methods[cm].params
            own["$" + methods[cm].name] = true
            declOpIfConvention(methods[cm].name, name)
        }
        return function(b) {
            var clsV = callExt(b, "js_obj_new", [])
            callExt(b, "js_set", [clsV, emitStr(b, "__isclass"), hTrue])
            callExt(b, "js_set", [clsV, emitStr(b, "__name"), emitStr(b, name)])
            // The marker kotlin-interpreter.abnf sets on an enum descriptor, so that
            // js_ktstr can render an entry as its NAME (java.lang.Enum.toString)
            // instead of the Name@1 an ordinary instance gets.
            callExt(b, "js_set", [clsV, emitStr(b, "__isenum"), hTrue])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, name), clsV])
            b = emitSuperLinks(b, clsV, hdr.supers, own)
            var ctorIdx = emitCtor(hdr.cparams, parts.inits, hdr.supers)
            callExt(b, "js_set", [clsV, emitStr(b, "__ctor"), callExt(b, "js_closure", [handle(ctorIdx), curScopeV])])
            // The entry scope: the entries are declared into it AND the enum's own
            // methods close over it, so a bare entry name resolves inside them. The
            // closures capture the scope handle, so declaring the entries after the
            // methods are emitted is fine - the reads happen at call time.
            var saved = curScopeV
            curScopeV = callExt(b, "js_scope_new", [curScopeV])
            var savedSuper = emitSuperName
            emitClassNames.push(name)
            emitSuperName = (hdr.sup != null && knownType(hdr.sup.name)) ? hdr.sup.name : null
            for (var k = 0; k < methods.length; k++) {
                var idx = emitFunc(methods[k].params, methods[k].body, true, false, methods[k].sig)
                callExt(b, "js_set", [clsV, emitStr(b, methods[k].name), callExt(b, "js_closure", [handle(idx), curScopeV])])
            }
            emitClassNames.pop()
            emitSuperName = savedSuper
            for (var e = 0; e < entries.length; e++) {
                var objV = callExt(b, "js_obj_new", [])
                callExt(b, "js_set", [objV, emitStr(b, "__class"), clsV])
                var eargs = orderArgs(entries[e].args, ctorParamNames["$" + name])
                var argsV = callExt(b, "js_arr_new", [])
                callExt(b, "js_arr_push", [argsV, objV])
                for (var a = 0; a < eargs.length; a++) {
                    var ra = eargs[a].at(b)
                    b = ra.b
                    callExt(b, "js_arr_push", [argsV, ra.v])
                }
                callExt(b, "js_call", [callExt(b, "js_get", [clsV, emitStr(b, "__ctor")]), hUndef, argsV])
                callExt(b, "js_set", [objV, emitStr(b, "name"), emitStr(b, entries[e].ename)])
                callExt(b, "js_set", [objV, emitStr(b, "ordinal"), emitNum(b, e)])
                callExt(b, "js_set", [clsV, emitStr(b, entries[e].ename), objV])
                callExt(b, "js_scope_decl", [curScopeV, emitStr(b, entries[e].ename), objV])
            }
            curScopeV = saved
            b = emitNestedList(b, clsV, null, parts.nested, name)
            return b
        }
    }

    // A companion object attaches its members to the class descriptor clsV: methods go
    // into a holder that clsV.__class points at (so ClassName.m() dispatches through
    // js_mcall, which prepends clsV as the receiver), properties become fields of clsV
    // (so ClassName.prop reads them). The property initializers see clsV as 'this'.
    function emitCompanion(b, clsV, comp, compName) {
        var cparts = splitMembers(comp, 0)
        var cprops = cparts.props
        var cmethods = cparts.methods
        emitClassNames.push("<companion>")
        if (cmethods.length > 0) {
            var holderV = callExt(b, "js_obj_new", [])
            for (var k = 0; k < cmethods.length; k++) {
                var idx = emitFunc(cmethods[k].params, cmethods[k].body, true, false, cmethods[k].sig)
                callExt(b, "js_set", [holderV, emitStr(b, cmethods[k].name), callExt(b, "js_closure", [handle(idx), curScopeV])])
            }
            callExt(b, "js_set", [clsV, emitStr(b, "__class"), holderV])
        }
        for (var ap = 0; ap < cparts.accprops.length; ap++) { b = emitAccessorPair(b, clsV, cparts.accprops[ap]) }
        var saved = curScopeV
        curScopeV = callExt(b, "js_scope_new", [curScopeV])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "this"), clsV])
        for (var p = 0; p < cprops.length; p++) {
            var r = cprops[p].init(b)
            b = r.b
            callExt(b, "js_set", [clsV, emitStr(b, cprops[p].prop), r.v])
        }
        curScopeV = saved
        // A NAMED companion (companion object Maker) is also reachable through its own
        // name - Cls.Maker.SEED and Cls.Maker.of(...). The class descriptor already
        // carries the properties and (via __class) the methods, so the name is simply
        // bound to the descriptor itself rather than to a second copy.
        if (compName != null) { callExt(b, "js_set", [clsV, emitStr(b, compName), clsV]) }
        emitClassNames.pop()
        return b
    }

    // object Name { ... }: lower to a singleton backing object bound to the name at
    // program start - a descriptor holding the methods, an instance whose __class is
    // the descriptor and whose fields are the once initialized properties. The property
    // initializers see the instance as 'this' (implicit member access works); method
    // calls dispatch through js_mcall exactly like class instances.
    function makeObjectStmt(items) {
        var name = items[0]
        var hdr = takeHeader(items, 1)
        var parts = splitMembers(items, hdr.i)
        var props = parts.props
        var methods = parts.methods
        classNames[name] = 2   // A singleton: named like a class, but never constructed.
        lastDeclaredType = name
        for (var om = 0; om < methods.length; om++) { classMethodNames["$" + methods[om].name] = true }
        return function(b) {
            var r = emitObjectInstance(b, name, methods, props, hdr.supers, parts.accprops)
            b = r.b
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, name), r.v])
            // A nested type of an object hangs on the object's DESCRIPTOR, not on the
            // singleton instance: the runtime's memberCall looks a call up the __class
            // chain (which is how Outer.Nested(1) reaches the factory), and js_get on
            // an instance falls through to the same chain for a plain read.
            b = emitNestedList(b, r.cls, r.v, parts.nested, name)
            return b
        }
    }
    // interface I [: Supers] { defaults }: a descriptor with the default-method closures
    // and no __ctor. Its signature list feeds interface delegation.
    function makeInterfaceStmt(items) {
        var name = items[0]
        var hdr = takeHeader(items, 1)
        var parts = splitMembers(items, hdr.i)
        var methods = parts.methods
        interfaceNames["$" + name] = true
        lastDeclaredType = name
        var sig = []
        for (var i = 0; i < methods.length; i++) {
            sig.push({name: methods[i].name, params: methods[i].params})
            classMethodNames["$" + methods[i].name] = true
        }
        for (var a = 0; a < parts.abstracts.length; a++) {
            sig.push({name: parts.abstracts[a].name, params: parts.abstracts[a].params})
            classMethodNames["$" + parts.abstracts[a].name] = true
        }
        interfaceMethods["$" + name] = sig
        var own = {}
        for (var o = 0; o < methods.length; o++) { own["$" + methods[o].name] = true }
        return function(b) {
            var clsV = callExt(b, "js_obj_new", [])
            callExt(b, "js_set", [clsV, emitStr(b, "__isclass"), hTrue])
            callExt(b, "js_set", [clsV, emitStr(b, "__name"), emitStr(b, name)])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, name), clsV])
            b = emitSuperLinks(b, clsV, hdr.supers, own)
            var savedSuper = emitSuperName
            emitClassNames.push(name)
            emitSuperName = (hdr.sup != null && knownType(hdr.sup.name)) ? hdr.sup.name : null
            for (var k = 0; k < methods.length; k++) {
                var idx = emitFunc(methods[k].params, methods[k].body, true, false, methods[k].sig)
                callExt(b, "js_set", [clsV, emitStr(b, methods[k].name), callExt(b, "js_closure", [handle(idx), curScopeV])])
            }
            for (var ap = 0; ap < parts.accprops.length; ap++) { b = emitAccessorPair(b, clsV, parts.accprops[ap]) }
            emitClassNames.pop()
            emitSuperName = savedSuper
            b = emitNestedList(b, clsV, null, parts.nested, name)
            return b
        }
    }
    // super.m(args): js_supercall walks the __super chain from the DEFINING class's
    // superclass descriptor (emitSuperName, valid while that class's methods emit).
    function makeSuperCall(items, pos) {
        var mname = items[0].smname
        var args = items.slice(1)
        return function(b) {
            if (emitSuperName == null) { notImpl("super call outside a subclass", pos); return {b: b, v: hUndef} }
            var supV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, emitSuperName)])
            var thisV = callExt(b, "js_kget", [curScopeV, emitStr(b, "this")])
            var ea = emitArgs(b, args)
            b = ea.b
            return {b: b, v: callExt(b, "js_supercall", [supV, thisV, emitStr(b, mname), ea.v])}
        }
    }

    // The program: jsmain(env, args) declares the builtins, the top level, then calls main().
    function buildMain(items) {
        // The walk of an imported file ends here too: stash its top-level
        // statements for the real jsmain instead of emitting a second one.
        if (importDepth > 0) {
            stashImported(items) // emitted later under this file's own source (see compile-core)
            return
        }
        var f = m.NewFunc("jsmain", i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        curF = f
        var b = f.NewBlock("entry")
        curScopeV = callExt(b, "js_scope_new", [f.Params[0]])
        // listOf/mutableListOf: an IR function that simply returns its argument array.
        funcCount++
        var loIdx = funcCount
        var lo = m.NewFunc("jsf_" + loIdx, i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var lob = lo.NewBlock("entry")
        lob.NewRet(lo.Params[1])
        var loV = callExt(b, "js_closure", [handle(loIdx), curScopeV])
        // The set/array constructors collapse onto listOf: in this untyped subset a set
        // is modelled as a list (element uniqueness is not enforced). setOf()/emptyList()
        // with no arguments yields the empty list, since jsf just returns its arg array.
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "listOf"), loV])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "mutableListOf"), loV])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "arrayListOf"), loV])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "arrayOf"), loV])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "setOf"), loV])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "mutableSetOf"), loV])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "hashSetOf"), loV])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "linkedSetOf"), loV])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "sortedSetOf"), loV])
        // The typed array constructors are the same "return the argument array"
        // function: intArrayOf(1, 2) is a list of those elements in this value model.
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "intArrayOf"), loV])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "longArrayOf"), loV])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "doubleArrayOf"), loV])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "floatArrayOf"), loV])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "booleanArrayOf"), loV])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "charArrayOf"), loV])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "listOfNotNull"), loV])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "emptyList"), loV])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "emptySet"), loV])
        // abs/max/min from Math, exitProcess from exit.
        var mathV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, "Math")])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "abs"), callExt(b, "js_get", [mathV, emitStr(b, "abs")])])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "max"), callExt(b, "js_get", [mathV, emitStr(b, "max")])])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "min"), callExt(b, "js_get", [mathV, emitStr(b, "min")])])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "exitProcess"),
                                     callExt(b, "js_scope_get", [curScopeV, emitStr(b, "exit")])])
        // println / print: Kotlin's OWN rendering, not the shared println host
        // function (which hands the raw runtime value to Go's %v and printed <nil>
        // for null, [1 2] for a list and a map of pointer addresses - or a stack
        // overflow - for an instance). js_ktprint / js_ktwrite each RETURN the host
        // function, so ::println and list.forEach(::println) keep working and no
        // other language's println changes. See abnf/jsrtkotlin.go.
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "println"), callExt(b, "js_ktprint", [])])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "print"), callExt(b, "js_ktwrite", [])])
        // Kotlin's number types as VALUES, for their companion constants. Int.MAX_VALUE
        // and friends existed in neither half before ("unknown name: Int"), and
        // Long.MAX_VALUE cannot be written as a plain number at all - which is the
        // whole reason a sized integer had to exist. The twin is hostGlobals["Int"] etc
        // in kotlin-interpreter.abnf; the objects come from js_kttype
        // (abnf/jsrtkotlin.go).
        var ktNumTypes = ["Int", "Long", "Byte", "Short", "UInt", "ULong", "UByte", "UShort",
                          "Char", "Double", "Float"]
        for (var kt = 0; kt < ktNumTypes.length; kt++) {
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, ktNumTypes[kt]),
                                         callExt(b, "js_kttype", [emitStr(b, ktNumTypes[kt])])])
        }
        b = emitImported(b)   // imported files' items, each under its own source (call-graph file attribution)
        b = makeSeq(items)(b)
        // The entry point defaults to main(), but the -main flag (c.mainName) can override
        // it. A bare identifier (no '(') names a top-level function to call; anything else
        // is a snippet of Kotlin - a single statement such as greet("a", 2) - parsed with
        // the same grammar (from its Statement rule) and emitted into jsmain's scope, so it
        // can call the file's functions with real arguments.
        var mainName = c.mainName
        if (mainName == undefined || mainName == "") { mainName = "main" }
        if (mainIsSnippet(mainName)) {
            b = emitMainSnippet(b, mainName, "Statement")
            b.NewRet(emitNum(b, 0))
        } else {
            var mainV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, mainName)])
            var argsV = callExt(b, "js_arr_new", [])
            b.NewRet(callExt(b, "js_call", [mainV, hUndef, argsV]))
        }
    }

    // ----- Core library config (see lib/compile-core.js) -----
    core.scopeGetExt = "js_kget" // Scope read with fallback to properties of this.

    c.compile(c.asg)

    println(m)

    var res = llvm.RunJS(m, "jsmain")
    var entryName = c.mainName
    if (entryName == undefined || entryName == "") { entryName = "main" }
    if (mainIsSnippet(entryName)) {
        println("kotlin compiler: -main snippet returned " + res.Ret)
    } else {
        println("kotlin compiler: " + entryName + "() returned " + res.Ret)
    }
    exit(res.Ret)

~~) ;
