    // byte-identical IR.
    function wrapLamRet(bodyT, lbl) {
        return function(b) {
            var tryClo = callExt(b, "js_closure",
                                 [handle(emitFunc([], bodyT, false, true,
                                                  {params: [], defs: [], tys: [], varargAt: -1, rty: curRetTy})),
                                  curScopeV])
            var catchClo = callExt(b, "js_closure",
                                   [handle(emitFunc(["__lr"], lamCatchBody(lbl), false, false)), curScopeV])
            var ctl = callExt(b, "js_try", [tryClo, catchClo, hUndef])
            var nb = excDispatch(b, ctl)
            nb.NewRet(ctl)
            return deadBlock()
        }
