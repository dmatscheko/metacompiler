    // js_kteq and not js_seq: a property holding a LIST or a MAP compares
    // element-wise, and a property holding another data instance goes through that
    // class's own equals (`data class D(val a: Int, val b: List<Int>)` equals an equal
    // copy).
    function emitEqualsFunc(name, props) {
        return emitFunc(["other"], function(bb) {
            var thisV = callExt(bb, "js_scope_get", [curScopeV, emitStr(bb, "this")])
            var otherV = callExt(bb, "js_scope_get", [curScopeV, emitStr(bb, "other")])
            var cmpB = curF.NewBlock("")
            var noB = curF.NewBlock("")
            bb.NewCondBr(truthy(bb, callExt(bb, "js_is_type", [otherV, emitStr(bb, name)])), cmpB, noB)
