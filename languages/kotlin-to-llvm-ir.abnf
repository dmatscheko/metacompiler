    // (the lambda we are in, or the function itself); otherwise it is a non-local return
    // to an OUTER lambda, which the subset cannot express.
    function makeReturnAt(items, pos) {
        var lbl = items[0].rlbl
        var top = retLblTop()
        if (top != null && top.lbl == lbl) {
            return makeReturn(items.slice(1), false)
        }
        // return@outerFun from inside a lambda: the enclosing function's wrapper can
        // deliver it, exactly like a bare non-local return.
        for (var i = retLabels.length - 1; i >= 0; i--) {
            if (retLabels[i].kind == "fun" && retLabels[i].lbl == lbl) {
                retLabels[i].nl = true
                return makeReturn(items.slice(1), true)
