        if (name == "isNegative") { return {v: f < 0 || (f === 0 && (1 / f) < 0)} }
        if (name == "isEven") { return {v: dIsInt(t) && szEq(dIntMod(t, 2), 0)} }
        if (name == "isOdd") { return {v: dIsInt(t) && !szEq(dIntMod(t, 2), 0)} }
        if (name == "sign") {
