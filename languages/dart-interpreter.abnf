            return {v: szCmp(t, 0) > 0 ? 1 : (szCmp(t, 0) < 0 ? 0 - 1 : 0)}
        }
        if (name == "remainder" && args.length == 1) {
            var rf = dNum(args[0])
            if (dIsFlo(t) || dIsFlo(args[0])) { return {v: dFlo(f % rf)} }
            return {v: szArith("%", t, args[0])}
        }
