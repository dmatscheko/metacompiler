    // ----- Core library config (see lib/interp-core.js) -----
    core.lang = "dart"
    core.varMiss = function(name) {
        var self = findThis()
        if (self != undefined && self != null) {
            if (hasOwn(self, name)) { return {v: self[name]} }
            if (self.__class != undefined) {
                var g = findMember(self.__class, "get$" + name)
                if (g != null) { return {v: g.fn.apply(undefined, [self])} }
                var m = findMember(self.__class, name)
                if (m != null) { return {v: makeTearOff(self, m.fn)} }
            }
        }
        var oc = ownerClass()
        if (oc != null && hasOwn(oc.__statics, name)) { return {v: oc.__statics[name]} }
        if (hasOwn(topGetters, "$" + name)) { return {v: topGetters["$" + name]()} }
        return null
    }
    core.setMiss = function(name, value) {
        var self = findThis()
        if (self != undefined && self != null) {
            if (hasOwn(self, name)) { self[name] = value; return true }
            if (self.__class != undefined) {
                var st = findMember(self.__class, "set$" + name)
                if (st != null) { st.fn.apply(undefined, [self, value]); return true }
            }
        }
        var oc = ownerClass()
        if (oc != null && hasOwn(oc.__statics, name)) { oc.__statics[name] = value; return true }
        if (hasOwn(topSetters, "$" + name)) { topSetters["$" + name](value); return true }
        return false
    }
