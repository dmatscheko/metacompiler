    // ----- exceptions -----
    // Dart discriminates catch clauses by type (`on XeA catch (e)`), so the clause list is
    // walked in order and the first whose type matches wins; `rethrow` re-raises the value
    // the innermost running catch clause bound.
    var curExc = []
    function makeCatchClause(items) {
        var cl = {catchbody: null, catchname: undefined, catchtype: undefined}
        for (var i = 0; i < items.length; i++) {
            var it = items[i]
            if (it == undefined || it == null) { continue }
            if (typeof it == "function") { cl.catchbody = it }
            else if (hasOwn(it, "catchtype")) { cl.catchtype = it.catchtype }
            else if (hasOwn(it, "catchname")) { cl.catchname = it.catchname }
        }
        return cl
    }
    function makeRethrow() {
        return function() {
            if (curExc.length == 0) { fail("rethrow outside a catch clause") }
            throw {__exc: true, v: curExc[curExc.length - 1]}
        }
    }
    function dartTry(items) {
        var tryT = anytype, finallyT = anytype
        var clauses = []
        for (var i = 0; i < items.length; i++) {
            if (items[i].trybody != undefined) { tryT = items[i].trybody }
            else if (items[i].finbody != undefined) { finallyT = items[i].finbody }
            else { clauses.push(items[i]) }
        }
        return function() {
            var savedChain = scopes.slice()
            var box = {sig: undefined}
            try {
                box.sig = tryT()
            } catch (e) {
                scopes = savedChain.slice()
                var hit = null
                if (excIsUser(e)) {
                    for (var k = 0; k < clauses.length; k++) {
                        if (clauses[k].catchtype == undefined || dartIsType(e.v, clauses[k].catchtype)) {
                            hit = clauses[k]
                            break
                        }
                    }
                }
                if (hit == null) { throw e }
                scopes.push({})
                if (hit.catchname != undefined) { declVar(hit.catchname, e.v) }
                curExc.push(e.v)
                box.sig = hit.catchbody()
                curExc.pop()
                scopes.pop()
            } finally {
                scopes = savedChain.slice()
                if (finallyT != undefined) {
                    var fr = finallyT()
                    if (fr != undefined) { return fr }
                }
            }
            return box.sig
        }
    }

    // ----- templates -----
    function makeTemplate(items) {
        return function() {
            var out = ""
            for (var i = 0; i < items.length; i++) {
                if (items[i].s != undefined) { out = out + items[i].s }
                else { out = out + dstr(items[i].e()) }
            }
            return out
        }
    }

    // ----- ternary, return -----
    function makeCond(items) {
        if (items.length == 1) { return items[0] }
        return function() { return core.test(items[0]()) ? items[1]() : items[2]() }
    }
    function makeReturn(items) {
        var t = items.length > 0 ? items[0] : makeConst(null)
        return function() { return {isRet: true, v: t()} }
    }

    // ----- declarations, assignment, ++/-- -----
    function makeDecl(items) {
        var name = items[0]
        var init = items.length > 1 ? items[1] : makeConst(null)
        return function() { declVar(name, init()) }
    }
    function resolveRefDart(ref) {
        var o = anytype
        o = getVar(ref.name)
        for (var i = 0; i < ref.path.length - 1; i++) {
            var s = ref.path[i]
            if (s.key != undefined) { o = readMember(o, s.key) } else { o = dget(o, s.idx()) }
        }
        var last = ref.path[ref.path.length - 1]
        if (last.key != undefined) { return {obj: o, key: last.key, field: true} }
        return {obj: o, key: last.idx(), field: false}
    }
    function makeAssign(items, pos) {
        var ref = items[0]
        var op = items[1]
        var valT = items[2]
        return function() {
            var v = anytype
            if (ref.path.length == 0) {
                if (op == "??=") {
                    var cur0 = getVar(ref.name)
                    if (cur0 !== null && cur0 !== undefined) { return cur0 }
                    v = valT()
                } else {
                    v = valT()
                    if (op != "=") { v = applyOp(op, getVar(ref.name), v) }
                }
                setVar(ref.name, v)
            } else {
                var p = resolveRefDart(ref)
                if (p.field) {
                    var cur = readMember(p.obj, p.key)
                    if (op == "??=") {
                        if (cur !== null && cur !== undefined) { return cur }
                        v = valT()
                    } else {
                        v = valT()
                        if (op != "=") { v = applyOp(op, cur, v) }
                    }
                    setFieldD(p.obj, p.key, v)
                } else {
                    if (op == "??=") {
                        var cur2 = dget(p.obj, p.key)
                        if (cur2 !== null && cur2 !== undefined) { return cur2 }
                        v = valT()
                    } else {
                        v = valT()
                        if (op != "=") { v = applyOp(op, dget(p.obj, p.key), v) }
                    }
                    dsetIndexD(p.obj, p.key, v)
                }
            }
            return v
        }
