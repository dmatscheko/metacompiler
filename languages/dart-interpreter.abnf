    // ----- labels, loops and their control signals -----
    // A labeled statement hands its label to the loop it wraps through pendingLabel: the
    // loop thunk is already built when the label's tag runs, so the label has to travel at
    // RUN time. The loop picks it up (and clears it) as its first act.
    var pendingLabel = ""
    function takeLabel() {
        var l = pendingLabel
        pendingLabel = ""
        return l
    }
    function makeLabeled(items) {
        var label = items[0].slabel
        var body = items[1]
        return function() {
            pendingLabel = label
            var r = body()
            if (isSignal(r) && r.label == label && r.sig == "break") { return undefined }
            return r
        }
    }
    function isSignal(r) {
        return r != undefined && r != null && typeof r == "object" && hasOwn(r, "sig") && hasOwn(r, "label")
    }
    function makeBreakL(items) {
        if (items.length == 0) { return makeBreak() }
        var lb = items[0].label
        return function() { return {sig: "break", label: lb} }
    }
    function makeContinueL(items) {
        if (items.length == 0) { return makeContinue() }
        var lb = items[0].label
        return function() { return {sig: "continue", label: lb} }
    }
    // Route one loop-body result: "break", "continue" or "propagate" (return / a signal
    // for an OUTER label).
    function loopRoute(r, myLabel) {
        if (r === BRK) { return "break" }
        if (r === CONT) { return "continue" }
        if (myLabel != "" && isSignal(r) && r.label == myLabel) {
            return (r.sig == "break") ? "break" : "continue"
        }
        return "propagate"
    }
    // while, with label support (the shared makeWhile has none).
    makeWhile = function(bodyT, condT) {
        return function() {
            var myLabel = takeLabel()
            while (core.test(condT())) {
                var r = bodyT()
                if (r != undefined) {
                    var act = loopRoute(r, myLabel)
                    if (act == "break") { break }
                    if (act == "propagate") { return r }
                }
            }
            return undefined
        }
    }
    function makeAssert(items) {
        var cond = items[0]
        var msg = (items.length > 1) ? items[1] : null
        return function() {
            if (!core.test(cond())) { fail("assertion failed" + ((msg != null) ? ": " + dstr(msg()) : "")) }
            return undefined
        }
    }

    // ----- for and for-in -----
    function makeFor(items) {
        var bodyT = items.pop()
        var init = null, cond = null, post = null
        for (var i = 0; i < items.length; i++) {
            if (items[i].k == "init") { init = items[i].t }
            if (items[i].k == "cond") { cond = items[i].t }
            if (items[i].k == "post") { post = items[i].t }
        }
        return function() {
            var myLabel = takeLabel()
            scopes.push({})
            var res = undefined
            if (init != null) { init() }
            while (cond == null || core.test(cond())) {
                var r = bodyT()
                if (r != undefined) {
                    var act = loopRoute(r, myLabel)
                    if (act == "break") { break }
                    if (act == "propagate") { res = r; break }
