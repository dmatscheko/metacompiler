// ---


:startScript(~~

    // Shared interpreter machinery (scopes, BRK/CONT protocol, expression and statement
    // builders); Dart-specific behaviour is configured on `core` and defined below.
    include("lib/interp-core.js")

    // takeAll empties the local stack and returns the items in push order.
    // unescapeJs resolves the JS/Dart string escapes.

    var curClassName = ""

    // print(x) writes x's string form followed by a newline (Dart print).
    hostGlobals["print"] = function(x) { println(dstr(x)) }

    // ----- string rendering: Dart's Object.toString() and its overrides -----
    // This is the twin of js_dartstr / js_dartprint in abnf/jsrtdart.go (the compiler
    // half's extern), and print, string interpolation and an explicit .toString() all
    // go through it. Falling through to JavaScript's ToString - which is what this
    // used to do - rendered a List as "1,2,3", and a Map, a Set and every instance as
    // "[object Object]".
    //
    //   null            null                     Instance of 'E'   no user toString()
    //   true / false    true / false             E                 a Type (a class)
    //   [1, 2, 3]       a List                   Col.red           an enum value
    //   {a: 1}          a Map                    (1, a)            a Record
    //   {1, 2}          a Set                    Closure           a function
    //
    // A string inside a collection is NOT quoted: print(['a']) is [a].
    // Citations, from tests/reference/dart/dart-language-tests:
    //   language/regress/regress45642_test.dart:14   "should print: Instance of 'Foo'"
    //   language/records/simple/literals_and_field_access_test.dart:121
    //                                                x.toString() == "[1, 2, 3]"
    //   language/enum/enum_test.dart:62              'Enum2.A' == Enum2.A.toString()
    //   language/enum/enhanced_enums_basic_test.dart:143  a user toString() wins
    function dstr(v) { return dstrIn(v, 0) }
    function dstrIn(v, d) {
        if (d > 64) { return "..." }
        if (v === null || v === undefined) { return "null" }
        if (v === true) { return "true" }
        if (v === false) { return "false" }
        if (typeof v == "string") { return v }
        if (typeof v == "function") { return "Closure" }
        // A boxed double renders with its point (1.0, not 1); a boxed int renders its
        // exact digits (9223372036854775807, not 9223372036854776000).
        if (dIsFlo(v)) { return dFloStr(v.__flo) }
        if (szIs(v)) { return szStr(v) }
        if (Array.isArray(v)) {
            var out = "["
            for (var i = 0; i < v.length; i++) {
                if (i > 0) { out = out + ", " }
                out = out + dstrIn(v[i], d + 1)
            }
            return out + "]"
        }
        if (typeof v != "object") { return "" + v }
        if (v.__isclass === true) { return v.__name }
        if (isDict(v)) {
            var isSet = hasOwn(v, "__set")
            var o2 = "{"
            for (var j = 0; j < v.keys.length; j++) {
                if (j > 0) { o2 = o2 + ", " }
                o2 = o2 + dstrIn(v.keys[j], d + 1)
                if (!isSet) { o2 = o2 + ": " + dstrIn(v.vals[j], d + 1) }
            }
            return o2 + "}"
        }
        if (isRec(v)) {
            var o3 = "("
            for (var k = 0; k < v.keys.length; k++) {
                if (k > 0) { o3 = o3 + ", " }
                if (v.keys[k].charAt(0) != "$") { o3 = o3 + v.keys[k] + ": " }
                o3 = o3 + dstrIn(v.vals[k], d + 1)
            }
            return o3 + ")"
        }
        if (v.__class != undefined) {
            // A user toString() anywhere in the linearisation wins, for a plain class
            // and for an enum alike.
            var m = findMember(v.__class, "toString")
            if (m != null) { return "" + m.fn.apply(undefined, [v]) }
            if (v.__enumName != undefined) { return v.__class.__name + "." + v.__enumName }
            return "Instance of '" + v.__class.__name + "'"
        }
        return "" + v
    }

    // ----- Dart escapes -----
    // Dart's escape set is JS's plus \u{...} (a variable-length code point, surrogate
    // encoded so '\u{1F600}'.length is 2 like a real Dart string).
    function unescapeDart(s) {
        if (s.indexOf("\\u{") < 0) { return unescapeJs(s) }
        var out = ""
        var i = 0
        while (i < s.length) {
            var c = s.charCodeAt(i)
            if (c != 92) { out = out + s.charAt(i); i = i + 1; continue }
            if (s.charCodeAt(i + 1) == 117 && s.charCodeAt(i + 2) == 123) {
                var j = i + 3
                var cp = 0
                while (j < s.length && s.charCodeAt(j) != 125) { cp = cp * 16 + hexAt(s, j, 1); j = j + 1 }
                if (cp > 0xFFFF) {
                    var u = cp - 0x10000
                    out = out + String.fromCharCode(0xD800 + ((u / 1024) | 0)) + String.fromCharCode(0xDC00 + (u % 1024))
