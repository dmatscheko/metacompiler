    // The int side reuses the shared 64-bit pair layer of lib/interp-core.js unchanged
    // (szArith / szCmp / szEq / szNorm / i64*), which was proved against 1.3M operator
    // vectors for Go; Dart only ever asks it for the signed 64-bit width, so a program
    // that stays inside 2^53 allocates no box and runs the arithmetic it ran before.
    //
    // Corpus citations, from tests/reference/dart/dart-language-tests:
    //   language/double/to_string_test.dart          the double rendering below
    //   language/number/int64_literal_test.dart:21-25  0x8000000000000000 IS int64min,
    //                                                and int64min - 1 wraps to int64max
    //   language/number/numbers_test.dart:16-29     int and double are disjoint types
    //   language/operator/bit_operations_test.dart:26-54  64-bit shifts
    var dZeroF = 0
    var dNegOne = 0 - 1
    var dInf = 1 / dZeroF
    function dFlo(f) { return {__flo: f} }
    function dIsFlo(v) { return v != undefined && v != null && typeof v == "object" && v.__flo !== undefined }
    // dNum is the JS double reading of any Dart number: a double's payload, a boxed
    // int's nearest double, a plain number as itself.
    function dNum(v) {
        if (v != undefined && v != null && typeof v == "object") {
            if (v.__flo !== undefined) { return v.__flo }
            if (v.__sz === true) { return szNum(v) }
        }
        return v
    }
    function dIsNum(v) { return typeof v == "number" || dIsFlo(v) || szIs(v) }
    function dIsInt(v) { return typeof v == "number" || szIs(v) }
    // dInt normalises any numeric operand to an int, truncating a double toward zero -
    // which is what toInt(), truncate() and the operand of a bitwise operator all do.
    function dInt(v) {
        if (dIsFlo(v)) { return szNorm(i64FromNum(dTrunc(v.__flo)), 64, false) }
        return v
    }
    function dTrunc(f) {
        if (f !== f || f === dInf || f === 0 - dInf) { return 0 }
        return f < 0 ? 0 - Math.floor(0 - f) : Math.floor(f)
    }
    // Dart's double.toString (language/double/to_string_test.dart): ECMAScript's
    // number-to-string, with ".0" appended when the result carries neither a point nor
    // an exponent - so 1.0 is "1.0", 1e21 is "1e+21" and 1e-7 is "1e-7". -0.0 renders
    // with its sign (to_string_test.dart:33) although JS spells it "0".
    function dFloStr(f) {
        if (f !== f) { return "NaN" }
        if (f === dInf) { return "Infinity" }
        if (f === 0 - dInf) { return "-Infinity" }
        var s = "" + f
        if (f === 0 && (1 / f) < 0) { s = "-0" }
        if (s.indexOf(".") < 0 && s.indexOf("e") < 0) { s = s + ".0" }
        return s
    }
    // The text of a number literal without its '_' digit separators (Dart 3.6) and
    // without the trailing whitespace the production consumed, ready for parseFloat.
    function dNoUnd(s) {
        var out = ""
        for (var i = 0; i < s.length; i++) {
            var ch = s.charAt(i)
            if (ch != "_") { out = out + ch }
        }
        return stripWs(out)
    }

    // ----- num's own members (dart:core num / int / double) -----
    // These did not exist at all before: `2.6.round()` failed with "method call 'round'
    // on 2". They matter far more now that int and double are distinct, because
    // toInt / toDouble are how a Dart program crosses between them. Every one of them
