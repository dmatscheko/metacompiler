                i = j + 1
                continue
            }
            out = out + unescapeJs(s.substring(i, i + 2))
            // \x.. and \u.... are longer than two characters; re-measure.
            var e = s.charCodeAt(i + 1)
            if (e == 120) { out = out.substring(0, out.length - 1) + String.fromCharCode(hexAt(s, i + 2, 2)); i = i + 4 }
            else if (e == 117) { out = out.substring(0, out.length - 1) + String.fromCharCode(hexAt(s, i + 2, 4)); i = i + 6 }
