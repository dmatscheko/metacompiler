ArrowTail   = ArrowExpr | ArrowBlock ;
ArrowExpr   <~~ push({ebody: pop()}) ~~> = "=>" AssignExpr ;
ArrowBlock  <~~ push({body: pop()}) ~~>  = Block ;

// new Type(args) - equivalent to Type(args); both construct. The operand is a whole
// member chain, so `new C.foo()` reaches the named constructor foo through the ordinary
// method-call suffix (which is exactly how an unprefixed C.foo() resolves too).
NewExpr     = KwNew CallMember ;

// f(args): a top level function, a builtin, or (when the name is a class) a constructor.
Call        <~~ push(makeCall(takeAll())) ~~>
            = Id <~~ push(up.in) ~~> [ CallTArgs ] "(" [ Arg { "," Arg } [ "," ] ] ")" ;
