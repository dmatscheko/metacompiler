            ret = runMainSnippet(entry, "Statement")
        } catch (e) {
            if (excIsUser(e)) { fail("uncaught exception: " + e.v) }
            throw e
        }
        println("dart interpreter: -main snippet returned " + ret)
    } else {
        if (!hasOwn(globalScope, entry) || typeof globalScope[entry] != "function") {
            fail("Dart programs need an int " + entry + "() function.")
        }
        try {
            ret = globalScope[entry]()
        } catch (e) {
            if (excIsUser(e)) { fail("uncaught exception: " + e.v) }
            throw e
        }
        println("dart interpreter: " + entry + "() returned " + ret)
    }
    exit(ret | 0)

