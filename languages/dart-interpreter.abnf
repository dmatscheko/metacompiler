        if (dIsFlo(k)) { return "n" + dNum(k) }
        if (szIs(k)) { return "n" + szStr(k) }
        return null
    }
    core.keyEq = function(a, b) {
        if (!dIsNum(a) || !dIsNum(b)) { return false }
        if (dIsFlo(a) || dIsFlo(b)) { return dNum(a) === dNum(b) }
        return szEq(a, b)
    }
    core.varMiss = function(name) {
        var self = findThis()
        if (self != undefined && self != null) {
            if (hasOwn(self, name)) { return {v: self[name]} }
            if (self.__class != undefined) {
                var g = findMember(self.__class, "get$" + name)
                if (g != null) { return {v: g.fn.apply(undefined, [self])} }
                var m = findMember(self.__class, name)
                if (m != null) { return {v: makeTearOff(self, m.fn)} }
            }
        }
        var oc = ownerClass()
        if (oc != null && hasOwn(oc.__statics, name)) { return {v: oc.__statics[name]} }
        if (hasOwn(topGetters, "$" + name)) { return {v: topGetters["$" + name]()} }
        // One of dart:core's errors or exceptions used as a NAME rather than called:
        // the receiver of a named constructor (ArgumentError.value(7)) or a Type
        // value. A marker object, not a class descriptor - see the dx* block.
        if (dxIsName(name)) { return {v: {__dexcType: name}} }
        // An unqualified GETTER of a non-object receiver: `extension SX on String { bool
        // e() => isEmpty; }`. The hasOwn arm at the top of this function already answers
        // `length`, because a host string's own property set is exactly {length} - but a
        // Dart getter that is not a host own property, like isEmpty, needs this arm or it
        // would fall through to "unknown name". mcall is Dart's own curated member
        // dispatch, the same one a qualified `.isEmpty` uses, so this answers exactly
        // what the qualified read would and admits no name Dart lacks.
        //
        // The guard is the receiver, and it matches the emitter's rtKGetB arm exactly:
        // NOT an object carrying a __class, since those instances were served by the two
        // arms above and handing one to mcall would turn a missing name into a zero-
        // argument call of a same-named method. mcall ABORTS on a name it cannot place,
        // so this is terminal and its diagnostic replaces "unknown name: X" for this
        // receiver shape - which is also what the compiled halves say.
        if (self != undefined && self != null) {
            var plainRecv = true
            if (typeof self == "object") { if (self.__class != undefined) { plainRecv = false } }
            if (plainRecv) { return {v: mcall(self, name, [])} }
        }
        return null
    }
    core.setMiss = function(name, value) {
        var self = findThis()
        if (self != undefined && self != null) {
            if (hasOwn(self, name)) { self[name] = value; return true }
            if (self.__class != undefined) {
                var st = findMember(self.__class, "set$" + name)
                if (st != null) { st.fn.apply(undefined, [self, value]); return true }
            }
        }
        var oc = ownerClass()
        if (oc != null && hasOwn(oc.__statics, name)) { oc.__statics[name] = value; return true }
        if (hasOwn(topSetters, "$" + name)) { topSetters["$" + name](value); return true }
        return false
    }
    // The class whose method / constructor is running (bound as __owner), or null.
    function ownerClass() {
        for (var i = scopes.length - 1; i >= 0; i--) {
            if (hasOwn(scopes[i], "__owner")) {
                var n = scopes[i]["__owner"]
                if (hasOwn(classReg, "$" + n)) { return classReg["$" + n] }
                return null
            }
        }
        return null
    }
    // identical(a, b): reference identity (structural for records, which have no identity).
    hostGlobals["identical"] = function(a, b) {
        if (isRec(a) && isRec(b)) { return recEq(a, b) }
        // Numbers have no identity separate from their value in Dart: identical(8, 8+0)
        // and identical(8.0, 8.0+0.0) are TRUE (language/number/identity_test.dart:20
        // and :31) while identical(mint, 8.0) is FALSE because the two are of different
        // types (:27), and identical(nan, nan+0.0) is TRUE
        // (language/number/identity2_test.dart:24). Since a double and a large int are
        // boxed objects here, === would have answered the opposite of all of them.
        if (dIsNum(a) || dIsNum(b)) {
            if (!dIsNum(a) || !dIsNum(b)) { return false }
            if (dIsFlo(a) != dIsFlo(b)) { return false }
            if (dIsFlo(a)) {
                var x = a.__flo
                var y = b.__flo
                if (x !== x && y !== y) { return true }              // identical(NaN, NaN)
                if (x === 0 && y === 0) { return (1 / x) === (1 / y) } // 0.0 is not -0.0
                return x === y
            }
            return szEq(a, b)
        }
        return a === b
    }
    function findThis() {
        for (var i = scopes.length - 1; i >= 0; i--) {
            if (hasOwn(scopes[i], "this")) { return scopes[i]["this"] }
        }
        return undefined
    }

    // ----- Project-file imports (import 'lib.dart';) -----
    // dart: libraries are builtins the runtime already provides, so importing one is a
    // no-op (resolveImport short-circuits on these prefixes, whole path or prefix).
    core.stdlibImports = ["dart:core", "dart:math", "dart:async", "dart:collection", "dart:convert"]

    // The URI text of an import directive, with any whitespace and the surrounding quotes
    // stripped: 'geomlib.dart' -> geomlib.dart (39 = ', 34 = ").
    function uriPath(raw) {
        var s = stripWs(raw)
        if (s.length >= 2) {
            var q = s.charCodeAt(0)
            if (q == 39 || q == 34) { s = s.substring(1, s.length - 1) }
        }
        return s
    }

    // A non-dart: import names a project file: strip a leading './', ensure the .dart
    // extension, then search the program's directory and the -i roots (c.findImport). The
    // file is parsed with this grammar and its top-level declaration thunk is run right
    // here, so its classes and functions register into the shared global scope before the
    // main file's own top level runs; only the main file's main() is the entry point. A
    // file is imported once; repeats and cycles are no-ops.
    var importedFiles = {}
    core.importFile = function(path, pos) {
        var p = path
        if (p.length >= 2 && p.substring(0, 2) == "./") { p = p.substring(2) }
        if (!(p.length >= 5 && p.substring(p.length - 5) == ".dart")) { p = p + ".dart" }
        var file = c.findImport(p)
        if (file == "") { return false }
        if (importedFiles["$" + file] == true) { return true }
        importedFiles["$" + file] = true
        var text = c.readFile(file)
        var asg = c.parse(c.agrammar, text, null, file)
        c.pushSource(file, text)
        c.compile(asg)
        var impProgT = popg()
        impProgT()
        c.popSource()
        return true
    }

    c.compile(c.asg)
    var progT = popg()

    // Run the top level (binds functions and classes), then call int main().
    progT()
    // The entry point defaults to main() but the -main flag (c.mainName) can name any
    // other top-level function.
    var entry = c.mainName
    if (entry == undefined || entry == "") { entry = "main" }
    // A user exception that escapes the entry point is reported like any runtime error.
    var ret = anytype
    if (mainIsSnippet(entry)) {
        try {
            ret = runMainSnippet(entry, "Statement")
        } catch (e) {
            if (excIsUser(e)) { fail("uncaught exception: " + dstr(e.v)) }
            throw e
        }
        println("dart interpreter: -main snippet returned " + ret)
    } else {
        if (!hasOwn(globalScope, entry) || typeof globalScope[entry] != "function") {
            fail("Dart programs need an int " + entry + "() function.")
        }
        try {
            ret = globalScope[entry]()
        } catch (e) {
            if (excIsUser(e)) { fail("uncaught exception: " + dstr(e.v)) }
            throw e
        }
        println("dart interpreter: " + entry + "() returned " + ret)
    }
    exit(ret | 0)

~~) ;
