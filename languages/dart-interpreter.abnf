RecMulti    <~~ push(makeRecord(takeAll())) ~~>
            = "(" RecField "," RecField { "," RecField } [ "," ] ")" ;
RecSingle   <~~ push(makeRecord(takeAll())) ~~>
            = "(" RecField "," ")" ;
RecNamedOne <~~ push(makeRecord(takeAll())) ~~>
            = "(" NamedRecField [ "," ] ")" ;
RecField    = NamedRecField | PosRecField ;
NamedRecField <~~ var rv = pop(); push({rname: popName2(), t: rv}) ~~>
            = Id <~~ push({rn: up.in}) ~~> ":" AssignExpr ;
PosRecField <~~ push({rname: "", t: pop()}) ~~> = AssignExpr ;

