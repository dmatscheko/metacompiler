        if (items.length == 1) { return items[0] }
        return function() {
            var out = ""
            for (var i = 0; i < items.length; i++) { out = out + dstr(items[i]()) }
            return out
        }
    }

    // ----- Dart's numbers: int is 64 bit, double is a separate type -----
    // Dart has TWO numeric types and no implicit conversion between them, and the value
    // model here is untyped, so 1 and 1.0 used to be the same JS number: print(1.0) said
