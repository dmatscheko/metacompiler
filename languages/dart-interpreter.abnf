// integer. All three accept '_' digit separators (Dart 3.6). The longest/prefixed forms
// come first because this is a PEG.
// A double may start with the point: `.5`. It comes first so the plain forms never see it.
// Dart's `int` and `double` are DIFFERENT types, so a literal has to say which one it
// is: a form with a point or an exponent builds the {__flo} double box, and a plain or
// hex digit run builds an int through the shared 64-bit pair layer (szNorm/i64FromStr in
// lib/interp-core.js), which is exact for 9223372036854775807 where parseInt is not.
// The shared NumHex/NumDec/NumInt of lib/numbers.abnf push plain parseInt/parseFloat
// values, so Dart uses its own three; NumHexDig and NumExp are still the shared ones.
NumLit      = NumLeadDot | DartHexLit | DartDecLit | DartIntLit ;
NumLeadDot  <~~ push(makeConst(dFlo(parseFloat("0" + dNoUnd(up.in))))) ~~>
            = "." :whitespace() "0"..."9" { "0"..."9" | "_" } :whitespace(Whitespace) ;
// i64FromRadix / i64FromStr SKIP every character that is not a digit of the base, so
// the "0x" prefix, the '_' separators and the trailing whitespace need no stripping.
DartHexLit  <~~ push(makeConst(szNorm(i64FromRadix(up.in, 16), 64, false))) ~~>
            = "0" ( "x" | "X" ) :whitespace() NumHexDig { NumHexDig | "_" } :whitespace(Whitespace) ;
DartDecLit  <~~ push(makeConst(dFlo(parseFloat(dNoUnd(up.in))))) ~~>
            = ( "0" | "1"..."9" ) :whitespace() { "0"..."9" | "_" }
