:title("Dart interpreter") ;
:description("Parses a practical subset of Dart and executes it directly with a tree-walking
interpreter, without generating code.

Dart is a dynamic/OO language modelled here on the js and kotlin subsets. It has: top level
and nested functions with block bodies and arrow bodies (Type name(params) => expr), typed
declarations whose type is parsed and erased (int x = 1), var/final/const, classes with
fields, methods, constructors and field-initialising formals (Rectangle(this.width)),
construction with or without new, this.field and implicit field access inside methods, List
literals [ ... ] and Map literals { key: value }, index/member access, string interpolation
with the dollar-var and dollar-brace-expr forms inside single and double quotes, if/else,
while, C-style for and for (x in coll), closures with real captured scopes, print(...), the
arithmetic + - * / ~/ % , comparisons, && || ! and the ternary operator.

Every tag composes a small closure (a thunk) out of the thunks of its children. Expression
thunks return the value; statement thunks return undefined or a signal object
(return/break/continue) that the enclosing statements route. Methods dispatch through a
class descriptor object (instances carry a __class), exactly like the compiler.

Not in the subset (accepted structurally and reported as not implemented under
-warn-unsupported, else aborting): mixins/inheritance, generics beyond being skipped,
async/await, named constructors and the null-assertion ! . The nullable type marker ? is
accepted and erased. The program must define int main(); its return value is the exit code
of the metacompiler run, so the test programs are self checking (0 on success). The same
subset is compiled to LLVM IR by dart-to-llvm-ir.abnf.") ;


// --- main rules

// Shared token productions (languages/lib).
:include("lib/cstyle-comments.abnf") ;
:include("lib/ident-dollar.abnf") ;
:include("lib/numbers.abnf") ;
:include("lib/bools.abnf") ;

:startRule(Program) ;
:whitespace(Whitespace) ;

// The merged pushes of all top level declarations become one program thunk on the global stack.
// Leading directives (import / export / part / library) are accepted and not implemented.
Program     <~~ pushg(makeSeq(takeAll())) ~~>
            = [ Shebang ] { Directive } { Statement } ;
// A leading `#!` line is a comment (tools/hello_script_test.dart ships one).
Shebang     = "#" :whitespace() "!" { ShebangCh } :whitespace(Whitespace) ;
ShebangCh   = "\x00"..."\x09" | "\x0b"..."\U0010ffff" ;

// Library directives: accepted, not implemented (there is no module system). Each pushes
// nothing, so only the statement thunks reach makeSeq.
Directive   = ImportD | ExportD | PartD | LibraryD ;
// import 'lib.dart'; maps to a project file (searched under the program's directory and the
// -i roots); a dart: import (dart:math, ...) is a builtin no-op. ImportUri captures the main
// URI with its surrounding quotes stripped and hands it to resolveImport; the show/hide
// combinators and a conditional-import URI are parsed and ignored.
ImportD     <~~ resolveImport(pop(), up.pos) ~~>
            = KwImport ImportUri { KwIf SkipParen UriStr } [ KwDeferred ] [ KwAs Id ]
              { Combinator } { KwIf SkipParen UriStr } ";" ;
ImportUri   <~~ push(uriPath(up.in)) ~~>
            = UriStr ;
ExportD     <~~ notImpl("export directive", up.pos) ~~>
            = KwExport UriStr { Combinator } { KwIf SkipParen UriStr } ";" ;
PartD       <~~ notImpl("part directive", up.pos) ~~>
            = KwPart [ KwOf ] ( UriStr | QualName ) ";" ;
LibraryD    <~~ notImpl("library directive", up.pos) ~~>
            = KwLibrary [ QualName ] ";" ;
Combinator  = ( KwShow | KwHide ) Id { "," Id } ;
UriStr      = SkipSqStr | SkipDqStr ;
QualName    = Id { "." Id } ;

// Every statement production pushes exactly one thunk: function() -> undefined | signal.
// The keyword-led statements come first: otherwise 'return x;' would parse as a variable
// declaration of a variable x with the (identifier-shaped) type 'return'.
Statement   = [ Annotations ] StatementBody ;
StatementBody = TopModDecl | Block | ClassAlias | ClassDecl | EnumDecl | MixinDecl | ExtensionDecl | TypedefDecl
            | IfCase | If | Switch | While | DoWhile | For | TryStmt | Return
            | Break | Continue | Rethrow | ThrowStmt | Yield | Assert | TopGetter | TopSetter
            | FuncDecl | VarDecl | LabeledStmt
            | Empty | PatAssign | ExprStmt ;

// A top-level `external` / `abstract` declaration: the modifier is erased and the
// declaration itself is an ordinary one. It pushes the inner statement's own thunk, so
// the item count the enclosing rule sees is unchanged.
TopModDecl  = TopMod ( ExternDecl | StatementBody ) ;
TopMod      = ( "external" | "abstract" ) KwEnd ;
// An `external` declaration has no body at all. The no-body form is confined to this
// production on purpose: offering it as an alternative of FnBodyKind made the ordinary
// statement `c1();` parse as a body-less declaration of a function named c1, which
// parses, runs and quietly returns null.
ExternDecl  = ExternFnTyped | ExternGetter | ExternSetter | ExternFnPlain ;
ExternFnTyped <~~ push(makeFuncDecl(takeAll())) ~~>
            = Type FName [ SkipAngle ] ParamList ExternBody ;
ExternFnPlain <~~ push(makeFuncDecl(takeAll())) ~~>
            = FName [ SkipAngle ] ParamList ExternBody ;
ExternGetter <~~ push(makeTopAccessor(true, takeAll())) ~~>
            = KwGet FName ExternBody | Type KwGet FName ExternBody ;
ExternSetter <~~ push(makeTopAccessor(false, takeAll())) ~~>
            = KwSet FName ParamList ExternBody | Type KwSet FName ParamList ExternBody ;
ExternBody  <~~ push({ebody: makeConst(null)}) ~~> = ";" ;

// Metadata annotations (@Foo, @Foo.bar, @Foo(args)) are parsed and erased, like in Java.
Annotations = Annotation { Annotation } ;
// `@A<int>(0)`, `@GenericClass<int, String>.new()`, `@prefix.C.named(1)`. The type
// arguments and the `.new` tear-off are part of the metadata grammar; all of it is erased.
Annotation  = "@" Id [ SkipAngle ] { "." AnnPart } [ SkipParen ] ;
AnnPart     = KwNew | Id ;

// Top-level declarations accepted structurally and reported as not implemented; their
// bodies are matched with SkipBlock so a full file parses.
// An enum is a class whose values are canonical instances: the value list comes first,
// then (after a ";") the ordinary members of an enhanced enum. Every value gets .index,
// and the enum itself a static .values list.
EnumDecl    <~~ push(makeEnumStmt(takeAll())) ~~>
            = KwEnum [ KwConst ] CName [ SkipAngle ] [ PrimaryCtor ] [ WithClause ] [ ImplementsClause ]
              "{" EnumValue { "," EnumValue } [ "," ] [ ";" { Member } ] "}" ;
EnumValue   <~~ push(makeEnumValue(takeAll())) ~~>
            = EVName [ SkipAngle ] [ EnumArgs ] ;
EVName      <~~ push({evname: up.in}) ~~> = Id ;
EnumArgs    <~~ push({eargs: takeAll()}) ~~> = "(" [ Arg { "," Arg } [ "," ] ] ")" ;

// A mixin is a class body with no constructor. Its `on` types are the superclass
// interface it may call through with super; the linearisation puts it between the using
// class and that superclass.
MixinDecl   <~~ push(makeClassStmt(takeAll())) ~~>
            = [ MixinMods ] KwMixin [ KwClass ] CName [ SkipAngle ] [ PrimaryCtor ]
              [ KwOn OnType { "," OnType } ] [ ImplementsClause ] ClassBody ;
OnType      <~~ push({con: up.in}) ~~> = TypeNamed ;

// extension Name on T { ... } adds members to an existing type; extension type N(T v)
// declares a wrapper type. The extension-type form comes first (it starts with the same
// two keywords).
ExtensionDecl = ExtensionType | ExtensionOn ;
// An extension may be ANONYMOUS: `extension on Object { ... }`. Writing the name as
// `[ EXName ]` does not work - the optional is greedy and never given back, so EXName
// matched the `on` keyword itself and KwOn then failed. Two full alternatives instead.
ExtensionOn = ExtensionNamed | ExtensionAnon ;
ExtensionNamed <~~ push(makeExtensionStmt(takeAll())) ~~>
            = KwExtension EXName [ SkipAngle ] KwOn ExtOnType "{" { Member } "}" ;
ExtensionAnon <~~ push(makeExtensionStmt(takeAll())) ~~>
            = KwExtension [ SkipAngle ] KwOn ExtOnType "{" { Member } "}" ;
EXName      <~~ push({exname: up.in}) ~~> = Id ;
ExtOnType   <~~ push({exton: up.in}) ~~> = Type ;
ExtensionType <~~ push(makeExtTypeStmt(takeAll())) ~~>
            = KwExtension KwType [ KwConst ] CName [ SkipAngle ] [ "." ETCtorName ] "(" ExtTypeField ")"
              [ ImplementsClause ] ClassBody ;
ETCtorName  = Id ;
ExtTypeField <~~ push({etfield: popName()}) ~~>
            = [ ParamMods ] Type Id <~~ push({mname: up.in}) ~~> ;

// A typedef only names a type, and all types are erased here, so it compiles to nothing.
TypedefDecl <~~ push(function() {}) ~~>
            = KwTypedef ( TypedefNew | TypedefOld | TypedefBare ) ;
TypedefNew  = Id [ SkipAngle ] "=" Type ";" ;
TypedefOld  = Type Id [ SkipAngle ] SkipParen ";" ;
// The legacy form with no return type: typedef Handler(bool e);
TypedefBare = Id [ SkipAngle ] SkipParen ";" ;

Block       <~~ push(makeBlockStmt(takeAll())) ~~>
            = "{" { Statement } "}" ;

// class Name { fields; constructors; methods }. Class modifiers (abstract, base, final,
// interface, sealed, mixin) are parsed and erased so the class still compiles.
// Inheritance/mixins are not implemented.
// A mixin application class: `class C = S with M1, M2;` declares a class whose body is
// exactly S plus the mixins, with S's constructors forwarded. It has to be tried BEFORE
// ClassDecl (both open with the same modifiers and name) and is told apart by the "=".
ClassAlias  <~~ push(makeClassStmt(takeAll())) ~~>
            = [ ClassMods ] KwClass CName [ SkipAngle ] "=" AliasSuper [ WithClause ]
              [ ImplementsClause ] ";" ;
AliasSuper  <~~ push({csuper: up.in}) ~~> = TypeNamed ;
// A PRIMARY (declaring header) constructor, Dart 3.10: `class Point(var int x, var int y);`
// declares two fields and the constructor that fills them, and the body may be just a ";".
// `class const C(...)` marks that constructor const.
ClassDecl   <~~ push(makeClassStmt(takeAll())) ~~>
            = [ ClassMods ] KwClass [ KwConst ] CName [ SkipAngle ] [ PrimaryCtor ]
              [ ExtendsClause ] [ WithClause ] [ ImplementsClause ] ClassBody ;
// A class body is a brace block or, for a header-constructor class, a bare ";".
ClassBody   = ClassBraceBody | ClassSemiBody ;
ClassBraceBody = "{" { Member } "}" ;
ClassSemiBody = ";" ;
PrimaryCtor <~~ push(makePrimaryCtor(pop())) ~~> = ParamList ;
CName       <~~ push({cname: up.in}); curClassName = up.in ~~> = Id ;
ClassMods   = { ClassMod } ;
ClassMod    = ( "abstract" | "base" | "final" | "interface" | "sealed" | "mixin" ) KwEnd ;
// The same modifiers WITHOUT "mixin": a greedy ClassMods would eat the `mixin` keyword of
// a mixin declaration itself, and this is a PEG - the committed repetition never gives it back.
MixinMods   = MixinMod { MixinMod } ;
MixinMod    = ( "abstract" | "base" | "final" | "interface" | "sealed" ) KwEnd ;
// extends contributes implementation, with contributes mixins (a later one wins over an
// earlier one) and implements contributes nothing but a nominal type.
ExtendsClause = KwExtends SuperType ;
SuperType   <~~ push({csuper: up.in}) ~~> = TypeNamed ;
WithClause  = KwWith MixinType { "," MixinType } ;
MixinType   <~~ push({cmixin: up.in}) ~~> = TypeNamed ;
ImplementsClause = KwImplements IfaceType { "," IfaceType } ;
IfaceType   <~~ push({ciface: up.in}) ~~> = TypeNamed ;

// A member is a field, a method (Type? name(params) body) or a constructor (name == the
// class name). NamedCtorMember is a named constructor - accepted, not implemented.
// Metadata annotations and member modifiers (static/covariant/external/abstract) are
// parsed and erased; getters, setters, operators and factory constructors are accepted
// and not implemented.
// One Member can declare SEVERAL things (`final int x, y;`), so the tag pushes one
// descriptor per declared member rather than a single one.
Member      <~~ pushMembers(takeAll()) ~~>
            = [ Annotations ] [ MemberMods ] MemberCore ;
MemberCore  = PrimaryBodyMember | ShortNewCtor | ShortFactoryCtor
            | GetterMember | SetterMember | OperatorMember | FactoryMember
            | NamedCtorMember | PlainFnMember | TypedFnMember | FieldMember ;
// The body part of a primary constructor: `this { ... }` / `this : x = 1 { ... }`.
PrimaryBodyMember <~~ push(makePrimaryBody(takeAll())) ~~>
            = "this" KwEnd [ CtorInit ] MemberBody ;
// The short forms a header-constructor class uses for its OTHER constructors:
// `new named() : x = 1;` is `C.named()`, `const factory() = C._;` is `const factory C()`.
ShortNewCtor <~~ push(makeCtorMember(false, takeAll())) ~~>
            = KwNew [ "." ] MName [ SkipAngle ] ParamList [ CtorInit ] MemberBody ;
ShortFactoryCtor <~~ push(makeCtorMember(true, takeAll())) ~~>
            = [ KwConst ] KwFactory ParamList ( MemberBody | FactoryRedirect ) ;
MemberMods  = MemberMod { MemberMod } ;
MemberMod   <~~ push({mmod: up.in}) ~~>
            = ( "static" | "covariant" | "external" | "abstract" ) KwEnd ;
// The bare (no return type) form is tried first: an optional leading Type would greedily
// consume the get/set/operator keyword itself (it is a valid identifier) and then commit.
// A getter becomes the class entry "get$name", a setter "set$name" and an operator its
// own symbol, so a field read / write / binary operation can find them by key.
GetterMember   <~~ push(makeAccessor("get$", takeAll())) ~~>
            = KwGet MName MemberBody | Type KwGet MName MemberBody ;
SetterMember   <~~ push(makeAccessor("set$", takeAll())) ~~>
            = KwSet MName ParamList MemberBody | Type KwSet MName ParamList MemberBody ;
OperatorMember <~~ push(makeAccessor("", takeAll())) ~~>
            = KwOperator OpName ParamList MemberBody | Type KwOperator OpName ParamList MemberBody ;
OpName      <~~ push({mn: up.in}) ~~> = OverloadableOp ;
// A factory constructor: it RETURNS an instance rather than initialising a fresh one.
FactoryMember  <~~ push(makeCtorMember(true, takeAll())) ~~>
            = [ KwConst ] KwFactory Id [ "." MName ] ParamList ( MemberBody | FactoryRedirect ) ;
FactoryRedirect <~~ push(makeFactoryRedirect(takeAll())) ~~> = "=" FRTarget ";" ;
FRTarget    <~~ push({frto: up.in}) ~~> = Type [ "." Id ] ;
OverloadableOp = "[]=" | "[]" | "==" | "<=" | ">=" | ">>>" | "<<" | ">>" | "~/"
            | "+" | "-" | "*" | "/" | "%" | "<" | ">" | "&" | "|" | "^" | "~" ;
NamedCtorMember <~~ push(makeCtorMember(false, takeAll())) ~~>
            = [ KwConst ] Id "." MName [ SkipAngle ] ParamList [ CtorInit ] MemberBody ;
PlainFnMember <~~ push(makeMember(false, takeAll())) ~~>
            = [ KwConst ] MName [ SkipAngle ] ParamList [ CtorInit ] MemberBody ;
TypedFnMember <~~ push(makeMember(true, takeAll())) ~~>
            = Type MName [ SkipAngle ] ParamList MemberBody ;
MName       <~~ push({mn: up.in}) ~~> = Id ;

// A constructor initializer list: `: assert(c), this.x = e, super(a)` or the redirect
// `: this(1, 1)`. The asserts are evaluated, the field initialisers run before the body,
// and the super / redirect call chains to the other constructor.
CtorInit    = ":" InitItem { "," InitItem } ;
InitItem    = CtorAssert | SuperCall | RedirectCall | FieldInit ;
CtorAssert  <~~ push({ciassert: takeAll()}) ~~>
            = KwAssert "(" Expression [ "," Expression ] [ "," ] ")" ;
SuperCall   <~~ push(makeSuperCall(takeAll())) ~~>
            = "super" KwEnd [ "." SCName ] "(" [ Arg { "," Arg } [ "," ] ] ")" ;
RedirectCall <~~ push(makeRedirectCall(takeAll())) ~~>
            = "this" KwEnd [ "." SCName ] "(" [ Arg { "," Arg } [ "," ] ] ")" ;
SCName      <~~ push({scname: up.in}) ~~> = Id ;
FieldInit   <~~ push(makeFieldInit(takeAll())) ~~>
            = [ "this" KwEnd "." ] FIName "=" AssignExpr ;
FIName      <~~ push({finame: up.in}) ~~> = Id ;

MemberBody  = [ AsyncMod ] MemberBodyKind ;
MemberBodyKind = MBlock | MArrow | MSemi ;
MBlock      <~~ push({body: pop()}) ~~>  = Block ;
MArrow      <~~ push({ebody: pop()}) ~~> = "=>" Expression ";" ;
MSemi       <~~ push({none: true}) ~~>   = ";" ;
AsyncMod    <~~ push({amod: up.in}) ~~> = ( "async" | "sync" ) KwEnd [ "*" ] ;

// Fields: (Type | var | final [Type]) name [= init] { , name [= init] } ; - separate
// complete alternatives so the leading-type / no-type cases never get stuck in an optional.
FieldMember = FieldVar | FieldFinalTyped | FieldFinal | FieldConstTyped | FieldConst | FieldLate | FieldTyped ;
FieldVar        = KwVar        FieldList ";" ;
FieldFinalTyped = KwFinal Type FieldList ";" ;
FieldFinal      = KwFinal      FieldList ";" ;
FieldConstTyped = KwConst Type FieldList ";" ;
FieldConst      = KwConst      FieldList ";" ;
// Same PEG-group trap as VarLate: `late final y = 1;` needs its own alternative.
FieldLate       = FieldLateFinalTyped | FieldLateFinal | FieldLateVar | FieldLateTyped ;
FieldLateFinalTyped = KwLate KwFinal Type FieldList ";" ;
FieldLateFinal      = KwLate KwFinal      FieldList ";" ;
FieldLateVar        = KwLate KwVar        FieldList ";" ;
FieldLateTyped      = KwLate Type         FieldList ";" ;
FieldTyped      = Type         FieldList ";" ;
FieldList   = FieldDecl { "," FieldDecl } ;
FieldDecl   <~~ push(makeFieldDecl(takeAll())) ~~>
            = Id <~~ push({fn: up.in}) ~~> [ "=" AssignExpr ] ;

// Function declarations (top level and nested). Two alternatives so the optional return
// type does not get stuck when it is absent.
FuncDecl    = FuncTyped | FuncPlain ;
FuncTyped   <~~ push(makeFuncDecl(takeAll())) ~~>
            = Type FName [ SkipAngle ] ParamList FnBody ;
FuncPlain   <~~ push(makeFuncDecl(takeAll())) ~~>
            = FName [ SkipAngle ] ParamList FnBody ;
FName       <~~ push({fname: up.in}) ~~> = Id ;
FnBody      = [ AsyncMod ] FnBodyKind ;
FnBodyKind  = FBlock | FArrow ;
FBlock      <~~ push({body: pop()}) ~~>  = Block ;
FArrow      <~~ push({ebody: pop()}) ~~> = "=>" Expression ";" ;

// A parameter list. this.x is a field-initialising formal; a bare or typed name is a plain
// parameter. TypedParam is tried before PlainParam (both are separate alternatives).
ParamList   <~~ push({params: takeAll()}) ~~>
            = "(" [ ParamItems ] ")" ;
ParamItems  = TailGroup | Param { "," Param } [ "," TailGroup ] [ "," ] ;
TailGroup   = NamedGroup | OptGroup ;
Param       = [ Annotations ] [ ParamMods ] ParamCore ;
ParamCore   = TypedThisParam | ThisParam | SuperParam | TypedParam | FnPlainParam | PlainParam ;
ParamMods   = ParamMod { ParamMod } ;
ParamMod    = ( "covariant" | "required" | "final" | "var" ) KwEnd ;
ThisParam   <~~ push({thisf: popName()}) ~~>
            = "this" KwEnd "." Id <~~ push({mname: up.in}) ~~> [ SkipParen ] ;
// A field-initialising formal may be written with its type: `const Pair(A this.fst)`.
TypedThisParam <~~ push({thisf: popName()}) ~~>
            = Type "this" KwEnd "." Id <~~ push({mname: up.in}) ~~> [ SkipParen ] ;
// A super parameter (2.17): IhKid(super.v) forwards v to the superclass constructor.
SuperParam  <~~ push(makeSuperParam(false, takeAll())) ~~>
            = "super" KwEnd "." Id <~~ push({mname: up.in}) ~~> [ SkipParen ] ;
// A parameter may itself be function-typed, in the old positional style:
// `void forEach(callback(E element))`, `bool test(Object error)?`.
TypedParam  <~~ push({pname: popName()}) ~~>
            = Type Id <~~ push({mname: up.in}) ~~> [ SkipAngle ] [ SkipParen ] [ "?" ] ;
FnPlainParam <~~ push({pname: popName()}) ~~>
            = Id <~~ push({mname: up.in}) ~~> [ SkipAngle ] SkipParen [ "?" ] ;
PlainParam  <~~ push({pname: up.in}) ~~> = Id ;

// Named (curly) parameters: foo({int a = 1, required int b, this.x = 0}). Optional, each
// with a default; unsupplied ones fall back to the default, else null. Marked named:true.
NamedGroup  = "{" NamedParam { "," NamedParam } [ "," ] "}" ;
NamedParam  = [ Annotations ] [ ParamMods ] NamedParamCore ;
NamedParamCore = NamedTypedThisParam | NamedThisParam | NamedSuperParam | NamedTypedParam
            | NamedFnPlainParam | NamedPlainParam ;
NamedThisParam  <~~ push(makeNamedParam(true, takeAll())) ~~>
            = "this" KwEnd "." Id <~~ push({mname: up.in}) ~~> [ "=" AssignExpr ] ;
NamedTypedThisParam <~~ push(makeNamedParam(true, takeAll())) ~~>
            = Type "this" KwEnd "." Id <~~ push({mname: up.in}) ~~> [ "=" AssignExpr ] ;
NamedSuperParam <~~ push(makeSuperParam(true, takeAll())) ~~>
            = "super" KwEnd "." Id <~~ push({mname: up.in}) ~~> [ "=" AssignExpr ] ;
NamedTypedParam <~~ push(makeNamedParam(false, takeAll())) ~~>
            = Type Id <~~ push({mname: up.in}) ~~> [ SkipParen ] [ "?" ] [ "=" AssignExpr ] ;
// `{onTimeout()?}` - function-typed with no return type, the old positional style.
NamedFnPlainParam <~~ push(makeNamedParam(false, takeAll())) ~~>
            = Id <~~ push({mname: up.in}) ~~> [ SkipAngle ] SkipParen [ "?" ] [ "=" AssignExpr ] ;
NamedPlainParam <~~ push(makeNamedParam(false, takeAll())) ~~>
            = Id <~~ push({mname: up.in}) ~~> [ "=" AssignExpr ] ;

// Optional POSITIONAL parameters: foo(int a, [int b = 2, int? c]). Positional like the
// plain ones, but a missing argument falls back to the default (else null).
OptGroup    = "[" OptParam { "," OptParam } [ "," ] "]" ;
OptParam    = [ Annotations ] [ ParamMods ] OptParamCore ;
OptParamCore = OptTypedThisParam | OptThisParam | OptSuperParam | OptTypedParam
            | OptFnPlainParam | OptPlainParam ;
// `[int? this.j]`, `[A<U> this.a = const A()]` - a typed field-initialising formal.
OptTypedThisParam <~~ push(makeOptParam(true, takeAll())) ~~>
            = Type "this" KwEnd "." Id <~~ push({mname: up.in}) ~~> [ "=" AssignExpr ] ;
OptFnPlainParam <~~ push(makeOptParam(false, takeAll())) ~~>
            = Id <~~ push({mname: up.in}) ~~> [ SkipAngle ] SkipParen [ "?" ] [ "=" AssignExpr ] ;
OptThisParam  <~~ push(makeOptParam(true, takeAll())) ~~>
            = "this" KwEnd "." Id <~~ push({mname: up.in}) ~~> [ "=" AssignExpr ] ;
OptSuperParam <~~ push(makeSuperParam(false, takeAll())) ~~>
            = "super" KwEnd "." Id <~~ push({mname: up.in}) ~~> [ "=" AssignExpr ] ;
OptTypedParam <~~ push(makeOptParam(false, takeAll())) ~~>
            = Type Id <~~ push({mname: up.in}) ~~> [ "=" AssignExpr ] ;
OptPlainParam <~~ push(makeOptParam(false, takeAll())) ~~>
            = Id <~~ push({mname: up.in}) ~~> [ "=" AssignExpr ] ;

// A type: a name with optional generics <...> (skipped) and dotted qualification, a record
// type ( (int, String) , ({int w, int h}) ) matched as a balanced paren run, and the
// Function(...) form that may follow either. Everything is parsed and erased.
Type        = TypePrim { TypeFn } ;
TypePrim    = TypeRecord | TypeFn | TypeNamed ;
TypeRecord  = SkipParen [ "?" ] ;
TypeNamed   = Id [ TypeArgs ] { "." Id [ TypeArgs ] } [ "?" ] ;
// A type-ARGUMENT list is parsed as real types, not as a balanced <...> run. The balanced
// run would happily span `i < 2; ... =>` to reach the ">" of a "=>" ten lines later and
// then find the "(" a generic call needs - which is exactly what it did.
TypeArgs    = "<" TypeArg { "," TypeArg } ">" ;
TypeArg     = Type ;
TypeFn      = KwFunction [ SkipAngle ] SkipParen [ "?" ] ;

// --- patterns (Dart 3) ---------------------------------------------------------------
// One pattern grammar serves every context (declaration, assignment, for-in, if-case,
// switch statement and switch expression). A BARE identifier is ambiguous - a binder in a
// declaration, an assignment target in a pattern assignment, a constant elsewhere - so it
// parses to an "idref" descriptor that the use site resolves (resolvePat, below).
Pattern     = PatOr ;
PatOr       <~~ push(makeOrPat(takeAll())) ~~>  = PatAnd { "||" PatAnd } ;
PatAnd      <~~ push(makeAndPat(takeAll())) ~~> = PatUnary { "&&" PatUnary } ;
PatUnary    = PatRelOp | PatPostfix ;
// A relational pattern (< 10, >= 20) compares the matched value with a constant.
PatRelOp    <~~ push(makeRelPat(takeAll())) ~~> = PatRelSym RelExpr ;
PatRelSym   <~~ push({relop: up.in}) ~~> = "==" | "!=" | "<=" | ">=" | "<" | ">" ;
PatPostfix  <~~ push(makePostPat(takeAll())) ~~>
            = PatPrimary { PatNullCheck | PatNullAssert | PatCast } ;
PatNullCheck  <~~ push({post: "?"}) ~~> = "?" ;
PatNullAssert <~~ push({post: "!"}) ~~> = "!" !"=" ;
PatCast     = KwAs PatCastType ;
PatCastType <~~ push({post: "as", ty: up.in}) ~~> = Type ;

PatPrimary  = PatList | PatMap | PatRecP | PatConstE | PatVarTyped | PatObject | PatBareId | PatConst ;
// `case const C(0.0):` - a const creation used as a constant pattern. It must come before
// PatVarTyped, which would otherwise read `const` as the TYPE and `C` as the bound name.
PatConstE   <~~ push({p: "const", t: pop()}) ~~> = ConstMember ;
PatList     <~~ push(makeListPat(takeAll())) ~~>
            = "[" [ PatListElem { "," PatListElem } [ "," ] ] "]" ;
PatListElem = PatRest | PatElemP ;
// [a, ..., b] skips the middle; [a, ...rest] binds it.
PatRest     <~~ push(makeRestPat(takeAll())) ~~> = "..." [ Pattern ] ;
PatElemP    <~~ push({pelem: pop()}) ~~> = Pattern ;
PatMap      <~~ push(makeMapPat(takeAll())) ~~>
            = "{" [ PatMapEntry { "," PatMapEntry } [ "," ] ] "}" ;
PatMapEntry <~~ var mp = pop(); push({mkey: pop(), mpat: mp}) ~~> = RelExpr ":" Pattern ;
PatRecP     <~~ push(makeRecPat(takeAll())) ~~>
            = "(" [ PatFieldP { "," PatFieldP } [ "," ] ] ")" ;
PatFieldP   = PatNamedFieldP | PatPosFieldP ;
PatNamedFieldP <~~ var fp = pop(); push({pfname: popName2(), pfpat: fp}) ~~>
            = Id <~~ push({rn: up.in}) ~~> ":" Pattern ;
PatPosFieldP <~~ push({pfname: "", pfpat: pop()}) ~~> = Pattern ;
// A typed / var / final binder: `var v`, `int a`, `final String s`.
PatVarTyped <~~ push(makeVarPat(takeAll())) ~~> = PatVarLead PatName ;
PatVarLead  = KwVar | KwFinal [ TypeNamed ] | TypeNamed ;
PatName     <~~ push({pvname: up.in}) ~~> = NotPatKw Id ;
// A zero-width guard that fails when the next word is one of the operators that may
// FOLLOW a pattern (as / when / in / is). Without it `ci as int` reads `ci` as the type
// and `as` as the variable name, and the enclosing alternative is already committed.
NotPatKw = :script(~~
    (function() {
        var i = 0
        var cc = c.peek(i)
        while (cc === 32 || cc === 9 || cc === 10 || cc === 13) { i = i + 1; cc = c.peek(i) }
        var c1 = c.peek(i + 1)
        var len = 0
        if (cc === 97 && c1 === 115) { len = 2 }                   // as
        else if (cc === 105 && (c1 === 115 || c1 === 110)) { len = 2 } // is / in
        else if (cc === 119 && c1 === 104 && c.peek(i + 2) === 101 && c.peek(i + 3) === 110) { len = 4 } // when
        if (len === 0) { return undefined }
        var n = c.peek(i + len)
        var isWord = (n >= 48 && n <= 57) || (n >= 65 && n <= 90) || (n >= 97 && n <= 122) || n === 95
        return isWord ? undefined : abnf.newToken("\x01pattern-keyword", 0)
    })()
~~) ;
// An object pattern: Type(field: subpattern, :shorthand).
PatObject   <~~ push(makeObjPat(takeAll())) ~~>
            = PatObjType "(" [ PatObjField { "," PatObjField } [ "," ] ] ")" ;
PatObjType  <~~ push({otype: up.in}) ~~> = TypeNamed ;
PatObjField = PatObjNamed | PatObjShort ;
PatObjNamed <~~ var op2 = pop(); push({pfname: popName2(), pfpat: op2}) ~~>
            = Id <~~ push({rn: up.in}) ~~> ":" Pattern ;
PatObjShort <~~ push(makeShortField(pop())) ~~> = ":" Pattern ;
// A bare name. The !"." / !"(" lookaheads keep a qualified constant (EnDir.north) and an
// object pattern out of this alternative.
PatBareId   <~~ push({p: "idref", name: up.in}) ~~> = PatBareName ;
// The `!"<"` keeps `case C<int>:` and `case List<int>:` out of here: a bare identifier
// pattern binds or names a constant and is never followed by type arguments, so without
// it PatBareId matched just the `C`, succeeded, and the case then died on the "<" with
// no way back (PEG: a committed alternative is never retried).
PatBareName = Id !"." !"(" !"<" ;
PatConst    <~~ push({p: "const", t: pop()}) ~~> = RelExpr ;

// Local variable declarations. Separate complete alternatives avoid the optional-type trap.
VarDecl     = PatVarDecl | VarLate | VarKwDecl | VarFinalTyped | VarFinal | VarConstTyped | VarConst | VarTyped ;
// A pattern variable declaration: var (a, b) = e; final [x, ...r] = e;
PatVarDecl  <~~ push(makePatDecl(takeAll())) ~~>
            = ( KwVar | KwFinal ) PatDeclHead "=" Expression ";" ;
PatDeclHead = PatList | PatMap | PatRecP ;
// `late` only delays the initialisation check, which this front end does not make, so a
// late declaration is an ordinary one (uninitialised means null).
// A GROUP of alternatives is committed once it matches: `late final y = 1;` took the
// `KwFinal Type` branch (Type = the identifier `y`), DeclTail then found the `=` and
// failed, and a PEG never retries the group. Each shape needs its own alternative.
VarLate     = VarLateFinalTyped | VarLateFinal | VarLateVar | VarLateTyped ;
VarLateFinalTyped = KwLate KwFinal Type DeclTail ;
VarLateFinal      = KwLate KwFinal      DeclTail ;
VarLateVar        = KwLate KwVar        DeclTail ;
VarLateTyped      = KwLate Type         DeclTail ;
VarKwDecl     = KwVar         DeclTail ;
VarFinalTyped = KwFinal Type  DeclTail ;
VarFinal      = KwFinal       DeclTail ;
VarConstTyped <~~ push(constifyStmt(pop())) ~~> = KwConst Type  DeclTail ;
VarConst      <~~ push(constifyStmt(pop())) ~~> = KwConst       DeclTail ;
VarTyped      = Type          DeclTail ;
DeclTail    <~~ push(makeSeq(takeAll())) ~~>
            = Declarator { "," Declarator } ";" ;
Declarator  <~~ push(makeDecl(takeAll())) ~~>
            = Id <~~ push(up.in) ~~> [ "=" AssignExpr ] ;

If          <~~ push(makeIf(takeAll())) ~~>
            = KwIf "(" Expression ")" Statement [ KwElse Statement ] ;
// if (e case pattern when guard) - the pattern's bindings are in scope in the then branch.
IfCase      <~~ push(makeIfCase(takeAll())) ~~>
            = KwIf "(" Expression KwCase Pattern [ SwGuard ] ")" Statement [ KwElse Statement ] ;
// A pattern assignment: (a, b) = (b, a); - the names must already exist.
PatAssign   <~~ push(makePatAssign(takeAll())) ~~>
            = PatDeclHead "=" Expression ";" ;

While       <~~ push(makeWhile(pop(), pop())) ~~>
            = KwWhile "(" Expression ")" Statement ;

// for (x in coll) is tried before the C-style for; both start with 'for ('.
For         = ForAwait | ForInPat | ForInTyped | ForInBare | ForCStyle ;
// await for (v in stream): with no event loop the stream is already a plain iterable.
ForAwait    = KwAwait ForInAny ;
ForInAny    = ForInPat | ForInTyped | ForInBare ;
// for (var (a, b) in pairs) - a pattern per element.
ForInPat    <~~ push(makeForInPat(takeAll())) ~~>
            = KwFor "(" ( KwVar | KwFinal ) PatDeclHead KwIn Expression ")" Statement ;
ForInTyped  <~~ push(makeForIn(takeAll())) ~~>
            = KwFor "(" ForInLead Id <~~ push(up.in) ~~> KwIn Expression ")" Statement ;
ForInBare   <~~ push(makeForIn(takeAll())) ~~>
            = KwFor "(" Id <~~ push(up.in) ~~> KwIn Expression ")" Statement ;
ForInLead   = KwVar | KwFinal | Type ;
ForCStyle   <~~ push(makeFor(takeAll())) ~~>
            = KwFor "(" [ ForInit ] ";" [ ForCond ] ";" [ ForPost ] ")" Statement ;
ForInit     <~~ push({k:"init", t:pop()}) ~~> = ForVar | ForExpr ;
ForVar      <~~ push(makeSeq(takeAll())) ~~> = ForVarHead Declarator { "," Declarator } ;
ForVarHead  = KwVar | KwFinal Type | KwFinal | Type ;
ForExpr     <~~ push(exprToStmt(pop())) ~~> = Expression ;
ForCond     <~~ push({k:"cond", t:pop()}) ~~> = Expression ;
ForPost     <~~ push({k:"post", t: makeSeq(takeAll())}) ~~> = ForPostOne { "," ForPostOne } ;
ForPostOne  <~~ push(exprToStmt(pop())) ~~> = Expression ;

Return      <~~ push(makeReturn(takeAll())) ~~>
            = KwReturn [ Expression ] ";" ;
// break / continue accept an optional target label (the labeled loop is not implemented,
// so the label warns and the break/continue still targets the innermost loop).
Break       <~~ push(makeBreakL(takeAll())) ~~>    = KwBreak [ LoopLabel ] ";" ;
Continue    <~~ push(makeContinueL(takeAll())) ~~> = KwContinue [ LoopLabel ] ";" ;
LoopLabel   <~~ push({label: up.in}) ~~> = Id ;
Empty       <~~ push(function() {}) ~~>  = ";" ;

// A switch statement over patterns. There is no fallthrough in Dart: a non-empty case
// body ends the switch, while an EMPTY body shares the next case's body (makeSwitch runs
// the first non-empty body at or after the matching case). break is allowed and swallowed.
Switch      <~~ push(makeSwitch(takeAll())) ~~>
            = KwSwitch "(" Expression ")" "{" { SwitchMember } "}" ;
// A case may carry labels (`a: case 5:`), which `continue a;` jumps to. The labels are
// parsed and erased; the jump itself is not implemented.
SwitchMember = CaseLabels SwitchMemberCore | SwitchMemberCore ;
SwitchMemberCore = SwitchCase | SwitchDefault ;
CaseLabels  = CaseLabel { CaseLabel } ;
CaseLabel   = Id ":" ;
SwitchCase  <~~ push(makeSwCase(takeAll())) ~~>
            = KwCase Pattern [ SwGuard ] ":" SwBody ;
SwitchDefault <~~ push(makeSwDefault(takeAll())) ~~>
            = KwDefault ":" SwBody ;
SwGuard     <~~ push({guard: pop()}) ~~> = KwWhen Expression ;
SwBody      <~~ push(makeSwBody(takeAll())) ~~> = { NotSwEnd Statement } ;
// A zero-width guard that stops a case body at the next `case` / `default`. Without it the
// body swallows `default: ...` as a LABELED STATEMENT (default is a plain identifier here).
NotSwEnd = :script(~~
    (function() {
        var i = 0
        var cc = c.peek(i)
        // Whitespace is NOT skipped before a :script guard, and a case body is routinely
        // followed by a trailing comment, so both have to be stepped over by hand.
        var spin = 0
        while (spin < 200000) {
            spin = spin + 1
            if (cc === 32 || cc === 9 || cc === 10 || cc === 13) { i = i + 1; cc = c.peek(i); continue }
            if (cc === 47 && c.peek(i + 1) === 47) {
                i = i + 2
                cc = c.peek(i)
                while (cc >= 0 && cc !== 10) { i = i + 1; cc = c.peek(i) }
                continue
            }
            if (cc === 47 && c.peek(i + 1) === 42) {
                i = i + 2
                cc = c.peek(i)
                while (cc >= 0 && !(cc === 42 && c.peek(i + 1) === 47)) { i = i + 1; cc = c.peek(i) }
                i = i + 2
                cc = c.peek(i)
                continue
            }
            break
        }
        var len = 0
        if (cc === 99 && c.peek(i + 1) === 97 && c.peek(i + 2) === 115 && c.peek(i + 3) === 101) { len = 4 }
        else if (cc === 100 && c.peek(i + 1) === 101 && c.peek(i + 2) === 102 && c.peek(i + 3) === 97
                 && c.peek(i + 4) === 117 && c.peek(i + 5) === 108 && c.peek(i + 6) === 116) { len = 7 }
        if (len === 0) { return undefined }
        var n = c.peek(i + len)
        var isWord = (n >= 48 && n <= 57) || (n >= 65 && n <= 90) || (n >= 97 && n <= 122) || n === 95
        return isWord ? undefined : abnf.newToken("\x01switch-member", 0)
    })()
~~) ;

DoWhile     <~~ push(makeDoWhile(takeAll())) ~~>
            = KwDo Statement KwWhile "(" Expression ")" ";" ;

// try/catch/finally and throw are implemented (excThrow/excTry, languages/lib): throw
// raises the value, catch binds it (the leftmost catch clause wins - exception types are
// parsed but not discriminated), finally always runs. return/break/continue inside a try
// still propagate to the enclosing loop or function. Each part is marked so excTry can
// tell them apart on the stack.
TryStmt     <~~ push(dartTry(takeAll())) ~~>
            = KwTry TryBody { CatchClause } [ FinallyClause ] ;
TryBody     <~~ push({trybody: pop()}) ~~>
            = Block ;
FinallyClause <~~ push({finbody: pop()}) ~~>
            = KwFinally Block ;
// Dart catch forms: `on Type catch (e)`, `on Type catch (e, st)`, `on Type { }` (no
// binding), `catch (e)`, `catch (e, st)`. The `on Type` type is parsed and discarded; the
// first binder is the caught value's name (pushed), the optional second binder (the stack
// trace) is parsed and dropped. excCatch reads [name?, blockThunk].
CatchClause <~~ push(makeCatchClause(takeAll())) ~~>
            = ( KwOn CatchType [ KwCatch "(" CatchName [ "," Id ] ")" ]
              | KwCatch "(" CatchName [ "," Id ] ")" ) Block ;
CatchType   <~~ push({catchtype: up.in}) ~~> = Type ;
CatchName   <~~ push({catchname: up.in}) ~~> = Id ;
// rethrow re-raises inside a catch. There is no current-exception register, so it is
// approximated as `throw null` (a genuine unwind carrying an undefined value).
Rethrow     <~~ push(makeRethrow()) ~~>
            = KwRethrow ";" ;
Assert      <~~ push(makeAssert(takeAll())) ~~>
            = KwAssert "(" Expression [ "," Expression ] [ "," ] ")" ";" ;
// yield / yield* inside a sync* or async* body.
Yield       <~~ push(makeYield(takeAll())) ~~> = KwYield [ YieldStar ] Expression ";" ;
YieldStar   <~~ push({ystar: true}) ~~> = "*" ;
// Top-level getters and setters: int get x => e; set x(v) { ... }
TopGetter   <~~ push(makeTopAccessor(true, takeAll())) ~~>
            = KwGet FName FnBody | Type KwGet FName FnBody ;
TopSetter   <~~ push(makeTopAccessor(false, takeAll())) ~~>
            = KwSet FName ParamList FnBody | Type KwSet FName ParamList FnBody ;
// A labeled statement (label: stmt). The label targeting is not implemented, but the
// labeled statement still runs.
LabeledStmt <~~ push(makeLabeled(takeAll())) ~~>
            = StmtLabel ":" Statement ;
StmtLabel   <~~ push({slabel: up.in}) ~~> = Id ;

// `throw e;` needs its own statement alternative BEFORE VarDecl: `throw t;` otherwise
// parses as a declaration of a variable t whose (identifier-shaped) type is `throw`.
ThrowStmt   <~~ push(exprToStmt(pop())) ~~>
            = ThrowExpr ";" ;

ExprStmt    <~~ push(exprToStmt(pop())) ~~>
            = Expression ";" ;

// Every expression production pushes exactly one thunk: function() -> value.
Expression  = AssignExpr ;
AssignExpr  = ThrowExpr | Assignment | Cascade ;
// throw is an expression in Dart (=> throw e, cond ? a : throw e). It raises its operand
// with excThrow (languages/lib), unwinding through expression evaluation to the nearest
// catch.
ThrowExpr   <~~ push(excThrow(pop())) ~~>
            = KwThrow AssignExpr ;
Assignment  <~~ push(makeAssign(takeAll(), up.pos)) ~~>
            = TargetOpAhead Target ( "+=" | "-=" | "*=" | "~/=" | "/=" | "%=" | "??=" | "&=" | "|=" | "^=" | "<<=" | ">>>=" | ">>=" | "=" ) <~~ push(up.in) ~~> AssignExpr ;

// Cascade: target..m(args)..field = v . Every section acts on the one target and the
// whole expression evaluates to that target. With no sections it is just the CondExpr,
// so ordinary expressions stay unaffected.
Cascade     <~~ push(makeCascade(takeAll())) ~~>
            = CondExpr { CascadeSection } ;
// A section is `..` (or the null-aware `?..`) then a selector chain, optionally ending in
// an assignment: ..a = 1 , ..[1] = 9 , ..m(x) , ..a.b = 2 . The assigned value is parsed
// at the conditional level, not the cascade level, so `..a = 1..[1] = 9` reads the second
// `..` as the next section of the OUTER cascade rather than a cascade on the value 1.
CascadeSection <~~ push(makeCascadeSec(takeAll())) ~~>
            = CascadeOp CascadeHead
              { MethodSfx | GenFieldSfx | FieldSfx | CallSfx | IndexSfx
              | NullMethodSfx | NullFieldSfx | NullIndexSfx | BangSfx } [ CascadeAssign ] ;
CascadeOp   <~~ push({casc: up.in}) ~~> = "?.." | ".." ;
CascadeHead = CascadeAnon | CascadeMcall | CascadeGenField | CascadeField | IndexSfx ;
// `[]..expectStaticType<Exactly<List<num>>>;` - a generic tear-off with no call, the
// cascade twin of GenFieldSfx. Before CascadeField, which would stop at the name.
CascadeGenField = Id <~~ push({kind: "field", name: up.in}) ~~> TypeArgs ;
// `buffer..{ ... }` / `buffer?..=> e`: an anonymous method as a cascade section. The
// section's value is discarded, like every other cascade section.
CascadeAnon <~~ push(makeAnonSfx(false, takeAll())) ~~> = AnonBody ;
CascadeMcall <~~ push({kind: "mcall", name: popName(), args: takeAll()}) ~~>
            = Id <~~ push({mname: up.in}) ~~> [ TypeArgs ] "(" [ Arg { "," Arg } [ "," ] ] ")" ;
CascadeField = Id <~~ push({kind: "field", name: up.in}) ~~> ;
CascadeAssign <~~ var cv = pop(); push({cassign: cv, cop: pop()}) ~~>
            = CascadeAssignOp <~~ push(up.in) ~~> CascadeValue ;
// A named production, not an inline group: a group of single-token alternatives directly
// after a :command() is read as a Times repetition (the Times trap).
CascadeAssignOp = "+=" | "-=" | "*=" | "~/=" | "/=" | "%=" | "??=" | "&=" | "|=" | "^="
            | "<<=" | ">>>=" | ">>=" | "=" ;
CascadeValue = ThrowExpr | Assignment | CondExpr ;
// A zero-width fast-fail in front of the two productions that begin with Target.
// Both `Assignment` and `IncDec` parse a whole Target before they learn whether the
// operator they need is there, and Target's seeds now include `new C(...)` and a
// parenthesized expression - so every nested creation was parsed TWICE (once by the
// speculative Target, once by the CallMember that follows it), which is 2^depth on
// language/async_nested/*, a corpus of deliberately deep literals. This guard answers
// "is there an assignment operator or a ++/-- ahead, at bracket depth 0, before this
// expression ends" and declines outright when there is not. It turned 9.4s into 0.13s
// on async_nested20_test.dart.
// Two caps, and they must be separate: `budget` bounds the CODE scanned (a target longer
// than that is treated as "no operator", which surfaces as a parse failure, not as a
// wrong parse), while `spin` bounds the raw iterations. Charging comments to `budget`
// was a 44-file regression - a statement preceded by nine lines of commentary spent the
// whole budget before reaching its own `=`.
TargetOpAhead = :script(~~
    (function() {
        var i = 0
        var depth = 0
        var angle = 0
        var budget = 512
        var spin = 0
        var q = 0
        var ch = 0
        while (spin < 200000 && budget > 0) {
            spin = spin + 1
            ch = c.peek(i)
            if (ch < 0) { break }
            if (ch === 32 || ch === 9 || ch === 10 || ch === 13 || ch === 12) { i = i + 1; continue }
            // comments - not charged to the budget
            if (ch === 47 && c.peek(i + 1) === 47) {
                i = i + 2
                while (c.peek(i) >= 0 && c.peek(i) !== 10) { i = i + 1 }
                continue
            }
            if (ch === 47 && c.peek(i + 1) === 42) {
                i = i + 2
                while (c.peek(i) >= 0 && !(c.peek(i) === 42 && c.peek(i + 1) === 47)) { i = i + 1 }
                i = i + 2
                continue
            }
            budget = budget - 1
            // string literals: their contents must not be read as operators or brackets
            if (ch === 39 || ch === 34) {
                q = ch
                if (c.peek(i + 1) === q && c.peek(i + 2) === q) {
                    i = i + 3
                    while (c.peek(i) >= 0
                           && !(c.peek(i) === q && c.peek(i + 1) === q && c.peek(i + 2) === q)) {
                        if (c.peek(i) === 92) { i = i + 1 }
                        i = i + 1
                    }
                    i = i + 3
                    continue
                }
                i = i + 1
                while (c.peek(i) >= 0 && c.peek(i) !== q && c.peek(i) !== 10) {
                    if (c.peek(i) === 92) { i = i + 1 }
                    i = i + 1
                }
                i = i + 1
                continue
            }
            if (ch === 40 || ch === 91 || ch === 123) { depth = depth + 1; i = i + 1; continue }
            if (ch === 41 || ch === 93 || ch === 125) {
                depth = depth - 1
                if (depth < 0) { break }
                i = i + 1
                continue
            }
            if (ch === 60) { angle = angle + 1 }
            if (ch === 62 && angle > 0) { angle = angle - 1 }
            if (depth === 0) {
                // A ';' or a ',' at depth 0 ends this expression: any operator that
                // belongs to it stands before them. Stopping at the comma is what keeps
                // the guard cheap inside a 20 000-element literal - without it the two
                // big_set_literal tests took 25s each and hit the sweep's timeout.
                // The comma of a TYPE ARGUMENT list is not such an end, though, so it
                // only counts outside an open '<': `Indexable<String, Object?>('')[0]
                // ??= e` is one target, and stopping at its comma lost eight files.
                if (ch === 59) { break }
                if (ch === 44 && angle === 0) { break }
                // ++ / -- (a postfix or prefix step)
                if ((ch === 43 && c.peek(i + 1) === 43) || (ch === 45 && c.peek(i + 1) === 45)) { return }
                // an assignment operator is the one that ENDS in a single '=' that is
                // neither part of '==', '=>', '!=', '<=' nor '>='.
                if (ch === 61 && c.peek(i + 1) !== 61 && c.peek(i + 1) !== 62) {
                    var p1 = i > 0 ? c.peek(i - 1) : 0
                    var p2 = i > 1 ? c.peek(i - 2) : 0
                    if (p1 === 61 || p1 === 33) { i = i + 1; continue }        // == , !=
                    if (p1 === 60 && p2 !== 60) { i = i + 1; continue }        // <= (not <<=)
                    if (p1 === 62 && p2 !== 62) { i = i + 1; continue }        // >= (not >>=)
                    return
                }
            }
            i = i + 1
        }
        return abnf.newToken("\x01noassign", 0)
    })()
~~) ;

// An assignment target: a name, or a CALL, followed by any run of .field / [index]
// steps. The call seed is what makes `E0(c0).m1 = 0` and `f(x)[0] = 1` assignable; the
// call form is tried first because it is the more specific of the two.
Target      <~~ push(makeDartTarget(takeAll())) ~~>
            = TargetSeed { DotTarget | IndexTarget | NullDotTarget | NullIndexTarget } ;
TargetSeed  = TargetCall | TargetNew | TargetParen | TargetName ;
TargetCall  <~~ push({seed: pop()}) ~~> = Call ;
// `new A().field = 42`, `(mock as dynamic).mood = 'x'`, `(variable)[0] = 0`: an object
// creation and a parenthesized expression are assignable seeds too.
TargetNew   <~~ push({seed: pop()}) ~~> = NewExpr ;
TargetParen <~~ push({seed: pop()}) ~~> = "(" Expression ")" ;
TargetName  <~~ push(up.in) ~~> = Id ;
DotTarget   = "." Id <~~ push({key: up.in}) ~~> ;
IndexTarget <~~ push({idx: pop()}) ~~> = "[" Expression "]" ;
// Null-aware assignment targets: `e?.f = v`, `e?[i] ??= v`. A null receiver makes the
// whole assignment a no-op evaluating to null, exactly as in Dart. "?[" is one fused
// token for the same reason NullIndexSfx fuses it.
NullDotTarget = "?." Id <~~ push({key: up.in, nulla: true}) ~~> ;
NullIndexTarget <~~ push({idx: pop(), nulla: true}) ~~> = "?[" Expression "]" ;

CondExpr    <~~ push(makeCond(takeAll())) ~~>
            = IfNullExpr [ "?" AssignExpr ":" AssignExpr ] ;
// a ?? b : if-null. Accepted, not implemented; both operands are evaluated (calls
// stay visible) and the first is returned. With no "??" it passes the operand through.
IfNullExpr  <~~ push(makeIfNull(takeAll())) ~~>
            = OrExpr { "??" <~~ push({ifnull: true, pos: up.pos}) ~~> OrExpr } ;
OrExpr      <~~ push(makeOrAnd(takeAll(), true)) ~~>
            = AndExpr { "||" AndExpr } ;
AndExpr     <~~ push(makeOrAnd(takeAll(), false)) ~~>
            = EqExpr { "&&" EqExpr } ;
EqExpr      <~~ push(foldBinary(takeAll())) ~~>
            = RelExpr { ( "==" | "!=" ) <~~ push(up.in) ~~> RelExpr } ;
RelExpr     <~~ push(foldBinary(takeAll())) ~~>
            = TypeTestExpr { ( "<=" | ">=" | "<" | ">" ) <~~ push(up.in) ~~> TypeTestExpr } ;
// is / is! / as type tests, at relational precedence. 'as' is an identity cast (operand
// evaluated, type erased); 'is' / 'is!' are accepted and not implemented.
TypeTestExpr <~~ push(makeTypeTest(takeAll())) ~~>
            = BitOrExpr [ TypeTestOp TestType ] ;
TestType    <~~ push({tname: up.in}) ~~> = Type ;
TypeTestOp  = IsOp | AsOp ;
IsOp        <~~ push({tt: up.in}) ~~> = KwIs [ "!" ] ;
AsOp        <~~ push({tt: "as"}) ~~> = KwAs ;
// Bitwise and shift levels sit between the relational and additive levels, as in Dart.
// A lone "|" that begins "||" fails its right operand and the iteration rolls back
// (likewise "&" below "&&"), so the logical levels above keep working.
BitOrExpr   <~~ push(foldBinary(takeAll())) ~~>
            = BitXorExpr { "|" <~~ push("|") ~~> BitXorExpr } ;
BitXorExpr  <~~ push(foldBinary(takeAll())) ~~>
            = BitAndExpr { "^" <~~ push("^") ~~> BitAndExpr } ;
BitAndExpr  <~~ push(foldBinary(takeAll())) ~~>
            = ShiftExpr { "&" <~~ push("&") ~~> ShiftExpr } ;
ShiftExpr   <~~ push(foldBinary(takeAll())) ~~>
            = AddExpr { ( "<<" | ">>>" | ">>" ) <~~ push(up.in) ~~> AddExpr } ;
AddExpr     <~~ push(foldBinary(takeAll())) ~~>
            = MulExpr { ( "+" | "-" ) <~~ push(up.in) ~~> MulExpr } ;
MulExpr     <~~ push(foldBinary(takeAll())) ~~>
            = UnaryExpr { ( "*" | "~/" | "/" | "%" ) <~~ push(up.in) ~~> UnaryExpr } ;

// The prefix ++ / -- come BEFORE Neg: "--i" would otherwise read as the double negation
// -(-i), which parses and quietly means something else.
UnaryExpr   = Await | PreIncDec | Neg | Not | BitNot | PostfixExpr ;
PreIncDec   <~~ push(makePreIncDec(takeAll())) ~~>
            = ( "++" | "--" ) <~~ push(up.in) ~~> Target ;
// await has no event loop here: a Future is already its value, so await is the identity
// (the child pushes the operand thunk unchanged).
Await       = KwAwait UnaryExpr ;
Neg         <~~ push(makeNeg(pop())) ~~> = "-" UnaryExpr ;
Not         <~~ push(makeNot(pop())) ~~> = "!" UnaryExpr ;
BitNot      <~~ push(makeBitNot(pop())) ~~> = "~" UnaryExpr ;

PostfixExpr = IncDec | ConstMember | CallMember ;
// A const expression: `const Kn.fix(2, 3)`. Const instances are canonicalized, so two
// const creations with equal arguments are identical().
ConstMember <~~ push(constify(pop())) ~~> = KwConst CallMember ;
IncDec      <~~ push(makeIncDec(takeAll())) ~~>
            = TargetOpAhead Target ( "++" | "--" ) <~~ push(up.in) ~~> ;

// A primary followed by any mix of method calls, field reads, index reads and the (not
// implemented) postfix null-assertion ! . The !"=" lookahead keeps a != b intact.
CallMember  <~~ push(foldCallMember(takeAll())) ~~>
            = Primary { MethodSfx | GenFieldSfx | AnonMethodSfx | FieldSfx | CallSfx | IndexSfx
                      | NullAnonSfx | NullMethodSfx | NullFieldSfx | NullIndexSfx | BangSfx } ;
// An ANONYMOUS METHOD (Dart 3.11 experiment): `receiver.{ return this.length; }` and its
// expression form `receiver.=> this.length`. It is invoked IMMEDIATELY - the corpus's own
// `final v1 = buffer.{ return foo; }; v1.expectStaticType<Exactly<int>>` says the value is
// the body's result, not a closure - with `this` bound to the receiver. It has to be tried
// before FieldSfx / NullFieldSfx, which also open with "." / "?.".
AnonMethodSfx <~~ push(makeAnonSfx(false, takeAll())) ~~> = "." AnonBody ;
NullAnonSfx   <~~ push(makeAnonSfx(true, takeAll())) ~~> = "?." AnonBody ;
// The body may declare a PARAMETER, which receives the receiver as well:
// `buffer.(p) => p.length` is `buffer.length`. ParamList fails on the first byte when
// there is none, so the optional is safe here.
AnonBody    = [ ParamList ] AnonTail ;
AnonTail    = AnonBlock | AnonArrow ;
AnonBlock   <~~ push({ablock: pop()}) ~~> = Block ;
AnonArrow   <~~ push({aexpr: pop()}) ~~>  = "=>" AssignExpr ;
// A call of whatever the chain has produced so far: foo(10)(20), f!(b), map['k']!(4, 2).
// Without it a curried or stored function can only be called through a variable.
CallSfx     <~~ push({kind: "callv", args: takeAll()}) ~~>
            = [ TypeArgs ] "(" [ Arg { "," Arg } [ "," ] ] ")" ;
// A generic tear-off: `o.method<int>` with no argument list (the parenthesized form is
// MethodSfx, which is tried first). The type arguments are erased.
GenFieldSfx = "." Id <~~ push({kind:"field", name: up.in}) ~~> TypeArgs ;
BangSfx     <~~ push({kind:"bang"}) ~~> = "!" !"=" ;
// Null-aware access (?., ?.(), ?[]): a null receiver short-circuits the whole remaining
// suffix chain to null, exactly like Dart.
NullMethodSfx <~~ push({kind:"nmcall", name: popName(), args: takeAll()}) ~~>
            = "?." Id <~~ push({mname: up.in}) ~~> "(" [ Arg { "," Arg } [ "," ] ] ")" ;
NullFieldSfx = "?." Id <~~ push({kind:"nfield", name: up.in}) ~~> ;
// "?[" is one fused token on purpose: with a space allowed between the two characters
// the ternary `b ? [9] : null` would parse as a null-aware index and then die on the ":".
NullIndexSfx <~~ push({kind:"nindex", idx: pop()}) ~~>
            = "?[" Expression "]" ;
MethodSfx   <~~ push({kind:"mcall", name: popName(), args: takeAll()}) ~~>
            = "." Id <~~ push({mname: up.in}) ~~> [ TypeArgs ] "(" [ Arg { "," Arg } [ "," ] ] ")" ;
FieldSfx    = "." FieldName ;
// A field name is an identifier or a record's positional field ($1, $2, ...).
FieldName   <~~ push({kind:"field", name: up.in}) ~~> = RecPosName | Id ;
RecPosName  = "$" :whitespace() "0"..."9" { "0"..."9" } :whitespace(Whitespace) ;
IndexSfx    <~~ push({kind:"index", idx: pop()}) ~~>
            = "[" Expression "]" ;

Primary     = ArrowFn | SuperExpr | SwitchExpr | SymbolLit | RecordLit | "(" Expression ")" | TypedColl | ListLit | MapLit
            | SetLit | StrLit | NumLit | True | False | Null | NewExpr | QualCall | QualRef
            | Call | TypeLit | DotShorthand | VarRef ;

// A TYPE LITERAL / explicit instantiation used as a value: `Map<int, bool>`,
// `f1<int>`, `A<B<int>>`. Types are erased here, so it evaluates to the type's text.
// `a < b, c > d` is also a perfectly good pair of comparisons, and Dart resolves the
// ambiguity purely lexically: `id<T, T>` is one term only when what FOLLOWS it is a
// stop or continuation token. language/constructor/explicit_instantiation_syntax_test.dart
// states the rule outright and enumerates every case:
//     <continuationToken> ::= '(' | '.' | '==' | '!='
//     <stopToken>         ::= ')' | ']' | '}' | ';' | ':' | ','
// TypeLit sits AFTER Call, so the '(' case is still a call; it is here for the rest.
TypeLit     <~~ push(makeConst(stripWs(up.in))) ~~>
            = Id TypeArgs InstEnd ;
// Whitespace is NOT skipped before a :script guard, and a refusing guard that skips too
// little says yes - the unsafe direction - so this steps over spaces AND both comment
// forms by hand, like every other forward-scanning guard in this tree.
InstEnd = :script(~~
    (function() {
        var i = 0
        var spin = 0
        while (spin < 200000) {
            spin = spin + 1
            var t = c.peek(i)
            if (t === 32 || t === 9 || t === 10 || t === 13 || t === 12) { i = i + 1; continue }
            if (t === 47 && c.peek(i + 1) === 47) {
                i = i + 2
                var u = c.peek(i)
                while (u >= 0 && u !== 10) { i = i + 1; u = c.peek(i) }
                continue
            }
            if (t === 47 && c.peek(i + 1) === 42) {
                i = i + 2
                var v = c.peek(i)
                while (v >= 0 && !(v === 42 && c.peek(i + 1) === 47)) { i = i + 1; v = c.peek(i) }
                if (v >= 0) { i = i + 2 }
                continue
            }
            break
        }
        var ch = c.peek(i)
        if (ch < 0) { return }                                   // end of file: a stop
        if (ch === 41 || ch === 93 || ch === 125) { return }      // ) ] }
        if (ch === 59 || ch === 58 || ch === 44) { return }       // ; : ,
        if (ch === 40 || ch === 46) { return }                    // ( .
        if (ch === 61 && c.peek(i + 1) === 61) { return }         // ==
        if (ch === 33 && c.peek(i + 1) === 61) { return }         // !=
        return abnf.newToken("\x01notinst", 0)
    })()
~~) ;

// A dot shorthand (Dart 3.10): `.blue`, `.new(1)`, `.member()` name a static member or
// constructor of the CONTEXT type. This front end does no type inference, so there is no
// context type to resolve the name against: the form is parsed and reported at run time.
DotShorthand <~~ push(makeDotShorthand(takeAll(), up.pos)) ~~>
            = "." DSName [ DSArgs ] ;
DSName      <~~ push({dsname: up.in}) ~~> = KwNew | Id ;
DSArgs      <~~ push({dsargs: takeAll()}) ~~> = "(" [ Arg { "," Arg } [ "," ] ] ")" ;

// A generic type used as a receiver: List<int>.filled(10, null), Future<Object?>.value().
// Without these two the type arguments are read as a comparison and the parse dies on the
// following ".", which is the single biggest failure cluster of the Dart corpus.
QualCall    <~~ push(makeQualCall(takeAll())) ~~>
            = Id <~~ push({qbase: up.in}) ~~> TypeArgs "." QRName "(" [ Arg { "," Arg } [ "," ] ] ")" ;
QualRef     <~~ push(makeQualRef(takeAll())) ~~>
            = Id <~~ push({qbase: up.in}) ~~> TypeArgs "." QRName ;
QRName      <~~ push({qname: up.in}) ~~> = Id ;

// super.m(args) / super.field: the lookup starts BELOW the class the running method was
// declared in, walking the receiver's linearisation (so a mixin's super reaches the class
// it was mixed in over).
SuperExpr   = SuperMcall | SuperFieldExpr ;
SuperMcall  <~~ push(makeSuperMcall(takeAll())) ~~>
            = KwSuper "." SMName "(" [ Arg { "," Arg } [ "," ] ] ")" ;
SuperFieldExpr <~~ push(makeSuperFieldExpr(takeAll())) ~~> = KwSuper "." SMName ;
SMName      <~~ push({smname: up.in}) ~~> = Id ;

// A switch expression: switch (e) { pattern => value, ... }. Unmatched is a runtime error
// (Dart checks exhaustiveness statically, which this front end does not).
SwitchExpr  <~~ push(makeSwitchExpr(takeAll())) ~~>
            = KwSwitch "(" Expression ")" "{" [ SwExprCase { "," SwExprCase } [ "," ] ] "}" ;
SwExprCase  <~~ push(makeSwExprCase(takeAll())) ~~>
            = Pattern [ SwGuard ] "=>" AssignExpr ;

// A symbol literal: #foo, #a.b . It names a member without calling it; with no mirrors
// here it evaluates to the plain string of that name. The whitespace scoping is the
// RecPosName idiom - no space may sit between the # and the name.
SymbolLit   <~~ push(makeConst(stripWs(up.in).substring(1))) ~~>
            = "#" :whitespace() SymName :whitespace(Whitespace) ;
// A symbol names a member, and an operator is a member: #>>>, #+, #[]= . The overloadable
// operator spellings come first because `#[]` is a prefix of `#[]=` (PEG ordered choice).
SymName     = OverloadableOp | SymDotted ;
SymDotted   = Id { "." Id } ;

// A record literal (Dart 3). It is told apart from a parenthesized expression by needing
// either two fields, a trailing comma after a single one, or a named field - which is why
// the three shapes are separate alternatives and RecordLit comes before "(" Expression ")".
RecordLit   = RecMulti | RecSingle | RecNamedOne ;
RecMulti    <~~ push(makeRecord(takeAll())) ~~>
            = "(" RecField "," RecField { "," RecField } [ "," ] ")" ;
RecSingle   <~~ push(makeRecord(takeAll())) ~~>
            = "(" RecField "," ")" ;
RecNamedOne <~~ push(makeRecord(takeAll())) ~~>
            = "(" NamedRecField [ "," ] ")" ;
RecField    = NamedRecField | PosRecField ;
NamedRecField <~~ var rv = pop(); push({rname: popName2(), t: rv}) ~~>
            = Id <~~ push({rn: up.in}) ~~> ":" AssignExpr ;
PosRecField <~~ push({rname: "", t: pop()}) ~~> = AssignExpr ;

// Dart number literals: hex (0x..), then the fractional/exponent form, then the plain
// integer. All three accept '_' digit separators (Dart 3.6). The longest/prefixed forms
// come first because this is a PEG.
// A double may start with the point: `.5`. It comes first so the plain forms never see it.
// Dart's `int` and `double` are DIFFERENT types, so a literal has to say which one it
// is: a form with a point or an exponent builds the {__flo} double box, and a plain or
// hex digit run builds an int through the shared 64-bit pair layer (szNorm/i64FromStr in
// lib/interp-core.js), which is exact for 9223372036854775807 where parseInt is not.
// The shared NumHex/NumDec/NumInt of lib/numbers.abnf push plain parseInt/parseFloat
// values, so Dart uses its own three; NumHexDig and NumExp are still the shared ones.
NumLit      = NumLeadDot | DartHexLit | DartDecLit | DartIntLit ;
NumLeadDot  <~~ push(makeConst(dFlo(parseFloat("0" + dNoUnd(up.in))))) ~~>
            = "." :whitespace() "0"..."9" { "0"..."9" | "_" } :whitespace(Whitespace) ;
// i64FromRadix / i64FromStr SKIP every character that is not a digit of the base, so
// the "0x" prefix, the '_' separators and the trailing whitespace need no stripping.
DartHexLit  <~~ push(makeConst(szNorm(i64FromRadix(up.in, 16), 64, false))) ~~>
            = "0" ( "x" | "X" ) :whitespace() NumHexDig { NumHexDig | "_" } :whitespace(Whitespace) ;
DartDecLit  <~~ push(makeConst(dFlo(parseFloat(dNoUnd(up.in))))) ~~>
            = ( "0" | "1"..."9" ) :whitespace() { "0"..."9" | "_" }
              ( "." "0"..."9" { "0"..."9" | "_" } [ NumExp ] | NumExp ) :whitespace(Whitespace) ;
DartIntLit  <~~ push(makeConst(szNorm(i64FromStr(up.in), 64, false))) ~~>
            = ( "0" | "1"..."9" ) :whitespace() { "0"..."9" | "_" } :whitespace(Whitespace) ;

// A collection literal with an explicit type argument: <int>[...], <K,V>{...}. The type
// argument is erased and the list/map/set is built as usual.
// The type argument of a collection literal is REMEMBERED (as __etype) so that a reified
// test like `<Object>[1] is! List<int>` can answer what Dart answers.
TypedColl   <~~ push(makeTypedColl(takeAll())) ~~>
            = CollTypeArgs ( ListLit | MapLit | SetLit ) ;
CollTypeArgs <~~ push({ctargs: up.in}) ~~> = TypeArgs ;

// A set literal { e, e, ... }: a brace literal whose elements are not key:value pairs.
// MapLit is tried first, so a bare {} and every {k: v, ...} is a map and only the rest
// reaches here.
SetLit      <~~ push(makeSet(takeAll())) ~~>
            = "{" CollElem { "," CollElem } [ "," ] "}" ;

// A closure: (params) => expr or (params) { statements }.
// A closure may be GENERIC: `<X>(X x) => x`, `<E>() sync* { ... }`. The type parameter
// list is erased. It is safe at the head of Primary because it demands a "<" first and
// then a parameter list, which no comparison expression offers.
ArrowFn     <~~ push(makeArrow(takeAll())) ~~>
            = [ SkipAngle ] ParamList [ AsyncMod ] ArrowTail ;
ArrowTail   = ArrowExpr | ArrowBlock ;
ArrowExpr   <~~ push({ebody: pop()}) ~~> = "=>" AssignExpr ;
ArrowBlock  <~~ push({body: pop()}) ~~>  = Block ;

// new Type(args) - equivalent to Type(args); both construct. The operand is a whole
// member chain, so `new C.foo()` reaches the named constructor foo through the ordinary
// method-call suffix (which is exactly how an unprefixed C.foo() resolves too).
NewExpr     = KwNew CallMember ;

// f(args): a top level function, a builtin, or (when the name is a class) a constructor.
Call        <~~ push(makeCall(takeAll())) ~~>
            = Id <~~ push(up.in) ~~> [ TypeArgs ] "(" [ Arg { "," Arg } [ "," ] ] ")" ;

// A call argument is positional (a bare expression, pushed as a thunk) or named
// (name: expr, pushed as a {named, val} marker collected into a trailing options dict).
Arg         = NamedArg | AssignExpr ;
NamedArg    <~~ var av = pop(); var an = pop(); push({named: an.aname, val: av}) ~~>
            = Id <~~ push({aname: up.in}) ~~> ":" AssignExpr ;

ListLit     <~~ push(makeList(takeAll())) ~~>
            = "[" [ CollElem { "," CollElem } [ "," ] ] "]" ;
// A collection element is a plain expression, a spread (...e splicing e's elements, ...?e
// contributing nothing when e is null), a collection-if or a collection-for. The same
// three control forms exist for map entries, one level down (MapElem).
CollElem    = SpreadElem | IfElem | ForElem | NullAwareElem | ExprElem ;
// A null-aware element (Dart 3.8): `?e` contributes nothing when e is null. "?" is not
// glued to the expression (`? .cn` is legal), so an ordinary token match is right here.
NullAwareElem <~~ push(makeNullAwareElem(pop())) ~~> = "?" AssignExpr ;
SpreadElem  <~~ push(makeSpread(takeAll())) ~~> = "..." [ "?" <~~ push({nullaware: true}) ~~> ] AssignExpr ;
IfElem      <~~ push(makeIfElem(takeAll())) ~~>
            = KwIf "(" Expression ")" CollElem [ KwElse CollElem ] ;
// `[await for (var i in stream) i]` - an await-for stream loop as a collection element.
// The await is in front of the `for`, not inside the head.
ForElem     <~~ push(makeForElem(takeAll())) ~~>
            = [ KwAwait ] KwFor "(" ForElemHead ")" CollElem ;
ExprElem    <~~ push({ekind: "val", t: pop()}) ~~> = AssignExpr ;
// The head of a collection-for is either `x in e` or the C-style triple; both reuse the
// statement-level pieces, so the markers arrive in the same shape.
ForElemHead = ForElemIn | ForElemC ;
ForElemIn   = [ ForInLead ] Id <~~ push({feName: up.in}) ~~> KwIn ForElemIter ;
ForElemIter <~~ push({feIter: pop()}) ~~> = Expression ;
ForElemC    = [ ForInit ] ";" [ ForCond ] ";" [ ForPost ] ;

MapLit      <~~ push(makeMap(takeAll())) ~~>
            = "{" [ MapElem { "," MapElem } [ "," ] ] "}" ;
MapElem     = SpreadElem | IfMapElem | ForMapElem | MapNullKeyEntry | MapEntry ;
// `{?k: v}` / `{k: ?v}`: a null key or value drops the whole entry.
MapNullKeyEntry <~~ push(makeNullMapEntry(takeAll())) ~~>
            = MapKeyQ AssignExpr ":" MapValQ AssignExpr ;
MapKeyQ     <~~ push({nk: up.in}) ~~> = [ "?" ] ;
MapValQ     <~~ push({nv: up.in}) ~~> = [ "?" ] ;
IfMapElem   <~~ push(makeIfElem(takeAll())) ~~>
            = KwIf "(" Expression ")" MapElem [ KwElse MapElem ] ;
ForMapElem  <~~ push(makeForElem(takeAll())) ~~>
            = [ KwAwait ] KwFor "(" ForElemHead ")" MapElem ;
MapEntry    <~~ var v = pop(); push({ekind: "entry", mk: pop(), mv: v}) ~~>
            = AssignExpr ":" AssignExpr ;

VarRef      <~~ push(makeVarRef(up.in)) ~~> = Id ;
Null        <~~ push(makeConst(null)) ~~>   = "null" KwEnd ;

// Dart string literals. Adjacent literals concatenate ('a' 'b' == "ab"), so a StrLit is
// one or more pieces. A piece is raw (r'...', no escapes and no interpolation), triple
// quoted (''' / """, spanning lines) or plain; all non-raw forms interpolate $name and
// ${expr}. The prefixed and longer forms come first (PEG ordered choice).
StrLit      <~~ push(makeStrCat(takeAll())) ~~>
            = StrPiece { StrPiece } ;
StrPiece    = RawTqSq | RawTqDq | RawSq | RawDq | TqSqTpl | TqDqTpl | SqTpl | DqTpl ;
SqTpl       <~~ push(makeTemplate(takeAll())) ~~>
            = "'" :whitespace() { TplExpr | TplVar | TplDollar | SqChunk } "'" :whitespace(Whitespace) ;
DqTpl       <~~ push(makeTemplate(takeAll())) ~~>
            = '"' :whitespace() { TplExpr | TplVar | TplDollar | DqChunk } '"' :whitespace(Whitespace) ;
// Triple-quoted: the closing delimiter is three quotes, so a single quote inside the body
// is ordinary text. The !"''" / !'""' lookaheads (literal lookahead is the only kind this
// dialect has) keep a lone quote in the chunk and stop at the real terminator.
TqSqTpl     <~~ push(makeTemplate(takeAll())) ~~>
            = "'''" :whitespace() { TplExpr | TplVar | TplDollar | TqSqChunk } "'''" :whitespace(Whitespace) ;
TqDqTpl     <~~ push(makeTemplate(takeAll())) ~~>
            = '"""' :whitespace() { TplExpr | TplVar | TplDollar | TqDqChunk } '"""' :whitespace(Whitespace) ;
TqSqChunk   <~~ push({s: unescapeDart(up.in)}) ~~> = TqSqCh { TqSqCh } ;
TqDqChunk   <~~ push({s: unescapeDart(up.in)}) ~~> = TqDqCh { TqDqCh } ;
TqSqCh      = TplEsc | TqSqQuote | SqPlain ;
TqDqCh      = TplEsc | TqDqQuote | DqPlain ;
TqSqQuote   = "'" !"''" ;
TqDqQuote   = '"' !'""' ;
// Raw strings: every character is literal, including backslashes and $.
RawTqSq     = "r" :whitespace() "'''" RawTqSqBody "'''" :whitespace(Whitespace) ;
RawTqDq     = "r" :whitespace() '"""' RawTqDqBody '"""' :whitespace(Whitespace) ;
RawSq       = "r" :whitespace() "'" RawSqBody "'" :whitespace(Whitespace) ;
RawDq       = "r" :whitespace() '"' RawDqBody '"' :whitespace(Whitespace) ;
RawTqSqBody <~~ push(makeConst(up.in)) ~~> = { TqSqQuote | RawSqPlain } ;
RawTqDqBody <~~ push(makeConst(up.in)) ~~> = { TqDqQuote | RawDqPlain } ;
RawSqBody   <~~ push(makeConst(up.in)) ~~> = { RawSqPlain } ;
RawDqBody   <~~ push(makeConst(up.in)) ~~> = { RawDqPlain } ;
RawSqPlain  = "\x00"..."\x26" | "\x28"..."\U0010ffff" ;
RawDqPlain  = "\x00"..."\x21" | "\x23"..."\U0010ffff" ;
TplExpr     <~~ push({e: pop()}) ~~>
            = "${" :whitespace(Whitespace) Expression "}" ;
TplVar      = "$" TplName <~~ push({e: makeVarRef(up.in)}) ~~> ;
TplName     = ( "a"..."z" | "A"..."Z" | "_" ) { "a"..."z" | "A"..."Z" | "0"..."9" | "_" } ;
TplDollar   <~~ push({s: "$"}) ~~> = "$" ;
SqChunk     <~~ push({s: unescapeDart(up.in)}) ~~> = SqTChar { SqTChar } ;
DqChunk     <~~ push({s: unescapeDart(up.in)}) ~~> = DqTChar { DqTChar } ;
SqTChar     = TplEsc | SqPlain ;
DqTChar     = TplEsc | DqPlain ;
TplEsc      = "\\" "\x00"..."\U0010ffff" ;
SqPlain     = "\x00"..."\x23" | "\x25"..."\x26" | "\x28"..."\x5b" | "\x5d"..."\U0010ffff" ;
DqPlain     = "\x00"..."\x21" | "\x23" | "\x25"..."\x5b" | "\x5d"..."\U0010ffff" ;

// A balanced < ... > run (generic parameters / arguments), parsed and ignored.
SkipAngle   = "<" { SkipAngle | SkipAngleItem } ">" ;
SkipAngleItem = "\x00"..."\x3b" | "\x3d" | "\x3f"..."\U0010ffff" ;

// A balanced { ... } run (switch / try / enum / member bodies) accepted without being
// understood. Dart string literals (single and double quoted, with $name / ${expr}
// interpolation) are matched first so braces inside them are never miscounted.
SkipBlock   = "{" { SkipItem } "}" ;
SkipItem    = SkipSqStr | SkipDqStr | SkipBlock | SkipBOther ;
SkipSqStr   = "'" :whitespace() { SkipTpl | SkipSqCh } "'" :whitespace(Whitespace) ;
SkipDqStr   = '"' :whitespace() { SkipTpl | SkipDqCh } '"' :whitespace(Whitespace) ;
SkipTpl     = "${" :whitespace(Whitespace) { SkipItem } "}" ;
SkipSqCh    = TplEsc | "$" | SqPlain ;
SkipDqCh    = TplEsc | "$" | DqPlain ;
SkipBOther  = "\x00"..."\x21" | "\x23"..."\x26" | "\x28"..."\x7a" | "\x7c" | "\x7e"..."\U0010ffff" ;

// A balanced ( ... ) run (switch / annotation / try headers), parsed and ignored.
SkipParen   = "(" { SkipSqStr | SkipDqStr | SkipParen | SkipPOther } ")" ;
SkipPOther  = "\x00"..."\x21" | "\x23"..."\x26" | "\x2a"..."\U0010ffff" ;

// Keywords end with a negative lookahead so 'ify' or 'classy' stay identifiers.
KwClass     = "class" KwEnd ;
KwNew       = "new" KwEnd ;
KwVar       = "var" KwEnd ;
KwFinal     = "final" KwEnd ;
KwConst     = "const" KwEnd ;
KwIf        = "if" KwEnd ;
KwElse      = "else" KwEnd ;
KwWhile     = "while" KwEnd ;
KwFor       = "for" KwEnd ;
KwIn        = "in" KwEnd ;
KwReturn    = "return" KwEnd ;
KwBreak     = "break" KwEnd ;
KwContinue  = "continue" KwEnd ;
KwExtends   = "extends" KwEnd ;
KwWith      = "with" KwEnd ;
KwImplements = "implements" KwEnd ;
KwLate      = "late" KwEnd ;
KwIs        = "is" KwEnd ;
KwAs        = "as" KwEnd ;
KwThrow     = "throw" KwEnd ;
KwSwitch    = "switch" KwEnd ;
KwDo        = "do" KwEnd ;
KwTry       = "try" KwEnd ;
KwCatch     = "catch" KwEnd ;
KwFinally   = "finally" KwEnd ;
KwOn        = "on" KwEnd ;
KwRethrow   = "rethrow" KwEnd ;
KwAssert    = "assert" KwEnd ;
KwImport    = "import" KwEnd ;
KwExport    = "export" KwEnd ;
KwPart      = "part" KwEnd ;
KwLibrary   = "library" KwEnd ;
KwOf        = "of" KwEnd ;
KwShow      = "show" KwEnd ;
KwHide      = "hide" KwEnd ;
KwEnum      = "enum" KwEnd ;
KwMixin     = "mixin" KwEnd ;
KwExtension = "extension" KwEnd ;
KwType      = "type" KwEnd ;
KwTypedef   = "typedef" KwEnd ;
KwFunction  = "Function" KwEnd ;
KwGet       = "get" KwEnd ;
KwSet       = "set" KwEnd ;
KwOperator  = "operator" KwEnd ;
KwFactory   = "factory" KwEnd ;
KwCase      = "case" KwEnd ;
KwDefault   = "default" KwEnd ;
KwWhen      = "when" KwEnd ;
KwYield     = "yield" KwEnd ;
KwAwait     = "await" KwEnd ;
KwSuper     = "super" KwEnd ;
