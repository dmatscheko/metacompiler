    function makeSuperFieldExpr(items) {
        var name = items[0].smname
        return function() {
            var self = findThis()
            if (self == undefined || self == null) { fail("super outside a method") }
            var g = findSuperMember(self.__class, getVar("__owner"), "get$" + name)
            if (g != null) { return g.fn.apply(undefined, [self]) }
