            scopes.pop()
            return res
        }
    }
    function makeForIn(items) {
        var name = items[0]
        var iterT = items[1]
        var bodyT = items[2]
        return function() {
            var it = anytype
            it = iterT()
            if (isDict(it)) { it = it.keys.slice(0) } // for (x in map) walks the keys
            var myLabel = takeLabel()
            scopes.push({})
            var res = undefined
            var n = dlen(it)
            for (var i = 0; i < n; i++) {
                declVar(name, dget(it, i))
                var r = bodyT()
                if (r != undefined) {
                    var act = loopRoute(r, myLabel)
                    if (act == "break") { break }
                    if (act == "propagate") { res = r; break }
