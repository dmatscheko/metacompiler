    //                                   one, unlike %
    //   language/operator/round_test.dart:22-26  round() is not floor(x + 0.5)
    // The rest (toDouble, abs, sign, isEven, toRadixString, clamp) is spec-derived from
    // the dart:core documentation of num / int / double; the corpus is silent on them.
    function dNumMethod(t, name, args) {
        var f = dNum(t)
        if (name == "toDouble") { return {v: dIsFlo(t) ? t : dFlo(f)} }
        if (name == "toInt" || name == "truncate") { return {v: dInt(t)} }
        if (name == "floor") { return {v: dIsFlo(t) ? szNorm(i64FromNum(Math.floor(f)), 64, false) : t} }
        if (name == "ceil") { return {v: dIsFlo(t) ? szNorm(i64FromNum(0 - Math.floor(0 - f)), 64, false) : t} }
        if (name == "round") {
            if (!dIsFlo(t)) { return {v: t} }
            return {v: szNorm(i64FromNum(dRound(f)), 64, false)}
        }
        if (name == "floorToDouble") { return {v: dFlo(Math.floor(f))} }
        if (name == "ceilToDouble") { return {v: dFlo(0 - Math.floor(0 - f))} }
        if (name == "truncateToDouble") { return {v: dFlo(dTrunc(f))} }
        if (name == "roundToDouble") { return {v: dFlo(dRound(f))} }
