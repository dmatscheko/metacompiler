ForElemIn   = [ ForInLead ] Id <~~ push({feName: up.in}) ~~> KwIn ForElemIter ;
ForElemIter <~~ push({feIter: pop()}) ~~> = Expression ;
ForElemC    = [ ForInit ] ";" [ ForCond ] ";" [ ForPost ] ;

MapLit      <~~ push(makeMap(takeAll())) ~~>
            = "{" [ MapElem { "," MapElem } [ "," ] ] "}" ;
MapElem     = SpreadElem | IfMapElem | ForMapElem | MapNullKeyEntry | MapEntry ;
// `{?k: v}` / `{k: ?v}`: a null key or value drops the whole entry.
MapNullKeyEntry <~~ push(makeNullMapEntry(takeAll())) ~~>
            = MapKeyQ AssignExpr ":" MapValQ AssignExpr ;
MapKeyQ     <~~ push({nk: up.in}) ~~> = [ "?" ] ;
MapValQ     <~~ push({nv: up.in}) ~~> = [ "?" ] ;
IfMapElem   <~~ push(makeIfElem(takeAll())) ~~>
            = KwIf "(" Expression ")" MapElem [ KwElse MapElem ] ;
ForMapElem  <~~ push(makeForElem(takeAll())) ~~>
            = [ KwAwait ] KwFor "(" ForElemHead ")" MapElem ;
MapEntry    <~~ var v = pop(); push({ekind: "entry", mk: pop(), mv: v}) ~~>
            = AssignExpr ":" AssignExpr ;

VarRef      <~~ push(makeVarRef(up.in)) ~~> = Id ;
Null        <~~ push(makeConst(null)) ~~>   = "null" KwEnd ;

// Dart string literals. Adjacent literals concatenate ('a' 'b' == "ab"), so a StrLit is
// one or more pieces. A piece is raw (r'...', no escapes and no interpolation), triple
// quoted (''' / """, spanning lines) or plain; all non-raw forms interpolate $name and
// ${expr}. The prefixed and longer forms come first (PEG ordered choice).
StrLit      <~~ push(makeStrCat(takeAll())) ~~>
            = StrPiece { StrPiece } ;
StrPiece    = RawTqSq | RawTqDq | RawSq | RawDq | TqSqTpl | TqDqTpl | SqTpl | DqTpl ;
SqTpl       <~~ push(makeTemplate(takeAll())) ~~>
            = "'" :whitespace() { TplExpr | TplVar | TplDollar | SqChunk } "'" :whitespace(Whitespace) ;
DqTpl       <~~ push(makeTemplate(takeAll())) ~~>
            = '"' :whitespace() { TplExpr | TplVar | TplDollar | DqChunk } '"' :whitespace(Whitespace) ;
// Triple-quoted: the closing delimiter is three quotes, so a single quote inside the body
// is ordinary text. The !"''" / !'""' lookaheads (literal lookahead is the only kind this
// dialect has) keep a lone quote in the chunk and stop at the real terminator.
