        var bodyStmt = bodyToStmt(m.body)
        var params = m.params
        var gen = m.amod == "sync*" || m.amod == "async*"
        return function() { return makeClosure(params, bodyStmt, scopes, gen) }
    }

    // ----- super -----
    function makeSuperMcall(items) {
        var name = items[0].smname
        var args = items.slice(1)
        return function() {
            var self = findThis()
            if (self == undefined || self == null) { fail("super outside a method") }
            var m = findSuperMember(self.__class, getVar("__owner"), name)
            if (m == null) { fail("no super member '" + name + "'") }
            return m.fn.apply(undefined, concat2impl([self], evalArgs(args)))
