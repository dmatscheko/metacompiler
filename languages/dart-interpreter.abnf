SpreadElem  <~~ push(makeSpread(takeAll())) ~~> = "..." [ "?" <~~ push({nullaware: true}) ~~> ] AssignExpr ;
IfElem      <~~ push(makeIfElem(takeAll())) ~~>
            = KwIf "(" Expression ")" CollElem [ KwElse CollElem ] ;
// `[await for (var i in stream) i]` - an await-for stream loop as a collection element.
// The await is in front of the `for`, not inside the head.
ForElem     <~~ push(makeForElem(takeAll())) ~~>
            = [ KwAwait ] KwFor "(" ForElemHead ")" CollElem ;
ExprElem    <~~ push({ekind: "val", t: pop()}) ~~> = AssignExpr ;
// The head of a collection-for is either `x in e` or the C-style triple; both reuse the
// statement-level pieces, so the markers arrive in the same shape.
