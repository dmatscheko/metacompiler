        if (typeof v == "boolean") { return hostGlobals["bool"] }
        if (typeof v == "number") { return (Math.floor(v) == v) ? hostGlobals["int"] : hostGlobals["float"] }
        if (Array.isArray(v)) { return hostGlobals["list"] }
