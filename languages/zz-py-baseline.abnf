            for (var i = 0; i < arguments.length; i++) inst.args.push(arguments[i])
            return inst
        }
    }
    hostGlobals["Exception"] = pyExcType("Exception")
    hostGlobals["ValueError"] = pyExcType("ValueError")
    hostGlobals["TypeError"] = pyExcType("TypeError")
    hostGlobals["KeyError"] = pyExcType("KeyError")
    hostGlobals["IndexError"] = pyExcType("IndexError")
