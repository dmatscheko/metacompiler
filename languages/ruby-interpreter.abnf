PctBrkCh    = "\x00"..."\x5a" | "\x5c" | "\x5e"..."\U0010ffff" ;
PctBrcCh    = "\x00"..."\x7a" | "\x7c" | "\x7e"..."\U0010ffff" ;

PctTplBody  = "(" { TplExpr | PctParChunk } ")"
            | "[" { TplExpr | PctBrkChunk } "]"
            | "{" { TplExpr | PctBrcChunk } "}"
            | "<" { TplExpr | PctAngChunk } ">"
            | "!" { TplExpr | PctBngChunk } "!"
            | "|" { TplExpr | PctPipChunk } "|" ;
// Ruby lets ANY non-alphanumeric character delimit a % literal; the bracket pairs
// above and these two are the ones that turn up in practice.
PctBngChunk <~~ push({s: unescapeRb(up.in)}) ~~> = PctBngTC { PctBngTC } ;
PctBngTC    = TplEsc | HashChar | PctBngPlain ;
PctBngPlain = "\x00"..."\x20" | "\x22" | "\x24"..."\x5b" | "\x5d"..."\U0010ffff" ;
PctPipChunk <~~ push({s: unescapeRb(up.in)}) ~~> = PctPipTC { PctPipTC } ;
PctPipTC    = TplEsc | HashChar | PctPipPlain ;
PctPipPlain = "\x00"..."\x22" | "\x24"..."\x5b" | "\x5d"..."\x7b" | "\x7d"..."\U0010ffff" ;
// The angle-bracket delimiter (%<a #{b}>), the fourth of Ruby's bracket pairs.
PctAngChunk <~~ push({s: unescapeRb(up.in)}) ~~> = PctAngTC { PctAngTC } ;
PctAngTC    = TplEsc | HashChar | PctAngPlain ;
PctAngPlain = "\x00"..."\x22" | "\x24"..."\x3d" | "\x3f"..."\x5b" | "\x5d"..."\U0010ffff" ;
PctParChunk <~~ push({s: unescapeRb(up.in)}) ~~> = PctParTC { PctParTC } ;
PctParTC    = TplEsc | HashChar | PctParPlain ;
PctParPlain = "\x00"..."\x22" | "\x24"..."\x27" | "\x2a"..."\x5b" | "\x5d"..."\U0010ffff" ;
PctBrkChunk <~~ push({s: unescapeRb(up.in)}) ~~> = PctBrkTC { PctBrkTC } ;
PctBrkTC    = TplEsc | HashChar | PctBrkPlain ;
PctBrkPlain = "\x00"..."\x22" | "\x24"..."\x5a" | "\x5e"..."\U0010ffff" ;
PctBrcChunk <~~ push({s: unescapeRb(up.in)}) ~~> = PctBrcTC { PctBrcTC } ;
PctBrcTC    = TplEsc | HashChar | PctBrcPlain ;
PctBrcPlain = "\x00"..."\x22" | "\x24"..."\x5b" | "\x5d"..."\x7a" | "\x7c" | "\x7e"..."\U0010ffff" ;

// ----- Regular expression literals -----
// /pattern/flags and %r{pattern}flags, matched by the shared engine in
// lib/regex.js. The body is kept RAW - unlike a double-quoted string it is NOT
// unescaped, because the regexp engine is the thing that reads the backslashes
// (unescaping first would turn \d into a plain d). '#{}' interpolation still
// applies, so the body is a template all the same; ReTplExpr restores the
// no-whitespace-skipping mode the literal runs in when the expression ends.
//
// A `/` only starts a literal in VALUE position, which is exactly where Primary is
// reached - so `8 / 2 / 2` still divides: after the 8 the parser is at the operator
// level and never offers Primary a `/`.
// `echo hi` / %x{echo hi}: run a sub-shell and yield its output. There is no process
// spawning here, so the interpolation is evaluated (for its side effects) and the
// result is the empty string - notImplemented, not a parse failure.
CmdLit      <~~ push(makeCommand(makeTemplate(takeAll()), up.pos)) ~~>
            = "`" :whitespace() { TplExpr | BtChunk } "`" :whitespace(Whitespace)
            | "%x" :whitespace() PctTplBody :whitespace(Whitespace) ;
BtChunk     <~~ push({s: unescapeRb(up.in)}) ~~> = BtTC { BtTC } ;
BtTC        = TplEsc | HashChar | BtPlain ;
BtPlain     = "\x00"..."\x22" | "\x24"..."\x5b" | "\x5d"..."\x5f" | "\x61"..."\U0010ffff" ;

RegexLit    <~~ push(makeRegex(takeAll())) ~~>
            = "/" :whitespace() { ReTplExpr | ReSlashChunk } "/" ReFlags :whitespace(Whitespace) ;
PctR        <~~ push(makeRegex(takeAll())) ~~>
            = "%r" :whitespace() ReBody ReFlags :whitespace(Whitespace) ;
ReBody      = "{" { ReTplExpr | ReBrcChunk } "}"
            | "(" { ReTplExpr | ReParChunk } ")"
            | "[" { ReTplExpr | ReBrkChunk } "]"
            | "<" { ReTplExpr | ReAngChunk } ">"
            | "|" { ReTplExpr | RePipChunk } "|" ;
ReTplExpr   <~~ push({e: pop()}) ~~>
            = "#{" :whitespace(Whitespace) Expression "}" :whitespace() ;
// The flag letters Ruby allows after a regexp. i / m / x change the match (mkRegex
// maps them onto the engine's neutral letters); o / u / n / e / s are encoding and
// once-only hints that do not, and are accepted and ignored.
ReFlags     <~~ push({reflags: up.in}) ~~>
            = { "i" | "m" | "x" | "o" | "u" | "n" | "e" | "s" } ;
ReSlashChunk <~~ push({s: up.in}) ~~> = ReSlashCh { ReSlashCh } ;
ReSlashCh   = ReEsc | HashChar | ReSlashPlain ;
ReBrcChunk  <~~ push({s: up.in}) ~~> = ReBrcCh { ReBrcCh } ;
ReBrcCh     = ReEsc | HashChar | ReBrcPlain ;
ReParChunk  <~~ push({s: up.in}) ~~> = ReParCh { ReParCh } ;
ReParCh     = ReEsc | HashChar | ReParPlain ;
ReBrkChunk  <~~ push({s: up.in}) ~~> = ReBrkCh { ReBrkCh } ;
ReBrkCh     = ReEsc | HashChar | ReBrkPlain ;
ReAngChunk  <~~ push({s: up.in}) ~~> = ReAngCh { ReAngCh } ;
ReAngCh     = ReEsc | HashChar | ReAngPlain ;
RePipChunk  <~~ push({s: up.in}) ~~> = RePipCh { RePipCh } ;
RePipCh     = ReEsc | HashChar | RePipPlain ;
// An escape is carried through as the two characters it is written with.
ReEsc       = "\\" "\x20"..."\U0010ffff" ;
ReSlashPlain = "\x00"..."\x22" | "\x24"..."\x2e" | "\x30"..."\x5b" | "\x5d"..."\U0010ffff" ;
ReBrcPlain  = "\x00"..."\x22" | "\x24"..."\x5b" | "\x5d"..."\x7c" | "\x7e"..."\U0010ffff" ;
ReParPlain  = "\x00"..."\x22" | "\x24"..."\x28" | "\x2a"..."\x5b" | "\x5d"..."\U0010ffff" ;
ReBrkPlain  = "\x00"..."\x22" | "\x24"..."\x5b" | "\x5e"..."\U0010ffff" ;
ReAngPlain  = "\x00"..."\x22" | "\x24"..."\x3d" | "\x3f"..."\x5b" | "\x5d"..."\U0010ffff" ;
RePipPlain  = "\x00"..."\x22" | "\x24"..."\x5b" | "\x5d"..."\x7b" | "\x7d"..."\U0010ffff" ;

// ?a / ?\n: the one-character string literal. The body may not start with a space,
// which is exactly what keeps the ternary `c ? a : b` out of it.
CharLit     <~~ push(makeConst(charLitVal(up.in))) ~~>
            = "?" :whitespace() CharBody :whitespace(Whitespace) ;
// ?\C-z / ?\M-\C-z: the control and meta forms of a character literal. Longest first
// (PEG), or the plain escape below would take the backslash and leave the rest.
CharBody    = CharCtl | "\\" "\x21"..b"\x7e" | "\x21"..."\U0010ffff" ;
CharCtl     = CharCtlPfx [ CharCtlPfx ] CharCtlCh ;
CharCtlPfx  = "\\M-" | "\\C-" | "\\c" ;
CharCtlCh   = "\\" "\x21"..."\x7e" | "\x21"..."\U0010ffff" ;

// if / unless usable as a statement and as an expression (yields the branch value).
IfExpr      <~~ push(makeIf(takeAll())) ~~>
            = KwIf Expression [ KwThen ] Body { Elsif } [ KwElse Body <~~ push({els: pop().body}) ~~> ] End ;
Elsif       <~~ var b = pop(); push({elifCond: pop(), elifBody: b.body}) ~~>
            = KwElsif Expression [ KwThen ] Body ;
UnlessExpr  <~~ push(makeUnless(takeAll())) ~~>
            = KwUnless Expression [ KwThen ] Body [ KwElse Body <~~ push({els: pop().body}) ~~> ] End ;

WhileExpr   <~~ push(makeWhile(pop().body, pop())) ~~>
            = KwWhile Expression [ KwDo ] Body End ;
UntilExpr   <~~ push(makeUntil(pop().body, pop())) ~~>
            = KwUntil Expression [ KwDo ] Body End ;

// case SUBJ / when V1, V2 / else - lowered to a chain of == tests (a switch). A
// subject-less case (case / when COND) tests each when expression for truthiness.
// A case may equally carry Ruby 3 `in PATTERN` clauses instead of `when` values;
// makeCase tells the two apart by what the clause pushed.
CaseExpr    <~~ push(makeCase(takeAll())) ~~>
            = KwCase [ Expression ] [ Semi ] { InClause | WhenClause } [ KwElse Body <~~ push({els: pop().body}) ~~> ] End ;
WhenClause  <~~ push(makeWhen(takeAll())) ~~>
            = KwWhen WhenVal { "," WhenVal } [ KwThen ] Body ;
// A when value: a range LO..HI / LO...HI matches by membership (Range#===); any
// other expression matches by == (subject form) or truthiness (subjectless form).
WhenVal     = WhenSplat | RangeVal | ScalarVal ;
// when *arr: every element of the array is a candidate value.
WhenSplat   <~~ push({t: pop(), isSplat: true}) ~~>
            = "*" !"*" Expression ;
RangeVal    <~~ push(makeRangeVal(takeAll())) ~~>
            = ShiftExpr ( "..." | ".." ) <~~ push(up.in) ~~> ShiftExpr ;
ScalarVal   <~~ push({t: pop(), isRange: false}) ~~>
            = Expression ;

// ----- Pattern matching (case/in, `expr => pattern', `expr in pattern') -----
// A pattern is compiled to a function(value) -> bool that BINDS as it goes, exactly
// like Ruby: every name in a pattern (except a pinned ^name and a Constant) is a
// local that receives the matched part, and the bindings of a failed alternative
// simply stay behind, which is what Ruby does too.
InClause    <~~ push(makeIn(takeAll())) ~~>
            = KwIn PatTop [ PatGuard ] [ KwThen ] Body ;
// At the TOP of an `in` clause the brackets may be dropped: `in a: 1, b: 1` is the
// hash pattern `{a: 1, b: 1}` and `in 1, 2` the array pattern `[1, 2]`. Both forms
// exist only here, which is why they are not alternatives of PatPrim - a nested
// `in [x, {a: 1}]` still needs its braces. The bare hash comes first (PEG): it starts
// with `name:`, which no other pattern can.
PatTop      = PatBareHash | PatBareSplat | PatBareArray | Pattern ;
// `in *;` and `in *rest` on their own: an array pattern that is nothing but a splat,
// which matches any deconstructable value ("matches anything with *").
PatBareSplat <~~ push(makePatArray(takeAll())) ~~>
            = PatSplat ;
// SameLine is what bounds an OMITTED value: `{a: 1} => a:` followed by `a.should == 1`
// on the next line must not read that line as the pattern for the key.
PatBareHash <~~ push(makePatHash(takeAll())) ~~>
            = PatBareHashElem { "," PatBareHashElem } ;
PatBareHashElem = PatHashRest | PatBareHashPair ;
PatBareHashPair <~~ push(makePatPair(takeAll())) ~~>
            = PatKey [ SameLine Pattern ] ;
// SameLine is what ends the bracket-less list: `in 5, 4,` followed by the clause body
// on the next line must not read that body as a third element. A comma left over at
// the end of the line is then the partial-match marker, exactly as inside brackets.
PatBareArray <~~ push(makePatArray(takeAll())) ~~>
            = PatArrElem "," [ SameLine PatArrElem { "," SameLine PatArrElem } ] [ PatArrTrail ] ;
PatGuard    = PatGuardIf | PatGuardUnless ;
PatGuardIf  <~~ push({guard: pop(), gneg: false}) ~~> = KwIf Expression ;
PatGuardUnless <~~ push({guard: pop(), gneg: true}) ~~> = KwUnless Expression ;

// PATTERN => name binds the whole matched value as well ({a: Integer} => whole).
Pattern     <~~ push(makePatBind(takeAll())) ~~>
            = PatAlt [ "=>" !">" PatBindName ] ;
PatBindName <~~ push({bindname: up.in}) ~~> = Name ;
PatAlt      <~~ push(makePatAlt(takeAll())) ~~>
            = PatPrim { "|" !"|" PatPrim } ;
// Order matters (PEG): the bracketed forms first, then a pinned name, then a bare
// LOWER-case name (a binding), and only then a general expression - which is what a
// Constant (Integer, String), a literal and a range all are.
PatPrim     = PatConstHash | PatConstArr | PatArray | PatHash | PatParen | PatPinExpr | PatPin
            | PatVar | PatValue ;
// Constant(pat, ...) / Constant[pat, ...] and Constant(id: pat, ...) - the value must
// be an instance of the constant AND deconstruct to the pattern inside. The spec suite
// spells all four forms out ("supports form Constant(pat, pat, ...)").
// SameLine keeps the deconstruction bracket on the constant's own line: without it
// `[1, 2] => a, b` followed by a line that OPENS with `[a, b]` reads that array as the
// pattern `b[a, b]`, and the parse then dies on the `.` after it.
PatConstArr <~~ push(makePatConstPat(takeAll())) ~~>
            = PatConstName SameLine PatConstArrBody ;
PatConstArrBody <~~ push(makePatArray(takeAll())) ~~>
            = "(" [ PatArrElem { "," PatArrElem } [ PatArrTrail ] ] ")"
            | "[" [ PatArrElem { "," PatArrElem } [ PatArrTrail ] ] "]" ;
PatConstHash <~~ push(makePatConstPat(takeAll())) ~~>
            = PatConstName SameLine PatConstHashBody ;
PatConstHashBody <~~ push(makePatHash(takeAll())) ~~>
            = "(" PatHashElem { "," PatHashElem } ")"
            | "[" PatHashElem { "," PatHashElem } "]" ;
PatConstName <~~ push(makeScopedConst(up.in)) ~~> = Name { "::" Name } ;
// A pattern in parentheses - the spec puts a whole range pattern on its own line
// inside them, so this is not the same thing as a Constant() deconstruction.
PatParen    = "(" Pattern ")" ;
// A pin may name an @ivar, a @@classvar or a $global as well as a local: `in ^@a`
// tests against the CURRENT value of @a rather than binding it.
PatPin      <~~ push(makePatPin(pop())) ~~>
            = "^" PatPinName ;
// ^(EXPR): the pin may hold a whole expression (Ruby 3.1), which is evaluated and then
// matched with === like any other value pattern.
PatPinExpr  <~~ push(makePatValue(pop())) ~~>
            = "^" "(" Expression ")" ;
PatPinName  <~~ push(up.in) ~~> = "@@" Id | "@" Id | "$" Id | Name ;
PatArray    <~~ push(makePatArray(takeAll())) ~~>
            = "[" [ PatArrElem { "," PatArrElem } [ PatArrTrail ] ] "]" ;
// `in [0, 1, ]` matches the array's BEGINNING and ignores the rest - the trailing
// comma is exactly an anonymous splat ("does match partially from the array beginning
// if list + , syntax used").
PatArrTrail <~~ push({psplat: ""}) ~~> = "," ;
PatArrElem  = PatSplat | Pattern ;
// [*pre, 42, *post]: a splat swallows any number of elements; two of them make the
// FIND pattern, which searches for the middle anywhere in the array.
PatSplat    <~~ var n = takeAll(); push({psplat: n.length > 0 ? n[0] : ""}) ~~>
            = "*" !"*" [ PatSplatName ] ;
PatSplatName <~~ push(up.in) ~~> = Name ;
PatHash     <~~ push(makePatHash(takeAll())) ~~>
            = "{" [ PatHashElem { "," PatHashElem } [ "," ] ] "}" ;
PatHashElem = PatHashRest | PatHashPair ;
PatHashRest <~~ var n = takeAll(); push({prest: n.length > 0 ? n[0] : ""}) ~~>
            = "**" [ PatSplatName ] ;
// `k: PATTERN' tests the value under :k; the value may be omitted (`r:'), which
// binds the local r to it.
PatHashPair <~~ push(makePatPair(takeAll())) ~~>
            = PatKey [ Pattern ] ;
// A hash-pattern key may be written as a quoted label ({"a": 0}); Ruby allows only a
// LABEL here, never a `"a" => 1` pair, which is why the value stays a plain symbol.
PatKey      = PatKeyPlain | PatKeyQ ;
PatKeyPlain <~~ push({pkey: hashShortName(up.in)}) ~~> = SymName ":" NotColonGlued ;
PatKeyQ     = '"' :whitespace() SymName <~~ push({pkey: up.in}) ~~> '"' ":" NotColonGlued :whitespace(Whitespace) ;
PatVar      <~~ push(makePatVar(up.in)) ~~> = NotKw LcId ;
LcId        = ( "a"..."z" | "_" ) :whitespace() { "a"..."z" | "A"..."Z" | "0"..."9" | "_" } :whitespace(Whitespace) ;
PatValue    <~~ push(makePatValue(pop())) ~~> = RangeExpr ;

// begin / rescue / else / ensure: genuinely executed (like Python try/except/else/
// finally). A raise in the body unwinds to the first rescue (exception types are
// parsed but not discriminated), which binds its `=> Id` name; else runs only when the
// body raised nothing and produced no return/break/next; ensure always runs. A
// return/break/next leaving the body propagates as the ordinary control signal.
BeginExpr   <~~ push(makeTry(takeAll(), up.pos)) ~~>
            = KwBegin Body <~~ push({trybody: pop().body}) ~~> { RescueClause }
              [ KwElse Body <~~ push({elsebody: pop().body}) ~~> ]
              [ KwEnsure Body <~~ push({finalbody: pop().body}) ~~> ] End ;
// rescue [Type[, Type]] [=> Id]: the type list is parsed and discarded (types are not
// discriminated); the `=> Id` name is pushed so makeExcept can bind it to the value.
// SameLine is what keeps a bare `rescue` whose body OPENS the next line with a
// constant (`rescue` newline `ScratchPad << :x`) from reading that constant as the
// rescued exception type - the type list, like every command argument in Ruby, has
// to sit on the rescue's own line.
RescueClause <~~ push(makeExcept(takeAll())) ~~>
            = KwRescue [ SameLine ErrList ] [ "=>" ExcName ] [ KwThen ] Body <~~ push({rbody: pop().body}) ~~> ;
// The capture is any assignable TARGET, not only a local: `rescue => @e`,
// `rescue => @@e`, `rescue => obj.field` and `rescue => obj&.field` all bind the
// exception through the ordinary assignment path. A bare name still DECLARES a fresh
// local in the handler's scope, which is what Ruby does and what a plain write would
// not do.
ExcName     <~~ push({href: pop()}) ~~>
            = Target ;
ErrList     = ErrName { "," ErrName } ;
ErrName     = ErrSplat | ScopedName <~~ push({etype: up.in}) ~~> ;
// `rescue *exception_list`: the classes come from an array only known at run time, so
// there is no name to discriminate on. The clause degrades to the catch-all it would
// be with no list at all - which is what dropping the expression here leaves.
ErrSplat    <~~ pop() ~~>
            = "*" !"*" Expression ;

// The optional argument of return/break/next must not start at a statement-modifier
// keyword: in `break if C` the `if` belongs to the enclosing ModStmt - without the
// NoModKw guard it parses as a block-if argument expression and swallows the loop's
// `end`.
ReturnExpr  <~~ push(makeReturn(takeAll())) ~~>
            = KwReturn [ NoModKw CommandForm | NoModKw RetVal { "," RetVal } ] ;
RetVal      = SplatRhs | Expression ;
BreakExpr   <~~ push(makeBreak(takeAll())) ~~>
            = KwBreak [ NoModKw CommandForm | NoModKw RetVal ] ;
NextExpr    <~~ push(makeNext(takeAll())) ~~>
            = KwNext [ NoModKw CommandForm | NoModKw RetVal { "," RetVal } ] ;
// redo re-runs the current block body with the same element, without advancing the
// iteration (it travels to the iterating method as its own control signal).
RedoExpr    <~~ push(makeRedo(up.pos)) ~~>
            = KwRedo ;
// retry re-runs the begin body that the running rescue clause belongs to.
RetryExpr   <~~ push(makeRetry()) ~~>
            = KwRetry ;

// raise [EXPR[, EXPR]]: raise the first expression's value (a bare raise re-raise is
// approximated as raising nil); a trailing message argument is parsed and ignored.
RaiseExpr   <~~ push(makeRaise(takeAll(), up.pos)) ~~>
            = KwRaise [ Expression { "," Expression } ] ;

// f(args): a top level method or a class (for C.new the .new is a method suffix).
// A call may carry a trailing block, with or without parentheses (`loop { ... }`,
// `s13_blk(5) { |v| ... }`), and a predicate/bang method may be called bare
// (`block_given?`). BareName is a non-keyword identifier that may end in ? or !;
// the longest form comes first, so `x ? a : b` only reaches the ternary after the
// call alternatives have failed and rolled back.
Call        <~~ push(makeCall(takeAll())) ~~>
            = BareName <~~ push(up.in) ~~> SameLine "(" [ Arg { "," Arg } [ "," ] ] ")" [ Block ]
            | BareName <~~ push(up.in) ~~> Block
            | PredName <~~ push(up.in) ~~> ;
BareName    = NotKw Id [ "?" | "!" ] ;
// A bare predicate/bang call has to be told apart from `a != b` and from the ternary
// `x ? a : b`, so the suffix character is checked with whitespace skipping OFF: a `!`
// may not be followed by `=`, and a `?` may not be followed by whitespace (Ruby uses
// exactly that spacing rule to separate `foo?` from `foo ? a : b`).
PredName    = PredOk NotKw Id :whitespace() PredSfx :whitespace(Whitespace) ;
PredSfx     = "?" | "!" ;

VarRef      <~~ push(makeVarRef(up.in)) ~~>
            = Name ;
IvarRef     = "@" Id <~~ push(makeIvarRef(up.in)) ~~> ;
// $global and @@classvar reads (their writes go through TargetHead above).
GvarRef     = "$" Id <~~ push(makeGvarRef(up.in)) ~~> ;
// The regexp match globals: $1..$9 are the capture groups of the last match and
// $~ the MatchData itself. They are ordinary entries in the global table, so they
// only need their own spelling here (Id does not start with a digit).
// (GvarNumCh is a production of its own because a Command followed by a GROUP is
// read as a repetition - see the Times trap in docs/abnf-dialect-gotchas.md.)
GvarNum     = "$" :whitespace() GvarDashCh <~~ push(makeGvarRef(up.in)) ~~> :whitespace(Whitespace)
            | "$" :whitespace() GvarNumCh <~~ push(makeGvarRef(up.in)) ~~> :whitespace(Whitespace) ;
// $-0 / $-a / $-I: the command-line flag globals, a '-' plus one more character.
GvarDashCh  = "-" GvarDashTail ;
GvarDashTail = "0"..."9" | "a"..."z" | "A"..."Z" | "_" ;
// Ruby's punctuation globals: the capture groups $1..$9, $~ / $& (the last match),
// $0 (the program name), $! (the current exception), $? $$ $. $, $; $/ $: $" $* $<
// $> $+ $_ $@. They are ordinary entries in the global table; only the spelling is
// unusual, and each has to be listed because Id cannot start with punctuation.
GvarNumCh   = "0"..."9" | "~" | "&" | "!" | "?" | "$" | "." | "," | ";" | "/" | "\\"
            | ":" | "*" | "<" | ">" | "+" | "@" | "'" | "`" | '"' | "=" ;
CvarRef     = "@@" Id <~~ push(makeCvarRef(up.in)) ~~> ;
// defined?(X) answers what kind of thing X is - or nil when it is nothing. Its
// argument is NOT evaluated, so the production keeps only the source text and
// makeDefined classifies it at run time.
// The parenthesis-less form (`defined? foo`, `not defined? qqq`) is the same rule
// without the brackets; the parenthesised one is tried first (PEG).
DefinedExpr <~~ push(makeDefined(takeAll())) ~~>
            = "defined?" :whitespace(Whitespace) "(" DefArgTxt ")"
            | "defined?" :whitespace(Whitespace) DefArgTxt ;
DefArgTxt   <~~ takeAll(); push({dtext: up.in}) ~~>
            = Expression | GvarRef | Id ;
Self        <~~ push(makeSelf()) ~~>    = KwSelf ;
// The source-position literals, resolved where they are WRITTEN (both are compile
// time constants in Ruby too). __dir__ is a method, not a keyword, but it answers the
// same question and nothing else here can.
FileLit     <~~ push(makeConst(c.file)) ~~> = "__FILE__" KwEnd ;
LineLit     <~~ push(makeConst(c.lineOf(up.pos))) ~~> = "__LINE__" KwEnd ;
DirLit      <~~ push(makeConst(dirOfFile(c.file))) ~~> = "__dir__" KwEnd ;
Nil         <~~ push(makeConst(null)) ~~> = "nil" KwEnd ;

ArrayLit    <~~ push(makeArray(takeAll())) ~~>
            = "[" [ ArrElem { "," ArrElem } [ "," ] ] "]" ;
// An array element may be splatted: [0, *[1, 2], 3] splices the inner array in.
// An array literal ends the same way a call's argument list does: a trailing run of
// `key => v` / `name: v` pairs is ONE Hash element (`["foo" => :bar, baz: 42]` is a
// one-element array holding a two-entry Hash).
ArrElem     = ArrSplat | KwArg | ArrowArg ;
ArrSplat    <~~ push({splat: pop()}) ~~>
            = "*" !"*" Expression ;
HashLit     <~~ push(makeHash(takeAll())) ~~>
            = "{" [ HashEntry { "," HashEntry } [ "," ] ] "}" ;
// { k => v } (arrow) and { name: v } (symbol key, genuinely lowered - name: is the
// symbol :name, which the runtime already represents as the string "name").
// HashShort is the Ruby 3.1 value omission {x:, y:} - the value is the local (or
// method) of the same name. It comes AFTER HashColon so the form WITH a value wins.
