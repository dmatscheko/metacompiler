    // prepend M: M's methods come BEFORE the class's own, and a `super` inside one of
    // them reaches the class itself. The owner is recorded by module NAME rather than
    // on the module object, so it survives the trip through the scope chain.
    var prependOwners = {}
    hostGlobals["prepend"] = function() {
        var c = directiveClass()
        var mods = []
        for (var i = 0; i < arguments.length; i++) { mods.push(arguments[i]) }
        for (var j = 0; j < mods.length; j++) {
            var pl = c.__prepends
            pl.push(mods[j])
            c.__prepends = pl
            scopePut(prependOwners, "$" + mods[j].__name, c)
        }
        return null
    }
    // extend M: M's instance methods become methods of the class OBJECT.
    hostGlobals["extend"] = function() {
        var c = directiveClass()
        for (var i = 0; i < arguments.length; i++) {
            var names = moduleMethodNames(arguments[i])
            for (var j = 0; j < names.length; j++) { scopePut(c, "$x$" + names[j], arguments[i][names[j]]) }
        }
        return null
    }
    hostGlobals["alias_method"] = function(nu, old) { doAlias(directiveClass(), rstr(nu), rstr(old)); return null }
    hostGlobals["define_method"] = function(nm, blk) {
        var c = directiveClass()
        scopePut(c, rstr(nm), function() {
            var a = []
            for (var i = 1; i < arguments.length; i++) { a.push(arguments[i]) }
            return blockCall(blk, a)
        })
        return null
    }
    // private / protected / public: with no argument they switch the mode for the
    // defs that follow, with arguments they mark exactly those methods.
    function visDirective(mode, args) {
        var c = directiveClass()
        if (args.length == 0) { curVis = mode; return null }
        for (var i = 0; i < args.length; i++) { scopePut(c, "$v$" + rstr(args[i]), mode) }
        return null
    }
    // The frozen engine has no Array.prototype, so `arguments` is copied by hand.
    function argsArray(a) {
        var out = []
        for (var i = 0; i < a.length; i++) { out.push(a[i]) }
        return out
    }
    hostGlobals["private"] = function() { return visDirective("private", argsArray(arguments)) }
    hostGlobals["protected"] = function() { return visDirective("protected", argsArray(arguments)) }
    hostGlobals["public"] = function() { return visDirective("public", argsArray(arguments)) }
    // module_function: every following def is ALSO a method of the module object.
    hostGlobals["module_function"] = function() { curVis = "module_function"; return null }
    hostGlobals["attr_reader"] = function() { return null }
    hostGlobals["attr_accessor"] = function() { return null }
    hostGlobals["attr_writer"] = function() { return null }
    hostGlobals["freeze"] = function(v) { return v }

    // ----- Builtins -----
    hostGlobals["puts"] = function() {}   // never reached: puts is a statement form
    hostGlobals["exit"] = function(code) { exit(code === undefined ? 0 : code | 0) }
    hostGlobals["abs"] = function(v) { return v < 0 ? -v | 0 : v | 0 }
    // Kernel#rand. There is no random source in this project and there cannot be one
    // that both engines agree on byte-for-byte, so rand is DETERMINISTICALLY ZERO -
    // but it is zero of the right class, which is the part a program can test:
    // `rand` and `rand(0)` are Floats in [0,1), `rand(n)` an Integer in [0,n), and
    // `rand(a..b)` the range's own low end.
    hostGlobals["rand"] = function(v) {
        if (v === undefined || v === null) { return mkFlo(0) }
        if (isRange(v)) { return v.lo }
        if (isFlo(v)) { return mkFlo(0) }
        return toF(v) == 0 ? mkFlo(0) : 0
    }
    hostGlobals["srand"] = function() { return 0 }
    // Kernel#lambda and Kernel#proc: the block itself is the value; only lambda marks
    // it, so Proc#lambda? can tell the two apart. A lambda's `return' is LOCAL, so
    // Kernel#lambda wraps the block in a closure that swallows the block's own
    // __blkret signal - without it `lambda { |x| return x }.call(1)' escaped every
    // enclosing method and, at the top level, aborted this half outright.
    hostGlobals["lambda"] = function(blk) { return markLambda(copyArity(lambdaWrap(blk), blk)) }
    hostGlobals["proc"] = function(blk) { return blk }
    hostGlobals["format"] = function() {
        var a = argsArray(arguments)
        return rformat(rstr(a[0]), a.slice(1))
    }
    hostGlobals["sprintf"] = function() {
        var sa = argsArray(arguments)
        return rformat(rstr(sa[0]), sa.slice(1))
    }
    // Kernel#printf is print(format(...)). It was missing here, and the compiler
    // half was resolving the bare name to the SHARED host printf instead of Ruby's
    // - Go's fmt under llvm.Run ("%!f(string=1.)") and something else again
    // natively (the directives came out verbatim). Three engines, three answers,
    // none of them Ruby's; docs/todo.md 2.9 recorded only the missing half.
    hostGlobals["printf"] = function() {
        var pa = argsArray(arguments)
        if (pa.length == 0) { return null }
        print(rformat(rstr(pa[0]), pa.slice(1)))
        return null
    }
    // Kernel#p writes INSPECT (not to_s) one argument per line, and answers the
    // argument - or the argument list when there is more than one, nil when none.
    hostGlobals["p"] = function() {
        var ia = argsArray(arguments)
        for (var pi = 0; pi < ia.length; pi++) { println(rinspect(ia[pi])) }
        if (ia.length == 0) { return null }
        if (ia.length == 1) { return ia[0] }
        return ia
    }
    hostGlobals["raise"] = function() { throw {__exc: true, v: mkExc(hostGlobals["RuntimeError"], rstr(arguments[0])) } }
    // Kernel#loop: an endless loop whose only exit is a break out of the block (which
    // arrives here as the non-local break makeCall catches, so `loop { break 42 }` is 42).
    hostGlobals["loop"] = function(blk) {
        while (true) { blockCall(blk, []) }
    }

    // ----- Equality: Ruby's Array#== / Hash#== compare structurally (element by
    // element / key by key), while every other value compares by identity. -----
    function rubyEq(l, r) {
        if (l === r) { return true }
        if (isNumV(l) && isNumV(r)) { return numEq(l, r) }
        if (isRange(l) && isRange(r)) { return rubyEq(l.lo, r.lo) && rubyEq(l.hi, r.hi) && l.excl === r.excl }
        if (isUserObj(l) && typeof lookupMethod(l.__class, "==") == "function") { return rtest(mcall(l, "==", [r], null)) }
        // undefined and nil both spell Ruby's nil (the compiled halves bind an
        // absent argument to undefined), so the two must compare equal here too.
        if (l === undefined || l === null || r === undefined || r === null) {
            var ln = l === undefined || l === null
            var rn = r === undefined || r === null
            return ln && rn
        }
        if (isExcObj(l) && typeof r == "string") { return rstr(l) === r }
        if (isExcObj(r) && typeof l == "string") { return rstr(r) === l }
        if (Array.isArray(l) && Array.isArray(r)) {
            if (l.length != r.length) { return false }
            for (var i = 0; i < l.length; i++) { if (!rubyEq(l[i], r[i])) { return false } }
            return true
        }
        if (isDict(l) && isDict(r)) {
            if (l.keys.length != r.keys.length) { return false }
            for (var j = 0; j < l.keys.length; j++) {
                var di = dictFind(r, l.keys[j])
                if (di < 0) { return false }
                if (!rubyEq(l.vals[j], r.vals[di])) { return false }
            }
            return true
        }
        return false
    }
    binOps["=="] = function(l, r) { return rubyEq(l, r) }
    binOps["!="] = function(l, r) { return !rubyEq(l, r) }
    // === is the case-equality operator: membership for a range, is_a? for a class
    // object, plain == otherwise. It is what `case/when` dispatches on.
    function caseEq(l, r) {
        if (isRange(l)) { return rangeCover(l, r) }
        if (isRegex(l)) { return reMatchOp(l, r) !== null }
        if (l !== null && l !== undefined && typeof l == "object" && l.__isclass === true) { return valueIsA(r, l) }
        if (isUserObj(l) && typeof lookupMethod(l.__class, "===") == "function") { return rtest(mcall(l, "===", [r], null)) }
        return rubyEq(l, r)
    }
    binOps["==="] = function(l, r) { return caseEq(l, r) }
    binOps["=~"] = function(l, r) { return reMatchOp(l, r) }
    binOps["!~"] = function(l, r) { return reMatchOp(l, r) === null }
    binOps["<=>"] = function(l, r) { return spaceship(l, r) }
    binOps["<"]  = function(l, r) { return rcmp(l, r) < 0 }
    binOps[">"]  = function(l, r) { return rcmp(l, r) > 0 }
    binOps["<="] = function(l, r) { return rcmp(l, r) <= 0 }
    binOps[">="] = function(l, r) { return rcmp(l, r) >= 0 }
    binOps["-"]  = function(l, r) { return rbin("-", l, r) }
    binOps["*"]  = function(l, r) { if (typeof l == "string") { return strRepeat(l, toF(r)) } return rbin("*", l, r) }
    binOps["/"]  = function(l, r) { return rbin("/", l, r) }
    binOps["%"]  = function(l, r) { if (typeof l == "string") { return rformat(l, r) } return rbin("%", l, r) }
    binOps["**"] = function(l, r) { return rbin("**", l, r) }
    binOps["&"]  = function(l, r) { return rbin("&", l, r) }
    binOps["|"]  = function(l, r) { return rbin("|", l, r) }
    binOps["^"]  = function(l, r) { return rbin("^", l, r) }

    // ----- Core config -----
    core.lang = "ruby"
    core.add = radd
    core.test = rtest
    // A Hash key that is an Integer past 2^53 is a BOX, and two boxes of the same
    // value are different objects - so `{2**64 => :big}[2**64]` missed on the
    // scan's `===`. The key IDENTITY is its exact decimal text, which puts a big
    // straight into dictIndex's map (no scan at all) and, because a plain Integer
    // uses the same rendering, keeps the two shapes of one Integer on one key.
    // The id namespace is "b", which no default id can collide with: a big is
    // only ever the key equal of ANOTHER big, exactly as the Go twin's
    // strictEq (a *jsBigInt arm demanding two *jsBigInts) and layer 2's
    // rbDictFind fallback have it.
    core.keyId = function(k) {
        if (isBig(k)) { return "b" + bigStr(k) }
        return null
    }
    // An ARRAY is a VALUE key in Ruby (Array#hash and Array#eql? are structural),
    // so `{[1] => 5}[[1]]` is 5 where a `===` scan answered nil - docs/todo.md
    // 2.11. It belongs HERE and not in interp-core's dictKeyEq, which nine
    // languages share and in which two arrays are two objects: python's `{(1,):5}`
    // is a tuple, JavaScript's `Map` keys by identity. A Hash keys the same way.
    // dictKeyId leaves an object key unindexed, so this is reached on the FALLBACK
    // SCAN only and an unchanged program pays nothing.
    //
    // One MRI corner is deliberately not modelled: MRI hashes the key ONCE at
    // insertion, so mutating a key array afterwards loses the entry until
    // Hash#rehash. This compares at lookup time and therefore still finds it -
    // the same shape the compiled halves' fallback scans have.
    core.keyEq = function(a, b) {
        if (Array.isArray(a) && Array.isArray(b)) { return rubyEq(a, b) }
        if (isDict(a) && isDict(b)) { return rubyEq(a, b) }
        if (!isBig(a) || !isBig(b)) { return false }
        return bigCmp(a, b) == 0
    }

    // ----- Project-file imports (require / require_relative) -----
    // A handful of stdlib names whose require is a no-op (the runtime provides them or
    // they are simply not modelled); every other require is looked up as a project file.
    core.stdlibImports = ["set", "json", "date", "time"]
    // require_relative 'geomlib' looks for geomlib.rb under the program's directory and
    // the -i roots (c.findImport), stripping a leading './' and adding a missing '.rb'.
    // The file is parsed with this grammar and walked with the same tags: its Program tag
    // (runProgram) runs its top level right there, so its def/class register in the global
    // scope before the requiring file's body runs. A file is imported once; repeats and
    // cycles are no-ops.
    var importedFiles = {}
    core.importFile = function(path, pos) {
        var rel = path
        if (rel.length >= 2 && rel.charAt(0) == "." && rel.charAt(1) == "/") { rel = rel.slice(2) }
        var cand = rel
        if (!(rel.length >= 3 && rel.slice(rel.length - 3) == ".rb")) { cand = rel + ".rb" }
        var file = c.findImport(cand)
        if (file == "") { return false }
        if (importedFiles["$" + file] == true) { return true }
        importedFiles["$" + file] = true
        var text = c.readFile(file)
        var asg = c.parse(c.agrammar, text, null, file)
        c.pushSource(file, text)
        c.compile(asg)
        c.popSource()
        return true
    }

    c.compile(c.asg)

    println("ruby interpreter: program finished")
    exit(0)

~~) ;
