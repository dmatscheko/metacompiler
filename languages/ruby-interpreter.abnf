        var values = []
        for (var i = 0; i < items.length; i++) {
            if (typeof items[i] == "function") { values.push(items[i]) }
            else { targets.push(items[i]) }
        }
        return function() {
            var vals = []
            if (values.length == 1 && targets.length > 1) {
                var it = anytype
                it = values[0]()
                if (Array.isArray(it)) { for (var j = 0; j < it.length; j++) { vals.push(it[j]) } }
                else { vals.push(it) }
            } else {
                for (var k = 0; k < values.length; k++) { vals.push(values[k]()) }
            }
            destructure(targets, vals)
            return vals
        }
    }

    // begin / rescue / else / ensure. items = [{trybody}, {handler,hname}*, {elsebody}?,
    // {finalbody}?]. makeExcept pairs a rescue's `=> Id` name (if any) with its body.
    // items = [name, bodyThunk] or [bodyThunk] (rescue with no binding).
    function makeExcept(items) {
        if (items.length > 1) { return {handler: items[1], hname: items[0]} }
        return {handler: items[0], hname: undefined}
    }
    // A raise in the body unwinds (a host throw) to the first rescue, which binds its
    // `=> Id` name to the value; else runs only when the body raised nothing AND produced
    // no return/break/next signal; ensure always runs and a control signal from it
    // overrides. A return/break/next signal from the body propagates as the begin's value.
    // The scope chain is restored to its begin-entry snapshot on the way out of a throw.
    function makeTry(items, pos) {
        var tryT = anytype, handlerT = anytype, hname = anytype, elseT = anytype, finallyT = anytype
        for (var i = 0; i < items.length; i++) {
            if (items[i].trybody != undefined) { tryT = items[i].trybody }
            else if (items[i].handler != undefined) {
                if (handlerT == undefined) { handlerT = items[i].handler; hname = items[i].hname }
            }
            else if (items[i].elsebody != undefined) { elseT = items[i].elsebody }
            else if (items[i].finalbody != undefined) { finallyT = items[i].finalbody }
        }
        return function() {
            var savedChain = scopes.slice()
            var box = {v: null}
            var threw = false
            try {
                box.v = tryT()
            } catch (e) {
                scopes = savedChain.slice()
                if (excIsUser(e) && handlerT != undefined) {
                    threw = true
                    scopes.push({})
                    if (hname != undefined) { declVar(hname, e.v) }
                    box.v = handlerT()
                    scopes.pop()
                } else {
                    throw e
                }
            } finally {
                scopes = savedChain.slice()
                if (!threw && !isSig(box.v) && elseT != undefined) {
                    box.v = elseT()
                }
                if (finallyT != undefined) {
                    var fr = finallyT()
                    // A return/break/next signal out of ensure must override the
                    // begin/rescue completion AND cancel a pending re-raise - only a
                    // return from the host finally block does both (box.v = fr cannot
                    // stop a rethrow that is already in flight).
                    if (isSig(fr)) { return fr }
                }
            }
            return box.v
        }
    }
    // raise [EXPR[, EXPR]]: raise the first expression's value as a host exception (a
    // bare raise re-raise is approximated by raising nil); the message argument is ignored.
    function makeRaise(items, pos) {
        var t = items.length > 0 ? items[0] : null
        return function() { throw {__exc: true, v: (t != null ? t() : null)} }
    }

    // ----- Builtins -----
    hostGlobals["puts"] = function() {}   // never reached: puts is a statement form
    hostGlobals["exit"] = function(code) { exit(code === undefined ? 0 : code | 0) }
    hostGlobals["abs"] = function(v) { return v < 0 ? -v | 0 : v | 0 }
    hostGlobals["rand"] = function() { return 0 }
    // Kernel#loop: an endless loop whose only exit is a break out of the block (which
    // arrives here as the non-local break makeCall catches, so `loop { break 42 }` is 42).
    hostGlobals["loop"] = function(blk) {
        while (true) { blockCall(blk, []) }
    }

    // ----- Equality: Ruby's Array#== / Hash#== compare structurally (element by
    // element / key by key), while every other value compares by identity. -----
    function rubyEq(l, r) {
        if (l === r) { return true }
        if (Array.isArray(l) && Array.isArray(r)) {
            if (l.length != r.length) { return false }
            for (var i = 0; i < l.length; i++) { if (!rubyEq(l[i], r[i])) { return false } }
            return true
        }
        if (isDict(l) && isDict(r)) {
            if (l.keys.length != r.keys.length) { return false }
            for (var j = 0; j < l.keys.length; j++) {
                var di = dictFind(r, l.keys[j])
                if (di < 0) { return false }
                if (!rubyEq(l.vals[j], r.vals[di])) { return false }
            }
            return true
        }
        return false
    }
    binOps["=="] = function(l, r) { return rubyEq(l, r) }
    binOps["!="] = function(l, r) { return !rubyEq(l, r) }

    // ----- Core config -----
    core.lang = "ruby"
    core.add = radd
    core.test = rtest

    // ----- Project-file imports (require / require_relative) -----
    // A handful of stdlib names whose require is a no-op (the runtime provides them or
    // they are simply not modelled); every other require is looked up as a project file.
    core.stdlibImports = ["set", "json", "date", "time"]
    // require_relative 'geomlib' looks for geomlib.rb under the program's directory and
    // the -i roots (c.findImport), stripping a leading './' and adding a missing '.rb'.
    // The file is parsed with this grammar and walked with the same tags: its Program tag
    // (runProgram) runs its top level right there, so its def/class register in the global
    // scope before the requiring file's body runs. A file is imported once; repeats and
    // cycles are no-ops.
    var importedFiles = {}
    core.importFile = function(path, pos) {
        var rel = path
        if (rel.length >= 2 && rel.charAt(0) == "." && rel.charAt(1) == "/") { rel = rel.slice(2) }
        var cand = rel
        if (!(rel.length >= 3 && rel.slice(rel.length - 3) == ".rb")) { cand = rel + ".rb" }
        var file = c.findImport(cand)
        if (file == "") { return false }
        if (importedFiles["$" + file] == true) { return true }
        importedFiles["$" + file] = true
        var text = c.readFile(file)
        var asg = c.parse(c.agrammar, text, null, file)
        c.pushSource(file, text)
        c.compile(asg)
        c.popSource()
        return true
    }

    c.compile(c.asg)

    println("ruby interpreter: program finished")
    exit(0)

~~) ;
