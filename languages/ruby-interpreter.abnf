            for (i = t.length - 1; i >= 0; i--) { rev.push(t[i]) }
            return name == "reverse" ? rev : arrReplace(t, rev)
        }
        if (name == "join") { return arrJoin(t, args.length == 0 ? "" : rstr(args[0])) }
        // min / max take an optional COUNT and an optional block, and with the count
        // they answer an array - ascending for min, DESCENDING for max.
        if (name == "min" || name == "max") {
            var wantMax = name == "max"
            var mcmp = arrCmpFn(blk)
            if (args.length > 0) {
                var mn = Math.trunc(toF(args[0]))
                var masc = arrSortWith(t, mcmp)
                if (!wantMax) { return arrSub(masc, 0, mn) }
                // max(n) answers the n largest in DESCENDING order.
                var mdesc = []
                for (i = masc.length - 1; i >= 0; i--) { mdesc.push(masc[i]) }
                return arrSub(mdesc, 0, mn)
            }
            if (t.length == 0) { return null }
            var best = anytype
            best = t[0]
            for (i = 1; i < t.length; i++) {
                var mc = mcmp(t[i], best)
                if (wantMax ? mc > 0 : mc < 0) { best = t[i] }
            }
            return best
        }
        if (name == "min_by" || name == "max_by") {
            if (t.length == 0) { return null }
            var kpairs = arrKeyed(t, blk)
            return name == "min_by" ? kpairs[0][1] : kpairs[kpairs.length - 1][1]
        }
        if (name == "minmax") {
            if (t.length == 0) { return [null, null] }
            var mmsorted = arrSortWith(t, arrCmpFn(blk))
            return [mmsorted[0], mmsorted[mmsorted.length - 1]]
        }
        // count: no argument is the length, an argument counts == matches, a block
        // counts the elements it accepts.
        if (name == "count") {
            if (blk != null) {
                var cb = 0
                for (i = 0; i < t.length; i++) { if (rtest(blockCall(blk, [t[i]]))) { cb = cb + 1 } }
                return cb
            }
            if (args.length == 0) { return t.length }
            var cn = 0
            for (i = 0; i < t.length; i++) { if (rubyEq(t[i], args[0])) { cn = cn + 1 } }
            return cn
        }
        if (name == "tally") {
            var td = {__dict: true, keys: [], vals: []}
            for (i = 0; i < t.length; i++) {
                var tix = dictFind(td, t[i])
                if (tix < 0) { dictSet(td, t[i], 1) } else { td.vals[tix] = td.vals[tix] + 1 }
            }
            return td
        }
        if (name == "flatten" || name == "flatten!") {
            var fdepth = args.length == 0 ? -1 : Math.trunc(toF(args[0]))
            var flat = arrFlatInto(t, fdepth, [])
            return name == "flatten" ? flat : arrReplace(t, flat)
        }
        if (name == "compact" || name == "compact!") {
            var cmp2 = []
            for (i = 0; i < t.length; i++) { if (t[i] !== null && t[i] !== undefined) { cmp2.push(t[i]) } }
            // The bang form answers nil when nothing was removed, which is how MRI
            // reports "no change" for every ! method that can make none.
            if (name == "compact") { return cmp2 }
            if (cmp2.length == t.length) { return null }
            return arrReplace(t, cmp2)
        }
        if (name == "uniq!") {
            var uq2 = arrayMethod(t, "uniq", [], null)
            if (uq2.length == t.length) { return null }
            return arrReplace(t, uq2)
        }
        // zip is element-wise across the receiver AND every argument array, padding a
        // short one with nil; the result is always as long as the RECEIVER.
        if (name == "zip") {
            var zout = []
            for (i = 0; i < t.length; i++) {
                var row = [t[i]]
                for (var zj = 0; zj < args.length; zj++) {
                    var za = args[zj]
                    row.push(Array.isArray(za) && i < za.length ? za[i] : null)
                }
                zout.push(row)
            }
            return zout
        }
        // each_slice / each_cons: with a block they yield each group and answer SELF
        // (Ruby 3.1 changed this from nil, and this project's corpus is Ruby 3);
        // with no block MRI answers an Enumerator, which has no value here, so they
        // answer the array of groups - what .to_a on that Enumerator would give.
        if (name == "each_slice" || name == "each_cons") {
            var gn = Math.trunc(toF(args[0]))
            if (gn < 1) { fail("invalid size") }
            var groups = []
            if (name == "each_slice") {
                for (i = 0; i < t.length; i = i + gn) { groups.push(arrSub(t, i, gn)) }
            } else {
                for (i = 0; i + gn <= t.length; i++) { groups.push(arrSub(t, i, gn)) }
            }
            if (blk == null) { return mkEnum(groups) }
            for (i = 0; i < groups.length; i++) { blockCall(blk, [groups[i]]) }
            return t
        }
        // sample / shuffle. There is no random source in this project and there cannot
        // be one the engines agree on byte-for-byte (see Kernel#rand, which is
        // deterministically zero), so these are the DETERMINISTIC draw: sample takes
        // from the front and shuffle is the identity permutation. Every invariant a
        // program can test - the length, membership, and that a shuffle is a
        // permutation of its receiver - holds; the particular ordering does not, and
        // MRI's would not be reproducible either.
        if (name == "sample") {
            if (args.length == 0) { return t.length == 0 ? null : t[0] }
            var sn = Math.trunc(toF(args[0]))
            if (sn > t.length) { sn = t.length }
            return arrSub(t, 0, sn)
        }
        if (name == "shuffle") { return t.slice(0) }
        if (name == "shuffle!") { return t }
        // cycle(n) { } runs the block over the whole array n times; cycle { } with no
        // count repeats FOREVER, and the way out is the block's own `break'.
        if (name == "cycle") {
            if (blk == null) {
                if (args.length == 0) { fail("cycle without a count needs a block") }
                var cyc = []
                var cn = Math.trunc(toF(args[0]))
                for (i = 0; i < cn; i++) { for (var cj = 0; cj < t.length; cj++) { cyc.push(t[cj]) } }
                return mkEnum(cyc)
            }
            if (args.length == 0) {
                if (t.length == 0) { return null }
                while (true) { for (i = 0; i < t.length; i++) { blockCall(blk, [t[i]]) } }
            }
            var cy = Math.trunc(toF(args[0]))
            for (i = 0; i < cy; i++) { for (var ck = 0; ck < t.length; ck++) { blockCall(blk, [t[ck]]) } }
            return null
        }
        // combination(n) / permutation(n): the subsets and the ordered arrangements, in
        // MRI's own order (combination is index-ascending, permutation is
        // lexicographic by index). With a block they yield each one and answer SELF.
        if (name == "combination" || name == "permutation") {
            var pk = args.length > 0 ? Math.trunc(toF(args[0])) : t.length
            var picks = name == "combination" ? combIdx(t.length, pk) : permIdx(t.length, pk)
            var res = []
            for (i = 0; i < picks.length; i++) {
                var row2 = []
                for (var pj = 0; pj < picks[i].length; pj++) { row2.push(t[picks[i][pj]]) }
                res.push(row2)
            }
            if (blk == null) { return mkEnum(res) }
            for (i = 0; i < res.length; i++) { blockCall(blk, [res[i]]) }
            return t
        }
        if (name == "take") { return arrSub(t, 0, Math.trunc(toF(args[0]))) }
        if (name == "drop") {
            var dn = Math.trunc(toF(args[0]))
            return arrSub(t, dn, t.length - dn)
        }
        if (name == "take_while" || name == "drop_while") {
            var cut = t.length
            for (i = 0; i < t.length; i++) {
                if (!rtest(blockCall(blk, [t[i]]))) { cut = i; break }
            }
            if (name == "take_while") { return arrSub(t, 0, cut) }
            return arrSub(t, cut, t.length - cut)
        }
        if (name == "find" || name == "detect") {
            for (i = 0; i < t.length; i++) { if (rtest(blockCall(blk, [t[i]]))) { return t[i] } }
            return null
        }
        // inject / reduce: four forms - a block, a block with an initial value, a
        // Symbol naming a binary operator, and an initial value with that Symbol.
        if (name == "inject" || name == "reduce") {
            var sym = null
            var haveInit = false
            var acc = anytype
            acc = null
            for (i = 0; i < args.length; i++) {
                if (isSym(args[i])) { sym = args[i].s }
                else { acc = args[i]; haveInit = true }
            }
            var from = 0
            if (!haveInit) {
                if (t.length == 0) { return null }
                acc = t[0]
                from = 1
            }
            for (i = from; i < t.length; i++) {
                if (sym != null) { acc = sym == "+" ? radd(acc, t[i]) : rbin(sym, acc, t[i]) }
                else { acc = blockCall(blk, [acc, t[i]]) }
            }
            return acc
        }
        if (name == "each_with_object") {
            var memo = anytype
            memo = args[0]
            for (i = 0; i < t.length; i++) { blockCall(blk, [t[i], memo]) }
            return memo
        }
        if (name == "all?" || name == "any?" || name == "none?" || name == "one?") {
            var hits = 0
            for (i = 0; i < t.length; i++) {
                var pv = false
                // With no block the element's own truthiness is the test; with an
                // argument the test is `arg === element`, which for a class object
                // is is_a? - modelled here as == plus the class test rcase makes.
                if (blk != null) { pv = rtest(blockCall(blk, [t[i]])) }
                else if (args.length > 0) { pv = rtest(caseEq(args[0], t[i])) }
                else { pv = rtest(t[i]) }
                if (pv) { hits = hits + 1 }
            }
            if (name == "all?") { return hits == t.length }
            if (name == "any?") { return hits > 0 }
            if (name == "none?") { return hits == 0 }
            return hits == 1
        }
        if (name == "flat_map" || name == "collect_concat") {
            var fm = []
            for (i = 0; i < t.length; i++) {
                var fv = blockCall(blk, [t[i]])
                if (Array.isArray(fv)) { for (var fj = 0; fj < fv.length; fj++) { fm.push(fv[fj]) } }
                else { fm.push(fv) }
            }
            return fm
        }
        if (name == "group_by") {
            var gd = {__dict: true, keys: [], vals: []}
            for (i = 0; i < t.length; i++) {
                var gk = blockCall(blk, [t[i]])
                var gix = dictFind(gd, gk)
                if (gix < 0) { dictSet(gd, gk, [t[i]]) } else { gd.vals[gix].push(t[i]) }
            }
            return gd
        }
        if (name == "partition") {
            var yes = []
            var no = []
            for (i = 0; i < t.length; i++) {
                if (rtest(blockCall(blk, [t[i]]))) { yes.push(t[i]) } else { no.push(t[i]) }
            }
            return [yes, no]
        }
        if (name == "rotate") {
            if (t.length == 0) { return [] }
            var rn = args.length == 0 ? 1 : Math.trunc(toF(args[0]))
            rn = ((rn % t.length) + t.length) % t.length
            var rot = []
            for (i = 0; i < t.length; i++) { rot.push(t[(i + rn) % t.length]) }
            return rot
        }
        if (name == "values_at") {
            var va = []
            for (i = 0; i < args.length; i++) {
                var vi = arrNorm(t, args[i])
                va.push(vi >= 0 && vi < t.length ? t[vi] : null)
            }
            return va
        }
        if (name == "slice") {
            if (isRange(args[0])) {
                var rlo = arrNorm(t, args[0].lo)
                var rhi = args[0].hi === null || args[0].hi === undefined ? t.length - 1 : arrNorm(t, args[0].hi)
                if (args[0].excl) { rhi = rhi - 1 }
                return arrSub(t, rlo, rhi - rlo + 1)
            }
            var si = arrNorm(t, args[0])
            if (args.length > 1) { return arrSub(t, si, Math.trunc(toF(args[1]))) }
            return si >= 0 && si < t.length ? t[si] : null
        }
        if (name == "insert") {
            var ii = arrNorm(t, args[0])
            var ins = arrSub(t, 0, ii)
            for (i = 1; i < args.length; i++) { ins.push(args[i]) }
            for (i = ii; i < t.length; i++) { ins.push(t[i]) }
            return arrReplace(t, ins)
        }
        // delete answers the value it removed (nil when it removed nothing), while
        // delete_at answers the element that was at that index.
        // delete answers the LAST element it removed - which is not always the
        // argument, since `[1, 1.0].delete(1)` removes both and MRI answers 1.0.
        if (name == "delete") {
            var kept = []
            var hit = anytype
            hit = null
            for (i = 0; i < t.length; i++) {
                if (rubyEq(t[i], args[0])) { hit = t[i] } else { kept.push(t[i]) }
            }
            arrReplace(t, kept)
            return hit
        }
        if (name == "delete_at") {
            var di = arrNorm(t, args[0])
            if (di < 0 || di >= t.length) { return null }
            var dv = t[di]
            var dkept = arrSub(t, 0, di)
            for (i = di + 1; i < t.length; i++) { dkept.push(t[i]) }
            arrReplace(t, dkept)
            return dv
        }
        // delete_if / keep_if always answer self; select! / reject! answer NIL when
        // they removed nothing, which is MRI's "no change" report for a ! method.
        if (name == "delete_if" || name == "reject!") {
            var dkeep = []
            for (i = 0; i < t.length; i++) { if (!rtest(blockCall(blk, [t[i]]))) { dkeep.push(t[i]) } }
            var dsame = dkeep.length == t.length
            arrReplace(t, dkeep)
            return name == "reject!" && dsame ? null : t
        }
        if (name == "keep_if" || name == "select!" || name == "filter!") {
            var skeep = []
            for (i = 0; i < t.length; i++) { if (rtest(blockCall(blk, [t[i]]))) { skeep.push(t[i]) } }
            var ssame = skeep.length == t.length
            arrReplace(t, skeep)
            return name != "keep_if" && ssame ? null : t
        }
        if (name == "map!" || name == "collect!") {
            var mm = []
            for (i = 0; i < t.length; i++) { mm.push(blockCall(blk, [t[i]])) }
            return arrReplace(t, mm)
        }
        if (name == "concat") {
            for (i = 0; i < args.length; i++) {
                var ca = args[i]
                if (Array.isArray(ca)) { for (var cj = 0; cj < ca.length; cj++) { t.push(ca[cj]) } }
            }
            return t
        }
        if (name == "fill") {
            var fl = []
            for (i = 0; i < t.length; i++) { fl.push(blk == null ? args[0] : blockCall(blk, [i])) }
            return arrReplace(t, fl)
        }
        if (name == "assoc") {
            for (i = 0; i < t.length; i++) {
                if (Array.isArray(t[i]) && t[i].length > 0 && rubyEq(t[i][0], args[0])) { return t[i] }
            }
            return null
        }
        if (name == "product") {
            var prod = []
            for (i = 0; i < t.length; i++) { prod.push([t[i]]) }
            for (i = 0; i < args.length; i++) {
                var pa = args[i]
                var nprod = []
                for (var pi = 0; pi < prod.length; pi++) {
                    for (var pj = 0; pj < pa.length; pj++) {
                        var prow = []
                        for (var pk = 0; pk < prod[pi].length; pk++) { prow.push(prod[pi][pk]) }
                        prow.push(pa[pj])
                        nprod.push(prow)
                    }
                }
                prod = nprod
            }
            return prod
        }
        if (name == "each_index") {
            for (i = 0; i < t.length; i++) { blockCall(blk, [i]) }
            return t
        }
        if (name == "dup" || name == "clone" || name == "freeze" || name == "itself" || name == "entries") {
            return name == "freeze" || name == "itself" ? t : t.slice(0)
        }
        fail("unknown Array method: " + name)
    }

    // One .method(args) [block] suffix. A call that was handed a block also catches the
    // block's non-local break, whose value becomes the value of THIS call.
    function invokeMcall(recv, s) {
        visCheck(recv, s.name)
        var sp = splitBlock(s.args)
        var argv = evalArgList(sp.args)
        if (sp.blk == null) { return mcall(recv, s.name, argv, null) }
        var bf = sp.blk()
        return catchBlkBreak(function() { return mcall(recv, s.name, argv, bf) })
    }

    // A member chain: primary followed by .method(args)/.field/[index] suffixes.
    foldCallMember = function(items) {
        if (items.length == 1) { return items[0] }
        var primary = items[0]
        var suffixes = items.slice(1)
        return function() {
            var cur = anytype   // a member chain hops between types
            cur = primary()
            for (var i = 0; i < suffixes.length; i++) {
                var s = suffixes[i]
                if (s.kind == "mcall") {
                    cur = invokeMcall(cur, s)
                } else if (s.kind == "smcall") {
                    if (cur === null || cur === undefined) { cur = null }
                    else { cur = invokeMcall(cur, s) }
                } else if (s.kind == "field") {
                    visCheck(cur, s.name)
                    if (isUserObj(cur)) { cur = mcall(cur, s.name, [], null) }
                    else if (s.name == "length" || s.name == "size") { cur = rlen(cur) }
                    else if (s.name == "to_s") { cur = rstr(cur) }
                    else { cur = mcall(cur, s.name, [], null) }
                } else if (s.kind == "sfield") {
                    if (cur === null || cur === undefined) { cur = null }
                    else if (s.name == "length" || s.name == "size") { cur = rlen(cur) }
                    else if (s.name == "to_s") { cur = rstr(cur) }
                    else { cur = mcall(cur, s.name, []) }
                } else {
                    cur = rindex(cur, s.idx())
                }
            }
            return cur
        }
    }

    // A block passed to a method: a real closure over the current scope.
    //
    // Control flow OUT of a block is non-local in Ruby: `break v` inside a block ends
    // the whole method call the block was given to and makes that call yield v, and
    // `redo` re-runs the block body with the same element. Neither can be expressed by
    // returning a value to the iterating method (which would just see a block result),
    // so both leave the block as a host throw that the call site (blockCall / makeCall /
    // foldCallMember) intercepts. `next` is local and simply ends this block run.
    function blkBind(params, args) {
        for (var i = 0; i < params.length; i++) {
            var av = anytype
            av = i < args.length ? args[i] : null
            if (params[i].pgroup != undefined) {
                var vv = []
                if (Array.isArray(av)) { vv = av } else { vv = [av] }
                blkBind(params[i].pgroup, vv)
            } else if (params[i].defT != undefined && i >= args.length) {
                declVar(params[i].param, params[i].defT())
            } else if (params[i].splat === true) {
                var rest = []
                for (var j = i; j < args.length; j++) { rest.push(args[j]) }
                if (params[i].param != null && params[i].param != undefined) { declVar(params[i].param, rest) }
            } else {
                declVar(params[i].param, av)
            }
        }
    }
    // The lambdas built so far, so Proc#lambda? can tell them from ordinary procs
    // (a property on the function value is not portable across the two engines).
    var lambdaSet = []
    function markLambda(f) { lambdaSet.push(f); return f }
    function isLambda(f) {
        for (var i = 0; i < lambdaSet.length; i++) { if (lambdaSet[i] === f) { return true } }
        return false
    }
    // Proc#arity needs a closure's PARAMETER SHAPE, and no function value carries one
    // in either engine, so both halves keep a registry keyed by function identity and
    // fill it where the closure is BUILT. The three counts are stored rather than the
    // answer because Kernel#lambda turns an already-built proc into a lambda, and the
    // two count OPTIONAL parameters differently: a proc ignores them
    // (`proc { |x = 0| }.arity' is 0), a lambda does not (`lambda { |x = 0| }.arity'
    // is -1). A *splat makes it -(required + 1) either way, and keyword and block
    // parameters are not counted at all. The compiler half does the same through
    // js_rarity; rubyArityOf of abnf/jsrt.go and rbProcArity of lib/ruby-rt.metajs.
    var arityFns = []
    var arityReq = []
    var arityOpt = []
    var arityStar = []
    function markArity(f, req, opt, star) {
        arityFns.push(f)
        arityReq.push(req)
        arityOpt.push(opt)
        arityStar.push(star)
        return f
    }
    function arityIndex(f) {
        for (var i = arityFns.length - 1; i >= 0; i--) { if (arityFns[i] === f) { return i } }
        return -1
    }
    // Carry a wrapped closure's shape over from the one it wraps (Kernel#lambda
    // rebuilds the function value, so identity alone would lose the record).
    function copyArity(dst, src) {
        var i = arityIndex(src)
        if (i >= 0) { markArity(dst, arityReq[i], arityOpt[i], arityStar[i]) }
        return dst
    }
    function procArity(f) {
        var i = arityIndex(f)
        if (i < 0) { return 0 }
        if (arityStar[i] === true) { return 0 - (arityReq[i] + 1) }
        if (isLambda(f) && arityOpt[i] > 0) { return 0 - (arityReq[i] + 1) }
        return arityReq[i]
    }
    // Record the shape of `params' against the closure f, and hand f back.
    function markParamArity(f, params) {
        var req = 0
        var opt = 0
        var star = false
        for (var i = 0; i < params.length; i++) {
            var p = params[i]
            if (p.kw === true || p.kwrest === true || p.blockp === true) { continue }
            if (p.splat === true) { star = true }
            else if (p.defT != undefined) { opt = opt + 1 }
            else { req = req + 1 }
        }
        // Nothing is recorded unless the program names `arity' (noteMName above), and
        // a closure with NO parameters is never recorded: 0 is what an unrecorded one
        // answers anyway, and `n.times { }' / `begin' bodies are the common shape.
        if (!usesArity) { return f }
        if (req == 0 && opt == 0 && !star) { return f }
        return markArity(f, req, opt, star)
    }
    // Kernel#lambda's block, made local-returning: the block itself still throws the
    // __blkret signal makeBlock builds, and this is the frame that stops it.
    function lambdaWrap(blk) {
        if (typeof blk != "function") { return blk }
        return function() {
            var args = []
            for (var i = 0; i < arguments.length; i++) { args.push(arguments[i]) }
            try {
                return blk.apply(undefined, args)
            } catch (e) {
                if (e !== null && e !== undefined && e.__blkret === true) { return e.v }
                throw e
            }
        }
    }
    // -> (params) { body }: a callable value. `return` inside it is LOCAL (it returns
    // from the lambda), which is the one behavioural difference from a block.
    function makeLambda(items) {
        var params = []
        var body = null
        for (var i = 0; i < items.length; i++) {
            if (items[i] == undefined) { continue }
            if (items[i].body != undefined) { body = items[i].body }
            else if (items[i].bparams != undefined) { params = items[i].bparams }
            else if (items[i].param != undefined) { params.push(items[i]) }
        }
