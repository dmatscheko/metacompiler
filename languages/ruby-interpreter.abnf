            if (depth > 0) { i = i - 1; continue }
            if (cc === 125 || cc === 123 || cc === 59) { start = i + 1; found = true; break }
            if (cc === 10) { start = i + 1; found = true; break }
            i = i - 1
        }
        if (!found) { return undefined }
        // Read the first word of that statement, skipping leading blanks.
        var j = start
        var dd = c.peek(j)
        var st2 = 0
        while (st2 < 1000 && (dd === 32 || dd === 9 || dd === 13)) { j = j + 1; dd = c.peek(j); st2 = st2 + 1 }
