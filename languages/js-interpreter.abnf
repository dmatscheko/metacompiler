    }
    function makeCtor(items) {
        return {kind: "ctor", params: items[0], body: items[1]}
    }
    // items = [{mods}, keyDesc] or [{mods}, keyDesc, initThunk].
    function makeField(items) {
        var key = items[1]
        return {kind: "field", name: key.mk, keyT: key.mkT, statik: hasStatic(items[0].mods),
