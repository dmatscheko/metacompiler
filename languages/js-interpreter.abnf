    // 'instanceof' and carry a name. One descriptor per function, remembered on the
    // function's own identity list, so two instances of the same constructor share it.
    var ctorDescriptors = []
    var ctorDescriptorFns = []
    function ctorDescriptor(name, fn) {
        for (var i = 0; i < ctorDescriptorFns.length; i++) {
            if (ctorDescriptorFns[i] === fn) { return ctorDescriptors[i] }
        }
        var d = {}
        d["__isclass"] = true
        d["__name"] = name
        ctorDescriptorFns.push(fn)
        ctorDescriptors.push(d)
        return d
    }

    // super(args): delegate to the parent constructor. super.m(args): dispatch m on the
    // parent class. The defining class comes from the scope the class body pushes
    // (__class__), so an anonymous class expression works the same way a named one does.
    function makeSuperCall(name, argThunks) {
        if (name == "") {
            return function() {
                var self = getVar("this")
                var supCls = getVar("__class__").__super
                if (supCls == undefined) fail("super() with no superclass")
                var argv = concat2impl([self], evalArgs(argThunks))
                supCls.__ctor.apply(undefined, argv)
                return undefined
            }
        }
        return function() {
            var self = getVar("this")
            var m = undefined
            for (var cl = getVar("__class__").__super; cl != undefined && m == undefined; cl = cl.__super) { if (hasOwn(cl, name)) m = cl[name] }
            if (typeof m != "function") fail("unknown super method '" + name + "'")
            var argv = concat2impl([self], evalArgs(argThunks))
            return m.apply(undefined, argv)
        }
    }

    binOp = function(op, l, r) {
        if (op == "+") return l + r
        if (op == "-") return l - r
        if (op == "*") return l * r
        if (op == "/") return l / r
        if (op == "%") return l % r
        if (op == "==") return l == r
        if (op == "!=") return l != r
        if (op == "===") return l === r
        if (op == "!==") return l !== r
        if (op == "<")  return l < r
        if (op == ">")  return l > r
        if (op == "<=") return l <= r
        if (op == ">=") return l >= r
        if (op == "|")  return l | r
        if (op == "^")  return l ^ r
        if (op == "&")  return l & r
        if (op == "<<") return l << r
        if (op == ">>") return l >> r
        if (op == ">>>") return l >>> r
    }
    // items = [thunk, op, thunk, op, thunk, ...] -> one left folded thunk.
    // || and && evaluate lazily and return the deciding operand, like in JS.
    function makeOr(items) {
        if (items.length == 1) return items[0]
        return function() {
            var v = anytype // The operands may be of mixed types.
            v = items[0]()
            for (var i = 1; i < items.length; i++) {
                if (v) return v
                v = items[i]()
            }
            return v
        }
    }
    function makeAnd(items) {
        if (items.length == 1) return items[0]
        return function() {
            var v = anytype // The operands may be of mixed types.
            v = items[0]()
            for (var i = 1; i < items.length; i++) {
                if (!v) return v
                v = items[i]()
            }
            return v
        }
    }
    // items = [thunk] or [condThunk, thenThunk, elseThunk].
    function makeCond(items) {
        if (items.length == 1) return items[0]
        return function() { return items[0]() ? items[1]() : items[2]() }
    }

    // items = [primaryThunk, {kind:"call"|"member", ...}...].
    // A member access remembers its object and its key. A directly following call is a
    // method call: if the looked-up member is a function value it is applied with the
    // object as 'this' (native string/array methods, object-literal methods); otherwise
    // it is a __class instance method, routed through mcall (which prepends the receiver
    // and follows __super). A call not preceded by a member is a plain function call.
    foldCallMember = function(items) {
        if (items.length == 1) return items[0]
        var primary = items[0]
        var suffixes = items.slice(1)
        return function() {
            var cur = anytype     // A member chain hops between types,
            var curThis = anytype // so do the remembered receiver
            var lastKey = anytype // and the remembered key.
            cur = primary()
            for (var i = 0; i < suffixes.length; i++) {
                var s = suffixes[i]
                // '?.' short-circuits the ENTIRE rest of the chain, not just its own
                // link: 'a?.b.c' is undefined when a is nullish, it does not go on to
                // read '.c' of undefined.
                if (s.opt == true && (cur == undefined || cur == null)) { return undefined }
                if (s.kind == "member") {
                    curThis = cur
                    lastKey = s.key()
                    cur = getMember(cur, lastKey)
                } else if (s.kind == "tagcall") {
                    // A tagged template: the tag gets the literal chunks first, then one
                    // argument per substitution.
                    if (typeof cur != "function") fail("tagged template on a non function value")
                    cur = callWithThis(cur, curThis, tagArgs(s.parts))
                    curThis = undefined
                } else {
                    var argv = evalArgs(s.args)
                    if (typeof cur == "function") {
                        cur = callWithThis(cur, curThis, argv)
                    } else {
                        cur = mcall(curThis, lastKey, argv)
                    }
                    curThis = undefined
                }
            }
            return cur
        }
    }

    // A parenthesized target ('(a.b).c = 1') arrives as {parenref: innerRef} followed by
    // whatever suffixes came after the ')'. The parentheses mean nothing at run time, so
    // the inner reference is unwrapped and the extra suffixes are appended to its path.
    makeTargetRef = function(items) {
        if (items[0] != undefined && items[0].parenref != undefined) {
            var inner = items[0].parenref
            return {name: inner.name, path: concat2impl(inner.path, items.slice(1))}
        }
        return {name: items[0], path: items.slice(1)}
    }

    // Target items = [nameString, suffix marker...] -> reference descriptor.
    // Walks a target path (members and calls) up to the last element and returns
    // the assignable place {obj, key}. The last element must be a member.
    resolveRef = function(ref) {
        var cur = anytype     // The walked values and receivers
        var curThis = anytype // may be of mixed types.
        // A reference starts at a NAME ('a.b = 1') or, for the LhsAssign form, at an
        // arbitrary primary expression ('[1].a = 2') that is evaluated here.
        cur = (ref.prim != undefined) ? ref.prim() : getVar(ref.name)
        for (var i = 0; i < ref.path.length - 1; i++) {
            var s = ref.path[i]
            if (s.kind == "member") {
                curThis = cur
                cur = getMember(cur, s.key())
            } else {
                var argv = evalArgs(s.args)
                if (typeof cur != "function") fail("call of a non function value: " + cur)
                cur = callWithThis(cur, curThis, argv)
                curThis = undefined
            }
        }
        var last = ref.path[ref.path.length - 1]
        if (last.kind != "member") fail("assignment target must end in a member")
        if (cur == undefined) fail("member assignment on " + cur)
        return {obj: cur, key: last.key()}
    }
    applyOp = function(op, a, b) {
        if (op == "+=") return a + b
        if (op == "-=") return a - b
        if (op == "*=") return a * b
        if (op == "/=") return a / b
        if (op == "%=") return a % b
        if (op == "**=") return Math.pow(a, b)
        if (op == "<<=") return a << b
        if (op == ">>=") return a >> b
        if (op == ">>>=") return a >>> b
        if (op == "&=") return a & b
        if (op == "^=") return a ^ b
        if (op == "|=") return a | b
    }
    // The two halves of a target reference, shared by the assignment builders: a bare
    // name goes through the scope chain, a path through resolveRef's {obj, key} place.
    function refGet(ref) {
        if (ref.path.length == 0) return getVar(ref.name)
        var p = resolveRef(ref)
        return getMember(p.obj, p.key)
    }
    function refSet(ref, v) {
        if (ref.path.length == 0) { setVar(ref.name, v); return }
        var p = resolveRef(ref)
        setMember(p.obj, p.key, v)
    }
    // items = [ref, "&&="|"||="|"??=", valueThunk]. The right-hand side is evaluated
    // ONLY when the test says the assignment happens; the value of the expression is the
    // new value when it did, the old one when it did not.
    function makeLogicalAssign(items) {
        var ref = items[0]
        var op = items[1]
        var valT = items[2]
        return function() {
            var cur = anytype // The current value may be of any type.
            cur = refGet(ref)
            var assign = false
            if (op == "&&=") { assign = cur ? true : false }
            else if (op == "||=") { assign = cur ? false : true }
            else { assign = (cur === null || cur === undefined) }
            if (!assign) { return cur }
            var v = anytype // So may the new one.
            v = valT()
            refSet(ref, v)
            return v
        }
    }
    // items = [{lhsprim}, suffix marker..., opString, valueThunk]. The left side is an
    // arbitrary expression reached through at least one member access, so the reference
    // it builds carries the primary's thunk instead of a variable name; everything after
    // that is the ordinary assignment path.
    function makeLhsAssign(items) {
        var ref = {prim: items[0].lhsprim, path: items.slice(1, items.length - 2)}
        var op = items[items.length - 2]
        var valT = items[items.length - 1]
        return function() {
            var v = anytype // A compound assignment may change the value's type.
            v = valT()
            var p = resolveRef(ref)
            if (op != "=") { v = applyOp(op, getMember(p.obj, p.key), v) }
            setMember(p.obj, p.key, v)
            return v
        }
    }

    // items = [ref, opString, valueThunk]. Returns the assigned value (assignment is an expression).
    function makeAssign(items) {
        var ref = items[0]
        var op = items[1]
        var valT = items[2]
        return function() {
            var v = anytype // A compound assignment (s += n) may change the value's type.
            v = valT()
            if (ref.path.length == 0) {
                if (op != "=") v = applyOp(op, getVar(ref.name), v)
                setVar(ref.name, v)
            } else {
                var p = resolveRef(ref)
                if (op != "=") v = applyOp(op, getMember(p.obj, p.key), v)
                setMember(p.obj, p.key, v)
            }
            return v
        }
    }
    // items = [ref, "++"|"--"]. Post increment: the expression value is the old (coerced) one.
    function makeIncDec(items) {
        var ref = items[0]
        var delta = (items[1] == "++") ? 1 : -1
        return function() {
            if (ref.path.length == 0) {
                var n = getVar(ref.name) - 0
                setVar(ref.name, n + delta)
                return n
            }
            var p = resolveRef(ref)
            var m = getMember(p.obj, p.key) - 0
            setMember(p.obj, p.key, m + delta)
            return m
        }
    }
    // Prefix ++/--: like makeIncDec, but the expression value is the new one.
    function makePreIncDec(ref, op) {
        var delta = (op == "++") ? 1 : -1
        return function() {
            if (ref.path.length == 0) {
                var n = getVar(ref.name) - 0 + delta
                setVar(ref.name, n)
                return n
            }
            var p = resolveRef(ref)
            var m = getMember(p.obj, p.key) - 0 + delta
            setMember(p.obj, p.key, m)
            return m
        }
    }

    // ----- Statement thunks: function() -> undefined | BRK | CONT | {isRet, v} -----

    // An expression in statement position: evaluate and discard the value.
    // items = [name] or [name, initThunk].
    function makeDecl(items) {
        var name = items[0]
        var init = items.length > 1 ? items[1] : makeConst(undefined)
        return function() { declVar(name, init()) }
    }
    // ----- Labels -----
    // A labeled break/continue is a signal object {lbl, isBrk} that travels outwards
    // like a return does, until it reaches the loop (or labeled statement) that carries
    // the name. Each loop production captures the label standing in front of it at BUILD
    // time - takeLabel is called from a tag on the loop's own keyword, which the walk
    // reaches before any tag inside the body, so a nested loop cannot steal it.
    var pendingLabel = ""
    function takeLabel() {
        var l = pendingLabel
        pendingLabel = ""
        return l
    }
    // How a loop must react to the signal its body returned: the plain BRK/CONT, a
    // labeled break/continue that names THIS loop (same thing), or anything else - a
    // return, or a label belonging to an enclosing statement - which propagates.
    function loopAction(r, label) {
        if (r == undefined) { return "none" }
        if (r === BRK) { return "break" }
        if (r === CONT) { return "continue" }
        if (r.lbl != undefined && r.lbl === label && label !== "") { return r.isBrk ? "break" : "continue" }
        return "propagate"
    }
    // items = [] or [{lblref}]. A bare break/continue keeps the shared BRK/CONT sentinel,
    // so the overwhelmingly common case costs nothing.
    function makeBreakStmt(items) {
        if (items.length == 0) { return makeBreak() }
        var l = items[0].lblref
        return function() { return {lbl: l, isBrk: true} }
    }
    function makeContinueStmt(items) {
        if (items.length == 0) { return makeContinue() }
        var l = items[0].lblref
        return function() { return {lbl: l, isBrk: false} }
    }
    // items = [label, bodyThunk]. A loop has already dealt with its own label, so what
    // reaches here is the labeled break of a NON-loop statement ('l: { ... break l }').
    function makeLabeled(items) {
        var label = items[0]
        var bodyT = items[1]
        takeLabel() // A labeled NON-loop never consumed the pending label - drop it here,
                    // or it would attach itself to the next loop in the file.
        return function() {
            var r = bodyT()
            if (r != undefined && r.lbl != undefined && r.lbl === label) { return undefined }
            return r
        }
    }
    // items = [{label}, condThunk, bodyThunk].
    function makeWhileStmt(items) {
        var label = items[0].label
        var condT = items[1]
        var bodyT = items[2]
        return function() {
            var res = undefined
            while (condT()) {
                var r = bodyT()
                var a = loopAction(r, label)
                if (a == "break") break
                if (a == "propagate") { res = r; break }
            }
            return res
        }
    }
    // items = [{label}, bodyThunk, condThunk].
    function makeDo(items) {
        var label = items[0].label
        var bodyT = items[1]
        var condT = items[2]
        return function() {
            var res = undefined
            do {
                var r = bodyT()
                var a = loopAction(r, label)
                if (a == "break") break
                if (a == "propagate") { res = r; break }
            } while (condT())
            return res
        }
    }
    // items = [{label}, {k:"init"|"cond"|"post", t:thunk}..., bodyThunk].
    function makeFor(items) {
        var bodyT = items.pop()
        var label = items[0].label
        var init = null, cond = null, post = null
        for (var i = 1; i < items.length; i++) {
            if (items[i].k == "init") init = items[i].t
            if (items[i].k == "cond") cond = items[i].t
            if (items[i].k == "post") post = items[i].t
        }
        return function() {
            scopes.push({}) // The for header is its own scope (for the loop variable).
            var res = undefined
            if (init != null) init()
            while (cond == null || cond()) {
                var r = bodyT()
                var a = loopAction(r, label)
                if (a == "break") break
                if (a == "propagate") { res = r; break } // A return, or an outer label.
                if (post != null) post()
            }
            scopes.pop()
            return res
        }
    }
    // items = [] or [exprThunk].
    function makeReturn(items) {
        var t = items.length > 0 ? items[0] : makeConst(undefined)
        return function() { return {isRet: true, v: t()} }
    }

    // items = [subjThunk, ({casev}|{isdflt}|stmtThunk)...]. The flat label/statement
    // list is grouped into case descriptors at build time; at run time the first ===
    // match (or default) starts execution, which falls through until a break.
    function makeSwitch(items) {
        var subj = items[0]
        var cases = []
        var cur = null
        for (var i = 1; i < items.length; i++) {
            var p = items[i]
            if (p != undefined && (p.casev != undefined || p.isdflt != undefined)) {
                cur = {isDefault: p.isdflt != undefined, v: p.casev, body: []}
                cases.push(cur)
            } else {
                if (cur == null) fail("switch: a statement before the first case label")
                cur.body.push(p)
            }
        }
        return function() {
            var v = subj()
            var start = -1
            var dflt = -1
            for (var i = 0; i < cases.length; i++) {
                if (cases[i].isDefault) { if (dflt < 0) dflt = i; continue }
                if (start < 0 && cases[i].v() === v) { start = i }
            }
            if (start < 0) { start = dflt }
            if (start < 0) { return undefined }
            for (var i = start; i < cases.length; i++) {
                var body = cases[i].body
                for (var j = 0; j < body.length; j++) {
                    var r = body[j]()
                    if (r === BRK) { return undefined }        // break leaves the switch
                    if (r != undefined) { return r }           // return/continue propagate
                }
            }
            return undefined
        }
    }

    // Local stack = [name, [paramNames...], bodyThunk] -- binds the closure when executed.
    function makeFuncDecl(bodyT, paramNames, name) {
        return function() { declVar(name, makeClosure(paramNames, bodyT, scopes)) }
    }

    // Build the program thunk out of the parsed source.
    // ----- Core library config (see lib/interp-core.js) -----
    core.lang = "js"

    // Build an import statement (see the ImportStmt rule): resolve the referenced file at
    // compile time - which loads and runs it, registering its declarations - and leave a
    // no-op thunk in the program. The path is the last item ModPath pushed.
    function jsImport(items, pos) {
        resolveImport(items[items.length - 1], pos)
        return function() { return undefined }
    }

    // JS has no importable stdlib modules in this subset, so every import path is a
    // project file (resolveImport hands them all to core.importFile below).
    core.stdlibImports = []

    // Project-file imports: load the file, parse it with this grammar, walk it (which
    // leaves its top-level statement thunk on the global stack) and run that thunk now,
    // so the file's function/class/var declarations register in the shared global scope
    // before the main program's top level runs. A file is loaded once; repeats and cycles
    // are no-ops. The path is a literal relative path ('./geomlib.js'): a leading './' is
    // dropped and a missing '.js' extension is appended before the -i-root search.
    var importedFiles = {}
    core.importFile = function(path, pos) {
        var rel = path
        if (rel.length >= 2 && rel.charAt(0) == "." && rel.charAt(1) == "/") { rel = rel.substring(2) }
        if (!(rel.length >= 3 && rel.substring(rel.length - 3) == ".js")) { rel = rel + ".js" }
        var file = c.findImport(rel)
        if (file == "") { return false }
        if (importedFiles["$" + file] == true) { return true }
        importedFiles["$" + file] = true
        var text = c.readFile(file)
        var asg = c.parse(c.agrammar, text, null, file)
        c.pushSource(file, text)
        c.compile(asg)
        c.popSource()
        var mod = popg()
        mod()
        return true
    }

    c.compile(c.asg)
    var progT = popg()

    // Run the top level (it binds the functions), then call main(). The exit code of
    // this metacompiler run is what main() returned, so test programs are self checking.
    progT()
    // The entry point defaults to main() but the -main flag (c.mainName) can name any
    // other top-level function.
    var entry = c.mainName
    if (entry == undefined || entry == "") { entry = "main" }
    // A user exception that escapes the entry point is reported like any runtime error.
    var ret = anytype
    if (mainIsSnippet(entry)) {
        try {
            ret = runMainSnippet(entry, "Statement")
        } catch (e) {
            if (excIsUser(e)) { fail("uncaught exception: " + e.v) }
            throw e
        }
        println("js interpreter: -main snippet returned " + ret)
    } else {
        if (!hasOwn(globalScope, entry) || typeof globalScope[entry] != "function") {
            fail("JavaScript programs need a " + entry + "() function.")
        }
        try {
            ret = globalScope[entry]()
        } catch (e) {
            if (excIsUser(e)) { fail("uncaught exception: " + e.v) }
            throw e
        }
        println("js interpreter: " + entry + "() returned " + ret)
    }
    exit(ret | 0)

~~) ;
