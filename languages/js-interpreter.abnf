        return "(intermediate value)"
    }
    function siteIndexText(base, txt) {
        // txt is the suffix's own matched input, brackets and all: up.in, which has
        // its whitespace elided ("[ i + 1 ]" arrives as "[i+1]"), or the source as
        // written when that spacing matters (cpTxt). The
        // optional form's rule also matched its "?." in one grammar and not in the
        // other, so the opening bracket is SEARCHED for rather than assumed at 0.
        var open = txt.indexOf("[")
        if (open < 0) { return base + "[?]" }
        var inner = txt.substring(open + 1, txt.length - 1)
        var ix = cpIndex(inner)
        if (ix !== null) { return base + ix }
        if (inner.length >= 2) {
            var q = inner.charCodeAt(0)
            if ((q == 34 || q == 39) && inner.charCodeAt(inner.length - 1) == q) {
