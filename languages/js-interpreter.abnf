    // ----- Class members -----
    // Each member production pushes one descriptor. The pieces are recognized by SHAPE
    // rather than by position, because the 'static' modifier, the async/generator markers
    // and the kind of key are each optional in one spelling or another.
    function hasStatic(mods) {
        for (var i = 0; i < mods.length; i++) { if (mods[i] == "static") { return true } }
        return false
    }
    // The name a member is filed under. A computed key is only known at run time, so it
    // is a thunk and this is called from inside the class-building thunk.
    function memberKey(m) {
        if (m.keyT != undefined && m.keyT != null) { return "" + m.keyT() }
        return m.name
    }
    // items = [{mods}, ({isasync}|{isgen})*, keyDesc, params, bodyThunk].
    function makeMethod(items) {
        var statik = hasStatic(items[0].mods)
        var i = 1
        var isGen = false
        while (items[i] != undefined && (items[i].isasync != undefined || items[i].isgen != undefined)) {
            if (items[i].isgen != undefined) { isGen = true }
            i = i + 1
        }
        var key = items[i]
        return {kind: "method", name: key.mk, keyT: key.mkT, statik: statik, isGen: isGen,
