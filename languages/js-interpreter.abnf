    // pattern's leaves in whatever scope is current when interp-core calls it, which is
    // the catch clause's own freshly pushed scope.
    function makeCatchBinder(pat) {
        return function(v) { bindPattern(pat, v) }
    }
    // 'export default <expression>': the value is not bound anywhere, but the expression
    // runs, so 'export default register()' still registers.
    function makeExportDefault(t) {
        return function() { t(); return undefined }
    }
    function jsImport(items, pos) {
        resolveImport(items[items.length - 1], pos)
        return function() { return undefined }
    }

    // JS has no importable stdlib modules in this subset, so every import path is a
    // project file (resolveImport hands them all to core.importFile below).
    core.stdlibImports = []

    // Project-file imports: load the file, parse it with this grammar, walk it (which
    // leaves its top-level statement thunk on the global stack) and run that thunk now,
    // so the file's function/class/var declarations register in the shared global scope
    // before the main program's top level runs. A file is loaded once; repeats and cycles
    // are no-ops. The path is a literal relative path ('./geomlib.js'): a leading './' is
    // dropped and a missing '.js' extension is appended before the -i-root search.
    var importedFiles = {}
    core.importFile = function(path, pos) {
        var rel = path
        if (rel.length >= 2 && rel.charAt(0) == "." && rel.charAt(1) == "/") { rel = rel.substring(2) }
        if (!(rel.length >= 3 && rel.substring(rel.length - 3) == ".js")) { rel = rel + ".js" }
        var file = c.findImport(rel)
        if (file == "") { return false }
        if (importedFiles["$" + file] == true) { return true }
        importedFiles["$" + file] = true
        var text = c.readFile(file)
        var asg = c.parse(c.agrammar, text, null, file)
        c.pushSource(file, text)
        c.compile(asg)
        c.popSource()
        var mod = popg()
        jsbLoad()
        mod()
        return true
    }

    // lib/js-builtins.js (Set, Map, Array.from, Array.of, Boolean, isNaN, isFinite, structuredClone) is JavaScript,
    // compiled into a program that names one of them (jsbRef, at the
    // VarRef, typeof-name and new-name tags) and run before anything that could use it:
    // before an imported file's top level and before the program's. Twin of jsbLoad in
    // js-to-llvm-ir.abnf.
    var jsbWant = false
    var jsbDone = false
    function jsbRef(name) {
        if (name == "Set" || name == "Map" || name == "Array" || name == "isNaN" || name == "isFinite" ||
            name == "structuredClone") { jsbWant = true }
        if (name == "arguments") { argsWant = true }
        return name
    }
    function jsbLoad() {
        if (!jsbWant || jsbDone) { return }
        jsbDone = true
        var text = load("lib/js-builtins.js")
        var asg = c.parse(c.agrammar, text, null, "js-builtins.js")
        c.pushSource("js-builtins.js", text)
        jsKeyRaw = true
        c.compile(asg)
        jsKeyRaw = false
        c.popSource()
        var mod = popg()
        mod()
    }

    c.compile(c.asg)
    var progT = popg()
    jsbLoad()

    // Run the top level (it binds the functions), then call main(). The exit code of
    // this metacompiler run is what main() returned, so test programs are self checking.
    // THE TOP LEVEL RUNS INSIDE THE SAME GUARD AS main(): a JavaScript exception
    // nobody caught at the top level must be reported as the program's uncaught
    // exception, not escape the interpreter as a raw host exception.
    try {
        progT()
    } catch (e) {
        if (excIsUser(e)) { fail("uncaught exception: " + jsStr(e.v)) }
        throw e
    }
    // The entry point defaults to main() but the -main flag (c.mainName) can name any
    // other top-level function.
    var entry = c.mainName
    if (entry == undefined || entry == "") { entry = "main" }
    // A user exception that escapes the entry point is reported like any runtime error.
    var ret = anytype
    if (mainIsSnippet(entry)) {
        try {
            ret = runMainSnippet(entry, "Statement")
            jsDrain()
        } catch (e) {
            if (excIsUser(e)) { fail("uncaught exception: " + jsStr(e.v)) }
            throw e
        }
        println("js interpreter: -main snippet returned " + ret)
    } else {
        if (!hasOwn(globalScope, entry) || typeof globalScope[entry] != "function") {
            fail("JavaScript programs need a " + entry + "() function.")
        }
        try {
            ret = globalScope[entry]()
            // The microtask queue is drained ONCE, after the whole program has run: this
            // runtime has no timers and no I/O, so that is the only event-loop turn a
            // program gets, and it is where every .then reaction and every resumption of
            // an async body happens. The compiler half drains at the same point.
            jsDrain()
        } catch (e) {
            if (excIsUser(e)) { fail("uncaught exception: " + jsStr(e.v)) }
            throw e
        }
        println("js interpreter: " + entry + "() returned " + ret)
    }
    exit(ret | 0)

~~) ;
