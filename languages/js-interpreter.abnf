:startScript(~~

    // Shared interpreter machinery (scopes, BRK/CONT protocol, expression and
    // statement builders); language-specific behavior is configured on `core` below.
    include("lib/interp-core.js")

    // takeAll empties the local stack of the current tag and returns its items in push
    // order as a plain JS array. It only uses pop(), so it works independently of how
    // the runtime wraps the Go slice behind up.stack.
    // Resolves the JS string escapes (\n \t \r \0 \xNN \uNNNN, and \c for the char itself).
    // The host unescape() is for the grammar token syntax and rejects \' and \", so the
    // JS string literals bring their own unescaper.
    // ----- Scopes -----
    // 'scopes' is the active scope chain (innermost last). Every closure captures a copy
    // of the chain array; the scope objects inside stay shared, so later declarations in
    // an already captured scope are visible to the closure (that is what allows mutual
    // recursion between top level functions).

    // The host names that a JS program can use. Everything resolves to the goja
    // natives, so e.g. Math.imul or the string/array methods behave exactly like in JS.
    var hostGlobals = {
        "println": println, "print": print, "printf": printf, "sprintf": sprintf,
        "parseInt": parseInt, "parseFloat": parseFloat, "Math": Math, "String": String,
        "exit": exit
    }

    // Plain, unpinned scope entries: a variable holds its value directly and may
    // change type freely. No declare-before-use discipline.
    getVar = function(name) {
        for (var i = scopes.length - 1; i >= 0; i--) {
            if (hasOwn(scopes[i], name)) return scopes[i][name]
        }
        if (hasOwn(hostGlobals, name)) return hostGlobals[name]
        fail("variable not defined: " + name)
    }
    declVar = function(name, value) {
        scopePut(scopes[scopes.length - 1], name, value)
    }
    // Assignment walks the chain; a name that is nowhere declared becomes an
    // implicit global (real, non strict JavaScript), never an error.
    setVar = function(name, value) {
        for (var i = scopes.length - 1; i >= 0; i--) {
            if (hasOwn(scopes[i], name)) { scopePut(scopes[i], name, value); return }
        }
        scopePut(globalScope, name, value)
    }

    // ----- Statement signals -----
    // Statement thunks return undefined (fall through), BRK, CONT, or {isRet:true, v:...}.

    // ----- Functions -----
    // A MetaJS function value is a real (goja) JS function, so typeof, passing it around,
    // and calling it work natively. It closes over the scope chain of its creation.
    function makeClosure(params, bodyT, defScopes) {
        var env = defScopes.slice()
        return function() {
            var args = []
            for (var i = 0; i < arguments.length; i++) args.push(arguments[i])
            var saved = scopes
            scopes = env.slice()
            var sc = {}
            for (var j = 0; j < params.length; j++) {
                scopePut(sc, params[j], args[j])
            }
            sc["arguments"] = args
            scopes.push(sc)
            var r = bodyT()
            scopes = saved
            return (r != undefined && r.isRet) ? r.v : undefined
        }
    }

    function getMember(o, k) {
        if (o == undefined) fail("member '" + k + "' of " + o) // Catches null and undefined.
        // Plain objects (instances, literals) read own properties only: a bare o[k]
        // resolved inherited Object.prototype members (toString, valueOf, ...) under a
        // host JS engine, while the frozen engine's objects have no prototype chain.
        if (typeof o == "object" && !Array.isArray(o) && !hasOwn(o, k)) return undefined
        return o[k]
    }

    // ----- Expression thunks: function() -> value -----

    makeNeg = function(t) { return function() { return -t() } }
    function makeBitNot(t) { return function() { return ~t() } }
    function makeTypeof(t) { return function() { return typeof t() } }

    // ----- Widened-surface helpers: transparent pass-through with one operand, else
    // ACCEPTED-but-not-lowered (notImplExpr). Mirrors js-to-llvm-ir.abnf exactly. -----
    function makeNullish(items, pos) { if (items.length == 1) return items[0]; return notImplExpr("nullish coalescing (??)", pos) }
    function makeExp(items, pos)     { if (items.length == 1) return items[0]; return notImplExpr("exponentiation (**)", pos) }
    function makeInInstanceof(items, pos) { if (items.length == 1) return items[0]; return notImplExpr("instanceof / in operator", pos) }
    function makeSequence(items, pos) { if (items.length == 1) return items[0]; return notImplExpr("sequence expression", pos) }
    // A not-lowered object property: a deterministic placeholder descriptor whose value
    // thunk is a notImplExpr.
    function notImplProp(name, pos) { return makeProp(notImplExpr(name, pos), "0notImpl") }
    // A not-lowered class member: warn and push a skip marker makeClassStmt ignores.
    function notImplMember(name, pos) { notImpl(name, pos); return {skip: true} }

    function makeArray(items) {
        return function() {
            var a = []
            for (var i = 0; i < items.length; i++) a.push(items[i]())
            return a
        }
    }
    // PropDef pops [valueThunk, key]; the key is an Id string or a constant string thunk
    // (calling the pure thunk once at build time yields the key text).
    function makeProp(valT, key) {
        return {k: (typeof key == "string") ? key : key(), t: valT}
    }
    // Objects carry a hidden __keys array recording their own keys in insertion order.
    // The tag dialect has no for-in and no Object.keys, and the -frozen engine cannot
    // enumerate a native object, so for-in reads this list instead. It matches the
    // compiler's js_keys (insertion order, __-prefixed keys never recorded).
    // A key that js_keys hides: the __-prefixed internal slots (__class, __keys, ...).
    function isInternalKey(key) {
        return typeof key == "string" && key.length >= 2 && key.charAt(0) == "_" && key.charAt(1) == "_"
    }
    function makeObject(props) {
        return function() {
            var o = {}
            var keys = []
            for (var i = 0; i < props.length; i++) {
                scopePut(o, props[i].k, props[i].t())
                if (!isInternalKey(props[i].k) && keys.indexOf(props[i].k) < 0) { keys.push(props[i].k) }
            }
            o["__keys"] = keys
            return o
        }
    }
    // Records a newly assigned key on a tracked object (an object carrying __keys). Plain
    // arrays and untracked values are left alone; only string, non-internal keys count.
    function trackKey(o, key) {
        if (o == undefined || o == null) { return }
        if (typeof key != "string") { return }
        if (isInternalKey(key)) { return }
        if (!hasOwn(o, "__keys")) { return }
        var ks = o["__keys"]
        if (ks.indexOf(key) < 0) { ks.push(key) }
    }
    // The own keys of an object for for-in: a snapshot (so the body may add keys), the
    // __-prefixed internals never appear (they are never recorded in __keys).
    function jsKeys(o) {
        if (o == undefined || o == null) fail("for-in over " + o)
        if (hasOwn(o, "__keys")) return o["__keys"].slice()
        return []
    }

    function makeFunctionExpr(bodyT, params) {
        return function() { return makeClosure(params, bodyT, scopes) }
    }

    // Arrow function: items = [{aparams:[names]}, {body: stmtThunk} | {ebody: exprThunk}].
    // A block body is a statement thunk (returns undefined|signal, handled by
    // makeClosure); an expression body becomes an implicit 'return <expr>'.
    function makeArrow(items) {
        var params = items[0].aparams
        var bm = items[1]
        var bodyT = anytype // Either a block statement thunk or a synthesized return.
        if (bm.body != undefined) {
            bodyT = bm.body
        } else {
            var et = bm.ebody
            bodyT = function() { return {isRet: true, v: et()} }
        }
        return function() { return makeClosure(params, bodyT, scopes) }
    }

    // Template literal: items = [{str:"chunk"} | {expr: thunk}...] -> string thunk.
    // Starting from "" forces JS string coercion on every interpolated part.
    function makeTemplate(items) {
        return function() {
            var out = anytype // The running value is a string after the first "" seed.
            out = ""
            for (var i = 0; i < items.length; i++) {
                if (items[i].str != undefined) { out = out + items[i].str }
                else { out = out + items[i].expr() }
            }
            return out
        }
    }

    // for-of / for-in. items = [name, "of"|"in", iterThunk, bodyThunk].
    // for-of genuinely iterates array elements / string characters by index.
    function makeForOf(items, pos) {
        var name = items[0]
        var iterT = items[2]
        var bodyT = items[3]
        if (items[1] == "in") {
            // for-in iterates the object's own keys (jsKeys), binding the loop variable
            // to each key string - mirrors the compiler's js_keys.
            return function() {
                var obj = anytype // The object whose keys are enumerated.
                obj = iterT()
                var ks = jsKeys(obj)
                scopes.push({})
                var res = undefined
                for (var i = 0; i < ks.length; i++) {
                    declVar(name, ks[i])
                    var r = bodyT()
                    if (r != undefined) {
                        if (r === BRK) break
                        if (r !== CONT) { res = r; break }
                    }
                }
                scopes.pop()
                return res
            }
        }
        return function() {
            var it = anytype // The iterable is an array or a string.
            it = iterT()
            scopes.push({}) // The loop header/variable get their own scope.
            var res = undefined
            for (var i = 0; i < it.length; i++) {
                declVar(name, it[i])
                var r = bodyT()
                if (r != undefined) {
                    if (r === BRK) break
                    if (r !== CONT) { res = r; break }
                }
            }
            scopes.pop()
            return res
        }
    }

    // A destructuring binding. makeDField turns a parsed object field into
    // {key, pat}: a shorthand {x} binds property x to a name x, {x: t} binds
    // property x to the sub-pattern t. bindPattern walks a pattern node
    // ({dtype:"id"|"arr"|"obj"}) against a value, declaring each leaf name to its
    // array element (by index) or object property (by key). The compiler lowers
    // the identical pattern tree the same way.
    function makeDField(items) {
        if (items.length == 1) return {key: items[0], pat: {dtype: "id", name: items[0]}}
        return {key: items[0], pat: items[1]}
    }
    function bindPattern(pat, value) {
        if (pat.dtype == "id") { declVar(pat.name, value) }
        else if (pat.dtype == "arr") {
            for (var i = 0; i < pat.elems.length; i++) { bindPattern(pat.elems[i], value[i]) }
        } else {
            for (var j = 0; j < pat.fields.length; j++) { bindPattern(pat.fields[j].pat, value[pat.fields[j].key]) }
        }
    }
    // items = [patternNode, initThunk]. Evaluate the initializer once, then bind.
    function makeDestructure(items, pos) {
        var pat = items[0]
        var init = items[1]
        return function() {
            var v = anytype // The initializer may be an array or an object.
            v = init()
            bindPattern(pat, v)
        }
    }

    // try/catch/finally and throw are handled by excTry/excThrow (lib/interp-core.js).

    // ----- Classes (the __class machinery, mirrors js-to-llvm-ir.abnf) -----
    // An instance is a plain object carrying a __class descriptor; the descriptor holds
    // the methods (closures over the class-defining scope) and the __ctor. A method call
    // dispatches through mcall (below), which prepends the instance as the receiver and
    // follows __super for inheritance; super.m() invokes the parent's method on 'this'.

    // The class whose body is being built, captured by super() / super.m() at build time.
    var curClassName = ""

    // An instance method: a closure binding this = arguments[0], params from arguments[1..].
    function makeInstanceClosure(params, bodyT, defScopes) {
        var env = defScopes.slice()
        return function() {
            var self = arguments[0]
            var args = []
            for (var i = 1; i < arguments.length; i++) args.push(arguments[i])
            var saved = scopes
            scopes = env.slice()
            var sc = {}
            sc["this"] = self
            for (var j = 0; j < params.length; j++) scopePut(sc, params[j], args[j])
            sc["arguments"] = args
            scopes.push(sc)
            var r = bodyT()
            scopes = saved
            return (r != undefined && r.isRet) ? r.v : undefined
        }
    }

    // A constructor closure: binds this = arguments[0], runs (for a default subclass ctor)
    // the implicit no-argument super, then the field initializers, then the body.
    function makeCtorClosure(params, bodyT, fields, defScopes, superName, isDefault) {
        var env = defScopes.slice()
        return function() {
            var self = arguments[0]
            var args = []
            for (var i = 1; i < arguments.length; i++) args.push(arguments[i])
            var saved = scopes
            scopes = env.slice()
            var sc = {}
            sc["this"] = self
            for (var j = 0; j < params.length; j++) scopePut(sc, params[j], args[j])
            sc["arguments"] = args
            scopes.push(sc)
            if (isDefault && superName != null) {
                var supCls = getVar(superName)
                supCls.__ctor.apply(undefined, [self])
            }
            for (var k = 0; k < fields.length; k++) {
                var fv = (fields[k].init != null) ? fields[k].init() : undefined
                scopePut(self, fields[k].name, fv)
                trackKey(self, fields[k].name)
            }
            if (bodyT != null) bodyT()
            scopes = saved
            return undefined
        }
    }

    // Method dispatch on an instance: follow the __class / __super chain. Native and
    // object-literal methods never reach here - foldCallMember calls this only when the
    // looked-up member was not itself a function value.
    function mcall(target, name, args) {
        if (target != undefined && target != null && target.__class != undefined) {
            var m = undefined
            for (var cl = target.__class; cl != undefined && m == undefined; cl = cl.__super) { if (hasOwn(cl, name)) m = cl[name] }
            if (typeof m != "function") fail("unknown method '" + name + "' on an instance")
            return m.apply(undefined, concat2impl([target], args))
        }
        fail("call of a non function value (method '" + name + "')")
    }

    function makeMethod(items) {
        var mods = items[0].mods
        var name = items[1].mname
        var params = items[2]   // The parameter names array (from ParamList).
        var body = items[3]
        var isStatic = false
        for (var i = 0; i < mods.length; i++) { if (mods[i] == "static") { isStatic = true } }
        return {kind: "method", name: name, statik: isStatic, params: params, body: body}
    }
    function makeCtor(items) {
        return {kind: "ctor", params: items[0], body: items[1]}
    }
    function makeField(items) {
        var mods = items[0].mods
        var name = items[1].fname
        var init = items.length > 2 ? items[2] : null
        var isStatic = false
        for (var i = 0; i < mods.length; i++) { if (mods[i] == "static") { isStatic = true } }
        return {kind: "field", name: name, statik: isStatic, init: init}
    }

    // A class declaration: build the descriptor object, attach static fields, the
    // constructor and the methods, then bind it in the current scope.
    function makeClassStmt(items) {
        var name = items[0].cname
        var superName = null
        var members = []
        for (var i = 1; i < items.length; i++) {
            if (items[i] == undefined) { continue }
            if (items[i].ext != undefined) { superName = items[i].ext }
            else if (items[i].skip != undefined) { continue }
            else { members.push(items[i]) }
        }
        var fields = []
        var methods = []
        var statics = []
        var ctorInfo = null
        for (var j = 0; j < members.length; j++) {
            var mm = members[j]
            if (mm.kind == "field") { if (mm.statik) { statics.push(mm) } else { fields.push(mm) } }
            else if (mm.kind == "method") { methods.push(mm) }
            else if (mm.kind == "ctor") { ctorInfo = mm }
        }
        return function() {
            var defScopes = scopes.slice()
            var cls = {}
            cls["__isclass"] = true
            cls["__name"] = name
            if (superName != null) {
                var sup = getVar(superName)
                if (sup == undefined || !sup.__isclass) fail("unknown superclass: " + superName)
                cls["__super"] = sup
            }
            for (var s = 0; s < statics.length; s++) {
                cls[statics[s].name] = (statics[s].init != null) ? statics[s].init() : undefined
            }
            if (ctorInfo != null) {
                cls["__ctor"] = makeCtorClosure(ctorInfo.params, ctorInfo.body, fields, defScopes, superName, false)
            } else {
                cls["__ctor"] = makeCtorClosure([], null, fields, defScopes, superName, true)
            }
            for (var mi = 0; mi < methods.length; mi++) {
                if (methods[mi].statik) { cls[methods[mi].name] = makeClosure(methods[mi].params, methods[mi].body, defScopes) }
                else { cls[methods[mi].name] = makeInstanceClosure(methods[mi].params, methods[mi].body, defScopes) }
            }
            declVar(name, cls)
            return undefined
        }
    }

    // new C(args): build the instance, attach __class, run the constructor as
    // __ctor(instance, args...).
    function makeNew(items) {
        var clsName = items[0].cls
        var argThunks = items.slice(1)
        return function() {
            var cls = getVar(clsName)
            if (cls == undefined || !cls.__isclass) fail("unknown class: " + clsName)
            var obj = {}
            obj["__class"] = cls
            obj["__keys"] = []
            var argv = [obj]
            for (var i = 0; i < argThunks.length; i++) argv.push(argThunks[i]())
            cls.__ctor.apply(undefined, argv)
            return obj
        }
    }

    // super(args): delegate to the parent constructor. super.m(args): dispatch m on the
    // parent class. The defining class is captured at build time (curClassName).
    function makeSuperCall(name, argThunks) {
        var defName = curClassName
        if (name == "") {
            return function() {
                var self = getVar("this")
                var supCls = getVar(defName).__super
                if (supCls == undefined) fail("super() with no superclass")
                var argv = [self]
                for (var i = 0; i < argThunks.length; i++) argv.push(argThunks[i]())
                supCls.__ctor.apply(undefined, argv)
                return undefined
            }
        }
        return function() {
            var self = getVar("this")
            var m = undefined
            for (var cl = getVar(defName).__super; cl != undefined && m == undefined; cl = cl.__super) { if (hasOwn(cl, name)) m = cl[name] }
            if (typeof m != "function") fail("unknown super method '" + name + "'")
            var argv = [self]
            for (var i = 0; i < argThunks.length; i++) argv.push(argThunks[i]())
            return m.apply(undefined, argv)
        }
    }

    binOp = function(op, l, r) {
        if (op == "+") return l + r
        if (op == "-") return l - r
        if (op == "*") return l * r
        if (op == "/") return l / r
        if (op == "%") return l % r
        if (op == "==") return l == r
        if (op == "!=") return l != r
        if (op == "===") return l === r
        if (op == "!==") return l !== r
        if (op == "<")  return l < r
        if (op == ">")  return l > r
        if (op == "<=") return l <= r
        if (op == ">=") return l >= r
        if (op == "|")  return l | r
        if (op == "^")  return l ^ r
        if (op == "&")  return l & r
        if (op == "<<") return l << r
        if (op == ">>") return l >> r
        if (op == ">>>") return l >>> r
    }
    // items = [thunk, op, thunk, op, thunk, ...] -> one left folded thunk.
    // || and && evaluate lazily and return the deciding operand, like in JS.
    function makeOr(items) {
        if (items.length == 1) return items[0]
        return function() {
            var v = anytype // The operands may be of mixed types.
            v = items[0]()
            for (var i = 1; i < items.length; i++) {
                if (v) return v
                v = items[i]()
            }
            return v
        }
    }
    function makeAnd(items) {
        if (items.length == 1) return items[0]
        return function() {
            var v = anytype // The operands may be of mixed types.
            v = items[0]()
            for (var i = 1; i < items.length; i++) {
                if (!v) return v
                v = items[i]()
            }
            return v
        }
    }
    // items = [thunk] or [condThunk, thenThunk, elseThunk].
    function makeCond(items) {
        if (items.length == 1) return items[0]
        return function() { return items[0]() ? items[1]() : items[2]() }
    }

    // items = [primaryThunk, {kind:"call"|"member", ...}...].
    // A member access remembers its object and its key. A directly following call is a
    // method call: if the looked-up member is a function value it is applied with the
    // object as 'this' (native string/array methods, object-literal methods); otherwise
    // it is a __class instance method, routed through mcall (which prepends the receiver
    // and follows __super). A call not preceded by a member is a plain function call.
    foldCallMember = function(items) {
        if (items.length == 1) return items[0]
        var primary = items[0]
        var suffixes = items.slice(1)
        // Any optional-chaining suffix (?. ?.[ ?.( ) routes the whole chain to
        // notImplemented: there is no short-circuit-on-nullish model in the subset.
        for (var oi = 0; oi < suffixes.length; oi++) {
            if (suffixes[oi].kind == "optchain") return notImplExpr("optional chaining (?.)", suffixes[oi].pos)
        }
        return function() {
            var cur = anytype     // A member chain hops between types,
            var curThis = anytype // so do the remembered receiver
            var lastKey = anytype // and the remembered key.
            cur = primary()
            for (var i = 0; i < suffixes.length; i++) {
                var s = suffixes[i]
                if (s.kind == "member") {
                    curThis = cur
                    lastKey = s.key()
                    cur = getMember(cur, lastKey)
                } else {
                    var argv = []
                    for (var j = 0; j < s.args.length; j++) argv.push(s.args[j]())
                    if (typeof cur == "function") {
                        cur = cur.apply(curThis, argv)
                    } else {
                        cur = mcall(curThis, lastKey, argv)
                    }
                    curThis = undefined
                }
            }
            return cur
        }
    }

    // Target items = [nameString, suffix marker...] -> reference descriptor.
    // Walks a target path (members and calls) up to the last element and returns
    // the assignable place {obj, key}. The last element must be a member.
    resolveRef = function(ref) {
        var cur = anytype     // The walked values and receivers
        var curThis = anytype // may be of mixed types.
        cur = getVar(ref.name)
        for (var i = 0; i < ref.path.length - 1; i++) {
            var s = ref.path[i]
            if (s.kind == "member") {
                curThis = cur
                cur = getMember(cur, s.key())
            } else {
                var argv = []
                for (var j = 0; j < s.args.length; j++) argv.push(s.args[j]())
                if (typeof cur != "function") fail("call of a non function value: " + cur)
                cur = cur.apply(curThis, argv)
                curThis = undefined
            }
        }
        var last = ref.path[ref.path.length - 1]
        if (last.kind != "member") fail("assignment target must end in a member")
        if (cur == undefined) fail("member assignment on " + cur)
        return {obj: cur, key: last.key()}
    }
    applyOp = function(op, a, b) {
        if (op == "+=") return a + b
        if (op == "-=") return a - b
        if (op == "*=") return a * b
        if (op == "/=") return a / b
        if (op == "%=") return a % b
    }
    // items = [ref, opString, valueThunk]. Returns the assigned value (assignment is an expression).
    function makeAssign(items) {
        var ref = items[0]
        var op = items[1]
        var valT = items[2]
        return function() {
            var v = anytype // A compound assignment (s += n) may change the value's type.
            v = valT()
            if (ref.path.length == 0) {
                if (op != "=") v = applyOp(op, getVar(ref.name), v)
                setVar(ref.name, v)
            } else {
                var p = resolveRef(ref)
                if (op != "=") v = applyOp(op, getMember(p.obj, p.key), v)
                scopePut(p.obj, p.key, v)
                trackKey(p.obj, p.key) // Keep the object's for-in key list up to date.
            }
            return v
        }
    }
    // items = [ref, "++"|"--"]. Post increment: the expression value is the old (coerced) one.
    function makeIncDec(items) {
        var ref = items[0]
        var delta = (items[1] == "++") ? 1 : -1
        return function() {
            if (ref.path.length == 0) {
                var n = getVar(ref.name) - 0
                setVar(ref.name, n + delta)
                return n
            }
            var p = resolveRef(ref)
            var m = getMember(p.obj, p.key) - 0
            scopePut(p.obj, p.key, m + delta)
            return m
        }
    }
    // Prefix ++/--: like makeIncDec, but the expression value is the new one.
    function makePreIncDec(ref, op) {
        var delta = (op == "++") ? 1 : -1
        return function() {
            if (ref.path.length == 0) {
                var n = getVar(ref.name) - 0 + delta
                setVar(ref.name, n)
                return n
            }
            var p = resolveRef(ref)
            var m = getMember(p.obj, p.key) - 0 + delta
            scopePut(p.obj, p.key, m)
            return m
        }
    }

    // ----- Statement thunks: function() -> undefined | BRK | CONT | {isRet, v} -----

    // An expression in statement position: evaluate and discard the value.
    // items = [name] or [name, initThunk].
    function makeDecl(items) {
        var name = items[0]
        var init = items.length > 1 ? items[1] : makeConst(undefined)
        return function() { declVar(name, init()) }
    }
    // items = [cond, then] or [cond, then, else].
    // Note: the childs lie on the stack in source order, so pop() delivers them reversed.
    function makeDo(condT, bodyT) {
        return function() {
            do {
                var r = bodyT()
                if (r != undefined) {
                    if (r === BRK) break
                    if (r !== CONT) return r
                }
            } while (condT())
        }
    }
    // items = [{k:"init"|"cond"|"post", t:thunk}..., bodyThunk].
    function makeFor(items) {
        var bodyT = items.pop()
        var init = null, cond = null, post = null
        for (var i = 0; i < items.length; i++) {
            if (items[i].k == "init") init = items[i].t
            if (items[i].k == "cond") cond = items[i].t
            if (items[i].k == "post") post = items[i].t
        }
        return function() {
            scopes.push({}) // The for header is its own scope (for the loop variable).
            var res = undefined
            if (init != null) init()
            while (cond == null || cond()) {
                var r = bodyT()
                if (r != undefined) {
                    if (r === BRK) break
                    if (r !== CONT) { res = r; break } // A return signal.
                }
                if (post != null) post()
            }
            scopes.pop()
            return res
        }
    }
    // items = [] or [exprThunk].
    function makeReturn(items) {
        var t = items.length > 0 ? items[0] : makeConst(undefined)
        return function() { return {isRet: true, v: t()} }
    }

    // items = [subjThunk, ({casev}|{isdflt}|stmtThunk)...]. The flat label/statement
    // list is grouped into case descriptors at build time; at run time the first ===
    // match (or default) starts execution, which falls through until a break.
    function makeSwitch(items) {
        var subj = items[0]
        var cases = []
        var cur = null
        for (var i = 1; i < items.length; i++) {
            var p = items[i]
            if (p != undefined && (p.casev != undefined || p.isdflt != undefined)) {
                cur = {isDefault: p.isdflt != undefined, v: p.casev, body: []}
                cases.push(cur)
            } else {
                if (cur == null) fail("switch: a statement before the first case label")
                cur.body.push(p)
            }
        }
        return function() {
            var v = subj()
            var start = -1
            var dflt = -1
            for (var i = 0; i < cases.length; i++) {
                if (cases[i].isDefault) { if (dflt < 0) dflt = i; continue }
                if (start < 0 && cases[i].v() === v) { start = i }
            }
            if (start < 0) { start = dflt }
            if (start < 0) { return undefined }
            for (var i = start; i < cases.length; i++) {
                var body = cases[i].body
                for (var j = 0; j < body.length; j++) {
                    var r = body[j]()
                    if (r === BRK) { return undefined }        // break leaves the switch
                    if (r != undefined) { return r }           // return/continue propagate
                }
            }
            return undefined
        }
    }

    // Local stack = [name, [paramNames...], bodyThunk] -- binds the closure when executed.
    function makeFuncDecl(bodyT, paramNames, name) {
        return function() { declVar(name, makeClosure(paramNames, bodyT, scopes)) }
    }

    // Build the program thunk out of the parsed source.
    // ----- Core library config (see lib/interp-core.js) -----
    core.lang = "js"

    // Build an import statement (see the ImportStmt rule): resolve the referenced file at
    // compile time - which loads and runs it, registering its declarations - and leave a
    // no-op thunk in the program. The path is the last item ModPath pushed.
    function jsImport(items, pos) {
        resolveImport(items[items.length - 1], pos)
        return function() { return undefined }
    }

    // JS has no importable stdlib modules in this subset, so every import path is a
    // project file (resolveImport hands them all to core.importFile below).
    core.stdlibImports = []

    // Project-file imports: load the file, parse it with this grammar, walk it (which
    // leaves its top-level statement thunk on the global stack) and run that thunk now,
    // so the file's function/class/var declarations register in the shared global scope
    // before the main program's top level runs. A file is loaded once; repeats and cycles
    // are no-ops. The path is a literal relative path ('./geomlib.js'): a leading './' is
    // dropped and a missing '.js' extension is appended before the -i-root search.
    var importedFiles = {}
    core.importFile = function(path, pos) {
        var rel = path
        if (rel.length >= 2 && rel.charAt(0) == "." && rel.charAt(1) == "/") { rel = rel.substring(2) }
        if (!(rel.length >= 3 && rel.substring(rel.length - 3) == ".js")) { rel = rel + ".js" }
        var file = c.findImport(rel)
        if (file == "") { return false }
        if (importedFiles["$" + file] == true) { return true }
        importedFiles["$" + file] = true
        var text = c.readFile(file)
        var asg = c.parse(c.agrammar, text, null, file)
        c.pushSource(file, text)
        c.compile(asg)
        c.popSource()
        var mod = popg()
        mod()
        return true
    }

    c.compile(c.asg)
    var progT = popg()

    // Run the top level (it binds the functions), then call main(). The exit code of
    // this metacompiler run is what main() returned, so test programs are self checking.
    progT()
    // The entry point defaults to main() but the -main flag (c.mainName) can name any
    // other top-level function.
    var entry = c.mainName
    if (entry == undefined || entry == "") { entry = "main" }
    // A user exception that escapes the entry point is reported like any runtime error.
    var ret = anytype
    if (mainIsSnippet(entry)) {
        try {
            ret = runMainSnippet(entry, "Statement")
        } catch (e) {
            if (excIsUser(e)) { fail("uncaught exception: " + e.v) }
            throw e
        }
        println("js interpreter: -main snippet returned " + ret)
    } else {
        if (!hasOwn(globalScope, entry) || typeof globalScope[entry] != "function") {
            fail("JavaScript programs need a " + entry + "() function.")
        }
        try {
            ret = globalScope[entry]()
        } catch (e) {
            if (excIsUser(e)) { fail("uncaught exception: " + e.v) }
            throw e
        }
        println("js interpreter: " + entry + "() returned " + ret)
    }
    exit(ret | 0)

