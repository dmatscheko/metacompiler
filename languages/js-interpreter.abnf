        var t = (items.length > at) ? items[at] : makeConst(undefined)
        return function() { return doYield(star, t()) }
    }
    // The value a generator FUNCTION is: calling it runs nothing, it only captures the
    // arguments and hands back a fresh generator object.
    function makeGenerator(params, bodyT) {
        return function() {
            var env = scopes.slice()
            return function() {
                var self = pendingThis
                pendingThis = undefined
                pendingNewTarget = undefined
                var args = []
                for (var i = 0; i < arguments.length; i++) args.push(arguments[i])
                return newGenObject(params, bodyT, env, self, args)
            }
        }
    }
    function newGenObject(params, bodyT, env, self, args) {
        var st = {sent: [], count: 0, done: false}
        var g = {}
        g["__gen"] = true
        g["__keys"] = []
        g["next"] = function() {
            var sendv = anytype // next(v) may send any value in.
            sendv = (arguments.length > 0) ? arguments[0] : undefined
            return genNext(st, params, bodyT, env, self, args, sendv)
        }
        return g
    }
    // One step: replay the body up to yield number st.count, and report what happened.
    function genNext(st, params, bodyT, env, self, args, sendv) {
        if (st.done) { return {value: undefined, done: true, __keys: ["value", "done"]} }
        st.sent.push(sendv)
        var run = {target: st.count, k: 0, sent: st.sent, out: undefined}
        genRuns.push(run)
        var saved = scopes
        var ret = anytype   // The generator's return value,
        var out = anytype   // or the value it yielded.
        ret = undefined
        out = undefined
        var yielded = false
        try {
            scopes = env.slice()
            var sc = {}
            sc["this"] = self
            sc["arguments"] = args
            scopes.push(sc)
            bindParams(sc, params, args)
            var r = bodyT()
            ret = (r != undefined && r.isRet) ? r.v : undefined
        } catch (e) {
            if (e != undefined && e.__genYield == true) { yielded = true; out = e.v }
            else { scopes = saved; genRuns.pop(); throw e }
        }
        scopes = saved
        genRuns.pop()
        if (yielded) {
            st.count = st.count + 1
            return {value: out, done: false, __keys: ["value", "done"]}
        }
        st.done = true
        return {value: ret, done: true, __keys: ["value", "done"]}
    }
    // items = [{isgen}?, name, params, bodyThunk] for a declaration, and the same
    // without the name for an expression. The '*' picks a generator over a function.
    function makeGenOrFuncDecl(items) {
        var isGen = false
        var at = 0
        if (items[0] != undefined && items[0].isgen != undefined) { isGen = true; at = 1 }
        var name = items[at]
        var params = items[at + 1]
        var body = items[at + 2]
        var mk = isGen ? makeGenerator(params, body) : makeFunctionExpr(body, params)
        return function() { declVar(name, mk()) }
    }
    // The expression form. The optional name is accepted and, like a plain function
    // expression's, not bound - so what is left after the marker is params and body.
    function makeGenOrFuncExpr(items) {
        var isGen = false
        var at = 0
        if (items[0] != undefined && items[0].isgen != undefined) { isGen = true; at = 1 }
        var params = items[items.length - 2]
        var body = items[items.length - 1]
        return isGen ? makeGenerator(params, body) : makeFunctionExpr(body, params)
    }

    // A destructuring binding. makeDField turns a parsed object field into
    // {key, pat}: a shorthand {x} binds property x to a name x, {x: t} binds
    // property x to the sub-pattern t. bindPattern walks a pattern node
    // ({dtype:"id"|"arr"|"obj"}) against a value, declaring each leaf name to its
    // array element (by index) or object property (by key). The compiler lowers
    // the identical pattern tree the same way.
    // The loop variable of a for-of / for-in: a plain name declares, a destructuring
    // pattern binds all of its leaves ('for (var [k, v] of pairs)').
    function bindLoopTarget(target, value) {
        if (typeof target == "string") { declVar(target, value) } else { bindPattern(target, value) }
    }

    // A pattern node is one of:
    //   {dtype:"id", name, dflt?}                 a leaf that binds a name
    //   {dtype:"hole"}                            a position that binds nothing
    //   {dtype:"arr", elems:[node], rest?, dflt?} an array pattern
    //   {dtype:"obj", fields:[field], rest?, dflt?} an object pattern
    // and a field is {key | keyT, pat}: a literal name, or a key thunk for a computed
    // key, plus the sub-pattern the property binds to.
    function makeArrPattern(items) {
        var elems = []
        var rest = null
        for (var i = 0; i < items.length; i++) {
            if (items[i].drest != undefined) { rest = items[i].drest } else { elems.push(items[i]) }
        }
        return {dtype: "arr", elems: elems, rest: rest}
    }
    function makeObjPattern(items) {
        var fields = []
        var rest = null
        for (var i = 0; i < items.length; i++) {
            if (items[i].dobjrest != undefined) { rest = items[i].dobjrest } else { fields.push(items[i]) }
        }
        return {dtype: "obj", fields: fields, rest: rest}
    }
    // items = [{dkey}|{dkeyT}, elemNode].
    function makeDField(items) {
        return {key: items[0].dkey, keyT: items[0].dkeyT, pat: items[1]}
    }
    // '{p}' and '{p = 1}': the key and the bound name are the same word.
    function makeShorthandField(items) {
        var name = items[0].dkey
        var pat = {dtype: "id", name: name}
        if (items.length > 1) { scopePut(pat, "dflt", items[1]) }
        return {key: name, keyT: null, pat: pat}
    }
    // items = [node] or [node, defaultThunk]. The default rides ON the node, so every
    // pattern position - leaf, nested array, nested object - can carry one.
    function withDefault(items) {
        if (items.length == 1) { return items[0] }
        scopePut(items[0], "dflt", items[1])
        return items[0]
    }
    // Binds a pattern against a value, DECLARING every leaf (the 'var [a] = xs' form).
    function bindPattern(pat, value) { bindPatternMode(pat, value, true) }
    // The same walk, but 'decl' picks what a leaf does: declare a new binding, or assign
    // to the existing one ('[a, b] = [b, a]'). A default fires only for an argument or a
    // property that is undefined - a null is a value and keeps the default out.
    function bindPatternMode(pat, value, decl) {
        if (pat.dtype == "hole") { return }
        var v = anytype // Every pattern position may hold any type.
        v = value
        if (v === undefined && pat.dflt != undefined) { v = pat.dflt() }
        if (pat.dtype == "id") {
            if (decl) { declVar(pat.name, v) } else { setVar(pat.name, v) }
            return
        }
        // A target leaf. With an empty path it is a plain name and behaves exactly like
        // the "id" leaf; with a path it is a place ('[a.b] = c'), which only an
        // assignment can have, and the value is written through it.
        if (pat.dtype == "ref") {
            var r = pat.ref
            if (r.path.length == 0) {
                if (decl) { declVar(r.name, v) } else { setVar(r.name, v) }
            } else {
                refSet(r, v)
            }
            return
        }
        if (v == undefined || v == null) fail("cannot destructure " + v)
        if (pat.dtype == "arr") {
            for (var i = 0; i < pat.elems.length; i++) { bindPatternMode(pat.elems[i], v[i], decl) }
            if (pat.rest != null) {
                var r = []
                for (var j = pat.elems.length; j < v.length; j++) { r.push(v[j]) }
                bindPatternMode(pat.rest, r, decl)
            }
            return
        }
        // An object pattern. The keys it named are remembered, because a '...rest' takes
        // every OTHER own key of the source.
        var used = []
        for (var f = 0; f < pat.fields.length; f++) {
            var fl = pat.fields[f]
            var key = (fl.keyT != undefined && fl.keyT != null) ? "" + fl.keyT() : fl.key
            used.push(key)
            bindPatternMode(fl.pat, getMember(v, key), decl)
        }
        if (pat.rest != null) {
            var o = {}
            var ks = []
            var all = ownKeys(v)
            for (var g = 0; g < all.length; g++) {
                if (used.indexOf(all[g]) >= 0) { continue }
                scopePut(o, all[g], getMember(v, all[g]))
                ks.push(all[g])
            }
            o["__keys"] = ks
            bindPatternMode(pat.rest, o, decl)
        }
    }
    // items = [patternNode, initThunk]. Evaluate the initializer once, then bind.
    function makeDestructure(items, pos) {
        var pat = items[0]
        var init = items[1]
        return function() {
            var v = anytype // The initializer may be an array or an object.
            v = init()
            bindPattern(pat, v)
        }
    }
    // The assignment form: the same walk with declaration turned off. Like every
    // assignment it is an expression, and its value is the right-hand side.
    function makePatternAssign(items) {
        var pat = items[0]
        var valT = items[1]
        return function() {
            var v = anytype // The right-hand side may be an array or an object.
            v = valT()
            bindPatternMode(pat, v, false)
            return v
        }
    }
    // A parameter descriptor for a destructuring parameter: items = [node] or
    // [node, defaultThunk], and the default rides on the node like everywhere else.
    function makePatternParam(items) { return {pat: withDefault(items)} }
    // items = [name, defaultThunk].
    function makeDefaultParam(items) { return {pname: items[0], dflt: items[1]} }

    // try/catch/finally and throw are handled by excTry/excThrow (lib/interp-core.js).

    // ----- Classes (the __class machinery, mirrors js-to-llvm-ir.abnf) -----
    // An instance is a plain object carrying a __class descriptor; the descriptor holds
    // the methods (closures over the class-defining scope) and the __ctor. A method call
    // dispatches through mcall (below), which prepends the instance as the receiver and
    // follows __super for inheritance; super.m() invokes the parent's method on 'this'.

    // An instance method: a closure binding this = arguments[0], params from arguments[1..].
    function makeInstanceClosure(params, bodyT, defScopes) {
        var env = defScopes.slice()
        return function() {
            var self = arguments[0]
            var args = []
            for (var i = 1; i < arguments.length; i++) args.push(arguments[i])
            var saved = scopes
            scopes = env.slice()
            var sc = {}
            sc["this"] = self
            sc["arguments"] = args
            scopes.push(sc)
            bindParams(sc, params, args)
            var r = bodyT()
            scopes = saved
            return (r != undefined && r.isRet) ? r.v : undefined
        }
    }

    // A constructor closure: binds this = arguments[0], runs (for a default subclass ctor)
    // the implicit no-argument super, then the field initializers, then the body.
    function makeCtorClosure(params, bodyT, fields, defScopes, superName, isDefault) {
        var env = defScopes.slice()
        return function() {
            var self = arguments[0]
            var args = []
            for (var i = 1; i < arguments.length; i++) args.push(arguments[i])
            var saved = scopes
            scopes = env.slice()
            var sc = {}
            sc["this"] = self
            sc["arguments"] = args
            scopes.push(sc)
            bindParams(sc, params, args)
            if (isDefault && superName != null) {
                var supCls = getVar(superName)
                supCls.__ctor.apply(undefined, [self])
            }
            for (var k = 0; k < fields.length; k++) {
                var fk = memberKey(fields[k])
                var fv = (fields[k].init != null) ? fields[k].init() : undefined
                scopePut(self, fk, fv)
                trackKey(self, fk)
