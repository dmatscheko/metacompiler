    // A class as a VALUE: builds the descriptor object, attaches the methods and
    // accessors, then runs the static initializers (fields and static blocks) in source
    // order. Shared by the declaration (which binds the result) and the class expression
    // (which just yields it).
    function makeClassValue(items) {
        var name = ""
        var superName = null
        var members = []
        for (var i = 0; i < items.length; i++) {
            if (items[i] == undefined) { continue }
            if (items[i].cname != undefined) { name = items[i].cname }
            else if (items[i].ext != undefined) { superName = items[i].ext }
            else if (items[i].skip != undefined) { continue }
            else { members.push(items[i]) }
        }
        var fields = []      // Instance fields: the constructor initializes them.
        var methods = []
        var accessors = []
        var inits = []       // Static fields AND static blocks, kept in source order.
        var ctorInfo = null
        for (var j = 0; j < members.length; j++) {
            var mm = members[j]
            if (mm.kind == "field") { if (mm.statik) { inits.push(mm) } else { fields.push(mm) } }
            else if (mm.kind == "method") { methods.push(mm) }
            else if (mm.kind == "accessor") { accessors.push(mm) }
            else if (mm.kind == "staticblock") { inits.push(mm) }
            else if (mm.kind == "ctor") { ctorInfo = mm }
        }
        return function() {
            var defScopes = scopes.slice()
            var cls = {}
            cls["__isclass"] = true
            cls["__name"] = name
            if (superName != null) {
                var sup = getVar(superName)
                if (sup == undefined || !sup.__isclass) fail("unknown superclass: " + superName)
                cls["__super"] = sup
            }
            // Every member closes over one extra scope that names the class itself. That
            // is what super() and super.m() resolve through - not the class's NAME, which
            // an anonymous class expression does not have.
            var clsScope = {}
            clsScope["__class__"] = cls
            var mscopes = concat2impl(defScopes, [clsScope])
            for (var mi = 0; mi < methods.length; mi++) {
                var mm2 = methods[mi]
                scopePut(cls, memberKey(mm2), classMemberFn(mm2, mscopes))
            }
            // An accessor is called with the receiver in the one-shot slot, never as
            // arguments[0], so a static and an instance accessor are built the same way.
            for (var ai = 0; ai < accessors.length; ai++) {
                var aa = accessors[ai]
                addAccessor(cls, aa.acc, memberKey(aa), makeClosure(aa.params, aa.body, mscopes))
            }
            if (ctorInfo != null) {
                cls["__ctor"] = makeCtorClosure(ctorInfo.params, ctorInfo.body, fields, mscopes, superName, false)
            } else {
                cls["__ctor"] = makeCtorClosure([], null, fields, mscopes, superName, true)
            }
            // The static initializers run now, with the methods already in place (a static
            // block may call them) and 'this' bound to the class.
            for (var si = 0; si < inits.length; si++) {
                var it = inits[si]
                if (it.kind == "staticblock") {
                    callWithThis(makeClosure([], it.body, mscopes), cls, [])
                } else {
                    scopePut(cls, memberKey(it), (it.init != null) ? callWithThis(makeClosure([], makeReturn([it.init]), mscopes), cls, []) : undefined)
                }
            }
            return cls
        }
    }
    // The function value of one method: an instance method takes the receiver as
    // arguments[0] (that is mcall's contract), a static one is an ordinary closure, and a
    // generator method hands back a generator object instead of running the body.
    function classMemberFn(m, mscopes) {
        if (m.statik) { return m.isGen ? makeGenerator(m.params, m.body)() : makeClosure(m.params, m.body, mscopes) }
        if (m.isGen) { return makeInstanceGenerator(m.params, m.body, mscopes) }
        return makeInstanceClosure(m.params, m.body, mscopes)
    }
    // A generator as an instance method: the receiver arrives as arguments[0], like for
    // every other instance method, and becomes the generator body's 'this'.
    function makeInstanceGenerator(params, bodyT, defScopes) {
        var env = defScopes.slice()
        return function() {
            var self = arguments[0]
            var args = []
            for (var i = 1; i < arguments.length; i++) args.push(arguments[i])
            return newGenObject(params, bodyT, env, self, args)
        }
    }

    // A class declaration: build the descriptor and bind it under the class's name.
    function makeClassStmt(items) {
        var name = ""
        for (var i = 0; i < items.length; i++) {
            if (items[i] != undefined && items[i].cname != undefined) { name = items[i].cname }
        }
        var build = makeClassValue(items)
        return function() { declVar(name, build()) }
    }

    // new C(args): build the instance, attach __class, run the constructor as
    // __ctor(instance, args...).
    function makeNew(items) {
        var clsName = items[0].cls
        var argThunks = items.slice(1)
        return function() {
            var cls = getVar(clsName)
            var argv = evalArgs(argThunks)
            // A CONSTRUCTOR FUNCTION - the pre-class way of writing a class, and still
            // the shape 'new.target' exists for. The fresh object goes in through the
            // receiver slot, and an object the function returns explicitly wins over it,
            // exactly like [[Construct]] does.
            if (typeof cls == "function") {
                var self = {}
                self["__keys"] = []
                self["__class"] = ctorDescriptor(clsName, cls)
                pendingNewTarget = cls
                var r = anytype // The function may return a replacement object.
                r = callWithThis(cls, self, argv)
                if (r != undefined && r != null && typeof r == "object") { return r }
                return self
            }
            if (cls == undefined || !cls.__isclass) fail("unknown class: " + clsName)
            var obj = {}
            obj["__class"] = cls
            obj["__keys"] = []
            var cargv = [obj]
            for (var j = 0; j < argv.length; j++) cargv.push(argv[j])
            cls.__ctor.apply(undefined, cargv)
