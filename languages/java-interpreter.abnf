// case-label/lambda trap in docs/abnf-dialect-gotchas.md.
LamId       <~~ push({lparam: up.in}) ~~> = NotJavaKw Id ;
NotJavaKw   = :script(~~
    (function() {
        var s = 0 // Whitespace is not skipped before a :script, so scan past it first.
        while (c.peek(s) === 32 || c.peek(s) === 9 || c.peek(s) === 10 || c.peek(s) === 13) { s++ }
        var kws = ["null", "true", "false", "this", "super", "new", "instanceof",
                   "return", "throw", "break", "continue", "case", "default",
                   "switch", "if", "else", "while", "do", "for", "class", "void",
                   "int", "long", "short", "byte", "char", "float", "double", "boolean"]
