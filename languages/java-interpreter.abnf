    }
    function jNewInner(cname, outer, argv) {
        var cls = jResolveClass(cname)
        if (cls == undefined || cls == null || !cls.__isclass) fail("unknown class: " + cname)
        var obj = {__class: cls, __outer: outer}
        jCallCtor(cls, obj, argv)
        return obj
    }
    // The shared foldCallMember knows the three ordinary suffixes; Java adds the
    // qualified-creation one, so it installs its own fold over the same shape.
    foldCallMember = function(items) {
        if (items.length == 1) { return items[0] }
        var primary = items[0]
        var suffixes = items.slice(1)
        return function() {
            var cur = anytype // A member chain hops between types: obj.name.length is object, string, number.
            cur = primary()
            for (var i = 0; i < suffixes.length; i++) {
                var s = suffixes[i]
                if (s.kind == "mcall") {
                    var argv = []
                    for (var j = 0; j < s.args.length; j++) { argv.push(s.args[j]()) }
                    cur = mcall(cur, s.name, argv)
                } else if (s.kind == "field") {
                    if (cur === undefined || cur === null) fail("field ." + s.name + " of " + core.nullWord)
                    cur = core.getField(cur, s.name)
                } else if (s.kind == "qnew") {
                    var av = []
                    for (var k = 0; k < s.args.length; k++) { av.push(s.args[k]()) }
                    cur = jNewInner(s.cname, cur, av)
                } else {
                    cur = core.getIndex(cur, s.idx())
                }
            }
            return cur
        }
    }
    function buildRecord(items) {
        jExitClass(items[0], buildClassFrom(items[0], items.slice(2), items[1].rparams))
    }

    // Appends b to a copy of a (kept as a plain function to stay inside MetaJS).
    // ----- Core library config (see lib/interp-core.js) -----
    core.lang = "java"
    core.add = jadd
    core.getField = function(o, name) {
        if (name == "length" && Array.isArray(o)) { return o.length }
        if (hasOwn(o, name)) { return o[name] }
        return undefined
    }

    // Import roots the runtime already provides (their symbols are builtins:
    // System, Math, String methods, ...), so importing them is a no-op. Anything
    // else is an external library we cannot resolve. resolveImport / stripWs live
    // in lib/interp-core.js.
    core.stdlibImports = ["java", "java.util", "java.io", "java.lang", "java.math", "java.time", "java.util.function", "javax"]

    // Project-file imports: 'import a.b.C;' looks for a/b/C.java, then a/b.java
    // under the program's directory and the -i roots (c.findImport). The file is
    // parsed with this grammar and walked with the same tags, so its classes
    // register exactly like the main file's; only the main file's Main.main
    // runs (the start script calls it once). A file is imported once; repeats
    // and cycles are no-ops.
    var importedFiles = {}
    core.importFile = function(path, pos) {
        if (path.length > 2 && path.substring(path.length - 2) == ".*") { return false }
        var rel = path.split(".").join("/")
        var cands = [rel + ".java"]
        var cut = -1
        for (var k = 0; k < rel.length; k++) { if (rel.charAt(k) == "/") { cut = k } }
        if (cut > 0) { cands.push(rel.substring(0, cut) + ".java") }
        for (var i = 0; i < cands.length; i++) {
            var file = c.findImport(cands[i])
            if (file == "") { continue }
            if (importedFiles["$" + file] == true) { return true }
            importedFiles["$" + file] = true
            var text = c.readFile(file)
            var asg = c.parse(c.agrammar, text, null, file)
            c.pushSource(file, text)
            c.compile(asg)
            c.popSource()
            return true
        }
