        for (var c = cls; c != undefined && c != null; c = c.__super) {
            if (c.__name == nm) { return true }
        }
        return false
    }
    // Outer.this - the enclosing instance an inner class captured (o.new Inner()
    // records it as __outer). Walks out until a class of that name is reached.
    function makeOuterThis(text) {
        var nm = stripWs(text).split(".")[0]
        return function() {
            var v = getVar("this")
            while (v != undefined && v != null) {
                if (v.__class != undefined && jClassIs(v.__class, nm)) { return v }
                v = v.__outer
            }
