// method body) is the ordinary declaration again: its tag builds it exactly
// like a top-level one, in the order the file is walked, so it is registered
// before anything can name it. It contributes NO member to the enclosing type
// (the build tags push nothing), and it is additionally registered under its
// qualified name, so `new Outer.Nested()` resolves.
NestedType  = ClassDecl | RecordDecl | Interface | EnumDecl | AnnotationDecl ;

KwClass     = "class" KwEnd ;
KwRecord    = "record" KwEnd ;
KwImplements = "implements" KwEnd ;
KwInterface = "interface" KwEnd ;
KwEnum      = "enum" KwEnd ;
KwThrows    = "throws" KwEnd ;
KwTry       = "try" KwEnd ;
KwCatch     = "catch" KwEnd ;
KwFinally   = "finally" KwEnd ;
KwThrow     = "throw" KwEnd ;
KwPackage   = "package" KwEnd ;
KwImport    = "import" KwEnd ;
KwIf        = "if" KwEnd ;
KwElse      = "else" KwEnd ;
KwWhile     = "while" KwEnd ;
KwDo        = "do" KwEnd ;
KwFor       = "for" KwEnd ;
KwReturn    = "return" KwEnd ;
KwBreak     = "break" KwEnd ;
KwContinue  = "continue" KwEnd ;
KwNew       = "new" KwEnd ;
KwExtends   = "extends" KwEnd ;
KwSuper     = "super" KwEnd ;
KwSwitch    = "switch" KwEnd ;
KwCase      = "case" KwEnd ;
KwDefault   = "default" KwEnd ;
KwInstanceof = "instanceof" KwEnd ;
KwAssert    = "assert" KwEnd ;
KwSync      = "synchronized" KwEnd ;

// ----- Post-shape parser checks (what javac's parser refuses AFTER the shape
// matched). Every rule below REFUSES something; each is anchored as narrowly as
// the diagnostic it mirrors, because a refusal that is one step too wide costs
// must-parse files. Each is a pure function of (source, position), like
// NotSwitchKw / NotIfaceKw above.

// A RESERVED word is never an identifier (JLS 3.9). Id in this grammar matches
// keywords, so `int assert;`, `Object this;`, `return null;` as a class member
// and `case 0 -> if (true);` (an `if` read as a method call) all parsed. The
// list is the 50 reserved words plus the three literals; the CONTEXTUAL ones
// (var, record, sealed, permits, yield, module, ...) are deliberately absent.
// Screened on first byte AND length before any comparison - this guard sits on
// Type and on every declarator, so it runs constantly.
NotResvKw   = :script(~~
    (function() {
        var s = 0 // Whitespace is not skipped before a :script, so scan past it first.
        while (c.peek(s) === 32 || c.peek(s) === 9 || c.peek(s) === 10 || c.peek(s) === 13) { s++ }
        var f0 = c.peek(s)
        if (f0 < 97 || f0 > 122) { return undefined } // every reserved word is lower-case
        var n = 0
        var more = true
        while (more) {
            var cc = c.peek(s + n)
            if ((cc >= 48 && cc <= 57) || (cc >= 65 && cc <= 90) || cc === 95 || cc === 36 || (cc >= 97 && cc <= 122)) { n++ } else { more = false }
            if (n > 12) { more = false }
        }
        var kws = ["abstract", "assert", "boolean", "break", "byte", "case", "catch",
                   "char", "class", "const", "continue", "default", "do", "double",
                   "else", "enum", "extends", "final", "finally", "float", "for",
                   "goto", "if", "implements", "import", "instanceof", "int",
                   "interface", "long", "native", "new", "package", "private",
                   "protected", "public", "return", "short", "static", "strictfp",
                   "super", "switch", "synchronized", "this", "throw", "throws",
                   "transient", "try", "void", "volatile", "while",
                   "true", "false", "null"]
        var hit = false
        for (var k = 0; k < kws.length; k++) {
            var w = kws[k]
            if (w.length === n && w.charCodeAt(0) === f0) {
                var ok = true
                for (var i = 1; i < n; i++) { if (c.peek(s + i) !== w.charCodeAt(i)) { ok = false } }
                if (ok) { hit = true }
            }
        }
        return hit ? abnf.newToken("\x01java-reserved", 0) : undefined
    })()
~~) ;

// MEASURED AND REVERTED: refusing `var` as a class / record / interface / enum
