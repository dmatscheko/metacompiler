        }
        try {
            ret = mainCls[entry]([])
        } catch (e) {
            if (excIsUser(e)) { fail("uncaught exception: " + e.v) }
            throw e
        }
        println("java interpreter: " + entry + "() returned " + (ret === undefined ? 0 : ret))
    }
    exit(ret === undefined ? 0 : ret | 0)

