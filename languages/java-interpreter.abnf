// an f/F/d/D/L suffix allowed). Distinct from an integer and from x.y access.
FloatLit    <~~ push(makeConst(numLit(up.in, 10))) ~~>
            = FloatBody [ NumSfx ] :whitespace(Whitespace) ;
FloatBody   = "." :whitespace() Dig { Dig | "_" } [ ExpPart ]
