        callExt(b, "js_set", [o, emitStr(b, "__ecase"), hTrue])
        callExt(b, "js_set", [o, emitStr(b, "__ename"), emitStr(b, cname)])
        callExt(b, "js_set", [o, emitStr(b, "__etype"), ename == null ? hUndef : emitStr(b, ename)])
        callExt(b, "js_set", [o, emitStr(b, "__raw"), rawV])
        callExt(b, "js_set", [o, emitStr(b, "__vals"), valsV])
