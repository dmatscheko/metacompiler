        var iV = callExt(headB, "js_scope_get", [sc, emitStr(headB, "i")])
        headB.NewCondBr(truthy(headB, callExt(headB, "js_lt", [iV, callExt(headB, "js_pylen", [many])])), bodyB, joinB)
