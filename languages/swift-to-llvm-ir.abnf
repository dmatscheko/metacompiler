        var sv = boundB.NewCall(rtSelfType(), [boundB.NewCall(rtKGet(), [curScopeV, emitStr(boundB, "self")]), stV])
        boundB.NewBr(joinB)
        return {b: joinB, v: joinB.NewPhi([llvm.ir.NewIncoming(stV, fromB), llvm.ir.NewIncoming(sv, boundB)])}
