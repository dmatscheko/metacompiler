    }
    // A raw literal keeps its characters verbatim except the escapes written with
    // its own pound count. Its content is `""` + newline ... newline + `""` exactly
    // when it is the multi-line form (#""" ... """#), which is then laid out like
    // MultiStr with the two quote pairs removed.
    function makeRawStr(items, lvl) {
        var n = items.length
        if (n > 0 && items[0].s != undefined && items[n - 1].s != undefined
            && swRawMlOpen(items[0].s) && swRawMlClose(items[n - 1].s)) {
            var parts = []
            for (var i = 0; i < n; i++) { parts.push(items[i]) }
            var last = parts[n - 1].s
            parts[n - 1] = {s: last.substring(0, last.length - 2)}
            parts[0] = {s: parts[0].s.substring(2)}
            return makeTemplate(swMlLayout(parts, lvl))
