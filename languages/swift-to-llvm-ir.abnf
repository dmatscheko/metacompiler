                    var h = str.charCodeAt(j)
                    var d = 0
                    if (h >= 48 && h <= 57) { d = h - 48 }
                    else if (h >= 97 && h <= 102) { d = h - 87 }
                    else if (h >= 65 && h <= 70) { d = h - 55 }
                    cp = cp * 16 + d
                    j++
