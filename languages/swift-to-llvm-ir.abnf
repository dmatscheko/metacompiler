    function rtSubSet() {
        return rtFunc("sw_subset", 3, function(b, ps) {
            var g = b.NewCall(rtSubLookup(), [ps[0], callExt(b, "js_jadd", [emitStr(b, "__sub_set"), b.NewCall(rtIdxArity(), [ps[1]])])])
            var callB = curF.NewBlock("")
            var plainB = curF.NewBlock("")
            b.NewCondBr(truthy(b, g), callB, plainB)
            var args = callExt(callB, "js_arr_new", [])
            callExt(callB, "js_arr_push", [args, ps[0]])
            callB = emitSpreadIdx(callB, args, ps[1])
            callExt(callB, "js_arr_push", [args, ps[2]])
            callB.NewRet(callExt(callB, "js_call", [g, hUndef, args]))
            callExt(plainB, "js_swdset", [ps[0], ps[1], ps[2]])
            plainB.NewRet(hUndef)
        })
    }
    // How many parameters this index carries (a multi-parameter subscript index
    // travels as one {__idxs} value).
    function rtIdxArity() {
        return rtFunc("sw_idxarity", 1, function(b, ps) {
            var many = b.NewCall(rtProbe("sw_idxs", "__idxs"), [ps[0]])
            var manyB = curF.NewBlock("")
            var oneB = curF.NewBlock("")
            b.NewCondBr(truthy(b, many), manyB, oneB)
            manyB.NewRet(callExt(manyB, "js_pylen", [many]))
            oneB.NewRet(emitNum(oneB, 1))
        })
    }
    // Finds a subscript accessor on the value's type, declared or inherited (an
    // instance walks from its __class, a type value from its own __static_ entry),
    // or undefined. Twin of subAccessor in swift-interpreter.abnf.
    function rtSubLookup() {
        return rtFunc("sw_sublookup", 2, function(b, ps) {
            var cls = b.NewCall(rtClassOf(), [ps[0]])
            var instB = curF.NewBlock("")
            var statB = curF.NewBlock("")
            b.NewCondBr(truthy(b, cls), instB, statB)
            instB.NewRet(instB.NewCall(rtFindM(), [ps[0], ps[1]]))
            var descB = curF.NewBlock("")
            var noB = curF.NewBlock("")
            statB.NewCondBr(truthy(statB, statB.NewCall(rtIsTypeVal(), [ps[0]])), descB, noB)
            descB.NewRet(descB.NewCall(rtFindStat(), [ps[0], callExt(descB, "js_jadd", [emitStr(descB, "__static_"), ps[1]])]))
            noB.NewRet(hUndef)
        })
    }
    // A multi-parameter subscript index travels as one {__idxs: [...]} value; this
    // appends either its elements or the single index to the argument array.
    function emitSpreadIdx(b, args, idxV) {
        var many = b.NewCall(rtProbe("sw_idxs", "__idxs"), [idxV])
        var manyB = curF.NewBlock("")
        var oneB = curF.NewBlock("")
        var joinB = curF.NewBlock("")
        b.NewCondBr(truthy(b, many), manyB, oneB)
        var sc = callExt(manyB, "js_scope_new", [handle(0)])
        callExt(manyB, "js_scope_decl", [sc, emitStr(manyB, "i"), emitNum(manyB, 0)])
        var headB = curF.NewBlock("")
        var bodyB = curF.NewBlock("")
        manyB.NewBr(headB)
        var iV = callExt(headB, "js_scope_get", [sc, emitStr(headB, "i")])
        headB.NewCondBr(truthy(headB, callExt(headB, "js_lt", [iV, callExt(headB, "js_pylen", [many])])), bodyB, joinB)
        var iV2 = callExt(bodyB, "js_scope_get", [sc, emitStr(bodyB, "i")])
        callExt(bodyB, "js_arr_push", [args, callExt(bodyB, "js_swidx", [many, iV2])])
        callExt(bodyB, "js_scope_set", [sc, emitStr(bodyB, "i"), callExt(bodyB, "js_jadd", [iV2, emitNum(bodyB, 1)])])
        bodyB.NewBr(headB)
        callExt(oneB, "js_arr_push", [args, idxV])
        oneB.NewBr(joinB)
        return joinB
    }

    // ----- Patterns and binding conditions -----
    // A pattern is {opt: n, core: k}: n trailing `?` (an optional pattern, which
    // fails on nil and matches the unwrapped value) around one core form.
    // The pattern of one catch clause, plus the type of its optional `as` suffix.
    function makeCatchPat(items) {
        var p = items[0]
        for (var i = 1; i < items.length; i++) {
            if (items[i] != undefined && items[i].casty != undefined) { p.asty = items[i].casty }
        }
        return p
    }
    function makePattern(items) {
        var n = 0
        for (var i = 1; i < items.length; i++) { n++ }
        return {opt: n, core: items[0]}
    }
    // [ "." ] path [ ( subpatterns ) ] - an enum case reference, or (under a `let`)
    // a plain name to bind.
    function makePatEnum(items) {
        var dot = false
        var path = ""
        var args = null
        for (var i = 0; i < items.length; i++) {
            if (items[i].pdot != undefined) { dot = true }
            else if (items[i].ppath != undefined) { path = items[i].ppath }
            else if (items[i].pargs != undefined) { args = items[i].pargs }
        }
        return {pdot: dot, ppath: path, pargs: args, pval: swPatPathVal(dot, path, args)}
    }
    // A qualified path with no arguments (`case Int.min:`) is an enum case or an
    // EXPRESSION pattern; for a subject that is no enum case it is the value the
    // path reads, compared with ==. null for every other pattern. Twin of
    // swPatPathVal in swift-interpreter.abnf.
    function swPatPathVal(dot, path, args) {
        if (dot || args != null || path.indexOf(".") < 0) { return null }
        var ps = path.split(".")
        var chain = [makeVarRef(ps[0])]
        for (var i = 1; i < ps.length; i++) { chain.push(makeFieldSfx(ps[i])) }
        return foldCallMember(chain, path)
    }
    // A nil / undefined test that branches to failB; returns the block to carry on in.
    function emitNotNil(b, v, failB) {
        var okB = curF.NewBlock("")
        var midB = curF.NewBlock("")
        b.NewCondBr(truthy(b, callExt(b, "js_seq", [v, hNull])), failB, midB)
        midB.NewCondBr(truthy(midB, callExt(midB, "js_seq", [v, hUndef])), failB, okB)
        return okB
    }
    // Emits the test chain of one pattern. On a match control reaches the returned
    // block with every `let`/`var` name of the pattern declared in curScopeV; on a
    // mismatch it branches to failB. binding says a bare identifier names a new
    // variable rather than an enum case.
    function emitMatchPat(b, p, v, binding, failB) {
        if (p.opt > 0) { b = emitNotNil(b, v, failB) }
        // `catch let e as T`: the type test comes first, and only then the binding.
        // Error and Any match every thrown value by Swift's own typing rule; a user
        // PROTOCOL filters through the conformance emitConfMark records.
        // The twin is swCatchTyMatch in swift-interpreter.abnf.
        if (p.asty != undefined && !catchTyAlways(p.asty)) {
            var ra = emitIsType(b, v, p.asty)
            var okA = curF.NewBlock("")
            ra.b.NewCondBr(truthy(ra.b, ra.v), okA, failB)
            b = okA
        }
        return emitMatchCore(b, p.core, v, binding, failB)
    }
    function catchTyAlways(t0) {
        var t = baseTypeName(t0)
        return t == "Error" || t == "Any"
    }
    function emitMatchCore(b, k, v, binding, failB) {
        // `case is Double:` - the same js_swis the `is` operator emits.
        if (k.pis != undefined) {
            var ri = emitIsType(b, v, k.pis)
            var okI = curF.NewBlock("")
            ri.b.NewCondBr(truthy(ri.b, ri.v), okI, failB)
            return okI
        }
        if (k.pwild != undefined) { return b }
        if (k.pexpr != undefined) {
            var re = k.pexpr(b)
            var okE = curF.NewBlock("")
            re.b.NewCondBr(truthy(re.b, emitBin(re.b, "==", v, re.v)), okE, failB)
            return okE
        }
        if (k.prange != undefined) {
            var rg = k.prange
            if (rg.lo != null) {
                // The bounds compare through the operators, so a sized-integer box,
                // a Double and a user Comparable all order as `<` does.
                var rl = rg.lo(b)
                var okL = curF.NewBlock("")
                rl.b.NewCondBr(truthy(rl.b, emitBin(rl.b, ">=", v, rl.v)), okL, failB)
                b = okL
            }
            if (rg.hi != null) {
                var rh = rg.hi(b)
                var okH = curF.NewBlock("")
                rh.b.NewCondBr(truthy(rh.b, emitBin(rh.b, rg.rop == "..<" ? "<" : "<=", v, rh.v)), okH, failB)
                b = okH
            }
            return b
        }
        if (k.plet != undefined) { return emitMatchPat(b, k.plet, v, true, failB) }
        if (k.ptup != undefined) {
            var subs = k.ptup
            for (var i = 0; i < subs.length; i++) {
                b = emitMatchPat(b, subs[i], callExt(b, "js_get", [v, emitStr(b, "" + i)]), binding, failB)
            }
            return b
        }
        var simple = !k.pdot && k.pargs == null && k.ppath.indexOf(".") < 0
        if (binding && simple) {
            if (k.ppath != "_") { callExt(b, "js_scope_decl", [curScopeV, emitStr(b, k.ppath), emitCopy(b, v)]) }
            return b
        }
        // Optional's own cases: `.none` is nil, `.some(p)` matches p against the
        // wrapped value itself (an Optional is not boxed here).
        var opt = swPatOptional(k)
        if (opt == "none") {
            var nilB = curF.NewBlock("")
            var undB = curF.NewBlock("")
            b.NewCondBr(truthy(b, callExt(b, "js_seq", [v, hNull])), nilB, undB)
            undB.NewCondBr(truthy(undB, callExt(undB, "js_seq", [v, hUndef])), nilB, failB)
            return nilB
        }
        if (opt == "some") { return emitMatchPat(emitNotNil(b, v, failB), k.pargs[0], v, binding, failB) }
        // An enum case pattern matches by case NAME (a leading `.` has no type to
        // resolve against, and a qualified path names the same case); the sub-patterns
        // then match the associated values in order. sw_ename answers undefined for a
        // value that is not an enum case, so the test is safe for any subject.
        var okB = curF.NewBlock("")
        var nm = b.NewCall(rtEName(), [v])
        if (k.pval != null) {
            var caseB = curF.NewBlock("")
            var valB = curF.NewBlock("")
            b.NewCondBr(truthy(b, callExt(b, "js_seq", [nm, hUndef])), valB, caseB)
            var rv = k.pval(valB)
            rv.b.NewCondBr(truthy(rv.b, emitBin(rv.b, "==", v, rv.v)), okB, failB)
            b = caseB
        }
        b.NewCondBr(truthy(b, callExt(b, "js_seq", [nm, emitStr(b, patCaseName(k))])), okB, failB)
        b = okB
        if (k.pargs != null && k.pargs.length > 0) {
            var valsV = b.NewCall(rtVals(), [v])
            for (var j = 0; j < k.pargs.length; j++) {
                b = emitMatchPat(b, k.pargs[j], callExt(b, "js_swidx", [valsV, emitNum(b, j)]), binding, failB)
            }
        }
        return b
    }
    // items = [loThunk?, {rop}, hiThunk?] - a range pattern, one-sided when a bound
    // is missing (`10...`, `..<0`).
    function makePatRange(items) {
        var lo = null
        var k = 0
        if (typeof items[0] == "function") { lo = items[0]; k = 1 }
        var rop = items[k].rop
        var hi = items.length > k + 1 ? items[k + 1] : null
        return {prange: {lo: lo, hi: hi, rop: rop}}
    }
    function patCaseName(k) {
        var path = k.ppath
        var cut = -1
        for (var i = 0; i < path.length; i++) { if (path.charAt(i) == ".") { cut = i } }
        return cut < 0 ? path : path.substring(cut + 1)
    }

    // A condition list of if/guard/while: {cexpr} tests, {bindNames} optional
    // bindings and {pat} case patterns, each optionally followed by a where guard.
    // Every item must pass; anything that fails branches to failB.
    function emitConds(b, conds, failB) {
        for (var i = 0; i < conds.length; i++) {
            var cd = conds[i]
            if (cd.cexpr != undefined) {
                var r = cd.cexpr(b)
                b = r.b
                var nb = curF.NewBlock("")
                b.NewCondBr(truthy(b, r.v), nb, failB)
                b = nb
            } else if (cd.bindNames != undefined) {
                var ri = cd.init(b)
                b = emitNotNil(ri.b, ri.v, failB)
                var ns = cd.bindNames
                if (ns.length == 1) {
                    if (ns[0] != "_") { callExt(b, "js_scope_decl", [curScopeV, emitStr(b, ns[0]), emitCopy(b, ri.v)]) }
                } else {
                    for (var j = 0; j < ns.length; j++) {
                        if (ns[j] == "_") { continue }
                        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, ns[j]),
                                                     emitCopy(b, callExt(b, "js_get", [ri.v, emitStr(b, "" + j)]))])
                    }
                }
            } else {
                var rp = cd.init(b)
                b = emitMatchPat(rp.b, cd.pat, rp.v, false, failB)
            }
            if (cd.whereT != null) {
                var rw = cd.whereT(b)
                b = rw.b
                var nb2 = curF.NewBlock("")
                b.NewCondBr(truthy(b, rw.v), nb2, failB)
                b = nb2
            }
        }
        return b
    }
    function makeOptBind(items) {
        var names = items[0].bnames
        var initT = null
        var whereT = null
        var bty = ""
        var btxt = names[0]
        for (var i = 1; i < items.length; i++) {
            if (items[i].cinit != undefined) { initT = items[i].cinit }
            else if (items[i].cwhere != undefined) { whereT = items[i].cwhere }
            else if (items[i].btype != undefined) { bty = items[i].btype }
            else if (items[i].ctext != undefined) { btxt = items[i].ctext }
        }
        // The bound name's annotation, for swKeepMode: the explicit type, else that
        // of the bare local it unwraps. It holds in the block that follows, whose
        // swAnnOpen takes it from localAnnPending.
        if (names.length == 1) { localAnnPending.push({n: names[0], t: bty != "" ? bty : swInferAnn(btxt)}) }
        // `if let x` (Swift 5.7) rebinds x from the x already in scope.
        if (initT == null) { initT = makeVarRef(names[0]) }
        return {bindNames: names, init: initT, whereT: whereT}
    }
    function makeCaseCond(items) {
        var initT = null
        var whereT = null
        for (var i = 1; i < items.length; i++) {
            if (items[i].cinit != undefined) { initT = items[i].cinit }
            else if (items[i].cwhere != undefined) { whereT = items[i].cwhere }
        }
        return {pat: items[0], init: initT, whereT: whereT}
    }
    function makeCondIf(items) {
        var conds = items[0].conds
        var thenT = items[1]
        var elseT = items.length > 2 ? items[2] : null
        return function(b) {
            var saved = curScopeV
            curScopeV = callExt(b, "js_scope_new", [curScopeV])
            var elseB = curF.NewBlock("")
            var contB = curF.NewBlock("")
            thenT(emitConds(b, conds, elseB)).NewBr(contB)
            curScopeV = saved
            if (elseT != null) { elseT(elseB).NewBr(contB) } else { elseB.NewBr(contB) }
            return contB
        }
    }
    // guard binds into the scope it stands in (the bindings outlive the statement);
    // the else block runs only when the clause fails and normally diverges.
    function makeCondGuard(items) {
        var conds = items[0].conds
        var elseT = items[1]
        return function(b) {
            var elseB = curF.NewBlock("")
            var contB = curF.NewBlock("")
            emitConds(b, conds, elseB).NewBr(contB)
            elseT(elseB).NewBr(contB)
            return contB
        }
    }
    // Does a complex condition clause DECLARE anything? A CplxCondClause is reached
    // either through a leading binding or through a comma, so `while a > 1, b < 2` is
    // a legal clause that binds nothing - and it must not start paying for the
    // per-iteration scope the binding forms need (see makeForRange's header). Anything
    // that is not a plain cexpr is treated as binding, which over-counts a
    // value-only `case` pattern and never under-counts.
    function condsBind(conds) {
        for (var i = 0; i < conds.length; i++) {
            if (conds[i].cexpr == undefined) { return true }
        }
        return false
    }
    function makeCondWhile(items) {
        var lbl = itemLbl(items)
        var rest = itemsAfterLbl(items)
        var conds = rest[0].conds
        var bodyT = rest[1]
        return function(b) {
            var saved = curScopeV
            var headB = curF.NewBlock("")
            var exitB = curF.NewBlock("")
            b.NewBr(headB)
            // The clause's bindings are RE-MADE every iteration, so the scope they land
            // in is opened in the loop HEAD and not before it: `while let t =
            // q.popLast() { fs.append({ t }) }` binds a fresh t each turn, exactly like
            // the interpreter half's scopes.push({}) inside its while(true). Opening it
            // once outside would give every closure the same cell (see makeForRange's header).
            if (condsBind(conds)) { curScopeV = callExt(headB, "js_scope_new", [saved]) }
            var bodyB = emitConds(headB, conds, exitB)
            loopStack.push({cont: headB, brk: exitB, lbl: lbl})
            bodyT(bodyB).NewBr(headB)
            loopStack.pop()
            curScopeV = saved
            return exitB
        }
    }
    // items = [{lbl}?, pattern, listT, {fwhere}?, bodyT] - for case PAT in xs.
    function makeForCase(items) {
        var lbl = itemLbl(items)
        var rest = itemsAfterLbl(items)
        var pat = rest[0]
        var listT = rest[1]
        var k = 2
        var whereT = null
        if (rest[k] != undefined && rest[k].fwhere != undefined) { whereT = rest[k].fwhere; k++ }
        var bodyT = rest[k]
        return function(b) {
            hidCount++
            var iName = "$i" + hidCount
            var sName = "$s" + hidCount
            var saved = curScopeV
            curScopeV = callExt(b, "js_scope_new", [curScopeV])
            var r = listT(b)
            b = r.b
            var listV = hasRanges || hasSets ? b.NewCall(rtRangeArr(), [r.v]) : r.v
            if (hasUniStr) { listV = b.NewCall(rtStrSeq(), [listV]) }
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, sName), listV])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, iName), emitNum(b, 0)])
            var headB = curF.NewBlock("")
            var bodyB = curF.NewBlock("")
            var postB = curF.NewBlock("")
            var exitB = curF.NewBlock("")
            b.NewBr(headB)
            var iV = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, iName)])
            var sV = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, sName)])
            var lenV = callExt(headB, "js_pylen", [sV])
            headB.NewCondBr(truthy(headB, callExt(headB, "js_lt", [iV, lenV])), bodyB, exitB)
            var iV2 = callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, iName)])
            var sV2 = callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, sName)])
            var elV = callExt(bodyB, "js_swidx", [sV2, iV2])
            // A FRESH SCOPE per iteration, and emitMatchPat's `let` bindings land in it -
            // see the header above makeForRange. The pattern is a general Pattern here,
            // so there is no cheap "binds nothing" case to skip: `for case 1 in xs` is
            // the only one and it is not worth a walk of the pattern tree.
            var loopSavedC = curScopeV
            curScopeV = callExt(bodyB, "js_scope_new", [loopSavedC])
            var innerB = emitMatchPat(bodyB, pat, elV, false, postB)
            loopStack.push({cont: postB, brk: exitB, lbl: lbl})
            if (whereT != null) {
                var rw = whereT(innerB)
                var runB = curF.NewBlock("")
                rw.b.NewCondBr(truthy(rw.b, rw.v), runB, postB)
                innerB = runB
            }
            bodyT(innerB).NewBr(postB)
            loopStack.pop()
            curScopeV = loopSavedC
            var iV3 = callExt(postB, "js_scope_get", [curScopeV, emitStr(postB, iName)])
            callExt(postB, "js_scope_set", [curScopeV, emitStr(postB, iName),
                                            callExt(postB, "js_jadd", [iV3, emitNum(postB, 1)])])
            postB.NewBr(headB)
            curScopeV = saved
            return exitB
        }
    }

    // cond ? a : b -> a diamond with a phi merge (like an if expression).
    // items = [cond] or [cond, then, {ltxt}, else, {ltxt}]; an Int literal arm
    // next to a Double one is a Double.
    function makeTernary(items, txt) {
        if (items.length == 1) { return items[0] }
        var condT = items[0]
        var arms = swLitOperands(items.slice(1))
        var plain = swLitPlain(items.slice(1))
        var cell = swLitNote(txt, true)
        return function(b) {
            var thenT = cell.off ? plain[0] : arms[0]
            var elseT = cell.off ? plain[1] : arms[1]
            var r = condT(b)
            var thenB = curF.NewBlock("")
            var elseB = curF.NewBlock("")
            var mergeB = curF.NewBlock("")
            r.b.NewCondBr(truthy(r.b, r.v), thenB, elseB)
            var rt = thenT(thenB)
            rt.b.NewBr(mergeB)
            var re = elseT(elseB)
            re.b.NewBr(mergeB)
            var phi = mergeB.NewPhi([llvm.ir.NewIncoming(rt.v, rt.b), llvm.ir.NewIncoming(re.v, re.b)])
            return {b: mergeB, v: phi}
        }
    }

    // a ?? b: the right side runs only in its own block when a is nil (phi merge).
    // items = [emitter, {at}, emitter, ...]; {at} is the first operand's end
    // position, for swAsqTyOf.
    function makeCoalesce(items) {
        if (items.length == 2) { return items[0] }
        var aty = swAsqTyOf(items[1].at)
        if (aty == "") { aty = swLitCoalTy(items[1].ltxt) }
        return function(b) {
            var r = items[0](b)
            b = r.b
            var v = r.v
            for (var i = 2; i < items.length; i++) {
                var rightB = curF.NewBlock("")
                var mergeB = curF.NewBlock("")
                // nil is null or undefined, as emitNotNil tests it.
                var undB = curF.NewBlock("")
                b.NewCondBr(truthy(b, callExt(b, "js_seq", [v, hNull])), rightB, undB)
                undB.NewCondBr(undB.NewICmp(llvm.enum.IPredEQ, v, hUndef), rightB, mergeB)
                var r2 = items[i](rightB)
                if (aty != "") { r2 = {b: r2.b, v: swEmitAdopt(r2.b, r2.v, aty)} }
                r2.b.NewBr(mergeB)
                var phi = mergeB.NewPhi([llvm.ir.NewIncoming(v, undB), llvm.ir.NewIncoming(r2.v, r2.b)])
                b = mergeB
                v = phi
            }
            return {b: b, v: v}
        }
    }

    function makeArray(items0, txt) {
        var adopted = swLitOperands(items0)
        var plain = swLitPlain(items0)
        var cell = swLitNote(txt, false)
        return function(b) {
