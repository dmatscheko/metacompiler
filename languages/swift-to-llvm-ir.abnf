    function swRawEsc(t, lvl) {
        if (lvl == 0) { return t }
        var out = ""
        var i = 0
        while (i < t.length) {
            if (t.charCodeAt(i) != 92) { out += t.charAt(i); i++; continue }
            var j = i + 1
            while (j < t.length && t.charCodeAt(j) == 35) { j++ }
            if (j - i - 1 == lvl) { out += "\\"; i = j; continue }
            out += "\\\\"
            i++
        }
        return out
    }
    // The token RawScan returned is the WHOLE literal, delimiters included: n pound
    // signs, a quote, the content verbatim, the closing quote and n pound signs.
    function makeRawScanned(text) {
        var n = 0
        while (n < text.length && text.charAt(n) == "#") { n++ }
        return makeRawStr([{s: text.substring(n + 1, text.length - n - 1)}], n)
    }

    // `Self` as a value (twin of swSelfType in swift-interpreter.abnf): self when it
