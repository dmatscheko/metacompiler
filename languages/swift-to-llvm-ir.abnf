    // items = [{s: chunk} | {e: thunk}...] -> js_jadd fold starting from "".
    function makeTemplate(items) {
        for (var q = 0; q < items.length; q++) {
            var t = items[q].s
            if (t == undefined) { continue }
            for (var z = 0; z < t.length; z++) { if (t.charCodeAt(z) > 127) { hasUniStr = true } }
        }
        return function(b) {
            var v = emitStr(b, "")
            for (var i = 0; i < items.length; i++) {
                var pv
                if (items[i].s != undefined) { pv = emitStr(b, items[i].s) }
                else {
