            = CustomOp <~~ push({op: stripWs(up.in)}) ~~> UnaryExpr ;
BitNot      <~~ push(makeBitNot(pop())) ~~> = "~" NotChar61b UnaryExpr ;
NotChar61b  = :script(~~
    (function() { return (c.peek(0) === 61) ? abnf.newToken("\x01eq-follows", 0) : undefined })()
~~) ;
