    // method of the enclosing type: js_kget only sees the scope chain and the
    // receiver's OWN properties. When the name is one some type computes (or one some
    // type declares as a method) and no local of that name is in scope, the read is a
    // dispatch on self instead. Names no type uses this way keep the plain js_kget.
    // The plain read is the lowered sw_kget helper below rather than
    // core.scopeGetExt: that field names an EXTERN, and js_kget is no longer one.
    makeVarRef = function(name) {
        var plain = function(b) { return {b: b, v: b.NewCall(rtKGet(), [curScopeV, emitStr(b, name)])} }
        return function(b) {
            if (!isComputedName(name) && !isMemberMethod(name)) { return plain(b) }
            var t = callExt(b, "js_scope_typeof", [curScopeV, emitStr(b, name)])
            var localB = curF.NewBlock("")
            var selfB = curF.NewBlock("")
            var joinB = curF.NewBlock("")
            b.NewCondBr(truthy(b, callExt(b, "js_seq", [t, emitStr(b, "undefined")])), selfB, localB)
            var lv = localB.NewCall(rtKGet(), [curScopeV, emitStr(localB, name)])
            localB.NewBr(joinB)
            var selfV = selfB.NewCall(rtKGet(), [selfB == null ? curScopeV : curScopeV, emitStr(selfB, "self")])
            var sv
            if (isComputedName(name)) { sv = selfB.NewCall(rtGetProp(), [selfV, emitStr(selfB, name)]) }
            else { sv = callExt(selfB, "js_get", [selfV, emitStr(selfB, name)]) }
            selfB.NewBr(joinB)
            return {b: joinB, v: joinB.NewPhi([llvm.ir.NewIncoming(lv, localB), llvm.ir.NewIncoming(sv, selfB)])}
        }
    }

    // ----- Emitted runtime helpers -----
    // A handful of routines are too branchy to inline at every use site, so they are
    // emitted ONCE as ordinary IR functions and called directly. rtFunc registers the
    // function before emitting its body, so a helper may call itself.
    var rtFuncs = {}
    function rtFunc(name, nparams, bodyFn) {
        if (hasOwn(rtFuncs, "$" + name)) { return rtFuncs["$" + name] }
        var ps = []
        for (var i = 0; i < nparams; i++) { ps.push(llvm.ir.NewParam("p" + i, i64)) }
        var f = m.NewFunc(name, i64, ps)
        rtFuncs["$" + name] = f
        var savedF = curF
        var savedScope = curScopeV
        var savedLoops = loopStack
        var savedTag = curFTag
        curF = f
        loopStack = []
        var b = f.NewBlock("entry")
        bodyFn(b, f.Params)
        curF = savedF
        curScopeV = savedScope
        loopStack = savedLoops
        curFTag = savedTag
        return f
    }
    // A guarded property read: undefined for anything that is not a plain object, so
    // it is safe to apply to a value of unknown type (js_get aborts on nil).
    function rtProbe(name, prop) {
        return rtFunc(name, 1, function(b, ps) {
            var v = ps[0]
            var noB = curF.NewBlock("")
            var c1 = curF.NewBlock("")
            var c2 = curF.NewBlock("")
            var c3 = curF.NewBlock("")
            b.NewCondBr(truthy(b, callExt(b, "js_seq", [v, hNull])), noB, c1)
            c1.NewCondBr(truthy(c1, callExt(c1, "js_seq", [v, hUndef])), noB, c2)
            c2.NewCondBr(truthy(c2, callExt(c2, "js_seq", [callExt(c2, "js_typeof", [v]), emitStr(c2, "object")])), c3, noB)
            c3.NewCondBr(truthy(c3, callExt(c3, "js_is_type", [v, emitStr(c3, "Array")])), noB, (function() {
                var okB = curF.NewBlock("")
                okB.NewRet(callExt(okB, "js_get", [v, emitStr(okB, prop)]))
                return okB
            })())
            noB.NewRet(hUndef)
        })
    }
    function rtEqKey() { return rtProbe("sw_eqkey", "__eqkey") }
    // ----- Strings are sequences of extended grapheme clusters -----
    // .count counts CLUSTERS and == compares by CANONICAL EQUIVALENCE, so these two
    // walk the string by code point (js_kindex answers the rune at a code-unit index;
    // a surrogate half comes back as U+FFFD, which is how a pair is recognised). Both
    // are emitted only for a program that has a non-ASCII or escaped string literal,
    // so an ASCII-only program keeps the IR it had.
    var combLo = [0x300, 0x483, 0x591, 0x610, 0x64B, 0x1AB0, 0x1DC0, 0x20D0, 0xFE00, 0xFE20]
    var combHi = [0x36F, 0x489, 0x5BD, 0x61A, 0x65F, 0x1AFF, 0x1DFF, 0x20F0, 0xFE0F, 0xFE2F]
    function rtIsComb() {
        return rtFunc("sw_iscomb", 1, function(b, ps) {
            var yesB = curF.NewBlock("")
            var noB = curF.NewBlock("")
            for (var i = 0; i < combLo.length; i++) {
                var inB = curF.NewBlock("")
                var nxB = curF.NewBlock("")
                b.NewCondBr(truthy(b, callExt(b, "js_ge", [ps[0], emitNum(b, combLo[i])])), inB, nxB)
                inB.NewCondBr(truthy(inB, callExt(inB, "js_le", [ps[0], emitNum(inB, combHi[i])])), yesB, nxB)
                b = nxB
            }
            b.NewBr(noB)
            yesB.NewRet(hTrue)
            noB.NewRet(hFalse)
        })
    }
    function rtGCount() {
        return rtFunc("sw_gcount", 1, function(b, ps) {
            var sV = ps[0]
            var lenV = callExt(b, "js_pylen", [sV])
            var sc = callExt(b, "js_scope_new", [handle(0)])
            callExt(b, "js_scope_decl", [sc, emitStr(b, "i"), emitNum(b, 0)])
            callExt(b, "js_scope_decl", [sc, emitStr(b, "n"), emitNum(b, 0)])
            var headB = curF.NewBlock("")
            var bodyB = curF.NewBlock("")
            var doneB = curF.NewBlock("")
            b.NewBr(headB)
            var iV = callExt(headB, "js_scope_get", [sc, emitStr(headB, "i")])
            headB.NewCondBr(truthy(headB, callExt(headB, "js_lt", [iV, lenV])), bodyB, doneB)
            var i2 = callExt(bodyB, "js_scope_get", [sc, emitStr(bodyB, "i")])
            var cp = callExt(bodyB, "js_char_code", [callExt(bodyB, "js_kindex", [sV, i2])])
            callExt(bodyB, "js_scope_set", [sc, emitStr(bodyB, "i"), callExt(bodyB, "js_jadd", [i2, emitNum(bodyB, 1)])])
            var surB = curF.NewBlock("")
            var chkB = curF.NewBlock("")
            var combB = curF.NewBlock("")
            var countB = curF.NewBlock("")
            bodyB.NewCondBr(truthy(bodyB, callExt(bodyB, "js_seq", [cp, emitNum(bodyB, 0xFFFD)])), surB, chkB)
            // A surrogate half: skip its partner, the pair is one cluster.
            callExt(surB, "js_scope_set", [sc, emitStr(surB, "i"),
                                           callExt(surB, "js_jadd", [callExt(surB, "js_scope_get", [sc, emitStr(surB, "i")]), emitNum(surB, 1)])])
            surB.NewBr(countB)
            chkB.NewCondBr(truthy(chkB, chkB.NewCall(rtIsComb(), [cp])), combB, countB)
            combB.NewBr(headB)
            callExt(countB, "js_scope_set", [sc, emitStr(countB, "n"),
                                             callExt(countB, "js_jadd", [callExt(countB, "js_scope_get", [sc, emitStr(countB, "n")]), emitNum(countB, 1)])])
            countB.NewBr(headB)
            doneB.NewRet(callExt(doneB, "js_scope_get", [sc, emitStr(doneB, "n")]))
        })
    }
    // Canonical decomposition of the Latin-1 precomposed letters (the range real
    // programs mix); everything else is copied through.
    function rtNfd() {
        return rtFunc("sw_nfd", 1, function(b, ps) {
            var sV = ps[0]
            var baseArr = callExt(b, "js_arr_new", [])
            var markArr = callExt(b, "js_arr_new", [])
            for (var q = 0; q < 64; q++) {
                callExt(b, "js_arr_push", [baseArr, emitNum(b, nfdBase.charCodeAt(q))])
                callExt(b, "js_arr_push", [markArr, emitNum(b, nfdMark[q])])
            }
            var lenV = callExt(b, "js_pylen", [sV])
            var sc = callExt(b, "js_scope_new", [handle(0)])
            callExt(b, "js_scope_decl", [sc, emitStr(b, "i"), emitNum(b, 0)])
            callExt(b, "js_scope_decl", [sc, emitStr(b, "o"), emitStr(b, "")])
            var headB = curF.NewBlock("")
            var bodyB = curF.NewBlock("")
            var doneB = curF.NewBlock("")
            b.NewBr(headB)
            var iV = callExt(headB, "js_scope_get", [sc, emitStr(headB, "i")])
            headB.NewCondBr(truthy(headB, callExt(headB, "js_lt", [iV, lenV])), bodyB, doneB)
            var i2 = callExt(bodyB, "js_scope_get", [sc, emitStr(bodyB, "i")])
            var cp = callExt(bodyB, "js_char_code", [callExt(bodyB, "js_kindex", [sV, i2])])
            callExt(bodyB, "js_scope_set", [sc, emitStr(bodyB, "i"), callExt(bodyB, "js_jadd", [i2, emitNum(bodyB, 1)])])
            var inRangeB = curF.NewBlock("")
            var hiB = curF.NewBlock("")
            var plainB = curF.NewBlock("")
            var splitB = curF.NewBlock("")
            bodyB.NewCondBr(truthy(bodyB, callExt(bodyB, "js_ge", [cp, emitNum(bodyB, 0xC0)])), hiB, plainB)
            hiB.NewCondBr(truthy(hiB, callExt(hiB, "js_le", [cp, emitNum(hiB, 0xFF)])), inRangeB, plainB)
            var idx = callExt(inRangeB, "js_sub", [cp, emitNum(inRangeB, 0xC0)])
            var bc = callExt(inRangeB, "js_pyget", [baseArr, idx])
            inRangeB.NewCondBr(truthy(inRangeB, bc), splitB, plainB)
            var acc1 = callExt(splitB, "js_scope_get", [sc, emitStr(splitB, "o")])
            acc1 = callExt(splitB, "js_jadd", [acc1, callExt(splitB, "js_char", [bc])])
            acc1 = callExt(splitB, "js_jadd", [acc1, callExt(splitB, "js_char", [callExt(splitB, "js_pyget", [markArr, idx])])])
            callExt(splitB, "js_scope_set", [sc, emitStr(splitB, "o"), acc1])
            splitB.NewBr(headB)
            var acc2 = callExt(plainB, "js_scope_get", [sc, emitStr(plainB, "o")])
            acc2 = callExt(plainB, "js_jadd", [acc2, callExt(plainB, "js_char", [cp])])
            callExt(plainB, "js_scope_set", [sc, emitStr(plainB, "o"), acc2])
            plainB.NewBr(headB)
            doneB.NewRet(callExt(doneB, "js_scope_get", [sc, emitStr(doneB, "o")]))
        })
    }
    // .count over a value that may be a string.
    function rtCount() {
        return rtFunc("sw_count", 1, function(b, ps) {
            var isStr = callExt(b, "js_seq", [callExt(b, "js_typeof", [ps[0]]), emitStr(b, "string")])
            var strB = curF.NewBlock("")
            var otherB = curF.NewBlock("")
            b.NewCondBr(truthy(b, isStr), strB, otherB)
            strB.NewRet(strB.NewCall(rtGCount(), [ps[0]]))
            otherB.NewRet(callExt(otherB, "js_pylen", [ps[0]]))
        })
    }
    // String equality by canonical equivalence: identical code units win outright,
    // otherwise the two decompositions are compared.
    function rtStrEq() {
        return rtFunc("sw_streq", 2, function(b, ps) {
            var sameB = curF.NewBlock("")
            var nfdB = curF.NewBlock("")
            b.NewCondBr(truthy(b, callExt(b, "js_seq", [ps[0], ps[1]])), sameB, nfdB)
            sameB.NewRet(hTrue)
            nfdB.NewRet(callExt(nfdB, "js_seq", [nfdB.NewCall(rtNfd(), [ps[0]]), nfdB.NewCall(rtNfd(), [ps[1]])]))
        })
    }
    // A property read that cannot abort: undefined for anything that is not a plain
    // object (js_get fails on nil, and answers an index on an array).
    function rtSafeGet() {
        return rtFunc("sw_safeget", 2, function(b, ps) {
            var v = ps[0]
            var noB = curF.NewBlock("")
            var c1 = curF.NewBlock("")
            var c2 = curF.NewBlock("")
            var okB = curF.NewBlock("")
            b.NewCondBr(truthy(b, callExt(b, "js_seq", [v, hNull])), noB, c1)
            c1.NewCondBr(truthy(c1, callExt(c1, "js_seq", [v, hUndef])), noB, c2)
            c2.NewCondBr(truthy(c2, callExt(c2, "js_seq", [callExt(c2, "js_typeof", [v]), emitStr(c2, "object")])), okB, noB)
            okB.NewRet(callExt(okB, "js_get", [v, ps[1]]))
            noB.NewRet(hUndef)
        })
    }
    // ----- the scope probe, lowered here rather than left as an extern -----
    //
    // js_kget / js_kset used to be externs that took a SCOPE HANDLE and walked the
    // chain. A scope is the C floor's PRIVATE storage - which is exactly why the Lua
    // pilot moved js_scope_decl/js_scope_set/js_scope_typeof INTO the floor - so
    // languages/lib/swift-rt.metajs (layer 2) cannot open one and could never have
    // implemented either. See "TWO THINGS EVERY ONE OF THE REMAINING NINE NEEDS" in
    // docs/runtime-next-plan.md part 3: this is the generalisation PHP recorded, and
    // Swift is its second instance.
    //
    // Neither call needs a floor addition, because both are PROBES and an EMITTER may
    // call js_scope_typeof / js_scope_get / js_scope_set. Two IR helpers rather than
    // PHP's single-expression helper, because Swift's pair is the `this`-aware Kotlin
    // shape: a name that is no local resolves against the properties of `self`.
    //
    // The one place this cannot be exact is a scope slot that HOLDS undefined:
    // js_scope_typeof answers "undefined" for it and for an absent name alike, so such
    // a name takes the self fallback and then, on a miss, the js_scope_get below -
    // which returns the undefined it held under the Go twin and ABORTS in the C floor
    // ("variable not defined"). Swift's grammar declares an uninitialised `let v: Int`
    // as NULL, not undefined (see the `let v: Int` note further down), so no emitted
    // binding takes that path; it is written out rather than hidden.
    function rtKGet() {
        return rtFunc("sw_kget", 2, function(b, ps) {
            var localB = curF.NewBlock("")
            var selfB = curF.NewBlock("")
            var t = callExt(b, "js_scope_typeof", [ps[0], ps[1]])
            b.NewCondBr(truthy(b, callExt(b, "js_seq", [t, emitStr(b, "undefined")])), selfB, localB)
            localB.NewRet(callExt(localB, "js_scope_get", [ps[0], ps[1]]))
            // No local of that name: the FIRST `this` up the chain, if there is one.
            var probeB = curF.NewBlock("")
            var missB = curF.NewBlock("")
            var tt = callExt(selfB, "js_scope_typeof", [selfB == null ? ps[0] : ps[0], emitStr(selfB, "this")])
            selfB.NewCondBr(truthy(selfB, callExt(selfB, "js_seq", [tt, emitStr(selfB, "undefined")])), missB, probeB)
            var selfV = callExt(probeB, "js_scope_get", [ps[0], emitStr(probeB, "this")])
            var mV = probeB.NewCall(rtSafeGet(), [selfV, ps[1]])
            var hitB = curF.NewBlock("")
            probeB.NewCondBr(truthy(probeB, callExt(probeB, "js_sne", [mV, hUndef])), hitB, missB)
            hitB.NewRet(mV)
            // Nothing anywhere: js_scope_get is the abort, and it is the SAME abort the
            // extern used to raise, so a program that read an unknown name still dies.
            missB.NewRet(callExt(missB, "js_scope_get", [ps[0], ps[1]]))
        })
    }
    function rtKSet() {
        return rtFunc("sw_kset", 3, function(b, ps) {
            var localB = curF.NewBlock("")
            var selfB = curF.NewBlock("")
            var t = callExt(b, "js_scope_typeof", [ps[0], ps[1]])
            b.NewCondBr(truthy(b, callExt(b, "js_seq", [t, emitStr(b, "undefined")])), selfB, localB)
            callExt(localB, "js_scope_set", [ps[0], ps[1], ps[2]])
            localB.NewRet(handle(0))
            var probeB = curF.NewBlock("")
            var missB = curF.NewBlock("")
            var tt = callExt(selfB, "js_scope_typeof", [ps[0], emitStr(selfB, "this")])
            selfB.NewCondBr(truthy(selfB, callExt(selfB, "js_seq", [tt, emitStr(selfB, "undefined")])), missB, probeB)
            var selfV = callExt(probeB, "js_scope_get", [ps[0], emitStr(probeB, "this")])
            var mV = probeB.NewCall(rtSafeGet(), [selfV, ps[1]])
            var hitB = curF.NewBlock("")
            probeB.NewCondBr(truthy(probeB, callExt(probeB, "js_sne", [mV, hUndef])), hitB, missB)
            callExt(hitB, "js_set", [selfV, ps[1], ps[2]])
            hitB.NewRet(handle(0))
            callExt(missB, "js_scope_set", [ps[0], ps[1], ps[2]])
            missB.NewRet(handle(0))
        })
    }
    // Finds a member on a value's type, walking the superclass chain, or undefined.
    function rtFindM() {
        return rtFunc("sw_findm", 2, function(b, ps) {
            var sc = callExt(b, "js_scope_new", [handle(0)])
            callExt(b, "js_scope_decl", [sc, emitStr(b, "c"), b.NewCall(rtClassOf(), [ps[0]])])
            var headB = curF.NewBlock("")
            var bodyB = curF.NewBlock("")
            var missB = curF.NewBlock("")
            b.NewBr(headB)
            var cV = callExt(headB, "js_scope_get", [sc, emitStr(headB, "c")])
            headB.NewCondBr(truthy(headB, cV), bodyB, missB)
            var mV = callExt(bodyB, "js_get", [cV, ps[1]])
            var hitB = curF.NewBlock("")
            var stepB = curF.NewBlock("")
            bodyB.NewCondBr(truthy(bodyB, mV), hitB, stepB)
            hitB.NewRet(mV)
            callExt(stepB, "js_scope_set", [sc, emitStr(stepB, "c"),
                                            callExt(stepB, "js_get", [callExt(stepB, "js_scope_get", [sc, emitStr(stepB, "c")]), emitStr(stepB, "__super")])])
            stepB.NewBr(headB)
            missB.NewRet(hUndef)
