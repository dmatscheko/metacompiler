    // enclosing type read statically.
    function rtSelfType() {
        return rtFunc("sw_selftype", 2, function(b, ps) {
            var tyB = curF.NewBlock("")
            var c2 = curF.NewBlock("")
            var insB = curF.NewBlock("")
            var stB = curF.NewBlock("")
            var descB = curF.NewBlock("")
            var tblB = curF.NewBlock("")
            b.NewCondBr(truthy(b, b.NewCall(rtIsTypeVal(), [ps[0]])), tyB, c2)
            tyB.NewRet(ps[0])
            var cls = c2.NewCall(rtClassOf(), [ps[0]])
