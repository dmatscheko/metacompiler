        // resolve against, and a qualified path names the same case); the sub-patterns
        // then match the associated values in order. sw_ename answers undefined for a
        // value that is not an enum case, so the test is safe for any subject.
        var okB = curF.NewBlock("")
        var nm = b.NewCall(rtEName(), [v])
        b.NewCondBr(truthy(b, callExt(b, "js_seq", [nm, emitStr(b, patCaseName(k))])), okB, failB)
