            if (enumNames[name] == 1) {
                var eV = b.NewCall(rtKGet(), [curScopeV, emitStr(b, name)])
                var ear = emitArgRecs(b, args)
                b = ear.b
                return {b: b, v: b.NewCall(rtRawCase(), [eV, callExt(b, "js_pyget", [ear.v, emitNum(b, 0)])])}
            }
            if (classNames[name] == 1) {
                var clsV = b.NewCall(rtKGet(), [curScopeV, emitStr(b, name)])
                return emitConstruct(b, name, clsV, args)
