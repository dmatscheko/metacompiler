        var assoc = null
        var rawT = null
        for (var i = 0; i < items.length; i++) {
            var it = items[i]
            if (it == undefined) { continue }
            if (it.cname != undefined) { cname = it.cname }
            else if (it.cassoc != undefined) { assoc = it.cassoc }
            else if (it.craw != undefined) { rawT = it.craw }
