    // precedencegroup / operator declarations. Only the RELATIVE order of the custom
    // operators matters: they all sit at one level of the expression grammar (tighter
    // than * and /), and the fold below orders them among themselves.
    var groupInfo = {}
    var opInfo = {}
    var builtinLevel = {AssignmentPrecedence: 1, TernaryPrecedence: 2, DefaultPrecedence: 3,
                        LogicalDisjunctionPrecedence: 4, LogicalConjunctionPrecedence: 5,
                        ComparisonPrecedence: 6, NilCoalescingPrecedence: 7,
                        CastingPrecedence: 8, RangeFormationPrecedence: 9,
                        AdditionPrecedence: 10, MultiplicationPrecedence: 11,
                        BitwiseShiftPrecedence: 12}
    function makePrecGroup(items) {
        var name = items[0]
        var higher = []
        var assoc = "left"
        for (var i = 1; i < items.length; i++) {
