        var conds = items[0].conds
        var thenT = items[1]
        var elseT = items.length > 2 ? items[2] : null
        return function(b) {
            var saved = curScopeV
            curScopeV = callExt(b, "js_scope_new", [curScopeV])
            var elseB = curF.NewBlock("")
            var contB = curF.NewBlock("")
            thenT(emitConds(b, conds, elseB)).NewBr(contB)
            curScopeV = saved
            if (elseT != null) { elseT(elseB).NewBr(contB) } else { elseB.NewBr(contB) }
            return contB
        }
    }
    // guard binds into the scope it stands in (the bindings outlive the statement);
    // the else block runs only when the clause fails and normally diverges.
    function makeCondGuard(items) {
        var conds = items[0].conds
        var elseT = items[1]
        return function(b) {
            var elseB = curF.NewBlock("")
            var contB = curF.NewBlock("")
            emitConds(b, conds, elseB).NewBr(contB)
            elseT(elseB).NewBr(contB)
            return contB
        }
    }
    function makeCondWhile(items) {
        var lbl = itemLbl(items)
        var rest = itemsAfterLbl(items)
        var conds = rest[0].conds
        var bodyT = rest[1]
        return function(b) {
            var saved = curScopeV
            curScopeV = callExt(b, "js_scope_new", [curScopeV])
            var headB = curF.NewBlock("")
            var exitB = curF.NewBlock("")
            b.NewBr(headB)
            var bodyB = emitConds(headB, conds, exitB)
            loopStack.push({cont: headB, brk: exitB, lbl: lbl})
            bodyT(bodyB).NewBr(headB)
            loopStack.pop()
            curScopeV = saved
            return exitB
        }
    }
    // items = [{lbl}?, pattern, listT, {fwhere}?, bodyT] - for case PAT in xs.
    function makeForCase(items) {
        var lbl = itemLbl(items)
        var rest = itemsAfterLbl(items)
        var pat = rest[0]
        var listT = rest[1]
        var k = 2
        var whereT = null
        if (rest[k] != undefined && rest[k].fwhere != undefined) { whereT = rest[k].fwhere; k++ }
        var bodyT = rest[k]
        return function(b) {
            hidCount++
            var iName = "$i" + hidCount
            var sName = "$s" + hidCount
            var saved = curScopeV
            curScopeV = callExt(b, "js_scope_new", [curScopeV])
            var r = listT(b)
            b = r.b
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, sName), r.v])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, iName), emitNum(b, 0)])
            var headB = curF.NewBlock("")
            var bodyB = curF.NewBlock("")
            var postB = curF.NewBlock("")
            var exitB = curF.NewBlock("")
            b.NewBr(headB)
            var iV = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, iName)])
            var sV = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, sName)])
            var lenV = callExt(headB, "js_pylen", [sV])
            headB.NewCondBr(truthy(headB, callExt(headB, "js_lt", [iV, lenV])), bodyB, exitB)
            var iV2 = callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, iName)])
            var sV2 = callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, sName)])
            var elV = callExt(bodyB, "js_pyget", [sV2, iV2])
            var innerB = emitMatchPat(bodyB, pat, elV, false, postB)
            loopStack.push({cont: postB, brk: exitB, lbl: lbl})
            if (whereT != null) {
                var rw = whereT(innerB)
                var runB = curF.NewBlock("")
                rw.b.NewCondBr(truthy(rw.b, rw.v), runB, postB)
                innerB = runB
            }
            bodyT(innerB).NewBr(postB)
            loopStack.pop()
            var iV3 = callExt(postB, "js_scope_get", [curScopeV, emitStr(postB, iName)])
            callExt(postB, "js_scope_set", [curScopeV, emitStr(postB, iName),
                                            callExt(postB, "js_jadd", [iV3, emitNum(postB, 1)])])
            postB.NewBr(headB)
            curScopeV = saved
            return exitB
        }
    }

    // cond ? a : b -> a diamond with a phi merge (like an if expression).
    function makeTernary(items) {
        if (items.length == 1) { return items[0] }
        var condT = items[0]
        var thenT = items[1]
        var elseT = items[2]
        return function(b) {
            var r = condT(b)
            var thenB = curF.NewBlock("")
            var elseB = curF.NewBlock("")
            var mergeB = curF.NewBlock("")
            r.b.NewCondBr(truthy(r.b, r.v), thenB, elseB)
            var rt = thenT(thenB)
            rt.b.NewBr(mergeB)
            var re = elseT(elseB)
            re.b.NewBr(mergeB)
            var phi = mergeB.NewPhi([llvm.ir.NewIncoming(rt.v, rt.b), llvm.ir.NewIncoming(re.v, re.b)])
            return {b: mergeB, v: phi}
        }
    }

    // a ?? b: the right side runs only in its own block when a is nil (phi merge).
    function makeCoalesce(items) {
        if (items.length == 1) { return items[0] }
        return function(b) {
            var r = items[0](b)
            b = r.b
            var v = r.v
            for (var i = 1; i < items.length; i++) {
                var rightB = curF.NewBlock("")
                var mergeB = curF.NewBlock("")
                var isNull = callExt(b, "js_seq", [v, hNull])
                b.NewCondBr(truthy(b, isNull), rightB, mergeB)
                var r2 = items[i](rightB)
                r2.b.NewBr(mergeB)
                var phi = mergeB.NewPhi([llvm.ir.NewIncoming(v, b), llvm.ir.NewIncoming(r2.v, r2.b)])
                b = mergeB
                v = phi
            }
            return {b: b, v: v}
        }
    }

    function makeArray(items) {
        return function(b) {
            var arrV = callExt(b, "js_arr_new", [])
            for (var i = 0; i < items.length; i++) {
                var r = items[i](b)
                b = r.b
                callExt(b, "js_arr_push", [arrV, r.v])
            }
            return {b: b, v: arrV}
        }
    }
    function makeDict(items) {
        return function(b) {
            var d = callExt(b, "js_dict_new", [])
            for (var i = 0; i < items.length; i++) {
                var rk = items[i].dk(b)
                b = rk.b
                var rv = items[i].dv(b)
                b = rv.b
                callExt(b, "js_pyset", [d, rk.v, rv.v])
            }
            return {b: b, v: d}
        }
    }

    // .count -> js_pylen (arrays, strings and dicts); other .name -> js_get;
    // [i] -> js_pyget (core.indexExt); .m(args) -> js_mcall.
    core.indexExt = "js_pyget"
    // A member read: a computed property (or an observed stored one) is reached
    // through the generated __get_x method, everything else is a plain js_get. The
    // decision is by NAME, over the set of names some type in this program computes.
    function emitFieldRead(b, cur, name) {
        if (name == "count") { return callExt(b, "js_pylen", [cur]) }
        if (name == "rawValue") { return callExt(b, "js_get", [cur, emitStr(b, "__raw")]) }
        var bt = builtinCompOf(name)
        if (bt != null) {
            var ta = callExt(b, "js_arr_new", [])
            callExt(b, "js_arr_push", [ta, cur])
            var tbl = callExt(b, "js_kget", [curScopeV, emitStr(b, "$ext$" + bt)])
            return callExt(b, "js_call", [callExt(b, "js_get", [tbl, emitStr(b, "__get_" + name)]), hUndef, ta])
        }
        if (isComputedName(name)) { return b.NewCall(rtGetProp(), [cur, emitStr(b, name)]) }
        return callExt(b, "js_get", [cur, emitStr(b, name)])
    }
    function emitIndexRead(b, cur, idxV) {
        if (!hasSubscript) { return callExt(b, core.indexExt, [cur, idxV]) }
        return b.NewCall(rtSubGet(), [cur, idxV])
    }
    foldCallMember = function(items) {
        if (items.length == 1) {
            if (typeof items[0] != "function") { return function(b) { return {b: b, v: hUndef} } }
            return items[0]
        }
        var primary = items[0]
        var suffixes = items.slice(1)
        // `super.m(args)` / `super.p`: resolved statically against the superclass of
        // the type whose member is being emitted, with the same receiver.
        if (typeof primary != "function" && primary.superref != undefined) {
            return function(b) {
                var t = curType()
                var sname = (t == null || t.superName == null) ? null : t.superName
                var thisV = callExt(b, "js_kget", [curScopeV, emitStr(b, "this")])
                if (sname == null) { return {b: b, v: hUndef} }
                var sV = callExt(b, "js_kget", [curScopeV, emitStr(b, sname)])
                var s0 = suffixes[0]
                var cur
                if (s0.kind == "mcall") {
                    var sargs = callExt(b, "js_arr_new", [])
                    callExt(b, "js_arr_push", [sargs, thisV])
                    var ea0 = emitArgRecsInto(b, s0.args, sargs)
                    b = ea0.b
                    var mkey = s0.name
                    if (s0.name == "init") { mkey = pickOverload("init", typeRec(sname).inits, s0.args) }
                    cur = callExt(b, "js_call", [callExt(b, "js_get", [sV, emitStr(b, mkey)]), hUndef, sargs])
                } else {
                    var gargs = callExt(b, "js_arr_new", [])
                    callExt(b, "js_arr_push", [gargs, thisV])
                    if (isComputedName(s0.name)) {
                        cur = callExt(b, "js_call", [callExt(b, "js_get", [sV, emitStr(b, "__get_" + s0.name)]), hUndef, gargs])
                    } else if (false) {} else {
                        cur = callExt(b, "js_get", [thisV, emitStr(b, s0.name)])
                    }
                }
                for (var i = 1; i < suffixes.length; i++) {
                    var s = suffixes[i]
                    if (s.kind == "mcall") {
                        var ea = emitArgRecs(b, s.args)
                        b = ea.b
                        cur = callExt(b, "js_mcall", [cur, emitStr(b, s.name), ea.v])
                    } else if (s.kind == "field") { cur = emitFieldRead(b, cur, s.name) }
                    else if (s.kind == "call") {
                        var eac = emitArgRecs(b, s.args)
                        b = eac.b
                        cur = callExt(b, "js_call", [cur, hUndef, eac.v])
                    } else if (s.kind == "index") {
                        var ri = s.idx(b)
                        b = ri.b
                        cur = emitIndexRead(b, cur, ri.v)
                    }
                }
                return {b: b, v: cur}
            }
        }
        return function(b) {
            var r = primary(b)
            b = r.b
            var cur = r.v
            // Optional chaining: every ?. adds a block that leaves the chain with nil.
            var nilExits = []
            for (var i = 0; i < suffixes.length; i++) {
                var s = suffixes[i]
                if (s.kind == "opt") {
                    var nB = curF.NewBlock("")
                    var c1B = curF.NewBlock("")
                    var contB = curF.NewBlock("")
                    b.NewCondBr(truthy(b, callExt(b, "js_seq", [cur, hNull])), nB, c1B)
                    c1B.NewCondBr(truthy(c1B, callExt(c1B, "js_seq", [cur, hUndef])), nB, contB)
                    nilExits.push(nB)
                    b = contB
                } else if (s.kind == "force") {
                    // Force unwrap: the value is already the unwrapped one here.
                } else if (s.kind == "mcall" && builtinMethOf(s.name) != null) {
                    // A method an extension of a builtin type added.
                    var eb = callExt(b, "js_arr_new", [])
                    callExt(b, "js_arr_push", [eb, cur])
                    var eab = emitArgRecsInto(b, s.args, eb)
                    b = eab.b
                    var btbl = callExt(b, "js_kget", [curScopeV, emitStr(b, "$ext$" + builtinMethOf(s.name))])
                    cur = callExt(b, "js_call", [callExt(b, "js_get", [btbl, emitStr(b, s.name)]), hUndef, eb])
                    emitWriteBacks(b, eab.boxes)
                } else if (s.kind == "mcall" && classNames[s.name] == 1) {
                    // Outer.Inner(...): a NESTED type reached through its enclosing one.
                    var rc = emitConstruct(b, s.name, callExt(b, "js_get", [cur, emitStr(b, s.name)]), s.args)
                    b = rc.b
                    cur = rc.v
                } else if (s.kind == "mcall") {
                    var ea = emitArgRecs(b, s.args)
                    b = ea.b
                    var mname = s.name
                    // self.init(...) picks the initializer overload by its labels.
                    if (s.name == "init" && curType() != null) {
                        mname = pickOverload("init", typeRec(curType().name).inits, s.args)
                    }
                    cur = callExt(b, "js_mcall", [cur, emitStr(b, mname), ea.v])
                    emitWriteBacks(b, ea.boxes)
                } else if (s.kind == "call") {
                    var eac = emitArgRecs(b, s.args)
                    b = eac.b
                    cur = callExt(b, "js_call", [cur, hUndef, eac.v])
                    emitWriteBacks(b, eac.boxes)
                } else if (s.kind == "field") {
                    cur = emitFieldRead(b, cur, s.name)
                } else {
                    var ir2 = s.idx(b)
                    b = ir2.b
                    cur = emitIndexRead(b, cur, ir2.v)
                }
            }
            if (nilExits.length == 0) { return {b: b, v: cur} }
            var mergeB = curF.NewBlock("")
            var inc = [llvm.ir.NewIncoming(cur, b)]
            b.NewBr(mergeB)
            for (var k = 0; k < nilExits.length; k++) {
                nilExits[k].NewBr(mergeB)
                inc.push(llvm.ir.NewIncoming(hNull, nilExits[k]))
            }
            return {b: mergeB, v: mergeB.NewPhi(inc)}
        }
    }

    // The closure signature: an optional capture list and the parameter names.
    function makeClosureSig(items) {
        var caps = []
        var names = []
        for (var i = 0; i < items.length; i++) {
            if (typeof items[i] == "string") { names.push(items[i]) }
            else if (items[i].caps != undefined) { caps = items[i].caps }
        }
        return {csig: true, caps: caps, cparams: names}
    }
    // An @autoclosure argument becomes a zero-argument closure, so the expression
    // only runs if the callee actually calls it.
    function autoWrap(t) {
        return function(b) {
            var body = function(bb) {
                var r = t(bb)
                r.b.NewRet(r.v)
                return deadBlock()
            }
            var idx = emitFunc([], body, false)
            return {b: b, v: callExt(b, "js_closure", [handle(idx), curScopeV])}
        }
    }
    // A closure becomes an IR function closed over the current scope (js_closure);
    // its value is the last expression. A capture list snapshots its names into a
    // scope of their own; a closure with no parameter names binds its arguments
    // under the shorthand names $0..$3.
    function makeClosure(items) {
        var params = []
        var caps = []
        var start = 0
        if (items.length > 0 && items[0] != undefined && items[0].csig != undefined) {
            params = items[0].cparams
            caps = items[0].caps
            start = 1
        }
        if (params.length == 0) { params = ["$0", "$1", "$2", "$3"] }
        var body = items.slice(start)
        var bodyStmt = function(b) {
            var v = hUndef
            for (var k = 0; k < body.length; k++) {
                if (body[k].expr != undefined) {
                    var r = body[k].expr(b)
                    b = r.b
                    v = r.v
                } else {
                    b = body[k].stmt(b)
                    v = hUndef
                }
            }
            b.NewRet(v)
            return deadBlock()
        }
        return function(b) {
            var env = curScopeV
            if (caps.length > 0) {
                env = callExt(b, "js_scope_new", [curScopeV])
                for (var ci = 0; ci < caps.length; ci++) {
                    callExt(b, "js_scope_decl", [env, emitStr(b, caps[ci]),
                                                 callExt(b, "js_kget", [curScopeV, emitStr(b, caps[ci])])])
                }
            }
            var savedEnv = curScopeV
            curScopeV = env
            var idx = emitFunc(params, bodyStmt, false)
            curScopeV = savedEnv
            return {b: b, v: callExt(b, "js_closure", [handle(idx), env])}
        }
    }

    // ----- Calls: argument labels, default values, variadics and inout -----
    // A call site knows the callee's parameter list whenever the callee was declared
    // earlier in the walk (sigReg, filled by every func/init as it is built), so the
    // arguments a call LEAVES OUT because they are defaulted are filled in here, by
    // matching each argument label against the parameter labels in order. Without a
    // signature the arguments stay positional and the callee's own prologue fills the
    // trailing defaults. Mirrors planArgs/swBindArgs in swift-interpreter.abnf.
    var sigReg = {}
    function regSig(name, params) { sigReg["$" + name] = params }
    function lookupSig(name) { return hasOwn(sigReg, "$" + name) ? sigReg["$" + name] : null }
    function hasOwn(o, n) { return Object.prototype.hasOwnProperty.call(o, n) }

    function makeParam(items) {
        var ids = []
        var type = ""
        var isVar = false
        var isInout = false
        var isAuto = false
        var hasDflt = false
        var dflt = null
        for (var i = 0; i < items.length; i++) {
            var it = items[i]
            if (it.pid != undefined) { ids.push(it.pid) }
            else if (it.ptype != undefined) { type = stripWs(it.ptype) }
            else if (it.pvar != undefined) { isVar = true }
            else if (it.pinout != undefined) { isInout = true }
            else if (it.pdflt != undefined) { hasDflt = true; dflt = it.pdflt }
            else if (it.pattr != undefined && it.pattr == "autoclosure") { isAuto = true }
        }
        var name = ids[ids.length - 1]
        var label = ids.length > 1 ? ids[0] : name
        if (label == "_") { label = "" }
        return {name: name, label: label, type: type, variadic: isVar, auto: isAuto,
                inout: isInout, hasDefault: hasDflt, dflt: dflt}
    }
    function pName(p) { return (typeof p == "string") ? p : p.name }
    function makeCallArg(items) {
        var lbl = null
        var t = null
        var ref = null
        for (var i = 0; i < items.length; i++) {
            var it = items[i]
            if (typeof it == "function") { t = it }
            else if (it.alabel != undefined) { lbl = it.alabel }
            else if (it.aref != undefined) { ref = it.aref }
        }
        return {lbl: lbl, t: t, ref: ref, dflt: null}
    }
    function makeTrailArg(t) { return {lbl: null, t: t, ref: null, dflt: null} }
    function makeLabTrail(items) { return {lbl: items[0].alabel, t: items[1], ref: null, dflt: null} }

    function planArgs(name, recs) {
        var params = lookupSig(name)
        if (params == null) { return recs }
        var out = []
        var ai = 0
        for (var p = 0; p < params.length; p++) {
            var prm = params[p]
            if (prm.variadic) { break }
            var take = false
            if (ai < recs.length) {
                var l = recs[ai].lbl
                take = (l == null || l == "" || l == prm.label)
            }
            if (take) {
                var rec = recs[ai]
                if (prm.auto && rec.t != null) { rec = {lbl: rec.lbl, t: autoWrap(rec.t), ref: null, dflt: null} }
                out.push(rec)
                ai++
            }
            else if (prm.hasDefault) { out.push({lbl: null, t: null, ref: null, dflt: prm.dflt}) }
        }
        while (ai < recs.length) { out.push(recs[ai]); ai++ }
        return out
    }
    // Emits the argument array. An &x argument becomes a one-slot box the callee
    // writes back into; emitWriteBacks copies the boxes home after the call.
    function emitArgRecs(b, recs) { return emitArgRecsInto(b, recs, null) }
    function emitArgRecsInto(b, recs, into) {
        var arr = (into == null) ? callExt(b, "js_arr_new", []) : into
        var boxes = []
        for (var i = 0; i < recs.length; i++) {
            var v
            if (recs[i].ref != null) {
                var box = callExt(b, "js_obj_new", [])
                callExt(b, "js_set", [box, emitStr(b, "__ref"), emitNum(b, 1)])
                callExt(b, "js_set", [box, emitStr(b, "v"),
                                      callExt(b, "js_kget", [curScopeV, emitStr(b, recs[i].ref)])])
                v = box
                boxes.push({name: recs[i].ref, box: box})
            } else if (recs[i].dflt != null) {
                var rd = recs[i].dflt(b)
                b = rd.b
                v = rd.v
            } else {
                var r = recs[i].t(b)
                b = r.b
                v = r.v
            }
            callExt(b, "js_arr_push", [arr, v])
        }
        return {b: b, v: arr, boxes: boxes}
    }
    function emitWriteBacks(b, boxes) {
        for (var i = 0; i < boxes.length; i++) {
            callExt(b, "js_kset", [curScopeV, emitStr(b, boxes[i].name),
                                   callExt(b, "js_get", [boxes[i].box, emitStr(b, "v")])])
        }
    }

    // f(args): a struct/class constructor (known at compile time) or a function value.
    // Emits a construction: __ctor lays down the default property values (the
    // superclass's first), then the initializer runs. Which initializer is decided
    // HERE, where the argument labels and count are known - overloads are stored under
    // init, init$1, ... A failable initializer that returned nil makes the whole
    // construction nil.
    function emitConstruct(b, tname, clsV, args) {
        var rec = typeRec(tname)
        var objV = callExt(b, "js_obj_new", [])
        callExt(b, "js_set", [objV, emitStr(b, "__class"), clsV])
        var ctorArgs = callExt(b, "js_arr_new", [])
        callExt(b, "js_arr_push", [ctorArgs, objV])
        callExt(b, "js_call", [callExt(b, "js_get", [clsV, emitStr(b, "__ctor")]), hUndef, ctorArgs])
        var initArgs = callExt(b, "js_arr_new", [])
        callExt(b, "js_arr_push", [initArgs, objV])
        var eai = emitArgRecsInto(b, args, initArgs)
        b = eai.b
        var key = pickOverload("init", rec.inits, args)
        var initV = callExt(b, "js_get", [clsV, emitStr(b, key)])
        var iret = callExt(b, "js_call", [initV, hUndef, initArgs])
        emitWriteBacks(b, eai.boxes)
        var nilB = curF.NewBlock("")
        var okB = curF.NewBlock("")
        var joinB = curF.NewBlock("")
        b.NewCondBr(truthy(b, callExt(b, "js_seq", [iret, hNull])), nilB, okB)
        nilB.NewBr(joinB)
        okB.NewBr(joinB)
        return {b: joinB, v: joinB.NewPhi([llvm.ir.NewIncoming(hNull, nilB), llvm.ir.NewIncoming(objV, okB)])}
    }
    function makeCall(items) {
        var name = items[0]
        var args = planArgs(name, items.slice(1))
        return function(b) {
            // E(rawValue: r): the failable initializer every raw-value enum gets free.
            if (enumNames[name] == 1) {
                var eV = callExt(b, "js_kget", [curScopeV, emitStr(b, name)])
                var ear = emitArgRecs(b, args)
                b = ear.b
                return {b: b, v: b.NewCall(rtRawCase(), [eV, callExt(b, "js_pyget", [ear.v, emitNum(b, 0)])])}
            }
            if (classNames[name] == 1) {
                var clsV = callExt(b, "js_kget", [curScopeV, emitStr(b, name)])
                return emitConstruct(b, name, clsV, args)
            }
            var ea = emitArgRecs(b, args)
            b = ea.b
            // An unqualified call inside a member body may name a METHOD of the
            // enclosing type, which lives on the type descriptor rather than in the
            // scope chain. Only names some type declares as a method take the probe.
            if (isMemberMethod(name)) {
                var tv = callExt(b, "js_scope_typeof", [curScopeV, emitStr(b, name)])
                var localB = curF.NewBlock("")
                var selfB = curF.NewBlock("")
                var joinB = curF.NewBlock("")
                b.NewCondBr(truthy(b, callExt(b, "js_seq", [tv, emitStr(b, "undefined")])), selfB, localB)
                var lv = callExt(localB, "js_call", [callExt(localB, "js_kget", [curScopeV, emitStr(localB, name)]), hUndef, ea.v])
                localB.NewBr(joinB)
                var sv = callExt(selfB, "js_mcall", [callExt(selfB, "js_kget", [curScopeV, emitStr(selfB, "self")]),
                                                    emitStr(selfB, name), ea.v])
                selfB.NewBr(joinB)
                emitWriteBacks(joinB, ea.boxes)
                return {b: joinB, v: joinB.NewPhi([llvm.ir.NewIncoming(lv, localB), llvm.ir.NewIncoming(sv, selfB)])}
            }
            var fV = callExt(b, "js_kget", [curScopeV, emitStr(b, name)])
            var rv = callExt(b, "js_call", [fV, hUndef, ea.v])
            emitWriteBacks(b, ea.boxes)
            return {b: b, v: rv}
        }
    }

    // Assignment: a plain name goes through js_kget/js_kset (locals, then the
    // properties of self); a .field path targets js_get/js_set; an [i] path
    // targets js_pyget/js_pyset (arrays and dictionaries).
    function emitRefPath(b, ref) {
        var o = callExt(b, "js_kget", [curScopeV, emitStr(b, ref.name)])
        for (var i = 0; i < ref.path.length - 1; i++) {
            var s = ref.path[i]
            if (s.key != undefined) { o = emitFieldRead(b, o, s.key) }
            else { var ri = s.idx(b); b = ri.b; o = emitIndexRead(b, o, ri.v) }
        }
        var last = ref.path[ref.path.length - 1]
        if (last.key != undefined) { return {b: b, obj: o, key: emitStr(b, last.key), keyName: last.key, isField: true} }
        var kr = last.idx(b)
        return {b: kr.b, obj: o, key: kr.v, keyName: "", isField: false}
    }
    function makeAssign(items) {
        var ref = items[0]
        var op = items[1]
        var valT = items[2]
        return function(b) {
            var r = valT(b)
            b = r.b
            var v = emitCopy(b, r.v)
            if (ref.path.length == 0) {
                // `_ = expr` evaluates and throws the value away.
                if (ref.name == "_") { return {b: b, v: v} }
                var nameV = emitStr(b, ref.name)
                if (op != "=") {
                    var old = callExt(b, "js_kget", [curScopeV, nameV])
                    v = emitBin(b, op, old, v)
                }
                if (ref.name == "self" && hasStructs) {
                    b.NewCall(rtAssignSelf(), [callExt(b, "js_kget", [curScopeV, emitStr(b, "this")]), v])
                    return {b: b, v: v}
                }
                callExt(b, "js_kset", [curScopeV, nameV, v])
            } else {
                var p = emitRefPath(b, ref)
                b = p.b
                if (p.isField) {
                    if (op != "=") {
                        var oldf = emitFieldRead(b, p.obj, p.keyName)
                        v = emitBin(b, op, oldf, v)
                    }
                    if (isSetterName(p.keyName)) {
                        b.NewCall(rtSetProp(), [p.obj, p.key, v])
                    } else {
                        callExt(b, "js_set", [p.obj, p.key, v])
                    }
                } else if (hasSubscript) {
                    if (op != "=") {
                        var olds = b.NewCall(rtSubGet(), [p.obj, p.key])
                        v = emitBin(b, op, olds, v)
                    }
                    b.NewCall(rtSubSet(), [p.obj, p.key, v])
                } else {
                    if (op != "=") {
                        var oldm = callExt(b, "js_pyget", [p.obj, p.key])
                        v = emitBin(b, op, oldm, v)
                    }
                    callExt(b, "js_pyset", [p.obj, p.key, v])
                }
            }
            return {b: b, v: v}
        }
    }

    // items = [{s: chunk} | {e: thunk}...] -> js_jadd fold starting from "".
    function makeTemplate(items) {
        return function(b) {
            var v = emitStr(b, "")
            for (var i = 0; i < items.length; i++) {
                var pv
                if (items[i].s != undefined) { pv = emitStr(b, items[i].s) }
                else {
                    var r = items[i].e(b)
                    b = r.b
                    pv = r.v
                }
                v = callExt(b, "js_jadd", [v, pv])
            }
            return {b: b, v: v}
        }
    }

    // ----- Statement thunks: function(block) -> block -----

    // items = [name, {tlabels}?, initThunk]
    function makeDecl(items) {
        var name = items[0]
        var labels = null
        var k = 1
        if (items[k] != undefined && items[k].tlabels != undefined) { labels = items[k].tlabels; k++ }
        var init = items[k]
        // `let v: Int` with no initializer declares the name as nil; the value
        // arrives by a later assignment (Swift's definite-initialization rule is
        // a type-checker job, and this front end does not enforce it).
        if (init == undefined) {
            return function(b) {
                callExt(b, "js_scope_decl", [curScopeV, emitStr(b, name), hNull])
                return b
            }
        }
        return function(b) {
            var r = init(b)
            b = r.b
            var v = emitCopy(b, r.v)
            if (labels != null) { v = emitRelabel(b, v, labels) }
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, name), v])
            return b
        }
    }
    // items = [{lbl}?, condT, bodyT]
    function makeWhileL(items) {
        var lbl = itemLbl(items)
        var rest = itemsAfterLbl(items)
        var condT = rest[0]
        var bodyT = rest[1]
        return function(b) {
            var headB = curF.NewBlock("")
            var bodyB = curF.NewBlock("")
            var exitB = curF.NewBlock("")
            b.NewBr(headB)
            var r = condT(headB)
            r.b.NewCondBr(truthy(r.b, r.v), bodyB, exitB)
            loopStack.push({cont: headB, brk: exitB, lbl: lbl})
            bodyT(bodyB).NewBr(headB)
            loopStack.pop()
            return exitB
        }
    }
    // items = [{lbl}?, bodyT, condT] - repeat { ... } while COND
    function makeRepeat(items) {
        var lbl = itemLbl(items)
        var rest = itemsAfterLbl(items)
        var bodyT = rest[0]
        var condT = rest[1]
        return function(b) {
            var bodyB = curF.NewBlock("")
            var condB = curF.NewBlock("")
            var exitB = curF.NewBlock("")
            b.NewBr(bodyB)
            loopStack.push({cont: condB, brk: exitB, lbl: lbl})
            bodyT(bodyB).NewBr(condB)
            loopStack.pop()
            var r = condT(condB)
            r.b.NewCondBr(truthy(r.b, r.v), bodyB, exitB)
            return exitB
        }
    }
    // items = [{lbl}?, pat, fromT, {rop}, toT, {fwhere}?, bodyT]. ..< subtracts one.
    function makeForRange(items) {
        var lbl = itemLbl(items)
        var rest = itemsAfterLbl(items)
        var pat = rest[0]
        var fromT = rest[1]
        var rop = rest[2].rop
        var toT = rest[3]
        var k = 4
        var whereT = null
        if (rest[k] != undefined && rest[k].fwhere != undefined) { whereT = rest[k].fwhere; k++ }
        var bodyT = rest[k]
        var name = (pat.fname != undefined) ? pat.fname : "$_"
        return function(b) {
            hidCount++
            var tName = "$to" + hidCount
            var saved = curScopeV
            curScopeV = callExt(b, "js_scope_new", [curScopeV])
            var rf = fromT(b)
            b = rf.b
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, name), rf.v])
            var rt = toT(b)
            b = rt.b
            var boundV = rt.v
            if (rop == "..<") { boundV = callExt(b, "js_sub", [boundV, emitNum(b, 1)]) }
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, tName), boundV])
            var headB = curF.NewBlock("")
            var bodyB = curF.NewBlock("")
            var postB = curF.NewBlock("")
            var exitB = curF.NewBlock("")
            b.NewBr(headB)
            var iV = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, name)])
            var tV = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, tName)])
            headB.NewCondBr(truthy(headB, callExt(headB, "js_le", [iV, tV])), bodyB, exitB)
            loopStack.push({cont: postB, brk: exitB, lbl: lbl})
            var innerB = bodyB
            if (whereT != null) {
                var rw = whereT(innerB)
                var runB = curF.NewBlock("")
                rw.b.NewCondBr(truthy(rw.b, rw.v), runB, postB)
                innerB = runB
            }
            bodyT(innerB).NewBr(postB)
            loopStack.pop()
            var iV2 = callExt(postB, "js_scope_get", [curScopeV, emitStr(postB, name)])
            callExt(postB, "js_scope_set", [curScopeV, emitStr(postB, name), callExt(postB, "js_jadd", [iV2, emitNum(postB, 1)])])
            postB.NewBr(headB)
            curScopeV = saved
            return exitB
        }
    }
    // items = [{lbl}?, pat, listT, {fwhere}?, bodyT]. The sequence walked by index is
    // the array itself, or - for a dictionary - its key array (js_keys); a tuple
    // pattern over a dictionary binds (key, value), like the interpreter.
    function makeForList(items) {
        var lbl = itemLbl(items)
        var rest = itemsAfterLbl(items)
        var pat = rest[0]
        var listT = rest[1]
        var k = 2
        var whereT = null
        if (rest[k] != undefined && rest[k].fwhere != undefined) { whereT = rest[k].fwhere; k++ }
        var bodyT = rest[k]
        var wantPair = pat.tnames != undefined
        return function(b) {
            hidCount++
            var iName = "$i" + hidCount
            var aName = "$a" + hidCount
            var sName = "$s" + hidCount
            var saved = curScopeV
            curScopeV = callExt(b, "js_scope_new", [curScopeV])
            var r = listT(b)
            b = r.b
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, aName), r.v])
            // The indexable sequence: the value itself for an array or a string, its
            // key array for a dictionary.
            var rd = emitIsDict(b, r.v)
            b = rd.b
            var arrB = curF.NewBlock("")
            var dictB = curF.NewBlock("")
            var seqB = curF.NewBlock("")
            b.NewCondBr(truthy(b, rd.v), dictB, arrB)
            arrB.NewBr(seqB)
            var keysV = callExt(dictB, "js_keys", [r.v])
            dictB.NewBr(seqB)
            var seqV = seqB.NewPhi([llvm.ir.NewIncoming(r.v, arrB), llvm.ir.NewIncoming(keysV, dictB)])
            b = seqB
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, sName), seqV])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, iName), emitNum(b, 0)])
            var headB = curF.NewBlock("")
            var bodyB = curF.NewBlock("")
            var postB = curF.NewBlock("")
            var exitB = curF.NewBlock("")
            b.NewBr(headB)
            var iV = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, iName)])
            var sV = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, sName)])
            var lenV = callExt(headB, "js_pylen", [sV])
            headB.NewCondBr(truthy(headB, callExt(headB, "js_lt", [iV, lenV])), bodyB, exitB)
            var iV2 = callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, iName)])
            var sV2 = callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, sName)])
            var aV2 = callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, aName)])
            var rawV = callExt(bodyB, "js_pyget", [sV2, iV2])
            var elV = rawV
            if (wantPair) {
                // A tuple pattern over a dictionary iterates (key, value) pairs; over an
                // array the element already IS the tuple.
                var rd2 = emitIsDict(bodyB, aV2)
                bodyB = rd2.b
                var pArrB = curF.NewBlock("")
                var pDictB = curF.NewBlock("")
                var pJoinB = curF.NewBlock("")
                bodyB.NewCondBr(truthy(bodyB, rd2.v), pDictB, pArrB)
                pArrB.NewBr(pJoinB)
                var pairV = callExt(pDictB, "js_obj_new", [])
                callExt(pDictB, "js_set", [pairV, emitStr(pDictB, "__tuple"), emitNum(pDictB, 2)])
                callExt(pDictB, "js_set", [pairV, emitStr(pDictB, "0"), rawV])
                callExt(pDictB, "js_set", [pairV, emitStr(pDictB, "1"), callExt(pDictB, "js_pyget", [aV2, rawV])])
                pDictB.NewBr(pJoinB)
                elV = pJoinB.NewPhi([llvm.ir.NewIncoming(rawV, pArrB), llvm.ir.NewIncoming(pairV, pDictB)])
                bodyB = pJoinB
            }
            emitBindForPat(bodyB, pat, elV)
            loopStack.push({cont: postB, brk: exitB, lbl: lbl})
            var innerB = bodyB
            if (whereT != null) {
                var rw2 = whereT(innerB)
                var runB2 = curF.NewBlock("")
                rw2.b.NewCondBr(truthy(rw2.b, rw2.v), runB2, postB)
                innerB = runB2
            }
            bodyT(innerB).NewBr(postB)
            loopStack.pop()
            var iV3 = callExt(postB, "js_scope_get", [curScopeV, emitStr(postB, iName)])
            callExt(postB, "js_scope_set", [curScopeV, emitStr(postB, iName), callExt(postB, "js_jadd", [iV3, emitNum(postB, 1)])])
            postB.NewBr(headB)
            curScopeV = saved
            return exitB
        }
    }
    function makeReturn(items) {
        var t = items.length > 0 ? items[0] : null
        return function(b) {
            var v = hUndef
            if (t != null) {
                var r = t(b)
                b = r.b
                v = retLabelled(b, r.v)
            }
            emitInoutBacks(b)
            return retStmt(b, v) // plain ret, or a control signal when leaving a try body
        }
    }

    // guard COND else BLOCK: a true condition jumps to the continuation, a false one
    // into the else block; the else normally diverges (its trailing branch is dead).
    function makeGuard(items) {
        var condT = items[0]
        var elseT = items[1]
        return function(b) {
            var r = condT(b)
            b = r.b
            var elseB = curF.NewBlock("")
            var contB = curF.NewBlock("")
            b.NewCondBr(truthy(b, r.v), contB, elseB)
            elseT(elseB).NewBr(contB)
            return contB
        }
    }

    // A case label carries its value thunks (empty for default).
    // A case label carries its patterns and its optional where guard (no patterns
    // at all means `default`).
    function makeCaseLabel(items) {
        var pats = []
        var whereT = null
        for (var i = 0; i < items.length; i++) {
            var it = items[i]
            if (it == undefined) { continue }
            if (it.cpat != undefined) { pats.push(it.cpat) }
            else if (it.cwhere != undefined) { whereT = it.cwhere }
        }
        return {isLabel: true, isDefault: pats.length == 0, pats: pats, whereT: whereT}
    }
    // fallthrough: a branch straight into the NEXT case's body block, which the switch
    // emitter publishes on fallStack while it emits each body.
    var fallStack = []
    function makeFallthrough() {
        return function(b) {
            if (fallStack.length > 0) { b.NewBr(fallStack[fallStack.length - 1]) }
            return deadBlock()
        }
    }
    // items = [{subj}, label or statement thunk...]: the flat item list is regrouped
    // (every statement belongs to the last label). The dispatch compares (js_seq) the
    // subject to each case value in source order; every body branches to the exit (no
    // fallthrough), a break inside a case leaves the switch, continue reaches the loop.
    function makeSwitch(items) {
        var subj = null
        var cases = []
        var cur = null
        var swLbl = itemLbl(items)
        for (var i = 0; i < items.length; i++) {
            var it = items[i]
            if (typeof it == "function") {
                if (cur != null) { cur.body.push(it) }
            } else if (it.lbl != undefined) {
                continue
            } else if (it.subj != undefined) {
                subj = it.subj
            } else if (it.isLabel != undefined) {
                cur = {isDefault: it.isDefault, pats: it.pats, whereT: it.whereT, body: []}
                cases.push(cur)
            }
        }
        return function(b) {
            var savedScope = curScopeV
            // The bindings a matched pattern declares are live in the body, so the
            // test chain and the bodies share one child scope.
            curScopeV = callExt(b, "js_scope_new", [curScopeV])
            var subjV = hUndef
            if (subj != null) {
                var rs = subj(b)
                b = rs.b
                subjV = rs.v
            }
            var exitB = curF.NewBlock("")
            var bodyBs = []
            var dfltB = exitB
            for (var i = 0; i < cases.length; i++) {
                bodyBs.push(curF.NewBlock(""))
                if (cases[i].isDefault && dfltB == exitB) { dfltB = bodyBs[i] }
            }
            for (var i = 0; i < cases.length; i++) {
                if (cases[i].isDefault) { continue }
                for (var p = 0; p < cases[i].pats.length; p++) {
                    var nextB = curF.NewBlock("")
                    var okB = emitMatchPat(b, cases[i].pats[p], subjV, false, nextB)
                    if (cases[i].whereT != null) {
                        var rw = cases[i].whereT(okB)
                        rw.b.NewCondBr(truthy(rw.b, rw.v), bodyBs[i], nextB)
                    } else {
                        okB.NewBr(bodyBs[i])
                    }
                    b = nextB
                }
            }
            b.NewBr(dfltB)
            var outerCont = loopStack.length > 0 ? loopStack[loopStack.length - 1].cont : null
            loopStack.push({cont: outerCont, brk: exitB, lbl: swLbl})
            for (var i = 0; i < cases.length; i++) {
                fallStack.push(i + 1 < cases.length ? bodyBs[i + 1] : exitB)
                var bb = bodyBs[i]
                var body = cases[i].body
                for (var j = 0; j < body.length; j++) { bb = body[j](bb) }
                bb.NewBr(exitB)
                fallStack.pop()
            }
            loopStack.pop()
            curScopeV = savedScope
            return exitB
        }
    }

    // ----- Functions, methods and classes -----

    function paramName(items) { return items[items.length - 1] }

    // Every user function/method/init/closure becomes jsf_N(env, args). Instance
    // functions bind arg 0 to both this and self so implicit property access works.
    // isCtl marks a try/catch body closure: a return/break/continue leaving it emits a
    // control signal instead of a ret/br (see compile-core inCtlBody / excDispatch).
    function emitFunc(params, body, isInstance, isCtl, rlabels) {
        funcCount++
        var idx = funcCount
        var f = m.NewFunc("jsf_" + idx, i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var savedF = curF
        var savedScope = curScopeV
        var savedLoops = loopStack
        var savedTag = curFTag
        curF = f
        curFTag = idx
        loopStack = []
        if (isCtl) { ctlEnter(idx) }
        retLabelStack.push(rlabels == undefined ? null : rlabels)
        var b = f.NewBlock("entry")
        curScopeV = callExt(b, "js_scope_new", [f.Params[0]])
        var off = 0
        if (isInstance) {
            var thisV = callExt(b, "js_arg", [f.Params[1], handle(0)])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "this"), thisV])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "self"), thisV])
            off = 1
        }
        // The parameter prologue. A plain closure parameter is a bare name; a
        // function/method parameter is a record that may be variadic, have a default
        // value or be inout (its argument is a one-slot box written back on the way
        // out - see emitInoutBacks, emitted before every ret).
        var inouts = []
        var nargsV = callExt(b, "js_pylen", [f.Params[1]])
        for (var i = 0; i < params.length; i++) {
            var prm = params[i]
            if (typeof prm == "string") {
                callExt(b, "js_scope_decl", [curScopeV, emitStr(b, prm),
                                             callExt(b, "js_arg", [f.Params[1], handle(i + off)])])
                continue
            }
            if (prm.variadic) {
                // Collect the remaining arguments into an array.
                var vArr = callExt(b, "js_arr_new", [])
                var vName = "$va" + i
                callExt(b, "js_scope_decl", [curScopeV, emitStr(b, vName), emitNum(b, i + off)])
                var vHead = curF.NewBlock("")
                var vBody = curF.NewBlock("")
                var vExit = curF.NewBlock("")
                b.NewBr(vHead)
                var vi = callExt(vHead, "js_scope_get", [curScopeV, emitStr(vHead, vName)])
                vHead.NewCondBr(truthy(vHead, callExt(vHead, "js_lt", [vi, nargsV])), vBody, vExit)
                var vi2 = callExt(vBody, "js_scope_get", [curScopeV, emitStr(vBody, vName)])
                callExt(vBody, "js_arr_push", [vArr, callExt(vBody, "js_kindex", [f.Params[1], vi2])])
                callExt(vBody, "js_scope_set", [curScopeV, emitStr(vBody, vName),
                                                callExt(vBody, "js_jadd", [vi2, emitNum(vBody, 1)])])
                vBody.NewBr(vHead)
                b = vExit
                callExt(b, "js_scope_decl", [curScopeV, emitStr(b, prm.name), vArr])
                continue
            }
            var av = callExt(b, "js_arg", [f.Params[1], handle(i + off)])
            if (prm.hasDefault) {
                // The argument may be missing: fall back to the default expression.
                var dB = curF.NewBlock("")
                var jB = curF.NewBlock("")
                var haveB = b
                b.NewCondBr(truthy(b, callExt(b, "js_le", [nargsV, emitNum(b, i + off)])), dB, jB)
                var rd = prm.dflt(dB)
                rd.b.NewBr(jB)
                var phi = jB.NewPhi([llvm.ir.NewIncoming(av, haveB), llvm.ir.NewIncoming(rd.v, rd.b)])
                b = jB
                av = phi
            }
            if (prm.inout) {
                callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "$box$" + prm.name), av])
