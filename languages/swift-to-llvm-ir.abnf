    makeBlockStmt = function(items) {
        var seq = swSeqWithDefers(items)
        return function(b) {
            var saved = curScopeV
            curScopeV = callExt(b, "js_scope_new", [curScopeV])
            b = seq(b)
            curScopeV = saved
            return b
        }
    }
