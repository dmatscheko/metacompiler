    // ----- Types -----
    // A type descriptor is an object carrying its name, its members and (for a class)
    // __super, which js_mcall and js_get already walk. A struct additionally carries
    // __struct and __fields, which is what sw_copy uses to give it value semantics.
    // Overloaded members (two inits, two subscripts of different arity) are stored
    // under name, name$1, name$2 ... and picked at the CALL SITE, where the argument
    // labels and count are known statically.
    //
    // typeInfo is keyed by the type's QUALIFIED PATH, not by its bare name:
    // `struct A { struct Inner {...} }` registers `A.Inner`, so a second
    // `struct B { struct Inner {...} }` gets a record of its own (a shared record
    // would put the second Inner's memberwise `init` on a slot nothing looks up).
    //
    // A nested declaration is walked BEFORE its enclosing one (the tag actions
    // reduce bottom-up), so a record is registered under its bare name and then
    // RE-KEYED by the parent, restoring whatever the bare key held. Everything that
    // reads a record therefore goes through typeAt/typeKeyOf rather than indexing
    // typeInfo directly, and a stale bare entry is recognised by `rec.key != k`.
    // A nested type is declared into the surrounding scope under its QUALIFIED KEY
    // ONLY, never under its bare name, and that key is what `Outer.Inner`,
    // `extension A.Inner` and a bare `Inner` inside Outer are resolved through.
    // A bare binding would let `struct A { struct Inner {...} }` clobber a top-level
    // `struct Inner` at file scope.
    //
    // Swift's rule is lexical, and both halves implement it as such: a nested
    // type is NOT in the surrounding scope at all, it is a member of its enclosing
    // type, reached STATICALLY here (typeKeyOf walks typeStack outward) and at RUN
    // time in the interpreter (swLookupType walks curOwner()'s `__outer` chain).
    var typeInfo = {}
    var typeUid = 0
    var deadRec = {inits: [], superName: null, meths: {}, key: "", bname: "", kids: [], prev: null, uid: -1, adopted: 1, kind: ""}
    // The record at this exact key, or null. A record whose own `key` has moved on
    // is a stale bare entry left behind by a re-key.
    function typeAt(k) {
        if (!hasOwn(typeInfo, "$" + k)) { return null }
        var r = typeInfo["$" + k]
        return r.key == k ? r : null
    }
    function typeRec(k) {
        var r = typeAt(k)
        if (r != null) { return r }
        typeUid = typeUid + 1
        typeInfo["$" + k] = {inits: [], superName: null, meths: {}, key: k, bname: k, kids: [], prev: null, uid: typeUid, adopted: 0, kind: ""}
        return typeInfo["$" + k]
    }
    // The record a type DECLARATION owns. Always fresh, so two same-named types never
    // share one, and it remembers what sat at its bare key so a re-key can put it back.
    function newTypeRec(name) {
        var prev = hasOwn(typeInfo, "$" + name) ? typeInfo["$" + name] : null
        typeUid = typeUid + 1
        var r = {inits: [], superName: null, meths: {}, key: name, bname: name, kids: [], prev: prev, uid: typeUid, adopted: 0, kind: ""}
        typeInfo["$" + name] = r
        return r
    }
