            typeStack.push({name: name, superName: null})
            var eV = callExt(b, "js_obj_new", [])
            callExt(b, "js_set", [eV, emitStr(b, "__isenum"), hTrue])
            callExt(b, "js_set", [eV, emitStr(b, "__enum"), hTrue])
            callExt(b, "js_set", [eV, emitStr(b, "__name"), emitStr(b, name)])
            var tblV = callExt(b, "js_obj_new", [])
            callExt(b, "js_set", [tblV, emitStr(b, "__name"), emitStr(b, name)])
            callExt(b, "js_set", [eV, emitStr(b, "__members"), tblV])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, name), eV])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "$etbl$" + name), tblV])
