// carries `opt`: a nil there skips the whole assignment, right-hand side included.
TOpt        = NoSpace "?" NotChar63 ( "." Id <~~ push({key: swBt(up.in), opt: true}) ~~> | TOptIdx ) ;
TOptIdx     <~~ var ia = takeAll(); push({idx: makeIndexKey(swIdxKeys(ia)), dflt: swIdxDfltOf(ia), opt: true}) ~~>
            = "[" IndexArg { "," IndexArg } "]" ;
TTupIdx     <~~ push({key: up.in}) ~~> = "0"..."9" { "0"..."9" } ;
TShort      <~~ push("$" + up.in) ~~> = "0"..."9" { "0"..."9" } ;
TForce      = NoSpace "!" NotChar61 ;
TIndex      <~~ var ia = takeAll(); push({idx: makeIndexKey(swIdxKeys(ia)), dflt: swIdxDfltOf(ia)}) ~~>
            = "[" IndexArg { "," IndexArg } "]" ;

Ternary     <~~ push(makeTernary(takeAll(), up.in)) ~~>
            = OrExpr [ "?" Expression <~~ push({ltxt: up.in}) ~~> ":" Ternary <~~ push({ltxt: up.in}) ~~> ] ;
OrExpr      <~~ push(makeOrAnd(takeAll(), true)) ~~>
            = AndExpr { "||" AndExpr } ;
AndExpr     <~~ push(makeOrAnd(takeAll(), false)) ~~>
            = EqExpr { "&&" EqExpr } ;
// === / !== compare object identity; the three-character forms are listed first
// so `a === b` is not read as `a == (= b)`.
EqExpr      <~~ var eqi = takeAll(); if (eqi.length > 1) { swDsNoteEq(up.start, up.pos) }; push(foldBinary(eqi)) ~~>
            = RelExpr { ( "===" | "!==" | "==" | "!=" | "~=" ) <~~ push(stripWs(up.in)) ~~> RelExpr } ;
RelExpr     <~~ push(foldBinary(takeAll())) ~~>
            = Coalesce { ( "<=" | ">=" | "<" | ">" ) <~~ push(up.in) ~~> Coalesce } ;
// a ?? b yields a unless it is nil (the nil-coalescing operator; b only runs then).
// Swift's precedence order, tightest first, is range formation, casting, nil
// coalescing, comparison: `x as? Double ?? -1` is `(x as? Double) ?? -1`.
Coalesce    <~~ push(makeCoalesce(takeAll())) ~~>
            = Cast <~~ push({at: up.pos, ltxt: up.in}) ~~> { "??" Cast } ;
// e as T / e as? T / e as! T / e is T. With no cast operator it is a pure
// pass-through (a single item).
Cast        <~~ push(makeCast(takeAll(), up.pos, up.in)) ~~>
            = RangeExpr { CastOp CastType } ;
// a...b / a..<b as a VALUE (Swift's RangeFormationPrecedence sits here): the
// pattern-match operator ~= tests it, and a for-in can walk it.
// The upper bound is OPTIONAL so that `a[1...]` - a PartialRangeFrom - parses.
// PEG never re-enters
// a rule that already succeeded, so `a[0...1]` cannot be recovered by ordering two
// alternatives: the optional bound has to live in RangeExpr itself, where the
// greedy AddExpr still takes `1` first and only a genuinely absent bound falls
// through. The DOWN form (`a[...1]`) is IndexArg's own alternative, which is safe
// unordered because no expression can begin with `...` or `..<`.
RangeExpr   <~~ push(makeRange(takeAll())) ~~>
            = RangeOp AddExpr | AddExpr [ RangeOp [ AddExpr ] ] ;
CastOp      <~~ push({cast: stripWs(up.in)}) ~~>
            = ( "as" KwEnd [ "?" | "!" ] | "is" KwEnd ) ;
CastType    <~~ push({ctype: stripWs(up.in)}) ~~> = Type ;
// The overflow operators (&+ &- &*) are listed before the plain ones, and | and &
// are spelled with a guard so they cannot start on the first character of || / &&
// or of an overflow operator. | and ^ carry Swift's AdditionPrecedence, & its
// MultiplicationPrecedence and the shifts their own, higher, level.
AddExpr     <~~ push(swFoldAdd(takeAll(), up.start, up.pos)) ~~>
            = MulExpr { ( "&+" | "&-" | "+" | "-" | BitOr | "^" ) <~~ push(stripWs(up.in)) ~~> MulExpr } ;
MulExpr     <~~ push(foldBinary(takeAll())) ~~>
            = ShiftExpr { ( "&*" | "*" | "/" | "%" | BitAnd ) <~~ push(stripWs(up.in)) ~~> ShiftExpr } ;
ShiftExpr   <~~ push(foldBinary(takeAll())) ~~>
            = CustomBin { ( "<<" | ">>" ) <~~ push(stripWs(up.in)) ~~> CustomBin } ;
BitOr       = "|" NotChar124 ;
BitAnd      = "&" NotAmpOp ;
NotChar124  = :script(~~
    (function() { return (c.peek(0) === 124) ? abnf.newToken("\x01or-follows", 0) : undefined })()
~~) ;
// Rejects the first character of && and of the overflow operators &+ &- &*.
NotAmpOp    = :script(~~
    (function() {
        var ch = c.peek(0)
        return (ch === 38 || ch === 43 || ch === 45 || ch === 42)
            ? abnf.newToken("\x01amp-op-follows", 0) : undefined
    })()
~~) ;
// A chain of USER-DEFINED infix operators, folded by their declared precedence
// groups and associativity. Everything at this level binds tighter than * and /,
// which is where a custom operator declared higherThan: MultiplicationPrecedence
// belongs; operators of other groups keep their order among THEMSELVES.
// An operand that is a bare name is noted ({oname}): an inout parameter of the
// operator function takes it by reference (swOpRecs).
CustomBin   <~~ push(foldCustomOps(takeAll())) ~~>
            = UnaryExpr <~~ swOpndName(up.in) ~~>
              { CustomOp <~~ push({op: stripWs(up.in)}) ~~> UnaryExpr <~~ swOpndName(up.in) ~~> } ;

// CustomPrefix first: Swift lexes an operator by maximal munch, so `---i` is the
// user operator `---`, never three negations.
UnaryExpr   = CustomPrefix | Neg | Not | BitNot | TryExpr | Await | EachExpr | OwnExpr | CallMember ;
// `copy x` / `consume x` (SE-0377 / SE-0366): an explicit copy or end of lifetime,
// which yields the value itself. Both are CONTEXTUAL keywords - `copy(x)` and
