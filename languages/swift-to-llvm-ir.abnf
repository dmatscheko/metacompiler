    // ----- Strings are sequences of extended grapheme clusters -----
    // .count counts CLUSTERS, so an astral emoji is one and a base letter plus its
    // combining mark is one; and == compares by CANONICAL EQUIVALENCE, so the
    // precomposed and the decomposed spelling of a letter are the same string. The
    // decomposition table covers the Latin-1 precomposed letters, which is the range
    // real programs mix; anything outside it compares by code units.
    var nfdBase = "AAAAAA\x00CEEEEIIII\x00NOOOOO\x00\x00UUUUY\x00\x00aaaaaa\x00ceeeeiiii\x00nooooo\x00\x00uuuuy\x00y"
    var nfdMark = [0x300, 0x301, 0x302, 0x303, 0x308, 0x30A, 0, 0x327,
                   0x300, 0x301, 0x302, 0x308, 0x300, 0x301, 0x302, 0x308,
                   0, 0x303, 0x300, 0x301, 0x302, 0x303, 0x308, 0,
                   0, 0x300, 0x301, 0x302, 0x308, 0x301, 0, 0,
                   0x300, 0x301, 0x302, 0x303, 0x308, 0x30A, 0, 0x327,
                   0x300, 0x301, 0x302, 0x308, 0x300, 0x301, 0x302, 0x308,
                   0, 0x303, 0x300, 0x301, 0x302, 0x303, 0x308, 0,
                   0, 0x300, 0x301, 0x302, 0x308, 0x301, 0, 0x308]
    function swNFD(str) {
