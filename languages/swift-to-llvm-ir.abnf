                var haveB = curF.NewBlock("")
                var contB = curF.NewBlock("")
                b.NewCondBr(truthy(b, callExt(b, "js_le", [nargs, emitNum(b, j + off)])), contB, haveB)
                var tv = callExt(haveB, "js_swfits", [callExt(haveB, "js_arg", [argsV, handle(j + off)]),
                                                      emitStr(haveB, P[j].type)])
                haveB.NewCondBr(truthy(haveB, tv), contB, nextB)
