    // Swift string escapes. Like interp-core's unescapeJs plus \u{...}, whose payload
    // is a Unicode SCALAR: above U+FFFF it becomes a surrogate pair.
    function swUnescape(str) {
        var out = ""
        var i = 0
        while (i < str.length) {
            var c1 = str.charCodeAt(i)
            if (c1 != 92) { out += str.charAt(i); i++; continue }
            var e = str.charCodeAt(i + 1)
            if (e == 110) { out += "\n"; i += 2; continue }
            if (e == 116) { out += "\t"; i += 2; continue }
            if (e == 114) { out += "\r"; i += 2; continue }
            if (e == 48) { out += String.fromCharCode(0); i += 2; continue }
            // A backslash before a line break ELIDES it (the multi-line literal's
            // line continuation); both spellings of the break.
            if (e == 10) { i += 2; continue }
            if (e == 13) { i += 2; if (str.charCodeAt(i) == 10) { i++ } ; continue }
            // ... and a backslash followed by trailing spaces/tabs and THEN a line
            // break elides the whole run, which real swift does too.
            if (e == 32 || e == 9) {
                var j3 = i + 1
                while (j3 < str.length && (str.charCodeAt(j3) == 32 || str.charCodeAt(j3) == 9)) { j3++ }
                if (str.charCodeAt(j3) == 10) { i = j3 + 1; continue }
                if (str.charCodeAt(j3) == 13) {
