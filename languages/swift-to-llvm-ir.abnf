    function makeReturn(items) {
        var t = items.length > 0 ? items[0] : null
        return function(b) {
            var v = hUndef
            if (t != null) {
                var r = t(b)
                b = r.b
                v = retLabelled(b, r.v)
            }
            emitInoutBacks(b)
            return retStmt(b, v) // plain ret, or a control signal when leaving a try body
        }
    }

    // guard COND else BLOCK: a true condition jumps to the continuation, a false one
    // into the else block; the else normally diverges (its trailing branch is dead).
    function makeGuard(items) {
        var condT = items[0]
        var elseT = items[1]
        return function(b) {
            var r = condT(b)
            b = r.b
            var elseB = curF.NewBlock("")
            var contB = curF.NewBlock("")
            b.NewCondBr(truthy(b, r.v), contB, elseB)
            elseT(elseB).NewBr(contB)
            return contB
        }
    }

    // A case label carries its value thunks (empty for default).
    // A case label carries its patterns and its optional where guard (no patterns
    // at all means `default`).
    function makeCaseLabel(items) {
        var pats = []
        var whereT = null
        for (var i = 0; i < items.length; i++) {
            var it = items[i]
            if (it == undefined) { continue }
            if (it.cpat != undefined) { pats.push(it.cpat) }
            else if (it.cwhere != undefined) { whereT = it.cwhere }
        }
        return {isLabel: true, isDefault: pats.length == 0, pats: pats, whereT: whereT}
    }
    // fallthrough: a branch straight into the NEXT case's body block, which the switch
    // emitter publishes on fallStack while it emits each body.
    var fallStack = []
    function makeFallthrough() {
        return function(b) {
            if (fallStack.length > 0) { b.NewBr(fallStack[fallStack.length - 1]) }
            return deadBlock()
        }
    }
    // items = [{subj}, label or statement thunk...]: the flat item list is regrouped
    // (every statement belongs to the last label). The dispatch compares (js_seq) the
    // subject to each case value in source order; every body branches to the exit (no
    // fallthrough), a break inside a case leaves the switch, continue reaches the loop.
    function makeSwitch(items) {
        var subj = null
        var cases = []
        var cur = null
        var swLbl = itemLbl(items)
        for (var i = 0; i < items.length; i++) {
            var it = items[i]
            if (typeof it == "function") {
                if (cur != null) { cur.body.push(it) }
            } else if (it.lbl != undefined) {
                continue
            } else if (it.subj != undefined) {
                subj = it.subj
            } else if (it.isLabel != undefined) {
                cur = {isDefault: it.isDefault, pats: it.pats, whereT: it.whereT, body: []}
                cases.push(cur)
            }
        }
        return function(b) {
            var savedScope = curScopeV
            // The bindings a matched pattern declares are live in the body, so the
            // test chain and the bodies share one child scope.
            curScopeV = callExt(b, "js_scope_new", [curScopeV])
            var subjV = hUndef
            if (subj != null) {
                var rs = subj(b)
                b = rs.b
                subjV = rs.v
            }
            var exitB = curF.NewBlock("")
            var bodyBs = []
            var dfltB = exitB
            for (var i = 0; i < cases.length; i++) {
                bodyBs.push(curF.NewBlock(""))
                if (cases[i].isDefault && dfltB == exitB) { dfltB = bodyBs[i] }
            }
            for (var i = 0; i < cases.length; i++) {
                if (cases[i].isDefault) { continue }
                for (var p = 0; p < cases[i].pats.length; p++) {
                    var nextB = curF.NewBlock("")
                    var okB = emitMatchPat(b, cases[i].pats[p], subjV, false, nextB)
                    if (cases[i].whereT != null) {
                        var rw = cases[i].whereT(okB)
                        rw.b.NewCondBr(truthy(rw.b, rw.v), bodyBs[i], nextB)
                    } else {
                        okB.NewBr(bodyBs[i])
                    }
                    b = nextB
                }
            }
            b.NewBr(dfltB)
            var outerCont = loopStack.length > 0 ? loopStack[loopStack.length - 1].cont : null
            loopStack.push({cont: outerCont, brk: exitB, lbl: swLbl})
            for (var i = 0; i < cases.length; i++) {
                fallStack.push(i + 1 < cases.length ? bodyBs[i + 1] : exitB)
                var bb = bodyBs[i]
                var body = cases[i].body
                for (var j = 0; j < body.length; j++) { bb = body[j](bb) }
                bb.NewBr(exitB)
                fallStack.pop()
            }
            loopStack.pop()
            curScopeV = savedScope
            return exitB
        }
    }

    // ----- Functions, methods and classes -----

    function paramName(items) { return items[items.length - 1] }

    // Every user function/method/init/closure becomes jsf_N(env, args). Instance
    // functions bind arg 0 to both this and self so implicit property access works.
    // isCtl marks a try/catch body closure: a return/break/continue leaving it emits a
    // control signal instead of a ret/br (see compile-core inCtlBody / excDispatch).
    function emitFunc(params, body, isInstance, isCtl, rlabels, rtype) {
        funcCount++
        var idx = funcCount
        var f = m.NewFunc("jsf_" + idx, i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var savedF = curF
        var savedScope = curScopeV
        var savedLoops = loopStack
        var savedTag = curFTag
        curF = f
        curFTag = idx
        loopStack = []
        if (isCtl) { ctlEnter(idx) }
        retLabelStack.push(rlabels == undefined ? null : rlabels)
        retTypeStack.push(rtype == undefined || rtype == null ? "" : rtype)
        var b = f.NewBlock("entry")
        curScopeV = callExt(b, "js_scope_new", [f.Params[0]])
        var off = 0
        if (isInstance) {
            var thisV = callExt(b, "js_arg", [f.Params[1], handle(0)])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "this"), thisV])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "self"), thisV])
            off = 1
        }
        // The parameter prologue. A plain closure parameter is a bare name; a
        // function/method parameter is a record that may be variadic, have a default
        // value or be inout (its argument is a one-slot box written back on the way
        // out - see emitInoutBacks, emitted before every ret).
        var inouts = []
        var nargsV = callExt(b, "js_pylen", [f.Params[1]])
        for (var i = 0; i < params.length; i++) {
            var prm = params[i]
            if (typeof prm == "string") {
                callExt(b, "js_scope_decl", [curScopeV, emitStr(b, prm),
                                             callExt(b, "js_arg", [f.Params[1], handle(i + off)])])
                continue
            }
            if (prm.variadic) {
                // Collect the remaining arguments into an array.
                var vArr = callExt(b, "js_arr_new", [])
                var vName = "$va" + i
                callExt(b, "js_scope_decl", [curScopeV, emitStr(b, vName), emitNum(b, i + off)])
                var vHead = curF.NewBlock("")
                var vBody = curF.NewBlock("")
                var vExit = curF.NewBlock("")
                b.NewBr(vHead)
                var vi = callExt(vHead, "js_scope_get", [curScopeV, emitStr(vHead, vName)])
                vHead.NewCondBr(truthy(vHead, callExt(vHead, "js_lt", [vi, nargsV])), vBody, vExit)
                var vi2 = callExt(vBody, "js_scope_get", [curScopeV, emitStr(vBody, vName)])
                callExt(vBody, "js_arr_push", [vArr, callExt(vBody, "js_kindex", [f.Params[1], vi2])])
                callExt(vBody, "js_scope_set", [curScopeV, emitStr(vBody, vName),
                                                callExt(vBody, "js_jadd", [vi2, emitNum(vBody, 1)])])
                vBody.NewBr(vHead)
                b = vExit
                callExt(b, "js_scope_decl", [curScopeV, emitStr(b, prm.name), vArr])
                continue
            }
            var av = callExt(b, "js_arg", [f.Params[1], handle(i + off)])
            if (prm.hasDefault) {
                // The argument may be missing: fall back to the default expression.
                var dB = curF.NewBlock("")
                var jB = curF.NewBlock("")
                var haveB = b
                b.NewCondBr(truthy(b, callExt(b, "js_le", [nargsV, emitNum(b, i + off)])), dB, jB)
                var rd = prm.dflt(dB)
                rd.b.NewBr(jB)
                var phi = jB.NewPhi([llvm.ir.NewIncoming(av, haveB), llvm.ir.NewIncoming(rd.v, rd.b)])
                b = jB
                av = phi
            }
            if (prm.inout) {
                callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "$box$" + prm.name), av])
                av = callExt(b, "js_get", [av, emitStr(b, "v")])
                inouts.push(prm.name)
            }
            // The declared parameter type adopts the argument: `func g(_ x: Double)`
            // called g(3) binds 3.0, so `x / 2` is 1.5 and not the 1 an Int division
            // gave. The memberwise initializer is emitted through here too, which is
            // how `T(a: 3)` fills a `var a: Double` field.
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, prm.name), swEmitAdopt(b, av, prm.adopt)])
        }
        inoutStack.push(inouts)
        var endB = body(b)
        emitInoutBacks(endB)
        endB.NewRet(hUndef)
        inoutStack.pop()
        retLabelStack.pop()
        retTypeStack.pop()
        if (isCtl) { ctlLeave() }
        curF = savedF
        curScopeV = savedScope
        loopStack = savedLoops
        curFTag = savedTag
        return idx
    }
    // The default-property initializer: sets the properties that have a default
    // value on this, before init runs.
    function emitCtor(props, superName, allFields) {
        funcCount++
        var idx = funcCount
        var f = m.NewFunc("jsf_" + idx, i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var savedF = curF
        var savedScope = curScopeV
        var savedLoops = loopStack
        var savedTag = curFTag
        curF = f
        curFTag = idx
        loopStack = []
        var b = f.NewBlock("entry")
        curScopeV = callExt(b, "js_scope_new", [f.Params[0]])
        var thisV = callExt(b, "js_arg", [f.Params[1], handle(0)])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "this"), thisV])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "self"), thisV])
        // The superclass lays its own default property values down first.
        if (superName != undefined && superName != null) {
            var sArgs = callExt(b, "js_arr_new", [])
            callExt(b, "js_arr_push", [sArgs, thisV])
            var sCls = b.NewCall(rtKGet(), [curScopeV, emitStr(b, superName)])
            callExt(b, "js_call", [callExt(b, "js_get", [sCls, emitStr(b, "__ctor")]), hUndef, sArgs])
        }
        for (var f0 = 0; f0 < allFields.length; f0++) {
            callExt(b, "js_set", [thisV, emitStr(b, allFields[f0].store), hNull])
        }
        for (var p = 0; p < props.length; p++) {
            var r = props[p].init(b)
            b = r.b
            callExt(b, "js_set", [thisV, emitStr(b, props[p].store),
                                  swEmitAdopt(b, r.v, props[p].ty)])
        }
        b.NewRet(hUndef)
        curF = savedF
        curScopeV = savedScope
        loopStack = savedLoops
        curFTag = savedTag
        return idx
    }
    // items = [name, {params}, {tlabels}?, bodyThunk]
    // items = [name, {params}, {tlabels}? | {itype}?, bodyThunk]
    function makeFun(items) {
        noteOperatorName(items[0])
        var k = 2
        var labels = null
        var rty = ""
        if (items[k] != undefined && items[k].tlabels != undefined) { labels = items[k].tlabels; k++ }
        else if (items[k] != undefined && items[k].itype != undefined) { rty = items[k].itype; k++ }
        return {name: items[0], params: items[1].params, body: items[k], rlabels: labels, rtype: rty}
    }
    // The inout parameters of the function whose body is currently being emitted:
    // their final values are copied back into their caller's boxes before every ret.
    var inoutStack = []
    function emitInoutBacks(b) {
        if (inoutStack.length == 0) { return }
        var names = inoutStack[inoutStack.length - 1]
        for (var i = 0; i < names.length; i++) {
            callExt(b, "js_set", [b.NewCall(rtKGet(), [curScopeV, emitStr(b, "$box$" + names[i])]),
                                  emitStr(b, "v"), b.NewCall(rtKGet(), [curScopeV, emitStr(b, names[i])])])
        }
    }
    // The tuple-return labels of the function whose body is currently being emitted,
    // and its declared NUMERIC return type: `func r() -> Double { return 3 }` answers
    // 3.0, so r() / 2 is 1.5.
    var retLabelStack = []
    var retTypeStack = []
    function retLabelled(b, v) {
        return retTupleLabelled(b, retTyped(b, v))
    }
    function retTyped(b, v) {
        if (retTypeStack.length == 0) { return v }
        return swEmitAdopt(b, v, retTypeStack[retTypeStack.length - 1])
    }
    function retTupleLabelled(b, v) {
        if (retLabelStack.length == 0) { return v }
        var labels = retLabelStack[retLabelStack.length - 1]
        if (labels == null) { return v }
        return emitRelabel(b, v, labels)
    }
    function makeInit(items) {
        return {name: "init", params: items[0].params, body: items[1]}
    }
    // A top-level or nested function declaration. A second function of the same name
    // is an OVERLOAD: each candidate is declared under its own name$K and the plain
    // name resolves to a dispatcher that picks, at call time, the first candidate
    // whose declared parameter types accept the actual arguments. The candidate list
    // is shared, and every declaration statement re-declares the dispatcher, so by
    // the time any call runs the name refers to the complete set.
    var funcOverloads = {}
