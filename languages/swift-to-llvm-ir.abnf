        b.NewCondBr(truthy(b, many), manyB, oneB)
        var sc = callExt(manyB, "js_scope_new", [handle(0)])
        callExt(manyB, "js_scope_decl", [sc, emitStr(manyB, "i"), emitNum(manyB, 0)])
