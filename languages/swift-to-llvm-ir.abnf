// next" test has to be a script and cannot be !"=" - a literal in this dialect
// skips leading whitespace, so !"=" in `maybe! == 7` looks PAST the space, finds
// the = of == and rejects a force-unwrap that is perfectly fine.
ForceSfx    <~~ push({kind:"force"}) ~~> = NoSpace "!" NotChar61 ;
