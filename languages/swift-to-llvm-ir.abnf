TplChar     = TplEsc | TplPlain ;
TplEsc      = "\\" ( "n" | "t" | "r" | "0" | "\\" | @'"' | "'" | UniEsc ) ;
// \u{48} / \u{1F600}: a Unicode scalar escape, one to eight hexadecimal digits.
UniEsc      = "u" "{" HexFDig { HexFDig } "}" ;
TplPlain    = "\x20"..."\x21" | "\x23"..."\x5b" | "\x5d"..."\x7e" | @"\t" | "\x7f"..."\U0010ffff" ;

// A multi-line string literal. Everything between the delimiter lines is content;
// the indentation of the CLOSING delimiter is stripped from every line, and the
// newline after the opening delimiter and the one before the closing one are not
// part of the value. Escapes and \( ... ) interpolation work as in a normal string.
MultiStr    <~~ push(makeMultiStr(takeAll())) ~~>
            = '"""' :whitespace() { MlExpr | MlChunk } '"""' :whitespace(Whitespace) ;
MlExpr      <~~ push({e: pop()}) ~~>
            = "\\(" :whitespace(Whitespace) [ TplLabel ] Expression ")" ;
MlChunk     <~~ push({s: up.in}) ~~> = MlChar { MlChar } ;
