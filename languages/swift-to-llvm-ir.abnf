            // own WIDTH (so -Int8(-128) wraps back to -128) and Int is 64 bit here,
            // where the shared path truncated every result to int32.
            if (!hasOpOverload) { return {b: b, v: callExt(b, "js_swneg", [r.v])} }
            var f = b.NewCall(rtFindM(), [r.v, emitStr(b, "-")])
            var userB = curF.NewBlock("")
            var plainB = curF.NewBlock("")
            var joinB = curF.NewBlock("")
            b.NewCondBr(truthy(b, f), userB, plainB)
            var args = callExt(userB, "js_arr_new", [])
            callExt(userB, "js_arr_push", [args, r.v])
            var uv = callExt(userB, "js_call", [f, hUndef, args])
            userB.NewBr(joinB)
            var pv = callExt(plainB, "js_swneg", [r.v])
            plainB.NewBr(joinB)
            return {b: joinB, v: joinB.NewPhi([llvm.ir.NewIncoming(uv, userB), llvm.ir.NewIncoming(pv, plainB)])}
