            var yB = curF.NewBlock("")
            var nB = curF.NewBlock("")
            var mB = curF.NewBlock("")
            joinB.NewCondBr(truthy(joinB, hit), yB, nB)
            yB.NewBr(mB)
            nB.NewBr(mB)
