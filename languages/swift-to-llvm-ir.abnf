NoSpaceParen = :script(~~
    (function() {
        return (c.peek(0) === 40) ? undefined : abnf.newToken("\x01space-before-paren", 0)
    })()
~~) ;
MArgs       = "(" [ CallArg { "," CallArg } ] ")" [ NoTrailCtx TrailArg { LabTrail } ]
