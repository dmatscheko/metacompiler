    // spellings are Double-aware externs rather than the shared Math members, and
    // the program calls them like any other function value.
    function emitExtFn(b, extName, arity) {
        funcCount++
        var idx = funcCount
        var f = m.NewFunc("jsf_" + idx, i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var savedF = curF
        var savedScope = curScopeV
        curF = f
        var fb = f.NewBlock("entry")
