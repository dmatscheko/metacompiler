        var midB = curF.NewBlock("")
        b.NewCondBr(truthy(b, callExt(b, "js_seq", [v, hNull])), failB, midB)
        midB.NewCondBr(truthy(midB, callExt(midB, "js_seq", [v, hUndef])), failB, okB)
        return okB
    }
    // Emits the test chain of one pattern. On a match control reaches the returned
    // block with every `let`/`var` name of the pattern declared in curScopeV; on a
    // mismatch it branches to failB. binding says a bare identifier names a new
    // variable rather than an enum case.
    function emitMatchPat(b, p, v, binding, failB) {
        if (p.opt > 0) { b = emitNotNil(b, v, failB) }
        return emitMatchCore(b, p.core, v, binding, failB)
