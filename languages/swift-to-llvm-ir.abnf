// bare integer type, so IntAnnType has to decline it and let the general Type read
// it. Without this the optional forms consumed only the `Int` and left the `?`
// standing, which turned into a parse error on the NEXT statement.
NotTypeSuffix = !"?" !"!" !"." !"&" ;
// let (a, _, c) = someTuple - a tuple-pattern declaration; _ discards its element.
DeclTuple   <~~ push(makeDeclTuple(takeAll())) ~~>
            = ( "let" | "var" ) KwEnd TupNames [ ":" DeclTupTy ] "=" Expression [ ";" ] ;
// `let (a, b): (Double, Int) = (1, 2)`: the annotation types the literal, so a is 1.0.
DeclTupTy   <~~ push({dtty: stripWs(up.in)}) ~~> = Type ;
// An element is a name, _ or a nested tuple pattern: `for (i, (x, y)) in`.
TupNames    <~~ push({tnames: takeAll()}) ~~>
            = "(" TupName { "," TupName } ")" ;
TupName     = TupNames | TupLeaf ;
TupLeaf     <~~ push(swBt(up.in)) ~~> = Wildcard | Id ;
// (x, y) = (y, x) - assignment through a tuple pattern (a swap, typically).
TupleAssign <~~ push(makeTupleAssign(takeAll())) ~~>
            = TupNames "=" Expression [ ";" ] ;

If          <~~ push(makeIf(takeAll())) ~~>
            = KwIf Expression Block [ KwElse ElseBody ] ;
ElseBody    = Block | CplxIf | If ;

While       <~~ push(makeWhileL(takeAll())) ~~>
            = [ LoopLabel ] KwWhile Expression Block ;

Repeat      <~~ push(makeRepeat(takeAll())) ~~>
            = [ LoopLabel ] KwRepeat Block KwWhile Expression [ ";" ] ;

