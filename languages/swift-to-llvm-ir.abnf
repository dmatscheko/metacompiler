// p.$score: the PROJECTED value of a property wrapper. The $ is adjacent to the
// name, so whitespace is off between them; the member is read under the name "$x",
// which is where the wrapper's generated accessor lives.
ProjSfx     = "." "$" :whitespace() Id <~~ push({kind:"field", name: "$" + up.in}) ~~> :whitespace(Whitespace) ;
