    }
    function makeContinueL(items) {
        if (items.length == 0) { return makeContinue() }
        var lbl = items[0].lbl
        return function(b) {
            var e = loopFind(lbl)
            if (e != null) { b.NewBr(e.cont) } else { emitContinue(b) }
            return deadBlock()
        }
    }
    // Is this value a dictionary? js_keys aborts on a string or a number, so the
    // test has to be "an object that is not an array" rather than a bare js_keys.
    function emitIsDict(bb, v) {
        var isArr = callExt(bb, "js_is_type", [v, emitStr(bb, "Array")])
        var chkB = curF.NewBlock("")
        var joinB = curF.NewBlock("")
        var fromB = bb
        bb.NewCondBr(truthy(bb, isArr), joinB, chkB)
        var isObj = callExt(chkB, "js_seq", [callExt(chkB, "js_typeof", [v]), emitStr(chkB, "object")])
        chkB.NewBr(joinB)
        var phi = joinB.NewPhi([llvm.ir.NewIncoming(hFalse, fromB), llvm.ir.NewIncoming(isObj, chkB)])
        return {b: joinB, v: phi}
    }
    function itemLbl(items) {
        if (items.length > 0 && items[0] != undefined && items[0].lbl != undefined) { return items[0].lbl }
        return null
    }
    function itemsAfterLbl(items) {
        if (itemLbl(items) != null) { return items.slice(1) }
        return items
    }
    // Binds one iteration value to the loop pattern (a name, _ or a tuple pattern).
    function emitBindForPat(b, pat, v) {
        if (pat.tnames != undefined) {
            for (var i = 0; i < pat.tnames.length; i++) {
                if (pat.tnames[i] == "_") { continue }
                callExt(b, "js_scope_decl", [curScopeV, emitStr(b, pat.tnames[i]),
