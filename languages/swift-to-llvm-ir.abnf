// fallthrough. Body parsed FLAT (labels before Statement, a bare 'case' is a valid
// identifier); the builder groups statements under the label they follow. break in
// a case leaves the switch (loop stack), continue reaches the enclosing loop.
Switch      <~~ push(makeSwitch(takeAll())) ~~>
            = [ LoopLabel ] KwSwitch SwitchSubj "{" { PoundIfCase | CaseLabel | Statement } "}" ;
SwitchSubj  <~~ push({subj: pop()}) ~~>
            = Expression ;
// A case label is a comma-separated list of PATTERNS with an optional where guard:
// values (case 1, 2), ranges (case 1...9, case ..<0), tuples (case (0, let y)),
// enum cases with their associated values (case .rect(let w, let h)) and bindings
// (case let (x, y) where x == y).
CaseLabel   <~~ push(makeCaseLabel(takeAll())) ~~>
            = ( KwCase CaseItem { "," CaseItem } [ CaseWhere ]
              | KwDefault ) ":" ;
CaseItem    <~~ push({cpat: pop()}) ~~> = Pattern ;
CaseWhere   <~~ push({cwhere: pop()}) ~~> = KwWhere Expression ;

Return      <~~ push(makeReturn(takeAll(), up.pos)) ~~>
            = KwReturn [ Expression <~~ push({itext: up.in, iat: up.start + ":" + up.pos}) ~~> ] [ ";" ] ;
Break       <~~ push(makeBreakL(takeAll())) ~~>    = KwBreak [ SameLine BreakLbl ] [ ";" ] ;
Continue    <~~ push(makeContinueL(takeAll())) ~~> = KwContinue [ SameLine BreakLbl ] [ ";" ] ;
BreakLbl    <~~ push({lbl: swBt(up.in)}) ~~> = Id ;

// A zero-width guard that fails at end of line (a newline or a // comment before the
// next token): the label of `break outer` must start on the SAME line, otherwise a
// bare `break` followed by a statement would swallow that statement's first name.
SameLine    = :script(~~
    (function() {
        var i = 0
        var cc = c.peek(i)
        while (cc === 32 || cc === 9) { i++; cc = c.peek(i) }
        return (cc === 10 || cc === 13 || cc < 0 || (cc === 47 && c.peek(i + 1) === 47))
            ? abnf.newToken("\x01newline-follows", 0)
            : undefined
    })()
~~) ;
// `;` alone, or `()` - the empty tuple as a statement (`case 0: ()`): a no-op.
Empty       <~~ push(function(b) { return b }) ~~> = ";" | "(" ")" StmtSep ;

ExprStmt    <~~ push(exprToStmt(pop())) ~~>
            = Expression [ ";" ] ;

// Every expression production pushes exactly one thunk: function(block) -> {b, v}.
Expression  = PackRepeat | Assignment | Ternary ;
// `repeat <expr>` - a pack expansion EXPRESSION (SE-0393). It evaluates its body
// once per element of the packs `each` names inside it and yields the results as a
// tuple, which is what makes `(repeat 2 * each arg + 3)` a tuple of the same arity
// as the value pack. `repeat` is a reserved word, and the repeat/while STATEMENT is
// matched before ExprStmt, so no guard is needed to tell the two apart.
PackRepeat  <~~ push(makePackRepeat(pop())) ~~> = KwRepeat Expression ;
Assignment  <~~ push(makeAssign(takeAll())) ~~>
            = Target ( "+=" | "-=" | "*=" | "/=" | "%=" | "=" ) <~~ push(up.in) ~~>
              Expression <~~ push({itext: up.in, iat: up.start + ":" + up.pos}) ~~> ;

// An assignment TARGET is a name followed by field reads, tuple-element reads,
// force-unwraps and subscripts, in any order: `n.next!.v = 4` and `tp.0 = 3`.
//
// TForce is spelled with the same NoSpace/NotChar61 guard ForceSfx uses, and the
// guard is what makes the rule safe: Assignment is tried before Ternary, so
// without the "no = next" test `a != b` would read as the target `a!` followed by
// `= b` and silently become an assignment. A `!` here is otherwise a no-op - an
// Optional IS its value in this model - so it pushes nothing.
Target      <~~ push(swNoteWrite(makeTargetRef(takeAll()))) ~~>
            = ( Id <~~ push(swBt(up.in)) ~~> | "$" :whitespace() TShort :whitespace(Whitespace) )
              { TOpt | "." Id <~~ push({key: swBt(up.in)}) ~~> | "." TTupIdx | TForce | TIndex } ;
