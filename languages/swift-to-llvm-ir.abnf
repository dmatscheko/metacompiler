// scan is a pure function of (source, position): it skips the whitespace itself and
// returns a token covering only the run.
CustomOp    = :script(~~
    (function() {
        var i = 0
        var ch = c.peek(i)
        while (ch === 32 || ch === 9 || ch === 10 || ch === 13) { i++; ch = c.peek(i) }
        var s = ""
        while (ch === 47 || ch === 61 || ch === 45 || ch === 43 || ch === 33 || ch === 42
