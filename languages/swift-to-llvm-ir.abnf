    function emitMatchCore(b, k, v, binding, failB) {
        if (k.pwild != undefined) { return b }
        if (k.pexpr != undefined) {
            var re = k.pexpr(b)
            var okE = curF.NewBlock("")
            re.b.NewCondBr(truthy(re.b, emitBin(re.b, "==", v, re.v)), okE, failB)
