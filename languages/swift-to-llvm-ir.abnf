        // `struct Outer { struct Inner { struct Inner {...} } }` registers the inner
        // Inner, then the middle Inner OVERWRITES $Inner with its own record, and an
        // unguarded restore would wipe the middle one.
        if (old == rec.bname && hasOwn(typeInfo, "$" + old) && typeInfo["$" + old].uid == rec.uid) {
