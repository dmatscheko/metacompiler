SwHexLit    <~~ push(swIntLit(up.in)) ~~>
            = "0" ( "x" | "X" ) :whitespace() HexFDig { HexFDig | "_" } :whitespace(Whitespace) ;
SwBinLit    <~~ push(swIntLit(up.in)) ~~>
            = "0" ( "b" | "B" ) :whitespace() SwBinDig { SwBinDig | "_" } :whitespace(Whitespace) ;
