        // functions (so Int.max stays an ordinary property read), and the call form
        // is resolved here at walk time. A user type of the same name still wins.
        // Double(x) / Float(x) / String(x): the same walk-time resolution the
        // integer types get. Double(3) is 3.0 and Double(3) / 2 is 1.5 - the whole
        // point of the box - and String(x) is the text print would have written.
        // Float(x) is the same resolution at the 32 bit WIDTH: a Swift Float is
        // an IEEE-754 binary32, so Float(1) / Float(3) is 0.33333334 where the
        // Double is 0.3333333333333333. The whole specification, and why the
        // width cannot live in the C floor, is the float WIDTH block of
        // languages/lib/swift-rt.metajs.
        if ((name == "Double" || name == "Float" || name == "String")
            && lookupSig(name) == null && classNames[name] != 1 && enumNames[name] != 1) {
            var convExt = name == "String" ? "js_swstr" : "js_swflo"
            if (name == "Float") { convExt = "js_swflo32" }
            return function(b) {
                var ec2 = emitArgRecs(b, args)
                b = ec2.b
                return {b: b, v: callExt(b, convExt, [callExt(b, "js_pyget", [ec2.v, emitNum(b, 0)])])}
            }
        }
        var swIt = swIntWidthOf(name)
        if (swIt != null && lookupSig(name) == null && classNames[name] != 1 && enumNames[name] != 1) {
            return function(b) {
                var ec = emitArgRecs(b, args)
                b = ec.b
                return {b: b, v: swEmitConv(b, callExt(b, "js_pyget", [ec.v, emitNum(b, 0)]), swIt)}
