    function makeCondIf(items) {
        var conds = items[0].conds
        var thenT = items[1]
        var elseT = items.length > 2 ? items[2] : null
        return function(b) {
            var saved = curScopeV
            curScopeV = callExt(b, "js_scope_new", [curScopeV])
            var elseB = curF.NewBlock("")
            var contB = curF.NewBlock("")
