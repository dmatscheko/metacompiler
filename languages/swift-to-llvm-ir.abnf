    // it to the enclosing declaration (the emit-time twin is lastTypeName).
    //
    // It travels as an INDEX, not as the object. A value pushed onto the tag stack is
    // DEEP-COPIED by the engine, so a record handed up that way arrives as a clone:
    // re-keying it would move the clone while the declaration's own closure still
    // read the bare key.
    var declRecs = []
    var lastDeclRec = -1
    function noteDeclRec(rec) {
        declRecs.push(rec)
        lastDeclRec = declRecs.length - 1
        return lastDeclRec
    }
