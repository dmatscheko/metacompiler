    // every line, and the newline that follows the opening delimiter and the one that
    // precedes the closing one are not part of the value.
    function makeMultiStr(items) {
        var parts = []
        for (var i = 0; i < items.length; i++) { parts.push(items[i]) }
        var indent = ""
        for (var k = parts.length - 1; k >= 0; k--) {
            if (parts[k].s == undefined) { break }
            var t = parts[k].s
            var cut = -1
            for (var j = 0; j < t.length; j++) { if (t.charAt(j) == "\n") { cut = j } }
            if (cut < 0) { continue }
            var tail = t.substring(cut + 1)
            var ok = true
            for (var q = 0; q < tail.length; q++) {
                var ch = tail.charAt(q)
                if (ch != " " && ch != "\t") { ok = false }
