// &x: an inout argument. Spelled ( "&" !"&" ) so it cannot start on the first
// character of a && operator.
InoutArg    = "&" !"&" Id <~~ push({aref: up.in}) ~~> ;

Primary     = Paren | MultiStr | RawStrN | RawStr3 | RawStr2 | RawStr1 | Template | NumberLit
            | True | False | Nil
            | PoundExpr | SuperRef | DotMember | Closure | ArrayTypeLit | DictLit | ArrayLit
            | Shorthand | MultiTrail | Call | VarRef ;

// The numeric literal forms, longest/most specific first (PEG first-match): a hex
// FLOAT before the hex integer that is its prefix, the based forms before the
// decimal ones (0 would otherwise match and leave xFF behind), and the fractional
// form before the plain integer. NONE of them come from lib/numbers.abnf any more:
// the shared INTEGER forms go through parseInt, which is a double, so
// 9223372036854775807 came back as 9223372036854776000 and 0xFFFFFFFFFFFFFFFF as
// 18446744073709552000 - both ordinary Swift literals, which swIntLit emits as
// DIGITS for js_gilit to read exactly. And the shared FRACTIONAL form emits a plain
// number, where a Swift float literal has to emit the js_swflo BOX that makes it a
