            var w = 1
            if (cp >= 0xD800 && cp <= 0xDBFF && i + 1 < str.length) {
                cp = 0x10000 + ((cp - 0xD800) * 1024) + (str.charCodeAt(i + 1) - 0xDC00)
                w = 2
            }
            i += w
            if (cp == 0x200D) { joining = true; continue }
            if (joining) { joining = false; continue }
            if (isCombiningCp(cp)) { continue }
            n++
        }
        return n
    }

    // ----- Expression thunks: function(block) -> {b, v} -----

    // e as/as?/as! T and e is T carry a {cast:1} marker per operator. With no
    // marker the single operand thunk passes through unchanged.
    // e is T answers the dynamic type test (js_swis, the Go twin of the
    // interpreter's swIsNamed), e as? T the value or nil, and e as / e as! T the value
    // itself - the value model has one representation per value, so an upcast and a
    // forced downcast are identities. An enum case answers to its enum's name.
    //
    // js_swis rather than the shared js_is_type: the shared probe does not know the
    // float box (`3 is Double` must be false, `3.0 is Double` true) and has no arm
    // for the name `Bool`. Every non-numeric name still falls through to js_is_type
    // inside it.
    // The dynamic type test as a value, shared by the `is` OPERATOR and by the
    // `case is T:` PATTERN so the two cannot drift - the enum arm below is the
    // reason a pattern spelled with a bare js_swis would not have been the same
    // test (the interpreter's swIsType has that arm inside it).
    // `A & B` is a protocol COMPOSITION and every component has to match:
    // `U2() is A2 & B2` is false with `struct U2: A2` (swiftc 6.1.2).
    function swSplitAmp(t) {
        var out = []
        var cur = ""
        // Only a spelling that HAS an & is taken apart: every other type name must
        // reach the tests below exactly as it was written, whitespace included.
        var amp = false
        for (var k = 0; k < t.length; k++) { if (t.charAt(k) == "&") { amp = true } }
        if (!amp) { out.push(t); return out }
        for (var i = 0; i < t.length; i++) {
            var ch = t.charAt(i)
            if (ch == "&") { out.push(swTrimTy(cur)); cur = "" } else { cur = cur + ch }
        }
        out.push(swTrimTy(cur))
        return out
    }
    function swTrimTy(s) {
        var a = 0
        var b2 = s.length
        while (a < b2 && (s.charAt(a) == " " || s.charAt(a) == "\t")) { a = a + 1 }
        while (b2 > a && (s.charAt(b2 - 1) == " " || s.charAt(b2 - 1) == "\t")) { b2 = b2 - 1 }
        return s.substring(a, b2)
    }
    function emitIsType(b, v, tname) {
        var comps = swSplitAmp(tname)
        if (comps.length > 1) {
            var failB = curF.NewBlock("")
            var joinB = curF.NewBlock("")
            for (var ci = 0; ci < comps.length; ci++) {
                var rc = emitIsType(b, v, comps[ci])
                b = rc.b
                var nxtB = curF.NewBlock("")
                b.NewCondBr(truthy(b, rc.v), nxtB, failB)
                b = nxtB
            }
            var allB = b
            allB.NewBr(joinB)
            failB.NewBr(joinB)
            return {b: joinB, v: joinB.NewPhi([llvm.ir.NewIncoming(hTrue, allB),
                                               llvm.ir.NewIncoming(hFalse, failB)])}
        }
        // A user PROTOCOL is answered by the conformance marker every adoption site
        // writes, not by a name walk: the descriptor is named for the conforming
        // TYPE. protoNames and protoBuiltinConf are complete
        // here - this runs at EMIT time, after the whole walk - so the builtin
        // conformers are passed as a static list rather than looked up at run time.
        var pt = baseTypeName(tname)
        if (protoNames[pt] == 1) {
            var bl = hasOwn(protoBuiltinConf, "$" + pt) ? protoBuiltinConf["$" + pt] : []
            var ba = callExt(b, "js_arr_new", [])
            for (var z = 0; z < bl.length; z++) { callExt(b, "js_arr_push", [ba, emitStr(b, bl[z])]) }
            return {b: b, v: callExt(b, "js_swconf", [v, emitStr(b, pt), ba])}
        }
        var isB = callExt(b, "js_swis", [v, emitStr(b, tname)])
        var elseB = curF.NewBlock("")
        var joinB = curF.NewBlock("")
        var fromB = b
        b.NewCondBr(truthy(b, isB), joinB, elseB)
        // A case value's type is its enum, which js_is_type does not know about.
        var nm = elseB.NewCall(rtProbe("sw_etype", "__etype"), [v])
        var alt = callExt(elseB, "js_seq", [nm, emitStr(elseB, tname)])
        elseB.NewBr(joinB)
        return {b: joinB, v: joinB.NewPhi([llvm.ir.NewIncoming(hTrue, fromB), llvm.ir.NewIncoming(alt, elseB)])}
    }
    function makeCastOne(t, op, tname) {
        // `3 as Int8` is a COERCION, not a no-op - see swift-interpreter.abnf's
        // makeCastOne for the four rows this settles against swiftc 6.1.2. The
        // swAdoptable test is at EMIT time, so a cast to a non-numeric name emits
        // no call at all.
        if (op != "is" && op != "as?") {
            if (op == "as!" && !swAdoptable(tname)) {
                return function(b) {
                    var ro = t(b)
                    return {b: ro.b, v: swEmitOptOpen(ro.b, ro.v)}
                }
            }
            // A structural type adopts its leaves too: `[1, 2] as [Double]`.
            if (!swAdoptable(tname) && !(op == "as" && swAdoptNeeded(tname))) { return t }
            var opens = op == "as!"
            return function(b) {
                var ra = t(b)
                var av = opens ? swEmitOptOpen(ra.b, ra.v) : ra.v
                return {b: ra.b, v: swEmitAdopt(ra.b, av, tname)}
            }
        }
        return function(b) {
            var r = t(b)
            b = r.b
            r = {b: b, v: swEmitOptOpen(b, r.v)}
            var ri = emitIsType(r.b, r.v, tname)
            var joinB = ri.b
            var hit = ri.v
            if (op == "is") { return {b: joinB, v: hit} }
            var yB = curF.NewBlock("")
            var nB = curF.NewBlock("")
            var mB = curF.NewBlock("")
            joinB.NewCondBr(truthy(joinB, hit), yB, nB)
            yB.NewBr(mB)
            nB.NewBr(mB)
            return {b: mB, v: mB.NewPhi([llvm.ir.NewIncoming(r.v, yB), llvm.ir.NewIncoming(hNull, nB)])}
