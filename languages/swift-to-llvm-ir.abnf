// The element literal adopts it - `for x: Double in [1, 2]` walks 1.0 and 2.0 - so a
// simple name's annotation travels to makeForList as {fty}; a tuple pattern's
// annotation only restates the element type.
ForPatType  <~~ push({fty: swForAnn}) ~~> = ":" Type <~~ swForTy(stripWs(up.in)) ~~> ;
// for x in xs where COND { ... }: the body runs only for the elements that pass.
ForWhere    <~~ push({fwhere: pop()}) ~~> = KwWhere Expression ;

// guard COND else { ... }: a false condition branches into the else block (which
// normally diverges via return/break/continue); a true condition falls through.
Guard       <~~ push(makeGuard(takeAll())) ~~>
            = KwGuard Expression KwElse Block ;

