        // overloaded operator work through it. A type may still DECLARE `static func
        // +=` - it is accepted - but the + overload is the one that runs.
        var baseOp = op
        if (op == "+=") { baseOp = "+" }
        else if (op == "-=") { baseOp = "-" }
        else if (op == "*=") { baseOp = "*" }
        else if (op == "/=") { baseOp = "/" }
        else if (op == "%=") { baseOp = "%" }
        if (baseOp == "+" || baseOp == "-" || baseOp == "*" || baseOp == "/" || baseOp == "%"
            || baseOp == "<" || baseOp == ">" || baseOp == "<=" || baseOp == ">=") {
            return emitOverloadable(b, baseOp, l, r, plain)
        }
        return plain(b)
    }

    // ----- Ranges, bitwise and overflow operators, operator overloading -----
    // a...b / a..<b as a value: {__range, lo, hi, closed}. ~= tests it, and a for-in
    // over a range VALUE (the a...b of a for loop is read below this level and keeps
    // its own operator) walks it.
    // A ONE-SIDED range carries a null bound: `1...` is {lo: 1, hi: null} and
    // `...1` / `..<2` is {lo: null, hi: 1}. sw_slice fills the missing end in from
    // the receiver's length, which is the only place either can be used - that is
    // what PartialRangeFrom/PartialRangeThrough are for in Swift too.
    function makeRange(items) {
        if (items.length == 1) { return items[0] }
        var loT = items[0]
        var opAt = items[0].rop != undefined ? 0 : 1
        var closed = items[opAt].rop == "..."
        var hiT = items[opAt + 1]
        if (opAt == 1) { loT = items[0] } else { loT = null }
        return function(b) {
            var loV = hNull
            if (loT != null) {
                var rl = loT(b)
                b = rl.b
                loV = rl.v
            }
            var hiV = hNull
            if (hiT != undefined && hiT != null) {
                var rh = hiT(b)
                b = rh.b
                hiV = rh.v
            }
            var o = callExt(b, "js_obj_new", [])
            callExt(b, "js_set", [o, emitStr(b, "__range"), hTrue])
            callExt(b, "js_set", [o, emitStr(b, "lo"), loV])
            callExt(b, "js_set", [o, emitStr(b, "hi"), hiV])
            callExt(b, "js_set", [o, emitStr(b, "closed"), closed ? hTrue : hFalse])
            hasRanges = true
            return {b: b, v: o}
        }
    }
    var hasRanges = false
    // ----- Set -----
    // A Set is {__set: true, elems: [...]}, its members in insertion order; the
    // methods, ==, the copy and the printed form are js_swmcall / js_sweq /
    // js_swcopy / js_swprint's (abnf/jsrtswift.go, lib/swift-rt.metajs). Here: the
    // construction, and - once a program builds one (hasSets, set at WALK time) -
    // rtRangeArr also walks a Set as its members, which is what count, isEmpty,
    // first, Array(s) and for-in read. Twin: the Set block of
    // swift-interpreter.abnf.
    var hasSets = false
    // A program that declares a Sequence or IteratorProtocol conformance, or builds a
    // sequence() / AnyIterator, can hand for-in and Array() a LAZY sequence
    // (js_swmkiter): set at WALK time, it gives makeForList its iterator path and
    // rtArrayOf its js_swseqarr. Every other program keeps the index-only loop.
    var hasLazySeq = false
    function swNoteInherit(t) {
        if (t == "Sequence" || t == "IteratorProtocol") { hasLazySeq = true }
        return t
    }
    function swIsSetTy(t) {
        var is = t == "Set" || (t.length > 4 && t.substring(0, 4) == "Set<")
        if (is) { hasSets = true }
        return is
    }
    // A String is first split into its Characters and a Range into its elements.
    function emitSetOf(b, v) {
        var sv = b.NewCall(rtRangeArr(), [b.NewCall(rtStrSeq(), [v])])
        return callExt(b, "js_swsetof", [sv])
    }
    // `var s: Set<Int> = [1, 2]`: the initializer, made a Set.
    function swSetInit(t) {
        return function(b) {
            var r = t(b)
            return {b: r.b, v: emitSetOf(r.b, r.v)}
        }
    }
    // `let a: [Set<Int>] = [[1], [2, 3]]`: an Array OF Sets, so each element literal
    // is made a Set. Twin of swIsSetArrTy in swift-interpreter.abnf.
    function swIsSetArrTy(t) {
        if (t.length < 3 || t.charAt(0) != "[" || t.charAt(t.length - 1) != "]") { return false }
        var inner = t.substring(1, t.length - 1)
        return (inner == "Set" || inner.charAt(inner.length - 1) == ">") && swIsSetTy(inner)
    }
    function swSetArrInit(t) {
        return function(b) {
            var r = t(b)
            return {b: r.b, v: r.b.NewCall(rtSetArr(), [r.v])}
        }
    }
    // `var d: [Set<Int>: V] = [[1, 2]: v]`: the KEY type makes an array literal key
    // a Set. Twin of swIsSetKeyTy / swSetKeys in swift-interpreter.abnf.
    function swIsSetKeyTy(t) {
        var ct = swDsCollTy(t)
        return ct.length == 2 && swIsSetTy(ct[0])
    }
    function swSetKeysInit(t) {
        return function(b) {
            var r = t(b)
            var keys = callExt(r.b, "js_get", [r.v, emitStr(r.b, "keys")])
            callExt(r.b, "js_set", [r.v, emitStr(r.b, "keys"), r.b.NewCall(rtSetArr(), [keys])])
            return {b: r.b, v: r.v}
        }
    }
    // Bool(x): a Bool is itself, and the failable Bool(String) accepts exactly
    // "true" and "false"; anything else is nil. Twin of hostGlobals["Bool"] in
    // swift-interpreter.abnf.
    function rtBoolOf() {
        return rtFunc("sw_boolof", 1, function(b, ps) {
            var tB = curF.NewBlock("")
            var n1 = curF.NewBlock("")
            var fB = curF.NewBlock("")
            var n2 = curF.NewBlock("")
            var n3 = curF.NewBlock("")
            var nilB = curF.NewBlock("")
            b.NewCondBr(truthy(b, callExt(b, "js_sweq", [ps[0], emitStr(b, "true")])), tB, n1)
            tB.NewRet(hTrue)
            n1.NewCondBr(truthy(n1, callExt(n1, "js_sweq", [ps[0], emitStr(n1, "false")])), fB, n2)
            fB.NewRet(hFalse)
            n2.NewCondBr(truthy(n2, callExt(n2, "js_seq", [callExt(n2, "js_typeof", [ps[0]]), emitStr(n2, "boolean")])), n3, nilB)
            n3.NewRet(ps[0])
            nilB.NewRet(hNull)
        })
    }
    function rtSetArr() {
        return rtFunc("sw_setarr", 1, function(b, ps) {
            var out = callExt(b, "js_arr_new", [])
            var sc = callExt(b, "js_scope_new", [handle(0)])
            callExt(b, "js_scope_decl", [sc, emitStr(b, "i"), emitNum(b, 0)])
            var lenV = callExt(b, "js_pylen", [ps[0]])
            var headB = curF.NewBlock("")
            var bodyB = curF.NewBlock("")
            var doneB = curF.NewBlock("")
            b.NewBr(headB)
            var iV = callExt(headB, "js_scope_get", [sc, emitStr(headB, "i")])
            headB.NewCondBr(truthy(headB, callExt(headB, "js_lt", [iV, lenV])), bodyB, doneB)
            callExt(bodyB, "js_arr_push", [out, emitSetOf(bodyB, callExt(bodyB, "js_swidx", [ps[0], iV]))])
            callExt(bodyB, "js_scope_set", [sc, emitStr(bodyB, "i"), callExt(bodyB, "js_jadd", [iV, emitNum(bodyB, 1)])])
            bodyB.NewBr(headB)
            doneB.NewRet(out)
        })
    }
    // ~= : containment when the left side is a range, == otherwise.
    function rtRangeHas() {
        return rtFunc("sw_rangehas", 2, function(b, ps) {
            var isR = b.NewCall(rtProbe("sw_isrange", "__range"), [ps[0]])
            var rB = curF.NewBlock("")
            var eqB = curF.NewBlock("")
            b.NewCondBr(truthy(b, isR), rB, eqB)
            var lo = callExt(rB, "js_get", [ps[0], emitStr(rB, "lo")])
            var hi = callExt(rB, "js_get", [ps[0], emitStr(rB, "hi")])
            var geB = curF.NewBlock("")
            var noB = curF.NewBlock("")
            rB.NewCondBr(truthy(rB, callExt(rB, "js_ge", [ps[1], lo])), geB, noB)
            var closedB = curF.NewBlock("")
            var openB = curF.NewBlock("")
            geB.NewCondBr(truthy(geB, callExt(geB, "js_get", [ps[0], emitStr(geB, "closed")])), closedB, openB)
            closedB.NewRet(callExt(closedB, "js_le", [ps[1], hi]))
            openB.NewRet(callExt(openB, "js_lt", [ps[1], hi]))
            noB.NewRet(hFalse)
            eqB.NewRet(eqB.NewCall(rtEq(), [ps[0], ps[1]]))
        })
    }
    // A range VALUE handed to for-in becomes the array of its elements.
    function rtRangeArr() {
        return rtFunc("sw_rangearr", 1, function(b, ps) {
            var isR = b.NewCall(rtProbe("sw_isrange", "__range"), [ps[0]])
            var rB = curF.NewBlock("")
            var asIs = curF.NewBlock("")
            b.NewCondBr(truthy(b, isR), rB, asIs)
            var out = callExt(rB, "js_arr_new", [])
            var hi = callExt(rB, "js_get", [ps[0], emitStr(rB, "hi")])
            var closed = callExt(rB, "js_get", [ps[0], emitStr(rB, "closed")])
            var sc = callExt(rB, "js_scope_new", [handle(0)])
            callExt(rB, "js_scope_decl", [sc, emitStr(rB, "i"), callExt(rB, "js_get", [ps[0], emitStr(rB, "lo")])])
            var headB = curF.NewBlock("")
            var bodyB = curF.NewBlock("")
            var doneB = curF.NewBlock("")
            var cmpB = curF.NewBlock("")
            var openB = curF.NewBlock("")
            rB.NewBr(headB)
            var iV = callExt(headB, "js_scope_get", [sc, emitStr(headB, "i")])
            headB.NewCondBr(truthy(headB, closed), cmpB, openB)
            cmpB.NewCondBr(truthy(cmpB, callExt(cmpB, "js_le", [iV, hi])), bodyB, doneB)
            openB.NewCondBr(truthy(openB, callExt(openB, "js_lt", [iV, hi])), bodyB, doneB)
            var i2 = callExt(bodyB, "js_scope_get", [sc, emitStr(bodyB, "i")])
            callExt(bodyB, "js_arr_push", [out, i2])
            callExt(bodyB, "js_scope_set", [sc, emitStr(bodyB, "i"), callExt(bodyB, "js_jadd", [i2, emitNum(bodyB, 1)])])
            bodyB.NewBr(headB)
            doneB.NewRet(out)
            if (!hasSets) { asIs.NewRet(ps[0]); return }
            var setB = curF.NewBlock("")
            var plainB = curF.NewBlock("")
            asIs.NewCondBr(truthy(asIs, asIs.NewCall(rtProbe("sw_isset", "__set"), [ps[0]])), setB, plainB)
            setB.NewRet(callExt(setB, "js_get", [ps[0], emitStr(setB, "elems")]))
            plainB.NewRet(ps[0])
        })
    }
    // An operator a type declares as `static func <op>`: found on the first operand,
    // else on the second, else the built-in behaviour applies.
    function rtOpFn() {
        return rtFunc("sw_opfn", 3, function(b, ps) {
            var f = b.NewCall(rtFindM(), [ps[0], ps[2]])
            var hitB = curF.NewBlock("")
            var tryRB = curF.NewBlock("")
            b.NewCondBr(truthy(b, f), hitB, tryRB)
            hitB.NewRet(f)
            tryRB.NewRet(tryRB.NewCall(rtFindM(), [ps[1], ps[2]]))
        })
    }
    // The overloadable binary operators, emitted as "ask the operand's type first,
    // otherwise the built-in operation". emitBin must not change the caller's block
    // (foldBinary keeps emitting into it), so the two-way choice lives inside a
    // helper FUNCTION - one per operator, emitted once, and only for a program that
    // declares an operator on a type.
    var hasOpOverload = false
    var ovlNames = {}
    var ovlCount = 0
    function emitOverloadable(b, op, l, r, plain) {
        if (!hasOpOverload) { return plain(b) }
        var key = "$" + op
        if (!hasOwn(ovlNames, key)) { ovlCount++; ovlNames[key] = "sw_ovl_" + ovlCount }
        var fname = ovlNames[key]
        var f = rtFunc(fname, 2, function(bb, ps) {
            var fn = bb.NewCall(rtOpFn(), [ps[0], ps[1], emitStr(bb, op)])
            var userB = curF.NewBlock("")
            var plainB = curF.NewBlock("")
            bb.NewCondBr(truthy(bb, fn), userB, plainB)
            var args = callExt(userB, "js_arr_new", [])
            callExt(userB, "js_arr_push", [args, ps[0]])
            callExt(userB, "js_arr_push", [args, ps[1]])
            userB.NewRet(callExt(userB, "js_call", [fn, hUndef, args]))
            plainB.NewRet(plain(plainB, ps[0], ps[1]))
        })
        return b.NewCall(f, [l, r])
    }

    // ----- Core library config (see lib/compile-core.js) -----
    // === / !== compare identity; with reference objects that is strict equality.
    binExt["==="] = "js_seq"
    binExt["!=="] = "js_sne"
    binExt["&"] = "js_band"
    binExt["|"] = "js_bor"
    binExt["^"] = "js_bxor"
    binExt["<<"] = "js_shl"
    binExt[">>"] = "js_shr"
    binExt["&+"] = "js_jadd"
    binExt["&-"] = "js_sub"
    binExt["&*"] = "js_mul"
    wraps["&+"] = 1
    wraps["&-"] = 1
    wraps["&*"] = 1

    // The this-aware scope read is the EMITTED sw_kget helper (see rtKGet above), not
    // an extern, so core's own name-read path is left on the plain floor primitive;
    // makeVarRef is overridden to use sw_kget and is the only site that reads a name.
    core.scopeGetExt = "js_scope_get"

    c.compile(c.asg)

    // ----- the native build -----
    // jsdispatch(idx, env, args) is the function table a LINKED binary needs: js_closure
    // stores a raw function index, and under llvm.Run the Go runtime turns that index
    // back into a callee by looking "jsf_<idx>" up in the module. A binary has no such
    // reflection, so the module carries the mapping itself. The MISS arm calls
    // jsdispatch_ext, the same table emitted by the layer-2 runtime library
    // (lib/swift-rt.ll, built by metajs-to-llvm-ir.abnf -rt-lib): its own function
    // indices are offset by a million, so the two chains cannot overlap and one js_call
    // reaches either module. Emitted ONLY for -exe. This is lua-to-llvm-ir.abnf's
    // emitDispatch, unchanged - nothing here is Swift's.
    function emitDispatch() {
        var idxs = []
        var fns = []
        var i = 0
        while (i < m.Funcs.length) {
            var f = m.Funcs[i]
            var nm = f.Name()
            if (nm.length > 4 && nm.substring(0, 4) == "jsf_") {
                idxs.push(parseInt(nm.substring(4, nm.length)))
                fns.push(f)
            }
            i = i + 1
        }
        var ext = m.NewFunc("jsdispatch_ext", i64,
            [llvm.ir.NewParam("idx", i64), llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var d = m.NewFunc("jsdispatch", i64,
            [llvm.ir.NewParam("idx", i64), llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var b = d.NewBlock("entry")
        var extB = d.NewBlock("ext")
        var ownB = d.NewBlock("own")
        b.NewCondBr(b.NewICmp(llvm.enum.IPredSGE, d.Params[0], llvm.constant.NewInt(i64, 1000000)), extB, ownB)
        extB.NewRet(extB.NewCall(ext, [d.Params[0], d.Params[1], d.Params[2]]))
        b = ownB
        i = 0
        while (i < fns.length) {
            var hit = d.NewBlock("hit" + idxs[i])
            var nxt = d.NewBlock("miss" + idxs[i])
            b.NewCondBr(b.NewICmp(llvm.enum.IPredEQ, d.Params[0], llvm.constant.NewInt(i64, idxs[i])), hit, nxt)
            hit.NewRet(hit.NewCall(fns[i], [d.Params[1], d.Params[2]]))
            b = nxt
            i = i + 1
        }
        b.NewRet(b.NewCall(ext, [d.Params[0], d.Params[1], d.Params[2]]))
    }

    // The two runtime inputs live next to THIS grammar, so the build does not depend on
    // the working directory: lib/runtime.ll is the C floor and lib/swift-rt.ll is
    // Swift's own layer 2. An explicit -rt REPLACES both.
    function libPath(name) {
        var mn = moduleName()
        var cut = -1
        var i = 0
        while (i < mn.length) {
            var ch = mn.charAt(i)
            if (ch == "/" || ch == "\\") { cut = i }
            i = i + 1
        }
        return mn.substring(0, cut + 1) + "lib/" + name
    }

    if (c.exePath != undefined && c.exePath != "") {
        emitDispatch()
        var rts = c.runtime
        if (rts == undefined || rts.length == 0) { rts = [libPath("runtime.ll"), libPath("swift-rt.ll")] }
        var buildErr = llvm.BuildExecutable(m, c.exePath, rts)
        if (buildErr != "") {
            println(buildErr)
            exit(1)
        }
        println("swift compiler: wrote executable " + c.exePath)
        exit(0)
    }

    println(m)

    var res = llvm.RunJS(m, "jsmain")
    println("swift compiler: main() returned " + res.Ret)
    exit(res.Ret)

~~) ;
