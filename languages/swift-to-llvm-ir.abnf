    }
    // A property read that goes through the generated getter when the value's type has
    // one, and is a plain member read otherwise - so a name that is COMPUTED in one
    // type and STORED in another still reads correctly in both.
    function rtGetProp() {
        return rtFunc("sw_getprop", 2, function(b, ps) {
            var key = callExt(b, "js_jadd", [emitStr(b, "__get_"), ps[1]])
            var g0 = b.NewCall(rtFindM(), [ps[0], key])
            // A STATIC computed property lives on the type descriptor itself, which
            // has no __class for the walk above to start from.
            var ownB = curF.NewBlock("")
            var joinB = curF.NewBlock("")
            var fromB = b
            b.NewCondBr(truthy(b, g0), joinB, ownB)
            var g1 = ownB.NewCall(rtSafeGet(), [ps[0], key])
            ownB.NewBr(joinB)
            var g = joinB.NewPhi([llvm.ir.NewIncoming(g0, fromB), llvm.ir.NewIncoming(g1, ownB)])
            b = joinB
            var callB = curF.NewBlock("")
            var plainB = curF.NewBlock("")
            b.NewCondBr(truthy(b, g), callB, plainB)
            var args = callExt(callB, "js_arr_new", [])
