    // Shared emitter machinery (module, handle constants, externs, loopStack
    // protocol, expression/statement builders); see the `core` knobs below.
    include("lib/compile-core.js")

    // swcIsProp: the Character property names js_swget answers.
    include("lib/swift-chars.js")

    var hidCount = 0     // Names hidden loop bounds.
    var classNames = {}  // Known struct/class names (constructor calls).

    function fail(msg) { println("swift compiler error: " + msg); exit(1) }

    // ----- Imports -----
    // System frameworks / modules the platform already provides (the standard library,
    // Foundation and the common Apple frameworks, plus the platform C libraries);
    // importing one is a no-op. Anything else is a project module we resolve to a file.
    core.stdlibImports = ["Swift", "Foundation", "Dispatch", "Combine", "SwiftUI", "UIKit",
                          "AppKit", "CoreGraphics", "CoreData", "CoreFoundation", "ObjectiveC",
                          "Darwin", "Glibc"]

    // Project-file imports: 'import Geom' looks for Geom.swift (a dotted 'import A.B'
    // for A/B.swift, then A.swift) under the program's directory and the -i roots. The
    // file is parsed with this grammar; its top-level declarations are stashed by
    // buildMain (importDepth > 0) and prepended to jsmain. A file is imported once;
    // repeats and cycles are no-ops.
    var importedFiles = {}
    var importDepth = 0
    // imported files top-level items: stashImported / emitImported (compile-core)
    core.importFile = function(path, pos) {
        var rel = path.split(".").join("/")
        var cands = [rel + ".swift"]
        var cut = -1
        for (var k = 0; k < rel.length; k++) { if (rel.charAt(k) == "/") { cut = k } }
        if (cut > 0) { cands.push(rel.substring(0, cut) + ".swift") }
        for (var i = 0; i < cands.length; i++) {
            var file = c.findImport(cands[i])
            if (file == "") { continue }
            if (importedFiles["$" + file] == true) { return true }
            importedFiles["$" + file] = true
            var text = c.readFile(file)
            var asg = c.parse(c.agrammar, text, null, file)
            c.pushSource(file, text)
            importDepth = importDepth + 1
            c.compile(asg)
            importDepth = importDepth - 1
            c.popSource()
            return true
        }
        return false
    }

    // ----- try/catch and throw (Swift has no finally) -----
    // Each do/catch body compiles to its own IR closure handed to js_try (jsrt.go): it
    // runs the try under a Go recover and routes a thrown value to the catch closure (a
    // one-parameter function bound to the catch name). The first catch clause wins.
    // makeCatch is shared - see lib/compile-core.js.
    // items = [{cpat}..., {cwhere}?, bodyThunk]
    function makeCatchClause(items) {
        var pats = []
        var whereT = null
        var body = null
        for (var i = 0; i < items.length; i++) {
            var it = items[i]
            if (it == undefined) { continue }
            if (typeof it == "function") { body = it }
            else if (it.cpat != undefined) { pats.push(it.cpat) }
            else if (it.cwhere != undefined) { whereT = it.cwhere }
        }
        return {catchbody: body, pats: pats, whereT: whereT}
    }
    // The whole catch chain becomes ONE catch closure taking `error`: it tests each
    // clause's patterns in turn and runs the first that matches, and re-throws when
    // none does so an outer do still sees the error. Swift has no finally.
    function makeTry(items) {
        var tryT = anytype
        var clauses = []
        for (var i = 0; i < items.length; i++) {
            if (items[i].trybody != undefined) { tryT = items[i].trybody }
            else if (items[i].catchbody != undefined) { clauses.push(items[i]) }
        }
        var catchBody = null
        if (clauses.length > 0) {
            catchBody = function(b) {
                var errV = b.NewCall(rtKGet(), [curScopeV, emitStr(b, "error")])
                var rethrowB = curF.NewBlock("")
                var doneB = curF.NewBlock("")
                for (var k = 0; k < clauses.length; k++) {
                    var cl = clauses[k]
                    var runB = curF.NewBlock("")
                    var nextB = curF.NewBlock("")
                    if (cl.pats.length == 0) {
                        b.NewBr(runB)
                    } else {
                        for (var q = 0; q < cl.pats.length; q++) {
                            var tryNext = curF.NewBlock("")
                            var okB = emitMatchPat(b, cl.pats[q], errV, false, tryNext)
                            if (cl.whereT != null) {
                                var rw = cl.whereT(okB)
                                rw.b.NewCondBr(truthy(rw.b, rw.v), runB, tryNext)
                            } else { okB.NewBr(runB) }
                            b = tryNext
                        }
                        b.NewBr(nextB)
                    }
                    cl.catchbody(runB).NewBr(doneB)
                    b = nextB
                }
                // No clause matched: keep unwinding so an outer do still sees it.
                b.NewBr(rethrowB)
                callExt(rethrowB, "js_throw", [errV])
                rethrowB.NewBr(doneB)
