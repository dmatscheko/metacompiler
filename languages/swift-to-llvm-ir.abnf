EachExpr    <~~ push(makeEach(pop())) ~~> = "each" KwEnd EachStart UnaryExpr ;
EachStart   = :script(~~
    (function() {
        var i = 0
        var ch = c.peek(i)
        var cap = 0
        while ((ch === 32 || ch === 9 || ch === 10 || ch === 13) && cap < 4096) { i++; cap++; ch = c.peek(i) }
        var ok = (ch >= 97 && ch <= 122) || (ch >= 65 && ch <= 90) || ch === 95 || ch === 40
