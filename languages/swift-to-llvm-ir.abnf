    function swBoundDigits(w, u, isMax) {
        if (u) {
            if (!isMax) { return "0" }
            if (w == 64) { return "18446744073709551615" }
            if (w == 32) { return "4294967295" }
            if (w == 16) { return "65535" }
            return "255"
        }
        if (w == 64) { return isMax ? "9223372036854775807" : "-9223372036854775808" }
        if (w == 32) { return isMax ? "2147483647" : "-2147483648" }
