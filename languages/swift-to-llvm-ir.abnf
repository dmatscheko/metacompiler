    function swRawMlOpen(t) {
        if (t.length < 3 || t.charCodeAt(0) != 34 || t.charCodeAt(1) != 34) { return false }
        var i = 2
        while (i < t.length && (t.charCodeAt(i) == 32 || t.charCodeAt(i) == 9)) { i++ }
        return i < t.length && (t.charCodeAt(i) == 10 || t.charCodeAt(i) == 13)
