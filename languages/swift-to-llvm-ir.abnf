    function makeWhileL(items) {
        var lbl = itemLbl(items)
        var rest = itemsAfterLbl(items)
        var condT = rest[0]
        var bodyT = rest[1]
        return function(b) {
            var headB = curF.NewBlock("")
            var bodyB = curF.NewBlock("")
            var exitB = curF.NewBlock("")
            b.NewBr(headB)
            var r = condT(headB)
            r.b.NewCondBr(truthy(r.b, r.v), bodyB, exitB)
            loopStack.push({cont: headB, brk: exitB, lbl: lbl})
            bodyT(bodyB).NewBr(headB)
            loopStack.pop()
