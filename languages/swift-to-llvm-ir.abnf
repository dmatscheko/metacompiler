// chain nil instead of failing. Adjacent, and not the start of ?? or a ternary.
OptSfx      <~~ push({kind:"opt"}) ~~> = NoSpace "?" NotChar63 ;
NotChar61   = :script(~~
    (function() { return (c.peek(0) === 61) ? abnf.newToken("\x01eq-follows", 0) : undefined })()
~~) ;
NotChar63   = :script(~~
    (function() { return (c.peek(0) === 63) ? abnf.newToken("\x01q-follows", 0) : undefined })()
~~) ;
MethodSfx   <~~ push({kind:"mcall", name: popName(), args: takeAll()}) ~~>
