    // the item list of the first branch whose condition is not statically false.
    // Nothing here evaluates os(...) / canImport(...) / swift(>=...): an ordinary
    // condition is treated as live, so the first branch wins.
    function poundLive(s) {
        var t = stripWs(s)
        if (t == "false") { return false }
        if (t == "0") { return false }
        return true
    }
    function poundPick(items) {
        var i = 0
        while (i + 1 < items.length) {
            if (poundLive(items[i].pcond)) { return items[i + 1].branch }
            i = i + 2
        }
        return []
    }
    function makeFunStmt(f) {
        regSig(f.name, f.params)
        var key = "$" + f.name
        var lst = hasOwn(funcOverloads, key) ? funcOverloads[key] : null
        if (lst == null) { lst = []; funcOverloads[key] = lst }
        lst.push({f: f})
        var slot = f.name + "$" + lst.length
        return function(b) {
            var idx = emitFunc(f.params, f.body, false, false, f.rlabels, f.rtype)
            var cloV = callExt(b, "js_closure", [handle(idx), curScopeV])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, slot), cloV])
            if (lst.length == 1) {
                callExt(b, "js_scope_decl", [curScopeV, emitStr(b, f.name), cloV])
            } else {
                var didx = emitOverloadDispatch(f.name, lst)
                callExt(b, "js_scope_decl", [curScopeV, emitStr(b, f.name),
                                             callExt(b, "js_closure", [handle(didx), curScopeV])])
            }
            return b
        }
    }
    // A nested function is the same declaration run as a statement of its body: the
    // closure is created over the current scope, so it captures the surrounding
    // locals and can call itself.
    function makeLocalFunStmt(f) { return makeFunStmt(f) }

    // The emitted overload dispatcher: for each candidate, in declaration order,
    // check the argument count against its required/maximum arity and the type of
    // every argument that has a declared parameter type, then tail-call it.
    function emitOverloadDispatch(name, lst) {
        funcCount++
        var idx = funcCount
        var f = m.NewFunc("jsf_" + idx, i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var savedF = curF
        var savedScope = curScopeV
        var savedLoops = loopStack
        var savedTag = curFTag
        curF = f
        curFTag = idx
        loopStack = []
        var b = f.NewBlock("entry")
        var sc = callExt(b, "js_scope_new", [f.Params[0]])
        var argsV = f.Params[1]
        var nargs = callExt(b, "js_pylen", [argsV])
        for (var k = 0; k < lst.length; k++) {
            var P = lst[k].f.params
            var nextB = curF.NewBlock("")
            var req = 0
            var varia = false
            for (var q = 0; q < P.length; q++) {
                if (P[q].variadic) { varia = true }
                else if (!P[q].hasDefault) { req++ }
            }
            var okB = curF.NewBlock("")
            b.NewCondBr(truthy(b, callExt(b, "js_ge", [nargs, emitNum(b, req)])), okB, nextB)
            b = okB
            if (!varia) {
                var okB2 = curF.NewBlock("")
                b.NewCondBr(truthy(b, callExt(b, "js_le", [nargs, emitNum(b, P.length)])), okB2, nextB)
                b = okB2
            }
            for (var j = 0; j < P.length; j++) {
                if (P[j].variadic || P[j].type == "") { continue }
                var haveB = curF.NewBlock("")
                var contB = curF.NewBlock("")
                b.NewCondBr(truthy(b, callExt(b, "js_le", [nargs, emitNum(b, j)])), contB, haveB)
                var tv = callExt(haveB, "js_is_type", [callExt(haveB, "js_arg", [argsV, handle(j)]),
                                                       emitStr(haveB, P[j].type)])
                haveB.NewCondBr(truthy(haveB, tv), contB, nextB)
                b = contB
            }
            var fv = b.NewCall(rtKGet(), [sc, emitStr(b, name + "$" + (k + 1))])
            b.NewRet(callExt(b, "js_call", [fv, hUndef, argsV]))
            b = nextB
        }
        var fv0 = b.NewCall(rtKGet(), [sc, emitStr(b, name + "$1")])
        b.NewRet(callExt(b, "js_call", [fv0, hUndef, argsV]))
        curF = savedF
        curScopeV = savedScope
        loopStack = savedLoops
        curFTag = savedTag
        return idx
    }
    // items = [name, {tlabels}? | {itype}?, initThunk?]
    // A numeric declared type adopts, exactly as it does on a local: `struct T { var
    // a: Double = 3 }` stores 3.0, and `T(a: 3)` binds 3.0 through the memberwise
    // initializer's parameter (memberwiseParams copies `ty` into its `adopt`).
    function makeProp(items) {
        var k = 1
        var ty = ""
        if (items[k] != undefined && items[k].tlabels != undefined) { k++ }
        else if (items[k] != undefined && items[k].itype != undefined) { ty = items[k].itype; k++ }
        if (items[k] != undefined) { return {prop: items[0], ty: ty, hasInit: true, init: items[k]} }
        return {prop: items[0], ty: ty, hasInit: false, init: null}
    }
    function plainParam(n) {
        return {name: n, label: n, type: "", adopt: "", variadic: false, auto: false,
                inout: false, hasDefault: false, dflt: null}
    }
    // A multi-parameter subscript index (`g[r, c]`) travels as one {__idxs} value, so
    // every existing single-key path (arrays, dictionaries, strings) is untouched.
    function makeIndexKey(items) {
        if (items.length == 1) { return items[0] }
        return function(b) {
            var arr = callExt(b, "js_arr_new", [])
            for (var i = 0; i < items.length; i++) {
                var r = items[i](b)
                b = r.b
                callExt(b, "js_arr_push", [arr, r.v])
            }
            var o = callExt(b, "js_obj_new", [])
            callExt(b, "js_set", [o, emitStr(b, "__idxs"), arr])
            return {b: b, v: o}
        }
    }

    // ----- Computed properties and property observers -----
    // Both are written `var x [: T] [= e] { ACCESSORS }`; which accessors the braces
    // hold decides which one it is. A computed property becomes a pair of ordinary
    // methods `__get_x` / `__set_x` on the type (js_defprop accessors never see their
    // receiver in a C-style emitter - see the gotchas doc); an OBSERVED stored
    // property keeps its value under the hidden name `__v_x` and gets the same pair.
    function makeAccessor(items) {
        var kind = ""
        var param = null
        var body = null
        for (var i = 0; i < items.length; i++) {
            var it = items[i]
            if (it == undefined) { continue }
            if (it.akind != undefined) { kind = stripWs(it.akind) }
            else if (it.aparam != undefined) { param = it.aparam }
            else if (it.abody != undefined) { body = it.abody }
        }
        return {acc: {kind: kind, param: param, body: body}}
    }
    function makeImplicitGetter(body) { return {acc: {kind: "get", param: null, body: body}} }
    function makeComputed(items) {
        var name = items[0]
        var dflt = null
        var get = null
        var set = null
        var setP = "newValue"
        var will = null
        var willP = "newValue"
        var did = null
        var didP = "oldValue"
        for (var i = 1; i < items.length; i++) {
            var it = items[i]
            if (it == undefined) { continue }
            if (it.pdefault != undefined) { dflt = it.pdefault; continue }
            if (it.acc == undefined) { continue }
            var a = it.acc
            if (a.kind == "get" || a.kind == "_read") { get = a.body }
            else if (a.kind == "set" || a.kind == "_modify") { set = a.body; if (a.param != null) { setP = a.param } }
            else if (a.kind == "willSet") { will = a.body; if (a.param != null) { willP = a.param } }
            else if (a.kind == "didSet") { did = a.body; if (a.param != null) { didP = a.param } }
        }
        var observed = (will != null || did != null)
        if (get != null || observed) { computedNames["$" + name] = 1 }
        if (set != null || observed) { setterNames["$" + name] = 1 }
        return {cprop: {name: name, get: get, set: set, setP: setP, will: will, willP: willP,
                        did: did, didP: didP, observed: observed, dflt: dflt}}
    }
    // items = [{params}, {acc}...] -> the __sub_get / __sub_set method records.
    function makeSubscript(items) {
        hasSubscript = true
        var params = items[0].params
        var get = null
        var set = null
        var setP = "newValue"
        for (var i = 1; i < items.length; i++) {
            var it = items[i]
            if (it == undefined || it.acc == undefined) { continue }
            var a = it.acc
            if (a.kind == "get" || a.kind == "_read") { get = a.body }
            else if (a.kind == "set" || a.kind == "_modify") { set = a.body; if (a.param != null) { setP = a.param } }
        }
        var out = []
        if (get != null) { out.push({method: {name: "__sub_get" + params.length, params: params, body: get}}) }
        if (set != null) {
            var sp = []
            for (var k = 0; k < params.length; k++) { sp.push(params[k]) }
            sp.push(plainParam(setP))
            out.push({method: {name: "__sub_set" + params.length, params: sp, body: set}})
        }
        return out
    }
    // The property names some type computes, the ones it can set, and the method names
    // some type declares. A member read/write or an unqualified name is emitted as an
    // accessor/method dispatch exactly when the program uses that name that way, so a
    // program that declares none emits precisely the IR it did before.
    var computedNames = {}
    var setterNames = {}
    var memberMethods = {}
