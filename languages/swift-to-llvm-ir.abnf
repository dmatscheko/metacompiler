RawScan     = :script(~~
    (function() {
        var i = 0
        var ch = c.peek(i)
        var cap = 0
        while ((ch === 32 || ch === 9 || ch === 10 || ch === 13) && cap < 100000) {
            i++; cap++; ch = c.peek(i)
        }
