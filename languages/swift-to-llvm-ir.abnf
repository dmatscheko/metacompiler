    function makeAssign(items) {
        var ref = items[0]
        var op = items[1]
        var valT = items[2]
        return function(b) {
            var r = valT(b)
            b = r.b
            var v = emitCopy(b, r.v)
            if (ref.path.length == 0) {
                // `_ = expr` evaluates and throws the value away.
                if (ref.name == "_") { return {b: b, v: v} }
                var nameV = emitStr(b, ref.name)
                if (op != "=") {
                    var old = b.NewCall(rtKGet(), [curScopeV, nameV])
                    v = emitBin(b, op, old, v)
                }
                // An unqualified write inside a member body may target a computed,
                // observed or wrapped property, which lives behind __set_x rather
                // than in the scope chain or among this's own properties.
                if (isSetterName(ref.name)) {
                    var tv2 = callExt(b, "js_scope_typeof", [curScopeV, nameV])
                    var localB2 = curF.NewBlock("")
                    var selfB2 = curF.NewBlock("")
                    var joinB2 = curF.NewBlock("")
                    b.NewCondBr(truthy(b, callExt(b, "js_seq", [tv2, emitStr(b, "undefined")])), selfB2, localB2)
                    localB2.NewCall(rtKSet(), [curScopeV, nameV, v])
                    localB2.NewBr(joinB2)
                    selfB2.NewCall(rtSetProp(), [selfB2.NewCall(rtKGet(), [curScopeV, emitStr(selfB2, "self")]), nameV, v])
                    selfB2.NewBr(joinB2)
                    return {b: joinB2, v: v}
