    // A line break, optional spaces/tabs, then `""`: the multi-line closer's head.
    function swRawMlClose(t) {
        if (t.length < 3 || t.charCodeAt(t.length - 1) != 34 || t.charCodeAt(t.length - 2) != 34) { return false }
        var i = t.length - 3
        while (i >= 0 && (t.charCodeAt(i) == 32 || t.charCodeAt(i) == 9)) { i-- }
        return i >= 0 && (t.charCodeAt(i) == 10 || t.charCodeAt(i) == 13)
