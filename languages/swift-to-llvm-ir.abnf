            = Id <~~ push(up.in) ~~> TrailArg LabTrail { LabTrail } ;

// String interpolation: "sum = \(a + b)".
Template    <~~ push(makeTemplate(takeAll())) ~~>
            = '"' :whitespace() { TplExpr | TplChunk } '"' :whitespace(Whitespace) ;
// A LABEL is allowed inside an interpolation - `"[\\(foo: x)]"` - because
// ExpressibleByStringInterpolation lets a type declare labelled
// appendInterpolation overloads. The label names nothing here and is dropped.
TplExpr     <~~ push({e: takeAll()[0]}) ~~>
