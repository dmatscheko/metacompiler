    // Swift string escapes. Like interp-core's unescapeJs plus \u{...}, whose payload
    // is a Unicode SCALAR: above U+FFFF it becomes a surrogate pair.
    function swUnescape(str) {
        var out = ""
        var i = 0
        while (i < str.length) {
            var c1 = str.charCodeAt(i)
            // A RAW astral character in the source (an emoji written as itself
            // rather than as \u{...}) is TWO code units, and copying it one unit at
            // a time hands a LONE SURROGATE to the host, which cannot encode one in
            // UTF-8 and answers U+FFFD. Copy the pair in ONE substring.
            // Twin in swift-interpreter.abnf.
            if (c1 != 92) {
                if (c1 >= 0xD800 && c1 <= 0xDBFF && i + 1 < str.length) {
                    out += str.substring(i, i + 2)
                    i += 2
                    continue
                }
                out += str.charAt(i)
                i++
                continue
            }
            var e = str.charCodeAt(i + 1)
            if (e == 110) { out += "\n"; i += 2; continue }
            if (e == 116) { out += "\t"; i += 2; continue }
            if (e == 114) { out += "\r"; i += 2; continue }
            if (e == 48) { out += String.fromCharCode(0); i += 2; continue }
            // A backslash before a line break ELIDES it (the multi-line literal's
            // line continuation); both spellings of the break.
            if (e == 10) { i += 2; continue }
            if (e == 13) { i += 2; if (str.charCodeAt(i) == 10) { i++ } ; continue }
            // ... and a backslash followed by trailing spaces/tabs and THEN a line
            // break elides the whole run, which real swift does too.
            if (e == 32 || e == 9) {
                var j3 = i + 1
                while (j3 < str.length && (str.charCodeAt(j3) == 32 || str.charCodeAt(j3) == 9)) { j3++ }
                if (str.charCodeAt(j3) == 10) { i = j3 + 1; continue }
                if (str.charCodeAt(j3) == 13) {
                    i = j3 + 1
                    if (str.charCodeAt(i) == 10) { i++ }
                    continue
                }
            }
            if (e == 117 && str.charCodeAt(i + 2) == 123) {
                var j = i + 3
                var cp = 0
                while (j < str.length && str.charCodeAt(j) != 125) {
                    var h = str.charCodeAt(j)
                    var d = 0
                    if (h >= 48 && h <= 57) { d = h - 48 }
                    else if (h >= 97 && h <= 102) { d = h - 87 }
                    else if (h >= 65 && h <= 70) { d = h - 55 }
                    cp = cp * 16 + d
                    j++
                }
                out += codePointStr(cp)
                i = j + 1
                continue
            }
            out += String.fromCharCode(e)
            i += 2
        }
        return out
    }
    function codePointStr(cp) {
        if (cp < 0x10000) { return String.fromCharCode(cp) }
        var v = cp - 0x10000
        return String.fromCharCode(0xD800 + ((v / 1024) | 0)) + String.fromCharCode(0xDC00 + (v % 1024))
    }
    // A multi-line literal: the indentation of the CLOSING delimiter is removed from
    // every line, and the newline that follows the opening delimiter and the one that
    // precedes the closing one are not part of the value.
    function makeMultiStr(items) { return makeTemplate(swMlLayout(items, 0)) }
    // The layout of a multi-line literal's chunks. rawLvl 0 is the escaped form; a
    // raw literal (rawLvl = its pound count) only honours escapes at its own level.
    function swMlLayout(items, rawLvl) {
        var parts = []
        for (var i = 0; i < items.length; i++) { parts.push(items[i]) }
        var indent = ""
        for (var k = parts.length - 1; k >= 0; k--) {
            if (parts[k].s == undefined) { break }
            var t = parts[k].s
            var cut = -1
            for (var j = 0; j < t.length; j++) { if (t.charAt(j) == "\n") { cut = j } }
            if (cut < 0) { continue }
            var tail = t.substring(cut + 1)
            var ok = true
            for (var q = 0; q < tail.length; q++) {
                var ch = tail.charAt(q)
                if (ch != " " && ch != "\t") { ok = false }
            }
            if (ok) { indent = tail }
            break
        }
        var out = []
        for (var n = 0; n < parts.length; n++) {
            if (parts[n].s == undefined) { out.push(parts[n]); continue }
            var txt = parts[n].s
            if (n == 0) { txt = dropFirstLine(txt) }
            if (n == parts.length - 1) { txt = dropLastLine(txt) }
            out.push({s: swUnescape(swRawEsc(stripIndent(txt, indent), rawLvl))})
        }
        return out
    }
    function dropFirstLine(t) {
        for (var i = 0; i < t.length; i++) { if (t.charAt(i) == "\n") { return t.substring(i + 1) } }
        return t
    }
    function dropLastLine(t) {
        var cut = -1
        for (var i = 0; i < t.length; i++) { if (t.charAt(i) == "\n") { cut = i } }
        if (cut < 0) { return t }
        return t.substring(0, cut)
