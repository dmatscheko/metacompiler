    // ----- Patterns and binding conditions -----
    // A pattern is {opt: n, core: k}: n trailing `?` (an optional pattern, which
    // fails on nil and matches the unwrapped value) around one core form.
    function makePattern(items) {
        var n = 0
        for (var i = 1; i < items.length; i++) { n++ }
        return {opt: n, core: items[0]}
    }
    // [ "." ] path [ ( subpatterns ) ] - an enum case reference, or (under a `let`)
    // a plain name to bind.
    function makePatEnum(items) {
        var dot = false
        var path = ""
        var args = null
        for (var i = 0; i < items.length; i++) {
            if (items[i].pdot != undefined) { dot = true }
            else if (items[i].ppath != undefined) { path = items[i].ppath }
            else if (items[i].pargs != undefined) { args = items[i].pargs }
        }
        return {pdot: dot, ppath: path, pargs: args}
