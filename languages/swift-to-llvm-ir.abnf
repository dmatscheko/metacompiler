    function stripIndent(t, indent) {
        if (indent == "") { return t }
        var out = ""
        var i = 0
        var atLineStart = true
        while (i < t.length) {
            if (atLineStart && t.substring(i, i + indent.length) == indent) { i += indent.length }
            atLineStart = t.charAt(i) == "\n"
            out += t.charAt(i)
            i++
