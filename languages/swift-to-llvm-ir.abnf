    // A type declared with @propertyWrapper - recognised by the wrappedValue member
    // it declares rather than by the attribute, so the attribute stays parse-and-drop.
    var wrapperNames = {}
    function isWrapperName(n) { return hasOwn(wrapperNames, "$" + n) }
    function declaresWrappedValue(mem) {
        for (var i = 0; i < mem.comps.length; i++) { if (mem.comps[i].name == "wrappedValue") { return true } }
        for (var j = 0; j < mem.fields.length; j++) { if (mem.fields[j].name == "wrappedValue") { return true } }
