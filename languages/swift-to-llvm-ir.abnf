    function emitMatchCore(b, k, v, binding, failB) {
        if (k.pwild != undefined) { return b }
        if (k.pexpr != undefined) {
            var re = k.pexpr(b)
            var okE = curF.NewBlock("")
            re.b.NewCondBr(truthy(re.b, emitBin(re.b, "==", v, re.v)), okE, failB)
            return okE
        }
        if (k.prange != undefined) {
            var rg = k.prange
            if (rg.lo != null) {
                var rl = rg.lo(b)
                var okL = curF.NewBlock("")
                rl.b.NewCondBr(truthy(rl.b, callExt(rl.b, "js_ge", [v, rl.v])), okL, failB)
                b = okL
            }
            if (rg.hi != null) {
                var rh = rg.hi(b)
                var okH = curF.NewBlock("")
                var cmp = rg.rop == "..<" ? "js_lt" : "js_le"
                rh.b.NewCondBr(truthy(rh.b, callExt(rh.b, cmp, [v, rh.v])), okH, failB)
