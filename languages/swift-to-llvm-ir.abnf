// the same accessors a property's are, and only willSet/didSet are accepted here.
LocalObs    <~~ push({lobs: takeAll()}) ~~> = "{" ObsAccessor { ObsAccessor } "}" ;
ObsAccessor <~~ push(makeAccessor(takeAll())) ~~>
            = ObsKind <~~ push({akind: up.in}) ~~> [ AccParam ] AccBody ;
ObsKind     = ( "willSet" | "didSet" ) KwEnd ;
