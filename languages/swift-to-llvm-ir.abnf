    function swEmitBound(b, w, u, isMax) {
        return callExt(b, "js_gilit", [emitStr(b, swBoundDigits(w, u, isMax)),
                                       emitNum(b, 10), emitNum(b, w), u ? hTrue : hFalse])
    }
    // Int(x) / UInt8(x) / ...: js_swintconv wraps to the width (and is FAILABLE for
    // a String source, where Swift answers nil).
    function swEmitConv(b, v, it) {
        return callExt(b, "js_swintconv", [v, emitNum(b, it.w), it.u ? hTrue : hFalse])
    }
    // A callable VALUE backed by one extern: jsf_N(env, args) reads `arity`
    // arguments and returns extName(...). abs/max/min need it because the Swift
    // spellings are Double-aware externs rather than the shared Math members, and
    // the program calls them like any other function value.
    function emitExtFn(b, extName, arity) {
        funcCount++
        var idx = funcCount
        var f = m.NewFunc("jsf_" + idx, i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        var savedF = curF
        var savedScope = curScopeV
        curF = f
        var fb = f.NewBlock("entry")
        curScopeV = callExt(fb, "js_scope_new", [f.Params[0]])
        var argv = []
        for (var i = 0; i < arity; i++) { argv.push(callExt(fb, "js_arg", [f.Params[1], handle(i)])) }
        fb.NewRet(callExt(fb, extName, argv))
        curF = savedF
        curScopeV = savedScope
        return callExt(b, "js_closure", [handle(idx), curScopeV])
    }
    // ----- Double: the boxed float (see the "Doubles" note in abnf/jsrtswift.go) -----
    // A float LITERAL emits the box, so `7.0 / 2.0` is 3.5 where the two operands
    // were otherwise indistinguishable from `7 / 2` and divided as integers.
    // The twin of swFlo in swift-interpreter.abnf.
    function makeFloConst(f) {
        return function(b) { return {b: b, v: callExt(b, "js_swflo", [emitNum(b, f)])} }
    }
    // 0xC.8p0: a hexadecimal mantissa scaled by a DECIMAL power-of-two exponent.
    // Written out rather than handed to parseFloat, which does not accept the form.
    function parseHexFloat(s) {
        var v = 0
        var scale = 1
        var seenDot = false
        var i = 2
        while (i < s.length) {
            var cc = s.charCodeAt(i)
            i++
            if (cc == 95) { continue }
            if (cc == 46) { seenDot = true; continue }
            if (cc == 112 || cc == 80) { break }
            var d = 0
            if (cc >= 48 && cc <= 57) { d = cc - 48 }
            else if (cc >= 97 && cc <= 102) { d = cc - 87 }
            else if (cc >= 65 && cc <= 70) { d = cc - 55 }
            if (seenDot) { scale = scale / 16; v = v + d * scale } else { v = v * 16 + d }
        }
        var esign = 1
        if (i < s.length && s.charCodeAt(i) == 43) { i++ }
        else if (i < s.length && s.charCodeAt(i) == 45) { esign = 0 - 1; i++ }
        var exp = 0
        while (i < s.length) {
            var c2 = s.charCodeAt(i)
            i++
            if (c2 < 48 || c2 > 57) { continue }
            exp = exp * 10 + (c2 - 48)
        }
        exp = exp * esign
        var mul = 1
        var k = 0
        if (exp >= 0) { for (k = 0; k < exp; k++) { mul = mul * 2 } }
        else { for (k = 0; k < 0 - exp; k++) { mul = mul / 2 } }
