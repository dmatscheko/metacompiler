                        if (of.hasInit) { mem.initProps.push(of) }
                    }
                }
            } else if (it.method != undefined) {
                memberMethods["$" + it.method.name] = 1
                if (isStatic && isOperatorName(it.method.name)) { hasOpOverload = true }
                if (isStatic) {
                    mem.statMethods.push(it.method)
                    if (!isOperatorName(it.method.name)) { swStatMeths["$" + it.method.name] = 1 }
                } else {
                    mem.methods.push(it.method)
                    if (it.method.name == "init") { mem.hasInit = true }
