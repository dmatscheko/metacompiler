:title("Ruby (subset) to LLVM IR compiler") ;
:description("Compiles a Ruby subset to an LLVM IR module and runs it with the built-in
IR interpreter and the MetaJS handle runtime (llvm.RunJS).

The subset matches ruby-interpreter.abnf: local variables (create on first assignment,
plus += -= *= /= %=), integers, double/single quoted strings with '#{expr}'
interpolation, true/false/nil, symbols :sym (as strings), arithmetic and comparison,
&& || ! and the words and/or/not, def with implicit return of the last expression and
explicit return, class C ... end with instance methods, @ivars and C.new, if/elsif/else
and unless (also as expressions), while/until with break/next, ranges 1..5 / 1...5
(eager arrays) with .each, arrays with [] get/set, .push/.pop/.size/.length/.each/.map/
.select/.include?, hashes {k => v} with [] get/set, .size/.keys/.values, blocks
(do |x| ... end and { |x| ... }, real closures via js_closure) and puts/print.

Locals, functions, @ivars, methods and blocks lower to the MetaJS handle runtime:
scopes via js_scope_new / js_pyset_var (Ruby create-on-assign) / js_scope_get, closures
via js_closure + js_call, objects/@ivars via js_obj_new / js_get / js_set, method
dispatch via js_rmcall (the Ruby builtin methods on strings/arrays/hashes with Ruby
truthiness and nil-on-empty; instances carry a __class descriptor, C.new runs initialize),
arrays via js_arr_new / js_arr_push, indexing via js_pyget / js_pyset, hashes via
js_dict_new. Ruby truthiness (only nil and false are falsy) is a single handle compare
(a value handle >= the 'true' singleton). The whole program becomes jsmain(env, args);
a self checking program ends with exit(failures). The same subset is interpreted
directly by ruby-interpreter.abnf, and the two must agree.") ;
// --- main rules

// Shared token productions (languages/lib): identifiers, integers, booleans.
:include("lib/ident.abnf") ;
:include("lib/numbers.abnf") ;
:include("lib/bools.abnf") ;

:startRule(Program) ;
:whitespace(Whitespace) ;

// Ruby '#' line comments (the '#{' of an interpolation lives inside a string
// token, which disables whitespace skipping, so it never reaches here).
Whitespace  = { @+" \t\r\n" | Comment } ;
Comment     = "#" :whitespace() { NotNewline } :whitespace(Whitespace) ;
NotNewline  = "\x00"..."\x09" | "\x0b"..."\U0010ffff" ;

// The whole program is a sequence of definitions and statements executed in order.
Program     <~~ buildMain(takeAll()) ~~>
            = { Def <~~ push(makeDefStmt(pop())) ~~> | ClassDecl | ModuleDecl | Statement } ;

// module M ... end: accepted but not implemented (no namespacing). Its body is a
// program of the same items; under -warn-unsupported they run in the current scope
// so any defs/classes/calls stay visible. A nested module recurses.
ModuleDecl  <~~ push(makeModuleStmt(takeAll())) ~~>
            = KwModule ScopedName <~~ push(up.in) ~~>
              { Semi | Def <~~ push({method: pop()}) ~~> | ClassDecl <~~ push({nested: pop()}) ~~>
              | ModuleDecl <~~ push({nested: pop()}) ~~> | AliasStmt | ClassBodyStmt } End ;
// A constant path Foo::Bar::Baz (module / class name or a scoped reference).
ScopedName  = Name { "::" Name } ;

// A def: implicit return of the last expression, or an explicit return. A singleton
// receiver (def self.m / def obj.m) is accepted but not implemented (routed as a
// plain method of that name). The parameter list accepts default / splat / double-
// splat / block / keyword parameters; the fancy forms are notImplemented (the method
// is still built with the parameter names, so its body stays compilable).
Def         <~~ push(makeFun(takeAll())) ~~>
            = KwDef [ SelfRecv ] MethodName <~~ push(up.in) ~~> [ ParamList ] DefTail ;
// An endless def (def sq(x) = x * x) has an EXPRESSION body and no `end`; the
// ordinary body may carry rescue/else/ensure clauses with no `begin` of their own.
DefTail     = EndlessBody | GuardedBody ;
EndlessBody <~~ push({body: pop()}) ~~>
            = "=" !"=" Expression ;
GuardedBody <~~ push({body: makeGuardedBody(takeAll())}) ~~>
            = Body <~~ push({trybody: pop().body}) ~~> { RescueClause }
              [ KwElse Body <~~ push({elsebody: pop().body}) ~~> ]
              [ KwEnsure Body <~~ push({finalbody: pop().body}) ~~> ] End ;
// def self.m: a method of the class object itself, not of its instances.
SelfRecv    <~~ push({selfrecv: true}) ~~>
            = ( KwSelf | Name ) "." ;
ParamList   = "(" [ Param { "," Param } ] ")" ;
Param       = ParamDSplat | ParamSplat | ParamBlock | ParamKw | ParamDefault | ParamSimple ;
ParamDSplat <~~ var n = takeAll(); push({param: n.length > 0 ? n[0] : null, kwrest: true}) ~~>
            = "**" [ Name <~~ push(up.in) ~~> ] ;
ParamSplat  <~~ var n = takeAll(); push({param: n.length > 0 ? n[0] : null, splat: true}) ~~>
            = "*" !"*" [ Name <~~ push(up.in) ~~> ] ;
// &blk: the block the call was given, received as an ordinary named parameter.
ParamBlock  <~~ push({param: pop(), blockp: true}) ~~>
            = "&" Name <~~ push(up.in) ~~> ;
// name: / name: DEFAULT - a keyword parameter, filled from the call's trailing hash.
ParamKw     <~~ var n = takeAll(); push({param: n[0], kw: true, defT: n.length > 1 ? n[1] : undefined}) ~~>
            = Name <~~ push(up.in) ~~> ":" !":" [ Expression ] ;
ParamDefault <~~ var n = takeAll(); push({param: n[0], defT: n[1]}) ~~>
            = Name <~~ push(up.in) ~~> "=" !"=" Expression ;
ParamSimple = Name <~~ push({param: up.in}) ~~> ;
// Method / call names may end with ? or ! (empty?, include?); Name may not. A def
// may equally name an OPERATOR (def +, def -@, def [], def []=, def <=>), which is
// how a class joins the operator table - the longest spelling comes first (PEG).
MethodName  = OpMethodName | Id [ "?" | "!" ] ;
OpMethodName = "[]=" | "[]" | "<=>" | "===" | "==" | "!=" | "<<" | ">>" | "<=" | ">="
            | "**" | "+@" | "-@" | "=~" | "+" | "-" | "*" | "/" | "%" | "<" | ">"
            | "&" | "|" | "^" | "~" | "!" ;

// class C ... end with instance methods; C.new builds an instance. attr_reader /
// attr_writer / attr_accessor declare @ivar getters/setters on the class.
// A superclass (class D < Base) is accepted but not implemented (no inheritance);
// the class body still compiles as its own methods.
ClassDecl   <~~ push(makeClassStmt(takeAll())) ~~>
            = KwClass Name <~~ push(up.in) ~~> [ Superclass ]
              { Semi | SingletonBlock | Def <~~ push({method: pop()}) ~~> | AttrDecl
              | AliasStmt | ClassBodyStmt } End ;
// class << self ... end: every def inside it is a method of the class object.
SingletonBlock <~~ push({sblock: takeAll()}) ~~>
            = KwClass "<<" KwSelf { Semi | Def <~~ push({method: pop()}) ~~> } End ;
// alias NEW OLD (a keyword, unlike alias_method which is an ordinary call).
AliasStmt   <~~ push({alias: takeAll()}) ~~>
            = KwAlias AliasName AliasName ;
AliasName   = ":" SymName <~~ push(up.in) ~~> | MethodName <~~ push(up.in) ~~> ;
// class D < Base: real inheritance (method lookup walks __super, and `super` calls
// the overridden method).
Superclass  = "<" Name <~~ push({supername: up.in}) ~~> ;
// Anything else in a class body - @@classvar = v, include M, private, alias - runs
// as an ordinary statement with `self` bound to the class object.
ClassBodyStmt <~~ push({cstmt: pop()}) ~~>
            = Statement ;
AttrDecl    <~~ push(makeAttr(takeAll())) ~~>
            = AttrKind <~~ push({akind: up.in}) ~~> AttrSym { "," AttrSym } ;
AttrKind    = ( "attr_accessor" | "attr_reader" | "attr_writer" ) KwEnd ;
AttrSym     = ":" SymName <~~ push({aname: up.in}) ~~> :whitespace(Whitespace) ;

End         = "end" KwEnd ;

// Body collects its statements into a single marker so the enclosing production
// (if/while/def/block) sees exactly one item on the stack for its body.
Body        <~~ push({body: makeBody(takeAll())}) ~~>
            = { Statement } ;

// Every statement pushes exactly one thunk: function() -> value | signal.
// A statement may be a post-condition loop (begin..end while/until COND, runs its
// body at least once) or carry a trailing modifier (STMT if/unless/while/until
// COND). A modifier only binds when its keyword sits on the SAME source line as
// the statement (SameLine), so a block 'if'/'while' that opens the next line stays
// a separate statement.
// A bare ';' is an empty statement: Ruby uses it as a statement separator, and it
// appears immediately after a def / class / module header (def f(x); BODY; end).
// Semi pushes nothing, so a body simply skips it.
Statement   = Semi | Require | DoWhileStmt | ModStmt ;
Semi        = ";" ;
DoWhileStmt <~~ push(makeDoWhile(takeAll())) ~~>
            = KwBegin Body End SameLine DoWhileKw Expression ;
DoWhileKw   = KwWhile <~~ push({dw: "while"}) ~~> | KwUntil <~~ push({dw: "until"}) ~~> ;
ModStmt     <~~ push(applyMod(takeAll())) ~~>
            = SimpleStmt [ SameLine ModKw Expression ] ;
SimpleStmt  = PutsStmt | MultiAssign | AppendStmt | CommandStmt | ExprStmt ;
// NAME arg[, arg] [block]: the parenthesis-less command call (`describe "x" do .. end`,
// `include Comparable`, `alias_method :other, :real`). It lives at STATEMENT level
// only: inside an argument list `f(double, 21)` a bare name is a VALUE, not a call of
// the following arguments, and Ruby itself resolves that with the local-variable
// table a PEG parser does not have. CmdArgAhead is the spacing rule Ruby uses to tell
// `foo -1` (an argument) from `foo - 1` (a subtraction).
CommandStmt <~~ push(makeCall(takeAll())) ~~>
            = BareName <~~ push(up.in) ~~> SameLine CmdArgAhead Arg { "," Arg } [ Block ] ;
// TARGET << V [<< V]: Ruby strings are mutable, so `s << "bc"` has to update the
// variable itself. The append is therefore a statement form that WRITES BACK to its
// target - for an array that is the same object it already mutated in place, for a
// string it is the new value.
AppendStmt  <~~ push(makeAppendStmt(takeAll())) ~~>
            = Target "<<" !"<" AddExpr { "<<" AddExpr } ;
ModKw       = KwIf <~~ push({mod: "if"}) ~~> | KwUnless <~~ push({mod: "unless"}) ~~>
            | KwWhile <~~ push({mod: "while"}) ~~> | KwUntil <~~ push({mod: "until"}) ~~> ;

// require / require_relative <string>: Ruby has no import statement - require and
// require_relative are ordinary method calls, intercepted here. The single argument is
// a single- or double-quoted string literal (no interpolation); a leading './' and a
// missing '.rb' are handled by core.importFile. Tried as the FIRST statement form so a
// bareword 'require'/'require_relative' (both ordinary identifiers, not keywords) is not
// swallowed by a plain VarRef; a 'require' not followed by a string rolls back to the
// normal statement forms. resolveImport runs at PARSE time (like every other language's
// import): the required file is compiled with importDepth > 0, so its top-level thunks are
// stashed (buildMain) and prepended to jsmain, existing before the requiring file's code.
// A require that resolves to no project file is a stdlib require: a no-op when the name is
// in core.stdlibImports, otherwise it aborts (or warns under -warn-imports). Require pushes
// no thunk (the work is done at parse time), so buildMain never sees it.
Require     <~~ resolveImport(pop(), up.pos) ~~>
            = KwRequire ReqPath ;
KwRequire   = ( "require_relative" | "require" ) KwEnd ;
ReqPath     = SqPath | DqPath ;
SqPath      = "'" :whitespace() { SqEsc | SqPlain } <~~ push(unescapeSq(up.in)) ~~> "'" :whitespace(Whitespace) ;
DqPath      = '"' :whitespace() { DqEsc | DqPathChar } <~~ push(unescapeJs(up.in)) ~~> '"' :whitespace(Whitespace) ;
DqEsc       = "\\" "\x20"..b"\x7e" ;
DqPathChar  = "\x20"..."\x21" | "\x23"..."\x5b" | "\x5d"..."\U0010ffff" | @"\t" ;

// a, b = 1, 2 (and the swap a, b = b, a): every right-hand value is evaluated
// before any target is written; a single right-hand array is unpacked positionally.
// Kept at statement level (needs a comma after the first target) so it never
// interferes with a nested expression.
MultiAssign <~~ push(makeMultiAssign(takeAll())) ~~>
            = MTarget "," MTarget { "," MTarget } "=" Expression { "," Expression } [ ";" ] ;
// A multiple-assignment target: a splat target (*rest, which collects the leftover
// values into an array), a parenthesized nested group ((m, n), o = [5, 6], 7) or an
// ordinary target. Longest first, so *x and (x, y) are not read as a plain Target.
MTarget     = MSplat | MGroup | Target ;
MSplat      <~~ push({splat: pop()}) ~~>
            = "*" Target ;
MGroup      <~~ push({group: takeAll()}) ~~>
            = "(" MTarget "," MTarget { "," MTarget } ")" ;

// puts / print command form: puts x, puts a, b, puts (no args), puts(x).
PutsStmt    <~~ push(makePuts(takeAll())) ~~>
            = KwPuts <~~ push({cmd: up.in}) ~~> [ Expression { "," Expression } ] ;

ExprStmt    = Expression [ ";" ] ;

// Every expression pushes exactly one thunk: function() -> value. A ternary
// cond ? a : b binds looser than the boolean operators (like Ruby).
// The word forms and/or/not bind LOOSER than assignment in Ruby, which is the whole
// point of `x = false or true` (x is false, the `or true` is a separate step). They
// therefore sit ABOVE the assignment, in their own three levels, while the symbol
// forms && || ! keep their tight precedence inside OrExpr/AndExpr/NotExpr below.
Expression  = LowOr ;
LowOr       <~~ push(makeOrAnd(takeAll(), true)) ~~>
            = LowAnd { OrWord LowAnd } ;
LowAnd      <~~ push(makeOrAnd(takeAll(), false)) ~~>
            = LowNot { AndWord LowNot } ;
LowNot      = LowNotOp | RescueMod ;
// EXPR rescue FALLBACK: the expression modifier form of rescue. SameLine keeps it
// clear of a def-level `rescue` clause that opens the next line.
RescueMod   <~~ push(makeRescueMod(takeAll())) ~~>
            = AssignExpr [ SameLine KwRescue AssignExpr ] ;
LowNotOp    <~~ push(makeNot(pop())) ~~>
            = NotWord LowNot ;
OrWord      = "or" KwEnd ;
AndWord     = "and" KwEnd ;
NotWord     = "not" KwEnd ;

AssignExpr  = Assignment | Ternary ;
Ternary     <~~ push(makeTernary(takeAll())) ~~>
            = OrExpr [ "?" Expression ":" Expression ] ;

Assignment  <~~ push(makeAssign(takeAll(), up.pos)) ~~>
            = Target AssignOp <~~ push(up.in) ~~> AssignExpr ;
// ||= and &&= (conditional assignment) are accepted but not implemented (no short
// circuit); makeAssign warns and falls back to a plain assignment.
AssignOp    = "||=" | "&&=" | "+=" | "-=" | "*=" | "/=" | "%=" | ( "=" !"=" ) ;
Target      <~~ push(makeTargetRef(takeAll())) ~~>
            = TargetHead { "." Id <~~ push({key: up.in}) ~~> | TIndex } ;
// The '@@' alternative must come BEFORE '@' (PEG: the shorter one would win).
TargetHead  = "$" Id <~~ push({gvar: up.in}) ~~>
            | "@@" Id <~~ push({cvar: up.in}) ~~>
            | "@" Id <~~ push({ivar: up.in}) ~~>
            | Name <~~ push({var: up.in}) ~~> ;
TIndex      <~~ push({idx: pop()}) ~~>
            = "[" Expression "]" ;

OrExpr      <~~ push(makeOrAnd(takeAll(), true)) ~~>
            = AndExpr { OrOp AndExpr } ;
OrOp        = "||" ;
AndExpr     <~~ push(makeOrAnd(takeAll(), false)) ~~>
            = NotExpr { AndOp NotExpr } ;
AndOp       = "&&" ;
NotExpr     = NotOp | EqExpr ;
NotOp       <~~ push(makeNot(pop())) ~~>
            = "!" !"=" NotExpr ;

EqExpr      <~~ push(foldBinary(takeAll())) ~~>
            = RelExpr { ( "===" | "==" | "!=" ) <~~ push(up.in) ~~> RelExpr } ;
// <=> (the spaceship) is listed FIRST so "<=" cannot swallow its prefix.
RelExpr     <~~ push(foldBinary(takeAll())) ~~>
            = BitOrExpr { ( "<=>" | "<=" | ">=" | "<" | ">" ) <~~ push(up.in) ~~> BitOrExpr } ;
// Bitwise | ^ and & (the lookaheads keep || && and the safe-navigation &. out).
BitOrExpr   <~~ push(foldBinary(takeAll())) ~~>
            = BitAndExpr { BitOrOp <~~ push(up.in) ~~> BitAndExpr } ;
BitOrOp     = ( "|" !"|" ) | "^" ;
BitAndExpr  <~~ push(foldBinary(takeAll())) ~~>
            = RangeExpr { BitAndOp <~~ push(up.in) ~~> RangeExpr } ;
BitAndOp    = "&" !"&" !"." ;
// A range 1..5 (inclusive) or 1...5 (exclusive), and the endless (5..) / beginless
// (..9) forms; built as a lazy Range object.
RangeExpr   <~~ push(makeRange(takeAll())) ~~>
            = ShiftExpr [ RangeOp <~~ push(up.in) ~~> [ ShiftExpr ] ] ;
RangeOp     = "..." | ".." ;
// The << and >> operators: on an array << appends (and yields the array, so
// a << b << c chains), on a string it concatenates, on an integer it shifts.
ShiftExpr   <~~ push(makeShift(takeAll())) ~~>
            = AddExpr { ShiftOp <~~ push(up.in) ~~> AddExpr } ;
ShiftOp     = "<<" | ">>" ;
// The LineCont guard is what keeps `first, *rest = [1, 2, 3]' followed by a line
// that OPENS with `*init, last = ...' from reading as one multiplication: in Ruby a
// newline ends the statement once the expression is complete, so a binary operator
// that starts a fresh source line never continues the previous expression.
AddExpr     <~~ push(foldBinary(takeAll())) ~~>
            = MulExpr { LineCont ( "+" | "-" ) <~~ push(up.in) ~~> MulExpr } ;
MulExpr     <~~ push(foldBinary(takeAll())) ~~>
            = UnaryExpr { LineCont ( "*" | "/" | "%" ) <~~ push(up.in) ~~> UnaryExpr } ;

UnaryExpr   = Neg | BitNot | PowExpr ;
Neg         <~~ push(makeNeg(pop())) ~~>
            = "-" UnaryExpr ;
BitNot      <~~ push(makeBitNot(pop())) ~~>
            = "~" UnaryExpr ;
// ** binds tighter than unary minus (-2 ** 2 is -4) and is RIGHT associative
// (2 ** 3 ** 2 is 512), so its right operand is a whole UnaryExpr again.
PowExpr     <~~ push(makePow(takeAll())) ~~>
            = PostfixExpr [ "**" UnaryExpr ] ;

// obj.method(args), obj.method do |x| ... end, obj.field, arr[i]. A trailing
// block (do..end or {..}) becomes the last argument of the method call.
PostfixExpr <~~ push(foldCallMember(takeAll())) ~~>
            = Primary { CallSfx | MethodSfx | FieldSfx | SafeMethodSfx | SafeFieldSfx | IndexSfx } ;
MethodSfx   <~~ push({kind: "mcall", name: popName(), args: takeAll()}) ~~>
            = "." MethodName <~~ push({mname: up.in}) ~~> MArgs ;
// p.(x): the parenthesis-only call shorthand for a Proc (Proc#call).
CallSfx     <~~ push({kind: "mcall", name: "call", args: takeAll()}) ~~>
            = "." "(" [ Arg { "," Arg } ] ")" ;
FieldSfx    = "." MethodName <~~ push({kind: "field", name: up.in}) ~~> ;
// Safe navigation obj&.m / obj&.m(args): yields nil (and skips the call, not even
// evaluating the arguments) when the receiver is nil, else a normal method/field.
SafeMethodSfx <~~ push({kind: "smcall", name: popName(), args: takeAll()}) ~~>
            = "&." MethodName <~~ push({mname: up.in}) ~~> MArgs ;
SafeFieldSfx = "&." MethodName <~~ push({kind: "sfield", name: up.in}) ~~> ;
// The LineCont guard keeps a line that OPENS with an array literal from being read
// as an index of the previous expression (`txt = ""' then `[[1, 2]].each ...').
IndexSfx    <~~ push({kind: "index", idx: pop()}) ~~>
            = LineCont "[" Expression "]" ;
MArgs       = "(" [ Arg { "," Arg } ] ")" [ Block ] | Block ;

// A call argument: an ordinary expression, or one of the forms accepted for
// recognition but not implemented - keyword argument (name: v), splat / double-splat
// (*a, **h) and block pass (&blk, &:sym). The unsupported forms warn and become a
// placeholder argument, so the call still compiles.
Arg         = KwArg | SplatArg | BlockArg | Expression ;
KwArg       <~~ var n = takeAll(); push({kwname: n[0], kwT: n[1]}) ~~>
            = SymName <~~ push(up.in) ~~> ":" !":" Expression ;
// *arr splices an array into the positional arguments, **h merges a hash into the
// keyword arguments.
SplatArg    <~~ push({splatT: pop()}) ~~>
            = ( "**" | "*" ) Expression ;
// &expr: pass expr as the call's block. A Proc is passed straight through; a symbol
// becomes the "call this method on each element" proc (`[1, 2].map(&:to_s)`).
BlockArg    <~~ push({blkT: makeBlockArg(pop())}) ~~>
            = "&" Expression ;

// ->(a, b = 1) { ... } / -> { ... }: a lambda literal. Unlike a block it is a VALUE,
// and a `return` inside it returns from the lambda itself.
LambdaLit   <~~ push(makeLambda(takeAll())) ~~>
            = "->" [ "(" [ Param { "," Param } ] ")" ] LambdaBody ;
LambdaBody  = KwDo Body End | "{" [ BlockParams ] Body "}" ;

// A block passed to a method call: a real closure over the current scope.
Block       <~~ push(makeBlock(takeAll())) ~~>
            = KwDo [ BlockParams ] Body End
            | "{" [ BlockParams ] Body "}" ;
BlockParams <~~ push({bparams: takeAll()}) ~~>
            = "|" [ BParam { "," BParam } ] "|" ;
// A block parameter may be a parenthesized group that destructures one element:
// `[[1, [2, 3]]].each { |a, (b, c)| ... }`.
BParam      = BGroup | Param ;
BGroup      <~~ push({pgroup: takeAll()}) ~~>
            = "(" BParam { "," BParam } ")" ;

Primary     = "(" Expression ")" | LambdaLit
            | IfExpr | UnlessExpr | WhileExpr | UntilExpr | ForExpr | CaseExpr | BeginExpr
            | ReturnExpr | BreakExpr | NextExpr | RedoExpr | RetryExpr | RaiseExpr | YieldExpr | SuperExpr
            | StrLit | CharLit | PercentLit
            | NumHex | NumBin | NumOct | Oct0Lit | RatLit | ImagLit | FloatLit | NumInt
            | SymLit
            | ArrayLit | HashLit
            | True | False | Nil | Self
            | DefinedExpr | GvarRef | CvarRef | IvarRef | ScopedConst | Call | VarRef ;

// for VAR[, VAR] in COLL ... end: unlike a block, `for` does NOT open a scope - the
// loop variable stays visible after the loop (Ruby), so it is written with the same
// assignment path as an ordinary local. Several variables destructure each element.
ForExpr     <~~ push(makeForIn(takeAll())) ~~>
            = KwFor ForVars KwIn Expression [ KwDo ] Body End ;
ForVars     = Name <~~ push({fvar: up.in}) ~~> { "," Name <~~ push({fvar: up.in}) ~~> } ;

// super / super(args): call the method of the same name in the superclass. A BARE
// super forwards the arguments the current method received (Ruby), while super()
// with an explicit list passes exactly that list - so `super` and `super()` differ.
SuperExpr   <~~ push(makeSuper(takeAll())) ~~>
            = KwSuper [ "(" <~~ push({explicit: true}) ~~> [ Arg { "," Arg } ] ")" ] ;

// yield / yield(args) / yield args: accepted but not implemented (no block passing);
// warns and yields a placeholder value.
YieldExpr   <~~ push(makeYield(takeAll(), up.pos)) ~~>
            = KwYield [ "(" [ Arg { "," Arg } ] ")" | SameLine Arg { "," Arg } ] ;

// The numeric tower. Integers are exact (hex 0xff, binary 0b1010, octal 0o17 and
// Ruby's bare-zero form 017, decimal with '_' separators, all via lib/numbers.abnf
// except the bare-zero octal below). A float 1.5 / 1e3 / 25e-2 is a BOXED value so
// it stays distinguishable from an integer - Ruby needs 7 / 2 == 3 AND 7.0 / 2 ==
// 3.5, which one JS number cannot express. 3r is a Rational, 2i an imaginary
// Complex; both are boxes too. The prefixed / suffixed forms come first (PEG).
Oct0Lit     <~~ push(makeConst(parseInt(up.in.split("_").join("").substring(1), 8))) ~~>
            = "0" :whitespace() "0"..."7" { "0"..."7" | "_" } :whitespace(Whitespace) ;
RatLit      <~~ push(makeConst(mkRat(parseInt(up.in.split("_").join("")), 1))) ~~>
            = ( "0" | "1"..."9" ) :whitespace() { "0"..."9" | "_" } "r" :whitespace(Whitespace) ;
ImagLit     <~~ push(makeConst(mkCpx(0, parseInt(up.in.split("_").join(""))))) ~~>
            = ( "0" | "1"..."9" ) :whitespace() { "0"..."9" | "_" } "i" :whitespace(Whitespace) ;
FloatLit    <~~ push(makeConst(mkFlo(parseFloat(up.in.split("_").join(""))))) ~~>
            = ( "0" | "1"..."9" ) :whitespace() { "0"..."9" | "_" }
              ( "." "0"..."9" { "0"..."9" | "_" } [ NumExp ] | NumExp ) :whitespace(Whitespace) ;

// A scoped constant Foo::Bar::Baz: walked down the module/class chain at run time.
ScopedConst <~~ push(makeScopedConst(up.in)) ~~>
            = Name "::" Name { "::" Name } ;

// The percent literals. The lower-case tags (%q %w %i) are RAW - no escapes beyond
// the delimiters and no '#{}' - while the upper-case ones (%Q %W %I) and the bare
// %(..) interpolate exactly like a double-quoted string. %w/%i split their body on
// whitespace into an array of strings / symbols. Each form accepts the three usual
// delimiter pairs ( ) [ ] { }; the body characters are spelled out per delimiter,
// because the dialect has no parameterized rules.
PercentLit  = PctQ | PctW | PctI | PctBigQ | PctBigW | PctBigI | PctBare ;
PctQ        <~~ push(makeConst(unescapeSq(pctRawOf(takeAll())))) ~~>
            = "%q" :whitespace() PctRawBody :whitespace(Whitespace) ;
PctW        <~~ push(makeConst(pctWords(pctRawOf(takeAll()), false))) ~~>
            = "%w" :whitespace() PctRawBody :whitespace(Whitespace) ;
PctI        <~~ push(makeConst(pctWords(pctRawOf(takeAll()), true))) ~~>
            = "%i" :whitespace() PctRawBody :whitespace(Whitespace) ;
PctBigQ     <~~ push(makeTemplate(takeAll())) ~~>
            = "%Q" :whitespace() PctTplBody :whitespace(Whitespace) ;
PctBare     <~~ push(makeTemplate(takeAll())) ~~>
            = "%" :whitespace() PctTplBody :whitespace(Whitespace) ;
PctBigW     <~~ push(makeWordsThunk(makeTemplate(takeAll()), false)) ~~>
            = "%W" :whitespace() PctTplBody :whitespace(Whitespace) ;
PctBigI     <~~ push(makeWordsThunk(makeTemplate(takeAll()), true)) ~~>
            = "%I" :whitespace() PctTplBody :whitespace(Whitespace) ;

PctRawBody  = PctParRaw | PctBrkRaw | PctBrcRaw ;
PctParRaw   = "(" { PctParCh } <~~ push({raw: up.in}) ~~> ")" ;
PctBrkRaw   = "[" { PctBrkCh } <~~ push({raw: up.in}) ~~> "]" ;
PctBrcRaw   = "{" { PctBrcCh } <~~ push({raw: up.in}) ~~> "}" ;
PctParCh    = "\x00"..."\x27" | "\x2a"..."\U0010ffff" ;
PctBrkCh    = "\x00"..."\x5a" | "\x5c" | "\x5e"..."\U0010ffff" ;
PctBrcCh    = "\x00"..."\x7a" | "\x7c" | "\x7e"..."\U0010ffff" ;

PctTplBody  = "(" { TplExpr | PctParChunk } ")"
            | "[" { TplExpr | PctBrkChunk } "]"
            | "{" { TplExpr | PctBrcChunk } "}" ;
PctParChunk <~~ push({s: unescapeJs(up.in)}) ~~> = PctParTC { PctParTC } ;
PctParTC    = TplEsc | HashChar | PctParPlain ;
PctParPlain = "\x00"..."\x22" | "\x24"..."\x27" | "\x2a"..."\x5b" | "\x5d"..."\U0010ffff" ;
PctBrkChunk <~~ push({s: unescapeJs(up.in)}) ~~> = PctBrkTC { PctBrkTC } ;
PctBrkTC    = TplEsc | HashChar | PctBrkPlain ;
PctBrkPlain = "\x00"..."\x22" | "\x24"..."\x5a" | "\x5e"..."\U0010ffff" ;
PctBrcChunk <~~ push({s: unescapeJs(up.in)}) ~~> = PctBrcTC { PctBrcTC } ;
PctBrcTC    = TplEsc | HashChar | PctBrcPlain ;
PctBrcPlain = "\x00"..."\x22" | "\x24"..."\x5b" | "\x5d"..."\x7a" | "\x7c" | "\x7e"..."\U0010ffff" ;

// ?a / ?\n: the one-character string literal. The body may not start with a space,
// which is exactly what keeps the ternary `c ? a : b` out of it.
CharLit     <~~ push(makeConst(charLitVal(up.in))) ~~>
            = "?" :whitespace() CharBody :whitespace(Whitespace) ;
CharBody    = "\\" "\x21"..b"\x7e" | "\x21"..."\U0010ffff" ;

// if / unless usable as a statement and as an expression (yields the branch value).
IfExpr      <~~ push(makeIf(takeAll())) ~~>
            = KwIf Expression [ KwThen ] Body { Elsif } [ KwElse Body <~~ push({els: pop().body}) ~~> ] End ;
Elsif       <~~ var b = pop(); push({elifCond: pop(), elifBody: b.body}) ~~>
            = KwElsif Expression [ KwThen ] Body ;
UnlessExpr  <~~ push(makeUnless(takeAll())) ~~>
            = KwUnless Expression [ KwThen ] Body [ KwElse Body <~~ push({els: pop().body}) ~~> ] End ;

WhileExpr   <~~ push(makeWhile(pop().body, pop())) ~~>
            = KwWhile Expression [ KwDo ] Body End ;
UntilExpr   <~~ push(makeUntil(pop().body, pop())) ~~>
            = KwUntil Expression [ KwDo ] Body End ;

// case SUBJ / when V1, V2 / else - lowered to a chain of == tests (a switch). A
// subject-less case (case / when COND) tests each when expression for truthiness.
CaseExpr    <~~ push(makeCase(takeAll())) ~~>
            = KwCase [ Expression ] [ Semi ] { WhenClause } [ KwElse Body <~~ push({els: pop().body}) ~~> ] End ;
WhenClause  <~~ push(makeWhen(takeAll())) ~~>
            = KwWhen WhenVal { "," WhenVal } [ KwThen ] Body ;
// A when value: a range LO..HI / LO...HI matches by membership (Range#===); any
// other expression matches by == (subject form) or truthiness (subjectless form).
WhenVal     = WhenSplat | RangeVal | ScalarVal ;
// when *arr: every element of the array is a candidate value.
WhenSplat   <~~ push({t: pop(), isSplat: true}) ~~>
            = "*" !"*" Expression ;
RangeVal    <~~ push(makeRangeVal(takeAll())) ~~>
            = ShiftExpr ( "..." | ".." ) <~~ push(up.in) ~~> ShiftExpr ;
ScalarVal   <~~ push({t: pop(), isRange: false}) ~~>
            = Expression ;

// begin / rescue / else / ensure: genuinely executed (like Python try/except/else/
// finally). A raise in the body unwinds to the first rescue (exception types are
// parsed but not discriminated), which binds its `=> Id` name; else runs only when the
// body raised nothing and produced no return/break/next; ensure always runs. A
// return/break/next leaving the body propagates as the ordinary control signal.
BeginExpr   <~~ push(makeTry(takeAll(), up.pos)) ~~>
            = KwBegin Body <~~ push({trybody: pop().body}) ~~> { RescueClause }
              [ KwElse Body <~~ push({elsebody: pop().body}) ~~> ]
              [ KwEnsure Body <~~ push({finalbody: pop().body}) ~~> ] End ;
// rescue [Type[, Type]] [=> Id]: the type list is parsed and discarded (types are not
// discriminated); the `=> Id` name is pushed so makeExcept can bind it to the value.
RescueClause <~~ push(makeExcept(takeAll())) ~~>
            = KwRescue [ ErrList ] [ "=>" Name <~~ push({hname: up.in}) ~~> ] [ KwThen ] Body <~~ push({rbody: pop().body}) ~~> ;
ErrList     = ErrName { "," ErrName } ;
ErrName     = ScopedName <~~ push({etype: up.in}) ~~> ;

// The optional argument of return/break/next must not start at a statement-modifier
// keyword: in `break if C` the `if` belongs to the enclosing ModStmt - without the
// NoModKw guard it parses as a block-if argument expression and swallows the loop's
// `end`.
ReturnExpr  <~~ push(makeReturn(takeAll())) ~~>
            = KwReturn [ NoModKw Expression { "," Expression } ] ;
BreakExpr   <~~ push(makeBreak(takeAll())) ~~>
            = KwBreak [ NoModKw Expression ] ;
NextExpr    <~~ push(makeNext(takeAll())) ~~>
            = KwNext [ NoModKw Expression ] ;
// redo re-runs the current block body with the same element, without advancing the
// iteration (it travels to the iterating method as its own control signal).
RedoExpr    <~~ push(makeRedo(up.pos)) ~~>
            = KwRedo ;
// retry re-runs the begin body that the running rescue clause belongs to.
RetryExpr   <~~ push(makeRetry()) ~~>
            = KwRetry ;

// raise [EXPR[, EXPR]]: raise the first expression's value (a bare raise re-raise is
// approximated as raising nil); a trailing message argument is parsed and ignored.
RaiseExpr   <~~ push(makeRaise(takeAll(), up.pos)) ~~>
            = KwRaise [ Expression { "," Expression } ] ;

// f(args): a top level method or a class (for C.new the .new is a method suffix).
// A call may carry a trailing block, with or without parentheses (`loop { ... }`,
// `s13_blk(5) { |v| ... }`), and a predicate/bang method may be called bare
// (`block_given?`). BareName is a non-keyword identifier that may end in ? or !;
// the longest form comes first, so `x ? a : b` only reaches the ternary after the
// call alternatives have failed and rolled back.
Call        <~~ push(makeCall(takeAll())) ~~>
            = BareName <~~ push(up.in) ~~> "(" [ Arg { "," Arg } ] ")" [ Block ]
            | BareName <~~ push(up.in) ~~> Block
            | PredName <~~ push(up.in) ~~> ;
BareName    = NotKw Id [ "?" | "!" ] ;
// A bare predicate/bang call has to be told apart from `a != b` and from the ternary
// `x ? a : b`, so the suffix character is checked with whitespace skipping OFF: a `!`
// may not be followed by `=`, and a `?` may not be followed by whitespace (Ruby uses
// exactly that spacing rule to separate `foo?` from `foo ? a : b`).
PredName    = PredOk NotKw Id :whitespace() PredSfx :whitespace(Whitespace) ;
PredSfx     = "?" | "!" ;

VarRef      <~~ push(makeVarRef(up.in)) ~~>
            = Name ;
IvarRef     = "@" Id <~~ push(makeIvarRef(up.in)) ~~> ;
// $global and @@classvar reads (their writes go through TargetHead above).
GvarRef     = "$" Id <~~ push(makeGvarRef(up.in)) ~~> ;
CvarRef     = "@@" Id <~~ push(makeCvarRef(up.in)) ~~> ;
// defined?(X) answers what kind of thing X is - or nil when it is nothing. Its
// argument is NOT evaluated, so the production keeps only the source text and
// makeDefined classifies it at run time.
DefinedExpr <~~ push(makeDefined(takeAll())) ~~>
            = "defined?" :whitespace(Whitespace) "(" DefArgTxt ")" ;
DefArgTxt   <~~ takeAll(); push({dtext: up.in}) ~~>
            = Expression | GvarRef | Id ;
Self        <~~ push(makeSelf()) ~~>    = KwSelf ;
Nil         <~~ push(makeConst(null)) ~~> = "nil" KwEnd ;

ArrayLit    <~~ push(makeArray(takeAll())) ~~>
            = "[" [ ArrElem { "," ArrElem } ] "]" ;
// An array element may be splatted: [0, *[1, 2], 3] splices the inner array in.
ArrElem     = ArrSplat | Expression ;
ArrSplat    <~~ push({splat: pop()}) ~~>
            = "*" !"*" Expression ;
HashLit     <~~ push(makeHash(takeAll())) ~~>
            = "{" [ HashEntry { "," HashEntry } ] "}" ;
// { k => v } (arrow) and { name: v } (symbol key, genuinely lowered - name: is the
// symbol :name, which the runtime already represents as the string "name").
HashEntry   = HashDSplat | HashColon | HashArrow ;
// {**other, k: v} merges another hash in.
HashDSplat  <~~ push({hsplat: pop()}) ~~>
            = "**" Expression ;
HashArrow   <~~ var v = pop(); push({hk: pop(), hv: v}) ~~>
            = Expression "=>" Expression ;
HashColon   <~~ var v = pop(); push({hk: pop(), hv: v}) ~~>
            = SymKey ":" Expression ;
SymKey      <~~ push(makeConst(mkSym(up.in))) ~~>
            = SymName ;

// :"two words" and :"n#{1 + 1}" are symbol literals with a string body.
SymLit      = SymQuoted | SymPlain ;
SymPlain    = ":" SymName <~~ push(makeConst(mkSym(up.in))) ~~> :whitespace(Whitespace) ;
SymQuoted   <~~ push(makeSymOf(pop())) ~~>
            = ":" DqStr ;
SymName     = ( "a"..."z" | "A"..."Z" | "_" ) :whitespace() { "a"..."z" | "A"..."Z" | "0"..."9" | "_" } ;

// Two string literals that are only separated by whitespace are ONE string in Ruby
// ("a" 'd' is "ad"), so a string primary is a run of pieces.
StrLit      <~~ push(makeAdjacent(takeAll())) ~~>
            = StrPiece { StrPiece } ;
StrPiece    = DqStr | SqStr ;

// Double quoted strings interpolate '#{expr}'; single quoted are literal.
DqStr       <~~ push(makeTemplate(takeAll())) ~~>
            = '"' :whitespace() { TplExpr | TplChunk } '"' :whitespace(Whitespace) ;
TplExpr     <~~ push({e: pop()}) ~~>
            = "#{" :whitespace(Whitespace) Expression "}" ;
TplChunk    <~~ push({s: unescapeJs(up.in)}) ~~>
            = TplChar { TplChar } ;
TplChar     = TplEsc | HashChar | TplPlain ;
TplEsc      = "\\" "\x20"..b"\x7e" ;
HashChar    = "#" !"{" ;
TplPlain    = "\x20"..."\x21" | "\x24"..."\x5b" | "\x5d"..."\x7e" | @"\t" | "\x7f"..."\U0010ffff" ;

SqStr       = "'" :whitespace() { SqEsc | SqLone | SqPlain } <~~ push(makeConst(unescapeSq(up.in))) ~~> "'" :whitespace(Whitespace) ;
SqEsc       = "\\" ( "'" | "\\" ) ;
// Only \' and \\ are escapes inside '..'; any other backslash is a literal one.
SqLone      = "\\" ;
SqPlain     = "\x20"..."\x26" | "\x28"..."\x5b" | "\x5d"..."\U0010ffff" | @"\t" ;

// A Name that is not a reserved word (keywords, literals, puts/print). The
// negative lookahead runs at PARSE time, so it must be self contained.
Name        = NotKw Id ;
NotKw       = :script(~~
    (function() {
        // Whitespace is skipped before tokens, not before this script, so the
        // lookahead skips leading whitespace and '#' comments itself.
        var i = 0
        var cc = c.peek(i)
        while (true) {
            if (cc === 32 || cc === 9 || cc === 13 || cc === 10) { i = i + 1; cc = c.peek(i); continue }
            if (cc === 35) { while (cc !== 10 && cc !== -1) { i = i + 1; cc = c.peek(i) } continue }
            break
        }
        if (!((cc >= 65 && cc <= 90) || (cc >= 97 && cc <= 122) || cc === 95)) { return undefined }
        var s = ""
        while ((cc >= 48 && cc <= 57) || (cc >= 65 && cc <= 90) || (cc >= 97 && cc <= 122) || cc === 95) {
            s = s + String.fromCharCode(cc)
            i = i + 1
            cc = c.peek(i)
        }
        var kws = ["def", "end", "if", "elsif", "else", "unless", "while", "until",
                   "do", "then", "return", "break", "next", "class", "module", "for",
                   "self", "nil", "true", "false", "and", "or", "not", "case", "when",
                   "in", "yield", "begin", "rescue", "ensure", "raise", "puts", "print",
                   "redo", "super", "retry", "alias"]
        for (var k = 0; k < kws.length; k++) {
            if (kws[k] === s) { return abnf.newToken("\x01reserved", 0) }
        }
        return undefined
    })()
~~) ;

// NoModKw succeeds (matching empty) only when the next word is NOT a statement-
// modifier keyword, so the optional argument of return/break/next leaves a trailing
// `if`/`unless`/`while`/`until` to the enclosing ModStmt. Self contained like NotKw.
NoModKw     = :script(~~
    (function() {
        var i = 0
        var cc = c.peek(i)
        while (true) {
            if (cc === 32 || cc === 9 || cc === 13 || cc === 10) { i = i + 1; cc = c.peek(i); continue }
            if (cc === 35) { while (cc !== 10 && cc !== -1) { i = i + 1; cc = c.peek(i) } continue }
            break
        }
        var s = ""
        while ((cc >= 48 && cc <= 57) || (cc >= 65 && cc <= 90) || (cc >= 97 && cc <= 122) || cc === 95) {
            s = s + String.fromCharCode(cc)
            i = i + 1
            cc = c.peek(i)
        }
        if (s === "if" || s === "unless" || s === "while" || s === "until") {
            return abnf.newToken("\x01modkw", 0)
        }
        return undefined
    })()
~~) ;

// PredOk succeeds (matching empty) only where a bare predicate/bang call really is
// one: an identifier immediately followed by '?' or '!', where the '!' is not the
// '!=' operator and the '?' is not the ternary (Ruby separates `foo?` from
// `foo ? a : b` by exactly that spacing). Pure function of (source, position).
PredOk      = :script(~~
    (function() {
        var i = 0
        var cc = c.peek(i)
        while (true) {
            if (cc === 32 || cc === 9 || cc === 13 || cc === 10) { i = i + 1; cc = c.peek(i); continue }
            if (cc === 35) { while (cc !== 10 && cc !== -1) { i = i + 1; cc = c.peek(i) } continue }
            break
        }
        if (!((cc >= 65 && cc <= 90) || (cc >= 97 && cc <= 122) || cc === 95)) { return abnf.newToken("\x01no", 0) }
        while ((cc >= 48 && cc <= 57) || (cc >= 65 && cc <= 90) || (cc >= 97 && cc <= 122) || cc === 95) {
            i = i + 1
            cc = c.peek(i)
        }
        var nx = c.peek(i + 1)
        if (cc === 33) {                                  // '!'
            if (nx === 61) { return abnf.newToken("\x01no", 0) }
            return undefined
        }
        if (cc === 63) {                                  // '?'
            if (nx === 61 || nx === 32 || nx === 9 || nx === 13 || nx === 10) {
                return abnf.newToken("\x01no", 0)
            }
            return undefined
        }
        return abnf.newToken("\x01no", 0)
    })()
~~) ;

// LineCont succeeds (matching empty) only when the position does NOT start a fresh
// source line, i.e. the token just before it is on the same line. It gates the
// binary operators that can equally open a statement (*, +, -), so a line beginning
// with one of them is a new statement rather than a continuation. Pure function of
// (source, position), like the other guards here.
LineCont    = :script(~~
    (function() {
        // Whitespace is skipped before tokens but not before a script, so the newline
        // that would separate the two statements is still AHEAD of this position.
        var i = -1
        var cc = c.peek(i)
        while (cc === 32 || cc === 9 || cc === 13) { i = i - 1; cc = c.peek(i) }
        if (cc === 10) { return abnf.newToken("\x01nl", 0) }
        var j = 0
        var dd = c.peek(j)
        while (dd === 32 || dd === 9 || dd === 13) { j = j + 1; dd = c.peek(j) }
        if (dd === 10 || dd === 35 || dd === -1) { return abnf.newToken("\x01nl", 0) }
        return undefined
    })()
~~) ;

// SameLine succeeds (matching empty) only when the current position and the token
// just before it are on the SAME source line: no line break (nor a '#' comment
// that would run to end of line) in the whitespace immediately before or after the
// position. It gates the statement modifiers and the post-condition loop keyword,
// so a block 'if'/'while'/'until' opening the next line is never read as a modifier.
// Runs at parse time; peeks the raw source both backward and forward, self contained.
SameLine    = :script(~~
    (function() {
        var i = -1
        var cc = c.peek(i)
        while (cc === 32 || cc === 9 || cc === 13) { i = i - 1; cc = c.peek(i) }
        if (cc === 10) { return abnf.newToken("\x01nl", 0) }
        var j = 0
        var dd = c.peek(j)
        while (dd === 32 || dd === 9 || dd === 13) { j = j + 1; dd = c.peek(j) }
        if (dd === 10 || dd === 35 || dd === -1) { return abnf.newToken("\x01nl", 0) }
        return undefined
    })()
~~) ;

// CmdArgAhead succeeds (matching empty) only where a parenthesis-less argument list
// really starts: the next character must be able to OPEN an expression and must not
// be readable as a binary operator continuing the previous one. Ruby's own rule is
// spacing - `foo -1` passes -1, `foo - 1` subtracts - so a sign/star/ampersand only
// counts when it is glued to what follows. A keyword that ends or modifies the
// statement (end, if, do, and, ...) is not an argument either. Pure function of
// (source, position), like the other guards here.
CmdArgAhead = :script(~~
    (function() {
        var no = abnf.newToken("\x01nocmd", 0)
        var i = 0
        var cc = c.peek(i)
        var sawSpace = false
        while (true) {
            if (cc === 32 || cc === 9) { sawSpace = true; i = i + 1; cc = c.peek(i); continue }
            if (cc === 13) { i = i + 1; cc = c.peek(i); continue }
            break
        }
        if (!sawSpace) { return no }                      // `foo(1)` is a normal call
        if (cc < 0 || cc === 10 || cc === 35) { return no }
        // Characters that can only continue an expression, never open one.
        if (cc === 40 || cc === 41 || cc === 93 || cc === 125 || cc === 44 || cc === 59
            || cc === 46 || cc === 61 || cc === 60 || cc === 62 || cc === 63 || cc === 124
            || cc === 94 || cc === 47 || cc === 37 || cc === 43 || cc === 92) { return no }
        var nx = c.peek(i + 1)
        // - * & ** are arguments only when glued to the value that follows.
        if (cc === 45 || cc === 42 || cc === 38) {
            if (nx === 32 || nx === 9 || nx === 61 || nx < 0) { return no }
            return undefined
        }
        if (cc === 33) { if (nx === 61) { return no } return undefined }
        // A reserved word that closes or modifies the statement is not an argument.
        if ((cc >= 65 && cc <= 90) || (cc >= 97 && cc <= 122) || cc === 95) {
            var w = ""
            var j = i
            var dd = cc
            while ((dd >= 48 && dd <= 57) || (dd >= 65 && dd <= 90) || (dd >= 97 && dd <= 122) || dd === 95) {
                w = w + String.fromCharCode(dd)
                j = j + 1
                dd = c.peek(j)
            }
            var bad = ["end", "if", "unless", "while", "until", "do", "then", "else",
                       "elsif", "rescue", "ensure", "and", "or", "in", "when"]
            for (var k = 0; k < bad.length; k++) { if (bad[k] === w) { return no } }
        }
        return undefined
    })()
~~) ;

KwDef       = "def" KwEnd ;
KwClass     = "class" KwEnd ;
KwModule    = "module" KwEnd ;
KwFor       = "for" KwEnd ;
KwIn        = "in" KwEnd ;
KwYield     = "yield" KwEnd ;
KwIf        = "if" KwEnd ;
KwElsif     = "elsif" KwEnd ;
KwElse      = "else" KwEnd ;
KwUnless    = "unless" KwEnd ;
KwThen      = "then" KwEnd ;
KwWhile     = "while" KwEnd ;
KwUntil     = "until" KwEnd ;
KwDo        = "do" KwEnd ;
KwCase      = "case" KwEnd ;
KwWhen      = "when" KwEnd ;
KwBegin     = "begin" KwEnd ;
KwRescue    = "rescue" KwEnd ;
KwEnsure    = "ensure" KwEnd ;
KwRaise     = "raise" KwEnd ;
KwReturn    = "return" KwEnd ;
KwBreak     = "break" KwEnd ;
KwNext      = "next" KwEnd ;
KwRedo      = "redo" KwEnd ;
KwRetry     = "retry" KwEnd ;
KwSelf      = "self" KwEnd ;
KwSuper     = "super" KwEnd ;
KwAlias     = "alias" KwEnd ;
KwPuts      = ( "puts" | "print" ) KwEnd ;

// ---


:startScript(~~

    // Shared emitter machinery (module, handle constants, externs, string/number
    // emission, foldBinary/makeConst/makeNeg/makeNot/emitArgs). Ruby specific
    // lowering is defined below; every thunk here is expression-shaped:
    // function(block) -> {b, v} (b = the block to continue in, v = the value).
    include("lib/compile-core.js")

    var hidCount = 0

    function fail(msg) { println("ruby compiler error: " + msg); exit(1) }

    // ----- Ruby truthiness: only nil and false are falsy. The value handles are
    // table indices: 0/1/2 = undefined/null/false (all falsy), 3 = true, and every
    // other value (numbers, strings, arrays, objects) is >= 4. So "truthy" is a
    // single unsigned compare handle >= 3. -----
    truthy = function(b, v) {
        return b.NewICmp(llvm.enum.IPredUGE, v, handle(3))
    }

    // ----- Control flow: a body threads blocks and yields its last value (Ruby
    // implicit return). return/break/next terminate the current block and continue
    // in a fresh (dead) one. -----
    function makeBody(items) {
        return function(b) {
            var v = hNull
            for (var i = 0; i < items.length; i++) {
                var r = items[i](b)
                b = r.b
                v = r.v
            }
            return {b: b, v: v}
        }
    }
    // return with several values yields an array (Ruby: `return 3, 4` -> [3, 4]).
    function makeReturn(items) {
        if (items.length > 1) {
            return function(b) {
                var arrV = callExt(b, "js_arr_new", [])
                for (var i = 0; i < items.length; i++) {
                    var ri = items[i](b)
                    b = ri.b
                    callExt(b, "js_arr_push", [arrV, ri.v])
                }
                return {b: retStmt(b, arrV), v: hNull}
            }
        }
        var t = items.length > 0 ? items[0] : null
        return function(b) {
            var v = hNull
            if (t != null) { var r = t(b); b = r.b; v = r.v }
            // A plain ret, or a control signal when the return leaves a begin body.
            return {b: retStmt(b, v), v: hNull}
        }
    }
    makeBreak = function(items) {
        // break value is discarded (loops yield nil); still evaluate it for effects.
        var t = items.length > 0 ? items[0] : null
        return function(b) {
            if (t != null) { var r = t(b); b = r.b }
            // A branch to the enclosing loop, or a control signal out of a begin body.
            emitBreak(b)
            return {b: deadBlock(), v: hNull}
        }
    }
    function makeNext(items) {
        var t = items.length > 0 ? items[0] : null
        return function(b) {
            if (t != null) { var r = t(b); b = r.b }
            emitContinue(b)
            return {b: deadBlock(), v: hNull}
        }
    }

    // if / unless: the branch value travels through a hidden result variable in the
    // CURRENT scope (so the branch bodies keep assigning to the enclosing scope -
    // Ruby's if/while do not introduce a new scope).
    makeIf = function(items) {
        var cond = items[0]
        var thenB = items[1].body
        var branches = []
        var els = null
        for (var i = 2; i < items.length; i++) {
            if (items[i].els != undefined) { els = items[i].els }
            else { branches.push({cond: items[i].elifCond, body: items[i].elifBody}) }
        }
        branches.unshift({cond: cond, body: thenB})
        return function(b) {
            hidCount++
            var rName = "$if" + hidCount
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, rName), hNull])
            var endB = curF.NewBlock("")
            for (var a = 0; a < branches.length; a++) {
                var rc = branches[a].cond(b)
                b = rc.b
                var thenBk = curF.NewBlock("")
                var nextBk = curF.NewBlock("")
                b.NewCondBr(truthy(b, rc.v), thenBk, nextBk)
                var rb = branches[a].body(thenBk)
                callExt(rb.b, "js_scope_set", [curScopeV, emitStr(rb.b, rName), rb.v])
                rb.b.NewBr(endB)
                b = nextBk
            }
            if (els != null) {
                var re = els(b)
                b = re.b
                callExt(b, "js_scope_set", [curScopeV, emitStr(b, rName), re.v])
            }
            b.NewBr(endB)
            var out = callExt(endB, "js_scope_get", [curScopeV, emitStr(endB, rName)])
            return {b: endB, v: out}
        }
    }
    function makeUnless(items) {
        var cond = items[0]
        var thenB = items[1].body
        var els = null
        if (items.length > 2 && items[2].els != undefined) { els = items[2].els }
        return function(b) {
            hidCount++
            var rName = "$un" + hidCount
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, rName), hNull])
            var rc = cond(b)
            b = rc.b
            var thenBk = curF.NewBlock("")
            var elseBk = curF.NewBlock("")
            var endB = curF.NewBlock("")
            b.NewCondBr(truthy(b, rc.v), elseBk, thenBk)
            var rb = thenB(thenBk)
            callExt(rb.b, "js_scope_set", [curScopeV, emitStr(rb.b, rName), rb.v])
            rb.b.NewBr(endB)
            if (els != null) {
                var re = els(elseBk)
                callExt(re.b, "js_scope_set", [curScopeV, emitStr(re.b, rName), re.v])
                re.b.NewBr(endB)
            } else {
                elseBk.NewBr(endB)
            }
            var out = callExt(endB, "js_scope_get", [curScopeV, emitStr(endB, rName)])
            return {b: endB, v: out}
        }
    }
    makeWhile = function(bodyT, condT) {
        return function(b) {
            var headB = curF.NewBlock("")
            var bodyB = curF.NewBlock("")
            var exitB = curF.NewBlock("")
            b.NewBr(headB)
            var r = condT(headB)
            r.b.NewCondBr(truthy(r.b, r.v), bodyB, exitB)
            loopStack.push({cont: headB, brk: exitB})
            var rb = bodyT(bodyB)
            rb.b.NewBr(headB)
            loopStack.pop()
            return {b: exitB, v: hNull}
        }
    }
    function makeUntil(bodyT, condT) {
        return function(b) {
            var headB = curF.NewBlock("")
            var bodyB = curF.NewBlock("")
            var exitB = curF.NewBlock("")
            b.NewBr(headB)
            var r = condT(headB)
            r.b.NewCondBr(truthy(r.b, r.v), exitB, bodyB)
            loopStack.push({cont: headB, brk: exitB})
            var rb = bodyT(bodyB)
            rb.b.NewBr(headB)
            loopStack.pop()
            return {b: exitB, v: hNull}
        }
    }

    // ----- Boolean operators yielding an operand (short circuit, Ruby truthiness) -----
    makeOrAnd = function(items, isOr) {
        if (items.length == 1) { return items[0] }
        return function(b) {
            var r = items[0](b)
            b = r.b
            var v = r.v
            for (var i = 1; i < items.length; i++) {
                var rightB = curF.NewBlock("")
                var mergeB = curF.NewBlock("")
                var cnd = truthy(b, v)
                if (isOr) { b.NewCondBr(cnd, mergeB, rightB) }
                else      { b.NewCondBr(cnd, rightB, mergeB) }
                var r2 = items[i](rightB)
                r2.b.NewBr(mergeB)
                var phi = mergeB.NewPhi([llvm.ir.NewIncoming(v, b), llvm.ir.NewIncoming(r2.v, r2.b)])
                b = mergeB
                v = phi
            }
            return {b: b, v: v}
        }
    }

    // ----- self / @ivars -----
    function makeSelf() {
        return function(b) { return {b: b, v: callExt(b, "js_scope_get", [curScopeV, emitStr(b, "self")])} }
    }
    function makeIvarRef(name) {
        return function(b) {
            var selfV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, "self")])
            return {b: b, v: callExt(b, "js_get", [selfV, emitStr(b, name)])}
        }
    }

    // ----- ranges (eager arrays), arrays, hashes, templates -----
    function makeRange(items) {
        if (items.length == 1) { return items[0] }
        // An endless range (5..) has no upper bound to count to, and the lowering
        // materializes ranges as arrays - so it stays unsupported rather than hanging.
        if (items.length < 3) { return notImplExpr("endless range (5..)", 0) }
        var loT = items[0]
        var op = items[1]
        var hiT = items[2]
        return function(b) {
            var rl = loT(b)
            b = rl.b
            var rh = hiT(b)
            b = rh.b
            var arrV = callExt(b, "js_arr_new", [])
            hidCount++
            var iName = "$rng" + hidCount
            var eName = "$rngE" + hidCount
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, iName), rl.v])
            var endV = op == "..." ? intWrap(b, callExt(b, "js_sub", [rh.v, emitNum(b, 1)])) : rh.v
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, eName), endV])
            var headB = curF.NewBlock("")
            var bodyB = curF.NewBlock("")
            var exitB = curF.NewBlock("")
            b.NewBr(headB)
            var iV = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, iName)])
            var eV = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, eName)])
            headB.NewCondBr(truthy(headB, callExt(headB, "js_le", [iV, eV])), bodyB, exitB)
            var iV2 = callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, iName)])
            callExt(bodyB, "js_arr_push", [arrV, iV2])
            callExt(bodyB, "js_scope_set", [curScopeV, emitStr(bodyB, iName),
                                            intWrap(bodyB, callExt(bodyB, "js_jadd", [iV2, emitNum(bodyB, 1)]))])
            bodyB.NewBr(headB)
            return {b: exitB, v: arrV}
        }
    }
    // [a, *b, c]: a splat element splices the inner array in with an emitted loop.
    function makeArray(items) {
        return function(b) {
            var arrV = callExt(b, "js_arr_new", [])
            for (var i = 0; i < items.length; i++) {
                if (items[i].splat != undefined) {
                    var rs = items[i].splat(b)
                    b = emitSpliceInto(rs.b, arrV, rs.v)
                    continue
                }
                var r = items[i](b)
                b = r.b
                callExt(b, "js_arr_push", [arrV, r.v])
            }
            return {b: b, v: arrV}
        }
    }
    // Append every element of srcV to dstV (both runtime arrays), with a counted loop.
    function emitSpliceInto(b, dstV, srcV) {
        hidCount++
        var iName = "$spl" + hidCount
        var lenV = callExt(b, "js_pylen", [srcV])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, iName), emitNum(b, 0)])
        var headB = curF.NewBlock("")
        var bodyB = curF.NewBlock("")
        var exitB = curF.NewBlock("")
        b.NewBr(headB)
        var iV = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, iName)])
        headB.NewCondBr(truthy(headB, callExt(headB, "js_lt", [iV, lenV])), bodyB, exitB)
        var iV2 = callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, iName)])
        callExt(bodyB, "js_arr_push", [dstV, callExt(bodyB, "js_pyget", [srcV, iV2])])
        callExt(bodyB, "js_scope_set", [curScopeV, emitStr(bodyB, iName),
                                        intWrap(bodyB, callExt(bodyB, "js_jadd", [iV2, emitNum(bodyB, 1)]))])
        bodyB.NewBr(headB)
        return exitB
    }
    // {**other, k: v}: a double-splat entry merges another hash in, key by key.
    function makeHash(items) {
        return function(b) {
            var d = callExt(b, "js_dict_new", [])
            for (var i = 0; i < items.length; i++) {
                if (items[i].hsplat != undefined) {
                    var rh = items[i].hsplat(b)
                    b = emitMergeDict(rh.b, d, rh.v)
                    continue
                }
                var rk = items[i].hk(b)
                b = rk.b
                var rv = items[i].hv(b)
                b = rv.b
                callExt(b, "js_pyset", [d, rk.v, rv.v])
            }
            return {b: b, v: d}
        }
    }
    // Copy every key/value pair of srcV into dstV (both runtime dicts).
    function emitMergeDict(b, dstV, srcV) {
        hidCount++
        var iName = "$mrg" + hidCount
        var keysV = callExt(b, "js_keys", [srcV])
        var lenV = callExt(b, "js_pylen", [keysV])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, iName), emitNum(b, 0)])
        var headB = curF.NewBlock("")
        var bodyB = curF.NewBlock("")
        var exitB = curF.NewBlock("")
        b.NewBr(headB)
        var iV = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, iName)])
        headB.NewCondBr(truthy(headB, callExt(headB, "js_lt", [iV, lenV])), bodyB, exitB)
        var iV2 = callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, iName)])
        var kV = callExt(bodyB, "js_pyget", [keysV, iV2])
        callExt(bodyB, "js_pyset", [dstV, kV, callExt(bodyB, "js_pyget", [srcV, kV])])
        callExt(bodyB, "js_scope_set", [curScopeV, emitStr(bodyB, iName),
                                        intWrap(bodyB, callExt(bodyB, "js_jadd", [iV2, emitNum(bodyB, 1)]))])
        bodyB.NewBr(headB)
        return exitB
    }
    function makeTemplate(items) {
        return function(b) {
            var v = emitStr(b, "")
            for (var i = 0; i < items.length; i++) {
                var pv
                if (items[i].s != undefined) { pv = emitStr(b, items[i].s) }
                else {
                    var r = items[i].e(b)
                    b = r.b
                    pv = r.v
                }
                v = callExt(b, "js_jadd", [v, pv])
            }
            return {b: b, v: v}
        }
    }
    function unescapeSq(s) {
        var out = ""
        var i = 0
        while (i < s.length) {
            var c = s.charCodeAt(i)
            if (c == 92 && i + 1 < s.length) {
                var e = s.charCodeAt(i + 1)
                if (e == 39 || e == 92) { out += String.fromCharCode(e); i += 2; continue }
            }
            out += String.fromCharCode(c)
            i++
        }
        return out
    }

    // ----- member chain: .method(args)/.method{block}, .field, [index], .new -----
    // C.new / C.new(args): build the instance, attach __class, run initialize.
    // Works both with parens (mcall) and without (a bare .new field access).
    function emitNew(b, cur, argThunks) {
        var objV = callExt(b, "js_obj_new", [])
        callExt(b, "js_set", [objV, emitStr(b, "__class"), cur])
        var argsV = callExt(b, "js_arr_new", [])
        for (var k = 0; k < argThunks.length; k++) {
            var ra = argThunks[k](b)
            b = ra.b
            callExt(b, "js_arr_push", [argsV, ra.v])
        }
        // Dispatched on the INSTANCE, not read off the class descriptor: that is the
        // lookup that walks __class and its __super chain, so a subclass without an
        // initialize of its own inherits the one above it.
        callExt(b, "js_rmcall", [objV, emitStr(b, "initialize"), argsV])
        return {b: b, v: objV}
    }
    // Ruby's Array#== / Hash#== compare structurally. js_pyeq/js_pyne are exactly that
    // (Python's == over the same runtime values), so the binary operator table simply
    // points at them instead of the identity comparisons js_seq/js_sne.
    binExt["=="] = "js_pyeq"
    binExt["!="] = "js_pyne"
    // Ruby's Integer#/ FLOORS (-7 / 2 == -4) and Integer#% takes the sign of the
    // DIVISOR (-7 % 3 == 2). js_fdiv/js_fmod are exactly those two operations - they
    // already back Python's // and %, which agree with Ruby here.
    binExt["/"] = "js_fdiv"
    binExt["%"] = "js_fmod"
    binExt["/="] = "js_fdiv"
    binExt["%="] = "js_fmod"

    core.indexExt = "js_rget"    // [i] over arrays, strings and hashes; nil when absent
    foldCallMember = function(items) {
        if (items.length == 1) { return items[0] }
        var primary = items[0]
        var suffixes = items.slice(1)
        return function(b) {
            var r = primary(b)
            b = r.b
            var cur = r.v
            for (var i = 0; i < suffixes.length; i++) {
                var s = suffixes[i]
                if (s.kind == "mcall") {
                    if (s.name == "new") {
                        var rn = emitNew(b, cur, unwrapArgs(s.args))
                        b = rn.b
                        cur = rn.v
                    } else {
                        var ea = emitArgs(b, unwrapArgs(s.args))
                        b = ea.b
                        cur = callExt(b, "js_rmcall", [cur, emitStr(b, s.name), ea.v])
                    }
                } else if (s.kind == "smcall" || s.kind == "sfield") {
                    // Safe navigation: guard on nil (skip the call, keep nil) via a
                    // hidden result variable; only the non-nil branch evaluates args.
                    hidCount++
                    var snName = "$sn" + hidCount
                    callExt(b, "js_scope_decl", [curScopeV, emitStr(b, snName), hNull])
                    var callBk = curF.NewBlock("")
                    var snEnd = curF.NewBlock("")
                    b.NewCondBr(truthy(b, callExt(b, "js_seq", [cur, hNull])), snEnd, callBk)
                    var snRes = hNull
                    if (s.kind == "smcall") {
                        var sea = emitArgs(callBk, unwrapArgs(s.args))
                        callBk = sea.b
                        snRes = callExt(callBk, "js_rmcall", [cur, emitStr(callBk, s.name), sea.v])
                    } else if (s.name == "length" || s.name == "size") {
                        snRes = callExt(callBk, "js_pylen", [cur])
                    } else if (s.name == "to_s") {
                        snRes = callExt(callBk, "js_jadd", [emitStr(callBk, ""), cur])
                    } else {
                        snRes = callExt(callBk, "js_rmcall", [cur, emitStr(callBk, s.name), callExt(callBk, "js_arr_new", [])])
                    }
                    callExt(callBk, "js_scope_set", [curScopeV, emitStr(callBk, snName), snRes])
                    callBk.NewBr(snEnd)
                    cur = callExt(snEnd, "js_scope_get", [curScopeV, emitStr(snEnd, snName)])
                    b = snEnd
                } else if (s.kind == "field") {
                    if (s.name == "length" || s.name == "size") {
                        cur = callExt(b, "js_pylen", [cur])
                    } else if (s.name == "to_s") {
                        cur = callExt(b, "js_jadd", [emitStr(b, ""), cur])
                    } else if (s.name == "to_a") {
                        cur = cur
                    } else if (s.name == "new") {
                        // Foo.new without parens: a zero argument constructor call.
                        var rn2 = emitNew(b, cur, [])
                        b = rn2.b
                        cur = rn2.v
                    } else {
                        // A bare .name is a zero argument method call (Ruby getters,
                        // pop, keys, ...); routed through js_rmcall like the interpreter.
                        cur = callExt(b, "js_rmcall", [cur, emitStr(b, s.name), callExt(b, "js_arr_new", [])])
                    }
                } else {
                    var ir = s.idx(b)
                    b = ir.b
                    cur = callExt(b, core.indexExt, [cur, ir.v])
                }
            }
            return {b: b, v: cur}
        }
    }

    // ----- blocks: an IR function closed over the defining scope (js_closure) -----
    function makeBlock(items) {
        var params = []
        var body = null
        for (var i = 0; i < items.length; i++) {
            if (items[i].body != undefined) { body = items[i].body }
            else { params = items[i].bparams }
        }
        var pnames = []
        for (var p = 0; p < params.length; p++) { pnames.push(params[p].param) }
        var bodyStmt = function(b) {
            var r = body(b)
            r.b.NewRet(r.v)
            return {b: deadBlock(), v: hNull}
        }
        return {blkT: function(b) {
            var idx = emitFunc(pnames, bodyStmt, false)
            return {b: b, v: callExt(b, "js_closure", [handle(idx), curScopeV])}
        }}
    }
    // A block reaches a call as a marker, so a call can tell it from its arguments.
    // The LLVM lowering keeps the interpreter's older convention of handing the block
    // to js_rmcall as the LAST positional argument, so unwrapArgs simply puts it back
    // at the end of the argument list.
    // name: v and *arr / **h call arguments have no lowering yet; each becomes the
    // notImplemented placeholder so the call itself still compiles.
    function rubyPlainArgs(args) {
        var out = []
        for (var i = 0; i < args.length; i++) {
            if (args[i].kwname != undefined) { out.push(notImplExpr("keyword argument (name:)", 0)) }
            else if (args[i].splatT != undefined) { out.push(notImplExpr("splat argument (* / **)", 0)) }
            else { out.push(args[i]) }
        }
        return out
    }
    function splitBlock(args) {
        var plain = []
        var blk = null
        for (var i = 0; i < args.length; i++) {
            if (args[i].blkT != undefined) { blk = args[i].blkT } else { plain.push(args[i]) }
        }
        return {args: plain, blk: blk}
    }
    function unwrapArgs(args) {
        var sp = splitBlock(rubyPlainArgs(args))
        if (sp.blk == null) { return sp.args }
        var out = []
        for (var i = 0; i < sp.args.length; i++) { out.push(sp.args[i]) }
        out.push(sp.blk)
        return out
    }
    // &expr as an argument: the value is handed over as the block itself.
    function makeBlockArg(t) { return t }
    // yield and redo need the block protocol the interpreter grew; not lowered yet.
    function makeYield(items, pos) { return notImplExpr("yield", pos) }
    function makeRedo(pos) { return notImplExpr("redo", pos) }
    // for VAR[, VAR] in COLL ... end, lowered as a counted loop over the collection.
    // `for` opens no scope, so the loop variable is written with the ordinary local
    // assignment rule and outlives the loop, exactly as in Ruby.
    function makeForIn(items) {
        var names = []
        var collT = null
        var body = null
        for (var i = 0; i < items.length; i++) {
            if (items[i].fvar != undefined) { names.push(items[i].fvar) }
            else if (items[i].body != undefined) { body = items[i].body }
            else { collT = items[i] }
        }
        return function(b) {
            var rc = collT(b)
            b = rc.b
            var seqV = rc.v
            var lenV = callExt(b, "js_pylen", [seqV])
            hidCount++
            var iName = "$for" + hidCount
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, iName), emitNum(b, 0)])
            for (var k = 0; k < names.length; k++) {
                callExt(b, "js_pyset_var", [curScopeV, emitStr(b, names[k]), hNull])
            }
            var headB = curF.NewBlock("")
            var bodyB = curF.NewBlock("")
            var exitB = curF.NewBlock("")
            b.NewBr(headB)
            var iV = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, iName)])
            headB.NewCondBr(truthy(headB, callExt(headB, "js_lt", [iV, lenV])), bodyB, exitB)
            var iV2 = callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, iName)])
            var elV = callExt(bodyB, "js_pyget", [seqV, iV2])
            if (names.length == 1) {
                callExt(bodyB, "js_pyset_var", [curScopeV, emitStr(bodyB, names[0]), elV])
            } else {
                for (var j = 0; j < names.length; j++) {
                    callExt(bodyB, "js_pyset_var", [curScopeV, emitStr(bodyB, names[j]),
                                                    callExt(bodyB, "js_pyget", [elV, emitNum(bodyB, j)])])
                }
            }
            loopStack.push({cont: headB, brk: exitB})
            var rb = body(bodyB)
            var curIV = callExt(rb.b, "js_scope_get", [curScopeV, emitStr(rb.b, iName)])
            var nextIV = intWrap(rb.b, callExt(rb.b, "js_jadd", [curIV, emitNum(rb.b, 1)]))
            callExt(rb.b, "js_scope_set", [curScopeV, emitStr(rb.b, iName), nextIV])
            rb.b.NewBr(headB)
            loopStack.pop()
            return {b: exitB, v: hNull}
        }
    }

    // ----- puts / print -----
    function makePuts(items) {
        var isPrint = items[0].cmd.indexOf("print") >= 0
        var args = items.slice(1)
        return function(b) {
            var fnName = isPrint ? "print" : "println"
            var fnV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, fnName)])
            if (args.length == 0) {
                if (!isPrint) { callExt(b, "js_call", [fnV, hUndef, argList(b, [emitStr(b, "")])]) }
                return {b: b, v: hNull}
            }
            for (var i = 0; i < args.length; i++) {
                var r = args[i](b)
                b = r.b
                callExt(b, "js_call", [fnV, hUndef, argList(b, [r.v])])
