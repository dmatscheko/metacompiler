        while (t.length > 0 && (t.charAt(0) == " " || t.charAt(0) == "\t" || t.charAt(0) == "\n" || t.charAt(0) == "\r")) { t = t.slice(1) }
        for (var i = 0; i < words.length; i++) {
            var wd = words[i]
            if (t.length >= wd.length && t.slice(0, wd.length) == wd) {
                if (t.length == wd.length) { return wd }
                var nx = t.charAt(wd.length)
                if (nx != "_" && !(nx >= "a" && nx <= "z") && !(nx >= "A" && nx <= "Z") && !(nx >= "0" && nx <= "9")) { return wd }
            }
        }
        return ""
    }
    function makeClassStmt(items) {
        var name = items[0]
        var methods = []
        var cstmts = []
        var hasInit = false
        var superName = ""
        for (var i = 1; i < items.length; i++) {
            if (items[i].supername != undefined) { superName = items[i].supername }
            else if (items[i].sblock != undefined) {
