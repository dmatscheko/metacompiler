    // target takes everything the fixed targets around it do not, so its share is only
    // known at run time - hence the emitted loop rather than compile-time indices.
    function emitDestructure(b, targets, arrV) {
        var si = -1
        var i
        for (i = 0; i < targets.length; i++) { if (targets[i].splat != undefined) { si = i } }
        if (si < 0) {
            for (i = 0; i < targets.length; i++) {
                var r0 = emitElemOrNil(b, arrV, emitNum(b, i))
