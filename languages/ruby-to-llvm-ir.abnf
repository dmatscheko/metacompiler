    }
    // Positional read of a destructuring source: Ruby fills a target that has no value
    // with nil, while js_pyget raises IndexError past the end - so the read is guarded.
    function emitElemOrNil(b, arrV, idxV) {
        var lenV = callExt(b, "js_pylen", [arrV])
        var inB = curF.NewBlock("")
        var endB = curF.NewBlock("")
        var fromB = b
        b.NewCondBr(truthy(b, callExt(b, "js_lt", [idxV, lenV])), inB, endB)
        var gotV = callExt(inB, "js_pyget", [arrV, idxV])
        inB.NewBr(endB)
        var phi = endB.NewPhi([llvm.ir.NewIncoming(gotV, inB), llvm.ir.NewIncoming(hNull, fromB)])
        return {b: endB, v: phi}
    }
    function emitAssignOne(b, tgt, v) {
        if (tgt.group != undefined) { return emitDestructure(b, tgt.group, v) }
        return emitAssignTarget(b, tgt, v)
    }
    function makeMultiAssign(items) {
