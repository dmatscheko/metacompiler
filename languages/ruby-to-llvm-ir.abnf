// A parameterless block may still take arguments, under the numbered names _1.._9
// (Ruby 2.7). Nothing in the parse tree records that they were USED, so makeBlock
// scans this text - which is why the body is wrapped in a production of its own.
BlockBody   <~~ var bb = pop(); push({body: bb.body, btext: up.in}) ~~>
            = Body ;
// A do-block body may carry its own rescue / else / ensure clauses with no `begin` of
// its own, exactly like a def body: `it "..." do ... ensure ... end`.
GuardedBlockBody <~~ push({body: makeGuardedBody(takeAll()), btext: up.in}) ~~>
            = GuardedItems ;
BlockParams <~~ push({bparams: takeAll()}) ~~>
// The trailing comma is legal and meaningful: `{ |a, | ... }` forces the single
// argument to be DESTRUCTURED rather than taken whole.
            = "|" [ BParam { "," BParam } [ "," ] ] [ ";" BLocal { "," BLocal } ] "|" ;
// After a `;` come the block-LOCAL variables: names that are fresh in the block even
// when the enclosing scope has one of the same name. They are ordinary parameters here
// (a block is always called with fewer arguments than it has names, and the extra ones
// arrive as nil, which is exactly what a block-local starts as).
BLocal      = Name <~~ push({param: up.in}) ~~> ;
// A block parameter may be a parenthesized group that destructures one element:
// `[[1, [2, 3]]].each { |a, (b, c)| ... }`.
// A default value inside |...| may NOT be a full expression: `{ |a=5, b=4| ... }`
// would otherwise read `4 | ...` as a bitwise-or and swallow the closing bar. Ruby has
// the same restriction; BitAndExpr is the level just below `|` and `^`.
BParam      = BGroup | ParamFwd | ParamDSplat | ParamSplat | ParamBlock | BParamKw
            | BParamDefault | ParamSimple ;
BParamKw    <~~ var n = takeAll(); push({param: n[0], kw: true, defT: n.length > 1 ? n[1] : undefined}) ~~>
            = Name <~~ push(up.in) ~~> ":" NotColonGlued [ BitAndExpr ] ;
BParamDefault <~~ var n = takeAll(); push({param: n[0], defT: n[1]}) ~~>
            = Name <~~ push(up.in) ~~> "=" !"=" BitAndExpr ;
BGroup      <~~ push({pgroup: takeAll()}) ~~>
            = "(" BParam { "," BParam } ")" ;

Primary     = "(" Expression ")" | ParenBody | LambdaLit | SingletonDecl
            | IfExpr | UnlessExpr | WhileExpr | UntilExpr | ForExpr | CaseExpr | BeginExpr
            | ReturnExpr | BreakExpr | NextExpr | RedoExpr | RetryExpr | RaiseExpr | YieldExpr | SuperExpr
            | CmdLit | HeredocLit | HeredocRef
            | StrLit | CharLit | PercentLit | RegexLit
            | NumHex | NumBin | NumOct | Oct0Lit | RatLit | ImagLit | FloatLit | NumInt
            | SymLit
            | ArrayLit | HashLit
            | True | False | Nil | Self | FileLit | LineLit | DirLit
            | ClassDecl | ModuleDecl | DefExpr
            | DefinedExpr | GvarNum | GvarRef | CvarRef | IvarRef | TopConst | ScopedConst | Call | VarRef ;
// `def m ... end` is an expression whose value is the Symbol :m (Ruby 2.1). Defining
// the method is its side effect, which is what makeDefStmt already does.
DefExpr     <~~ push(makeDefExpr(pop())) ~~>
            = Def ;

// ( STMT; STMT ) is a value: parentheses in Ruby hold a whole statement SEQUENCE and
// yield the last one's value, so `(ScratchPad << :x; obj).a = 1` and
// `case (def foo; 'f'; end; 'f')` are ordinary expressions. The EMPTY form `()` is
// the same rule with no statements at all, and its value is nil - which is exactly
// what `[0, (), 2]`, `{() => ()}` and `if ()` rely on. Tried AFTER the plain
// `( Expression )` so the common case never pays for the statement machinery.
ParenBody   <~~ push(pop().body) ~~>
            = "(" Body ")" ;

// for VAR[, VAR] in COLL ... end: unlike a block, `for` does NOT open a scope - the
// loop variable stays visible after the loop (Ruby), so it is written with the same
// assignment path as an ordinary local. Several variables destructure each element.
ForExpr     <~~ push(makeForIn(takeAll())) ~~>
            = KwFor ForVars KwIn Expression [ KwDo ] Body End ;
// The trailing comma is meaningful, exactly as in a block parameter list: `for i, in`
// forces each element to be DESTRUCTURED rather than taken whole.
ForVars     = "(" ForVarList ")" | ForVarList ;
ForVarList  = ForVar { "," [ "*" ] [ ForVar ] } ;
