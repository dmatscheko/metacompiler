    // Go twin (abnf/jsrtregex.go, reached by the js_rx* externs); this copy is here
    // so a regexp literal can be checked for validity while the tags run.
    include("lib/regex.js")
    rxFail = function (msg) { println("ruby compiler error: " + msg); exit(1) }

    var hidCount = 0
    // The argument array of the function being emitted (js_rblock reads the block out
    // of it for block_given? and for a &blk parameter).
    var curArgsV = null
    // ----- non-local control flow OUT of a block -----
    // A block is its own IR function, called from the Go runtime (Array#each, ...), so
    // a `break' inside it cannot branch to anything in the frame that wrote the block.
    // Ruby's rule is that `break v' ends the CALL the block was given to and makes that
    // call yield v, `next v' ends this one block run with v, and `redo' re-runs the
    // block body with the same bindings.
    //   next  -> a plain ret of the block function (nothing else to do).
    //   redo  -> a branch back to curRedoB, the block created right after the parameter
    //            binding, so the bindings survive.
    //   break -> js_throw of a marker exception, caught by the js_try that wraps every
    //            call carrying a literal block (emitBlkBreakCall below). The marker is
    //            built with js_pyexc, whose {__class:{__name}, args} shape js_is_type
    //            recognizes on ANY value - so the catch can tell it from a real Ruby
    //            exception without probing fields of a number or a string.
    // curIsBlockFn / curRedoB are emit-time state, saved and restored by emitFunc, so a
    // def or a lambda written INSIDE a block gets the ordinary treatment again.
    var curIsBlockFn = false
    var curRedoB = null
    var blkBrkName = "__blkbrk"
    // The same marker trick carries `retry' out of a rescue clause closure: the clause
    // returns it, and the loop makeTry wraps around the js_try re-runs the begin body.
    var retryName = "__blkretry"
    var curInRescue = false
