        var bodyB = curF.NewBlock("")
        var exitB = curF.NewBlock("")
        b.NewBr(headB)
        var iV = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, iName)])
        var stV = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, sName)])
        headB.NewCondBr(truthy(headB, callExt(headB, "js_lt", [iV, stV])), bodyB, exitB)
