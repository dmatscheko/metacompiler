        var args = unwrapArgs(items.slice(1))
        return function(b) {
            if (selfMethod(curClsName, name)) {
                var selfV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, "self")])
                var eam = emitArgs(b, args)
                b = eam.b
                return {b: b, v: callExt(b, "js_rmcall", [selfV, emitStr(b, name), eam.v])}
            }
            var fV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, name)])
            var ea = emitArgs(b, args)
            b = ea.b
            return {b: b, v: callExt(b, "js_call", [fV, hUndef, ea.v])}
