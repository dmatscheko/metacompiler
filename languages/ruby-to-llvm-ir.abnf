        var body = null
        var typed = false
        for (var i = 0; i < items.length; i++) {
            if (items[i].etype != undefined) { typed = true }
            else if (items[i].hname != undefined) { hname = items[i].hname }
            else if (items[i].rbody != undefined) { body = items[i].rbody }
