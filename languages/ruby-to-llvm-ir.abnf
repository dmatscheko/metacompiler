            if (own[m1].name == "initialize") { hasInit = true }
        }
        for (var m2 = 0; m2 < front.length; m2++) { mnames.push(front[m2].name) }
        classMethods["$" + name] = mnames
        declaredClassNames.push(name)
        var snames = []
        for (var m3 = 0; m3 < sdefs.length; m3++) { snames.push(sdefs[m3].name) }
        classSMethods["$" + name] = snames
        var rnames = []
        for (var m4 = 0; m4 < r.restricted.length; m4++) { rnames.push(r.restricted[m4].name) }
        restrictedMethods["$" + name] = rnames
        if (superName != "") { classSupers["$" + name] = superName }
        // A prepend gives the class a synthetic ancestor even without a superclass,
        // so `super` inside the prepended method is a legal thing to emit.
        if (front.length > 0 && superName == "") { classHasSuper["$" + name] = true }
        var coreName = name + "$core"
        return function(b) {
            var clsV = callExt(b, "js_obj_new", [])
            callExt(b, "js_set", [clsV, emitStr(b, "__isclass"), hTrue])
            callExt(b, "js_set", [clsV, emitStr(b, "__name"), emitStr(b, name)])
            var baseSet = false
            var baseV = hNull
            if (superName != "") {
                baseV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, superName)])
                baseSet = true
            }
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, name), clsV])
            var savedCls = curClsName
            curClsName = name
            // A NESTED class or module is declared in the ENCLOSING scope, not inside the
            // body closure - so a method of the outer class can name it - and is then
            // published on the class under $c$, which is what makes Outer::Inner resolve.
            // This is the same treatment a module body already gives its items.
            for (var ni = 0; ni < r.cstmts.length; ni++) {
                if (!hoistedCstmt(r.cstmts[ni])) { continue }
                var nres = r.cstmts[ni].t(b)
                b = nres.b
                var nn = r.cstmts[ni].name
                if (nn != undefined && nn != "") {
                    callExt(b, "js_set", [clsV, emitStr(b, "$c$" + nn),
                                          callExt(b, "js_scope_get", [curScopeV, emitStr(b, nn)])])
                }
            }
            // The class body statements, with `self` bound to the class object.
            var bodyTs = []
            for (var ci = 0; ci < r.cstmts.length; ci++) {
                if (hoistedCstmt(r.cstmts[ci])) { continue }
                bodyTs.push(r.cstmts[ci].t)
            }
            var lastV = hNull
            if (bodyTs.length > 0) {
                var cbIdx = emitFunc([], makeBody(bodyTs), true)
                var cbArgs = callExt(b, "js_arr_new", [])
                callExt(b, "js_arr_push", [cbArgs, clsV])
                lastV = callExt(b, "js_call", [callExt(b, "js_closure", [handle(cbIdx), curScopeV]), hUndef, cbArgs])
            }
            // With a prepend the class's OWN methods move one level down.
            var ownDstV = clsV
            if (front.length > 0) {
                var coreV = callExt(b, "js_obj_new", [])
                callExt(b, "js_set", [coreV, emitStr(b, "__isclass"), hTrue])
                callExt(b, "js_set", [coreV, emitStr(b, "__name"), emitStr(b, coreName)])
                if (baseSet) { callExt(b, "js_set", [coreV, emitStr(b, "__super"), baseV]) }
                callExt(b, "js_set", [clsV, emitStr(b, "__super"), coreV])
                ownDstV = coreV
            } else if (baseSet) {
                callExt(b, "js_set", [clsV, emitStr(b, "__super"), baseV])
            }
            b = emitMethods(b, ownDstV, own, "", name, r.restricted)
            b = emitMethods(b, clsV, front, "", name, [])
            b = emitMethods(b, clsV, sdefs, "$s$", name, [])
            // alias / alias_method: the new name is bound to the SAME closure, after
            // every method of the body exists.
            for (var ai = 0; ai < r.aliases.length; ai++) {
                callExt(b, "js_set", [ownDstV, emitStr(b, r.aliases[ai].to),
                                      callExt(b, "js_get", [ownDstV, emitStr(b, r.aliases[ai].from)])])
            }
            curClsName = savedCls
            // A subclass with no initialize of its own INHERITS one, so the default is
            // only emitted when nothing above supplies it: a root class, or one whose
            // superclass is a BUILTIN (`class MyErr < StandardError'), which carries no
            // compiled initialize for js_rnew / super to find. The default stores the
            // constructor arguments under `args', which is where Exception#message
            // reads the message from - so a user exception class needs no body at all.
            if (!hasInit && (superName == "" || classMethods["$" + superName] == undefined)) {
                var emptyBody = function(bb) {
                    var sV = callExt(bb, "js_scope_get", [curScopeV, emitStr(bb, "self")])
                    callExt(bb, "js_set", [sV, emitStr(bb, "args"),
                                           callExt(bb, "js_rargrest", [curArgsV, handle(1)])])
                    return {b: bb, v: hNull}
                }
                var iidx = emitFunc([], emptyBody, true)
                callExt(b, "js_set", [ownDstV, emitStr(b, "initialize"),
                                      callExt(b, "js_closure", [handle(iidx), curScopeV])])
            }
            // A class body is an EXPRESSION: its value is its last statement's.
            return {b: b, v: lastV}
        }
    }

    // class << VALUE ... end - the singleton class of a value. The class machinery here
    // is BUILD time (a class name maps to a method table decided while walking), and the
    // target of a `class << EXPR` is only known at run time, so a def inside one has no
    // table to land on: those are notImplemented. The target and the ordinary body
    // statements are still emitted, with `self` bound to the target, so the surrounding
    // file compiles and its side effects happen.
    function makeSingletonStmt(items, pos) {
        var targetT = null
        var isSelf = false
        var cstmts = []
        var hasDef = false
        for (var i = 0; i < items.length; i++) {
            if (items[i].cguard != undefined) { notImpl("rescue/ensure on a singleton class body", pos); continue }
            if (items[i].sgself != undefined) { isSelf = true }
            else if (items[i].sgexpr != undefined) { targetT = items[i].sgexpr }
            else if (items[i].cstmt != undefined) { cstmts.push(items[i].cstmt) }
            else { hasDef = true }
        }
        if (hasDef) { notImpl("def inside class << VALUE", pos) }
        return function(b) {
            var selfV = hNull
            if (isSelf) { selfV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, "self")]) }
            else if (targetT != null) {
                var r = targetT(b)
                b = r.b
                selfV = r.v
            }
            var v = hNull
            if (cstmts.length > 0) {
                var cbIdx = emitFunc([], makeBody(cstmts), true)
                var cbArgs = callExt(b, "js_arr_new", [])
                callExt(b, "js_arr_push", [cbArgs, selfV])
                v = callExt(b, "js_call", [callExt(b, "js_closure", [handle(cbIdx), curScopeV]), hUndef, cbArgs])
            }
            return {b: b, v: v}
        }
    }

    // module M ... end. The body's defs are registered as a TEMPLATE for include /
    // extend / prepend, and a runtime object is built as well so `M.f` (a def self.
    // or a module_function), `M::CONST` and `M::Inner` all resolve.
    function makeModuleStmt(items, pos) {
        var name = items[0]
        // Same as makeClassStmt: a rescue / ensure on the module BODY would need the
        // body to run under js_try, which the build-time module machinery cannot do.
        for (var gi = 1; gi < items.length; gi++) {
            if (items[gi] != undefined && items[gi].cguard != undefined) { notImpl("rescue/ensure on a module body", pos) }
        }
        lastDeclName = name
        var r = clsItems(items, 1)
        moduleDefs["$" + name] = r.methods
        moduleSDefs["$" + name] = r.sdefs
        moduleConsts["$" + name] = r.consts
        var mnames = []
        for (var m1 = 0; m1 < r.methods.length; m1++) { mnames.push(r.methods[m1].name) }
        classMethods["$" + name] = mnames
        var snames = []
        for (var m3 = 0; m3 < r.sdefs.length; m3++) { snames.push(r.sdefs[m3].name) }
        classSMethods["$" + name] = snames
        restrictedMethods["$" + name] = []
        // A module's instance methods are emitted onto the module object too (Ruby
        // keeps them there), and one of them may call `super` - which only means
        // anything once the module is mixed into a class. Allowing the emission here
        // keeps the mixin copy compilable; the module-object copy simply is not the
        // one anybody calls.
        classHasSuper["$" + name] = true
        return function(b) {
            var modV = callExt(b, "js_obj_new", [])
            callExt(b, "js_set", [modV, emitStr(b, "__isclass"), hTrue])
            callExt(b, "js_set", [modV, emitStr(b, "__ismodule"), hTrue])
            callExt(b, "js_set", [modV, emitStr(b, "__name"), emitStr(b, name)])
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, name), modV])
            var savedCls = curClsName
            curClsName = name
            // A module body's statements (constants, nested classes and modules) run
            // in the CURRENT scope, so a name it introduces stays visible where the
            // module was written - which is what lets a mixed-in method read a
            // constant of its module. Each one is then published on the module under
            // $c$ as well, for the M::NAME form.
            for (var ci = 0; ci < r.cstmts.length; ci++) {
                var res = r.cstmts[ci].t(b)
                b = res.b
                var cn = r.cstmts[ci].name
                if (cn != undefined && cn != "") {
                    callExt(b, "js_set", [modV, emitStr(b, "$c$" + cn),
                                          callExt(b, "js_scope_get", [curScopeV, emitStr(b, cn)])])
                }
            }
            b = emitMethods(b, modV, r.methods, "", name, [])
            b = emitMethods(b, modV, r.sdefs, "$s$", name, [])
            for (var ai = 0; ai < r.aliases.length; ai++) {
                callExt(b, "js_set", [modV, emitStr(b, r.aliases[ai].to),
                                      callExt(b, "js_get", [modV, emitStr(b, r.aliases[ai].from)])])
            }
            curClsName = savedCls
            return {b: b, v: hNull}
        }
    }
    // A::B::C - the head is a scope name, every further step a $c$ member of the
    // module or class object before it.
    function makeScopedConst(text) {
        var parts = []
        var cur = ""
        for (var i = 0; i < text.length; i++) {
            if (text.charAt(i) == ":") {
                if (cur != "") { parts.push(cur); cur = "" }
                continue
            }
            if (isIdentByte(text.charCodeAt(i))) { cur += text.charAt(i) }
        }
        if (cur != "") { parts.push(cur) }
        return function(b) {
            var v = callExt(b, "js_scope_get", [curScopeV, emitStr(b, parts[0])])
            for (var k = 1; k < parts.length; k++) {
                v = callExt(b, "js_get", [v, emitStr(b, "$c$" + parts[k])])
            }
            return {b: b, v: v}
        }
    }


    // ----- Project-file imports (require / require_relative) -----
    // A handful of stdlib names whose require is a no-op (the runtime provides them or
    // they are simply not modelled); every other require is looked up as a project file.
    core.stdlibImports = ["set", "json", "date", "time"]
    // require_relative 'geomlib' looks for geomlib.rb under the program's directory and the
    // -i roots (c.findImport), stripping a leading './' and adding a missing '.rb'. The file
    // is parsed with this grammar and compiled with importDepth > 0; its buildMain stashes
    // the top-level def/class/statement thunks into importedItems instead of emitting a
    // second jsmain. They are prepended to the real jsmain (below), so the imported
    // definitions exist before the requiring file's code runs. A file is imported once;
    // repeats and cycles are no-ops.
    var importedFiles = {}
    var importDepth = 0
    // imported files top-level items: stashImported / emitImportedWith (compile-core)
    core.importFile = function(path, pos) {
        var rel = path
        if (rel.length >= 2 && rel.charAt(0) == "." && rel.charAt(1) == "/") { rel = rel.slice(2) }
        var cand = rel
        if (!(rel.length >= 3 && rel.slice(rel.length - 3) == ".rb")) { cand = rel + ".rb" }
        var file = c.findImport(cand)
        if (file == "") { return false }
        if (importedFiles["$" + file] == true) { return true }
        importedFiles["$" + file] = true
        var text = c.readFile(file)
        var asg = c.parse(c.agrammar, text, null, file)
        c.pushSource(file, text)
        importDepth = importDepth + 1
        c.compile(asg)
        importDepth = importDepth - 1
        c.popSource()
        return true
    }

    // ----- program entry -----
    // The builtin classes named in ordinary Ruby code: the core value classes, the
    // module-like ancestors used in a type test, and the standard exception names.
    var rubyBuiltinClasses = ["Integer", "Float", "Rational", "Complex", "Numeric",
        "String", "Symbol", "Array", "Hash", "Range", "Proc", "NilClass", "TrueClass",
        "FalseClass", "Object", "BasicObject", "Kernel", "Comparable", "Enumerable",
        "Exception", "StandardError", "RuntimeError", "ArgumentError", "TypeError",
        "NameError", "NoMethodError", "IndexError", "KeyError", "RangeError",
        "ZeroDivisionError", "StopIteration", "FrozenError", "NotImplementedError"]
    function buildMain(items) {
        // The walk of an imported file ends here too (importDepth > 0): stash its top-level
        // thunks for the real jsmain instead of emitting a second one.
        if (importDepth > 0) {
            stashImported(items) // stashed with its file; emitted later (compile-core)
            return
        }
        var f = m.NewFunc("jsmain", i64, [llvm.ir.NewParam("env", i64), llvm.ir.NewParam("args", i64)])
        curF = f
        var b = f.NewBlock("entry")
        curScopeV = callExt(b, "js_scope_new", [f.Params[0]])
        var mathV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, "Math")])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, "abs"), callExt(b, "js_get", [mathV, emitStr(b, "abs")])])
        // The builtin class constants, so `case v when Integer`, `v.is_a?(String)`
        // and `rescue ArgumentError` name a real class object (js_rclass hands out
        // one object per name, so the identity comparisons hold).
        for (var bc = 0; bc < rubyBuiltinClasses.length; bc++) {
            var bn = rubyBuiltinClasses[bc]
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, bn),
                                         callExt(b, "js_rclass", [emitStr(b, bn)])])
        }
        // Imported definitions first, each under its own source, then this file's own items.
        b = emitImportedWith(b, function(item, bb) { return item(bb).b })
        for (var i = 0; i < items.length; i++) { b = items[i](b).b }
        b.NewRet(handle(0))
    }

    // makeVarRef uses core.scopeGetExt (js_scope_get) - fine for Ruby locals,
    // functions and class constants (all live in the scope chain).
    core.scopeGetExt = "js_scope_get"

    c.compile(c.asg)

    println(m)

    var res = llvm.RunJS(m, "jsmain")
    println("ruby compiler: jsmain() returned " + res.Ret)
    exit(res.Ret)

~~) ;
