    truthy = function(b, v) {
        return b.NewICmp(llvm.enum.IPredUGE, v, handle(3))
    }

    // ----- Control flow: a body threads blocks and yields its last value (Ruby
    // implicit return). return/break/next terminate the current block and continue
    // in a fresh (dead) one. -----
    function makeBody(items) {
        return function(b) {
            var v = hNull
            for (var i = 0; i < items.length; i++) {
                var r = items[i](b)
                b = r.b
                v = r.v
            }
            return {b: b, v: v}
        }
    }
    // return with several values yields an array (Ruby: `return 3, 4` -> [3, 4]).
    function makeReturn(items) {
        if (items.length > 1) {
            return function(b) {
                var arrV = callExt(b, "js_arr_new", [])
                for (var i = 0; i < items.length; i++) {
                    var ri = items[i](b)
                    b = ri.b
                    callExt(b, "js_arr_push", [arrV, ri.v])
                }
                return {b: retStmt(b, arrV), v: hNull}
            }
        }
        var t = items.length > 0 ? items[0] : null
        return function(b) {
            var v = hNull
            if (t != null) { var r = t(b); b = r.b; v = r.v }
            // A plain ret, or a control signal when the return leaves a begin body.
            return {b: retStmt(b, v), v: hNull}
        }
    }
    makeBreak = function(items) {
        // In a loop the break value is discarded (loops yield nil); still evaluate it
        // for effects. Directly in a block body it is the value of the whole call, and
        // travels there as the js_pyexc marker that emitBlkBreakCall unwraps.
        var t = items.length > 0 ? items[0] : null
        return function(b) {
            var v = hNull
            if (t != null) { var r = t(b); b = r.b; v = r.v }
            if (loopStack.length == 0 && curIsBlockFn) {
                var margs = callExt(b, "js_arr_new", [])
                callExt(b, "js_arr_push", [margs, v])
                callExt(b, "js_throw", [callExt(b, "js_pyexc", [emitStr(b, blkBrkName), margs])])
                b.NewRet(hUndef) // never reached: js_throw unwinds on the host side
                return {b: deadBlock(), v: hNull}
            }
            // A branch to the enclosing loop, or a control signal out of a begin body.
            emitBreak(b)
            return {b: deadBlock(), v: hNull}
        }
    }
    function makeNext(items) {
        // `next 1, 2, 3' yields an array, exactly like `return 3, 4'.
        var t = items.length > 0 ? items[0] : null
        if (items.length > 1) {
            t = function(b) {
                var arrV = callExt(b, "js_arr_new", [])
                for (var i = 0; i < items.length; i++) {
                    var ri = items[i](b)
                    b = ri.b
                    callExt(b, "js_arr_push", [arrV, ri.v])
                }
                return {b: b, v: arrV}
            }
        }
        return function(b) {
            var v = hNull
            if (t != null) { var r = t(b); b = r.b; v = r.v }
            // `next v' directly in a block ends THIS block run with v: an ordinary ret.
            if (loopStack.length == 0 && curIsBlockFn) {
                b.NewRet(v)
                return {b: deadBlock(), v: hNull}
            }
            emitContinue(b)
            return {b: deadBlock(), v: hNull}
        }
    }

    // if / unless: the branch value travels through a hidden result variable in the
    // CURRENT scope (so the branch bodies keep assigning to the enclosing scope -
    // Ruby's if/while do not introduce a new scope).
    makeIf = function(items) {
        var cond = items[0]
        var thenB = items[1].body
        var branches = []
        var els = null
        for (var i = 2; i < items.length; i++) {
            if (items[i].els != undefined) { els = items[i].els }
            else { branches.push({cond: items[i].elifCond, body: items[i].elifBody}) }
        }
        branches.unshift({cond: cond, body: thenB})
        return function(b) {
            hidCount++
            var rName = "$if" + hidCount
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, rName), hNull])
            var endB = curF.NewBlock("")
            for (var a = 0; a < branches.length; a++) {
                var rc = branches[a].cond(b)
                b = rc.b
                var thenBk = curF.NewBlock("")
                var nextBk = curF.NewBlock("")
                b.NewCondBr(truthy(b, rc.v), thenBk, nextBk)
                var rb = branches[a].body(thenBk)
                callExt(rb.b, "js_scope_set", [curScopeV, emitStr(rb.b, rName), rb.v])
                rb.b.NewBr(endB)
                b = nextBk
            }
            if (els != null) {
                var re = els(b)
                b = re.b
                callExt(b, "js_scope_set", [curScopeV, emitStr(b, rName), re.v])
            }
            b.NewBr(endB)
            var out = callExt(endB, "js_scope_get", [curScopeV, emitStr(endB, rName)])
            return {b: endB, v: out}
        }
    }
    function makeUnless(items) {
        var cond = items[0]
        var thenB = items[1].body
        var els = null
        if (items.length > 2 && items[2].els != undefined) { els = items[2].els }
        return function(b) {
            hidCount++
            var rName = "$un" + hidCount
            callExt(b, "js_scope_decl", [curScopeV, emitStr(b, rName), hNull])
            var rc = cond(b)
            b = rc.b
            var thenBk = curF.NewBlock("")
            var elseBk = curF.NewBlock("")
            var endB = curF.NewBlock("")
            b.NewCondBr(truthy(b, rc.v), elseBk, thenBk)
            var rb = thenB(thenBk)
            callExt(rb.b, "js_scope_set", [curScopeV, emitStr(rb.b, rName), rb.v])
            rb.b.NewBr(endB)
            if (els != null) {
                var re = els(elseBk)
                callExt(re.b, "js_scope_set", [curScopeV, emitStr(re.b, rName), re.v])
                re.b.NewBr(endB)
            } else {
                elseBk.NewBr(endB)
            }
            var out = callExt(endB, "js_scope_get", [curScopeV, emitStr(endB, rName)])
            return {b: endB, v: out}
        }
    }
    makeWhile = function(bodyT, condT) {
        return function(b) {
            var headB = curF.NewBlock("")
            var bodyB = curF.NewBlock("")
            var exitB = curF.NewBlock("")
            b.NewBr(headB)
            var r = condT(headB)
            r.b.NewCondBr(truthy(r.b, r.v), bodyB, exitB)
            loopStack.push({cont: headB, brk: exitB})
            var rb = bodyT(bodyB)
            rb.b.NewBr(headB)
            loopStack.pop()
            return {b: exitB, v: hNull}
        }
    }
    function makeUntil(bodyT, condT) {
        return function(b) {
            var headB = curF.NewBlock("")
            var bodyB = curF.NewBlock("")
            var exitB = curF.NewBlock("")
            b.NewBr(headB)
            var r = condT(headB)
            r.b.NewCondBr(truthy(r.b, r.v), exitB, bodyB)
            loopStack.push({cont: headB, brk: exitB})
            var rb = bodyT(bodyB)
            rb.b.NewBr(headB)
            loopStack.pop()
            return {b: exitB, v: hNull}
        }
    }

    // ----- Boolean operators yielding an operand (short circuit, Ruby truthiness) -----
    makeOrAnd = function(items, isOr) {
        if (items.length == 1) { return items[0] }
        return function(b) {
            var r = items[0](b)
            b = r.b
            var v = r.v
            for (var i = 1; i < items.length; i++) {
                var rightB = curF.NewBlock("")
                var mergeB = curF.NewBlock("")
                var cnd = truthy(b, v)
                if (isOr) { b.NewCondBr(cnd, mergeB, rightB) }
                else      { b.NewCondBr(cnd, rightB, mergeB) }
                var r2 = items[i](rightB)
                r2.b.NewBr(mergeB)
                var phi = mergeB.NewPhi([llvm.ir.NewIncoming(v, b), llvm.ir.NewIncoming(r2.v, r2.b)])
                b = mergeB
                v = phi
            }
            return {b: b, v: v}
        }
    }

    // ----- self / @ivars -----
    function makeSelf() {
        return function(b) { return {b: b, v: callExt(b, "js_scope_get", [curScopeV, emitStr(b, "self")])} }
    }
    function makeIvarRef(name) {
        return function(b) {
            var selfV = callExt(b, "js_scope_get", [curScopeV, emitStr(b, "self")])
            return {b: b, v: callExt(b, "js_get", [selfV, emitStr(b, name)])}
        }
    }

    // ----- ranges (eager arrays), arrays, hashes, templates -----
    function makeRange(items) {
        if (items.length == 1) { return items[0] }
        // A range with BOTH bounds is materialized as an array (js_rrangearr, which
        // also knows the String ranges "a".."c"), because that is what everything
        // downstream expects: `for i in 1..3', `a[1..2]', `(1..n).each'.
        // A range with an open end ((5..), (..9)) has no array to build and becomes
        // the js_rrangeopen object, which answers cover? / include? / === instead.
        var beginless = typeof items[0] == "string"
        var loT = beginless ? null : items[0]
        var op = beginless ? items[0] : items[1]
        var hiT = beginless ? items[1] : (items.length > 2 ? items[2] : null)
        var exclV = op == "..." ? hTrue : hFalse
        return function(b) {
            var loV = hNull
            var hiV = hNull
            if (loT != null) { var rl = loT(b); b = rl.b; loV = rl.v }
            if (hiT != null) { var rh = hiT(b); b = rh.b; hiV = rh.v }
            if (loT == null || hiT == null) {
                return {b: b, v: callExt(b, "js_rrangeopen", [loV, hiV, exclV])}
            }
            return {b: b, v: callExt(b, "js_rrangearr", [loV, hiV, exclV])}
        }
    }
    // [a, *b, c]: a splat element splices the inner array in with an emitted loop.
    function makeArray(items) {
        return function(b) {
            var arrV = callExt(b, "js_arr_new", [])
            // A trailing run of `name: v` / `key => v` elements is ONE Hash element.
            var dictV = hNull
            var haveDict = false
            for (var i = 0; i < items.length; i++) {
                if (items[i].kwname != undefined || items[i].kwkeyT != undefined) {
                    if (!haveDict) { dictV = callExt(b, "js_dict_new", []); haveDict = true }
                    var keyV = hNull
                    if (items[i].kwname != undefined) { keyV = callExt(b, "js_sym", [emitStr(b, items[i].kwname)]) }
                    else {
                        var rk2 = items[i].kwkeyT(b)
                        b = rk2.b
                        keyV = rk2.v
                    }
                    var rv2 = items[i].kwT(b)
                    b = rv2.b
                    callExt(b, "js_pyset", [dictV, keyV, rv2.v])
                    continue
                }
                if (items[i].splat != undefined) {
                    var rs = items[i].splat(b)
                    b = emitSpliceInto(rs.b, arrV, rs.v)
                    continue
                }
                var r = items[i](b)
                b = r.b
                callExt(b, "js_arr_push", [arrV, r.v])
            }
            if (haveDict) { callExt(b, "js_arr_push", [arrV, dictV]) }
            return {b: b, v: arrV}
        }
    }
    // Append every element of srcV to dstV (both runtime arrays), with a counted loop.
    function emitSpliceInto(b, dstV, srcV) {
        hidCount++
        var iName = "$spl" + hidCount
        var lenV = callExt(b, "js_pylen", [srcV])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, iName), emitNum(b, 0)])
        var headB = curF.NewBlock("")
        var bodyB = curF.NewBlock("")
        var exitB = curF.NewBlock("")
        b.NewBr(headB)
        var iV = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, iName)])
        headB.NewCondBr(truthy(headB, callExt(headB, "js_lt", [iV, lenV])), bodyB, exitB)
        var iV2 = callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, iName)])
        callExt(bodyB, "js_arr_push", [dstV, callExt(bodyB, "js_pyget", [srcV, iV2])])
        callExt(bodyB, "js_scope_set", [curScopeV, emitStr(bodyB, iName),
                                        intWrap(bodyB, callExt(bodyB, "js_jadd", [iV2, emitNum(bodyB, 1)]))])
        bodyB.NewBr(headB)
        return exitB
    }
    // {**other, k: v}: a double-splat entry merges another hash in, key by key.
    function makeHash(items) {
        return function(b) {
            var d = callExt(b, "js_dict_new", [])
            for (var i = 0; i < items.length; i++) {
                if (items[i].hsplat != undefined) {
                    var rh = items[i].hsplat(b)
                    b = emitMergeDict(rh.b, d, rh.v)
                    continue
                }
                var rk = items[i].hk(b)
                b = rk.b
                var rv = items[i].hv(b)
                b = rv.b
                callExt(b, "js_pyset", [d, rk.v, rv.v])
            }
            return {b: b, v: d}
        }
    }
    // Copy every key/value pair of srcV into dstV (both runtime dicts).
    function emitMergeDict(b, dstV, srcV) {
        hidCount++
        var iName = "$mrg" + hidCount
        var keysV = callExt(b, "js_keys", [srcV])
        var lenV = callExt(b, "js_pylen", [keysV])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, iName), emitNum(b, 0)])
        var headB = curF.NewBlock("")
        var bodyB = curF.NewBlock("")
        var exitB = curF.NewBlock("")
        b.NewBr(headB)
        var iV = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, iName)])
        headB.NewCondBr(truthy(headB, callExt(headB, "js_lt", [iV, lenV])), bodyB, exitB)
        var iV2 = callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, iName)])
        var kV = callExt(bodyB, "js_pyget", [keysV, iV2])
        callExt(bodyB, "js_pyset", [dstV, kV, callExt(bodyB, "js_pyget", [srcV, kV])])
        callExt(bodyB, "js_scope_set", [curScopeV, emitStr(bodyB, iName),
                                        intWrap(bodyB, callExt(bodyB, "js_jadd", [iV2, emitNum(bodyB, 1)]))])
        bodyB.NewBr(headB)
        return exitB
    }
    function makeTemplate(items) {
        return function(b) {
            var v = emitStr(b, "")
            for (var i = 0; i < items.length; i++) {
                var pv
                if (items[i].s != undefined) { pv = emitStr(b, items[i].s) }
                else {
                    var r = items[i].e(b)
                    b = r.b
                    // '#{v}' is Ruby's to_s: a Float keeps its point, an Array renders
                    // like #inspect, a Symbol is its bare name.
                    pv = callExt(b, "js_rstr", [r.v])
                }
                v = callExt(b, "js_radd", [v, pv])
            }
            return {b: b, v: v}
        }
    }
    function unescapeSq(s) {
        var out = ""
        var i = 0
        while (i < s.length) {
            var c = s.charCodeAt(i)
            if (c == 92 && i + 1 < s.length) {
                var e = s.charCodeAt(i + 1)
                if (e == 39 || e == 92) { out += String.fromCharCode(e); i += 2; continue }
            }
            out += String.fromCharCode(c)
            i++
        }
        return out
    }

    // ----- member chain: .method(args)/.method{block}, .field, [index], .new -----
    // C.new / C.new(args): build the instance, attach __class, run initialize.
    // Works both with parens (mcall) and without (a bare .new field access).
    // C.new(args). js_rnew attaches __class, then dispatches initialize ON THE
    // INSTANCE - the lookup that walks __class and its __super chain, so a subclass
    // without an initialize of its own inherits the one above it. A builtin class
    // (Proc, the exception classes) is constructed by js_rnew itself.
    function emitNew(b, cur, argThunks) {
        var ea = emitArgs(b, argThunks)
        b = ea.b
        return {b: b, v: callExt(b, "js_rnew", [cur, ea.v])}
    }
    // ----- The Ruby operator table -----
    // Every binary operator routes to a Ruby specific extern (js_r*, abnf/jsrt.go)
    // rather than to the shared Java/JS ones, because Ruby's arithmetic differs on
    // three counts that the shared operators cannot express at once:
    //   - the NUMERIC TOWER: Integer, Float, Rational and Complex are distinct, so
    //     7 / 2 == 3 and 7.0 / 2 == 3.5 hold at the same time (js_rflo/js_rrat/js_rcpx
    //     box the three non-integer kinds);
    //   - Integer / and % FLOOR (-7 / 2 == -4, -7 % 3 == 2), and an Integer is never
    //     truncated to 32 bit (10_000_000_000 * 10 is exact);
    //   - the operators are METHODS: a user class with `def +` / `def <=>` / `def ==`
    //     dispatches to its own, and String/Array carry their own + - * % << .
    // The comparisons are Ruby's too: == is structural over Array/Hash and numeric
    // across the tower, <=> yields nil for incomparable values, === is case equality.
    binExt["+"] = "js_radd"
    binExt["-"] = "js_rsub"
    binExt["*"] = "js_rmul"
    binExt["/"] = "js_rdiv"
    binExt["%"] = "js_rmod"
    binExt["+="] = "js_radd"
    binExt["-="] = "js_rsub"
    binExt["*="] = "js_rmul"
    binExt["/="] = "js_rdiv"
    binExt["%="] = "js_rmod"
    binExt["=="] = "js_req"
    binExt["!="] = "js_rne"
    binExt["==="] = "js_rxcase"
    // =~ / !~ : the match operators. js_rxmatch answers the INDEX of the match (not
    // a boolean) or nil, which is what `("zzz" =~ /b/) == nil` needs.
    binExt["=~"] = "js_rxmatch"
    binExt["!~"] = "js_rxnmatch"
    binExt["<"] = "js_rlt"
    binExt[">"] = "js_rgt"
    binExt["<="] = "js_rle"
    binExt[">="] = "js_rge"
    binExt["<=>"] = "js_rcmp"
    binExt["&"] = "js_rband"
    binExt["|"] = "js_rbor"
    binExt["^"] = "js_rbxor"
    binExt["**"] = "js_rpow"
    // The compound forms of the remaining operators (a **= 2, a |= b, a <<= 1).
    binExt["**="] = "js_rpow"
    binExt["|="] = "js_rbor"
    binExt["&="] = "js_rband"
    binExt["^="] = "js_rbxor"
    binExt["<<="] = "js_rshl"
    binExt[">>="] = "js_rshr"
    // The shared table truncates - * / % to 32 bit (Java/Kotlin Int semantics); a Ruby
    // Integer has no width, so nothing is wrapped here.
    wraps = {}
    // Unary minus is a tower operation too (-2.5 stays a Float, and a user class may
    // define -@), so it replaces the shared js_neg + 32 bit wrap.
    // `x = *v`: an Array is copied, anything else is wrapped in a one-element Array
    // (and nil becomes the empty Array), which is what Ruby's splat on a right side does.
    function makeSplatRhs(t) {
        return function(b) {
            var r = t(b)
            b = r.b
            var outV = callExt(b, "js_arr_new", [])
            // An Array is spliced element by element; anything else is one element, and
            // nil none at all - the same three cases the interpreter's makeSplatRhs has.
            var arrB = curF.NewBlock("")
            var elseB = curF.NewBlock("")
            var oneB = curF.NewBlock("")
            var doneB = curF.NewBlock("")
            b.NewCondBr(truthy(b, isTypeNamed(b, r.v, "Array")), arrB, elseB)
            emitSpliceInto(arrB, outV, r.v).NewBr(doneB)
            elseB.NewCondBr(truthy(elseB, callExt(elseB, "js_seq", [r.v, hNull])), doneB, oneB)
            callExt(oneB, "js_arr_push", [outV, r.v])
            oneB.NewBr(doneB)
            return {b: doneB, v: outV}
        }
    }
    makeNeg = function(t) {
        return function(b) {
            var r = t(b)
            return {b: r.b, v: callExt(r.b, "js_rneg", [r.v])}
        }
    }
    // Unary plus: the identity. `+"str"` asks Ruby for an unfrozen copy of a frozen
    // string literal, and every string value here is already an ordinary mutable one.
    function makePos(t) { return t }

    // js_rxget is js_rget plus MatchData indexing (m[1], m[:name]); it delegates to
    // js_rget for every other receiver, so nothing else changes.
    core.indexExt = "js_rxget"   // [i] over arrays, strings, hashes and MatchData
    foldCallMember = function(items) {
        if (items.length == 1) { return items[0] }
        var primary = items[0]
        var suffixes = items.slice(1)
        return function(b) {
            var r = primary(b)
            b = r.b
            var cur = r.v
            for (var i = 0; i < suffixes.length; i++) {
                var s = suffixes[i]
                if (s.kind == "mcall") {
                    if (s.name == "new") {
                        var rn = emitNew(b, cur, unwrapArgs(s.args))
                        b = rn.b
                        cur = rn.v
                    } else if (hasBlockArg(s.args)) {
                        // A call with a literal block can be ended by a `break' inside
                        // that block; the receiver travels into the try closure through
                        // a hidden scope slot (an IR value cannot cross a closure).
                        hidCount++
                        var recvName = "$blkrecv" + hidCount
                        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, recvName), cur])
                        var mname = s.name
                        var margsT = unwrapArgs(s.args)
                        var rw = emitBlkBreakCall(b, function(bb) {
                            var recvV = callExt(bb, "js_scope_get", [curScopeV, emitStr(bb, recvName)])
                            var ia = emitArgs(bb, margsT)
                            return {b: ia.b, v: callExt(ia.b, "js_rxmcall", [recvV, emitStr(ia.b, methodKey(mname)), ia.v])}
                        })
                        b = rw.b
                        cur = rw.v
                    } else {
                        var ea = emitArgs(b, unwrapArgs(s.args))
                        b = ea.b
                        cur = callExt(b, "js_rxmcall", [cur, emitStr(b, methodKey(s.name)), ea.v])
                    }
                } else if (s.kind == "smcall" || s.kind == "sfield") {
                    // Safe navigation: guard on nil (skip the call, keep nil) via a
                    // hidden result variable; only the non-nil branch evaluates args.
                    hidCount++
                    var snName = "$sn" + hidCount
                    callExt(b, "js_scope_decl", [curScopeV, emitStr(b, snName), hNull])
                    var callBk = curF.NewBlock("")
                    var snEnd = curF.NewBlock("")
                    b.NewCondBr(truthy(b, callExt(b, "js_seq", [cur, hNull])), snEnd, callBk)
                    var snRes = hNull
                    if (s.kind == "smcall") {
                        var sea = emitArgs(callBk, unwrapArgs(s.args))
                        callBk = sea.b
                        snRes = callExt(callBk, "js_rxmcall", [cur, emitStr(callBk, methodKey(s.name)), sea.v])
                    } else if (s.name == "length" || s.name == "size") {
                        snRes = callExt(callBk, "js_pylen", [cur])
                    } else if (s.name == "to_s") {
                        snRes = callExt(callBk, "js_jadd", [emitStr(callBk, ""), cur])
                    } else {
                        snRes = callExt(callBk, "js_rxmcall", [cur, emitStr(callBk, methodKey(s.name)), callExt(callBk, "js_arr_new", [])])
                    }
