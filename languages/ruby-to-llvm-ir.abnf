        for (var p = 0; p < curMethParams.length; p++) { if (curMethParams[p] == name) { return false } }
        return classHasMethod(clsName, name)
    }
    function classHasMethod(clsName, name) {
        var c = clsName
        var hops = 0
        while (c != undefined && c != "" && hops < 64) {
            hops = hops + 1
