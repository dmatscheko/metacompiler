        var okB = curF.NewBlock("")
        b.NewCondBr(truthy(b, callExt(b, "js_lt", [stopV, emitNum(b, si)])), lowB, okB)
        callExt(lowB, "js_scope_set", [curScopeV, emitStr(lowB, sName), emitNum(lowB, si)])
