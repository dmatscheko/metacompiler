    // the feature-matrix file uses that shape to pass a method around as a value). The
    // registry is consulted when the reference is EMITTED, after every tag has run, so a
    // def anywhere in the file counts.
    var rubyMethods = {}
    // Every def of the file by name (rubyMethods holds only the zero parameter ones,
    // which are auto-called); defined? uses this one to answer "method".
    var rubyAllMethods = {}
    makeVarRef = function(name) {
        // __method__ is a bare name, not a call: the method being compiled, as a Symbol.
