// source line, i.e. the token just before it is on the same line. It gates the
// binary operators that can equally open a statement (*, +, -), so a line beginning
// with one of them is a new statement rather than a continuation. Pure function of
// (source, position), like the other guards here.
LineCont    = :script(~~
    (function() {
        // Whitespace is skipped before tokens but not before a script, so the newline
        // that would separate the two statements is still AHEAD of this position.
        var i = -1
        var cc = c.peek(i)
        while (cc === 32 || cc === 9 || cc === 13) { i = i - 1; cc = c.peek(i) }
        if (cc === 10) { return abnf.newToken("\x01nl", 0) }
        var j = 0
        var dd = c.peek(j)
        while (dd === 32 || dd === 9 || dd === 13) { j = j + 1; dd = c.peek(j) }
        if (dd === 10 || dd === 35 || dd === -1) { return abnf.newToken("\x01nl", 0) }
        return undefined
    })()
