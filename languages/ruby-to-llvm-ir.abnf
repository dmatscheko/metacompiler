        return function(b) {
            var arrV = hNull
            if (values.length == 1 && targets.length > 1) {
                var rr = values[0](b)
                b = rr.b
                arrV = rr.v
            } else {
                arrV = callExt(b, "js_arr_new", [])
                for (var k = 0; k < values.length; k++) {
                    var rv = values[k](b)
                    b = rv.b
                    callExt(b, "js_arr_push", [arrV, rv.v])
                }
            }
            b = emitDestructure(b, targets, arrV)
            return {b: b, v: hNull}
