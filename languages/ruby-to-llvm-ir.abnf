        }
        // stop = max(si, len - after): the first index that belongs to the trailing targets.
        hidCount++
        var sName = "$dst" + hidCount
        var iName = "$dsi" + hidCount
        var stopV = intWrap(b, callExt(b, "js_sub", [lenV, emitNum(b, after)]))
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, sName), stopV])
        var lowB = curF.NewBlock("")
        var okB = curF.NewBlock("")
        b.NewCondBr(truthy(b, callExt(b, "js_lt", [stopV, emitNum(b, si)])), lowB, okB)
        callExt(lowB, "js_scope_set", [curScopeV, emitStr(lowB, sName), emitNum(lowB, si)])
        lowB.NewBr(okB)
        b = okB
        var midV = callExt(b, "js_arr_new", [])
        callExt(b, "js_scope_decl", [curScopeV, emitStr(b, iName), emitNum(b, si)])
        var headB = curF.NewBlock("")
        var bodyB = curF.NewBlock("")
        var exitB = curF.NewBlock("")
        b.NewBr(headB)
        var iV = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, iName)])
        var stV = callExt(headB, "js_scope_get", [curScopeV, emitStr(headB, sName)])
        headB.NewCondBr(truthy(headB, callExt(headB, "js_lt", [iV, stV])), bodyB, exitB)
        var iV2 = callExt(bodyB, "js_scope_get", [curScopeV, emitStr(bodyB, iName)])
        callExt(bodyB, "js_arr_push", [midV, callExt(bodyB, "js_pyget", [arrV, iV2])])
