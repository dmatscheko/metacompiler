    // block's `break v' marker back into the value of the call, and re-raises anything
    // else unchanged.
    function emitBlkBreakCall(b, mk) {
        var tryIdx = emitFunc([], function(bb) { return mk(bb) }, false)
        var tryClo = callExt(b, "js_closure", [handle(tryIdx), curScopeV])
        var catchIdx = emitFunc(["$brk"], function(bb) {
            var ev = callExt(bb, "js_scope_get", [curScopeV, emitStr(bb, "$brk")])
            var mineB = curF.NewBlock("")
            var otherB = curF.NewBlock("")
