    // many parameters an otherwise parameterless block takes.
    function numberedParamCount(src) {
        var maxN = 0
        for (var i = 0; i + 1 < src.length; i++) {
            if (src.charCodeAt(i) != 95) { continue }
            var d = src.charCodeAt(i + 1)
            if (d < 49 || d > 57) { continue }
            if (i + 2 < src.length && isIdentByte(src.charCodeAt(i + 2))) { continue }
            if (i > 0 && (isIdentByte(src.charCodeAt(i - 1)) || src.charCodeAt(i - 1) == 46)) { continue }
            var n = d - 48
            if (n > maxN) { maxN = n }
