:title("MetaJS interpreter") ;
:description("Parses MetaJS and executes it directly, without generating code.

MetaJS is the restricted JavaScript subset that the annotation scripts of the grammars in
this repository are written in. It has: var/let/const (all block scoped), function declarations and
anonymous function expressions with real closures and an 'arguments' array, if/else, while,
do-while, for(;;), switch (=== comparison, fallthrough, stacked labels, default),
break, continue, return, throw (terminates, there is no try/catch),
numbers (doubles, hex 0x literals included), strings with the methods length/charAt/
charCodeAt/indexOf/replace/slice/substring/split/toUpperCase/toLowerCase/trim,
booleans, null, undefined,
arrays (push/pop/shift/unshift/slice/indexOf/join/concat), object literals, member
access (.name and [expr]), method calls, assignment (= += -= *= /= %=) as an expression
(the target may reach through calls: findScope(name)[name] = v), prefix and postfix
++/--, the
ternary operator, || and && (short circuit, returning the operand),
== != === !== < > <= >= + - * / % | ^ & << >> >>> and unary - ! ~ typeof.

Two discipline rules are part of the language: every variable must be declared
(var/let/const) before use, and a variable's type is pinned by the first
non-undefined, non-null value it holds - later assignments must keep that type class
(number, string, boolean, function or object; arrays and objects share the object
class like typeof does). undefined and null pin nothing and are always assignable,
and a redeclaration starts the pin fresh. A violation aborts the run.
A variable that must hold values of changing types declares it: var v = anytype
(a host global) starts the variable as undefined and exempts it from pinning;
assigning anytype to an already existing variable is an error.

Deliberately not in the subset: this, new, prototypes, try/catch, regex, for-in,
getters/setters, and hoisting (a binding must be executed before it is used;
main() is called after the whole top level ran, so mutual recursion works anyway).
Semicolons are optional at statement ends, but a statement must not begin with '(' or '['
(write an explicit ';' before it in that rare case).

Every tag composes a small JS closure (a 'thunk') out of the thunks of its children.
Expression thunks return the value, statement thunks return undefined or a signal object
(return/break/continue) that the enclosing statements route.

The program must define main(); the exit code of the metacompiler run is what main()
returns, so MetaJS test programs are self checking: they return 0 on success.
The same language is compiled to LLVM IR by metajs-to-llvm-ir.abnf.") ;


// --- main rules

// Shared token productions (languages/lib).
:include("lib/cstyle-comments.abnf") ;
:include("lib/ident-dollar.abnf") ;
:include("lib/dq-strings.abnf") ;
:include("lib/numbers.abnf") ;
:include("lib/bools.abnf") ;

:startRule(Program) ;
:whitespace(Whitespace) ;

// The merged pushes of all top level statements become one program thunk on the global stack.
Program     <~~ pushg(makeSeq(takeAll())) ~~>
            = { Statement } ;

// Every statement production pushes exactly one thunk: function() -> undefined | signal.
Statement   = Block | ImportStmt | VarDecl | If | While | Do | For | Switch | Return | Break | Continue
            | TryStmt | Throw | FuncDecl | Empty | ExprStmt ;

// import "./mod.js"; loads the referenced file (resolveImport -> core.importFile) and runs
// its top level, so its function/var declarations register in the shared global scope
// before the main program runs. A flat, side-effect module model (no binding clause).
ImportStmt  <~~ push(metajsImport(takeAll(), up.pos)) ~~>
            = KwImport ModPath [ ";" ] ;
ModPath     = ModDq | ModSq ;
ModDq       = '"' :whitespace() { StrEsc | DqPlain } <~~ push(unescapeJs(up.in)) ~~> '"' :whitespace(Whitespace) ;
ModSq       = "'" :whitespace() { StrEsc | SqPlain } <~~ push(unescapeJs(up.in)) ~~> "'" :whitespace(Whitespace) ;

// The JS switch: === comparison, fallthrough until break, stacked labels, default
// anywhere. The body is a flat list - the labels must be tried before Statement,
// because 'case 1:' would otherwise parse as two expression statements (semicolons
// are optional).
Switch      <~~ push(makeSwitch(takeAll())) ~~>
            = KwSwitch "(" Expression ")" "{" { CaseLabel | DefaultLabel | Statement } "}" ;
CaseLabel   <~~ push({casev: pop()}) ~~>
            = KwCase AssignExpr ":" ;
DefaultLabel <~~ push({isdflt: true}) ~~>
            = KwDefault ":" ;

Block       <~~ push(makeBlockStmt(takeAll())) ~~>
            = "{" { Statement } "}" ;

// var, let and const all declare a block scoped variable in the current scope.
VarDecl     = VarDeclCore [ ";" ] ;
VarDeclCore <~~ push(makeSeq(takeAll())) ~~>
            = KwVar Declarator { "," Declarator } ;
Declarator  <~~ push(makeDecl(takeAll())) ~~>
            = Id <~~ push(up.in) ~~> [ "=" AssignExpr ] ;

// [condThunk, thenThunk] or [condThunk, thenThunk, elseThunk].
If          <~~ push(makeIf(takeAll())) ~~>
            = KwIf "(" Expression ")" Statement [ KwElse Statement ] ;

While       <~~ push(makeWhile(pop(), pop())) ~~>
            = KwWhile "(" Expression ")" Statement ;

Do          <~~ push(makeDo(pop(), pop())) ~~>
            = KwDo Statement KwWhile "(" Expression ")" [ ";" ] ;

// The three optional parts are wrapped with a kind marker, otherwise e.g.
// 'for (;c;)' and 'for (i=0;;)' could not be told apart on the stack.
For         <~~ push(makeFor(takeAll())) ~~>
            = KwFor "(" [ ForInit ] ";" [ ForCond ] ";" [ ForPost ] ")" Statement ;
ForInit     <~~ push({k:"init", t:pop()}) ~~> = ForVar | ForExpr ;
ForVar      = VarDeclCore ;
ForExpr     <~~ push(exprToStmt(pop())) ~~> = Expression ;
ForCond     <~~ push({k:"cond", t:pop()}) ~~> = Expression ;
ForPost     <~~ push({k:"post", t:exprToStmt(pop())}) ~~> = Expression ;

// [] or [exprThunk].
Return      <~~ push(makeReturn(takeAll())) ~~>
            = KwReturn [ Expression ] [ ";" ] ;

Break       <~~ push(makeBreak()) ~~>
            = KwBreak [ ";" ] ;

Continue    <~~ push(makeContinue()) ~~>
            = KwContinue [ ";" ] ;

Throw       <~~ push(makeThrow(pop())) ~~>
            = KwThrow Expression [ ";" ] ;

// try/catch/finally. The catch binding is optional (ES2019 `catch {}`), and either
// catch or finally may be omitted. Each part is wrapped with a marker so makeTry can
// tell them apart on the stack; the catch clause scopes its own takeAll to pair the
// optional binding name with the block.
TryStmt     <~~ push(makeTry(takeAll())) ~~>
            = KwTry TryBody [ CatchClause ] [ FinallyClause ] ;
TryBody     <~~ push({trybody: pop()}) ~~>
            = Block ;
CatchClause <~~ push(makeCatch(takeAll())) ~~>
            = KwCatch [ "(" Id <~~ push(up.in) ~~> ")" ] Block ;
FinallyClause <~~ push({finbody: pop()}) ~~>
            = KwFinally Block ;

// A function declaration binds the closure in the current scope when it executes.
FuncDecl    <~~ push(makeFuncDecl(pop(), pop(), pop())) ~~>
            = KwFunction Id <~~ push(up.in) ~~> ParamList Block ;

ParamList   <~~ push(takeAll()) /* Collect the parameter names into one array. */ ~~>
            = "(" [ Id <~~ push(up.in) ~~> { "," Id <~~ push(up.in) ~~> } ] ")" ;

Empty       <~~ push(function() {}) ~~>
            = ";" ;

ExprStmt    <~~ push(exprToStmt(pop())) ~~>
            = Expression [ ";" ] ;

// Every expression production pushes exactly one thunk: function() -> value.
Expression  = AssignExpr ;

// Assignment is an expression and associates to the right: a = b = c.
// If the assignment shape does not fit (e.g. 'a == b'), the parser falls back to CondExpr.
AssignExpr  = Assignment | CondExpr ;
Assignment  <~~ push(makeAssign(takeAll())) ~~>
            = Target ( "+=" | "-=" | "*=" | "/=" | "%=" | "=" ) <~~ push(up.in) ~~> AssignExpr ;

// An assignable place: a variable, or a member path that may reach through calls
// but must end in a member: findScope(name)[name] = value.
// The local stack holds [name, suffix marker, suffix marker, ...].
Target      <~~ push(makeTargetRef(takeAll())) ~~>
            = Id <~~ push(up.in) ~~> { CallSuffix | DotSuffix | IndexSuffix } ;

CondExpr    <~~ push(makeCond(takeAll())) ~~>
            = OrExpr [ "?" AssignExpr ":" AssignExpr ] ;

OrExpr      <~~ push(makeOr(takeAll())) ~~>
            = AndExpr { "||" AndExpr } ;

AndExpr     <~~ push(makeAnd(takeAll())) ~~>
            = BitOrExpr { "&&" BitOrExpr } ;

// The bitwise levels sit between && and equality, like in JS. A single "|" that
// actually starts a "||" fails its right side, the iteration rolls back, and the
// enclosing || level picks it up.
BitOrExpr   <~~ push(foldBinary(takeAll())) ~~>
            = BitXorExpr { "|" <~~ push("|") ~~> BitXorExpr } ;
BitXorExpr  <~~ push(foldBinary(takeAll())) ~~>
            = BitAndExpr { "^" <~~ push("^") ~~> BitAndExpr } ;
BitAndExpr  <~~ push(foldBinary(takeAll())) ~~>
            = EqExpr { "&" <~~ push("&") ~~> EqExpr } ;

// The longer operators must be tried before their prefixes ("===" before "==").
EqExpr      <~~ push(foldBinary(takeAll())) ~~>
            = RelExpr { ( "===" | "!==" | "==" | "!=" ) <~~ push(up.in) ~~> RelExpr } ;

RelExpr     <~~ push(foldBinary(takeAll())) ~~>
            = ShiftExpr { ( "<=" | ">=" | "<" | ">" ) <~~ push(up.in) ~~> ShiftExpr } ;

ShiftExpr   <~~ push(foldBinary(takeAll())) ~~>
            = AddExpr { ( "<<" | ">>>" | ">>" ) <~~ push(up.in) ~~> AddExpr } ;

AddExpr     <~~ push(foldBinary(takeAll())) ~~>
            = MulExpr { ( "+" | "-" ) <~~ push(up.in) ~~> MulExpr } ;

MulExpr     <~~ push(foldBinary(takeAll())) ~~>
            = UnaryExpr { ( "*" | "/" | "%" ) <~~ push(up.in) ~~> UnaryExpr } ;

UnaryExpr   = PreIncDec | Neg | Not | BitNot | Typeof | PostfixExpr ;
// Prefix ++/--: the expression value is the new one.
PreIncDec   <~~ push(makePreIncDec(pop(), pop())) ~~>
            = ( "++" | "--" ) <~~ push(up.in) ~~> Target ;
Neg         <~~ push(makeNeg(pop())) ~~>
            = "-" UnaryExpr ;
Not         <~~ push(makeNot(pop())) ~~>
            = "!" UnaryExpr ;
BitNot      <~~ push(makeBitNot(pop())) ~~>
            = "~" UnaryExpr ;
Typeof      <~~ push(makeTypeof(pop())) ~~>
            = KwTypeof UnaryExpr ;

// The postfix forms: i++ evaluates to the old value.
PostfixExpr = IncDec | CallMember ;
IncDec      <~~ push(makeIncDec(takeAll())) ~~>
            = Target ( "++" | "--" ) <~~ push(up.in) ~~> ;

// A primary expression followed by any mix of calls and member accesses: a.b[i](x).c().
// A call after a member access is a method call: the object becomes 'this' of the callee
// (that is what makes items.slice(1) or str.charCodeAt(0) work on the native values).
CallMember  <~~ push(foldCallMember(takeAll())) ~~>
            = Primary { CallSuffix | DotSuffix | IndexSuffix } ;
CallSuffix  <~~ push({kind:"call", args: takeAll()}) ~~>
            = "(" [ AssignExpr { "," AssignExpr } ] ")" ;
DotSuffix   = "." Id <~~ push({kind:"member", key: makeConst(up.in)}) ~~> ;
IndexSuffix <~~ push({kind:"member", key: pop()}) ~~>
            = "[" Expression "]" ;

Primary     = "(" Expression ")" | FunctionExpr | ObjectLit | ArrayLit | StringLit | NumberLit
            | True | False | Null | Undefined | VarRef ;

// The optional name of a function expression is accepted but not bound.
FunctionExpr <~~ push(makeFunctionExpr(pop(), pop())) ~~>
            = KwFunction [ Id ] ParamList Block ;

ObjectLit   <~~ push(makeObject(takeAll())) ~~>
            = "{" [ PropDef { "," PropDef } ] "}" ;
PropDef     <~~ push(makeProp(pop(), pop())) ~~>
            = PropKey ":" AssignExpr ;
PropKey     = Id <~~ push(up.in) ~~> | StringLit ;

ArrayLit    <~~ push(makeArray(takeAll())) ~~>
            = "[" [ AssignExpr { "," AssignExpr } ] "]" ;

Null        <~~ push(makeConst(null)) ~~>      = "null" KwEnd ;
Undefined   <~~ push(makeConst(undefined)) ~~> = "undefined" KwEnd ;

VarRef      <~~ push(makeVarRef(up.in)) ~~>
            = Id ;

StringLit   = DqString | SqString ;
NumberLit   = HexLit | DecLit ;

// Hex must be tried before decimal, otherwise '0x1A' would stop after the '0'.
HexLit      <~~ push(makeConst(hexAt(up.in, 2, up.in.length - 2))) ~~>
            = ( "0x" | "0X" ) :whitespace() HexDigit { HexDigit } :whitespace(Whitespace) ;
HexDigit    = "0"..."9" | "a"..."f" | "A"..."F" ;

// The keywords end with a negative lookahead, so that e.g. 'iffy' or 'variable' stay identifiers.
KwImport    = "import" KwEnd ;
KwVar       = ( "var" | "let" | "const" ) KwEnd ;
KwFunction  = "function" KwEnd ;
KwIf        = "if" KwEnd ;
KwElse      = "else" KwEnd ;
KwWhile     = "while" KwEnd ;
KwDo        = "do" KwEnd ;
KwFor       = "for" KwEnd ;
KwReturn    = "return" KwEnd ;
KwBreak     = "break" KwEnd ;
KwContinue  = "continue" KwEnd ;
KwThrow     = "throw" KwEnd ;
KwTry       = "try" KwEnd ;
KwCatch     = "catch" KwEnd ;
KwFinally   = "finally" KwEnd ;
KwTypeof    = "typeof" KwEnd ;
KwSwitch    = "switch" KwEnd ;
KwCase      = "case" KwEnd ;
KwDefault   = "default" KwEnd ;

// ---


:startScript(~~

    // Shared interpreter machinery (scopes, BRK/CONT protocol, expression and
    // statement builders); language-specific behavior is configured on `core` below.
    include("lib/interp-core.js")

    // takeAll empties the local stack of the current tag and returns its items in push
    // order as a plain JS array. It only uses pop(), so it works independently of how
    // the runtime wraps the Go slice behind up.stack.
    // Resolves the JS string escapes (\n \t \r \0 \xNN \uNNNN, and \c for the char itself).
    // The host unescape() is for the grammar token syntax and rejects \' and \", so the
    // JS string literals bring their own unescaper.
    // ----- Scopes -----
    // 'scopes' is the active scope chain (innermost last). Every closure captures a copy
    // of the chain array; the scope objects inside stay shared, so later declarations in
    // an already captured scope are visible to the closure (that is what allows mutual
    // recursion between top level functions).

    // The host names that a MetaJS program can use. Everything resolves to the goja
    // natives, so e.g. Math.imul or the string/array methods behave exactly like in JS.
    // The 'anytype' declaration marker of the interpreted programs: a unique
    // object a program can only obtain through the anytype global below.
    var anytypeMarker = {}

    // ----- The SIZED INTEGER, and the five places a program can see it -----
    //
    // The other half has a real primitive type for it: tag 13 of
    // languages/lib/runtime.c natively, jsGInt of abnf/jsrtint.go under
    // llvm.Run, and both bind the eleven sint* globals below (seed_root ids
    // 40..50 / giBindings). This half cannot make a new primitive type at all -
    // its values ARE goja/frozen-engine values - so the box is the {__sz} object
    // of lib/interp-core.js, which already implements giNorm/giTrunc/giArith on
    // exact 64 bit pairs and is validated against `go run` over 156,490 vectors.
    //
    // What that costs is the five observations a MetaJS program can make where
    // an object and a number differ, each routed below to the floor's answer:
    //
    //   typeof v          "number", not "object"        siTypeof, makeTypeof
    //   the pinned type   "number", so a variable may
    //                     later hold a plain number     siTypeof, typeClass
    //   an operator       to_number / to_string / the
    //                     strict_eq and js_compare
    //                     arms of runtime.c             siBinOp, binOp, applyOp
    //   println / print   the decimal digits            the wrappers below
    //
    // The fifth, TRUTHINESS, is NOT converted: runtime.c's truthy() answers
    // `fa(h) != 0` for tag 13, so `if (sint(0, 0, 8, 0))` is false there and
    // true here, because the condition is the host engine's own and the
    // statement builders live in lib/interp-core.js. Recorded in
    // docs/runtime-next-plan.md part 2 and deliberately not asserted.
    //
    // Every function is named after the si_* of runtime.c it transliterates.
    // interp-core.js's szNorm/szCmp are NOT reused directly: szNorm rounds a
    // width that is not 8/16/32/64 to 16 bits where si_norm leaves it alone, and
    // szCmp compares two plain operands as doubles where si_cmp truncates them
    // to integers first. Those are the only two differences and they are here so
    // that a future reader can see the floor, not a near-miss of it.
    function siWidthOf(l, r) {
        if (szIs(l)) return l.w
        if (szIs(r)) return r.w
        return 64
    }
    function siUnsOf(l, r) {
        if (szIs(l)) return l.u
        if (szIs(r)) return r.u
        return false
    }
    // si_trunc: only 8, 16 and 32 wrap; anything else is a 64 bit value already.
    function siTrunc(p, w, u) {
        if (w == 8 || w == 16 || w == 32) return i64Trunc(p, w, u)
        return p
    }
    // si_val: the 64 bit value of any operand, a plain number truncated toward
    // zero (i64FromNum is giFromFloat, NaN and an infinity included).
    function siPair(v) {
        if (szIs(v)) return v.p
        return i64FromNum(v * 1)
    }
    // si_norm: THE invariant, applied here and nowhere else.
    function siNorm(p, w, u) {
        var q = siTrunc(p, w, u)
        if (w == 64 && !u && i64Fits53(q)) return i64ToNumS(q)
        return szMake(q, w, u ? true : false)
    }
    // si_float: the double reading; a uint64 needs the unsigned one.
    function siNum(v) {
        if (!szIs(v)) return v * 1
        if (v.u && v.w == 64) return i64ToNumU(v.p)
        return i64ToNumS(v.p)
    }
    // si_str, and to_string for everything else.
    function siStr(v) {
        if (!szIs(v)) return "" + v
        if (v.u) return i64StrU(siTrunc(v.p, v.w, true))
        return i64StrS(v.p)
    }
    // si_apply, by the same 0..10 operator index the floor uses. An index the
    // table does not have answers si_norm(0), which is what si_apply's
    // `long x = 0` with no arm taken produces.
    function siOp(code, l, r) {
        var w = siWidthOf(l, r)
        var u = siUnsOf(l, r)
        var a = siPair(l)
        var b = siPair(r)
        var x = i64Make(0, 0)
        if (code == 0) { x = i64Add(a, b) }
        else if (code == 1) { x = i64Sub(a, b) }
        else if (code == 2) { x = i64Mul(a, b) }
        else if (code == 3 || code == 4) {
            if (i64IsZero(b)) { fail("integer divide by zero") }
            var d = u ? i64DivModU(siTrunc(a, w, true), siTrunc(b, w, true)) : i64DivModS(a, b)
            x = (code == 3) ? d.q : d.r
        }
        else if (code == 5) { x = i64And(a, b) }
        else if (code == 6) { x = i64Or(a, b) }
        else if (code == 7) { x = i64Xor(a, b) }
        else if (code == 8) { x = i64And(a, i64Not(b)) }
        else if (code == 9 || code == 10) {
            // The COUNT is read as the floor reads it, si_val(r) as a signed
            // 64 bit value - so a uint64 count above 2^63 is negative here too.
            var s = i64ToNumS(b)
            if (code == 9) {
                if (s >= 0 && s < w) { x = i64Shl(a, s) }
            } else if (s >= 0) {
                if (u) {
                    if (s < w) { x = i64ShrU(siTrunc(a, w, true), s) }
                } else {
                    if (s >= w) { s = w - 1 }
                    x = i64ShrS(a, s)
                }
            }
        }
        return siNorm(x, w, u)
    }
    // si_cmp: -1, 0 or 1, unsigned where the result type is.
    function siCmp(l, r) {
        var w = siWidthOf(l, r)
        var x = siPair(l)
        var y = siPair(r)
        if (siUnsOf(l, r)) return i64CmpU(siTrunc(x, w, true), siTrunc(y, w, true))
        return i64CmpS(x, y)
    }
    // strict_eq's two tag-13 arms: a sized integer compares by VALUE with
    // another sized integer or with a plain number, and with nothing else.
    function siStrictEq(l, r) {
        if (szIs(l)) {
            if (szIs(r) || typeof r == "number") return i64Eq(siPair(l), siPair(r))
            return false
        }
        if (szIs(r)) {
            if (typeof l == "number") return i64Eq(siPair(l), siPair(r))
            return false
        }
        return l === r
    }
    // loose_eq, where a box is NEITHER a number nor a string: the
    // `(ta == 3 || ta == 4) != (tb == 3 || tb == 4)` line answers 0 for a box
    // against a plain number, so `box == 5` is FALSE while `box === 5` is true.
    // Faithfully odd; both engines of the other half do exactly this.
    function siLooseEq(l, r) {
        if (l == undefined || r == undefined) return false
        if (typeof l == "boolean" || typeof r == "boolean") return false
        if (szIs(l) && szIs(r)) return siStrictEq(l, r)
        return false
    }
    // The operators, for the case where at least one operand is a box.
    function siBinOp(op, l, r) {
        if (op == "+") {
            // js_add_v: a string, an array or an object operand concatenates.
            if (typeof l == "string" || typeof r == "string") return siStr(l) + siStr(r)
            if (typeof l == "object" && !szIs(l)) return siStr(l) + siStr(r)
            if (typeof r == "object" && !szIs(r)) return siStr(l) + siStr(r)
            return siNum(l) + siNum(r)
        }
        if (op == "-") return siNum(l) - siNum(r)
        if (op == "*") return siNum(l) * siNum(r)
        if (op == "/") return siNum(l) / siNum(r)
        if (op == "%") return siNum(l) % siNum(r)
        if (op == "==") return siLooseEq(l, r)
        if (op == "!=") return !siLooseEq(l, r)
        if (op == "===") return siStrictEq(l, r)
        if (op == "!==") return !siStrictEq(l, r)
        // js_compare: both sides through to_number, so a uint64 compares as its
        // unsigned double reading.
        if (op == "<")  return siNum(l) < siNum(r)
        if (op == ">")  return siNum(l) > siNum(r)
        if (op == "<=") return siNum(l) <= siNum(r)
        if (op == ">=") return siNum(l) >= siNum(r)
        // The 32 bit bitwise operators are js_bitand and friends, which take
        // to_number and then ToInt32 - they are NOT the sized-integer operators.
        if (op == "|")  return siNum(l) | siNum(r)
        if (op == "^")  return siNum(l) ^ siNum(r)
        if (op == "&")  return siNum(l) & siNum(r)
        if (op == "<<") return siNum(l) << siNum(r)
        if (op == ">>") return siNum(l) >> siNum(r)
        if (op == ">>>") return siNum(l) >>> siNum(r)
    }
    // typeof, and the type class a declaration pins: "number" for a box, which
    // is js_typeof's answer in both engines of the other half.
    function siTypeof(v) {
        if (szIs(v)) return "number"
        return typeof v
    }
    // print/println render a box as its digits, which is what fmt.Fprintln of
    // the int64/uint64 toGoNatural hands out and what o_str(to_string(...))
    // writes natively. printf and sprintf are deliberately NOT wrapped: their
    // %d takes the Go int64 there, and a string here would print as
    // %!d(string=...).
    function siPrintArgs(a) {
        var out = []
        for (var i = 0; i < a.length; i++) out.push(szIs(a[i]) ? siStr(a[i]) : a[i])
        return out
    }
    function siPrintln() { return println.apply(undefined, siPrintArgs(arguments)) }
    function siPrint() { return print.apply(undefined, siPrintArgs(arguments)) }
    function siEprintln() { return eprintln.apply(undefined, siPrintArgs(arguments)) }
    // sint(hi, lo, bits, unsigned): two UNSIGNED 32 bit halves, because a MetaJS
    // number is a double and cannot carry 64 bits exactly. bits defaults to 64
    // and unsigned to false, matching the floor's `n > 2` / `n > 3`.
    function siHost(hi, lo, bits, uns) {
        var w = (bits === undefined) ? 64 : bits
        return siNorm(i64Make(i64FromNum(hi).l, i64FromNum(lo).l), w, uns ? true : false)
    }

    var hostGlobals = {
        "println": siPrintln, "print": siPrint, "printf": printf, "sprintf": sprintf,
        "eprintln": siEprintln,
        "parseInt": parseInt, "parseFloat": parseFloat, "Math": Math, "String": String,
        "exit": exit, "anytype": anytypeMarker,
        // The eleven sized-integer names, the same set languages/lib/runtime.c
        // seeds and abnf/jsrtint.go's giBindings adds.
        "sint": siHost,
        "sintIs": function(v) { return szIs(v) },
        "sintHi": function(v) { return siPair(v).h >>> 0 },
        "sintLo": function(v) { return siPair(v).l >>> 0 },
        "sintWidth": function(v) { return siWidthOf(v, v) },
        "sintUns": function(v) { return siUnsOf(v, v) ? true : false },
        "sintOp": siOp, "sintCmp": siCmp,
        "sintConv": function(v, bits, uns) { return siNorm(siPair(v), bits, uns ? true : false) },
        "sintStr": siStr, "sintNum": siNum
    }

    // The type class that pins a variable: undefined and null pin nothing.
    function typeClass(v) {
        if (v === undefined || v === null) return ""
        return siTypeof(v)
    }
    // Scope entries are {v, t} type boxes: reads unbox, declarations pin the
    // type; t '*' marks an anytype variable (starts undefined, never pins).
    getVar = function(name) {
        for (var i = scopes.length - 1; i >= 0; i--) {
            if (hasOwn(scopes[i], name)) return scopes[i][name].v
        }
        if (hasOwn(hostGlobals, name)) return hostGlobals[name]
        fail("variable not defined: " + name)
    }
    declVar = function(name, value) {
        if (value === anytypeMarker) { scopes[scopes.length - 1][name] = {v: undefined, t: "*"}; return }
        scopes[scopes.length - 1][name] = {v: value, t: typeClass(value)}
    }
    setVar = function(name, value) {
        if (value === anytypeMarker) { fail("MetaJS: anytype can only initialize a declaration") }
        for (var i = scopes.length - 1; i >= 0; i--) {
            if (hasOwn(scopes[i], name)) {
                var entry = scopes[i][name]
                var tc = typeClass(value)
                if (tc != "" && entry.t != "*") {
                    if (entry.t != "" && entry.t != tc) {
                        fail("MetaJS: variable '" + name + "' has type " + entry.t + " and cannot hold a " + tc)
                    }
                    entry.t = tc
                }
                entry.v = value
                return
            }
        }
        fail("assignment to undeclared variable: " + name)
    }

    // ----- Statement signals -----
    // Statement thunks return undefined (fall through), BRK, CONT, or {isRet:true, v:...}.

    // ----- Functions -----
    // A MetaJS function value is a real (goja) JS function, so typeof, passing it around,
    // and calling it work natively. It closes over the scope chain of its creation.
    function makeClosure(params, bodyT, defScopes) {
        var env = defScopes.slice()
        return function() {
            var args = []
            for (var i = 0; i < arguments.length; i++) args.push(arguments[i])
            var saved = scopes
            scopes = env.slice()
            var sc = {}
            for (var j = 0; j < params.length; j++) {
                sc[params[j]] = (args[j] === anytypeMarker) ? {v: undefined, t: "*"} : {v: args[j], t: typeClass(args[j])}
            }
            sc["arguments"] = {v: args, t: "object"}
            scopes.push(sc)
            var r = bodyT()
            scopes = saved
            return (r != undefined && r.isRet) ? r.v : undefined
        }
    }

    function getMember(o, k) {
        if (o == undefined) fail("member '" + k + "' of " + o) // Catches null and undefined.
        return o[k]
    }

    // ----- Expression thunks: function() -> value -----

    makeNeg = function(t) { return function() { return -t() } }
    function makeBitNot(t) { return function() { return ~t() } }
    function makeTypeof(t) { return function() { return siTypeof(t()) } }

    function makeArray(items) {
        return function() {
            var a = []
            for (var i = 0; i < items.length; i++) a.push(items[i]())
            return a
        }
    }
    // PropDef pops [valueThunk, key]; the key is an Id string or a constant string thunk
    // (calling the pure thunk once at build time yields the key text).
    function makeProp(valT, key) {
        return {k: (typeof key == "string") ? key : key(), t: valT}
    }
    function makeObject(props) {
        return function() {
            var o = {}
            for (var i = 0; i < props.length; i++) o[props[i].k] = props[i].t()
            return o
        }
    }

    function makeFunctionExpr(bodyT, params) {
        return function() { return makeClosure(params, bodyT, scopes) }
    }

    binOp = function(op, l, r) {
        // A sized integer is a NUMBER (typeof says so in both halves), so every
        // operator has to read it as one - siBinOp is runtime.c's arms. The
        // guard is two typeof tests, so the ordinary path costs no call: only an
        // object operand can possibly be a box.
        if (typeof l == "object" || typeof r == "object") {
            if (szIs(l) || szIs(r)) return siBinOp(op, l, r)
        }
        if (op == "+") return l + r
        if (op == "-") return l - r
        if (op == "*") return l * r
        if (op == "/") return l / r
        if (op == "%") return l % r
        if (op == "==") return l == r
        if (op == "!=") return l != r
        if (op == "===") return l === r
        if (op == "!==") return l !== r
        if (op == "<")  return l < r
        if (op == ">")  return l > r
        if (op == "<=") return l <= r
        if (op == ">=") return l >= r
        if (op == "|")  return l | r
        if (op == "^")  return l ^ r
        if (op == "&")  return l & r
        if (op == "<<") return l << r
        if (op == ">>") return l >> r
        if (op == ">>>") return l >>> r
    }
    // items = [thunk, op, thunk, op, thunk, ...] -> one left folded thunk.
    // || and && evaluate lazily and return the deciding operand, like in JS.
    function makeOr(items) {
        if (items.length == 1) return items[0]
        return function() {
            var v = anytype // The operands may be of mixed types.
            v = items[0]()
            for (var i = 1; i < items.length; i++) {
                if (v) return v
                v = items[i]()
            }
            return v
        }
    }
    function makeAnd(items) {
        if (items.length == 1) return items[0]
        return function() {
            var v = anytype // The operands may be of mixed types.
            v = items[0]()
            for (var i = 1; i < items.length; i++) {
                if (!v) return v
                v = items[i]()
            }
            return v
        }
    }
    // items = [thunk] or [condThunk, thenThunk, elseThunk].
    function makeCond(items) {
        if (items.length == 1) return items[0]
        return function() { return items[0]() ? items[1]() : items[2]() }
    }

    // items = [primaryThunk, {kind:"call"|"member", ...}...]. A member access remembers
    // its object, so that a directly following call uses it as 'this'.
    foldCallMember = function(items) {
        if (items.length == 1) return items[0]
        var primary = items[0]
        var suffixes = items.slice(1)
        return function() {
            var cur = anytype     // A member chain hops between types,
            var curThis = anytype // and so does the remembered receiver.
            cur = primary()
            for (var i = 0; i < suffixes.length; i++) {
                var s = suffixes[i]
                if (s.kind == "member") {
                    curThis = cur
                    cur = getMember(cur, s.key())
                } else {
                    var argv = []
                    for (var j = 0; j < s.args.length; j++) argv.push(s.args[j]())
                    if (typeof cur != "function") fail("call of a non function value: " + cur)
                    cur = cur.apply(curThis, argv)
                    curThis = undefined
                }
            }
            return cur
        }
    }

    // Target items = [nameString, suffix marker...] -> reference descriptor.
    // Walks a target path (members and calls) up to the last element and returns
    // the assignable place {obj, key}. The last element must be a member.
    resolveRef = function(ref) {
        var cur = anytype     // The walked values and receivers
        var curThis = anytype // may be of mixed types.
        cur = getVar(ref.name)
        for (var i = 0; i < ref.path.length - 1; i++) {
            var s = ref.path[i]
            if (s.kind == "member") {
                curThis = cur
                cur = getMember(cur, s.key())
            } else {
                var argv = []
                for (var j = 0; j < s.args.length; j++) argv.push(s.args[j]())
                if (typeof cur != "function") fail("call of a non function value: " + cur)
                cur = cur.apply(curThis, argv)
                curThis = undefined
            }
        }
        var last = ref.path[ref.path.length - 1]
        if (last.kind != "member") fail("assignment target must end in a member")
        if (cur == undefined) fail("member assignment on " + cur)
        return {obj: cur, key: last.key()}
    }
    // A compound assignment is its plain operator, so it goes through binOp and
    // inherits the sized-integer arms with it (s += box is js_add there).
    applyOp = function(op, a, b) {
        if (op == "+=") return binOp("+", a, b)
        if (op == "-=") return binOp("-", a, b)
        if (op == "*=") return binOp("*", a, b)
        if (op == "/=") return binOp("/", a, b)
        if (op == "%=") return binOp("%", a, b)
    }
    // items = [ref, opString, valueThunk]. Returns the assigned value (assignment is an expression).
    function makeAssign(items) {
        var ref = items[0]
        var op = items[1]
        var valT = items[2]
        return function() {
            var v = anytype // A compound assignment (s += n) may change the value's type.
            v = valT()
            if (ref.path.length == 0) {
                if (op != "=") v = applyOp(op, getVar(ref.name), v)
                setVar(ref.name, v)
            } else {
                var p = resolveRef(ref)
                if (op != "=") v = applyOp(op, p.obj[p.key], v)
                p.obj[p.key] = v
            }
            return v
        }
    }
    // items = [ref, "++"|"--"]. Post increment: the expression value is the old (coerced) one.
    function makeIncDec(items) {
        var ref = items[0]
        var delta = (items[1] == "++") ? 1 : -1
        return function() {
            if (ref.path.length == 0) {
                var n = getVar(ref.name) - 0
                setVar(ref.name, n + delta)
                return n
            }
            var p = resolveRef(ref)
            var m = p.obj[p.key] - 0
            p.obj[p.key] = m + delta
            return m
        }
    }
    // Prefix ++/--: like makeIncDec, but the expression value is the new one.
    function makePreIncDec(ref, op) {
        var delta = (op == "++") ? 1 : -1
        return function() {
            if (ref.path.length == 0) {
                var n = getVar(ref.name) - 0 + delta
                setVar(ref.name, n)
                return n
            }
            var p = resolveRef(ref)
            var m = p.obj[p.key] - 0 + delta
            p.obj[p.key] = m
            return m
        }
    }

    // ----- Statement thunks: function() -> undefined | BRK | CONT | {isRet, v} -----

    // An expression in statement position: evaluate and discard the value.
    // items = [name] or [name, initThunk].
    function makeDecl(items) {
        var name = items[0]
        var init = items.length > 1 ? items[1] : makeConst(undefined)
        return function() { declVar(name, init()) }
    }
    // items = [cond, then] or [cond, then, else].
    // Note: the childs lie on the stack in source order, so pop() delivers them reversed.
    function makeDo(condT, bodyT) {
        return function() {
            do {
                var r = bodyT()
                if (r != undefined) {
                    if (r === BRK) break
                    if (r !== CONT) return r
                }
            } while (condT())
        }
    }
    // items = [{k:"init"|"cond"|"post", t:thunk}..., bodyThunk].
    function makeFor(items) {
        var bodyT = items.pop()
        var init = null, cond = null, post = null
        for (var i = 0; i < items.length; i++) {
            if (items[i].k == "init") init = items[i].t
            if (items[i].k == "cond") cond = items[i].t
            if (items[i].k == "post") post = items[i].t
        }
        return function() {
            scopes.push({}) // The for header is its own scope (for the loop variable).
            var res = undefined
            if (init != null) init()
            while (cond == null || cond()) {
                var r = bodyT()
                if (r != undefined) {
                    if (r === BRK) break
                    if (r !== CONT) { res = r; break } // A return signal.
                }
                if (post != null) post()
            }
            scopes.pop()
            return res
        }
    }
    // items = [] or [exprThunk].
    function makeReturn(items) {
        var t = items.length > 0 ? items[0] : makeConst(undefined)
        return function() { return {isRet: true, v: t()} }
    }
    // throw wraps the thrown value in a marker object and raises it as a real host
    // exception, so it unwinds through any depth of expression evaluation and calls
    // up to the nearest catch. isUserExc distinguishes it from a host/runtime error
    // (which a catch must not swallow - it is re-thrown).
    function makeThrow(t) { return function() { throw {__exc: true, v: t()} } }
    function isUserExc(e) { return e != undefined && e.__exc == true }

    // items = [name, blockThunk] or [blockThunk] (no binding).
    function makeCatch(items) {
        if (items.length > 1) { return {catchbody: items[1], catchname: items[0]} }
        return {catchbody: items[0], catchname: undefined}
    }
    // items = [{trybody}, {catchbody,catchname}?, {finbody}?]. The try block runs; a
    // user exception routes to the catch (binding the value); finally always runs and
    // its own control-flow signal (return/break/continue) overrides. A non-user
    // exception, or a throw with no catch clause, propagates after finally. The try/
    // catch bodies return the target program's statement signal (undefined/BRK/CONT/
    // {isRet}), so return/break/continue INSIDE them still propagate to the enclosing
    // loop or function; the scope chain is healed on the way out of a throw.
    function makeTry(items) {
        var tryT = anytype, catchT = anytype, catchName = anytype, finallyT = anytype
        for (var i = 0; i < items.length; i++) {
            if (items[i].trybody != undefined) { tryT = items[i].trybody }
            else if (items[i].catchbody != undefined) { catchT = items[i].catchbody; catchName = items[i].catchname }
            else if (items[i].finbody != undefined) { finallyT = items[i].finbody }
        }
        return function() {
            var savedChain = scopes.slice()
            var box = {sig: undefined}
            try {
                box.sig = tryT()
            } catch (e) {
                scopes = savedChain.slice()
                if (isUserExc(e) && catchT != undefined) {
                    var sc = {}
                    if (catchName != undefined) { sc[catchName] = {v: e.v, t: typeClass(e.v)} }
                    scopes.push(sc)
                    box.sig = catchT()
                    scopes.pop()
                } else {
                    throw e
                }
            } finally {
                scopes = savedChain.slice()
                if (finallyT != undefined) {
                    var fr = finallyT()
                    // An abrupt finally overrides the completion and cancels a
                    // rethrown exception, like in JS (see lib/interp-core.js).
                    if (fr != undefined) { return fr }
                }
            }
            return box.sig
        }
    }

    // items = [subjThunk, ({casev}|{isdflt}|stmtThunk)...]. The flat label/statement
    // list is grouped into case descriptors at build time; at run time the first ===
    // match (or default) starts execution, which falls through until a break.
    function makeSwitch(items) {
        var subj = items[0]
        var cases = []
        var cur = null
        for (var i = 1; i < items.length; i++) {
            var p = items[i]
            if (p != undefined && (p.casev != undefined || p.isdflt != undefined)) {
                cur = {isDefault: p.isdflt != undefined, v: p.casev, body: []}
                cases.push(cur)
            } else {
                if (cur == null) fail("switch: a statement before the first case label")
                cur.body.push(p)
            }
        }
        return function() {
            var v = subj()
            var start = -1
            var dflt = -1
            for (var i = 0; i < cases.length; i++) {
                if (cases[i].isDefault) { if (dflt < 0) dflt = i; continue }
                if (start < 0 && cases[i].v() === v) { start = i }
            }
            if (start < 0) { start = dflt }
            if (start < 0) { return undefined }
            for (var i = start; i < cases.length; i++) {
                var body = cases[i].body
                for (var j = 0; j < body.length; j++) {
                    var r = body[j]()
                    if (r === BRK) { return undefined }        // break leaves the switch
                    if (r != undefined) { return r }           // return/continue propagate
                }
            }
            return undefined
        }
    }

    // Local stack = [name, [paramNames...], bodyThunk] -- binds the closure when executed.
    function makeFuncDecl(bodyT, paramNames, name) {
        return function() { declVar(name, makeClosure(paramNames, bodyT, scopes)) }
    }

    // Build the program thunk out of the parsed source.
    // ----- Core library config (see lib/interp-core.js) -----
    core.lang = "js"

    // ----- Project-file imports (see the ImportStmt rule) -----
    function metajsImport(items, pos) {
        resolveImport(items[items.length - 1], pos)
        return function() { return undefined }
    }
    // MetaJS has no importable stdlib modules, so every import path is a project file.
    core.stdlibImports = []
    // Load the file, parse+walk it (its top-level program thunk lands on the global stack)
    // and run that thunk now, so the file's declarations register in the shared global scope
    // before the main program runs. Imported once; a leading './' is dropped and a missing
    // '.js' extension appended before the -i-root search.
    var importedFiles = {}
    core.importFile = function(path, pos) {
        var rel = path
        if (rel.length >= 2 && rel.charAt(0) == "." && rel.charAt(1) == "/") { rel = rel.substring(2) }
        if (!(rel.length >= 3 && rel.substring(rel.length - 3) == ".js")) { rel = rel + ".js" }
        var file = c.findImport(rel)
        if (file == "") { return false }
        if (importedFiles["$" + file] == true) { return true }
        importedFiles["$" + file] = true
        var text = c.readFile(file)
        var asg = c.parse(c.agrammar, text, null, file)
        c.pushSource(file, text)
        c.compile(asg)
        c.popSource()
        var mod = popg()
        mod()
        return true
    }

    c.compile(c.asg)
    var progT = popg()

    // Run the top level (it binds the functions), then call main(). The exit code of
    // this metacompiler run is what main() returned, so test programs are self checking.
    // The entry point defaults to main() but the -main flag (c.mainName) can name any
    // other top-level function. A user exception that escapes it is reported like any
    // runtime error.
    var ret = anytype
    var entry = c.mainName
    if (entry == undefined || entry == "") { entry = "main" }
    var snip = mainIsSnippet(entry)
    try {
        progT()
        if (snip) {
            ret = runMainSnippet(entry, "Statement")
        } else {
            if (!hasOwn(globalScope, entry) || typeof globalScope[entry].v != "function") {
                fail("MetaJS programs need a " + entry + "() function.")
            }
            ret = globalScope[entry].v()
        }
    } catch (e) {
        if (isUserExc(e)) { fail("uncaught exception: " + e.v) }
        throw e
    }
    if (snip) {
        println("js interpreter: -main snippet returned " + ret)
    } else {
        println("js interpreter: " + entry + "() returned " + ret)
    }
    exit(ret | 0)

~~) ;
